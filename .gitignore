# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 변환된 자료 — 사이트를 만들 때마다 content/ 에서 새로 만든다 (pnpm build:content)
/src/data/
/public/data/*
# 조각 사전은 원본 DB 가 커서 미리 만들어 둔 것을 저장소에 넣는다
!/public/data/dict/

# Firebase 배포 기록
/.firebase/
firebase-debug*.log

# ── 공개 저장소에 넣지 않는 자료 ── (비공개 저장소에 따로 두고 사이트를 만들 때만 합친다: scripts/fetch-private.mjs)
# 법구경 법현 스님 번역 — 사이트에는 보이되 저장소에는 올리지 않는다
/content/theravada-app/sutta_pitaka/khuddaka_nikaya/dhammapada/dhammapada_kor_beophyun/
# 이용 조건 확인 중인 사전 (K-PTS 원본·조각, PTS, 미얀마)
/content/theravada-app/dictionary/
/public/data/dict/kpts/
/public/data/dict/pts/
/public/data/dict/mm/
# 사전 원본 DB (크고, 다시 만들 때만 필요)
/content/dpd/
/content/epitaka.db
# 받아 온 비공개 자료
/.private/
