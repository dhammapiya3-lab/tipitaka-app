{"suttaId":"thig6.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[649,668],"vripara":"169"},"segments":{"thig6.8:0.3":"Vijayātherīgāthā","thig6.8:1.1":"“Catukkhattuṃ pañcakkhattuṃ, vihārā upanikkhamiṃ;","thig6.8:1.3":"Aladdhā cetaso santiṃ, citte avasavattinī.","thig6.8:2.1":"“Bhikkhuniṃ upasaṅkamma, sakkaccaṃ paripucchahaṃ;","thig6.8:2.3":"Sā me dhammamadesesi, dhātuāyatanāni ca.","thig6.8:3.1":"“Cattāri ariyasaccāni, indriyāni balāni ca;","thig6.8:3.3":"Bojjhaṅgaṭṭhaṅgikaṃ maggaṃ, uttamatthassa pattiyā.","thig6.8:4.1":"“Tassāhaṃ vacanaṃ sutvā, karontī anusāsaniṃ;","thig6.8:4.3":"Rattiyā purime yāme, pubbajātimanussariṃ.","thig6.8:5.1":"“Rattiyā majjhime yāme, dibbacakkhuṃ visodhayiṃ;","thig6.8:5.3":"Rattiyā pacchime yāme, tamokhandhaṃ padālayiṃ.","thig6.8:6.1":"“Pītisukhena ca kāyaṃ, pharitvā vihariṃ tadā;","thig6.8:6.3":"Sattamiyā pāde pasāresiṃ, tamokhandhaṃ padāliyā”ti.","thig6.8:7.1":"… Vijayā therī ….","thig6.8:8.1":"Chakkanipāto niṭṭhito."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":2623,"to":2623,"paras":[{"para":2623,"vripara":null,"refs":["thig6.8:6"],"words":["pītisukhenā","kāyaṃ","pharitvā","sattamiyā pāde pasāresiṃ","tamokhandhaṃ padāliya"],"lines":["<b>Pītisukhenā</b>ti phalasamāpattipariyāpannāya pītiyā sukhena ca.","<b>Kāyan</b>ti taṃsampayuttaṃ nāmakāyaṃ tadanusārena rūpakāyañca.","<b>Pharitvā</b>ti phusitvā byāpetvā vā.","<b>Sattamiyā pāde pasāresin</b>ti vipassanāya āraddhadivasato sattamiyaṃ pallaṅkaṃ bhinditvā pāde pasāresiṃ.","Kathaṃ?","<b>Tamokhandhaṃ padāliya,</b> appadālitapubbaṃ mohakkhandhaṃ aggamaggañāṇāsinā padāletvā.","Sesaṃ heṭṭhā vuttanayameva."],"lineRefs":[["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"]]}]},"tika":null}
