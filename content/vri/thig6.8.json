{"suttaId":"thig6.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[649,668],"vripara":"169"},"segments":{"thig6.8:0.3":"Vijayātherīgāthā","thig6.8:1.1":"“Catukkhattuṃ pañcakkhattuṃ,","thig6.8:1.2":"vihārā upanikkhamiṃ;","thig6.8:1.3":"Aladdhā cetaso santiṃ,","thig6.8:1.4":"citte avasavattinī. 170.","thig6.8:2.1":"“Bhikkhuniṃ upasaṅkamma,","thig6.8:2.2":"sakkaccaṃ paripucchahaṃ;","thig6.8:2.3":"Sā me dhammamadesesi,","thig6.8:2.4":"dhātuāyatanāni ca. 171.","thig6.8:3.1":"“Cattāri ariyasaccāni,","thig6.8:3.2":"indriyāni balāni ca;","thig6.8:3.3":"Bojjhaṅgaṭṭhaṅgikaṃ maggaṃ,","thig6.8:3.4":"uttamatthassa pattiyā. 172.","thig6.8:4.1":"“Tassāhaṃ vacanaṃ sutvā,","thig6.8:4.2":"karontī anusāsaniṃ;","thig6.8:4.3":"Rattiyā purime yāme,","thig6.8:4.4":"pubbajātimanussariṃ. 173.","thig6.8:5.1":"“Rattiyā majjhime yāme,","thig6.8:5.2":"dibbacakkhuṃ visodhayiṃ;","thig6.8:5.3":"Rattiyā pacchime yāme,","thig6.8:5.4":"tamokhandhaṃ padālayiṃ. 174.","thig6.8:6.1":"“Pītisukhena ca kāyaṃ,","thig6.8:6.2":"pharitvā vihariṃ tadā;","thig6.8:6.3":"Sattamiyā pāde pasāresiṃ,","thig6.8:6.4":"tamokhandhaṃ padāliyā”ti. …","thig6.8:7.1":"Vijayā therī….","thig6.8:8.1":"Chakkanipāto niṭṭhito. 7."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":2623,"to":2623,"paras":[{"para":2623,"vripara":null,"refs":["thig6.8:6"],"lines":["<b>Pītisukhenā</b>ti phalasamāpattipariyāpannāya pītiyā sukhena ca.","<b>Kāya</b>nti taṃsampayuttaṃ nāmakāyaṃ tadanusārena rūpakāyañca.","<b>Pharitvā</b>ti phusitvā byāpetvā vā.","<b>Sattamiyā pāde pasāresi</b>nti vipassanāya āraddhadivasato sattamiyaṃ pallaṅkaṃ bhinditvā pāde pasāresiṃ.","Kathaṃ?","<b>Tamokhandhaṃ padāliya,</b> appadālitapubbaṃ mohakkhandhaṃ aggamaggañāṇāsinā padāletvā.","Sesaṃ heṭṭhā vuttanayameva."],"lineRefs":[["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"]]}],"wordLinks":[["thig6.8:6.1","pītisukhenā",0,0],["thig6.8:6.1","kāyaṃ",0,1],["thig6.8:6.1","pharitvā",0,2],["thig6.8:6.3","sattamiyā pāde pasāresiṃ",0,3],["thig6.8:6.3","tamokhandhaṃ padāliya",0,5]],"before":[{"para":2600,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Vijayātherīgāthāvaṇṇanā"]},{"para":2601,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["<b>Catukkhattu</b>ntiādikā vijayāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī, anukkamena paribrūhitakusalamūlā devamanussesu saṃsarantī, imasmiṃ buddhuppāde rājagahe aññatarasmiṃ kulagehe nibbattitvā viññutaṃ patvā khemāya theriyā gihikāle sahāyikā ahosi.","Sā tassā pabbajitabhāvaṃ sutvā “sāpi nāma rājamahesī pabbajissati kimaṅgaṃ panāha”nti pabbajitukāmāyeva hutvā khemātheriyā santikaṃ upasaṅkami.","Therī tassā ajjhāsayaṃ ñatvā tathā dhammaṃ desesi, yathā saṃsāre saṃviggamānasā sāsane sā abhippasannā bhavissati.","Sā taṃ dhammaṃ sutvā saṃvegajātā paṭiladdhasaddhā ca hutvā pabbajjaṃ yāci.","Therī taṃ pabbājesi.","Sā pabbajitvā katapubbakiccā vipassanaṃ paṭṭhapetvā hetusampannatāya, na cirasseva saha paṭisambhidāhi arahattaṃ patvā attano paṭipattiṃ paccavekkhitvā udānavasena – 169."]},{"para":2603,"vripara":"169","title":"Vijayātherīgāthāvaṇṇanā","lines":["“Catukkhattuṃ pañcakkhattuṃ, vihārā upanikkhamiṃ;"]},{"para":2604,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Aladdhā cetaso santiṃ, citte avasavattinī. 170."]},{"para":2606,"vripara":"170","title":"Vijayātherīgāthāvaṇṇanā","lines":["“Bhikkhuniṃ upasaṅkamma, sakkaccaṃ paripucchahaṃ;"]},{"para":2607,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Sā me dhammamadesesi, dhātuāyatanāni ca. 171."]},{"para":2609,"vripara":"171","title":"Vijayātherīgāthāvaṇṇanā","lines":["“Cattāri ariyasaccāni, indriyāni balāni ca;"]},{"para":2610,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Bojjhaṅgaṭṭhaṅgikaṃ maggaṃ, uttamatthassa pattiyā. 172."]},{"para":2612,"vripara":"172","title":"Vijayātherīgāthāvaṇṇanā","lines":["“Tassāhaṃ vacanaṃ sutvā, karontī anusāsaniṃ;"]},{"para":2613,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Rattiyā purime yāme, pubbajātimanussariṃ. 173."]},{"para":2615,"vripara":"173","title":"Vijayātherīgāthāvaṇṇanā","lines":["“Rattiyā majjhime yāme, dibbacakkhuṃ visodhayiṃ;"]},{"para":2616,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Rattiyā pacchime yāme, tamokhandhaṃ padālayiṃ. 174."]},{"para":2618,"vripara":"174","title":"Vijayātherīgāthāvaṇṇanā","lines":["“Pītisukhena ca kāyaṃ, pharitvā vihariṃ tadā;"]},{"para":2619,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Sattamiyā pāde pasāresiṃ, tamokhandhaṃ padāliyā”ti. –"]},{"para":2620,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Imā gāthā abhāsi."]},{"para":2621,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Tattha <b>bhikkhuni</b>nti khemātheriṃ sandhāya vadati."]},{"para":2622,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["<b>Bojjhaṅgaṭṭhaṅgikaṃ magga</b>nti sattabojjhaṅgañca aṭṭhaṅgikañca ariyamaggaṃ.","<b>Uttamatthassa pattiyā</b>ti arahattassa nibbānasseva vā pattiyā adhigamāya."]}],"after":[{"para":2624,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Vijayātherīgāthāvaṇṇanā niṭṭhitā."]},{"para":2625,"vripara":null,"title":"Vijayātherīgāthāvaṇṇanā","lines":["Chakkanipātavaṇṇanā niṭṭhitā. 7."]}]},"tika":null,"tika2":null}
