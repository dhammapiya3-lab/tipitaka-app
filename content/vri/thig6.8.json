{"suttaId":"thig6.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[649,668],"vripara":"169"},"segments":{"thig6.8:0.3":"Vijayātherīgāthā","thig6.8:1.1":"“Catukkhattuṃ pañcakkhattuṃ, vihārā upanikkhamiṃ;","thig6.8:1.3":"Aladdhā cetaso santiṃ, citte avasavattinī.","thig6.8:2.1":"“Bhikkhuniṃ upasaṅkamma, sakkaccaṃ paripucchahaṃ;","thig6.8:2.3":"Sā me dhammamadesesi, dhātuāyatanāni ca.","thig6.8:3.1":"“Cattāri ariyasaccāni, indriyāni balāni ca;","thig6.8:3.3":"Bojjhaṅgaṭṭhaṅgikaṃ maggaṃ, uttamatthassa pattiyā.","thig6.8:4.1":"“Tassāhaṃ vacanaṃ sutvā, karontī anusāsaniṃ;","thig6.8:4.3":"Rattiyā purime yāme, pubbajātimanussariṃ.","thig6.8:5.1":"“Rattiyā majjhime yāme, dibbacakkhuṃ visodhayiṃ;","thig6.8:5.3":"Rattiyā pacchime yāme, tamokhandhaṃ padālayiṃ.","thig6.8:6.1":"“Pītisukhena ca kāyaṃ, pharitvā vihariṃ tadā;","thig6.8:6.3":"Sattamiyā pāde pasāresiṃ, tamokhandhaṃ padāliyā”ti.","thig6.8:7.1":"… Vijayā therī ….","thig6.8:8.1":"Chakkanipāto niṭṭhito."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":2623,"to":2623,"paras":[{"para":2623,"vripara":null,"refs":["thig6.8:6"],"lines":["<b>Pītisukhenā</b>ti phalasamāpattipariyāpannāya pītiyā sukhena ca.","<b>Kāyan</b>ti taṃsampayuttaṃ nāmakāyaṃ tadanusārena rūpakāyañca.","<b>Pharitvā</b>ti phusitvā byāpetvā vā.","<b>Sattamiyā pāde pasāresin</b>ti vipassanāya āraddhadivasato sattamiyaṃ pallaṅkaṃ bhinditvā pāde pasāresiṃ.","Kathaṃ?","<b>Tamokhandhaṃ padāliya,</b> appadālitapubbaṃ mohakkhandhaṃ aggamaggañāṇāsinā padāletvā.","Sesaṃ heṭṭhā vuttanayameva."],"lineRefs":[["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"],["thig6.8:6"]]}],"wordLinks":[["thig6.8:6.1","pītisukhenā",0,0],["thig6.8:6.1","kāyaṃ",0,1],["thig6.8:6.1","pharitvā",0,2],["thig6.8:6.3","sattamiyā pāde pasāresiṃ",0,3],["thig6.8:6.3","tamokhandhaṃ padāliya",0,5]],"before":[{"para":2598,"vripara":null,"refs":[],"lines":["Evaṃ satthārā imāsu gāthāsu bhāsitāsu gāthāpariyosāne therī saha paṭisambhidāhi arahattaṃ patvā udānavasena bhagavatā bhāsitaniyāmeneva imā gāthā abhāsi.","Teneva tā theriyā gāthā nāma jātā."],"lineRefs":[[],[]]},{"para":2599,"vripara":null,"refs":[],"lines":["Guttātherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2600,"vripara":null,"refs":[],"lines":["Vijayātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":2601,"vripara":null,"refs":[],"lines":["<b>Catukkhattun</b>tiādikā vijayāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī, anukkamena paribrūhitakusalamūlā devamanussesu saṃsarantī, imasmiṃ buddhuppāde rājagahe aññatarasmiṃ kulagehe nibbattitvā viññutaṃ patvā khemāya theriyā gihikāle sahāyikā ahosi.","Sā tassā pabbajitabhāvaṃ sutvā “sāpi nāma rājamahesī pabbajissati kimaṅgaṃ panāhan”ti pabbajitukāmāyeva hutvā khemātheriyā santikaṃ upasaṅkami.","Therī tassā ajjhāsayaṃ ñatvā tathā dhammaṃ desesi, yathā saṃsāre saṃviggamānasā sāsane sā abhippasannā bhavissati.","Sā taṃ dhammaṃ sutvā saṃvegajātā paṭiladdhasaddhā ca hutvā pabbajjaṃ yāci.","Therī taṃ pabbājesi.","Sā pabbajitvā katapubbakiccā vipassanaṃ paṭṭhapetvā hetusampannatāya, na cirasseva saha paṭisambhidāhi arahattaṃ patvā attano paṭipattiṃ paccavekkhitvā udānavasena –"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":2603,"vripara":"169","refs":[],"lines":["“Catukkhattuṃ pañcakkhattuṃ, vihārā upanikkhamiṃ;"],"lineRefs":[[]]},{"para":2604,"vripara":null,"refs":[],"lines":["Aladdhā cetaso santiṃ, citte avasavattinī."],"lineRefs":[[]]},{"para":2606,"vripara":"170","refs":[],"lines":["“Bhikkhuniṃ upasaṅkamma, sakkaccaṃ paripucchahaṃ;"],"lineRefs":[[]]},{"para":2607,"vripara":null,"refs":[],"lines":["Sā me dhammamadesesi, dhātuāyatanāni ca."],"lineRefs":[[]]},{"para":2609,"vripara":"171","refs":[],"lines":["“Cattāri ariyasaccāni, indriyāni balāni ca;"],"lineRefs":[[]]},{"para":2610,"vripara":null,"refs":[],"lines":["Bojjhaṅgaṭṭhaṅgikaṃ maggaṃ, uttamatthassa pattiyā."],"lineRefs":[[]]},{"para":2612,"vripara":"172","refs":[],"lines":["“Tassāhaṃ vacanaṃ sutvā, karontī anusāsaniṃ;"],"lineRefs":[[]]},{"para":2613,"vripara":null,"refs":[],"lines":["Rattiyā purime yāme, pubbajātimanussariṃ."],"lineRefs":[[]]},{"para":2615,"vripara":"173","refs":[],"lines":["“Rattiyā majjhime yāme, dibbacakkhuṃ visodhayiṃ;"],"lineRefs":[[]]},{"para":2616,"vripara":null,"refs":[],"lines":["Rattiyā pacchime yāme, tamokhandhaṃ padālayiṃ."],"lineRefs":[[]]},{"para":2618,"vripara":"174","refs":[],"lines":["“Pītisukhena ca kāyaṃ, pharitvā vihariṃ tadā;"],"lineRefs":[[]]},{"para":2619,"vripara":null,"refs":[],"lines":["Sattamiyā pāde pasāresiṃ, tamokhandhaṃ padāliyā”ti.","–"],"lineRefs":[[],[]]},{"para":2620,"vripara":null,"refs":[],"lines":["Imā gāthā abhāsi."],"lineRefs":[[]]},{"para":2621,"vripara":null,"refs":[],"lines":["Tattha <b>bhikkhunin</b>ti khemātheriṃ sandhāya vadati."],"lineRefs":[[]]},{"para":2622,"vripara":null,"refs":[],"lines":["<b>Bojjhaṅgaṭṭhaṅgikaṃ maggan</b>ti sattabojjhaṅgañca aṭṭhaṅgikañca ariyamaggaṃ.","<b>Uttamatthassa pattiyā</b>ti arahattassa nibbānasseva vā pattiyā adhigamāya."],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
