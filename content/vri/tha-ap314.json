{"suttaId":"tha-ap314","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9242,9260],"vripara":"4"},"segments":{"tha-ap314:0.3":"Bhojanadāyakattheraapadānaṃ","tha-ap314:1.1":"“Sujāto sālalaṭṭhīva, sobhañjanamivuggato;","tha-ap314:1.3":"Indalaṭṭhirivākāse, virocati sadā jino.","tha-ap314:2.1":"“Tassa devātidevassa, vessabhussa mahesino;","tha-ap314:2.3":"Adāsi bhojanamahaṃ, vippasannena cetasā.","tha-ap314:3.1":"“Taṃ me buddho anumodi, sayambhū aparājito;","tha-ap314:3.3":"Bhave nibbattamānamhi, phalaṃ nibbattatū tava.","tha-ap314:4.1":"“Ekattiṃse ito kappe, yaṃ dānamadadiṃ tadā;","tha-ap314:4.3":"Duggatiṃ nābhijānāmi, bhojanassa idaṃ phalaṃ.","tha-ap314:5.1":"“Pañcavīse ito kappe, eko āsiṃ amittako;","tha-ap314:5.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap314:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap314:7.1":"Itthaṃ sudaṃ āyasmā bhojanadāyako thero imā gāthāyo abhāsitthāti.","tha-ap314:8.1":"Bhojanadāyakattherassāpadānaṃ dutiyaṃ."},"attha":null,"tika":null}
