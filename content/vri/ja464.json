{"suttaId":"ja464","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[6266,6302],"vripara":"1"},"segments":{"ja464:0.4":"Cūḷakuṇālajātakaṃ (1)","ja464:1.1":"Luddhānaṃ [khuddānaṃ (sī. syā. pī.)] lahucittānaṃ,","ja464:1.2":"akataññūna dubbhinaṃ;","ja464:1.3":"Nādevasatto puriso,","ja464:1.4":"thīnaṃ saddhātumarahati.","ja464:2.1":"Na tā pajānanti kataṃ na kiccaṃ,","ja464:2.2":"na mātaraṃ pitaraṃ bhātaraṃ vā;","ja464:2.3":"Anariyā samatikkantadhammā,","ja464:2.4":"sasseva cittassa vasaṃ vajanti.","ja464:3.1":"Cirānuvuṭṭhampi [cirānuvutthampi (sī. pī.)] piyaṃ manāpaṃ,","ja464:3.2":"anukampakaṃ pāṇasamampi bhattuṃ [santaṃ (sī. syā. pī.)];","ja464:3.3":"Āvāsu kiccesu ca naṃ jahanti,","ja464:3.4":"tasmāhamitthīnaṃ na vissasāmi.","ja464:4.1":"Thīnañhi cittaṃ yathā vānarassa,","ja464:4.2":"kannappakannaṃ yathā rukkhachāyā;","ja464:4.3":"Calācalaṃ hadayamitthiyānaṃ,","ja464:4.4":"cakkassa nemi viya parivattati.","ja464:5.1":"Yadā tā passanti samekkhamānā,","ja464:5.2":"ādeyyarūpaṃ purisassa vittaṃ;","ja464:5.3":"Saṇhāhi vācāhi nayanti menaṃ,","ja464:5.4":"kambojakā jalajeneva assaṃ.","ja464:6.1":"Yadā na passanti samekkhamānā,","ja464:6.2":"ādeyyarūpaṃ purisassa vittaṃ;","ja464:6.3":"Samantato naṃ parivajjayanti,","ja464:6.4":"tiṇṇo nadīpāragatova kullaṃ.","ja464:7.1":"Silesūpamā sikhiriva sabbabhakkhā,","ja464:7.2":"tikkhamāyā nadīriva sīghasotā;","ja464:7.3":"Sevanti hetā piyamappiyañca,","ja464:7.4":"nāvā yathā orakūlaṃ parañca.","ja464:8.1":"Na tā ekassa na dvinnaṃ,","ja464:8.2":"āpaṇova pasārito;","ja464:8.3":"Yo tā mayhanti maññeyya,","ja464:8.4":"vātaṃ jālena bādhaye [bandhaye (syā. ka.)].","ja464:9.1":"Yathā nadī ca pantho ca,","ja464:9.2":"pānāgāraṃ sabhā papā;","ja464:9.3":"Evaṃ lokitthiyo nāma,","ja464:9.4":"velā tāsaṃ na vijjati [imissā gāthāya pubbaddhāparaddhaṃ vipariyāyena dissati (ka.)].","ja464:10.1":"Ghatāsanasamā etā,","ja464:10.2":"kaṇhasappasirūpamā;","ja464:10.3":"Gāvo bahitiṇasseva,","ja464:10.4":"omasanti varaṃ varaṃ.","ja464:11.1":"Ghatāsanaṃ kuñjaraṃ kaṇhasappaṃ,","ja464:11.2":"muddhābhisittaṃ pamadā ca sabbā;","ja464:11.3":"Ete naro niccayato [niccayatto (sī. pī.)] bhajetha,","ja464:11.4":"tesaṃ have dubbidu sabbabhāvo [saccabhāvo (syā.)].","ja464:12.1":"Naccantavaṇṇā na bahūnaṃ kantā,","ja464:12.2":"na dakkhiṇā pamadā sevitabbā;","ja464:12.3":"Na parassa bhariyā na dhanassa hetu,","ja464:12.4":"etitthiyo pañca na sevitabbāti.","ja464:13.1":"Cūḷakuṇālajātakaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ja-a-iv","bookName":"Jātaka-aṭṭhakathā-4","vriCode":"s0513a4.att","from":1400,"to":1400,"paras":[{"para":1400,"vripara":"1-12","refs":["ja464:1"],"lines":["1-12. <b>Luddhānaṃ lahucittānan</b>ti idaṃ jātakaṃ <b>kuṇālajātake</b> (jā.2.21. kuṇālajātaka) āvi bhavissati;"],"lineRefs":[["ja464:1"]]}],"wordLinks":[["ja464:1.1","luddhānaṃ lahucittānaṃ",0,0]],"before":[{"para":1388,"vripara":null,"refs":[],"lines":["Cattāro māse videsaṃ pakkhandanāvā nivattitvā iddhimā viya saccānubhāvena ekadivaseneva kurukacchapaṭṭanaṃ agamāsi.","Gantvā ca pana thalepi aṭṭhusabhamattaṃ ṭhānaṃ pakkhanditvā nāvikassa gharadvāreyeva aṭṭhāsi.","Mahāsatto tesaṃ vāṇijānaṃ suvaṇṇarajatamaṇipavāḷamuttavajirāni bhājetvā adāsi.","“Ettakehi vo ratanehi alaṃ, mā puna samuddaṃ pavisathā”ti tesaṃ ovādaṃ datvā yāvajīvaṃ dānādīni puññāni katvā devapuraṃ pūresi."],"lineRefs":[[],[],[],[]]},{"para":1389,"vripara":null,"refs":[],"lines":["Satthā imaṃ dhammadesanaṃ āharitvā “evaṃ, bhikkhave, pubbepi tathāgato mahāpaññoyevā”ti vatvā jātakaṃ samodhānesi –","“tadā parisā buddhaparisā ahesuṃ, suppārakapaṇḍito pana ahameva ahosin”ti."],"lineRefs":[[],[]]},{"para":1390,"vripara":null,"refs":[],"lines":["Suppārakajātakavaṇṇanā navamā."],"lineRefs":[[]]},{"para":1391,"vripara":null,"refs":[],"lines":["Jātakuddānaṃ –"],"lineRefs":[[]]},{"para":1392,"vripara":null,"refs":[],"lines":["Mātuposaka juṇho ca, dhamma udaya pānīyo;"],"lineRefs":[[]]},{"para":1393,"vripara":null,"refs":[],"lines":["Yudhañcayo dasaratho, saṃvaro ca suppārako;"],"lineRefs":[[]]},{"para":1394,"vripara":null,"refs":[],"lines":["Ekādasanipātamhi, saṅgītā nava jātakā."],"lineRefs":[[]]},{"para":1395,"vripara":null,"refs":[],"lines":["Ekādasakanipātavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1396,"vripara":null,"refs":[],"lines":["Dvādasakanipāto"],"lineRefs":[[]]},{"para":1398,"vripara":null,"refs":[],"lines":["[464]1. Cūḷakuṇālajātakavaṇṇanā"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
