{"suttaId":"vv49","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1875,1888],"vripara":"819"},"segments":{"vv49:0.4":"Vandanavimānavatthu","vv49:1.1":"“Abhikkantena vaṇṇena,","vv49:1.2":"yā tvaṃ tiṭṭhasi devate;","vv49:1.3":"Obhāsentī disā sabbā,","vv49:1.4":"osadhī viya tārakā.","vv49:2.1":"“Kena tetādiso vaṇṇo … pe.","vv49:2.3":"Vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv49:3.1":"Sā devatā attamanā … pe …","vv49:3.3":"yassa kammassidaṃ phalaṃ.","vv49:4.1":"“Ahaṃ manussesu manussabhūtā,","vv49:4.2":"disvāna samaṇe sīlavante;","vv49:4.3":"Pādāni vanditvā manaṃ pasādayiṃ,","vv49:4.4":"vittā cahaṃ añjalikaṃ akāsiṃ.","vv49:5.1":"“Tena metādiso vaṇṇo … pe …","vv49:5.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv49:6.1":"Vandanavimānaṃ ekādasamaṃ."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2204,"to":2204,"paras":[{"para":2204,"vripara":"823","refs":["vv49:4"],"lines":["Tattha <b>samaṇe</b>ti samitapāpe.","<b>Sīlavante</b>ti sīlaguṇayutte.","<b>Manaṃ pasādayin</b>ti “sādhurūpā vatime ayyā dhammacārino samacārino brahmacārino”ti tesaṃ guṇe ārabbha cittaṃ pasādesiṃ.","<b>Vittā cahaṃ añjalikaṃ akāsin</b>ti tuṭṭhā somanassajātā ahaṃ vandiṃ.","Pesalānaṃ bhikkhūnaṃ pasādavikasitāni akkhīni ummīletvā dassanamattampi imesaṃ sattānaṃ bahūpakāraṃ, pageva vandanāti.","Tenāha <b>“tena metādiso vaṇṇo”</b>tiādi.","Sesaṃ vuttanayameva."],"lineRefs":[["vv49:4"],["vv49:4"],["vv49:4"],["vv49:4"],["vv49:4"],["vv49:4"],["vv49:4"]]}],"wordLinks":[["vv49:4.1","samaṇe",0,0],["vv49:4.1","sīlavante",0,1],["vv49:4.3","manaṃ pasādayiṃ",0,2],["vv49:4.3","vittā cahaṃ añjalikaṃ akāsiṃ",0,3]],"before":[{"para":2196,"vripara":"819","refs":[],"lines":["“Abhikkantena vaṇṇena … pe … vaṇṇo ca te sabbadisā pabhāsatī”ti."],"lineRefs":[[]]},{"para":2197,"vripara":"822","refs":[],"lines":["“Sā devatā attamanā … pe … yassa kammassidaṃ phalaṃ”."],"lineRefs":[[]]},{"para":2199,"vripara":"823","refs":[],"lines":["