{"suttaId":"ja272","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1988,1997],"vripara":"64"},"segments":{"ja272:0.4":"Byagghajātakaṃ (3-3-2)","ja272:1.1":"Yena mittena saṃsaggā, yogakkhemo vihiyyati;","ja272:1.3":"Pubbevajjhābhavaṃ tassa, rukkhe akkhīva paṇḍito.","ja272:2.1":"Yena mittena saṃsaggā, yogakkhemo pavaḍḍhati;","ja272:2.3":"Kareyyattasamaṃ vuttiṃ, sabbakiccesu paṇḍito.","ja272:3.1":"Etha byagghā nivattavho, paccupetha [paccametha (sī. pī.)] mahāvanaṃ;","ja272:3.3":"Mā vanaṃ chindi nibyagghaṃ, byagghā māhesu nibbanāti.","ja272:4.1":"Byagghajātakaṃ dutiyaṃ."},"attha":null,"tika":null}
