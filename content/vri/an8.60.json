{"suttaId":"an8.60","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-viii","vriCode":"s0404m1.mul","paras":[774,782],"vripara":"60"},"segments":{"an8.60:0.3":"Dutiyapuggalasuttaṃ","an8.60:1.1":"“Aṭṭhime, bhikkhave, puggalā āhuneyyā … pe … anuttaraṃ puññakkhettaṃ lokassa.","an8.60:1.2":"Katame aṭṭha?","an8.60:1.3":"Sotāpanno, sotāpattiphalasacchikiriyāya paṭipanno … pe … arahā, arahattāya paṭipanno.","an8.60:1.4":"Ime kho, bhikkhave, aṭṭha puggalā āhuneyyā … pe … anuttaraṃ puññakkhettaṃ lokassā”ti.","an8.60:2.1":"“Cattāro ca paṭipannā,","an8.60:2.2":"cattāro ca phale ṭhitā;","an8.60:2.3":"Esa saṅgho samukkaṭṭho,","an8.60:2.4":"sattānaṃ aṭṭha puggalā.","an8.60:3.1":"“Yajamānānaṃ manussānaṃ,","an8.60:3.2":"puññapekkhāna pāṇinaṃ;","an8.60:3.3":"Karotaṃ opadhikaṃ puññaṃ,","an8.60:3.4":"ettha dinnaṃ mahapphalan”ti.","an8.60:3.5":"dasamaṃ;","an8.60:3.6":"Gotamīvaggo paṭhamo.","an8.60:4.0":"Tassuddānaṃ –","an8.60:4.1":"Gotamī ovādaṃ saṃkhittaṃ,","an8.60:4.2":"dīghajāṇu ca ujjayo;","an8.60:4.3":"Bhayā dve āhuneyyā ca,","an8.60:4.4":"dve ca aṭṭha puggalāti."},"unsure":[],"attha":{"book":"Mp-viii","bookName":"Aṭṭhakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":197,"to":200,"paras":[{"para":197,"vripara":"59-60","refs":["an8.60:1"],"lines":["59-60. Navame <b>ujubhūto</b>ti kāyavaṅkādīnaṃ abhāvena ujuko.","<b>Paññāsīlasamāhito</b>ti paññāya ca sīlena ca samannāgato.","<b>Yajamānānan</b>ti dānaṃ dadantānaṃ.","<b>Puññapekkhānan</b>ti puññaṃ olokentānaṃ gavesantānaṃ.","<b>Opadhikan</b>ti upadhivipākaṃ, opadhibhūtaṃ ṭhānaṃ appamāṇaṃ.","Dasame <b>samukkaṭṭho</b>ti ukkaṭṭho uttamo.","<b>Sattānan</b>ti sabbasattānaṃ.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["an8.60:1"],["an8.60:1"],["an8.60:1"],["an8.60:1"],["an8.60:1"],["an8.60:1"],["an8.60:1"],["an8.60:1"]]},{"para":198,"vripara":null,"refs":["an8.60:1"],"lines":["Gotamīvaggo chaṭṭho."],"lineRefs":[["an8.60:1"]]},{"para":199,"vripara":null,"refs":["an8.60:1"],"lines":["(7)2. Bhūmicālavaggo"],"lineRefs":[["an8.60:1"]]},{"para":200,"vripara":null,"refs":["an8.60:1"],"lines":["Icchāsuttavaṇṇanā"],"lineRefs":[["an8.60:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-viii","bookName":"Aṭṭhakanipāta-ṭīkā","vriCode":"s0404t.tik","from":195,"to":199,"paras":[{"para":195,"vripara":"59-60","refs":["an8.60:1"],"lines":["59-60. Navame <b>dānaṃ dadantānan</b>ti dakkhiṇeyyaṃ uddissa dānaṃ dentānaṃ.","Upadhī vipaccanti etena, upadhīsu vā vipaccati, upadhayo vā vipākā etassāti <b>upadhivipākaṃ.</b>","<b>Saṅghe dinnaṃ mahapphalan</b>ti ariyasaṅghe dinnaṃ vipphāraṭṭhānaṃ hoti, vipulaphalanti attho.","Dasame natthi vattabbaṃ."],"lineRefs":[["an8.60:1"],["an8.60:1"],["an8.60:1"],["an8.60:1"]]},{"para":196,"vripara":null,"refs":["an8.60:1"],"lines":["Puggalasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an8.60:1"]]},{"para":197,"vripara":null,"refs":["an8.60:1"],"lines":["Gotamīvaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an8.60:1"]]},{"para":198,"vripara":null,"refs":["an8.60:1"],"lines":["(7)2. Bhūmicālavaggo"],"lineRefs":[["an8.60:1"]]},{"para":199,"vripara":null,"refs":["an8.60:1"],"lines":["1-5. Icchāsuttādivaṇṇanā"],"lineRefs":[["an8.60:1"]]}],"wordLinks":[]},"tika2":null}
