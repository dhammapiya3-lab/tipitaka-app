{"suttaId":"thag1.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[97,101],"vripara":"16"},"segments":{"thag1.16:0.4":"Belaṭṭhasīsattheragāthā","thag1.16:1.1":"“Yathāpi bhaddo ājañño, naṅgalāvattanī sikhī;","thag1.16:1.3":"Gacchati appakasirena, evaṃ rattindivā mama;","thag1.16:1.5":"Gacchanti appakasirena, sukhe laddhe nirāmise”ti.","thag1.16:1.7":"… Belaṭṭhasīso thero …."},"attha":null,"tika":null}
