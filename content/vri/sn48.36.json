{"suttaId":"sn48.36","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1257,1262],"vripara":"506"},"segments":{"sn48.36:0.3":"Paṭhamavibhaṅgasuttaṃ","sn48.36:1.1":"“Pañcimāni, bhikkhave, indriyāni.","sn48.36:1.2":"Katamāni pañca?","sn48.36:1.3":"Sukhindriyaṃ, dukkhindriyaṃ, somanassindriyaṃ, domanassindriyaṃ, upekkhindriyaṃ.","sn48.36:2.1":"“Katamañca, bhikkhave, sukhindriyaṃ?","sn48.36:2.2":"Yaṃ kho, bhikkhave, kāyikaṃ sukhaṃ, kāyikaṃ sātaṃ, kāyasamphassajaṃ sukhaṃ sātaṃ vedayitaṃ –","sn48.36:2.3":"idaṃ vuccati, bhikkhave, sukhindriyaṃ.","sn48.36:3.1":"“Katamañca, bhikkhave, dukkhindriyaṃ?","sn48.36:3.2":"Yaṃ kho, bhikkhave, kāyikaṃ dukkhaṃ, kāyikaṃ asātaṃ, kāyasamphassajaṃ dukkhaṃ asātaṃ vedayitaṃ –","sn48.36:3.3":"idaṃ vuccati, bhikkhave, dukkhindriyaṃ.","sn48.36:4.1":"“Katamañca, bhikkhave, somanassindriyaṃ?","sn48.36:4.2":"Yaṃ kho, bhikkhave, cetasikaṃ sukhaṃ, cetasikaṃ sātaṃ, manosamphassajaṃ sukhaṃ sātaṃ vedayitaṃ –","sn48.36:4.3":"idaṃ vuccati, bhikkhave, somanassindriyaṃ.","sn48.36:5.1":"“Katamañca, bhikkhave, domanassindriyaṃ?","sn48.36:5.2":"Yaṃ kho, bhikkhave, cetasikaṃ dukkhaṃ, cetasikaṃ asātaṃ, manosamphassajaṃ dukkhaṃ asātaṃ vedayitaṃ –","sn48.36:5.3":"idaṃ vuccati, bhikkhave, domanassindriyaṃ.","sn48.36:6.1":"“Katamañca, bhikkhave, upekkhindriyaṃ?","sn48.36:6.2":"Yaṃ kho, bhikkhave, kāyikaṃ vā cetasikaṃ vā nevasātaṃ nāsātaṃ vedayitaṃ –","sn48.36:6.3":"idaṃ vuccati, bhikkhave, upekkhindriyaṃ.","sn48.36:6.4":"Imāni kho, bhikkhave, pañcindriyānī”ti.","sn48.36:6.5":"Chaṭṭhaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":582,"to":582,"paras":[{"para":582,"vripara":"506","refs":["sn48.36:2","sn48.36:6"],"lines":["Chaṭṭhe <b>kāyikan</b>ti kāyapasādavatthukaṃ.","<b>Sukhan</b>ti ayamassa sarūpaniddeso.","<b>Sātan</b>ti tasseva vevacanaṃ, madhuranti vuttaṃ hoti.","<b>Kāyasamphassajan</b>ti kāyasamphassato jātaṃ.","<b>Sukhaṃ sātan</b>ti vuttanayameva.","<b>Vedayitan</b>ti ayamassa sabbavedanāsādhāraṇo aññadhammavisiṭṭho sabhāvaniddeso.","Iminā nayena sesesupi attho veditabbo.","<b>Kāyikaṃ vā cetasikaṃ vā</b>ti ettha pana cakkhādayo cattāro pasādakāye vatthuṃ katvā uppattivasena kāyikanti vuttaṃ.","Kāyapasādavatthukaṃ pana adukkhamasukhaṃ nāma natthi."],"lineRefs":[["sn48.36:2"],["sn48.36:2"],["sn48.36:2"],["sn48.36:2"],["sn48.36:2"],["sn48.36:2"],["sn48.36:2"],["sn48.36:6"],["sn48.36:6"]]}],"wordLinks":[["sn48.36:2.2","kāyikaṃ",0,0],["sn48.36:2.2","sukhaṃ",0,1],["sn48.36:2.2","sātaṃ",0,2],["sn48.36:2.2","kāyasamphassajaṃ",0,3],["sn48.36:2.2","sukhaṃ sātaṃ",0,4],["sn48.36:2.2","vedayitaṃ",0,5],["sn48.36:6.2","kāyikaṃ vā cetasikaṃ vā",0,7]]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":504,"to":504,"paras":[{"para":504,"vripara":"506","refs":["sn48.36:2","sn48.36:4"],"lines":["<b>Kāyikan</b>ti ayamassa nissayavasena niddesoti āha –","<b>“kāyapasādavatthukan”</b>ti.","<b>Sarūpaniddeso</b> sukhaṃ sukhindriyassa sarūpanti.","Sādanīyaṭṭhena dhammapadāni attani assādayatīti <b>sātaṃ,</b> madhuraṃ.","<b>Vedayitan</b>ti vediyanaṃ, anubhavananti attho.","<b>Aññadhammavisiṭṭho</b>ti phassādīhi aññehi dhammehi visadiso.","<b>Kāyikan</b>ti pasādakāyasannissitaṃ.","<b>Cetasikan</b>ti cetosannissitaṃ, tena vuttaṃ <b>“ettha panā”</b>tiādi.","<b>Kāyapasāda … pe … natthi,</b> tasmā <b>“cattāro pasādakāye vatthuṃ katvā”</b>ti vuttaṃ."],"lineRefs":[["sn48.36:2"],["sn48.36:2"],["sn48.36:2"],["sn48.36:2"],["sn48.36:2"],["sn48.36:2"],["sn48.36:2"],["sn48.36:4"],["sn48.36:4"]]}],"wordLinks":[["sn48.36:2.2","kāyikaṃ",0,0],["sn48.36:2.2","sātaṃ",0,3],["sn48.36:2.2","vedayitaṃ",0,4],["sn48.36:2.2","kāyikaṃ",0,6],["sn48.36:4.2","cetasikaṃ",0,7]]},"tika2":null}
