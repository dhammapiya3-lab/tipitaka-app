{"suttaId":"an5.182","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1259,1259],"vripara":"182"},"segments":{"an5.182:0.3":"Cīvarasuttaṃ","an5.182:1.1":"“Pañcime, bhikkhave, paṃsukūlikā.","an5.182:1.2":"Katame pañca?","an5.182:1.3":"Mandattā momūhattā paṃsukūliko hoti … pe … idamatthitaṃyeva nissāya paṃsukūliko hoti.","an5.182:1.4":"Ime kho, bhikkhave, pañca paṃsukūlikā”ti.","an5.182:1.5":"Dutiyaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
