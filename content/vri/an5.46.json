{"suttaId":"an5.46","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[354,354],"vripara":"46"},"segments":{"an5.46:0.3":"Sampadāsuttaṃ","an5.46:1.1":"“Pañcimā, bhikkhave, sampadā.","an5.46:1.2":"Katamā pañca?","an5.46:1.3":"Saddhāsampadā, sīlasampadā, sutasampadā, cāgasampadā, paññāsampadā – imā kho, bhikkhave, pañca sampadā”ti.","an5.46:1.5":"Chaṭṭhaṃ."},"attha":null,"tika":null}
