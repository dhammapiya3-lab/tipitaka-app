{"suttaId":"sn46.25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[538,538],"vripara":"206"},"segments":{"sn46.25:0.3":"Aparihāniyasuttaṃ","sn46.25:1.1":"“Satta vo, bhikkhave, aparihāniye dhamme desessāmi;","sn46.25:1.2":"taṃ suṇātha.","sn46.25:1.3":"Katame ca, bhikkhave, satta aparihāniyā dhammā?","sn46.25:1.4":"Yadidaṃ –","sn46.25:1.5":"satta bojjhaṅgā.","sn46.25:1.6":"Katame satta?","sn46.25:1.7":"Satisambojjhaṅgo…pe… upekkhāsambojjhaṅgo –","sn46.25:1.8":"ime kho, bhikkhave, satta aparihāniyā dhammā”ti.","sn46.25:1.9":"Pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":185,"to":186,"paras":[{"para":185,"vripara":"204-206","refs":["sn46.25:1"],"lines":["Tatiye <b>kāmarāgaṭṭhāniyāna</b>nti kāmarāgassa kāraṇabhūtānaṃ ārammaṇadhammānaṃ.","<b>Byāpādaṭṭhāniyā</b>dīsupi eseva nayo.","Sakalañhi idaṃ suttaṃ ārammaṇeneva kathitaṃ.","Paṭhamavaggassa dutiyasutte vuttaparicchedopettha labbhateva.","Catutthe missakabojjhaṅgā kathitā.","Pañcame <b>aparihāniye dhamme</b>ti aparihānikare sabhāvadhamme. 6-7."],"lineRefs":[["sn46.25:1"],["sn46.25:1"],["sn46.25:1"],["sn46.25:1"],["sn46.25:1"],["sn46.25:1"]]},{"para":186,"vripara":null,"refs":["sn46.25:1"],"lines":["Taṇhakkhayasuttādivaṇṇanā 207-208."],"lineRefs":[["sn46.25:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":190,"to":191,"paras":[{"para":190,"vripara":"204-206","refs":["sn46.25:1"],"lines":["Kāmarāgena gadhitabbaṭṭhānabhūtā kāmarāgaṭṭhāniyāti āha <b>“ārammaṇadhammāna”</b>nti.","“Manasikārabahulīkārā”ti vuttattā <b>“ārammaṇeneva kathita”</b>nti vuttaṃ.","<b>Vuttaparicchedo</b>ti etena na kevalaṃ ārammaṇavaseneva, atha kho upanissayavasenapettha attho labbhatīti dasseti.","Paṭhamavaggassa hi dutiye sutte upanissayavaseneva attho dassito.","<b>Missakabojjhaṅgā kathitā</b> avibhāgeneva kathitattā.","<b>Aparihāniye</b>ti tīhi sikkhāhi aparihānāvahe. 6-7."],"lineRefs":[["sn46.25:1"],["sn46.25:1"],["sn46.25:1"],["sn46.25:1"],["sn46.25:1"],["sn46.25:1"]]},{"para":191,"vripara":null,"refs":["sn46.25:1"],"lines":["Taṇhakkhayasuttādivaṇṇanā 207-208."],"lineRefs":[["sn46.25:1"]]}],"wordLinks":[]},"tika2":null}
