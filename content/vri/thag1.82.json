{"suttaId":"thag1.82","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[478,481],"vripara":"82"},"segments":{"thag1.82:0.4":"Kassapattheragāthā","thag1.82:1.1":"“Yena yena subhikkhāni,","thag1.82:1.2":"sivāni abhayāni ca;","thag1.82:1.3":"Tena puttaka gacchassu,","thag1.82:1.4":"mā sokāpahato bhavā”ti.","thag1.82:1.5":"… Kassapo thero …."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2122,"to":2122,"paras":[{"para":2122,"vripara":null,"refs":["thag1.82:1"],"lines":["Tattha <b>yena yenā</b>ti yattha yattha.","Bhummatthe hi etaṃ karaṇavacanaṃ, yasmiṃ yasmiṃ disābhāgeti attho.","<b>Subhikkhānī</b>ti sulabhapiṇḍāni, raṭṭhānīti adhippāyo.","<b>Sivānī</b>ti khemāni arogāni.","<b>Abhayānī</b>ti corabhayādīhi nibbhayāni, rogadubbhikkhabhayāni pana “subhikkhāni, sivānī”ti padadvayeneva gahitāni.","<b>Tenā</b>ti tattha, tasmiṃ tasmiṃ disābhāgeti attho.","<b>Puttakā</b>ti anukampantī taṃ ālapati.","<b>Mā</b>ti paṭisedhatthe nipāto <b>sokāpahato</b>ti vuttaguṇarahitāni raṭṭhāni gantvā dubbhikkhabhayādijanitena sokena upahato mā <b>bhava</b> māhosīti attho.","Taṃ sutvā thero,“mama mātā mayhaṃ sokarahitaṭṭhānagamanaṃ āsīsati, handa mayaṃ sabbaso accantameva sokarahitaṃ ṭhānaṃ pattuṃ yuttan”ti ussāhajāto vipassanaṃ paṭṭhapetvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.13.1-9)–"],"lineRefs":[["thag1.82:1"],["thag1.82:1"],["thag1.82:1"],["thag1.82:1"],["thag1.82:1"],["thag1.82:1"],["thag1.82:1"],["thag1.82:1"],["thag1.82:1"],["thag1.82:1"]]}],"wordLinks":[["thag1.82:1.1","yena yenā",0,0],["thag1.82:1.1","subhikkhānī",0,2],["thag1.82:1.1","sivānī",0,3],["thag1.82:1.1","abhayānī",0,4],["thag1.82:1.3","tenā",0,5],["thag1.82:1.3","puttakā",0,6],["thag1.82:1.3","bhava",0,7],["thag1.82:1.3","mā",0,7],["thag1.82:1.3","sokāpahato",0,7]],"before":[{"para":2117,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Kassapattheragāthāvaṇṇanā"]},{"para":2118,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["<b>Yena yena subhikkhānī</b>ti āyasmato kassapattherassa gāthā.","Kā uppatti?","Ayaṃ kira padumuttarassa bhagavato kāle brāhmaṇakule nibbattitvā tīsu vedesu aññesu ca brāhmaṇasippesu nipphattiṃ gato, so ekadivasaṃ bhagavantaṃ disvā pasannamānaso sumanapupphehi pūjaṃ akāsi.","Karonto ca satthu samantato upari ca pupphamuṭṭhiyo khipi.","Buddhānubhāvena pupphāni pupphāsanākārena sattāhaṃ aṭṭhaṃsu.","So taṃ acchariyaṃ disvā bhiyyosomattāya pasannamānaso ahosi.","Aparāparaṃ puññāni karonto kappasatasahassaṃ sugatīsuyeva saṃsaranto imasmiṃ buddhuppāde sāvatthiyaṃ aññatarassa udiccabrāhmaṇassa putto hutvā nibbatti, <b>kassapo</b>tissa nāmaṃ ahosi.","Tassa daharakāleyeva pitā kālamakāsi.","Mātā taṃ paṭijaggati.","So ekadivasaṃ jetavanaṃ gato bhagavato dhammadesanaṃ sutvā hetusampannatāya tasmiṃyeva āsane sotāpanno hutvā mātu santikaṃ gantvā anujānāpetvā pabbajito satthari vuṭṭhavasse pavāretvā janapadacārikaṃ pakkante sayampi satthārā saddhiṃ gantukāmo āpucchituṃ mātu santikaṃ agamāsi.","Mātā vissajjentī ovādavasena –"]},{"para":2120,"vripara":"82","title":"Kassapattheragāthāvaṇṇanā","lines":["“Yena yena subhikkhāni, sivāni abhayāni ca;"]},{"para":2121,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Tena puttaka gacchassu, mā sokāpahato bhavā”ti.","– gāthaṃ abhāsi;"]}],"after":[{"para":2123,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["“Ajjhāyako mantadharo, tiṇṇaṃ vedāna pāragū;"]},{"para":2124,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Abbhokāse ṭhito santo, addasaṃ lokanāyakaṃ."]},{"para":2125,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["“Sīhaṃ yathā vanacaraṃ, byaggharājaṃva nittasaṃ;"]},{"para":2126,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Tidhāpabhinnamātaṅgaṃ, kuñjaraṃva mahesinaṃ."]},{"para":2127,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["“Sereyakaṃ gahetvāna, ākāse ukkhipiṃ ahaṃ;"]},{"para":2128,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Buddhassa ānubhāvena, parivārenti sabbaso."]},{"para":2129,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["“Adhiṭṭhahi mahāvīro, sabbaññū lokanāyako;"]},{"para":2130,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Samantā pupphacchadanā, okiriṃsu narāsabhaṃ."]},{"para":2131,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["“Tato sā pupphakañcukā, antovaṇṭā bahimukhā;"]},{"para":2132,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Sattāhaṃ chadanaṃ katvā, tato antaradhāyatha."]},{"para":2133,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["“Tañca acchariyaṃ disvā, abbhutaṃ lomahaṃsanaṃ;"]},{"para":2134,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Buddhe cittaṃ pasādesiṃ, sugate lokanāyake."]},{"para":2135,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["“Tena cittappasādena, sukkamūlena codito;"]},{"para":2136,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Kappānaṃ satasahassaṃ, duggatiṃ nupapajjahaṃ."]},{"para":2137,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["“Pannarasasahassamhi, kappānaṃ pañcavīsati;"]},{"para":2138,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Vītamalāsanāmā ca, cakkavattī mahabbalā."]},{"para":2139,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."]},{"para":2140,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Arahattaṃ pana patvā “idameva mātu vacanaṃ arahattappattiyā aṅkusaṃ jātan”ti tameva gāthaṃ paccudāhāsi."]},{"para":2141,"vripara":null,"title":"Kassapattheragāthāvaṇṇanā","lines":["Kassapattheragāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
