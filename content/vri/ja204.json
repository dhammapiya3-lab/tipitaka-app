{"suttaId":"ja204","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1328,1334],"vripara":"107"},"segments":{"ja204:0.4":"Vīrakajātakaṃ (2-6-4)","ja204:1.1":"Api vīraka passesi, sakuṇaṃ mañjubhāṇakaṃ;","ja204:1.3":"Mayūragīvasaṅkāsaṃ, patiṃ mayhaṃ saviṭṭhakaṃ.","ja204:2.1":"Udakathalacarassa pakkhino, niccaṃ āmakamacchabhojino;","ja204:2.3":"Tassānukaraṃ saviṭṭhako, sevāle paliguṇṭhito matoti.","ja204:3.1":"Vīrakajātakaṃ catutthaṃ."},"attha":null,"tika":null}
