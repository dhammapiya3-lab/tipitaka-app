{"suttaId":"ja204","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1328,1334],"vripara":"107"},"segments":{"ja204:0.4":"Vīrakajātakaṃ (2-6-4)","ja204:1.1":"Api vīraka passesi, sakuṇaṃ mañjubhāṇakaṃ;","ja204:1.3":"Mayūragīvasaṅkāsaṃ, patiṃ mayhaṃ saviṭṭhakaṃ.","ja204:2.1":"Udakathalacarassa pakkhino, niccaṃ āmakamacchabhojino;","ja204:2.3":"Tassānukaraṃ saviṭṭhako, sevāle paliguṇṭhito matoti.","ja204:3.1":"Vīrakajātakaṃ catutthaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":934,"to":939,"paras":[{"para":934,"vripara":null,"refs":["ja204:1"],"lines":["Tattha <b>api, vīraka, passesī</b>ti, sāmi vīraka, api passasi.","<b>Mañjubhāṇakan</b>ti mañjubhāṇinaṃ.","Sā hi rāgavasena “madhurassaro me patī”ti maññati, tasmā evamāha.","<b>Mayūragīvasaṅkāsan</b>ti moragīvasamānavaṇṇaṃ."],"lineRefs":[["ja204:1"],["ja204:1"],["ja204:1"],["ja204:1"]]},{"para":935,"vripara":null,"refs":[],"lines":["Taṃ sutvā vīrako “āma, jānāmi te sāmikassa gataṭṭhānan”ti vatvā dutiyaṃ gāthamāha –"],"lineRefs":[[]]},{"para":937,"vripara":"108","refs":[],"lines":["“Udakathalacarassa pakkhino, niccaṃ āmakamacchabhojino;"],"lineRefs":[[]]},{"para":938,"vripara":null,"refs":[],"lines":["Tassānukaraṃ saviṭṭhako, sevāle paliguṇṭhito mato”ti."],"lineRefs":[[]]},{"para":939,"vripara":null,"refs":["ja204:2"],"lines":["Tattha <b>udakathalacarassā</b>ti udake ca thale ca carituṃ samatthassa.","<b>Pakkhino</b>ti attānaṃ sandhāya vadati.","<b>Tassānukaran</b>ti tassa anukaronto.","<b>Sevāle paliguṇṭhito mato</b>ti udakaṃ pavisitvā sevālaṃ chinditvā nikkhamituṃ asakkonto sevālapariyonaddho antoudakeyeva mato, passa, etassa tuṇḍaṃ dissatīti.","Taṃ sutvā kākī paridevitvā bārāṇasimeva agamāsi."],"lineRefs":[["ja204:2"],["ja204:2"],["ja204:2"],["ja204:2"],["ja204:2"]]}],"wordLinks":[["ja204:1.1","api vīraka passesī",0,0],["ja204:1.1","mañjubhāṇakaṃ",0,1],["ja204:1.3","mayūragīvasaṅkāsaṃ",0,3],["ja204:2.1","udakathalacarassā",4,0],["ja204:2.1","pakkhino",4,1],["ja204:2.3","tassānukaraṃ",4,2],["ja204:2.3","sevāle paliguṇṭhito mato",4,3]]},"tika":null}
