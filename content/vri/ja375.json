{"suttaId":"ja375","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[3530,3556],"vripara":"135"},"segments":{"ja375:0.4":"Kapotajātakaṃ (5-3-5)","ja375:1.1":"Idāni khomhi sukhito arogo,","ja375:1.2":"nikkaṇṭako nippatito kapoto;","ja375:1.3":"Kāhāmi dānī hadayassa tuṭṭhiṃ,","ja375:1.4":"tathāhimaṃ maṃsasākaṃ baleti.","ja375:2.1":"Kāyaṃ balākā sikhino, corī laṅghipitāmahā;","ja375:2.3":"Oraṃ balāke āgaccha,","ja375:2.4":"caṇḍo me vāyaso sakhā.","ja375:3.1":"Alañhi te jagghitāye,","ja375:3.2":"mamaṃ disvāna edisaṃ;","ja375:3.3":"Vilūnaṃ sūdaputtena,","ja375:3.4":"piṭṭhamaṇḍena [piṭṭhamaddena (sī. syā. pī.)] makkhitaṃ.","ja375:4.1":"Sunhāto suvilittosi,","ja375:4.2":"annapānena tappito;","ja375:4.3":"Kaṇṭhe ca te veḷuriyo,","ja375:4.4":"agamā nu kajaṅgalaṃ.","ja375:5.1":"Mā te mitto amitto vā,","ja375:5.2":"agamāsi kajaṅgalaṃ;","ja375:5.3":"Piñchāni tattha lāyitvā,","ja375:5.4":"kaṇṭhe bandhanti vaṭṭanaṃ.","ja375:6.1":"Punapāpajjasī samma,","ja375:6.2":"sīlañhi tava tādisaṃ;","ja375:6.3":"Na hi mānusakā bhogā,","ja375:6.4":"subhuñjā honti pakkhināti.","ja375:7.1":"Kapotajātakaṃ pañcamaṃ.","ja375:7.2":"Aḍḍhavaggo tatiyo.","ja375:8.1":"Tassuddānaṃ –","ja375:9.1":"Atha vaṇṇa sasīla hiri labhate,","ja375:9.2":"sumukhā visa sāḷiyamittavaro;","ja375:9.3":"Atha cakka palāsa sarāja sato,","ja375:9.4":"yava bāla kapotaka pannarasāti.","ja375:10.1":"Atha vagguddānaṃ –","ja375:11.1":"Jīnañca vaṇṇaṃ asamaṃvaguppari,","ja375:11.2":"sudesitā jātakanti santi vīsati [jātaka pañcavīsati (?)];","ja375:11.3":"Mahesino brahmacarittamutta-","ja375:11.4":"mavoca gāthā atthavatī subyañjanāti.","ja375:12.1":"Pañcakanipātaṃ niṭṭhitaṃ."},"unsure":["ja375:2.1"],"preface":[],"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":1996,"to":2021,"paras":[{"para":1996,"vripara":null,"refs":["ja375:1"],"lines":["Tattha <b>nippatito</b>ti niggato.","<b>Kapoto</b>ti pārāvato.","<b>Kāhāmi dānī</b>ti karissāmi dāni.","<b>Tathā hi maṃ maṃsasākaṃ baletī</b>ti tathā hi maṃsañca avasesaṃ sākañca mayhaṃ balaṃ karoti, uṭṭhehi khādāti vadamānaṃ viya ussāhaṃ mamaṃ karotīti attho."],"lineRefs":[["ja375:1"],["ja375:1"],["ja375:1"],["ja375:1"]]},{"para":1997,"vripara":null,"refs":["ja375:1"],"lines":["So bhattakārake macchamaṃsaṃ pacitvā mahānasā nikkhamma sarīrato sedaṃ pavāhente pacchito nikkhamitvā rasakaroṭiyaṃ nilīyitvā “kiri kirī”ti saddamakāsi.","Bhattakārako vegenāgantvā kākaṃ gahetvā sabbapattāni luñjitvā allasiṅgīverañca siddhatthake ca pisitvā lasuṇaṃ pūtitakkena madditvā sakalasarīraṃ makkhetvā ekaṃ kaṭhalaṃ ghaṃsitvā vijjhitvā suttakena tassa gīvāyaṃ bandhitvā nīḷapacchiyaṃyeva taṃ pakkhipitvā agamāsi.","Pārāvato āgantvā taṃ disvā “kā esā balākā mama sahāyassa pacchiyaṃ nipannā, caṇḍo hi so āgantvā ghāteyyāpi nan”ti parihāsaṃ karonto dutiyaṃ gāthamāha –"],"lineRefs":[["ja375:1"],["ja375:1"],["ja375:1"]]},{"para":1999,"vripara":"136","refs":["ja375:1"],"lines":["“Kāyaṃ balākā sikhinī, corī laṅghipitāmahā;"],"lineRefs":[["ja375:1"]]},{"para":2000,"vripara":null,"refs":["ja375:1"],"lines":["Oraṃ balāke āgaccha, caṇḍo me vāyaso sakhā”ti."],"lineRefs":[["ja375:1"]]},{"para":2001,"vripara":null,"refs":["ja375:1"],"lines":["Sā heṭṭhā (jā. aṭṭha.2.3.70) vuttatthāyeva."],"lineRefs":[["ja375:1"]]},{"para":2002,"vripara":null,"refs":["ja375:1"],"lines":["Taṃ sutvā kāko tatiyaṃ gāthamāha –"],"lineRefs":[["ja375:1"]]},{"para":2004,"vripara":"137","refs":["ja375:1"],"lines":["“Alañhi te jagghitāye, mamaṃ disvāna edisaṃ;"],"lineRefs":[["ja375:1"]]},{"para":2005,"vripara":null,"refs":["ja375:1"],"lines":["Vilūnaṃ sūdaputtena, piṭṭhamaṇḍena makkhitan”ti."],"lineRefs":[["ja375:1"]]},{"para":2006,"vripara":null,"refs":["ja375:3"],"lines":["Tattha <b>alan</b>ti paṭisedhatthe nipāto.","<b>Jagghitāye</b>ti hasituṃ.","Idaṃ vuttaṃ hoti – idāni maṃ edisaṃ evaṃ dukkhappattaṃ disvā tava alaṃ hasituṃ, mā edise kāle parihāsakeḷiṃ karohīti."],"lineRefs":[["ja375:3"],["ja375:3"],["ja375:3"]]},{"para":2007,"vripara":null,"refs":["ja375:3"],"lines":["So parihāsakeḷiṃ karontova puna catutthaṃ gāthamāha –"],"lineRefs":[["ja375:3"]]},{"para":2009,"vripara":"138","refs":["ja375:3"],"lines":["“Sunhāto suvilittosi, annapānena tappito;"],"lineRefs":[["ja375:3"]]},{"para":2010,"vripara":null,"refs":["ja375:3"],"lines":["Kaṇṭhe ca te veḷuriyo, agamā nu kajaṅgalan”ti."],"lineRefs":[["ja375:3"]]},{"para":2011,"vripara":null,"refs":["ja375:4"],"lines":["Tattha <b>kaṇṭhe ca te veḷuriyo</b>ti ayaṃ te veḷuriyamaṇipi kaṇṭhe piḷandho, tvaṃ ettakaṃ kālaṃ amhākaṃ etaṃ na dassesīti kapālaṃ sandhāyevamāha.","<b>Kajaṅgalan</b>ti idha bārāṇasīyeva “kajaṅgalā”ti adhippetā.","Ito nikkhamitvā kacci antonagaraṃ gatosīti pucchati."],"lineRefs":[["ja375:4"],["ja375:4"],["ja375:4"]]},{"para":2012,"vripara":null,"refs":["ja375:4"],"lines":["Tato kāko pañcamaṃ gāthamāha –"],"lineRefs":[["ja375:4"]]},{"para":2014,"vripara":"139","refs":["ja375:4"],"lines":["“Mā te mitto amitto vā, agamāsi kajaṅgalaṃ;"],"lineRefs":[["ja375:4"]]},{"para":2015,"vripara":null,"refs":["ja375:4"],"lines":["Piñchāni tattha lāyitvā, kaṇṭhe bandhanti vaṭṭanan”ti."],"lineRefs":[["ja375:4"]]},{"para":2016,"vripara":null,"refs":["ja375:5"],"lines":["Tattha <b>piñchānī</b>ti pattāni.","<b>Tattha lāyitvā</b>ti tasmiṃ bārāṇasinagare luñcitvā.","<b>Vaṭṭanan</b>ti kaṭhalikaṃ."],"lineRefs":[["ja375:5"],["ja375:5"],["ja375:5"]]},{"para":2017,"vripara":null,"refs":["ja375:5"],"lines":["Taṃ sutvā pārāvato osānagāthamāha –"],"lineRefs":[["ja375:5"]]},{"para":2019,"vripara":"140","refs":["ja375:5"],"lines":["“Punapāpajjasī samma, sīlañhi tava tādisaṃ;"],"lineRefs":[["ja375:5"]]},{"para":2020,"vripara":null,"refs":["ja375:5"],"lines":["Na hi mānusakā bhogā, subhuñjā honti pakkhinā”ti."],"lineRefs":[["ja375:5"]]},{"para":2021,"vripara":null,"refs":["ja375:6"],"lines":["Tattha <b>punapāpajjasī</b>ti punapi evarūpaṃ āpajjissasi.","Evarūpañhi te sīlanti."],"lineRefs":[["ja375:6"],["ja375:6"]]}],"wordLinks":[["ja375:1.1","nippatito",0,0],["ja375:1.1","kapoto",0,1],["ja375:1.3","kāhāmi dānī",0,2],["ja375:1.3","tathā hi maṃ maṃsasākaṃ baletī",0,3],["ja375:3.1","alaṃ",8,0],["ja375:3.1","jagghitāye",8,1],["ja375:4.3","kaṇṭhe ca te veḷuriyo",12,0],["ja375:4.3","kajaṅgalaṃ",12,1],["ja375:5.3","piñchānī",16,0],["ja375:5.3","tattha lāyitvā",16,1],["ja375:5.3","vaṭṭanaṃ",16,2],["ja375:6.1","punapāpajjasī",20,0]],"after":[{"para":2022,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Iti naṃ so ovaditvā tattha avasitvā pakkhe pasāretvā aññattha agamāsi.","Kākopi tattheva jīvitakkhayaṃ pāpuṇi."]},{"para":2023,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne lolabhikkhu anāgāmiphale patiṭṭhahi.","Tadā kāko lolabhikkhu ahosi, kapoto pana ahameva ahosinti."]},{"para":2024,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Kapotajātakavaṇṇanā pañcamā."]},{"para":2025,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Aḍḍhavaggo tatiyo."]},{"para":2026,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Jātakuddānaṃ –"]},{"para":2027,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Maṇikuṇḍala sujātā, venasākhañca oragaṃ;"]},{"para":2028,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Ghaṭaṃ koraṇḍi laṭuki, dhammapālaṃ migaṃ tathā."]},{"para":2029,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Suyonandī vaṇṇāroha, sīlaṃ hirī khajjopanaṃ;"]},{"para":2030,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Ahi gumbiya sāḷiyaṃ, tacasāraṃ mittavindaṃ."]},{"para":2031,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Palāsañceva dīghiti, migapotaka mūsikaṃ;"]},{"para":2032,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Dhanuggaho kapotañca, jātakā pañcavīsati."]},{"para":2033,"vripara":null,"title":"[375] 5. Kapotajātakavaṇṇanā","lines":["Pañcakanipātavaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
