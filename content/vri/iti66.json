{"suttaId":"iti66","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"It","vriCode":"s0504m.mul","paras":[603,607],"vripara":"66"},"segments":{"iti66:0.4":"Soceyyasuttaṃ","iti66:1.1":"Vuttañhetaṃ bhagavatā, vuttamarahatāti me sutaṃ –","iti66:2.1":"“Tīṇimāni, bhikkhave, soceyyāni.","iti66:2.2":"Katamāni tīṇi?","iti66:2.3":"Kāyasoceyyaṃ, vacīsoceyyaṃ, manosoceyyaṃ – imāni kho, bhikkhave, tīṇi soceyyānī”ti.","iti66:2.5":"Etamatthaṃ bhagavā avoca.","iti66:2.6":"Tatthetaṃ iti vuccati –","iti66:3.1":"“Kāyasuciṃ vacīsuciṃ [vācāsuciṃ (ka.)], cetosucimanāsavaṃ;","iti66:3.3":"Suciṃ soceyyasampannaṃ, āhu sabbappahāyinan”ti [āhu ninhātapāpakanti (a. ni.3.122) yuttataraṃ].","iti66:4.1":"Ayampi attho vutto bhagavatā, iti me sutanti.","iti66:4.2":"Sattamaṃ."},"attha":{"book":"It-a","bookName":"Itivuttaka-aṭṭhakathā","vriCode":"s0504a.att","from":1030,"to":1031,"paras":[{"para":1030,"vripara":"66","refs":["iti66:2"],"lines":["Sattame <b>soceyyānī</b>ti sucibhāvā.","<b>Kāyasoceyyan</b>ti kāyasucaritaṃ, vacīmanosoceyyānipi vacīmanosucaritāneva.","Tathā hi vuttaṃ “tattha katamaṃ kāyasoceyyaṃ?","Pāṇātipātā veramaṇī”tiādi (a. ni.3.121-122)."],"lineRefs":[["iti66:2"],["iti66:2"],["iti66:2"],["iti66:2"]]},{"para":1031,"vripara":null,"refs":["iti66:3"],"lines":["Gāthāyaṃ samucchedavasena pahīnasabbakāyaduccaritattā kāyena sucīti <b>kāyasuci.</b>","<b>Soceyyasampannan</b>ti paṭippassaddhakilesattā suparisuddhāya soceyyasampattiyā upetaṃ.","Sesaṃ vuttanayameva."],"lineRefs":[["iti66:3"],["iti66:3"],["iti66:3"]]}],"wordLinks":[["iti66:2.1","soceyyānī",0,0],["iti66:2.3","soceyyānī",0,0],["iti66:2.3","kāyasoceyyaṃ",0,1],["iti66:3.1","kāyasuci",1,0],["iti66:3.3","soceyyasampannaṃ",1,1]]},"tika":null}
