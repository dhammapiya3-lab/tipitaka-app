{"suttaId":"an7.29","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[167,184],"vripara":"29"},"segments":{"an7.29:0.3":"Dutiyaparihānisuttaṃ","an7.29:1.1":"“Sattime, bhikkhave, dhammā upāsakassa parihānāya saṃvattanti.","an7.29:1.2":"Katame satta?","an7.29:1.3":"Bhikkhudassanaṃ hāpeti,","an7.29:1.4":"saddhammassavanaṃ pamajjati,","an7.29:1.5":"adhisīle na sikkhati,","an7.29:1.6":"appasādabahulo hoti,","an7.29:1.7":"bhikkhūsu theresu ceva navesu ca majjhimesu ca upārambhacitto dhammaṃ suṇāti randhagavesī,","an7.29:1.8":"ito bahiddhā dakkhiṇeyyaṃ gavesati,","an7.29:1.9":"tattha ca pubbakāraṃ karoti.","an7.29:1.10":"Ime kho, bhikkhave, satta dhammā upāsakassa parihānāya saṃvattanti.","an7.29:2.1":"“Sattime, bhikkhave, dhammā upāsakassa aparihānāya saṃvattanti.","an7.29:2.2":"Katame satta?","an7.29:2.3":"Bhikkhudassanaṃ na hāpeti,","an7.29:2.4":"saddhammassavanaṃ nappamajjati,","an7.29:2.5":"adhisīle sikkhati,","an7.29:2.6":"pasādabahulo hoti,","an7.29:2.7":"bhikkhūsu theresu ceva navesu ca majjhimesu ca anupārambhacitto dhammaṃ suṇāti na randhagavesī,","an7.29:2.8":"na ito bahiddhā dakkhiṇeyyaṃ gavesati,","an7.29:2.9":"idha ca pubbakāraṃ karoti.","an7.29:2.10":"Ime kho, bhikkhave, satta dhammā upāsakassa aparihānāya saṃvattantī”ti.","an7.29:2.11":"Idamavoca bhagavā.","an7.29:2.12":"Idaṃ vatvāna sugato athāparaṃ etadavoca satthā –","an7.29:3.1":"“Dassanaṃ bhāvitattānaṃ,","an7.29:3.2":"yo hāpeti upāsako;","an7.29:3.3":"Savanañca ariyadhammānaṃ,","an7.29:3.4":"adhisīle na sikkhati.","an7.29:4.1":"“Appasādo ca bhikkhūsu,","an7.29:4.2":"bhiyyo bhiyyo pavaḍḍhati;","an7.29:4.3":"Upārambhakacitto ca,","an7.29:4.4":"saddhammaṃ sotumicchati.","an7.29:5.1":"“Ito ca bahiddhā aññaṃ,","an7.29:5.2":"dakkhiṇeyyaṃ gavesati;","an7.29:5.3":"Tattheva ca pubbakāraṃ,","an7.29:5.4":"yo karoti upāsako.","an7.29:6.1":"“Ete kho parihāniye,","an7.29:6.2":"satta dhamme sudesite;","an7.29:6.3":"Upāsako sevamāno,","an7.29:6.4":"saddhammā parihāyati.","an7.29:7.1":"“Dassanaṃ bhāvitattānaṃ,","an7.29:7.2":"yo na hāpeti upāsako;","an7.29:7.3":"Savanañca ariyadhammānaṃ,","an7.29:7.4":"adhisīle ca sikkhati.","an7.29:8.1":"“Pasādo cassa bhikkhūsu,","an7.29:8.2":"bhiyyo bhiyyo pavaḍḍhati;","an7.29:8.3":"Anupārambhacitto ca,","an7.29:8.4":"saddhammaṃ sotumicchati.","an7.29:9.1":"“Na ito bahiddhā aññaṃ,","an7.29:9.2":"dakkhiṇeyyaṃ gavesati;","an7.29:9.3":"Idheva ca pubbakāraṃ,","an7.29:9.4":"yo karoti upāsako.","an7.29:10.1":"“Ete kho aparihāniye,","an7.29:10.2":"satta dhamme sudesite;","an7.29:10.3":"Upāsako sevamāno,","an7.29:10.4":"saddhammā na parihāyatī”ti.","an7.29:10.5":"navamaṃ; 10."},"unsure":[],"preface":[],"attha":{"book":"Mp-vii","bookName":"Sattakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":863,"to":863,"paras":[{"para":863,"vripara":"29","refs":["an7.29:1"],"lines":["Navame <b>bhikkhudassanaṃ hāpetī</b>ti bhikkhusaṅghassa dassanatthāya gamanaṃ hāpeti.","<b>Adhisīle</b>ti pañcasīladasasīlasaṅkhāte uttamasīle.","<b>Ito bahiddhā</b>ti imamhā sāsanā bahiddhā.","<b>Dakkhiṇeyyaṃ gavesatī</b>ti deyyadhammapaṭiggāhake pariyesati.","<b>Tattha ca pubbakāraṃ karotī</b>ti tesaṃ bāhirānaṃ titthiyānaṃ datvā pacchā bhikkhūnaṃ deti.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["an7.29:1"],["an7.29:1"],["an7.29:1"],["an7.29:1"],["an7.29:1"],["an7.29:1"]]}],"wordLinks":[["an7.29:1.3","bhikkhudassanaṃ hāpetī",0,0],["an7.29:1.3","adhisīle",0,1],["an7.29:1.3","ito bahiddhā",0,2],["an7.29:1.3","dakkhiṇeyyaṃ gavesatī",0,3],["an7.29:1.3","tattha ca pubbakāraṃ karotī",0,4]],"before":[{"para":862,"vripara":null,"title":"Dutiyaparihānisuttavaṇṇanā","lines":["Dutiyaparihānisuttavaṇṇanā 29."]}],"after":[{"para":864,"vripara":null,"title":"Dutiyaparihānisuttavaṇṇanā","lines":["Vajjisattakavaggo tatiyo. 4."]}]},"tika":{"book":"Mp-t-vii","bookName":"Sattakanipāta-ṭīkā","vriCode":"s0403t.tik","from":859,"to":863,"paras":[{"para":859,"vripara":"27-31","refs":["an7.29:1"],"lines":["Sattame aniccāti anupassati etāyāti <b>aniccānupassanā</b>.","Tathāpavattavipassanā pana yasmā attanā sahagatasaññāya bhāvitāya bhāvitā eva hoti, tasmā vuttaṃ <b>“aniccānupassanādīhi sahagatasaññā”</b>ti.","Imā satta lokiyavipassanāpi honti “anicca”ntiādinā pavattanato.","“Etaṃ santaṃ etaṃ paṇītaṃ yadidaṃ sabbasaṅkhārasamatho”ti āgatavasena panettha dve lokuttarā hontīti veditabbā.","“Virāgo nirodho”ti hi tattha nibbānaṃ vuttanti idha virāgasaññā, tā vuttasaññā nibbānārammaṇāpi siyuṃ.","Sesamettha suviññeyyameva.","Aṭṭhamādīni uttānatthāneva."],"lineRefs":[["an7.29:1"],["an7.29:1"],["an7.29:1"],["an7.29:1"],["an7.29:1"],["an7.29:1"],["an7.29:1"]]},{"para":860,"vripara":null,"refs":["an7.29:1"],"lines":["Saññāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an7.29:1"]]},{"para":861,"vripara":null,"refs":["an7.29:1"],"lines":["Vajjisattakavaggavaṇṇanā niṭṭhitā. 4."],"lineRefs":[["an7.29:1"]]},{"para":862,"vripara":null,"refs":["an7.29:1"],"lines":["Devatāvaggo 5."],"lineRefs":[["an7.29:1"]]},{"para":863,"vripara":null,"refs":["an7.29:1"],"lines":["Paṭhamamittasuttavaṇṇanā 36."],"lineRefs":[["an7.29:1"]]}],"wordLinks":[]},"tika2":null}
