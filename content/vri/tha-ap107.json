{"suttaId":"tha-ap107","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5234,5249],"vripara":"24"},"segments":{"tha-ap107:0.3":"Muṭṭhipupphiyattheraapadānaṃ","tha-ap107:1.1":"“Sudassanoti nāmena, mālākāro ahaṃ tadā;","tha-ap107:1.3":"Addasaṃ virajaṃ buddhaṃ, lokajeṭṭhaṃ narāsabhaṃ.","tha-ap107:2.1":"“Jātipupphaṃ gahetvāna, pūjayiṃ padumuttaraṃ;","tha-ap107:2.3":"Visuddhacakkhu sumano, dibbacakkhuṃ samajjhagaṃ.","tha-ap107:3.1":"“Etissā pupphapūjāya, cittassa paṇidhīhi ca;","tha-ap107:3.3":"Kappānaṃ satasahassaṃ, duggatiṃ nupapajjahaṃ.","tha-ap107:4.1":"“Soḷasāsiṃsu rājāno, devuttarasanāmakā;","tha-ap107:4.3":"Chattiṃsamhi ito kappe, cakkavattī mahabbalā.","tha-ap107:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap107:6.1":"Itthaṃ sudaṃ āyasmā muṭṭhipupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap107:7.1":"Muṭṭhipupphiyattherassāpadānaṃ pañcamaṃ."},"attha":null,"tika":null,"tika2":null}
