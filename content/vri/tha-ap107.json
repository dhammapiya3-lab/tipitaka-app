{"suttaId":"tha-ap107","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5234,5249],"vripara":"24"},"segments":{"tha-ap107:0.3":"Muṭṭhipupphiyattheraapadānaṃ","tha-ap107:1.1":"“Sudassanoti nāmena,","tha-ap107:1.2":"mālākāro ahaṃ tadā;","tha-ap107:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap107:1.4":"lokajeṭṭhaṃ narāsabhaṃ.","tha-ap107:2.1":"“Jātipupphaṃ gahetvāna,","tha-ap107:2.2":"pūjayiṃ padumuttaraṃ;","tha-ap107:2.3":"Visuddhacakkhu sumano,","tha-ap107:2.4":"dibbacakkhuṃ samajjhagaṃ.","tha-ap107:3.1":"“Etissā pupphapūjāya,","tha-ap107:3.2":"cittassa paṇidhīhi ca;","tha-ap107:3.3":"Kappānaṃ satasahassaṃ,","tha-ap107:3.4":"duggatiṃ nupapajjahaṃ.","tha-ap107:4.1":"“Soḷasāsiṃsu rājāno,","tha-ap107:4.2":"devuttarasanāmakā;","tha-ap107:4.3":"Chattiṃsamhi ito kappe,","tha-ap107:4.4":"cakkavattī mahabbalā.","tha-ap107:5.1":"“Paṭisambhidā catasso … pe …","tha-ap107:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap107:6.1":"Itthaṃ sudaṃ āyasmā muṭṭhipupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap107:7.1":"Muṭṭhipupphiyattherassāpadānaṃ pañcamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
