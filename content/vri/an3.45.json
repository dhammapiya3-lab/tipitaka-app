{"suttaId":"an3.45","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[361,365],"vripara":"45"},"segments":{"an3.45:0.3":"Paṇḍitasuttaṃ","an3.45:1.1":"“Tīṇimāni, bhikkhave, paṇḍitapaññattāni sappurisapaññattāni.","an3.45:1.2":"Katamāni tīṇi?","an3.45:1.3":"Dānaṃ, bhikkhave, paṇḍitapaññattaṃ sappurisapaññattaṃ.","an3.45:1.4":"Pabbajjā, bhikkhave, paṇḍitapaññattā sappurisapaññattā.","an3.45:1.5":"Mātāpitūnaṃ, bhikkhave, upaṭṭhānaṃ paṇḍitapaññattaṃ sappurisapaññattaṃ.","an3.45:1.6":"Imāni kho, bhikkhave, tīṇi paṇḍitapaññattāni sappurisapaññattānī”ti.","an3.45:2.1":"“Sabbhi dānaṃ upaññattaṃ,","an3.45:2.2":"ahiṃsā saṃyamo damo;","an3.45:2.3":"Mātāpitu upaṭṭhānaṃ,","an3.45:2.4":"santānaṃ brahmacārinaṃ.","an3.45:3.1":"“Sataṃ etāni ṭhānāni,","an3.45:3.2":"yāni sevetha paṇḍito;","an3.45:3.3":"Ariyo dassanasampanno,","an3.45:3.4":"sa lokaṃ bhajate sivan”ti.","an3.45:3.5":"pañcamaṃ;"},"unsure":[],"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":568,"to":568,"paras":[{"para":568,"vripara":"45","refs":["an3.45:1","an3.45:2","an3.45:3"],"lines":["Pañcame <b>paṇḍitapaññattānī</b>ti paṇḍitehi paññattāni kathitāni pasatthāni.","<b>Sappurisapaññattānī</b>ti sappurisehi mahāpurisehi paññattāni kathitāni pasatthāni.","<b>Ahiṃsā</b>ti karuṇā ceva karuṇāpubbabhāgo ca.","<b>Saṃyamo</b>ti sīlasaṃyamo.","<b>Damo</b>ti indriyasaṃvaro, uposathavasena vā attadamanaṃ, puṇṇovāde (ma. ni.3.395 ādayo; saṃ. ni.4.88 ādayo) damoti vuttā khantipi āḷavake (saṃ. ni.1.246; su. ni.183 ādayo) vuttā paññāpi imasmiṃ sutte vaṭṭatiyeva.","<b>Mātāpitu upaṭṭhānan</b>ti mātāpitūnaṃ rakkhanaṃ gopanaṃ paṭijagganaṃ.","<b>Santānan</b>ti aññattha buddhapaccekabuddhaariyasāvakā santo nāma, idha pana mātāpituupaṭṭhākā adhippetā.","Tasmā uttamaṭṭhena santānaṃ, seṭṭhacariyaṭṭhena <b>brahmacārīnaṃ</b>.","Idaṃ mātāpituupaṭṭhānaṃ sabbhi upaññātanti evamettha attho daṭṭhabbo.","<b>Sataṃ etāni ṭhānānī</b>ti santānaṃ uttamapurisānaṃ etāni ṭhānāni kāraṇāni.","<b>Ariyo dassanasampanno</b>ti idha imesaṃyeva tiṇṇaṃ ṭhānānaṃ kāraṇena ariyo ceva dassanasampanno ca veditabbo, na buddhādayo na sotāpannā.","Atha vā <b>sataṃ etāni ṭhānānī</b>ti mātupaṭṭhānaṃ pitupaṭṭhānanti etāni ṭhānāni santānaṃ uttamapurisānaṃ kāraṇānīti evaṃ mātāpituupaṭṭhākavasena imissā gāthāya attho veditabbo.","Mātāpituupaṭṭhākoyeva hi idha “ariyo dassanasampanno”ti vutto.","<b>Sa lokaṃ bhajate sivan</b>ti so khemaṃ devalokaṃ gacchatīti."],"lineRefs":[["an3.45:1"],["an3.45:1"],["an3.45:2"],["an3.45:2"],["an3.45:2"],["an3.45:2"],["an3.45:2"],["an3.45:2"],["an3.45:2"],["an3.45:3"],["an3.45:3"],["an3.45:3"],["an3.45:3"],["an3.45:3"]]}],"wordLinks":[["an3.45:1.1","paṇḍitapaññattānī",0,0],["an3.45:1.6","paṇḍitapaññattānī",0,0],["an3.45:1.1","sappurisapaññattānī",0,1],["an3.45:1.6","sappurisapaññattānī",0,1],["an3.45:2.1","ahiṃsā",0,2],["an3.45:2.1","saṃyamo",0,3],["an3.45:2.1","damo",0,4],["an3.45:2.3","mātāpitu upaṭṭhānaṃ",0,5],["an3.45:2.3","santānaṃ",0,6],["an3.45:3.1","sataṃ etāni ṭhānānī",0,9],["an3.45:3.3","ariyo dassanasampanno",0,10],["an3.45:3.1","sataṃ etāni ṭhānānī",0,11],["an3.45:3.3","sa lokaṃ bhajate sivaṃ",0,13]],"before":[{"para":567,"vripara":null,"refs":[],"lines":["Paṇḍitasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":564,"to":564,"paras":[{"para":564,"vripara":"45","refs":["an3.45:1"],"lines":["Pañcame <b>paṇḍitapaññattānī</b>ti paṇḍitehi paṭhamaṃ paññattāni.","<b>Kathitānī</b>ti seyyaso kathitāni.","<b>Mahāpurisehī</b>ti buddhabodhisattehi.","<b>Karuṇā</b>ti karuṇācetovimutti vuttā.","<b>Pubbabhāgo</b>ti tassa upacāro.","<b>Damoti indriyasaṃvaro</b> “manacchaṭṭhānaṃ indriyānaṃ damanan”ti katvā.","<b>Attadamanan</b>ti cittadamanaṃ.","<b>Puṇṇovāde</b> (ma. ni.3.396)“sakkhissasi kho, tvaṃ puṇṇa, iminā damūpasamenā”ti āgatattā <b>damoti vuttā khantipi.</b>","<b>Āḷavake</b> āḷavakasutte (saṃ. ni.1.246; su. ni.190)“saccā damā cāgā”ti evaṃ <b>vuttā paññāpi</b> imasmiṃ sutte “damo”ti vattuṃ vaṭṭati.","<b>Rakkhanaṃ gopanaṃ paṭijagganan</b>ti mātāpitūnaṃ manussāmanussakatūpaddavato rakkhanaṃ, byādhiādianatthato gopanaṃ, ghāsacchādanādīhi veyyāvaccakaraṇena paṭijagganaṃ.","<b>Santo nāma</b> sabbakilesadarathapariḷāhūpasamena upasantakāyavacīsamācāratāya ca.","<b>Uttamaṭṭhena santānan</b>ti matteyyatādīhi seṭṭhaṭṭhena santānaṃ."],"lineRefs":[["an3.45:1"],["an3.45:1"],["an3.45:1"],["an3.45:1"],["an3.45:1"],["an3.45:1"],["an3.45:1"],["an3.45:1"],["an3.45:1"],["an3.45:1"],["an3.45:1"],["an3.45:1"]]}],"wordLinks":[["an3.45:1.1","paṇḍitapaññattānī",0,0],["an3.45:1.6","paṇḍitapaññattānī",0,0]],"before":[{"para":562,"vripara":null,"refs":[],"lines":["Kathāpavattisuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":563,"vripara":null,"refs":[],"lines":["Paṇḍitasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
