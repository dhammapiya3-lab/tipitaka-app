{"suttaId":"tha-ap480","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1741,1755],"vripara":"66"},"segments":{"tha-ap480:0.3":"Vallikāraphaladāyakattheraapadānaṃ","tha-ap480:1.1":"“Sumano nāma sambuddho,","tha-ap480:1.2":"takkarāyaṃ vasī tadā;","tha-ap480:1.3":"Vallikāraphalaṃ gayha,","tha-ap480:1.4":"sayambhussa adāsahaṃ. 67.","tha-ap480:2.1":"“Ekatiṃse ito kappe,","tha-ap480:2.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap480:2.3":"Duggatiṃ nābhijānāmi,","tha-ap480:2.4":"phaladānassidaṃ phalaṃ. 68.","tha-ap480:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap480:3.3":"viharāmi anāsavo. 69.","tha-ap480:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap480:4.3":"kataṃ buddhassa sāsanaṃ. 70.","tha-ap480:5.1":"“Paṭisambhidā catasso…pe…","tha-ap480:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap480:6.1":"Itthaṃ sudaṃ āyasmā vallikāraphaladāyako thero imā Gāthāyo abhāsitthāti.","tha-ap480:7.1":"Vallikāraphaladāyakattherassāpadānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
