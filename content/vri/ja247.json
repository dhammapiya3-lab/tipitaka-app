{"suttaId":"ja247","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1703,1709],"vripara":"194"},"segments":{"ja247:0.4":"Pādañjalījātakaṃ (2-10-7)","ja247:1.1":"Addhā pādañjalī sabbe, paññāya atirocati;","ja247:1.3":"Tathā hi oṭṭhaṃ bhañjati, uttariṃ nūna passati.","ja247:2.1":"Nāyaṃ dhammaṃ adhammaṃ vā, atthānatthañca bujjhati;","ja247:2.3":"Aññatra oṭṭhanibbhogā, nāyaṃ jānāti kiñcananti.","ja247:3.1":"Pādañjalījātakaṃ sattamaṃ."},"attha":null,"tika":null}
