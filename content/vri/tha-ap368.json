{"suttaId":"tha-ap368","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10670,10681],"vripara":"20"},"segments":{"tha-ap368:0.3":"Kadambapupphiyattheraapadānaṃ","tha-ap368:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap368:1.2":"gacchantaṃ antarāpaṇe;","tha-ap368:1.3":"Kañcanagghiyasaṅkāsaṃ,","tha-ap368:1.4":"bāttiṃsavaralakkhaṇaṃ.","tha-ap368:2.1":"“Nisajja pāsādavare,","tha-ap368:2.2":"addasaṃ lokanāyakaṃ;","tha-ap368:2.3":"Kadambapupphaṃ paggayha,","tha-ap368:2.4":"vipassiṃ abhipūjayiṃ.","tha-ap368:3.1":"“Ekanavutito kappe,","tha-ap368:3.2":"yaṃ buddhamabhipūjayiṃ;","tha-ap368:3.3":"Duggatiṃ nābhijānāmi,","tha-ap368:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap368:4.1":"“Paṭisambhidā catasso … pe …","tha-ap368:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap368:5.1":"Itthaṃ sudaṃ āyasmā kadambapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap368:6.1":"Kadambapupphiyattherassāpadānaṃ chaṭṭhaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
