{"suttaId":"tha-ap450","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[975,1007],"vripara":"50"},"segments":{"tha-ap450:0.3":"Pādapīṭhiyattheraapadānaṃ","tha-ap450:1.1":"“Sumedho nāma sambuddho,","tha-ap450:1.2":"aggo kāruṇiko muni;","tha-ap450:1.3":"Tārayitvā bahū satte,","tha-ap450:1.4":"nibbuto so mahāyaso. 51.","tha-ap450:2.1":"“Sīhāsanassa sāmantā,","tha-ap450:2.2":"sumedhassa mahesino;","tha-ap450:2.3":"Pasannacitto sumano,","tha-ap450:2.4":"pādapīṭhamakārayiṃ. 52.","tha-ap450:3.1":"“Katvāna kusalaṃ kammaṃ,","tha-ap450:3.2":"sukhapākaṃ sukhudrayaṃ;","tha-ap450:3.3":"Puññakammena saṃyutto,","tha-ap450:3.4":"tāvatiṃsamagacchahaṃ. 53.","tha-ap450:4.1":"“Tattha me vasamānassa,","tha-ap450:4.2":"puññakammasamaṅgino;","tha-ap450:4.3":"Padāni uddharantassa,","tha-ap450:4.4":"soṇṇapīṭhā bhavanti me. 54.","tha-ap450:5.1":"“Lābhā tesaṃ suladdhaṃ vo,","tha-ap450:5.2":"ye labhanti upassutiṃ;","tha-ap450:5.3":"Nibbute kāraṃ katvāna,","tha-ap450:5.4":"labhanti vipulaṃ sukhaṃ. 55.","tha-ap450:6.1":"“Mayāpi sukataṃ kammaṃ,","tha-ap450:6.2":"vāṇijjaṃ suppayojitaṃ;","tha-ap450:6.3":"Pādapīṭhaṃ karitvāna,","tha-ap450:6.4":"soṇṇapīṭhaṃ labhāmahaṃ. 56.","tha-ap450:7.1":"“Yaṃ yaṃ disaṃ pakkamāmi,","tha-ap450:7.2":"kenaci kiccayenahaṃ [paccayenahaṃ (sī. pī.)];","tha-ap450:7.3":"Soṇṇapīṭhe akkamāmi [soṇṇapīṭhena kamāmi (ka.)],","tha-ap450:7.4":"puññakammassidaṃ phalaṃ. 57.","tha-ap450:8.1":"“Tiṃsakappasahassamhi,","tha-ap450:8.2":"yaṃ kammamakariṃ tadā;","tha-ap450:8.3":"Duggatiṃ nābhijānāmi,","tha-ap450:8.4":"pādapīṭhassidaṃ phalaṃ. 58.","tha-ap450:9.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap450:9.3":"viharāmi anāsavo. 59.","tha-ap450:10.1":"“Svāgataṃ vata me āsi…pe…","tha-ap450:10.3":"kataṃ buddhassa sāsanaṃ. 60.","tha-ap450:11.1":"“Paṭisambhidā catasso…pe…","tha-ap450:11.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap450:12.1":"Itthaṃ sudaṃ āyasmā pādapīṭhiyo thero imā gāthāyo Abhāsitthāti.","tha-ap450:13.1":"Pādapīṭhiyattherassāpadānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
