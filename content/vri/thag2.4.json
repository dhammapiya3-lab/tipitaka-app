{"suttaId":"thag2.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[730,736],"vripara":"127"},"segments":{"thag2.4:0.4":"Gaṅgātīriyattheragāthā","thag2.4:1.1":"“Tiṇṇaṃ me tālapattānaṃ, gaṅgātīre kuṭī katā;","thag2.4:1.3":"Chavasittova me patto, paṃsukūlañca cīvaraṃ.","thag2.4:2.1":"“Dvinnaṃ antaravassānaṃ, ekā vācā me bhāsitā;","thag2.4:2.3":"Tatiye antaravassamhi, tamokhandho [tamokkhandho (sī. syā.)] padālito”ti.","thag2.4:2.5":"… Gaṅgātīriyo thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":3191,"to":3191,"paras":[{"para":3191,"vripara":null,"refs":["thag2.4:2"],"lines":["<b>Dvinnaṃ antaravassānan</b>ti dvīsu antaravassesu pabbajitato arahattamappattasaṃvaccharesu.","<b>Ekā vācā me bhāsitā</b>ti ekā,“alaṃ, bhaginī”ti khīrapaṭikkhepavācā eva mayā vuttā, añño tattha vacībhedo nāhosi.","Tena ukkaṃsagataṃ kāyavacīsaṃyamaṃ dasseti.","<b>Tatiye antaravassamhī</b>ti tatiyassa saṃvaccharassa abbhantare, tasmiṃ aparipuṇṇeyeva.","<b>Tamokhandho padālito</b>ti aggamaggena tamokhandho bhinno, avijjānusayo samucchinnoti attho.","Tena tadekaṭṭhatāya sabbakilesānaṃ anavasesappahānaṃ vadati."],"lineRefs":[["thag2.4:2"],["thag2.4:2"],["thag2.4:2"],["thag2.4:2"],["thag2.4:2"],["thag2.4:2"]]}],"wordLinks":[["thag2.4:2.1","dvinnaṃ antaravassānaṃ",0,0],["thag2.4:2.1","ekā vācā me bhāsitā",0,1],["thag2.4:2.3","tatiye antaravassamhī",0,3],["thag2.4:2.3","tamokhandho padālito",0,4]]},"tika":null,"tika2":null}
