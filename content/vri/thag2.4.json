{"suttaId":"thag2.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[730,736],"vripara":"127"},"segments":{"thag2.4:0.4":"Gaṅgātīriyattheragāthā","thag2.4:1.1":"“Tiṇṇaṃ me tālapattānaṃ, gaṅgātīre kuṭī katā;","thag2.4:1.3":"Chavasittova me patto, paṃsukūlañca cīvaraṃ.","thag2.4:2.1":"“Dvinnaṃ antaravassānaṃ, ekā vācā me bhāsitā;","thag2.4:2.3":"Tatiye antaravassamhi, tamokhandho [tamokkhandho (sī. syā.)] padālito”ti.","thag2.4:2.5":"… Gaṅgātīriyo thero …."},"attha":null,"tika":null}
