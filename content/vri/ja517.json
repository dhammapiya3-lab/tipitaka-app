{"suttaId":"ja517","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[10044,10151],"vripara":"224"},"segments":{"ja517:0.4":"Dakarakkhasajātakaṃ (7)","ja517:1.1":"Sace vo vuyhamānānaṃ,","ja517:1.2":"sattannaṃ udakaṇṇave;","ja517:1.3":"Manussabalimesāno,","ja517:1.4":"nāvaṃ gaṇheyya rakkhaso;","ja517:1.5":"Anupubbaṃ kathaṃ datvā,","ja517:1.6":"muñcesi dakarakkhasā [dakarakkhato (pī.)].","ja517:2.1":"Mātaraṃ paṭhamaṃ dajjaṃ,","ja517:2.2":"bhariyaṃ datvāna bhātaraṃ;","ja517:2.3":"Tato sahāyaṃ datvāna,","ja517:2.4":"pañcamaṃ dajjaṃ [dajja (syā.)] brāhmaṇaṃ;","ja517:2.5":"Chaṭṭhāhaṃ dajjamattānaṃ,","ja517:2.6":"neva dajjaṃ mahosadhaṃ.","ja517:3.1":"Posetā te janettī ca,","ja517:3.2":"dīgharattānukampikā;","ja517:3.3":"Chabbhī tayi padussati [paduṭṭhasmiṃ (sī. syā.)],","ja517:3.4":"paṇḍitā atthadassinī;","ja517:3.5":"Aññaṃ upanisaṃ katvā,","ja517:3.6":"vadhā taṃ parimocayi.","ja517:4.1":"Taṃ tādisiṃ [tādisaṃ (ka.)] pāṇadadiṃ,","ja517:4.2":"orasaṃ gabbhadhāriniṃ [gabbhadhāriṇiṃ (sī. syā.)];","ja517:4.3":"Mātaraṃ kena dosena,","ja517:4.4":"dajjāsi dakarakkhino [dakarakkhato (pī.)].","ja517:5.1":"Daharā viyalaṅkāraṃ,","ja517:5.2":"dhāreti apiḷandhanaṃ;","ja517:5.3":"Dovārike anīkaṭṭhe,","ja517:5.4":"ativelaṃ pajagghati [sañjagghati (ka.)].","ja517:6.1":"Athopi paṭirājūnaṃ,","ja517:6.2":"sayaṃ dūtāni sāsati;","ja517:6.3":"Mātaraṃ tena dosena,","ja517:6.4":"dajjāhaṃ dakarakkhino.","ja517:7.1":"Itthigumbassa pavarā,","ja517:7.2":"accantaṃ piyabhāṇinī [accantapiyavādinī (sī. pī.)];","ja517:7.3":"Anuggatā [anubbatā (syā.), anupubbatā (ka.)] sīlavatī,","ja517:7.4":"chāyāva anapāyinī.","ja517:8.1":"Akkodhanā puññavatī [paññavatī (sī. pī.)],","ja517:8.2":"paṇḍitā atthadassinī;","ja517:8.3":"Ubbariṃ [uppariṃ (sī.)] kena dosena,","ja517:8.4":"dajjāsi dakarakkhino.","ja517:9.1":"Khiḍḍāratisamāpannaṃ,","ja517:9.2":"anatthavasamāgataṃ;","ja517:9.3":"Sā maṃ sakāna puttānaṃ,","ja517:9.4":"ayācaṃ yācate dhanaṃ.","ja517:10.1":"Sohaṃ dadāmi sāratto [sārato (syā.)],","ja517:10.2":"bahuṃ uccāvacaṃ dhanaṃ;","ja517:10.3":"Suduccajaṃ cajitvāna,","ja517:10.4":"pacchā socāmi dummano;","ja517:10.5":"Ubbariṃ tena dosena,","ja517:10.6":"dajjāhaṃ dakarakkhino.","ja517:11.1":"Yenocitā janapadā [jānapadā (sī. syā. pī.)],","ja517:11.2":"ānītā ca paṭiggahaṃ;","ja517:11.3":"Ābhataṃ pararajjebhi,","ja517:11.4":"abhiṭṭhāya bahuṃ dhanaṃ.","ja517:12.1":"Dhanuggahānaṃ pavaraṃ,","ja517:12.2":"sūraṃ tikhiṇamantinaṃ;","ja517:12.3":"Bhātaraṃ kena dosena,","ja517:12.4":"dajjāsi dakarakkhino.","ja517:13.1":"Yenocitā [mayocitā (sī.), mayācitā (pī.)] janapadā,","ja517:13.2":"ānītā ca paṭiggahaṃ;","ja517:13.3":"Ābhataṃ pararajjebhi,","ja517:13.4":"abhiṭṭhāya bahuṃ dhanaṃ.","ja517:14.1":"Dhanuggahānaṃ pavaro,","ja517:14.2":"sūro tikhiṇamanti ca [tikhiṇamantino (ka.)];","ja517:14.3":"Mayāyaṃ [mayā so (sī. pī.)] sukhito rājā,","ja517:14.4":"atimaññati dārako.","ja517:15.1":"Upaṭṭhānampi me ayye,","ja517:15.2":"na so eti yathā pure;","ja517:15.3":"Bhātaraṃ tena dosena,","ja517:15.4":"dajjāhaṃ dakarakkhino.","ja517:16.1":"Ekarattena ubhayo,","ja517:16.2":"tvañceva dhanusekha ca [dhanusekhavā (sī. syā. pī.)];","ja517:16.3":"Ubho jātettha pañcālā,","ja517:16.4":"sahāyā susamāvayā.","ja517:17.1":"Cariyā taṃ anubandhittho [anubandho (ka.)],","ja517:17.2":"ekadukkhasukho tava;","ja517:17.3":"Ussukko te divārattiṃ,","ja517:17.4":"sabbakiccesu byāvaṭo;","ja517:17.5":"Sahāyaṃ kena dosena,","ja517:17.6":"dajjāsi dakarakkhino.","ja517:18.1":"Cariyā maṃ ayaṃ [cariyāya ayaṃ (sī. pī.)] ayye,","ja517:18.2":"pajagghittho [sañjagghittho (syā.)] mayā saha;","ja517:18.3":"Ajjāpi tena vaṇṇena,","ja517:18.4":"ativelaṃ pajagghati.","ja517:19.1":"Ubbariyāpihaṃ ayye,","ja517:19.2":"mantayāmi rahogato;","ja517:19.3":"Anāmanto [anāmantā (sī.)] pavisati,","ja517:19.4":"pubbe appaṭivedito.","ja517:20.1":"Laddhadvāro [laddhavāro (sī. pī.)] katokāso,","ja517:20.2":"ahirikaṃ anādaraṃ;","ja517:20.3":"Sahāyaṃ tena dosena,","ja517:20.4":"dajjāhaṃ dakarakkhino.","ja517:21.1":"Kusalo sabbanimittānaṃ,","ja517:21.2":"rutaññū [rudaññū (sī. syā. pī.)] āgatāgamo;","ja517:21.3":"Uppāte supine yutto,","ja517:21.4":"niyyāne ca pavesane.","ja517:22.1":"Paṭṭho [paddho (sī. pī.)] bhūmantalikkhasmiṃ,","ja517:22.2":"nakkhattapadakovido;","ja517:22.3":"Brāhmaṇaṃ kena dosena,","ja517:22.4":"dajjāsi dakarakkhino.","ja517:23.1":"Parisāyampi me ayye,","ja517:23.2":"ummīlitvā udikkhati;","ja517:23.3":"Tasmā accabhamuṃ luddaṃ,","ja517:23.4":"dajjāhaṃ dakarakkhino.","ja517:24.1":"Sasamuddapariyāyaṃ,","ja517:24.2":"mahiṃ sāgarakuṇḍalaṃ;","ja517:24.3":"Vasundharaṃ āvasasi,","ja517:24.4":"amaccaparivārito.","ja517:25.1":"Cāturanto mahāraṭṭho,","ja517:25.2":"vijitāvī mahabbalo;","ja517:25.3":"Pathabyā ekarājāsi,","ja517:25.4":"yaso te vipulaṃ gato.","ja517:26.1":"Soḷasitthisahassāni,","ja517:26.2":"āmuttamaṇikuṇḍalā;","ja517:26.3":"Nānājanapadā nārī,","ja517:26.4":"devakaññūpamā subhā.","ja517:27.1":"Evaṃ sabbaṅgasampannaṃ,","ja517:27.2":"sabbakāmasamiddhinaṃ;","ja517:27.3":"Sukhitānaṃ piyaṃ dīghaṃ,","ja517:27.4":"jīvitaṃ āhu khattiya.","ja517:28.1":"Atha tvaṃ kena vaṇṇena,","ja517:28.2":"kena vā pana hetunā;","ja517:28.3":"Paṇḍitaṃ anurakkhanto,","ja517:28.4":"pāṇaṃ cajasi duccajaṃ.","ja517:29.1":"Yatopi āgato ayye,","ja517:29.2":"mama hatthaṃ mahosadho;","ja517:29.3":"Nābhijānāmi dhīrassa,","ja517:29.4":"anumattampi dukkaṭaṃ.","ja517:30.1":"Sace ca kismici kāle,","ja517:30.2":"maraṇaṃ me pure siyā;","ja517:30.3":"So me putte [putte ca me (sī. syā. pī.] paputte ca,","ja517:30.4":"sukhāpeyya mahosadho.","ja517:31.1":"Anāgataṃ paccuppannaṃ,","ja517:31.2":"sabbamatthampi passati [sabbamatthaṃ vipassati (sī. syā. pī.)];","ja517:31.3":"Anāparādhakammantaṃ,","ja517:31.4":"na dajjaṃ dakarakkhino.","ja517:32.1":"Idaṃ suṇātha pañcālā,","ja517:32.2":"cūḷaneyyassa [cūḷanīyassa (sī.)] bhāsitaṃ;","ja517:32.3":"Paṇḍitaṃ anurakkhanto,","ja517:32.4":"pāṇaṃ cajati duccajaṃ.","ja517:33.1":"Mātu bhariyāya bhātucca,","ja517:33.2":"sakhino brāhmaṇassa ca;","ja517:33.3":"Attano cāpi pañcālo,","ja517:33.4":"channaṃ cajati jīvitaṃ.","ja517:34.1":"Evaṃ mahatthikā [khahiddhiyā (syā.), mahiddhikā (ka.)] paññā,","ja517:34.2":"nipuṇā sādhucintinī;","ja517:34.3":"Diṭṭhadhammahitatthāya,","ja517:34.4":"samparāyasukhāya cāti.","ja517:35.1":"Dakarakkhasajātakaṃ sattamaṃ."},"unsure":[],"attha":{"book":"Ja-a-vi-b","bookName":"Jātaka-aṭṭhakathā-5","vriCode":"s0513a4.att","from":6263,"to":6272,"paras":[{"para":6263,"vripara":"224-257","refs":["ja517:1"],"lines":["224-257. <b>Sace vo vuyhamānānan</b>ti dakarakkhasajātakaṃ.","Taṃ sabbaṃ mahāumaṅgajātake āvi bhavissatīti."],"lineRefs":[["ja517:1"],["ja517:1"]]},{"para":6264,"vripara":null,"refs":["ja517:1"],"lines":["Dakarakkhasajātakavaṇṇanā sattamā."],"lineRefs":[["ja517:1"]]},{"para":6266,"vripara":null,"refs":["ja517:1"],"lines":["[518]8. Paṇḍaranāgarājajātakavaṇṇanā"],"lineRefs":[["ja517:1"]]},{"para":6267,"vripara":null,"refs":["ja517:1"],"lines":["<b>Vikiṇṇavācan</b>ti idaṃ satthā jetavane viharanto musāvādaṃ katvā devadattassa pathavippavesanaṃ ārabbha kathesi.","Tadā hi satthā bhikkhūhi tassa avaṇṇe kathite “na, bhikkhave, idāneva, pubbepi devadatto musāvādaṃ katvā pathaviṃ paviṭṭhoyevā”ti vatvā atītaṃ āhari."],"lineRefs":[["ja517:1"],["ja517:1"]]},{"para":6268,"vripara":null,"refs":["ja517:1"],"lines":["Atīte bārāṇasiyaṃ brahmadatte rajjaṃ kārente pañcasatavāṇijā nāvāya samuddaṃ pakkhanditvā sattame divase atīradassaniyā nāvāya samuddapiṭṭhe bhinnāya ṭhapetvā ekaṃ avasesā macchakacchapabhakkhā ahesuṃ, eko pana vātavegena karampiyapaṭṭanaṃ nāma pāpuṇi.","So samuddato uttaritvā naggabhogo tasmiṃ paṭṭaneyeva bhikkhāya cari.","Tamenaṃ manussā “ayaṃ samaṇo appiccho santuṭṭho”ti sambhāvetvā sakkāraṃ kariṃsu.","So “laddho me jīvikūpāyo”ti tesu nivāsanapārupanaṃ dentesupi na icchi.","Te “natthi ito uttari appiccho samaṇo”ti bhiyyo bhiyyo pasīditvā tassa assamapadaṃ katvā tattha naṃ nivāsāpesuṃ.","So “karampiyaacelo”ti paññāyi.","Tassa tattha vasantassa mahālābhasakkāro udapādi."],"lineRefs":[["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"]]},{"para":6269,"vripara":null,"refs":["ja517:1"],"lines":["Eko nāgarājāpissa supaṇṇarājā ca upaṭṭhānaṃ āgacchanti.","Tesu nāgarājā nāmena paṇḍaro nāma.","Athekadivasaṃ supaṇṇarājā tassa santikaṃ gantvā vanditvā ekamantaṃ nisinno evamāha –","“bhante, amhākaṃ ñātakā nāge gaṇhantā bahū vinassanti, etesaṃ nāgānaṃ gahaṇaniyāmaṃ mayaṃ na jānāma, guyhakāraṇaṃ kira tesaṃ atthi, sakkuṇeyyātha nu kho tumhe ete piyāyamānā viya taṃ kāraṇaṃ pucchitun”ti.","So “sādhū”ti sampaṭicchitvā supaṇṇarāje vanditvā pakkante nāgarājassa āgatakāle vanditvā nisinnaṃ nāgarājānaṃ pucchi –","“nāgarāja, supaṇṇā kira tumhe gaṇhantā bahū vinassanti, tumhe gaṇhantā kathaṃ gaṇhituṃ na sakkontī”ti.","Bhante, idaṃ amhākaṃ guyhaṃ rahassaṃ, mayā imaṃ kathentena ñātisaṅghassa maraṇaṃ āhaṭaṃ hotīti.","Kiṃ pana tvaṃ, āvuso,“ayaṃ aññassa kathessatī”ti evaṃsaññī hosi, nāhaṃ aññassa kathessāmi, attanā pana jānitukāmatāya pucchāmi, tvaṃ mayhaṃ saddahitvā nibbhayo hutvā kathehīti.","Nāgarājā “na kathessāmi, bhante”ti vanditvā pakkāmi.","Punadivasepi pucchi, tathāpissa na kathesi."],"lineRefs":[["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"]]},{"para":6270,"vripara":null,"refs":["ja517:1"],"lines":["Atha naṃ tatiyadivase āgantvā nisinnaṃ,“nāgarāja, ajja tatiyo divaso, mama pucchantassa kimatthaṃ na kathesī”ti āha.","“Tumhe aññassa ācikkhissathā”ti bhayena, bhanteti.","Kassaci na kathessāmi, nibbhayo kathehīti.","“Tena hi, bhante, aññassa mā kathayitthā”ti paṭiññaṃ gahetvā,“bhante, mayaṃ mahante mahante pāsāṇe gilitvā bhāriyā hutvā nipajjitvā supaṇṇānaṃ āgamanakāle mukhaṃ nibbāhetvā dante vivaritvā supaṇṇe ḍaṃsituṃ acchāma, te āgantvā amhākaṃ sīsaṃ gaṇhanti, tesaṃ amhe garubhāre hutvā nipanne uddharituṃ vāyamantānaññeva udakaṃ ottharati.","Te sīdantā antoudakeyeva maranti, iminā kāraṇena bahū supaṇṇā vinassanti, tesaṃ amhe gaṇhantānaṃ kiṃ sīsena gahitena, bālā naṅguṭṭhe gahetvā amhe heṭṭhāsīsake katvā gahitaṃ gocaraṃ mukhena chaḍḍāpetvā lahuke katvā gantuṃ sakkontī”ti so attano rahassakāraṇaṃ tassa dussīlassa kathesi."],"lineRefs":[["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"]]},{"para":6271,"vripara":null,"refs":["ja517:1"],"lines":["Atha tasmiṃ pakkante supaṇṇarājā āgantvā karampiyaacelaṃ vanditvā “kiṃ, bhante, pucchitaṃ te nāgarājassa guyhakāraṇan”ti āha.","So “āmāvuso”ti vatvā sabbaṃ tena kathitaniyāmeneva kathesi.","Taṃ sutvā supaṇṇo “nāgarājena ayuttaṃ kataṃ, ñātīnaṃ nāma nassananiyāmo parassa na kathetabbo, hotu, ajjeva mayā supaṇṇavātaṃ katvā paṭhamaṃ etameva gahetuṃ vaṭṭatī”ti supaṇṇavātaṃ katvā paṇḍaranāgarājānaṃ naṅguṭṭhe gahetvā heṭṭhāsīsaṃ katvā gahitagocaraṃ chaḍḍāpetvā uppatitvā ākāsaṃ pakkhandi.","Paṇḍaro ākāse heṭṭhāsīsakaṃ olambanto “mayāva mama dukkhaṃ ābhatan”ti paridevanto āha –"],"lineRefs":[["ja517:1"],["ja517:1"],["ja517:1"],["ja517:1"]]}],"wordLinks":[],"before":[{"para":6132,"vripara":null,"refs":[],"lines":["Tato paraṃ brāhmaṇo āha –"],"lineRefs":[[]]},{"para":6134,"vripara":"186","refs":[],"lines":["“Taggha te ahamakkhissaṃ, yathāpi kusalo tathā;"],"lineRefs":[[]]},{"para":6135,"vripara":null,"refs":[],"lines":["Saccavādiñhi lokasmiṃ, pasaṃsantīdha paṇḍitā."],"lineRefs":[[]]},{"para":6137,"vripara":"187","refs":[],"lines":["“Eko caraṃ gogaveso, mūḷho accasariṃ vane;"],"lineRefs":[[]]},{"para":6138,"vripara":null,"refs":[],"lines":["Araññe irīṇe vivane, nānākuñjarasevite."],"lineRefs":[[]]},{"para":6140,"vripara":"188","refs":[],"lines":["“Vāḷamigānucarite, vippanaṭṭhosmi kānane;"],"lineRefs":[[]]},{"para":6141,"vripara":null,"refs":[],"lines":["Acariṃ tattha sattāhaṃ, khuppipāsasamappito."],"lineRefs":[[]]},{"para":6143,"vripara":"189","refs":[],"lines":["“Tattha tindukamaddakkhiṃ, visamaṭṭhaṃ bubhukkhito;"],"lineRefs":[[]]},{"para":6144,"vripara":null,"refs":[],"lines":["Papātamabhilambantaṃ, sampannaphaladhārinaṃ."],"lineRefs":[[]]},{"para":6146,"vripara":"190","refs":[],"lines":["“Vātassitāni bhakkhesiṃ, tāni rucciṃsu me bhusaṃ;"],"lineRefs":[[]]},{"para":6147,"vripara":null,"refs":[],"lines":["Atitto rukkhamārūhiṃ, tattha hessāmi āsito."],"lineRefs":[[]]},{"para":6149,"vripara":"191","refs":[],"lines":["“Ekaṃ me bhakkhitaṃ āsi, dutiyaṃ abhipatthitaṃ;"],"lineRefs":[[]]},{"para":6150,"vripara":null,"refs":[],"lines":["Tato sā bhañjatha sākhā, chinnā pharasunā viya."],"lineRefs":[[]]},{"para":6152,"vripara":"192","refs":[],"lines":["“Sohaṃ sahāva sākhāhi, uddhaṃpādo avaṃsiro;"],"lineRefs":[[]]},{"para":6153,"vripara":null,"refs":[],"lines":["Appatiṭṭhe anālambe, giriduggasmi pāpataṃ."],"lineRefs":[[]]},{"para":6155,"vripara":"193","refs":[],"lines":["“Yasmā ca vāri gambhīraṃ, tasmā na samapajjisaṃ;"],"lineRefs":[[]]},{"para":6156,"vripara":null,"refs":[],"lines":["Tattha sesiṃ nirānando, anūnā dasa rattiyo."],"lineRefs":[[]]},{"para":6158,"vripara":"194","refs":[],"lines":["“Athettha kapi māgañchi, gonaṅgulo darīcaro;"],"lineRefs":[[]]},{"para":6159,"vripara":null,"refs":[],"lines":["Sākhāhi sākhaṃ vicaranto, khādamāno dumapphalaṃ."],"lineRefs":[[]]},{"para":6161,"vripara":"195","refs":[],"lines":["“So maṃ disvā kisaṃ paṇḍuṃ, kāruññamakaraṃ mayi;"],"lineRefs":[[]]},{"para":6162,"vripara":null,"refs":[],"lines":["Ambho ko nāma so ettha, evaṃ dukkhena aṭṭito."],"lineRefs":[[]]},{"para":6164,"vripara":"196","refs":[],"lines":["“Manusso amanusso vā, attānaṃ me pavedaya;"],"lineRefs":[[]]},{"para":6165,"vripara":null,"refs":[],"lines":["Tassañjaliṃ paṇāmetvā, idaṃ vacanamabraviṃ."],"lineRefs":[[]]},{"para":6167,"vripara":"197","refs":[],"lines":["“Manussohaṃ byasampatto, sā me natthi ito gati;"],"lineRefs":[[]]},{"para":6168,"vripara":null,"refs":[],"lines":["Taṃ vo vadāmi bhaddaṃ vo, tvañca me saraṇaṃ bhava."],"lineRefs":[[]]},{"para":6170,"vripara":"198","refs":[],"lines":["“Garuṃ silaṃ gahetvāna, vicarī pabbate kapi;"],"lineRefs":[[]]},{"para":6171,"vripara":null,"refs":[],"lines":["Silāya yoggaṃ katvāna, nisabho etadabravi."],"lineRefs":[[]]},{"para":6173,"vripara":"199","refs":[],"lines":["“Ehi me piṭṭhimāruyha, gīvaṃ gaṇhāhi bāhubhi;"],"lineRefs":[[]]},{"para":6174,"vripara":null,"refs":[],"lines":["Ahaṃ taṃ uddharissāmi, giriduggata vegasā."],"lineRefs":[[]]},{"para":6176,"vripara":"200","refs":[],"lines":["“Tassa taṃ vacanaṃ sutvā, vānarindassa sirīmato;"],"lineRefs":[[]]},{"para":6177,"vripara":null,"refs":[],"lines":["Piṭṭhimāruyha dhīrassa, gīvaṃ bāhāhi aggahiṃ."],"lineRefs":[[]]},{"para":6179,"vripara":"201","refs":[],"lines":["“So maṃ tato samuṭṭhāsi, tejassī balavā kapi;"],"lineRefs":[[]]},{"para":6180,"vripara":null,"refs":[],"lines":["Vihaññamāno kicchena, giriduggata vegasā."],"lineRefs":[[]]},{"para":6182,"vripara":"202","refs":[],"lines":["“Uddharitvāna maṃ santo, nisabho etadabravi;"],"lineRefs":[[]]},{"para":6183,"vripara":null,"refs":[],"lines":["Iṅgha maṃ samma rakkhassu, pasupissaṃ muhuttakaṃ."],"lineRefs":[[]]},{"para":6185,"vripara":"203","refs":[],"lines":["“Sīhā byagghā ca dīpī ca, acchakokataracchayo;"],"lineRefs":[[]]},{"para":6186,"vripara":null,"refs":[],"lines":["Te maṃ pamattaṃ hiṃseyyuṃ, te tvaṃ disvā nivāraya."],"lineRefs":[[]]},{"para":6188,"vripara":"204","refs":[],"lines":["“Evaṃ me parittātūna, pasupī so muhuttakaṃ;"],"lineRefs":[[]]},{"para":6189,"vripara":null,"refs":[],"lines":["Tadāhaṃ pāpikaṃ diṭṭhiṃ, paṭilacchiṃ ayoniso."],"lineRefs":[[]]},{"para":6191,"vripara":"205","refs":[],"lines":["“Bhakkho ayaṃ manussānaṃ, yathā caññe vane migā;"],"lineRefs":[[]]},{"para":6192,"vripara":null,"refs":[],"lines":["Yaṃ nūnimaṃ vadhitvāna, chāto khādeyya vānaraṃ."],"lineRefs":[[]]},{"para":6194,"vripara":"206","refs":[],"lines":["“Asito ca gamissāmi, maṃsamādāya sambalaṃ;"],"lineRefs":[[]]},{"para":6195,"vripara":null,"refs":[],"lines":["Kantāraṃ nittharissāmi, pātheyyaṃ me bhavissati."],"lineRefs":[[]]},{"para":6197,"vripara":"207","refs":[],"lines":["“Tato silaṃ gahetvāna, matthakaṃ sannitāḷayiṃ;"],"lineRefs":[[]]},{"para":6198,"vripara":null,"refs":[],"lines":["Mama gattakilantassa, pahāro dubbalo ahu."],"lineRefs":[[]]},{"para":6200,"vripara":"208","refs":[],"lines":["“So ca vegenudappatto, kapi ruhiramakkhito;"],"lineRefs":[[]]},{"para":6201,"vripara":null,"refs":[],"lines":["Assupuṇṇehi nettehi, rodanto maṃ udikkhati."],"lineRefs":[[]]},{"para":6203,"vripara":"209","refs":[],"lines":["“Māyyo maṃ kari bhaddante, tvañca nāmedisaṃ kari;"],"lineRefs":[[]]},{"para":6204,"vripara":null,"refs":[],"lines":["Tvañca kho nāma dīghāvu, aññe vāretumarahasi."],"lineRefs":[[]]},{"para":6206,"vripara":"210","refs":[],"lines":["“Aho vata re purisa, tāvadukkarakāraka;"],"lineRefs":[[]]},{"para":6207,"vripara":null,"refs":[],"lines":["Edisā visamā duggā, papātā uddhato mayā."],"lineRefs":[[]]},{"para":6209,"vripara":"211","refs":[],"lines":["“Ānīto paralokāva, dubbheyyaṃ maṃ amaññatha;"],"lineRefs":[[]]},{"para":6210,"vripara":null,"refs":[],"lines":["Taṃ tena pāpakammena, pāpaṃ pāpena cintitaṃ."],"lineRefs":[[]]},{"para":6212,"vripara":"212","refs":[],"lines":["“Mā heva tvaṃ adhammaṭṭha, vedanaṃ kaṭukaṃ phusi;"],"lineRefs":[[]]},{"para":6213,"vripara":null,"refs":[],"lines":["Mā heva pāpakammaṃ taṃ, phalaṃ veḷuṃva taṃ vadhi."],"lineRefs":[[]]},{"para":6215,"vripara":"213","refs":[],"lines":["“Tayi me natthi vissāso, pāpadhamma asaññata;"],"lineRefs":[[]]},{"para":6216,"vripara":null,"refs":[],"lines":["Ehi me piṭṭhito gaccha, dissamānova santike."],"lineRefs":[[]]},{"para":6218,"vripara":"214","refs":[],"lines":["“Muttosi hatthā vāḷānaṃ, pattosi mānusiṃ padaṃ;"],"lineRefs":[[]]},{"para":6219,"vripara":null,"refs":[],"lines":["Esa maggo adhammaṭṭha, tena gaccha yathāsukhaṃ."],"lineRefs":[[]]},{"para":6221,"vripara":"215","refs":[],"lines":["“Idaṃ vatvā giricaro, rahade pakkhalya matthakaṃ;"],"lineRefs":[[]]},{"para":6222,"vripara":null,"refs":[],"lines":["Assūni sampamajjitvā, tato pabbatamāruhi."],"lineRefs":[[]]},{"para":6224,"vripara":"216","refs":[],"lines":["“Sohaṃ tenābhisattosmi, pariḷāhena aṭṭito;"],"lineRefs":[[]]},{"para":6225,"vripara":null,"refs":[],"lines":["Ḍayhamānena gattena, vāriṃ pātuṃ upāgamiṃ."],"lineRefs":[[]]},{"para":6227,"vripara":"217","refs":[],"lines":["“Agginā viya santatto, rahado ruhiramakkhito;"],"lineRefs":[[]]},{"para":6228,"vripara":null,"refs":[],"lines":["Pubbalohitasaṅkāso, sabbo me samapajjatha."],"lineRefs":[[]]},{"para":6230,"vripara":"218","refs":[],"lines":["“Yāvanto udabindūni, kāyasmiṃ nipatiṃsu me;"],"lineRefs":[[]]},{"para":6231,"vripara":null,"refs":[],"lines":["Tāvanto gaṇḍa jāyetha, addhabeluvasādisā."],"lineRefs":[[]]},{"para":6233,"vripara":"219","refs":[],"lines":["“Pabhinnā pagghariṃsu me, kuṇapā pubbalohitā;"],"lineRefs":[[]]},{"para":6234,"vripara":null,"refs":[],"lines":["Yena yeneva gacchāmi, gāmesu nigamesu ca."],"lineRefs":[[]]},{"para":6236,"vripara":"220","refs":[],"lines":["“Daṇḍahatthā nivārenti, itthiyo purisā ca maṃ;"],"lineRefs":[[]]},{"para":6237,"vripara":null,"refs":[],"lines":["Okkitā pūtigandhena, māssu orena āgamā."],"lineRefs":[[]]},{"para":6239,"vripara":"221","refs":[],"lines":["“Etādisaṃ idaṃ dukkhaṃ, satta vassāni dāni me;"],"lineRefs":[[]]},{"para":6240,"vripara":null,"refs":[],"lines":["Anubhomi sakaṃ kammaṃ, pubbe dukkaṭamattano."],"lineRefs":[[]]},{"para":6242,"vripara":"222","refs":[],"lines":["“Taṃ vo vadāmi bhaddante, yāvantettha samāgatā;"],"lineRefs":[[]]},{"para":6243,"vripara":null,"refs":[],"lines":["Māssu mittāna dubbhittho, mittadubbho hi pāpako."],"lineRefs":[[]]},{"para":6245,"vripara":"223","refs":[],"lines":["“Kuṭṭhī kilāsī bhavati, yo mittānidha dubbhati;"],"lineRefs":[[]]},{"para":6246,"vripara":null,"refs":[],"lines":["Kāyassa bhedā mittaddu, nirayaṃ sopapajjatī”ti."],"lineRefs":[[]]},{"para":6247,"vripara":null,"refs":[],"lines":["Tattha <b>kusalo</b>ti yathā cheko kusalo katheti, tathā vo kathessāmi.","<b>Gogaveso</b>ti naṭṭhe goṇe gavesanto.","<b>Accasarin</b>ti manussapathaṃ atikkamitvā himavantaṃ pāvisiṃ.","<b>Araññe</b>ti arājake suññe.","<b>Irīṇe</b>ti sukkhakantāre.","<b>Vivane</b>ti vivitte.","<b>Vippanaṭṭho</b>ti maggamūḷho.","<b>Bubhukkhito</b>ti sañjātabubhukkho chātajjhatto.","<b>Papātamabhilambantan</b>ti papātābhimukhaṃ olambantaṃ.","<b>Sampannaphaladhārinan</b>ti madhuraphaladhārinaṃ.","<b>Vātassitānī</b>ti paṭhamaṃ tāva vātapatitāni khādiṃ.","<b>Tattha hessāmī</b>ti tasmiṃ rukkhe suhito bhavissāmīti āruḷhomhi.","<b>Tato sā bhañjatha sākhā</b>ti tassa abhipatthitassa atthāya hatthe pasārite sā mayā abhiruḷhā sākhā pharasunā chinnā viya abhañjatha.","<b>Anālambe</b>ti ālambitabbaṭṭhānarahite.","<b>Giriduggasmin</b>ti girivisame.","<b>Sesin</b>ti sayitomhi."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":6248,"vripara":null,"refs":[],"lines":["<b>Kapi māgañchī</b>ti kapi āgañchi.","<b>Gonaṅgulo</b>ti gunnaṃ naṅguṭṭhasadisanaṅguṭṭho.","“Gonaṅguṭṭho” tipi pāṭho.","“Gonaṅgulī” tipi paṭhanti.","<b>Akaraṃ mayī</b>ti akarā mayi.","<b>Ambho</b>ti, mahārāja, so kapirājā tasmiṃ narakapapāte mama udakapothanasaddaṃ sutvā maṃ “ambho”ti ālapitvā “ko nāmeso”ti pucchi.","<b>Byasampatto</b>ti byasanaṃ patto, papātassa vasaṃ pattoti vā attho.","<b>Bhaddaṃ vo</b>ti tasmā tumhe vadāmi –","“bhaddaṃ tumhākaṃ hotū”ti.","<b>Garuṃ silan</b>ti, mahārāja, so kapirājā mayā evaṃ vutte “mā bhāyī”ti maṃ assāsetvā paṭhamaṃ tāva garuṃ silaṃ gahetvā yoggaṃ karonto pabbate vicari.","<b>Nisabho</b>ti purisanisabho uttamavānarindo pabbatapapāte ṭhatvā maṃ etadabravīti."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[]]},{"para":6249,"vripara":null,"refs":[],"lines":["<b>Bāhubhī</b>ti dvīhi bāhāhi mama gīvaṃ suggahitaṃ gaṇha.","<b>Vegasā</b>ti vegena.","<b>Sirīmato</b>ti puññavantassa.","<b>Aggahin</b>ti saṭṭhihatthaṃ narakapapātaṃ vātavegena otaritvā udakapiṭṭhe ṭhitassa ahaṃ vegena piṭṭhimabhiruhitvā ubhohi bāhāhi gīvaṃ aggahesiṃ.","<b>Vihaññamāno</b>ti kilamanto.","<b>Kicchenā</b>ti dukkhena.","<b>Santo</b>ti paṇḍito, atha vā parisanto kilanto.","<b>Rakkhassū</b>ti ahaṃ taṃ uddharanto kilanto muhuttaṃ vissamanto pasupissaṃ, tasmā maṃ rakkhāhi.","<b>Yathā caññe vane migā</b>ti sīhādīhi aññepi ye imasmiṃ vane vāḷamigā.","Pāḷiyaṃ pana “acchakokataracchayo”ti likhanti.","<b>Parittātūnā</b>ti, mahārāja, evaṃ so kapirājā maṃ attano parittāṇaṃ katvā muhuttaṃ pasupi.","<b>Ayoniso</b>ti ayonisomanasikārena.","<b>Bhakkho</b>ti khāditabbayuttako.","<b>Asito</b> dhāto suhito.","<b>Sambalan</b>ti pātheyyaṃ.","<b>Matthakaṃ sannitāḷayin</b>ti tassa vānarindassa matthakaṃ pahariṃ.","“Sannitāḷayan” tipi pāṭho.","<b>Dubbalo ahū</b>ti na balavā āsi, yathādhippāyaṃ na agamāsīti."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":6250,"vripara":null,"refs":[],"lines":["<b>Vegenā</b>ti mayā pahaṭapāsāṇavegena.","<b>Udappatto</b>ti uṭṭhito.","<b>Māyyo</b>ti tena mittadubbhipurisena silāya paviddhāya mahācammaṃ chinditvā olambi, ruhiraṃ pagghari.","Mahāsatto vedanāppatto cintesi –","“imasmiṃ ṭhāne añño natthi, idaṃ bhayaṃ imaṃ purisaṃ nissāya uppannan”ti.","So maraṇabhayabhīto olambantaṃ cammabandhaṃ hatthena gahetvā uppatitvā sākhaṃ abhiruyha tena pāpapurisena saddhiṃ sallapanto <b>“māyyo man”</b>tiādimāha.","Tattha <b>māyyo maṃ kari bhaddante</b>ti mā akari ayyo maṃ bhaddanteti taṃ nivāreti.","<b>Tvañca kho nāmā</b>ti tvaṃ nāma evaṃ mayā papātā uddhaṭo edisaṃ pharusakammaṃ mayi kari, aho te ayuttaṃ katanti.","<b>Aho vatā</b>ti taṃ garahanto evamāha.","<b>Tāvadukkarakārakā</b>ti mayi aparajjhanena atidukkarakammakāraka.","<b>Paralokāvā</b>ti paralokato viya ānīto.","<b>Dubbheyyan</b>ti dubbhitabbaṃ vadhitabbaṃ.","<b>Vedanaṃ kaṭukan</b>ti evaṃ santepi tvaṃ adhammaṭṭha yādisaṃ vedanaṃ ahaṃ phusāmi, edisaṃ vedanaṃ kaṭukaṃ mā phusi, taṃ pāpakammaṃ phalaṃ veḷuṃva taṃ mā vadhi.","Iti maṃ, mahārāja, so piyaputtakaṃ viya anukampi."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":6251,"vripara":null,"refs":[],"lines":["Atha naṃ ahaṃ etadavocaṃ –","“ayya, mayā kataṃ dosaṃ hadaye mā kari, mā maṃ asappurisaṃ evarūpe araññe nāsaya, ahaṃ disāmūḷho maggaṃ na jānāmi, attanā kataṃ kammaṃ mā nāsetha, jīvitadānaṃ me detha, araññā nīharitvā manussapathe ṭhapethā”ti.","Evaṃ vutte so mayā saddhiṃ sallapanto <b>“tayi me natthi vissāso”</b>ti ādimāha.","Tattha <b>tayī</b>ti ito paṭṭhāya mayhaṃ tayi vissāso natthi.","<b>Ehī</b>ti, bho purisa, ahaṃ tayā saddhiṃ maggena na gamissāmi, tvaṃ pana ehi mama piṭṭhito avidūre dissamānasarīrova gaccha, ahaṃ rukkhaggeheva gamissāmīti.","<b>Muttosī</b>ti atha so maṃ, mahārāja, araññā nīharitvā, bho purisa, vāḷamigānaṃ hatthā muttosi.","<b>Pattosi mānusiṃ padan</b>ti manussūpacāraṃ patto āgatosi, esa te maggo, etena gacchāti āha."],"lineRefs":[[],[],[],[],[],[],[]]},{"para":6252,"vripara":null,"refs":[],"lines":["<b>Giricaro</b>ti giricārī vānaro.","<b>Pakkhalyā</b>ti dhovitvā.","<b>Tenābhisattosmī</b>ti so ahaṃ, mahārāja, tena vānarena abhisatto, pāpakamme pariṇate tenābhisattosmīti maññamāno evamāha.","<b>Aṭṭito</b>ti upadduto.","<b>Upāgamin</b>ti ekaṃ rahadaṃ upagatosmi.","<b>Samapajjathā</b>ti jāto, evarūpo hutvā upaṭṭhāsi.","<b>Yāvanto</b>ti yattakāni.","<b>Gaṇḍa jāyethā</b>ti gaṇḍā jāyiṃsu.","So kira pipāsaṃ sandhāretuṃ asakkonto udakañjaliṃ ukkhipitvā thokaṃ pivitvā sesaṃ sarīre siñci.","Athassa tāvadeva udakabindugaṇanāya aḍḍhabeluvapakkappamāṇā gaṇḍā uṭṭhahiṃsu, tasmā evamāha.","<b>Pabhinnā</b>ti te gaṇḍā taṃ divasameva bhijjitvā kuṇapā pūtigandhikā hutvā pubbalohitāni pagghariṃsu.","<b>Yena yenā</b>ti yena yena maggena.","<b>Okkitā</b>ti pūtigandhena okiṇṇā parikkhittā parivāritā.","<b>Māssu orena āgamā</b>ti duṭṭhasatta orena māssu āgamā, amhākaṃ santikaṃ mā āgamīti evaṃ vadantā maṃ nivārentīti attho.","<b>Satta vassāni dāni me</b>ti, mahārāja, tato paṭṭhāya idāni satta vassāni mama ettakaṃ kālaṃ sakaṃ kammaṃ anubhomi."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":6253,"vripara":null,"refs":[],"lines":["Iti so attano mittadubbhikammaṃ vitthāretvā,“mahārāja, maññeva oloketvā evarūpaṃ kammaṃ na kenaci kattabban”ti vatvā <b>“taṃ vo”</b>tiādimāha.","Tattha <b>tan</b>ti tasmā.","Yasmā evarūpaṃ kammaṃ evaṃ dukkhavipākaṃ, tasmāti attho."],"lineRefs":[[],[],[]]},{"para":6255,"vripara":"223","refs":[],"lines":["“Kuṭṭhī kilāsī bhavati, yo mittānidha dubbhati;"],"lineRefs":[[]]},{"para":6256,"vripara":null,"refs":[],"lines":["Kāyassa bhedā mittaddu, nirayaṃ sopapajjatī”ti.","–"],"lineRefs":[[],[]]},{"para":6257,"vripara":null,"refs":[],"lines":["Ayaṃ abhisambuddhagāthā.","Bhikkhave, yo idha loke mittāni dubbhati hiṃsati, so evarūpo hotīti attho."],"lineRefs":[[],[]]},{"para":6258,"vripara":null,"refs":[],"lines":["Tassapi purisassa raññā saddhiṃ kathentasseva pathavī vivaraṃ adāsi.","Taṅkhaṇaññeva cavitvā avīcimhi nibbatto.","Rājā tasmiṃ pathaviṃ paviṭṭhe uyyānā nikkhamitvā nagaraṃ paviṭṭho."],"lineRefs":[[],[],[]]},{"para":6259,"vripara":null,"refs":[],"lines":["Satthā imaṃ dhammadesanaṃ āharitvā “na, bhikkhave, idāneva, pubbepi devadatto mayhaṃ silaṃ paṭivijjhiyevā”ti vatvā jātakaṃ samodhānesi –","“tadā mittadubbhī puriso devadatto ahosi, kapirājā pana ahameva ahosin”ti."],"lineRefs":[[],[]]},{"para":6260,"vripara":null,"refs":[],"lines":["Mahākapijātakavaṇṇanā chaṭṭhā."],"lineRefs":[[]]},{"para":6262,"vripara":null,"refs":[],"lines":["[517]7. Dakarakkhasajātakavaṇṇanā"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
