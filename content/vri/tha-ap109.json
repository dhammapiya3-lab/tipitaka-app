{"suttaId":"tha-ap109","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5274,5308],"vripara":"36"},"segments":{"tha-ap109:0.3":"Naḷamāliyattheraapadānaṃ","tha-ap109:1.1":"“Padumuttarabuddhassa,","tha-ap109:1.2":"lokajeṭṭhassa tādino;","tha-ap109:1.3":"Tiṇatthare nisinnassa,","tha-ap109:1.4":"upasantassa tādino. 37.","tha-ap109:2.1":"“Naḷamālaṃ gahetvāna,","tha-ap109:2.2":"bandhitvā [bījitvā (ka.)] bījaniṃ ahaṃ;","tha-ap109:2.3":"Buddhassa upanāmesiṃ,","tha-ap109:2.4":"dvipadindassa tādino. 38.","tha-ap109:3.1":"“Paṭiggahetvā sabbaññū,","tha-ap109:3.2":"bījaniṃ lokanāyako;","tha-ap109:3.3":"Mama saṅkappamaññāya,","tha-ap109:3.4":"imaṃ gāthaṃ abhāsatha. 39.","tha-ap109:4.1":"“‘Yathā me kāyo nibbāti,","tha-ap109:4.2":"pariḷāho na vijjati;","tha-ap109:4.3":"Tatheva tividhaggīhi,","tha-ap109:4.4":"cittaṃ tava vimuccatu’. 40.","tha-ap109:5.1":"“Sabbe devā samāgacchuṃ,","tha-ap109:5.2":"ye keci vananissitā;","tha-ap109:5.3":"Sossāma buddhavacanaṃ,","tha-ap109:5.4":"hāsayantañca dāyakaṃ. 41.","tha-ap109:6.1":"“Nisinno bhagavā tattha,","tha-ap109:6.2":"devasaṅghapurakkhato;","tha-ap109:6.3":"Dāyakaṃ sampahaṃsento,","tha-ap109:6.4":"imā gāthā abhāsatha. 42.","tha-ap109:7.1":"“‘Iminā bījanidānena,","tha-ap109:7.2":"cittassa paṇidhīhi ca;","tha-ap109:7.3":"Subbato nāma nāmena,","tha-ap109:7.4":"cakkavattī bhavissati. 43.","tha-ap109:8.1":"“‘Tena kammāvasesena,","tha-ap109:8.2":"sukkamūlena codito;","tha-ap109:8.3":"Māluto nāma nāmena,","tha-ap109:8.4":"cakkavattī bhavissati’. 44.","tha-ap109:9.1":"“‘Iminā bījanidānena,","tha-ap109:9.2":"sammānavipulena ca;","tha-ap109:9.3":"Kappasatasahassampi,","tha-ap109:9.4":"duggatiṃ nupapajjati. 45.","tha-ap109:10.1":"“Tiṃsakappasahassamhi,","tha-ap109:10.2":"subbatā aṭṭhatiṃsa te;","tha-ap109:10.3":"Ekūnatiṃsasahasse,","tha-ap109:10.4":"aṭṭha mālutanāmakā. 46.","tha-ap109:11.1":"“Paṭisambhidā catasso…pe…","tha-ap109:11.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap109:12.1":"Itthaṃ sudaṃ āyasmā naḷamāliyo thero imā gāthāyo abhāsitthāti.","tha-ap109:13.1":"Naḷamāliyattherassāpadānaṃ sattamaṃ.","tha-ap109:13.2":"Sattamabhāṇavāraṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2825,"to":2826,"paras":[{"para":2825,"vripara":"36","refs":["tha-ap109:1"],"lines":["So aparabhāge attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>padumuttarabuddhassā</b>tiādimāha.","Taṃ heṭṭhā vuttameva. 37."],"lineRefs":[["tha-ap109:1"],["tha-ap109:1"]]},{"para":2826,"vripara":"37","refs":["tha-ap109:2"],"lines":["<b>Naḷamālaṃ gahetvānā</b>ti naḷati asāro nissāro hutvā veḷuvaṃsatopi tanuko sallahuko jātoti naḷo, naḷassa mālā pupphaṃ naḷamālaṃ, tena naḷamālena bījaniṃ kāresinti sambandho.","Bījissati janissati vāto anenāti bījanī, taṃ bījaniṃ buddhassa upanāmesiṃ, paṭiggahesinti attho.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["tha-ap109:2"],["tha-ap109:2"],["tha-ap109:2"]]}],"wordLinks":[["tha-ap109:1.1","padumuttarabuddhassā",0,0],["tha-ap109:2.1","naḷamālaṃ gahetvānā",1,0]],"before":[{"para":2823,"vripara":null,"title":"Naḷamāliyattheraapadānavaṇṇanā","lines":["Naḷamāliyattheraapadānavaṇṇanā"]},{"para":2824,"vripara":null,"title":"Naḷamāliyattheraapadānavaṇṇanā","lines":["<b>Padumuttarabuddhassā</b>tiādikaṃ āyasmato naḷamāliyattherassa apadānaṃ.","Esopi purimajinavaresu katādhikāro anekāsu jātīsu vivaṭṭūpanissayāni kusalakammāni upacinanto padumuttarassa bhagavato kāle kulagehe nibbatto vuddhimanvāya gharāvāsaṃ saṇṭhapetvā kāme ādīnavaṃ disvā gehaṃ pahāya tāpasapabbajjaṃ pabbajitvā himavante vasanto tatthāgataṃ bhagavantaṃ disvā pasanno vanditvā tiṇasantharaṃ santharitvā tattha nisinnassa bhagavato naḷamālehi bījaniṃ katvā bījetvā adāsi.","Paṭiggahesi bhagavā tassānukampāya, anumodanañca akāsi.","So tena puññena devamanussesu saṃsaranto uppannuppannabhave pariḷāhasantāpavivajjito kāyacittacetasikasukhappatto anekasukhamanubhavitvā imasmiṃ buddhuppāde ekasmiṃ kulagehe nibbatto vuddhimanvāya pubbavāsanābalena satthari pasanno pabbajitvā nacirasseva arahā ahosi. 36."]}],"after":[{"para":2827,"vripara":null,"title":"Naḷamāliyattheraapadānavaṇṇanā","lines":["Naḷamāliyattheraapadānavaṇṇanā samattā."]},{"para":2828,"vripara":null,"title":"Naḷamāliyattheraapadānavaṇṇanā","lines":["Sattamabhāṇavāravaṇṇanā samattā. 8."]}]},"tika":null,"tika2":null}
