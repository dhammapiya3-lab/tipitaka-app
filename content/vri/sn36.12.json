{"suttaId":"sn36.12","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1342,1352],"vripara":"260"},"segments":{"sn36.12:0.3":"Paṭhamaākāsasuttaṃ","sn36.12:1.1":"“Seyyathāpi, bhikkhave, ākāse vividhā vātā vāyanti.","sn36.12:1.2":"Puratthimāpi vātā vāyanti, pacchimāpi vātā vāyanti, uttarāpi vātā vāyanti, dakkhiṇāpi vātā vāyanti, sarajāpi vātā vāyanti, arajāpi vātā vāyanti, sītāpi vātā vāyanti, uṇhāpi vātā vāyanti, parittāpi vātā vāyanti, adhimattāpi vātā vāyanti.","sn36.12:1.3":"Evameva kho, bhikkhave, imasmiṃ kāyasmiṃ vividhā vedanā uppajjanti, sukhāpi vedanā uppajjati, dukkhāpi vedanā uppajjati, adukkhamasukhāpi vedanā uppajjatī”ti.","sn36.12:2.1":"“Yathāpi vātā ākāse,","sn36.12:2.2":"vāyanti vividhā puthū;","sn36.12:2.3":"Puratthimā pacchimā cāpi,","sn36.12:2.4":"uttarā atha dakkhiṇā.","sn36.12:3.1":"“Sarajā arajā capi,","sn36.12:3.2":"sītā uṇhā ca ekadā;","sn36.12:3.3":"Adhimattā parittā ca,","sn36.12:3.4":"puthū vāyanti mālutā.","sn36.12:4.1":"“Tathevimasmiṃ kāyasmiṃ,","sn36.12:4.2":"samuppajjanti vedanā;","sn36.12:4.3":"Sukhadukkhasamuppatti,","sn36.12:4.4":"adukkhamasukhā ca yā.","sn36.12:5.1":"“Yato ca bhikkhu ātāpī,","sn36.12:5.2":"sampajaññaṃ na riñcati [sampajāno nirūpadhi (ka.)];","sn36.12:5.3":"Tato so vedanā sabbā,","sn36.12:5.4":"parijānāti paṇḍito.","sn36.12:6.1":"“So vedanā pariññāya,","sn36.12:6.2":"diṭṭhe dhamme anāsavo;","sn36.12:6.3":"Kāyassa bhedā dhammaṭṭho,","sn36.12:6.4":"saṅkhyaṃ nopeti vedagū”ti.","sn36.12:6.5":"dutiyaṃ;"},"unsure":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":621,"to":621,"paras":[{"para":621,"vripara":"260-261","refs":["sn36.12:3"],"lines":["260-261. Dutiye <b>puthū vāyanti mālutā</b>ti bahū vātā vāyanti.","Sesaṃ uttānatthamevāti.","Tatiyaṃ vinā gāthāhi bujjhantānaṃ ajjhāsayena vuttaṃ."],"lineRefs":[["sn36.12:3"],["sn36.12:3"],["sn36.12:3"]]}],"wordLinks":[["sn36.12:3.3","puthū vāyanti mālutā",0,0]],"before":[{"para":620,"vripara":null,"refs":[],"lines":["2-3. Paṭhamaākāsasuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
