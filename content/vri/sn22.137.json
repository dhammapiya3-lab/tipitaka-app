{"suttaId":"sn22.137","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[830,830],"vripara":"137"},"segments":{"sn22.137:0.3":"Aniccasuttaṃ","sn22.137:1.1":"Sāvatthinidānaṃ.","sn22.137:1.2":"“Yaṃ, bhikkhave, aniccaṃ; tatra vo chando pahātabbo.","sn22.137:1.3":"Kiñca, bhikkhave, aniccaṃ?","sn22.137:1.4":"Rūpaṃ, bhikkhave, aniccaṃ; tatra vo chando pahātabbo.","sn22.137:1.5":"Vedanā aniccā…pe…","sn22.137:1.6":"saññā…","sn22.137:1.7":"saṅkhārā…","sn22.137:1.8":"viññāṇaṃ aniccaṃ; tatra vo chando pahātabbo.","sn22.137:1.9":"Yaṃ, bhikkhave, aniccaṃ; tatra vo chando pahātabbo”ti.","sn22.137:1.10":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":391,"to":394,"paras":[{"para":391,"vripara":"136-149","refs":["sn22.137:1"],"lines":["Kukkuḷavaggassa paṭhame <b>kukkuḷa</b>nti santattaṃ ādittaṃ chārikarāsiṃ viya mahāpariḷāhaṃ.","Imasmiṃ sutte dukkhalakkhaṇaṃ kathitaṃ, sesesu aniccalakkhaṇādīni.","Sabbāni cetāni pāṭiyekkaṃ puggalajjhāsayena kathitānīti."],"lineRefs":[["sn22.137:1"],["sn22.137:1"],["sn22.137:1"]]},{"para":392,"vripara":null,"refs":["sn22.137:1"],"lines":["Kukkuḷavaggo cuddasamo. 15."],"lineRefs":[["sn22.137:1"]]},{"para":393,"vripara":null,"refs":["sn22.137:1"],"lines":["Diṭṭhivaggo 1-9."],"lineRefs":[["sn22.137:1"]]},{"para":394,"vripara":null,"refs":["sn22.137:1"],"lines":["Ajjhattasuttādivaṇṇanā 150-158."],"lineRefs":[["sn22.137:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":395,"to":399,"paras":[{"para":395,"vripara":"136-149","refs":["sn22.137:1"],"lines":["Anto aggi mahanto chārikarāsi, tattha ukkuḷavikulato akkamantaṃ yāva kesaggaṃ anudahatāya kucchitaṃ kuḷanti kukkuḷaṃ, rūpavedanādi pana tatopi kañci kālaṃ anudahanato mahāpariḷāhanaṭṭhena ca kukkuḷaṃ viyāti <b>kukkuḷaṃ.</b>","<b>Aniccalakkhaṇādīnī</b>ti aniccadukkhānattalakkhaṇāni."],"lineRefs":[["sn22.137:1"],["sn22