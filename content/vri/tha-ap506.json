{"suttaId":"tha-ap506","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3055,3072],"vripara":"57"},"segments":{"tha-ap506:0.3":"Avaṭaphaliyattheraapadānaṃ","tha-ap506:1.1":"“Sahassaraṃsī bhagavā, sayambhū aparājito;","tha-ap506:1.3":"Vivekā uṭṭhahitvāna, gocarāyābhinikkhami.","tha-ap506:2.1":"“Phalahattho ahaṃ disvā, upagacchiṃ narāsabhaṃ;","tha-ap506:2.3":"Pasannacitto sumano, avaṭaṃ adadiṃ phalaṃ.","tha-ap506:3.1":"“Catunnavutito kappe, yaṃ phalaṃ adadiṃ tadā;","tha-ap506:3.3":"Duggatiṃ nābhijānāmi, phaladānassidaṃ phalaṃ.","tha-ap506:4.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap506:5.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap506:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap506:7.1":"Itthaṃ sudaṃ āyasmā avaṭaphaliyo thero imā gāthāyo Abhāsitthāti.","tha-ap506:8.1":"Avaṭaphaliyattherassāpadānaṃ catutthaṃ."},"attha":null,"tika":null}
