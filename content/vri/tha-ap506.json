{"suttaId":"tha-ap506","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3055,3072],"vripara":"57"},"segments":{"tha-ap506:0.3":"Avaṭaphaliyattheraapadānaṃ","tha-ap506:1.1":"“Sahassaraṃsī bhagavā,","tha-ap506:1.2":"sayambhū aparājito;","tha-ap506:1.3":"Vivekā uṭṭhahitvāna,","tha-ap506:1.4":"gocarāyābhinikkhami. 58.","tha-ap506:2.1":"“Phalahattho ahaṃ disvā,","tha-ap506:2.2":"upagacchiṃ narāsabhaṃ;","tha-ap506:2.3":"Pasannacitto sumano,","tha-ap506:2.4":"avaṭaṃ adadiṃ phalaṃ. 59.","tha-ap506:3.1":"“Catunnavutito kappe,","tha-ap506:3.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap506:3.3":"Duggatiṃ nābhijānāmi,","tha-ap506:3.4":"phaladānassidaṃ phalaṃ. 60.","tha-ap506:4.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap506:4.3":"viharāmi anāsavo. 61.","tha-ap506:5.1":"“Svāgataṃ vata me āsi…pe…","tha-ap506:5.3":"kataṃ buddhassa sāsanaṃ. 62.","tha-ap506:6.1":"“Paṭisambhidā catasso…pe…","tha-ap506:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap506:7.1":"Itthaṃ sudaṃ āyasmā avaṭaphaliyo thero imā gāthāyo Abhāsitthāti.","tha-ap506:8.1":"Avaṭaphaliyattherassāpadānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
