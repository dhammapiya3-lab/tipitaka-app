{"suttaId":"thig1.14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[72,75],"vripara":"14"},"segments":{"thig1.14:0.3":"Sumanātherīgāthā","thig1.14:1.1":"“Dhātuyo dukkhato disvā, mā jātiṃ punarāgami;","thig1.14:1.3":"Bhave chandaṃ virājetvā, upasantā carissasī”ti.","thig1.14:2.1":"… Sumanā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":238,"to":238,"paras":[{"para":238,"vripara":null,"refs":["thig1.14:1"],"lines":["Tattha <b>dhātuyo dukkhato disvā</b>ti sasantatipariyāpannā cakkhādidhātuyo itarāpi ca udayabbayapaṭipīḷanādinā “dukkhā”ti ñāṇacakkhunā disvā.","<b>Mā jātiṃ punarāgamī</b>ti puna jātiṃ āyatiṃ punabbhavaṃ mā upagacchi.","<b>Bhave chandaṃ virājetvā</b>ti kāmabhavādike sabbasmiṃ bhave taṇhāchandaṃ virāgasaṅkhātena maggena pajahitvā.","<b>Upasantā carissasī</b>ti sabbaso pahīnakilesatāya nibbutā viharissasi."],"lineRefs":[["thig1.14:1"],["thig1.14:1"],["thig1.14:1"],["thig1.14:1"]]}],"wordLinks":[["thig1.14:1.1","dhātuyo dukkhato disvā",0,0],["thig1.14:1.1","mā jātiṃ punarāgamī",0,1],["thig1.14:1.3","bhave chandaṃ virājetvā",0,2],["thig1.14:1.3","upasantā carissasī",0,3]]},"tika":null}
