{"suttaId":"thig1.14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[72,75],"vripara":"14"},"segments":{"thig1.14:0.3":"Sumanātherīgāthā","thig1.14:1.1":"“Dhātuyo dukkhato disvā,","thig1.14:1.2":"mā jātiṃ punarāgami;","thig1.14:1.3":"Bhave chandaṃ virājetvā,","thig1.14:1.4":"upasantā carissasī”ti.","thig1.14:2.1":"… Sumanā therī …."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":238,"to":238,"paras":[{"para":238,"vripara":null,"refs":["thig1.14:1"],"lines":["Tattha <b>dhātuyo dukkhato disvā</b>ti sasantatipariyāpannā cakkhādidhātuyo itarāpi ca udayabbayapaṭipīḷanādinā “dukkhā”ti ñāṇacakkhunā disvā.","<b>Mā jātiṃ punarāgamī</b>ti puna jātiṃ āyatiṃ punabbhavaṃ mā upagacchi.","<b>Bhave chandaṃ virājetvā</b>ti kāmabhavādike sabbasmiṃ bhave taṇhāchandaṃ virāgasaṅkhātena maggena pajahitvā.","<b>Upasantā carissasī</b>ti sabbaso pahīnakilesatāya nibbutā viharissasi."],"lineRefs":[["thig1.14:1"],["thig1.14:1"],["thig1.14:1"],["thig1.14:1"]]}],"wordLinks":[["thig1.14:1.1","dhātuyo dukkhato disvā",0,0],["thig1.14:1.1","mā jātiṃ punarāgamī",0,1],["thig1.14:1.3","bhave chandaṃ virājetvā",0,2],["thig1.14:1.3","upasantā carissasī",0,3]],"before":[{"para":232,"vripara":null,"title":"Sumanātherīgāthāvaṇṇanā","lines":["Sumanātherīgāthāvaṇṇanā"]},{"para":233,"vripara":null,"title":"Sumanātherīgāthāvaṇṇanā","lines":["<b>Dhātuyo dukkhato disvā</b>ti sumanāya theriyā gāthā.","Tassā vatthu tissātheriyā vatthusadisaṃ.","Imissāpi hi satthā obhāsaṃ vissajjetvā purato nisinno viya attānaṃ dassetvā –"]},{"para":235,"vripara":"14","title":"Sumanātherīgāthāvaṇṇanā","lines":["“Dhātuyo dukkhato disvā, mā jātiṃ punarāgami;"]},{"para":236,"vripara":null,"title":"Sumanātherīgāthāvaṇṇanā","lines":["Bhave chandaṃ virājetvā, upasantā carissasī”ti.","–"]},{"para":237,"vripara":null,"title":"Sumanātherīgāthāvaṇṇanā","lines":["Imaṃ gāthamāha.","Sā gāthāpariyosāne arahattaṃ pāpuṇi."]}],"after":[{"para":239,"vripara":null,"title":"Sumanātherīgāthāvaṇṇanā","lines":["Ettha ca “dhātuyo dukkhato disvā”ti iminā dukkhānupassanāmukhena vipassanā dassitā.","“Bhave chandaṃ virājetvā”ti iminā maggo,“upasantā carissasī”ti iminā saupādisesā nibbānadhātu,“mā jātiṃ punarāgamī”ti iminā anupādisesā nibbānadhātu dassitāti daṭṭhabbaṃ."]},{"para":240,"vripara":null,"title":"Sumanātherīgāthāvaṇṇanā","lines":["Sumanātherīgāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
