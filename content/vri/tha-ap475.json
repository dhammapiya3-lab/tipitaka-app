{"suttaId":"tha-ap475","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1628,1675],"vripara":"30"},"segments":{"tha-ap475:0.3":"Ukkāsatikattheraapadānaṃ","tha-ap475:1.1":"“Kosiko nāma bhagavā,","tha-ap475:1.2":"cittakūṭe vasī tadā;","tha-ap475:1.3":"Jhāyī jhānarato buddho,","tha-ap475:1.4":"vivekābhirato muni. 31.","tha-ap475:2.1":"“Ajjhogāhetvā [ajjhogahetvā (sī. syā. pī.)] himavantaṃ,","tha-ap475:2.2":"nārīgaṇapurakkhato;","tha-ap475:2.3":"Addasaṃ kosikaṃ buddhaṃ,","tha-ap475:2.4":"puṇṇamāyeva candimaṃ. 32.","tha-ap475:3.1":"“Ukkāsate gahetvāna,","tha-ap475:3.2":"parivāresahaṃ tadā;","tha-ap475:3.3":"Sattarattindivaṃ ṭhatvā [buddho (syā. ka.)],","tha-ap475:3.4":"aṭṭhamena agacchahaṃ. 33.","tha-ap475:4.1":"“Vuṭṭhitaṃ kosikaṃ buddhaṃ,","tha-ap475:4.2":"sayambhuṃ aparājitaṃ;","tha-ap475:4.3":"Pasannacitto vanditvā,","tha-ap475:4.4":"ekaṃ bhikkhaṃ adāsahaṃ. 34.","tha-ap475:5.1":"“Tena kammena dvipadinda,","tha-ap475:5.2":"lokajeṭṭha narāsabha;","tha-ap475:5.3":"Uppajjiṃ tusite kāye,","tha-ap475:5.4":"ekabhikkhāyidaṃ phalaṃ. 35.","tha-ap475:6.1":"“Divasañceva rattiñca,","tha-ap475:6.2":"āloko hoti me sadā;","tha-ap475:6.3":"Samantā yojanasataṃ,","tha-ap475:6.4":"obhāsena pharāmahaṃ. 36.","tha-ap475:7.1":"“Pañcapaññāsakappamhi,","tha-ap475:7.2":"cakkavattī ahosahaṃ;","tha-ap475:7.3":"Cāturanto vijitāvī,","tha-ap475:7.4":"jambumaṇḍassa [jambusaṇḍassa (pī.)] issaro. 37.","tha-ap475:8.1":"“Tadā me nagaraṃ āsi,","tha-ap475:8.2":"iddhaṃ phītaṃ sunimmitaṃ;","tha-ap475:8.3":"Tiṃsayojanamāyāmaṃ,","tha-ap475:8.4":"vitthārena ca vīsati. 38.","tha-ap475:9.1":"“Sobhaṇaṃ nāma nagaraṃ,","tha-ap475:9.2":"vissakammena māpitaṃ;","tha-ap475:9.3":"Dasasaddāvivittaṃ taṃ,","tha-ap475:9.4":"sammatāḷasamāhitaṃ. 39.","tha-ap475:10.1":"“Na tamhi nagare atthi,","tha-ap475:10.2":"vallikaṭṭhañca mattikā;","tha-ap475:10.3":"Sabbasoṇṇamayaṃyeva,","tha-ap475:10.4":"jotate niccakālikaṃ. 40.","tha-ap475:11.1":"“Catupākāraparikkhittaṃ,","tha-ap475:11.2":"tayo āsuṃ maṇimayā;","tha-ap475:11.3":"Vemajjhe tālapantī ca,","tha-ap475:11.4":"vissakammena māpitā. 41.","tha-ap475:12.1":"“Dasasahassapokkharañño,","tha-ap475:12.2":"padumuppalachāditā;","tha-ap475:12.3":"Puṇḍarīkehi [puṇḍarīkādi (syā.)] sañchannā,","tha-ap475:12.4":"nānāgandhasamīritā. 42.","tha-ap475:13.1":"“Catunnavutito kappe,","tha-ap475:13.2":"yaṃ ukkaṃ dhārayiṃ ahaṃ;","tha-ap475:13.3":"Duggatiṃ nābhijānāmi, ukkadhārassidaṃ phalaṃ. 43.","tha-ap475:14.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap475:14.3":"viharāmi anāsavo. 44.","tha-ap475:15.1":"“Svāgataṃ vata me āsi…pe…","tha-ap475:15.3":"kataṃ buddhassa sāsanaṃ. 45.","tha-ap475:16.1":"“Paṭisambhidā catasso…pe…","tha-ap475:16.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap475:17.1":"Itthaṃ sudaṃ āyasmā ukkāsatiko thero imā gāthāyo Abhāsitthāti.","tha-ap475:18.1":"Ukkāsatikattherassāpadānaṃ tatiyaṃ. 4."},"unsure":["tha-ap475:13.3"],"preface":[],"attha":null,"tika":null,"tika2":null}
