{"suttaId":"kp2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Khp","vriCode":"s0501m.mul","paras":[16,26],"vripara":"1"},"segments":{"kp2:0.2":"Dasasikkhāpadaṃ","kp2:1.1":"Pāṇātipātā veramaṇī-sikkhāpadaṃ [veramaṇīsikkhāpadaṃ (sī. syā.)] samādiyāmi. 2.","kp2:2.1":"Adinnādānā veramaṇī-sikkhāpadaṃ samādiyāmi. 3.","kp2:3.1":"Abrahmacariyā veramaṇī-sikkhāpadaṃ samādiyāmi. 4.","kp2:4.1":"Musāvādā veramaṇī-sikkhāpadaṃ samādiyāmi. 5.","kp2:5.1":"Surāmerayamajjapamādaṭṭhānā veramaṇī-sikkhāpadaṃ samādiyāmi. 6.","kp2:6.1":"Vikālabhojanā veramaṇī-sikkhāpadaṃ samādiyāmi. 7.","kp2:7.1":"Nacca-gīta-vādita-visūkadassanā veramaṇī-sikkhāpadaṃ samādiyāmi. 8.","kp2:8.1":"Mālā-gandha-vilepana-dhāraṇa-maṇḍana-vibhūsanaṭṭhānā veramaṇī-sikkhāpadaṃ samādiyāmi. 9.","kp2:9.1":"Uccāsayana-mahāsayanā veramaṇī-sikkhāpadaṃ samādiyāmi. 10.","kp2:10.1":"Jātarūpa-rajatapaṭiggahaṇā veramaṇī-sikkhāpadaṃ samādiyāmi.","kp2:11.1":"Dasasikkhāpadaṃ [dasasikkhāpadaṃ niṭṭhitaṃ (syā.)] niṭṭhitaṃ. 3."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
