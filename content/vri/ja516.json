{"suttaId":"ja516","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[9904,10042],"vripara":"178"},"segments":{"ja516:0.4":"Mahākapijātakaṃ (6)","ja516:1.1":"Bārāṇasyaṃ [bārāṇassaṃ (sī. pī.)] ahū rājā,","ja516:1.2":"kāsīnaṃ raṭṭhavaḍḍhano;","ja516:1.3":"Mittāmaccaparibyūḷho,","ja516:1.4":"agamāsi migājinaṃ [migājiraṃ (sī.), migāciraṃ (pī.)]. 179.","ja516:2.1":"Tattha brāhmaṇamaddakkhi,","ja516:2.2":"setaṃ citraṃ kilāsinaṃ;","ja516:2.3":"Viddhastaṃ koviḷāraṃva,","ja516:2.4":"kisaṃ dhamanisanthataṃ. 180.","ja516:3.1":"Paramakāruññataṃ pattaṃ,","ja516:3.2":"disvā kicchagataṃ naraṃ;","ja516:3.3":"Avaca byamhito rājā,","ja516:3.4":"“yakkhānaṃ katamo nusi. 181.","ja516:4.1":"“Hatthapādā ca te setā,","ja516:4.2":"tato setataraṃ [setataro (pī.)] siro;","ja516:4.3":"Gattaṃ kammāsavaṇṇaṃ te,","ja516:4.4":"kilāsabahulo casi. 182.","ja516:5.1":"“Vaṭṭanāvaḷi [vaṭṭhanāvali (pī.)] saṅkāsā,","ja516:5.2":"piṭṭhi te ninnatunnatā;","ja516:5.3":"Kāḷapabbāva [kāḷapabbā ca (syā.), kāḷā pabbā ca (pī.)] te aṅgā,","ja516:5.4":"nāññaṃ passāmi edisaṃ. 183.","ja516:6.1":"“Ugghaṭṭapādo tasito,","ja516:6.2":"kiso dhamanisanthato;","ja516:6.3":"Chāto ātattarūposi [ādittarūposi (ka.), atittarūposi (syā. ka. aṭṭha.)],","ja516:6.4":"kutosi kattha gacchasi. 184.","ja516:7.1":"“Duddasī appakārosi,","ja516:7.2":"dubbaṇṇo bhīmadassano;","ja516:7.3":"Janetti yāpi te mātā,","ja516:7.4":"na taṃ iccheyya passituṃ. 185.","ja516:8.1":"“Kiṃ kammamakaraṃ [kammamakarā (sī. syā. pī.)] pubbe,","ja516:8.2":"kaṃ avajjhaṃ aghātayi;","ja516:8.3":"Kibbisaṃ yaṃ karitvāna,","ja516:8.4":"idaṃ dukkhaṃ upāgami”. 186.","ja516:9.1":"Taggha te ahamakkhissaṃ,","ja516:9.2":"yathāpi kusalo tathā;","ja516:9.3":"Saccavādiñhi lokasmiṃ,","ja516:9.4":"pasaṃsantīdha paṇḍitā. 187.","ja516:10.1":"Eko caraṃ gogaveso,","ja516:10.2":"mūḷho accasariṃ vane;","ja516:10.3":"Araññe irīṇe [īriṇe (sī. syā. pī.)] vivane,","ja516:10.4":"nānākuñjarasevite. 188.","ja516:11.1":"Vāḷamigānucarite,","ja516:11.2":"vippanaṭṭhosmi kānane;","ja516:11.3":"Acariṃ tattha sattāhaṃ,","ja516:11.4":"khuppipāsa [khuppipāsā (sī. pī.)] samappito. 189.","ja516:12.1":"Tattha tindukamaddakkhiṃ,","ja516:12.2":"visamaṭṭhaṃ bubhukkhito;","ja516:12.3":"Papātamabhilambantaṃ,","ja516:12.4":"sampannaphaladhārinaṃ. 190.","ja516:13.1":"Vātassitāni bhakkhesiṃ,","ja516:13.2":"tāni rucciṃsu me bhusaṃ;","ja516:13.3":"Atitto rukkhamārūhiṃ [māruyha (sī. syā.)],","ja516:13.4":"tattha hessāmi āsito. 191.","ja516:14.1":"Ekaṃ me bhakkhitaṃ āsi,","ja516:14.2":"dutiyaṃ abhipatthitaṃ;","ja516:14.3":"Tato sā bhañjatha sākhā,","ja516:14.4":"chinnā pharasunā viya. 192.","ja516:15.1":"Sohaṃ sahāva sākhāhi,","ja516:15.2":"uddhaṃpādo avaṃsiro;","ja516:15.3":"Appatiṭṭhe anālambe,","ja516:15.4":"giriduggasmi pāpataṃ. 193.","ja516:16.1":"Yasmā ca vāri gambhīraṃ,","ja516:16.2":"tasmā na samapajjisaṃ [samapajjasiṃ (sī.), samabhajjisaṃ (pī.)];","ja516:16.3":"Tattha sesiṃ nirānando,","ja516:16.4":"anūnā [anātho (sī.)] dasa rattiyo. 194.","ja516:17.1":"Athettha kapi māgañchi [māgacchi (syā. ka.)],","ja516:17.2":"gonaṅgulo darīcaro;","ja516:17.3":"Sākhāhi sākhaṃ vicaranto,","ja516:17.4":"khādamāno dumapphalaṃ. 195.","ja516:18.1":"So maṃ disvā kisaṃ paṇḍuṃ,","ja516:18.2":"kāruññamakaraṃ mayi;","ja516:18.3":"Ambho ko nāma so ettha,","ja516:18.4":"evaṃ dukkhena aṭṭito. 196.","ja516:19.1":"Manusso amanusso vā,","ja516:19.2":"attānaṃ me pavedaya;","ja516:19.3":"Tassañjaliṃ paṇāmetvā,","ja516:19.4":"idaṃ vacanamabraviṃ. 197.","ja516:20.1":"Manussohaṃ byasampatto [vasampatto (syā. ka.)],","ja516:20.2":"sā me natthi ito gati;","ja516:20.3":"Taṃ vo vadāmi bhaddaṃ vo,","ja516:20.4":"tvañca me saraṇaṃ bhava. 198.","ja516:21.1":"Garuṃ [garu (sī. pī.)] silaṃ gahetvāna,","ja516:21.2":"vicarī [vicari (pī.)] pabbate kapi;","ja516:21.3":"Silāya yoggaṃ katvāna,","ja516:21.4":"nisabho etadabravi. 199.","ja516:22.1":"Ehi me piṭṭhimāruyha,","ja516:22.2":"gīvaṃ gaṇhāhi bāhubhi;","ja516:22.3":"Ahaṃ taṃ uddharissāmi,","ja516:22.4":"giriduggata vegasā. 200.","ja516:23.1":"Tassa taṃ vacanaṃ sutvā,","ja516:23.2":"vānarindassa sirīmato;","ja516:23.3":"Piṭṭhimāruyha dhīrassa,","ja516:23.4":"gīvaṃ bāhāhi aggahiṃ. 201.","ja516:24.1":"So maṃ tato samuṭṭhāsi,","ja516:24.2":"tejassī [tejasī (syā. pī. ka.)] balavā kapi;","ja516:24.3":"Vihaññamāno kicchena,","ja516:24.4":"giriduggata vegasā. 202.","ja516:25.1":"Uddharitvāna maṃ santo,","ja516:25.2":"nisabho etadabravi;","ja516:25.3":"Iṅgha maṃ samma rakkhassu, passupissaṃ muhuttakaṃ. 203.","ja516:26.1":"Sīhā byagghā ca dīpī ca,","ja516:26.2":"acchakokataracchayo;","ja516:26.3":"Te maṃ pamattaṃ hiṃseyyuṃ,","ja516:26.4":"te tvaṃ disvā nivāraya [disvāna vāraya (pī.)]. 204.","ja516:27.1":"Evaṃ me parittātūna [parittātuna (ka.)], passupi so muhuttakaṃ;","ja516:27.3":"Tadāhaṃ pāpikaṃ diṭṭhiṃ,","ja516:27.4":"paṭilacchiṃ ayoniso. 205.","ja516:28.1":"Bhakkho ayaṃ manussānaṃ,","ja516:28.2":"yathā caññe vane migā;","ja516:28.3":"Yaṃ nūnimaṃ vadhitvāna,","ja516:28.4":"chāto khādeyya vānaraṃ. 206.","ja516:29.1":"Asito [āsiko (pī.)] ca gamissāmi,","ja516:29.2":"maṃsamādāya sambalaṃ;","ja516:29.3":"Kantāraṃ nittharissāmi,","ja516:29.4":"pātheyyaṃ me bhavissati. 207.","ja516:30.1":"Tato silaṃ gahetvāna,","ja516:30.2":"matthakaṃ sannitāḷayiṃ;","ja516:30.3":"Mama gatta [bhatta (sī. syā.), hattha (pī.)] kilantassa,","ja516:30.4":"pahāro dubbalo ahu. 208.","ja516:31.1":"So ca vegenudappatto,","ja516:31.2":"kapi ruhira [rudhira (sī.)] makkhito;","ja516:31.3":"Assupuṇṇehi nettehi,","ja516:31.4":"rodanto maṃ udikkhati. 209.","ja516:32.1":"Māyyomaṃ kari bhaddante,","ja516:32.2":"tvañca nāmedisaṃ kari;","ja516:32.3":"Tvañca kho nāma dīghāvu [dīghāyu (pī.)],","ja516:32.4":"aññe [aññaṃ (pī.)] vāretumarahasi. 210.","ja516:33.1":"Aho vata re purisa,","ja516:33.2":"tāva dukkarakāraka;","ja516:33.3":"Edisā visamā duggā,","ja516:33.4":"papātā uddhato [uddhaṭo (pī.)] mayā. 211.","ja516:34.1":"Ānīto paralokāva,","ja516:34.2":"dubbheyyaṃ maṃ amaññatha;","ja516:34.3":"Taṃ tena pāpadhammena,","ja516:34.4":"pāpaṃ pāpena cintitaṃ. 212.","ja516:35.1":"Mā heva tvaṃ adhammaṭṭha,","ja516:35.2":"vedanaṃ kaṭukaṃ phusi;","ja516:35.3":"Mā heva pāpakammaṃ taṃ,","ja516:35.4":"phalaṃ veḷuṃva taṃ vadhi. 213.","ja516:36.1":"Tayime natthi vissāso,","ja516:36.2":"pāpadhamma asaññata [pāpadhammaṃ amaññatha (pī.)];","ja516:36.3":"Ehi me piṭṭhito gaccha,","ja516:36.4":"dissamānova santike. 214.","ja516:37.1":"Muttosi hatthā vāḷānaṃ,","ja516:37.2":"pattosi mānusiṃ padaṃ;","ja516:37.3":"Esa maggo adhammaṭṭha,","ja516:37.4":"tena gaccha yathāsukhaṃ. 215.","ja516:38.1":"Idaṃ vatvā giricaro,","ja516:38.2":"rahade [ruhiraṃ (syā. ka.)] pakkhalya matthakaṃ;","ja516:38.3":"Assūni sampamajjitvā,","ja516:38.4":"tato pabbatamāruhi. 216.","ja516:39.1":"Sohaṃ tenābhisattosmi,","ja516:39.2":"pariḷāhena aṭṭito;","ja516:39.3":"Ḍayhamānena gattena,","ja516:39.4":"vāriṃ pātuṃ upāgamiṃ. 217.","ja516:40.1":"Agginā viya santatto,","ja516:40.2":"rahado ruhiramakkhito;","ja516:40.3":"Pubbalohitasaṅkāso,","ja516:40.4":"sabbo me samapajjatha. 218.","ja516:41.1":"Yāvanto udabindūni,","ja516:41.2":"kāyasmiṃ nipatiṃsu me;","ja516:41.3":"Tāvanto gaṇḍa [gaṇḍū (sī. pī.), gaṇḍu (syā.)] jāyetha,","ja516:41.4":"addhabeluvasādisā. 219.","ja516:42.1":"Pabhinnā pagghariṃsu me,","ja516:42.2":"kuṇapā pubbalohitā;","ja516:42.3":"Yena yeneva gacchāmi,","ja516:42.4":"gāmesu nigamesu ca. 220.","ja516:43.1":"Daṇḍahatthā nivārenti,","ja516:43.2":"itthiyo purisā ca maṃ;","ja516:43.3":"Okkitā [okiṇṇā (sī.)] pūtigandhena,","ja516:43.4":"māssu orena āgamā [māgamā (sī. pī.)]. 221.","ja516:44.1":"Etādisaṃ idaṃ dukkhaṃ,","ja516:44.2":"satta vassāni dāni me;","ja516:44.3":"Anubhomi sakaṃ kammaṃ,","ja516:44.4":"pubbe dukkaṭamattano. 222.","ja516:45.1":"Taṃ vo vadāmi bhaddante [bhaddaṃ vo (sī. pī.)],","ja516:45.2":"yāvantettha samāgatā;","ja516:45.3":"Māssu mittāna [mittānaṃ (sī. pī.)] dubbhittho,","ja516:45.4":"mittadubbho hi pāpako. 223.","ja516:46.1":"Kuṭṭhī kilāsī bhavati,","ja516:46.2":"yo mittānidha dubbhati [yo mittānaṃ idhaddubhi (sī. aṭṭha.), yo mittānaṃ idha dubbhati (pī.)];","ja516:46.3":"Kāyassa bhedā mittaddu [mittadubbhī (syā. ka.)],","ja516:46.4":"nirayaṃ sopapajjatīti [so upapajjatīti (sī. syā. pī.)].","ja516:47.1":"Mahākapijātakaṃ chaṭṭhaṃ. 517."},"unsure":["ja516:25.3","ja516:27.1"],"preface":[],"attha":{"book":"Ja-a-vi-b","bookName":"Jātaka-aṭṭhakathā-5","vriCode":"s0513a4.att","from":6131,"to":6131,"paras":[{"para":6131,"vripara":null,"refs":["ja516:8"],"lines":["Tattha <b>bārāṇasya</b>nti bārāṇasiyaṃ.","<b>Mittāmaccaparibyūḷho</b>ti mittehi ca daḷhabhattīhi amaccehi ca parivuto.","<b>Migājina</b>nti evaṃnāmakaṃ uyyānaṃ.","<b>Seta</b>nti setakuṭṭhena setaṃ kabarakuṭṭhena vicitraṃ paribhinnena kaṇḍūyanakilāsakuṭṭhena kilāsinaṃ vedanāppattaṃ kadalipaṇṇe nipannaṃ addasa.","<b>Viddhastaṃ koviḷāraṃvā</b>ti vaṇamukhehi paggharantena maṃsena viddhastaṃ pupphitakoviḷārasadisaṃ.","<b>Kisa</b>nti ekaccesu padesesu aṭṭhicammamattasarīraṃ sirājālasanthataṃ.","<b>Byamhito</b>ti bhīto vimhayamāpanno vā.","<b>Yakkhāna</b>nti yakkhānaṃ antare tvaṃ katarayakkho nāmāsi.","<b>Vaṭṭanāvaḷisaṅkāsā</b>ti piṭṭhikaṇṭakaṭṭhāne āvunitvā ṭhapitāvaṭṭanāvaḷisadisā.","<b>Aṅgā</b>ti kāḷapabbavallisadisāni te aṅgāni.","<b>Nāñña</b>nti aññaṃ purisaṃ edisaṃ na passāmi.","<b>Ugghaṭṭapādo</b>ti rajokiṇṇapādo.","<b>Ātattarūpo</b>ti sukkhasarīro.","<b>Duddasī</b>ti dukkhena passitabbo.","<b>Appakārosī</b>ti sarīrappakārarahitosi, dussaṇṭhānosīti attho.","<b>Kiṃ kammamakara</b>nti ito pubbe kiṃ kammaṃ akaraṃ, akāsīti attho.","<b>Kibbisa</b>nti dāruṇakammaṃ."],"lineRefs":[["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"]]}],"wordLinks":[["ja516:8.1","kiṃ kammamakaraṃ",0,15],["ja516:8.3","kibbisaṃ",0,16]],"after":[{"para":6132,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Tato paraṃ brāhmaṇo āha – 186."]},{"para":6134,"vripara":"186","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Taggha te ahamakkhissaṃ, yathāpi kusalo tathā;"]},{"para":6135,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Saccavādiñhi lokasmiṃ, pasaṃsantīdha paṇḍitā. 187."]},{"para":6137,"vripara":"187","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Eko caraṃ gogaveso, mūḷho accasariṃ vane;"]},{"para":6138,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Araññe irīṇe vivane, nānākuñjarasevite. 188."]},{"para":6140,"vripara":"188","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Vāḷamigānucarite, vippanaṭṭhosmi kānane;"]},{"para":6141,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Acariṃ tattha sattāhaṃ, khuppipāsasamappito. 189."]},{"para":6143,"vripara":"189","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Tattha tindukamaddakkhiṃ, visamaṭṭhaṃ bubhukkhito;"]},{"para":6144,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Papātamabhilambantaṃ, sampannaphaladhārinaṃ. 190."]},{"para":6146,"vripara":"190","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Vātassitāni bhakkhesiṃ, tāni rucciṃsu me bhusaṃ;"]},{"para":6147,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Atitto rukkhamārūhiṃ, tattha hessāmi āsito. 191."]},{"para":6149,"vripara":"191","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Ekaṃ me bhakkhitaṃ āsi, dutiyaṃ abhipatthitaṃ;"]},{"para":6150,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Tato sā bhañjatha sākhā, chinnā pharasunā viya. 192."]},{"para":6152,"vripara":"192","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Sohaṃ sahāva sākhāhi, uddhaṃpādo avaṃsiro;"]},{"para":6153,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Appatiṭṭhe anālambe, giriduggasmi pāpataṃ. 193."]},{"para":6155,"vripara":"193","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Yasmā ca vāri gambhīraṃ, tasmā na samapajjisaṃ;"]},{"para":6156,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Tattha sesiṃ nirānando, anūnā dasa rattiyo. 194."]},{"para":6158,"vripara":"194","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Athettha kapi māgañchi, gonaṅgulo darīcaro;"]},{"para":6159,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Sākhāhi sākhaṃ vicaranto, khādamāno dumapphalaṃ. 195."]},{"para":6161,"vripara":"195","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“So maṃ disvā kisaṃ paṇḍuṃ, kāruññamakaraṃ mayi;"]},{"para":6162,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Ambho ko nāma so ettha, evaṃ dukkhena aṭṭito. 196."]},{"para":6164,"vripara":"196","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Manusso amanusso vā, attānaṃ me pavedaya;"]},{"para":6165,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Tassañjaliṃ paṇāmetvā, idaṃ vacanamabraviṃ. 197."]},{"para":6167,"vripara":"197","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Manussohaṃ byasampatto, sā me natthi ito gati;"]},{"para":6168,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Taṃ vo vadāmi bhaddaṃ vo, tvañca me saraṇaṃ bhava. 198."]},{"para":6170,"vripara":"198","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Garuṃ silaṃ gahetvāna, vicarī pabbate kapi;"]},{"para":6171,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Silāya yoggaṃ katvāna, nisabho etadabravi. 199."]},{"para":6173,"vripara":"199","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Ehi me piṭṭhimāruyha, gīvaṃ gaṇhāhi bāhubhi;"]},{"para":6174,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Ahaṃ taṃ uddharissāmi, giriduggata vegasā. 200."]},{"para":6176,"vripara":"200","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Tassa taṃ vacanaṃ sutvā, vānarindassa sirīmato;"]},{"para":6177,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Piṭṭhimāruyha dhīrassa, gīvaṃ bāhāhi aggahiṃ. 201."]},{"para":6179,"vripara":"201","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“So maṃ tato samuṭṭhāsi, tejassī balavā kapi;"]},{"para":6180,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Vihaññamāno kicchena, giriduggata vegasā. 202."]},{"para":6182,"vripara":"202","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Uddharitvāna maṃ santo, nisabho etadabravi;"]},{"para":6183,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Iṅgha maṃ samma rakkhassu, pasupissaṃ muhuttakaṃ. 203."]},{"para":6185,"vripara":"203","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Sīhā byagghā ca dīpī ca, acchakokataracchayo;"]},{"para":6186,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Te maṃ pamattaṃ hiṃseyyuṃ, te tvaṃ disvā nivāraya. 204."]},{"para":6188,"vripara":"204","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Evaṃ me parittātūna, pasupī so muhuttakaṃ;"]},{"para":6189,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Tadāhaṃ pāpikaṃ diṭṭhiṃ, paṭilacchiṃ ayoniso. 205."]},{"para":6191,"vripara":"205","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Bhakkho ayaṃ manussānaṃ, yathā caññe vane migā;"]},{"para":6192,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Yaṃ nūnimaṃ vadhitvāna, chāto khādeyya vānaraṃ. 206."]},{"para":6194,"vripara":"206","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Asito ca gamissāmi, maṃsamādāya sambalaṃ;"]},{"para":6195,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Kantāraṃ nittharissāmi, pātheyyaṃ me bhavissati. 207."]},{"para":6197,"vripara":"207","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Tato silaṃ gahetvāna, matthakaṃ sannitāḷayiṃ;"]},{"para":6198,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Mama gattakilantassa, pahāro dubbalo ahu. 208."]},{"para":6200,"vripara":"208","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“So ca vegenudappatto, kapi ruhiramakkhito;"]},{"para":6201,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Assupuṇṇehi nettehi, rodanto maṃ udikkhati. 209."]},{"para":6203,"vripara":"209","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Māyyo maṃ kari bhaddante, tvañca nāmedisaṃ kari;"]},{"para":6204,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Tvañca kho nāma dīghāvu, aññe vāretumarahasi. 210."]},{"para":6206,"vripara":"210","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Aho vata re purisa, tāvadukkarakāraka;"]},{"para":6207,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Edisā visamā duggā, papātā uddhato mayā. 211."]},{"para":6209,"vripara":"211","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Ānīto paralokāva, dubbheyyaṃ maṃ amaññatha;"]},{"para":6210,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Taṃ tena pāpakammena, pāpaṃ pāpena cintitaṃ. 212."]},{"para":6212,"vripara":"212","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Mā heva tvaṃ adhammaṭṭha, vedanaṃ kaṭukaṃ phusi;"]},{"para":6213,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Mā heva pāpakammaṃ taṃ, phalaṃ veḷuṃva taṃ vadhi. 213."]},{"para":6215,"vripara":"213","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Tayi me natthi vissāso, pāpadhamma asaññata;"]},{"para":6216,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Ehi me piṭṭhito gaccha, dissamānova santike. 214."]},{"para":6218,"vripara":"214","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Muttosi hatthā vāḷānaṃ, pattosi mānusiṃ padaṃ;"]},{"para":6219,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Esa maggo adhammaṭṭha, tena gaccha yathāsukhaṃ. 215."]},{"para":6221,"vripara":"215","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Idaṃ vatvā giricaro, rahade pakkhalya matthakaṃ;"]},{"para":6222,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Assūni sampamajjitvā, tato pabbatamāruhi. 216."]},{"para":6224,"vripara":"216","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Sohaṃ tenābhisattosmi, pariḷāhena aṭṭito;"]},{"para":6225,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Ḍayhamānena gattena, vāriṃ pātuṃ upāgamiṃ. 217."]},{"para":6227,"vripara":"217","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Agginā viya santatto, rahado ruhiramakkhito;"]},{"para":6228,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Pubbalohitasaṅkāso, sabbo me samapajjatha. 218."]},{"para":6230,"vripara":"218","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Yāvanto udabindūni, kāyasmiṃ nipatiṃsu me;"]},{"para":6231,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Tāvanto gaṇḍa jāyetha, addhabeluvasādisā. 219."]},{"para":6233,"vripara":"219","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Pabhinnā pagghariṃsu me, kuṇapā pubbalohitā;"]},{"para":6234,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Yena yeneva gacchāmi, gāmesu nigamesu ca. 220."]},{"para":6236,"vripara":"220","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Daṇḍahatthā nivārenti, itthiyo purisā ca maṃ;"]},{"para":6237,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Okkitā pūtigandhena, māssu orena āgamā. 221."]},{"para":6239,"vripara":"221","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Etādisaṃ idaṃ dukkhaṃ, satta vassāni dāni me;"]},{"para":6240,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Anubhomi sakaṃ kammaṃ, pubbe dukkaṭamattano. 222."]},{"para":6242,"vripara":"222","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Taṃ vo vadāmi bhaddante, yāvantettha samāgatā;"]},{"para":6243,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Māssu mittāna dubbhittho, mittadubbho hi pāpako. 223."]},{"para":6245,"vripara":"223","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Kuṭṭhī kilāsī bhavati, yo mittānidha dubbhati;"]},{"para":6246,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Kāyassa bhedā mittaddu, nirayaṃ sopapajjatī”ti."]},{"para":6247,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Tattha <b>kusalo</b>ti yathā cheko kusalo katheti, tathā vo kathessāmi.","<b>Gogaveso</b>ti naṭṭhe goṇe gavesanto.","<b>Accasari</b>nti manussapathaṃ atikkamitvā himavantaṃ pāvisiṃ.","<b>Araññe</b>ti arājake suññe.","<b>Irīṇe</b>ti sukkhakantāre.","<b>Vivane</b>ti vivitte.","<b>Vippanaṭṭho</b>ti maggamūḷho.","<b>Bubhukkhito</b>ti sañjātabubhukkho chātajjhatto.","<b>Papātamabhilambanta</b>nti papātābhimukhaṃ olambantaṃ.","<b>Sampannaphaladhārina</b>nti madhuraphaladhārinaṃ.","<b>Vātassitānī</b>ti paṭhamaṃ tāva vātapatitāni khādiṃ.","<b>Tattha hessāmī</b>ti tasmiṃ rukkhe suhito bhavissāmīti āruḷhomhi.","<b>Tato sā bhañjatha sākhā</b>ti tassa abhipatthitassa atthāya hatthe pasārite sā mayā abhiruḷhā sākhā pharasunā chinnā viya abhañjatha.","<b>Anālambe</b>ti ālambitabbaṭṭhānarahite.","<b>Giriduggasmi</b>nti girivisame.","<b>Sesi</b>nti sayitomhi."]},{"para":6248,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["<b>Kapi māgañchī</b>ti kapi āgañchi.","<b>Gonaṅgulo</b>ti gunnaṃ naṅguṭṭhasadisanaṅguṭṭho.","“Gonaṅguṭṭho”tipi pāṭho.","“Gonaṅgulī”tipi paṭhanti.","<b>Akaraṃ mayī</b>ti akarā mayi.","<b>Ambho</b>ti, mahārāja, so kapirājā tasmiṃ narakapapāte mama udakapothanasaddaṃ sutvā maṃ “ambho”ti ālapitvā “ko nāmeso”ti pucchi.","<b>Byasampatto</b>ti byasanaṃ patto, papātassa vasaṃ pattoti vā attho.","<b>Bhaddaṃ vo</b>ti tasmā tumhe vadāmi –","“bhaddaṃ tumhākaṃ hotū”ti.","<b>Garuṃ sila</b>nti, mahārāja, so kapirājā mayā evaṃ vutte “mā bhāyī”ti maṃ assāsetvā paṭhamaṃ tāva garuṃ silaṃ gahetvā yoggaṃ karonto pabbate vicari.","<b>Nisabho</b>ti purisanisabho uttamavānarindo pabbatapapāte ṭhatvā maṃ etadabravīti."]},{"para":6249,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["<b>Bāhubhī</b>ti dvīhi bāhāhi mama gīvaṃ suggahitaṃ gaṇha.","<b>Vegasā</b>ti vegena.","<b>Sirīmato</b>ti puññavantassa.","<b>Aggahi</b>nti saṭṭhihatthaṃ narakapapātaṃ vātavegena otaritvā udakapiṭṭhe ṭhitassa ahaṃ vegena piṭṭhimabhiruhitvā ubhohi bāhāhi gīvaṃ aggahesiṃ.","<b>Vihaññamāno</b>ti kilamanto.","<b>Kicchenā</b>ti dukkhena.","<b>Santo</b>ti paṇḍito, atha vā parisanto kilanto.","<b>Rakkhassū</b>ti ahaṃ taṃ uddharanto kilanto muhuttaṃ vissamanto pasupissaṃ, tasmā maṃ rakkhāhi.","<b>Yathā caññe vane migā</b>ti sīhādīhi aññepi ye imasmiṃ vane vāḷamigā.","Pāḷiyaṃ pana “acchakokataracchayo”ti likhanti.","<b>Parittātūnā</b>ti, mahārāja, evaṃ so kapirājā maṃ attano parittāṇaṃ katvā muhuttaṃ pasupi.","<b>Ayoniso</b>ti ayonisomanasikārena.","<b>Bhakkho</b>ti khāditabbayuttako.","<b>Asito</b> dhāto suhito.","<b>Sambala</b>nti pātheyyaṃ.","<b>Matthakaṃ sannitāḷayi</b>nti tassa vānarindassa matthakaṃ pahariṃ.","“Sannitāḷaya”ntipi pāṭho.","<b>Dubbalo ahū</b>ti na balavā āsi, yathādhippāyaṃ na agamāsīti."]},{"para":6250,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["<b>Vegenā</b>ti mayā pahaṭapāsāṇavegena.","<b>Udappatto</b>ti uṭṭhito.","<b>Māyyo</b>ti tena mittadubbhipurisena silāya paviddhāya mahācammaṃ chinditvā olambi, ruhiraṃ pagghari.","Mahāsatto vedanāppatto cintesi –","“imasmiṃ ṭhāne añño natthi, idaṃ bhayaṃ imaṃ purisaṃ nissāya uppanna”nti.","So maraṇabhayabhīto olambantaṃ cammabandhaṃ hatthena gahetvā uppatitvā sākhaṃ abhiruyha tena pāpapurisena saddhiṃ sallapanto <b>“māyyo ma”</b>ntiādimāha.","Tattha <b>māyyo maṃ kari bhaddante</b>ti mā akari ayyo maṃ bhaddanteti taṃ nivāreti.","<b>Tvañca kho nāmā</b>ti tvaṃ nāma evaṃ mayā papātā uddhaṭo edisaṃ pharusakammaṃ mayi kari, aho te ayuttaṃ katanti.","<b>Aho vatā</b>ti taṃ garahanto evamāha.","<b>Tāvadukkarakārakā</b>ti mayi aparajjhanena atidukkarakammakāraka.","<b>Paralokāvā</b>ti paralokato viya ānīto.","<b>Dubbheyya</b>nti dubbhitabbaṃ vadhitabbaṃ.","<b>Vedanaṃ kaṭuka</b>nti evaṃ santepi tvaṃ adhammaṭṭha yādisaṃ vedanaṃ ahaṃ phusāmi, edisaṃ vedanaṃ kaṭukaṃ mā phusi, taṃ pāpakammaṃ phalaṃ veḷuṃva taṃ mā vadhi.","Iti maṃ, mahārāja, so piyaputtakaṃ viya anukampi."]},{"para":6251,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Atha naṃ ahaṃ etadavocaṃ –","“ayya, mayā kataṃ dosaṃ hadaye mā kari, mā maṃ asappurisaṃ evarūpe araññe nāsaya, ahaṃ disāmūḷho maggaṃ na jānāmi, attanā kataṃ kammaṃ mā nāsetha, jīvitadānaṃ me detha, araññā nīharitvā manussapathe ṭhapethā”ti.","Evaṃ vutte so mayā saddhiṃ sallapanto <b>“tayi me natthi vissāso”</b>ti ādimāha.","Tattha <b>tayī</b>ti ito paṭṭhāya mayhaṃ tayi vissāso natthi.","<b>Ehī</b>ti, bho purisa, ahaṃ tayā saddhiṃ maggena na gamissāmi, tvaṃ pana ehi mama piṭṭhito avidūre dissamānasarīrova gaccha, ahaṃ rukkhaggeheva gamissāmīti.","<b>Muttosī</b>ti atha so maṃ, mahārāja, araññā nīharitvā, bho purisa, vāḷamigānaṃ hatthā muttosi.","<b>Pattosi mānusiṃ pada</b>nti manussūpacāraṃ patto āgatosi, esa te maggo, etena gacchāti āha."]},{"para":6252,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["<b>Giricaro</b>ti giricārī vānaro.","<b>Pakkhalyā</b>ti dhovitvā.","<b>Tenābhisattosmī</b>ti so ahaṃ, mahārāja, tena vānarena abhisatto, pāpakamme pariṇate tenābhisattosmīti maññamāno evamāha.","<b>Aṭṭito</b>ti upadduto.","<b>Upāgami</b>nti ekaṃ rahadaṃ upagatosmi.","<b>Samapajjathā</b>ti jāto, evarūpo hutvā upaṭṭhāsi.","<b>Yāvanto</b>ti yattakāni.","<b>Gaṇḍa jāyethā</b>ti gaṇḍā jāyiṃsu.","So kira pipāsaṃ sandhāretuṃ asakkonto udakañjaliṃ ukkhipitvā thokaṃ pivitvā sesaṃ sarīre siñci.","Athassa tāvadeva udakabindugaṇanāya aḍḍhabeluvapakkappamāṇā gaṇḍā uṭṭhahiṃsu, tasmā evamāha.","<b>Pabhinnā</b>ti te gaṇḍā taṃ divasameva bhijjitvā kuṇapā pūtigandhikā hutvā pubbalohitāni pagghariṃsu.","<b>Yena yenā</b>ti yena yena maggena.","<b>Okkitā</b>ti pūtigandhena okiṇṇā parikkhittā parivāritā.","<b>Māssu orena āgamā</b>ti duṭṭhasatta orena māssu āgamā, amhākaṃ santikaṃ mā āgamīti evaṃ vadantā maṃ nivārentīti attho.","<b>Satta vassāni dāni me</b>ti, mahārāja, tato paṭṭhāya idāni satta vassāni mama ettakaṃ kālaṃ sakaṃ kammaṃ anubhomi."]},{"para":6253,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Iti so attano mittadubbhikammaṃ vitthāretvā, “mahārāja, maññeva oloketvā evarūpaṃ kammaṃ na kenaci kattabba”nti vatvā <b>“taṃ vo”</b>tiādimāha.","Tattha <b>ta</b>nti tasmā.","Yasmā evarūpaṃ kammaṃ evaṃ dukkhavipākaṃ, tasmāti attho. 223."]},{"para":6255,"vripara":"223","title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["“Kuṭṭhī kilāsī bhavati, yo mittānidha dubbhati;"]},{"para":6256,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Kāyassa bhedā mittaddu, nirayaṃ sopapajjatī”ti. –"]},{"para":6257,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Ayaṃ abhisambuddhagāthā.","Bhikkhave, yo idha loke mittāni dubbhati hiṃsati, so evarūpo hotīti attho."]},{"para":6258,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Tassapi purisassa raññā saddhiṃ kathentasseva pathavī vivaraṃ adāsi.","Taṅkhaṇaññeva cavitvā avīcimhi nibbatto.","Rājā tasmiṃ pathaviṃ paviṭṭhe uyyānā nikkhamitvā nagaraṃ paviṭṭho."]},{"para":6259,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā “na, bhikkhave, idāneva, pubbepi devadatto mayhaṃ silaṃ paṭivijjhiyevā”ti vatvā jātakaṃ samodhānesi –","“tadā mittadubbhī puriso devadatto ahosi, kapirājā pana ahameva ahosi”nti."]},{"para":6260,"vripara":null,"title":"[516] 6. Mahākapijātakavaṇṇanā","lines":["Mahākapijātakavaṇṇanā chaṭṭhā. [517] 7."]},{"para":6262,"vripara":null,"title":"[517] 7. Dakarakkhasajātakavaṇṇanā","lines":["Dakarakkhasajātakavaṇṇanā 224-257."]}]},"tika":null,"tika2":null}
