{"suttaId":"ja516","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[9904,10042],"vripara":"178"},"segments":{"ja516:0.4":"Mahākapijātakaṃ (6)","ja516:1.1":"Bārāṇasyaṃ [bārāṇassaṃ (sī. pī.)] ahū rājā,","ja516:1.2":"kāsīnaṃ raṭṭhavaḍḍhano;","ja516:1.3":"Mittāmaccaparibyūḷho,","ja516:1.4":"agamāsi migājinaṃ [migājiraṃ (sī.), migāciraṃ (pī.)].","ja516:2.1":"Tattha brāhmaṇamaddakkhi,","ja516:2.2":"setaṃ citraṃ kilāsinaṃ;","ja516:2.3":"Viddhastaṃ koviḷāraṃva,","ja516:2.4":"kisaṃ dhamanisanthataṃ.","ja516:3.1":"Paramakāruññataṃ pattaṃ,","ja516:3.2":"disvā kicchagataṃ naraṃ;","ja516:3.3":"Avaca byamhito rājā,","ja516:3.4":"“yakkhānaṃ katamo nusi.","ja516:4.1":"“Hatthapādā ca te setā,","ja516:4.2":"tato setataraṃ [setataro (pī.)] siro;","ja516:4.3":"Gattaṃ kammāsavaṇṇaṃ te,","ja516:4.4":"kilāsabahulo casi.","ja516:5.1":"“Vaṭṭanāvaḷi [vaṭṭhanāvali (pī.)] saṅkāsā,","ja516:5.2":"piṭṭhi te ninnatunnatā;","ja516:5.3":"Kāḷapabbāva [kāḷapabbā ca (syā.), kāḷā pabbā ca (pī.)] te aṅgā,","ja516:5.4":"nāññaṃ passāmi edisaṃ.","ja516:6.1":"“Ugghaṭṭapādo tasito,","ja516:6.2":"kiso dhamanisanthato;","ja516:6.3":"Chāto ātattarūposi [ādittarūposi (ka.), atittarūposi (syā. ka. aṭṭha.)],","ja516:6.4":"kutosi kattha gacchasi.","ja516:7.1":"“Duddasī appakārosi,","ja516:7.2":"dubbaṇṇo bhīmadassano;","ja516:7.3":"Janetti yāpi te mātā,","ja516:7.4":"na taṃ iccheyya passituṃ.","ja516:8.1":"“Kiṃ kammamakaraṃ [kammamakarā (sī. syā. pī.)] pubbe,","ja516:8.2":"kaṃ avajjhaṃ aghātayi;","ja516:8.3":"Kibbisaṃ yaṃ karitvāna,","ja516:8.4":"idaṃ dukkhaṃ upāgami”.","ja516:9.1":"Taggha te ahamakkhissaṃ,","ja516:9.2":"yathāpi kusalo tathā;","ja516:9.3":"Saccavādiñhi lokasmiṃ,","ja516:9.4":"pasaṃsantīdha paṇḍitā.","ja516:10.1":"Eko caraṃ gogaveso,","ja516:10.2":"mūḷho accasariṃ vane;","ja516:10.3":"Araññe irīṇe [īriṇe (sī. syā. pī.)] vivane,","ja516:10.4":"nānākuñjarasevite.","ja516:11.1":"Vāḷamigānucarite,","ja516:11.2":"vippanaṭṭhosmi kānane;","ja516:11.3":"Acariṃ tattha sattāhaṃ,","ja516:11.4":"khuppipāsa [khuppipāsā (sī. pī.)] samappito.","ja516:12.1":"Tattha tindukamaddakkhiṃ,","ja516:12.2":"visamaṭṭhaṃ bubhukkhito;","ja516:12.3":"Papātamabhilambantaṃ,","ja516:12.4":"sampannaphaladhārinaṃ.","ja516:13.1":"Vātassitāni bhakkhesiṃ,","ja516:13.2":"tāni rucciṃsu me bhusaṃ;","ja516:13.3":"Atitto rukkhamārūhiṃ [māruyha (sī. syā.)],","ja516:13.4":"tattha hessāmi āsito.","ja516:14.1":"Ekaṃ me bhakkhitaṃ āsi,","ja516:14.2":"dutiyaṃ abhipatthitaṃ;","ja516:14.3":"Tato sā bhañjatha sākhā,","ja516:14.4":"chinnā pharasunā viya.","ja516:15.1":"Sohaṃ sahāva sākhāhi,","ja516:15.2":"uddhaṃpādo avaṃsiro;","ja516:15.3":"Appatiṭṭhe anālambe,","ja516:15.4":"giriduggasmi pāpataṃ.","ja516:16.1":"Yasmā ca vāri gambhīraṃ,","ja516:16.2":"tasmā na samapajjisaṃ [samapajjasiṃ (sī.), samabhajjisaṃ (pī.)];","ja516:16.3":"Tattha sesiṃ nirānando,","ja516:16.4":"anūnā [anātho (sī.)] dasa rattiyo.","ja516:17.1":"Athettha kapi māgañchi [māgacchi (syā. ka.)],","ja516:17.2":"gonaṅgulo darīcaro;","ja516:17.3":"Sākhāhi sākhaṃ vicaranto,","ja516:17.4":"khādamāno dumapphalaṃ.","ja516:18.1":"So maṃ disvā kisaṃ paṇḍuṃ,","ja516:18.2":"kāruññamakaraṃ mayi;","ja516:18.3":"Ambho ko nāma so ettha,","ja516:18.4":"evaṃ dukkhena aṭṭito.","ja516:19.1":"Manusso amanusso vā,","ja516:19.2":"attānaṃ me pavedaya;","ja516:19.3":"Tassañjaliṃ paṇāmetvā,","ja516:19.4":"idaṃ vacanamabraviṃ.","ja516:20.1":"Manussohaṃ byasampatto [vasampatto (syā. ka.)],","ja516:20.2":"sā me natthi ito gati;","ja516:20.3":"Taṃ vo vadāmi bhaddaṃ vo,","ja516:20.4":"tvañca me saraṇaṃ bhava.","ja516:21.1":"Garuṃ [garu (sī. pī.)] silaṃ gahetvāna,","ja516:21.2":"vicarī [vicari (pī.)] pabbate kapi;","ja516:21.3":"Silāya yoggaṃ katvāna,","ja516:21.4":"nisabho etadabravi.","ja516:22.1":"Ehi me piṭṭhimāruyha,","ja516:22.2":"gīvaṃ gaṇhāhi bāhubhi;","ja516:22.3":"Ahaṃ taṃ uddharissāmi,","ja516:22.4":"giriduggata vegasā.","ja516:23.1":"Tassa taṃ vacanaṃ sutvā,","ja516:23.2":"vānarindassa sirīmato;","ja516:23.3":"Piṭṭhimāruyha dhīrassa,","ja516:23.4":"gīvaṃ bāhāhi aggahiṃ.","ja516:24.1":"So maṃ tato samuṭṭhāsi,","ja516:24.2":"tejassī [tejasī (syā. pī. ka.)] balavā kapi;","ja516:24.3":"Vihaññamāno kicchena,","ja516:24.4":"giriduggata vegasā.","ja516:25.1":"Uddharitvāna maṃ santo,","ja516:25.2":"nisabho etadabravi;","ja516:25.3":"Iṅgha maṃ samma rakkhassu, passupissaṃ muhuttakaṃ.","ja516:26.1":"Sīhā byagghā ca dīpī ca,","ja516:26.2":"acchakokataracchayo;","ja516:26.3":"Te maṃ pamattaṃ hiṃseyyuṃ,","ja516:26.4":"te tvaṃ disvā nivāraya [disvāna vāraya (pī.)].","ja516:27.1":"Evaṃ me parittātūna [parittātuna (ka.)], passupi so muhuttakaṃ;","ja516:27.3":"Tadāhaṃ pāpikaṃ diṭṭhiṃ,","ja516:27.4":"paṭilacchiṃ ayoniso.","ja516:28.1":"Bhakkho ayaṃ manussānaṃ,","ja516:28.2":"yathā caññe vane migā;","ja516:28.3":"Yaṃ nūnimaṃ vadhitvāna,","ja516:28.4":"chāto khādeyya vānaraṃ.","ja516:29.1":"Asito [āsiko (pī.)] ca gamissāmi,","ja516:29.2":"maṃsamādāya sambalaṃ;","ja516:29.3":"Kantāraṃ nittharissāmi,","ja516:29.4":"pātheyyaṃ me bhavissati.","ja516:30.1":"Tato silaṃ gahetvāna,","ja516:30.2":"matthakaṃ sannitāḷayiṃ;","ja516:30.3":"Mama gatta [bhatta (sī. syā.), hattha (pī.)] kilantassa,","ja516:30.4":"pahāro dubbalo ahu.","ja516:31.1":"So ca vegenudappatto,","ja516:31.2":"kapi ruhira [rudhira (sī.)] makkhito;","ja516:31.3":"Assupuṇṇehi nettehi,","ja516:31.4":"rodanto maṃ udikkhati.","ja516:32.1":"Māyyomaṃ kari bhaddante,","ja516:32.2":"tvañca nāmedisaṃ kari;","ja516:32.3":"Tvañca kho nāma dīghāvu [dīghāyu (pī.)],","ja516:32.4":"aññe [aññaṃ (pī.)] vāretumarahasi.","ja516:33.1":"Aho vata re purisa,","ja516:33.2":"tāva dukkarakāraka;","ja516:33.3":"Edisā visamā duggā,","ja516:33.4":"papātā uddhato [uddhaṭo (pī.)] mayā.","ja516:34.1":"Ānīto paralokāva,","ja516:34.2":"dubbheyyaṃ maṃ amaññatha;","ja516:34.3":"Taṃ tena pāpadhammena,","ja516:34.4":"pāpaṃ pāpena cintitaṃ.","ja516:35.1":"Mā heva tvaṃ adhammaṭṭha,","ja516:35.2":"vedanaṃ kaṭukaṃ phusi;","ja516:35.3":"Mā heva pāpakammaṃ taṃ,","ja516:35.4":"phalaṃ veḷuṃva taṃ vadhi.","ja516:36.1":"Tayime natthi vissāso,","ja516:36.2":"pāpadhamma asaññata [pāpadhammaṃ amaññatha (pī.)];","ja516:36.3":"Ehi me piṭṭhito gaccha,","ja516:36.4":"dissamānova santike.","ja516:37.1":"Muttosi hatthā vāḷānaṃ,","ja516:37.2":"pattosi mānusiṃ padaṃ;","ja516:37.3":"Esa maggo adhammaṭṭha,","ja516:37.4":"tena gaccha yathāsukhaṃ.","ja516:38.1":"Idaṃ vatvā giricaro,","ja516:38.2":"rahade [ruhiraṃ (syā. ka.)] pakkhalya matthakaṃ;","ja516:38.3":"Assūni sampamajjitvā,","ja516:38.4":"tato pabbatamāruhi.","ja516:39.1":"Sohaṃ tenābhisattosmi,","ja516:39.2":"pariḷāhena aṭṭito;","ja516:39.3":"Ḍayhamānena gattena,","ja516:39.4":"vāriṃ pātuṃ upāgamiṃ.","ja516:40.1":"Agginā viya santatto,","ja516:40.2":"rahado ruhiramakkhito;","ja516:40.3":"Pubbalohitasaṅkāso,","ja516:40.4":"sabbo me samapajjatha.","ja516:41.1":"Yāvanto udabindūni,","ja516:41.2":"kāyasmiṃ nipatiṃsu me;","ja516:41.3":"Tāvanto gaṇḍa [gaṇḍū (sī. pī.), gaṇḍu (syā.)] jāyetha,","ja516:41.4":"addhabeluvasādisā.","ja516:42.1":"Pabhinnā pagghariṃsu me,","ja516:42.2":"kuṇapā pubbalohitā;","ja516:42.3":"Yena yeneva gacchāmi,","ja516:42.4":"gāmesu nigamesu ca.","ja516:43.1":"Daṇḍahatthā nivārenti,","ja516:43.2":"itthiyo purisā ca maṃ;","ja516:43.3":"Okkitā [okiṇṇā (sī.)] pūtigandhena,","ja516:43.4":"māssu orena āgamā [māgamā (sī. pī.)].","ja516:44.1":"Etādisaṃ idaṃ dukkhaṃ,","ja516:44.2":"satta vassāni dāni me;","ja516:44.3":"Anubhomi sakaṃ kammaṃ,","ja516:44.4":"pubbe dukkaṭamattano.","ja516:45.1":"Taṃ vo vadāmi bhaddante [bhaddaṃ vo (sī. pī.)],","ja516:45.2":"yāvantettha samāgatā;","ja516:45.3":"Māssu mittāna [mittānaṃ (sī. pī.)] dubbhittho,","ja516:45.4":"mittadubbho hi pāpako.","ja516:46.1":"Kuṭṭhī kilāsī bhavati,","ja516:46.2":"yo mittānidha dubbhati [yo mittānaṃ idhaddubhi (sī. aṭṭha.), yo mittānaṃ idha dubbhati (pī.)];","ja516:46.3":"Kāyassa bhedā mittaddu [mittadubbhī (syā. ka.)],","ja516:46.4":"nirayaṃ sopapajjatīti [so upapajjatīti (sī. syā. pī.)].","ja516:47.1":"Mahākapijātakaṃ chaṭṭhaṃ."},"unsure":["ja516:25.3","ja516:27.1"],"attha":{"book":"Ja-a-vi-b","bookName":"Jātaka-aṭṭhakathā-5","vriCode":"s0513a4.att","from":6131,"to":6131,"paras":[{"para":6131,"vripara":null,"refs":["ja516:8"],"lines":["Tattha <b>bārāṇasyan</b>ti bārāṇasiyaṃ.","<b>Mittāmaccaparibyūḷho</b>ti mittehi ca daḷhabhattīhi amaccehi ca parivuto.","<b>Migājinan</b>ti evaṃnāmakaṃ uyyānaṃ.","<b>Setan</b>ti setakuṭṭhena setaṃ kabarakuṭṭhena vicitraṃ paribhinnena kaṇḍūyanakilāsakuṭṭhena kilāsinaṃ vedanāppattaṃ kadalipaṇṇe nipannaṃ addasa.","<b>Viddhastaṃ koviḷāraṃvā</b>ti vaṇamukhehi paggharantena maṃsena viddhastaṃ pupphitakoviḷārasadisaṃ.","<b>Kisan</b>ti ekaccesu padesesu aṭṭhicammamattasarīraṃ sirājālasanthataṃ.","<b>Byamhito</b>ti bhīto vimhayamāpanno vā.","<b>Yakkhānan</b>ti yakkhānaṃ antare tvaṃ katarayakkho nāmāsi.","<b>Vaṭṭanāvaḷisaṅkāsā</b>ti piṭṭhikaṇṭakaṭṭhāne āvunitvā ṭhapitāvaṭṭanāvaḷisadisā.","<b>Aṅgā</b>ti kāḷapabbavallisadisāni te aṅgāni.","<b>Nāññan</b>ti aññaṃ purisaṃ edisaṃ na passāmi.","<b>Ugghaṭṭapādo</b>ti rajokiṇṇapādo.","<b>Ātattarūpo</b>ti sukkhasarīro.","<b>Duddasī</b>ti dukkhena passitabbo.","<b>Appakārosī</b>ti sarīrappakārarahitosi, dussaṇṭhānosīti attho.","<b>Kiṃ kammamakaran</b>ti ito pubbe kiṃ kammaṃ akaraṃ, akāsīti attho.","<b>Kibbisan</b>ti dāruṇakammaṃ."],"lineRefs":[["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"],["ja516:8"]]}],"wordLinks":[["ja516:8.1","kiṃ kammamakaraṃ",0,15],["ja516:8.3","kibbisaṃ",0,16]],"before":[{"para":6099,"vripara":null,"refs":[],"lines":["Evaṃ mahāsatto gaganatale candaṃ uṭṭhāpento viya buddhalīḷāya brāhmaṇassa pañhaṃ kathesi.","Mahājano nadanto selento apphoṭento sādhukārasahassāni adāsi, celukkhepe ca aṅguliphoṭe ca pavattesi, hatthapiḷandhanādīni khipi.","Evaṃ khittadhanaṃ koṭimattaṃ ahosi.","Rājāpissa tuṭṭho mahantaṃ yasaṃ adāsi.","Suciratopi nikkhasahassena pūjaṃ katvā suvaṇṇapaṭṭe jātihiṅgulakena pañhavissajjanaṃ likhitvā indapatthanagaraṃ gantvā rañño dhammayāgapañhaṃ kathesi.","Rājā tasmiṃ dhamme vattitvā saggapuraṃ pūresi."],"lineRefs":[[],[],[],[],[],[]]},{"para":6100,"vripara":null,"refs":[],"lines":["Satthā imaṃ dhammadesanaṃ āharitvā “na, bhikkhave, idāneva, pubbepi tathāgato mahāpaññoyevā”ti vatvā jātakaṃ samodhānesi “tadā dhanañcayarājā ānando ahosi, sucirato anuruddho, vidhuro kassapo, bhadrakāro moggallāno, sañcayamāṇavo sāriputto, sambhavapaṇḍito pana ahameva ahosin”ti."],"lineRefs":[[]]},{"para":6101,"vripara":null,"refs":[],"lines":["Sambhavajātakavaṇṇanā pañcamā."],"lineRefs":[[]]},{"para":6103,"vripara":null,"refs":[],"lines":["[516]6. Mahākapijātakavaṇṇanā"],"lineRefs":[[]]},{"para":6104,"vripara":null,"refs":[],"lines":["<b>Bārāṇasyaṃ ahū rājā</b>ti idaṃ satthā veḷuvane viharanto devadattassa silāpavijjhanaṃ ārabbha kathesi.","Tena hi dhanuggahe payojetvā aparabhāge silāya paviddhāya bhikkhūhi devadattassa avaṇṇe kathite satthā “na, bhikkhave, idāneva, pubbepi devadatto mayhaṃ silaṃ pavijjhiyevā”ti vatvā atītaṃ āhari."],"lineRefs":[[],[]]},{"para":6105,"vripara":null,"refs":[],"lines":["Atīte bārāṇasiyaṃ brahmadatte rajjaṃ kārente kāsikagāmake eko kassakabrāhmaṇo khettaṃ kasitvā goṇe vissajjetvā kuddālakammaṃ kātuṃ ārabhi.","Goṇā ekasmiṃ gacche paṇṇāni khādantā anukkamena aṭaviṃ pavisitvā palāyiṃsu.","So velaṃ sallakkhetvā kuddālaṃ ṭhapetvā goṇe olokento adisvā domanassappatto te pariyesanto antoaṭaviṃ pavisitvā āhiṇḍanto himavantaṃ pāvisi.","So tattha disāmūḷho hutvā sattāhaṃ nirāhāro vicaranto ekaṃ tindukarukkhaṃ disvā abhiruyha phalāni khādanto tindukarukkhato parigaḷitvā saṭṭhihatthe narakapapāte pati.","Tatrassa dasa divasā vītivattā.","Tadā bodhisatto kapiyoniyaṃ nibbattitvā phalāphalāni khādanto taṃ purisaṃ disvā silāya yoggaṃ katvā taṃ purisaṃ uddharitvā silāya matthake nisīdāpetvā evamāha –","“bho brāhmaṇa, ahaṃ kilamāmi, muhuttaṃ niddāyissāmi, maṃ rakkhāhī”ti.","So tassa niddāyantassa silāya matthakaṃ padālesi.","Mahāsatto tassa taṃ kammaṃ ñatvā uppatitvā sākhāya nisīditvā “bho purisa, tvaṃ bhūmiyā gaccha, ahaṃ sākhaggena tuyhaṃ maggaṃ ācikkhanto gamissāmī”ti taṃ purisaṃ araññato nīharitvā magge ṭhapetvā pabbatapādameva pāvisi.","So puriso mahāsatte aparajjhitvā kuṭṭhī hutvā diṭṭhadhammeyeva manussapeto ahosi."],"lineRefs":[[],[],[],[],[],[],[],[],[],[]]},{"para":6106,"vripara":null,"refs":[],"lines":["So satta vassāni dukkhapīḷito vicaranto bārāṇasiyaṃ migājinaṃ nāma uyyānaṃ pavisitvā pākārantare kadalipaṇṇaṃ attharitvā vedanāppatto nipajji.","Tadā bārāṇasirājā uyyānaṃ gantvā tattha vicaranto taṃ disvā “kosi tvaṃ, kiṃ vā katvā imaṃ dukkhaṃ patto”ti pucchi.","Sopissa sabbaṃ vitthārato ācikkhi.","Tamatthaṃ pakāsento satthā āha –"],"lineRefs":[[],[],[],[]]},{"para":6108,"vripara":"178","refs":[],"lines":["“Bārāṇasyaṃ ahū rājā, kāsīnaṃ raṭṭhavaḍḍhano;"],"lineRefs":[[]]},{"para":6109,"vripara":null,"refs":[],"lines":["Mittāmaccaparibyūḷho, agamāsi migājinaṃ."],"lineRefs":[[]]},{"para":6111,"vripara":"179","refs":[],"lines":["“Tattha brāhmaṇamaddakkhi, setaṃ citraṃ kilāsinaṃ;"],"lineRefs":[[]]},{"para":6112,"vripara":null,"refs":[],"lines":["Viddhastaṃ koviḷāraṃva, kisaṃ dhamanisanthataṃ."],"lineRefs":[[]]},{"para":6114,"vripara":"180","refs":[],"lines":["“Paramakāruññataṃ pattaṃ, disvā kicchagataṃ naraṃ;"],"lineRefs":[[]]},{"para":6115,"vripara":null,"refs":[],"lines":["Avaca byamhito rājā, yakkhānaṃ katamo nusi."],"lineRefs":[[]]},{"para":6117,"vripara":"181","refs":[],"lines":["“Hatthapādā ca te setā, tato setataraṃ siro;"],"lineRefs":[[]]},{"para":6118,"vripara":null,"refs":[],"lines":["Gattaṃ kammāsavaṇṇaṃ te, kilāsabahulo casi."],"lineRefs":[[]]},{"para":6120,"vripara":"182","refs":[],"lines":["“Vaṭṭanāvaḷisaṅkāsā, piṭṭhi te ninnatunnatā;"],"lineRefs":[[]]},{"para":6121,"vripara":null,"refs":[],"lines":["Kāḷapabbāva te aṅgā, nāññaṃ passāmi edisaṃ."],"lineRefs":[[]]},{"para":6123,"vripara":"183","refs":[],"lines":["“Ugghaṭṭapādo tasito, kiso dhamanisanthato;"],"lineRefs":[[]]},{"para":6124,"vripara":null,"refs":[],"lines":["Chāto ātattarūposi, kutosi kattha gacchati."],"lineRefs":[[]]},{"para":6126,"vripara":"184","refs":[],"lines":["“Duddasī appakārosi, dubbaṇṇo bhīmadassano;"],"lineRefs":[[]]},{"para":6127,"vripara":null,"refs":[],"lines":["Janetti yāpi te mātā, na taṃ iccheyya passituṃ."],"lineRefs":[[]]},{"para":6129,"vripara":"185","refs":[],"lines":["“Kiṃ kammamakaraṃ pubbe, kaṃ avajjhaṃ aghātayi;"],"lineRefs":[[]]},{"para":6130,"vripara":null,"refs":[],"lines":["Kibbisaṃ yaṃ karitvāna, idaṃ dukkhaṃ upāgamī”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
