{"suttaId":"bv25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[2842,2927],"vripara":"1"},"segments":{"bv25:0.2":"Koṇāgamanabuddhavaṃso","bv25:1.1":"Kakusandhassa aparena,","bv25:1.2":"sambuddho dvipaduttamo;","bv25:1.3":"Koṇāgamano nāma jino,","bv25:1.4":"lokajeṭṭho narāsabho.","bv25:2.1":"Dasadhamme pūrayitvāna,","bv25:2.2":"kantāraṃ samatikkami;","bv25:2.3":"Pavāhiya malaṃ sabbaṃ,","bv25:2.4":"patto sambodhimuttamaṃ.","bv25:3.1":"Dhammacakkaṃ pavattente,","bv25:3.2":"koṇāgamananāyake;","bv25:3.3":"Tiṃsakoṭisahassānaṃ,","bv25:3.4":"paṭhamābhisamayo ahu.","bv25:4.1":"Pāṭihīraṃ karonte ca,","bv25:4.2":"paravādappamaddane;","bv25:4.3":"Vīsatikoṭisahassānaṃ,","bv25:4.4":"dutiyābhisamayo ahu.","bv25:5.1":"Tato vikubbanaṃ katvā,","bv25:5.2":"jino devapuraṃ gato;","bv25:5.3":"Vasate tattha sambuddho,","bv25:5.4":"silāya paṇḍukambale.","bv25:6.1":"Pakaraṇe satta desento,","bv25:6.2":"vassaṃ vasati so muni;","bv25:6.3":"Dasakoṭisahassānaṃ,","bv25:6.4":"tatiyābhisamayo ahu.","bv25:7.1":"Tassāpi devadevassa,","bv25:7.2":"eko āsi samāgamo;","bv25:7.3":"Khīṇāsavānaṃ vimalānaṃ,","bv25:7.4":"santacittāna tādinaṃ.","bv25:8.1":"Tiṃsabhikkhusahassānaṃ,","bv25:8.2":"tadā āsi samāgamo;","bv25:8.3":"Oghānamatikkantānaṃ,","bv25:8.4":"bhijjitānañca maccuyā.","bv25:9.1":"Ahaṃ tena samayena,","bv25:9.2":"pabbato nāma khattiyo;","bv25:9.3":"Mittāmaccehi sampanno,","bv25:9.4":"anantabalavāhano.","bv25:10.1":"Sambuddhadassanaṃ gantvā,","bv25:10.2":"sutvā dhammamanuttaraṃ;","bv25:10.3":"Nimantetvā sajinasaṅghaṃ,","bv25:10.4":"dānaṃ datvā yadicchakaṃ.","bv25:11.1":"Paṭṭuṇṇaṃ cīnapaṭṭañca,","bv25:11.2":"koseyyaṃ kambalampi ca;","bv25:11.3":"Sovaṇṇapādukañceva,","bv25:11.4":"adāsiṃ satthusāvake.","bv25:12.1":"Sopi maṃ buddho byākāsi,","bv25:12.2":"saṅghamajjhe nisīdiya;","bv25:12.3":"“Imamhi bhaddake kappe,","bv25:12.4":"ayaṃ buddho bhavissati.","bv25:13.1":"“Ahu kapilavhayā rammā … pe …","bv25:13.3":"hessāma sammukhā imaṃ”.","bv25:14.1":"Tassāpi vacanaṃ sutvā,","bv25:14.2":"bhiyyo cittaṃ pasādayiṃ;","bv25:14.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv25:14.4":"dasapāramipūriyā.","bv25:15.1":"Sabbaññutaṃ gavesanto,","bv25:15.2":"dānaṃ datvā naruttame;","bv25:15.3":"Ohāyāhaṃ mahārajjaṃ,","bv25:15.4":"pabbajiṃ jinasantike [tassa santike (sī.)].","bv25:16.1":"Nagaraṃ sobhavatī nāma,","bv25:16.2":"sobho nāmāsi khattiyo;","bv25:16.3":"Vasate tattha nagare,","bv25:16.4":"sambuddhassa mahākulaṃ.","bv25:17.1":"Brāhmaṇo yaññadatto ca,","bv25:17.2":"āsi buddhassa so pitā;","bv25:17.3":"Uttarā nāma janikā,","bv25:17.4":"koṇāgamanassa satthuno.","bv25:18.1":"Tīṇi vassasahassāni,","bv25:18.2":"agāraṃ ajjha so vasi;","bv25:18.3":"Tusitasantusitasantuṭṭhā,","bv25:18.4":"tayo pāsādamuttamā.","bv25:19.1":"Anūnasoḷasasahassāni,","bv25:19.2":"nāriyo samalaṅkatā;","bv25:19.3":"Rucigattā nāma nārī,","bv25:19.4":"satthavāho nāma atrajo.","bv25:20.1":"Nimitte caturo disvā,","bv25:20.2":"hatthiyānena nikkhami;","bv25:20.3":"Chamāsaṃ padhānacāraṃ,","bv25:20.4":"acarī purisuttamo.","bv25:21.1":"Brahmunā yācito santo,","bv25:21.2":"koṇāgamananāyako;","bv25:21.3":"Vatti cakkaṃ mahāvīro,","bv25:21.4":"migadāye naruttamo.","bv25:22.1":"Bhiyyaso uttaro nāma,","bv25:22.2":"ahesuṃ aggasāvakā;","bv25:22.3":"Sotthijo nāmupaṭṭhāko,","bv25:22.4":"koṇāgamanassa satthuno.","bv25:23.1":"Samuddā uttarā ceva,","bv25:23.2":"ahesuṃ aggasāvikā;","bv25:23.3":"Bodhi tassa bhagavato,","bv25:23.4":"udumbaroti pavuccati.","bv25:24.1":"Uggo ca somadevo ca,","bv25:24.2":"ahesuṃ aggupaṭṭhakā;","bv25:24.3":"Sīvalā ceva sāmā ca,","bv25:24.4":"ahesuṃ aggupaṭṭhikā.","bv25:25.1":"Uccattanena so buddho,","bv25:25.2":"tiṃsahatthasamuggato;","bv25:25.3":"Ukkāmukhe yathā kambu,","bv25:25.4":"evaṃ raṃsīhi maṇḍito.","bv25:26.1":"Tiṃsavassasahassāni,","bv25:26.2":"āyu buddhassa tāvade;","bv25:26.3":"Tāvatā tiṭṭhamāno so,","bv25:26.4":"tāresi janataṃ bahuṃ.","bv25:27.1":"Dhammacetiṃ samussetvā,","bv25:27.2":"dhammadussavibhūsitaṃ;","bv25:27.3":"Dhammapupphaguḷaṃ katvā,","bv25:27.4":"nibbuto so sasāvako.","bv25:28.1":"Mahāvilāso tassa jano,","bv25:28.2":"siridhammappakāsano;","bv25:28.3":"Sabbaṃ tamantarahitaṃ,","bv25:28.4":"nanu rittā sabbasaṅkhārā.","bv25:29.1":"Koṇāgamano sambuddho,","bv25:29.2":"pabbatārāmamhi nibbuto;","bv25:29.3":"Dhātuvitthārikaṃ āsi,","bv25:29.4":"tesu tesu padesatoti.","bv25:30.1":"Koṇāgamanassa bhagavato vaṃso tevīsatimo."},"unsure":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":3680,"to":3736,"paras":[{"para":3680,"vripara":null,"refs":["bv25:6"],"lines":["Tattha <b>dasa dhamme pūrayitvānā</b>ti dasa pāramidhamme pūrayitvā.","<b>Kantāraṃ samatikkamī</b>ti jātikantāraṃ samatikkami.","<b>Pavāhiyā</b>ti pavāhetvā.","<b>Malaṃ sabban</b>ti rāgādimalattayaṃ.","<b>Pāṭihīraṃ karonte ca, paravādappamaddane</b>ti paravādivādappamaddane, bhagavati pāṭihāriyaṃ karonteti attho.","<b>Vikubbanan</b>ti vikubbaniddhiṃ, sundaranagaradvāre yamakapāṭihāriyaṃ katvā devapuraṃ gato tattha paṇḍukambalasilāyaṃ vasi.","Kathaṃ vasīti?","<b>Pakaraṇe satta desento</b>ti tattha devānaṃ sattappakaraṇasaṅkhātaṃ abhidhammapiṭakaṃ desento vasi.","Evaṃ tattha abhidhammaṃ desente bhagavati dasakoṭisahassānaṃ devānaṃ abhisamayo ahosīti attho."],"lineRefs":[["bv25:6"],["bv25:6"],["bv25:6"],["bv25:6"],["bv25:6"],["bv25:6"],["bv25:6"],["bv25:6"],["bv25:6"]]},{"para":3681,"vripara":null,"refs":["bv25:6"],"lines":["Parisuddhapāramipūraṇāgamanassa koṇāgamanassapi eko sāvakasannipāto ahosi.","Surindavatīnagare surindavatuyyāne viharanto bhiyyasassa rājaputtassa ca uttarassa ca rājaputtassa dvinnampi tiṃsasahassaparivārānaṃ dhammaṃ desetvā sabbeva te ehibhikkhupabbajjāya pabbājetvā tesaṃ majjhagato māghapuṇṇamāyaṃ pātimokkhaṃ uddisi.","Tena vuttaṃ –"],"lineRefs":[["bv25:6"],["bv25:6"],["bv25:6"]]},{"para":3683,"vripara":"7","refs":["bv25:6"],"lines":["“Tassāpi devadevassa, eko āsi samāgamo;"],"lineRefs":[["bv25:6"]]},{"para":3684,"vripara":null,"refs":["bv25:6"],"lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ."],"lineRefs":[["bv25:6"]]},{"para":3686,"vripara":"8","refs":["bv25:6"],"lines":["“Tiṃsabhikkhusahassānaṃ, tadā āsi samāgamo;"],"lineRefs":[["bv25:6"]]},{"para":3687,"vripara":null,"refs":["bv25:6"],"lines":["Oghānamatikkantānaṃ, bhijjitānañca maccuyā”ti."],"lineRefs":[["bv25:6"]]},{"para":3688,"vripara":null,"refs":["bv25:8"],"lines":["Tattha <b>oghānan</b>ti kāmoghādīnaṃ, catunnamoghānametaṃ adhivacanaṃ.","Yassa pana te saṃvijjanti, taṃ vaṭṭasmiṃ ohananti osīdāpentīti oghā, tesaṃ oghānaṃ, upayogatthe sāmivacanaṃ daṭṭhabbaṃ.","Catubbidhe oghe atikkantānanti attho.","<b>Bhijjitānan</b>ti etthāpi eseva nayo.","<b>Maccuyā</b>ti maccuno."],"lineRefs":[["bv25:8"],["bv25:8"],["bv25:8"],["bv25:8"],["bv25:8"]]},{"para":3689,"vripara":null,"refs":["bv25:8"],"lines":["Tadā amhākaṃ bodhisatto mithilanagare pabbato nāma rājā ahosi, tadā “saraṇagatasabbapāṇāgamanaṃ koṇāgamanaṃ mithilanagaramanuppattan”ti sutvā saparivāro rājā paccuggantvā vanditvā dasabalaṃ nimantetvā mahādānaṃ datvā tattha bhagavantaṃ vassāvāsatthāya yācitvā temāsaṃ sasāvakasaṅghaṃ satthāraṃ upaṭṭhahitvā pattuṇṇacīnapaṭṭakambalakoseyyadukūlakappāsikādīni mahagghāni ceva sukhumavatthāni ca suvaṇṇapādukā ceva aññañca bahuparikkhāramadāsi.","Sopi naṃ bhagavā byākāsi –","“imasmiṃyeva bhaddakappe ayaṃ buddho bhavissatī”ti.","Atha so mahāpuriso tassa bhagavato byākaraṇaṃ sutvā mahārajjaṃ pariccajitvā tasseva bhagavato santike pabbaji.","Tena vuttaṃ –"],"lineRefs":[["bv25:8"],["bv25:8"],["bv25:8"],["bv25:8"],["bv25:8"]]},{"para":3691,"vripara":"9","refs":["bv25:8"],"lines":["“Ahaṃ tena samayena, pabbato nāma khattiyo;"],"lineRefs":[["bv25:8"]]},{"para":3692,"vripara":null,"refs":["bv25:8"],"lines":["Mittāmaccehi sampanno, anantabalavāhano."],"lineRefs":[["bv25:8"]]},{"para":3694,"vripara":"10","refs":["bv25:8"],"lines":["“Sambuddhadassanaṃ gantvā, sutvā dhammamanuttaraṃ;"],"lineRefs":[["bv25:8"]]},{"para":3695,"vripara":null,"refs":["bv25:8"],"lines":["Nimantetvā sajinasaṅghaṃ, dānaṃ datvā yadicchakaṃ."],"lineRefs":[["bv25:8"]]},{"para":3697,"vripara":"11","refs":["bv25:8"],"lines":["“Pattuṇṇaṃ cīnapaṭṭañca, koseyyaṃ kambalampi ca;"],"lineRefs":[["bv25:8"]]},{"para":3698,"vripara":null,"refs":["bv25:8"],"lines":["Suvaṇṇapādukañceva, adāsiṃ satthusāvake."],"lineRefs":[["bv25:8"]]},{"para":3700,"vripara":"12","refs":["bv25:8"],"lines":["“Sopi maṃ buddho byākāsi, saṅghamajjhe nisīdiya;"],"lineRefs":[["bv25:8"]]},{"para":3701,"vripara":null,"refs":["bv25:8"],"lines":["Imamhi bhaddake kappe, ayaṃ buddho bhavissati."],"lineRefs":[["bv25:8"]]},{"para":3703,"vripara":"13","refs":["bv25:8"],"lines":["“Ahu kapilavhayā rammā … pe … hessāma sammukhā imaṃ."],"lineRefs":[["bv25:8"]]},{"para":3705,"vripara":"14","refs":["bv25:8"],"lines":["“Tassāpi vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[["bv25:8"]]},{"para":3706,"vripara":null,"refs":["bv25:8"],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ dasapāramipūriyā."],"lineRefs":[["bv25:8"]]},{"para":3708,"vripara":"15","refs":["bv25:8"],"lines":["“Sabbaññutaṃ gavesanto, dānaṃ datvā naruttame;"],"lineRefs":[["bv25:8"]]},{"para":3709,"vripara":null,"refs":["bv25:8"],"lines":["Ohāyāhaṃ mahārajjaṃ, pabbajiṃ jinasantike”ti."],"lineRefs":[["bv25:8"]]},{"para":3710,"vripara":null,"refs":["bv25:8","bv25:15"],"lines":["Tattha <b>anantabalavāhano</b>ti bahukaṃ anantaṃ mayhaṃ balaṃ assahatthiādikaṃ vāhanañcāti attho.","<b>Sambuddhadassanan</b>ti sambuddhadassanatthāya.","<b>Yadicchakan</b>ti yāvadicchakaṃ buddhappamukhaṃ saṅghaṃ catubbidhena āhārena “alamalan”ti pavārāpetvā, hatthena pidahāpetvāti attho.","<b>Satthusāvake</b>ti satthuno ceva sāvakānañca adāsiṃ.","<b>Naruttame</b>ti naruttamassa.","<b>Ohāyā</b>ti pahāya pariccajitvā."],"lineRefs":[["bv25:8"],["bv25:8"],["bv25:8"],["bv25:8"],["bv25:15"],["bv25:15"]]},{"para":3711,"vripara":null,"refs":["bv25:15"],"lines":["Tassa pana koṇāgamanassa bhagavato sobhavatī nāma nagaraṃ ahosi, yaññadatto nāma brāhmaṇo pitā, uttarā nāma brāhmaṇī mātā, bhiyyaso ca uttaro cāti dve aggasāvakā, sotthijo nāmupaṭṭhāko, samuddā ca uttarā ca dve aggasāvikā, udumbararukkho bodhi, sarīraṃ tiṃsahatthubbedhaṃ ahosi, tiṃsavassasahassāni āyu, bhariyā panassa rucigattā nāma brāhmaṇī, satthavāho nāma putto, hatthiyānena nikkhami.","Tena vuttaṃ –"],"lineRefs":[["bv25:15"],["bv25:15"]]},{"para":3713,"vripara":"16","refs":["bv25:15"],"lines":["“Nagaraṃ sobhavatī nāma, sobho nāmāsi khattiyo;"],"lineRefs":[["bv25:15"]]},{"para":3714,"vripara":null,"refs":["bv25:15"],"lines":["Vasate tattha nagare, sambuddhassa mahākulaṃ."],"lineRefs":[["bv25:15"]]},{"para":3716,"vripara":"17","refs":["bv25:15"],"lines":["“Brāhmaṇo yaññadatto ca, āsi buddhassa so pitā;"],"lineRefs":[["bv25:15"]]},{"para":3717,"vripara":null,"refs":["bv25:15"],"lines":["Uttarā nāma janikā, koṇāgamanassa satthuno;"],"lineRefs":[["bv25:15"]]},{"para":3719,"vripara":"22","refs":["bv25:15"],"lines":["“Bhiyyaso uttaro nāma, ahesuṃ aggasāvakā;"],"lineRefs":[["bv25:15"]]},{"para":3720,"vripara":null,"refs":["bv25:15"],"lines":["Sotthijo nāmupaṭṭhāko, koṇāgamanassa satthuno."],"lineRefs":[["bv25:15"]]},{"para":3722,"vripara":"23","refs":["bv25:15"],"lines":["“Samuddā uttarā ceva, ahesuṃ aggasāvikā;"],"lineRefs":[["bv25:15"]]},{"para":3723,"vripara":null,"refs":["bv25:15"],"lines":["Bodhi tassa bhagavato, udumbaroti pavuccati."],"lineRefs":[["bv25:15"]]},{"para":3725,"vripara":"25","refs":["bv25:15"],"lines":["“Uccattanena so buddho, tiṃsahatthasamuggato;"],"lineRefs":[["bv25:15"]]},{"para":3726,"vripara":null,"refs":["bv25:15"],"lines":["Ukkāmukhe yathā kambu, evaṃ raṃsīhi maṇḍito."],"lineRefs":[["bv25:15"]]},{"para":3728,"vripara":"26","refs":["bv25:15"],"lines":["“Tiṃsavassasahassāni, āyu buddhassa tāvade;"],"lineRefs":[["bv25:15"]]},{"para":3729,"vripara":null,"refs":["bv25:15"],"lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[["bv25:15"]]},{"para":3731,"vripara":"27","refs":["bv25:15"],"lines":["“Dhammacetiṃ samussetvā, dhammadussavibhūsitaṃ;"],"lineRefs":[["bv25:15"]]},{"para":3732,"vripara":null,"refs":["bv25:15"],"lines":["Dhammapupphaguḷaṃ katvā, nibbuto so sasāvako."],"lineRefs":[["bv25:15"]]},{"para":3734,"vripara":"28","refs":["bv25:15"],"lines":["“Mahāvilāso tassa jano, siridhammappakāsano;"],"lineRefs":[["bv25:15"]]},{"para":3735,"vripara":null,"refs":["bv25:15"],"lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā”ti."],"lineRefs":[["bv25:15"]]},{"para":3736,"vripara":null,"refs":["bv25:15","bv25:28"],"lines":["Tattha <b>ukkāmukhe</b>ti kammāruddhane.","Yathā <b>kambū</b>ti suvaṇṇanikkhaṃ viya.","<b>Evaṃ raṃsīhi maṇḍito</b>ti evaṃ rasmīhi paṭimaṇḍito samalaṅkato.","<b>Dhammacetiṃ samussetvā</b>ti sattattiṃsabodhipakkhiyadhammamayaṃ cetiyaṃ patiṭṭhāpetvā.","<b>Dhammadussavibhūsitan</b>ti catusaccadhammapaṭākavibhūsitaṃ.","<b>Dhammapupphaguḷaṃ katvā</b>ti dhammamayapupphamālāguḷaṃ katvā.","Mahājanassa vipassanācetiyaṅgaṇe ṭhitassa namassanatthāya dhammacetiyaṃ patiṭṭhāpetvā sasāvakasaṅgho satthā parinibbāyīti attho.","<b>Mahāvilāso</b>ti mahāiddhivilāsappatto.","<b>Tassā</b>ti tassa bhagavato.","<b>Jano</b>ti sāvakajano.","<b>Siridhammappakāsano</b>ti lokuttaradhammappakāsano so bhagavā ca sabbaṃ tamantarahitanti attho."],"lineRefs":[["bv25:15"],["bv25:15"],["bv25:15"],["bv25:15"],["bv25:15"],["bv25:15"],["bv25:15"],["bv25:28"],["bv25:28"],["bv25:28"],["bv25:28"]]}],"wordLinks":[["bv25:6.1","pakaraṇe satta desento",0,7],["bv25:8.3","oghānaṃ",6,0],["bv25:8.3","bhijjitānaṃ",6,3],["bv25:8.3","maccuyā",6,4],["bv25:15.1","naruttame",21,4],["bv25:15.3","ohāyā",21,5],["bv25:28.1","mahāvilāso",39,7],["bv25:28.1","tassā",39,8],["bv25:28.1","jano",39,9],["bv25:28.1","siridhammappakāsano",39,10]],"before":[{"para":3652,"vripara":null,"refs":[],"lines":["“Apetabandho kakusandhabuddho, adandhapañño gatasabbarandho;"],"lineRefs":[[]]},{"para":3653,"vripara":null,"refs":[],"lines":["Tilokasandho kira saccasandho, kheme pane vāsamakappayittha”."],"lineRefs":[[]]},{"para":3654,"vripara":null,"refs":[],"lines":["Sesagāthāsu sabbattha pākaṭamevāti."],"lineRefs":[[]]},{"para":3655,"vripara":null,"refs":[],"lines":["Kakusandhabuddhavaṃsavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3656,"vripara":null,"refs":[],"lines":["Niṭṭhito bāvīsatimo buddhavaṃso."],"lineRefs":[[]]},{"para":3657,"vripara":null,"refs":[],"lines":["Koṇāgamanabuddhavaṃsavaṇṇanā"],"lineRefs":[[]]},{"para":3658,"vripara":null,"refs":[],"lines":["Kakusandhassa pana bhagavato aparabhāge tassa sāsane ca antarahite sattesu tiṃsavassasahassāyukesu jātesu parahitakoṇāgamano <b>koṇāgamano</b> nāma satthā loke udapādi.","Atha vā kanakāgamanato koṇāgamano nāma satthā loke udapādi.","Tattha ka-kārassa koādesaṃ katvā na-kārassa ṇādesaṃ katvā ekassa ka-kārassa lopaṃ katvā niruttinayena kanakassa kanakādiābharaṇassa āgamanaṃ pavassanaṃ yassa bhagavato uppannakāle so koṇāgamano nāma.","Ettha pana āyu anupubbena parihīnasadisaṃ kataṃ, na evaṃ parihīnaṃ, puna vaḍḍhitvā parihīnanti veditabbaṃ.","Kathaṃ?","Imasmiṃyeva kappe kakusandho bhagavā cattālīsavassasahassāyukakāle nibbatto, taṃ pana āyu parihāyamānaṃ dasavassakālaṃ patvā puna asaṅkhyeyyaṃ patvā tato parihāyamānaṃ tiṃsavassasahassāyukakāle ṭhitaṃ, tadā koṇāgamano bhagavā loke uppannoti veditabbo."],"lineRefs":[[],[],[],[],[],[]]},{"para":3659,"vripara":null,"refs":[],"lines":["Sopi pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā sobhavatīnagare yaññadattassa brāhmaṇassa bhariyāya rūpādīhi guṇehi anuttarāya uttarāya nāma brāhmaṇiyā kucchismiṃ paṭisandhiṃ gahetvā dasannaṃ māsānaṃ accayena subhavatīuyyāne mātukucchito nikkhami.","Jāyamāne pana tasmiṃ sakalajambudīpe devo kanakavassaṃ vassi.","Tenassa kanakāgamanakāraṇattā “kanakāgamano”ti nāmamakaṃsu.","Taṃ panassa nāmaṃ anukkamena pariṇamamānaṃ koṇāgamano”ti jātaṃ.","So pana tīṇi vassasahassāni agāraṃ ajjhāvasi.","Tusita-santusita-santuṭṭhanāmakā panassa tayo pāsādā ahesuṃ.","Rucigattābrāhmaṇīpamukhāni soḷasa itthisahassāni ahesuṃ."],"lineRefs":[[],[],[],[],[],[],[]]},{"para":3660,"vripara":null,"refs":[],"lines":["So cattāri nimittāni disvā rucigattāya brāhmaṇiyā satthavāhe nāma putte uppanne hatthikkhandhavaragato hatthiyānena mahābhinikkhamanaṃ nikkhamitvā pabbaji.","Taṃ tiṃsapurisasahassāni anupabbajiṃsu.","So tehi parivuto cha māse padhānacariyaṃ caritvā visākhapuṇṇamāyaṃ aggisonabrāhmaṇassa dhītāya aggisonabrāhmaṇakumāriyā dinnaṃ madhupāyāsaṃ paribhuñjitvā khadiravane divāvihāraṃ katvā sāyanhasamaye jaṭātindukena nāma yavapālena dinnā aṭṭha tiṇamuṭṭhiyo gahetvā udumbarabodhiṃ puṇḍarīke vuttappamāṇaṃ phalavibhūtisampannaṃ dakkhiṇato upagantvā vīsatihatthavitthataṃ tiṇasantharaṃ santharitvā pallaṅkaṃ ābhujitvā mārabalaṃ viddhaṃsetvā dasabalañāṇāni paṭilabhitvā –","“anekajātisaṃsāraṃ … pe … taṇhānaṃ khayamajjhagā”ti udānaṃ udānetvā sattasattāhaṃ vītināmetvā attanā saha pabbajitānaṃ tiṃsabhikkhusahassānaṃ upanissayasampattiṃ disvā gaganapathena gantvā sudassananagarasamīpe isipatane migadāye otaritvā tesaṃ majjhagato dhammacakkaṃ pavattesi, tadā tiṃsakoṭisahassānaṃ paṭhamābhisamayo ahosi."],"lineRefs":[[],[],[],[]]},{"para":3661,"vripara":null,"refs":[],"lines":["Puna sundaranagaradvāre mahāsālarukkhamūle yamakapāṭihāriyaṃ katvā vīsatikoṭisahassānaṃ dhammāmataṃ pāyesi, so dutiyo abhisamayo ahosi.","Attano mātaraṃ uttaraṃ pamukhaṃ katvā dasasu cakkavāḷasahassesu devatānaṃ samāgatānaṃ abhidhammapiṭakaṃ desente bhagavati dasannaṃ koṭisahassānaṃ tatiyo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[]]},{"para":3663,"vripara":"1","refs":[],"lines":["“Kakusandhassa aparena, sambuddho dvipaduttamo;"],"lineRefs":[[]]},{"para":3664,"vripara":null,"refs":[],"lines":["Koṇāgamano nāma jino, lokajeṭṭho narāsabho."],"lineRefs":[[]]},{"para":3666,"vripara":"2","refs":[],"lines":["“Dasa dhamme pūrayitvāna, kantāraṃ samatikkami;"],"lineRefs":[[]]},{"para":3667,"vripara":null,"refs":[],"lines":["Pavāhiya malaṃ sabbaṃ, patto sambodhimuttamaṃ."],"lineRefs":[[]]},{"para":3669,"vripara":"3","refs":[],"lines":["“Dhammacakkaṃ pavattente, koṇāgamananāyake;"],"lineRefs":[[]]},{"para":3670,"vripara":null,"refs":[],"lines":["Tiṃsakoṭisahassānaṃ, paṭhamābhisamayo ahu."],"lineRefs":[[]]},{"para":3672,"vripara":"4","refs":[],"lines":["“Pāṭihīraṃ karonte ca, paravādappamaddane;"],"lineRefs":[[]]},{"para":3673,"vripara":null,"refs":[],"lines":["Vīsatikoṭisahassānaṃ, dutiyābhisamayo ahu."],"lineRefs":[[]]},{"para":3675,"vripara":"5","refs":[],"lines":["“Tato vikubbanaṃ katvā, jino devapuraṃ gato;"],"lineRefs":[[]]},{"para":3676,"vripara":null,"refs":[],"lines":["Vasate tattha sambuddho, silāya paṇḍukambale."],"lineRefs":[[]]},{"para":3678,"vripara":"6","refs":[],"lines":["“Pakaraṇe satta desento, vassaṃ vasati so muni;"],"lineRefs":[[]]},{"para":3679,"vripara":null,"refs":[],"lines":["Dasakoṭisahassānaṃ, tatiyābhisamayo ahū”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
