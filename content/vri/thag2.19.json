{"suttaId":"thag2.19","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[859,865],"vripara":"157"},"segments":{"thag2.19:0.4":"Nandattheragāthā","thag2.19:1.1":"“Ayoniso manasikārā, maṇḍanaṃ anuyuñjisaṃ;","thag2.19:1.3":"Uddhato capalo cāsiṃ, kāmarāgena aṭṭito.","thag2.19:2.1":"“Upāyakusalenāhaṃ, buddhenādiccabandhunā;","thag2.19:2.3":"Yoniso paṭipajjitvā, bhave cittaṃ udabbahin”ti.","thag2.19:2.5":"… Nando thero …."},"attha":null,"tika":null}
