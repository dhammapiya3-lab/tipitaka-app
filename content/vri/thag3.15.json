{"suttaId":"thag3.15","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1295,1304],"vripara":"261"},"segments":{"thag3.15:0.4":"Hāritattheragāthā","thag3.15:1.1":"“Yo pubbe karaṇīyāni,","thag3.15:1.2":"pacchā so kātumicchati;","thag3.15:1.3":"Sukhā so dhaṃsate ṭhānā,","thag3.15:1.4":"pacchā ca manutappati. 262.","thag3.15:2.1":"“Yañhi kayirā tañhi vade,","thag3.15:2.2":"yaṃ na kayirā na taṃ vade;","thag3.15:2.3":"Akarontaṃ bhāsamānaṃ,","thag3.15:2.4":"parijānanti paṇḍitā. 263.","thag3.15:3.1":"“Susukhaṃ vata nibbānaṃ,","thag3.15:3.2":"sammāsambuddhadesitaṃ;","thag3.15:3.3":"Asokaṃ virajaṃ khemaṃ,","thag3.15:3.4":"yattha dukkhaṃ nirujjhatī”ti. …","thag3.15:3.5":"Hārito thero…. 16."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
