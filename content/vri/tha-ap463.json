{"suttaId":"tha-ap463","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1300,1317],"vripara":"1"},"segments":{"tha-ap463:0.3":"Sālakusumiyattheraapadānaṃ","tha-ap463:1.1":"“Parinibbute bhagavati,","tha-ap463:1.2":"jalajuttamanāmake;","tha-ap463:1.3":"Āropitamhi citake,","tha-ap463:1.4":"sālapupphamapūjayiṃ.","tha-ap463:2.1":"“Satasahassito kappe,","tha-ap463:2.2":"yaṃ pupphamabhiropayiṃ [pupphamabhipujayiṃ (syā.)];","tha-ap463:2.3":"Duggatiṃ nābhijānāmi,","tha-ap463:2.4":"citapūjāyidaṃ [buddhapūjāyidaṃ (syā.)] phalaṃ.","tha-ap463:3.1":"“Kilesā jhāpitā mayhaṃ,","tha-ap463:3.2":"bhavā sabbe samūhatā;","tha-ap463:3.3":"Nāgova bandhanaṃ chetvā,","tha-ap463:3.4":"viharāmi anāsavo.","tha-ap463:4.1":"“Svāgataṃ vata me āsi,","tha-ap463:4.2":"mama buddhassa santike;","tha-ap463:4.3":"Tisso vijjā anuppattā,","tha-ap463:4.4":"kataṃ buddhassa sāsanaṃ.","tha-ap463:5.1":"“Paṭisambhidā catasso,","tha-ap463:5.2":"vimokkhāpi ca aṭṭhime;","tha-ap463:5.3":"Chaḷabhiññā sacchikatā,","tha-ap463:5.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap463:6.1":"Itthaṃ sudaṃ āyasmā sālakusumiyo thero imā gāthāyo Abhāsitthāti.","tha-ap463:7.1":"Sālakusumiyattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
