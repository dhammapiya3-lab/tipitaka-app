{"suttaId":"sn2.14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1042,1056],"vripara":"95"},"segments":{"sn2.14:0.3":"Nandanasuttaṃ","sn2.14:1.1":"Ekamantaṃ ṭhito kho nandano devaputto bhagavantaṃ gāthāya ajjhabhāsi –","sn2.14:2.1":"“Pucchāmi taṃ gotama bhūripañña,","sn2.14:2.2":"Anāvaṭaṃ bhagavato ñāṇadassanaṃ;","sn2.14:2.3":"Kathaṃvidhaṃ sīlavantaṃ vadanti,","sn2.14:2.4":"Kathaṃvidhaṃ paññavantaṃ vadanti;","sn2.14:2.5":"Kathaṃvidho dukkhamaticca iriyati,","sn2.14:2.6":"Kathaṃvidhaṃ devatā pūjayantī”ti.","sn2.14:3.1":"“Yo sīlavā paññavā bhāvitatto,","sn2.14:3.2":"Samāhito jhānarato satīmā;","sn2.14:3.3":"Sabbassa sokā vigatā pahīnā,","sn2.14:3.4":"Khīṇāsavo antimadehadhārī.","sn2.14:4.1":"“Tathāvidhaṃ sīlavantaṃ vadanti,","sn2.14:4.2":"Tathāvidhaṃ paññavantaṃ vadanti;","sn2.14:4.3":"Tathāvidho dukkhamaticca iriyati,","sn2.14:4.4":"Tathāvidhaṃ devatā pūjayantī”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":539,"to":539,"paras":[{"para":539,"vripara":"95","refs":["sn2.14:2"],"lines":["Catutthe <b>gotamā</b>ti bhagavantaṃ gottena ālapati.","<b>Anāvaṭan</b>ti tathāgatassa hi sabbaññutaññāṇaṃ pesentassa rukkho vā pabbato vā āvarituṃ samattho nāma natthi.","Tenāha “anāvaṭan”ti.","Iti tathāgataṃ thometvā devaloke abhisaṅkhatapañhaṃ pucchanto <b>kathaṃvidhan</b>tiādimāha.","Tattha <b>dukkhamaticca iriyatī</b>ti dukkhaṃ atikkamitvā viharati.","<b>Sīlavā</b>ti lokiyalokuttarena sīlena samannāgato khīṇāsavo.","<b>Paññā</b> dayopi missakāyeva veditabbā.","<b>Pūjayantī</b>ti gandhapupphādīhi pūjenti.","Catutthaṃ."],"lineRefs":[["sn2.14:2"],["sn2.14:2"],["sn2.14:2"],["sn2.14:2"],["sn2.14:2"],["sn2.14:2"],["sn2.14:2"],["sn2.14:2"],["sn2.14:2"]]}],"wordLinks":[["sn2.14:2.1","gotamā",0,0],["sn2.14:2.2","anāvaṭaṃ",0,1],["sn2.14:2.3","kathaṃvidhaṃ",0,3],["sn2.14:2.4","kathaṃvidhaṃ",0,3],["sn2.14:2.6","kathaṃvidhaṃ",0,3],["sn2.14:2.5","dukkhamaticca iriyatī",0,4],["sn2.14:2.3","sīlavā",0,5],["sn2.14:2.1","paññā",0,6],["sn2.14:2.4","paññā",0,6],["sn2.14:2.6","pūjayantī",0,7]],"before":[{"para":538,"vripara":null,"refs":[],"lines":["Nandanasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":684,"to":684,"paras":[{"para":684,"vripara":"95","refs":["sn2.14:2"],"lines":["Natthi etassa āvaṭṭaṃ āvaraṇanti <b>anāvaṭaṃ</b>.","<b>Rukkho vā pabbato vā</b>ti sattānaṃ pakaticakkhussa āvaraṇabhūto rukkho viya pabbato viya ca abhibhavituṃ samattho ñeyyāvaraṇo natthi.","<b>Kathaṃvidhan</b>ti kathaṃsaṇṭhitaṃ, kathaṃpakāraṃ vā.","<b>Dukkhan</b>ti vaṭṭadukkhaṃ."],"lineRefs":[["sn2.14:2"],["sn2.14:2"],["sn2.14:2"],["sn2.14:2"]]}],"wordLinks":[["sn2.14:2.2","anāvaṭaṃ",0,0],["sn2.14:2.3","kathaṃvidhaṃ",0,2],["sn2.14:2.4","kathaṃvidhaṃ",0,2],["sn2.14:2.6","kathaṃvidhaṃ",0,2],["sn2.14:2.5","dukkhaṃ",0,3]]},"tika2":null}
