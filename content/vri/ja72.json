{"suttaId":"ja72","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[405,408],"vripara":"72"},"segments":{"ja72:0.4":"Sīlavahatthijātakaṃ","ja72:1.1":"Akataññussa posassa, niccaṃ vivaradassino;","ja72:1.3":"Sabbaṃ ce pathaviṃ [paṭhaviṃ (sī. syā. pī.)] dajjā, neva naṃ abhirādhayeti.","ja72:2.1":"Sīlavahatthijātakaṃ dutiyaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2032,"to":2032,"paras":[{"para":2032,"vripara":null,"refs":["ja72:1"],"lines":["Tattha <b>akataññussā</b>ti attano kataguṇaṃ ajānantassa.","<b>Posassā</b>ti purisassa.","<b>Vivaradassino</b>ti chiddameva okāsameva olokentassa.","<b>Sabbaṃ ce pathaviṃ dajjā</b>ti sacepi tādisassa puggalassa sakalaṃ cakkavattirajjaṃ, imaṃ vā pana mahāpathaviṃ parivattetvā pathavojaṃ dadeyya.","<b>Neva naṃ abhirādhaye</b>ti evaṃ karontopi evarūpaṃ kataguṇaviddhaṃsakaṃ koci paritosetuṃ vā pasādetuṃ vā na sakkuṇeyyāti attho."],"lineRefs":[["ja72:1"],["ja72:1"],["ja72:1"],["ja72:1"],["ja72:1"]]}],"wordLinks":[["ja72:1.1","akataññussā",0,0],["ja72:1.1","posassā",0,1],["ja72:1.1","vivaradassino",0,2],["ja72:1.3","sabbaṃ ce pathaviṃ dajjā",0,3],["ja72:1.3","neva naṃ abhirādhaye",0,4]]},"tika":null,"tika2":null}
