{"suttaId":"tha-ap206","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7477,7495],"vripara":"15"},"segments":{"tha-ap206:0.3":"Taraṇiyattheraapadānaṃ","tha-ap206:1.1":"“Atthadassī tu bhagavā,","tha-ap206:1.2":"dvipadindo narāsabho;","tha-ap206:1.3":"Purakkhato sāvakehi,","tha-ap206:1.4":"gaṅgātīramupāgami. 16.","tha-ap206:2.1":"“Samatitti kākapeyyā,","tha-ap206:2.2":"gaṅgā āsi duruttarā;","tha-ap206:2.3":"Uttārayiṃ bhikkhusaṅghaṃ,","tha-ap206:2.4":"buddhañca dvipaduttamaṃ. 17.","tha-ap206:3.1":"“Aṭṭhārase kappasate,","tha-ap206:3.2":"yaṃ kammamakariṃ tadā;","tha-ap206:3.3":"Duggatiṃ nābhijānāmi,","tha-ap206:3.4":"taraṇāya idaṃ phalaṃ. 18.","tha-ap206:4.1":"“Teraseto kappasate,","tha-ap206:4.2":"pañca sabbobhavā [sabbhogavā (sī.)] ahuṃ;","tha-ap206:4.3":"Sattaratanasampannā,","tha-ap206:4.4":"cakkavattī mahabbalā. 19.","tha-ap206:5.1":"“Pacchime ca bhave asmiṃ,","tha-ap206:5.2":"jātohaṃ brāhmaṇe kule;","tha-ap206:5.3":"Saddhiṃ tīhi sahāyehi,","tha-ap206:5.4":"pabbajiṃ satthu sāsane. 20.","tha-ap206:6.1":"“Paṭisambhidā catasso…pe…","tha-ap206:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap206:7.1":"Itthaṃ sudaṃ āyasmā taraṇiyo thero imā gāthāyo abhāsitthāti;","tha-ap206:8.1":"Taraṇiyattherassāpadānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
