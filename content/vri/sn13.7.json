{"suttaId":"sn13.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[649,650],"vripara":"80"},"segments":{"sn13.7:0.3":"Samuddasuttaṃ","sn13.7:1.1":"Sāvatthiyaṃ viharati … pe …“seyyathāpi, bhikkhave, puriso mahāsamuddato dve vā tīṇi vā udakaphusitāni uddhareyya.","sn13.7:1.3":"Taṃ kiṃ maññatha, bhikkhave, katamaṃ nu kho bahutaraṃ, yāni vā dve vā tīṇi vā udakaphusitāni ubbhatāni yaṃ vā mahāsamudde udakan”ti?","sn13.7:2.1":"“Etadeva, bhante, bahutaraṃ, yadidaṃ mahāsamudde udakaṃ;","sn13.7:2.2":"appamattakāni dve vā tīṇi vā udakaphusitāni ubbhatāni.","sn13.7:2.3":"Neva satimaṃ kalaṃ upenti na sahassimaṃ kalaṃ upenti na satasahassimaṃ kalaṃ upenti mahāsamudde udakaṃ upanidhāya dve vā tīṇi vā udakaphusitāni ubbhatānī”ti.","sn13.7:2.4":"“Evameva kho, bhikkhave … pe … dhammacakkhupaṭilābho”ti.","sn13.7:2.6":"Sattamaṃ."},"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":484,"to":488,"paras":[{"para":484,"vripara":"78-84","refs":["sn13.7:1"],"lines":["78-84. Pañcame <b>mahāpathaviyā</b>ti cakkavāḷabbhantarāya mahāpathaviyā uddharitvā.","<b>Kolaṭṭhimattiyo</b>ti padaraṭṭhipamāṇā.","<b>Guḷikā</b>ti mattikaguḷikā.","<b>Upanikkhipeyyā</b>ti ekasmiṃ ṭhāne ṭhapeyya.","Chaṭṭhādīsu vuttanayeneva attho veditabbo.","Pariyosāne pana <b>aññatitthiyasamaṇabrāhmaṇaparibbājakānaṃ adhigamo</b>ti bāhirakānaṃ sabbopi guṇādhigamo paṭhamamaggena adhigataguṇānaṃ satabhāgampi sahassabhāgampi satasahassabhāgampi na upagacchatīti.","Pañcamādīni."],"lineRefs":[["sn13.7:1"],["sn13.7:1"],["sn13.7:1"],["sn13.7:1"],["sn13.7:1"],["sn13.7:1"],["sn13.7:1"]]},{"para":485,"vripara":null,"refs":[],"lines":["Abhisamayasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":486,"vripara":null,"refs":[],"lines":["Dhātusaṃyuttaṃ"],"lineRefs":[[]]},{"para":487,"vripara":null,"refs":[],"lines":["Nānattavaggo"],"lineRefs":[[]]},{"para":488,"vripara":null,"refs":["sn13.7:1"],"lines":["Dhātunānattasuttavaṇṇanā"],"lineRefs":[["sn13.7:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":475,"to":483,"paras":[{"para":475,"vripara":"78-84","refs":["sn13.7:1"],"lines":["78-84. <b>Cakkavāḷabbhantarāyā</b>ti cakkavāḷapabbatassa antogadhāya."],"lineRefs":[["sn13.7:1"]]},{"para":476,"vripara":null,"refs":[],"lines":["<b>Chaṭṭhādīsu vuttanayenevā</b>ti idha chaṭṭhasuttādīsu paṭhamasuttādīsu vuttanayenevāti attho veditabbo visesābhāvato."],"lineRefs":[[]]},{"para":477,"vripara":null,"refs":[],"lines":["<b>Pariyosāne</b>ti imassa abhisamayasaṃyuttassa osānaṭṭhāne.","<b>Aññatitthiyasamaṇabrāhmaṇaparibbājakānan</b>ti aññatitthiyānaṃ.","<b>Guṇādhigamo</b>ti jhānābhiññāsahito guṇādhigamo.","<b>Satabhāgampi … pe … na upagacchati</b> saccapaṭivedhassa mahānubhāvattā.","Tenāha bhagavā paccakkhasabbadhammo “evaṃ mahādhigamo, bhikkhave, diṭṭhisampanno puggalo evaṃ mahābhiñño”ti."],"lineRefs":[[],[],[],[],[]]},{"para":478,"vripara":null,"refs":[],"lines":["Pathavīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":479,"vripara":null,"refs":[],"lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"],"lineRefs":[[]]},{"para":480,"vripara":null,"refs":[],"lines":["Abhisamayasaṃyuttavaṇṇanāya līnatthappakāsanā samattā."],"lineRefs":[[]]},{"para":481,"vripara":null,"refs":[],"lines":["Dhātusaṃyuttaṃ"],"lineRefs":[[]]},{"para":482,"vripara":null,"refs":[],"lines":["Nānattavaggo"],"lineRefs":[[]]},{"para":483,"vripara":null,"refs":["sn13.7:1"],"lines":["Dhātunānattasuttavaṇṇanā"],"lineRefs":[["sn13.7:1"]]}],"wordLinks":[]},"tika2":null}
