{"suttaId":"ja148","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[826,829],"vripara":"148"},"segments":{"ja148:0.4":"Siṅgālajātakaṃ","ja148:1.1":"Nāhaṃ punaṃ na ca punaṃ,","ja148:1.2":"na cāpi apunappunaṃ;","ja148:1.3":"Hatthibondiṃ pavekkhāmi,","ja148:1.4":"tathā hi bhayatajjitoti.","ja148:2.1":"Siṅgālajātakaṃ aṭṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":3072,"to":3072,"paras":[{"para":3072,"vripara":null,"refs":["ja148:1"],"lines":["Tattha <b>na cāpi apunappunan</b>ti a-kāro nipātamatto.","Ayaṃ panetissā sakalāyapi gāthāya attho – ahañhi ito puna, tato ca punāti vuttavārato puna tatopi ca punappunaṃ vāraṇasarīrasaṅkhātaṃ <b>hatthibondiṃ na pavekkhāmi</b>.","Kiṃkāraṇā?","<b>Tathā hi bhayatajjito,</b> tathā hi ahaṃ imasmiññeva pavesane bhayatajjito maraṇabhayena santāsaṃ saṃvegaṃ āpāditoti."],"lineRefs":[["ja148:1"],["ja148:1"],["ja148:1"],["ja148:1"]]}],"wordLinks":[["ja148:1.1","na cāpi apunappunaṃ",0,0],["ja148:1.3","tathā hi bhayatajjito",0,3]]},"tika":null,"tika2":null}
