{"suttaId":"tha-ap222","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7771,7788],"vripara":"51"},"segments":{"tha-ap222:0.3":"Pāpanivāriyattheraapadānaṃ","tha-ap222:1.1":"“Piyadassissa bhagavato, caṅkamaṃ sodhitaṃ mayā;","tha-ap222:1.3":"Naḷakehi paṭicchannaṃ, vātātapanivāraṇaṃ.","tha-ap222:2.1":"“Pāpaṃ vivajjanatthāya, kusalassupasampadā;","tha-ap222:2.3":"Kilesānaṃ pahānāya, padahiṃ satthu sāsane.","tha-ap222:3.1":"“Ito ekādase kappe, aggidevoti vissuto;","tha-ap222:3.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap222:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap222:5.1":"Itthaṃ sudaṃ āyasmā pāpanivāriyo [vātātapanivāriyo (?)] thero imā gāthāyo abhāsitthāti.","tha-ap222:6.1":"Pāpanivāriyattherassāpadānaṃ dasamaṃ.","tha-ap222:7.1":"Hatthivaggo bāvīsatimo.","tha-ap222:8.1":"Tassuddānaṃ –","tha-ap222:9.1":"Hatthi pānadhi saccañca, ekasaññi ca raṃsiko;","tha-ap222:9.3":"Sandhito tālavaṇṭañca, tathā akkantasaññako;","tha-ap222:9.5":"Sappi pāpanivārī ca, catuppaññāsa gāthakāti."},"attha":null,"tika":null,"tika2":null}
