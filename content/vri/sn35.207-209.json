{"suttaId":"sn35.207-209","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1044,1044],"vripara":"207-209"},"segments":{"sn35.207-209:0.3":"40-42. Ajjhattātītādiyaṃdukkhasuttaṃ","sn35.207-209:1.1":"207-209. “Cakkhu, bhikkhave, dukkhaṃ atītaṃ anāgataṃ paccuppannaṃ.","sn35.207-209:1.2":"Yaṃ dukkhaṃ, tadanattā.","sn35.207-209:1.3":"Yadanattā, taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ … pe …","sn35.207-209:1.4":"jivhā dukkhā … pe …","sn35.207-209:1.5":"mano dukkho atīto anāgato paccuppanno.","sn35.207-209:1.6":"Yaṃ dukkhaṃ, tadanattā.","sn35.207-209:1.7":"Yadanattā, taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.207-209:1.8":"Evaṃ passaṃ … pe …","sn35.207-209:1.9":"nāparaṃ itthattāyāti pajānātī”ti."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
