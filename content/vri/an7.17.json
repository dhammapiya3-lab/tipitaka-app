{"suttaId":"an7.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[102,102],"vripara":"17"},"segments":{"an7.17:0.3":"Dukkhānupassīsuttaṃ","an7.17:1.1":"Sattime, bhikkhave, puggalā āhuneyyā … pe … anuttaraṃ puññakkhettaṃ lokassa.","an7.17:1.2":"Katame satta?","an7.17:1.3":"Idha, bhikkhave, ekacco puggalo sabbasaṅkhāresu dukkhānupassī viharati … pe ….","an7.17:1.4":"Sattamaṃ."},"attha":{"book":"Mp-vii","bookName":"Sattakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":819,"to":819,"paras":[{"para":819,"vripara":"17-19","refs":["an7.17:1"],"lines":["17-19. Sattame <b>dukkhānupassī</b>ti pīḷanākāraṃ dukkhato anupassanto.","Aṭṭhame <b>anattānupassī</b>ti avasavattanākāraṃ anattāti anupassanto.","Navame <b>sukhānupassī</b>ti sukhanti evaṃ ñāṇena anupassanto."],"lineRefs":[["an7.17:1"],["an7.17:1"],["an7.17:1"]]}],"wordLinks":[["an7.17:1.3","dukkhānupassī",0,0]]},"tika":null}
