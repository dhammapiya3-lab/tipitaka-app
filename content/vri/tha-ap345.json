{"suttaId":"tha-ap345","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10291,10311],"vripara":"20"},"segments":{"tha-ap345:0.3":"Dhajadāyakattheraapadānaṃ","tha-ap345:1.1":"“Tisso nāma ahu satthā,","tha-ap345:1.2":"lokajeṭṭho narāsabho;","tha-ap345:1.3":"Tayopadhikkhaye [tassopadhikkhaye (sī.)] disvā,","tha-ap345:1.4":"dhajaṃ āropitaṃ mayā. 21.","tha-ap345:2.1":"“Tena kammena sukatena,","tha-ap345:2.2":"cetanāpaṇidhīhi ca;","tha-ap345:2.3":"Jahitvā mānusaṃ dehaṃ,","tha-ap345:2.4":"tāvatiṃsamagacchahaṃ. 22.","tha-ap345:3.1":"“Satānaṃ tīṇikkhattuñca,","tha-ap345:3.2":"devarajjaṃ akārayiṃ;","tha-ap345:3.3":"Satānaṃ pañcakkhattuñca,","tha-ap345:3.4":"cakkavattī ahosahaṃ. 23.","tha-ap345:4.1":"“Padesarajjaṃ vipulaṃ,","tha-ap345:4.2":"gaṇanāto asaṅkhiyaṃ;","tha-ap345:4.3":"Anubhomi sakaṃ kammaṃ,","tha-ap345:4.4":"pubbe sukatamattano. 24.","tha-ap345:5.1":"“Dvenavute ito kappe,","tha-ap345:5.2":"yaṃ kammamakariṃ tadā;","tha-ap345:5.3":"Duggatiṃ nābhijānāmi,","tha-ap345:5.4":"dhajadānassidaṃ phalaṃ. 25.","tha-ap345:6.1":"“Icchamāno cahaṃ ajja,","tha-ap345:6.2":"sakānanaṃ sapabbataṃ;","tha-ap345:6.3":"Khomadussena chādeyyaṃ,","tha-ap345:6.4":"tadā mayhaṃ kate phalaṃ. 26.","tha-ap345:7.1":"“Paṭisambhidā catasso…pe…","tha-ap345:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap345:8.1":"Itthaṃ sudaṃ āyasmā dhajadāyako thero imā gāthāyo abhāsitthāti.","tha-ap345:9.1":"Dhajadāyakattherassāpadānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
