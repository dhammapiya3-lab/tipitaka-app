{"suttaId":"sn1.78","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[855,859],"vripara":"78"},"segments":{"sn1.78:0.3":"Kāmasuttaṃ","sn1.78:1.1":"“Kimatthakāmo na dade,","sn1.78:1.2":"kiṃ macco na pariccaje;","sn1.78:1.3":"Kiṃsu muñceyya kalyāṇaṃ,","sn1.78:1.4":"pāpikaṃ na ca mocaye”ti.","sn1.78:2.1":"“Attānaṃ na dade poso,","sn1.78:2.2":"attānaṃ na pariccaje;","sn1.78:2.3":"Vācaṃ muñceyya kalyāṇaṃ,","sn1.78:2.4":"pāpikañca na mocaye”ti. 9."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":493,"to":493,"paras":[{"para":493,"vripara":"78","refs":["sn1.78:2"],"lines":["Aṭṭhame <b>attānaṃ na dade</b>ti parassa dāsaṃ katvā attānaṃ na dadeyya ṭhapetvā sabbabodhisatteti vuttaṃ.","<b>Na pariccaje</b>ti sīhabyagghādīnaṃ na pariccajeyya sabbabodhisatte ṭhapetvāyevāti vuttaṃ.","<b>Kalyāṇa</b>nti saṇhaṃ mudukaṃ.","<b>Pāpika</b>nti pharusaṃ vācaṃ.","Aṭṭhamaṃ. 9."],"lineRefs":[["sn1.78:2"],["sn1.78:2"],["sn1.78:2"],["sn1.78:2"],["sn1.78:2"]]}],"wordLinks":[["sn1.78:2.1","attānaṃ na dade",0,0],["sn1.78:2.1","na pariccaje",0,1],["sn1.78:2.3","kalyāṇaṃ",0,2],["sn1.78:2.3","pāpikaṃ",0,3]],"before":[{"para":492,"vripara":null,"title":"Kāmasuttavaṇṇanā","lines":["Kāmasuttavaṇṇanā 78."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":617,"to":617,"paras":[{"para":617,"vripara":"78","refs":["sn1.78:1"],"lines":["“Attakāmo”ti pāḷiyaṃ vuttattā āha <b>“ṭhapetvā sabbabodhisatte”</b>ti.","Te hi sabbaso paratthāya eva paṭipajjamānā mahākāruṇikā paratthakāmā, atthakāmā nāma na honti, yā ca tesaṃ attatthāvahā paṭipatti, sāpi yāvadeva paratthā evāti.","<b>Vuttaṃ</b> porāṇaṭṭhakathāyaṃ.","Yasmā bodhisattā parahitapaṭipattiyā pāramiyo pūrentā tathārūpaṃ kāraṇaṃ patvā attānaṃ paresaṃ pariccajanti paññāpāramiyā paripūraṇato, tasmā idhāpi <b>“sabbabodhisatte ṭhapetvāyevāti vutta”</b>nti āha.","<b>Kalyāṇa</b>nti bhaddakaṃ.","Vācāya adhippetattā āha <b>“saṇhaṃ muduka”</b>nti.","<b>Pāpika</b>nti lāmakaṃ nihīnaṃ.","Taṃ pana <b>pharusaṃ vāca</b>nti sarūpato dasseti."],"lineRefs":[["sn1.78:1"],["sn1.78:1"],["sn1.78:1"],["sn1.78:1"],["sn1.78:1"],["sn1.78:1"],["sn1.78:1"],["sn1.78:1"]]}],"wordLinks":[["sn1.78:1.3","kalyāṇaṃ",0,4],["sn1.78:1.3","pāpikaṃ",0,6]],"before":[{"para":616,"vripara":null,"title":"Kāmasuttavaṇṇanā","lines":["Kāmasuttavaṇṇanā 78."]}],"after":[{"para":618,"vripara":null,"title":"Kāmasuttavaṇṇanā","lines":["Kāmasuttavaṇṇanā niṭṭhitā. 9."]}]},"tika2":null}
