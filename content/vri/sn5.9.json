{"suttaId":"sn5.9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[2068,2078],"vripara":"170"},"segments":{"sn5.9:0.3":"Selāsuttaṃ","sn5.9:1.1":"Sāvatthinidānaṃ.","sn5.9:1.2":"Atha kho selā bhikkhunī pubbaṇhasamayaṃ nivāsetvā … pe …","sn5.9:1.3":"aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi.","sn5.9:1.4":"Atha kho māro pāpimā selāya bhikkhuniyā bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo … pe …","sn5.9:1.5":"selaṃ bhikkhuniṃ gāthāya ajjhabhāsi –","sn5.9:2.1":"“Kenidaṃ pakataṃ bimbaṃ,","sn5.9:2.2":"kvanu [kvannu (sī. pī.), kvaci (syā. kaṃ. ka.)] bimbassa kārako;","sn5.9:2.3":"Kvanu bimbaṃ samuppannaṃ,","sn5.9:2.4":"kvanu bimbaṃ nirujjhatī”ti.","sn5.9:3.1":"Atha kho selāya bhikkhuniyā etadahosi –","sn5.9:3.2":"“ko nu khvāyaṃ manusso vā amanusso vā gāthaṃ bhāsatī”ti?","sn5.9:3.3":"Atha kho selāya bhikkhuniyā etadahosi –","sn5.9:3.4":"“māro kho ayaṃ pāpimā mama bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo gāthaṃ bhāsatī”ti.","sn5.9:3.5":"Atha kho selā bhikkhunī “māro ayaṃ pāpimā” iti viditvā māraṃ pāpimantaṃ gāthāhi paccabhāsi –","sn5.9:4.1":"“Nayidaṃ attakataṃ [nayidaṃ pakataṃ (syā. kaṃ.)] bimbaṃ,","sn5.9:4.2":"nayidaṃ parakataṃ [nayidaṃ pakataṃ (syā. kaṃ.)] aghaṃ;","sn5.9:4.3":"Hetuṃ paṭicca sambhūtaṃ,","sn5.9:4.4":"hetubhaṅgā nirujjhati.","sn5.9:5.1":"“Yathā aññataraṃ bījaṃ,","sn5.9:5.2":"khette vuttaṃ virūhati;","sn5.9:5.3":"Pathavīrasañcāgamma,","sn5.9:5.4":"sinehañca tadūbhayaṃ.","sn5.9:6.1":"“Evaṃ khandhā ca dhātuyo,","sn5.9:6.2":"cha ca āyatanā ime;","sn5.9:6.3":"Hetuṃ paṭicca sambhūtā,","sn5.9:6.4":"hetubhaṅgā nirujjhare”ti.","sn5.9:7.1":"Atha kho māro pāpimā “jānāti maṃ selā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":890,"to":890,"paras":[{"para":890,"vripara":"170","refs":["sn5.9:2","sn5.9:4"],"lines":["Navame <b>kenidaṃ pakatan</b>ti kena idaṃ kataṃ.","<b>Bimban</b>ti attabhāvaṃ sandhāya vadati.","<b>Aghan</b>ti dukkhapatiṭṭhānattā attabhāvameva vadati.","<b>Hetubhaṅgā</b>ti hetunirodhena paccayavekallena.","Navamaṃ."],"lineRefs":[["sn5.9:2"],["sn5.9:2"],["sn5.9:4"],["sn5.9:4"],["sn5.9:4"]]}],"wordLinks":[["sn5.9:2.1","kenidaṃ pakataṃ",0,0],["sn5.9:2.1","bimbaṃ",0,1],["sn5.9:2.3","bimbaṃ",0,1],["sn5.9:4.1","aghaṃ",0,2],["sn5.9:4.3","hetubhaṅgā",0,3]],"before":[{"para":889,"vripara":null,"title":"Selāsuttavaṇṇanā","lines":["Selāsuttavaṇṇanā"]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1075,"to":1075,"paras":[{"para":1075,"vripara":"170","refs":["sn5.9:2","sn5.9:4"],"lines":["<b>Kenidaṃ pakataṃ bimban</b>ti idaṃ attabhāvasaññitaṃ bimbaṃ brahmā-visaṇupurisa-pajāpatiādīsu kena kataṃ nimmitaṃ nibbattitanti kattabbamohaṃ nāma kātukāmo pucchati.","<b>Aghan</b>ti aghavatthu.","Tenāha <b>“dukkhapatiṭṭhānattā”</b>ti.","<b>Hetunirodhenā</b>ti taṇhāsaṅkhatassa hetuno anuppādanirodhena.","<b>Paccayavekallenā</b>ti tadavasiṭṭhakilesābhisaṅkhārādipaccayassa vekallabhāvena, apaccayabhāvūpagamanenāti attho."],"lineRefs":[["sn5.9:2"],["sn5.9:4"],["sn5.9:4"],["sn5.9:4"],["sn5.9:4"]]}],"wordLinks":[["sn5.9:2.1","kenidaṃ pakataṃ bimbaṃ",0,0],["sn5.9:4.1","aghaṃ",0,1]],"before":[{"para":1074,"vripara":null,"title":"Selāsuttavaṇṇanā","lines":["Selāsuttavaṇṇanā"]}],"after":[{"para":1076,"vripara":null,"title":"Selāsuttavaṇṇanā","lines":["Selāsuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
