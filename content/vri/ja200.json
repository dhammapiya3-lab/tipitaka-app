{"suttaId":"ja200","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1282,1292],"vripara":"99"},"segments":{"ja200:0.4":"Sādhusīlajātakaṃ (2-5-10)","ja200:1.1":"Sarīradabyaṃ vuḍḍhabyaṃ [vaddhabyaṃ (sī. pī.)],","ja200:1.2":"sojaccaṃ sādhusīliyaṃ;","ja200:1.3":"Brāhmaṇaṃ teva pucchāma, kannu tesaṃ vanimhase [vaṇimhase (sī. pī.)]. 100.","ja200:2.1":"Attho atthi sarīrasmiṃ,","ja200:2.2":"vuḍḍhabyassa namo kare;","ja200:2.3":"Attho atthi sujātasmiṃ,","ja200:2.4":"sīlaṃ asmāka ruccatīti.","ja200:3.1":"Sādhusīlajātakaṃ dasamaṃ.","ja200:3.2":"Ruhakavaggo pañcamo.","ja200:4.1":"Tassuddānaṃ –","ja200:5.1":"Apiruhaka rūpavatī musalo,","ja200:5.2":"pavasanti sapañcamapokkharaṇī;","ja200:5.3":"Atha muttimavāṇija umhayate,","ja200:5.4":"ciraāgata koṭṭha sarīra dasāti. 6."},"unsure":["ja200:1.3"],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":845,"to":850,"paras":[{"para":845,"vripara":null,"refs":["ja200:1"],"lines":["Tattha <b>“sarīradabya”</b>ntiādīhi tesaṃ catunnaṃ vijjamāne guṇe pakāseti.","Ayañhettha adhippāyo – dhītaro me cattāro janā patthenti, tesu ekassa sarīradabyamatthi, sarīrasampadā abhirūpabhāvo saṃvijjati.","Ekassa vuḍḍhabyaṃ vuḍḍhibhāvo mahallakatā atthi.","Ekassa sojaccaṃ sujātitā jātisampadā atthi.","“Sujacca”ntipi pāṭho.","Ekassa sādhusīliyaṃ sundarasīlabhāvo sīlasampadā atthi.","<b>Brāhmaṇaṃ teva pucchāmā</b>ti tesu asukassa nāmetā dātabbāti ajānantā mayaṃ bhavantaṃ brāhmaṇaññeva pucchāma.","<b>Kannu tesaṃ vanimhase</b>ti tesaṃ catunnaṃ janānaṃ kaṃ vanimhase, kaṃ icchāma, kassa tā kumārikā dadāmāti pucchati."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"]]},{"para":846,"vripara":null,"refs":["ja200:1"],"lines":["Taṃ sutvā ācariyo “rūpasampadādīsu vijjamānāsupi vipannasīlo gārayho, tasmā taṃ nappamāṇaṃ, amhākaṃ sīlavantabhāvo ruccatī”ti imamatthaṃ pakāsento dutiyaṃ gāthamāha – 100."],"lineRefs":[["ja200:1"]]},{"para":848,"vripara":"100","refs":["ja200:1"],"lines":["“Attho atthi sarīrasmiṃ, vuḍḍhabyassa namo kare;"],"lineRefs":[["ja200:1"]]},{"para":849,"vripara":null,"refs":["ja200:1"],"lines":["Attho atthi sujātasmiṃ, sīlaṃ asmāka ruccatī”ti."],"lineRefs":[["ja200:1"]]},{"para":850,"vripara":null,"refs":["ja200:2"],"lines":["Tattha <b>attho atthi sarīrasmi</b>nti rūpasampanne sarīrepi attho viseso vuddhi atthiyeva, “natthī”ti na vadāmi.","<b>Vuḍḍhabyassa namo kare</b>ti vuḍḍhabhāvassa pana namakkārameva karomi.","Vuḍḍhabhāvo hi vandanamānanaṃ labhati.","<b>Attho atthi sujātasmi</b>nti sujātepi purise vuḍḍhi atthi, jātisampattipi icchitabbāyeva.","<b>Sīlaṃ asmāka ruccatī</b>ti amhākaṃ pana sīlameva ruccati.","Sīlavā hi ācārasampanno sarīradabyavirahitopi pujjo pāsaṃsoti.","Brāhmaṇo tassa vacanaṃ sutvā sīlavantasseva dhītaro adāsi."],"lineRefs":[["ja200:2"],["ja200:2"],["ja200:2"],["ja200:2"],["ja200:2"],["ja200:2"],["ja200:2"]]}],"wordLinks":[["ja200:1.1","sarīradabyaṃ",0,0],["ja200:1.3","brāhmaṇaṃ teva pucchāmā",0,6],["ja200:1.3","kannu tesaṃ vanimhase",0,7],["ja200:2.1","attho atthi sarīrasmiṃ",4,0],["ja200:2.1","vuḍḍhabyassa namo kare",4,1],["ja200:2.3","attho atthi sujātasmiṃ",4,3],["ja200:2.3","sīlaṃ asmāka ruccatī",4,4]],"after":[{"para":851,"vripara":null,"title":"[200] 10. Sādhusīlajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi – saccapariyosāne brāhmaṇo sotāpattiphale patiṭṭhahi.","“Tadā brāhmaṇo ayameva brāhmaṇo ahosi, disāpāmokkho ācariyo pana ahameva ahosi”nti."]},{"para":852,"vripara":null,"title":"[200] 10. Sādhusīlajātakavaṇṇanā","lines":["Sādhusīlajātakavaṇṇanā dasamā."]},{"para":853,"vripara":null,"title":"[200] 10. Sādhusīlajātakavaṇṇanā","lines":["Ruhakavaggo pañcamo."]},{"para":854,"vripara":null,"title":"[200] 10. Sādhusīlajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":855,"vripara":null,"title":"[200] 10. Sādhusīlajātakavaṇṇanā","lines":["Ruhakaṃ sirikāḷakaṃ, padumaṃ maṇicorakaṃ;"]},{"para":856,"vripara":null,"title":"[200] 10. Sādhusīlajātakavaṇṇanā","lines":["Pabbatūpattharavalāhaṃ, mittāmittañca rādhañca;"]},{"para":857,"vripara":null,"title":"[200] 10. Sādhusīlajātakavaṇṇanā","lines":["Gahapati sādhusīlaṃ. 6."]}]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":465,"to":477,"paras":[{"para":465,"vripara":null,"refs":["ja200:1"],"lines":["10-sādhusīlajātakavaṇṇanā (200)"],"lineRefs":[["ja200:1"]]},{"para":466,"vripara":null,"refs":["ja200:1"],"lines":["<b>tā cattāro janā patthentī</b>ti tā catasso dhītaro ekatova cattāro janā patthenti.","<b>tesū</b>ti tesu catūsu janesu.","<b>eko</b>ti eko jano.","<b>abhirūpo</b>ti chavivaṇṇena samannāgato.","<b>sarīrasampanno</b>ti aṅgapaccaṅgānaṃ avekallabhāvena sarīrasampanno.","<b>vayappatto</b>ti vuḍḍhisampatto.","<b>mahallako</b>ti mahantasarīrabhāvena vepullappatto.","<b>jātisampanno</b>ti ukkaṭṭhabhāvena jātisampanno.","<b>imesa</b>nti imesaṃ catunnaṃ janānaṃ.","<b>nivesentenā</b>ti patiṭṭhapentena.","<b>patthentenā</b>ti ākaṅkhamānena.","<b>kiṃ rūpasampannassā</b>ti kiṃ rūpasampannassa dātabbā.","udāhu vayappattajātisampannasīlavantānaṃ aññatarassa dātabbāti evaṃ cintesīti sambandho."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"]]},{"para":467,"vripara":null,"refs":["ja200:1"],"lines":["<b>tamatthaṃ ārocetvā</b>ti mayhaṃ catasso dhītaro ahesuṃ.","tā cattāro janā patthenti.","tesu eko abhirūpo sarīrasampanno.","eko vayappatto mahallako.","eko jātisampanno.","eko sīlavāti ārocetvā “bhante imesu catūsu janesu kassa dātuṃ vaṭṭatī”ti pucchi.","tasmiṃ ca kāle satthā atītajātakeneva taṃ viññāpesi.","tenāha — “satthā pubbe”ti ādi."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"]]},{"para":468,"vripara":null,"refs":["ja200:1"],"lines":["<b>bhavasaṅkhepagatattā pana sallakkhetuṃ na sakkosī</b>ti ettha tvanti kattā uddharitabbo.","tvaṃ brāhmaṇa sallakkhetuṃ na sakkosīti attho.","<b>evamevā</b>ti iminā eko abhirūpo sarīrasampannoti ādi atidisati."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"]]},{"para":469,"vripara":null,"refs":["ja200:1"],"lines":["<b>sarīradabyavuḍḍhabya</b>nti ettha sarīradabyanti vattabbe chandānurakkhaṇatthaṃ niggahitalopo kato.","sarīradabyanti ca sarīrameva sambhārabhūtattā dabbaṃ sarīradabbaṃ.","sarīradabbaṃ assa atthīti sarīradabbo.","abhirūpo sarīrasampanno.","taddhitapaccayassa hi ānubhāvena sarīradabbasaddeneva sobhaggapattasarīra-dabbo gahetabbo.","yathā rūpavāti.","sarīradabbassa bhāvo sarīradabyaṃ sarīrasampadā abhirūpabhāvo.","tenāha — “sarīradabyamattaṃ sarīrabhāvatthe abyapaccayo daṭṭhabbo.","vicitrāhi taddhitavuttī”ti.","athavā vuḍḍhaṃ mahallakabhāvaṃ vāti gacchatīti vuḍḍhavo.","mahallako.","vuḍḍhavassa bhāvo vuḍḍhabyaṃ.","bhāvatthe ṇyapaccayo.","<b>sujātatā jātisampannatā</b>ti iminā sampannā jāti yassāti sujāti.","jātisampannapuggalo.","susaddo hettha sampannattho.","sujātissa bhāvo sojaccanti nibbacanaṃ dasseti.","sānubandhapaccayassa vasena vuddhividhānaṃ aniccaṃ.","teneva sujaccantipi pāṭho dissati.","tenāha — “sujaccantipi pāṭho”ti."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"]]},{"para":470,"vripara":null,"refs":["ja200:1"],"lines":["<b>sādhusīliya</b>nti ettha sādhu sundaraṃ sīlaṃ yassāti sādhusīlo.","sīlasampannapuggalo.","tassa bhāvo sādhusīliyaṃ.","sādhusaddo cettha sundaratthe.","so ca sampadāyevāti āha “sīlasampadā”ti.","<b>brāhmaṇantevā-</b>ti ettha brāhmaṇaṃ tu evāti chedo.","tusaddo panettha vacanālaṅkāra-matto.","evasaddo avadhāraṇattho.","athavā tvevasaddo evasaddena samānattho eko nipātoti daṭṭhabbo."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"]]},{"para":471,"vripara":null,"refs":["ja200:1"],"lines":["footnote 1.","sarīradabyaṃ.","ṭṭha."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"]]},{"para":472,"vripara":null,"refs":["ja200:1"],"lines":["footnote 2.","brāhmaṇaṃ teva.","ṭṭha."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"]]},{"para":473,"vripara":null,"refs":["ja200:1"],"lines":["<b>vanimhaseti</b>ettha vana-yācaneti dantajapañcamakkharantadhātu.","se- kāro pana āgamo.","so ca nipāto.","karomasetiādīsu viya.","vuddhīti iminā atthoti padassa atthaṃ dasseti.","ettha ca katthaci potthakesu “attho viseso vuddhī “ti pāṭho dissati.","so na icchitabbo.","so hi saddenayena ca atthanayena ca virujjhati.","upari pana visesasaddo na dissati.","tasmā tassa natthibhāvoyeva paṇḍitehi icchitabboti.","yasmiṃ yasmiṃ vākye padhānopalakkhaṇādinayānaṃ lakkhaṇaṃ na dissati.","tasmiṃ tasmiṃ vākye evattho upalabbhati.","luttaniddiṭṭhavasena vā aññatthāpohanavasena vāti āha — “atthiyeva natthīti na vadāmī”ti."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"]]},{"para":474,"vripara":null,"refs":["ja200:1"],"lines":["<b>namo kare</b>ti ettha bhāvayoge kammapade o-kārāgamo.","ayaṃ hi manogaṇādikassa sabhāvo.","athavā namosaddo o-kārantanipāto.","so ca paccattopayogekavacanantaṭṭhānesuyeva āgato.","idha pana upayogekavacanantaṭṭhāne.","tenāha — “namakkāra-mevā”ti.","<b>kare</b>ti ettha vattamānekavacanantavasena padasiddhi vibhattilopa-vasena o-kārassa ca e-kāravasena.","<b>sīlavā hīti</b>ādīsu sīlavā ācārasampanno sarīradabyavirahitopi sujaccavirahitopi pāsaṃso pasaṃsiyo vaṇṇitabboti attho.","potthakesu pana katthaci sujacco icceva pāṭho dissati.","so na sundaroti."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"]]},{"para":475,"vripara":null,"refs":["ja200:1"],"lines":["ending sādhusīlajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja200:1"]]},{"para":476,"vripara":null,"refs":["ja200:1"],"lines":["ending ruhakavaggo pañcamo."],"lineRefs":[["ja200:1"]]},{"para":477,"vripara":null,"refs":["ja200:1"],"lines":["footnote 1.","pujjo.","ṭṭha.","126."],"lineRefs":[["ja200:1"],["ja200:1"],["ja200:1"],["ja200:1"]]}],"wordLinks":[]},"tika2":null}
