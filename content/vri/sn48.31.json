{"suttaId":"sn48.31","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1245,1245],"vripara":"501"},"segments":{"sn48.31:0.3":"Suddhikasuttaṃ","sn48.31:1.1":"“Pañcimāni, bhikkhave, indriyāni.","sn48.31:1.2":"Katamāni pañca?","sn48.31:1.3":"Sukhindriyaṃ, dukkhindriyaṃ, somanassindriyaṃ, domanassindriyaṃ, upekkhindriyaṃ –","sn48.31:1.4":"imāni kho, bhikkhave, pañcindriyānī”ti.","sn48.31:1.5":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":580,"to":580,"paras":[{"para":580,"vripara":"501-505","refs":["sn48.31:1"],"lines":["Catutthavaggassa paṭhame sukhañca taṃ sahajātānaṃ ādhipateyyasaṅkhātena indaṭṭhena indriyañcāti <b>sukhindriyaṃ.</b>","<b>Dukkhindriyā</b>dīsupi eseva nayo.","Ettha ca sukhindriyadukkhindriyadomanassindriyāni kāmāvacarāneva, somanassindriyaṃ ṭhapetvā arūpāvacaraṃ sesaṃ tebhūmakaṃ, upekkhindriyaṃ catubhūmakaṃ.","Dutiyādīni cattāri catusaccavaseneva kathitāni. 6."],"lineRefs":[["sn48.31:1"],["sn48.31:1"],["sn48.31:1"],["sn48.31:1"]]}],"wordLinks":[["sn48.31:1.3","sukhindriyaṃ",0,0],["sn48.31:1.3","dukkhindriyā",0,1]]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":502,"to":503,"paras":[{"para":502,"vripara":"501-505","refs":["sn48.31:1"],"lines":["Yathā cakkhu dassane adhipateyyaṭṭhena cakkhundriyaṃ, evaṃ sukhavedanā sukhane adhipateyyaṭṭhena sukhindriyaṃ.","Esa nayo sesesupi.","<b>Sesaṃ tebhūmaka</b>nti sesaṃ bhūmittayavasena tebhūmakaṃ. 6."],"lineRefs":[["sn48.31:1"],["sn48.31:1"],["sn48.31:1"]]},{"para":503,"vripara":null,"refs":["sn48.31:1"],"lines":["Paṭhamavibhaṅgasuttavaṇṇanā 506."],"lineRefs":[["sn48.31:1"]]}],"wordLinks":[]},"tika2":null}
