{"suttaId":"thi-ap16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[7194,7225],"vripara":"86"},"segments":{"thi-ap16:0.3":"Naḷamālikātherīapadānaṃ","thi-ap16:1.1":"“Candabhāgānadītīre,","thi-ap16:1.2":"ahosiṃ kinnarī tadā;","thi-ap16:1.3":"Addasaṃ virajaṃ buddhaṃ,","thi-ap16:1.4":"sayambhuṃ aparājitaṃ. 87.","thi-ap16:2.1":"“Pasannacittā sumanā,","thi-ap16:2.2":"vedajātā katañjalī;","thi-ap16:2.3":"Naḷamālaṃ gahetvāna,","thi-ap16:2.4":"sayambhuṃ abhipūjayiṃ. 88.","thi-ap16:3.1":"“Tena kammena sukatena,","thi-ap16:3.2":"cetanāpaṇidhīhi ca;","thi-ap16:3.3":"Jahitvā kinnarīdehaṃ [mānasaṃ dehaṃ (sī. pī. ka.) sumedhāvaggepi],","thi-ap16:3.4":"tāvatiṃsamagacchahaṃ. 89.","thi-ap16:4.1":"“Chattiṃsadevarājūnaṃ,","thi-ap16:4.2":"mahesittamakārayiṃ;","thi-ap16:4.3":"Manasā patthitaṃ mayhaṃ,","thi-ap16:4.4":"nibbattati yathicchitaṃ. 90.","thi-ap16:5.1":"“Dasannaṃ cakkavattīnaṃ,","thi-ap16:5.2":"mahesittamakārayiṃ;","thi-ap16:5.3":"Ocitattāva [sucitattāva (pī.)] hutvāna,","thi-ap16:5.4":"saṃsarāmi bhavesvahaṃ. 91.","thi-ap16:6.1":"“Kusalaṃ vijjate mayhaṃ,","thi-ap16:6.2":"pabbajiṃ anagāriyaṃ;","thi-ap16:6.3":"Pūjārahā ahaṃ ajja,","thi-ap16:6.4":"sakyaputtassa sāsane. 92.","thi-ap16:7.1":"“Visuddhamanasā ajja,","thi-ap16:7.2":"apetamanapāpikā;","thi-ap16:7.3":"Sabbāsavaparikkhīṇā,","thi-ap16:7.4":"natthi dāni punabbhavo. 93.","thi-ap16:8.1":"“Catunnavutito kappe,","thi-ap16:8.2":"yaṃ buddhamabhipūjayiṃ;","thi-ap16:8.3":"Duggatiṃ nābhijānāmi,","thi-ap16:8.4":"naḷamālāyidaṃ phalaṃ. 94.","thi-ap16:9.1":"“Kilesā jhāpitā mayhaṃ…pe…","thi-ap16:9.3":"viharāmi anāsavā. 95.","thi-ap16:10.1":"“Svāgataṃ vata me āsi…pe…","thi-ap16:10.3":"kataṃ buddhassa sāsanaṃ. 96.","thi-ap16:11.1":"“Paṭisambhidā catasso…pe…","thi-ap16:11.3":"kataṃ buddhassa sāsanaṃ”.","thi-ap16:12.1":"Itthaṃ sudaṃ naḷamālikā bhikkhunī imā gāthāyo abhāsitthāti.","thi-ap16:13.1":"Naḷamālikātheriyāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
