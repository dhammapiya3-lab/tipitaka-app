{"suttaId":"ja393","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[3973,3992],"vripara":"122"},"segments":{"ja393:0.4":"Vighāsādajātakaṃ (6-2-8)","ja393:1.1":"Susukhaṃ vata jīvanti,","ja393:1.2":"ye janā vighāsādino;","ja393:1.3":"Diṭṭheva dhamme pāsaṃsā,","ja393:1.4":"samparāye ca suggatī. 123.","ja393:2.1":"Sukassa [suvassa (sī. syā. pī.)] bhāsamānassa,","ja393:2.2":"na nisāmetha paṇḍitā;","ja393:2.3":"Idaṃ suṇātha sodariyā,","ja393:2.4":"amhevāyaṃ pasaṃsati. 124.","ja393:3.1":"Nāhaṃ tumhe pasaṃsāmi,","ja393:3.2":"kuṇapādā suṇātha me;","ja393:3.3":"Ucchiṭṭhabhojino [bhojanā (ka.)] tumhe,","ja393:3.4":"na tumhe vighāsādino. 125.","ja393:4.1":"Sattavassā pabbajitā,","ja393:4.2":"mejjhāraññe [majjheraññe (ka.)] sikhaṇḍino;","ja393:4.3":"Vighāseneva yāpentā,","ja393:4.4":"mayaṃ ce bhoto gārayhā;","ja393:4.5":"Ke nu bhoto pasaṃsiyā. 126.","ja393:5.1":"Tumhe sīhānaṃ byagghānaṃ,","ja393:5.2":"vāḷānañcāvasiṭṭhakaṃ;","ja393:5.3":"Ucchiṭṭheneva yāpentā,","ja393:5.4":"maññivho vighāsādino. 127.","ja393:6.1":"Ye brāhmaṇassa samaṇassa,","ja393:6.2":"aññassa vā [aññassa ca (sī. syā.), aññasseva (pī.)] vanibbino [vaṇibbino (sī. syā.)];","ja393:6.3":"Datvāva [datvāna (pī. ka.)] sesaṃ bhuñjanti,","ja393:6.4":"te janā vighāsādinoti.","ja393:7.1":"Vighāsādajātakaṃ aṭṭhamaṃ. 394."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":2765,"to":2791,"paras":[{"para":2765,"vripara":null,"refs":["ja393:1"],"lines":["Tattha <b>vighāsādino</b>ti bhuttātirekaṃ bhuñjante sandhāyāha.","<b>Diṭṭheva dhamme</b>ti ye evarūpā, te diṭṭheva dhamme pāsaṃsā, samparāye ca tesaṃ sugati hoti, sagge uppajjantīti adhippāyena vadati."],"lineRefs":[["ja393:1"],["ja393:1"]]},{"para":2766,"vripara":null,"refs":["ja393:1"],"lines":["Atha tesu eko tassa vacanaṃ sutvā avasese āmantetvā dutiyaṃ gāthamāha – 123."],"lineRefs":[["ja393:1"]]},{"para":2768,"vripara":"123","refs":["ja393:1"],"lines":["“Sukassa bhāsamānassa, na nisāmetha paṇḍitā;"],"lineRefs":[["ja393:1"]]},{"para":2769,"vripara":null,"refs":["ja393:1"],"lines":["Idaṃ suṇātha sodariyā, amhevāyaṃ pasaṃsatī”ti."],"lineRefs":[["ja393:1"]]},{"para":2770,"vripara":null,"refs":["ja393:2"],"lines":["Tattha <b>bhāsamānassā</b>ti mānusikāya vācāya bhaṇantassa.","<b>Na nisāmethā</b>ti na suṇātha.","<b>Idaṃ suṇāthā</b>ti idamassa vacanaṃ suṇātha.","<b>Sodariyā</b>ti samāne udare vutthabhāvena te ālapanto āha."],"lineRefs":[["ja393:2"],["ja393:2"],["ja393:2"],["ja393:2"]]},{"para":2771,"vripara":null,"refs":["ja393:2"],"lines":["Atha ne paṭikkhipanto suko tatiyaṃ gāthamāha – 124."],"lineRefs":[["ja393:2"]]},{"para":2773,"vripara":"124","refs":["ja393:2"],"lines":["“Nāhaṃ tumhe pasaṃsāmi, kuṇapādā suṇātha me;"],"lineRefs":[["ja393:2"]]},{"para":2774,"vripara":null,"refs":["ja393:2"],"lines":["Ucchiṭṭhabhojino tumhe, na tumhe vighāsādino”ti."],"lineRefs":[["ja393:2"]]},{"para":2775,"vripara":null,"refs":["ja393:3"],"lines":["Tattha <b>kuṇapādā</b>ti kuṇapakhādakāti te ālapati."],"lineRefs":[["ja393:3"]]},{"para":2776,"vripara":null,"refs":["ja393:3"],"lines":["Te tassa vacanaṃ sutvā sabbepi catutthaṃ gāthamāhaṃsu – 125."],"lineRefs":[["ja393:3"]]},{"para":2778,"vripara":"125","refs":["ja393:3"],"lines":["“Sattavassā pabbajitā, majjhāraññe sikhaṇḍino;"],"lineRefs":[["ja393:3"]]},{"para":2779,"vripara":null,"refs":["ja393:3"],"lines":["Vighāseneva yāpentā, mayañce bhoto gārayhā;"],"lineRefs":[["ja393:3"]]},{"para":2780,"vripara":null,"refs":["ja393:3"],"lines":["Ke nu bhoto pasaṃsiyā”ti."],"lineRefs":[["ja393:3"]]},{"para":2781,"vripara":null,"refs":["ja393:4"],"lines":["Tattha <b>sikhaṇḍino</b>ti cūḷāya samannāgatā.","<b>Vighāsenevā</b>ti ettakaṃ kālaṃ satta vassāni sīhabyagghavighāseneva yāpentā yadi bhoto gārayhā, atha ke nu te pasaṃsiyāti."],"lineRefs":[["ja393:4"],["ja393:4"]]},{"para":2782,"vripara":null,"refs":["ja393:4"],"lines":["Te lajjāpento mahāsatto pañcamaṃ gāthamāha – 126."],"lineRefs":[["ja393:4"]]},{"para":2784,"vripara":"126","refs":["ja393:4"],"lines":["“Tumhe sīhānaṃ byagghānaṃ, vāḷānañcāvasiṭṭhakaṃ;"],"lineRefs":[["ja393:4"]]},{"para":2785,"vripara":null,"refs":["ja393:4"],"lines":["Ucchiṭṭheneva yāpentā, maññivho vighāsādino”ti."],"lineRefs":[["ja393:4"]]},{"para":2786,"vripara":null,"refs":["ja393:5"],"lines":["Tattha <b>vāḷānañcāvasiṭṭhaka</b>nti sesavāḷamigānañca avasiṭṭhakaṃ ucchiṭṭhabhojanaṃ."],"lineRefs":[["ja393:5"]]},{"para":2787,"vripara":null,"refs":["ja393:5"],"lines":["Taṃ sutvā tāpasā “sace mayaṃ na vighāsādā, atha ke carahi te vighāsādā”ti?","Atha tesaṃ so tamatthaṃ ācikkhanto chaṭṭhaṃ gāthamāha – 127."],"lineRefs":[["ja393:5"],["ja393:5"]]},{"para":2789,"vripara":"127","refs":["ja393:5"],"lines":["“Ye brāhmaṇassa samaṇassa, aññassa vā vanibbino;"],"lineRefs":[["ja393:5"]]},{"para":2790,"vripara":null,"refs":["ja393:5"],"lines":["Datvāva sesaṃ bhuñjanti, te janā vighāsādino”ti."],"lineRefs":[["ja393:5"]]},{"para":2791,"vripara":null,"refs":["ja393:6"],"lines":["Tattha <b>vanibbino</b>ti taṃ taṃ bhaṇḍaṃ yācanakassa.","Evaṃ te lajjāpetvā mahāsatto sakaṭṭhānameva gato."],"lineRefs":[["ja393:6"],["ja393:6"]]}],"wordLinks":[["ja393:1.1","vighāsādino",0,0],["ja393:1.3","diṭṭheva dhamme",0,1],["ja393:2.1","bhāsamānassā",4,0],["ja393:2.1","na nisāmethā",4,1],["ja393:2.3","idaṃ suṇāthā",4,2],["ja393:2.3","sodariyā",4,3],["ja393:3.1","kuṇapādā",8,0],["ja393:4.1","sikhaṇḍino",13,0],["ja393:4.3","vighāsenevā",13,1],["ja393:5.1","vāḷānañcāvasiṭṭhakaṃ",17,0],["ja393:6.1","vanibbino",21,0]],"after":[{"para":2792,"vripara":null,"title":"[393] 8. Vighāsādajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā satta bhātaro ime keḷisīlakā bhikkhū ahesuṃ, sakko pana ahameva ahosi”nti."]},{"para":2793,"vripara":null,"title":"[393] 8. Vighāsādajātakavaṇṇanā","lines":["Vighāsādajātakavaṇṇanā aṭṭhamā. [394] 9."]},{"para":2795,"vripara":null,"title":"[394] 9. Vaṭṭakajātakavaṇṇanā","lines":["Vaṭṭakajātakavaṇṇanā"]},{"para":2796,"vripara":null,"title":"[394] 9. Vaṭṭakajātakavaṇṇanā","lines":["<b>Paṇīta</b>nti idaṃ satthā jetavane viharanto ekaṃ lolabhikkhuṃ ārabbha kathesi.","Tañhi satthā “saccaṃ kira tvaṃ bhikkhu lolo”ti pucchitvā “āma, bhante”ti vutte “na kho bhikkhu idāneva lolo, pubbepi tvaṃ loloyeva, lolatāya pana bārāṇasiyaṃ hatthigavāssapurisakuṇapehi atitto ‘ito uttaritaraṃ labhissāmī’ti araññaṃ paviṭṭhosī”ti vatvā atītaṃ āhari."]},{"para":2797,"vripara":null,"title":"[394] 9. Vaṭṭakajātakavaṇṇanā","lines":["Atīte bārāṇasiyaṃ brahmadatte rajjaṃ kārente bodhisatto vaṭṭakayoniyaṃ nibbattitvā araññe lūkhatiṇabījāhāro vasi.","Tadā bārāṇasiyaṃ eko lolakāko hatthikuṇapādīhi atitto “ito uttaritaraṃ labhissāmī”ti araññaṃ pavisitvā phalāphalaṃ khādanto bodhisattaṃ disvā “ayaṃ vaṭṭako ativiya thūlasarīro, madhuraṃ gocaraṃ khādati maññe, etassa gocaraṃ pucchitvā taṃ khāditvā ahampi thūlo bhavissāmī”ti cintetvā bodhisattassa uparibhāge sākhāya nilīyitvā bodhisattaṃ pucchi “bho vaṭṭaka, kiṃ nāma paṇītāhāraṃ bhuñjasi, thūlasarīro ahosī”ti?","Bodhisatto tena pucchito tena saddhiṃ paṭisanthāraṃ karonto paṭhamaṃ gāthamāha – 128."]},{"para":2799,"vripara":"128","title":"[394] 9. Vaṭṭakajātakavaṇṇanā","lines":["“Paṇītaṃ bhuñjase bhattaṃ, sappitelañca mātula;"]},{"para":2800,"vripara":null,"title":"[394] 9. Vaṭṭakajātakavaṇṇanā","lines":["Atha kena nu vaṇṇena, kiso tvamasi vāyasā”ti."]}]},"tika":null,"tika2":null}
