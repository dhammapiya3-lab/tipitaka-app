{"suttaId":"sn22.110","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[734,734],"vripara":"110"},"segments":{"sn22.110:0.3":"Arahantasuttaṃ","sn22.110:1.1":"Sāvatthinidānaṃ.","sn22.110:1.2":"“Pañcime, bhikkhave, upādānakkhandhā.","sn22.110:1.3":"Katame pañca?","sn22.110:1.4":"Seyyathidaṃ – rūpupādānakkhandho … pe … viññāṇupādānakkhandho.","sn22.110:1.5":"Yato kho, bhikkhave, bhikkhu imesaṃ pañcannaṃ upādānakkhandhānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā anupādāvimutto hoti.","sn22.110:1.6":"Ayaṃ vuccati, bhikkhave, bhikkhu arahaṃ khīṇāsavo vusitavā katakaraṇīyo ohitabhāro anuppattasadattho parikkhīṇabhavasaṃyojano sammadaññāvimutto”ti.","sn22.110:1.7":"Aṭṭhamaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":367,"to":370,"paras":[{"para":367,"vripara":"107-112","refs":["sn22.110:1"],"lines":["107-112. Pañcamādīsu catūsu cattāri saccāni kathitāni.","Navamadasamesu kilesappahānanti.","Pañcamādīni."],"lineRefs":[["sn22.110:1"],["sn22.110:1"],["sn22.110:1"]]},{"para":368,"vripara":null,"refs":[],"lines":["Antavaggo ekādasamo."],"lineRefs":[[]]},{"para":369,"vripara":null,"refs":[],"lines":["Dhammakathikavaggo"],"lineRefs":[[]]},{"para":370,"vripara":null,"refs":["sn22.110:1"],"lines":["1-2. Avijjāsuttādivaṇṇanā"],"lineRefs":[["sn22.110:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":359,"to":364,"paras":[{"para":359,"vripara":"107-112","refs":["sn22.110:1"],"lines":["107-112. <b>Cattāri saccāni kathitāni</b> assādādīnaṃ samudayādīnañca desitattā."],"lineRefs":[["sn22.110:1"]]},{"para":360,"vripara":null,"refs":[],"lines":["<b>Kilesappahānaṃ kathitaṃ</b> rāgappahānassa jotitattā."],"lineRefs":[[]]},{"para":361,"vripara":null,"refs":[],"lines":["Samaṇasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":362,"vripara":null,"refs":[],"lines":["Antavaggavaṇṇanā niṭṭhitā."],"l