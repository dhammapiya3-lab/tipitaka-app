{"suttaId":"bv22","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[2583,2665],"vripara":"1"},"segments":{"bv22:0.2":"Sikhībuddhavaṃso","bv22:1.1":"Vipassissa aparena,","bv22:1.2":"sambuddho dvipaduttamo;","bv22:1.3":"Sikhivhayo āsi jino,","bv22:1.4":"asamo appaṭipuggalo.","bv22:2.1":"Mārasenaṃ pamadditvā,","bv22:2.2":"patto sambodhimuttamaṃ;","bv22:2.3":"Dhammacakkaṃ pavattesi,","bv22:2.4":"anukampāya pāṇinaṃ.","bv22:3.1":"Dhammacakkaṃ pavattente,","bv22:3.2":"sikhimhi jinapuṅgave [munipuṅgave (sī.)];","bv22:3.3":"Koṭisatasahassānaṃ,","bv22:3.4":"paṭhamābhisamayo ahu.","bv22:4.1":"Aparampi dhammaṃ desente,","bv22:4.2":"gaṇaseṭṭhe naruttame;","bv22:4.3":"Navutikoṭisahassānaṃ,","bv22:4.4":"dutiyābhisamayo ahu.","bv22:5.1":"Yamakapāṭihāriyañca [yamakaṃ pāṭihīrañca (sī.)],","bv22:5.2":"dassayante sadevake;","bv22:5.3":"Asītikoṭisahassānaṃ,","bv22:5.4":"tatiyābhisamayo ahu.","bv22:6.1":"Sannipātā tayo āsuṃ,","bv22:6.2":"sikhissāpi mahesino;","bv22:6.3":"Khīṇāsavānaṃ vimalānaṃ,","bv22:6.4":"santacittāna tādinaṃ.","bv22:7.1":"Bhikkhusatasahassānaṃ,","bv22:7.2":"paṭhamo āsi samāgamo;","bv22:7.3":"Asītibhikkhusahassānaṃ,","bv22:7.4":"dutiyo āsi samāgamo.","bv22:8.1":"Sattatibhikkhusahassānaṃ,","bv22:8.2":"tatiyo āsi samāgamo;","bv22:8.3":"Anupalitto padumaṃva,","bv22:8.4":"toyamhi sampavaḍḍhitaṃ.","bv22:9.1":"Ahaṃ tena samayena,","bv22:9.2":"arindamo nāma khattiyo;","bv22:9.3":"Sambuddhappamukhaṃ saṅghaṃ,","bv22:9.4":"annapānena tappayiṃ.","bv22:10.1":"Bahuṃ dussavaraṃ datvā,","bv22:10.2":"dussakoṭiṃ anappakaṃ;","bv22:10.3":"Alaṅkataṃ hatthiyānaṃ,","bv22:10.4":"sambuddhassa adāsahaṃ.","bv22:11.1":"Hatthiyānaṃ nimminitvā,","bv22:11.2":"kappiyaṃ upanāmayiṃ;","bv22:11.3":"Pūrayiṃ mānasaṃ mayhaṃ,","bv22:11.4":"niccaṃ daḷhamupaṭṭhitaṃ.","bv22:12.1":"Sopi maṃ buddho byākāsi,","bv22:12.2":"sikhī lokagganāyako;","bv22:12.3":"“Ekatiṃse ito kappe,","bv22:12.4":"ayaṃ buddho bhavissati.","bv22:13.1":"“Ahu kapilavhayā rammā … pe …","bv22:13.3":"hessāma sammukhā imaṃ”.","bv22:14.1":"Tassāhaṃ vacanaṃ sutvā,","bv22:14.2":"bhiyyo cittaṃ pasādayiṃ;","bv22:14.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv22:14.4":"dasapāramipūriyā.","bv22:15.1":"Nagaraṃ aruṇavatī nāma,","bv22:15.2":"aruṇo nāma khattiyo;","bv22:15.3":"Pabhāvatī nāma janikā,","bv22:15.4":"sikhissāpi mahesino.","bv22:16.1":"Sattavassasahassāni,","bv22:16.2":"agāraṃ ajjha so vasi;","bv22:16.3":"Sucandako giri vasabho [sucando girivahano (sī.)],","bv22:16.4":"tayo pāsādamuttamā.","bv22:17.1":"Catuvīsasahassāni,","bv22:17.2":"nāriyo samalaṅkatā;","bv22:17.3":"Sabbakāmā nāma nārī,","bv22:17.4":"atulo nāma atrajo.","bv22:18.1":"Nimitte caturo disvā,","bv22:18.2":"hatthiyānena nikkhami;","bv22:18.3":"Aṭṭhamāsaṃ padhānacāraṃ,","bv22:18.4":"acarī purisuttamo.","bv22:19.1":"Brahmunā yācito santo,","bv22:19.2":"sikhī lokagganāyako;","bv22:19.3":"Vatti cakkaṃ mahāvīro,","bv22:19.4":"migadāye naruttamo.","bv22:20.1":"Abhibhū sambhavo ceva,","bv22:20.2":"ahesuṃ aggasāvakā;","bv22:20.3":"Khemaṅkaro nāmupaṭṭhāko,","bv22:20.4":"sikhissāpi mahesino.","bv22:21.1":"Sakhilā ca padumā ca,","bv22:21.2":"ahesuṃ aggasāvikā;","bv22:21.3":"Bodhi tassa bhagavato,","bv22:21.4":"puṇḍarīkoti vuccati.","bv22:22.1":"Sirivaḍḍho ca nando ca,","bv22:22.2":"ahesuṃ aggupaṭṭhakā;","bv22:22.3":"Cittā ceva suguttā ca,","bv22:22.4":"ahesuṃ aggupaṭṭhikā.","bv22:23.1":"Uccattanena so buddho,","bv22:23.2":"sattatihatthamuggato;","bv22:23.3":"Kañcanagghiyasaṅkāso,","bv22:23.4":"dvattiṃsavaralakkhaṇo.","bv22:24.1":"Tassāpi byāmappabhā kāyā,","bv22:24.2":"divārattiṃ nirantaraṃ;","bv22:24.3":"Disodisaṃ niccharanti,","bv22:24.4":"tīṇiyojanaso pabhā.","bv22:25.1":"Sattativassasahassāni,","bv22:25.2":"āyu tassa mahesino;","bv22:25.3":"Tāvatā tiṭṭhamāno so,","bv22:25.4":"tāresi janataṃ bahuṃ.","bv22:26.1":"Dhammameghaṃ pavassetvā,","bv22:26.2":"temayitvā sadevake;","bv22:26.3":"Khemantaṃ pāpayitvāna,","bv22:26.4":"nibbuto so sasāvako.","bv22:27.1":"Anubyañjanasampannaṃ,","bv22:27.2":"dvattiṃsavaralakkhaṇaṃ;","bv22:27.3":"Sabbaṃ tamantarahitaṃ,","bv22:27.4":"nanu rittā sabbasaṅkhārā.","bv22:28.1":"Sikhī munivaro buddho,","bv22:28.2":"assārāmamhi nibbuto;","bv22:28.3":"Tatthevassa thūpavaro,","bv22:28.4":"tīṇiyojanamuggatoti.","bv22:29.1":"Sikhissa bhagavato vaṃso vīsatimo."},"unsure":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":3435,"to":3483,"paras":[{"para":3435,"vripara":null,"refs":["bv22:8"],"lines":["Tattha <b>anupalitto padumaṃvā</b>ti toye jātaṃ toyeva vaḍḍhitaṃ padumaṃ viya toyena anupalittaṃ, sopi bhikkhusannipāto loke jātopi lokadhammehi anupalitto ahosīti attho."],"lineRefs":[["bv22:8"]]},{"para":3436,"vripara":null,"refs":["bv22:8"],"lines":["Tadā kira amhākaṃ bodhisatto katthaci asaṃsaṭṭho paribhuttanagare arindamo nāma rājā hutvā sikhimhi satthari paribhuttanagaramanuppatte saparivāro rājā bhagavato paccuggantvā pasādavaḍḍhitahadayanayanasoto dasabalassa amalacaraṇakamalayugaḷesu saparivāro sirasā abhivanditvā dasabalaṃ nimantetvā sattāhaṃ issariyakulavibhavasaddhānurūpaṃ mahādānaṃ datvā dussabhaṇḍāgāradvārāni vivarāpetvā buddhappamukhassa bhikkhusaṅghassa mahagghāni vatthāni adāsi.","Attano ca balarūpalakkhaṇajavasampannahemajālamālāsamalaṅkataṃ navakanakaruciradaṇḍakosacāmarayugavirājitaṃ vipulamudukaṇṇaṃ candarājivirājitavadanasobhaṃ erāvaṇavāraṇamiva arivāraṇaṃ varavāraṇaṃ datvā vāraṇappamāṇameva katvā kappiyabhaṇḍañca adāsi.","Sopi naṃ satthā –","“ito ekattiṃsakappe buddho bhavissatī”ti byākāsi.","Tena vuttaṃ –"],"lineRefs":[["bv22:8"],["bv22:8"],["bv22:8"],["bv22:8"],["bv22:8"]]},{"para":3438,"vripara":"9","refs":["bv22:8"],"lines":["“Ahaṃ tena samayena, arindamo nāma khattiyo;"],"lineRefs":[["bv22:8"]]},{"para":3439,"vripara":null,"refs":["bv22:8"],"lines":["Sambuddhappamukhaṃ saṅghaṃ, annapānena tappayiṃ."],"lineRefs":[["bv22:8"]]},{"para":3441,"vripara":"10","refs":["bv22:8"],"lines":["“Bahuṃ dussavaraṃ datvā, dussakoṭiṃ anappakaṃ;"],"lineRefs":[["bv22:8"]]},{"para":3442,"vripara":null,"refs":["bv22:8"],"lines":["Alaṅkataṃ hatthiyānaṃ, sambuddhassa adāsahaṃ."],"lineRefs":[["bv22:8"]]},{"para":3444,"vripara":"11","refs":["bv22:8"],"lines":["“Hatthiyānaṃ nimminitvā, kappiyaṃ upanāmayiṃ;"],"lineRefs":[["bv22:8"]]},{"para":3445,"vripara":null,"refs":["bv22:8"],"lines":["Pūrayiṃ mānasaṃ mayhaṃ, niccaṃ daḷhamupaṭṭhitaṃ."],"lineRefs":[["bv22:8"]]},{"para":3447,"vripara":"12","refs":["bv22:8"],"lines":["“Sopi maṃ buddho byākāsi, sikhī lokagganāyako;"],"lineRefs":[["bv22:8"]]},{"para":3448,"vripara":null,"refs":["bv22:8"],"lines":["Ekattiṃse ito kappe, ayaṃ buddho bhavissati."],"lineRefs":[["bv22:8"]]},{"para":3450,"vripara":"13","refs":["bv22:8"],"lines":["“Ahu kapilavhayā rammā … pe … hessāma sammukhā imaṃ."],"lineRefs":[["bv22:8"]]},{"para":3452,"vripara":"14","refs":["bv22:8"],"lines":["“Tassāhaṃ vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[["bv22:8"]]},{"para":3453,"vripara":null,"refs":["bv22:8"],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā”ti."],"lineRefs":[["bv22:8"]]},{"para":3454,"vripara":null,"refs":["bv22:8"],"lines":["Tattha <b>nimminitvā</b>ti tassa hatthino pamāṇena tulayitvā.","<b>Kappiyan</b>ti kappiyabhaṇḍaṃ, bhikkhūnaṃ yaṃ bhaṇḍaṃ kappati gahetuṃ, taṃ kappiyabhaṇḍaṃ nāma.","<b>Pūrayiṃ mānasaṃ mayhan</b>ti mama cittaṃ dānapītiyā pūrayiṃ, mayhaṃ hāsuppādanasamatthaṃ akāsinti attho.","<b>Niccaṃ daḷhamupaṭṭhitan</b>ti niccakālaṃ dānaṃ dassāmī”ti dānavasena daḷhaṃ upaṭṭhitaṃ cittanti attho."],"lineRefs":[["bv22:8"],["bv22:8"],["bv22:8"],["bv22:8"]]},{"para":3455,"vripara":null,"refs":["bv22:8"],"lines":["Tassa pana bhagavato nagaraṃ aruṇavatī nāma ahosi.","Aruṇavā nāma rājā pitā, pabhāvatī nāma mātā, abhibhū ca sambhavo ca dve aggasāvakā, khemaṅkaro nāmupaṭṭhāko, sakhilā ca madumā ca dve aggasāvikā, puṇḍarīkarukkho bodhi, sarīrañcassa sattatihatthubbedhaṃ ahosi.","Sarīrappabhā niccakālaṃ yojanattayaṃ pharitvā aṭṭhāsi.","Sattativassasahassāni āyu, sabbakāmā nāmassa aggamahesī, atulo nāmassa putto, hatthiyānena nikkhami.","Tena vuttaṃ –"],"lineRefs":[["bv22:8"],["bv22:8"],["bv22:8"],["bv22:8"],["bv22:8"]]},{"para":3457,"vripara":"15","refs":["bv22:8"],"lines":["“Nagaraṃ aruṇavatī nāma, aruṇo nāma khattiyo;"],"lineRefs":[["bv22:8"]]},{"para":3458,"vripara":null,"refs":["bv22:8"],"lines":["Pabhāvatī nāma janikā, sikhissāpi mahesino."],"lineRefs":[["bv22:8"]]},{"para":3460,"vripara":"20","refs":["bv22:8"],"lines":["“Abhibhū sambhavo ceva, ahesuṃ aggasāvakā;"],"lineRefs":[["bv22:8"]]},{"para":3461,"vripara":null,"refs":["bv22:8"],"lines":["Khemaṅkaro nāmupaṭṭhāko, sikhissāpi mahesino."],"lineRefs":[["bv22:8"]]},{"para":3463,"vripara":"21","refs":["bv22:8"],"lines":["“Sakhilā ca padumā ca, ahesuṃ aggasāvikā;"],"lineRefs":[["bv22:8"]]},{"para":3464,"vripara":null,"refs":["bv22:8"],"lines":["Bodhi tassa bhagavato, puṇḍarīkoti vuccati."],"lineRefs":[["bv22:8"]]},{"para":3466,"vripara":"22","refs":["bv22:8"],"lines":["“Sirivaḍḍho ca nando ca, ahesuṃ aggupaṭṭhakā;"],"lineRefs":[["bv22:8"]]},{"para":3467,"vripara":null,"refs":["bv22:8"],"lines":["Cittā ceva suguttā ca, ahesuṃ aggupaṭṭhikā."],"lineRefs":[["bv22:8"]]},{"para":3469,"vripara":"23","refs":["bv22:8"],"lines":["“Uccattanena so buddho, sattatihatthamuggato;"],"lineRefs":[["bv22:8"]]},{"para":3470,"vripara":null,"refs":["bv22:8"],"lines":["Kañcanagghiyasaṅkāso, dvattiṃsavaralakkhaṇo."],"lineRefs":[["bv22:8"]]},{"para":3472,"vripara":"24","refs":["bv22:8"],"lines":["“Tassāpi byāmappabhā kāyā, divārattiṃ nirantaraṃ;"],"lineRefs":[["bv22:8"]]},{"para":3473,"vripara":null,"refs":["bv22:8"],"lines":["Disodisaṃ niccharanti, tīṇi yojanaso pabhā."],"lineRefs":[["bv22:8"]]},{"para":3475,"vripara":"25","refs":["bv22:8"],"lines":["“Sattativassasahassāni, āyu tassa mahesino;"],"lineRefs":[["bv22:8"]]},{"para":3476,"vripara":null,"refs":["bv22:8"],"lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[["bv22:8"]]},{"para":3478,"vripara":"26","refs":["bv22:8"],"lines":["“Dhammameghaṃ pavassetvā, temayitvā sadevake;"],"lineRefs":[["bv22:8"]]},{"para":3479,"vripara":null,"refs":["bv22:8"],"lines":["Khemantaṃ pāpayitvāna, nibbuto so sasāvako."],"lineRefs":[["bv22:8"]]},{"para":3481,"vripara":"27","refs":["bv22:8"],"lines":["“Anubyañjanasampannaṃ, dvattiṃsavaralakkhaṇaṃ;"],"lineRefs":[["bv22:8"]]},{"para":3482,"vripara":null,"refs":["bv22:8"],"lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā”ti."],"lineRefs":[["bv22:8"]]},{"para":3483,"vripara":null,"refs":["bv22:8","bv22:27"],"lines":["Tattha <b>puṇḍarīko</b>ti setambarukkho.","<b>Tīṇi yojanaso pabhā</b>ti tīṇi yojanāni pabhā niccharantīti attho.","<b>Dhammameghan</b>ti dhammavassaṃ, dhammavassanako buddhamegho.","<b>Temayitvā</b>ti dhammakathāsalilena temetvā, siñcitvāti attho.","<b>Sadevake</b>ti sadevake satte.","<b>Khemantan</b>ti khemantaṃ nibbānaṃ.","<b>Anubyañjanasampannan</b>ti tambanakhatuṅganāsavaṭṭaṅgulitādīhi asītiyā anubyañjanehi sampannaṃ, dvattiṃsamahāpurisalakkhaṇapaṭimaṇḍitaṃ bhagavato sarīranti attho.","Sikhī kira sammāsambuddho sīlavatīnagare assārāme parinibbāyi."],"lineRefs":[["bv22:8"],["bv22:8"],["bv22:8"],["bv22:8"],["bv22:8"],["bv22:8"],["bv22:27"],["bv22:27"]]}],"wordLinks":[["bv22:8.3","anupalitto padumaṃvā",0,0],["bv22:27.1","anubyañjanasampannaṃ",33,6]],"before":[{"para":3335,"vripara":null,"refs":[],"lines":["Tadā amhākaṃ bodhisatto mahiddhiko mahānubhāvo atulo nāma nāgarājā hutvā anekanāgakoṭisatasahassaparivāro hutvā saparivārassa dasabalassa asamabalasīlassa karuṇāsītalahadayassa sakkārakaraṇatthaṃ sattaratanamayaṃ candamaṇḍalasaṅkāsaṃ daṭṭhabbasāramaṇḍaṃ maṇḍapaṃ kāretvā tattha nisīdāpetvā sattāhaṃ dibbavibhavānurūpaṃ mahādānaṃ datvā sattaratanakhacitaṃ mahārahaṃ suvaṇṇamayaṃ nānāmaṇijutivisarasamujjalaṃ pīṭhaṃ bhagavato adāsi.","Tadā naṃ pīṭhānumodanāvasāne “ito ayaṃ ekanavutikappe buddho bhavissatī”ti byākāsi.","Tena vuttaṃ –"],"lineRefs":[[],[],[]]},{"para":3337,"vripara":"10","refs":[],"lines":["“Ahaṃ tena samayena, nāgarājā mahiddhiko;"],"lineRefs":[[]]},{"para":3338,"vripara":null,"refs":[],"lines":["Atulo nāma nāmena, puññavanto jutindharo."],"lineRefs":[[]]},{"para":3340,"vripara":"11","refs":[],"lines":["“Nekānaṃ nāgakoṭīnaṃ, parivāretvānahaṃ tadā;"],"lineRefs":[[]]},{"para":3341,"vripara":null,"refs":[],"lines":["Vajjanto dibbaturiyehi, lokajeṭṭhaṃ upāgamiṃ."],"lineRefs":[[]]},{"para":3343,"vripara":"12","refs":[],"lines":["“Upasaṅkamitvā sambuddhaṃ, vipassiṃ lokanāyakaṃ;"],"lineRefs":[[]]},{"para":3344,"vripara":null,"refs":[],"lines":["Maṇimuttaratanakhacitaṃ, sabbābharaṇabhūsitaṃ;"],"lineRefs":[[]]},{"para":3345,"vripara":null,"refs":[],"lines":["Nimantetvā dhammarājassa, suvaṇṇapīṭhamadāsahaṃ."],"lineRefs":[[]]},{"para":3347,"vripara":"13","refs":[],"lines":["“Sopi maṃ buddho byākāsi, saṅghamajjhe nisīdiya;"],"lineRefs":[[]]},{"para":3348,"vripara":null,"refs":[],"lines":["Ekanavutito kappe, ayaṃ buddho bhavissati."],"lineRefs":[[]]},{"para":3350,"vripara":"14","refs":[],"lines":["“Ahu kapilavhayā rammā, nikkhamitvā tathāgato;"],"lineRefs":[[]]},{"para":3351,"vripara":null,"refs":[],"lines":["Padhānaṃ padahitvāna, katvā dukkarakārikaṃ."],"lineRefs":[[]]},{"para":3353,"vripara":"15","refs":[],"lines":["“Ajapālarukkhamūlasmiṃ, nisīditvā tathāgato;"],"lineRefs":[[]]},{"para":3354,"vripara":null,"refs":[],"lines":["Tattha pāyāsaṃ paggayha, nerañjaramupehiti."],"lineRefs":[[]]},{"para":3356,"vripara":"16","refs":[],"lines":["“Nerañjarāya tīramhi, pāyāsaṃ ada so jino;"],"lineRefs":[[]]},{"para":3357,"vripara":null,"refs":[],"lines":["Paṭiyattavaramaggena, bodhimūlamupehiti."],"lineRefs":[[]]},{"para":3359,"vripara":"17","refs":[],"lines":["“Tato padakkhiṇaṃ katvā, bodhimaṇḍaṃ anuttaro;"],"lineRefs":[[]]},{"para":3360,"vripara":null,"refs":[],"lines":["Assatthamūle sambodhiṃ, bujjhissati mahāyaso."],"lineRefs":[[]]},{"para":3362,"vripara":"18","refs":[],"lines":["“Imassa janikā mātā, māyā nāma bhavissati;"],"lineRefs":[[]]},{"para":3363,"vripara":null,"refs":[],"lines":["Pitā suddhodano nāma, ayaṃ hessati gotamo."],"lineRefs":[[]]},{"para":3365,"vripara":"19","refs":[],"lines":["“Anāsavā vītarāgā, santacittā samāhitā;"],"lineRefs":[[]]},{"para":3366,"vripara":null,"refs":[],"lines":["Kolito upatisso ca, aggā hessanti sāvakā;"],"lineRefs":[[]]},{"para":3367,"vripara":null,"refs":[],"lines":["Ānando nāmupaṭṭhāko, upaṭṭhissatimaṃ jinaṃ."],"lineRefs":[[]]},{"para":3369,"vripara":"20","refs":[],"lines":["“Khemā uppalavaṇṇā ca, aggā hessanti sāvikā;"],"lineRefs":[[]]},{"para":3370,"vripara":null,"refs":[],"lines":["Anāsavā vītarāgā, santacittā samāhitā;"],"lineRefs":[[]]},{"para":3371,"vripara":null,"refs":[],"lines":["Bodhi tassa bhagavato, assatthoti pavuccati … pe …."],"lineRefs":[[]]},{"para":3373,"vripara":"23","refs":[],"lines":["“Tassāhaṃ vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[[]]},{"para":3374,"vripara":null,"refs":[],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā”ti."],"lineRefs":[[]]},{"para":3375,"vripara":null,"refs":[],"lines":["Tattha <b>puññavanto</b>ti puññavā, samupacitapuññasañcayoti attho.","<b>Jutindharo</b>ti pabhāyutto.","<b>Nekānaṃ nāgakoṭīnan</b>ti anekāhi nāgakoṭīhi, karaṇatthe sāmivacanaṃ daṭṭhabbaṃ.","<b>Parivāretvānā</b>ti bhagavantaṃ parivāretvā.","<b>Ahan</b>ti attānaṃ niddisati.","<b>Vajjanto</b>ti vādento tāḷento.","<b>Maṇimuttaratanakhacitan</b>ti maṇimuttādīhi vividhehi ratanehi khacitanti attho.","<b>Sabbābharaṇabhūsitan</b>ti sabbābharaṇehi vāḷarūpādīhi ratanamayehi maṇḍitanti attho.","<b>Suvaṇṇapīṭhan</b>ti suvaṇṇamayaṃ pīṭhaṃ.","<b>Adāsahan</b>ti adāsiṃ ahaṃ."],"lineRefs":[[],[],[],[],[],[],[],[],[],[]]},{"para":3376,"vripara":null,"refs":[],"lines":["Tassa pana vipassissa bhagavato bandhumatī nāma nagaraṃ ahosi.","Bandhumā nāma rājā pitā, bandhumatī nāma mātā, khaṇḍo ca tisso ca dve aggasāvakā, asoko nāmupaṭṭhāko, candā ca candamittā ca dve aggasāvikā, pāṭalirukkho bodhi, sarīraṃ asītihatthubbedhaṃ ahosi, sarīrappabhā sabbakālaṃ satta yojanāni pharitvā aṭṭhāsi asītivassasahassāni āyu, sutanu nāmassa aggamahesī, samavaṭṭakkhandho nāmassa putto, ājaññarathena nikkhami.","Tena vuttaṃ –"],"lineRefs":[[],[],[]]},{"para":3378,"vripara":"24","refs":[],"lines":["“Nagaraṃ bandhumatī nāma, bandhumā nāma khattiyo;"],"lineRefs":[[]]},{"para":3379,"vripara":null,"refs":[],"lines":["Mātā bandhumatī nāma, vipassissa mahesino."],"lineRefs":[[]]},{"para":3381,"vripara":"29","refs":[],"lines":["“Khaṇḍo ca tissanāmo ca, ahesuṃ aggasāvakā;"],"lineRefs":[[]]},{"para":3382,"vripara":null,"refs":[],"lines":["Asoko nāmupaṭṭhāko, vipassissa mahesino."],"lineRefs":[[]]},{"para":3384,"vripara":"30","refs":[],"lines":["“Candā ca candamittā ca, ahesuṃ aggasāvikā;"],"lineRefs":[[]]},{"para":3385,"vripara":null,"refs":[],"lines":["Bodhi tassa bhagavato, pāṭalīti pavuccati."],"lineRefs":[[]]},{"para":3387,"vripara":"32","refs":[],"lines":["“Asītihatthamubbedho, vipassī lokanāyako;"],"lineRefs":[[]]},{"para":3388,"vripara":null,"refs":[],"lines":["Pabhā niddhāvatī tassa, samantā sattayojane."],"lineRefs":[[]]},{"para":3390,"vripara":"33","refs":[],"lines":["“Asītivassasahassāni, āyu buddhassa tāvade;"],"lineRefs":[[]]},{"para":3391,"vripara":null,"refs":[],"lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[[]]},{"para":3393,"vripara":"34","refs":[],"lines":["“Bahudevamanussānaṃ, bandhanā parimocayi;"],"lineRefs":[[]]},{"para":3394,"vripara":null,"refs":[],"lines":["Maggāmaggañca ācikkhi, avasesaputhujjane."],"lineRefs":[[]]},{"para":3396,"vripara":"35","refs":[],"lines":["“Ālokaṃ dassayitvāna, desetvā amataṃ padaṃ;"],"lineRefs":[[]]},{"para":3397,"vripara":null,"refs":[],"lines":["Jalitvā aggikkhandhova, nibbuto so sasāvako."],"lineRefs":[[]]},{"para":3399,"vripara":"36","refs":[],"lines":["“Iddhivaraṃ puññavaraṃ, lakkhaṇañca kusumitaṃ;"],"lineRefs":[[]]},{"para":3400,"vripara":null,"refs":[],"lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā”ti."],"lineRefs":[[]]},{"para":3401,"vripara":null,"refs":[],"lines":["Tattha <b>bandhanā</b>ti devamanusse kāmarāgasaṃyojanādibandhanā mocesi, vikāsesīti attho.","<b>Maggāmaggañca ācikkhī</b>ti “amatādhigamāya ayaṃ maggo ucchedasassatadiṭṭhivirahitā majjhimā paṭipadā maggo kāyakilamathādiko nāyaṃ maggo”ti sesaputhujjane ācikkhīti attho.","<b>Ālokaṃ dassayitvānā</b>ti maggañāṇālokaṃ vipassanāñāṇālokañca dassayitvā.","<b>Lakkhaṇañca kusumitan</b>ti cittalakkhaṇādīhi phullitaṃ maṇḍitaṃ bhagavato sarīranti attho.","Sesaṃ sabbattha gāthāsu uttānamevāti."],"lineRefs":[[],[],[],[],[]]},{"para":3402,"vripara":null,"refs":[],"lines":["Vipassībuddhavaṃsavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3403,"vripara":null,"refs":[],"lines":["Niṭṭhito ekūnavīsatimo buddhavaṃso."],"lineRefs":[[]]},{"para":3404,"vripara":null,"refs":[],"lines":["Sikhībuddhavaṃsavaṇṇanā"],"lineRefs":[[]]},{"para":3405,"vripara":null,"refs":[],"lines":["Vipassissa aparabhāge antarahite ca tasmiṃ kappe tato paraṃ ekūnasaṭṭhiyā kappesu buddhā loke na uppajjiṃsu.","Apagatabuddhāloko ahosi.","Kilesadevaputtamārānaṃ ekarajjaṃ apagatakaṇṭakaṃ ahosi.","Ito pana ekattiṃsakappe siniddhasukkhasāradārupacito pahūtasappisitto nidhūmo sikhī viya <b>sikhī</b> ca <b>vessabhū</b> cāti dve sammāsambuddhā loke uppajjiṃsu.","Tattha <b>sikhī</b> pana bhagavā pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā kusalakaraṇavatī aruṇavatīnagare paramaguṇavato aruṇavato nāma rañño aggamahesiyā rattakanakapaṭibimbarucirappabhāya pabhāvatiyā nāma deviyā kucchismiṃ paṭisandhiṃ gahetvā dasa māse vītināmetvā nisabhuyyāne mātukucchito nikkhami.","Nemittikā panassa nāmaṃ karontā uṇhīsassa sikhā viya uggatattā “sikhī”ti nāmamakaṃsu.","So sattavassasahassāni agāraṃ ajjhāvasi.","Sucandakasirīgiriyasanārivasabha nāmakā tayo pāsādā ahesuṃ.","Sabbakāmādevippamukhāni catuvīsati itthisahassāni paccupaṭṭhitāni ahesuṃ."],"lineRefs":[[],[],[],[],[],[],[],[],[]]},{"para":3406,"vripara":null,"refs":[],"lines":["So cattāri nimittāni disvā sabbakāmādeviyā guṇagaṇātule atule nāma putte uppanne hatthiyānena hatthikkhandhavaragato mahābhinikkhamanaṃ nikkhamitvā pabbaji.","Taṃ sattatipurisasatasahassāni anupabbajiṃsu.","So tehi parivuto aṭṭhamāsaṃ padhānacariyaṃ caritvā visākhapuṇṇamāya gaṇasaṅgaṇikaṃ pahāya sudassananigame piyadassīseṭṭhino dhītuyā dinnaṃ madhupāyāsaṃ paribhuñjitvā taruṇakhadiravane divāvihāraṃ vītināmetvā anomadassinā nāma tāpasena dinnā aṭṭha kusatiṇamuṭṭhiyo gahetvā puṇḍarīkabodhiṃ upasaṅkami.","Tassā kira puṇḍarīkabodhiyāpi pāṭaliyā pamāṇameva pamāṇaṃ ahosi.","Taṃdivasameva so paṇṇāsaratanakkhandho hutvā abbhuggato, sākhāpissa paṇṇāsaratanamattāva.","So dibbehi gandhehi pupphehi sañchanno ahosi.","Na kevalaṃ puppheheva, phalehipi sañchanno ahosi.","Tassa ekapassato taruṇāni phalāni ekato majjhimāni ekato nātipakkāni ekato pakkhittadibbojāni viya surasāni vaṇṇagandharasasampannāni tato tato olambanti.","Yathā ca so, evaṃ dasasahassicakkavāḷesu pupphūpagā rukkhā pupphehi phalūpagā rukkhā phalehi paṭimaṇḍitā ahesuṃ."],"lineRefs":[[],[],[],[],[],[],[],[],[]]},{"para":3407,"vripara":null,"refs":[],"lines":["So tattha catuvīsatihatthavitthataṃ tiṇasantharaṃ santharitvā pallaṅkaṃ ābhujitvā caturaṅgavīriyaṃ adhiṭṭhāya nisīdi.","Evaṃ nisīditvā chattiṃsa yojanavitthataṃ samāraṃ mārabalaṃ vidhamitvā sambodhiṃ pāpuṇitvā –","“anekajātisaṃsāraṃ … pe … taṇhānaṃ khayamajjhagā”ti udānaṃ udānetvā bodhisamīpeyeva sattasattāhaṃ vītināmetvā brahmāyācanaṃ sampaṭicchitvā attanā saha pabbajitānaṃ sattatiyā bhikkhusatasahassānaṃ upanissayasampattiṃ disvā surapathena gantvā vividhāvaraṇavatiyā aruṇavatiyā rājadhāniyā samīpe migājinuyyāne otaritvā tehi munigaṇehi parivuto tesaṃ majjhe dhammacakkaṃ pavattesi.","Tadā koṭisatasahassānaṃ paṭhamo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[]]},{"para":3409,"vripara":"1","refs":[],"lines":["“Vipassissa aparena, sambuddho dvipaduttamo;"],"lineRefs":[[]]},{"para":3410,"vripara":null,"refs":[],"lines":["Sikhivhayo āsi jino, asamo appaṭipuggalo."],"lineRefs":[[]]},{"para":3412,"vripara":"2","refs":[],"lines":["“Mārasenaṃ pamadditvā, patto sambodhimuttamaṃ;"],"lineRefs":[[]]},{"para":3413,"vripara":null,"refs":[],"lines":["Dhammacakkaṃ pavattesi, anukampāya pāṇinaṃ."],"lineRefs":[[]]},{"para":3415,"vripara":"3","refs":[],"lines":["“Dhammacakkaṃ pavattente, sikhimhi jinapuṅgave;"],"lineRefs":[[]]},{"para":3416,"vripara":null,"refs":[],"lines":["Koṭisatasahassānaṃ, paṭhamābhisamayo ahū”ti."],"lineRefs":[[]]},{"para":3417,"vripara":null,"refs":[],"lines":["Punapi aruṇavatiyā rājadhāniyā samīpeyeva abhibhūrājaputtassa ca sambhavarājaputtassa cāti dvinnaṃ saparivārānaṃ dhammaṃ desetvā navutikoṭisahassāni dhammāmataṃ pāyesi.","So dutiyo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[]]},{"para":3419,"vripara":"4","refs":[],"lines":["“Aparampi dhammaṃ desente, gaṇaseṭṭhe naruttame;"],"lineRefs":[[]]},{"para":3420,"vripara":null,"refs":[],"lines":["Navuttikoṭisahassānaṃ, dutiyābhisamayo ahū”ti."],"lineRefs":[[]]},{"para":3421,"vripara":null,"refs":[],"lines":["Yadā pana sūriyavatīnagaradvāre campakarukkhamūle titthiyamadamānabhañjanatthaṃ sabbajanabandhanamokkhatthañca yamakapāṭihāriyaṃ karonto bhagavā dhammaṃ desesi, tadā asītikoṭisahassānaṃ tatiyo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[]]},{"para":3423,"vripara":"5","refs":[],"lines":["“Yamakapāṭihāriyañca, dassayante sadevake;"],"lineRefs":[[]]},{"para":3424,"vripara":null,"refs":[],"lines":["Asītikoṭisahassānaṃ, tatiyābhisamayo ahū”ti."],"lineRefs":[[]]},{"para":3425,"vripara":null,"refs":[],"lines":["Abhibhunā ca sambhavena ca rājaputtena saddhiṃ pabbajitānaṃ arahantānaṃ satasahassānaṃ majjhe nisīditvā pātimokkhaṃ uddisi, so paṭhamo sannipāto ahosi, aruṇavatīnagare ñātisamāgame pabbajitānaṃ asītiyā bhikkhusahassānaṃ majjhe nisīditvā pātimokkhaṃ uddisi, so dutiyo sannipāto ahosi.","Dhanañjayanagare dhanapālakanāgavinayanasamaye pabbajitānaṃ sattatiyā bhikkhusahassānaṃ majjhe bhagavā pātimokkhaṃ uddisi, so tatiyo sannipāto ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[]]},{"para":3427,"vripara":"6","refs":[],"lines":["“Sannipātā tayo āsuṃ, sikhissāpi mahesino;"],"lineRefs":[[]]},{"para":3428,"vripara":null,"refs":[],"lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ."],"lineRefs":[[]]},{"para":3430,"vripara":"7","refs":[],"lines":["“Bhikkhusatasahassānaṃ, paṭhamo āsi samāgamo;"],"lineRefs":[[]]},{"para":3431,"vripara":null,"refs":[],"lines":["Asītibhikkhusahassānaṃ, dutiyo āsi samāgamo."],"lineRefs":[[]]},{"para":3433,"vripara":"8","refs":[],"lines":["“Sattatibhikkhusahassānaṃ, tatiyo āsi samāgamo;"],"lineRefs":[[]]},{"para":3434,"vripara":null,"refs":[],"lines":["Anupalitto padumaṃva, toyamhi sampavaḍḍhitan”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
