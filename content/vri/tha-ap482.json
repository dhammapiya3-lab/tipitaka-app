{"suttaId":"tha-ap482","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1815,1838],"vripara":"90"},"segments":{"tha-ap482:0.3":"Pulinacaṅkamiyattheraapadānaṃ","tha-ap482:1.1":"“Migaluddo pure āsiṃ,","tha-ap482:1.2":"araññe kānane ahaṃ;","tha-ap482:1.3":"Vātamigaṃ gavesanto,","tha-ap482:1.4":"caṅkamaṃ addasaṃ ahaṃ.","tha-ap482:2.1":"“Ucchaṅgena pulinaṃ [puḷinaṃ (sī. syā. pī. ka.)] gayha,","tha-ap482:2.2":"caṅkame okiriṃ ahaṃ;","tha-ap482:2.3":"Pasannacitto sumano,","tha-ap482:2.4":"sugatassa sirīmato.","tha-ap482:3.1":"“Ekatiṃse ito kappe,","tha-ap482:3.2":"pulinaṃ okiriṃ ahaṃ;","tha-ap482:3.3":"Duggatiṃ nābhijānāmi,","tha-ap482:3.4":"pulinassa idaṃ phalaṃ.","tha-ap482:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap482:4.3":"viharāmi anāsavo.","tha-ap482:5.1":"“Svāgataṃ vata me āsi … pe …","tha-ap482:5.3":"kataṃ buddhassa sāsanaṃ.","tha-ap482:6.1":"“Paṭisambhidā catasso … pe …","tha-ap482:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap482:7.1":"Itthaṃ sudaṃ āyasmā pulinacaṅkamiyo thero imā gāthāyo Abhāsitthāti.","tha-ap482:8.1":"Pulinacaṅkamiyattherassāpadānaṃ dasamaṃ.","tha-ap482:9.1":"Naḷamālivaggo aṭṭhacattālīsamo.","tha-ap482:10.1":"Tassuddānaṃ –","tha-ap482:11.1":"Naḷamālī maṇidado,","tha-ap482:11.2":"ukkāsatikabījanī;","tha-ap482:11.3":"Kummāso ca kusaṭṭho ca,","tha-ap482:11.4":"giripunnāgiyopi ca.","tha-ap482:12.1":"Vallikāro pānadhido,","tha-ap482:12.2":"atho pulinacaṅkamo;","tha-ap482:12.3":"Gāthāyo pañcanavuti,","tha-ap482:12.4":"gaṇitāyo vibhāvibhi."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
