{"suttaId":"ja11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[63,67],"vripara":"11"},"segments":{"ja11:0.4":"Lakkhaṇamigajātakaṃ","ja11:1.1":"Hoti sīlavataṃ attho, paṭisanthāra [paṭisandhāra (ka.)] vuttinaṃ;","ja11:1.3":"Lakkhaṇaṃ passa āyantaṃ, ñātisaṅghapurakkhataṃ [purakkhitaṃ (syā.), purekkhitaṃ (ka.)];","ja11:1.5":"Atha passasimaṃ kāḷaṃ, suvihīnaṃva ñātibhīti.","ja11:2.1":"Lakkhaṇamigajātakaṃ paṭhamaṃ."},"attha":null,"tika":null}
