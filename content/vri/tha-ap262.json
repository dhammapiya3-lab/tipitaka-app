{"suttaId":"tha-ap262","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8378,8398],"vripara":"37"},"segments":{"tha-ap262:0.3":"Aggapupphiyattheraapadānaṃ","tha-ap262:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap262:1.2":"nisinnaṃ pabbatantare;","tha-ap262:1.3":"Obhāsayantaṃ raṃsena [raṃsiyā (syā.)],","tha-ap262:1.4":"sikhinaṃ sikhinaṃ yathā.","tha-ap262:2.1":"“Aggajaṃ pupphamādāya,","tha-ap262:2.2":"upāgacchiṃ naruttamaṃ;","tha-ap262:2.3":"Pasannacitto sumano,","tha-ap262:2.4":"buddhassa abhiropayiṃ.","tha-ap262:3.1":"“Ekattiṃse ito kappe,","tha-ap262:3.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap262:3.3":"Duggatiṃ nābhijānāmi,","tha-ap262:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap262:4.1":"“Pañcavīsatikappamhi,","tha-ap262:4.2":"ahosi amitogato [amitavhayo (sī.)];","tha-ap262:4.3":"Sattaratanasampanno,","tha-ap262:4.4":"cakkavattī mahabbalo.","tha-ap262:5.1":"“Paṭisambhidā catasso … pe …","tha-ap262:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap262:6.1":"Itthaṃ sudaṃ āyasmā aggapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap262:7.1":"Aggapupphiyattherassāpadānaṃ dasamaṃ.","tha-ap262:8.1":"Thomakavaggo chabbīsatimo.","tha-ap262:9.1":"Tassuddānaṃ –","tha-ap262:10.1":"Thomakekāsanacitakaṃ,","tha-ap262:10.2":"campako sattapāṭali;","tha-ap262:10.3":"Pānadhi [pāhano (sī.), pādu (syā.)] mañjarī paṇṇaṃ,","tha-ap262:10.4":"kuṭido aggapupphiyo;","tha-ap262:10.5":"Gāthāyo gaṇitā cettha,","tha-ap262:10.6":"ekatālīsameva cāti."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3218,"to":3218,"paras":[{"para":3218,"vripara":"37-38","refs":["tha-ap262:1"],"lines":["37-38. Dasamāpadāne <b>sikhinaṃ sikhinaṃ yathā</b>ti sarīrato nikkhantachabbaṇṇaraṃsīhi <b>obhāsayantaṃ</b> jalantaṃ sikhīnaṃ sikhībhagavantaṃ sikhīnaṃ yathā jalamānaaggikkhandhaṃ viya.","<b>Aggajaṃ pupphamādāyā</b>ti aggajanāmakaṃ pupphaṃ gahetvā <b>buddhassa</b> sikhissa bhagavato <b>abhiropayiṃ</b> pūjesinti attho."],"lineRefs":[["tha-ap262:1"],["tha-ap262:1"]]}],"wordLinks":[["tha-ap262:1.3","obhāsayantaṃ",0,0],["tha-ap262:1.3","sikhinaṃ sikhinaṃ yathā",0,0]],"after":[{"para":3219,"vripara":null,"title":"Thomakattheraapadānādivaṇṇanā","lines":["Chabbīsatimavaggavaṇṇanā samattā."]}]},"tika":null,"tika2":null}
