{"suttaId":"an4.98","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[955,955],"vripara":"98"},"segments":{"an4.98:0.3":"Attahitasuttaṃ","an4.98:1.1":"“Cattārome, bhikkhave, puggalā santo saṃvijjamānā lokasmiṃ.","an4.98:1.2":"Katame cattāro?","an4.98:1.3":"Attahitāya paṭipanno no parahitāya,","an4.98:1.4":"parahitāya paṭipanno no attahitāya,","an4.98:1.5":"nevattahitāya paṭipanno no parahitāya,","an4.98:1.6":"attahitāya ceva paṭipanno parahitāya ca.","an4.98:1.7":"Ime kho, bhikkhave, cattāro puggalā santo saṃvijjamānā lokasmin”ti.","an4.98:1.8":"Aṭṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1361,"to":1362,"paras":[{"para":1361,"vripara":"98-99","refs":["an4.98:1"],"lines":["98-99. Aṭṭhamaṃ puggalajjhāsayavasenāpi dasabalassa desanāñāṇavilāsenāpi kathitaṃ, navamaṃ pañcaveravasena."],"lineRefs":[["an4.98:1"]]},{"para":1362,"vripara":null,"refs":["an4.98:1"],"lines":["Potaliyasuttavaṇṇanā"],"lineRefs":[["an4.98:1"]]}],"wordLinks":[],"before":[{"para":1360,"vripara":null,"title":"Attahitasuttavaṇṇanā","lines":["Attahitasuttavaṇṇanā"]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1544,"to":1547,"paras":[{"para":1544,"vripara":"97-100","refs":["an4.98:1"],"lines":["97-100. Sattame <b>khippanisantī</b>ti khippapañño.","Tenāha <b>“khippanisāmano”</b>tiādi.","<b>Anurūpadhamman</b>ti lokuttarādhigamassa anucchavikasabhāvaṃ.","Kalyāṇā sundarā parimaṇḍalapadabyañjanā vācā assāti <b>kalyāṇavāco</b>.","Tenāha <b>“sundaravacano”</b>ti.","Kalyāṇaṃ madhuraṃ vākkaraṇaṃ udāhāraghoso assāti <b>kalyāṇavākkaraṇo</b>.","Guṇaparipuṇṇabhāvena pūre puṇṇabhāve bhavāti porī, tāya <b>poriyā</b>.","Tenāha <b>“guṇaparipuṇṇāyā”</b>ti.","Pure bhavattā poriyā nāgarikitthiyā sukhumālattanena sadisāti porī, tāya <b>poriyā</b>.","“Sukhumālattanenā”ti iminā tassā vācāya mudusaṇhabhāvo vutto.","<b>Apalibuddhāyā</b>ti pittasemhādīhi na paliveṭhitāya.","<b>Adosāyā</b>ti sandiddhavilambitādidosarahitāya <b>agaḷitapadabyañjanāyā</b>ti apatitapadabyañjanāya avirahitapadabyañjanāya.","Ubhayametaṃ anelagalāyāti imasseva atthavacanaṃ.","<b>Anelagalāyā</b>ti hi anelāya ceva agalāya cāti attho.","<b>Atthaṃ viññāpetuṃ samatthāyā</b>ti ādimajjhapariyosānaṃ pākaṭaṃ katvā bhāsitatthassa viññāpanasatthāya.","Aṭṭhamanavamadasamāni uttānatthāneva."],"lineRefs":[["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"],["an4.98:1"]]},{"para":1545,"vripara":null,"refs":["an4.98:1"],"lines":["Khippanisantisuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an4.98:1"]]},{"para":1546,"vripara":null,"refs":["an4.98:1"],"lines":["Asuravaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an4.98:1"]]},{"para":1547,"vripara":null,"refs":["an4.98:1"],"lines":["Dutiyapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an4.98:1"]]}],"wordLinks":[]},"tika2":null}
