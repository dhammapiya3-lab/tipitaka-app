{"suttaId":"ja226","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1518,1525],"vripara":"151"},"segments":{"ja226:0.4":"Kosiyajātakaṃ (2-8-6)","ja226:1.1":"Kāle nikkhamanā sādhu, nākāle sādhu nikkhamo;","ja226:1.3":"Akālena hi nikkhamma, ekakampi bahujjano;","ja226:1.5":"Na kiñci atthaṃ joteti, dhaṅkasenāva kosiyaṃ.","ja226:2.1":"Dhīro ca vidhividhānaññū, paresaṃ vivarānugū;","ja226:2.3":"Sabbāmitte vasīkatvā, kosiyova sukhī siyāti.","ja226:3.1":"Kosiyajātakaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
