{"suttaId":"thag1.40","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[234,242],"vripara":"40"},"segments":{"thag1.40:0.4":"Vaḍḍhamānattheragāthā","thag1.40:1.1":"“Sattiyā viya omaṭṭho, ḍayhamānova matthake;","thag1.40:1.3":"Bhavarāgappahānāya, sato bhikkhu paribbaje”ti.","thag1.40:1.5":"… Vaḍḍhamāno thero ….","thag1.40:1.6":"Vaggo catuttho niṭṭhito.","thag1.40:2.0":"Tassuddānaṃ –","thag1.40:2.1":"Gahvaratīriyo suppiyo, sopāko ceva posiyo;","thag1.40:2.3":"Sāmaññakāni kumāputto, kumāputtasahāyako;","thag1.40:2.5":"Gavampati tissatthero, vaḍḍhamāno mahāyasoti."},"attha":null,"tika":null}
