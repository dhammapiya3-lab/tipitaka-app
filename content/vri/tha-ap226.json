{"suttaId":"tha-ap226","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7853,7868],"vripara":"19"},"segments":{"tha-ap226:0.3":"Ārakkhadāyakattheraapadānaṃ","tha-ap226:1.1":"“Siddhatthassa bhagavato, vedi kārāpitā [vedikā kāritā (syā.)] mayā;","tha-ap226:1.3":"Ārakkho ca mayā dinno, sugatassa mahesino.","tha-ap226:2.1":"“Tena kammavisesena, na passiṃ bhayabheravaṃ;","tha-ap226:2.3":"Kuhiñci upapannassa, tāso mayhaṃ na vijjati.","tha-ap226:3.1":"“Catunnavutito kappe, yaṃ vediṃ kārayiṃ pure;","tha-ap226:3.3":"Duggatiṃ nābhijānāmi, vedikāya idaṃ phalaṃ.","tha-ap226:4.1":"“Ito chaṭṭhamhi kappamhi, apassenasanāmako;","tha-ap226:4.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap226:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap226:6.1":"Itthaṃ sudaṃ āyasmā ārakkhadāyako thero imā gāthāyo abhāsitthāti.","tha-ap226:7.1":"Ārakkhadāyakattherassāpadānaṃ catutthaṃ."},"attha":null,"tika":null,"tika2":null}
