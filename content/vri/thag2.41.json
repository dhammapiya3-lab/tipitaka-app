{"suttaId":"thag2.41","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1058,1065],"vripara":"201"},"segments":{"thag2.41:0.4":"Kumārakassapattheragāthā","thag2.41:1.1":"“Aho buddhā aho dhammā, aho no satthu sampadā;","thag2.41:1.3":"Yattha etādisaṃ dhammaṃ, sāvako sacchikāhi”ti.","thag2.41:2.1":"“Asaṅkheyyesu kappesu, sakkāyādhigatā ahū;","thag2.41:2.3":"Tesamayaṃ pacchimako, carimoyaṃ samussayo;","thag2.41:2.5":"Jātimaraṇasaṃsāro, natthi dāni punabbhavo”ti.","thag2.41:2.7":"… Kumārakassapo thero …."},"attha":null,"tika":null}
