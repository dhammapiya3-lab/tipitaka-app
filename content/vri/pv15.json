{"suttaId":"pv15","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[450,556],"vripara":"134"},"segments":{"pv15:0.3":"Mattāpetivatthu","pv15:1.1":"“Naggā dubbaṇṇarūpāsi,","pv15:1.2":"kisā dhamanisanthatā;","pv15:1.3":"Upphāsulike kisike,","pv15:1.4":"kā nu tvaṃ idha tiṭṭhasī”ti.","pv15:2.1":"“Ahaṃ mattā tuvaṃ tissā,","pv15:2.2":"sapattī te pure ahuṃ;","pv15:2.3":"Pāpakammaṃ karitvāna,","pv15:2.4":"petalokaṃ ito gatā”ti.","pv15:3.1":"“Kiṃ nu kāyena vācāya,","pv15:3.2":"manasā dukkaṭaṃ kataṃ;","pv15:3.3":"Kissa kammavipākena,","pv15:3.4":"petalokaṃ ito gatā”ti.","pv15:4.1":"“Caṇḍī ca pharusā cāsiṃ,","pv15:4.2":"issukī maccharī saṭhā [saṭhī (sī.)];","pv15:4.3":"Tāhaṃ duruttaṃ vatvāna,","pv15:4.4":"petalokaṃ ito gatā”ti.","pv15:5.1":"Sabbaṃ [saccaṃ (ka.)] ahampi jānāmi,","pv15:5.2":"yathā tvaṃ caṇḍikā ahu;","pv15:5.3":"Aññañca kho taṃ pucchāmi,","pv15:5.4":"kenāsi paṃsukunthitā”ti.","pv15:6.1":"“Sīsaṃnhātā tuvaṃ āsi,","pv15:6.2":"sucivatthā alaṅkatā;","pv15:6.3":"Ahañca kho [kho taṃ (sī. ka.)] adhimattaṃ,","pv15:6.4":"samalaṅkatatarā tayā.","pv15:7.1":"“Tassā me pekkhamānāya,","pv15:7.2":"sāmikena samantayi;","pv15:7.3":"Tato me issā vipulā,","pv15:7.4":"kodho me samajāyatha.","pv15:8.1":"“Tato paṃsuṃ gahetvāna,","pv15:8.2":"paṃsunā taṃ hi okiriṃ [taṃ vikīrihaṃ (syā. ka.)];","pv15:8.3":"Tassa kammavipākena,","pv15:8.4":"tenamhi paṃsukunthitā”ti.","pv15:9.1":"“Saccaṃ ahampi jānāmi,","pv15:9.2":"paṃsunā maṃ tvamokiri;","pv15:9.3":"Aññañca kho taṃ pucchāmi,","pv15:9.4":"kena khajjasi kacchuyā”ti.","pv15:10.1":"“Bhesajjahārī ubhayo,","pv15:10.2":"vanantaṃ agamimhase;","pv15:10.3":"Tvañca bhesajjamāhari,","pv15:10.4":"ahañca kapikacchuno.","pv15:11.1":"“Tassā tyājānamānāya,","pv15:11.2":"seyyaṃ tyāhaṃ samokiriṃ;","pv15:11.3":"Tassa kammavipākena,","pv15:11.4":"tena khajjāmi kacchuyā”ti.","pv15:12.1":"“Saccaṃ ahampi jānāmi,","pv15:12.2":"seyyaṃ me tvaṃ samokiri;","pv15:12.3":"Aññañca kho taṃ pucchāmi,","pv15:12.4":"kenāsi naggiyā tuvan”ti.","pv15:13.1":"“Sahāyānaṃ samayo āsi,","pv15:13.2":"ñātīnaṃ samitī ahu;","pv15:13.3":"Tvañca āmantitā āsi,","pv15:13.4":"sasāminī no ca kho ahaṃ.","pv15:14.1":"“Tassā tyājānamānāya,","pv15:14.2":"dussaṃ tyāhaṃ apānudiṃ;","pv15:14.3":"Tassa kammavipākena,","pv15:14.4":"tenamhi naggiyā ahan”ti.","pv15:15.1":"“Saccaṃ ahampi jānāmi,","pv15:15.2":"dussaṃ me tvaṃ apānudi;","pv15:15.3":"Aññañca kho taṃ pucchāmi,","pv15:15.4":"kenāsi gūthagandhinī”ti.","pv15:16.1":"“Tava gandhañca mālañca,","pv15:16.2":"paccagghañca vilepanaṃ;","pv15:16.3":"Gūthakūpe adhāresiṃ [adhāresiṃ (ka.)],","pv15:16.4":"taṃ pāpaṃ pakataṃ mayā;","pv15:16.5":"Tassa kammavipākena,","pv15:16.6":"tenamhi gūthagandhinī”ti.","pv15:17.1":"“Saccaṃ ahampi jānāmi,","pv15:17.2":"taṃ pāpaṃ pakataṃ tayā;","pv15:17.3":"Aññañca kho taṃ pucchāmi,","pv15:17.4":"kenāsi duggatā tuvan”ti.","pv15:18.1":"“Ubhinnaṃ samakaṃ āsi,","pv15:18.2":"yaṃ gehe vijjate dhanaṃ;","pv15:18.3":"Santesu deyyadhammesu,","pv15:18.4":"dīpaṃ nākāsimattano;","pv15:18.5":"Tassa kammavipākena,","pv15:18.6":"tenamhi duggatā ahaṃ.","pv15:19.1":"“Tadeva maṃ tvaṃ avaca,","pv15:19.2":"‘pāpakammaṃ nisevasi;","pv15:19.3":"Na hi pāpehi kammehi,","pv15:19.4":"sulabhā hoti suggatī’”ti.","pv15:20.1":"“Vāmato maṃ tvaṃ paccesi,","pv15:20.2":"athopi maṃ usūyasi;","pv15:20.3":"Passa pāpānaṃ kammānaṃ,","pv15:20.4":"vipāko hoti yādiso.","pv15:21.1":"“Te gharā tā ca dāsiyo [te gharadāsiyo āsuṃ (sī. syā.), te ghare dāsiyo ceva (ka.)],","pv15:21.2":"tānevābharaṇānime;","pv15:21.3":"Te aññe paricārenti,","pv15:21.4":"na bhogā honti sassatā.","pv15:22.1":"“Idāni bhūtassa pitā,","pv15:22.2":"āpaṇā gehamehiti;","pv15:22.3":"Appeva te dade kiñci,","pv15:22.4":"mā su tāva ito agā”ti.","pv15:23.1":"“Naggā dubbaṇṇarūpāmhi,","pv15:23.2":"kisā dhamanisanthatā;","pv15:23.3":"Kopīnametaṃ itthīnaṃ,","pv15:23.4":"mā maṃ bhūtapitāddasā”ti.","pv15:24.1":"“Handa kiṃ vā tyāhaṃ [kiṃ tyāhaṃ (sī. syā.), kiṃ vatāhaṃ (ka.)] dammi,","pv15:24.2":"kiṃ vā tedha [kiṃ vā ca te (sī. syā.), kiṃ vidha te (ka.)] karomahaṃ;","pv15:24.3":"Yena tvaṃ sukhitā assa,","pv15:24.4":"sabbakāmasamiddhinī”ti.","pv15:25.1":"“Cattāro bhikkhū saṅghato,","pv15:25.2":"cattāro pana puggalā;","pv15:25.3":"Aṭṭha bhikkhū bhojayitvā,","pv15:25.4":"mama dakkhiṇamādisa;","pv15:25.5":"Tadāhaṃ sukhitā hessaṃ,","pv15:25.6":"sabbakāmasamiddhinī”ti.","pv15:26.1":"Sādhūti sā paṭissutvā,","pv15:26.2":"bhojayitvāṭṭha bhikkhavo;","pv15:26.3":"Vatthehacchādayitvāna,","pv15:26.4":"tassā dakkhiṇamādisī.","pv15:27.1":"Samanantarānuddiṭṭhe,","pv15:27.2":"vipāko udapajjatha;","pv15:27.3":"Bhojanacchādanapānīyaṃ,","pv15:27.4":"dakkhiṇāya idaṃ phalaṃ.","pv15:28.1":"Tato suddhā sucivasanā,","pv15:28.2":"kāsikuttamadhārinī;","pv15:28.3":"Vicittavatthābharaṇā,","pv15:28.4":"sapattiṃ upasaṅkami.","pv15:29.1":"“Abhikkantena vaṇṇena,","pv15:29.2":"yā tvaṃ tiṭṭhasi devate;","pv15:29.3":"Obhāsentī disā sabbā,","pv15:29.4":"osadhī viya tārakā.","pv15:30.1":"“Kena tetādiso vaṇṇo,","pv15:30.2":"kena te idha mijjhati;","pv15:30.3":"Uppajjanti ca te bhogā,","pv15:30.4":"ye keci manaso piyā.","pv15:31.1":"“Pucchāmi taṃ devi mahānubhāve,","pv15:31.2":"manussabhūtā kimakāsi puññaṃ;","pv15:31.3":"Kenāsi evaṃ jalitānubhāvā,","pv15:31.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","pv15:32.1":"“Ahaṃ mattā tuvaṃ tissā,","pv15:32.2":"sapattī te pure ahuṃ;","pv15:32.3":"Pāpakammaṃ karitvāna,","pv15:32.4":"petalokaṃ ito gatā.","pv15:33.1":"“Tava dinnena dānena,","pv15:33.2":"modāmi akutobhayā;","pv15:33.3":"Cīraṃ jīvāhi bhagini,","pv15:33.4":"saha sabbehi ñātibhi;","pv15:33.5":"Asokaṃ virajaṃ ṭhānaṃ,","pv15:33.6":"āvāsaṃ vasavattinaṃ.","pv15:34.1":"“Idha dhammaṃ caritvāna,","pv15:34.2":"dānaṃ datvāna sobhane;","pv15:34.3":"Vineyya maccheramalaṃ samūlaṃ,","pv15:34.4":"aninditā saggamupehi ṭhānan”ti.","pv15:35.1":"Mattāpetivatthu tatiyaṃ."},"unsure":[],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":792,"to":806,"paras":[{"para":792,"vripara":"138","refs":["pv15:5"],"lines":["Tattha <b>sabbaṃ ahampi jānāmi, yathā tvaṃ caṇḍikā ahū</b>ti “caṇḍī ca pharusā cāsin”ti yaṃ tayā vuttaṃ, taṃ sabbaṃ ahampi jānāmi, yathā tvaṃ caṇḍikā kodhanā pharusavacanā issukī maccharī saṭhā ca ahosi.","<b>Aññañca kho taṃ pucchāmī</b>ti aññaṃ puna taṃ idāni pucchāmi.","<b>Kenāsi paṃsukunthitā</b>ti kena kammena saṅkārapaṃsūti oguṇṭhitā sabbaso okiṇṇasarīrā ahūti attho."],"lineRefs":[["pv15:5"],["pv15:5"],["pv15:5"]]},{"para":793,"vripara":"139-140","refs":["pv15:6"],"lines":["139-40. <b>Sīsaṃnhātā</b>ti sasīsaṃ nhātā.","<b>Adhimattan</b>ti adhikataraṃ.","<b>Samalaṅkatatarā</b>ti sammā atisayena alaṅkatā.","“Adhimattā”ti vā pāṭho, ativiya mattā mānamadamattā, mānanissitāti attho.","<b>Tayā</b>ti bhotiyā.","<b>Sāmikena samantayī</b>ti sāmikena saddhiṃ allopasallāpavasena kathesi."],"lineRefs":[["pv15:6"],["pv15:6"],["pv15:6"],["pv15:6"],["pv15:6"],["pv15:6"]]},{"para":794,"vripara":"142-144","refs":["pv15:9"],"lines":["142-144. <b>Khajjasi kacchuyā</b>ti kacchurogena khādīyasi, bādhīyasīti attho.","<b>Bhesajjahārī</b>ti bhesajjahāriniyo osadhahārikāyo.","<b>Ubhayo</b>ti duve, tvañca ahañcāti attho.","<b>Vanantan</b>ti vanaṃ.","<b>Tvañca bhesajjamāharī</b>ti tvaṃ vejjehi vuttaṃ attano upakārāvahaṃ bhesajjaṃ āhari.","<b>Ahañca kapikacchuno</b>ti ahaṃ pana kapikacchuphalāni duphassaphalāni āhariṃ.","<b>Kapikacchū</b>ti vā sayaṃbhūtā vuccati, tasmā sayaṃbhūtāya pattaphalāni āharinti attho.","<b>Seyyaṃ tyāhaṃ samokirin</b>ti tava seyyaṃ ahaṃ kapikacchuphalapattehi samantato avakiriṃ."],"lineRefs":[["pv15:9"],["pv15:9"],["pv15:9"],["pv15:9"],["pv15:9"],["pv15:9"],["pv15:9"],["pv15:9"]]},{"para":795,"vripara":"146-147","refs":["pv15:13"],"lines":["146-147. <b>Sahāyānan</b>ti mittānaṃ.","<b>Samayo</b>ti samāgamo.","<b>Ñātīnan</b>ti bandhūnaṃ.","<b>Samitī</b>ti sannipāto.","<b>Āmantitā</b>ti maṅgalakiriyāvasena nimantitā.","<b>Sasāminī</b>ti sabhattikā, saha bhattunāti attho.","<b>No ca khohan</b>ti no ca kho ahaṃ āmantitā āsinti yojanā.","<b>Dussaṃ tyāhan</b>ti dussaṃ te ahaṃ.","<b>Apānudin</b>ti corikāya avahariṃ aggahosiṃ."],"lineRefs":[["pv15:13"],["pv15:13"],["pv15:13"],["pv15:13"],["pv15:13"],["pv15:13"],["pv15:13"],["pv15:13"],["pv15:13"]]},{"para":796,"vripara":"149","refs":["pv15:16"],"lines":["<b>Paccagghan</b>ti abhinavaṃ, mahagghaṃ vā.","<b>Atāresin</b>ti khipiṃ.","<b>Gūthagandhinī</b>ti gūthagandhagandhinī karīsavāyinī."],"lineRefs":[["pv15:16"],["pv15:16"],["pv15:16"]]},{"para":797,"vripara":"151","refs":["pv15:18"],"lines":["<b>Yaṃ gehe vijjate dhanan</b>ti yaṃ gehe dhanaṃ upalabbhati, taṃ tuyhaṃ mayhañcāti amhākaṃ ubhinna samakaṃ tulyameva āsi.","<b>Santesū</b>ti vijjamānesu.","<b>Dīpan</b>ti patiṭṭhaṃ, puññakammaṃ sandhāya vadati."],"lineRefs":[["pv15:18"],["pv15:18"],["pv15:18"]]},{"para":798,"vripara":"152","refs":["pv15:19"],"lines":["Evaṃ sā petī tissāya pucchitamatthaṃ katthetvā puna pubbe tassā vacanaṃ akatvā attanā kataṃ aparādhaṃ pakāsentī <b>“tadeva maṃ tvan”</b>tiādimāha.","Tattha <b>tadevā</b>ti tadā eva, mayhaṃ manussattabhāve ṭhitakāleyeva.","Tathevāti vā pāṭho, yathā etarahi jātaṃ, taṃ tathā evāti attho.","<b>Man</b>ti attānaṃ niddisati, <b>tvan</b>ti tissaṃ.","<b>Avacā</b>ti abhaṇi.","Yathā pana avaca, taṃ dassetuṃ <b>“pāpakamman”</b>tiādi vuttaṃ.","“Pāpakammānī”ti pāḷi.","“Tvaṃ pāpakammāniyeva karosi, pāpehi pana kammehi sugati sulabhā na hoti, atha kho duggati eva sulabhā”ti yathā maṃ tvaṃ pubbe avaca ovadi, taṃ tathevāti vadati."],"lineRefs":[["pv15:19"],["pv15:19"],["pv15:19"],["pv15:19"],["pv15:19"],["pv15:19"],["pv15:19"],["pv15:19"]]},{"para":799,"vripara":"153","refs":["pv15:20"],"lines":["Taṃ sutvā tissā <b>“vāmato maṃ tvaṃ paccesī”</b>tiādinā tisso gāthā āha.","Tattha <b>vāmato maṃ tvaṃ paccesī</b>ti vilomato maṃ tvaṃ adhigacchasi, tuyhaṃ hitesimpi vipaccanīkakāriniṃ katvā maṃ gaṇhāsi.","<b>Maṃ usūyasī</b>ti mayhaṃ usūyasi, mayi issaṃ karosi.","<b>Passa pāpānaṃ kammānaṃ, vipāko hoti yādiso</b>ti pāpakānaṃ nāma kammānaṃ vipāko yādiso yathā ghorataro, taṃ paccakkhato passāti vadati."],"lineRefs":[["pv15:20"],["pv15:20"],["pv15:20"],["pv15:20"]]},{"para":800,"vripara":"154","refs":["pv15:21"],"lines":["<b>Te aññe paricārentī</b>ti te ghare dāsiyo ābharaṇāni ca imāni tayā pubbe pariggahitāni idāni aññe paricārenti paribhuñjanti.","“Ime”ti hi liṅgavipallāsena vuttaṃ.","<b>Na bhogā honti sassatā</b>ti bhogā nāmete na sassatā anavaṭṭhitā tāvakālikā mahāyagamanīyā, tasmā tadatthaṃ issāmacchariyādīni na kattabbānīti adhippāyo."],"lineRefs":[["pv15:21"],["pv15:21"],["pv15:21"]]},{"para":801,"vripara":"155","refs":["pv15:22"],"lines":["<b>Idāni bhūtassa pitā</b>ti idāneva bhūtassa mayhaṃ puttassa pitā kuṭumbiko.","<b>Āpaṇā</b>ti āpaṇato imaṃ <b>gehaṃ ehiti</b> āgamissati.","<b>Appeva te dade kiñcī</b>ti gehaṃ āgato kuṭumbiko tuyhaṃ dātabbayuttakaṃ kiñci deyyadhammaṃ api nāma dadeyya.","<b>Mā su tāva ito agā</b>ti ito gehassa pacchā vatthuto mā tāva agamāsīti taṃ anukampamānā āha."],"lineRefs":[["pv15:22"],["pv15:22"],["pv15:22"],["pv15:22"]]},{"para":802,"vripara":"156","refs":["pv15:23"],"lines":["Taṃ sutvā petī attano ajjhāsayaṃ pakāsentī <b>“naggā dubbaṇṇarūpāmhī”</b>ti gāthamāha.","Tattha <b>kopīnametaṃ itthīnan</b>ti etaṃ naggadubbaṇṇatādikaṃ paṭicchādetabbatāya itthīnaṃ kopīnaṃ rundhanīyaṃ.","<b>Mā maṃ bhūtapitāddasā</b>ti tasmā bhūtassa pitā kuṭumbiko maṃ mā addakkhīti lajjamānā vadati."],"lineRefs":[["pv15:23"],["pv15:23"],["pv15:23"]]},{"para":803,"vripara":"157","refs":["pv15:24"],"lines":["Taṃ sutvā tissā sañjātanuddayā <b>“handa kiṃ vā tyāhaṃ dammī”</b>ti gāthamāha.","Tattha <b>handā</b>ti codanatthe nipāto.","<b>Kiṃ vā tyāhaṃ dammī</b>ti kiṃ te ahaṃ dammi, kiṃ vatthaṃ dassāmi, udāhu bhattanti.","<b>Kiṃ vā tedha karomahan</b>ti kiṃ vā aññaṃ te idha imasmiṃ kāle upakāraṃ karissāmi."],"lineRefs":[["pv15:24"],["pv15:24"],["pv15:24"],["pv15:24"]]},{"para":804,"vripara":"158","refs":["pv15:25"],"lines":["Taṃ sutvā petī <b>“cattāro bhikkhū saṅghato”</b>ti gāthamāha.","Tattha <b>cattāro bhikkhū saṅghato, cattāro pana puggale</b>ti bhikkhusaṅghato saṅghavasena cattāro bhikkhū, puggalavasena cattāro bhikkhūti evaṃ aṭṭha bhikkhū yathāruciṃ bhojetvā taṃ dakkhiṇaṃ mama ādisa, mayhaṃ pattidānaṃ dehi.","<b>Tadāhaṃ sukhitā hessan</b>ti yadā tvaṃ dakkhiṇaṃ mama uddisissasi, tadā ahaṃ sukhitā sukhappattā sabbakāmasamiddhinī bhavissāmīti attho."],"lineRefs":[["pv15:25"],["pv15:25"],["pv15:25"]]},{"para":805,"vripara":"159-161","refs":["pv15:25","pv15:26"],"lines":["159-161. Taṃ sutvā tissā tamatthaṃ attano sāmikassa ārocetvā dutiyadivase aṭṭha bhikkhū bhojetvā tassā dakkhiṇamādisi, sā tāvadeva paṭiladdhadibbasampattikā puna tissāya santikaṃ upasaṅkami.","Tamatthaṃ dassetuṃ saṅgītikārehi <b>“sādhūti sā paṭissutvā”</b>tiādikā tisso gāthā ṭhapitā."],"lineRefs":[["pv15:25"],["pv15:26"]]},{"para":806,"vripara":"162-167","refs":["pv15:29"],"lines":["162-167. Upasaṅkamitvā ṭhitaṃ pana naṃ tissā <b>“abhikkantena vaṇṇenā”</b>tiādīhi tīhi gāthāhi paṭipucchi.","Itarā <b>“ahaṃ mattā”</b>ti gāthāya attānaṃ ācikkhitvā <b>“ciraṃ jīvāhī”</b>ti gāthāya tassā anumodanaṃ datvā <b>“idha dhammaṃ caritvānā”</b>ti gāthāya ovādaṃ adāsi.","Tattha <b>tava dinnenā</b>ti tayā dinnena.","<b>Asokaṃ virajaṃ ṭhānan</b>ti sokābhāvena asokaṃ, sedajallikānaṃ pana abhāvena virajaṃ dibbaṭṭhānaṃ, sabbametaṃ devalokaṃ sandhāya vadati.","<b>Āvāsan</b>ti ṭhānaṃ.","<b>Vasavattinan</b>ti dibbena ādhipateyyena attano vasaṃ vattentānaṃ.","<b>Samūlan</b>ti salobhadosaṃ.","Lobhadosā hi macchariyassa mūlaṃ nāma.","<b>Aninditā</b>ti agarahitā pāsaṃsā, <b>saggamupehi ṭhānan</b>ti rūpādīhi visayehi suṭṭhu aggattā “saggan”ti laddhanāmaṃ dibbaṭṭhānaṃ upehi, sugatiparāyaṇā hohīti attho.","Sesaṃ uttānameva."],"lineRefs":[["pv15:29"],["pv15:29"],["pv15:29"],["pv15:29"],["pv15:29"],["pv15:29"],["pv15:29"],["pv15:29"],["pv15:29"],["pv15:29"]]}],"wordLinks":[["pv15:5.1","sabbaṃ ahampi jānāmi yathā tvaṃ caṇḍikā ahū",0,0],["pv15:5.3","aññañca kho taṃ pucchāmī",0,1],["pv15:5.3","kenāsi paṃsukunthitā",0,2],["pv15:6.1","sīsaṃnhātā",1,0],["pv15:6.3","adhimattaṃ",1,1],["pv15:6.3","samalaṅkatatarā",1,2],["pv15:6.3","tayā",1,4],["pv15:9.3","khajjasi kacchuyā",2,0],["pv15:13.1","sahāyānaṃ",3,0],["pv15:13.1","samayo",3,1],["pv15:13.1","ñātīnaṃ",3,2],["pv15:13.1","samitī",3,3],["pv15:13.3","āmantitā",3,4],["pv15:13.3","sasāminī",3,5],["pv15:16.1","paccagghaṃ",4,0],["pv15:16.5","gūthagandhinī",4,2],["pv15:18.1","yaṃ gehe vijjate dhanaṃ",5,0],["pv15:18.3","santesū",5,1],["pv15:18.3","dīpaṃ",5,2],["pv15:19.1","tadeva maṃ tvaṃ",6,0],["pv15:19.1","tadevā",6,1],["pv15:19.1","maṃ",6,3],["pv15:19.1","tvaṃ",6,3],["pv15:19.1","avacā",6,4],["pv15:19.1","pāpakammaṃ",6,5],["pv15:20.1","vāmato maṃ tvaṃ paccesī",7,0],["pv15:20.1","vāmato maṃ tvaṃ paccesī",7,1],["pv15:20.1","maṃ usūyasī",7,2],["pv15:20.3","passa pāpānaṃ kammānaṃ vipāko hoti yādiso",7,3],["pv15:21.3","te aññe paricārentī",8,0],["pv15:21.3","na bhogā honti sassatā",8,2],["pv15:22.1","idāni bhūtassa pitā",9,0],["pv15:22.1","āpaṇā",9,1],["pv15:22.3","appeva te dade kiñcī",9,2],["pv15:22.3","mā su tāva ito agā",9,3],["pv15:23.1","naggā dubbaṇṇarūpāmhī",10,0],["pv15:23.3","kopīnametaṃ itthīnaṃ",10,1],["pv15:23.3","mā maṃ bhūtapitāddasā",10,2],["pv15:24.1","handa kiṃ vā tyāhaṃ dammī",11,0],["pv15:24.1","handā",11,1],["pv15:24.1","kiṃ vā tyāhaṃ dammī",11,2],["pv15:24.1","kiṃ vā tedha karomahaṃ",11,3],["pv15:25.1","cattāro bhikkhū saṅghato",12,0],["pv15:25.1","cattāro bhikkhū saṅghato cattāro pana puggale",12,1],["pv15:25.5","tadāhaṃ sukhitā hessaṃ",12,2],["pv15:26.1","sādhūti sā paṭissutvā",13,1],["pv15:29.1","abhikkantena vaṇṇenā",14,0]],"before":[{"para":678,"vripara":null,"refs":[],"lines":["Sāriputtattheramātupetivatthuvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":679,"vripara":null,"refs":[],"lines":["Mattāpetivatthuvaṇṇanā"],"lineRefs":[[]]},{"para":680,"vripara":null,"refs":[],"lines":["<b>Naggā dubbaṇṇarūpāsī</b>ti idaṃ satthari jetavane viharante mattaṃ nāma petiṃ ārabbha vuttaṃ.","Sāvatthiyaṃ kira aññataro kuṭumbiko saddho pasanno ahosi.","Tassa bhariyā assaddhā appasannā kodhanā vañjhā ca ahosi nāmena mattā nāma.","Atha so kuṭumbiko kulavaṃsūpacchedanabhayena sadisakulato tissaṃ nāma aññaṃ kaññaṃ ānesi.","Sā ahosi saddhā pasannā sāmino ca piyā manāpā, sā nacirasseva gabbhinī hutvā dasamāsaccayena puttaṃ vijāyi,“bhūto” tissa nāmaṃ ahosi.","Sā gehassāminī hutvā cattāro bhikkhū sakkaccaṃ upaṭṭhahi, vañjhā pana taṃ usūyati."],"lineRefs":[[],[],[],[],[],[]]},{"para":681,"vripara":null,"refs":[],"lines":["Tā ubhopi ekasmiṃ divase sīsaṃ nhatvā allakesā aṭṭhaṃsu, kuṭumbiko guṇavasena tissāya ābaddhasineho manuññena hadayena tāya saddhiṃ bahuṃ sallapanto aṭṭhāsi.","Taṃ asahamānā mattā issāpakatā gehe sammajjitvā ṭhapitaṃ saṅkāraṃ tissāya matthake okiri.","Sā aparena samayena kālaṃ katvā petayoniyaṃ nibbattitvā attano kammabalena pañcavidhaṃ dukkhaṃ anubhavati.","Taṃ pana dukkhaṃ pāḷito eva viññāyati.","Athekadivasaṃ sā petī sañjhāya vītivattāya gehassa piṭṭhipasse nhāyantiyā tissāya attānaṃ dassesi.","Taṃ disvā tissā –"],"lineRefs":[[],[],[],[],[],[]]},{"para":683,"vripara":"134","refs":[],"lines":["“Naggā dubbaṇṇarūpāsi, kisā dhamanisanthatā;"],"lineRefs":[[]]},{"para":684,"vripara":null,"refs":[],"lines":["Upphāsulike kisike, kā nu tvaṃ idha tiṭṭhasī”ti.","–"],"lineRefs":[[],[]]},{"para":685,"vripara":null,"refs":[],"lines":["Gāthāya paṭipucchi.","Itarā –"],"lineRefs":[[],[]]},{"para":687,"vripara":"135","refs":[],"lines":["“Ahaṃ mattā tuvaṃ tissā, sapattī te pure ahuṃ;"],"lineRefs":[[]]},{"para":688,"vripara":null,"refs":[],"lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gatā”ti.","–"],"lineRefs":[[],[]]},{"para":689,"vripara":null,"refs":[],"lines":["Gāthāya paṭivacanaṃ adāsi.","Tattha <b>ahaṃ mattā tuvaṃ tissā</b>ti ahaṃ mattā nāma, tuvaṃ tissā nāma.","<b>Pure</b>ti purimattabhāve.","<b>Te</b>ti tuyhaṃ sapattī ahuṃ, ahosinti attho.","Puna tissā –"],"lineRefs":[[],[],[],[],[]]},{"para":691,"vripara":"136","refs":[],"lines":["“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;"],"lineRefs":[[]]},{"para":692,"vripara":null,"refs":[],"lines":["Kissakammavipākena, petalokaṃ ito gatā”ti.","–"],"lineRefs":[[],[]]},{"para":693,"vripara":null,"refs":[],"lines":["Gāthāya katakammaṃ pucchi.","Puna itarā –"],"lineRefs":[[],[]]},{"para":695,"vripara":"137","refs":[],"lines":["“Caṇḍī ca pharusā cāsiṃ, issukī maccharī saṭhā;"],"lineRefs":[[]]},{"para":696,"vripara":null,"refs":[],"lines":["Tāhaṃ duruttaṃ vatvāna, petalokaṃ ito gatā”ti.","–"],"lineRefs":[[],[]]},{"para":697,"vripara":null,"refs":[],"lines":["Gāthāya attanā katakammaṃ ācikkhi.","Tattha <b>caṇḍī</b>ti kodhanā.","<b>Pharusā</b>ti pharusavacanā.","<b>Āsin</b>ti ahosiṃ.","<b>Tāhan</b>ti taṃ ahaṃ.","<b>Duruttan</b>ti dubbhāsitaṃ niratthakavacanaṃ.","Ito parampi tāsaṃ vacanapaṭivacanavaseneva gāthā pavattā –"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":699,"vripara":"138","refs":[],"lines":["“Sabbaṃ ahampi jānāmi, yathā tvaṃ caṇḍikā ahu;"],"lineRefs":[[]]},{"para":700,"vripara":null,"refs":[],"lines":["Aññañca kho taṃ pucchāmi, kenāsi paṃsukunthitā."],"lineRefs":[[]]},{"para":702,"vripara":"139","refs":[],"lines":["“Sīsaṃnhātā tuvaṃ āsi, sucivatthā alaṅkatā;"],"lineRefs":[[]]},{"para":703,"vripara":null,"refs":[],"lines":["Ahañca kho adhimattaṃ, samalaṅkatatarā tayā."],"lineRefs":[[]]},{"para":705,"vripara":"140","refs":[],"lines":["“Tassā me pekkhamānāya, sāmikena samantayi;"],"lineRefs":[[]]},{"para":706,"vripara":null,"refs":[],"lines":["Tato me issā vipulā, kodho me samajāyatha."],"lineRefs":[[]]},{"para":708,"vripara":"141","refs":[],"lines":["“Tato paṃsuṃ gahetvāna, paṃsunā tañhi okiriṃ;"],"lineRefs":[[]]},{"para":709,"vripara":null,"refs":[],"lines":["Tassakammavipākena, tenamhi paṃsukunthitā."],"lineRefs":[[]]},{"para":711,"vripara":"142","refs":[],"lines":["“Sabbaṃ ahampi jānāmi, paṃsunā maṃ tvamokiri;"],"lineRefs":[[]]},{"para":712,"vripara":null,"refs":[],"lines":["Aññañca kho taṃ pucchāmi, kena khajjasi kacchuyā."],"lineRefs":[[]]},{"para":714,"vripara":"143","refs":[],"lines":["“Bhesajjahārī ubhayo, vanantaṃ agamimhase;"],"lineRefs":[[]]},{"para":715,"vripara":null,"refs":[],"lines":["Tvañca bhesajjamāhari, ahañca kapikacchuno."],"lineRefs":[[]]},{"para":717,"vripara":"144","refs":[],"lines":["“Tassā tyājānamānāya, seyyaṃ tyāhaṃ samokiriṃ;"],"lineRefs":[[]]},{"para":718,"vripara":null,"refs":[],"lines":["Tassakammavipākena, tena khajjāmi kacchuyā."],"lineRefs":[[]]},{"para":720,"vripara":"145","refs":[],"lines":["“Sabbaṃ ahampi jānāmi, seyyaṃ me tvaṃ samokiri;"],"lineRefs":[[]]},{"para":721,"vripara":null,"refs":[],"lines":["Aññañca kho taṃ pucchāmi, kenāsi naggiyā tuvaṃ."],"lineRefs":[[]]},{"para":723,"vripara":"146","refs":[],"lines":["“Sahāyānaṃ samayo āsi, ñātīnaṃ samitī ahu;"],"lineRefs":[[]]},{"para":724,"vripara":null,"refs":[],"lines":["Tvañca āmantitā āsi, sasāminī no ca khohaṃ."],"lineRefs":[[]]},{"para":726,"vripara":"147","refs":[],"lines":["“Tassā tyājānamānāya, dussaṃ tyāhaṃ apānudiṃ;"],"lineRefs":[[]]},{"para":727,"vripara":null,"refs":[],"lines":["Tassakammavipākena, tenamhi naggiyā ahaṃ."],"lineRefs":[[]]},{"para":729,"vripara":"148","refs":[],"lines":["“Sabbaṃ ahampi jānāmi, dussaṃ me tvaṃ apānudi;"],"lineRefs":[[]]},{"para":730,"vripara":null,"refs":[],"lines":["Aññañca kho taṃ pucchāmi, kenāsi gūthagandhinī."],"lineRefs":[[]]},{"para":732,"vripara":"149","refs":[],"lines":["“Tava gandhañca mālañca, paccagghañca vilepanaṃ;"],"lineRefs":[[]]},{"para":733,"vripara":null,"refs":[],"lines":["Gūthakūpe atāresiṃ, taṃ pāpaṃ pakataṃ mayā;"],"lineRefs":[[]]},{"para":734,"vripara":null,"refs":[],"lines":["Tassakammavipākena, tenamhi gūthagandhinī."],"lineRefs":[[]]},{"para":736,"vripara":"150","refs":[],"lines":["“Sabbaṃ ahampi jānāmi, taṃ pāpaṃ pakataṃ tayā;"],"lineRefs":[[]]},{"para":737,"vripara":null,"refs":[],"lines":["Aññañca kho taṃ pucchāmi, kenāsi duggatā tuvaṃ."],"lineRefs":[[]]},{"para":739,"vripara":"151","refs":[],"lines":["“Ubhinnaṃ samakaṃ āsi, yaṃ gehe vijjate dhanaṃ;"],"lineRefs":[[]]},{"para":740,"vripara":null,"refs":[],"lines":["Santesu deyyadhammesu, dīpaṃ nākāsimattano;"],"lineRefs":[[]]},{"para":741,"vripara":null,"refs":[],"lines":["Tassakammavipākena, tenamhi duggatā ahaṃ."],"lineRefs":[[]]},{"para":743,"vripara":"152","refs":[],"lines":["“Tadeva maṃ tvaṃ avaca, pāpakammaṃ nisevasi;"],"lineRefs":[[]]},{"para":744,"vripara":null,"refs":[],"lines":["Na hi pāpehi kammehi, sulabhā hoti suggati."],"lineRefs":[[]]},{"para":746,"vripara":"153","refs":[],"lines":["“Vāmato maṃ tvaṃ paccesi, athopi maṃ usūyasi;"],"lineRefs":[[]]},{"para":747,"vripara":null,"refs":[],"lines":["Passa pāpānaṃ kammānaṃ, vipāko hoti yādiso."],"lineRefs":[[]]},{"para":749,"vripara":"154","refs":[],"lines":["“Te gharā tā ca dāsiyo, tānevābharaṇānime;"],"lineRefs":[[]]},{"para":750,"vripara":null,"refs":[],"lines":["Te aññe paricārenti, na bhogā honti sassatā."],"lineRefs":[[]]},{"para":752,"vripara":"155","refs":[],"lines":["“Idāni bhūtassa pitā, āpaṇā gehamehiti;"],"lineRefs":[[]]},{"para":753,"vripara":null,"refs":[],"lines":["Appeva te dade kiñci, mā su tāva ito agā."],"lineRefs":[[]]},{"para":755,"vripara":"156","refs":[],"lines":["“Naggā dubbaṇṇarūpāmhi, kisā dhamanisanthatā;"],"lineRefs":[[]]},{"para":756,"vripara":null,"refs":[],"lines":["Kopīnametaṃ itthīnaṃ, mā maṃ bhūtapitāddasa."],"lineRefs":[[]]},{"para":758,"vripara":"157","refs":[],"lines":["“Handa kiṃ vā tyāhaṃ dammi, kiṃ vā teca karomahaṃ;"],"lineRefs":[[]]},{"para":759,"vripara":null,"refs":[],"lines":["Yena tvaṃ sukhitā assa, sabbakāmasamiddhinī."],"lineRefs":[[]]},{"para":761,"vripara":"158","refs":[],"lines":["“Cattāro bhikkhū saṅghato, cattāro pana puggale;"],"lineRefs":[[]]},{"para":762,"vripara":null,"refs":[],"lines":["Aṭṭha bhikkhū bhojayitvā, mama dakkhiṇamādisa;"],"lineRefs":[[]]},{"para":763,"vripara":null,"refs":[],"lines":["Tadāhaṃ sukhitā hessaṃ, sabbakāmasamiddhinī."],"lineRefs":[[]]},{"para":765,"vripara":"159","refs":[],"lines":["“Sādhūti sā paṭissutvā, bhojayitvāṭṭha bhikkhavo;"],"lineRefs":[[]]},{"para":766,"vripara":null,"refs":[],"lines":["Vatthehacchādayitvāna, tassā dakkhiṇamādisī."],"lineRefs":[[]]},{"para":768,"vripara":"160","refs":[],"lines":["“Samanantarānuddiṭṭhe, vipāko udapajjatha;"],"lineRefs":[[]]},{"para":769,"vripara":null,"refs":[],"lines":["Bhojanacchādanapānīyaṃ, dakkhiṇāya idaṃ phalaṃ."],"lineRefs":[[]]},{"para":771,"vripara":"161","refs":[],"lines":["“Tato suddhā sucivasanā, kāsikuttamadhārinī;"],"lineRefs":[[]]},{"para":772,"vripara":null,"refs":[],"lines":["Vicittavatthābharaṇā, sapattiṃ upasaṅkami."],"lineRefs":[[]]},{"para":774,"vripara":"162","refs":[],"lines":["“Abhikkantena vaṇṇena, yā tvaṃ tiṭṭhasi devate;"],"lineRefs":[[]]},{"para":775,"vripara":null,"refs":[],"lines":["Obhāsentī disā sabbā, osadhī viya tārakā."],"lineRefs":[[]]},{"para":777,"vripara":"163","refs":[],"lines":["“Kena tetādiso vaṇṇo, kena te idha mijjhati;"],"lineRefs":[[]]},{"para":778,"vripara":null,"refs":[],"lines":["Uppajjanti ca te bhogā, ye keci manaso piyā."],"lineRefs":[[]]},{"para":780,"vripara":"164","refs":[],"lines":["“Pucchāmi taṃ devi mahānubhāve, manussabhūtā kimakāsī puññaṃ;"],"lineRefs":[[]]},{"para":781,"vripara":null,"refs":[],"lines":["Kenāsi evaṃ jalitānubhāvā, vaṇṇo ca te sabbadisā pabhāsatīti."],"lineRefs":[[]]},{"para":783,"vripara":"165","refs":[],"lines":["“Ahaṃ mattā tuvaṃ tissā, sapattī te pure ahuṃ;"],"lineRefs":[[]]},{"para":784,"vripara":null,"refs":[],"lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gatā."],"lineRefs":[[]]},{"para":786,"vripara":"166","refs":[],"lines":["“Tava dinnena dānena, modāmi akutobhayā;"],"lineRefs":[[]]},{"para":787,"vripara":null,"refs":[],"lines":["Ciraṃ jīvāhi bhagini, saha sabbehi ñātibhi;"],"lineRefs":[[]]},{"para":788,"vripara":null,"refs":[],"lines":["Asokaṃ virajaṃ ṭhānaṃ, āvāsaṃ vasavattinaṃ."],"lineRefs":[[]]},{"para":790,"vripara":"167","refs":[],"lines":["“Idha dhammaṃ caritvāna, dānaṃ datvāna sobhane;"],"lineRefs":[[]]},{"para":791,"vripara":null,"refs":[],"lines":["Vineyya maccheramalaṃ samūlaṃ, aninditā saggamupehi ṭhānan”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
