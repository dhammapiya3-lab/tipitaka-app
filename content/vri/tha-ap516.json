{"suttaId":"tha-ap516","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3252,3269],"vripara":"17"},"segments":{"tha-ap516:0.3":"Ketakapupphiyattheraapadānaṃ","tha-ap516:1.1":"“Vinatānadiyā tīre,","tha-ap516:1.2":"vihāsi purisuttamo;","tha-ap516:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap516:1.4":"ekaggaṃ susamāhitaṃ. 18.","tha-ap516:2.1":"“Madhugandhassa pupphena,","tha-ap516:2.2":"ketakassa ahaṃ tadā;","tha-ap516:2.3":"Pasannacitto sumano,","tha-ap516:2.4":"buddhaseṭṭhamapūjayiṃ. 19.","tha-ap516:3.1":"“Ekanavutito kappe,","tha-ap516:3.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap516:3.3":"Duggatiṃ nābhijānāmi,","tha-ap516:3.4":"buddhapūjāyidaṃ phalaṃ. 20.","tha-ap516:4.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap516:4.3":"viharāmi anāsavo. 21.","tha-ap516:5.1":"“Svāgataṃ vata me āsi…pe…","tha-ap516:5.3":"kataṃ buddhassa sāsanaṃ. 22.","tha-ap516:6.1":"“Paṭisambhidā catasso…pe…","tha-ap516:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap516:7.1":"Itthaṃ sudaṃ āyasmā ketakapupphiyo thero imā gāthāyo Abhāsitthāti.","tha-ap516:8.1":"Ketakapupphiyattherassāpadānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
