{"suttaId":"tha-ap516","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3252,3269],"vripara":"17"},"segments":{"tha-ap516:0.3":"Ketakapupphiyattheraapadānaṃ","tha-ap516:1.1":"“Vinatānadiyā tīre, vihāsi purisuttamo;","tha-ap516:1.3":"Addasaṃ virajaṃ buddhaṃ, ekaggaṃ susamāhitaṃ.","tha-ap516:2.1":"“Madhugandhassa pupphena, ketakassa ahaṃ tadā;","tha-ap516:2.3":"Pasannacitto sumano, buddhaseṭṭhamapūjayiṃ.","tha-ap516:3.1":"“Ekanavutito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap516:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap516:4.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap516:5.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap516:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap516:7.1":"Itthaṃ sudaṃ āyasmā ketakapupphiyo thero imā gāthāyo Abhāsitthāti.","tha-ap516:8.1":"Ketakapupphiyattherassāpadānaṃ catutthaṃ."},"attha":null,"tika":null,"tika2":null}
