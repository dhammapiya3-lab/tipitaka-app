{"suttaId":"an5.183","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1261,1261],"vripara":"183"},"segments":{"an5.183:0.3":"Rukkhamūlikasuttaṃ","an5.183:1.1":"“Pañcime, bhikkhave, rukkhamūlikā.","an5.183:1.2":"Katame pañca?","an5.183:1.3":"Mandattā momūhattā rukkhamūliko hoti…pe… idamatthitaṃyeva nissāya rukkhamūliko hoti.","an5.183:1.4":"Ime kho, bhikkhave, pañca rukkhamūlikā”ti.","an5.183:1.5":"Tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
