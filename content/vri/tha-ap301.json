{"suttaId":"tha-ap301","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9010,9019],"vripara":"40"},"segments":{"tha-ap301:0.3":"Ambapiṇḍiyattheraapadānaṃ","tha-ap301:1.1":"“Romaso nāma nāmena,","tha-ap301:1.2":"dānavo iti vissuto;","tha-ap301:1.3":"Ambapiṇḍī mayā dinnā [ambapiṇḍo mayā dinno (syā.)],","tha-ap301:1.4":"vipassissa mahesino.","tha-ap301:2.1":"“Ekanavutito kappe,","tha-ap301:2.2":"yamambamadadiṃ tadā;","tha-ap301:2.3":"Duggatiṃ nābhijānāmi,","tha-ap301:2.4":"ambadānassidaṃ phalaṃ.","tha-ap301:3.1":"“Paṭisambhidā catasso … pe …","tha-ap301:3.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap301:4.1":"Itthaṃ sudaṃ āyasmā ambapiṇḍiyo thero imā gāthāyo abhāsitthāti.","tha-ap301:5.1":"Ambapiṇḍiyattherassāpadānaṃ navamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
