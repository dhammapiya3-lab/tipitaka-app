{"suttaId":"bv7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[1243,1329],"vripara":"1"},"segments":{"bv7:0.2":"Revatabuddhavaṃso","bv7:1.1":"Sumanassa aparena,","bv7:1.2":"revato nāma nāyako;","bv7:1.3":"Anūpamo asadiso,","bv7:1.4":"atulo uttamo jino.","bv7:2.1":"Sopi dhammaṃ pakāsesi,","bv7:2.2":"brahmunā abhiyācito;","bv7:2.3":"Khandhadhātuvavatthānaṃ,","bv7:2.4":"appavattaṃ bhavābhave.","bv7:3.1":"Tassābhisamayā tīṇi,","bv7:3.2":"ahesuṃ dhammadesane;","bv7:3.3":"Gaṇanāya na vattabbo,","bv7:3.4":"paṭhamābhisamayo ahu.","bv7:4.1":"Yadā arindamaṃ rājaṃ [rājānaṃ (ka.)],","bv7:4.2":"vinesi revato muni;","bv7:4.3":"Tadā koṭisahassānaṃ,","bv7:4.4":"dutiyābhisamayo ahu.","bv7:5.1":"Sattāhaṃ paṭisallānā,","bv7:5.2":"vuṭṭhahitvā narāsabho;","bv7:5.3":"Koṭisataṃ naramarūnaṃ,","bv7:5.4":"vinesi uttame phale.","bv7:6.1":"Sannipātā tayo āsuṃ,","bv7:6.2":"revatassa mahesino;","bv7:6.3":"Khīṇāsavānaṃ vimalānaṃ,","bv7:6.4":"suvimuttāna tādinaṃ.","bv7:7.1":"Atikkantā gaṇanapathaṃ,","bv7:7.2":"paṭhamaṃ ye samāgatā;","bv7:7.3":"Koṭisatasahassānaṃ,","bv7:7.4":"dutiyo āsi samāgamo.","bv7:8.1":"Yopi [yo so (syā. kaṃ. ka.)] paññāya asamo,","bv7:8.2":"tassa cakkānuvattako;","bv7:8.3":"So tadā byādhito āsi,","bv7:8.4":"patto jīvitasaṃsayaṃ.","bv7:9.1":"Tassa gilānapucchāya,","bv7:9.2":"ye tadā upagatā munī;","bv7:9.3":"Koṭisahassā arahanto,","bv7:9.4":"tatiyo āsi samāgamo.","bv7:10.1":"Ahaṃ tena samayena,","bv7:10.2":"atidevo nāma brāhmaṇo;","bv7:10.3":"Upagantvā revataṃ buddhaṃ,","bv7:10.4":"saraṇaṃ tassa gañchahaṃ.","bv7:11.1":"Tassa sīlaṃ samādhiñca,","bv7:11.2":"paññāguṇamanuttamaṃ;","bv7:11.3":"Thomayitvā yathāthāmaṃ,","bv7:11.4":"uttarīyamadāsahaṃ.","bv7:12.1":"Sopi maṃ buddho byākāsi,","bv7:12.2":"revato lokanāyako;","bv7:12.3":"“Aparimeyyito kappe,","bv7:12.4":"ayaṃ buddho bhavissati.","bv7:13.1":"“Padhānaṃ padahitvāna … pe …","bv7:13.3":"hessāma sammukhā imaṃ”.","bv7:14.1":"Tassāpi vacanaṃ sutvā,","bv7:14.2":"bhiyyo cittaṃ pasādayiṃ;","bv7:14.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv7:14.4":"dasapāramipūriyā.","bv7:15.1":"Tadāpi taṃ buddhadhammaṃ,","bv7:15.2":"saritvā anubrūhayiṃ;","bv7:15.3":"Āharissāmi taṃ dhammaṃ,","bv7:15.4":"yaṃ mayhaṃ abhipatthitaṃ.","bv7:16.1":"Nagaraṃ sudhaññavatī nāma [sudhammakaṃ nāma (sī.), sudhaññakaṃ nāma (syā.)],","bv7:16.2":"vipulo nāma khattiyo;","bv7:16.3":"Vipulā nāma janikā,","bv7:16.4":"revatassa mahesino.","bv7:17.1":"Cha ca vassasahassāni [chabbassasahassāni (sī. syā.)],","bv7:17.2":"agāraṃ ajjha so vasi;","bv7:17.3":"Sudassano ratanagghi,","bv7:17.4":"āveḷo ca vibhūsito;","bv7:17.5":"Puññakammābhinibbattā,","bv7:17.6":"tayo pāsādamuttamā.","bv7:18.1":"Tettiṃsa ca sahassāni,","bv7:18.2":"nāriyo samalaṅkatā;","bv7:18.3":"Sudassanā nāma nārī,","bv7:18.4":"varuṇo nāma atrajo.","bv7:19.1":"Nimitte caturo disvā,","bv7:19.2":"rathayānena nikkhami;","bv7:19.3":"Anūnasattamāsāni,","bv7:19.4":"padhānaṃ padahī jino.","bv7:20.1":"Brahmunā yācito santo,","bv7:20.2":"revato lokanāyako;","bv7:20.3":"Vatti cakkaṃ mahāvīro,","bv7:20.4":"varuṇārāme sirīghare.","bv7:21.1":"Varuṇo brahmadevo ca,","bv7:21.2":"ahesuṃ aggasāvakā;","bv7:21.3":"Sambhavo nāmupaṭṭhāko,","bv7:21.4":"revatassa mahesino.","bv7:22.1":"Bhaddā ceva subhaddā ca,","bv7:22.2":"ahesuṃ aggasāvikā;","bv7:22.3":"Sopi buddho asamasamo,","bv7:22.4":"nāgamūle abujjhatha.","bv7:23.1":"Padumo kuñjaro ceva,","bv7:23.2":"ahesuṃ aggupaṭṭhikā;","bv7:23.3":"Sirīmā ceva yasavatī,","bv7:23.4":"ahesuṃ aggupaṭṭhikā.","bv7:24.1":"Uccattanena so buddho,","bv7:24.2":"asītihatthamuggato;","bv7:24.3":"Obhāseti disā sabbā,","bv7:24.4":"indaketuva uggato.","bv7:25.1":"Tassa sarīre nibbattā,","bv7:25.2":"pabhāmālā anuttarā;","bv7:25.3":"Divā vā yadi vā rattiṃ,","bv7:25.4":"samantā pharati yojanaṃ.","bv7:26.1":"Saṭṭhivassasahassāni,","bv7:26.2":"āyu vijjati tāvade;","bv7:26.3":"Tāvatā tiṭṭhamāno so,","bv7:26.4":"tāresi janataṃ bahuṃ.","bv7:27.1":"Dassayitvā buddhabalaṃ,","bv7:27.2":"amataṃ loke pakāsayaṃ;","bv7:27.3":"Nibbāyi anupādāno,","bv7:27.4":"yathaggupādānasaṅkhayā.","bv7:28.1":"So ca kāyo ratananibho,","bv7:28.2":"so ca dhammo asādiso;","bv7:28.3":"Sabbaṃ tamantarahitaṃ,","bv7:28.4":"nanu rittā sabbasaṅkhārā.","bv7:29.1":"Revato yasadharo buddho,","bv7:29.2":"nibbuto so mahāpure;","bv7:29.3":"Dhātuvitthārikaṃ āsi,","bv7:29.4":"tesu tesu padesatoti.","bv7:30.1":"Revatassa bhagavato vaṃso pañcamo."},"unsure":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":2092,"to":2175,"paras":[{"para":2092,"vripara":null,"refs":["bv7:2"],"lines":["Tattha <b>khandhadhātuvavatthānan</b>ti pañcannaṃ khandhānaṃ aṭṭhārasannaṃ dhātūnaṃ nāmarūpavavatthānādivasena vibhāgakaraṇaṃ.","Sabhāvalakkhaṇasāmaññalakkhaṇādivasena rūpārūpadhammapariggaho khandhadhātuvavatthānaṃ nāma.","Atha vā pheṇapiṇḍūpamaṃ rūpaṃ parimaddanāsahanato chiddāvachiddādibhāvato ca udakapubbuḷakaṃ viya vedanā muhuttaramaṇīyabhāvato, marīcikā viya saññā vippalambhanato, kadalikkhandho viya saṅkhārā asārakato, māyā viya viññāṇaṃ vañcanakato”ti evamādināpi nayena aniccānupassanādivasenapi khandhadhātuvavatthānaṃ veditabbaṃ (vibha. aṭṭha.26 kamādivinicchayakathā).","<b>Appavattaṃ bhavābhave</b>ti ettha bhavoti vaḍḍhi, abhavoti hāni.","Bhavoti sassatadiṭṭhi, abhavoti ucchedadiṭṭhi.","Bhavoti khuddakabhavo, abhavoti mahābhavo.","Bhavoti kāmabhavo, abhavoti rūpārūpabhavoti evamādinā nayena bhavābhavānaṃ attho veditabbo (ma. ni. aṭṭha.2.223; saṃ. ni. aṭṭha.3.5.1080; udā. aṭṭha.20).","Tesaṃ bhavābhavānaṃ appavattihetubhūtaṃ dhammaṃ pakāsesīti attho.","Atha vā bhavati anenāti bhavo, tīsu bhavesu uppattinimittaṃ kammādikaṃ.","Upapattibhavo abhavo nāma.","Ubhayattha nikantiyā pahānakaraṃ appavattaṃ dhammaṃ desesīti attho.","Tassa pana revatabuddhassa tayova abhisamayā ahesuṃ.","Paṭhamo panassa gaṇanapathaṃ vītivatto.","Tena vuttaṃ –"],"lineRefs":[["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"],["bv7:2"]]},{"para":2094,"vripara":"3","refs":["bv7:2"],"lines":["“Tassābhisamayā tīṇi, ahesuṃ dhammadesane;"],"lineRefs":[["bv7:2"]]},{"para":2095,"vripara":null,"refs":["bv7:2"],"lines":["Gaṇanāya na vattabbo, paṭhamābhisamayo ahū”ti."],"lineRefs":[["bv7:2"]]},{"para":2096,"vripara":null,"refs":["bv7:3"],"lines":["Tattha <b>tīṇī</b>ti tayo, liṅgavipallāso kato, ayaṃ paṭhamo abhisamayo ahosi."],"lineRefs":[["bv7:3"]]},{"para":2097,"vripara":null,"refs":["bv7:3"],"lines":["Athāparena samayena nagaruttare uttare nagare sabbārindamo arindamo nāma rājā ahosi.","So kira bhagavantaṃ attano nagaramanuppattaṃ sutvā tīhi janakoṭīhi parivuto bhagavato paccuggamanaṃ katvā svātanāya nimantetvā buddhappamukhassa bhikkhusaṅghassa sattāhaṃ mahādānaṃ pavattetvā tigāvutavitthataṃ dīpapūjaṃ katvā bhagavantaṃ upasaṅkamitvā nisīdi.","Atha bhagavā tassa manonukūlaṃ vicittanayaṃ dhammaṃ desesi.","Tattha devamanussānaṃ koṭisahassassa dutiyābhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"]]},{"para":2099,"vripara":"4","refs":["bv7:3"],"lines":["“Yadā arindamaṃ rājaṃ, vinesi revato muni;"],"lineRefs":[["bv7:3"]]},{"para":2100,"vripara":null,"refs":["bv7:3"],"lines":["Tadā koṭisahassānaṃ, dutiyābhisamayo ahū”ti."],"lineRefs":[["bv7:3"]]},{"para":2101,"vripara":null,"refs":["bv7:3"],"lines":["Ayaṃ dutiyo abhisamayo."],"lineRefs":[["bv7:3"]]},{"para":2102,"vripara":null,"refs":["bv7:3"],"lines":["Athāparena samayena revato satthā uttaranigamaṃ nāma upanissāya viharanto sattāhaṃ nirodhasamāpattiṃ samāpajjitvā nisīdi.","Tadā kira uttaranigamavāsino manussā yāgubhattakhajjakabhesajjapānakādīni āharitvā bhikkhusaṅghassa mahādānaṃ datvā bhikkhū paripucchiṃsu –","“kuhiṃ, bhante, bhagavā”ti?","Tato tesaṃ bhikkhū āhaṃsu –","“bhagavā, āvuso, nirodhasamāpattiṃ samāpanno”ti.","Athātīte tasmiṃ sattāhe bhagavantaṃ nirodhasamāpattito vuṭṭhitaṃ saradasamaye sūriyo viya attano anūpamāya buddhasiriyā virocamānaṃ disvā nirodhasamāpattiyā guṇānisaṃsaṃ pucchiṃsu.","Bhagavā ca tesaṃ nirodhasamāpattiyā guṇānisaṃsaṃ kathesi.","Tadā devamanussānaṃ koṭisataṃ arahatte patiṭṭhāsi.","Ayaṃ tatiyo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"]]},{"para":2104,"vripara":"5","refs":["bv7:3"],"lines":["“Sattāhaṃ paṭisallānā, vuṭṭhahitvā narāsabho;"],"lineRefs":[["bv7:3"]]},{"para":2105,"vripara":null,"refs":["bv7:3"],"lines":["Koṭisataṃ naramarūnaṃ, vinesi uttame phale”ti."],"lineRefs":[["bv7:3"]]},{"para":2106,"vripara":null,"refs":["bv7:3"],"lines":["Sudhaññavatīnagare paṭhamamahāpātimokkhuddese ehibhikkhupabbajjāya pabbajitānaṃ arahantānaṃ gaṇanapathaṃ vītivattānaṃ paṭhamo sannipāto ahosi.","Mekhalanagare koṭisatasahassasaṅkhātānaṃ ehibhikkhupabbajjāya pabbajitānaṃ arahantānaṃ dutiyo sannipāto ahosi.","Revatassa pana bhagavato dhammacakkānuvattako varuṇo nāma aggasāvako paññavantānaṃ aggo ābādhiko ahosi.","Tattha gilānapucchanatthāya sampattamahājanassa lakkhaṇattayaparidīpakaṃ dhammaṃ desetvā koṭisatasahassaṃ purisānaṃ ehibhikkhupabbajjāya pabbājetvā arahatte patiṭṭhāpetvā caturaṅginike sannipāte pātimokkhaṃ uddisi.","Ayaṃ tatiyo sannipāto ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"],["bv7:3"]]},{"para":2108,"vripara":"6","refs":["bv7:3"],"lines":["“Sannipātā tayo āsuṃ, revatassa mahesino;"],"lineRefs":[["bv7:3"]]},{"para":2109,"vripara":null,"refs":["bv7:3"],"lines":["Khīṇāsavānaṃ vimalānaṃ, suvimuttāna tādinaṃ."],"lineRefs":[["bv7:3"]]},{"para":2111,"vripara":"7","refs":["bv7:3"],"lines":["“Atikkantā gaṇanapathaṃ, paṭhamaṃ ye samāgatā;"],"lineRefs":[["bv7:3"]]},{"para":2112,"vripara":null,"refs":["bv7:3"],"lines":["Koṭisatasahassānaṃ, dutiyo āsi samāgamo."],"lineRefs":[["bv7:3"]]},{"para":2114,"vripara":"8","refs":["bv7:3"],"lines":["“Yopi paññāya asamo, tassa cakkānuvattako;"],"lineRefs":[["bv7:3"]]},{"para":2115,"vripara":null,"refs":["bv7:3"],"lines":["So tadā byādhito āsi, patto jīvitasaṃsayaṃ."],"lineRefs":[["bv7:3"]]},{"para":2117,"vripara":"9","refs":["bv7:3"],"lines":["“Tassa gilānapucchāya, ye tadā upagatā munī;"],"lineRefs":[["bv7:3"]]},{"para":2118,"vripara":null,"refs":["bv7:3"],"lines":["Koṭisatasahassā arahanto, tatiyo āsi samāgamo”ti."],"lineRefs":[["bv7:3"]]},{"para":2119,"vripara":null,"refs":["bv7:3","bv7:9"],"lines":["Tattha <b>cakkānuvattako</b>ti dhammacakkānuvattako.","<b>Patto jīvitasaṃsayan</b>ti ettha jīvite saṃsayaṃ jīvitasaṃsayaṃ, jīvitakkhayaṃ pāpuṇāti vā, na vā pāpuṇātīti evaṃ jīvitasaṃsayaṃ patto, byādhitassa balavabhāvena marati, na maratīti jīvite saṃsayaṃ pattoti attho.","<b>Ye tadā upagatā munī</b>ti iti dīghabhāve sati bhikkhūnaṃ upari hoti, rasse anussarena saddhiṃ varuṇassa upari hoti."],"lineRefs":[["bv7:3"],["bv7:3"],["bv7:9"]]},{"para":2120,"vripara":null,"refs":["bv7:9"],"lines":["Tadā amhākaṃ bodhisatto rammavatīnagare atidevo nāma brāhmaṇo hutvā brāhmaṇadhamme pāraṃ gato revataṃ sammāsambuddhaṃ disvā tassa dhammakathaṃ sutvā saraṇesu patiṭṭhāya silokasahassena dasabalaṃ kittetvā sahassagghanikena uttarāsaṅgena bhagavantaṃ pūjesi.","Sopi naṃ buddho byākāsi –","“ito kappasatasahassādhikānaṃ dvinnaṃ asaṅkhyeyyānaṃ matthake gotamo nāma buddho bhavissatī”ti.","Tena vuttaṃ –"],"lineRefs":[["bv7:9"],["bv7:9"],["bv7:9"],["bv7:9"]]},{"para":2122,"vripara":"10","refs":["bv7:9"],"lines":["“Ahaṃ tena samayena, atidevo nāma brāhmaṇo;"],"lineRefs":[["bv7:9"]]},{"para":2123,"vripara":null,"refs":["bv7:9"],"lines":["Upagantvā revataṃ buddhaṃ, saraṇaṃ tassa gañchahaṃ."],"lineRefs":[["bv7:9"]]},{"para":2125,"vripara":"11","refs":["bv7:9"],"lines":["“Tassa sīlaṃ samādhiñca, paññāguṇamanuttamaṃ;"],"lineRefs":[["bv7:9"]]},{"para":2126,"vripara":null,"refs":["bv7:9"],"lines":["Thomayitvā yathāthāmaṃ, uttarīyamadāsahaṃ."],"lineRefs":[["bv7:9"]]},{"para":2128,"vripara":"12","refs":["bv7:9"],"lines":["“Sopi maṃ buddho byākāsi, revato lokanāyako;"],"lineRefs":[["bv7:9"]]},{"para":2129,"vripara":null,"refs":["bv7:9"],"lines":["Aparimeyyito kappe, ayaṃ buddho bhavissati."],"lineRefs":[["bv7:9"]]},{"para":2131,"vripara":"13","refs":["bv7:9"],"lines":["‘Padhānaṃ padahitvāna … pe … hessāma sammukhā iman’”ti.","–"],"lineRefs":[["bv7:9"],["bv7:9"]]},{"para":2132,"vripara":null,"refs":["bv7:9"],"lines":["Aṭṭha gāthā vitthāretabbā."],"lineRefs":[["bv7:9"]]},{"para":2134,"vripara":"14","refs":["bv7:9"],"lines":["“Tassāpi vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[["bv7:9"]]},{"para":2135,"vripara":null,"refs":["bv7:9"],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā."],"lineRefs":[["bv7:9"]]},{"para":2137,"vripara":"15","refs":["bv7:9"],"lines":["“Tadāpi taṃ buddhadhammaṃ, saritvā anubrūhayiṃ;"],"lineRefs":[["bv7:9"]]},{"para":2138,"vripara":null,"refs":["bv7:9"],"lines":["Āharissāmi taṃ dhammaṃ, yaṃ mayhaṃ abhipatthitan”ti."],"lineRefs":[["bv7:9"]]},{"para":2139,"vripara":null,"refs":["bv7:9","bv7:15"],"lines":["Tattha <b>saraṇaṃ tassa gañchahan</b>ti taṃ saraṇaṃ agañchiṃ ahaṃ, upayogatthe sāmivacanaṃ.","<b>Paññāguṇan</b>ti paññāsampattiṃ.","<b>Anuttaman</b>ti seṭṭhaṃ.","“Paññāvimuttiguṇamuttaman” tipi pāṭho, so uttānova.","<b>Thomayitvā</b>ti thometvā vaṇṇayitvā.","Yathāthāmanti yathābalaṃ.","<b>Uttarīyan</b>ti uttarāsaṅgaṃ.","<b>Adāsahan</b>ti adāsiṃ ahaṃ.","<b>Buddhadhamman</b>ti buddhabhāvakaraṃ dhammaṃ, pāramīdhammanti attho.","<b>Saritvā</b>ti anussaritvā.","<b>Anubrūhayin</b>ti abhivaḍḍhesiṃ.","<b>Āharissāmī</b>ti ānayissāmi.","<b>Taṃ dhamman</b>ti taṃ buddhattaṃ.","<b>Yaṃ mayhaṃ abhipatthitan</b>ti yaṃ mayā abhipatthitaṃ buddhattaṃ, taṃ āharissāmīti attho."],"lineRefs":[["bv7:9"],["bv7:9"],["bv7:9"],["bv7:9"],["bv7:9"],["bv7:9"],["bv7:9"],["bv7:9"],["bv7:15"],["bv7:15"],["bv7:15"],["bv7:15"],["bv7:15"],["bv7:15"]]},{"para":2140,"vripara":null,"refs":["bv7:15"],"lines":["Tassa pana <b>revatassa</b> bhagavato nagaraṃ sudhaññavatī nāma ahosi, pitā vipulo nāma khattiyo, mātā vipulā nāma, varuṇo ca brahmadevo ca dve aggasāvakā, sambhavo nāma upaṭṭhāko, bhaddā ca subhaddā ca dve aggasāvikā, nāgarukkho bodhi, sarīraṃ asītihatthubbedhaṃ ahosi, āyu saṭṭhivassasahassāni, sudassanā nāma aggamahesī, varuṇo nāma putto, ājaññarathena nikkhami."],"lineRefs":[["bv7:15"]]},{"para":2141,"vripara":null,"refs":["bv7:15"],"lines":["“Tassa dehābhinikkhantaṃ, pabhājālamanuttaraṃ;"],"lineRefs":[["bv7:15"]]},{"para":2142,"vripara":null,"refs":["bv7:15"],"lines":["Divā ceva tadā rattiṃ, niccaṃ pharati yojanaṃ."],"lineRefs":[["bv7:15"]]},{"para":2143,"vripara":null,"refs":["bv7:15"],"lines":["“Dhātuyo mama sabbāpi, vikirantūti so jino;"],"lineRefs":[["bv7:15"]]},{"para":2144,"vripara":null,"refs":["bv7:15"],"lines":["Adhiṭṭhāsi mahāvīro, sabbasattānukampako."],"lineRefs":[["bv7:15"]]},{"para":2145,"vripara":null,"refs":["bv7:15"],"lines":["“Mahānāgavanuyyāne, mahato nagarassa so;"],"lineRefs":[["bv7:15"]]},{"para":2146,"vripara":null,"refs":["bv7:15"],"lines":["Pūjito naramarūhi, parinibbāyi revato”ti."],"lineRefs":[["bv7:15"]]},{"para":2147,"vripara":null,"refs":["bv7:15"],"lines":["Tena vuttaṃ –"],"lineRefs":[["bv7:15"]]},{"para":2149,"vripara":"16","refs":["bv7:15"],"lines":["“Nagaraṃ sudhaññavatī nāma, vipulo nāma khattiyo;"],"lineRefs":[["bv7:15"]]},{"para":2150,"vripara":null,"refs":["bv7:15"],"lines":["Vipulā nāma janikā, revatassa mahesino."],"lineRefs":[["bv7:15"]]},{"para":2152,"vripara":"21","refs":["bv7:15"],"lines":["“Varuṇo brahmadevo ca, ahesuṃ aggasāvakā;"],"lineRefs":[["bv7:15"]]},{"para":2153,"vripara":null,"refs":["bv7:15"],"lines":["Sambhavo nāmupaṭṭhāko, revatassa mahesino."],"lineRefs":[["bv7:15"]]},{"para":2155,"vripara":"22","refs":["bv7:15"],"lines":["“Bhaddā ceva subhaddā ca, ahesuṃ aggasāvikā;"],"lineRefs":[["bv7:15"]]},{"para":2156,"vripara":null,"refs":["bv7:15"],"lines":["Sopi buddho asamasamo, nāgamūle abujjhatha."],"lineRefs":[["bv7:15"]]},{"para":2158,"vripara":"23","refs":["bv7:15"],"lines":["“Padumo kuñjaro ceva, ahesuṃ aggupaṭṭhakā;"],"lineRefs":[["bv7:15"]]},{"para":2159,"vripara":null,"refs":["bv7:15"],"lines":["Sirimā ceva yasavatī, ahesuṃ aggupaṭṭhikā."],"lineRefs":[["bv7:15"]]},{"para":2161,"vripara":"24","refs":["bv7:15"],"lines":["“Uccattanena so buddho, asītihatthamuggato;"],"lineRefs":[["bv7:15"]]},{"para":2162,"vripara":null,"refs":["bv7:15"],"lines":["Obhāseti disā sabbā, indaketuva uggato."],"lineRefs":[["bv7:15"]]},{"para":2164,"vripara":"25","refs":["bv7:15"],"lines":["“Tassa sarīre nibbattā, pabhāmālā anuttarā;"],"lineRefs":[["bv7:15"]]},{"para":2165,"vripara":null,"refs":["bv7:15"],"lines":["Divā vā yadi vā rattiṃ, samantā pharati yojanaṃ."],"lineRefs":[["bv7:15"]]},{"para":2167,"vripara":"26","refs":["bv7:15"],"lines":["“Saṭṭhivassasahassāni, āyu vijjati tāvade;"],"lineRefs":[["bv7:15"]]},{"para":2168,"vripara":null,"refs":["bv7:15"],"lines":["Tāvatā diṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[["bv7:15"]]},{"para":2170,"vripara":"27","refs":["bv7:15"],"lines":["“Dassayitvā buddhabalaṃ amataṃ loke pakāsayaṃ;"],"lineRefs":[["bv7:15"]]},{"para":2171,"vripara":null,"refs":["bv7:15"],"lines":["Nibbāyi anupādāno, yathaggupādānasaṅkhayā."],"lineRefs":[["bv7:15"]]},{"para":2173,"vripara":"28","refs":["bv7:15"],"lines":["“So ca kāyo ratananibho, so ca dhammo asādiso;"],"lineRefs":[["bv7:15"]]},{"para":2174,"vripara":null,"refs":["bv7:15"],"lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā”ti."],"lineRefs":[["bv7:15"]]},{"para":2175,"vripara":null,"refs":["bv7:15","bv7:28"],"lines":["Tattha <b>obhāsetī</b>ti pakāsayati.","<b>Uggato</b>ti ussito.","<b>Pabhāmālā</b>ti pabhāvelā.","<b>Yathaggī</b>ti aggi viya.","<b>Upādānasaṅkhayā</b>ti indhanakkhayā.","<b>So ca kāyo ratananibho</b>ti so ca tassa bhagavato kāyo suvaṇṇavaṇṇo.","“Tañca kāyaṃ ratananibhan” tipi pāṭho, liṅgavipallāsena vuttaṃ.","Soyeva panassattho.","Sesagāthāsu sabbattha uttānamevāti."],"lineRefs":[["bv7:15"],["bv7:15"],["bv7:15"],["bv7:15"],["bv7:15"],["bv7:28"],["bv7:28"],["bv7:28"],["bv7:28"]]}],"wordLinks":[["bv7:2.3","khandhadhātuvavatthānaṃ",0,0],["bv7:2.3","appavattaṃ bhavābhave",0,3],["bv7:3.1","tīṇī",3,0],["bv7:9.1","ye tadā upagatā munī",20,2],["bv7:15.1","buddhadhammaṃ",34,8],["bv7:15.1","saritvā",34,9],["bv7:15.1","anubrūhayiṃ",34,10],["bv7:15.3","āharissāmī",34,11],["bv7:15.3","taṃ dhammaṃ",34,12],["bv7:15.3","yaṃ mayhaṃ abhipatthitaṃ",34,13],["bv7:28.1","so ca kāyo ratananibho",61,5]],"before":[{"para":2018,"vripara":"15","refs":[],"lines":["“Ahaṃ tena samayena, nāgarājā mahiddhiko;"],"lineRefs":[[]]},{"para":2019,"vripara":null,"refs":[],"lines":["Atulo nāma nāmena, ussannakusalasañcayo."],"lineRefs":[[]]},{"para":2021,"vripara":"16","refs":[],"lines":["“Tadāhaṃ nāgabhavanā, nikkhamitvā sañātibhi;"],"lineRefs":[[]]},{"para":2022,"vripara":null,"refs":[],"lines":["Nāgānaṃ dibbaturiyehi, sasaṅghaṃ jinamupaṭṭhahiṃ."],"lineRefs":[[]]},{"para":2024,"vripara":"17","refs":[],"lines":["“Koṭisatasahassānaṃ, annapānena tappayiṃ;"],"lineRefs":[[]]},{"para":2025,"vripara":null,"refs":[],"lines":["Paccekadussayugaṃ datvā, saraṇaṃ tamupāgamiṃ."],"lineRefs":[[]]},{"para":2027,"vripara":"18","refs":[],"lines":["“Sopi maṃ buddho byākāsi, sumano lokanāyako;"],"lineRefs":[[]]},{"para":2028,"vripara":null,"refs":[],"lines":["Aparimeyyito kappe, ayaṃ buddho bhavissati."],"lineRefs":[[]]},{"para":2030,"vripara":"19","refs":[],"lines":["“Padhānaṃ padahitvāna … pe … hessāma sammukhā imaṃ”."],"lineRefs":[[]]},{"para":2031,"vripara":null,"refs":[],"lines":["Yathā koṇḍaññabuddhavaṃse, evaṃ aṭṭha gāthā vitthāretabbāti."],"lineRefs":[[]]},{"para":2033,"vripara":"20","refs":[],"lines":["“Tassāpi vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[[]]},{"para":2034,"vripara":null,"refs":[],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā”ti."],"lineRefs":[[]]},{"para":2035,"vripara":null,"refs":[],"lines":["Tassa pana <b>sumanassa</b> bhagavato mekhalaṃ nāma nagaraṃ ahosi, sudatto nāma rājā pitā, sirimā nāma devī mātā, saraṇo ca bhāvitatto ca dve aggasāvakā, udeno nāmupaṭṭhāko, soṇā ca upasoṇā ca dve aggasāvikā, nāgarukkho bodhi, navutihatthubbedhaṃ sarīraṃ, navutiyeva vassasahassāni āyuppamāṇaṃ ahosi, vaṭaṃsikā nāmassa mahesī devī, anūpamo nāma putto ahosi, hatthiyānena nikkhami.","Upaṭṭhāko aṅgarājā.","Aṅgārāme vasīti.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[]]},{"para":2037,"vripara":"21","refs":[],"lines":["“Nagaraṃ mekhalaṃ nāma, sudatto nāma khattiyo;"],"lineRefs":[[]]},{"para":2038,"vripara":null,"refs":[],"lines":["Sirimā nāma janikā, sumanassa mahesino."],"lineRefs":[[]]},{"para":2040,"vripara":"22","refs":[],"lines":["“Navavassasahassāni, agāraṃ ajjha so vasi;"],"lineRefs":[[]]},{"para":2041,"vripara":null,"refs":[],"lines":["Cando sucando vaṭaṃso ca, tayo pāsādamuttamā."],"lineRefs":[[]]},{"para":2043,"vripara":"23","refs":[],"lines":["“Tesaṭṭhisatasahassāni, nāriyo samalaṅkatā;"],"lineRefs":[[]]},{"para":2044,"vripara":null,"refs":[],"lines":["Vaṭaṃsikā nāma nārī, anūpamo nāma atrajo."],"lineRefs":[[]]},{"para":2046,"vripara":"24","refs":[],"lines":["“Nimitte caturo disvā, hatthiyānena nikkhami;"],"lineRefs":[[]]},{"para":2047,"vripara":null,"refs":[],"lines":["Anūnadasamāsāni, padhānaṃ padahī jino."],"lineRefs":[[]]},{"para":2049,"vripara":"25","refs":[],"lines":["“Brahmunā yācito santo, sumano lokanāyako;"],"lineRefs":[[]]},{"para":2050,"vripara":null,"refs":[],"lines":["Vatti cakkaṃ mahāvīro, mekhale puramuttame."],"lineRefs":[[]]},{"para":2052,"vripara":"26","refs":[],"lines":["“Saraṇo bhāvitatto ca, ahesuṃ aggasāvakā;"],"lineRefs":[[]]},{"para":2053,"vripara":null,"refs":[],"lines":["Udeno nāmupaṭṭhāko, sumanassa mahesino."],"lineRefs":[[]]},{"para":2055,"vripara":"27","refs":[],"lines":["“Soṇā ca upasoṇā ca, ahesuṃ aggasāvikā;"],"lineRefs":[[]]},{"para":2056,"vripara":null,"refs":[],"lines":["Sopi buddho amitayaso, nāgamūle abujjhatha."],"lineRefs":[[]]},{"para":2058,"vripara":"28","refs":[],"lines":["“Varuṇo ceva saraṇo ca, ahesuṃ aggupaṭṭhakā;"],"lineRefs":[[]]},{"para":2059,"vripara":null,"refs":[],"lines":["Cālā ca upacālā ca, ahesuṃ aggupaṭṭhikā."],"lineRefs":[[]]},{"para":2061,"vripara":"29","refs":[],"lines":["“Uccattanena so buddho, navutihatthamuggato;"],"lineRefs":[[]]},{"para":2062,"vripara":null,"refs":[],"lines":["Kañcanagghiyasaṅkāso, dasasahassī virocati."],"lineRefs":[[]]},{"para":2064,"vripara":"30","refs":[],"lines":["“Navutivassasahassāni, āyu vijjati tāvade;"],"lineRefs":[[]]},{"para":2065,"vripara":null,"refs":[],"lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[[]]},{"para":2067,"vripara":"31","refs":[],"lines":["“Tāraṇīye tārayitvā, bodhanīye ca bodhayi;"],"lineRefs":[[]]},{"para":2068,"vripara":null,"refs":[],"lines":["Parinibbāyi sambuddho, uḷurājāva atthami."],"lineRefs":[[]]},{"para":2070,"vripara":"32","refs":[],"lines":["“Te ca khīṇāsavā bhikkhū, so ca buddho asādiso;"],"lineRefs":[[]]},{"para":2071,"vripara":null,"refs":[],"lines":["Atulappabhaṃ dassayitvā, nibbutā te mahāyasā."],"lineRefs":[[]]},{"para":2073,"vripara":"33","refs":[],"lines":["“Tañca ñāṇaṃ atuliyaṃ, tāni ca atulāni ratanāni;"],"lineRefs":[[]]},{"para":2074,"vripara":null,"refs":[],"lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā."],"lineRefs":[[]]},{"para":2076,"vripara":"34","refs":[],"lines":["“Sumano yasadharo buddho, aṅgārāmamhi nibbuto;"],"lineRefs":[[]]},{"para":2077,"vripara":null,"refs":[],"lines":["Tattheva tassa jinathūpo, catuyojanamuggato”ti."],"lineRefs":[[]]},{"para":2078,"vripara":null,"refs":[],"lines":["Tattha <b>kañcanagghiyasaṅkāso</b>ti vividharatanavicittakañcanamayagghikasadisarūpasobho.","<b>Dasasahassī virocatī</b>ti tassa pabhāya dasasahassīpi lokadhātu virocatīti attho.","<b>Tāraṇīye</b>ti tārayitabbe, tārayituṃ vutte sabbe buddhaveneyyeti attho.","<b>Uḷurājāvā</b>ti cando viya.","<b>Atthamī</b>ti atthaṅgato.","Keci “atthaṃ gato”ti paṭhanti.","<b>Asādiso</b>ti asadiso.","<b>Mahāyasā</b>ti mahākittisaddā mahāparivārā ca.","<b>Tañca ñāṇan</b>ti taṃ sabbaññutaññāṇañca.","<b>Atuliyan</b>ti atulyaṃ asadisaṃ.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[]]},{"para":2079,"vripara":null,"refs":[],"lines":["Sumanabuddhavaṃsavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2080,"vripara":null,"refs":[],"lines":["Niṭṭhito catuttho buddhavaṃso."],"lineRefs":[[]]},{"para":2081,"vripara":null,"refs":[],"lines":["Revatabuddhavaṃsavaṇṇanā"],"lineRefs":[[]]},{"para":2082,"vripara":null,"refs":[],"lines":["Sumanassa pana bhagavato aparabhāge sāsane cassa antarahite navutivassasahassāyukā manussā anukkamena parihāyitvā dasavassāyukā hutvā puna anukkamena vaḍḍhitvā asaṅkhyeyyāyukā hutvā puna parihāyamānā saṭṭhivassasahassāyukā ahesuṃ.","Tadā <b>revato</b> nāma satthā udapādi.","Sopi pāramiyo pūretvā anekaratanasamujjalitabhavane tusitabhavane nibbattitvā tato cavitvā sabbadhanadhaññavatisudhaññavatīnagare sabbālaṅkārasamalaṅkataamitaruciraparivāraparivutassa sirivibhavasamudayenākulassa sabbasamiddhivipulassa vipulassa nāma rañño kule sabbajananayanālipālisamākulāya samphullanayanakuvalayasassirikasiniddhavadanakamalākarasobhāsamujjalāya suruciramanoharaguṇagaṇavipulāya vipulāya nāma aggamahesiyā kucchismiṃ paṭisandhiṃ gahetvā dasannaṃ māsānaṃ accayena cittakūṭapabbatato suvaṇṇahaṃsarājā viya mātukucchito nikkhami."],"lineRefs":[[],[],[]]},{"para":2083,"vripara":null,"refs":[],"lines":["Tassa paṭisandhiyaṃ jātiyañca pāṭihāriyāni pubbe vuttanayāneva ahesuṃ.","Sudassanaratanagghiāveḷanāmakā tayo cassa pāsādā ahesuṃ.","Sudassanādevippamukhāni tettiṃsa itthisahassāni paccupaṭṭhitāni ahesuṃ.","Tāhi parivuto so surayuvatīhi parivuto devakumāro viya chabbassasahassāni visayasukhamanubhavamāno agāraṃ ajjhāvasi.","So sudassanāya nāma deviyā varuṇe nāma tanaye jāte cattāri nimittāni disvā nānāvirāgatanuvaravasananivasano āmukkamuttāhāramaṇikuṇḍalo varakeyūramakuṭakaṭakadharo paramasurabhigandhakusumasamalaṅkato paramarucirakaranikaro saradasamayarajanikaro viya tārāgaṇaparivuto viya cando tidasagaṇaparivuto viya dasasatanayano brahmagaṇaparivuto viya ca hāritamahābrahmā caturaṅginiyā mahatiyā senāya parivuto ājaññarathena mahābhinikkhamanaṃ nikkhamitvā sabbābharaṇāni omuñcitvā bhaṇḍāgārikassa hatthe datvā jalajāmalāvikalanīlakuvalayadalasadisenātinisitenātitikhiṇenāsinā sakesamakuṭaṃ chinditvā ākāse khipi.","Taṃ sakko devarājā suvaṇṇacaṅkoṭakena paṭiggahetvā tāvatiṃsabhavanaṃ netvā sinerumuddhani sattaratanamayaṃ cetiyaṃ akāsi."],"lineRefs":[[],[],[],[],[],[]]},{"para":2084,"vripara":null,"refs":[],"lines":["Mahāpuriso pana devadattāni kāsāyāni paridahitvā pabbaji, ekā ca naṃ purisakoṭi anupabbaji.","So tehi parivuto sattamāse padhānacariyaṃ caritvā visākhapuṇṇamāya aññatarāya sādhudeviyā nāma seṭṭhidhītāya dinnaṃ madhupāyāsaṃ paribhuñjitvā sālavane divāvihāraṃ vītināmetvā sāyanhasamaye aññatarenājīvakena dinnā aṭṭha tiṇamuṭṭhiyo gahetvā mattavaranāgagāmī nāgabodhiṃ padakkhiṇaṃ katvā tepaṇṇāsahatthavitthataṃ tiṇasantharaṃ santharitvā caturaṅgavīriyaṃ adhiṭṭhāya nisīditvā mārabalaṃ vidhamitvā sabbaññutaññāṇaṃ paṭivijjhitvā –","“anekajātisaṃsāraṃ … pe … taṇhānaṃ khayamajjhagā”ti (dha. pa.153-154) udānaṃ udānesi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[]]},{"para":2086,"vripara":"1","refs":[],"lines":["“Sumanassa aparena, revato nāma nāyako;"],"lineRefs":[[]]},{"para":2087,"vripara":null,"refs":[],"lines":["Anupamo asadiso, atulo uttamo jino”ti."],"lineRefs":[[]]},{"para":2088,"vripara":null,"refs":[],"lines":["Revato kira satthā bodhisamīpeyeva sattasattāhāni vītināmetvā dhammadesanatthaṃ brahmāyācanaṃ sampaṭicchitvā –","“kassa nu kho ahaṃ paṭhamaṃ dhammaṃ deseyyan”ti (dī. ni.2.72; ma. ni.1.284;2.341; mahāva.10) upadhārento attanā saha pabbajitabhikkhukoṭiyo aññe ca bahū devamanusse upanissayasampanne disvā ākāsena gantvā varuṇārāme otaritvā tehi parivuto gambhīraṃ nipuṇaṃ tiparivaṭṭaṃ appaṭivattiyaṃ aññena anuttaraṃ dhammacakkaṃ pavattetvā bhikkhūnaṃ koṭi arahatte patiṭṭhāpesi.","Tīsu maggaphalesu patiṭṭhitānaṃ gaṇanaparicchedo natthi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[]]},{"para":2090,"vripara":"2","refs":[],"lines":["“Sopi dhammaṃ pakāsesi, brahmunā abhiyācito;"],"lineRefs":[[]]},{"para":2091,"vripara":null,"refs":[],"lines":["Khandhadhātuvavatthānaṃ, appavattaṃ bhavābhave”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
