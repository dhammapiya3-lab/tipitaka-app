{"suttaId":"ja96","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[538,541],"vripara":"96"},"segments":{"ja96:0.4":"Telapattajātakaṃ","ja96:1.1":"Samatittikaṃ anavasekaṃ, telapattaṃ yathā parihareyya;","ja96:1.3":"Evaṃ sacittamanurakkhe, patthayāno disaṃ agatapubbanti.","ja96:2.1":"Telapattajātakaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
