{"suttaId":"ja96","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[538,541],"vripara":"96"},"segments":{"ja96:0.4":"Telapattajātakaṃ","ja96:1.1":"Samatittikaṃ anavasekaṃ, telapattaṃ yathā parihareyya;","ja96:1.3":"Evaṃ sacittamanurakkhe, patthayāno disaṃ agatapubbanti.","ja96:2.1":"Telapattajātakaṃ chaṭṭhaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2412,"to":2431,"paras":[{"para":2412,"vripara":null,"refs":["ja96:1"],"lines":["Tattha <b>samatittikan</b>ti antomukhavaṭṭilekhaṃ pāpetvā samabharitaṃ.","<b>Anavasesakan</b>ti anavasiñcanakaṃ aparissāvanakaṃ katvā.","<b>Telapattan</b>ti pakkhittatilatelapattaṃ.","<b>Parihareyyā</b>ti hareyya, ādāya gaccheyya.","<b>Evaṃ sacittamanurakkhe</b>ti taṃ telabharitaṃ pattaṃ viya attano cittaṃ kāyagatāsatiyā gocare ceva sampayuttasatiyā cāti ubhinnaṃ antare pakkhipitvā yathā muhuttampi bahiddhā gocare na vikkhipati, tathā paṇḍito yogāvacaro rakkheyya gopeyya.","Kiṃkāraṇā?","Etassa hi –"],"lineRefs":[["ja96:1"],["ja96:1"],["ja96:1"],["ja96:1"],["ja96:1"],["ja96:1"],["ja96:1"]]},{"para":2413,"vripara":null,"refs":[],"lines":["“Dunniggahassa lahuno, yatthakāmanipātino;"],"lineRefs":[[]]},{"para":2414,"vripara":null,"refs":[],"lines":["Cittassa damatho sādhu, cittaṃ dantaṃ sukhāvahan”ti.(dha. pa.35);"],"lineRefs":[[]]},{"para":2415,"vripara":null,"refs":[],"lines":["Tasmā –"],"lineRefs":[[]]},{"para":2416,"vripara":null,"refs":[],"lines":["“Sududdasaṃ sunipuṇaṃ, yatthakāmanipātinaṃ;"],"lineRefs":[[]]},{"para":2417,"vripara":null,"refs":[],"lines":["Cittaṃ rakkhetha medhāvī, cittaṃ guttaṃ sukhāvahaṃ”.(dha. pa.36);"],"lineRefs":[[]]},{"para":2418,"vripara":null,"refs":[],"lines":["Idañhi –"],"lineRefs":[[]]},{"para":2419,"vripara":null,"refs":[],"lines":["“Dūraṅgamaṃ ekacaraṃ, asarīraṃ guhāsayaṃ;"],"lineRefs":[[]]},{"para":2420,"vripara":null,"refs":[],"lines":["Ye cittaṃ saṃyamessanti, mokkhanti mārabandhanā”.(dha. pa.37);"],"lineRefs":[[]]},{"para":2421,"vripara":null,"refs":[],"lines":["Itarassa pana –"],"lineRefs":[[]]},{"para":2422,"vripara":null,"refs":[],"lines":["“Anavaṭṭhitacittassa, saddhammaṃ avijānato;"],"lineRefs":[[]]},{"para":2423,"vripara":null,"refs":[],"lines":["Pariplavapasādassa, paññā na paripūrati”.(dha. pa.38);"],"lineRefs":[[]]},{"para":2424,"vripara":null,"refs":[],"lines":["Thirakammaṭṭhānasahāyassa pana –"],"lineRefs":[[]]},{"para":2425,"vripara":null,"refs":[],"lines":["“Anavassutacittassa, ananvāhatacetaso;"],"lineRefs":[[]]},{"para":2426,"vripara":null,"refs":[],"lines":["Puññapāpapahīnassa, natthi jāgarato bhayaṃ”.(dha. pa.39);"],"lineRefs":[[]]},{"para":2427,"vripara":null,"refs":[],"lines":["Tasmā etaṃ –"],"lineRefs":[[]]},{"para":2428,"vripara":null,"refs":[],"lines":["“Phandanaṃ capalaṃ cittaṃ, dūrakkhaṃ dunnivārayaṃ;"],"lineRefs":[[]]},{"para":2429,"vripara":null,"refs":[],"lines":["Ujuṃ karoti medhāvī, usukārova tejanaṃ”.(dha. pa.33);"],"lineRefs":[[]]},{"para":2430,"vripara":null,"refs":[],"lines":["Evaṃ ujuṃ karonto sacittamanurakkhe."],"lineRefs":[[]]},{"para":2431,"vripara":null,"refs":["ja96:1"],"lines":["<b>Patthayāno disaṃ agatapubban</b>ti imasmiṃ kāyagatāsatikammaṭṭhāne kammaṃ ārabhitvā anamatagge saṃsāre agatapubbaṃ disaṃ patthento pihento vuttanayena sakaṃ cittaṃ rakkheyyāti attho.","Kā panesā disā nāma?","–"],"lineRefs":[["ja96:1"],["ja96:1"],["ja96:1"]]}],"wordLinks":[["ja96:1.1","samatittikaṃ",0,0],["ja96:1.1","telapattaṃ",0,2],["ja96:1.1","parihareyyā",0,3],["ja96:1.3","evaṃ sacittamanurakkhe",0,4],["ja96:1.3","patthayāno disaṃ agatapubbaṃ",19,0]]},"tika":null}
