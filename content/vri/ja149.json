{"suttaId":"ja149","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[831,834],"vripara":"149"},"segments":{"ja149:0.4":"Ekapaṇṇajātakaṃ","ja149:1.1":"Ekapaṇṇo ayaṃ rukkho, na bhūmyā caturaṅgulo;","ja149:1.3":"Phalena visakappena, mahāyaṃ kiṃ bhavissatīti.","ja149:2.1":"Ekapaṇṇajātakaṃ navamaṃ."},"attha":null,"tika":null}
