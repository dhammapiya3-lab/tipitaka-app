{"suttaId":"an4.71","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[821,821],"vripara":"71"},"segments":{"an4.71:0.3":"Padhānasuttaṃ","an4.71:1.1":"“Catūhi, bhikkhave, dhammehi samannāgato bhikkhu apaṇṇakappaṭipadaṃ paṭipanno hoti, yoni cassa āraddhā hoti āsavānaṃ khayāya.","an4.71:1.2":"Katamehi catūhi?","an4.71:1.3":"Idha, bhikkhave, bhikkhu sīlavā hoti, bahussuto hoti, āraddhavīriyo hoti, paññavā hoti.","an4.71:1.4":"Imehi kho, bhikkhave, catūhi dhammehi samannāgato bhikkhu apaṇṇakappaṭipadaṃ paṭipanno hoti, yoni cassa āraddhā hoti āsavānaṃ khayāyā”ti.","an4.71:1.5":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1313,"to":1313,"paras":[{"para":1313,"vripara":"71","refs":["an4.71:1"],"lines":["Tatiyavaggassa paṭhame <b>apaṇṇakappaṭipada</b>nti aviraddhappaṭipadaṃ.","<b>Yoni cassa āraddhā hotī</b>ti kāraṇañcassa paripuṇṇaṃ hoti.","<b>Āsavānaṃ khayāyā</b>ti arahattatthāya.","Dutiyaṃ uttānameva. 3."],"lineRefs":[["an4.71:1"],["an4.71:1"],["an4.71:1"],["an4.71:1"]]}],"wordLinks":[["an4.71:1.1","apaṇṇakappaṭipadaṃ",0,0],["an4.71:1.4","apaṇṇakappaṭipadaṃ",0,0],["an4.71:1.1","yoni cassa āraddhā hotī",0,1],["an4.71:1.4","yoni cassa āraddhā hotī",0,1],["an4.71:1.1","āsavānaṃ khayāyā",0,2],["an4.71:1.4","āsavānaṃ khayāyā",0,2]],"before":[{"para":1311,"vripara":null,"title":"3. Apaṇṇakavaggo","lines":["Apaṇṇakavaggo 1."]},{"para":1312,"vripara":null,"title":"Padhānasuttavaṇṇanā","lines":["Padhānasuttavaṇṇanā 71."]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1491,"to":1491,"paras":[{"para":1491,"vripara":"71-72","refs":["an4.71:1"],"lines":["Tatiyavaggassa paṭhame yavati tena phalaṃ missitaṃ viya hotīti <b>yoni,</b> ekantikaṃ kāraṇaṃ.","<b>Assā</b>ti yathāvuttassa bhikkhuno.","<b>Paripuṇṇa</b>nti avikalaṃ anavasesaṃ.","Āsave khepetīti <b>āsavakkhayo,</b> aggamaggo.","Idha pana arahattaphalaṃ adhippetanti āha <b>“arahattatthāyā”</b>ti.","Dutiyaṃ uttānameva."],"lineRefs":[["an4.71:1"],["an4.71:1"],["an4.71:1"],["an4.71:1"],["an4.71:1"],["an4.71:1"]]}],"wordLinks":[["an4.71:1.1","yoni",0,0],["an4.71:1.4","yoni",0,0],["an4.71:1.1","assā",0,1],["an4.71:1.4","assā",0,1]],"before":[{"para":1489,"vripara":null,"title":"3. Apaṇṇakavaggo","lines":["Apaṇṇakavaggo 1-2."]},{"para":1490,"vripara":null,"title":"Padhānasuttādivaṇṇanā","lines":["Padhānasuttādivaṇṇanā 71-72."]}]},"tika2":null}
