{"suttaId":"tha-ap400","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[12669,12687],"vripara":"449"},"segments":{"tha-ap400:0.3":"Saḷalamaṇḍapiyattheraapadānaṃ","tha-ap400:1.1":"“Nibbute kakusandhamhi,","tha-ap400:1.2":"brāhmaṇamhi vusīmati;","tha-ap400:1.3":"Gahetvā saḷalaṃ mālaṃ,","tha-ap400:1.4":"maṇḍapaṃ kārayiṃ ahaṃ. 450.","tha-ap400:2.1":"“Tāvatiṃsagato santo,","tha-ap400:2.2":"labhāmi byamhamuttamaṃ;","tha-ap400:2.3":"Aññe devetirocāmi,","tha-ap400:2.4":"puññakammassidaṃ phalaṃ. 451.","tha-ap400:3.1":"“Divā vā yadi vā rattiṃ,","tha-ap400:3.2":"caṅkamanto ṭhito cahaṃ;","tha-ap400:3.3":"Channo saḷalapupphehi,","tha-ap400:3.4":"puññakammassidaṃ phalaṃ. 452.","tha-ap400:4.1":"“Imasmiṃyeva kappamhi,","tha-ap400:4.2":"yaṃ buddhamabhipūjayiṃ;","tha-ap400:4.3":"Duggatiṃ nābhijānāmi,","tha-ap400:4.4":"buddhapūjāyidaṃ phalaṃ. 453.","tha-ap400:5.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap400:5.3":"viharāmi anāsavo. 454.","tha-ap400:6.1":"“Svāgataṃ vata me āsi…pe…","tha-ap400:6.3":"kataṃ buddhassa sāsanaṃ. 455.","tha-ap400:7.1":"“Paṭisambhidā catasso…pe…","tha-ap400:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap400:8.1":"Itthaṃ sudaṃ āyasmā saḷalamaṇḍapiyo thero imā gāthāyo abhāsitthāti.","tha-ap400:9.1":"Saḷalamaṇḍapiyattherassāpadānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":1926,"to":1927,"paras":[{"para":1926,"vripara":"454","refs":["tha-ap400:6"],"lines":["<b>Mantāṇiputto</b>ti mantāṇīnāmāya kappakadhītuyā putto, māsapuṇṇatāya divasapuṇṇatāya <b>puṇṇo</b>ti laddhanāmoti attho.","Tassa satthussa sāvako <b>hessati</b> bhavissatīti sambandho. 455."],"lineRefs":[["tha-ap400:6"],["tha-ap400:6"]]},{"para":1927,"vripara":"455","refs":["tha-ap400:7"],"lines":["<b>Evaṃ kittayi so buddho</b>ti <b>so</b> padumuttaro bhagavā <b>evaṃ</b> iminā pakārena <b>sunandaṃ</b> sundarākārena somanassadāyakaṃ <b>kittayi</b> byākaraṇamadāsīti attho.","<b>Sabbaṃ janaṃ</b> sakalajanasamūhaṃ sādhukaṃ <b>hāsayanto</b> somanassaṃ karonto <b>sakaṃ balaṃ</b> attano balaṃ <b>dassayanto</b> pākaṭaṃ karontoti sambandho. 456."],"lineRefs":[["tha-ap400:7"],["tha-ap400:7"]]}],"wordLinks":[]},"tika":null,"tika2":null}
