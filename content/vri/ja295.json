{"suttaId":"ja295","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2253,2262],"vripara":"133"},"segments":{"ja295:0.4":"Antajātakaṃ (3-5-5)","ja295:1.1":"Usabhasseva te khandho, sīhasseva vijambhitaṃ;","ja295:1.3":"Migarāja namo tyatthu, api kiñci labhāmase.","ja295:2.1":"Kulaputtova jānāti, kulaputtaṃ pasaṃsituṃ;","ja295:2.3":"Mayūragīvasaṅkāsa, ito pariyāhi vāyasa.","ja295:3.1":"Migānaṃ siṅgālo [kotthuko (sī. pī.), koṭṭhuko (syā.)] anto, pakkhīnaṃ pana vāyaso;","ja295:3.3":"Eraṇḍo anto rukkhānaṃ, tayo antā samāgatāti.","ja295:4.1":"Antajātakaṃ pañcamaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":2875,"to":2885,"paras":[{"para":2875,"vripara":null,"refs":["ja295:1"],"lines":["Tattha <b>namo tyatthū</b>ti namo te atthu."],"lineRefs":[["ja295:1"]]},{"para":2876,"vripara":null,"refs":[],"lines":["Taṃ sutvā siṅgālo dutiyaṃ gāthamāha –"],"lineRefs":[[]]},{"para":2878,"vripara":"134","refs":[],"lines":["“Kulaputtova jānāti, kulaputtaṃ pasaṃsituṃ;"],"lineRefs":[[]]},{"para":2879,"vripara":null,"refs":[],"lines":["Mayūragīvasaṅkāsa, ito pariyāhi vāyasā”ti."],"lineRefs":[[]]},{"para":2880,"vripara":null,"refs":["ja295:2"],"lines":["Tattha <b>ito pariyāhī</b>ti eraṇḍato otaritvā ito yenāhaṃ, tenāgantvā maṃsaṃ khādāti vadati."],"lineRefs":[["ja295:2"]]},{"para":2881,"vripara":null,"refs":[],"lines":["Taṃ tesaṃ kiriyaṃ disvā rukkhadevatā tatiyaṃ gāthamāha –"],"lineRefs":[[]]},{"para":2883,"vripara":"135","refs":[],"lines":["“Migānaṃ siṅgālo anto, pakkhīnaṃ pana vāyaso;"],"lineRefs":[[]]},{"para":2884,"vripara":null,"refs":[],"lines":["Eraṇḍo anto rukkhānaṃ, tayo antā samāgatā”ti."],"lineRefs":[[]]},{"para":2885,"vripara":null,"refs":["ja295:3"],"lines":["Tattha <b>anto</b>ti hīno lāmako."],"lineRefs":[["ja295:3"]]}],"wordLinks":[["ja295:1.3","namo tyatthū",0,0],["ja295:2.3","ito pariyāhī",4,0],["ja295:3.1","anto",8,0],["ja295:3.3","anto",8,0]]},"tika":null}
