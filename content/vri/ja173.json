{"suttaId":"ja173","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1049,1055],"vripara":"45"},"segments":{"ja173:0.4":"Makkaṭajātakaṃ (2-3-3)","ja173:1.1":"Tāta māṇavako eso, tālamūlaṃ apassito;","ja173:1.3":"Agārakañcidaṃ atthi, handa demassagārakaṃ.","ja173:2.1":"Mā kho tvaṃ tāta pakkosi, dūseyya no agārakaṃ;","ja173:2.3":"Netādisaṃ mukhaṃ hoti, brāhmaṇassa susīlinoti.","ja173:3.1":"Makkaṭajātakaṃ tatiyaṃ."},"attha":null,"tika":null}
