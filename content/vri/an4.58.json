{"suttaId":"an4.58","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[671,678],"vripara":"58"},"segments":{"an4.58:0.3":"Sudattasuttaṃ","an4.58:1.1":"Atha kho anāthapiṇḍiko gahapati yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinnaṃ kho anāthapiṇḍikaṃ gahapatiṃ bhagavā etadavoca –","an4.58:2.1":"“Bhojanaṃ, gahapati, dadamāno ariyasāvako paṭiggāhakānaṃ cattāri ṭhānāni deti.","an4.58:2.2":"Katamāni cattāri?","an4.58:2.3":"Āyuṃ deti, vaṇṇaṃ deti, sukhaṃ deti, balaṃ deti.","an4.58:2.4":"Āyuṃ kho pana datvā āyussa bhāgī hoti dibbassa vā mānusassa vā.","an4.58:2.5":"Vaṇṇaṃ datvā… sukhaṃ datvā… balaṃ datvā balassa bhāgī hoti dibbassa vā mānusassa vā.","an4.58:2.6":"Bhojanaṃ, gahapati, dadamāno ariyasāvako paṭiggāhakānaṃ imāni cattāri ṭhānāni detī”ti. [mahāva. 282]","an4.58:3.1":"“Yo saññatānaṃ paradattabhojinaṃ,","an4.58:3.2":"Kālena sakkacca dadāti bhojanaṃ;","an4.58:3.3":"Cattāri ṭhānāni anuppavecchati,","an4.58:3.4":"Āyuñca vaṇṇañca sukhaṃ balañca.","an4.58:4.1":"“So āyudāyī vaṇṇadāyī [so āyudāyī baladāyī (sī. pī.), āyudāyī baladāyī (syā. kaṃ.)],","an4.58:4.2":"sukhaṃ balaṃ dado [sukhaṃ vaṇṇaṃ dado (sī. syā. kaṃ. pī.), sukhabaladado (ka.)] naro;","an4.58:4.3":"Dīghāyu yasavā hoti,","an4.58:4.4":"yattha yatthūpapajjatī”ti.","an4.58:4.5":"aṭṭhamaṃ; 9."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1276,"to":1276,"paras":[{"para":1276,"vripara":"58","refs":["an4.58:3","an4.58:4"],"lines":["Aṭṭhame <b>saññatāna</b>nti kāyavācāhi saṃyatānaṃ.","<b>Paradattabhojina</b>nti parehi dinnameva bhuñjitvā yāpentānaṃ.","<b>Kālenā</b>ti yuttappattakālena.","<b>Sakkacca dadātī</b>ti sahatthā sakkāraṃ katvā dadāti.","<b>Cattāri ṭhānāni anuppavecchatī</b>ti cattāri kāraṇāni anuppaveseti dadāti.","<b>Yasavā hotī</b>ti mahāparivāro hoti.","Navamaṃ kevalaṃ bhikkhūnaṃ kathitaṃ.","Sesamettha tādisameva. 10."],"lineRefs":[["an4.58:3"],["an4.58:3"],["an4.58:3"],["an4.58:3"],["an4.58:3"],["an4.58:4"],["an4.58:4"],["an4.58:4"]]}],"wordLinks":[["an4.58:3.1","saññatānaṃ",0,0],["an4.58:3.1","paradattabhojinaṃ",0,1],["an4.58:3.2","kālenā",0,2],["an4.58:3.2","sakkacca dadātī",0,3],["an4.58:3.3","cattāri ṭhānāni anuppavecchatī",0,4],["an4.58:4.3","yasavā hotī",0,5]],"before":[{"para":1275,"vripara":null,"title":"Sudattasuttavaṇṇanā","lines":["Sudattasuttavaṇṇanā 58."]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1454,"to":1458,"paras":[{"para":1454,"vripara":"57-60","refs":["an4.58:1"],"lines":["Sattame <b>āyubhāgapaṭilābhinī hotī</b>ti āyukoṭṭhāsassa paṭilābhinī hoti.","<b>Tividhaloka</b>nti sattasaṅkhārabhājanasaṅkhātaṃ tividhaṃ lokaṃ.","<b>Viditaṃ katvā</b>ti vibhūtaṃ katvā.","<b>Lokavidūna</b>nti karaṇatthe sāmivacananti āha <b>“buddhehi pasatthā”</b>ti.","Aṭṭhamanavamadasamāni uttānatthāneva."],"lineRefs":[["an4.58:1"],["an4.58:1"],["an4.58:1"],["an4.58:1"],["an4.58:1"]]},{"para":1455,"vripara":null,"refs":["an4.58:1"],"lines":["Suppavāsāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an4.58:1"]]},{"para":1456,"vripara":null,"refs":["an4.58:1"],"lines":["Puññābhisandavaggavaṇṇanā niṭṭhitā. (7) 2."],"lineRefs":[["an4.58:1"]]},{"para":1457,"vripara":null,"refs":["an4.58:1"],"lines":["Pattakammavaggo 1-4."],"lineRefs":[["an4.58:1"]]},{"para":1458,"vripara":null,"refs":["an4.58:1"],"lines":["Pattakammasuttādivaṇṇanā 61-64."],"lineRefs":[["an4.58:1"]]}],"wordLinks":[]},"tika2":null}
