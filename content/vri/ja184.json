{"suttaId":"ja184","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1144,1151],"vripara":"67"},"segments":{"ja184:0.4":"Giridattajātakaṃ (2-4-4)","ja184:1.1":"Dūsito giridattena [giridantena (pī.)], hayo sāmassa paṇḍavo;","ja184:1.3":"Porāṇaṃ pakatiṃ hitvā, tassevānuvidhiyyati [nuvidhīyati (sī. pī.)].","ja184:2.1":"Sace ca tanujo poso, sikharākāra [siṅgārākāra (syā.)] kappito;","ja184:2.3":"Ānane naṃ [taṃ (sī. syā. pī.)] gahetvāna, maṇḍale parivattaye;","ja184:2.5":"Khippameva pahantvāna, tassevānuvidhiyyatīti.","ja184:3.1":"Giridattajātakaṃ catutthaṃ."},"attha":null,"tika":null}
