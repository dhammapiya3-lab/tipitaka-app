{"suttaId":"sn35.167","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[999,1003],"vripara":"167"},"segments":{"sn35.167:0.3":"Attānudiṭṭhipahānasuttaṃ","sn35.167:1.1":"Atha kho aññataro bhikkhu…pe…","sn35.167:1.2":"etadavoca –","sn35.167:1.3":"“kathaṃ nu kho, bhante, jānato kathaṃ passato attānudiṭṭhi pahīyatī”ti?","sn35.167:1.4":"“Cakkhuṃ kho, bhikkhu, anattato jānato passato attānudiṭṭhi pahīyati.","sn35.167:1.5":"Rūpe anattato jānato passato attānudiṭṭhi pahīyati.","sn35.167:1.6":"Cakkhuviññāṇaṃ anattato jānato passato attānudiṭṭhi pahīyati.","sn35.167:1.7":"Cakkhusamphassaṃ anattato jānato passato attānudiṭṭhi pahīyati.","sn35.167:1.8":"Yampidaṃ cakkhusamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi anattato jānato passato attānudiṭṭhi pahīyati…pe…","sn35.167:1.9":"jivhaṃ anattato jānato passato attānudiṭṭhi pahīyati…pe…","sn35.167:1.10":"manaṃ anattato jānato passato attānudiṭṭhi pahīyati.","sn35.167:1.11":"Dhamme…","sn35.167:1.12":"manoviññāṇaṃ…","sn35.167:1.13":"manosamphassaṃ…","sn35.167:1.14":"yampidaṃ manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi anattato jānato passato attānudiṭṭhi pahīyatī”ti.","sn35.167:1.15":"Dvādasamaṃ.","sn35.167:1.16":"Nandikkhayavaggo soḷasamo.","sn35.167:2.0":"Tassuddānaṃ –","sn35.167:2.1":"Nandikkhayena cattāro,","sn35.167:2.2":"jīvakambavane duve;","sn35.167:2.3":"Koṭṭhikena tayo vuttā,","sn35.167:2.4":"micchā sakkāya attanoti. 17."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":286,"to":289,"paras":[{"para":286,"vripara":"165-167","refs":["sn35.167:1"],"lines":["Dasamādīni tīṇi pāṭiyekkena puggalajjhāsayavasena vuttāni.","Tesaṃ attho vuttanayeneva veditabboti."],"lineRefs":[["sn35.167:1"],["sn35.167:1"]]},{"para":287,"vripara":null,"refs":["sn35.167:1"],"lines":["Nandikkhayavaggo solasamo. 17."],"lineRefs":[["sn35.167:1"]]},{"para":288,"vripara":null,"refs":["sn35.167:1"],"lines":["Saṭṭhipeyyālavaggo 1-60."],"lineRefs":[["sn35.167:1"]]},{"para":289,"vripara":null,"refs":["sn35.167:1"],"lines":["Ajjhattaaniccachandasuttādivaṇṇanā 168-227."],"lineRefs":[["sn35.167:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":305,"to":309,"paras":[{"para":305,"vripara":"165-167","refs":["sn35.167:1"],"lines":["<b>Pāṭiyekka</b>nti visuṃ visuṃ.","<b>Vuttanayenevā</b>ti heṭṭhā vuttanayeneva apubbassa vattabbassa abhāvā."],"lineRefs":[["sn35.167:1"],["sn35.167:1"]]},{"para":306,"vripara":null,"refs":["sn35.167:1"],"lines":["Micchādiṭṭhipahānasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.167:1"]]},{"para":307,"vripara":null,"refs":["sn35.167:1"],"lines":["Nandikkhayavaggavaṇṇanā niṭṭhitā. 17."],"lineRefs":[["sn35.167:1"]]},{"para":308,"vripara":null,"refs":["sn35.167:1"],"lines":["Saṭṭhipeyyālavaggo 1-60."],"lineRefs":[["sn35.167:1"]]},{"para":309,"vripara":null,"refs":["sn35.167:1"],"lines":["Ajjhattaaniccachandasuttādivaṇṇanā 168-227."],"lineRefs":[["sn35.167:1"]]}],"wordLinks":[]},"tika2":null}
