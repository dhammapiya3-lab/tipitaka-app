{"suttaId":"thag2.33","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[984,990],"vripara":"185"},"segments":{"thag2.33:0.4":"Upavāṇattheragāthā","thag2.33:1.1":"“Arahaṃ sugato loke, vātehābādhito [… bādhito (ka.)] muni;","thag2.33:1.3":"Sace uṇhodakaṃ atthi, munino dehi brāhmaṇa.","thag2.33:2.1":"“Pūjito pūjaneyyānaṃ [pūjanīyānaṃ (sī.)], sakkareyyāna sakkato;","thag2.33:2.3":"Apacitopaceyyānaṃ [apacanīyānaṃ (sī.), apacineyyānaṃ (syā.)], tassa icchāmi hātave”ti.","thag2.33:2.5":"… Upavāṇo thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":4245,"to":4245,"paras":[{"para":4245,"vripara":null,"refs":["thag2.33:2"],"lines":["Tassattho – yo imasmiṃ <b>loke pūjaneyyānaṃ</b> pūjetabbehi sakkādīhi devehi mahābrahmādīhi ca brahmehi <b>pūjito, sakkareyyānaṃ</b> sakkātabbehi bimbisārakosalarājādīhi <b>sakkato, apaceyyānaṃ</b> apacāyitabbehi mahesīhi khīṇāsavehi <b>apacito,</b> kilesehi ārakattādinā <b>arahaṃ,</b> sobhanagamanādinā <b>sugato</b> sabbaññū <b>muni</b> mayhaṃ satthā devadevo sakkānaṃ atisakko brahmānaṃ atibrahmā, so dāni <b>vātehi</b> vātahetu vātakkhobhanimittaṃ <b>ābādhiko</b> jāto.","<b>Sace, brāhmaṇa, uṇhodakaṃ atthi, tassa</b> vātābādhavūpasamanatthaṃ taṃ <b>hātave</b> upanetuṃ <b>icchāmī</b>ti.","Taṃ sutvā brāhmaṇo uṇhodakaṃ tadanurūpaṃ vātārahañca bhesajjaṃ bhagavato upanāmesi.","Tena ca satthu rogo vūpasami.","Tassa bhagavā anumodanaṃ akāsīti."],"lineRefs":[["thag2.33:2"],["thag2.33:2"],["thag2.33:2"],["thag2.33:2"],["thag2.33:2"]]}],"wordLinks":[["thag2.33:2.3","apacito",0,0],["thag2.33:2.3","hātave",0,1],["thag2.33:2.3","icchāmī",0,1]],"before":[{"para":4126,"vripara":null,"refs":[],"lines":["Sivakattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":4127,"vripara":null,"refs":[],"lines":["Upavāṇattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":4128,"vripara":null,"refs":[],"lines":["<b>Arahaṃ sugato</b>ti āyasmato upavāṇattherassa gāthā.","Kā uppatti?","Ayaṃ kira padumuttarassa bhagavato kāle daliddakule nibbattitvā viññutaṃ patto bhagavati parinibbute tassa dhātuṃ gahetvā manussadevanāgagaruḷakumbhaṇḍayakkhagandhabbehi sattaratanamaye sattayojanike thūpe kate tattha sudhotaṃ attano uttarāsaṅgaṃ veḷagge ābandhitvā dhajaṃ katvā pūjaṃ akāsi.","Taṃ gahetvā abhisammatako nāma yakkhasenāpati devehi cetiyapūjārakkhaṇatthaṃ ṭhapito adissamānakāyo ākāse dhārento cetiyaṃ tikkhattuṃ padakkhiṇaṃ akāsi.","So taṃ disvā bhiyyosomattāya pasannamānaso ahosi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇakule nibbattitvā <b>upavāṇo</b>ti laddhanāmo vayappatto jetavanapaṭiggahaṇe buddhānubhāvaṃ disvā paṭiladdhasaddho pabbajitvā vipassanāya kammaṃ karonto arahattaṃ patvā chaḷabhiñño ahosi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.56.122-178)–"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":4129,"vripara":null,"refs":[],"lines":["“Padumuttaro nāma jino, sabbadhammāna pāragū;"],"lineRefs":[[]]},{"para":4130,"vripara":null,"refs":[],"lines":["Jalitvā aggikkhandhova, sambuddho parinibbuto."],"lineRefs":[[]]},{"para":4131,"vripara":null,"refs":[],"lines":["“Mahājanā samāgamma, pūjayitvā tathāgataṃ;"],"lineRefs":[[]]},{"para":4132,"vripara":null,"refs":[],"lines":["Cittaṃ katvāna sugataṃ, sarīraṃ abhiropayuṃ."],"lineRefs":[[]]},{"para":4133,"vripara":null,"refs":[],"lines":["“Sarīrakiccaṃ katvāna, dhātuṃ tattha samānayuṃ;"],"lineRefs":[[]]},{"para":4134,"vripara":null,"refs":[],"lines":["Sadevamanussā sabbe, buddhathūpaṃ akaṃsu te."],"lineRefs":[[]]},{"para":4135,"vripara":null,"refs":[],"lines":["“Paṭhamā kañcanamayā, dutiyā ca maṇimayā;"],"lineRefs":[[]]},{"para":4136,"vripara":null,"refs":[],"lines":["Tatiyā rūpiyamayā, catutthī phalikāmayā."],"lineRefs":[[]]},{"para":4137,"vripara":null,"refs":[],"lines":["“Tattha pañcamikā ceva, lohitaṅkamayā ahu;"],"lineRefs":[[]]},{"para":4138,"vripara":null,"refs":[],"lines":["Chaṭṭhā masāragallassa, sabbaṃ ratanamayūpari."],"lineRefs":[[]]},{"para":4139,"vripara":null,"refs":[],"lines":["“Jaṅghā maṇimayā āsi, vedikā ratanāmayā;"],"lineRefs":[[]]},{"para":4140,"vripara":null,"refs":[],"lines":["Sabbasoṇṇamayo thūpo, uddhaṃ yojanamuggato."],"lineRefs":[[]]},{"para":4141,"vripara":null,"refs":[],"lines":["“Devā tattha samāgantvā, ekato mantayuṃ tadā;"],"lineRefs":[[]]},{"para":4142,"vripara":null,"refs":[],"lines":["Mayampi thūpaṃ kassāma, lokanāthassa tādino."],"lineRefs":[[]]},{"para":4143,"vripara":null,"refs":[],"lines":["“Dhātu āveṇikā natthi, sarīraṃ ekapiṇḍitaṃ;"],"lineRefs":[[]]},{"para":4144,"vripara":null,"refs":[],"lines":["Imamhi buddhathūpamhi, kassāma kañcukaṃ mayaṃ."],"lineRefs":[[]]},{"para":4145,"vripara":null,"refs":[],"lines":["“Devā sattahi ratnehi, aññaṃ vaḍḍhesuṃ yojanaṃ;"],"lineRefs":[[]]},{"para":4146,"vripara":null,"refs":[],"lines":["Thūpo dviyojanubbedho, timiraṃ byapahanti so."],"lineRefs":[[]]},{"para":4147,"vripara":null,"refs":[],"lines":["“Nāgā tattha samāgantvā, ekato mantayuṃ tadā;"],"lineRefs":[[]]},{"para":4148,"vripara":null,"refs":[],"lines":["Manussā ceva devā ca, buddhathūpaṃ akaṃsu te."],"lineRefs":[[]]},{"para":4149,"vripara":null,"refs":[],"lines":["“Mā no pamattā assumha, appamattā sadevakā;"],"lineRefs":[[]]},{"para":4150,"vripara":null,"refs":[],"lines":["Mayampi thūpaṃ kassāma, lokanāthassa tādino."],"lineRefs":[[]]},{"para":4151,"vripara":null,"refs":[],"lines":["“Indanīlaṃ mahānīlaṃ, atho jotirasaṃ maṇiṃ;"],"lineRefs":[[]]},{"para":4152,"vripara":null,"refs":[],"lines":["Ekato sannipātetvā, buddhathūpaṃ achādayuṃ."],"lineRefs":[[]]},{"para":4153,"vripara":null,"refs":[],"lines":["“Sabbaṃ maṇimayaṃ āsi, yāvatā buddhacetiyaṃ;"],"lineRefs":[[]]},{"para":4154,"vripara":null,"refs":[],"lines":["Tiyojanasamubbedhaṃ, ālokakaraṇaṃ tadā."],"lineRefs":[[]]},{"para":4155,"vripara":null,"refs":[],"lines":["“Garuḷā ca samāgantvā, ekato mantayuṃ tadā;"],"lineRefs":[[]]},{"para":4156,"vripara":null,"refs":[],"lines":["Manussā devanāgā ca, buddhapūjaṃ akaṃsu te."],"lineRefs":[[]]},{"para":4157,"vripara":null,"refs":[],"lines":["“Mā no pamattā assumha, appamattā sadevakā;"],"lineRefs":[[]]},{"para":4158,"vripara":null,"refs":[],"lines":["Mayampi thūpaṃ kassāma, lokanāthassa tādino."],"lineRefs":[[]]},{"para":4159,"vripara":null,"refs":[],"lines":["“Sabbaṃ maṇimayaṃ thūpaṃ, akaruṃ te ca kañcukaṃ;"],"lineRefs":[[]]},{"para":4160,"vripara":null,"refs":[],"lines":["Yojanaṃ tepi vaḍḍhesuṃ, āyataṃ buddhacetiyaṃ."],"lineRefs":[[]]},{"para":4161,"vripara":null,"refs":[],"lines":["“Catuyojanamubbedho, buddhathūpo virocati;"],"lineRefs":[[]]},{"para":4162,"vripara":null,"refs":[],"lines":["Obhāseti disā sabbā, sataraṃsīva uggato."],"lineRefs":[[]]},{"para":4163,"vripara":null,"refs":[],"lines":["“Kumbhaṇḍā ca samāgantvā, ekato mantayuṃ tadā;"],"lineRefs":[[]]},{"para":4164,"vripara":null,"refs":[],"lines":["Manussā ceva devā ca, nāgā ca garuḷā tathā."],"lineRefs":[[]]},{"para":4165,"vripara":null,"refs":[],"lines":["“Paccekaṃ buddhaseṭṭhassa, akaṃsu thūpamuttamaṃ;"],"lineRefs":[[]]},{"para":4166,"vripara":null,"refs":[],"lines":["Mā no pamattā assumha, appamattā sadevakā."],"lineRefs":[[]]},{"para":4167,"vripara":null,"refs":[],"lines":["“Mayampi thūpaṃ kassāma, lokanāthassa tādino;"],"lineRefs":[[]]},{"para":4168,"vripara":null,"refs":[],"lines":["Ratanehi chādessāma, āyataṃ buddhacetiyaṃ."],"lineRefs":[[]]},{"para":4169,"vripara":null,"refs":[],"lines":["“Yojanaṃ tepi vaḍḍhesuṃ, āyataṃ buddhacetiyaṃ;"],"lineRefs":[[]]},{"para":4170,"vripara":null,"refs":[],"lines":["Pañcayojanamubbedho, thūpo obhāsate tadā."],"lineRefs":[[]]},{"para":4171,"vripara":null,"refs":[],"lines":["“Yakkhā tattha samāgantvā, ekato mantayuṃ tadā;"],"lineRefs":[[]]},{"para":4172,"vripara":null,"refs":[],"lines":["Manussā devanāgā ca, garuḷā ca kumbhaṇḍakā."],"lineRefs":[[]]},{"para":4173,"vripara":null,"refs":[],"lines":["“Paccekaṃ buddhaseṭṭhassa, akaṃsu thūpamuttamaṃ;"],"lineRefs":[[]]},{"para":4174,"vripara":null,"refs":[],"lines":["Mā no pamattā assumha, appamattā sadevakā."],"lineRefs":[[]]},{"para":4175,"vripara":null,"refs":[],"lines":["“Mayampi thūpaṃ kassāma, lokanāthassa tādino;"],"lineRefs":[[]]},{"para":4176,"vripara":null,"refs":[],"lines":["Phalikā chādayissāma, āyataṃ buddhacetiyaṃ."],"lineRefs":[[]]},{"para":4177,"vripara":null,"refs":[],"lines":["“Yojanaṃ tepi vaḍḍhesuṃ, āyataṃ buddhacetiyaṃ;"],"lineRefs":[[]]},{"para":4178,"vripara":null,"refs":[],"lines":["Chayojanikamubbedho, thūpo obhāsate tadā."],"lineRefs":[[]]},{"para":4179,"vripara":null,"refs":[],"lines":["“Gandhabbā ca samāgantvā, ekato mantayuṃ tadā;"],"lineRefs":[[]]},{"para":4180,"vripara":null,"refs":[],"lines":["Manujā devatā nāgā, kumbhaṇḍā garuḷā tathā."],"lineRefs":[[]]},{"para":4181,"vripara":null,"refs":[],"lines":["“Sabbe akaṃsu buddhathūpaṃ, mayamettha akārakā;"],"lineRefs":[[]]},{"para":4182,"vripara":null,"refs":[],"lines":["Mayampi thūpaṃ kassāma, lokanāthassa tādino."],"lineRefs":[[]]},{"para":4183,"vripara":null,"refs":[],"lines":["“Vediyo satta katvāna, dhajaṃ chattaṃ akaṃsu te;"],"lineRefs":[[]]},{"para":4184,"vripara":null,"refs":[],"lines":["Sabbasoṇṇamayaṃ thūpaṃ, gandhabbā kārayuṃ tadā."],"lineRefs":[[]]},{"para":4185,"vripara":null,"refs":[],"lines":["“Sattayojanamubbedho, thūpo obhāsate tadā;"],"lineRefs":[[]]},{"para":4186,"vripara":null,"refs":[],"lines":["Rattindivā na ñāyanti, āloko hoti sabbadā."],"lineRefs":[[]]},{"para":4187,"vripara":null,"refs":[],"lines":["“Abhibhonti na tassābhā, candasūrā satārakā;"],"lineRefs":[[]]},{"para":4188,"vripara":null,"refs":[],"lines":["Samantā yojanasate, padīpopi na pajjali."],"lineRefs":[[]]},{"para":4189,"vripara":null,"refs":[],"lines":["“Tena kālena ye keci, thūpaṃ pūjenti mānusā;"],"lineRefs":[[]]},{"para":4190,"vripara":null,"refs":[],"lines":["Na te thūpaṃ āruhanti, ambare ukkhipanti te."],"lineRefs":[[]]},{"para":4191,"vripara":null,"refs":[],"lines":["“Devehi ṭhapito yakkho, abhisammatanāmako;"],"lineRefs":[[]]},{"para":4192,"vripara":null,"refs":[],"lines":["Dhajaṃ vā pupphadāmaṃ vā, abhiropeti uttariṃ."],"lineRefs":[[]]},{"para":4193,"vripara":null,"refs":[],"lines":["“Na te passanti taṃ yakkhaṃ, dāmaṃ passanti gacchato;"],"lineRefs":[[]]},{"para":4194,"vripara":null,"refs":[],"lines":["Evaṃ passitvā gacchantā, sabbe gacchanti suggatiṃ."],"lineRefs":[[]]},{"para":4195,"vripara":null,"refs":[],"lines":["“Viruddhā ye pāvacane, pasannā ye ca sāsane;"],"lineRefs":[[]]},{"para":4196,"vripara":null,"refs":[],"lines":["Pāṭihīraṃ daṭṭhukāmā, thūpaṃ pūjenti mānusā."],"lineRefs":[[]]},{"para":4197,"vripara":null,"refs":[],"lines":["“Nagare haṃsavatiyā, ahosiṃ bhatako tadā;"],"lineRefs":[[]]},{"para":4198,"vripara":null,"refs":[],"lines":["Āmoditaṃ janaṃ disvā, evaṃ cintesahaṃ tadā."],"lineRefs":[[]]},{"para":4199,"vripara":null,"refs":[],"lines":["“Uḷāro bhagavā neso, yassa dhātughare disaṃ;"],"lineRefs":[[]]},{"para":4200,"vripara":null,"refs":[],"lines":["Imā ca janatā tuṭṭhā, kāraṃ kubbaṃ na tappare."],"lineRefs":[[]]},{"para":4201,"vripara":null,"refs":[],"lines":["“Ahampi kāraṃ kassāmi, lokanāthassa tādino;"],"lineRefs":[[]]},{"para":4202,"vripara":null,"refs":[],"lines":["Tassa dhammesu dāyādo, bhavissāmi anāgate."],"lineRefs":[[]]},{"para":4203,"vripara":null,"refs":[],"lines":["“Sudhotaṃ rajakenāhaṃ, uttareyyaṃ paṭaṃ mama;"],"lineRefs":[[]]},{"para":4204,"vripara":null,"refs":[],"lines":["Veḷagge ālaggetvāna, dhajaṃ ukkhipimambare."],"lineRefs":[[]]},{"para":4205,"vripara":null,"refs":[],"lines":["“Abhisammatako gayha, ambare hāsi me dhajaṃ;"],"lineRefs":[[]]},{"para":4206,"vripara":null,"refs":[],"lines":["Vāteritaṃ dhajaṃ disvā, bhiyyo hāsaṃ janesahaṃ."],"lineRefs":[[]]},{"para":4207,"vripara":null,"refs":[],"lines":["“Tattha cittaṃ pasādetvā, samaṇaṃ upasaṅkamiṃ;"],"lineRefs":[[]]},{"para":4208,"vripara":null,"refs":[],"lines":["Taṃ bhikkhuṃ abhivādetvā, vipākaṃ pucchahaṃ dhaje."],"lineRefs":[[]]},{"para":4209,"vripara":null,"refs":[],"lines":["“So me kathesi ānandī, pītisañjananaṃ mama;"],"lineRefs":[[]]},{"para":4210,"vripara":null,"refs":[],"lines":["Tassa dhajassa vipākaṃ, anubhossasi sabbadā."],"lineRefs":[[]]},{"para":4211,"vripara":null,"refs":[],"lines":["“Hatthiassarathāpattī, senā ca caturaṅginī;"],"lineRefs":[[]]},{"para":4212,"vripara":null,"refs":[],"lines":["Parivāressanti taṃ niccaṃ, dhajadānassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":4213,"vripara":null,"refs":[],"lines":["“Saṭṭhitūriyasahassāni, bheriyo samalaṅkatā;"],"lineRefs":[[]]},{"para":4214,"vripara":null,"refs":[],"lines":["Parivāressanti taṃ niccaṃ, dhajadānassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":4215,"vripara":null,"refs":[],"lines":["“Chaḷasīti sahassāni, nāriyo samalaṅkatā;"],"lineRefs":[[]]},{"para":4216,"vripara":null,"refs":[],"lines":["Vicittavatthābharaṇā, āmukkamaṇikuṇḍalā."],"lineRefs":[[]]},{"para":4217,"vripara":null,"refs":[],"lines":["“Aḷārapamhā hasulā, susaññā tanumajjhimā;"],"lineRefs":[[]]},{"para":4218,"vripara":null,"refs":[],"lines":["Parivāressanti taṃ niccaṃ, dhajadānassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":4219,"vripara":null,"refs":[],"lines":["“Tiṃsakappasahassāni, devaloke ramissasi;"],"lineRefs":[[]]},{"para":4220,"vripara":null,"refs":[],"lines":["Asītikkhattuṃ devindo, devarajjaṃ karissasi."],"lineRefs":[[]]},{"para":4221,"vripara":null,"refs":[],"lines":["“Sahassakkhattuṃ rājā ca, cakkavattī bhavissati;"],"lineRefs":[[]]},{"para":4222,"vripara":null,"refs":[],"lines":["Padesarajjaṃ vipulaṃ, gaṇanāto asaṅkhiyaṃ."],"lineRefs":[[]]},{"para":4223,"vripara":null,"refs":[],"lines":["“Kappasatasahassamhi, okkākakulasambhavo;"],"lineRefs":[[]]},{"para":4224,"vripara":null,"refs":[],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[[]]},{"para":4225,"vripara":null,"refs":[],"lines":["“Devalokā cavitvāna, sukkamūlena codito;"],"lineRefs":[[]]},{"para":4226,"vripara":null,"refs":[],"lines":["Puññakammena saññutto, brahmabandhu bhavissasi."],"lineRefs":[[]]},{"para":4227,"vripara":null,"refs":[],"lines":["“Asītikoṭiṃ chaḍḍetvā, dāse kammakare bahū;"],"lineRefs":[[]]},{"para":4228,"vripara":null,"refs":[],"lines":["Gotamassa bhagavato, sāsane pabbajissasi."],"lineRefs":[[]]},{"para":4229,"vripara":null,"refs":[],"lines":["“Ārādhayitvā sambuddhaṃ, gotamaṃ sakyapuṅgavaṃ;"],"lineRefs":[[]]},{"para":4230,"vripara":null,"refs":[],"lines":["Upavāṇoti nāmena, hessasi satthu sāvako."],"lineRefs":[[]]},{"para":4231,"vripara":null,"refs":[],"lines":["“Satasahasse kataṃ kammaṃ, phalaṃ dassesi me idha;"],"lineRefs":[[]]},{"para":4232,"vripara":null,"refs":[],"lines":["Sumutto saravegova, kilese jhāpayiṃ mama."],"lineRefs":[[]]},{"para":4233,"vripara":null,"refs":[],"lines":["“Cakkavattissa santassa, cātuddīpissarassa me;"],"lineRefs":[[]]},{"para":4234,"vripara":null,"refs":[],"lines":["Tīṇi yojanāni sāmantā, ussīyanti dhajā sadā."],"lineRefs":[[]]},{"para":4235,"vripara":null,"refs":[],"lines":["“Satasahassito kappe, yaṃ kammamakariṃ tadā;"],"lineRefs":[[]]},{"para":4236,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, dhajadānassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":4237,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":4238,"vripara":null,"refs":[],"lines":["Athāyasmā upavāṇo bhagavato upaṭṭhāko ahosi.","Tena ca samayena bhagavato vātābādho uppajji.","Therassa ca gihisahāyo devahito nāma brāhmaṇo sāvatthiyaṃ paṭivasati.","So theraṃ catūhi paccayehi pavedesi.","Athāyasmā upavāṇo nivāsetvā pattacīvaramādāya tassa brāhmaṇassa nivesanaṃ upagacchi.","Brāhmaṇo “kenaci aññena payojanena thero āgato”ti ñatvā,“vadeyyātha, bhante, kenattho”ti āha.","Thero tassa brāhmaṇassa payojanaṃ ācikkhanto –"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":4240,"vripara":"185","refs":[],"lines":["“Arahaṃ sugato loke, vātehābādhiko muni;"],"lineRefs":[[]]},{"para":4241,"vripara":null,"refs":[],"lines":["Sace uṇhodakaṃ atthi, munino dehi brāhmaṇa."],"lineRefs":[[]]},{"para":4243,"vripara":"186","refs":[],"lines":["“Pūjito pūjaneyyānaṃ, sakkareyyāna sakkato;"],"lineRefs":[[]]},{"para":4244,"vripara":null,"refs":[],"lines":["Apacitopaceyyānaṃ, tassa icchāmi hātave”ti.","– gāthādvayaṃ abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
