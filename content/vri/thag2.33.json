{"suttaId":"thag2.33","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[984,990],"vripara":"185"},"segments":{"thag2.33:0.4":"Upavāṇattheragāthā","thag2.33:1.1":"“Arahaṃ sugato loke,","thag2.33:1.2":"vātehābādhito [… bādhito (ka.)] muni;","thag2.33:1.3":"Sace uṇhodakaṃ atthi,","thag2.33:1.4":"munino dehi brāhmaṇa. 186.","thag2.33:2.1":"“Pūjito pūjaneyyānaṃ [pūjanīyānaṃ (sī.)],","thag2.33:2.2":"sakkareyyāna sakkato;","thag2.33:2.3":"Apacitopaceyyānaṃ [apacanīyānaṃ (sī.), apacineyyānaṃ (syā.)],","thag2.33:2.4":"tassa icchāmi hātave”ti. …","thag2.33:2.5":"Upavāṇo thero…. 4."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":4245,"to":4245,"paras":[{"para":4245,"vripara":null,"refs":["thag2.33:2"],"lines":["Tassattho – yo imasmiṃ <b>loke pūjaneyyānaṃ</b> pūjetabbehi sakkādīhi devehi mahābrahmādīhi ca brahmehi <b>pūjito, sakkareyyānaṃ</b> sakkātabbehi bimbisārakosalarājādīhi <b>sakkato, apaceyyānaṃ</b> apacāyitabbehi mahesīhi khīṇāsavehi <b>apacito,</b> kilesehi ārakattādinā <b>arahaṃ,</b> sobhanagamanādinā <b>sugato</b> sabbaññū <b>muni</b> mayhaṃ satthā devadevo sakkānaṃ atisakko brahmānaṃ atibrahmā, so dāni <b>vātehi</b> vātahetu vātakkhobhanimittaṃ <b>ābādhiko</b> jāto.","<b>Sace, brāhmaṇa, uṇhodakaṃ atthi, tassa</b> vātābādhavūpasamanatthaṃ taṃ <b>hātave</b> upanetuṃ <b>icchāmī</b>ti.","Taṃ sutvā brāhmaṇo uṇhodakaṃ tadanurūpaṃ vātārahañca bhesajjaṃ bhagavato upanāmesi.","Tena ca satthu rogo vūpasami.","Tassa bhagavā anumodanaṃ akāsīti."],"lineRefs":[["thag2.33:2"],["thag2.33:2"],["thag2.33:2"],["thag2.33:2"],["thag2.33:2"]]}],"wordLinks":[["thag2.33:2.3","apacito",0,0],["thag2.33:2.3","hātave",0,1],["thag2.33:2.3","icchāmī",0,1]],"before":[{"para":4127,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Upavāṇattheragāthāvaṇṇanā"]},{"para":4128,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["<b>Arahaṃ sugato</b>ti āyasmato upavāṇattherassa gāthā.","Kā uppatti?","Ayaṃ kira padumuttarassa bhagavato kāle daliddakule nibbattitvā viññutaṃ patto bhagavati parinibbute tassa dhātuṃ gahetvā manussadevanāgagaruḷakumbhaṇḍayakkhagandhabbehi sattaratanamaye sattayojanike thūpe kate tattha sudhotaṃ attano uttarāsaṅgaṃ veḷagge ābandhitvā dhajaṃ katvā pūjaṃ akāsi.","Taṃ gahetvā abhisammatako nāma yakkhasenāpati devehi cetiyapūjārakkhaṇatthaṃ ṭhapito adissamānakāyo ākāse dhārento cetiyaṃ tikkhattuṃ padakkhiṇaṃ akāsi.","So taṃ disvā bhiyyosomattāya pasannamānaso ahosi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇakule nibbattitvā <b>upavāṇo</b>ti laddhanāmo vayappatto jetavanapaṭiggahaṇe buddhānubhāvaṃ disvā paṭiladdhasaddho pabbajitvā vipassanāya kammaṃ karonto arahattaṃ patvā chaḷabhiñño ahosi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.56.122-178) –"]},{"para":4129,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Padumuttaro nāma jino, sabbadhammāna pāragū;"]},{"para":4130,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Jalitvā aggikkhandhova, sambuddho parinibbuto."]},{"para":4131,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Mahājanā samāgamma, pūjayitvā tathāgataṃ;"]},{"para":4132,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Cittaṃ katvāna sugataṃ, sarīraṃ abhiropayuṃ."]},{"para":4133,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Sarīrakiccaṃ katvāna, dhātuṃ tattha samānayuṃ;"]},{"para":4134,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Sadevamanussā sabbe, buddhathūpaṃ akaṃsu te."]},{"para":4135,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Paṭhamā kañcanamayā, dutiyā ca maṇimayā;"]},{"para":4136,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Tatiyā rūpiyamayā, catutthī phalikāmayā."]},{"para":4137,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Tattha pañcamikā ceva, lohitaṅkamayā ahu;"]},{"para":4138,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Chaṭṭhā masāragallassa, sabbaṃ ratanamayūpari."]},{"para":4139,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Jaṅghā maṇimayā āsi, vedikā ratanāmayā;"]},{"para":4140,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Sabbasoṇṇamayo thūpo, uddhaṃ yojanamuggato."]},{"para":4141,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Devā tattha samāgantvā, ekato mantayuṃ tadā;"]},{"para":4142,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Mayampi thūpaṃ kassāma, lokanāthassa tādino."]},{"para":4143,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Dhātu āveṇikā natthi, sarīraṃ ekapiṇḍitaṃ;"]},{"para":4144,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Imamhi buddhathūpamhi, kassāma kañcukaṃ mayaṃ."]},{"para":4145,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Devā sattahi ratnehi, aññaṃ vaḍḍhesuṃ yojanaṃ;"]},{"para":4146,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Thūpo dviyojanubbedho, timiraṃ byapahanti so."]},{"para":4147,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Nāgā tattha samāgantvā, ekato mantayuṃ tadā;"]},{"para":4148,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Manussā ceva devā ca, buddhathūpaṃ akaṃsu te."]},{"para":4149,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Mā no pamattā assumha, appamattā sadevakā;"]},{"para":4150,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Mayampi thūpaṃ kassāma, lokanāthassa tādino."]},{"para":4151,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Indanīlaṃ mahānīlaṃ, atho jotirasaṃ maṇiṃ;"]},{"para":4152,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Ekato sannipātetvā, buddhathūpaṃ achādayuṃ."]},{"para":4153,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Sabbaṃ maṇimayaṃ āsi, yāvatā buddhacetiyaṃ;"]},{"para":4154,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Tiyojanasamubbedhaṃ, ālokakaraṇaṃ tadā."]},{"para":4155,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Garuḷā ca samāgantvā, ekato mantayuṃ tadā;"]},{"para":4156,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Manussā devanāgā ca, buddhapūjaṃ akaṃsu te."]},{"para":4157,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Mā no pamattā assumha, appamattā sadevakā;"]},{"para":4158,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Mayampi thūpaṃ kassāma, lokanāthassa tādino."]},{"para":4159,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Sabbaṃ maṇimayaṃ thūpaṃ, akaruṃ te ca kañcukaṃ;"]},{"para":4160,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Yojanaṃ tepi vaḍḍhesuṃ, āyataṃ buddhacetiyaṃ."]},{"para":4161,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Catuyojanamubbedho, buddhathūpo virocati;"]},{"para":4162,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Obhāseti disā sabbā, sataraṃsīva uggato."]},{"para":4163,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Kumbhaṇḍā ca samāgantvā, ekato mantayuṃ tadā;"]},{"para":4164,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Manussā ceva devā ca, nāgā ca garuḷā tathā."]},{"para":4165,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Paccekaṃ buddhaseṭṭhassa, akaṃsu thūpamuttamaṃ;"]},{"para":4166,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Mā no pamattā assumha, appamattā sadevakā."]},{"para":4167,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Mayampi thūpaṃ kassāma, lokanāthassa tādino;"]},{"para":4168,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Ratanehi chādessāma, āyataṃ buddhacetiyaṃ."]},{"para":4169,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Yojanaṃ tepi vaḍḍhesuṃ, āyataṃ buddhacetiyaṃ;"]},{"para":4170,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Pañcayojanamubbedho, thūpo obhāsate tadā."]},{"para":4171,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Yakkhā tattha samāgantvā, ekato mantayuṃ tadā;"]},{"para":4172,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Manussā devanāgā ca, garuḷā ca kumbhaṇḍakā."]},{"para":4173,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Paccekaṃ buddhaseṭṭhassa, akaṃsu thūpamuttamaṃ;"]},{"para":4174,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Mā no pamattā assumha, appamattā sadevakā."]},{"para":4175,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Mayampi thūpaṃ kassāma, lokanāthassa tādino;"]},{"para":4176,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Phalikā chādayissāma, āyataṃ buddhacetiyaṃ."]},{"para":4177,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Yojanaṃ tepi vaḍḍhesuṃ, āyataṃ buddhacetiyaṃ;"]},{"para":4178,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Chayojanikamubbedho, thūpo obhāsate tadā."]},{"para":4179,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Gandhabbā ca samāgantvā, ekato mantayuṃ tadā;"]},{"para":4180,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Manujā devatā nāgā, kumbhaṇḍā garuḷā tathā."]},{"para":4181,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Sabbe akaṃsu buddhathūpaṃ, mayamettha akārakā;"]},{"para":4182,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Mayampi thūpaṃ kassāma, lokanāthassa tādino."]},{"para":4183,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Vediyo satta katvāna, dhajaṃ chattaṃ akaṃsu te;"]},{"para":4184,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Sabbasoṇṇamayaṃ thūpaṃ, gandhabbā kārayuṃ tadā."]},{"para":4185,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Sattayojanamubbedho, thūpo obhāsate tadā;"]},{"para":4186,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Rattindivā na ñāyanti, āloko hoti sabbadā."]},{"para":4187,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Abhibhonti na tassābhā, candasūrā satārakā;"]},{"para":4188,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Samantā yojanasate, padīpopi na pajjali."]},{"para":4189,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Tena kālena ye keci, thūpaṃ pūjenti mānusā;"]},{"para":4190,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Na te thūpaṃ āruhanti, ambare ukkhipanti te."]},{"para":4191,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Devehi ṭhapito yakkho, abhisammatanāmako;"]},{"para":4192,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Dhajaṃ vā pupphadāmaṃ vā, abhiropeti uttariṃ."]},{"para":4193,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Na te passanti taṃ yakkhaṃ, dāmaṃ passanti gacchato;"]},{"para":4194,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Evaṃ passitvā gacchantā, sabbe gacchanti suggatiṃ."]},{"para":4195,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Viruddhā ye pāvacane, pasannā ye ca sāsane;"]},{"para":4196,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Pāṭihīraṃ daṭṭhukāmā, thūpaṃ pūjenti mānusā."]},{"para":4197,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Nagare haṃsavatiyā, ahosiṃ bhatako tadā;"]},{"para":4198,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Āmoditaṃ janaṃ disvā, evaṃ cintesahaṃ tadā."]},{"para":4199,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Uḷāro bhagavā neso, yassa dhātughare disaṃ;"]},{"para":4200,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Imā ca janatā tuṭṭhā, kāraṃ kubbaṃ na tappare."]},{"para":4201,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Ahampi kāraṃ kassāmi, lokanāthassa tādino;"]},{"para":4202,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Tassa dhammesu dāyādo, bhavissāmi anāgate."]},{"para":4203,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Sudhotaṃ rajakenāhaṃ, uttareyyaṃ paṭaṃ mama;"]},{"para":4204,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Veḷagge ālaggetvāna, dhajaṃ ukkhipimambare."]},{"para":4205,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Abhisammatako gayha, ambare hāsi me dhajaṃ;"]},{"para":4206,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Vāteritaṃ dhajaṃ disvā, bhiyyo hāsaṃ janesahaṃ."]},{"para":4207,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Tattha cittaṃ pasādetvā, samaṇaṃ upasaṅkamiṃ;"]},{"para":4208,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Taṃ bhikkhuṃ abhivādetvā, vipākaṃ pucchahaṃ dhaje."]},{"para":4209,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“So me kathesi ānandī, pītisañjananaṃ mama;"]},{"para":4210,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Tassa dhajassa vipākaṃ, anubhossasi sabbadā."]},{"para":4211,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Hatthiassarathāpattī, senā ca caturaṅginī;"]},{"para":4212,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Parivāressanti taṃ niccaṃ, dhajadānassidaṃ phalaṃ."]},{"para":4213,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Saṭṭhitūriyasahassāni, bheriyo samalaṅkatā;"]},{"para":4214,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Parivāressanti taṃ niccaṃ, dhajadānassidaṃ phalaṃ."]},{"para":4215,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Chaḷasīti sahassāni, nāriyo samalaṅkatā;"]},{"para":4216,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Vicittavatthābharaṇā, āmukkamaṇikuṇḍalā."]},{"para":4217,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Aḷārapamhā hasulā, susaññā tanumajjhimā;"]},{"para":4218,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Parivāressanti taṃ niccaṃ, dhajadānassidaṃ phalaṃ."]},{"para":4219,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Tiṃsakappasahassāni, devaloke ramissasi;"]},{"para":4220,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Asītikkhattuṃ devindo, devarajjaṃ karissasi."]},{"para":4221,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Sahassakkhattuṃ rājā ca, cakkavattī bhavissati;"]},{"para":4222,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Padesarajjaṃ vipulaṃ, gaṇanāto asaṅkhiyaṃ."]},{"para":4223,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Kappasatasahassamhi, okkākakulasambhavo;"]},{"para":4224,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Gotamo nāma gottena, satthā loke bhavissati."]},{"para":4225,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Devalokā cavitvāna, sukkamūlena codito;"]},{"para":4226,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Puññakammena saññutto, brahmabandhu bhavissasi."]},{"para":4227,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Asītikoṭiṃ chaḍḍetvā, dāse kammakare bahū;"]},{"para":4228,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Gotamassa bhagavato, sāsane pabbajissasi."]},{"para":4229,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Ārādhayitvā sambuddhaṃ, gotamaṃ sakyapuṅgavaṃ;"]},{"para":4230,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Upavāṇoti nāmena, hessasi satthu sāvako."]},{"para":4231,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Satasahasse kataṃ kammaṃ, phalaṃ dassesi me idha;"]},{"para":4232,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Sumutto saravegova, kilese jhāpayiṃ mama."]},{"para":4233,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Cakkavattissa santassa, cātuddīpissarassa me;"]},{"para":4234,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Tīṇi yojanāni sāmantā, ussīyanti dhajā sadā."]},{"para":4235,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Satasahassito kappe, yaṃ kammamakariṃ tadā;"]},{"para":4236,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, dhajadānassidaṃ phalaṃ."]},{"para":4237,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti."]},{"para":4238,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Athāyasmā upavāṇo bhagavato upaṭṭhāko ahosi.","Tena ca samayena bhagavato vātābādho uppajji.","Therassa ca gihisahāyo devahito nāma brāhmaṇo sāvatthiyaṃ paṭivasati.","So theraṃ catūhi paccayehi pavedesi.","Athāyasmā upavāṇo nivāsetvā pattacīvaramādāya tassa brāhmaṇassa nivesanaṃ upagacchi.","Brāhmaṇo “kenaci aññena payojanena thero āgato”ti ñatvā, “vadeyyātha, bhante, kenattho”ti āha.","Thero tassa brāhmaṇassa payojanaṃ ācikkhanto – 185."]},{"para":4240,"vripara":"185","title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Arahaṃ sugato loke, vātehābādhiko muni;"]},{"para":4241,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Sace uṇhodakaṃ atthi, munino dehi brāhmaṇa. 186."]},{"para":4243,"vripara":"186","title":"Upavāṇattheragāthāvaṇṇanā","lines":["“Pūjito pūjaneyyānaṃ, sakkareyyāna sakkato;"]},{"para":4244,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Apacitopaceyyānaṃ, tassa icchāmi hātave”ti. –","gāthādvayaṃ abhāsi;"]}],"after":[{"para":4246,"vripara":null,"title":"Upavāṇattheragāthāvaṇṇanā","lines":["Upavāṇattheragāthāvaṇṇanā niṭṭhitā. 4."]}]},"tika":null,"tika2":null}
