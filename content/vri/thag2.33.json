{"suttaId":"thag2.33","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[984,990],"vripara":"185"},"segments":{"thag2.33:0.4":"Upavāṇattheragāthā","thag2.33:1.1":"“Arahaṃ sugato loke, vātehābādhito [… bādhito (ka.)] muni;","thag2.33:1.3":"Sace uṇhodakaṃ atthi, munino dehi brāhmaṇa.","thag2.33:2.1":"“Pūjito pūjaneyyānaṃ [pūjanīyānaṃ (sī.)], sakkareyyāna sakkato;","thag2.33:2.3":"Apacitopaceyyānaṃ [apacanīyānaṃ (sī.), apacineyyānaṃ (syā.)], tassa icchāmi hātave”ti.","thag2.33:2.5":"… Upavāṇo thero …."},"attha":null,"tika":null}
