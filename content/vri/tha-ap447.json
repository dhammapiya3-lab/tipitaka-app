{"suttaId":"tha-ap447","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[915,929],"vripara":"31"},"segments":{"tha-ap447:0.3":"Uttalipupphiyattheraapadānaṃ","tha-ap447:1.1":"“Nigrodhe haritobhāse,","tha-ap447:1.2":"saṃviruḷhamhi pādape;","tha-ap447:1.3":"Uttalimālaṃ [ummā mālaṃ hi (syā.)] paggayha,","tha-ap447:1.4":"bodhiyā abhiropayiṃ.","tha-ap447:2.1":"“Imasmiṃyeva kappamhi,","tha-ap447:2.2":"yaṃ bodhimabhipūjayiṃ;","tha-ap447:2.3":"Duggatiṃ nābhijānāmi,","tha-ap447:2.4":"bodhipūjāyidaṃ phalaṃ.","tha-ap447:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap447:3.3":"viharāmi anāsavo.","tha-ap447:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap447:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap447:5.1":"“Paṭisambhidā catasso … pe …","tha-ap447:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap447:6.1":"Itthaṃ sudaṃ āyasmā uttalipupphiyo thero imā gāthāyo Abhāsitthāti.","tha-ap447:7.1":"Uttalipupphiyattherassāpadānaṃ pañcamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
