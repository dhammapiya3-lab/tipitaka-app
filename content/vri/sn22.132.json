{"suttaId":"sn22.132","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[806,807],"vripara":"132"},"segments":{"sn22.132:0.3":"Dutiyasamudayasuttaṃ","sn22.132:1.1":"Bārāṇasiyaṃ viharanti isipatane migadāye…pe…","sn22.132:1.2":"ekamantaṃ nisinno kho āyasmā mahākoṭṭhiko āyasmantaṃ sāriputtaṃ etadavoca –","sn22.132:1.3":"“‘vijjā, vijjā’ti, āvuso sāriputta, vuccati.","sn22.132:1.4":"Katamā nu kho, āvuso, vijjā,","sn22.132:1.5":"kittāvatā ca vijjāgato hotī”ti?","sn22.132:2.1":"“Idhāvuso, sutavā ariyasāvako rūpassa samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ pajānāti.","sn22.132:2.2":"Vedanāya…pe…","sn22.132:2.3":"saññāya…","sn22.132:2.4":"saṅkhārānaṃ…","sn22.132:2.5":"viññāṇassa samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ pajānāti.","sn22.132:2.6":"Ayaṃ vuccatāvuso, vijjā;","sn22.132:2.7":"ettāvatā ca vijjāgato hotī”ti.","sn22.132:2.8":"Sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":387,"to":390,"paras":[{"para":387,"vripara":"126-135","refs":["sn22.132:1"],"lines":["Avijjāvaggo uttānatthova.","Imasmiñhi vagge sabbasuttesu catusaccameva kathitaṃ."],"lineRefs":[["sn22.132:1"],["sn22.132:1"]]},{"para":388,"vripara":null,"refs":["sn22.132:1"],"lines":["Avijjāvaggo terasamo. 14."],"lineRefs":[["sn22.132:1"]]},{"para":389,"vripara":null,"refs":["sn22.132:1"],"lines":["Kukkuḷavaggo 1-13."],"lineRefs":[["sn22.132:1"]]},{"para":390,"vripara":null,"refs":["sn22.132:1"],"lines":["Kukkuḷasuttādivaṇṇanā 136-149."],"lineRefs":[["sn22.132:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":390,"to":394,"paras":[{"para":390,"vripara":"126-135","refs":["sn22.132:1"],"lines":["<b>Imasmi</b>nti avijjāvagge.","<b>Catusaccameva kathitaṃ, tasmā</b> heṭṭhā vuttanayattā uttānamevāti adhippāyo."],"lineRefs":[["sn22.132:1"],["sn22.132:1"]]},{"para":391