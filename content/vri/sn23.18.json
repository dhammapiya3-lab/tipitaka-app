{"suttaId":"sn23.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[937,937],"vripara":"177"},"segments":{"sn23.18:0.3":"Anattadhammasuttaṃ","sn23.18:1.1":"Sāvatthinidānaṃ.","sn23.18:1.2":"Ekamantaṃ nisinno kho āyasmā rādho bhagavantaṃ etadavoca –","sn23.18:1.3":"“‘anattadhammo, anattadhammo’ti, bhante, vuccati.","sn23.18:1.4":"Katamo nu kho, bhante, anattadhammo”ti?","sn23.18:1.5":"“Rūpaṃ kho, rādha, anattadhammo, vedanā anattadhammo, saññā anattadhammo, saṅkhārā anattadhammo, viññāṇaṃ anattadhammo.","sn23.18:1.6":"Evaṃ passaṃ … pe … nāparaṃ itthattāyāti pajānātī”ti.","sn23.18:1.8":"Aṭṭhamaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":410,"to":413,"paras":[{"para":410,"vripara":"170-181","refs":["sn23.18:1"],"lines":["170-181. Dutiyavaggassa paṭhame <b>māro, māro</b>ti maraṇaṃ pucchati.","Yasmā pana rūpādivinimuttaṃ maraṇaṃ nāma natthi, tenassa bhagavā <b>rūpaṃ kho, rādha, māro</b>tiādimāha.","Dutiye <b>māradhammo</b>ti maraṇadhammo.","Etenupāyena sabbattha attho veditabboti."],"lineRefs":[["sn23.18:1"],["sn23.18:1"],["sn23.18:1"],["sn23.18:1"]]},{"para":411,"vripara":null,"refs":[],"lines":["Dutiyo vaggo."],"lineRefs":[[]]},{"para":412,"vripara":null,"refs":[],"lines":["3-4. Āyācanavaggādi"],"lineRefs":[[]]},{"para":413,"vripara":null,"refs":["sn23.18:1"],"lines":["1-11. Mārādisuttaekādasakavaṇṇanā"],"lineRefs":[["sn23.18:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":420,"to":424,"paras":[{"para":420,"vripara":"170-181","refs":["sn23.18:1"],"lines":["170-181. <b>Rūpādivinimuttaṃ maraṇaṃ nāma natthi</b> rūpādīnaṃyeva vibhave maraṇasamaññāti.","<b>Maraṇadhammo</b> vināsabhāvo."],"lineRefs":[["sn23.18:1"],["sn23.18:1"]]},{"para":421,"vripara":null,"refs":[],"lines":["Mārasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":422,"vripara":null,"refs":[],"lines":["Dutiyavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":423,"vripara":null,"refs":[],"lines":["3-4. Āyācanavaggādi"],"lineRefs":[[]]},{"para":424,"vripara":null,"refs":["sn23.18:1"],"lines":["1-11. Mārādisuttaekādasakavaṇṇanā"],"lineRefs":[["sn23.18:1"]]}],"wordLinks":[]}}
