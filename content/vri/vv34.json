{"suttaId":"vv34","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1302,1382],"vripara":"619"},"segments":{"vv34:0.4":"Daddallavimānavatthu","vv34:1.1":"“Daddallamānā [daddaḷhamānā (ka.)] vaṇṇena,","vv34:1.2":"yasasā ca yasassinī;","vv34:1.3":"Sabbe deve tāvatiṃse,","vv34:1.4":"vaṇṇena atirocasi. 620.","vv34:2.1":"“Dassanaṃ nābhijānāmi,","vv34:2.2":"idaṃ paṭhamadassanaṃ;","vv34:2.3":"Kasmā kāyā nu āgamma,","vv34:2.4":"nāmena bhāsase mama”nti. 621.","vv34:3.1":"“Ahaṃ bhadde subhaddāsiṃ,","vv34:3.2":"pubbe mānusake bhave;","vv34:3.3":"Sahabhariyā ca te āsiṃ,","vv34:3.4":"bhaginī ca kaniṭṭhikā. 622.","vv34:4.1":"“Sā ahaṃ kāyassa bhedā,","vv34:4.2":"vippamuttā tato cutā;","vv34:4.3":"Nimmānaratīnaṃ devānaṃ,","vv34:4.4":"upapannā sahabyata”nti. 623.","vv34:5.1":"“Pahūtakatakalyāṇā,","vv34:5.2":"te deve yanti pāṇino;","vv34:5.3":"Yesaṃ tvaṃ kittayissasi,","vv34:5.4":"subhadde jātimattano. 624.","vv34:6.1":"“Atha [kathaṃ (sī. syā.)] tvaṃ kena vaṇṇena,","vv34:6.2":"kena vā anusāsitā;","vv34:6.3":"Kīdiseneva dānena,","vv34:6.4":"subbatena yasassinī. 625.","vv34:7.1":"“Yasaṃ etādisaṃ pattā,","vv34:7.2":"visesaṃ vipulamajjhagā;","vv34:7.3":"Devate pucchitācikkha,","vv34:7.4":"kissa kammassidaṃ phala”nti. 626.","vv34:8.1":"“Aṭṭheva piṇḍapātāni,","vv34:8.2":"yaṃ dānaṃ adadaṃ pure;","vv34:8.3":"Dakkhiṇeyyassa saṅghassa,","vv34:8.4":"pasannā sehi pāṇibhi. 627.","vv34:9.1":"“Tena metādiso vaṇṇo…pe…","vv34:9.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti. 629.","vv34:10.1":"“Ahaṃ tayā bahutare bhikkhū,","vv34:10.2":"saññate brahmacārayo [brahmacarino (syā.), brahmacāriye (pī. ka.)];","vv34:10.3":"Tappesiṃ annapānena,","vv34:10.4":"pasannā sehi pāṇibhi. 630.","vv34:11.1":"“Tayā bahutaraṃ datvā,","vv34:11.2":"hīnakāyūpagā ahaṃ [ahuṃ (ka. sī.)];","vv34:11.3":"Kathaṃ tvaṃ appataraṃ datvā,","vv34:11.4":"visesaṃ vipulamajjhagā;","vv34:11.5":"Devate pucchitācikkha,","vv34:11.6":"kissa kammassidaṃ phala”nti. 631.","vv34:12.1":"“Manobhāvanīyo bhikkhu,","vv34:12.2":"sandiṭṭho me pure ahu;","vv34:12.3":"Tāhaṃ bhattena [bhadde (ka.)] nimantesiṃ,","vv34:12.4":"revataṃ attanaṭṭhamaṃ. 632.","vv34:13.1":"“So me atthapurekkhāro,","vv34:13.2":"anukampāya revato;","vv34:13.3":"Saṅghe dehīti maṃvoca,","vv34:13.4":"tassāhaṃ vacanaṃ kariṃ. 633.","vv34:14.1":"“Sā dakkhiṇā saṅghagatā,","vv34:14.2":"appameyye patiṭṭhitā;","vv34:14.3":"Puggalesu tayā dinnaṃ,","vv34:14.4":"na taṃ tava mahapphala”nti. 634.","vv34:15.1":"“Idānevāhaṃ jānāmi,","vv34:15.2":"saṅghe dinnaṃ mahapphalaṃ;","vv34:15.3":"Sāhaṃ gantvā manussattaṃ,","vv34:15.4":"vadaññū vītamaccharā;","vv34:15.5":"Saṅghe dānāni dassāmi [saṅghe dānaṃ dassāmihaṃ (syā.)],","vv34:15.6":"appamattā punappuna”nti. 635.","vv34:16.1":"“Kā esā devatā bhadde,","vv34:16.2":"tayā mantayate saha;","vv34:16.3":"Sabbe deve tāvatiṃse,","vv34:16.4":"vaṇṇena atirocatī”ti. 636.","vv34:17.1":"“Manussabhūtā devinda,","vv34:17.2":"pubbe mānusake bhave;","vv34:17.3":"Sahabhariyā ca me āsi,","vv34:17.4":"bhaginī ca kaniṭṭhikā;","vv34:17.5":"Saṅghe dānāni datvāna,","vv34:17.6":"katapuññā virocatī”ti. 637.","vv34:18.1":"“Dhammena pubbe bhaginī,","vv34:18.2":"tayā bhadde virocati;","vv34:18.3":"Yaṃ saṅghamhi appameyye,","vv34:18.4":"patiṭṭhāpesi dakkhiṇaṃ. 638.","vv34:19.1":"“Pucchito hi mayā buddho,","vv34:19.2":"gijjhakūṭamhi pabbate;","vv34:19.3":"Vipākaṃ saṃvibhāgassa,","vv34:19.4":"yattha dinnaṃ mahapphalaṃ. 639.","vv34:20.1":"“Yajamānānaṃ manussānaṃ,","vv34:20.2":"puññapekkhāna pāṇinaṃ;","vv34:20.3":"Karotaṃ opadhikaṃ puññaṃ,","vv34:20.4":"yattha dinnaṃ mahapphalaṃ. 640.","vv34:21.1":"“Taṃ me buddho viyākāsi,","vv34:21.2":"jānaṃ kammaphalaṃ sakaṃ;","vv34:21.3":"Vipākaṃ saṃvibhāgassa,","vv34:21.4":"yattha dinnaṃ mahapphalaṃ. 641. [vi. va. 750; kathā. 798]","vv34:22.1":"“Cattāro ca paṭipannā,","vv34:22.2":"cattāro ca phale ṭhitā;","vv34:22.3":"Esa saṅgho ujubhūto,","vv34:22.4":"paññāsīlasamāhito. 642. [vi. va. 751; kathā. 798]","vv34:23.1":"“Yajamānānaṃ manussānaṃ,","vv34:23.2":"puññapekkhāna pāṇinaṃ;","vv34:23.3":"Karotaṃ opadhikaṃ puññaṃ,","vv34:23.4":"saṅghe dinnaṃ mahapphalaṃ. 643. [vi. va. 752; kathā. 798]","vv34:24.1":"“Eso hi saṅgho vipulo mahaggato,","vv34:24.2":"esappameyyo udadhīva sāgaro;","vv34:24.3":"Ete hi seṭṭhā naravīrasāvakā,","vv34:24.4":"pabhaṅkarā dhammamudīrayanti [dhammakathaṃ udīrayanti (syā.)]. 644. [vi. va. 753; kathā. 798]","vv34:25.1":"“Tesaṃ sudinnaṃ suhutaṃ suyiṭṭhaṃ,","vv34:25.2":"ye saṅghamuddissa dadanti dānaṃ;","vv34:25.3":"Sā dakkhiṇā saṅghagatā patiṭṭhitā,","vv34:25.4":"mahapphalā lokavidūna [lokavidūhi (syā. ka.)] vaṇṇitā. 645. [vi. va. 754; kathā. 798]","vv34:26.1":"“Etādisaṃ yaññamanussarantā [puññamanussarantā (syā. ka.)],","vv34:26.2":"ye vedajātā vicaranti loke;","vv34:26.3":"Vineyya maccheramalaṃ samūlaṃ,","vv34:26.4":"aninditā saggamupenti ṭhāna”nti.","vv34:27.1":"Daddallavimānaṃ [daddaḷhavimānaṃ (ka.)] chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1486,"to":1579,"paras":[{"para":1486,"vripara":"619-620","refs":["vv34:1"],"lines":["Tattha <b>vaṇṇenā</b>ti vaṇṇādisampattiyā.","<b>Dassanaṃ nābhijānāmī</b>ti ito pubbe tava dassanaṃ nābhijānāmi, tvaṃ mayā na diṭṭhapubbāti attho.","Tenāha <b>“idaṃ paṭhamadassana”nti.</b>","<b>Kasmā kāyā nu āgamma, nāmena bhāsase mama</b>nti kataradevanikāyato āgantvā “bhadde”ti nāmena maṃ ālapasi. 621."],"lineRefs":[["vv34:1"],["vv34:1"],["vv34:1"],["vv34:1"]]},{"para":1487,"vripara":"621","refs":["vv34:3"],"lines":["<b>Ahaṃ</b> <b>bhadde</b>ti ettha <b>bhadde</b>ti ālapanaṃ.","<b>Subhaddāsi</b>nti ahaṃ subhaddā nāma tava bhaginī kaniṭṭhikā āsiṃ ahosiṃ, tattha pubbe mānusake bhave sahabhariyā samānabhariyā te tayā ekasseva bhariyā, tava patino eva bhariyā, āsinti attho.","Puna bhaddā – 623."],"lineRefs":[["vv34:3"],["vv34:3"],["vv34:3"]]},{"para":1489,"vripara":"623","refs":["vv34:3"],"lines":["“Pahūtakatakalyāṇā, te deve yanti pāṇino;"],"lineRefs":[["vv34:3"]]},{"para":1490,"vripara":null,"refs":["vv34:3"],"lines":["Yesaṃ tvaṃ kittayissasi, subhadde jātimattano. 624."],"lineRefs":[["vv34:3"]]},{"para":1492,"vripara":"624","refs":["vv34:3"],"lines":["“Atha tvaṃ kena vaṇṇena, kena vā anusāsitā;"],"lineRefs":[["vv34:3"]]},{"para":1493,"vripara":null,"refs":["vv34:3"],"lines":["Kīdiseneva dānena, subbatena yasassinī. 625."],"lineRefs":[["vv34:3"]]},{"para":1495,"vripara":"625","refs":["vv34:3"],"lines":["“Yasaṃ etādisaṃ pattā, visesaṃ vipulamajjhagā;"],"lineRefs":[["vv34:3"]]},{"para":1496,"vripara":null,"refs":["vv34:3"],"lines":["Devate pucchitācikkha, kissa kammassidaṃ phala”nti. –"],"lineRefs":[["vv34:3"]]},{"para":1497,"vripara":null,"refs":["vv34:3"],"lines":["Tīhi gāthāhi pucchi.","Puna subhaddā – 626."],"lineRefs":[["vv34:3"],["vv34:3"]]},{"para":1499,"vripara":"626","refs":["vv34:3"],"lines":["“Aṭṭheva piṇḍapātāni, yaṃ dānaṃ adadaṃ pure;"],"lineRefs":[["vv34:3"]]},{"para":1500,"vripara":null,"refs":["vv34:3"],"lines":["Dakkhiṇeyyassa saṅghassa, pasannā sehi pāṇibhi. 627."],"lineRefs":[["vv34:3"]]},{"para":1502,"vripara":"627","refs":["vv34:3"],"lines":["“Tena metādiso vaṇṇo…pe…"],"lineRefs":[["vv34:3"]]},{"para":1503,"vripara":null,"refs":["vv34:3"],"lines":["Vaṇṇo ca me sabbadisā pabhāsatī”ti. –"],"lineRefs":[["vv34:3"]]},{"para":1504,"vripara":null,"refs":["vv34:3"],"lines":["Byākāsi. 623."],"lineRefs":[["vv34:3"]]},{"para":1505,"vripara":"623","refs":["vv34:5"],"lines":["Tattha <b>pahūtakatakalyāṇā te deve yantī</b>ti pahūtakatakalyāṇā mahāpuññā <b>te</b> nimmānaratino deve <b>yanti</b> uppajjanavasena gacchanti <b>pāṇino</b> sattā, <b>yesaṃ</b> nimmānaratīnaṃ devānaṃ antare <b>tvaṃ attano jātiṃ kittayissasi</b> kathesīti yojanā. 624."],"lineRefs":[["vv34:5"]]},{"para":1506,"vripara":"624","refs":["vv34:6"],"lines":["<b>Kena vaṇṇenā</b>ti kena kāraṇena.","<b>Kīdisenevā</b>ti evasaddo samuccayattho, kīdisena cāti attho, ayameva vā pāṭho.","<b>Subbatenā</b>ti sundarena vatena, suvisuddhena sīlenāti attho. 626."],"lineRefs":[["vv34:6"],["vv34:6"],["vv34:6"]]},{"para":1507,"vripara":"626","refs":["vv34:8"],"lines":["<b>Aṭṭheva</b> <b>piṇḍapātānī</b>ti aṭṭhannaṃ bhikkhūnaṃ dinnapiṇḍapāte sandhāya vadati.","<b>Adada</b>nti adāsiṃ."],"lineRefs":[["vv34:8"],["vv34:8"]]},{"para":1508,"vripara":null,"refs":["vv34:8"],"lines":["Evaṃ subhaddāya kathite puna bhaddā – 629."],"lineRefs":[["vv34:8"]]},{"para":1510,"vripara":"629","refs":["vv34:8"],"lines":["“Ahaṃ tayā bahutare bhikkhū, saññate brahmacārayo;"],"lineRefs":[["vv34:8"]]},{"para":1511,"vripara":null,"refs":["vv34:8"],"lines":["Tappesiṃ annapānena, pasannā sehi pāṇibhi. 630."],"lineRefs":[["vv34:8"]]},{"para":1513,"vripara":"630","refs":["vv34:8"],"lines":["“Tayā bahutaraṃ datvā, hīnakāyūpagā ahaṃ;"],"lineRefs":[["vv34:8"]]},{"para":1514,"vripara":null,"refs":["vv34:8"],"lines":["Kathaṃ tvaṃ appataraṃ datvā, visesaṃ vipulamajjhagā;"],"lineRefs":[["vv34:8"]]},{"para":1515,"vripara":null,"refs":["vv34:8"],"lines":["Devate pucchitācikkha, kissa kammassidaṃ phala”nti. –"],"lineRefs":[["vv34:8"]]},{"para":1516,"vripara":null,"refs":["vv34:8","vv34:11"],"lines":["Pucchi.","Tattha <b>tayā</b>ti nissakke karaṇavacanaṃ.","Puna subhaddā – 631."],"lineRefs":[["vv34:8"],["vv34:11"],["vv34:11"]]},{"para":1518,"vripara":"631","refs":["vv34:11"],"lines":["“Manobhāvanīyo bhikkhu, sandiṭṭho me pure ahu;"],"lineRefs":[["vv34:11"]]},{"para":1519,"vripara":null,"refs":["vv34:11"],"lines":["Tāhaṃ bhattena nimantesiṃ, revataṃ attanaṭṭhamaṃ. 632."],"lineRefs":[["vv34:11"]]},{"para":1521,"vripara":"632","refs":["vv34:11"],"lines":["“So me atthapurekkhāro, anukampāya revato;"],"lineRefs":[["vv34:11"]]},{"para":1522,"vripara":null,"refs":["vv34:11"],"lines":["Saṅghe dehīti maṃvoca, tassāhaṃ vacanaṃ kariṃ. 633."],"lineRefs":[["vv34:11"]]},{"para":1524,"vripara":"633","refs":["vv34:11"],"lines":["“Sā dakkhiṇā saṅghagatā, appameyye patiṭṭhitā;"],"lineRefs":[["vv34:11"]]},{"para":1525,"vripara":null,"refs":["vv34:11"],"lines":["Puggalesu tayā dinnaṃ, na taṃ tava mahapphala”nti. –"],"lineRefs":[["vv34:11"]]},{"para":1526,"vripara":null,"refs":["vv34:11"],"lines":["Attanā katakammaṃ kathesi. 631."],"lineRefs":[["vv34:11"]]},{"para":1527,"vripara":"631","refs":["vv34:12"],"lines":["Tattha <b>manobhāvanīyo</b>ti manavaḍḍhanako uḷāraguṇatāya sambhāvanīyo.","<b>Sandiṭṭho</b>ti nimantanavasena bodhito kathito.","Tenāha <b>“tāhaṃ bhattena nimantesiṃ, revataṃ attanaṭṭhama”</b>nti, taṃ manobhāvanīyaṃ ayyaṃ revataṃ attanaṭṭhamaṃ bhattena ahaṃ nimantesiṃ. 632-3."],"lineRefs":[["vv34:12"],["vv34:12"],["vv34:12"]]},{"para":1528,"vripara":"632-633","refs":["vv34:13"],"lines":["<b>So me atthapurekkhāro</b>ti so ayyo revato dānassa mahapphalabhāvakaraṇena mama atthapurekkhāro hitesī.","<b>Saṅghe dehīti maṃvocā</b>ti “yadi tvaṃ subhadde aṭṭhannaṃ bhikkhūnaṃ dātukāmā, yasmā puggalagatāya dakkhiṇāya saṅghagatā eva dakkhiṇā mahapphalatarā, tasmā saṅghe dehi, saṅghaṃ uddissa dānaṃ dehī”ti maṃ abhāsi.","<b>Ta</b>nti taṃ dānaṃ."],"lineRefs":[["vv34:13"],["vv34:13"],["vv34:13"]]},{"para":1529,"vripara":null,"refs":["vv34:13"],"lines":["Evaṃ subhaddāya vutte bhaddā tamatthaṃ sampaṭicchantī uttari ca tathā paṭipajjitukāmā – 634."],"lineRefs":[["vv34:13"]]},{"para":1531,"vripara":"634","refs":["vv34:13"],"lines":["“Idānevāhaṃ jānāmi, saṅghe dinnaṃ mahapphalaṃ;"],"lineRefs":[["vv34:13"]]},{"para":1532,"vripara":null,"refs":["vv34:13"],"lines":["Sāhaṃ gantvā manussattaṃ, vadaññū vītamaccharā;"],"lineRefs":[["vv34:13"]]},{"para":1533,"vripara":null,"refs":["vv34:13"],"lines":["Saṅghe dānāni dassāmi, appamattā punappuna”nti. –"],"lineRefs":[["vv34:13"]]},{"para":1534,"vripara":null,"refs":["vv34:13"],"lines":["Gāthamāha.","Subhaddā pana attano devalokameva gatā.","Atha sakko devānamindo sabbe deve tāvatiṃse attano sarīrobhāsena abhibhuyya virocamānaṃ subhaddaṃ devadhītaraṃ disvā tañca tāsaṃ kathāsallāpaṃ sutvā tāvadeva ca subhaddāya antarahitāya taṃ “ayaṃ nāmā”ti ajānanto – 635."],"lineRefs":[["vv34:13"],["vv34:13"],["vv34:13"]]},{"para":1536,"vripara":"635","refs":["vv34:13"],"lines":["“Kā esā devatā bhadde, tayā mantayate saha;"],"lineRefs":[["vv34:13"]]},{"para":1537,"vripara":null,"refs":["vv34:13"],"lines":["Sabbe deve tāvatiṃse, vaṇṇena atirocatī”ti. –"],"lineRefs":[["vv34:13"]]},{"para":1538,"vripara":null,"refs":["vv34:13"],"lines":["Bhaddaṃ pucchi.","Sāpissa – 636."],"lineRefs":[["vv34:13"],["vv34:13"]]},{"para":1540,"vripara":"636","refs":["vv34:13"],"lines":["“Manussabhūtā devinda, pubbe mānusake bhave;"],"lineRefs":[["vv34:13"]]},{"para":1541,"vripara":null,"refs":["vv34:13"],"lines":["Sahabhariyā ca me āsi, bhaginī ca kaniṭṭhikā,"],"lineRefs":[["vv34:13"]]},{"para":1542,"vripara":null,"refs":["vv34:13"],"lines":["Saṅghe dānāni datvāna, katapuññā virocatī”ti. –"],"lineRefs":[["vv34:13"]]},{"para":1543,"vripara":null,"refs":["vv34:13"],"lines":["Kathesi.","Atha sakko tassā saṅghagatāya dakkhiṇāya mahapphalabhāvaṃ dassento dhammaṃ kathesi.","Tena vuttaṃ – 637."],"lineRefs":[["vv34:13"],["vv34:13"],["vv34:13"]]},{"para":1545,"vripara":"637","refs":["vv34:13"],"lines":["“Dhammena pubbe bhaginī, tayā bhadde virocati;"],"lineRefs":[["vv34:13"]]},{"para":1546,"vripara":null,"refs":["vv34:13"],"lines":["Yaṃ saṅghamhi appameyye, patiṭṭhāpesi dakkhiṇaṃ. 638."],"lineRefs":[["vv34:13"]]},{"para":1548,"vripara":"638","refs":["vv34:13"],"lines":["“Pucchito hi mayā buddho, gijjhakūṭamhi pabbate;"],"lineRefs":[["vv34:13"]]},{"para":1549,"vripara":null,"refs":["vv34:13"],"lines":["Vipākaṃ saṃvibhāgassa, yattha dinnaṃ mahapphalaṃ. 639."],"lineRefs":[["vv34:13"]]},{"para":1551,"vripara":"639","refs":["vv34:13"],"lines":["“Yajamānānaṃ manussānaṃ, puññapekkhāna pāṇinaṃ;"],"lineRefs":[["vv34:13"]]},{"para":1552,"vripara":null,"refs":["vv34:13"],"lines":["Karotaṃ opadhikaṃ puññaṃ, yattha dinnaṃ mahapphalaṃ. 640."],"lineRefs":[["vv34:13"]]},{"para":1554,"vripara":"640","refs":["vv34:13"],"lines":["“Taṃ me buddho viyākāsi, jānaṃ kammaphalaṃ sakaṃ;"],"lineRefs":[["vv34:13"]]},{"para":1555,"vripara":null,"refs":["vv34:13"],"lines":["Vipākaṃ saṃvibhāgassa, yattha dinnaṃ mahapphalaṃ. 641."],"lineRefs":[["vv34:13"]]},{"para":1557,"vripara":"641","refs":["vv34:13"],"lines":["“Cattāro ca paṭipannā, cattāro ca phale ṭhitā;"],"lineRefs":[["vv34:13"]]},{"para":1558,"vripara":null,"refs":["vv34:13"],"lines":["Esa saṅgho ujubhūto, paññāsīlasamāhito. 642."],"lineRefs":[["vv34:13"]]},{"para":1560,"vripara":"642","refs":["vv34:13"],"lines":["“Yajamānānaṃ manussānaṃ, puññapekkhāna pāṇinaṃ;"],"lineRefs":[["vv34:13"]]},{"para":1561,"vripara":null,"refs":["vv34:13"],"lines":["Karotaṃ opadhikaṃ puññaṃ, saṅghe dinnaṃ mahapphalaṃ. 643."],"lineRefs":[["vv34:13"]]},{"para":1563,"vripara":"643","refs":["vv34:13"],"lines":["“Eso hi saṅgho vipulo mahaggato, esappameyyo udadhīva sāgaro;"],"lineRefs":[["vv34:13"]]},{"para":1564,"vripara":null,"refs":["vv34:13"],"lines":["Ete hi seṭṭhā naravīrasāvakā, pabhaṅkarā dhammamudīrayanti. 644."],"lineRefs":[["vv34:13"]]},{"para":1566,"vripara":"644","refs":["vv34:13"],"lines":["“Tesaṃ sudinnaṃ suhutaṃ suyiṭṭhaṃ, ye saṅghamuddissa dadanti dānaṃ;"],"lineRefs":[["vv34:13"]]},{"para":1567,"vripara":null,"refs":["vv34:13"],"lines":["Sā dakkhiṇā saṅghagatā patiṭṭhitā, mahapphalā lokavidūna vaṇṇitā. 645."],"lineRefs":[["vv34:13"]]},{"para":1569,"vripara":"645","refs":["vv34:13"],"lines":["“Etādisaṃ yaññamanussarantā, ye vedajātā vicaranti loke;"],"lineRefs":[["vv34:13"]]},{"para":1570,"vripara":null,"refs":["vv34:13"],"lines":["Vineyya maccheramalaṃ samūlaṃ, aninditā saggamupenti ṭhāna”nti. 637."],"lineRefs":[["vv34:13"]]},{"para":1571,"vripara":"637","refs":["vv34:18"],"lines":["Tattha <b>dhammenā</b>ti kāraṇena ñāyena vā.","<b>Tayā</b>ti nissakke karaṇavacanaṃ.","Idāni taṃ “dhammenā”ti vuttakāraṇaṃ dassetuṃ <b>yaṃ saṅghamhi appameyye, patiṭṭhāpesi dakkhiṇa”</b>nti vuttaṃ.","<b>Appameyye</b>ti guṇānubhāvassa attani katānaṃ kārānaṃ phalavisesassa ca vasena paminituṃ asakkuṇeyye. 638-9."],"lineRefs":[["vv34:18"],["vv34:18"],["vv34:18"],["vv34:18"]]},{"para":1572,"vripara":"638-639","refs":["vv34:19"],"lines":["Ayañca attho bhagavato sammukhā ca suto, sammukhā ca paṭiggahitoti dassento <b>“pucchito”</b>tiādimāha.","Tattha <b>yajamānāna</b>nti dadantānaṃ.","<b>Puññapekkhāna pāṇina</b>nti anunāsikalopaṃ katvā niddeso, puññaphalaṃ ākaṅkhantānaṃ sattānaṃ.","<b>Opadhika</b>nti upadhi nāma khandhā, upadhissa karaṇasīlaṃ, upadhipayojananti vā opadhikaṃ, attabhāvajanakaṃ paṭisandhipavattivipākadāyakaṃ. 640."],"lineRefs":[["vv34:19"],["vv34:19"],["vv34:19"],["vv34:19"]]},{"para":1573,"vripara":"640","refs":["vv34:21"],"lines":["<b>Jānaṃ kammaphalaṃ saka</b>nti sattānaṃ sakaṃ sakaṃ yathāsakaṃ puññaṃ puññaphalañca hatthatale āmalakaṃ viya jānanto.","Sakanti vā yakārassa kakāraṃ katvā vuttaṃ, sayaṃ attanāti attho. 641."],"lineRefs":[["vv34:21"],["vv34:21"]]},{"para":1574,"vripara":"641","refs":["vv34:22"],"lines":["<b>Paṭipannā</b>ti paṭipajjamānā, maggaṭṭhāti attho.","<b>Ujubhūto</b>ti ujupaṭipattiyā ujubhāvaṃ patto dakkhiṇeyyo jāto.","<b>Paññāsīlasamāhito</b>ti paññāya sīlena ca samāhito, diṭṭhisīlasampanno ariyāya diṭṭhiyā ariyena sīlena ca samannāgato.","Tenāpissa paramatthasaṅghabhāvameva vibhāveti.","Diṭṭhisīlasāmaññena saṅghaṭitattā hi saṅgho.","Atha vā samāhitaṃ samādhi, paññā sīlaṃ samāhitañca assa atthīti <b>paññāsīlasamāhito</b>.","Tenassa sīlādidhammakkhandhattayasampannatāya aggadakkhiṇeyyabhāvaṃ vibhāveti. 643."],"lineRefs":[["vv34:22"],["vv34:22"],["vv34:22"],["vv34:22"],["vv34:22"],["vv34:22"],["vv34:22"]]},{"para":1575,"vripara":"643","refs":["vv34:24"],"lines":["<b>Vipulo mahaggato</b>ti guṇehi mahattaṃ gatoti mahaggato, tato eva attani katānaṃ kārānaṃ phalavepullahetutāya vipulo.","<b>Udadhīva sāgaro</b>ti yathā udakaṃ ettha dhīyatīti “udadhī”ti laddhanāmo sāgaro, “ettakāni udakāḷhakānī”tiādinā udakato appameyyo, evamesa guṇatoti attho.","<b>Ete hī</b>ti <b>hi</b>-saddo avadhāraṇe nipāto, ete eva seṭṭhāti attho.","Vuttañhetaṃ –"],"lineRefs":[["vv34:24"],["vv34:24"],["vv34:24"],["vv34:24"]]},{"para":1576,"vripara":null,"refs":["vv34:24"],"lines":["“Yāvatā, bhikkhave, saṅghā vā gaṇā vā, tathāgatasāvakasaṅgho tesaṃ aggamakkhāyatī”ti (itivu. 90; a. ni. 4.34; 5.32)."],"lineRefs":[["vv34:24"]]},{"para":1577,"vripara":null,"refs":["vv34:24"],"lines":["<b>Naravīrasāvakā</b>ti naresu vīriyasampannassa narassa sāvakā.","<b>Pabhaṅkarā</b>ti lokassa ñāṇālokakarā.","<b>Dhammamudīrayantī</b>ti dhammaṃ uddisanti.","Kathaṃ?","Dhammasāminā hi dhammapajjoto ariyasaṅghe ṭhapito. 644."],"lineRefs":[["vv34:24"],["vv34:24"],["vv34:24"],["vv34:24"],["vv34:24"]]},{"para":1578,"vripara":"644","refs":["vv34:25"],"lines":["<b>Ye saṅghamuddissa dadanti dāna</b>nti ye sattā ariyasaṅghaṃ uddissa sammutisaṅghe antamaso gotrabhupuggalesupi dānaṃ dadanti, taṃ dānaṃ saṃvibhāgavasena dinnampi <b>sudinnaṃ,</b> āhunapāhunavasena hutampi <b>suhutaṃ,</b> mahāyāgavasena yiṭṭhampi <b>suyiṭṭha</b>meva hoti.","Kasmā?","Yasmā <b>sā dakkhiṇā saṅghagatā patiṭṭhitā mahapphalā lokavidūna vaṇṇitā</b>ti, lokavidūhi sammāsambuddhehi “na tvevāhaṃ, ānanda, kenaci pariyāyena saṅghagatāya dakkhiṇāya pāṭipuggalikaṃ dakkhiṇaṃ mahapphalataraṃ vadāmi (ma. ni. 3.380).","Puññaṃ ākaṅkhamānānaṃ, saṅgho ve yajataṃ mukhaṃ (ma. ni. 2.400; su. ni. 574; mahāva. 300).","Anuttaraṃ puññakkhettaṃ lokassā”ti (ma. ni. 1.74; saṃ. ni. 5.997) ca ādinā mahapphalatā vaṇṇitā pasatthā thomitāti attho. 645."],"lineRefs":[["vv34:25"],["vv34:25"],["vv34:25"],["vv34:25"],["vv34:25"]]},{"para":1579,"vripara":"645","refs":["vv34:25","vv34:26"],"lines":["<b>Īdisaṃ yaññamanussarantā</b>ti etādisaṃ saṅghaṃ uddissa attanā kataṃ dānaṃ anussarantā.","<b>Vedajātā</b>ti jātasomanassā.","<b>Vineyya maccheramalaṃ</b> <b>samūla</b>nti maccherameva cittassa malinabhāvakaraṇato <b>maccheramalaṃ,</b> atha vā maccherañca aññaṃ issālobhadosādimalañcāti maccheramalaṃ.","Tañca avijjāvicikicchāvipallāsādīhi saha mūlehīti samūlaṃ vineyya vinayitvā vikkhambhetvā aninditvā saggamupenti ṭhānanti yojanā.","Sesaṃ vuttanayameva."],"lineRefs":[["vv34:25"],["vv34:26"],["vv34:26"],["vv34:26"],["vv34:26"]]}],"wordLinks":[["vv34:1.1","vaṇṇenā",0,0],["vv34:1.3","vaṇṇenā",0,0],["vv34:3.1","ahaṃ bhadde",1,0],["vv34:3.1","bhadde",1,0],["vv34:3.1","subhaddāsiṃ",1,1],["vv34:5.1","pahūtakatakalyāṇā te deve yantī",14,0],["vv34:5.1","pāṇino",14,0],["vv34:5.1","te",14,0],["vv34:5.1","yanti",14,0],["vv34:5.3","yesaṃ",14,0],["vv34:6.1","kena vaṇṇenā",15,0],["vv34:6.3","kīdisenevā",15,1],["vv34:6.3","subbatenā",15,2],["vv34:8.1","aṭṭheva piṇḍapātānī",16,0],["vv34:8.1","adadaṃ",16,1],["vv34:11.1","tayā",23,1],["vv34:12.1","manobhāvanīyo",31,0],["vv34:12.1","sandiṭṭho",31,1],["vv34:12.3","tāhaṃ bhattena nimantesiṃ revataṃ attanaṭṭhamaṃ",31,2],["vv34:13.1","so me atthapurekkhāro",32,0],["vv34:13.3","saṅghe dehīti maṃvocā",32,1],["vv34:18.1","dhammenā",63,0],["vv34:18.1","tayā",63,1],["vv34:18.3","yaṃ saṅghamhi appameyye patiṭṭhāpesi dakkhiṇaṃ",63,2],["vv34:18.3","appameyye",63,3],["vv34:19.1","pucchito",64,0],["vv34:21.1","jānaṃ kammaphalaṃ sakaṃ",65,0],["vv34:22.1","paṭipannā",66,0],["vv34:22.3","ujubhūto",66,1],["vv34:22.3","paññāsīlasamāhito",66,2],["vv34:22.3","paññāsīlasamāhito",66,5],["vv34:24.1","vipulo mahaggato",67,0],["vv34:24.1","udadhīva sāgaro",67,1],["vv34:24.1","hi",67,2],["vv34:24.3","ete hī",67,2],["vv34:24.3","hi",67,2],["vv34:24.3","naravīrasāvakā",69,0],["vv34:24.3","pabhaṅkarā",69,1],["vv34:24.3","dhammamudīrayantī",69,2],["vv34:25.1","sudinnaṃ",70,0],["vv34:25.1","suhutaṃ",70,0],["vv34:25.1","suyiṭṭha",70,0],["vv34:25.1","ye saṅghamuddissa dadanti dānaṃ",70,0],["vv34:25.3","sā dakkhiṇā saṅghagatā patiṭṭhitā mahapphalā lokavidūna vaṇṇitā",70,2],["vv34:26.1","vedajātā",71,1],["vv34:26.3","maccheramalaṃ",71,2],["vv34:26.3","vineyya maccheramalaṃ samūlaṃ",71,2]],"before":[{"para":1469,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["Daddallavimānavaṇṇanā"]},{"para":1470,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["<b>Daddallamānā</b> <b>vaṇṇenā</b>ti daddallavimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tena ca samayena nālakagāmake āyasmato revatattherassa upaṭṭhākassa aññatarassa kuṭumbikassa dve dhītaro ahesuṃ, ekā bhaddā nāma, itarā subhaddā nāma.","Tāsu bhaddā patikulaṃ gatā saddhā pasannā buddhisampannā vañjhā ca ahosi.","Sā sāmikaṃ āha “mama kaniṭṭhā subhaddā nāma atthi, taṃ ānehi, sacassā putto bhaveyya, so mamapi putto siyā, ayañca kulavaṃso na nasseyyā”ti.","So “sādhū”ti sampaṭicchitvā tathā akāsi."]},{"para":1471,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["Atha bhaddā subhaddaṃ ovadi “subhadde, dānasaṃvibhāgaratā dhammacariyāya appamattā hohi, evaṃ te diṭṭhadhammiko samparāyiko ca attho hatthagato eva hotī”ti.","Sā tassā ovāde ṭhatvā vuttanayena paṭipajjamānā ekadivasaṃ āyasmantaṃ revatattheraṃ attaṭṭhamaṃ nimantesi.","Thero subhaddāya puññūpacayaṃ ākaṅkhanto saṅghuddesavasena satta bhikkhū gahetvā tassā gehaṃ agamāsi.","Sā pasannacittā āyasmantaṃ revatattheraṃ te ca bhikkhū paṇītena khādanīyena bhojanīyena sahatthā santappesi, thero anumodanaṃ katvā pakkāmi.","Sā aparabhāge kālaṃ katvā nimmānaratīnaṃ devānaṃ sahabyataṃ upapajji.","Bhaddā pana puggalesu dānāni datvā sakkassa devānamindassa paricārikā hutvā nibbatti."]},{"para":1472,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["Atha subhaddā attano sampattiṃ paccavekkhitvā “kena nu kho ahaṃ puññena idhūpapannā”ti āvajjentī “bhaddāya ovāde ṭhatvā saṅghagatāya dakkhiṇāya imaṃ sampattiṃ sampattā, bhaddā nu kho kahaṃ nibbattā”ti olokentī taṃ sakkassa paricārikābhāvena nibbattaṃ disvā anukampamānā tassā vimānaṃ pāvisi.","Atha naṃ bhaddā – 619."]},{"para":1474,"vripara":"619","title":"Daddallavimānavaṇṇanā","lines":["“Daddallamānā vaṇṇena, yasasā ca yasassinī;"]},{"para":1475,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["Sabbe deve tāvatiṃse, vaṇṇena atirocasi. 620."]},{"para":1477,"vripara":"620","title":"Daddallavimānavaṇṇanā","lines":["“Dassanaṃ nābhijānāmi, idaṃ paṭhamadassanaṃ;"]},{"para":1478,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["Kasmā kāyā nu āgamma, nāmena bhāsase mama”nti. –"]},{"para":1479,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["Dvīhi gāthāhi pucchi.","Sāpi tassā – 621."]},{"para":1481,"vripara":"621","title":"Daddallavimānavaṇṇanā","lines":["“Ahaṃ bhadde subhaddāsiṃ, pubbe mānusake bhave;"]},{"para":1482,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["Sahabhariyā ca te āsiṃ, bhaginī ca kaniṭṭhikā. 622."]},{"para":1484,"vripara":"622","title":"Daddallavimānavaṇṇanā","lines":["“Sā ahaṃ kāyassa bhedā, vippamuttā tato cutā;"]},{"para":1485,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["Nimmānaratīnaṃ devānaṃ, upapannā sahabyata”nti. –","dvīhi gāthāhi byākāsi; 619-20."]}],"after":[{"para":1580,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["Imaṃ pana sabbaṃ pavattiṃ sakko devānamindo “daddallamānā vaṇṇenā”tiādinā āyasmato mahāmoggallānassa ācikkhi, āyasmā mahāmoggallāno bhagavato ārocesi, bhagavā tamatthaṃ aṭṭhuppattiṃ katvā sampattaparisāya dhammaṃ desesi.","Sā desanā mahājanassa sātthikā ahosi."]},{"para":1581,"vripara":null,"title":"Daddallavimānavaṇṇanā","lines":["Daddallavimānavaṇṇanā niṭṭhitā. 7."]}]},"tika":null,"tika2":null}
