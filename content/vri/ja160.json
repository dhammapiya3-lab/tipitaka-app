{"suttaId":"ja160","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[935,945],"vripara":"19"},"segments":{"ja160:0.4":"Vinīlajātakaṃ (2-1-10)","ja160:1.1":"Evameva nūna [nu (ka.)] rājānaṃ,","ja160:1.2":"vedehaṃ mithilaggahaṃ;","ja160:1.3":"Assā vahanti ājaññā,","ja160:1.4":"yathā haṃsā vinīlakaṃ. 20.","ja160:2.1":"Vinīla duggaṃ bhajasi,","ja160:2.2":"abhūmiṃ tāta sevasi;","ja160:2.3":"Gāmantakāni [gāmantikāni (sī.), gāmantarāni (ka.)] sevassu,","ja160:2.4":"etaṃ mātālayaṃ tavāti.","ja160:3.1":"Vinīlajātakaṃ dasamaṃ.","ja160:3.2":"Daḷhavaggo paṭhamo.","ja160:4.1":"Tassuddānaṃ –","ja160:5.1":"Varaballika daddara sūkarako,","ja160:5.2":"uragūttama pañcamabhaggavaro;","ja160:5.3":"Mahatīcamu yāva siṅgālavaro,","ja160:5.4":"suhanuttama mora vinīlaṃ dasāti. 2."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":193,"to":198,"paras":[{"para":193,"vripara":null,"refs":["ja160:1"],"lines":["Tattha <b>evamevā</b>ti evaṃ eva, <b>nūnā</b>ti parivitakke nipāto.","Ekaṃsepi vaṭṭatiyeva.","<b>Vedeha</b>nti videharaṭṭhasāmikaṃ.","<b>Mithilaggaha</b>nti mithilagehaṃ, mithilāyaṃ gharaṃ pariggahetvā vasamānanti attho.","<b>Ājaññā</b>ti kāraṇākāraṇājānanakā.","<b>Yathā haṃsā vinīlaka</b>nti yathā ime haṃsā maṃ vinīlakaṃ vahanti, evameva vahantīti."],"lineRefs":[["ja160:1"],["ja160:1"],["ja160:1"],["ja160:1"],["ja160:1"],["ja160:1"]]},{"para":194,"vripara":null,"refs":["ja160:1"],"lines":["Haṃsapotakā tassa vacanaṃ sutvā kujjhitvā “idheva naṃ pātetvā gamissāmā”ti cittaṃ uppādetvāpi “evaṃ kate pitā no kiṃ vakkhatī”ti garahabhayena pitu santikaṃ netvā tena katakiriyaṃ pitu ācikkhiṃsu.","Atha naṃ pitā kujjhitvā “kiṃ tvaṃ mama puttehi adhikatarosi, yo mama putte abhibhavitvā rathe yuttasindhave viya karosi, attano pamāṇaṃ na jānāsi.","Imaṃ ṭhānaṃ tava agocaro, attano mātu vasanaṭṭhānameva gacchāhī”ti tajjetvā dutiyaṃ gāthamāha – 20."],"lineRefs":[["ja160:1"],["ja160:1"],["ja160:1"]]},{"para":196,"vripara":"20","refs":["ja160:1"],"lines":["“Vinīla duggaṃ bhajasi, abhūmiṃ tāta sevasi;"],"lineRefs":[["ja160:1"]]},{"para":197,"vripara":null,"refs":["ja160:1"],"lines":["Gāmantakāni sevassu, etaṃ mātālayaṃ tavā”ti."],"lineRefs":[["ja160:1"]]},{"para":198,"vripara":null,"refs":["ja160:2"],"lines":["Tattha <b>vinīlā</b>ti taṃ nāmenālapati.","<b>Duggaṃ bhajasī</b>ti imesaṃ vasena giriduggaṃ bhajasi.","<b>Abhūmiṃ, tāta, sevasī</b>ti, tāta, girivisamaṃ nāma tava abhūmi, taṃ sevasi upagacchasi.","<b>Etaṃ mātālayaṃ tavā</b>ti etaṃ gāmantaṃ ukkāraṭṭhānaṃ āmakasusānaṭṭhānañca tava mātu ālayaṃ gehaṃ vasanaṭṭhānaṃ, tattha gacchāhīti.","Evaṃ taṃ tajjetvā “gacchatha, naṃ mithilanagarassa ukkārabhūmiyaññeva otāretvā ethā”ti putte āṇāpesi, te tathā akaṃsu."],"lineRefs":[["ja160:2"],["ja160:2"],["ja160:2"],["ja160:2"],["ja160:2"]]}],"wordLinks":[["ja160:1.1","evamevā",0,0],["ja160:1.1","nūnā",0,0],["ja160:1.1","vedehaṃ",0,2],["ja160:1.1","mithilaggahaṃ",0,3],["ja160:1.3","ājaññā",0,4],["ja160:1.3","yathā haṃsā vinīlakaṃ",0,5],["ja160:2.1","vinīlā",4,0],["ja160:2.1","duggaṃ bhajasī",4,1],["ja160:2.1","abhūmiṃ tāta sevasī",4,2],["ja160:2.3","etaṃ mātālayaṃ tavā",4,3]],"after":[{"para":199,"vripara":null,"title":"[160] 10. Vinīlajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā vinīlako devadatto ahosi, dve haṃsapotakā dve aggasāvakā ahesuṃ, pitā ānando ahosi, videharājā pana ahameva ahosi”nti."]},{"para":200,"vripara":null,"title":"[160] 10. Vinīlajātakavaṇṇanā","lines":["Vinīlajātakavaṇṇanā dasamā."]},{"para":201,"vripara":null,"title":"[160] 10. Vinīlajātakavaṇṇanā","lines":["Daḷhavaggo paṭhamo."]},{"para":202,"vripara":null,"title":"[160] 10. Vinīlajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":203,"vripara":null,"title":"[160] 10. Vinīlajātakavaṇṇanā","lines":["Rājovādañca siṅgālaṃ, sūkaraṃ uragaṃ bhaggaṃ;"]},{"para":204,"vripara":null,"title":"[160] 10. Vinīlajātakavaṇṇanā","lines":["Alīnacittaguṇañca, suhanu moravinīlaṃ. 2."]}]},"tika":null,"tika2":null}
