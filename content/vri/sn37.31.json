{"suttaId":"sn37.31","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1511,1511],"vripara":"310"},"segments":{"sn37.31:0.3":"Hetusuttaṃ","sn37.31:1.1":"“Pañcimāni, bhikkhave, mātugāmassa balāni.","sn37.31:1.2":"Katamāni pañca?","sn37.31:1.3":"Rūpabalaṃ, bhogabalaṃ, ñātibalaṃ, puttabalaṃ, sīlabalaṃ.","sn37.31:1.4":"Na, bhikkhave, mātugāmo rūpabalahetu vā bhogabalahetu vā ñātibalahetu vā puttabalahetu vā kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati.","sn37.31:1.5":"Sīlabalahetu kho, bhikkhave, mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati.","sn37.31:1.6":"Imāni kho, bhikkhave, pañca mātugāmassa balānī”ti.","sn37.31:1.7":"Sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":661,"to":664,"paras":[{"para":661,"vripara":"305-313","refs":["sn37.31:1"],"lines":["<b>Pasayhā</b>ti abhibhavitvā.","<b>Abhibhuyya vattatī</b>ti abhibhavati ajjhottharati.","<b>Neva rūpabalaṃ tāyatī</b>ti neva rūpabalaṃ tāyituṃ rakkhituṃ sakkoti.","<b>Nāsenteva naṃ, kule na vāsentī</b>ti “dussīlā saṃbhinnācārā atikkantamariyādā”ti gīvāyaṃ gahetvā nīharanti, na tasmiṃ kule vāsenti.","<b>Vāsenteva naṃ kule, na nāsentī</b>ti “kiṃ rūpena bhogādīhi vā, parisuddhasīlā esā ācārasampannā”ti ñatvā ñātakā tasmiṃ kule vāsentiyeva, na nāsenti.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn37.31:1"],["sn37.31:1"],["sn37.31:1"],["sn37.31:1"],["sn37.31:1"],["sn37.31:1"]]},{"para":662,"vripara":null,"refs":["sn37.31:1"],"lines":["Mātugāmasaṃyuttavaṇṇanā niṭṭhitā. 4."],"lineRefs":[["sn37.31:1"]]},{"para":663,"vripara":null,"refs":["sn37.31:1"],"lines":["Jambukhādakasaṃyuttaṃ 1."],"lineRefs":[["sn37.31:1"]]},{"para":664,"vripara":null,"refs":["sn37.31:1"],"lines":["Nibbānapañhāsuttavaṇṇanā 314."],"lineRefs":[["sn37.31:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":569,"to":573,"paras":[{"para":569,"vripara":"305-313","refs":["sn37.31:1"],"lines":["<b>Abhibhavitvā</b> sabbaṃ antojanaṃ sāmikañca.","<b>Nāsentī</b>ti nāsanaṃ adassanaṃ nenti nīharantīti attho."],"lineRefs":[["sn37.31:1"],["sn37.31:1"]]},{"para":570,"vripara":null,"refs":["sn37.31:1"],"lines":["Pasayhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn37.31:1"]]},{"para":571,"vripara":null,"refs":["sn37.31:1"],"lines":["Mātugāmasaṃyuttavaṇṇanā niṭṭhitā. 4."],"lineRefs":[["sn37.31:1"]]},{"para":572,"vripara":null,"refs":["sn37.31:1"],"lines":["Jambukhādakasaṃyuttaṃ 1."],"lineRefs":[["sn37.31:1"]]},{"para":573,"vripara":null,"refs":["sn37.31:1"],"lines":["Nibbānapañhasuttavaṇṇanā 314."],"lineRefs":[["sn37.31:1"]]}],"wordLinks":[]},"tika2":null}
