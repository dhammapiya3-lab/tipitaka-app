{"suttaId":"thag2.48","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1115,1121],"vripara":"215"},"segments":{"thag2.48:0.4":"Vajjitattheragāthā","thag2.48:1.1":"“Saṃsaraṃ dīghamaddhānaṃ, gatīsu parivattisaṃ;","thag2.48:1.3":"Apassaṃ ariyasaccāni, andhabhūto [andhībhūto (ka.)] puthujjano.","thag2.48:2.1":"“Tassa me appamattassa, saṃsārā vinaḷīkatā;","thag2.48:2.3":"Sabbā gatī samucchinnā, natthi dāni punabbhavo”ti.","thag2.48:2.5":"… Vajjito thero …."},"attha":null,"tika":null}
