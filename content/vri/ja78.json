{"suttaId":"ja78","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[437,440],"vripara":"78"},"segments":{"ja78:0.4":"Illisajātakaṃ","ja78:1.1":"Ubho khañjā ubho kuṇī,","ja78:1.2":"ubho visamacakkhukā [cakkhulā (sī. pī.)];","ja78:1.3":"Ubhinnaṃ piḷakā [pīḷakā (syā.)] jātā,","ja78:1.4":"nāhaṃ passāmi illisanti.","ja78:2.1":"Illisajātakaṃ aṭṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2159,"to":2159,"paras":[{"para":2159,"vripara":null,"refs":["ja78:1"],"lines":["Tattha <b>ubho</b>ti dvepi janā.","<b>Khañjā</b>ti kuṇṭhapādā.","<b>Kuṇī</b>ti kuṇṭhahatthā.","<b>Visamacakkhukā</b>ti visamakkhimaṇḍalā kekarā.","<b>Piḷakā</b>ti dvinnampi ekasmiṃyeva sīsapadese ekasaṇṭhānāva piḷakā jātā.","<b>Nāhaṃ passāmī</b>ti ahaṃ “imesu ayaṃ nāma illiso”ti na passāmi, ekassāpi illisabhāvaṃ na jānāmīti avoca."],"lineRefs":[["ja78:1"],["ja78:1"],["ja78:1"],["ja78:1"],["ja78:1"],["ja78:1"]]}],"wordLinks":[["ja78:1.1","ubho",0,0],["ja78:1.3","ubho",0,0],["ja78:1.1","khañjā",0,1],["ja78:1.1","kuṇī",0,2],["ja78:1.1","visamacakkhukā",0,3],["ja78:1.3","piḷakā",0,4],["ja78:1.3","nāhaṃ passāmī",0,5]]},"tika":null,"tika2":null}
