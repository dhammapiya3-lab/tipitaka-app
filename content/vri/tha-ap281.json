{"suttaId":"tha-ap281","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8673,8682],"vripara":"35"},"segments":{"tha-ap281:0.3":"Ekapuṇḍarīkattheraapadānaṃ","tha-ap281:1.1":"“Romaso nāma nāmena, sayambhū subbato [sappabho (syā.)] tadā;","tha-ap281:1.3":"Puṇḍarīkaṃ mayā dinnaṃ, vippasannena cetasā.","tha-ap281:2.1":"“Catunnavutito kappe, puṇḍarīkamadaṃ tadā;","tha-ap281:2.3":"Duggatiṃ nābhijānāmi, puṇḍarīkassidaṃ phalaṃ.","tha-ap281:3.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap281:4.1":"Itthaṃ sudaṃ āyasmā ekapuṇḍarīko thero imā gāthāyo abhāsitthāti.","tha-ap281:5.1":"Ekapuṇḍarīkattherassāpadānaṃ navamaṃ."},"attha":null,"tika":null,"tika2":null}
