{"suttaId":"an10.180","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[1401,1402],"vripara":"180"},"segments":{"an10.180:0.3":"Kusalasuttaṃ","an10.180:1.1":"“Kusalañca vo, bhikkhave, desessāmi akusalañca.","an10.180:1.2":"Taṃ suṇātha … pe … katamañca, bhikkhave, akusalaṃ?","an10.180:1.4":"Pāṇātipāto … pe … micchādiṭṭhi – idaṃ vuccati, bhikkhave, akusalaṃ.","an10.180:2.1":"“Katamañca, bhikkhave, kusalaṃ?","an10.180:2.2":"Pāṇātipātā veramaṇī … pe … sammādiṭṭhi – idaṃ vuccati, bhikkhave, kusalan”ti.","an10.180:2.5":"Tatiyaṃ."},"attha":null,"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":765,"to":769,"paras":[{"para":765,"vripara":"167-210","refs":["an10.180:1"],"lines":["167-210. Dutiye ca paṭhamādīni uttānatthāni.","Dasame <b>pacchābhūmivāsino</b>ti paccantadesavāsino.","<b>Sevālamālikā</b>ti pātova udakaṃ orohitvā sevālañceva uppalādīni ca gahetvā attano udakasuddhikabhāvajānanatthañceva “lokassa ca udakena suddhi hotī”ti imassa atthassa jānanatthañca mālaṃ katvā pilandhanakā.","<b>Udakorohakā</b>ti pāto majjhanhe sāyanhe ca udakaorohaṇakā.","Tenāha <b>“sāyatatiyakaṃ udakorohaṇānuyogamanuyuttā”</b>ti.","Ekādasamādīni uttānatthāni.","Catutthe paṇṇāsake natthi vattabbaṃ."],"lineRefs":[["an10.180:1"],["an10.180:1"],["an10.180:1"],["an10.180:1"],["an10.180:1"],["an10.180:1"],["an10.180:1"]]},{"para":766,"vripara":null,"refs":[],"lines":["Brāhmaṇapaccorohaṇīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":767,"vripara":null,"refs":[],"lines":["Catutthapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[[]]},{"para":768,"vripara":null,"refs":[],"lines":["(21)1. Karajakāyavaggo"],"lineRefs":[[]]},{"para":769,"vripara":null,"refs":["an10.180:1"],"lines":["1-536. Paṭhamanirayasaggasuttādivaṇṇanā"],"lineRefs":[["an10.180:1"]]}],"wordLinks":[]},"tika2":null}
