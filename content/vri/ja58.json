{"suttaId":"ja58","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[324,327],"vripara":"58"},"segments":{"ja58:0.4":"Tayodhammajātakaṃ","ja58:1.1":"Yassete ca [yassa ete (sī. pī.)] tayo dhammā, vānarinda yathā tava;","ja58:1.3":"Dakkhiyaṃ sūriyaṃ paññā, diṭṭhaṃ so ativattatīti.","ja58:2.1":"Tayodhammajātakaṃ aṭṭhamaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1812,"to":1812,"paras":[{"para":1812,"vripara":null,"refs":["ja58:1"],"lines":["Tattha <b>dakkhiyan</b>ti dakkhabhāvo, sampattabhayaṃ vidhamituṃ jānanapaññāya sampayuttauttamavīriyassetaṃ nāmaṃ.","<b>Sūriyan</b>ti sūrabhāvo, nibbhayabhāvassetaṃ nāmaṃ.","<b>Paññā</b>ti paññāpadaṭṭhānāya upāyapaññāyetaṃ nāmaṃ."],"lineRefs":[["ja58:1"],["ja58:1"],["ja58:1"]]}],"wordLinks":[["ja58:1.3","dakkhiyaṃ",0,0],["ja58:1.3","sūriyaṃ",0,1],["ja58:1.3","paññā",0,2]]},"tika":null,"tika2":null}
