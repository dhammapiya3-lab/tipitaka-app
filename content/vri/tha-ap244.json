{"suttaId":"tha-ap244","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8125,8140],"vripara":"4"},"segments":{"tha-ap244:0.3":"Nāgakesariyattheraapadānaṃ","tha-ap244:1.1":"“Dhanuṃ advejjhaṃ katvāna, vanamajjhogahiṃ ahaṃ;","tha-ap244:1.3":"Kesaraṃ ogataṃ [osaraṃ (syā.), osaṭaṃ (sī.)] disvā, patapattaṃ samuṭṭhitaṃ.","tha-ap244:2.1":"“Ubho hatthehi paggayha, sire katvāna añjaliṃ;","tha-ap244:2.3":"Buddhassa abhiropesiṃ, tissassa lokabandhuno.","tha-ap244:3.1":"“Dvenavute ito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap244:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap244:4.1":"“Tesattatimhi kappamhi [sattasattatime kappe (syā.)], satta kesaranāmakā;","tha-ap244:4.3":"Sattaratanasampannā, cakkavattī mahabbalā.","tha-ap244:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap244:6.1":"Itthaṃ sudaṃ āyasmā nāgakesariyo thero imā gāthāyo abhāsitthāti.","tha-ap244:7.1":"Nāgakesariyattherassāpadānaṃ dutiyaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3199,"to":3199,"paras":[{"para":3199,"vripara":"4-5","refs":["tha-ap244:1"],"lines":["4-5. Dutiyāpadāne <b>dhanuṃ advejjhaṃ katvānā</b>ti migādīnaṃ māraṇatthāya dhanuṃ sannayhitvā caramāno <b>kesaraṃ ogataṃ disvā</b>ti supupphitaṃ khuddakasaraṃ disvā <b>buddhassa abhiropesin</b>ti ahaṃ cittaṃ pasādetvā vanaṃ sampattassa tissassa bhagavato abhiropayiṃ pūjesinti attho."],"lineRefs":[["tha-ap244:1"]]}],"wordLinks":[["tha-ap244:1.1","dhanuṃ advejjhaṃ katvānā",0,0],["tha-ap244:1.3","kesaraṃ ogataṃ disvā",0,0]]},"tika":null}
