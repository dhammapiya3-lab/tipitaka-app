{"suttaId":"bv26","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[2930,3086],"vripara":"1"},"segments":{"bv26:0.2":"Kassapabuddhavaṃso","bv26:1.1":"Koṇāgamanassa aparena,","bv26:1.2":"sambuddho dvipaduttamo;","bv26:1.3":"Kassapo nāma gottena,","bv26:1.4":"dhammarājā pabhaṅkaro.","bv26:2.1":"Sañchaḍḍitaṃ kulamūlaṃ,","bv26:2.2":"bahvannapānabhojanaṃ;","bv26:2.3":"Datvāna yācake dānaṃ,","bv26:2.4":"pūrayitvāna mānasaṃ;","bv26:2.5":"Usabhova āḷakaṃ bhetvā,","bv26:2.6":"patto sambodhimuttamaṃ.","bv26:3.1":"Dhammacakkaṃ pavattente,","bv26:3.2":"kassape lokanāyake;","bv26:3.3":"Vīsakoṭisahassānaṃ,","bv26:3.4":"paṭhamābhisamayo ahu.","bv26:4.1":"Catumāsaṃ yadā buddho,","bv26:4.2":"loke carati cārikaṃ;","bv26:4.3":"Dasakoṭisahassānaṃ,","bv26:4.4":"dutiyābhisamayo ahu.","bv26:5.1":"Yamakaṃ vikubbanaṃ katvā,","bv26:5.2":"ñāṇadhātuṃ pakittayi;","bv26:5.3":"Pañcakoṭisahassānaṃ,","bv26:5.4":"tatiyābhisamayo ahu.","bv26:6.1":"Sudhammā devapure ramme,","bv26:6.2":"tattha dhammaṃ pakittayi;","bv26:6.3":"Tīṇikoṭisahassānaṃ,","bv26:6.4":"devānaṃ bodhayī jino.","bv26:7.1":"Naradevassa yakkhassa,","bv26:7.2":"apare dhammadesane;","bv26:7.3":"Etesānaṃ abhisamayā,","bv26:7.4":"gaṇanāto asaṅkhiyā.","bv26:8.1":"Tassāpi devadevassa,","bv26:8.2":"eko āsi samāgamo;","bv26:8.3":"Khīṇāsavānaṃ vimalānaṃ,","bv26:8.4":"santacittāna tādinaṃ.","bv26:9.1":"Vīsabhikkhusahassānaṃ,","bv26:9.2":"tadā āsi samāgamo;","bv26:9.3":"Atikkantabhavantānaṃ,","bv26:9.4":"hirisīlena tādinaṃ.","bv26:10.1":"Ahaṃ tadā māṇavako,","bv26:10.2":"jotipāloti vissuto;","bv26:10.3":"Ajjhāyako mantadharo,","bv26:10.4":"tiṇṇaṃ vedāna pāragū.","bv26:11.1":"Lakkhaṇe itihāse ca,","bv26:11.2":"sadhamme pāramiṃ gato;","bv26:11.3":"Bhūmantalikkhakusalo,","bv26:11.4":"katavijjo anāvayo.","bv26:12.1":"Kassapassa bhagavato,","bv26:12.2":"ghaṭikāro nāmupaṭṭhāko;","bv26:12.3":"Sagāravo sappatisso,","bv26:12.4":"nibbuto tatiye phale.","bv26:13.1":"Ādāya maṃ ghaṭīkāro,","bv26:13.2":"upagañchi kassapaṃ jinaṃ;","bv26:13.3":"Tassa dhammaṃ suṇitvāna,","bv26:13.4":"pabbajiṃ tassa santike.","bv26:14.1":"Āraddhavīriyo hutvā,","bv26:14.2":"vattāvattesu kovido;","bv26:14.3":"Na kvaci parihāyāmi,","bv26:14.4":"pūresiṃ jinasāsanaṃ.","bv26:15.1":"Yāvatā buddhabhaṇitaṃ,","bv26:15.2":"navaṅgaṃ jinasāsanaṃ;","bv26:15.3":"Sabbaṃ pariyāpuṇitvāna,","bv26:15.4":"sobhayiṃ jinasāsanaṃ.","bv26:16.1":"Mama acchariyaṃ disvā,","bv26:16.2":"sopi buddho viyākari;","bv26:16.3":"“Imamhi bhaddake kappe,","bv26:16.4":"ayaṃ buddho bhavissati.","bv26:17.1":"“Ahu kapilavhayā rammā,","bv26:17.2":"nikkhamitvā tathāgato;","bv26:17.3":"Padhānaṃ padahitvāna,","bv26:17.4":"katvā dukkarakārikaṃ.","bv26:18.1":"“Ajapālarukkhamūle,","bv26:18.2":"nisīditvā tathāgato;","bv26:18.3":"Tattha pāyāsaṃ paggayha,","bv26:18.4":"nerañjaramupehiti.","bv26:19.1":"“Nerañjarāya tīramhi,","bv26:19.2":"pāyāsaṃ paribhuñjiya;","bv26:19.3":"Paṭiyattavaramaggena,","bv26:19.4":"bodhimūlamupehiti.","bv26:20.1":"“Tato padakkhiṇaṃ katvā,","bv26:20.2":"bodhimaṇḍaṃ anuttaro;","bv26:20.3":"Aparājitaṭṭhānamhi [aparājitanisabhaṭṭhāne (ka.)],","bv26:20.4":"bodhipallaṅkamuttame;","bv26:20.5":"Pallaṅkena nisīditvā,","bv26:20.6":"bujjhissati mahāyaso.","bv26:21.1":"“Imassa janikā mātā,","bv26:21.2":"māyā nāma bhavissati;","bv26:21.3":"Pitā suddhodano nāma,","bv26:21.4":"ayaṃ hessati gotamo.","bv26:22.1":"“Anāsavā vītarāgā,","bv26:22.2":"santacittā samāhitā;","bv26:22.3":"Kolito upatisso ca,","bv26:22.4":"aggā hessanti sāvakā;","bv26:22.5":"Ānando nāmupaṭṭhāko,","bv26:22.6":"upaṭṭhissatimaṃ jinaṃ.","bv26:23.1":"“Khemā uppalavaṇṇā ca,","bv26:23.2":"aggā hessanti sāvikā;","bv26:23.3":"Anāsavā santacittā,","bv26:23.4":"vītarāgā samāhitā;","bv26:23.5":"Bodhi tassa bhagavato,","bv26:23.6":"assatthoti pavuccati.","bv26:24.1":"“Citto hatthāḷavako ca,","bv26:24.2":"aggā hessantupaṭṭhakā;","bv26:24.3":"Nandamātā ca uttarā,","bv26:24.4":"aggā hessantupaṭṭhikā”.","bv26:25.1":"Idaṃ sutvāna vacanaṃ,","bv26:25.2":"assamassa mahesino;","bv26:25.3":"Āmoditā naramarū,","bv26:25.4":"buddhabījaṃ kira ayaṃ.","bv26:26.1":"Ukkuṭṭhisaddā pavattanti,","bv26:26.2":"apphoṭenti hasanti ca;","bv26:26.3":"Katañjalī namassanti,","bv26:26.4":"dasasahassī sadevakā.","bv26:27.1":"“Yadimassa lokanāthassa,","bv26:27.2":"virajjhissāma sāsanaṃ;","bv26:27.3":"Anāgatamhi addhāne,","bv26:27.4":"hessāma sammukhā imaṃ.","bv26:28.1":"“Yathā manussā nadiṃ tarantā,","bv26:28.2":"paṭititthaṃ virajjhiya;","bv26:28.3":"Heṭṭhā titthe gahetvāna,","bv26:28.4":"uttaranti mahānadiṃ.","bv26:29.1":"“Evameva mayaṃ sabbe,","bv26:29.2":"yadi muñcāmimaṃ jinaṃ;","bv26:29.3":"Anāgatamhi addhāne,","bv26:29.4":"hessāma sammukhā imaṃ”.","bv26:30.1":"Tassāpi vacanaṃ sutvā,","bv26:30.2":"bhiyyo cittaṃ pasādayiṃ;","bv26:30.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv26:30.4":"dasapāramipūriyā.","bv26:31.1":"Evamahaṃ saṃsaritvā,","bv26:31.2":"parivajjento anācaraṃ;","bv26:31.3":"Dukkarañca kataṃ mayhaṃ,","bv26:31.4":"bodhiyāyeva kāraṇā.","bv26:32.1":"Nagaraṃ bārāṇasī nāma,","bv26:32.2":"kikī nāmāsi khattiyo;","bv26:32.3":"Vasate tattha nagare,","bv26:32.4":"sambuddhassa mahākulaṃ.","bv26:33.1":"Brāhmaṇo brahmadattova,","bv26:33.2":"āsi buddhassa so pitā;","bv26:33.3":"Dhanavatī nāma janikā,","bv26:33.4":"kassapassa mahesino.","bv26:34.1":"Duve vassasahassāni,","bv26:34.2":"agāraṃ ajjha so vasi;","bv26:34.3":"Haṃso yaso sirinando,","bv26:34.4":"tayo pāsādamuttamā.","bv26:35.1":"Tisoḷasasahassāni,","bv26:35.2":"nāriyo samalaṅkatā;","bv26:35.3":"Sunandā nāma sā nārī,","bv26:35.4":"vijitaseno nāma atrajo.","bv26:36.1":"Nimitte caturo disvā,","bv26:36.2":"pāsādenābhinikkhami;","bv26:36.3":"Sattāhaṃ padhānacāraṃ,","bv26:36.4":"acarī purisuttamo.","bv26:37.1":"Brahmunā yācito santo,","bv26:37.2":"kassapo lokanāyako;","bv26:37.3":"Vatti cakkaṃ mahāvīro,","bv26:37.4":"migadāye naruttamo.","bv26:38.1":"Tisso ca bhāradvājo ca,","bv26:38.2":"ahesuṃ aggasāvakā;","bv26:38.3":"Sabbamitto nāmupaṭṭhāko,","bv26:38.4":"kassapassa mahesino.","bv26:39.1":"Anuḷā uruveḷā ca, ahesuṃ aggasāvikā;","bv26:39.3":"Bodhi tassa bhagavato,","bv26:39.4":"nigrodhoti pavuccati.","bv26:40.1":"Sumaṅgalo ghaṭikāro ca,","bv26:40.2":"ahesuṃ aggupaṭṭhakā;","bv26:40.3":"Vicitasenā bhaddā [bhadrā (ka.)] ca,","bv26:40.4":"ahesuṃ aggupaṭṭhikā.","bv26:41.1":"Uccattanena so buddho,","bv26:41.2":"vīsatiratanuggato;","bv26:41.3":"Vijjulaṭṭhīva ākāse,","bv26:41.4":"candova gahapūrito.","bv26:42.1":"Vīsativassasahassāni,","bv26:42.2":"āyu tassa mahesino;","bv26:42.3":"Tāvatā tiṭṭhamāno so,","bv26:42.4":"tāresi janataṃ bahuṃ.","bv26:43.1":"Dhammataḷākaṃ māpayitvā,","bv26:43.2":"sīlaṃ datvā vilepanaṃ;","bv26:43.3":"Dhammadussaṃ nivāsetvā,","bv26:43.4":"dhammamālaṃ vibhajjiya.","bv26:44.1":"Dhammavimalamādāsaṃ,","bv26:44.2":"ṭhapayitvā mahājane;","bv26:44.3":"Keci nibbānaṃ patthentā,","bv26:44.4":"passantu me alaṅkaraṃ.","bv26:45.1":"Sīlakañcukaṃ datvāna,","bv26:45.2":"jhānakavacavammitaṃ;","bv26:45.3":"Dhammacammaṃ pārupitvā,","bv26:45.4":"datvā sannāhamuttamaṃ.","bv26:46.1":"Satiphalakaṃ datvāna,","bv26:46.2":"tikhiṇañāṇakuntimaṃ;","bv26:46.3":"Dhammakhaggavaraṃ datvā,","bv26:46.4":"sīlasaṃsaggamaddanaṃ.","bv26:47.1":"Tevijjābhūsanaṃ datvāna,","bv26:47.2":"āveḷaṃ caturo phale;","bv26:47.3":"Chaḷabhiññābharaṇaṃ datvā,","bv26:47.4":"dhammapupphapiḷandhanaṃ.","bv26:48.1":"Saddhammapaṇḍaracchattaṃ,","bv26:48.2":"datvā pāpanivāraṇaṃ;","bv26:48.3":"Māpayitvābhayaṃ pupphaṃ,","bv26:48.4":"nibbuto so sasāvako.","bv26:49.1":"Eso hi sammāsambuddho,","bv26:49.2":"appameyyo durāsado;","bv26:49.3":"Eso hi dhammaratano,","bv26:49.4":"svākkhāto ehipassiko.","bv26:50.1":"Eso hi saṅgharatano,","bv26:50.2":"suppaṭipanno anuttaro;","bv26:50.3":"Sabbaṃ tamantarahitaṃ,","bv26:50.4":"nanu rittā sabbasaṅkhārā.","bv26:51.1":"Mahākassapo jino satthā,","bv26:51.2":"setabyārāmamhi nibbuto;","bv26:51.3":"Tatthevassa jinathūpo,","bv26:51.4":"yojanubbedhamuggatoti.","bv26:52.1":"Kassapassa bhagavato vaṃso catuvīsatimo."},"unsure":["bv26:39.1"],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":3770,"to":3811,"paras":[{"para":3770,"vripara":null,"refs":["bv26:7"],"lines":["Tattha <b>catumāsan</b>ti cātumāse.","Ayameva vā pāṭho.","<b>Caratī</b>ti acari.","<b>Yamakaṃ vikubbanaṃ katvā</b>ti yamakapāṭihāriyaṃ katvā.","<b>Ñāṇadhātun</b>ti sabbaññutaññāṇasabhāvaṃ.","“Sabbañāṇadhātun” tipi vadanti.","<b>Pakittayī</b>ti mahājanassa pakāsesi.","<b>Sudhammā</b>ti tāvatiṃsabhavane sudhammā nāma sabhā atthi, tattha nisīditvāti attho.","<b>Dhamman</b>ti abhidhammaṃ."],"lineRefs":[["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"]]},{"para":3771,"vripara":null,"refs":["bv26:7"],"lines":["Tadā kira ānubhāvavijitanaradevo naradevo nāma mahesakkho heṭṭhā vuttanaradevayakkho viya mahiddhiko yakkho ahosi.","So jambudīpe ekasmiṃ nagare rañño yādisaṃ rūpaṃ, tādisaṃ rūpasaṇṭhānaṃ sarakuttiṃ nimminitvā taṃ rājānaṃ māretvā khāditvā sahaantepuraṃ rajjaṃ paṭipajjitvā aparimitamaṃsabhojano ahosi.","So kira itthidhutto ca ahosi.","Yadā pana taṃ kusalā chekā itthiyo –","“nāyaṃ amhākaṃ rājā, amanusso eso”ti jānanti, tadā so lajjito hutvā tā sabbā khāditvā aññaṃ nagaraṃ paṭipajjati.","Evameva so naradevayakkho manusse bhakkhayanto yadā sundaranagarābhimukho agamāsi, tadā taṃ disvā nagaravāsino manussā maraṇabhayatajjitasantāsā sakanagarato nikkhamitvā tato tato palāyiṃsu.","Atha te manusse palāyamāne disvā kassapadasabalo tassa naradevassa yakkhassa purato aṭṭhāsi.","Naradevo evaṃ devadevaṃ ṭhitaṃ disvā vissaraṃ ghoraṃ nādaṃ naditvā bhagavato bhayaṃ uppādetuṃ asakkonto taṃ saraṇaṃ gantvā pañhaṃ pucchi.","Pañhaṃ vissajjetvā taṃ dametvā dhamme desiyamāne sampattānaṃ naramarānaṃ gaṇanapathātītānaṃ abhisamayo ahosi.","Tena vuttaṃ –","<b>“naradevassa yakkhassā”</b>tiādi.","Tattha <b>apare dhammadesane</b>ti aparasmiṃ dhammadesane.","<b>Etesānan</b>ti etesaṃ.","Ayameva vā pāṭho."],"lineRefs":[["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"]]},{"para":3772,"vripara":null,"refs":["bv26:7"],"lines":["Tassa pana kassapabhagavato ekova sāvakasannipāto ahosi.","Bārāṇasīnagare purohitaputto tisso nāma ahosi.","So kassapassa bodhisattassa sarīre lakkhaṇasampattiṃ disvā pituno bhāsato sutvā –","“nissaṃsayaṃ eso mahābhinikkhamanaṃ nikkhamitvā buddho bhavissati, etassāhaṃ santike pabbajitvā saṃsāradukkhato muccissāmī”ti cintetvā suddhamunigaṇavantaṃ himavantaṃ gantvā tāpasapabbajjaṃ pabbaji.","Tassa parivārabhūtāni vīsatitāpasasahassāni ahesuṃ.","So aparabhāge “kassapakumāro nikkhamitvā abhisambodhiṃ anuppatto”ti sutvā saparivāro āgantvā kassapassa bhagavato santike saparivāro ehibhikkhupabbajjāya pabbajitvā arahattaṃ pāpuṇi.","Tasmiṃ samāgame kassapo bhagavā māghapuṇṇamāyaṃ pātimokkhaṃ uddisi.","Tena vuttaṃ –"],"lineRefs":[["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"]]},{"para":3774,"vripara":"8","refs":["bv26:7"],"lines":["“Tassāpi devadevassa, eko āsi samāgamo;"],"lineRefs":[["bv26:7"]]},{"para":3775,"vripara":null,"refs":["bv26:7"],"lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ."],"lineRefs":[["bv26:7"]]},{"para":3777,"vripara":"9","refs":["bv26:7"],"lines":["“Vīsabhikkhusahassānaṃ, tadā āsi samāgamo;"],"lineRefs":[["bv26:7"]]},{"para":3778,"vripara":null,"refs":["bv26:7"],"lines":["Atikkantabhavantānaṃ, hirisīlena tādinan”ti."],"lineRefs":[["bv26:7"]]},{"para":3779,"vripara":null,"refs":["bv26:9"],"lines":["Tattha <b>atikkantabhavantānan</b>ti atikkantaputhujjanasotāpannādīnaṃ, sabbesaṃ khīṇāsavānamevāti attho.","<b>Hirisīlena tādinan</b>ti hiriyā ca sīlena ca sadisānaṃ."],"lineRefs":[["bv26:9"],["bv26:9"]]},{"para":3780,"vripara":null,"refs":["bv26:9"],"lines":["Tadā amhākaṃ bodhisatto jotipālo nāma māṇavo tiṇṇaṃ vedānaṃ pāragū bhūmiyañceva antalikkhe ca pākaṭo ghaṭikārassa kumbhakārassa sahāyo ahosi.","So tena saddhiṃ satthāraṃ upasaṅkamitvā tassa dhammakathaṃ sutvā tassa santike pabbaji.","So āraddhavīriyo tīṇi piṭakāni uggahetvā vattapaṭipattiyā buddhasāsanaṃ sobhesi.","Sopi taṃ satthā byākāsi.","Tena vuttaṃ –"],"lineRefs":[["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"]]},{"para":3782,"vripara":"10","refs":["bv26:9"],"lines":["“Ahaṃ tadā māṇavako, jotipāloti vissuto;"],"lineRefs":[["bv26:9"]]},{"para":3783,"vripara":null,"refs":["bv26:9"],"lines":["Ajjhāyako mantadharo, tiṇṇaṃ vedāna pāragū."],"lineRefs":[["bv26:9"]]},{"para":3785,"vripara":"11","refs":["bv26:9"],"lines":["“Lakkhaṇe itihāse ca, sadhamme pāramiṃ gato;"],"lineRefs":[["bv26:9"]]},{"para":3786,"vripara":null,"refs":["bv26:9"],"lines":["Bhūmantalikkhakusalo, katavijjo anavayo."],"lineRefs":[["bv26:9"]]},{"para":3788,"vripara":"12","refs":["bv26:9"],"lines":["“Kassapassa bhagavato, ghaṭikāro nāmupaṭṭhako;"],"lineRefs":[["bv26:9"]]},{"para":3789,"vripara":null,"refs":["bv26:9"],"lines":["Sagāravo sappatisso, nibbuto tatiye phale."],"lineRefs":[["bv26:9"]]},{"para":3791,"vripara":"13","refs":["bv26:9"],"lines":["“Ādāya maṃ ghaṭīkāro, upagañchi kassapaṃ jinaṃ;"],"lineRefs":[["bv26:9"]]},{"para":3792,"vripara":null,"refs":["bv26:9"],"lines":["Tassa dhammaṃ suṇitvāna, pabbajiṃ tassa santike."],"lineRefs":[["bv26:9"]]},{"para":3794,"vripara":"14","refs":["bv26:9"],"lines":["“Āraddhavīriyo hutvā, vattāvattesu kovido;"],"lineRefs":[["bv26:9"]]},{"para":3795,"vripara":null,"refs":["bv26:9"],"lines":["Na kvaci parihāyāmi, pūresiṃ jinasāsanaṃ."],"lineRefs":[["bv26:9"]]},{"para":3797,"vripara":"15","refs":["bv26:9"],"lines":["“Yāvatā buddhabhaṇitaṃ, navaṅgaṃ jinasāsanaṃ;"],"lineRefs":[["bv26:9"]]},{"para":3798,"vripara":null,"refs":["bv26:9"],"lines":["Sabbaṃ pariyāpuṇitvāna, sobhayiṃ jinasāsanaṃ."],"lineRefs":[["bv26:9"]]},{"para":3800,"vripara":"16","refs":["bv26:9"],"lines":["“Mama acchariyaṃ disvā, sopi buddho viyākari;"],"lineRefs":[["bv26:9"]]},{"para":3801,"vripara":null,"refs":["bv26:9"],"lines":["Imamhi bhaddake kappe, ayaṃ buddho bhavissati."],"lineRefs":[["bv26:9"]]},{"para":3803,"vripara":"17","refs":["bv26:9"],"lines":["“Ahu kapilavhayā rammā … pe … hessāma sammukhā imaṃ."],"lineRefs":[["bv26:9"]]},{"para":3805,"vripara":"30","refs":["bv26:9"],"lines":["“Tassāpi vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[["bv26:9"]]},{"para":3806,"vripara":null,"refs":["bv26:9"],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā."],"lineRefs":[["bv26:9"]]},{"para":3808,"vripara":"31","refs":["bv26:9"],"lines":["“Evamahaṃ saṃsaritvā, parivajjento anācaraṃ;"],"lineRefs":[["bv26:9"]]},{"para":3809,"vripara":null,"refs":["bv26:9"],"lines":["Dukkarañca kataṃ mayhaṃ, bodhiyāyeva kāraṇā”ti."],"lineRefs":[["bv26:9"]]},{"para":3810,"vripara":null,"refs":["bv26:9"],"lines":["Tattha <b>bhūmantalikkhakusalo</b>ti bhūmisikkhāsu ca antalikkhesu ca joticakkācāre jotivijjāya ca kusaloti attho.","<b>Upaṭṭhako</b>ti upaṭṭhāyako.","<b>Sappatisso</b>ti sappatissayo.","<b>Nibbuto</b>ti vinīto, vissuto vā.","<b>Tatiye phale</b>ti nimittasattamī, tatiyaphalādhigamahetu nibbutoti attho.","<b>Ādāyā</b>ti maṃ gahetvā.","<b>Vattāvattesū</b>ti khuddakavattamahāvattesu.","<b>Kovido</b>ti tesaṃ pūraṇe kusalo.","<b>Na kvaci parihāyāmī</b>ti kvacipi sīlesu vā samādhisamāpattiādīsu vā katthaci kutopi na parihāyāmi, sabbattha me parihāni nāma na vijjatīti dīpeti.","“Na koci parihāyāmī” tipi pāṭho, soyevattho."],"lineRefs":[["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"]]},{"para":3811,"vripara":null,"refs":["bv26:9","bv26:31"],"lines":["<b>Yāvatā</b>ti paricchedavacanametaṃ, yāvatakanti attho.","<b>Buddhabhaṇitan</b>ti buddhavacanaṃ.","<b>Sobhayin</b>ti sobhesiṃ pakāsesiṃ.","<b>Mama acchariyan</b>ti mama sammāpaṭipattiṃ aññehi asādhāraṇaṃ acchariyaṃ abbhutaṃ kassapo bhagavā disvāti attho.","<b>Saṃsaritvā</b>ti saṃsāre saṃsaritvā.","<b>Anācaran</b>ti anācāraṃ akattabbaṃ, akaraṇīyanti attho."],"lineRefs":[["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:31"],["bv26:31"]]}],"wordLinks":[["bv26:7.1","dhammaṃ",0,8],["bv26:7.1","naradevassa yakkhassā",1,10],["bv26:7.1","apare dhammadesane",1,11],["bv26:7.3","etesānaṃ",1,12],["bv26:9.3","atikkantabhavantānaṃ",7,0],["bv26:9.3","hirisīlena tādinaṃ",7,1],["bv26:31.1","saṃsaritvā",29,4],["bv26:31.1","anācaraṃ",29,5]],"before":[{"para":3737,"vripara":null,"refs":[],"lines":["“Sukhena koṇāgamano gatāsavo, vikāmapāṇāgamano mahesī;"],"lineRefs":[[]]},{"para":3738,"vripara":null,"refs":[],"lines":["Vane viveke sirināmadheyye, visuddhavaṃsāgamano vasittha”."],"lineRefs":[[]]},{"para":3739,"vripara":null,"refs":[],"lines":["Sesagāthāsu sabbattha pākaṭamevāti."],"lineRefs":[[]]},{"para":3740,"vripara":null,"refs":[],"lines":["Koṇāgamanabuddhavaṃsavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3741,"vripara":null,"refs":[],"lines":["Niṭṭhito tevīsatimo buddhavaṃso."],"lineRefs":[[]]},{"para":3742,"vripara":null,"refs":[],"lines":["Kassapabuddhavaṃsavaṇṇanā"],"lineRefs":[[]]},{"para":3743,"vripara":null,"refs":[],"lines":["Koṇāgamanassa pana bhagavato aparabhāge tassa sāsane ca antarahite tiṃsavassasahassāyukā sattā anupubbena parihāyitvā dasavassāyukā hutvā puna vaḍḍhitvā aparimitāyukā hutvā puna anupubbena parihāyitvā vīsativassasahassāyukesu sattesu jātesu anekamanussapo <b>kassapo</b> nāma satthā loke udapādi (su. ni. aṭṭha. āmakagandhasuttavaṇṇanā).","So pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā bārāṇasīnagare brahmadattassa nāma brāhmaṇassa vipulaguṇavatiyā dhanavatiyā nāma brāhmaṇiyā kucchismiṃ paṭisandhiṃ gahetvā dasannaṃ māsānaṃ accayena isipatane migadāye mātukucchito nikkhami.","Gottavasena panassa “kassapakumāro”ti nāmamakaṃsu.","So dve vassasahassāni agāraṃ ajjhāvasi.","Haṃsavā yasavā sirinandoti tassa tayo pāsādā ahesuṃ.","Sunandā nāma brāhmaṇippamukhāni aṭṭhacattālīsa itthisahassāni paccupaṭṭhitāni ahesuṃ."],"lineRefs":[[],[],[],[],[],[]]},{"para":3744,"vripara":null,"refs":[],"lines":["So cattāri nimittāni disvā sunandāya brāhmaṇiyā vijitasene nāma putte uppanne uppannasaṃvego “mahābhinikkhamanaṃ nikkhamissāmī”ti cintesi.","Athassa parivitakkasamanantarameva pāsādo kulālacakkamiva bhamitvā gaganatalamabbhuggantvā paramarucirakaranikaro saradasamayarajanikaro viya tārāgaṇaparivuto anekanarasataparivuto gaganatalamalaṅkaronto viya puññānubhāvaṃ pakāsento viya jananayanahadayāni ākaḍḍhento viya rukkhaggāni paraṃ sobhayamāno viya ca gantvā nigrodhabodhiṃ majjhekatvā bhūmiyaṃ patiṭṭhahi.","Atha bodhisatto mahāsatto pathaviyaṃ patiṭṭhahitvā devadattaṃ arahattaddhajamādāya pabbaji.","Tassa nāṭakitthiyo pāsādā otaritvā aḍḍhagāvutaṃ maggaṃ gantvā saparivārā senāsannivesaṃ katvā nisīdiṃsu.","Tato itthiparicārike ṭhapetvā sahāgatā sabbe pabbajiṃsu."],"lineRefs":[[],[],[],[],[]]},{"para":3745,"vripara":null,"refs":[],"lines":["Mahāpuriso kira sattāhaṃ tehi parivuto padhānacariyaṃ caritvā visākhapuṇṇamāya sunandāya nāma brāhmaṇiyā dinnaṃ madhupāyāsaṃ paribhuñjitvā khadiravane divāvihāraṃ katvā sāyanhasamaye somena nāma yavapālakena upanītā aṭṭha tiṇamuṭṭhiyo gahetvā nigrodhabodhiṃ upagantvā pañcadasahatthāyāmavitthataṃ tiṇasantharaṃ santharitvā tattha nisīditvā abhisambodhiṃ pāpuṇitvā –","“anekajātisaṃsāraṃ … pe … taṇhānaṃ khayamajjhagā”ti udānaṃ udānetvā sattasattāhaṃ vītināmetvā attanā saha pabbajitānaṃ bhikkhūnaṃ koṭiyā upanissayasampattiṃ disvā gaganatalena gantvā bārāṇasiyaṃ isipatane migadāye otaritvā tehi parivuto tattha dhammacakkaṃ pavattesi.","Tadā vīsatiyā koṭisahassānaṃ paṭhamo dhammābhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[]]},{"para":3747,"vripara":"1","refs":[],"lines":["“Koṇāgamanassa aparena, sambuddho dvipaduttamo;"],"lineRefs":[[]]},{"para":3748,"vripara":null,"refs":[],"lines":["Kassapo nāma gottena, dhammarājā pabhaṅkaro."],"lineRefs":[[]]},{"para":3750,"vripara":"2","refs":[],"lines":["“Sañchaḍḍitaṃ kulamūlaṃ, bahvannapānabhojanaṃ;"],"lineRefs":[[]]},{"para":3751,"vripara":null,"refs":[],"lines":["Datvāna yācake dānaṃ, pūrayitvāna mānasaṃ;"],"lineRefs":[[]]},{"para":3752,"vripara":null,"refs":[],"lines":["Usabhova āḷakaṃ bhetvā, patto sambodhimuttamaṃ."],"lineRefs":[[]]},{"para":3754,"vripara":"3","refs":[],"lines":["“Dhammacakkaṃ pavattente, kassape lokanāyake;"],"lineRefs":[[]]},{"para":3755,"vripara":null,"refs":[],"lines":["Vīsakoṭisahassānaṃ, paṭhamābhisamayo ahū”ti."],"lineRefs":[[]]},{"para":3756,"vripara":null,"refs":[],"lines":["Tattha <b>sañchaḍḍitan</b>ti chaḍḍitaṃ ujjhitaṃ pariccattaṃ.","<b>Kulamūlan</b>ti kulagharaṃ, aparimitabhogakkhandhaṃ anekakoṭisahassadhanasañcayaṃ dasasatanayanabhavanasadisabhogaṃ atiduccajaṃ tiṇamiva chaḍḍitanti attho.","<b>Yācake</b>ti yācakānaṃ datvā.","<b>Āḷakan</b>ti goṭṭhaṃ, yathā usabho goṭṭhaṃ bhinditvā yathāsukhaṃ icchitaṭṭhānaṃ pāpuṇāti, evaṃ mahāpurisopi gehabandhanaṃ bhinditvā abhisambodhiṃ pāpuṇīti attho."],"lineRefs":[[],[],[],[]]},{"para":3757,"vripara":null,"refs":[],"lines":["Puna catumāsaṃ janapadacārikaṃ caramāne satthari dasakoṭisahassānaṃ dutiyo abhisamayo ahosi.","Yadā pana sundaranagaradvāre asanarukkhamūle yamakapāṭihāriyaṃ karonto dhammaṃ desesi, tadā pañcannaṃ koṭisahassānaṃ tatiyo abhisamayo ahosi.","Puna yamakapāṭihāriyaṃ katvā suraripudurabhibhavane tāvatiṃsabhavane sudhammā nāma devasabhā atthi, tattha nisīditvā attano mātaraṃ dhanavatīdeviṃ pamukhaṃ katvā dasasahassilokadhātuyā devatānaṃ anuggahakaraṇatthaṃ sattappakaraṇaṃ abhidhammapiṭakaṃ desento tīṇi devatākoṭisahassāni dhammāmataṃ pāyesi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[]]},{"para":3759,"vripara":"4","refs":[],"lines":["“Catumāsaṃ yadā buddho, loke carati cārikaṃ;"],"lineRefs":[[]]},{"para":3760,"vripara":null,"refs":[],"lines":["Dasakoṭisahassānaṃ, dutiyābhisamayo ahu."],"lineRefs":[[]]},{"para":3762,"vripara":"5","refs":[],"lines":["“Yamakaṃ vikubbanaṃ katvā, ñāṇadhātuṃ pakittayi;"],"lineRefs":[[]]},{"para":3763,"vripara":null,"refs":[],"lines":["Pañcakoṭisahassānaṃ, tatiyābhisamayo ahu."],"lineRefs":[[]]},{"para":3765,"vripara":"6","refs":[],"lines":["“Sudhammā devapure ramme, tattha dhammaṃ pakittayi;"],"lineRefs":[[]]},{"para":3766,"vripara":null,"refs":[],"lines":["Tīṇikoṭisahassānaṃ, devānaṃ bodhayī jino."],"lineRefs":[[]]},{"para":3768,"vripara":"7","refs":[],"lines":["“Naradevassa yakkhassa, apare dhammadesane;"],"lineRefs":[[]]},{"para":3769,"vripara":null,"refs":[],"lines":["Etesānaṃ abhisamayā, gaṇanāto asaṅkhiyā”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
