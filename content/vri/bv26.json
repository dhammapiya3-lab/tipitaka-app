{"suttaId":"bv26","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[2930,3086],"vripara":"1"},"segments":{"bv26:0.2":"Kassapabuddhavaṃso","bv26:1.1":"Koṇāgamanassa aparena,","bv26:1.2":"sambuddho dvipaduttamo;","bv26:1.3":"Kassapo nāma gottena,","bv26:1.4":"dhammarājā pabhaṅkaro. 2.","bv26:2.1":"Sañchaḍḍitaṃ kulamūlaṃ,","bv26:2.2":"bahvannapānabhojanaṃ;","bv26:2.3":"Datvāna yācake dānaṃ,","bv26:2.4":"pūrayitvāna mānasaṃ;","bv26:2.5":"Usabhova āḷakaṃ bhetvā,","bv26:2.6":"patto sambodhimuttamaṃ. 3.","bv26:3.1":"Dhammacakkaṃ pavattente,","bv26:3.2":"kassape lokanāyake;","bv26:3.3":"Vīsakoṭisahassānaṃ,","bv26:3.4":"paṭhamābhisamayo ahu. 4.","bv26:4.1":"Catumāsaṃ yadā buddho,","bv26:4.2":"loke carati cārikaṃ;","bv26:4.3":"Dasakoṭisahassānaṃ,","bv26:4.4":"dutiyābhisamayo ahu. 5.","bv26:5.1":"Yamakaṃ vikubbanaṃ katvā,","bv26:5.2":"ñāṇadhātuṃ pakittayi;","bv26:5.3":"Pañcakoṭisahassānaṃ,","bv26:5.4":"tatiyābhisamayo ahu. 6.","bv26:6.1":"Sudhammā devapure ramme,","bv26:6.2":"tattha dhammaṃ pakittayi;","bv26:6.3":"Tīṇikoṭisahassānaṃ,","bv26:6.4":"devānaṃ bodhayī jino. 7.","bv26:7.1":"Naradevassa yakkhassa,","bv26:7.2":"apare dhammadesane;","bv26:7.3":"Etesānaṃ abhisamayā,","bv26:7.4":"gaṇanāto asaṅkhiyā. 8.","bv26:8.1":"Tassāpi devadevassa,","bv26:8.2":"eko āsi samāgamo;","bv26:8.3":"Khīṇāsavānaṃ vimalānaṃ,","bv26:8.4":"santacittāna tādinaṃ. 9.","bv26:9.1":"Vīsabhikkhusahassānaṃ,","bv26:9.2":"tadā āsi samāgamo;","bv26:9.3":"Atikkantabhavantānaṃ,","bv26:9.4":"hirisīlena tādinaṃ. 10.","bv26:10.1":"Ahaṃ tadā māṇavako,","bv26:10.2":"jotipāloti vissuto;","bv26:10.3":"Ajjhāyako mantadharo,","bv26:10.4":"tiṇṇaṃ vedāna pāragū. 11.","bv26:11.1":"Lakkhaṇe itihāse ca,","bv26:11.2":"sadhamme pāramiṃ gato;","bv26:11.3":"Bhūmantalikkhakusalo,","bv26:11.4":"katavijjo anāvayo. 12.","bv26:12.1":"Kassapassa bhagavato,","bv26:12.2":"ghaṭikāro nāmupaṭṭhāko;","bv26:12.3":"Sagāravo sappatisso,","bv26:12.4":"nibbuto tatiye phale. 13.","bv26:13.1":"Ādāya maṃ ghaṭīkāro,","bv26:13.2":"upagañchi kassapaṃ jinaṃ;","bv26:13.3":"Tassa dhammaṃ suṇitvāna,","bv26:13.4":"pabbajiṃ tassa santike. 14.","bv26:14.1":"Āraddhavīriyo hutvā,","bv26:14.2":"vattāvattesu kovido;","bv26:14.3":"Na kvaci parihāyāmi,","bv26:14.4":"pūresiṃ jinasāsanaṃ. 15.","bv26:15.1":"Yāvatā buddhabhaṇitaṃ,","bv26:15.2":"navaṅgaṃ jinasāsanaṃ;","bv26:15.3":"Sabbaṃ pariyāpuṇitvāna,","bv26:15.4":"sobhayiṃ jinasāsanaṃ. 16.","bv26:16.1":"Mama acchariyaṃ disvā,","bv26:16.2":"sopi buddho viyākari;","bv26:16.3":"“Imamhi bhaddake kappe,","bv26:16.4":"ayaṃ buddho bhavissati. 17.","bv26:17.1":"“Ahu kapilavhayā rammā,","bv26:17.2":"nikkhamitvā tathāgato;","bv26:17.3":"Padhānaṃ padahitvāna,","bv26:17.4":"katvā dukkarakārikaṃ. 18.","bv26:18.1":"“Ajapālarukkhamūle,","bv26:18.2":"nisīditvā tathāgato;","bv26:18.3":"Tattha pāyāsaṃ paggayha,","bv26:18.4":"nerañjaramupehiti. 19.","bv26:19.1":"“Nerañjarāya tīramhi,","bv26:19.2":"pāyāsaṃ paribhuñjiya;","bv26:19.3":"Paṭiyattavaramaggena,","bv26:19.4":"bodhimūlamupehiti. 20.","bv26:20.1":"“Tato padakkhiṇaṃ katvā,","bv26:20.2":"bodhimaṇḍaṃ anuttaro;","bv26:20.3":"Aparājitaṭṭhānamhi [aparājitanisabhaṭṭhāne (ka.)],","bv26:20.4":"bodhipallaṅkamuttame;","bv26:20.5":"Pallaṅkena nisīditvā,","bv26:20.6":"bujjhissati mahāyaso. 21.","bv26:21.1":"“Imassa janikā mātā,","bv26:21.2":"māyā nāma bhavissati;","bv26:21.3":"Pitā suddhodano nāma,","bv26:21.4":"ayaṃ hessati gotamo. 22.","bv26:22.1":"“Anāsavā vītarāgā,","bv26:22.2":"santacittā samāhitā;","bv26:22.3":"Kolito upatisso ca,","bv26:22.4":"aggā hessanti sāvakā;","bv26:22.5":"Ānando nāmupaṭṭhāko,","bv26:22.6":"upaṭṭhissatimaṃ jinaṃ. 23.","bv26:23.1":"“Khemā uppalavaṇṇā ca,","bv26:23.2":"aggā hessanti sāvikā;","bv26:23.3":"Anāsavā santacittā,","bv26:23.4":"vītarāgā samāhitā;","bv26:23.5":"Bodhi tassa bhagavato,","bv26:23.6":"assatthoti pavuccati. 24.","bv26:24.1":"“Citto hatthāḷavako ca,","bv26:24.2":"aggā hessantupaṭṭhakā;","bv26:24.3":"Nandamātā ca uttarā,","bv26:24.4":"aggā hessantupaṭṭhikā”. 25.","bv26:25.1":"Idaṃ sutvāna vacanaṃ,","bv26:25.2":"assamassa mahesino;","bv26:25.3":"Āmoditā naramarū,","bv26:25.4":"buddhabījaṃ kira ayaṃ. 26.","bv26:26.1":"Ukkuṭṭhisaddā pavattanti,","bv26:26.2":"apphoṭenti hasanti ca;","bv26:26.3":"Katañjalī namassanti,","bv26:26.4":"dasasahassī sadevakā. 27.","bv26:27.1":"“Yadimassa lokanāthassa,","bv26:27.2":"virajjhissāma sāsanaṃ;","bv26:27.3":"Anāgatamhi addhāne,","bv26:27.4":"hessāma sammukhā imaṃ. 28.","bv26:28.1":"“Yathā manussā nadiṃ tarantā,","bv26:28.2":"paṭititthaṃ virajjhiya;","bv26:28.3":"Heṭṭhā titthe gahetvāna,","bv26:28.4":"uttaranti mahānadiṃ. 29.","bv26:29.1":"“Evameva mayaṃ sabbe,","bv26:29.2":"yadi muñcāmimaṃ jinaṃ;","bv26:29.3":"Anāgatamhi addhāne,","bv26:29.4":"hessāma sammukhā imaṃ”. 30.","bv26:30.1":"Tassāpi vacanaṃ sutvā,","bv26:30.2":"bhiyyo cittaṃ pasādayiṃ;","bv26:30.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv26:30.4":"dasapāramipūriyā. 31.","bv26:31.1":"Evamahaṃ saṃsaritvā,","bv26:31.2":"parivajjento anācaraṃ;","bv26:31.3":"Dukkarañca kataṃ mayhaṃ,","bv26:31.4":"bodhiyāyeva kāraṇā. 32.","bv26:32.1":"Nagaraṃ bārāṇasī nāma,","bv26:32.2":"kikī nāmāsi khattiyo;","bv26:32.3":"Vasate tattha nagare,","bv26:32.4":"sambuddhassa mahākulaṃ. 33.","bv26:33.1":"Brāhmaṇo brahmadattova,","bv26:33.2":"āsi buddhassa so pitā;","bv26:33.3":"Dhanavatī nāma janikā,","bv26:33.4":"kassapassa mahesino. 34.","bv26:34.1":"Duve vassasahassāni,","bv26:34.2":"agāraṃ ajjha so vasi;","bv26:34.3":"Haṃso yaso sirinando,","bv26:34.4":"tayo pāsādamuttamā. 35.","bv26:35.1":"Tisoḷasasahassāni,","bv26:35.2":"nāriyo samalaṅkatā;","bv26:35.3":"Sunandā nāma sā nārī,","bv26:35.4":"vijitaseno nāma atrajo. 36.","bv26:36.1":"Nimitte caturo disvā,","bv26:36.2":"pāsādenābhinikkhami;","bv26:36.3":"Sattāhaṃ padhānacāraṃ,","bv26:36.4":"acarī purisuttamo. 37.","bv26:37.1":"Brahmunā yācito santo,","bv26:37.2":"kassapo lokanāyako;","bv26:37.3":"Vatti cakkaṃ mahāvīro,","bv26:37.4":"migadāye naruttamo. 38.","bv26:38.1":"Tisso ca bhāradvājo ca,","bv26:38.2":"ahesuṃ aggasāvakā;","bv26:38.3":"Sabbamitto nāmupaṭṭhāko,","bv26:38.4":"kassapassa mahesino. 39.","bv26:39.1":"Anuḷā uruveḷā ca, ahesuṃ aggasāvikā;","bv26:39.3":"Bodhi tassa bhagavato,","bv26:39.4":"nigrodhoti pavuccati. 40.","bv26:40.1":"Sumaṅgalo ghaṭikāro ca,","bv26:40.2":"ahesuṃ aggupaṭṭhakā;","bv26:40.3":"Vicitasenā bhaddā [bhadrā (ka.)] ca,","bv26:40.4":"ahesuṃ aggupaṭṭhikā. 41.","bv26:41.1":"Uccattanena so buddho,","bv26:41.2":"vīsatiratanuggato;","bv26:41.3":"Vijjulaṭṭhīva ākāse,","bv26:41.4":"candova gahapūrito. 42.","bv26:42.1":"Vīsativassasahassāni,","bv26:42.2":"āyu tassa mahesino;","bv26:42.3":"Tāvatā tiṭṭhamāno so,","bv26:42.4":"tāresi janataṃ bahuṃ. 43.","bv26:43.1":"Dhammataḷākaṃ māpayitvā,","bv26:43.2":"sīlaṃ datvā vilepanaṃ;","bv26:43.3":"Dhammadussaṃ nivāsetvā,","bv26:43.4":"dhammamālaṃ vibhajjiya. 44.","bv26:44.1":"Dhammavimalamādāsaṃ,","bv26:44.2":"ṭhapayitvā mahājane;","bv26:44.3":"Keci nibbānaṃ patthentā,","bv26:44.4":"passantu me alaṅkaraṃ. 45.","bv26:45.1":"Sīlakañcukaṃ datvāna,","bv26:45.2":"jhānakavacavammitaṃ;","bv26:45.3":"Dhammacammaṃ pārupitvā,","bv26:45.4":"datvā sannāhamuttamaṃ. 46.","bv26:46.1":"Satiphalakaṃ datvāna,","bv26:46.2":"tikhiṇañāṇakuntimaṃ;","bv26:46.3":"Dhammakhaggavaraṃ datvā,","bv26:46.4":"sīlasaṃsaggamaddanaṃ. 47.","bv26:47.1":"Tevijjābhūsanaṃ datvāna,","bv26:47.2":"āveḷaṃ caturo phale;","bv26:47.3":"Chaḷabhiññābharaṇaṃ datvā,","bv26:47.4":"dhammapupphapiḷandhanaṃ. 48.","bv26:48.1":"Saddhammapaṇḍaracchattaṃ,","bv26:48.2":"datvā pāpanivāraṇaṃ;","bv26:48.3":"Māpayitvābhayaṃ pupphaṃ,","bv26:48.4":"nibbuto so sasāvako. 49.","bv26:49.1":"Eso hi sammāsambuddho,","bv26:49.2":"appameyyo durāsado;","bv26:49.3":"Eso hi dhammaratano,","bv26:49.4":"svākkhāto ehipassiko. 50.","bv26:50.1":"Eso hi saṅgharatano,","bv26:50.2":"suppaṭipanno anuttaro;","bv26:50.3":"Sabbaṃ tamantarahitaṃ,","bv26:50.4":"nanu rittā sabbasaṅkhārā. 51.","bv26:51.1":"Mahākassapo jino satthā,","bv26:51.2":"setabyārāmamhi nibbuto;","bv26:51.3":"Tatthevassa jinathūpo,","bv26:51.4":"yojanubbedhamuggatoti.","bv26:52.1":"Kassapassa bhagavato vaṃso catuvīsatimo. 27."},"unsure":["bv26:39.1"],"preface":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":3770,"to":3811,"paras":[{"para":3770,"vripara":null,"refs":["bv26:7"],"lines":["Tattha <b>catumāsa</b>nti cātumāse.","Ayameva vā pāṭho.","<b>Caratī</b>ti acari.","<b>Yamakaṃ vikubbanaṃ katvā</b>ti yamakapāṭihāriyaṃ katvā.","<b>Ñāṇadhātu</b>nti sabbaññutaññāṇasabhāvaṃ.","“Sabbañāṇadhātu”ntipi vadanti.","<b>Pakittayī</b>ti mahājanassa pakāsesi.","<b>Sudhammā</b>ti tāvatiṃsabhavane sudhammā nāma sabhā atthi, tattha nisīditvāti attho.","<b>Dhamma</b>nti abhidhammaṃ."],"lineRefs":[["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"]]},{"para":3771,"vripara":null,"refs":["bv26:7"],"lines":["Tadā kira ānubhāvavijitanaradevo naradevo nāma mahesakkho heṭṭhā vuttanaradevayakkho viya mahiddhiko yakkho ahosi.","So jambudīpe ekasmiṃ nagare rañño yādisaṃ rūpaṃ, tādisaṃ rūpasaṇṭhānaṃ sarakuttiṃ nimminitvā taṃ rājānaṃ māretvā khāditvā sahaantepuraṃ rajjaṃ paṭipajjitvā aparimitamaṃsabhojano ahosi.","So kira itthidhutto ca ahosi.","Yadā pana taṃ kusalā chekā itthiyo –","“nāyaṃ amhākaṃ rājā, amanusso eso”ti jānanti, tadā so lajjito hutvā tā sabbā khāditvā aññaṃ nagaraṃ paṭipajjati.","Evameva so naradevayakkho manusse bhakkhayanto yadā sundaranagarābhimukho agamāsi, tadā taṃ disvā nagaravāsino manussā maraṇabhayatajjitasantāsā sakanagarato nikkhamitvā tato tato palāyiṃsu.","Atha te manusse palāyamāne disvā kassapadasabalo tassa naradevassa yakkhassa purato aṭṭhāsi.","Naradevo evaṃ devadevaṃ ṭhitaṃ disvā vissaraṃ ghoraṃ nādaṃ naditvā bhagavato bhayaṃ uppādetuṃ asakkonto taṃ saraṇaṃ gantvā pañhaṃ pucchi.","Pañhaṃ vissajjetvā taṃ dametvā dhamme desiyamāne sampattānaṃ naramarānaṃ gaṇanapathātītānaṃ abhisamayo ahosi.","Tena vuttaṃ –","<b>“naradevassa yakkhassā”</b>tiādi.","Tattha <b>apare dhammadesane</b>ti aparasmiṃ dhammadesane.","<b>Etesāna</b>nti etesaṃ.","Ayameva vā pāṭho."],"lineRefs":[["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"]]},{"para":3772,"vripara":null,"refs":["bv26:7"],"lines":["Tassa pana kassapabhagavato ekova sāvakasannipāto ahosi.","Bārāṇasīnagare purohitaputto tisso nāma ahosi.","So kassapassa bodhisattassa sarīre lakkhaṇasampattiṃ disvā pituno bhāsato sutvā –","“nissaṃsayaṃ eso mahābhinikkhamanaṃ nikkhamitvā buddho bhavissati, etassāhaṃ santike pabbajitvā saṃsāradukkhato muccissāmī”ti cintetvā suddhamunigaṇavantaṃ himavantaṃ gantvā tāpasapabbajjaṃ pabbaji.","Tassa parivārabhūtāni vīsatitāpasasahassāni ahesuṃ.","So aparabhāge “kassapakumāro nikkhamitvā abhisambodhiṃ anuppatto”ti sutvā saparivāro āgantvā kassapassa bhagavato santike saparivāro ehibhikkhupabbajjāya pabbajitvā arahattaṃ pāpuṇi.","Tasmiṃ samāgame kassapo bhagavā māghapuṇṇamāyaṃ pātimokkhaṃ uddisi.","Tena vuttaṃ – 8."],"lineRefs":[["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"],["bv26:7"]]},{"para":3774,"vripara":"8","refs":["bv26:7"],"lines":["“Tassāpi devadevassa, eko āsi samāgamo;"],"lineRefs":[["bv26:7"]]},{"para":3775,"vripara":null,"refs":["bv26:7"],"lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ. 9."],"lineRefs":[["bv26:7"]]},{"para":3777,"vripara":"9","refs":["bv26:7"],"lines":["“Vīsabhikkhusahassānaṃ, tadā āsi samāgamo;"],"lineRefs":[["bv26:7"]]},{"para":3778,"vripara":null,"refs":["bv26:7"],"lines":["Atikkantabhavantānaṃ, hirisīlena tādina”nti."],"lineRefs":[["bv26:7"]]},{"para":3779,"vripara":null,"refs":["bv26:9"],"lines":["Tattha <b>atikkantabhavantāna</b>nti atikkantaputhujjanasotāpannādīnaṃ, sabbesaṃ khīṇāsavānamevāti attho.","<b>Hirisīlena tādina</b>nti hiriyā ca sīlena ca sadisānaṃ."],"lineRefs":[["bv26:9"],["bv26:9"]]},{"para":3780,"vripara":null,"refs":["bv26:9"],"lines":["Tadā amhākaṃ bodhisatto jotipālo nāma māṇavo tiṇṇaṃ vedānaṃ pāragū bhūmiyañceva antalikkhe ca pākaṭo ghaṭikārassa kumbhakārassa sahāyo ahosi.","So tena saddhiṃ satthāraṃ upasaṅkamitvā tassa dhammakathaṃ sutvā tassa santike pabbaji.","So āraddhavīriyo tīṇi piṭakāni uggahetvā vattapaṭipattiyā buddhasāsanaṃ sobhesi.","Sopi taṃ satthā byākāsi.","Tena vuttaṃ – 10."],"lineRefs":[["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"]]},{"para":3782,"vripara":"10","refs":["bv26:9"],"lines":["“Ahaṃ tadā māṇavako, jotipāloti vissuto;"],"lineRefs":[["bv26:9"]]},{"para":3783,"vripara":null,"refs":["bv26:9"],"lines":["Ajjhāyako mantadharo, tiṇṇaṃ vedāna pāragū. 11."],"lineRefs":[["bv26:9"]]},{"para":3785,"vripara":"11","refs":["bv26:9"],"lines":["“Lakkhaṇe itihāse ca, sadhamme pāramiṃ gato;"],"lineRefs":[["bv26:9"]]},{"para":3786,"vripara":null,"refs":["bv26:9"],"lines":["Bhūmantalikkhakusalo, katavijjo anavayo. 12."],"lineRefs":[["bv26:9"]]},{"para":3788,"vripara":"12","refs":["bv26:9"],"lines":["“Kassapassa bhagavato, ghaṭikāro nāmupaṭṭhako;"],"lineRefs":[["bv26:9"]]},{"para":3789,"vripara":null,"refs":["bv26:9"],"lines":["Sagāravo sappatisso, nibbuto tatiye phale. 13."],"lineRefs":[["bv26:9"]]},{"para":3791,"vripara":"13","refs":["bv26:9"],"lines":["“Ādāya maṃ ghaṭīkāro, upagañchi kassapaṃ jinaṃ;"],"lineRefs":[["bv26:9"]]},{"para":3792,"vripara":null,"refs":["bv26:9"],"lines":["Tassa dhammaṃ suṇitvāna, pabbajiṃ tassa santike. 14."],"lineRefs":[["bv26:9"]]},{"para":3794,"vripara":"14","refs":["bv26:9"],"lines":["“Āraddhavīriyo hutvā, vattāvattesu kovido;"],"lineRefs":[["bv26:9"]]},{"para":3795,"vripara":null,"refs":["bv26:9"],"lines":["Na kvaci parihāyāmi, pūresiṃ jinasāsanaṃ. 15."],"lineRefs":[["bv26:9"]]},{"para":3797,"vripara":"15","refs":["bv26:9"],"lines":["“Yāvatā buddhabhaṇitaṃ, navaṅgaṃ jinasāsanaṃ;"],"lineRefs":[["bv26:9"]]},{"para":3798,"vripara":null,"refs":["bv26:9"],"lines":["Sabbaṃ pariyāpuṇitvāna, sobhayiṃ jinasāsanaṃ. 16."],"lineRefs":[["bv26:9"]]},{"para":3800,"vripara":"16","refs":["bv26:9"],"lines":["“Mama acchariyaṃ disvā, sopi buddho viyākari;"],"lineRefs":[["bv26:9"]]},{"para":3801,"vripara":null,"refs":["bv26:9"],"lines":["Imamhi bhaddake kappe, ayaṃ buddho bhavissati. 17."],"lineRefs":[["bv26:9"]]},{"para":3803,"vripara":"17","refs":["bv26:9"],"lines":["“Ahu kapilavhayā rammā…pe… hessāma sammukhā imaṃ. 30."],"lineRefs":[["bv26:9"]]},{"para":3805,"vripara":"30","refs":["bv26:9"],"lines":["“Tassāpi vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[["bv26:9"]]},{"para":3806,"vripara":null,"refs":["bv26:9"],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā. 31."],"lineRefs":[["bv26:9"]]},{"para":3808,"vripara":"31","refs":["bv26:9"],"lines":["“Evamahaṃ saṃsaritvā, parivajjento anācaraṃ;"],"lineRefs":[["bv26:9"]]},{"para":3809,"vripara":null,"refs":["bv26:9"],"lines":["Dukkarañca kataṃ mayhaṃ, bodhiyāyeva kāraṇā”ti."],"lineRefs":[["bv26:9"]]},{"para":3810,"vripara":null,"refs":["bv26:9"],"lines":["Tattha <b>bhūmantalikkhakusalo</b>ti bhūmisikkhāsu ca antalikkhesu ca joticakkācāre jotivijjāya ca kusaloti attho.","<b>Upaṭṭhako</b>ti upaṭṭhāyako.","<b>Sappatisso</b>ti sappatissayo.","<b>Nibbuto</b>ti vinīto, vissuto vā.","<b>Tatiye phale</b>ti nimittasattamī, tatiyaphalādhigamahetu nibbutoti attho.","<b>Ādāyā</b>ti maṃ gahetvā.","<b>Vattāvattesū</b>ti khuddakavattamahāvattesu.","<b>Kovido</b>ti tesaṃ pūraṇe kusalo.","<b>Na kvaci parihāyāmī</b>ti kvacipi sīlesu vā samādhisamāpattiādīsu vā katthaci kutopi na parihāyāmi, sabbattha me parihāni nāma na vijjatīti dīpeti.","“Na koci parihāyāmī”tipi pāṭho, soyevattho."],"lineRefs":[["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"]]},{"para":3811,"vripara":null,"refs":["bv26:9","bv26:31"],"lines":["<b>Yāvatā</b>ti paricchedavacanametaṃ, yāvatakanti attho.","<b>Buddhabhaṇita</b>nti buddhavacanaṃ.","<b>Sobhayi</b>nti sobhesiṃ pakāsesiṃ.","<b>Mama acchariya</b>nti mama sammāpaṭipattiṃ aññehi asādhāraṇaṃ acchariyaṃ abbhutaṃ kassapo bhagavā disvāti attho.","<b>Saṃsaritvā</b>ti saṃsāre saṃsaritvā.","<b>Anācara</b>nti anācāraṃ akattabbaṃ, akaraṇīyanti attho."],"lineRefs":[["bv26:9"],["bv26:9"],["bv26:9"],["bv26:9"],["bv26:31"],["bv26:31"]]}],"wordLinks":[["bv26:7.1","dhammaṃ",0,8],["bv26:7.1","naradevassa yakkhassā",1,10],["bv26:7.1","apare dhammadesane",1,11],["bv26:7.3","etesānaṃ",1,12],["bv26:9.3","atikkantabhavantānaṃ",7,0],["bv26:9.3","hirisīlena tādinaṃ",7,1],["bv26:31.1","saṃsaritvā",29,4],["bv26:31.1","anācaraṃ",29,5]],"before":[{"para":3742,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Kassapabuddhavaṃsavaṇṇanā"]},{"para":3743,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Koṇāgamanassa pana bhagavato aparabhāge tassa sāsane ca antarahite tiṃsavassasahassāyukā sattā anupubbena parihāyitvā dasavassāyukā hutvā puna vaḍḍhitvā aparimitāyukā hutvā puna anupubbena parihāyitvā vīsativassasahassāyukesu sattesu jātesu anekamanussapo <b>kassapo</b> nāma satthā loke udapādi (su. ni. aṭṭha. āmakagandhasuttavaṇṇanā).","So pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā bārāṇasīnagare brahmadattassa nāma brāhmaṇassa vipulaguṇavatiyā dhanavatiyā nāma brāhmaṇiyā kucchismiṃ paṭisandhiṃ gahetvā dasannaṃ māsānaṃ accayena isipatane migadāye mātukucchito nikkhami.","Gottavasena panassa “kassapakumāro”ti nāmamakaṃsu.","So dve vassasahassāni agāraṃ ajjhāvasi.","Haṃsavā yasavā sirinandoti tassa tayo pāsādā ahesuṃ.","Sunandā nāma brāhmaṇippamukhāni aṭṭhacattālīsa itthisahassāni paccupaṭṭhitāni ahesuṃ."]},{"para":3744,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["So cattāri nimittāni disvā sunandāya brāhmaṇiyā vijitasene nāma putte uppanne uppannasaṃvego “mahābhinikkhamanaṃ nikkhamissāmī”ti cintesi.","Athassa parivitakkasamanantarameva pāsādo kulālacakkamiva bhamitvā gaganatalamabbhuggantvā paramarucirakaranikaro saradasamayarajanikaro viya tārāgaṇaparivuto anekanarasataparivuto gaganatalamalaṅkaronto viya puññānubhāvaṃ pakāsento viya jananayanahadayāni ākaḍḍhento viya rukkhaggāni paraṃ sobhayamāno viya ca gantvā nigrodhabodhiṃ majjhekatvā bhūmiyaṃ patiṭṭhahi.","Atha bodhisatto mahāsatto pathaviyaṃ patiṭṭhahitvā devadattaṃ arahattaddhajamādāya pabbaji.","Tassa nāṭakitthiyo pāsādā otaritvā aḍḍhagāvutaṃ maggaṃ gantvā saparivārā senāsannivesaṃ katvā nisīdiṃsu.","Tato itthiparicārike ṭhapetvā sahāgatā sabbe pabbajiṃsu."]},{"para":3745,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Mahāpuriso kira sattāhaṃ tehi parivuto padhānacariyaṃ caritvā visākhapuṇṇamāya sunandāya nāma brāhmaṇiyā dinnaṃ madhupāyāsaṃ paribhuñjitvā khadiravane divāvihāraṃ katvā sāyanhasamaye somena nāma yavapālakena upanītā aṭṭha tiṇamuṭṭhiyo gahetvā nigrodhabodhiṃ upagantvā pañcadasahatthāyāmavitthataṃ tiṇasantharaṃ santharitvā tattha nisīditvā abhisambodhiṃ pāpuṇitvā –","“anekajātisaṃsāraṃ…pe… taṇhānaṃ khayamajjhagā”ti udānaṃ udānetvā sattasattāhaṃ vītināmetvā attanā saha pabbajitānaṃ bhikkhūnaṃ koṭiyā upanissayasampattiṃ disvā gaganatalena gantvā bārāṇasiyaṃ isipatane migadāye otaritvā tehi parivuto tattha dhammacakkaṃ pavattesi.","Tadā vīsatiyā koṭisahassānaṃ paṭhamo dhammābhisamayo ahosi.","Tena vuttaṃ – 1."]},{"para":3747,"vripara":"1","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Koṇāgamanassa aparena, sambuddho dvipaduttamo;"]},{"para":3748,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Kassapo nāma gottena, dhammarājā pabhaṅkaro. 2."]},{"para":3750,"vripara":"2","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Sañchaḍḍitaṃ kulamūlaṃ, bahvannapānabhojanaṃ;"]},{"para":3751,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Datvāna yācake dānaṃ, pūrayitvāna mānasaṃ;"]},{"para":3752,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Usabhova āḷakaṃ bhetvā, patto sambodhimuttamaṃ. 3."]},{"para":3754,"vripara":"3","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Dhammacakkaṃ pavattente, kassape lokanāyake;"]},{"para":3755,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Vīsakoṭisahassānaṃ, paṭhamābhisamayo ahū”ti."]},{"para":3756,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Tattha <b>sañchaḍḍita</b>nti chaḍḍitaṃ ujjhitaṃ pariccattaṃ.","<b>Kulamūla</b>nti kulagharaṃ, aparimitabhogakkhandhaṃ anekakoṭisahassadhanasañcayaṃ dasasatanayanabhavanasadisabhogaṃ atiduccajaṃ tiṇamiva chaḍḍitanti attho.","<b>Yācake</b>ti yācakānaṃ datvā.","<b>Āḷaka</b>nti goṭṭhaṃ, yathā usabho goṭṭhaṃ bhinditvā yathāsukhaṃ icchitaṭṭhānaṃ pāpuṇāti, evaṃ mahāpurisopi gehabandhanaṃ bhinditvā abhisambodhiṃ pāpuṇīti attho."]},{"para":3757,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Puna catumāsaṃ janapadacārikaṃ caramāne satthari dasakoṭisahassānaṃ dutiyo abhisamayo ahosi.","Yadā pana sundaranagaradvāre asanarukkhamūle yamakapāṭihāriyaṃ karonto dhammaṃ desesi, tadā pañcannaṃ koṭisahassānaṃ tatiyo abhisamayo ahosi.","Puna yamakapāṭihāriyaṃ katvā suraripudurabhibhavane tāvatiṃsabhavane sudhammā nāma devasabhā atthi, tattha nisīditvā attano mātaraṃ dhanavatīdeviṃ pamukhaṃ katvā dasasahassilokadhātuyā devatānaṃ anuggahakaraṇatthaṃ sattappakaraṇaṃ abhidhammapiṭakaṃ desento tīṇi devatākoṭisahassāni dhammāmataṃ pāyesi.","Tena vuttaṃ – 4."]},{"para":3759,"vripara":"4","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Catumāsaṃ yadā buddho, loke carati cārikaṃ;"]},{"para":3760,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Dasakoṭisahassānaṃ, dutiyābhisamayo ahu. 5."]},{"para":3762,"vripara":"5","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Yamakaṃ vikubbanaṃ katvā, ñāṇadhātuṃ pakittayi;"]},{"para":3763,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Pañcakoṭisahassānaṃ, tatiyābhisamayo ahu. 6."]},{"para":3765,"vripara":"6","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Sudhammā devapure ramme, tattha dhammaṃ pakittayi;"]},{"para":3766,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Tīṇikoṭisahassānaṃ, devānaṃ bodhayī jino. 7."]},{"para":3768,"vripara":"7","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Naradevassa yakkhassa, apare dhammadesane;"]},{"para":3769,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Etesānaṃ abhisamayā, gaṇanāto asaṅkhiyā”ti."]}],"after":[{"para":3812,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Tassa pana kassapassa bhagavato jātanagaraṃ bārāṇasī nāma ahosi, brahmadatto nāma brāhmaṇo pitā, paramaguṇavatī dhanavatī nāma brāhmaṇī mātā, tisso ca bhāradvājo ca dve aggasāvakā, sabbamitto nāmupaṭṭhāko, anuḷā ca uruveḷā ca dve aggasāvikā, nigrodharukkho bodhi, sarīraṃ vīsatihatthubbedhaṃ ahosi, vīsativassasahassāni āyu, sunandā nāmassa aggamahesī, vijitaseno nāma putto, pāsādayānena nikkhami.","Tena vuttaṃ – 32."]},{"para":3814,"vripara":"32","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Nagaraṃ bārāṇasī nāma, kikī nāmāsi khattiyo;"]},{"para":3815,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Vasate tattha nagare, sambuddhassa mahākulaṃ. 33."]},{"para":3817,"vripara":"33","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Brāhmaṇo brahmadattova, āsi buddhassa so pitā;"]},{"para":3818,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Dhanavatī nāma janikā, kassapassa mahesino. 38."]},{"para":3820,"vripara":"38","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Tisso ca bhāradvājo ca, ahesuṃ aggasāvakā;"]},{"para":3821,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Sabbamitto nāmupaṭṭhāko, kassapassa mahesino. 39."]},{"para":3823,"vripara":"39","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Anuḷā uruveḷā ca, ahesuṃ aggasāvikā;"]},{"para":3824,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Bodhi tassa bhagavato, nigrodhoti pavuccati. 41."]},{"para":3826,"vripara":"41","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Uccattanena so buddho, vīsatiratanuggato;"]},{"para":3827,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Vijjulaṭṭhīva ākāse, candova gahapūrito. 42."]},{"para":3829,"vripara":"42","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Vīsativassasahassāni, āyu tassa mahesino;"]},{"para":3830,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ. 43."]},{"para":3832,"vripara":"43","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Dhammataḷākaṃ māpayitvā, sīlaṃ datvā vilepanaṃ;"]},{"para":3833,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Dhammadussaṃ nivāsetvā, dhammamālaṃ vibhajjiya. 44."]},{"para":3835,"vripara":"44","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Dhammavimalamādāsaṃ, ṭhapayitvā mahājane;"]},{"para":3836,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Keci nibbānaṃ patthentā, passantu me alaṅkaraṃ. 45."]},{"para":3838,"vripara":"45","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Sīlakañcukaṃ datvāna, jhānakavacavammitaṃ;"]},{"para":3839,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Dhammacammaṃ pārupitvā, datvā sannāhamuttamaṃ. 46."]},{"para":3841,"vripara":"46","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Satiphalakaṃ datvāna, tikhiṇaṃ ñāṇakuntimaṃ;"]},{"para":3842,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Dhammakhaggavaraṃ datvā, sīlasaṃsaggamaddanaṃ. 47."]},{"para":3844,"vripara":"47","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Tevijjābhūsanaṃ datvāna, āveḷaṃ caturo phale;"]},{"para":3845,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Chaḷabhiññābharaṇaṃ datvā, dhammapupphapiḷandhanaṃ. 48."]},{"para":3847,"vripara":"48","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Saddhammapaṇḍaracchattaṃ, datvā pāpanivāraṇaṃ;"]},{"para":3848,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Māpayitvābhayaṃ pupphaṃ, nibbuto so sasāvako. 49."]},{"para":3850,"vripara":"49","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Eso hi sammāsambuddho, appameyyo durāsado;"]},{"para":3851,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Eso hi dhammaratano, svākkhāto ehipassiko. 50."]},{"para":3853,"vripara":"50","title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Eso hi saṅgharatano, suppaṭipanno anuttaro;"]},{"para":3854,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā”ti."]},{"para":3855,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Tattha <b>vijjulaṭṭhīvā</b>ti ghanabhāvena saṇṭhitā vijjulatā viya.","<b>Candova gahapūrito</b>ti parivesagahaparikkhito puṇṇacando viya.","<b>Dhammataḷākaṃ māpayitvā</b>ti pariyattidhammataḷākaṃ māpayitvā.","<b>Sīlaṃ datvā vilepana</b>nti catupārisuddhisīlasaṅkhātaṃ cittasantativibhūsanatthaṃ vilepanaṃ datvā.","<b>Dhammadussaṃ nivāsetvā</b>ti hirottappadhammasaṅkhātaṃ sāṭakayugaṃ nivāsetvā.","<b>Dhammamālaṃ vibhajjiyā</b>ti sattattiṃsabodhipakkhiyadhammakusumamālaṃ vibhajitvā.","Vidahitvāti attho."]},{"para":3856,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["<b>Dhammavimalamādāsa</b>nti vimalaṃ sotāpattimaggasaṅkhātaṃ ādāsaṃ sāvajjānavajjakusalākusaladhammasallakkhaṇatthaṃ mahājanassa dhammataḷākatīre dhammādāsaṃ ṭhapetvāti attho.","<b>Mahājane</b>ti mahājanassa.","<b>Kecī</b>ti ye keci.","<b>Nibbānaṃ patthentā</b>ti sabbākusalamalavilayakaraṃ amatamasaṅkhatamanītikaṃ paramasantaṃ accutirasaṃ nibbānaṃ patthentā vicaranti.","Te imaṃ alaṅkāraṃ vuttappakāraṃ mayā dassitaṃ passantūti attho.","“Nibbānamabhipatthentā, passantu maṃ alaṅkara”ntipi pāṭho, soyevattho.","Alaṅkaranti rassaṃ katvā vuttaṃ."]},{"para":3857,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["<b>Sīlakañcukaṃ datvānā</b>ti pañcasīladasasīlacatupārisuddhisīlamayaṃ kañcukaṃ datvā.","<b>Jhānakavacavammita</b>nti catukkapañcakajjhānakavacabandhaṃ bandhitvā.","<b>Dhammacammaṃ pārupitvā</b>ti satisampajaññasaṅkhātadhammacammaṃ pārupitvā.","<b>Datvā sannāhamuttama</b>nti uttamaṃ caturaṅgasamannāgataṃ vīriyasannāhaṃ datvāti attho.","<b>Satiphalakaṃ datvānā</b>ti rāgādidosāripāpanivāraṇatthaṃ catusatipaṭṭhānaphalakanivāraṇaṃ datvā.","<b>Tikhiṇaṃ ñāṇakuntima</b>nti paṭivedhasamatthaṃ tikhiṇavipassanāñāṇakuntavantaṃ, vipassanāñāṇanisitakuntavaranti attho, kilesabalanidhanakarasamatthaṃ vā yogāvacarayodhavaraṃ ṭhapetvāti attho.","<b>Dhammakhaggavaraṃ</b> <b>datvā</b>ti tassa yogāvacarassa vīriyupalatalanisitadhāraṃ maggapaññāvarakhaggaṃ datvā.","<b>Sīlasaṃsaggamaddana</b>nti ariyaṃ lokuttarasīlaṃ kilesasaṃsaggamaddanatthāya, kilesanighātanatthāyāti attho."]},{"para":3858,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["<b>Tevijjābhūsanaṃ datvā</b>ti tevijjāmayaṃ vibhūsanaṃ datvā.","<b>Āveḷaṃ caturo phale</b>ti cattāri phalāni vaṭaṃsakaṃ katvā.","<b>Chaḷabhiññābharaṇa</b>nti ābharaṇatthāya alaṅkārakaraṇatthāya cha abhiññāyo datvā.","<b>Dhammapupphapiḷandhana</b>nti navalokuttaradhammasaṅkhātaṃ kusumamālaṃ katvā.","<b>Saddhammapaṇḍaracchattaṃ, datvā pāpanivāraṇa</b>nti accantavisuddhaṃ vimuttisetacchattaṃ sabbākusalātapanivāraṇaṃ datvā.","<b>Māpayitvābhayaṃ puppha</b>nti abhayapuragāminaṃ aṭṭhaṅgikamaggaṃ pupphaṃ katvāti attho."]},{"para":3859,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Kassapo kira bhagavā kāsiraṭṭhe setabyanagare setabyuyyāne parinibbāyi.","Dhātuyo kirassa na vikiriṃsu.","Sakalajambudīpavāsino manussā sannipatitvā ekekaṃ suvaṇṇiṭṭhakaṃ koṭiagghanakaṃ ratanavicittaṃ bahicinanatthaṃ ekekaṃ aḍḍhakoṭiagghanakaṃ abbhantarapūraṇatthaṃ manosilāya mattikākiccaṃ telena udakakiccaṃ karonto yojanubbedhaṃ thūpamakaṃsu."]},{"para":3860,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["“Kassapopi bhagavā katakicco, sabbasattahitameva karonto;"]},{"para":3861,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Kāsirājanagare migadāye, lokanandanakaro nivasī”ti."]},{"para":3862,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Sesagāthāsu sabbattha pākaṭamevāti."]},{"para":3863,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Iti madhuratthavilāsiniyā buddhavaṃsa-aṭṭhakathāya"]},{"para":3864,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Kassapabuddhavaṃsavaṇṇanā niṭṭhitā."]},{"para":3865,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Ettāvatā catuvīsatiyā buddhānaṃ buddhavaṃsavaṇṇanā"]},{"para":3866,"vripara":null,"title":"Kassapabuddhavaṃsavaṇṇanā","lines":["Sabbākārena niṭṭhitā. 27."]}]},"tika":null,"tika2":null}
