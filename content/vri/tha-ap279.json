{"suttaId":"tha-ap279","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8645,8657],"vripara":"27"},"segments":{"tha-ap279:0.3":"Citakapūjakattheraapadānaṃ","tha-ap279:1.1":"“Candabhāgānadītīre,","tha-ap279:1.2":"anusotaṃ vajāmahaṃ;","tha-ap279:1.3":"Satta māluvapupphāni,","tha-ap279:1.4":"citamāropayiṃ ahaṃ. 28.","tha-ap279:2.1":"“Catunnavutito kappe,","tha-ap279:2.2":"citakaṃ yamapūjayiṃ;","tha-ap279:2.3":"Duggatiṃ nābhijānāmi,","tha-ap279:2.4":"citapūjāyidaṃ phalaṃ. 29.","tha-ap279:3.1":"“Sattasaṭṭhimhito kappe,","tha-ap279:3.2":"paṭijaggasanāmakā;","tha-ap279:3.3":"Sattaratanasampannā,","tha-ap279:3.4":"sattāsuṃ cakkavattino [paṭijaggasanāmako; sattaratanasampanno, cakkavattī mahabbalo (syā.)]. 30.","tha-ap279:4.1":"“Paṭisambhidā catasso…pe…","tha-ap279:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap279:5.1":"Itthaṃ sudaṃ āyasmā citakapūjako thero imā gāthāyo abhāsitthāti.","tha-ap279:6.1":"Citakapūjakattherassāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3237,"to":3237,"paras":[{"para":3237,"vripara":"27","refs":["tha-ap279:1"],"lines":["Sattamāpadāne <b>candabhāgānadītīre</b>ti candabhāgāya nāma nadiyā tīrato, nissakke bhummavacanaṃ.","<b>Anusota</b>nti sotassa anu heṭṭhāgaṅgaṃ <b>vajāmi</b> gacchāmi ahanti attho.","<b>Satta māluvapupphāni, citamāropayiṃ aha</b>nti ahaṃ māluvapupphāni satta pattāni gahetvā citake vālukarāsimhi vālukāhi thūpaṃ katvā pūjesinti attho. 31-32."],"lineRefs":[["tha-ap279:1"],["tha-ap279:1"],["tha-ap279:1"]]}],"wordLinks":[["tha-ap279:1.1","candabhāgānadītīre",0,0],["tha-ap279:1.1","anusotaṃ",0,1],["tha-ap279:1.1","vajāmi",0,1],["tha-ap279:1.3","satta māluvapupphāni citamāropayiṃ ahaṃ",0,2]]},"tika":null,"tika2":null}
