{"suttaId":"an4.276","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1944,1944],"vripara":"276"},"segments":{"an4.276:0.3":"Iddhipādasuttaṃ","an4.276:1.1":"“Rāgassa, bhikkhave, abhiññāya cattāro dhammā bhāvetabbā.","an4.276:1.2":"Katame cattāro?","an4.276:1.3":"Idha, bhikkhave, bhikkhu chandasamādhipadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti;","an4.276:1.4":"vīriyasamādhi … pe …","an4.276:1.5":"cittasamādhi … pe …","an4.276:1.6":"vīmaṃsāsamādhipadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti.","an4.276:1.7":"Rāgassa, bhikkhave, abhiññāya ime cattāro dhammā bhāvetabbā”ti.","an4.276:1.8":"Tatiyaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
