{"suttaId":"sn22.106","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[726,726],"vripara":"106"},"segments":{"sn22.106:0.3":"Pariññeyyasuttaṃ","sn22.106:1.1":"Sāvatthinidānaṃ.","sn22.106:1.2":"“Pariññeyye ca, bhikkhave, dhamme desessāmi pariññañca pariññātāviñca puggalaṃ.","sn22.106:1.3":"Taṃ suṇātha.","sn22.106:1.4":"Katame ca, bhikkhave, pariññeyyā dhammā?","sn22.106:1.5":"Rūpaṃ, bhikkhave, pariññeyyo dhammo.","sn22.106:1.6":"Vedanā…pe…","sn22.106:1.7":"saññā…","sn22.106:1.8":"saṅkhārā…","sn22.106:1.9":"viññāṇaṃ pariññeyyo dhammo.","sn22.106:1.10":"Ime vuccanti, bhikkhave, pariññeyyā dhammā.","sn22.106:1.11":"Katamā ca, bhikkhave, pariññā?","sn22.106:1.12":"Rāgakkhayo, dosakkhayo, mohakkhayo –","sn22.106:1.13":"ayaṃ vuccati, bhikkhave, pariññā.","sn22.106:1.14":"Katamo ca, bhikkhave, pariññātāvī puggalo?","sn22.106:1.15":"Arahātissa vacanīyaṃ.","sn22.106:1.16":"Yvāyaṃ āyasmā evaṃnāmo evaṃgotto –","sn22.106:1.17":"ayaṃ vuccati, bhikkhave, pariññātāvī puggalo”ti.","sn22.106:1.18":"Catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":365,"to":365,"paras":[{"para":365,"vripara":"106","refs":["sn22.106:1"],"lines":["Catutthe <b>pariññeyye</b>ti parijānitabbe samatikkamitabbe.","<b>Pariñña</b>nti samatikkamaṃ.","<b>Pariññātāvi</b>nti tāya pariññāya parijānitvā samatikkamitvā ṭhitaṃ.","<b>Rāgakkhayo</b>tiādīhi nibbānaṃ dassitaṃ.","Catutthaṃ. 5-10."],"lineRefs":[["sn22.106:1"],["sn22.106:1"],["sn22.106:1"],["sn22.106:1"],["sn22.106:1"]]}],"wordLinks":[["sn22.106:1.2","pariññeyye",0,0],["sn22.106:1.4","pariññeyye",0,0],["sn22.106:1.5","pariññeyye",0,0],["sn22.106:1.6","pariññeyye",0,0],["sn22.106:1.10","pariññeyye",0,0],["sn22.106:1.2","pariññaṃ",0,1],["sn22.106:1.2","pariññātāviṃ",0,2],["sn22.106:1.12","rāgakkhayo",0,3]]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":356,"to":356,"paras":[{"para":356,"vripara":"106","refs":["sn22.106:1"],"lines":["<b>Pariññeyye</b>ti ettha tisso pariññā ñātapariññā, tīraṇapariññā, pahānapariññāti.","Tāsu <b>ñātapariññā</b> yāvadeva tīraṇapariññatthā.","<b>Tīraṇapariññā ca</b> yāvadeva pahānapariññatthāti.","Tattha ukkaṭṭhāya pariññāya kiccadassanavasena atthaṃ dassento <b>“pariññeyyeti parijānitabbe samatikkamitabbe”</b>ti, pahātabbeti attho.","Tenāha bhagavā –","“katamā ca, bhikkhave, pariññā?","Rāgakkhayo, dosakkhayo, mohakkhayo”ti, tasmā <b>samatikkama</b>nti, samatikkantaṃ pahānassa upāyaṃ.","<b>Samatikkamitvā ṭhita</b>nti pajahitvā ṭhitanti ayamettha attho."],"lineRefs":[["sn22.106:1"],["sn22.106:1"],["sn22.106:1"],["sn22.106:1"],["sn22.106:1"],["sn22.106:1"],["sn22.106:1"],["sn22.106:1"]]}],"wordLinks":[["sn22.106:1.2","pariññeyye",0,0],["sn22.106:1.4","pariññeyye",0,0],["sn22.106:1.5","pariññeyye",0,0],["sn22.106:1.6","pariññeyye",0,0],["sn22.106:1.10","pariññeyye",0,0]],"after":[{"para":357,"vripara":null,"title":"Pariññeyyasuttavaṇṇanā","lines":["Pariññeyyasuttavaṇṇanā niṭṭhitā. 5-10."]}]},"tika2":null}
