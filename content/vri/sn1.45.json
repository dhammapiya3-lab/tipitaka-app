{"suttaId":"sn1.45","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[567,569],"vripara":"45"},"segments":{"sn1.45:0.3":"Anomasuttaṃ","sn1.45:1.1":"“Anomanāmaṃ nipuṇatthadassiṃ,","sn1.45:1.2":"paññādadaṃ kāmālaye asattaṃ;","sn1.45:1.3":"Taṃ passatha sabbaviduṃ sumedhaṃ,","sn1.45:1.4":"ariye pathe kamamānaṃ mahesi”nti. 6."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":407,"to":407,"paras":[{"para":407,"vripara":"45","refs":["sn1.45:1"],"lines":["Pañcame <b>anomanāma</b>nti sabbaguṇasamannāgatattā avekallanāmaṃ, paripūranāmanti attho.","<b>Nipuṇatthadassi</b>nti bhagavā saṇhasukhume khandhantarādayo atthe passatīti nipuṇatthadassī.","<b>Paññādada</b>nti anvayapaññādhigamāya paṭipadaṃ kathanavasena paññāya dāyakaṃ.","<b>Kāmālaye asatta</b>nti pañcakāmaguṇālaye alaggaṃ.","<b>Kamamāna</b>nti bhagavā mahābodhimaṇḍeyeva ariyamaggena gato, na idāni gacchati, atītaṃ pana upādāya idaṃ vuttaṃ.","<b>Mahesi</b>nti mahantānaṃ sīlakkhandhādīnaṃ esitāraṃ pariyesitāranti.","Pañcamaṃ. 6."],"lineRefs":[["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"]]}],"wordLinks":[["sn1.45:1.1","anomanāmaṃ",0,0],["sn1.45:1.1","nipuṇatthadassiṃ",0,1],["sn1.45:1.1","paññādadaṃ",0,2],["sn1.45:1.1","kāmālaye asattaṃ",0,3],["sn1.45:1.3","kamamānaṃ",0,4],["sn1.45:1.3","mahesiṃ",0,5]],"before":[{"para":406,"vripara":null,"title":"Anomasuttavaṇṇanā","lines":["Anomasuttavaṇṇanā 45."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":494,"to":494,"paras":[{"para":494,"vripara":"45","refs":["sn1.45:1"],"lines":["<b>Anomanāma</b>nti anūnanāmaṃ.","Guṇanemittikāni eva hi bhagavato nāmāni.","Guṇānañcassa paripuṇṇatāya anūnanāmanti āha <b>“sabbaguṇasamannāgatattā”</b>tiādi.","Apica tathā tevijjo, chaḷabhiññotiādīni nāmāni anomanāmāni na honti paricchinnavisayattā, bhagavato pana satthā, sabbaññū, sammāsambuddhotiādīni nāmāni anomanāmāni nāma mahāvisayattā anūnabhāvato.","Tenāha <b>“avekallanāma”</b>nti.","<b>Khandhantarādayo</b>ti khandhavisesādike.","Ñāṇena yāthāvato araṇīyaṭṭhena <b>atthe.</b>","<b>Anvayapaññādhigamāyā</b>ti lokuttarapaññāpaṭilābhāya.","<b>Paṭipada</b>nti samathavipassanāpaṭipadaṃ.","Kilesakāmānaṃ vasena allīyitabbaṭṭhena kāmā eva <b>ālayo</b>.","Atītakāleyeva kamanataṃ gahetvā vuttaṃ <b>“kamamāna”</b>nti.","Na etarahi tadabhāvatoti āha <b>“atītaṃ pana upādāya idaṃ vutta”</b>nti.","Mahānubhāvatādinā <b>mahantānaṃ</b>."],"lineRefs":[["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"]]}],"wordLinks":[["sn1.45:1.1","anomanāmaṃ",0,0],["sn1.45:1.1","atthe",0,6],["sn1.45:1.1","ālayo",0,9],["sn1.45:1.3","kamamānaṃ",0,10]],"before":[{"para":493,"vripara":null,"title":"Anomasuttavaṇṇanā","lines":["Anomasuttavaṇṇanā 45."]}],"after":[{"para":495,"vripara":null,"title":"Anomasuttavaṇṇanā","lines":["Anomasuttavaṇṇanā niṭṭhitā. 6."]}]},"tika2":null}
