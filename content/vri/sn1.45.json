{"suttaId":"sn1.45","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[567,569],"vripara":"45"},"segments":{"sn1.45:0.3":"Anomasuttaṃ","sn1.45:1.1":"“Anomanāmaṃ nipuṇatthadassiṃ, paññādadaṃ kāmālaye asattaṃ;","sn1.45:1.3":"Taṃ passatha sabbaviduṃ sumedhaṃ, ariye pathe kamamānaṃ mahesin”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":407,"to":407,"paras":[{"para":407,"vripara":"45","refs":["sn1.45:1"],"lines":["Pañcame <b>anomanāman</b>ti sabbaguṇasamannāgatattā avekallanāmaṃ, paripūranāmanti attho.","<b>Nipuṇatthadassin</b>ti bhagavā saṇhasukhume khandhantarādayo atthe passatīti nipuṇatthadassī.","<b>Paññādadan</b>ti anvayapaññādhigamāya paṭipadaṃ kathanavasena paññāya dāyakaṃ.","<b>Kāmālaye asattan</b>ti pañcakāmaguṇālaye alaggaṃ.","<b>Kamamānan</b>ti bhagavā mahābodhimaṇḍeyeva ariyamaggena gato, na idāni gacchati, atītaṃ pana upādāya idaṃ vuttaṃ.","<b>Mahesin</b>ti mahantānaṃ sīlakkhandhādīnaṃ esitāraṃ pariyesitāranti.","Pañcamaṃ."],"lineRefs":[["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"]]}],"wordLinks":[["sn1.45:1.1","anomanāmaṃ",0,0],["sn1.45:1.1","nipuṇatthadassiṃ",0,1],["sn1.45:1.1","paññādadaṃ",0,2],["sn1.45:1.1","kāmālaye asattaṃ",0,3],["sn1.45:1.3","kamamānaṃ",0,4],["sn1.45:1.3","mahesiṃ",0,5]],"before":[{"para":406,"vripara":null,"refs":[],"lines":["Anomasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":494,"to":494,"paras":[{"para":494,"vripara":"45","refs":["sn1.45:1"],"lines":["<b>Anomanāman</b>ti anūnanāmaṃ.","Guṇanemittikāni eva hi bhagavato nāmāni.","Guṇānañcassa paripuṇṇatāya anūnanāmanti āha <b>“sabbaguṇasamannāgatattā”</b>tiādi.","Apica tathā tevijjo, chaḷabhiññotiādīni nāmāni anomanāmāni na honti paricchinnavisayattā, bhagavato pana satthā, sabbaññū, sammāsambuddhotiādīni nāmāni anomanāmāni nāma mahāvisayattā anūnabhāvato.","Tenāha <b>“avekallanāman”</b>ti.","<b>Khandhantarādayo</b>ti khandhavisesādike.","Ñāṇena yāthāvato araṇīyaṭṭhena <b>atthe.</b>","<b>Anvayapaññādhigamāyā</b>ti lokuttarapaññāpaṭilābhāya.","<b>Paṭipadan</b>ti samathavipassanāpaṭipadaṃ.","Kilesakāmānaṃ vasena allīyitabbaṭṭhena kāmā eva <b>ālayo</b>.","Atītakāleyeva kamanataṃ gahetvā vuttaṃ <b>“kamamānan”</b>ti.","Na etarahi tadabhāvatoti āha <b>“atītaṃ pana upādāya idaṃ vuttan”</b>ti.","Mahānubhāvatādinā <b>mahantānaṃ</b>."],"lineRefs":[["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"],["sn1.45:1"]]}],"wordLinks":[["sn1.45:1.1","anomanāmaṃ",0,0],["sn1.45:1.1","atthe",0,6],["sn1.45:1.1","ālayo",0,9],["sn1.45:1.3","kamamānaṃ",0,10]],"before":[{"para":492,"vripara":null,"refs":[],"lines":["Ekamūlasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":493,"vripara":null,"refs":[],"lines":["Anomasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
