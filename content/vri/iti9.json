{"suttaId":"iti9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"It","vriCode":"s0504m.mul","paras":[63,68],"vripara":"9"},"segments":{"iti9:0.4":"Lobhapariññāsuttaṃ","iti9:1.1":"Vuttañhetaṃ bhagavatā, vuttamarahatāti me sutaṃ –","iti9:2.1":"“Lobhaṃ, bhikkhave, anabhijānaṃ aparijānaṃ tattha cittaṃ avirājayaṃ appajahaṃ abhabbo dukkhakkhayāya.","iti9:2.2":"Lobhañca kho, bhikkhave, abhijānaṃ parijānaṃ tattha cittaṃ virājayaṃ pajahaṃ bhabbo dukkhakkhayāyā”ti.","iti9:2.3":"Etamatthaṃ bhagavā avoca.","iti9:2.4":"Tatthetaṃ iti vuccati –","iti9:3.1":"“Yena lobhena luddhāse,","iti9:3.2":"sattā gacchanti duggatiṃ;","iti9:3.3":"Taṃ lobhaṃ sammadaññāya,","iti9:3.4":"pajahanti vipassino;","iti9:3.5":"Pahāya na punāyanti,","iti9:3.6":"imaṃ lokaṃ kudācanan”ti.","iti9:4.1":"Ayampi attho vutto bhagavatā, iti me sutanti.","iti9:4.2":"Navamaṃ."},"unsure":[],"attha":{"book":"It-a","bookName":"Itivuttaka-aṭṭhakathā","vriCode":"s0504a.att","from":268,"to":272,"paras":[{"para":268,"vripara":"9-10","refs":["iti9:1"],"lines":["9-10. Navamadasamesu apubbaṃ natthi.","Desanāvilāsavasena tathā bujjhanakānaṃ veneyyānaṃ ajjhāsayavasena vā tathā desitānīti daṭṭhabbaṃ."],"lineRefs":[["iti9:1"],["iti9:1"]]},{"para":269,"vripara":null,"refs":["iti9:1"],"lines":["Navamadasamasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["iti9:1"]]},{"para":270,"vripara":null,"refs":["iti9:1"],"lines":["Paṭhamavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["iti9:1"]]},{"para":271,"vripara":null,"refs":["iti9:1"],"lines":["Dutiyavaggo"],"lineRefs":[["iti9:1"]]},{"para":272,"vripara":null,"refs":["iti9:1"],"lines":["1-3. Mohapariññādisuttavaṇṇanā"],"lineRefs":[["iti9:1"]]}],"wordLinks":[]},"tika":null,"tika2":null}
