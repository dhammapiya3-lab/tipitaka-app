{"suttaId":"tha-ap303","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9050,9063],"vripara":"1"},"segments":{"tha-ap303:0.3":"Padumakesariyattheraapadānaṃ","tha-ap303:1.1":"“Isisaṅghe ahaṃ pubbe,","tha-ap303:1.2":"āsiṃ mātaṅgavāraṇo;","tha-ap303:1.3":"Mahesīnaṃ pasādena,","tha-ap303:1.4":"padmakesaramokiriṃ.","tha-ap303:2.1":"“Paccekajinaseṭṭhesu,","tha-ap303:2.2":"dhutarāgesu tādisu;","tha-ap303:2.3":"Tesu cittaṃ pasādetvā,","tha-ap303:2.4":"kappaṃ saggamhi modahaṃ.","tha-ap303:3.1":"“Ekanavutito kappe,","tha-ap303:3.2":"kesaraṃ okiriṃ tadā;","tha-ap303:3.3":"Duggatiṃ nābhijānāmi,","tha-ap303:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap303:4.1":"“Paṭisambhidā catasso,","tha-ap303:4.2":"vimokkhāpi ca aṭṭhime;","tha-ap303:4.3":"Chaḷabhiññā sacchikatā,","tha-ap303:4.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap303:5.1":"Itthaṃ sudaṃ āyasmā padumakesariyo thero imā gāthāyo abhāsitthāti.","tha-ap303:6.1":"Padumakesariyattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3259,"to":3259,"paras":[{"para":3259,"vripara":"1-2","refs":["tha-ap303:1"],"lines":["1-2. Ekatiṃsatime vagge paṭhamāpadāne <b>isisaṅghe ahaṃ pubbe</b>ti ahaṃ pubbe bodhisambhārapūraṇakāle isisaṅghe paccekabuddhaisisamūhe tesaṃ samīpe himavantapabbate mātaṅgahatthikule vāraṇo caṇḍahatthī ahosinti sambandho.","Manussādayo vāretīti <b>vāraṇo,</b> atha vā vācāya ravati koñcanādaṃ nadatīti <b>vāraṇo.</b>","<b>Mahesīnaṃ pasādenā</b>ti paccekabuddhamahesīnaṃ pasādena.","<b>Paccekajinaseṭṭhesu, dhutarāgesu tādisū</b>ti lokadhammehi niccalesu paccekabuddhesu <b>padmakesaraṃ</b> padumareṇuṃ <b>okiriṃ</b> avasiñcinti sambandho."],"lineRefs":[["tha-ap303:1"],["tha-ap303:1"],["tha-ap303:1"],["tha-ap303:1"]]}],"wordLinks":[["tha-ap303:1.1","isisaṅghe ahaṃ pubbe",0,0],["tha-ap303:1.1","vāraṇo",0,1],["tha-ap303:1.3","mahesīnaṃ pasādenā",0,2],["tha-ap303:1.3","okiriṃ",0,3],["tha-ap303:1.3","padmakesaraṃ",0,3]]},"tika":null,"tika2":null}
