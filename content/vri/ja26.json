{"suttaId":"ja26","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[145,148],"vripara":"26"},"segments":{"ja26:0.4":"Mahiḷāmukhajātakaṃ","ja26:1.1":"Purāṇacorāna vaco nisamma, mahiḷāmukho pothayamanvacārī;","ja26:1.3":"Susaññatānañhi vaco nisamma, gajuttamo sabbaguṇesu aṭṭhāti.","ja26:2.1":"Mahiḷāmukhajātakaṃ chaṭṭhaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1346,"to":1346,"paras":[{"para":1346,"vripara":null,"refs":["ja26:1"],"lines":["Tattha <b>purāṇacorānan</b>ti porāṇacorānaṃ.","<b>Nisammā</b>ti sutvā, paṭhamaṃ corānaṃ vacanaṃ sutvāti attho.","<b>Mahiḷāmukho</b>ti hatthinimukhena sadisamukho.","Yathā mahiḷā purato olokiyamānā sobhati, na pacchato, tathā sopi purato olokiyamāno sobhati.","Tasmā “mahiḷāmukho” tissa nāmaṃ akaṃsu.","<b>Pothayamanvacārī</b>ti pothayanto mārento anucārī.","Ayameva vā pāṭho.","<b>Susaññatānan</b>ti suṭṭhu saññatānaṃ sīlavantānaṃ.","<b>Gajuttamo</b>ti uttamagajo maṅgalahatthī.","<b>Sabbaguṇesu aṭṭhā</b>ti sabbesu porāṇaguṇesu patiṭṭhito.","Rājā “tiracchānagatassāpi āsayaṃ jānātī”ti bodhisattassa mahantaṃ yasaṃ adāsi.","So yāvatāyukaṃ ṭhatvā saddhiṃ bodhisattena yathākammaṃ gato."],"lineRefs":[["ja26:1"],["ja26:1"],["ja26:1"],["ja26:1"],["ja26:1"],["ja26:1"],["ja26:1"],["ja26:1"],["ja26:1"],["ja26:1"],["ja26:1"],["ja26:1"]]}],"wordLinks":[["ja26:1.1","purāṇacorānaṃ",0,0],["ja26:1.1","nisammā",0,1],["ja26:1.3","nisammā",0,1],["ja26:1.1","mahiḷāmukho",0,2],["ja26:1.1","pothayamanvacārī",0,5],["ja26:1.3","susaññatānaṃ",0,7],["ja26:1.3","gajuttamo",0,8],["ja26:1.3","sabbaguṇesu aṭṭhā",0,9]]},"tika":null}
