{"suttaId":"ja26","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[145,148],"vripara":"26"},"segments":{"ja26:0.4":"Mahiḷāmukhajātakaṃ","ja26:1.1":"Purāṇacorāna vaco nisamma, mahiḷāmukho pothayamanvacārī;","ja26:1.3":"Susaññatānañhi vaco nisamma, gajuttamo sabbaguṇesu aṭṭhāti.","ja26:2.1":"Mahiḷāmukhajātakaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
