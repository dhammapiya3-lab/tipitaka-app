{"suttaId":"an4.212","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1703,1704],"vripara":"212"},"segments":{"an4.212:0.3":"Diṭṭhisuttaṃ","an4.212:1.1":"“Catūhi, bhikkhave, dhammehi samannāgato yathābhataṃ nikkhitto evaṃ niraye.","an4.212:1.2":"Katamehi catūhi?","an4.212:1.3":"Kāyaduccaritena, vacīduccaritena, manoduccaritena, micchādiṭṭhiyā –","an4.212:1.4":"imehi kho, bhikkhave, catūhi dhammehi samannāgato yathābhataṃ nikkhitto evaṃ niraye.","an4.212:2.1":"“Catūhi, bhikkhave, dhammehi samannāgato yathābhataṃ nikkhitto evaṃ sagge.","an4.212:2.2":"Katamehi catūhi?","an4.212:2.3":"Kāyasucaritena, vacīsucaritena, manosucaritena, sammādiṭṭhiyā –","an4.212:2.4":"imehi kho, bhikkhave, catūhi dhammehi samannāgato yathābhataṃ nikkhitto evaṃ sagge”ti.","an4.212:2.5":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1665,"to":1666,"paras":[{"para":1665,"vripara":"212","refs":["an4.212:1"],"lines":["Dutiye manoduccarite pariyāpannāpi micchādiṭṭhi mahāsāvajjatāya visuṃ vuttā, tassā ca paṭipakkhavasena sammādiṭṭhi. 3."],"lineRefs":[["an4.212:1"]]},{"para":1666,"vripara":null,"refs":["an4.212:1"],"lines":["Akataññutāsuttavaṇṇanā 213."],"lineRefs":[["an4.212:1"]]}],"wordLinks":[],"before":[{"para":1664,"vripara":null,"title":"Diṭṭhisuttavaṇṇanā","lines":["Diṭṭhisuttavaṇṇanā 212."]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1868,"to":1869,"paras":[{"para":1868,"vripara":"211-220","refs":["an4.212:1"],"lines":["Dutiyo parisāvaggo uttānatthoyeva. (23) 3."],"lineRefs":[["an4.212:1"]]},{"para":1869,"vripara":null,"refs":["an4.212:1"],"lines":["Duccaritavaggavaṇṇanā 221-231."],"lineRefs":[["an4.212:1"]]}],"wordLinks":[]},"tika2":null}
