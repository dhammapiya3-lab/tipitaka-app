{"suttaId":"thag6.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1900,1918],"vripara":"429"},"segments":{"thag6.10:0.4":"Sumanattheragāthā","thag6.10:1.1":"“Yadā navo pabbajito, jātiyā sattavassiko;","thag6.10:1.3":"Iddhiyā abhibhotvāna, pannagindaṃ mahiddhikaṃ.","thag6.10:2.1":"“Upajjhāyassa udakaṃ, anotattā mahāsarā;","thag6.10:2.3":"Āharāmi tato disvā, maṃ satthā etadabravi”.","thag6.10:3.1":"“Sāriputta imaṃ passa, āgacchantaṃ kumārakaṃ;","thag6.10:3.3":"Udakakumbhamādāya, ajjhattaṃ susamāhitaṃ.","thag6.10:4.1":"“Pāsādikena vattena, kalyāṇairiyāpatho;","thag6.10:4.3":"Sāmaṇeronuruddhassa, iddhiyā ca visārado.","thag6.10:5.1":"“Ājānīyena ājañño, sādhunā sādhukārito;","thag6.10:5.3":"Vinīto anuruddhena, katakiccena sikkhito.","thag6.10:6.1":"“So patvā paramaṃ santiṃ, sacchikatvā akuppataṃ;","thag6.10:6.3":"Sāmaṇero sa sumano, mā maṃ jaññāti icchatī”ti.","thag6.10:6.5":"… Sumano thero …."},"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":1390,"to":1390,"paras":[{"para":1390,"vripara":null,"refs":["thag6.10:6"],"lines":["So sāmaṇero sumano paramaṃ <b>santiṃ</b> nibbānaṃ <b>patvā</b> aggamaggādhigamena adhigantvā <b>sacchikatvā</b> attapaccakkhaṃ katvā <b>akuppataṃ</b> arahattaphalaṃ appicchabhāvassa paramukkaṃsagatattā <b>mā maṃ jaññā</b>ti maṃ “ayaṃ khīṇāsavo”ti vā “chaḷabhiñño”ti vā kocipi mā jāneyyāti <b>icchati</b> abhikaṅkhatīti."],"lineRefs":[["thag6.10:6"]]}],"wordLinks":[["thag6.10:6.1","akuppataṃ",0,0],["thag6.10:6.1","patvā",0,0],["thag6.10:6.1","sacchikatvā",0,0],["thag6.10:6.1","santiṃ",0,0],["thag6.10:6.3","icchati",0,0],["thag6.10:6.3","mā maṃ jaññā",0,0]]},"tika":null,"tika2":null}
