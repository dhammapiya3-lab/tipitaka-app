{"suttaId":"tha-ap515","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3236,3250],"vripara":"12"},"segments":{"tha-ap515:0.3":"Kosambaphaliyattheraapadānaṃ","tha-ap515:1.1":"“Kakudhaṃ vilasantaṃva,","tha-ap515:1.2":"devadevaṃ narāsabhaṃ;","tha-ap515:1.3":"Rathiyaṃ paṭipajjantaṃ,","tha-ap515:1.4":"kosambaṃ [kosumbaṃ (sī. syā. pī.)] adadiṃ tadā. 13.","tha-ap515:2.1":"“Ekatiṃse ito kappe,","tha-ap515:2.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap515:2.3":"Duggatiṃ nābhijānāmi,","tha-ap515:2.4":"phaladānassidaṃ phalaṃ. 14.","tha-ap515:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap515:3.3":"viharāmi anāsavo. 15.","tha-ap515:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap515:4.3":"kataṃ buddhassa sāsanaṃ. 16.","tha-ap515:5.1":"“Paṭisambhidā catasso…pe…","tha-ap515:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap515:6.1":"Itthaṃ sudaṃ āyasmā kosambaphaliyo thero imā gāthāyo Abhāsitthāti.","tha-ap515:7.1":"Kosambaphaliyattherassāpadānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
