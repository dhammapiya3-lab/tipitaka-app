{"suttaId":"ja395","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[4014,4040],"vripara":"134"},"segments":{"ja395:0.4":"Pārāvatajātakaṃ (6-2-10)","ja395:1.1":"Cirassaṃ vata passāmi,","ja395:1.2":"sahāyaṃ maṇidhārinaṃ;","ja395:1.3":"Sukatā [sukatāya (sī. pī.)] massukuttiyā,","ja395:1.4":"sobhate vata me sakhā. 135.","ja395:2.1":"Parūḷhakacchanakhalomo,","ja395:2.2":"ahaṃ kammesu byāvaṭo;","ja395:2.3":"Cirassaṃ nhāpitaṃ laddhā,","ja395:2.4":"lomaṃ taṃ ajjaṃ hārayiṃ [apahārayiṃ (sī. pī.)]. 136.","ja395:3.1":"Yaṃ nu lomaṃ ahāresi,","ja395:3.2":"dullabhaṃ laddha kappakaṃ;","ja395:3.3":"Atha kiñcarahi te samma,","ja395:3.4":"kaṇṭhe kiṇikiṇāyati [idaṃ kaṇṭhe kiṇāyati (ka.), kaṇṭhe kiṃnikilāyati (syā.)]. 137.","ja395:4.1":"Manussasukhumālānaṃ,","ja395:4.2":"maṇi kaṇṭhesu lambati;","ja395:4.3":"Tesāhaṃ anusikkhāmi,","ja395:4.4":"mā tvaṃ maññi davā kataṃ. 138.","ja395:5.1":"Sacepimaṃ pihayasi,","ja395:5.2":"massukuttiṃ sukāritaṃ;","ja395:5.3":"Kārayissāmi te samma,","ja395:5.4":"maṇiñcāpi dadāmi te. 139.","ja395:6.1":"Tvaññeva maṇinā channo,","ja395:6.2":"sukatāya ca massuyā;","ja395:6.3":"Āmanta kho taṃ gacchāmi,","ja395:6.4":"piyaṃ me tava dassananti.","ja395:7.1":"Pārāvatajātakaṃ [kākajātakaṃ (sī. pī.), maṇijātakaṃ (syā.)] dasamaṃ.","ja395:7.2":"Kharaputtavaggo [senakavaggo (sī. pī.), khuraputtavaggo (syā.), sūcivaggo (ka.)] dutiyo.","ja395:8.1":"Tassuddānaṃ –","ja395:9.1":"Atha passa sasūci ca tuṇḍilako,","ja395:9.2":"miga mayhakapañcamapakkhivaro;","ja395:9.3":"Atha pañjali vārija mejjha puna,","ja395:9.4":"atha vaṭṭa kapotavarena dasāti.","ja395:10.1":"Atha vagguddānaṃ –","ja395:11.1":"Atha vaggaṃ pakittissaṃ,","ja395:11.2":"chanipātaṃ varuttame;","ja395:11.3":"Avāriyā ca kharo ca [senaka (sī.), sūci ca (syā. ka.)],","ja395:11.4":"dve ca vuttā subyañjanāti.","ja395:12.1":"Chakkanipātaṃ niṭṭhitaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":2831,"to":2854,"paras":[{"para":2831,"vripara":null,"refs":["ja395:1"],"lines":["Tattha <b>massukuttiyā</b>ti imāya massukiriyāya."],"lineRefs":[["ja395:1"]]},{"para":2832,"vripara":null,"refs":["ja395:1"],"lines":["Taṃ sutvā kāko dutiyaṃ gāthamāha – 135."],"lineRefs":[["ja395:1"]]},{"para":2834,"vripara":"135","refs":["ja395:1"],"lines":["“Parūḷhakacchanakhalomo, ahaṃ kammesu byāvaṭo;"],"lineRefs":[["ja395:1"]]},{"para":2835,"vripara":null,"refs":["ja395:1"],"lines":["Cirassaṃ nhāpitaṃ laddhā, lomaṃ taṃ ajja hārayi”nti."],"lineRefs":[["ja395:1"]]},{"para":2836,"vripara":null,"refs":["ja395:2"],"lines":["Tattha <b>ahaṃ kammesu byāvaṭo</b>ti ahaṃ samma pārāvata, rājakammesu byāvaṭo okāsaṃ alabhanto parūḷhakacchanakhalomo ahosinti vadati.","<b>Ajja hārayi</b>nti ajja hāresiṃ."],"lineRefs":[["ja395:2"],["ja395:2"]]},{"para":2837,"vripara":null,"refs":["ja395:2"],"lines":["Tato bodhisatto tatiyaṃ gāthamāha – 136."],"lineRefs":[["ja395:2"]]},{"para":2839,"vripara":"136","refs":["ja395:2"],"lines":["“Yaṃ nu lomaṃ ahāresi, dullabhaṃ laddha kappakaṃ;"],"lineRefs":[["ja395:2"]]},{"para":2840,"vripara":null,"refs":["ja395:2"],"lines":["Atha kiñcarahi te samma, kaṇṭhe kiṇikiṇāyatī”ti."],"lineRefs":[["ja395:2"]]},{"para":2841,"vripara":null,"refs":["ja395:2"],"lines":["Tassattho – yaṃ tāva dullabhaṃ kappakaṃ labhitvā lomaṃ harāpesi, taṃ harāpaya, atha kiñcarahi te vayassa idaṃ kaṇṭhe kiṇikiṇāyatīti."],"lineRefs":[["ja395:2"]]},{"para":2842,"vripara":null,"refs":["ja395:2"],"lines":["Tato kāko dve gāthā abhāsi – 137."],"lineRefs":[["ja395:2"]]},{"para":2844,"vripara":"137","refs":["ja395:2"],"lines":["“Manussasukhumālānaṃ, maṇi kaṇṭhesu lambati;"],"lineRefs":[["ja395:2"]]},{"para":2845,"vripara":null,"refs":["ja395:2"],"lines":["Tesāhaṃ anusikkhāmi, mā tvaṃ maññi davā kataṃ. 138."],"lineRefs":[["ja395:2"]]},{"para":2847,"vripara":"138","refs":["ja395:2"],"lines":["“Sacepimaṃ pihayasi, massukuttiṃ sukāritaṃ;"],"lineRefs":[["ja395:2"]]},{"para":2848,"vripara":null,"refs":["ja395:2"],"lines":["Kārayissāmi te samma, maṇiñcāpi dadāmi te”ti."],"lineRefs":[["ja395:2"]]},{"para":2849,"vripara":null,"refs":["ja395:5"],"lines":["Tattha <b>maṇī</b>ti evarūpānaṃ manussānaṃ ekaṃ maṇiratanaṃ kaṇṭhesu lambati.","<b>Tesāha</b>nti tesaṃ ahaṃ.","<b>Mā tvaṃ maññī</b>ti tvaṃ pana “etaṃ mayā davā kata”nti mā maññi.","<b>Sacepimaṃ pihayasī</b>ti sace imaṃ mama kataṃ massukuttiṃ tvaṃ icchasi."],"lineRefs":[["ja395:5"],["ja395:5"],["ja395:5"],["ja395:5"]]},{"para":2850,"vripara":null,"refs":["ja395:5"],"lines":["Taṃ sutvā bodhisatto chaṭṭhaṃ gāthamāha – 139."],"lineRefs":[["ja395:5"]]},{"para":2852,"vripara":"139","refs":["ja395:5"],"lines":["“Tvaññeva maṇinā channo, sukatāya ca massuyā;"],"lineRefs":[["ja395:5"]]},{"para":2853,"vripara":null,"refs":["ja395:5"],"lines":["Āmanta kho taṃ gacchāmi, piyaṃ me tavadassana”nti."],"lineRefs":[["ja395:5"]]},{"para":2854,"vripara":null,"refs":["ja395:6"],"lines":["Tattha <b>maṇinā</b>ti maṇino, ayameva vā pāṭho.","Idaṃ vuttaṃ hoti – samma vāyasa, tvaññeva imassa maṇino anucchaviko imissā ca sukatāya massuyā, mama pana tava adassanameva piyaṃ, tasmā taṃ āmantayitvā gacchāmīti."],"lineRefs":[["ja395:6"],["ja395:6"]]}],"wordLinks":[["ja395:1.3","massukuttiyā",0,0],["ja395:2.1","ahaṃ kammesu byāvaṭo",4,0],["ja395:5.3","maṇī",14,0],["ja395:5.1","sacepimaṃ pihayasī",14,3],["ja395:6.1","maṇinā",18,0]],"after":[{"para":2855,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Evañca pana vatvā bodhisatto uppatitvā aññattha gato.","Kāko tattheva jīvitakkhayaṃ patto."]},{"para":2856,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne lolabhikkhu anāgāmiphale patiṭṭhahi.","Tadā kāko lolabhikkhu ahosi, pārāvato pana ahameva ahosinti."]},{"para":2857,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Pārāvatajātakavaṇṇanā dasamā."]},{"para":2858,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Kharaputtavaggo dutiyo niṭṭhito."]},{"para":2859,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Jātakuddānaṃ –"]},{"para":2860,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Avāriyaṃ setaketu, darīmukhañca neru ca;"]},{"para":2861,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Āsaṅkamigālopañca, kāḷakaṇṇī ca kukkuṭaṃ."]},{"para":2862,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Dhammadhajañca nandiyaṃ, kharaputtaṃ sūci ceva;"]},{"para":2863,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Tuṇḍilaṃ soṇṇakakkaṭaṃ, mayhakaṃ vijjādharañceva."]},{"para":2864,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Siṅghapupphaṃ vighāsādaṃ, vaṭṭakañca pārāvataṃ;"]},{"para":2865,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Saṅgāyiṃsu mahātherā, chakke vīsati jātake."]},{"para":2866,"vripara":null,"title":"[395] 10. Pārāvatajātakavaṇṇanā","lines":["Chakkanipātavaṇṇanā niṭṭhitā. 7."]}]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":2179,"to":2187,"paras":[{"para":2179,"vripara":null,"refs":["ja395:1"],"lines":["10-pārāvatajātakavaṇṇanā (395)"],"lineRefs":[["ja395:1"]]},{"para":2180,"vripara":null,"refs":["ja395:1"],"lines":["<b>heṭṭhā vuttanayamevā</b>ti heṭṭhā ekanipāte vuttanayameva.","<b>nīḷapacchi-ya</b>nti sakuṇānaṃ vasanatthāya ṭhapitapacchiyaṃ.","sakuṇānaṃ hi gehaṃ nīḷanti vuccati.","<b>sabbaṃ vitthāretabba</b>nti pārāvatassa santike upaṭṭhānaṃ ādiṃ katvā sabbaṃ vattabbavacanaṃ vitthāretabbaṃ.","vitthāravasena gahetabbanti vuttaṃ hoti.","<b>piṭṭhenā</b>ti taṇḍulacuṇṇena.","<b>ekaṃ kapālakhaṇḍaṃ vijjhitvā</b>ti ekaṃ kapālakhaṇḍaṃ kuvalayaṃ viya majjhe chinditvā.","<b>kaṇṭhe piḷandhitvā</b>ti kaṇṭhe piḷandhanaṃ viya katvā.","<b>massukiriyāyā</b>ti kaṇṭhe lomānaṃ luñcanaṃ sandhāya parihāse- tukāmatāya vuttaṃ.","<b>paruḷhakacchanakhalomo</b>ti ettha kacchasaddena kacchesu pavuttalomā gahetabbā.","lomasaddena pana avasesaṃ lomaṃ gahetabbaṃ.","paruḷhakacchaparuḷhanakhāparuḷhalomā ahesunti attho."],"lineRefs":[["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"]]},{"para":2181,"vripara":null,"refs":["ja395:1"],"lines":["<b>kammesū</b>ti gocarapariyesanādikammesu.","<b>byāvato</b>ti ussukkaṃ āpanno.","vi-āvaṭoti padacchedo daṭṭhabbo.","vata-ussukketi dantajapatha-makkharantadhātu.","ta-kārassa pana ṭa-kārādeso daṭṭhabbo.","pāḷiyaṃ <b>lomaṃ ta</b>nti lomaṃyeva lomaṃ taṃ.","<b>dullabhaṃ laddha kappaka</b>nti ettha laddhāti vattabbe chandānurakkhaṇatthaṃ laddhaïti vuttaṃ.","tenāha — “dullabhaṃ kappakaṃ labhitvā”ti.","kappakanti ca lomādichedanakapurisaṃ.","<b>atha kiñcarahī</b>ti evaṃ hotūti atthe nipātasamudāyo.","<b>ida</b>nti idaṃ maṇiratanaṃ."],"lineRefs":[["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"]]},{"para":2182,"vripara":null,"refs":["ja395:1"],"lines":["<b>kiṇakiṇāyatī</b>ti kiṇasaddaṃ karoti.","pāḷiyaṃ <b>manussasukhu-mālāna</b>nti sukhumālānaṃ sukhedhitānaṃ manussānaṃ.","<b>tesāha</b>nti ettha padacchedaṃ dassetuṃ “tesāhanti tesaṃ aha”nti vuttaṃ.","<b>tesa</b>nti manussānaṃ.","ahaṃ anusikkhāmi anāturaṇavasena karotīti attho.","<b>anucchaviko</b>ti iminā channoti padassa atthaṃ dasseti.","imāni hi dve padāni chididhātu-vaseneva sijjhanti."],"lineRefs":[["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"],["ja395:1"]]},{"para":2183,"vripara":null,"refs":["ja395:1"],"lines":["<b>āmantakho</b>ti ettha tvāpaccayassa khoādeso daṭṭhabbo.","tenāha — “taṃ āmantayitvā gacchāmīti” vuttanti."],"lineRefs":[["ja395:1"],["ja395:1"]]},{"para":2184,"vripara":null,"refs":["ja395:1"],"lines":["ending pārāvatajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja395:1"]]},{"para":2185,"vripara":null,"refs":["ja395:1"],"lines":["ending kharaputtavaggo niṭṭhito."],"lineRefs":[["ja395:1"]]},{"para":2186,"vripara":null,"refs":["ja395:1"],"lines":["ending chakkanipātavaṇṇanā niṭṭhitā."],"lineRefs":[["ja395:1"]]},{"para":2187,"vripara":null,"refs":["ja395:1"],"lines":["footnote 1.","kiṇikiṇāyati.","chaṭṭha."],"lineRefs":[["ja395:1"],["ja395:1"],["ja395:1"]]}],"wordLinks":[]},"tika2":null}
