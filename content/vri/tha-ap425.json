{"suttaId":"tha-ap425","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[116,190],"vripara":"36"},"segments":{"tha-ap425:0.3":"Ekāsanadāyakattheraapadānaṃ","tha-ap425:1.1":"“Himavantassāvidūre,","tha-ap425:1.2":"gosito nāma pabbato;","tha-ap425:1.3":"Assamo sukato mayhaṃ,","tha-ap425:1.4":"paṇṇasālā sumāpitā. 37.","tha-ap425:2.1":"“Nārado nāma nāmena,","tha-ap425:2.2":"kassapo iti maṃ vidū;","tha-ap425:2.3":"Suddhimaggaṃ gavesanto,","tha-ap425:2.4":"vasāmi gosite tadā. 38.","tha-ap425:3.1":"“Padumuttaro nāma jino,","tha-ap425:3.2":"sabbadhammāna pāragū;","tha-ap425:3.3":"Vivekakāmo sambuddho,","tha-ap425:3.4":"agañchi anilañjasā. 39.","tha-ap425:4.1":"“Vanagge gacchamānassa,","tha-ap425:4.2":"disvā raṃsiṃ mahesino;","tha-ap425:4.3":"Kaṭṭhamañcaṃ paññāpetvā,","tha-ap425:4.4":"ajinañca apatthariṃ. 40.","tha-ap425:5.1":"“Āsanaṃ paññāpetvāna,","tha-ap425:5.2":"sire katvāna añjaliṃ;","tha-ap425:5.3":"Somanassaṃ paveditvā,","tha-ap425:5.4":"idaṃ vacanamabraviṃ. 41.","tha-ap425:6.1":"“‘Sallakatto mahāvīra,","tha-ap425:6.2":"āturānaṃ tikicchako;","tha-ap425:6.3":"Mamaṃ rogaparetassa [rāga… (syā.)],","tha-ap425:6.4":"tikicchaṃ dehi nāyaka. 42.","tha-ap425:7.1":"“‘Kallatthikā ye passanti,","tha-ap425:7.2":"buddhaseṭṭha tuvaṃ mune;","tha-ap425:7.3":"Dhuvatthasiddhiṃ papponti,","tha-ap425:7.4":"etesaṃ ajaro [jajjaro (sī. pī. ka.)] bhave. 43.","tha-ap425:8.1":"“‘Na me deyyadhammo atthi,","tha-ap425:8.2":"pavattaphalabhojihaṃ;","tha-ap425:8.3":"Idaṃ me āsanaṃ atthi [na me deyyaṃ tava atthi (sī. syā.)],","tha-ap425:8.4":"nisīda kaṭṭhamañcake’. 44.","tha-ap425:9.1":"“Nisīdi tattha bhagavā,","tha-ap425:9.2":"asambhītova [acchambhitova (syā. ka.)] kesarī;","tha-ap425:9.3":"Muhuttaṃ vītināmetvā,","tha-ap425:9.4":"idaṃ vacanamabravi. 45.","tha-ap425:10.1":"“‘Visaṭṭho [vissattho (sī. pī), vissaṭṭho (syā. ka.)] hohi mā bhāyi,","tha-ap425:10.2":"laddho jotiraso tayā;","tha-ap425:10.3":"Yaṃ tuyhaṃ patthitaṃ sabbaṃ,","tha-ap425:10.4":"paripūrissatināgate [paripūrissatāsanaṃ (syā. ka.)]. 46.","tha-ap425:11.1":"“‘Na moghaṃ taṃ kataṃ tuyhaṃ,","tha-ap425:11.2":"puññakkhette anuttare;","tha-ap425:11.3":"Sakkā uddharituṃ attā,","tha-ap425:11.4":"yassa cittaṃ paṇīhitaṃ [sunīhitaṃ (syā.)]. 47.","tha-ap425:12.1":"“‘Imināsanadānena,","tha-ap425:12.2":"cetanāpaṇidhīhi ca;","tha-ap425:12.3":"Kappasatasahassāni,","tha-ap425:12.4":"vinipātaṃ na gacchasi. 48.","tha-ap425:13.1":"“‘Paññāsakkhattuṃ devindo,","tha-ap425:13.2":"devarajjaṃ karissasi;","tha-ap425:13.3":"Asītikkhattuṃ rājā ca,","tha-ap425:13.4":"cakkavattī bhavissasi. 49.","tha-ap425:14.1":"“‘Padesarajjaṃ vipulaṃ,","tha-ap425:14.2":"gaṇanāto asaṅkhiyaṃ;","tha-ap425:14.3":"Sabbattha sukhito hutvā,","tha-ap425:14.4":"saṃsāre saṃsarissasi’. 50.","tha-ap425:15.1":"“Idaṃ vatvāna sambuddho,","tha-ap425:15.2":"jalajuttamanāmako;","tha-ap425:15.3":"Nabhaṃ abbhuggamī vīro,","tha-ap425:15.4":"haṃsarājāva ambare. 51.","tha-ap425:16.1":"“Hatthiyānaṃ assayānaṃ,","tha-ap425:16.2":"sarathaṃ sandamānikaṃ;","tha-ap425:16.3":"Labhāmi sabbamevetaṃ,","tha-ap425:16.4":"ekāsanassidaṃ phalaṃ. 52.","tha-ap425:17.1":"“Kānanaṃ pavisitvāpi,","tha-ap425:17.2":"yadā icchāmi āsanaṃ;","tha-ap425:17.3":"Mama saṅkappamaññāya,","tha-ap425:17.4":"pallaṅko upatiṭṭhati. 53.","tha-ap425:18.1":"“Vārimajjhagato santo,","tha-ap425:18.2":"yadā icchāmi āsanaṃ;","tha-ap425:18.3":"Mama saṅkappamaññāya,","tha-ap425:18.4":"pallaṅko upatiṭṭhati. 54.","tha-ap425:19.1":"“Yaṃ yaṃ yonupapajjāmi,","tha-ap425:19.2":"devattaṃ atha mānusaṃ;","tha-ap425:19.3":"Pallaṅkasatasahassāni,","tha-ap425:19.4":"parivārenti maṃ sadā. 55.","tha-ap425:20.1":"“Duve bhave saṃsarāmi,","tha-ap425:20.2":"devatte atha mānuse;","tha-ap425:20.3":"Duve kule pajāyāmi,","tha-ap425:20.4":"khattiye atha brāhmaṇe. 56.","tha-ap425:21.1":"“Ekāsanaṃ daditvāna,","tha-ap425:21.2":"puññakkhette anuttare;","tha-ap425:21.3":"Dhammapallaṅkamādāya [dhammapallaṅkamaññāya (syā. ka.)],","tha-ap425:21.4":"viharāmi anāsavo. 57.","tha-ap425:22.1":"“Satasahassito kappe,","tha-ap425:22.2":"yaṃ dānamadadiṃ tadā;","tha-ap425:22.3":"Duggatiṃ nābhijānāmi,","tha-ap425:22.4":"ekāsanassidaṃ phalaṃ. 58.","tha-ap425:23.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap425:23.3":"viharāmi anāsavo. 59.","tha-ap425:24.1":"“Svāgataṃ vata me āsi…pe…","tha-ap425:24.3":"kataṃ buddhassa sāsanaṃ. 60.","tha-ap425:25.1":"“Paṭisambhidā catasso…pe…","tha-ap425:25.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap425:26.1":"Itthaṃ sudaṃ āyasmā ekāsanadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap425:27.1":"Ekāsanadāyakattherassāpadānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
