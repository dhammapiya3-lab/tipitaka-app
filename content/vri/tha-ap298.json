{"suttaId":"tha-ap298","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8965,8977],"vripara":"27"},"segments":{"tha-ap298:0.3":"Pādapūjakattheraapadānaṃ","tha-ap298:1.1":"“Pabbate himavantamhi,","tha-ap298:1.2":"ahosiṃ kinnaro tadā;","tha-ap298:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap298:1.4":"pītaraṃsiṃva bhāṇumaṃ. 28.","tha-ap298:2.1":"“Upetaṃ tamahaṃ [upetopi tadā (syā.), upesiṃ tamahaṃ (?)] buddhaṃ,","tha-ap298:2.2":"vipassiṃ lokanāyakaṃ;","tha-ap298:2.3":"Candanaṃ tagarañcāpi,","tha-ap298:2.4":"pāde osiñcahaṃ tadā. 29.","tha-ap298:3.1":"“Ekanavutito kappe,","tha-ap298:3.2":"yaṃ pādaṃ abhipūjayiṃ;","tha-ap298:3.3":"Duggatiṃ nābhijānāmi,","tha-ap298:3.4":"pādapūjāyidaṃ phalaṃ. 30.","tha-ap298:4.1":"“Paṭisambhidā catasso…pe…","tha-ap298:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap298:5.1":"Itthaṃ sudaṃ āyasmā pādapūjako thero imā gāthāyo abhāsitthāti.","tha-ap298:6.1":"Pādapūjakattherassāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
