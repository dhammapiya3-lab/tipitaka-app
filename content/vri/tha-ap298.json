{"suttaId":"tha-ap298","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8965,8977],"vripara":"27"},"segments":{"tha-ap298:0.3":"Pādapūjakattheraapadānaṃ","tha-ap298:1.1":"“Pabbate himavantamhi, ahosiṃ kinnaro tadā;","tha-ap298:1.3":"Addasaṃ virajaṃ buddhaṃ, pītaraṃsiṃva bhāṇumaṃ.","tha-ap298:2.1":"“Upetaṃ tamahaṃ [upetopi tadā (syā.), upesiṃ tamahaṃ (?)] buddhaṃ, vipassiṃ lokanāyakaṃ;","tha-ap298:2.3":"Candanaṃ tagarañcāpi, pāde osiñcahaṃ tadā.","tha-ap298:3.1":"“Ekanavutito kappe, yaṃ pādaṃ abhipūjayiṃ;","tha-ap298:3.3":"Duggatiṃ nābhijānāmi, pādapūjāyidaṃ phalaṃ.","tha-ap298:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap298:5.1":"Itthaṃ sudaṃ āyasmā pādapūjako thero imā gāthāyo abhāsitthāti.","tha-ap298:6.1":"Pādapūjakattherassāpadānaṃ chaṭṭhaṃ."},"attha":null,"tika":null,"tika2":null}
