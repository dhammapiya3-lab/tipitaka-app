{"suttaId":"an6.76","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[723,724],"vripara":"76"},"segments":{"an6.76:0.3":"Arahattasuttaṃ","an6.76:1.1":"“Cha, bhikkhave, dhamme appahāya abhabbo arahattaṃ sacchikātuṃ.","an6.76:1.2":"Katame cha?","an6.76:1.3":"Mānaṃ, omānaṃ, atimānaṃ, adhimānaṃ, thambhaṃ, atinipātaṃ.","an6.76:1.4":"Ime kho, bhikkhave, cha dhamme appahāya abhabbo arahattaṃ sacchikātuṃ.","an6.76:2.1":"“Cha, bhikkhave, dhamme pahāya bhabbo arahattaṃ sacchikātuṃ.","an6.76:2.2":"Katame cha?","an6.76:2.3":"Mānaṃ, omānaṃ, atimānaṃ, adhimānaṃ, thambhaṃ, atinipātaṃ.","an6.76:2.4":"Ime kho, bhikkhave, cha dhamme pahāya bhabbo arahattaṃ sacchikātun”ti.","an6.76:2.5":"Dutiyaṃ."},"unsure":[],"preface":[],"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":741,"to":741,"paras":[{"para":741,"vripara":"76","refs":["an6.76:1"],"lines":["Dutiye <b>mānan</b>ti jātiādīhi maññanaṃ.","<b>Omānan</b>ti hīnohamasmīti mānaṃ.","<b>Atimānan</b>ti atikkamitvā pavattaṃ accuṇṇatimānaṃ.","<b>Adhimānan</b>ti adhigatamānaṃ.","<b>Thambhan</b>ti kodhamānehi thaddhabhāvaṃ.","<b>Atinipātan</b>ti hīnassa hīnohamasmīti mānaṃ."],"lineRefs":[["an6.76:1"],["an6.76:1"],["an6.76:1"],["an6.76:1"],["an6.76:1"],["an6.76:1"]]}],"wordLinks":[["an6.76:1.3","mānaṃ",0,0],["an6.76:1.3","omānaṃ",0,1],["an6.76:1.3","atimānaṃ",0,2],["an6.76:1.3","adhimānaṃ",0,3],["an6.76:1.3","thambhaṃ",0,4],["an6.76:1.3","atinipātaṃ",0,5]],"before":[{"para":740,"vripara":null,"title":"Arahattasuttavaṇṇanā","lines":["Arahattasuttavaṇṇanā"]}]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":760,"to":762,"paras":[{"para":760,"vripara":"75-77","refs":["an6.76:1"],"lines":["75-77. Aṭṭhamassa paṭhamādīsu natthi vattabbaṃ.","Tatiye <b>tividhaṃ kuhanavatthun</b>ti paccayappaṭisevanasāmantajappanairiyāpathappavattanasaṅkhātaṃ tividhaṃ kuhanavatthuṃ.","<b>Ukkhipitvā</b>ti “mahākuṭumbiko mahānāviko mahādānapatī”tiādinā paggaṇhitvā lapanaṃ.","<b>Avakkhipitvā</b>ti “kiṃ imassa jīvitaṃ, bījabhojano nāmāyan”ti hīḷetvā lapanaṃ."],"lineRefs":[["an6.76:1"],["an6.76:1"],["an6.76:1"],["an6.76:1"]]},{"para":761,"vripara":null,"refs":["an6.76:1"],"lines":["Dukkhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an6.76:1"]]},{"para":762,"vripara":null,"refs":["an6.76:1"],"lines":["Sukhasomanassasuttavaṇṇanā"],"lineRefs":[["an6.76:1"]]}],"wordLinks":[]},"tika2":null}
