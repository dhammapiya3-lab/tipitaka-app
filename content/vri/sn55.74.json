{"suttaId":"sn55.74","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[2424,2429],"vripara":"1070"},"segments":{"sn55.74:0.3":"Nibbedhikapaññāsuttaṃ","sn55.74:1.1":"… Nibbedhikapaññatā saṃvattanti.","sn55.74:1.2":"Katame cattāro?","sn55.74:1.3":"Sappurisasaṃsevo, saddhammassavanaṃ, yonisomanasikāro, dhammānudhammappaṭipatti – ime kho, bhikkhave, cattāro dhammā bhāvitā bahulīkatā nibbedhikapaññatāya saṃvattantī”ti.","sn55.74:1.5":"Terasamaṃ.","sn55.74:1.6":"Mahāpaññavaggo sattamo.","sn55.74:2.0":"Tassuddānaṃ –","sn55.74:2.1":"Mahā puthu vipula-gambhīraṃ, appamatta-bhūri-bāhullaṃ;","sn55.74:2.3":"Sīgha-lahu-hāsa-javana, tikkha-nibbedhikāya cāti.","sn55.74:2.5":"Sotāpattisaṃyuttaṃ ekādasamaṃ."},"attha":null,"tika":null}
