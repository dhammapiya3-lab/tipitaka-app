{"suttaId":"tha-ap544","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[5075,5134],"vripara":"34"},"segments":{"tha-ap544:0.3":"Kaṅkhārevatattheraapadānaṃ","tha-ap544:1.1":"“Padumuttaro nāma jino,","tha-ap544:1.2":"sabbadhammesu cakkhumā;","tha-ap544:1.3":"Ito satasahassamhi,","tha-ap544:1.4":"kappe uppajji nāyako. 35.","tha-ap544:2.1":"“Sīhahanu brahmagiro,","tha-ap544:2.2":"haṃsadundubhinissano [haṃsadundubhinissaro (sī.) … nissavano (pī.) … sāvano (syā.)];","tha-ap544:2.3":"Nāgavikkantagamano,","tha-ap544:2.4":"candasūrādikappabho. 36.","tha-ap544:3.1":"“Mahāmatī mahāvīro,","tha-ap544:3.2":"mahājhāyī mahābalo [mahāgati (syā.), mahāhito (pī.)];","tha-ap544:3.3":"Mahākāruṇiko nātho,","tha-ap544:3.4":"mahātamapanūdano [mahātamavidhaṃsano (syā.), mahātamanisūdano (pī.)]. 37.","tha-ap544:4.1":"“Sa kadāci tilokaggo,","tha-ap544:4.2":"veneyyaṃ vinayaṃ bahuṃ [veneyye viniyaṃ bahū (sī.)];","tha-ap544:4.3":"Dhammaṃ desesi sambuddho,","tha-ap544:4.4":"sattāsayavidū muni. 38.","tha-ap544:5.1":"“Jhāyiṃ jhānarataṃ vīraṃ,","tha-ap544:5.2":"upasantaṃ anāvilaṃ;","tha-ap544:5.3":"Vaṇṇayanto parisatiṃ,","tha-ap544:5.4":"tosesi [toseti (syā. pī. ka.)] janataṃ jino. 39.","tha-ap544:6.1":"“Tadāhaṃ haṃsavatiyaṃ,","tha-ap544:6.2":"brāhmaṇo vedapāragū;","tha-ap544:6.3":"Dhammaṃ sutvāna mudito,","tha-ap544:6.4":"taṃ ṭhānamabhipatthayiṃ. 40.","tha-ap544:7.1":"“Tadā jino viyākāsi,","tha-ap544:7.2":"saṅghamajjhe vināyako;","tha-ap544:7.3":"‘Mudito hohi tvaṃ brahme,","tha-ap544:7.4":"lacchase taṃ manorathaṃ. 41.","tha-ap544:8.1":"“‘Satasahassito kappe,","tha-ap544:8.2":"okkākakulasambhavo;","tha-ap544:8.3":"Gotamo nāma gottena,","tha-ap544:8.4":"satthā loke bhavissati. 42.","tha-ap544:9.1":"“‘Tassa dhammesu dāyādo,","tha-ap544:9.2":"oraso dhammanimmito;","tha-ap544:9.3":"Revato nāma nāmena,","tha-ap544:9.4":"hessati satthu sāvako’. 43.","tha-ap544:10.1":"“Tena kammena sukatena,","tha-ap544:10.2":"cetanāpaṇidhīhi ca;","tha-ap544:10.3":"Jahitvā mānusaṃ dehaṃ,","tha-ap544:10.4":"tāvatiṃsamagacchahaṃ. 44.","tha-ap544:11.1":"“Pacchime ca bhave dāni,","tha-ap544:11.2":"jātohaṃ koliye pure;","tha-ap544:11.3":"Khattiye kulasampanne,","tha-ap544:11.4":"iddhe phīte mahaddhane. 45.","tha-ap544:12.1":"“Yadā kapilavatthusmiṃ,","tha-ap544:12.2":"buddho dhammamadesayi;","tha-ap544:12.3":"Tadā pasanno sugate,","tha-ap544:12.4":"pabbajiṃ anagāriyaṃ. 46.","tha-ap544:13.1":"“Kaṅkhā me bahulā āsi,","tha-ap544:13.2":"kappākappe tahiṃ tahiṃ;","tha-ap544:13.3":"Sabbaṃ taṃ vinayī buddho,","tha-ap544:13.4":"desetvā dhammamuttamaṃ. 47.","tha-ap544:14.1":"“Tatohaṃ tiṇṇasaṃsāro,","tha-ap544:14.2":"sadā jhānasukhe rato;","tha-ap544:14.3":"Viharāmi tadā buddho,","tha-ap544:14.4":"maṃ disvā etadabravi. 48.","tha-ap544:15.1":"“‘Yā kāci kaṅkhā idha vā huraṃ vā,","tha-ap544:15.2":"sakavediyā vā paravediyā vā;","tha-ap544:15.3":"Ye jhāyino tā pajahanti sabbā,","tha-ap544:15.4":"ātāpino brahmacariyaṃ carantā’. 49.","tha-ap544:16.1":"“Satasahasse kataṃ kammaṃ,","tha-ap544:16.2":"phalaṃ dassesi me idha;","tha-ap544:16.3":"Sumutto saravegova","tha-ap544:16.4":"kilese jhāpayiṃ mama. 50.","tha-ap544:17.1":"“Tato jhānarataṃ disvā,","tha-ap544:17.2":"buddho lokantagū muni;","tha-ap544:17.3":"Jhāyīnaṃ bhikkhūnaṃ aggo,","tha-ap544:17.4":"paññāpeti mahāmati. 51.","tha-ap544:18.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap544:18.3":"viharāmi anāsavo. 52.","tha-ap544:19.1":"“Svāgataṃ vata me āsi…pe…","tha-ap544:19.3":"kataṃ buddhassa sāsanaṃ. 53.","tha-ap544:20.1":"“Paṭisambhidā catasso…pe…","tha-ap544:20.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap544:21.1":"Itthaṃ sudaṃ āyasmā kaṅkhārevato thero imā gāthāyo Abhāsitthāti.","tha-ap544:22.1":"Kaṅkhārevatattherassāpadānaṃ dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3509,"to":3509,"paras":[{"para":3509,"vripara":"34","refs":["tha-ap544:1"],"lines":["Dutiyāpadāne <b>padumuttaro nāma jino</b>tiādikaṃ āyasmato kaṅkhārevatattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto padumuttarassa bhagavato kāle brāhmaṇakule nibbatto, taṃ sabbaṃ pāṭhānusārena suviññeyyamevāti."],"lineRefs":[["tha-ap544:1"],["tha-ap544:1"]]}],"wordLinks":[["tha-ap544:1.1","padumuttaro nāma jino",0,0]],"before":[{"para":3508,"vripara":null,"title":"Kaṅkhārevatattheraapadānavaṇṇanā","lines":["Kaṅkhārevatattheraapadānavaṇṇanā 34."]}],"after":[{"para":3510,"vripara":null,"title":"Kaṅkhārevatattheraapadānavaṇṇanā","lines":["Kaṅkhārevatattheraapadānavaṇṇanā samattā. 3."]}]},"tika":null,"tika2":null}
