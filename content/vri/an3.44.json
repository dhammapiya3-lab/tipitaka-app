{"suttaId":"an3.44","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[359,359],"vripara":"44"},"segments":{"an3.44:0.3":"Kathāpavattisuttaṃ","an3.44:1.1":"“Tīhi, bhikkhave, ṭhānehi kathā pavattinī hoti.","an3.44:1.2":"Katamehi tīhi?","an3.44:1.3":"Yo dhammaṃ deseti so atthappaṭisaṃvedī ca hoti dhammappaṭisaṃvedī ca.","an3.44:1.4":"Yo dhammaṃ suṇāti so atthappaṭisaṃvedī ca hoti dhammappaṭisaṃvedī ca.","an3.44:1.5":"Yo ceva dhammaṃ deseti yo ca dhammaṃ suṇāti ubho atthappaṭisaṃvedino ca honti dhammappaṭisaṃvedino ca.","an3.44:1.6":"Imehi kho, bhikkhave, tīhi ṭhānehi kathā pavattinī hotī”ti.","an3.44:1.7":"Catutthaṃ."},"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":566,"to":566,"paras":[{"para":566,"vripara":"44","refs":["an3.44:1"],"lines":["Catutthe <b>ṭhānehī</b>ti kāraṇehi.","<b>Pavattinī</b>ti appaṭihatā niyyānikā."],"lineRefs":[["an3.44:1"],["an3.44:1"]]}],"wordLinks":[["an3.44:1.1","ṭhānehī",0,0],["an3.44:1.6","ṭhānehī",0,0],["an3.44:1.1","pavattinī",0,1],["an3.44:1.6","pavattinī",0,1]]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":561,"to":561,"paras":[{"para":561,"vripara":"44","refs":["an3.44:1"],"lines":["Catutthe <b>pavattinī</b>ti yāva adhippetatthanigamanā avicchedena pavattinī.","Paṭighātābhāvena <b>appaṭihatā.</b>","<b>Niyyānikā</b> sappāṭihīrakā."],"lineRefs":[["an3.44:1"],["an3.44:1"],["an3.44:1"]]}],"wordLinks":[["an3.44:1.1","pavattinī",0,0],["an3.44:1.6","pavattinī",0,0]]},"tika2":null}
