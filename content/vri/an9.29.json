{"suttaId":"an9.29","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-ix","vriCode":"s0404m2.mul","paras":[233,233],"vripara":"29"},"segments":{"an9.29:0.3":"Āghātavatthusuttaṃ","an9.29:1.1":"[vibha.960; dī. ni.3.340; a. ni.10.79]“Navayimāni, bhikkhave, āghātavatthūni.","an9.29:1.2":"Katamāni nava?","an9.29:1.3":"‘Anatthaṃ me acarī’ti āghātaṃ bandhati;","an9.29:1.4":"‘anatthaṃ me caratī’ti āghātaṃ bandhati;","an9.29:1.5":"‘anatthaṃ me carissatī’ti āghātaṃ bandhati;","an9.29:1.6":"‘piyassa me manāpassa anatthaṃ acarī’ti … pe …‘anatthaṃ caratī’ti … pe …‘anatthaṃ carissatī’ti āghātaṃ bandhati;","an9.29:1.9":"‘appiyassa me amanāpassa atthaṃ acarī’ti … pe …‘atthaṃ caratī’ti … pe …‘atthaṃ carissatī’ti āghātaṃ bandhati.","an9.29:1.12":"Imāni kho, bhikkhave, nava āghātavatthūnī”ti.","an9.29:1.13":"Navamaṃ."},"attha":{"book":"Mp-ix","bookName":"Navakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":358,"to":358,"paras":[{"para":358,"vripara":"29","refs":["an9.29:1"],"lines":["Navame <b>āghātavatthūnī</b>ti āghātakāraṇāni.","<b>Āghātaṃ bandhatī</b>ti kopaṃ bandhati uppādeti."],"lineRefs":[["an9.29:1"],["an9.29:1"]]}],"wordLinks":[["an9.29:1.1","āghātavatthūnī",0,0],["an9.29:1.12","āghātavatthūnī",0,0],["an9.29:1.3","āghātaṃ bandhatī",0,1],["an9.29:1.4","āghātaṃ bandhatī",0,1],["an9.29:1.5","āghātaṃ bandhatī",0,1],["an9.29:1.6","āghātaṃ bandhatī",0,1],["an9.29:1.9","āghātaṃ bandhatī",0,1]]},"tika":{"book":"Mp-t-ix","bookName":"Navakanipāta-ṭīkā","vriCode":"s0404t.tik","from":407,"to":407,"paras":[{"para":407,"vripara":"29","refs":["an9.29:1"],"lines":["Navame vasati ettha phalaṃ tannimittatāya pavattatīti <b>vatthu,</b> kāraṇanti āha <b>“āghātavatthūnī”</b>ti.","Kopo nāmāyaṃ yasmiṃ vatthusmiṃ uppajjati, na tattha ekavārameva uppajjati, atha kho punapi uppajjatevāti vuttaṃ <b>“bandhatī”</b>ti.","Atha vā yo paccayavisesena uppajjamāno āghāto savisaye baddho viya na vigacchati, punapi uppajjateva.","Taṃ sandhāyāha <b>“āghātaṃ bandhatī”</b>ti.","Taṃ panassa paccayavasena nibbattanaṃ uppādanamevāti vuttaṃ <b>“uppādetī”</b>ti."],"lineRefs":[["an9.29:1"],["an9.29:1"],["an9.29:1"],["an9.29:1"],["an9.29:1"]]}],"wordLinks":[["an9.29:1.1","vatthu",0,0],["an9.29:1.1","āghātavatthūnī",0,0],["an9.29:1.12","vatthu",0,0],["an9.29:1.12","āghātavatthūnī",0,0],["an9.29:1.3","bandhatī",0,1],["an9.29:1.4","bandhatī",0,1],["an9.29:1.5","bandhatī",0,1],["an9.29:1.6","bandhatī",0,1],["an9.29:1.9","bandhatī",0,1],["an9.29:1.3","āghātaṃ bandhatī",0,3],["an9.29:1.4","āghātaṃ bandhatī",0,3],["an9.29:1.5","āghātaṃ bandhatī",0,3],["an9.29:1.6","āghātaṃ bandhatī",0,3],["an9.29:1.9","āghātaṃ bandhatī",0,3]]}}
