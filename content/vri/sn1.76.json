{"suttaId":"sn1.76","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[830,843],"vripara":"76"},"segments":{"sn1.76:0.3":"Najīratisuttaṃ","sn1.76:1.1":"“Kiṃ jīrati kiṃ na jīrati,","sn1.76:1.2":"kiṃsu uppathoti vuccati;","sn1.76:1.3":"Kiṃsu dhammānaṃ paripantho,","sn1.76:1.4":"kiṃsu rattindivakkhayo;","sn1.76:1.5":"Kiṃ malaṃ brahmacariyassa,","sn1.76:1.6":"kiṃ sinānamanodakaṃ.","sn1.76:2.1":"“Kati lokasmiṃ chiddāni,","sn1.76:2.2":"yattha vittaṃ [cittaṃ (sī. syā. kaṃ. pī.)] na tiṭṭhati;","sn1.76:2.3":"Bhagavantaṃ puṭṭhumāgamma,","sn1.76:2.4":"kathaṃ jānemu taṃ mayan”ti.","sn1.76:3.1":"“Rūpaṃ jīrati maccānaṃ,","sn1.76:3.2":"nāmagottaṃ na jīrati;","sn1.76:3.3":"Rāgo uppathoti vuccati.","sn1.76:4.1":"“Lobho dhammānaṃ paripantho,","sn1.76:4.2":"vayo rattindivakkhayo;","sn1.76:4.3":"Itthī malaṃ brahmacariyassa,","sn1.76:4.4":"etthāyaṃ sajjate pajā;","sn1.76:4.5":"Tapo ca brahmacariyañca,","sn1.76:4.6":"taṃ sinānamanodakaṃ.","sn1.76:5.1":"“Cha lokasmiṃ chiddāni,","sn1.76:5.2":"yattha vittaṃ na tiṭṭhati;","sn1.76:5.3":"Ālasyañca [ālassañca (sī. pī.)] pamādo ca,","sn1.76:5.4":"anuṭṭhānaṃ asaṃyamo;","sn1.76:5.5":"Niddā tandī [tandi (sī.)] ca te chidde,","sn1.76:5.6":"sabbaso taṃ vivajjaye”ti."},"unsure":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":489,"to":489,"paras":[{"para":489,"vripara":"76","refs":["sn1.76:3","sn1.76:5"],"lines":["Chaṭṭhe <b>nāmagottaṃ na jīratī</b>ti atītabuddhānaṃ yāvajjadivasā nāmagottaṃ kathiyati, tasmā na jīratīti vuccati.","Porāṇā pana “addhāne gacchante na paññāyissati, jīraṇasabhāvo pana na hotiyevā”ti vadanti.","<b>Ālasyan</b>ti ālasiyaṃ, yena ṭhitaṭṭhāne ṭhitova, nisinnaṭṭhāne nisinnova hoti, telepi uttarante ṭhitiṃ na karoti.","<b>Pamādo</b>ti niddāya vā kilesavasena vā pamādo.","<b>Anuṭṭhānan</b>ti kammasamaye kammakaraṇavīriyābhāvo.","<b>Asaṃyamo</b>ti sīlasaññamābhāvo vissaṭṭhācāratā.","<b>Niddā</b>ti soppabahulatā.","Tāya gacchantopi ṭhitopi nisinnopi niddāyati, pageva nipanno.","<b>Tandī</b>ti aticchātādivasena āgantukālasiyaṃ.","<b>Te chidde</b>ti tāni cha chiddāni vivarāni.","<b>Sabbaso</b>ti sabbākārena.","<b>Tan</b>ti nipātamattaṃ.","<b>Vivajjaye</b>ti vajjeyya jaheyya.","Chaṭṭhaṃ."],"lineRefs":[["sn1.76:3"],["sn1.76:3"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"]]}],"wordLinks":[["sn1.76:3.1","nāmagottaṃ na jīratī",0,0],["sn1.76:5.3","ālasyaṃ",0,2],["sn1.76:5.3","pamādo",0,3],["sn1.76:5.3","anuṭṭhānaṃ",0,4],["sn1.76:5.3","asaṃyamo",0,5],["sn1.76:5.5","niddā",0,6],["sn1.76:5.5","tandī",0,8],["sn1.76:5.5","te chidde",0,9],["sn1.76:5.5","sabbaso",0,10],["sn1.76:5.1","taṃ",0,11],["sn1.76:5.5","taṃ",0,11],["sn1.76:5.5","vivajjaye",0,12]],"before":[{"para":487,"vripara":null,"refs":[],"lines":["Aparopi pariyāyo – vācantiādīni tīṇi aṅgāni, bahvannapānanti iminā yaññaupakkharova gahito, saddho mudū saṃvibhāgī vadaññūti ekaṃ aṅgaṃ.","Aparo dukanayo nāma hoti.","“Vācaṃ manañcā”ti idamekaṃ aṅgaṃ,“kāyena pāpāni akubbamāno, bahvannapānaṃ gharamāvasanto”ti ekaṃ,“saddho mudū”ti ekaṃ,“saṃvibhāgī vadaññū”ti ekaṃ.","Etesu catūsu dhammesu ṭhito dhamme ṭhito nāma hoti.","So ito paralokaṃ gacchanto na bhāyati.","Pañcamaṃ."],"lineRefs":[[],[],[],[],[],[]]},{"para":488,"vripara":null,"refs":[],"lines":["Najīratisuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":610,"to":611,"paras":[{"para":610,"vripara":"76","refs":["sn1.76:3"],"lines":["<b>Nāmagottan</b>ti tisso kassapo gotamoti evarūpaṃ nāmañca gottañca.","Nidassanamattametaṃ, tasmā sabbassa paññattiyā lakkhaṇavacananti daṭṭhabbaṃ.","<b>Na jīratī</b>ti asabhāvadhammattā uppādavayābhāvato jaraṃ na pāpuṇāti.","Tenāha <b>“jīraṇasabhāvo na hotī”</b>ti.","Yasmā samaññābhāvato kālantarepi taṃ samaññāyateva, tasmā <b>“atītabuddhānaṃ … pe … na jīratīti vuccatī”</b>ti āha."],"lineRefs":[["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"]]},{"para":611,"vripara":null,"refs":["sn1.76:3","sn1.76:5"],"lines":["<b>Ālasiyan</b>ti alasabhāvo daḷhakosajjaṃ.","Tenāha <b>“yenā”</b>tiādi.","<b>Ṭhitin</b>ti byāpāraṃ.","<b>Niddāvasena pamajjanaṃ</b> kattabbassa akaraṇaṃ.","<b>Kilesavasena pamajjanaṃ</b> akattabbassa karaṇampi.","<b>Kammasamaye</b>ti kammaṃ kātuṃ yuttakāle.","<b>Kammakaraṇavīriyābhāvo</b>ti taṃkammakiriyasamuṭṭhāpakavīriyābhāvo.","So pana atthato vīriyapaṭipakkho akusalacittuppādo, na vīriyassa abhāvamattaṃ.","<b>Sīlasaññamābhāvo</b> dussīlyaṃ.","<b>Vissaṭṭhācāratā</b> nāma anācāro.","<b>Soppabahulatā</b>ti niddālutā.","Yato gahaṇahatthopi na kilāsupi puriso niddāya abhibhuyyati.","Tenāha <b>“tāyā”</b>tiādi.","<b>Aticchātādīnī</b>ti <b>ādi</b> -saddena abhibhuyyatādiṃ saṅgaṇhāti.","<b>Āgantukālasiyaṃ</b> na pubbe vuttaālasyaṃ viya pakatisiddhaṃ.","“Te chidde”ti pāḷiyaṃ liṅgavipallāsena vuttanti āha <b>“tāni cha chiddānī”</b>ti.","Kusalacittappavattiyā anokāsabhāvato <b>chiddāni</b>.","Tenāha bhagavā –","<b>“yattha vittaṃ na tiṭṭhatī”</b>ti.","<b>Sabbākārena</b> lesamattaṃ asesetvāti adhippāyo."],"lineRefs":[["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:3"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"],["sn1.76:5"]]}],"wordLinks":[["sn1.76:3.1","nāmagottaṃ",0,0],["sn1.76:3.1","na jīratī",0,2],["sn1.76:5.1","chiddāni",1,16],["sn1.76:5.1","yattha vittaṃ na tiṭṭhatī",1,18]],"before":[{"para":607,"vripara":null,"refs":[],"lines":["<b>Vācantiādīni tīṇi aṅgāni</b>tividhasīlasampattidīpanato.","Sampannasīlo hi paralokaṃ na bhāseyya.","<b>Saddho ekaṃ aṅgaṃ</b> payogāsayasuddhidīpanato.","Suddhāsayassa sammāpayoge ṭhitassa kathaṃ paralokato bhayanti.","Dukavasena caturaṅgayojanā <b>dukanayo.</b>","<b>Etesu catūsu dhammesu ṭhito</b>ti etesu yathāvuttadukasaṅgahesu catūsu guṇesu patiṭṭhito."],"lineRefs":[[],[],[],[],[],[]]},{"para":608,"vripara":null,"refs":[],"lines":["Bhītāsuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":609,"vripara":null,"refs":[],"lines":["Najīratisuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
