{"suttaId":"sn1.50","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[624,656],"vripara":"50"},"segments":{"sn1.50:0.3":"Ghaṭīkārasuttaṃ","sn1.50:1.1":"“Avihaṃ upapannāse,","sn1.50:1.2":"vimuttā satta bhikkhavo;","sn1.50:1.3":"Rāgadosaparikkhīṇā,","sn1.50:1.4":"tiṇṇā loke visattikan”ti.","sn1.50:2.1":"“Ke ca te ataruṃ paṅkaṃ [saṅgaṃ (sī. syā.)],","sn1.50:2.2":"maccudheyyaṃ suduttaraṃ;","sn1.50:2.3":"Ke hitvā mānusaṃ dehaṃ,","sn1.50:2.4":"dibbayogaṃ upaccagun”ti.","sn1.50:3.1":"“Upako palagaṇḍo ca,","sn1.50:3.2":"pukkusāti ca te tayo;","sn1.50:3.3":"Bhaddiyo khaṇḍadevo ca,","sn1.50:3.4":"bāhuraggi ca siṅgiyo [bahudantī ca piṅgayo (sī.)];","sn1.50:3.5":"Te hitvā mānusaṃ dehaṃ,","sn1.50:3.6":"dibbayogaṃ upaccagun”ti.","sn1.50:4.1":"“Kusalī bhāsasī tesaṃ,","sn1.50:4.2":"mārapāsappahāyinaṃ;","sn1.50:4.3":"Kassa te dhammamaññāya,","sn1.50:4.4":"acchiduṃ bhavabandhanan”ti.","sn1.50:5.1":"“Na aññatra bhagavatā,","sn1.50:5.2":"nāññatra tava sāsanā;","sn1.50:5.3":"Yassa te dhammamaññāya,","sn1.50:5.4":"acchiduṃ bhavabandhanaṃ.","sn1.50:6.1":"“Yattha nāmañca rūpañca,","sn1.50:6.2":"asesaṃ uparujjhati;","sn1.50:6.3":"Taṃ te dhammaṃ idhaññāya,","sn1.50:6.4":"acchiduṃ bhavabandhanan”ti.","sn1.50:7.1":"“Gambhīraṃ bhāsasī vācaṃ,","sn1.50:7.2":"dubbijānaṃ sudubbudhaṃ;","sn1.50:7.3":"Kassa tvaṃ dhammamaññāya,","sn1.50:7.4":"vācaṃ bhāsasi īdisan”ti.","sn1.50:8.1":"“Kumbhakāro pure āsiṃ,","sn1.50:8.2":"vekaḷiṅge [vehaḷiṅge (sī.), vebhaḷiṅge (syā. kaṃ.)] ghaṭīkaro;","sn1.50:8.3":"Mātāpettibharo āsiṃ,","sn1.50:8.4":"kassapassa upāsako.","sn1.50:9.1":"“Virato methunā dhammā,","sn1.50:9.2":"brahmacārī nirāmiso;","sn1.50:9.3":"Ahuvā te sagāmeyyo,","sn1.50:9.4":"ahuvā te pure sakhā.","sn1.50:10.1":"“Sohamete pajānāmi,","sn1.50:10.2":"vimutte satta bhikkhavo;","sn1.50:10.3":"Rāgadosaparikkhīṇe,","sn1.50:10.4":"tiṇṇe loke visattikan”ti.","sn1.50:11.1":"“Evametaṃ tadā āsi,","sn1.50:11.2":"yathā bhāsasi bhaggava;","sn1.50:11.3":"Kumbhakāro pure āsi,","sn1.50:11.4":"vekaḷiṅge ghaṭīkaro;","sn1.50:11.5":"Mātāpettibharo āsi,","sn1.50:11.6":"kassapassa upāsako.","sn1.50:12.1":"“Virato methunā dhammā,","sn1.50:12.2":"brahmacārī nirāmiso;","sn1.50:12.3":"Ahuvā me sagāmeyyo,","sn1.50:12.4":"ahuvā me pure sakhā”ti.","sn1.50:13.1":"“Evametaṃ purāṇānaṃ,","sn1.50:13.2":"sahāyānaṃ ahu saṅgamo;","sn1.50:13.3":"Ubhinnaṃ bhāvitattānaṃ,","sn1.50:13.4":"sarīrantimadhārinan”ti.","sn1.50:13.5":"Ādittavaggo pañcamo.","sn1.50:14.0":"Tassuddānaṃ –","sn1.50:14.1":"Ādittaṃ kiṃdadaṃ annaṃ,","sn1.50:14.2":"ekamūlaanomiyaṃ;","sn1.50:14.3":"Accharāvanaropajetaṃ,","sn1.50:14.4":"maccharena ghaṭīkaroti."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":431,"to":431,"paras":[{"para":431,"vripara":"50","refs":["sn1.50:1","sn1.50:2","sn1.50:3","sn1.50:4","sn1.50:6","sn1.50:7","sn1.50:9"],"lines":["Dasame <b>upapannāse</b>ti nibbattivasena upagatā.","<b>Vimuttā</b>ti avihābrahmalokasmiṃ upapattisamanantarameva arahattaphalavimuttiyā vimuttā.","<b>Mānusaṃ dehan</b>ti idha pañcorambhāgiyasaṃyojanāni eva vuttāni.","<b>Dibbayogan</b>ti pañca uddhambhāgiyasaṃyojanāni.","<b>Upaccagun</b>ti atikkamiṃsu.","<b>Upako</b>tiādīni tesaṃ therānaṃ nāmāni.","<b>Kusalī bhāsasī tesan</b>ti,“kusalan”ti idaṃ vacanaṃ imassa atthīti <b>kusalī,</b> tesaṃ therānaṃ tvaṃ kusalaṃ anavajjaṃ bhāsasi, thomesi pasaṃsasi, paṇḍitosi devaputtāti vadati.","<b>Taṃ te dhammaṃ idhaññāyā</b>ti te therā taṃ dhammaṃ idha tumhākaṃ sāsane jānitvā.","<b>Gambhīran</b>ti gambhīratthaṃ.","<b>Brahmacārī nirāmiso</b>ti nirāmisabrahmacārī nāma anāgāmī, anāgāmī ahosinti attho.","<b>Ahuvā</b>ti ahosi.","<b>Sagāmeyyo</b>ti ekagāmavāsī.","Pariyosānagāthā saṅgītikārehi ṭhapitāti.","Dasamaṃ."],"lineRefs":[["sn1.50:1"],["sn1.50:1"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:3"],["sn1.50:4"],["sn1.50:6"],["sn1.50:7"],["sn1.50:9"],["sn1.50:9"],["sn1.50:9"],["sn1.50:9"],["sn1.50:9"]]}],"wordLinks":[["sn1.50:1.1","upapannāse",0,0],["sn1.50:1.1","vimuttā",0,1],["sn1.50:2.3","mānusaṃ dehaṃ",0,2],["sn1.50:2.3","dibbayogaṃ",0,3],["sn1.50:2.3","upaccaguṃ",0,4],["sn1.50:3.1","upako",0,5],["sn1.50:4.1","kusalī",0,6],["sn1.50:4.1","kusalī bhāsasī tesaṃ",0,6],["sn1.50:6.3","taṃ te dhammaṃ idhaññāyā",0,7],["sn1.50:7.1","gambhīraṃ",0,8],["sn1.50:9.1","brahmacārī nirāmiso",0,9],["sn1.50:9.3","ahuvā",0,10],["sn1.50:9.3","sagāmeyyo",0,11]],"before":[{"para":430,"vripara":null,"title":"Ghaṭīkārasuttavaṇṇanā","lines":["Ghaṭīkārasuttavaṇṇanā"]}],"after":[{"para":432,"vripara":null,"title":"Ghaṭīkārasuttavaṇṇanā","lines":["Ādittavaggo pañcamo."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":521,"to":521,"paras":[{"para":521,"vripara":"50","refs":["sn1.50:2"],"lines":["“Upapannāse”ti se-kārāgamaṃ katvā niddeso,“upapannā” icceva atthoti āha <b>“nibbattivasena upagatā”</b>ti.","Attano sampattito avihānato avihā, tesaṃ brahmaloko <b>avihābrahmaloko,</b> tasmiṃ.","<b>Upapattisamanantaramevā</b>ti paṭhamakoṭṭhāse eva.","<b>Arahattaphalavimuttiyā</b>ti asekkhavimuttiyā.","Sekkhavimuttiyā pana avihūpapattito pageva vimuttā.","Mānusaṃ dehaṃ samatikkamanti cittupakkilesapahānavasenāti phalena hetudassanamidanti āha <b>“mānusaṃ dehanti idha … pe … vuttānī”</b>ti.","Divi bhavaṃ dibbaṃ, brahmattabhāvasaññitaṃ khandhapañcakaṃ.","Tattha saṃyojanakoti vuttaṃ <b>“dibbaṃ yoganti pañca uddhambhāgiyasaṃyojanānī”</b>ti.","<b>Imassā</b>ti devaputtassa.","<b>“Hitvā mānusaṃ dehaṃ, dibbayogaṃ upaccagun”</b>ti tesaṃ tvaṃ kusalaṃ sabbāvajjappahānena anavajjataṃ bhāsatīti kusalī vadesi.","Atthena saddassa abhedopacāraṃ katvā gambhīravacanaṃ vuttanti āha <b>“gambhīratthan”</b>ti atthasseva gambhīrato, na saddassa.","Samucchinnakāmarāgatāya sabbaso kāmavisayappahānena <b>nirāmisabrahmacārī nāma anāgāmī</b>.","Nivāsanaṭṭhānabhūto samāno eko gāmo etassāti āha <b>“ekagāmavāsī”</b>ti."],"lineRefs":[["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"],["sn1.50:2"]]}],"wordLinks":[["sn1.50:2.3","hitvā mānusaṃ dehaṃ dibbayogaṃ upaccaguṃ",0,9]],"before":[{"para":520,"vripara":null,"title":"Ghaṭīkārasuttavaṇṇanā","lines":["Ghaṭīkārasuttavaṇṇanā"]}],"after":[{"para":522,"vripara":null,"title":"Ghaṭīkārasuttavaṇṇanā","lines":["Ghaṭīkārasuttavaṇṇanā niṭṭhitā."]},{"para":523,"vripara":null,"title":"Ghaṭīkārasuttavaṇṇanā","lines":["Ādittavaggavaṇṇanā niṭṭhitā."]}]},"tika2":null}
