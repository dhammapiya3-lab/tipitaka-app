{"suttaId":"thi-ap3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[6616,6629],"vripara":"26"},"segments":{"thi-ap3:0.3":"Maṇḍapadāyikātherīapadānaṃ","thi-ap3:1.1":"“Koṇāgamanabuddhassa,","thi-ap3:1.2":"maṇḍapo kārito mayā;","thi-ap3:1.3":"Dhuvaṃ ticīvaraṃdāsiṃ [thūpañca pavaramadaṃ (syā.), dhuvañca cīvaraṃ adaṃ (pī.)],","thi-ap3:1.4":"buddhassa lokabandhuno. 27.","thi-ap3:2.1":"“Yaṃ yaṃ janapadaṃ yāmi,","thi-ap3:2.2":"nigame rājadhāniyo;","thi-ap3:2.3":"Sabbattha pūjito homi,","thi-ap3:2.4":"puññakammassidaṃ phalaṃ. 28.","thi-ap3:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","thi-ap3:3.3":"viharāmi anāsavā. 29.","thi-ap3:4.1":"“Svāgataṃ vata me āsi…pe…","thi-ap3:4.3":"kataṃ buddhassa sāsanaṃ. 30.","thi-ap3:5.1":"“Paṭisambhidā catasso…pe…","thi-ap3:5.3":"kataṃ buddhassa sāsanaṃ”.","thi-ap3:6.1":"Itthaṃ sudaṃ maṇḍapadāyikā bhikkhunī imā gāthāyo abhāsitthāti.","thi-ap3:7.1":"Maṇḍapadāyikātheriyāpadānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
