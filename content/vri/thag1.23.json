{"suttaId":"thag1.23","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[140,144],"vripara":"23"},"segments":{"thag1.23:0.4":"Gosālattheragāthā","thag1.23:1.1":"“Ahaṃ kho veḷugumbasmiṃ, bhutvāna madhupāyasaṃ;","thag1.23:1.3":"Padakkhiṇaṃ sammasanto, <b>khandhānaṃ udayabbayaṃ;</b>","thag1.23:1.5":"Sānuṃ paṭigamissāmi, vivekamanubrūhayan”ti.","thag1.23:1.7":"… Gosālo thero …."},"attha":null,"tika":null}
