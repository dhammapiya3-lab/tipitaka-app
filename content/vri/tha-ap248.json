{"suttaId":"tha-ap248","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8181,8190],"vripara":"20"},"segments":{"tha-ap248:0.3":"Pattadāyakattheraapadānaṃ","tha-ap248:1.1":"“Paramena damathena, siddhatthassa mahesino;","tha-ap248:1.3":"Pattadānaṃ mayā dinnaṃ, ujubhūtassa tādino.","tha-ap248:2.1":"“Catunnavutito kappe, yaṃ dānamadadiṃ tadā;","tha-ap248:2.3":"Duggatiṃ nābhijānāmi, pattadānassidaṃ phalaṃ.","tha-ap248:3.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap248:4.1":"Itthaṃ sudaṃ āyasmā pattadāyako thero imā gāthāyo abhāsitthāti.","tha-ap248:5.1":"Pattadāyakattherassāpadānaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
