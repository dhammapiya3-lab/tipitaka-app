{"suttaId":"an6.23","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[148,155],"vripara":"23"},"segments":{"an6.23:0.3":"Bhayasuttaṃ","an6.23:1.1":"“‘Bhaya’nti, bhikkhave, kāmānametaṃ adhivacanaṃ;","an6.23:1.2":"‘dukkha’nti, bhikkhave, kāmānametaṃ adhivacanaṃ;","an6.23:1.3":"‘rogo’ti, bhikkhave, kāmānametaṃ adhivacanaṃ;","an6.23:1.4":"‘gaṇḍo’ti, bhikkhave, kāmānametaṃ adhivacanaṃ;","an6.23:1.5":"‘saṅgo’ti, bhikkhave, kāmānametaṃ adhivacanaṃ;","an6.23:1.6":"‘paṅko’ti, bhikkhave, kāmānametaṃ adhivacanaṃ.","an6.23:2.1":"“Kasmā ca, bhikkhave, ‘bhaya’nti kāmānametaṃ adhivacanaṃ?","an6.23:2.2":"Kāmarāgarattāyaṃ, bhikkhave, chandarāgavinibaddho diṭṭhadhammikāpi bhayā na parimuccati, samparāyikāpi bhayā na parimuccati, tasmā ‘bhaya’nti kāmānametaṃ adhivacanaṃ.","an6.23:2.3":"Kasmā ca, bhikkhave, dukkhanti…pe…","an6.23:2.4":"rogoti…","an6.23:2.5":"gaṇḍoti…","an6.23:2.6":"saṅgoti…","an6.23:2.7":"paṅkoti kāmānametaṃ adhivacanaṃ?","an6.23:2.8":"Kāmarāgarattāyaṃ, bhikkhave, chandarāgavinibaddho diṭṭhadhammikāpi paṅkā na parimuccati, samparāyikāpi paṅkā na parimuccati, tasmā ‘paṅko’ti kāmānametaṃ adhivacana”nti.","an6.23:3.1":"“Bhayaṃ dukkhaṃ rogo gaṇḍo,","an6.23:3.2":"saṅgo paṅko ca ubhayaṃ;","an6.23:3.3":"Ete kāmā pavuccanti,","an6.23:3.4":"yattha satto puthujjano.","an6.23:4.1":"“Upādāne bhayaṃ disvā,","an6.23:4.2":"jātimaraṇasambhave;","an6.23:4.3":"Anupādā vimuccanti,","an6.23:4.4":"jātimaraṇasaṅkhaye.","an6.23:5.1":"“Te khemappattā sukhino,","an6.23:5.2":"diṭṭhadhammābhinibbutā;","an6.23:5.3":"Sabbaverabhayātītā [sabbe verabhayātītā (syā.)],","an6.23:5.4":"sabbadukkhaṃ upaccagu”nti.","an6.23:5.5":"tatiyaṃ; 4."},"unsure":[],"preface":[],"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":564,"to":564,"paras":[{"para":564,"vripara":"23","refs":["an6.23:2","an6.23:3","an6.23:4","an6.23:5"],"lines":["Tatiye <b>kāmarāgarattāya</b>nti kāmarāgaratto ayaṃ.","<b>Chandarāgavinibaddho</b>ti chandarāgena vinibaddho.","<b>Bhayā</b>ti cittutrāsabhayā.","<b>Paṅkā</b>ti kilesapaṅkato.","<b>Saṅgo paṅko ca ubhaya</b>nti saṅgo ca paṅko ca idampi ubhayaṃ.","<b>Ete kāmā pavuccanti, yattha satto puthujjano</b>ti yasmiṃ saṅge ca paṅke ca puthujjano satto laggo laggito palibuddho.","<b>Upādāne</b>ti catubbidhe upādāne.","<b>Jātimaraṇasambhave</b>ti jātiyā ca maraṇassa ca sambhave paccayabhūte.","<b>Anupādā</b> <b>vimuccantī</b>ti anupādiyitvā vimuccanti.","<b>Jātimaraṇasaṅkhaye</b>ti jātimaraṇānaṃ saṅkhayasaṅkhāte nibbāne, nibbānārammaṇāya vimuttiyā vimuccantīti attho.","Imasmiṃ ṭhāne vivaṭṭetvā arahattameva patto esa bhikkhu.","Idāni taṃ khīṇāsavaṃ thomento <b>te khemappattā</b>tiādimāha.","Tattha <b>khemappattā</b>ti khemabhāvaṃ pattā.","<b>Sukhino</b>ti lokuttarasukhena sukhitā.","<b>Diṭṭhadhammābhinibbutā</b>ti abbhantare kilesābhāvena diṭṭhadhammeyeva abhinibbutā.","Imasmiṃ sutte vaṭṭameva kathetvā gāthāsu vaṭṭavivaṭaṃ kathitaṃ. 4."],"lineRefs":[["an6.23:2"],["an6.23:2"],["an6.23:2"],["an6.23:2"],["an6.23:3"],["an6.23:3"],["an6.23:4"],["an6.23:4"],["an6.23:4"],["an6.23:4"],["an6.23:4"],["an6.23:5"],["an6.23:5"],["an6.23:5"],["an6.23:5"],["an6.23:5"]]}],"wordLinks":[["an6.23:2.2","kāmarāgarattāyaṃ",0,0],["an6.23:2.8","kāmarāgarattāyaṃ",0,0],["an6.23:2.2","chandarāgavinibaddho",0,1],["an6.23:2.8","chandarāgavinibaddho",0,1],["an6.23:2.1","bhayā",0,2],["an6.23:2.2","bhayā",0,2],["an6.23:2.3","paṅkā",0,3],["an6.23:2.8","paṅkā",0,3],["an6.23:3.1","saṅgo paṅko ca ubhayaṃ",0,4],["an6.23:3.3","ete kāmā pavuccanti yattha satto puthujjano",0,5],["an6.23:4.1","upādāne",0,6],["an6.23:4.1","jātimaraṇasambhave",0,7],["an6.23:4.3","anupādā vimuccantī",0,8],["an6.23:4.3","jātimaraṇasaṅkhaye",0,9],["an6.23:5.1","te khemappattā",0,11],["an6.23:5.1","khemappattā",0,12],["an6.23:5.1","sukhino",0,13],["an6.23:5.1","diṭṭhadhammābhinibbutā",0,14]]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":555,"to":555,"paras":[{"para":555,"vripara":"23","refs":["an6.23:4","an6.23:5"],"lines":["Tatiye sambhavati jātimaraṇaṃ etenāti <b>sambhavo,</b> upādānanti āha <b>“jātiyā ca maraṇassa ca sambhave paccayabhūte”</b>ti.","<b>Anupādā</b>ti anupādāya.","Tenāha <b>“anupādiyitvā”</b>ti.","Jātimaraṇāni sammā khīyanti etthāti <b>jātimaraṇasaṅkhayo,</b> nibbānanti āha <b>“jātimaraṇānaṃ saṅkhayasaṅkhāte nibbāne”</b>ti.","<b>Sabbadukkhaṃ upaccagu</b>nti sakalampi vaṭṭadukkhaṃ atikkantā carimacittanirodhena vaṭṭadukkhalesassapi asambhavato."],"lineRefs":[["an6.23:4"],["an6.23:4"],["an6.23:4"],["an6.23:4"],["an6.23:5"]]}],"wordLinks":[["an6.23:4.1","sambhavo",0,0],["an6.23:4.3","anupādā",0,1],["an6.23:4.3","jātimaraṇasaṅkhayo",0,3],["an6.23:5.3","sabbadukkhaṃ upaccaguṃ",0,4]],"after":[{"para":556,"vripara":null,"title":"Bhayasuttavaṇṇanā","lines":["Bhayasuttavaṇṇanā niṭṭhitā. 4."]}]},"tika2":null}
