{"suttaId":"thag1.56","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[329,332],"vripara":"56"},"segments":{"thag1.56:0.4":"Kuṭivihārittheragāthā","thag1.56:1.1":"“Ko kuṭikāyaṃ bhikkhu kuṭikāyaṃ,","thag1.56:1.2":"vītarāgo susamāhitacitto;","thag1.56:1.3":"Evaṃ jānāhi āvuso,","thag1.56:1.4":"amoghā te kuṭikā katā”ti. …","thag1.56:1.5":"Kuṭivihāritthero…. 7."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":1449,"to":1456,"paras":[{"para":1449,"vripara":null,"refs":["thag1.56:1"],"lines":["Tattha <b>ko kuṭikāya</b>nti, “imissaṃ kuṭikāyaṃ ko nisinno”ti khettapālassa pucchāvacanaṃ.","Tassa <b>bhikkhu kuṭikāya</b>nti therassa paṭivacanadānaṃ.","Atha naṃ attano anuttaradakkhiṇeyyabhāvato taṃ kuṭiparibhogaṃ anumodāpetvā uḷāraṃ tameva puññaṃ patiṭṭhāpetuṃ <b>“vītarāgo”</b>tiādi vuttaṃ.","Tassattho – eko bhinnakileso <b>bhikkhu</b> te <b>kuṭikāyaṃ</b> nisinno, tato eva so aggamaggena sabbaso samucchinnarāgatāya <b>vītarāgo</b> anuttarasamādhinā nibbānaṃ ārammaṇaṃ katvā suṭṭhu samāhitacittatāya <b>susamāhitacitto,</b> imañca atthaṃ, <b>āvuso</b> khettapāla, yathāhaṃ vadāmi, <b>evaṃ jānāhi</b> saddaha adhimuccassu.","<b>Amoghā</b> <b>te kuṭikā katā</b> tayā katā kuṭikā amoghā avañjhā saphalā saudrayā, yasmā arahatā khīṇāsavena paribhuttā.","Sace tvaṃ anumodasi, taṃ te bhavissati dīgharattaṃ hitāya sukhāyāti."],"lineRefs":[["thag1.56:1"],["thag1.56:1"],["thag1.56:1"],["thag1.56:1"],["thag1.56:1"],["thag1.56:1"]]},{"para":1450,"vripara":null,"refs":["thag1.56:1"],"lines":["Taṃ sutvā khettapālo “lābhā vata me, suladdhaṃ vata me, yassa me kuṭikāyaṃ ediso ayyo pavisitvā nisīdatī”ti pasannacitto anumodanto aṭṭhāsi.","Imaṃ pana tesaṃ kathāsallāpaṃ bhagavā dibbāya sotadhātuyā sutvā anumodanañcassa ñatvā tambhāviniṃ sampattiṃ vibhāvento khettapālaṃ imāhi gāthāhi ajjhabhāsi –"],"lineRefs":[["thag1.56:1"],["thag1.56:1"]]},{"para":1451,"vripara":null,"refs":["thag1.56:1"],"lines":["“Vihāsi kuṭiyaṃ bhikkhu, santacitto anāsavo;"],"lineRefs":[["thag1.56:1"]]},{"para":1452,"vripara":null,"refs":["thag1.56:1"],"lines":["Tena kammavipākena, devindo tvaṃ bhavissasi."],"lineRefs":[["thag1.56:1"]]},{"para":1453,"vripara":null,"refs":["thag1.56:1"],"lines":["“Chattiṃsakkhattuṃ devindo, devarajjaṃ karissasi;"],"lineRefs":[["thag1.56:1"]]},{"para":1454,"vripara":null,"refs":["thag1.56:1"],"lines":["Catuttiṃsakkhattuṃ cakkavattī, rājā raṭṭhe bhavissasi;"],"lineRefs":[["thag1.56:1"]]},{"para":1455,"vripara":null,"refs":["thag1.56:1"],"lines":["Ratanakuṭi nāma paccekabuddho, vītarāgo bhavissasī”ti."],"lineRefs":[["thag1.56:1"]]},{"para":1456,"vripara":null,"refs":["thag1.56:1"],"lines":["Kuṭikāyaṃ laddhavisesattā pana therassa tato pabhuti <b>kuṭivihārī</b>tveva samaññā udapādi.","Ayameva ca therassa aññābyākaraṇagāthāpi ahosīti."],"lineRefs":[["thag1.56:1"],["thag1.56:1"]]}],"wordLinks":[["thag1.56:1.1","ko kuṭikāyaṃ",0,0],["thag1.56:1.1","bhikkhu kuṭikāyaṃ",0,1],["thag1.56:1.1","vītarāgo",0,2],["thag1.56:1.1","bhikkhu",0,3],["thag1.56:1.1","kuṭikāyaṃ",0,3],["thag1.56:1.1","susamāhitacitto",0,3],["thag1.56:1.1","vītarāgo",0,3],["thag1.56:1.3","evaṃ jānāhi",0,3],["thag1.56:1.3","āvuso",0,3],["thag1.56:1.3","amoghā te kuṭikā katā",0,4],["thag1.56:1.5","kuṭivihārī",7,0]],"before":[{"para":1429,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Kuṭivihārittheragāthāvaṇṇanā"]},{"para":1430,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["<b>Ko</b> <b>kuṭikāya</b>nti āyasmato kuṭivihārittherassa gāthā.","Kā uppatti?","So kira padumuttarassa bhagavato ākāsena gacchantassa “udakadānaṃ dassāmī”ti sītalaṃ udakaṃ gahetvā pītisomanassajāto uddhammukho hutvā ukkhipi.","Satthā tassa ajjhāsayaṃ ñatvā pasādasaṃvaḍḍhanatthaṃ ākāse ṭhitova sampaṭicchi.","So tena anappakaṃ pītisomanassaṃ paṭisaṃvedesi.","Sesaṃ añjanavaniyattherassa vatthumhi vuttasadisameva.","Ayaṃ pana viseso – ayaṃ kira vuttanayena pabbajitvā katapubbakicco vipassanaṃ anuyuñjanto sāyaṃ khettasamīpena gacchanto deve phusāyante khettapālakassa puññaṃ tiṇakuṭiṃ disvā pavisitvā tattha tiṇasanthārake nisīdi.","Nisinnamattova utusappāyaṃ labhitvā vipassanaṃ ussukkāpetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.11.29-35) –"]},{"para":1431,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["“Suvaṇṇavaṇṇaṃ sambuddhaṃ, gacchantaṃ anilañjase;"]},{"para":1432,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Ghatāsanaṃva jalitaṃ, ādittaṃva hutāsanaṃ."]},{"para":1433,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["“Pāṇinā udakaṃ gayha, ākāse ukkhipiṃ ahaṃ;"]},{"para":1434,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Sampaṭicchi mahāvīro, buddho kāruṇiko isi."]},{"para":1435,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["“Antalikkhe ṭhito satthā, padumuttaranāmako;"]},{"para":1436,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Mama saṅkappamaññāya, imā gāthā abhāsatha."]},{"para":1437,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["“Iminā dakadānena, pītiuppādanena ca;"]},{"para":1438,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Kappasatasahassampi, duggatiṃ nupapajjati."]},{"para":1439,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["“Tena kammena dvipadinda, lokajeṭṭha narāsabha;"]},{"para":1440,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Pattomhi acalaṃ ṭhānaṃ, hitvā jayaparājayaṃ."]},{"para":1441,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["“Sahassarājanāmena, tayo te cakkavattino;"]},{"para":1442,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Pañcasaṭṭhikappasate, cāturantā janādhipā."]},{"para":1443,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti."]},{"para":1444,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Arahattaṃ pana patvā there tattha nisinne khettapālako āgantvā “ko kuṭikāya”nti āha.","Taṃ sutvā thero “bhikkhu kuṭikāya”ntiādimāha.","Tayidaṃ khettapālassa therassa ca vacanaṃ ekajjhaṃ katvā – 56."]},{"para":1446,"vripara":"56","title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["“Ko kuṭikāyaṃ bhikkhu kuṭikāyaṃ, vītarāgo susamāhitacitto;"]},{"para":1447,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Evaṃ jānāhi āvuso, amoghā te kuṭikā katā”ti. –"]},{"para":1448,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Tathārūpena saṅgītiṃ āropitaṃ."]}],"after":[{"para":1457,"vripara":null,"title":"Kuṭivihārittheragāthāvaṇṇanā","lines":["Kuṭivihārittheragāthāvaṇṇanā niṭṭhitā. 7."]}]},"tika":null,"tika2":null}
