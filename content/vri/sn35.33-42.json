{"suttaId":"sn35.33-42","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[127,140],"vripara":"33"},"segments":{"sn35.33:0.3":"1-10. Jātidhammādisuttadasakaṃ","sn35.33:1.1":"Sāvatthinidānaṃ.","sn35.33:1.2":"Tatra kho…pe…","sn35.33:1.3":"“sabbaṃ, bhikkhave, jātidhammaṃ.","sn35.33:1.4":"Kiñca, bhikkhave, sabbaṃ jātidhammaṃ?","sn35.33:1.5":"Cakkhu, bhikkhave, jātidhammaṃ.","sn35.33:1.6":"Rūpā…","sn35.33:1.7":"cakkhuviññāṇaṃ…","sn35.33:1.8":"cakkhusamphasso jātidhammo.","sn35.33:1.9":"Yampidaṃ cakkhusamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi jātidhammaṃ…pe…","sn35.33:1.10":"jivhā…","sn35.33:1.11":"rasā…","sn35.33:1.12":"jivhāviññāṇaṃ…","sn35.33:1.13":"jivhāsamphasso…","sn35.33:1.14":"yampidaṃ jivhāsamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi jātidhammaṃ.","sn35.33:1.15":"Kāyo…pe...","sn35.33:1.16":"mano jātidhammo, dhammā jātidhammā, manoviññāṇaṃ jātidhammaṃ, manosamphasso jātidhammo.","sn35.33:1.17":"Yampidaṃ manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi jātidhammaṃ.","sn35.33:1.18":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako cakkhusmimpi nibbindati, rūpesupi… cakkhuviññāṇepi… cakkhusamphassepi…pe…","sn35.33:1.19":"nāparaṃ itthattāyāti pajānātī”ti.","sn35.33:1.20":"Paṭhamaṃ. 34.","sn35.34:1.1":"“Sabbaṃ, bhikkhave, jarādhammaṃ…pe… saṃkhittaṃ.","sn35.34:1.3":"Dutiyaṃ. 35.","sn35.35:1.1":"“Sabbaṃ, bhikkhave, byādhidhammaṃ…pe….","sn35.35:1.3":"Tatiyaṃ. 36.","sn35.36:1.1":"“Sabbaṃ, bhikkhave, maraṇadhammaṃ…pe….","sn35.36:1.3":"Catutthaṃ. 37.","sn35.37:1.1":"“Sabbaṃ, bhikkhave, sokadhammaṃ…pe….","sn35.37:1.3":"Pañcamaṃ. 38.","sn35.38:1.1":"“Sabbaṃ, bhikkhave, saṃkilesikadhammaṃ…pe….","sn35.38:1.3":"Chaṭṭhaṃ. 39.","sn35.39:1.1":"“Sabbaṃ, bhikkhave, khayadhammaṃ…pe….","sn35.39:1.2":"Sattamaṃ. 40.","sn35.40:1.1":"“Sabbaṃ, bhikkhave, vayadhammaṃ…pe….","sn35.40:1.3":"Aṭṭhamaṃ. 41.","sn35.41:1.1":"“Sabbaṃ, bhikkhave, samudayadhammaṃ…pe….","sn35.41:1.3":"Navamaṃ. 42.","sn35.42:1.1":"“Sabbaṃ, bhikkhave, nirodhadhammaṃ…pe….","sn35.42:1.3":"Dasamaṃ.","sn35.42:1.4":"Jātidhammavaggo catuttho.","sn35.42:2.0":"Tassuddānaṃ –","sn35.42:2.1":"Jātijarābyādhimaraṇaṃ,","sn35.42:2.2":"soko ca saṃkilesikaṃ;","sn35.42:2.3":"Khayavayasamudayaṃ,","sn35.42:2.4":"nirodhadhammena te dasāti. 5."},"unsure":["sn35.34:1.1","sn35.38:1.1","sn35.39:1.2"],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":64,"to":64,"paras":[{"para":64,"vripara":"33-42","refs":["sn35.33"],"lines":["Jātidhammavagge <b>jātidhamma</b>nti jāyanadhammaṃ nibbattanasabhāvaṃ.","<b>Jarādhamma</b>nti jīraṇasabhāvaṃ.","<b>Byādhidhamma</b>nti byādhino uppattipaccayabhāvena byādhisabhāvaṃ.","<b>Maraṇadhamma</b>nti maraṇasabhāvaṃ.","<b>Sokadhamma</b>nti sokassa uppattipaccayabhāvena sokasabhāvaṃ.","<b>Saṃkilesikadhamma</b>nti saṃkilesikasabhāvaṃ.","<b>Khayadhamma</b>nti khayagamanasabhāvaṃ.","<b>Vayadhammā</b>dīsupi eseva nayoti."],"lineRefs":[["sn35.33"],["sn35.33"],["sn35.33"],["sn35.33"],["sn35.33"],["sn35.33"],["sn35.33"],["sn35.33"]]}],"wordLinks":[["sn35.33:1.2","jātidhammaṃ",0,0],["sn35.33:1.4","jātidhammaṃ",0,0],["sn35.33:1.5","jātidhammaṃ",0,0],["sn35.33:1.9","jātidhammaṃ",0,0],["sn35.33:1.16","jātidhammaṃ",0,0],["sn35.33:1.17","jātidhammaṃ",0,0]],"before":[{"para":63,"vripara":null,"title":"Jātidhammavaggavaṇṇanā","lines":["Jātidhammavaggavaṇṇanā 33-42."]}],"after":[{"para":65,"vripara":null,"title":"Jātidhammavaggavaṇṇanā","lines":["Jātidhammavaggo catuttho. 5."]}]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":73,"to":75,"paras":[{"para":73,"vripara":"33-42","refs":["sn35.33"],"lines":["<b>Nibbattanasabhāva</b>nti hetupaccayehi uppajjanasabhāvaṃ.","Uppādānantaraṃ buddhippattiyā <b>jīraṇasabhāvaṃ</b>.","Yattha cakkhādayo, tattheva visabhāgasamuṭṭhānalakkhaṇena byādhino <b>uppattipaccayabhāvena byādhisabhāvaṃ.</b>","<b>Maraṇasabhāva</b>nti vināsasabhāvaṃ.","<b>Sokasabhāva</b>nti ñātibyasanādinā ḍayhamānadukkhasabhāvaṃ.","<b>Saṃkilesikasabhāva</b>nti taṇhādivasena saṃkilissanasabhāvaṃ."],"lineRefs":[["sn35.33"],["sn35.33"],["sn35.33"],["sn35.33"],["sn35.33"],["sn35.33"]]},{"para":74,"vripara":null,"refs":["sn35.33"],"lines":["Jātidhammavaggavaṇṇanā niṭṭhitā. 5."],"lineRefs":[["sn35.33"]]},{"para":75,"vripara":null,"refs":["sn35.33"],"lines":["Sabbaaniccavaggavaṇṇanā 43-52."],"lineRefs":[["sn35.33"]]}],"wordLinks":[]},"tika2":null}
