{"suttaId":"an7.30","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[186,186],"vripara":"30"},"segments":{"an7.30:0.3":"Vipattisuttaṃ","an7.30:1.1":"Sattimā, bhikkhave, upāsakassa vipattiyo…pe…","an7.30:1.2":"sattimā, bhikkhave, upāsakassa sampadā…pe….","an7.30:1.3":"Dasamaṃ. 11."},"unsure":[],"preface":[],"attha":null,"tika":{"book":"Mp-t-vii","bookName":"Sattakanipāta-ṭīkā","vriCode":"s0403t.tik","from":859,"to":863,"paras":[{"para":859,"vripara":"27-31","refs":["an7.30:1"],"lines":["Sattame aniccāti anupassati etāyāti <b>aniccānupassanā</b>.","Tathāpavattavipassanā pana yasmā attanā sahagatasaññāya bhāvitāya bhāvitā eva hoti, tasmā vuttaṃ <b>“aniccānupassanādīhi sahagatasaññā”</b>ti.","Imā satta lokiyavipassanāpi honti “anicca”ntiādinā pavattanato.","“Etaṃ santaṃ etaṃ paṇītaṃ yadidaṃ sabbasaṅkhārasamatho”ti āgatavasena panettha dve lokuttarā hontīti veditabbā.","“Virāgo nirodho”ti hi tattha nibbānaṃ vuttanti idha virāgasaññā, tā vuttasaññā nibbānārammaṇāpi siyuṃ.","Sesamettha suviññeyyameva.","Aṭṭhamādīni uttānatthāneva."],"lineRefs":[["an7.30:1"],["an7.30:1"],["an7.30:1"],["an7.30:1"],["an7.30:1"],["an7.30:1"],["an7.30:1"]]},{"para":860,"vripara":null,"refs":["an7.30:1"],"lines":["Saññāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an7.30:1"]]},{"para":861,"vripara":null,"refs":["an7.30:1"],"lines":["Vajjisattakavaggavaṇṇanā niṭṭhitā. 4."],"lineRefs":[["an7.30:1"]]},{"para":862,"vripara":null,"refs":["an7.30:1"],"lines":["Devatāvaggo 5."],"lineRefs":[["an7.30:1"]]},{"para":863,"vripara":null,"refs":["an7.30:1"],"lines":["Paṭhamamittasuttavaṇṇanā 36."],"lineRefs":[["an7.30:1"]]}],"wordLinks":[]},"tika2":null}
