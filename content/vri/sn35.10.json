{"suttaId":"sn35.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[26,26],"vripara":"10"},"segments":{"sn35.10:0.3":"Bāhirāniccātītānāgatasuttaṃ","sn35.10:1.1":"“Rūpā, bhikkhave, aniccā atītānāgatā;","sn35.10:1.2":"ko pana vādo paccuppannānaṃ!","sn35.10:1.3":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītesu rūpesu anapekkho hoti;","sn35.10:1.4":"anāgate rūpe nābhinandati;","sn35.10:1.5":"paccuppannānaṃ rūpānaṃ nibbidāya virāgāya nirodhāya paṭipanno hoti.","sn35.10:1.6":"Saddā …","sn35.10:1.7":"gandhā …","sn35.10:1.8":"rasā …","sn35.10:1.9":"phoṭṭhabbā …","sn35.10:1.10":"dhammā aniccā atītānāgatā;","sn35.10:1.11":"ko pana vādo paccuppannānaṃ!","sn35.10:1.12":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītesu dhammesu anapekkho hoti;","sn35.10:1.13":"anāgate dhamme nābhinandati;","sn35.10:1.14":"paccuppannānaṃ dhammānaṃ nibbidāya virāgāya nirodhāya paṭipanno hotī”ti.","sn35.10:1.15":"Dasamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":15,"to":18,"paras":[{"para":15,"vripara":"7-12","refs":["sn35.10:1"],"lines":["7-12. Sattamādīni atītānāgatesu cakkhādīsu aniccalakkhaṇādīni sallakkhetvā paccuppannesu balavagāhena kilamantānaṃ vasena vuttāni.","Sesaṃ sabbattha heṭṭhā vuttanayamevāti."],"lineRefs":[["sn35.10:1"],["sn35.10:1"]]},{"para":16,"vripara":null,"refs":["sn35.10:1"],"lines":["Aniccavaggo paṭhamo."],"lineRefs":[["sn35.10:1"]]},{"para":17,"vripara":null,"refs":["sn35.10:1"],"lines":["Yamakavaggo"],"lineRefs":[["sn35.10:1"]]},{"para":18,"vripara":null,"refs":["sn35.10:1"],"lines":["1-4. Paṭhamapubbesambodhasuttādivaṇṇanā"],"lineRefs":[["sn35.10:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":18,"to":22,"paras":[{"para":18,"vripara":"7-12","refs":["sn35.10:1"],"lines":["7-12. <b>Sallakkhetvā</b>ti atītānāgatānaṃ avijjamānattā gāhassa daḷhatāya sallakkhetvā.","<b>Paccuppannesu</b> vijjamānattā balavatā taṇhādigāhena vipassanāvīthiṃ paṭipādetuṃ <b>kilamantānaṃ</b> vineyyānaṃ <b>vasena</b>."],"lineRefs":[["sn35.10:1"],["sn35.10:1"]]},{"para":19,"vripara":null,"refs":["sn35.10:1"],"lines":["Ajjhattāniccātītānāgatasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.10:1"]]},{"para":20,"vripara":null,"refs":["sn35.10:1"],"lines":["Aniccavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.10:1"]]},{"para":21,"vripara":null,"refs":["sn35.10:1"],"lines":["Yamakavaggo"],"lineRefs":[["sn35.10:1"]]},{"para":22,"vripara":null,"refs":["sn35.10:1"],"lines":["1-4. Paṭhamapubbesambodhasuttādivaṇṇanā"],"lineRefs":[["sn35.10:1"]]}],"wordLinks":[]},"tika2":null}
