{"suttaId":"vv77","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2757,2773],"vripara":"1126"},"segments":{"vv77:0.4":"Maṇithūṇavimānavatthu","vv77:1.1":"“Uccamidaṃ maṇithūṇaṃ vimānaṃ,","vv77:1.2":"samantato dvādasa yojanāni;","vv77:1.3":"Kūṭāgārā sattasatā uḷārā,","vv77:1.4":"veḷuriyathambhā rucakatthatā subhā. 1127.","vv77:2.1":"“Tatthacchasi pivasi khādasi ca,","vv77:2.2":"dibbā ca vīṇā pavadanti vagguṃ;","vv77:2.3":"Dibbā rasā kāmaguṇettha pañca,","vv77:2.4":"nāriyo ca naccanti suvaṇṇachannā. 1128.","vv77:3.1":"“Kena tetādiso vaṇṇo…pe…","vv77:3.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti. 1130.","vv77:4.1":"So devaputto attamano…pe…","vv77:4.3":"yassa kammassidaṃ phalaṃ. 1131.","vv77:5.1":"“Ahaṃ manussesu manussabhūto,","vv77:5.2":"vivane pathe saṅkamanaṃ [caṅkamanaṃ (sī.), caṅkamaṃ (syā.), samakaṃ (ka. sī.)] akāsiṃ;","vv77:5.3":"Ārāmarukkhāni ca ropayissaṃ,","vv77:5.4":"piyā ca me sīlavanto ahesuṃ;","vv77:5.5":"Annañca pānañca pasannacitto,","vv77:5.6":"sakkacca dānaṃ vipulaṃ adāsiṃ. 1132.","vv77:6.1":"“Tena metādiso vaṇṇo…pe…","vv77:6.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv77:7.1":"Maṇithūṇavimānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3315,"to":3315,"paras":[{"para":3315,"vripara":"1131","refs":["vv77:5"],"lines":["Tattha <b>vivane</b>ti araññe.","<b>Ārāmarukkhāni cā</b> ārāmabhūte rukkhe, ārāmaṃ katvā tattha rukkhe ropesinti attho.","Sesaṃ sabbaṃ vuttanayameva."],"lineRefs":[["vv77:5"],["vv77:5"],["vv77:5"]]}],"wordLinks":[["vv77:5.1","vivane",0,0],["vv77:5.3","ārāmarukkhāni cā",0,1]],"after":[{"para":3316,"vripara":null,"title":"Maṇithūṇavimānavaṇṇanā","lines":["Maṇithūṇavimānavaṇṇanā niṭṭhitā. 4."]}]},"tika":null,"tika2":null}
