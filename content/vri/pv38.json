{"suttaId":"pv38","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[2136,2311],"vripara":"658"},"segments":{"pv38:0.3":"Nandakapetavatthu","pv38:1.1":"Rājā piṅgalako nāma,","pv38:1.2":"suraṭṭhānaṃ adhipati ahu;","pv38:1.3":"Moriyānaṃ upaṭṭhānaṃ gantvā,","pv38:1.4":"suraṭṭhaṃ punarāgamā.","pv38:2.1":"Uṇhe majjhanhike [majjhantike (sabbattha)] kāle,","pv38:2.2":"rājā paṅkaṃ [vaṅkaṃ (ka.)] upāgami;","pv38:2.3":"Addasa maggaṃ ramaṇīyaṃ,","pv38:2.4":"petānaṃ taṃ vaṇṇupathaṃ [vaṇṇanāpathaṃ (sī. syā.)].","pv38:3.1":"Sārathiṃ āmantayī rājā –","pv38:4.1":"“Ayaṃ maggo ramaṇīyo,","pv38:4.2":"khemo sovatthiko sivo;","pv38:4.3":"Iminā sārathi yāma,","pv38:4.4":"suraṭṭhānaṃ santike ito”.","pv38:5.1":"Tena pāyāsi soraṭṭho,","pv38:5.2":"senāya caturaṅginiyā;","pv38:5.3":"Ubbiggarūpo puriso,","pv38:5.4":"soraṭṭhaṃ etadabravi.","pv38:6.1":"“Kummaggaṃ paṭipannamhā,","pv38:6.2":"bhiṃsanaṃ lomahaṃsanaṃ;","pv38:6.3":"Purato dissati maggo,","pv38:6.4":"pacchato ca na dissati.","pv38:7.1":"“Kummaggaṃ paṭipannamhā,","pv38:7.2":"yamapurisāna santike;","pv38:7.3":"Amānuso vāyati gandho,","pv38:7.4":"ghoso suyyati [sūyati (sī. syā.)] dāruṇo”.","pv38:8.1":"Saṃviggo rājā soraṭṭho,","pv38:8.2":"sārathiṃ etadabravi;","pv38:8.3":"“Kummaggaṃ paṭipannamhā,","pv38:8.4":"bhiṃsanaṃ lomahaṃsanaṃ;","pv38:8.5":"Purato dissati maggo,","pv38:8.6":"pacchato ca na dissati.","pv38:9.1":"“Kummaggaṃ paṭipannamhā,","pv38:9.2":"yamapurisāna santike;","pv38:9.3":"Amānuso vāyati gandho,","pv38:9.4":"ghoso suyyati dāruṇo”.","pv38:10.1":"Hatthikkhandhaṃ samāruyha,","pv38:10.2":"olokento catuddisaṃ [catuddissā (ka.)];","pv38:10.3":"Addasa nigrodhaṃ ramaṇīyaṃ [rukkhaṃ nigrodhaṃ (syā. ka.)],","pv38:10.4":"pādapaṃ chāyāsampannaṃ;","pv38:10.5":"Nīlabbhavaṇṇasadisaṃ,","pv38:10.6":"meghavaṇṇasirīnibhaṃ.","pv38:11.1":"Sārathiṃ āmantayī rājā,","pv38:11.2":"“kiṃ eso dissati brahā;","pv38:11.3":"Nīlabbhavaṇṇasadiso,","pv38:11.4":"meghavaṇṇasirīnibho”.","pv38:12.1":"“Nigrodho so mahārāja,","pv38:12.2":"pādapo chāyāsampanno;","pv38:12.3":"Nīlabbhavaṇṇasadiso,","pv38:12.4":"meghavaṇṇasirīnibho”.","pv38:13.1":"Tena pāyāsi soraṭṭho,","pv38:13.2":"yena so dissate brahā;","pv38:13.3":"Nīlabbhavaṇṇasadiso,","pv38:13.4":"meghavaṇṇasirīnibho.","pv38:14.1":"Hatthikkhandhato oruyha,","pv38:14.2":"rājā rukkhaṃ upāgami;","pv38:14.3":"Nisīdi rukkhamūlasmiṃ,","pv38:14.4":"sāmacco saparijjano;","pv38:14.5":"Pūraṃ pānīyasarakaṃ,","pv38:14.6":"pūve vitte ca addasa.","pv38:15.1":"Puriso ca devavaṇṇī,","pv38:15.2":"sabbābharaṇabhūsito;","pv38:15.3":"Upasaṅkamitvā rājānaṃ,","pv38:15.4":"soraṭṭhaṃ etadabravi.","pv38:16.1":"“Svāgataṃ te mahārāja,","pv38:16.2":"atho te adurāgataṃ;","pv38:16.3":"Pivatu devo pānīyaṃ,","pv38:16.4":"pūve khāda arindama”.","pv38:17.1":"Pivitvā rājā pānīyaṃ,","pv38:17.2":"sāmacco saparijjano;","pv38:17.3":"Pūve khāditvā pitvā ca,","pv38:17.4":"soraṭṭho etadabravi.","pv38:18.1":"“Devatā nusi gandhabbo,","pv38:18.2":"adu sakko purindado;","pv38:18.3":"Ajānantā taṃ pucchāma,","pv38:18.4":"kathaṃ jānemu taṃ mayan”ti.","pv38:19.1":"“Nāmhi devo na gandhabbo,","pv38:19.2":"nāpi [namhi (ka.)] sakko purindado;","pv38:19.3":"Peto ahaṃ mahārāja,","pv38:19.4":"suraṭṭhā idha māgato”ti.","pv38:20.1":"“Kiṃsīlo kiṃsamācāro,","pv38:20.2":"suraṭṭhasmiṃ pure tuvaṃ;","pv38:20.3":"Kena te brahmacariyena,","pv38:20.4":"ānubhāvo ayaṃ tavā”ti.","pv38:21.1":"“Taṃ suṇohi mahārāja,","pv38:21.2":"arindama raṭṭhavaḍḍhana;","pv38:21.3":"Amaccā pārisajjā ca,","pv38:21.4":"brāhmaṇo ca purohito.","pv38:22.1":"“Suraṭṭhasmiṃ ahaṃ deva,","pv38:22.2":"puriso pāpacetaso;","pv38:22.3":"Micchādiṭṭhi ca dussīlo,","pv38:22.4":"kadariyo paribhāsako.","pv38:23.1":"“‘Dadantānaṃ karontānaṃ,","pv38:23.2":"vārayissaṃ bahujjanaṃ;","pv38:23.3":"Aññesaṃ dadamānānaṃ,","pv38:23.4":"antarāyakaro ahaṃ.","pv38:24.1":"“‘Vipāko natthi dānassa,","pv38:24.2":"saṃyamassa kuto phalaṃ;","pv38:24.3":"Natthi ācariyo nāma,","pv38:24.4":"adantaṃ ko damessati.","pv38:25.1":"“‘Samatulyāni bhūtāni,","pv38:25.2":"kuto [kule (syā. ka.)] jeṭṭhāpacāyiko;","pv38:25.3":"Natthi balaṃ vīriyaṃ vā,","pv38:25.4":"kuto uṭṭhānaporisaṃ.","pv38:26.1":"“‘Natthi dānaphalaṃ nāma,","pv38:26.2":"na visodheti verinaṃ;","pv38:26.3":"Laddheyyaṃ labhate macco,","pv38:26.4":"niyatipariṇāmajaṃ [pariṇāmajā (sī. ka.)].","pv38:27.1":"“‘Natthi mātā pitā bhātā,","pv38:27.2":"loko natthi ito paraṃ;","pv38:27.3":"Natthi dinnaṃ natthi hutaṃ,","pv38:27.4":"sunihitaṃ na vijjati.","pv38:28.1":"“‘Yopi haneyya purisaṃ,","pv38:28.2":"parassa chindate [purisassa chinde (syā. ka.)] siraṃ;","pv38:28.3":"Na koci kañci hanati,","pv38:28.4":"sattannaṃ vivaramantare.","pv38:29.1":"“‘Acchejjābhejjo hi [bhejjo (sī.), abhejjo (syā.), bhejjāsi (ka.)] jīvo,","pv38:29.2":"aṭṭhaṃso guḷaparimaṇḍalo;","pv38:29.3":"Yojanānaṃ sataṃ pañca,","pv38:29.4":"ko jīvaṃ chettumarahati.","pv38:30.1":"“‘Yathā suttaguḷe khitte,","pv38:30.2":"nibbeṭhentaṃ palāyati;","pv38:30.3":"Evameva ca so jīvo,","pv38:30.4":"nibbeṭhento palāyati.","pv38:31.1":"“‘Yathā gāmato nikkhamma,","pv38:31.2":"aññaṃ gāmaṃ pavisati;","pv38:31.3":"Evameva ca so jīvo,","pv38:31.4":"aññaṃ bondiṃ pavisati.","pv38:32.1":"“‘Yathā gehato nikkhamma,","pv38:32.2":"aññaṃ gehaṃ pavisati;","pv38:32.3":"Evameva ca so jīvo,","pv38:32.4":"aññaṃ bondiṃ pavisati.","pv38:33.1":"“‘Cullāsīti [cuḷāsīti (sī. syā. ka.)] mahākappino [mahākappuno (sī.)],","pv38:33.2":"satasahassāni hi;","pv38:33.3":"Ye bālā ye ca paṇḍitā,","pv38:33.4":"saṃsāraṃ khepayitvāna;","pv38:33.5":"Dukkhassantaṃ karissare.","pv38:34.1":"“‘Mitāni sukhadukkhāni,","pv38:34.2":"doṇehi piṭakehi ca;","pv38:34.3":"Jino sabbaṃ pajānāti’,","pv38:34.4":"sammūḷhā itarā pajā.","pv38:35.1":"“Evaṃdiṭṭhi pure āsiṃ,","pv38:35.2":"sammūḷho mohapāruto;","pv38:35.3":"Micchādiṭṭhi ca dussīlo,","pv38:35.4":"kadariyo paribhāsako.","pv38:36.1":"“Oraṃ me chahi māsehi,","pv38:36.2":"kālaṅkiriyā bhavissati;","pv38:36.3":"Ekantakaṭukaṃ ghoraṃ,","pv38:36.4":"nirayaṃ papatissahaṃ.","pv38:37.1":"[pe. va.70]“Catukkaṇṇaṃ catudvāraṃ,","pv38:37.2":"vibhattaṃ bhāgaso mitaṃ;","pv38:37.3":"Ayopākārapariyantaṃ,","pv38:37.4":"ayasā paṭikujjitaṃ.","pv38:38.1":"[pe. va.71]“Tassa ayomayā bhūmi,","pv38:38.2":"jalitā tejasā yutā;","pv38:38.3":"Samantā yojanasataṃ,","pv38:38.4":"pharitvā tiṭṭhati sabbadā.","pv38:39.1":"“Vassāni satasahassāni,","pv38:39.2":"ghoso suyyati tāvade;","pv38:39.3":"Lakkho eso mahārāja,","pv38:39.4":"satabhāgavassakoṭiyo.","pv38:40.1":"“Koṭisatasahassāni,","pv38:40.2":"niraye paccare janā;","pv38:40.3":"Micchādiṭṭhī ca dussīlā,","pv38:40.4":"ye ca ariyūpavādino.","pv38:41.1":"“Tatthāhaṃ dīghamaddhānaṃ,","pv38:41.2":"dukkhaṃ vedissa vedanaṃ;","pv38:41.3":"Phalaṃ pāpassa kammassa,","pv38:41.4":"tasmā socāmahaṃ bhusaṃ.","pv38:42.1":"“Taṃ suṇohi mahārāja,","pv38:42.2":"arindama raṭṭhavaḍḍhana;","pv38:42.3":"Dhītā mayhaṃ mahārāja,","pv38:42.4":"uttarā bhaddamatthu te.","pv38:43.1":"“Karoti bhaddakaṃ kammaṃ,","pv38:43.2":"sīlesuposathe ratā;","pv38:43.3":"Saññatā saṃvibhāgī ca,","pv38:43.4":"vadaññū vītamaccharā.","pv38:44.1":"“Akhaṇḍakārī sikkhāya,","pv38:44.2":"suṇhā parakulesu ca;","pv38:44.3":"Upāsikā sakyamunino,","pv38:44.4":"sambuddhassa sirīmato.","pv38:45.1":"“Bhikkhu ca sīlasampanno,","pv38:45.2":"gāmaṃ piṇḍāya pāvisi;","pv38:45.3":"Okkhittacakkhu satimā,","pv38:45.4":"guttadvāro susaṃvuto.","pv38:46.1":"“Sapadānaṃ caramāno,","pv38:46.2":"agamā taṃ nivesanaṃ;","pv38:46.3":"‘Tamaddasa mahārāja,","pv38:46.4":"uttarā bhaddamatthu te’.","pv38:47.1":"“Pūraṃ pānīyasarakaṃ,","pv38:47.2":"pūve vitte ca sā adā;","pv38:47.3":"‘Pitā me kālaṅkato, bhante","pv38:47.4":"tassetaṃ upakappatu’.","pv38:48.1":"“Samanantarānuddiṭṭhe,","pv38:48.2":"vipāko udapajjatha;","pv38:48.3":"Bhuñjāmi kāmakāmīhaṃ,","pv38:48.4":"rājā vessavaṇo yathā.","pv38:49.1":"“Taṃ suṇohi mahārāja,","pv38:49.2":"arindama raṭṭhavaḍḍhana;","pv38:49.3":"Sadevakassa lokassa,","pv38:49.4":"buddho aggo pavuccati;","pv38:49.5":"Taṃ buddhaṃ saraṇaṃ gaccha,","pv38:49.6":"saputtadāro arindama.","pv38:50.1":"“Aṭṭhaṅgikena maggena,","pv38:50.2":"phusanti amataṃ padaṃ;","pv38:50.3":"Taṃ dhammaṃ saraṇaṃ gaccha,","pv38:50.4":"saputtadāro arindama.","pv38:51.1":"“Cattāro ca paṭipannā [maggapaṭipannā (sī. syā.)],","pv38:51.2":"cattāro ca phale ṭhitā;","pv38:51.3":"Esa saṅgho ujubhūto,","pv38:51.4":"paññāsīlasamāhito;","pv38:51.5":"Taṃ saṅghaṃ saraṇaṃ gaccha,","pv38:51.6":"saputtadāro arindama.","pv38:52.1":"“Pāṇātipātā viramassu khippaṃ,","pv38:52.2":"loke adinnaṃ parivajjayassu;","pv38:52.3":"Amajjapo mā ca musā abhāṇī, sakena dārena ca hohi tuṭṭho”ti. “Atthakāmosi me yakkha, hitakāmosi devate; Karomi tuyhaṃ vacanaṃ, tvaṃsi ācariyo mama. “Upemi saraṇaṃ buddhaṃ, dhammañcāpi anuttaraṃ; Saṅghañca naradevassa, gacchāmi saraṇaṃ ahaṃ. “Pāṇātipātā viramāmi khippaṃ, loke adinnaṃ parivajjayāmi; Amajjapo no ca musā bhaṇāmi, sakena dārena ca homi tuṭṭho.","pv38:56.1":"“Ophuṇāmi [opuṇāmi (sī.), ophunāmi (syā. ka.), opunāmi (?)] mahāvāte,","pv38:56.2":"nadiyā sīghagāmiyā;","pv38:56.3":"Vamāmi pāpikaṃ diṭṭhiṃ,","pv38:56.4":"buddhānaṃ sāsane rato”.","pv38:57.1":"Idaṃ vatvāna soraṭṭho,","pv38:57.2":"viramitvā pāpadassanā [pāpadassanaṃ (syā. ka.)];","pv38:57.3":"Namo bhagavato katvā,","pv38:57.4":"pāmokkho rathamāruhīti.","pv38:58.1":"Nandakapetavatthu tatiyaṃ."},"unsure":["pv38:52.3","pv38:52.4"],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":2820,"to":2846,"paras":[{"para":2820,"vripara":"658-659","refs":["pv38:1"],"lines":["658-9. Tattha <b>rājā piṅgalako nāma, suraṭṭhānaṃ adhipati ahū</b>ti piṅgalacakkhutāya “piṅgalo”ti pākaṭanāmo suraṭṭhadesassa issaro rājā ahosi.","<b>Moriyānan</b>ti moriyarājūnaṃ, dhammāsokaṃ sandhāya vadati.","<b>Suraṭṭhaṃ punarāgamā</b>ti suraṭṭhassa visayaṃ uddissa suraṭṭhagāmimaggaṃ paccāgañchi.","<b>Paṅkan</b>ti mudubhūmiṃ.","<b>Vaṇṇupathan</b>ti petena nimmitaṃ marūbhūmimaggaṃ."],"lineRefs":[["pv38:1"],["pv38:1"],["pv38:1"],["pv38:1"],["pv38:1"]]},{"para":2821,"vripara":"660","refs":["pv38:4"],"lines":["<b>Khemo</b>ti nibbhayo.","<b>Sovatthiko</b>ti sotthibhāvāvaho.","<b>Sivo</b>ti anupaddavo.","<b>Suraṭṭhānaṃ santike ito</b>ti iminā maggena gacchantā mayaṃ suraṭṭhavisayassa samīpeyeva."],"lineRefs":[["pv38:4"],["pv38:4"],["pv38:4"],["pv38:4"]]},{"para":2822,"vripara":"661-662","refs":["pv38:5"],"lines":["661-2. <b>Soraṭṭho</b>ti suraṭṭhādhipati.","<b>Ubbiggarūpo</b>ti utrastasabhāvo.","<b>Bhiṃsanan</b>ti bhayajananaṃ.","<b>Lomahaṃsanan</b>ti bhiṃsanakabhāvena lomānaṃ haṃsāpanaṃ."],"lineRefs":[["pv38:5"],["pv38:5"],["pv38:5"],["pv38:5"]]},{"para":2823,"vripara":"663","refs":["pv38:7"],"lines":["<b>Yamapurisāna santike</b>ti petānaṃ samīpe vattāma.","<b>Amānuso vāyati gandho</b>ti petānaṃ sarīragandho vāyati.","<b>Ghoso suyyati dāruṇo</b>ti paccekanirayesu kāraṇaṃ kāriyamānānaṃ sattānaṃ ghorataro saddo suyyati."],"lineRefs":[["pv38:7"],["pv38:7"],["pv38:7"]]},{"para":2824,"vripara":"666","refs":["pv38:10"],"lines":["<b>Pādapan</b>ti pādasadisehi mūlāvayavehi udakassa pivanato “pādapo”ti laddhanāmaṃ taruṃ.","<b>Chāyāsampannan</b>ti sampannacchāyaṃ.","<b>Nīlabbhavaṇṇasadisan</b>ti vaṇṇena nīlameghasadisaṃ.","<b>Meghavaṇṇasirīnibhan</b>ti meghavaṇṇasaṇṭhānaṃ hutvā khāyamānaṃ."],"lineRefs":[["pv38:10"],["pv38:10"],["pv38:10"],["pv38:10"]]},{"para":2825,"vripara":"670","refs":["pv38:14"],"lines":["<b>Pūraṃ pānīyasarakan</b>ti pānīyena puṇṇaṃ pānīyabhājanaṃ.","<b>Pūve</b>ti khajjake.","<b>Vitte</b>ti vittijanane madhure manuññe tahiṃ tahiṃ sarāve pūretvā ṭhapitapūve addasa."],"lineRefs":[["pv38:14"],["pv38:14"],["pv38:14"]]},{"para":2826,"vripara":"672","refs":["pv38:16"],"lines":["<b>Atho te adurāgatan</b>ti ettha <b>atho</b>ti nipātamattaṃ, avadhāraṇatthe vā, mahārāja, te āgataṃ durāgataṃ na hoti, atha kho svāgatamevāti mayaṃ sampaṭicchāmāti attho.","<b>Arindamā</b>ti arīnaṃ damanasīla."],"lineRefs":[["pv38:16"],["pv38:16"]]},{"para":2827,"vripara":"677","refs":["pv38:21"],"lines":["<b>Amaccā pārisajjā</b>ti amaccā pārisajjā ca vacanaṃ suṇantu, brāhmaṇo ca tuyhaṃ purohito taṃ suṇātūti yojanā."],"lineRefs":[["pv38:21"]]},{"para":2828,"vripara":"678","refs":["pv38:22"],"lines":["<b>Suraṭṭhasmiṃ ahan</b>ti suraṭṭhadese ahaṃ.","<b>Devā</b>ti rājānaṃ ālapati.","<b>Micchādiṭṭhī</b>ti natthikadiṭṭhiyā viparītadassano.","<b>Dussīlo</b>ti nissīlo.","<b>Kadariyo</b>ti thaddhamaccharī.","<b>Paribhāsako</b>ti samaṇabrāhmaṇānaṃ akkosako."],"lineRefs":[["pv38:22"],["pv38:22"],["pv38:22"],["pv38:22"],["pv38:22"],["pv38:22"]]},{"para":2829,"vripara":"679","refs":["pv38:23"],"lines":["<b>Vārayissan</b>ti vāresiṃ.","<b>Antarāyakaro ahan</b>ti dānaṃ dadantānaṃ upakāraṃ karontānaṃ antarāyakaro hutvā aññesañca paresaṃ dānaṃ dadamānānaṃ dānamayapuññato ahaṃ bahujanaṃ vārayissaṃ vāresinti yojanā."],"lineRefs":[["pv38:23"],["pv38:23"]]},{"para":2830,"vripara":"680","refs":["pv38:24"],"lines":["<b>Vipāko natthi dānassā</b>tiādi vāritākāradassanaṃ.","Tattha <b>vipāko natthi dānassā</b>ti dānaṃ dadato tassa vipāko āyatiṃ pattabbaphalaṃ natthīti vipākaṃ paṭibāhati.","<b>Saṃyamassa kuto phalan</b>ti sīlassa pana kuto nāma phalaṃ, sabbena sabbaṃ taṃ natthīti adhippāyo.","<b>Natthi ācariyo nāmā</b>ti ācārasamācārasikkhāpako ācariyo nāma koci natthi.","Sabhāvato eva hi sattā dantā vā adantā vā hontīti adhippāyo.","Tenāha <b>“adantaṃ ko damessatī”</b>ti."],"lineRefs":[["pv38:24"],["pv38:24"],["pv38:24"],["pv38:24"],["pv38:24"],["pv38:24"]]},{"para":2831,"vripara":"681","refs":["pv38:25"],"lines":["<b>Samatulyāni bhūtānī</b>ti ime sattā sabbepi aññamaññaṃ samasamā, tasmā jeṭṭho eva natthi, kuto jeṭṭhāpacāyiko, jeṭṭhāpacāyanapuññaṃ nāma natthīti attho.","<b>Natthi balan</b>ti yamhi attano bale patiṭṭhitā sattā vīriyaṃ katvā manussasobhagyataṃ ādiṃ katvā yāvaarahattaṃ sampattiyo pāpuṇanti, taṃ vīriyabalaṃ paṭikkhipati.","<b>Vīriyaṃ vā natthi kuto uṭṭhānaporisan</b>ti idaṃ no purisavīriyena purisakārena pavattanti evaṃ pavattavādapaṭikkhepavasena vuttaṃ."],"lineRefs":[["pv38:25"],["pv38:25"],["pv38:25"]]},{"para":2832,"vripara":"682","refs":["pv38:26"],"lines":["<b>Natthi dānaphalaṃ nāmā</b>ti dānassa phalaṃ nāma kiñci natthi, deyyadhammapariccāgo bhasmanihitaṃ viya nipphalo evāti attho.","<b>Na visodheti verinan</b>ti ettha <b>verinan</b>ti veravantaṃ verānaṃ vasena pāṇātipātādīnaṃ vasena ca katapāpaṃ puggalaṃ dānasīlādivatato na visodheti, kadācipi suddhaṃ na karoti.","Pubbe “vipāko natthi dānassā”tiādi dānādito attano paresaṃ nivāritākāradassanaṃ,“natthi dānaphalaṃ nāmā”tiādi pana atthano micchābhinivesadassananti daṭṭhabbaṃ.","<b>Laddheyyan</b>ti laddhabbaṃ.","Kathaṃ pana laddhabbanti āha <b>“niyatipariṇāmajan”</b>ti.","Ayaṃ satto sukhaṃ vā dukkhaṃ vā labhanto niyativipariṇāmavaseneva labhati, na kammassa katattā, na issarādinā cāti adhippāyo."],"lineRefs":[["pv38:26"],["pv38:26"],["pv38:26"],["pv38:26"],["pv38:26"],["pv38:26"]]},{"para":2833,"vripara":"683","refs":["pv38:27"],"lines":["<b>Natthi mātā pitā bhātā</b>ti mātādīsu sammāpaṭipattimicchāpaṭipattīnaṃ phalābhāvaṃ sandhāya vadati.","<b>Loko natthi ito paran</b>ti ito idhalokato paraloko nāma koci natthi, tattha tattheva sattā ucchijjantīti adhippāyo.","<b>Dinnan</b>ti mahādānaṃ.","<b>Hutan</b>ti pahenakasakkāro, tadubhayampi phalābhāvaṃ sandhāya “natthī”ti paṭikkhipati.","<b>Sunihitan</b>ti suṭṭhu nihitaṃ.","<b>Na vijjatī</b>ti yaṃ samaṇabrāhmaṇānaṃ dānaṃ nāma “anugāmikanidhī”ti vadanti, taṃ na vijjati.","Tesaṃ taṃ vācāvatthumattamevāti adhippāyo."],"lineRefs":[["pv38:27"],["pv38:27"],["pv38:27"],["pv38:27"],["pv38:27"],["pv38:27"],["pv38:27"]]},{"para":2834,"vripara":"684","refs":["pv38:28"],"lines":["<b>Na koci kañci hanatī</b>ti yo puriso paraṃ purisaṃ haneyya, parassa purisassa sīsaṃ chindeyya, tattha paramatthato na koci kañci hanati, sattannaṃ kāyānaṃ chiddabhāvato hananto viya hoti.","Kathaṃ satthapahāroti āha <b>“sattannaṃ vivaramantare”</b>ti.","Pathavīādīnaṃ sattannaṃ kāyānaṃ vivarabhūte antare chidde satthaṃ pavisati, tena sattā asiādīhi pahatā viya honti, jīvo viya pana sesakāyāpi niccasabhāvattā na chijjantīti adhippāyo."],"lineRefs":[["pv38:28"],["pv38:28"],["pv38:28"]]},{"para":2835,"vripara":"685","refs":["pv38:29"],"lines":["<b>Acchejjābhejjo hi jīvo</b>ti ayaṃ sattānaṃ jīvo satthādīhi na chinditabbo na bhinditabbo niccasabhāvattā.","<b>Aṭṭhaṃso guḷaparimaṇḍalo</b>ti so pana jīvo kadāci aṭṭhaṃso hoti kadāci guḷaparimaṇḍalo.","<b>Yojanānaṃ sataṃ pañcā</b>ti kevalībhāvaṃ patto pañcayojanasatubbedho hoti.","<b>Ko jīvaṃ chettumarahatī</b>ti niccaṃ nibbikāraṃ jīvaṃ ko nāma satthādīhi chindituṃ arahati, na so kenaci vikopaneyyoti vadati."],"lineRefs":[["pv38:29"],["pv38:29"],["pv38:29"],["pv38:29"]]},{"para":2836,"vripara":"686","refs":["pv38:30"],"lines":["<b>Suttaguḷe</b>ti veṭhetvā katasuttaguḷe.","<b>Khitte</b>ti nibbeṭhanavasena khitte.","<b>Nibbeṭhentaṃ palāyatī</b>ti pabbate vā rukkhagge vā ṭhatvā nibbeṭhiyamānaṃ khittaṃ suttaguḷaṃ nibbeṭhentameva gacchati, sutte khīṇe na gacchati.","<b>Evamevan</b>ti yathā taṃ suttaguḷaṃ nibbeṭhiyamānaṃ gacchati, sutte khīṇe na gacchati, evameva so jīvo “cullāsīti mahākappino satasahassānī”ti vuttakālameva attabhāvaguḷaṃ nibbeṭhento palāyati pavattati, tato uddhaṃ na pavattati."],"lineRefs":[["pv38:30"],["pv38:30"],["pv38:30"],["pv38:30"]]},{"para":2837,"vripara":"687","refs":["pv38:31"],"lines":["<b>Evameva ca so jīvo</b>ti yathā koci puriso attano nivāsagāmato nikkhamitvā tato aññaṃ gāmaṃ pavisati kenacideva karaṇīyena, evameva so jīvo ito sarīrato nikkhamitvā aññaṃ aparaṃ sarīraṃ niyatavasena pavisatīti adhippāyo.","<b>Bondin</b>ti kāyaṃ."],"lineRefs":[["pv38:31"],["pv38:31"]]},{"para":2838,"vripara":"689","refs":["pv38:33"],"lines":["<b>Cullāsītī</b>ti caturāsīti.","<b>Mahākappino</b>ti mahākappānaṃ.","Tattha “ekamhā mahāsarā anotattādito vassasate vassasate kusaggena ekekaṃ udakabinduṃ nīharante iminā upakkamena sattakkhattuṃ tamhi sare nirudake jāte eko mahākappo nāma hotī”ti vatvā “evarūpānaṃ mahākappānaṃ caturāsītisatasahassāni saṃsārassa parimāṇan”ti vadanti.","<b>Ye bālā ye ca paṇḍitā</b>ti ye andhabālā, ye ca sappaññā, sabbepi te.","<b>Saṃsāraṃ khepayitvānā</b>ti yathāvuttakālaparicchedaṃ saṃsāraṃ aparāparuppattivasena khepetvā.","<b>Dukkhassantaṃ karissare</b>ti vaṭṭadukkhassa pariyantaṃ pariyosānaṃ karissanti.","Paṇḍitāpi antarā sujjhituṃ na sakkonti, bālāpi tato uddhaṃ nappavattantīti tassa laddhi."],"lineRefs":[["pv38:33"],["pv38:33"],["pv38:33"],["pv38:33"],["pv38:33"],["pv38:33"],["pv38:33"]]},{"para":2839,"vripara":"690","refs":["pv38:34"],"lines":["<b>Mitāni</b> sukhadukkhāni, doṇehi piṭakehi <b>cā</b>ti sattānaṃ sukhadukkhāni nāma doṇehi piṭakehi mānabhājanehi mitāni viya yathāvuttakālaparicchedeneva parimitattā paccekañca tesaṃ tesaṃ sattānaṃ tāni niyatipariṇāmajāni parimitāni.","Tayidaṃ <b>jino sabbaṃ pajānāti</b> jinabhūmiyaṃ ṭhito kevalaṃ pajānāti saṃsārassa samatikkantattā.","Saṃsāre pana paribbhamati sammūḷhāyaṃ <b>itarā pajā</b>."],"lineRefs":[["pv38:34"],["pv38:34"],["pv38:34"]]},{"para":2840,"vripara":"691","refs":["pv38:35"],"lines":["<b>Evaṃdiṭṭhi pure āsin</b>ti yathāvuttanatthikadiṭṭhiko pubbeva ahaṃ ahosiṃ.","<b>Sammūḷho mohapāruto</b>ti yathāvuttāya diṭṭhiyā hetubhūtena sammohena sammūḷho, taṃsahajātena pana mohena pāruto, paṭicchāditakusalabījoti adhippāyo."],"lineRefs":[["pv38:35"],["pv38:35"]]},{"para":2841,"vripara":"692","refs":["pv38:36"],"lines":["Evaṃ pubbe yā attano uppannā pāpadiṭṭhi, tassā vasena kataṃ pāpakammaṃ dassetvā idāni attanā āyatiṃ anubhavitabbaṃ tassa phalaṃ dassento <b>“oraṃ me chahi māsehī”</b>tiādimāha."],"lineRefs":[["pv38:36"]]},{"para":2842,"vripara":"695-697","refs":["pv38:39"],"lines":["695-7. Tattha <b>vassāni satasahassānī</b>ti vassānaṃ satasahassāni, atikkamitvāti vacanaseso.","Bhummatthe vā etaṃ paccattavacanaṃ, vassesu satasahassesu vītivattesūti attho.","<b>Ghoso suyyati tāvade</b>ti yadā ettako kālo atikkanto hoti, tāvadeva tasmiṃ kāle “idha paccantānaṃ vo mārisā vassasatasahassaparimāṇo kālo atīto”ti evaṃ tasmiṃ niraye saddo suyyati.","<b>Lakkho eso, mahārāja, satabhāgavassakoṭiyo</b>ti satabhāgā satakoṭṭhāsā vassakoṭiyo, mahārāja, niraye paccantānaṃ sattānaṃ āyuno eso lakkho eso paricchedoti attho.","Idaṃ vuttaṃ hoti – dasadasakaṃ sataṃ nāma, dasa satāni sahassaṃ nāma, dasadasasahassāni satasahassaṃ nāma, satasatasahassāni koṭi nāma, tāsaṃ koṭīnaṃ vasena satasahassavassakoṭiyo satabhāgā vassakoṭiyo.","Sā ca kho nerayikānaṃyeva vassagaṇanāvasena veditabbā, na manussānaṃ, devānaṃ vā.","Īdisāni anekāni vassakoṭisatasahassāni nerayikānaṃ āyu.","Tenāha <b>“koṭisatasahassāni, niraye paccare janā”</b>ti.","Yādisena pana pāpena sattā evaṃ nirayesu paccanti, taṃ nigamanavasena dassetuṃ <b>“micchādiṭṭhī ca dussīlā, ye ca ariyūpavādino”</b>ti vuttaṃ.","<b>Vedissan</b>ti anubhavissaṃ."],"lineRefs":[["pv38:39"],["pv38:39"],["pv38:39"],["pv38:39"],["pv38:39"],["pv38:39"],["pv38:39"],["pv38:39"],["pv38:39"],["pv38:39"]]},{"para":2843,"vripara":"698-706","refs":["pv38:42"],"lines":["698-706. Evaṃ āyatiṃ attanā anubhavitabbaṃ pāpaphalaṃ dassetvā idāni “kena te brahmacariyena, ānubhāvo ayaṃ tavā”ti raññā pucchitamatthaṃ ācikkhitvā taṃ saraṇesu ceva sīlesu ca patiṭṭhāpetukāmo <b>“taṃ suṇohi mahārājā”</b>tiādimāha.","Tattha <b>sīlesuposathe ratā</b>ti niccasīlesu ca uposathasīlesu ca abhiratā.","<b>Adā</b>ti adāsi.","<b>Taṃ dhamman</b>ti taṃ aṭṭhaṅgikaṃ maggaṃ amatapadañca."],"lineRefs":[["pv38:42"],["pv38:42"],["pv38:42"],["pv38:42"]]},{"para":2844,"vripara":"709-712","refs":["pv38:52"],"lines":["709-12. Evaṃ petena saraṇesu sīlesu ca samādapito rājā pasannamānaso tena attano kataṃ upakāraṃ tāva kittetvā saraṇādīsu patiṭṭhahanto <b>“atthakāmo”</b>tiādikā tisso gāthā vatvā pubbe attanā gahitāya pāpikāya diṭṭhiyā paṭinissaṭṭhabhāvaṃ pakāsento <b>“ophuṇāmī”</b>ti gāthamāha."],"lineRefs":[["pv38:52"]]},{"para":2845,"vripara":null,"refs":["pv38:52"],"lines":["Tattha <b>ophuṇāmi mahāvāte</b>ti mahante vāte vāyante bhusaṃ viya taṃ pāpakaṃ diṭṭhiṃ, yakkha, tava dhammadesanāvāte ophuṇāmi niddhunāmi.","<b>Nadiyā vā sīghagāmiyā</b>ti sīghasotāya mahānadiyā vā tiṇakaṭṭhapaṇṇakasaṭaṃ viya pāpikaṃ diṭṭhiṃ pavāhemīti adhippāyo.","<b>Vamāmi pāpikaṃ diṭṭhin</b>ti mama manomukhagataṃ pāpikaṃ diṭṭhiṃ ucchaḍḍayāmi.","Tattha kāraṇamāha <b>“buddhānaṃ sāsane rato”ti.</b>","Yasmā ekaṃsena amatāvahe buddhānaṃ bhagavantānaṃ sāsane rato abhirato, tasmā taṃ diṭṭhisaṅkhātaṃ visaṃ vamāmīti yojanā."],"lineRefs":[["pv38:52"],["pv38:52"],["pv38:52"],["pv38:52"],["pv38:52"]]},{"para":2846,"vripara":"713","refs":["pv38:52","pv38:57"],"lines":["Ti osānagāthā saṅgītikārehi ṭhapitā.","Tattha <b>pāmokkho</b>ti pācīnadisābhimukho hutvā.","<b>Rathamāruhī</b>ti rājā gamanasajjaṃ attano rājarathaṃ abhiruhi, āruyha yakkhānubhāvena taṃ divasameva attano nagaraṃ patvā rājabhavanaṃ pāvisi.","So aparena samayena imaṃ pavattiṃ bhikkhūnaṃ ārocesi, bhikkhū taṃ therānaṃ ārocesuṃ, therā tatiyasaṅgītiyaṃ saṅgahaṃ āropesuṃ."],"lineRefs":[["pv38:52"],["pv38:57"],["pv38:57"],["pv38:57"]]}],"wordLinks":[["pv38:1.1","rājā piṅgalako nāma suraṭṭhānaṃ adhipati ahū",0,0],["pv38:1.3","moriyānaṃ",0,1],["pv38:1.3","suraṭṭhaṃ punarāgamā",0,2],["pv38:4.1","khemo",1,0],["pv38:4.1","sovatthiko",1,1],["pv38:4.1","sivo",1,2],["pv38:4.3","suraṭṭhānaṃ santike ito",1,3],["pv38:5.1","soraṭṭho",2,0],["pv38:5.3","soraṭṭho",2,0],["pv38:5.3","ubbiggarūpo",2,1],["pv38:7.1","yamapurisāna santike",3,0],["pv38:7.3","amānuso vāyati gandho",3,1],["pv38:7.3","ghoso suyyati dāruṇo",3,2],["pv38:10.3","pādapaṃ",4,0],["pv38:10.3","chāyāsampannaṃ",4,1],["pv38:10.5","nīlabbhavaṇṇasadisaṃ",4,2],["pv38:10.5","meghavaṇṇasirīnibhaṃ",4,3],["pv38:14.5","pūraṃ pānīyasarakaṃ",5,0],["pv38:14.5","pūve",5,1],["pv38:14.5","vitte",5,2],["pv38:16.1","atho",6,0],["pv38:16.1","atho te adurāgataṃ",6,0],["pv38:16.3","arindamā",6,1],["pv38:21.3","amaccā pārisajjā",7,0],["pv38:22.1","suraṭṭhasmiṃ ahaṃ",8,0],["pv38:22.1","devā",8,1],["pv38:22.3","micchādiṭṭhī",8,2],["pv38:22.3","dussīlo",8,3],["pv38:22.3","kadariyo",8,4],["pv38:22.3","paribhāsako",8,5],["pv38:23.1","vārayissaṃ",9,0],["pv38:23.3","antarāyakaro ahaṃ",9,1],["pv38:24.1","vipāko natthi dānassā",10,0],["pv38:24.1","vipāko natthi dānassā",10,1],["pv38:24.1","saṃyamassa kuto phalaṃ",10,2],["pv38:24.3","natthi ācariyo nāmā",10,3],["pv38:24.3","adantaṃ ko damessatī",10,5],["pv38:25.1","samatulyāni bhūtānī",11,0],["pv38:25.3","natthi balaṃ",11,1],["pv38:26.1","natthi dānaphalaṃ nāmā",12,0],["pv38:26.1","na visodheti verinaṃ",12,1],["pv38:26.1","verinaṃ",12,1],["pv38:26.3","laddheyyaṃ",12,3],["pv38:26.3","niyatipariṇāmajaṃ",12,4],["pv38:27.1","natthi mātā pitā bhātā",13,0],["pv38:27.1","loko natthi ito paraṃ",13,1],["pv38:27.3","dinnaṃ",13,2],["pv38:27.3","hutaṃ",13,3],["pv38:27.3","sunihitaṃ",13,4],["pv38:27.3","na vijjatī",13,5],["pv38:28.3","na koci kañci hanatī",14,0],["pv38:28.3","sattannaṃ vivaramantare",14,1],["pv38:29.1","acchejjābhejjo hi jīvo",15,0],["pv38:29.1","aṭṭhaṃso guḷaparimaṇḍalo",15,1],["pv38:29.3","yojanānaṃ sataṃ pañcā",15,2],["pv38:29.3","ko jīvaṃ chettumarahatī",15,3],["pv38:30.1","suttaguḷe",16,0],["pv38:30.1","khitte",16,1],["pv38:30.1","nibbeṭhentaṃ palāyatī",16,2],["pv38:30.3","evamevaṃ",16,3],["pv38:31.3","evameva ca so jīvo",17,0],["pv38:31.3","bondiṃ",17,1],["pv38:33.1","cullāsītī",18,0],["pv38:33.1","mahākappino",18,1],["pv38:33.3","ye bālā ye ca paṇḍitā",18,3],["pv38:33.3","saṃsāraṃ khepayitvānā",18,4],["pv38:33.5","dukkhassantaṃ karissare",18,5],["pv38:34.1","cā",19,0],["pv38:34.1","mitāni",19,0],["pv38:34.3","jino sabbaṃ pajānāti",19,1],["pv38:34.3","itarā pajā",19,2],["pv38:35.1","evaṃdiṭṭhi pure āsiṃ",20,0],["pv38:35.1","sammūḷho mohapāruto",20,1],["pv38:36.1","oraṃ me chahi māsehī",21,0],["pv38:39.1","vassāni satasahassānī",22,0],["pv38:39.1","ghoso suyyati tāvade",22,2],["pv38:39.3","lakkho eso mahārāja satabhāgavassakoṭiyo",22,3],["pv38:42.1","taṃ suṇohi mahārājā",23,0],["pv38:52.3","atthakāmo",24,0],["pv38:57.3","pāmokkho",26,1],["pv38:57.3","rathamāruhī",26,2]],"before":[{"para":2647,"vripara":"658","refs":[],"lines":["“Rājā piṅgalako nāma, suraṭṭhānaṃ adhipati ahu;"],"lineRefs":[[]]},{"para":2648,"vripara":null,"refs":[],"lines":["Moriyānaṃ upaṭṭhānaṃ gantvā, suraṭṭhaṃ punarāgamā."],"lineRefs":[[]]},{"para":2650,"vripara":"659","refs":[],"lines":["“Uṇhe majjhanhike kāle, rājā paṅkaṃ upāgami;"],"lineRefs":[[]]},{"para":2651,"vripara":null,"refs":[],"lines":["Addasa maggaṃ ramaṇīyaṃ, petānaṃ taṃ vaṇṇupathaṃ."],"lineRefs":[[]]},{"para":2652,"vripara":"660","refs":[],"lines":["Sārathiṃ āmantayī rājā –"],"lineRefs":[[]]},{"para":2653,"vripara":null,"refs":[],"lines":["“‘Ayaṃ maggo ramaṇīyo, khemo sovatthiko sivo;"],"lineRefs":[[]]},{"para":2654,"vripara":null,"refs":[],"lines":["Iminā sārathi yāma, suraṭṭhānaṃ santike ito’."],"lineRefs":[[]]},{"para":2656,"vripara":"661","refs":[],"lines":["“Tena pāyāsi soraṭṭho, senāya caturaṅginiyā;"],"lineRefs":[[]]},{"para":2657,"vripara":null,"refs":[],"lines":["Ubbiggarūpo puriso, soraṭṭhaṃ etadabravi."],"lineRefs":[[]]},{"para":2659,"vripara":"662","refs":[],"lines":["“‘Kummaggaṃ paṭipannamhā, bhiṃsanaṃ lomahaṃsanaṃ;"],"lineRefs":[[]]},{"para":2660,"vripara":null,"refs":[],"lines":["Purato dissati maggo, pacchato ca na dissati."],"lineRefs":[[]]},{"para":2662,"vripara":"663","refs":[],"lines":["“‘Kummaggaṃ paṭipannamhā, yamapurisāna santike;"],"lineRefs":[[]]},{"para":2663,"vripara":null,"refs":[],"lines":["Amānuso vāyati gandho, ghoso suyyati dāruṇo’."],"lineRefs":[[]]},{"para":2665,"vripara":"664","refs":[],"lines":["“Saṃviggo rājā soraṭṭho, sārathiṃ etadabravi;"],"lineRefs":[[]]},{"para":2666,"vripara":null,"refs":[],"lines":["‘Kummaggaṃ paṭipannamhā, bhiṃsanaṃ lomahaṃsanaṃ;"],"lineRefs":[[]]},{"para":2667,"vripara":null,"refs":[],"lines":["Purato dissati maggo, pacchato ca na dissati."],"lineRefs":[[]]},{"para":2669,"vripara":"665","refs":[],"lines":["“‘Kummaggaṃ paṭipannamhā, yamapurisāna santike;"],"lineRefs":[[]]},{"para":2670,"vripara":null,"refs":[],"lines":["Amānuso vāyati gandho, ghoso suyyati dāruṇo’."],"lineRefs":[[]]},{"para":2672,"vripara":"666","refs":[],"lines":["“Hatthikkhandhaṃ samāruyha, olokento catuddisā;"],"lineRefs":[[]]},{"para":2673,"vripara":null,"refs":[],"lines":["Addasa nigrodhaṃ ramaṇīyaṃ, pādapaṃ chāyāsampannaṃ;"],"lineRefs":[[]]},{"para":2674,"vripara":null,"refs":[],"lines":["Nīlabbhavaṇṇasadisaṃ, meghavaṇṇasirīnibhaṃ."],"lineRefs":[[]]},{"para":2676,"vripara":"667","refs":[],"lines":["“Sārathiṃ āmantayī rājā,‘kiṃ eso dissati brahā;"],"lineRefs":[[]]},{"para":2677,"vripara":null,"refs":[],"lines":["Nīlabbhavaṇṇasadiso, meghavaṇṇasirīnibho’."],"lineRefs":[[]]},{"para":2679,"vripara":"668","refs":[],"lines":["“Nigrodho so mahārāja, pādapo chāyāsampanno;"],"lineRefs":[[]]},{"para":2680,"vripara":null,"refs":[],"lines":["Nīlabbhavaṇṇasadiso, meghavaṇṇasirīnibho."],"lineRefs":[[]]},{"para":2682,"vripara":"669","refs":[],"lines":["“Tena pāyāsi soraṭṭho, yena so dissate brahā;"],"lineRefs":[[]]},{"para":2683,"vripara":null,"refs":[],"lines":["Nīlabbhavaṇṇasadiso, meghavaṇṇasirīnibho."],"lineRefs":[[]]},{"para":2685,"vripara":"670","refs":[],"lines":["“Hatthikkhandhato oruyha, rājā rukkhaṃ upāgami;"],"lineRefs":[[]]},{"para":2686,"vripara":null,"refs":[],"lines":["Nisīdi rukkhamūlasmiṃ, sāmacco saparijjano;"],"lineRefs":[[]]},{"para":2687,"vripara":null,"refs":[],"lines":["Pūraṃ pānīyasarakaṃ, pūve vitte ca addasa."],"lineRefs":[[]]},{"para":2689,"vripara":"671","refs":[],"lines":["“Puriso ca devavaṇṇī, sabbābharaṇabhūsito;"],"lineRefs":[[]]},{"para":2690,"vripara":null,"refs":[],"lines":["Upasaṅkamitvā rājānaṃ, soraṭṭhaṃ etadabravi."],"lineRefs":[[]]},{"para":2692,"vripara":"672","refs":[],"lines":["“‘Svāgataṃ te mahārāja, atho te adurāgataṃ;"],"lineRefs":[[]]},{"para":2693,"vripara":null,"refs":[],"lines":["Pivatu devo pānīyaṃ, pūve khāda arindama’."],"lineRefs":[[]]},{"para":2695,"vripara":"673","refs":[],"lines":["“Pivitvā rājā pānīyaṃ, sāmacco saparijjano;"],"lineRefs":[[]]},{"para":2696,"vripara":null,"refs":[],"lines":["Pūve khāditvā pitvā ca, soraṭṭho etadabravi."],"lineRefs":[[]]},{"para":2698,"vripara":"674","refs":[],"lines":["“Devatā nusi gandhabbo, adu sakko purindado;"],"lineRefs":[[]]},{"para":2699,"vripara":null,"refs":[],"lines":["Ajānantā taṃ pucchāma, kathaṃ jānemu taṃ mayanti."],"lineRefs":[[]]},{"para":2701,"vripara":"675","refs":[],"lines":["“Nāmhi devo na gandhabbo, nāpi sakko purindado;"],"lineRefs":[[]]},{"para":2702,"vripara":null,"refs":[],"lines":["Peto ahaṃ mahārāja, suraṭṭhā idha māgatoti."],"lineRefs":[[]]},{"para":2704,"vripara":"676","refs":[],"lines":["“Kiṃsīlo kiṃsamācāro, suraṭṭhasmiṃ pure tuvaṃ;"],"lineRefs":[[]]},{"para":2705,"vripara":null,"refs":[],"lines":["Kena te brahmacariyena, ānubhāvo ayaṃ tavāti."],"lineRefs":[[]]},{"para":2707,"vripara":"677","refs":[],"lines":["“Taṃ suṇohi mahārāja, arindama raṭṭhavaḍḍhana;"],"lineRefs":[[]]},{"para":2708,"vripara":null,"refs":[],"lines":["Amaccā pārisajjā ca, brāhmaṇo ca purohito."],"lineRefs":[[]]},{"para":2710,"vripara":"678","refs":[],"lines":["“Suraṭṭhasmiṃ ahaṃ deva, puriso pāpacetaso;"],"lineRefs":[[]]},{"para":2711,"vripara":null,"refs":[],"lines":["Micchādiṭṭhi ca dussīlo, kadariyo paribhāsako."],"lineRefs":[[]]},{"para":2713,"vripara":"679","refs":[],"lines":["“Dadantānaṃ karontānaṃ, vārayissaṃ bahujjanaṃ;"],"lineRefs":[[]]},{"para":2714,"vripara":null,"refs":[],"lines":["Aññesaṃ dadamānānaṃ, antarāyakaro ahaṃ."],"lineRefs":[[]]},{"para":2716,"vripara":"680","refs":[],"lines":["“Vipāko natthi dānassa, saṃyamassa kuto phalaṃ;"],"lineRefs":[[]]},{"para":2717,"vripara":null,"refs":[],"lines":["Natthi ācariyo nāma, adantaṃ ko damessati."],"lineRefs":[[]]},{"para":2719,"vripara":"681","refs":[],"lines":["“Samatulyāni bhūtāni, kuto jeṭṭhāpacāyiko;"],"lineRefs":[[]]},{"para":2720,"vripara":null,"refs":[],"lines":["Natthi balaṃ vīriyaṃ vā, kuto uṭṭhānaporisaṃ."],"lineRefs":[[]]},{"para":2722,"vripara":"682","refs":[],"lines":["“Natthi dānaphalaṃ nāma, na visodheti verinaṃ;"],"lineRefs":[[]]},{"para":2723,"vripara":null,"refs":[],"lines":["Laddheyyaṃ labhate macco, niyatipariṇāmajaṃ."],"lineRefs":[[]]},{"para":2725,"vripara":"683","refs":[],"lines":["“Natthi mātā pitā bhātā, loko natthi ito paraṃ;"],"lineRefs":[[]]},{"para":2726,"vripara":null,"refs":[],"lines":["Natthi dinnaṃ natthi hutaṃ, sunihitaṃ na vijjati."],"lineRefs":[[]]},{"para":2728,"vripara":"684","refs":[],"lines":["“Yopi haneyya purisaṃ, parassa chindate siraṃ;"],"lineRefs":[[]]},{"para":2729,"vripara":null,"refs":[],"lines":["Na koci kañci hanati, sattannaṃ vivaramantare."],"lineRefs":[[]]},{"para":2731,"vripara":"685","refs":[],"lines":["“Acchejjābhejjo hi jīvo, aṭṭhaṃso guḷaparimaṇḍalo;"],"lineRefs":[[]]},{"para":2732,"vripara":null,"refs":[],"lines":["Yojanānaṃ sataṃ pañca, ko jīvaṃ chettumarahati."],"lineRefs":[[]]},{"para":2734,"vripara":"686","refs":[],"lines":["“Yathā suttaguḷe khitte, nibbeṭhentaṃ palāyati;"],"lineRefs":[[]]},{"para":2735,"vripara":null,"refs":[],"lines":["Evameva ca so jīvo, nibbeṭhento palāyati."],"lineRefs":[[]]},{"para":2737,"vripara":"687","refs":[],"lines":["“Yathā gāmato nikkhamma, aññaṃ gāmaṃ pavisati;"],"lineRefs":[[]]},{"para":2738,"vripara":null,"refs":[],"lines":["Evameva ca so jīvo, aññaṃ bondiṃ pavisati."],"lineRefs":[[]]},{"para":2740,"vripara":"688","refs":[],"lines":["“Yathā gehato nikkhamma, aññaṃ gehaṃ pavisati;"],"lineRefs":[[]]},{"para":2741,"vripara":null,"refs":[],"lines":["Evameva ca so jīvo, aññaṃ bondiṃ pavisati."],"lineRefs":[[]]},{"para":2743,"vripara":"689","refs":[],"lines":["“Cullāsīti mahākappino, satasahassāni hi;"],"lineRefs":[[]]},{"para":2744,"vripara":null,"refs":[],"lines":["Ye bālā ye ca paṇḍitā, saṃsāraṃ khepayitvāna;"],"lineRefs":[[]]},{"para":2745,"vripara":null,"refs":[],"lines":["Dukkhassantaṃ karissare."],"lineRefs":[[]]},{"para":2747,"vripara":"690","refs":[],"lines":["“Mitāni sukhadukkhāni, doṇehi piṭakehi ca;"],"lineRefs":[[]]},{"para":2748,"vripara":null,"refs":[],"lines":["Jino sabbaṃ pajānāti, sammūḷhā itarā pajā."],"lineRefs":[[]]},{"para":2750,"vripara":"691","refs":[],"lines":["“Evaṃdiṭṭhi pure āsiṃ, sammūḷho mohapāruto;"],"lineRefs":[[]]},{"para":2751,"vripara":null,"refs":[],"lines":["Micchādiṭṭhi ca dussīlo, kadariyo paribhāsako."],"lineRefs":[[]]},{"para":2753,"vripara":"692","refs":[],"lines":["“Oraṃ me chahi māsehi, kālakiriyā bhavissati;"],"lineRefs":[[]]},{"para":2754,"vripara":null,"refs":[],"lines":["Ekantakaṭukaṃ ghoraṃ, nirayaṃ papatissahaṃ."],"lineRefs":[[]]},{"para":2756,"vripara":"693","refs":[],"lines":["“Catukkaṇṇaṃ catudvāraṃ, vibhattaṃ bhāgaso mitaṃ;"],"lineRefs":[[]]},{"para":2757,"vripara":null,"refs":[],"lines":["Ayopākārapariyantaṃ, ayasā paṭikujjitaṃ."],"lineRefs":[[]]},{"para":2759,"vripara":"694","refs":[],"lines":["“Tassa ayomayā bhūmi, jalitā tejasā yutā;"],"lineRefs":[[]]},{"para":2760,"vripara":null,"refs":[],"lines":["Samantā yojanasataṃ, pharitvā tiṭṭhati sabbadā."],"lineRefs":[[]]},{"para":2762,"vripara":"695","refs":[],"lines":["“Vassāni satasahassāni, ghoso suyyati tāvade;"],"lineRefs":[[]]},{"para":2763,"vripara":null,"refs":[],"lines":["Lakkho eso mahārāja, satabhāgavassakoṭiyo."],"lineRefs":[[]]},{"para":2765,"vripara":"696","refs":[],"lines":["“Koṭisatasahassāni, niraye paccare janā;"],"lineRefs":[[]]},{"para":2766,"vripara":null,"refs":[],"lines":["Micchādiṭṭhī ca dussīlā, ye ca ariyūpavādino."],"lineRefs":[[]]},{"para":2768,"vripara":"697","refs":[],"lines":["“Tatthāhaṃ dīghamaddhānaṃ, dukkhaṃ vedissa vedanaṃ;"],"lineRefs":[[]]},{"para":2769,"vripara":null,"refs":[],"lines":["Phalaṃ pāpassa kammassa, tasmā socāmahaṃ bhusaṃ."],"lineRefs":[[]]},{"para":2771,"vripara":"698","refs":[],"lines":["“Taṃ suṇohi mahārāja, arindama raṭṭhavaḍḍhana;"],"lineRefs":[[]]},{"para":2772,"vripara":null,"refs":[],"lines":["Dhītā mayhaṃ mahārāja, uttarā bhaddamatthu te."],"lineRefs":[[]]},{"para":2774,"vripara":"699","refs":[],"lines":["“Karoti bhaddakaṃ kammaṃ, sīlesuposathe ratā;"],"lineRefs":[[]]},{"para":2775,"vripara":null,"refs":[],"lines":["Saññatā saṃvibhāgī ca, vadaññū vītamaccharā."],"lineRefs":[[]]},{"para":2777,"vripara":"700","refs":[],"lines":["“Akhaṇḍakārī sikkhāya, suṇhā parakulesu ca;"],"lineRefs":[[]]},{"para":2778,"vripara":null,"refs":[],"lines":["Upāsikā sakyamunino, sambuddhassa sirīmato."],"lineRefs":[[]]},{"para":2780,"vripara":"701","refs":[],"lines":["“Bhikkhu ca sīlasampanno, gāmaṃ piṇḍāya pāvisi;"],"lineRefs":[[]]},{"para":2781,"vripara":null,"refs":[],"lines":["Okkhittacakkhu satimā, guttadvāro susaṃvuto."],"lineRefs":[[]]},{"para":2783,"vripara":"702","refs":[],"lines":["“Sapadānaṃ caramāno, agamā taṃ nivesanaṃ;"],"lineRefs":[[]]},{"para":2784,"vripara":null,"refs":[],"lines":["Tamaddasa mahārāja, uttarā bhaddamatthu te."],"lineRefs":[[]]},{"para":2786,"vripara":"703","refs":[],"lines":["“Pūraṃ pānīyasarakaṃ, pūve vitte ca sā adā;"],"lineRefs":[[]]},{"para":2787,"vripara":null,"refs":[],"lines":["Pitā me kālakato bhante, tassetaṃ upakappatu."],"lineRefs":[[]]},{"para":2789,"vripara":"704","refs":[],"lines":["“Samanantarānuddiṭṭhe, vipāko udapajjatha;"],"lineRefs":[[]]},{"para":2790,"vripara":null,"refs":[],"lines":["Bhuñjāmi kāmakāmīhaṃ, rājā vessavaṇo yathā."],"lineRefs":[[]]},{"para":2792,"vripara":"705","refs":[],"lines":["“Taṃ suṇohi mahārāja, arindama raṭṭhavaḍḍhana;"],"lineRefs":[[]]},{"para":2793,"vripara":null,"refs":[],"lines":["Sadevakassa lokassa, buddho aggo pavuccati;"],"lineRefs":[[]]},{"para":2794,"vripara":null,"refs":[],"lines":["Taṃ buddhaṃ saraṇaṃ gaccha, saputtadāro arindama."],"lineRefs":[[]]},{"para":2796,"vripara":"706","refs":[],"lines":["“Aṭṭhaṅgikena maggena, phusanti amataṃ padaṃ;"],"lineRefs":[[]]},{"para":2797,"vripara":null,"refs":[],"lines":["Taṃ dhammaṃ saraṇaṃ gaccha, saputtadāro arindama."],"lineRefs":[[]]},{"para":2799,"vripara":"707","refs":[],"lines":["“Cattāro ca paṭipannā, cattāro ca phale ṭhitā;"],"lineRefs":[[]]},{"para":2800,"vripara":null,"refs":[],"lines":["Esa saṅgho ujubhūto, paññāsīlasamāhito;"],"lineRefs":[[]]},{"para":2801,"vripara":null,"refs":[],"lines":["Taṃ saṅghaṃ saraṇaṃ gaccha, saputtadāro arindama."],"lineRefs":[[]]},{"para":2803,"vripara":"708","refs":[],"lines":["“Pāṇātipātā viramassu khippaṃ, loke adinnaṃ parivajjayassu;"],"lineRefs":[[]]},{"para":2804,"vripara":null,"refs":[],"lines":["Amajjapo mā ca musā abhāṇi, sakena dārena ca hohi tuṭṭhoti."],"lineRefs":[[]]},{"para":2806,"vripara":"709","refs":[],"lines":["“Atthakāmosi me yakkha, hitakāmosi devate;"],"lineRefs":[[]]},{"para":2807,"vripara":null,"refs":[],"lines":["Karomi tuyhaṃ vacanaṃ, tvaṃsi ācariyo mama."],"lineRefs":[[]]},{"para":2809,"vripara":"710","refs":[],"lines":["“Upemi saraṇaṃ buddhaṃ, dhammañcāpi anuttaraṃ;"],"lineRefs":[[]]},{"para":2810,"vripara":null,"refs":[],"lines":["Saṅghañca naradevassa, gacchāmi saraṇaṃ ahaṃ."],"lineRefs":[[]]},{"para":2812,"vripara":"711","refs":[],"lines":["“Pāṇātipātā viramāmi khippaṃ, loke adinnaṃ parivajjayāmi;"],"lineRefs":[[]]},{"para":2813,"vripara":null,"refs":[],"lines":["Amajjapo no ca musā bhaṇāmi, sakena dārena ca homi tuṭṭho."],"lineRefs":[[]]},{"para":2815,"vripara":"712","refs":[],"lines":["“Ophuṇāmi mahāvāte, nadiyā sīghagāmiyā;"],"lineRefs":[[]]},{"para":2816,"vripara":null,"refs":[],"lines":["Vamāmi pāpikaṃ diṭṭhiṃ, buddhānaṃ sāsane rato."],"lineRefs":[[]]},{"para":2818,"vripara":"713","refs":[],"lines":["“Idaṃ vatvāna soraṭṭho, viramitvā pāpadassanā;"],"lineRefs":[[]]},{"para":2819,"vripara":null,"refs":[],"lines":["Namo bhagavato katvā, pāmokkho rathamāruhī”ti.","– gāthāyo avocuṃ;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
