{"suttaId":"an5.306","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1614,1614],"vripara":"306"},"segments":{"an5.306:0.3":"305","an5.306:1.1":"“Rāgassa, bhikkhave, abhiññāya pañca dhammā bhāvetabbā.","an5.306:1.2":"Katame pañca?","an5.306:1.3":"Saddhindriyaṃ, vīriyindriyaṃ, satindriyaṃ, samādhindriyaṃ, paññindriyaṃ –","an5.306:1.4":"rāgassa, bhikkhave, abhiññāya ime pañca dhammā bhāvetabbā”ti."},"unsure":[],"attha":null,"tika":null,"tika2":null}
