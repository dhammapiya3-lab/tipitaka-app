{"suttaId":"snp5.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3639,3665],"vripara":"1067"},"segments":{"snp5.6:0.2":"Dhotakamāṇavapucchā","snp5.6:1.1":"“Pucchāmi taṃ bhagavā brūhi me taṃ,","snp5.6:1.2":"(iccāyasmā dhotako)","snp5.6:1.3":"Vācābhikaṅkhāmi mahesi tuyhaṃ;","snp5.6:1.4":"Tava sutvāna nigghosaṃ,","snp5.6:1.5":"sikkhe nibbānamattano”.","snp5.6:2.1":"“Tenahātappaṃ karohi,","snp5.6:2.2":"(dhotakāti bhagavā)","snp5.6:2.3":"idheva nipako sato;","snp5.6:2.4":"Ito sutvāna nigghosaṃ,","snp5.6:2.5":"sikkhe nibbānamattano”.","snp5.6:3.1":"“Passāmahaṃ devamanussaloke,","snp5.6:3.2":"akiñcanaṃ brāhmaṇamiriyamānaṃ;","snp5.6:3.3":"Taṃ taṃ namassāmi samantacakkhu,","snp5.6:3.4":"pamuñca maṃ sakka kathaṃkathāhi”.","snp5.6:4.1":"“Nāhaṃ sahissāmi [samissāmi (syā.), gamissāmi (sī.), samīhāmi (pī.)] pamocanāya,","snp5.6:4.2":"kathaṃkathiṃ dhotaka kañci loke;","snp5.6:4.3":"Dhammañca seṭṭhaṃ abhijānamāno [ājānamāno (sī. syā. pī.)],","snp5.6:4.4":"evaṃ tuvaṃ oghamimaṃ taresi”.","snp5.6:5.1":"“Anusāsa brahme karuṇāyamāno,","snp5.6:5.2":"vivekadhammaṃ yamahaṃ vijaññaṃ;","snp5.6:5.3":"Yathāhaṃ ākāsova abyāpajjamāno,","snp5.6:5.4":"idheva santo asito careyyaṃ”.","snp5.6:6.1":"“Kittayissāmi te santiṃ,","snp5.6:6.2":"(dhotakāti bhagavā)","snp5.6:6.3":"diṭṭhe dhamme anītihaṃ;","snp5.6:6.4":"Yaṃ viditvā sato caraṃ,","snp5.6:6.5":"tare loke visattikaṃ”.","snp5.6:7.1":"“Tañcāhaṃ abhinandāmi,","snp5.6:7.2":"mahesi santimuttamaṃ;","snp5.6:7.3":"Yaṃ viditvā sato caraṃ,","snp5.6:7.4":"tare loke visattikaṃ”.","snp5.6:8.1":"“Yaṃ kiñci sampajānāsi,","snp5.6:8.2":"(dhotakāti bhagavā)","snp5.6:8.3":"Uddhaṃ adho tiriyañcāpi majjhe;","snp5.6:8.4":"Etaṃ viditvā saṅgoti loke,","snp5.6:8.5":"bhavābhavāya mākāsi taṇhan”ti.","snp5.6:8.6":"Dhotakamāṇavapucchā pañcamī niṭṭhitā."},"unsure":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2565,"to":2565,"paras":[{"para":2565,"vripara":"1068-1069","refs":["snp5.6:2"],"lines":["1068-9. <b>Pucchāmi tan</b>ti dhotakasuttaṃ.","Tattha <b>vācābhikaṅkhāmī</b>ti vācaṃ abhikaṅkhāmi.","<b>Sikkhe nibbānamattano</b>ti attano rāgādīnaṃ nibbānatthāya adhisīlādīni sikkheyya.","<b>Ito</b>ti mama mukhato."],"lineRefs":[["snp5.6:2"],["snp5.6:2"],["snp5.6:2"],["snp5.6:2"]]}],"wordLinks":[["snp5.6:2.4","sikkhe nibbānamattano",0,2],["snp5.6:2.4","ito",0,3]]},"tika":null,"tika2":null}
