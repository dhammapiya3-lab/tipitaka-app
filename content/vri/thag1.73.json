{"suttaId":"thag1.73","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[427,430],"vripara":"73"},"segments":{"thag1.73:0.4":"Māṇavattheragāthā","thag1.73:1.1":"“Jiṇṇañca disvā dukhitañca byādhitaṃ,","thag1.73:1.2":"matañca disvā gatamāyusaṅkhayaṃ;","thag1.73:1.3":"Tato ahaṃ nikkhamitūna pabbajiṃ,","thag1.73:1.4":"pahāya kāmāni manoramānī”ti.","thag1.73:1.5":"… Māṇavo thero …."},"unsure":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":1930,"to":1930,"paras":[{"para":1930,"vripara":null,"refs":["thag1.73:1"],"lines":["Tattha <b>jiṇṇan</b>ti jarāya abhibhūtaṃ, khaṇḍiccapāliccavalittacatādīhi samaṅgībhūtaṃ.","<b>Dukhitan</b>ti dukkhappattaṃ.","<b>Byādhitan</b>ti gilānaṃ.","Ettha ca “byādhitan”ti vuttepi dukkhappattabhāvo siddho,“dukhitan”ti vacanaṃ tassa bāḷhagilānabhāvaparidīpanatthaṃ.","<b>Matan</b>ti kālaṅkataṃ, yasmā kālaṅkato āyuno khayaṃ vayaṃ bhedaṃ gato nāma hoti, tasmā vuttaṃ <b>“gatamāyusaṅkhayan”</b>ti.","Tasmā jiṇṇabyādhimatānaṃ diṭṭhattā,“ime jarādayo nāma na imesaṃyeva, atha kho sabbasādhāraṇā, tasmā ahampi jarādike anativatto”ti saṃviggattā.","<b>Nikkhamitūnā</b>ti nikkhamitvā, ayameva vā pāṭho.","Pabbajjādhippāyena gharato niggantvā.","<b>Pabbajin</b>ti satthu sāsane pabbajaṃ upagato.","<b>Pahāya kāmāni manoramānī</b>ti iṭṭhakantādibhāvato avītarāgānaṃ mano ramentīti manorame vatthukāme pajahitvā, tappaṭibaddhassa chandarāgassa ariyamaggena samucchindanena nirapekkhabhāvena chaḍḍetvāti attho.","Kāmānaṃ pahānakittanamukhena cetaṃ therassa aññābyākaraṇaṃ ahosi.","Māṇavakāle pabbajitattā imassa therassa <b>māṇavo</b> tveva samaññā jātāti."],"lineRefs":[["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"]]}],"wordLinks":[["thag1.73:1.1","jiṇṇaṃ",0,0],["thag1.73:1.1","dukhitaṃ",0,1],["thag1.73:1.1","byādhitaṃ",0,2],["thag1.73:1.1","gatamāyusaṅkhayaṃ",0,4],["thag1.73:1.1","mataṃ",0,4],["thag1.73:1.3","nikkhamitūnā",0,6],["thag1.73:1.3","pabbajiṃ",0,8],["thag1.73:1.3","pahāya kāmāni manoramānī",0,9],["thag1.73:1.5","māṇavo",0,11]],"before":[{"para":1862,"vripara":null,"refs":[],"lines":["“Nisajja pāsādavare, vipassiṃ addasaṃ jinaṃ;"],"lineRefs":[[]]},{"para":1863,"vripara":null,"refs":[],"lines":["Kakudhaṃ vilasantaṃva, sabbaññuṃ tamanāsakaṃ."],"lineRefs":[[]]},{"para":1864,"vripara":null,"refs":[],"lines":["“Pāsādassāvidūre ca, gacchati lokanāyako;"],"lineRefs":[[]]},{"para":1865,"vripara":null,"refs":[],"lines":["Pabhā niddhāvate tassa, yathā ca sataraṃsino."],"lineRefs":[[]]},{"para":1866,"vripara":null,"refs":[],"lines":["“Gandhodakañca paggayha, buddhaseṭṭhaṃ samokiriṃ;"],"lineRefs":[[]]},{"para":1867,"vripara":null,"refs":[],"lines":["Tena cittappasādena, tattha kālaṅkato ahaṃ."],"lineRefs":[[]]},{"para":1868,"vripara":null,"refs":[],"lines":["“Ekanavutito kappe, yaṃ gandhodakamākiriṃ;"],"lineRefs":[[]]},{"para":1869,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":1870,"vripara":null,"refs":[],"lines":["“Ekatiṃse ito kappe, sugandho nāma khattiyo;"],"lineRefs":[[]]},{"para":1871,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1872,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":1873,"vripara":null,"refs":[],"lines":["Chaḷabhiñño pana hutvā mātaraṃ āpucchitvā tassā pekkhantiyāyeva ākāsena pakkāmi.","So arahattappattiyā uttarikālampi antarantarā tameva gāthaṃ paccudāhāsi."],"lineRefs":[[],[]]},{"para":1874,"vripara":null,"refs":[],"lines":["Tattha “pabbajitomhī”ti imināpadesena ayampi therassa aññābyākaraṇagāthā ahosi attano santāne rāgādimalassa pabbājitabhāvadīpanato.","Tenāha bhagavā –","“pabbājayamattano malaṃ, tasmā ‘pabbajito’ti vuccatī”ti (dha. pa.388)."],"lineRefs":[[],[],[]]},{"para":1875,"vripara":null,"refs":[],"lines":["Ātumattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1876,"vripara":null,"refs":[],"lines":["Māṇavattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":1877,"vripara":null,"refs":[],"lines":["<b>Jiṇṇañca disvā dukhitañca byādhitan</b>ti āyasmato māṇavattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinanto ito ekanavute kappe brāhmaṇakule nibbattitvā lakkhaṇadharo hutvā vipassissa bhagavato abhijātiyā lakkhaṇāni pariggahetvā pubbanimittāni sāvetvā,“ekaṃsena ayaṃ buddho bhavissatī”ti byākaritvā nānānayehi thometvā abhivādetvā padakkhiṇaṃ katvā pakkāmi.","So tena puññakammena sugatīsuyeva saṃsaranto imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇamahāsālassa gehe nibbattitvā yāva sattavassāni, tāva antoghareyeva vaḍḍhitvā sattame saṃvacchare upanayanatthaṃ uyyānaṃ nīto antarāmagge jiṇṇāturamate disvā tesaṃ adiṭṭhapubbattā te parijane pucchitvā jarārogamaraṇasabhāvaṃ sutvā sañjātasaṃvego tato anivattanto vihāraṃ gantvā satthu santike dhammaṃ sutvā mātāpitaro anujānāpetvā pabbajitvā vipassanaṃ paṭṭhapetvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.13.41-64)–"],"lineRefs":[[],[],[],[],[]]},{"para":1878,"vripara":null,"refs":[],"lines":["“Jāyamāne vipassimhi, nimittaṃ byākariṃ ahaṃ;"],"lineRefs":[[]]},{"para":1879,"vripara":null,"refs":[],"lines":["Nibbāpayiñca janataṃ, buddho loke bhavissati."],"lineRefs":[[]]},{"para":1880,"vripara":null,"refs":[],"lines":["“Yasmiñca jāyamānasmiṃ, dasasahassi kampati;"],"lineRefs":[[]]},{"para":1881,"vripara":null,"refs":[],"lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."],"lineRefs":[[]]},{"para":1882,"vripara":null,"refs":[],"lines":["“Yasmiñca jāyamānasmiṃ, āloko vipulo ahu;"],"lineRefs":[[]]},{"para":1883,"vripara":null,"refs":[],"lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."],"lineRefs":[[]]},{"para":1884,"vripara":null,"refs":[],"lines":["“Yasmiñca jāyamānasmiṃ, saritāyo na sandayuṃ;"],"lineRefs":[[]]},{"para":1885,"vripara":null,"refs":[],"lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."],"lineRefs":[[]]},{"para":1886,"vripara":null,"refs":[],"lines":["“Yasmiñca jāyamānasmiṃ, avīcaggi na pajjali;"],"lineRefs":[[]]},{"para":1887,"vripara":null,"refs":[],"lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."],"lineRefs":[[]]},{"para":1888,"vripara":null,"refs":[],"lines":["“Yasmiñca jāyamānasmiṃ, pakkhisaṅgho na sañcari;"],"lineRefs":[[]]},{"para":1889,"vripara":null,"refs":[],"lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."],"lineRefs":[[]]},{"para":1890,"vripara":null,"refs":[],"lines":["“Yasmiñca jāyamānasmiṃ, vātakkhandho na vāyati;"],"lineRefs":[[]]},{"para":1891,"vripara":null,"refs":[],"lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."],"lineRefs":[[]]},{"para":1892,"vripara":null,"refs":[],"lines":["“Yasmiñca jāyamānasmiṃ, sabbaratanāni jotayuṃ;"],"lineRefs":[[]]},{"para":1893,"vripara":null,"refs":[],"lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."],"lineRefs":[[]]},{"para":1894,"vripara":null,"refs":[],"lines":["“Yasmiñca jāyamānasmiṃ, sattāsuṃ padavikkamā;"],"lineRefs":[[]]},{"para":1895,"vripara":null,"refs":[],"lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."],"lineRefs":[[]]},{"para":1896,"vripara":null,"refs":[],"lines":["“Jātamatto ca sambuddho, disā sabbā vilokayi;"],"lineRefs":[[]]},{"para":1897,"vripara":null,"refs":[],"lines":["Vācāsabhimudīresi, esā buddhāna dhammatā."],"lineRefs":[[]]},{"para":1898,"vripara":null,"refs":[],"lines":["“Saṃvejayitvā janataṃ, thavitvā lokanāyakaṃ;"],"lineRefs":[[]]},{"para":1899,"vripara":null,"refs":[],"lines":["Sambuddhaṃ abhivādetvā, pakkāmiṃ pācināmukho."],"lineRefs":[[]]},{"para":1900,"vripara":null,"refs":[],"lines":["“Ekanavutito kappe, yaṃ buddhamabhithomayiṃ;"],"lineRefs":[[]]},{"para":1901,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, thomanāya idaṃ phalaṃ."],"lineRefs":[[]]},{"para":1902,"vripara":null,"refs":[],"lines":["“Ito navutikappamhi, sammukhāthavikavhayo;"],"lineRefs":[[]]},{"para":1903,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1904,"vripara":null,"refs":[],"lines":["“Pathavīdundubhi nāma, ekūnanavutimhito;"],"lineRefs":[[]]},{"para":1905,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1906,"vripara":null,"refs":[],"lines":["“Aṭṭhāsītimhito kappe, obhāso nāma khattiyo;"],"lineRefs":[[]]},{"para":1907,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1908,"vripara":null,"refs":[],"lines":["“Sattāsītimhito kappe, saritacchedanavhayo;"],"lineRefs":[[]]},{"para":1909,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1910,"vripara":null,"refs":[],"lines":["“Agginibbāpano nāma, kappānaṃ chaḷasītiyā;"],"lineRefs":[[]]},{"para":1911,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1912,"vripara":null,"refs":[],"lines":["“Gatipacchedano nāma, kappānaṃ pañcasītiyā;"],"lineRefs":[[]]},{"para":1913,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1914,"vripara":null,"refs":[],"lines":["“Rājā vātasamo nāma, kappānaṃ cullasītiyā;"],"lineRefs":[[]]},{"para":1915,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1916,"vripara":null,"refs":[],"lines":["“Ratanapajjalo nāma, kappānaṃ teasītiyā;"],"lineRefs":[[]]},{"para":1917,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1918,"vripara":null,"refs":[],"lines":["“Padavikkamano nāma, kappānaṃ dveasītiyā;"],"lineRefs":[[]]},{"para":1919,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1920,"vripara":null,"refs":[],"lines":["“Rājā vilokano nāma, kappānaṃ ekasītiyā;"],"lineRefs":[[]]},{"para":1921,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1922,"vripara":null,"refs":[],"lines":["“Girasāroti nāmena, kappesītimhi khattiyo;"],"lineRefs":[[]]},{"para":1923,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1924,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":1925,"vripara":null,"refs":[],"lines":["Adhigatārahatto pana bhikkhūhi,“kena, tvaṃ āvuso, saṃvegena atidaharova samāno pabbajito”ti pucchito attano pabbajjānimittakittanāpadesena aññaṃ byākaronto –"],"lineRefs":[[]]},{"para":1927,"vripara":"73","refs":[],"lines":["“Jiṇṇañca disvā dukhitañca byādhitaṃ, matañca disvā gatamāyusaṅkhayaṃ;"],"lineRefs":[[]]},{"para":1928,"vripara":null,"refs":[],"lines":["Tato ahaṃ nikkhamitūna pabbajiṃ, pahāya kāmāni manoramānī”ti.","–"],"lineRefs":[[],[]]},{"para":1929,"vripara":null,"refs":[],"lines":["Gāthaṃ abhāsi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
