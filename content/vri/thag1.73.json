{"suttaId":"thag1.73","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[427,430],"vripara":"73"},"segments":{"thag1.73:0.4":"Māṇavattheragāthā","thag1.73:1.1":"“Jiṇṇañca disvā dukhitañca byādhitaṃ,","thag1.73:1.2":"matañca disvā gatamāyusaṅkhayaṃ;","thag1.73:1.3":"Tato ahaṃ nikkhamitūna pabbajiṃ,","thag1.73:1.4":"pahāya kāmāni manoramānī”ti. …","thag1.73:1.5":"Māṇavo thero…. 4."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":1930,"to":1930,"paras":[{"para":1930,"vripara":null,"refs":["thag1.73:1"],"lines":["Tattha <b>jiṇṇa</b>nti jarāya abhibhūtaṃ, khaṇḍiccapāliccavalittacatādīhi samaṅgībhūtaṃ.","<b>Dukhita</b>nti dukkhappattaṃ.","<b>Byādhita</b>nti gilānaṃ.","Ettha ca “byādhita”nti vuttepi dukkhappattabhāvo siddho, “dukhita”nti vacanaṃ tassa bāḷhagilānabhāvaparidīpanatthaṃ.","<b>Mata</b>nti kālaṅkataṃ, yasmā kālaṅkato āyuno khayaṃ vayaṃ bhedaṃ gato nāma hoti, tasmā vuttaṃ <b>“gatamāyusaṅkhaya”</b>nti.","Tasmā jiṇṇabyādhimatānaṃ diṭṭhattā, “ime jarādayo nāma na imesaṃyeva, atha kho sabbasādhāraṇā, tasmā ahampi jarādike anativatto”ti saṃviggattā.","<b>Nikkhamitūnā</b>ti nikkhamitvā, ayameva vā pāṭho.","Pabbajjādhippāyena gharato niggantvā.","<b>Pabbaji</b>nti satthu sāsane pabbajaṃ upagato.","<b>Pahāya kāmāni manoramānī</b>ti iṭṭhakantādibhāvato avītarāgānaṃ mano ramentīti manorame vatthukāme pajahitvā, tappaṭibaddhassa chandarāgassa ariyamaggena samucchindanena nirapekkhabhāvena chaḍḍetvāti attho.","Kāmānaṃ pahānakittanamukhena cetaṃ therassa aññābyākaraṇaṃ ahosi.","Māṇavakāle pabbajitattā imassa therassa <b>māṇavo</b>tveva samaññā jātāti."],"lineRefs":[["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"],["thag1.73:1"]]}],"wordLinks":[["thag1.73:1.1","jiṇṇaṃ",0,0],["thag1.73:1.1","dukhitaṃ",0,1],["thag1.73:1.1","byādhitaṃ",0,2],["thag1.73:1.1","gatamāyusaṅkhayaṃ",0,4],["thag1.73:1.1","mataṃ",0,4],["thag1.73:1.3","nikkhamitūnā",0,6],["thag1.73:1.3","pabbajiṃ",0,8],["thag1.73:1.3","pahāya kāmāni manoramānī",0,9],["thag1.73:1.5","māṇavo",0,11]],"before":[{"para":1876,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Māṇavattheragāthāvaṇṇanā"]},{"para":1877,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["<b>Jiṇṇañca disvā dukhitañca byādhita</b>nti āyasmato māṇavattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinanto ito ekanavute kappe brāhmaṇakule nibbattitvā lakkhaṇadharo hutvā vipassissa bhagavato abhijātiyā lakkhaṇāni pariggahetvā pubbanimittāni sāvetvā, “ekaṃsena ayaṃ buddho bhavissatī”ti byākaritvā nānānayehi thometvā abhivādetvā padakkhiṇaṃ katvā pakkāmi.","So tena puññakammena sugatīsuyeva saṃsaranto imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇamahāsālassa gehe nibbattitvā yāva sattavassāni, tāva antoghareyeva vaḍḍhitvā sattame saṃvacchare upanayanatthaṃ uyyānaṃ nīto antarāmagge jiṇṇāturamate disvā tesaṃ adiṭṭhapubbattā te parijane pucchitvā jarārogamaraṇasabhāvaṃ sutvā sañjātasaṃvego tato anivattanto vihāraṃ gantvā satthu santike dhammaṃ sutvā mātāpitaro anujānāpetvā pabbajitvā vipassanaṃ paṭṭhapetvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.13.41-64) –"]},{"para":1878,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Jāyamāne vipassimhi, nimittaṃ byākariṃ ahaṃ;"]},{"para":1879,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Nibbāpayiñca janataṃ, buddho loke bhavissati."]},{"para":1880,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Yasmiñca jāyamānasmiṃ, dasasahassi kampati;"]},{"para":1881,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."]},{"para":1882,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Yasmiñca jāyamānasmiṃ, āloko vipulo ahu;"]},{"para":1883,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."]},{"para":1884,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Yasmiñca jāyamānasmiṃ, saritāyo na sandayuṃ;"]},{"para":1885,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."]},{"para":1886,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Yasmiñca jāyamānasmiṃ, avīcaggi na pajjali;"]},{"para":1887,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."]},{"para":1888,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Yasmiñca jāyamānasmiṃ, pakkhisaṅgho na sañcari;"]},{"para":1889,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."]},{"para":1890,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Yasmiñca jāyamānasmiṃ, vātakkhandho na vāyati;"]},{"para":1891,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."]},{"para":1892,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Yasmiñca jāyamānasmiṃ, sabbaratanāni jotayuṃ;"]},{"para":1893,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."]},{"para":1894,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Yasmiñca jāyamānasmiṃ, sattāsuṃ padavikkamā;"]},{"para":1895,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["So dāni bhagavā satthā, dhammaṃ deseti cakkhumā."]},{"para":1896,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Jātamatto ca sambuddho, disā sabbā vilokayi;"]},{"para":1897,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Vācāsabhimudīresi, esā buddhāna dhammatā."]},{"para":1898,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Saṃvejayitvā janataṃ, thavitvā lokanāyakaṃ;"]},{"para":1899,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sambuddhaṃ abhivādetvā, pakkāmiṃ pācināmukho."]},{"para":1900,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Ekanavutito kappe, yaṃ buddhamabhithomayiṃ;"]},{"para":1901,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, thomanāya idaṃ phalaṃ."]},{"para":1902,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Ito navutikappamhi, sammukhāthavikavhayo;"]},{"para":1903,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1904,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Pathavīdundubhi nāma, ekūnanavutimhito;"]},{"para":1905,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1906,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Aṭṭhāsītimhito kappe, obhāso nāma khattiyo;"]},{"para":1907,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1908,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Sattāsītimhito kappe, saritacchedanavhayo;"]},{"para":1909,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1910,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Agginibbāpano nāma, kappānaṃ chaḷasītiyā;"]},{"para":1911,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1912,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Gatipacchedano nāma, kappānaṃ pañcasītiyā;"]},{"para":1913,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1914,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Rājā vātasamo nāma, kappānaṃ cullasītiyā;"]},{"para":1915,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1916,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Ratanapajjalo nāma, kappānaṃ teasītiyā;"]},{"para":1917,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1918,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Padavikkamano nāma, kappānaṃ dveasītiyā;"]},{"para":1919,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1920,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Rājā vilokano nāma, kappānaṃ ekasītiyā;"]},{"para":1921,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1922,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Girasāroti nāmena, kappesītimhi khattiyo;"]},{"para":1923,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":1924,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti."]},{"para":1925,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Adhigatārahatto pana bhikkhūhi, “kena, tvaṃ āvuso, saṃvegena atidaharova samāno pabbajito”ti pucchito attano pabbajjānimittakittanāpadesena aññaṃ byākaronto – 73."]},{"para":1927,"vripara":"73","title":"Māṇavattheragāthāvaṇṇanā","lines":["“Jiṇṇañca disvā dukhitañca byādhitaṃ, matañca disvā gatamāyusaṅkhayaṃ;"]},{"para":1928,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Tato ahaṃ nikkhamitūna pabbajiṃ, pahāya kāmāni manoramānī”ti. –"]},{"para":1929,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Gāthaṃ abhāsi."]}],"after":[{"para":1931,"vripara":null,"title":"Māṇavattheragāthāvaṇṇanā","lines":["Māṇavattheragāthāvaṇṇanā niṭṭhitā. 4."]}]},"tika":null,"tika2":null}
