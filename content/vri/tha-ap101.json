{"suttaId":"tha-ap101","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5109,5124],"vripara":"51"},"segments":{"tha-ap101:0.3":"Veyyāvaccakattheraapadānaṃ","tha-ap101:1.1":"“Vipassissa bhagavato,","tha-ap101:1.2":"mahāpūgagaṇo ahu;","tha-ap101:1.3":"Veyyāvaccakaro āsiṃ,","tha-ap101:1.4":"sabbakiccesu vāvaṭo [byāvaṭo (sī. syā.)].","tha-ap101:2.1":"“Deyyadhammo ca me natthi,","tha-ap101:2.2":"sugatassa mahesino;","tha-ap101:2.3":"Avandiṃ satthuno pāde,","tha-ap101:2.4":"vippasannena cetasā.","tha-ap101:3.1":"“Ekanavutito kappe,","tha-ap101:3.2":"veyyāvaccaṃ akāsahaṃ;","tha-ap101:3.3":"Duggatiṃ nābhijānāmi,","tha-ap101:3.4":"veyyāvaccassidaṃ phalaṃ.","tha-ap101:4.1":"“Ito ca aṭṭhame kappe,","tha-ap101:4.2":"rājā āsiṃ sucintito;","tha-ap101:4.3":"Sattaratanasampanno,","tha-ap101:4.4":"cakkavattī mahabbalo.","tha-ap101:5.1":"“Paṭisambhidā catasso … pe …","tha-ap101:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap101:6.1":"Itthaṃ sudaṃ āyasmā veyyāvaccako thero imā gāthāyo abhāsitthāti.","tha-ap101:7.1":"Veyyāvaccakattherassāpadānaṃ navamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2793,"to":2793,"paras":[{"para":2793,"vripara":"51","refs":["tha-ap101:1"],"lines":["So ekadivasaṃ attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>vipassissa bhagavato</b>tiādimāha.","Taṃ heṭṭhā vuttameva.","<b>Ahosiṃ saṅkhadhamako</b>ti saṃ suṭṭhu khananto gacchatīti saṅkho, samuddajalapariyante caramāno gacchati vicaratīti attho.","Taṃ saṅkhaṃ dhamati ghosaṃ karotīti saṅkhadhamako, sohaṃ saṅkhadhamakova ahosinti attho.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["tha-ap101:1"],["tha-ap101:1"],["tha-ap101:1"],["tha-ap101:1"],["tha-ap101:1"]]}],"wordLinks":[["tha-ap101:1.1","vipassissa bhagavato",0,0]],"before":[{"para":2787,"vripara":null,"refs":[],"lines":["Senāsanadāyakattheraapadānavaṇṇanā samattā."],"lineRefs":[[]]},{"para":2788,"vripara":null,"refs":[],"lines":["Veyyāvaccakarattheraapadānavaṇṇanā"],"lineRefs":[[]]},{"para":2789,"vripara":null,"refs":[],"lines":["<b>Vipassissa bhagavato</b>tiādikaṃ āyasmato veyyāvaccakarattherassa apadānaṃ.","Tassa uppattiādayo heṭṭhā vuttaniyāmeneva daṭṭhabbā."],"lineRefs":[[],[]]},{"para":2790,"vripara":null,"refs":[],"lines":["Veyyāvaccakarattheraapadānavaṇṇanā samattā."],"lineRefs":[[]]},{"para":2791,"vripara":null,"refs":[],"lines":["Buddhupaṭṭhākattheraapadānavaṇṇanā"],"lineRefs":[[]]},{"para":2792,"vripara":null,"refs":[],"lines":["<b>Vipassissa bhagavato</b>tiādikaṃ āyasmato buddhupaṭṭhākattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto vipassissa bhagavato kāle saṅkhadhamakakule nibbatto vuddhimanvāya attano sippe saṅkhadhamane cheko ahosi, niccakālaṃ bhagavato saṅkhaṃ dhametvā saṅkhasaddeneva pūjesi.","So tena puññena devamanussesu saṃsaranto sabbattha pākaṭo mahāghoso mahānādī madhurassaro ahosi, imasmiṃ buddhuppāde ekasmiṃ pākaṭakule nibbatto vuddhippatto <b>madhurassaro</b>ti pākaṭo, satthari pasīditvā pabbajito nacirasseva arahā ahosi, aparabhāge madhurassarattheroti pākaṭo."],"lineRefs":[[],[],[]]}]},"tika":null,"tika2":null}
