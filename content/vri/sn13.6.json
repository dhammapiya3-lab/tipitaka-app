{"suttaId":"sn13.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[646,647],"vripara":"79"},"segments":{"sn13.6:0.3":"Dutiyapathavīsuttaṃ","sn13.6:1.1":"Sāvatthiyaṃ viharati…pe…","sn13.6:1.2":"“seyyathāpi, bhikkhave, mahāpathavī parikkhayaṃ pariyādānaṃ gaccheyya, ṭhapetvā satta kolaṭṭhimattiyo guḷikā.","sn13.6:1.3":"Taṃ kiṃ maññatha, bhikkhave,","sn13.6:1.4":"katamaṃ nu kho bahutaraṃ, yaṃ vā mahāpathaviyā parikkhīṇaṃ pariyādiṇṇaṃ yā vā satta kolaṭṭhimattiyo guḷikā avasiṭṭhā”ti?","sn13.6:2.1":"“Etadeva bhante, bahutaraṃ, mahāpathaviyā, yadidaṃ parikkhīṇaṃ pariyādiṇṇaṃ;","sn13.6:2.2":"appamattikā satta kolaṭṭhimattiyo guḷikā avasiṭṭhā.","sn13.6:2.3":"Neva satimaṃ kalaṃ upenti na sahassimaṃ kalaṃ upenti na satasahassimaṃ kalaṃ upenti mahāpathaviyā parikkhīṇaṃ pariyādiṇṇaṃ upanidhāya satta kolaṭṭhimattiyo guḷikā avasiṭṭhā”ti.","sn13.6:2.4":"“Evameva kho, bhikkhave…pe…","sn13.6:2.5":"dhammacakkhupaṭilābho”ti.","sn13.6:2.6":"Chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":484,"to":488,"paras":[{"para":484,"vripara":"78-84","refs":["sn13.6:1"],"lines":["Pañcame <b>mahāpathaviyā</b>ti cakkavāḷabbhantarāya mahāpathaviyā uddharitvā.","<b>Kolaṭṭhimattiyo</b>ti padaraṭṭhipamāṇā.","<b>Guḷikā</b>ti mattikaguḷikā.","<b>Upanikkhipeyyā</b>ti ekasmiṃ ṭhāne ṭhapeyya.","Chaṭṭhādīsu vuttanayeneva attho veditabbo.","Pariyosāne pana <b>aññatitthiyasamaṇabrāhmaṇaparibbājakānaṃ adhigamo</b>ti bāhirakānaṃ sabbopi guṇādhigamo paṭhamamaggena adhigataguṇānaṃ satabhāgampi sahassabhāgampi satasahassabhāgampi na upagacchatīti.","Pañcamādīni."],"lineRefs":[["sn13.6:1"],["sn13.6:1"],["sn13.6:1"],["sn13.6:1"],["sn13.6:1"],["sn13.6:1"],["sn13.6:1"]]},{"para":485,"vripara":null,"refs":["sn13.6:1"],"lines":["Abhisamayasaṃyuttavaṇṇanā niṭṭhitā. 3."],"lineRefs":[["sn13.6:1"]]},{"para":486,"vripara":null,"refs":["sn13.6:1"],"lines":["Dhātusaṃyuttaṃ 1."],"lineRefs":[["sn13.6:1"]]},{"para":487,"vripara":null,"refs":["sn13.6:1"],"lines":["Nānattavaggo 1."],"lineRefs":[["sn13.6:1"]]},{"para":488,"vripara":null,"refs":["sn13.6:1"],"lines":["Dhātunānattasuttavaṇṇanā 85."],"lineRefs":[["sn13.6:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":475,"to":483,"paras":[{"para":475,"vripara":"78-84","refs":["sn13.6:1"],"lines":["<b>Cakkavāḷabbhantarāyā</b>ti cakkavāḷapabbatassa antogadhāya."],"lineRefs":[["sn13.6:1"]]},{"para":476,"vripara":null,"refs":["sn13.6:1"],"lines":["<b>Chaṭṭhādīsu vuttanayenevā</b>ti idha chaṭṭhasuttādīsu paṭhamasuttādīsu vuttanayenevāti attho veditabbo visesābhāvato."],"lineRefs":[["sn13.6:1"]]},{"para":477,"vripara":null,"refs":["sn13.6:1"],"lines":["<b>Pariyosāne</b>ti imassa abhisamayasaṃyuttassa osānaṭṭhāne.","<b>Aññatitthiyasamaṇabrāhmaṇaparibbājakāna</b>nti aññatitthiyānaṃ.","<b>Guṇādhigamo</b>ti jhānābhiññāsahito guṇādhigamo.","<b>Satabhāgampi…pe… na upagacchati</b> saccapaṭivedhassa mahānubhāvattā.","Tenāha bhagavā paccakkhasabbadhammo “evaṃ mahādhigamo, bhikkhave, diṭṭhisampanno puggalo evaṃ mahābhiñño”ti."],"lineRefs":[["sn13.6:1"],["sn13.6:1"],["sn13.6:1"],["sn13.6:1"],["sn13.6:1"]]},{"para":478,"vripara":null,"refs":["sn13.6:1"],"lines":["Pathavīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn13.6:1"]]},{"para":479,"vripara":null,"refs":["sn13.6:1"],"lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"],"lineRefs":[["sn13.6:1"]]},{"para":480,"vripara":null,"refs":["sn13.6:1"],"lines":["Abhisamayasaṃyuttavaṇṇanāya līnatthappakāsanā samattā. 3."],"lineRefs":[["sn13.6:1"]]},{"para":481,"vripara":null,"refs":["sn13.6:1"],"lines":["Dhātusaṃyuttaṃ 1."],"lineRefs":[["sn13.6:1"]]},{"para":482,"vripara":null,"refs":["sn13.6:1"],"lines":["Nānattavaggo 1."],"lineRefs":[["sn13.6:1"]]},{"para":483,"vripara":null,"refs":["sn13.6:1"],"lines":["Dhātunānattasuttavaṇṇanā 85."],"lineRefs":[["sn13.6:1"]]}],"wordLinks":[]},"tika2":null}
