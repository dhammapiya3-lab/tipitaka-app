{"suttaId":"tha-ap183","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7010,7026],"vripara":"1"},"segments":{"tha-ap183:0.3":"Kuṭajapupphiyattheraapadānaṃ","tha-ap183:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ, sataraṃsiṃva uggataṃ;","tha-ap183:1.3":"Disaṃ anuvilokentaṃ, gacchantaṃ anilañjase.","tha-ap183:2.1":"“Kuṭajaṃ pupphitaṃ disvā, saṃvitthatasamotthataṃ;","tha-ap183:2.3":"Rukkhato ocinitvāna, phussassa abhiropayiṃ.","tha-ap183:3.1":"“Dvenavute ito kappe, yaṃ pupphamabhiropayiṃ;","tha-ap183:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap183:4.1":"“Ito sattarase kappe, tayo āsuṃ supupphitā;","tha-ap183:4.3":"Sattaratanasampannā, cakkavattī mahabbalā.","tha-ap183:5.1":"“Paṭisambhidā catasso, vimokkhāpi ca aṭṭhime;","tha-ap183:5.3":"Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanaṃ”.","tha-ap183:6.1":"Itthaṃ sudaṃ āyasmā kuṭajapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap183:7.1":"Kuṭajapupphiyattherassāpadānaṃ paṭhamaṃ."},"attha":null,"tika":null,"tika2":null}
