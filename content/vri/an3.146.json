{"suttaId":"an3.146","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1235,1236],"vripara":"147"},"segments":{"an3.146:0.3":"Akusalasuttaṃ","an3.146:1.1":"“Tīhi, bhikkhave, dhammehi samannāgato yathābhataṃ nikkhitto evaṃ niraye.","an3.146:1.2":"Katamehi tīhi?","an3.146:1.3":"Akusalena kāyakammena, akusalena vacīkammena, akusalena manokammena –","an3.146:1.4":"imehi kho, bhikkhave, tīhi dhammehi samannāgato yathābhataṃ nikkhitto evaṃ niraye.","an3.146:2.1":"“Tīhi, bhikkhave, dhammehi samannāgato yathābhataṃ nikkhitto evaṃ sagge.","an3.146:2.2":"Katamehi tīhi?","an3.146:2.3":"Kusalena kāyakammena, kusalena vacīkammena, kusalena manokammena –","an3.146:2.4":"imehi kho, bhikkhave, tīhi dhammehi samannāgato yathābhataṃ nikkhitto evaṃ sagge”ti.","an3.146:2.5":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":978,"to":978,"paras":[{"para":978,"vripara":"147-155","refs":["an3.146:1"],"lines":["Pañcamassa paṭhame <b>yathābhataṃ nikkhitto</b>ti yathā ānetvā ṭhapito.","Dutiye <b>sāvajjenā</b>ti sadosena.","Tatiye <b>visamenā</b>ti sapakkhalanena.","<b>Samenā</b>ti apakkhalanena.","Catutthe <b>asucinā</b>ti gūthasadisena aparisuddhena amejjhena.","<b>Sucinā</b>ti parisuddhena mejjhena.","Pañcamādīni uttānāneva. 10."],"lineRefs":[["an3.146:1"],["an3.146:1"],["an3.146:1"],["an3.146:1"],["an3.146:1"],["an3.146:1"],["an3.146:1"]]}],"wordLinks":[["an3.146:1.1","yathābhataṃ nikkhitto",0,0],["an3.146:1.3","yathābhataṃ nikkhitto",0,0]],"before":[{"para":976,"vripara":null,"title":"5. Maṅgalavaggo","lines":["Maṅgalavaggo 1-9."]},{"para":977,"vripara":null,"title":"Akusalasuttādivaṇṇanā","lines":["Akusalasuttādivaṇṇanā 147-155."]}]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":1009,"to":1011,"paras":[{"para":1009,"vripara":"147-156","refs":["an3.146:1"],"lines":["Maṅgalavaggo uttānatthoyeva."],"lineRefs":[["an3.146:1"]]