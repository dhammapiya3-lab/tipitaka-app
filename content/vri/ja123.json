{"suttaId":"ja123","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[691,694],"vripara":"123"},"segments":{"ja123:0.4":"Naṅgalīsajātakaṃ","ja123:1.1":"Asabbatthagāmiṃ vācaṃ, bālo sabbattha bhāsati;","ja123:1.3":"Nāyaṃ dadhiṃ vedi na [na vedi (ka.)] naṅgalīsaṃ, dadhippayaṃ [dadhimpayaṃ (sī. pī.)] maññati naṅgalīsanti.","ja123:2.1":"Naṅgalīsajātakaṃ tatiyaṃ."},"attha":null,"tika":null}
