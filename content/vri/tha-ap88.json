{"suttaId":"tha-ap88","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4860,4872],"vripara":"35"},"segments":{"tha-ap88:0.3":"Dutiyaraṃsisaññakattheraapadānaṃ","tha-ap88:1.1":"“Pabbate himavantamhi,","tha-ap88:1.2":"vākacīradharo ahaṃ;","tha-ap88:1.3":"Caṅkamañca samārūḷho,","tha-ap88:1.4":"nisīdiṃ pācināmukho.","tha-ap88:2.1":"“Pabbate sugataṃ disvā,","tha-ap88:2.2":"phussaṃ jhānarataṃ tadā;","tha-ap88:2.3":"Añjaliṃ paggahetvāna,","tha-ap88:2.4":"raṃsyā cittaṃ pasādayiṃ.","tha-ap88:3.1":"“Dvenavute ito kappe,","tha-ap88:3.2":"yaṃ saññamalabhiṃ tadā;","tha-ap88:3.3":"Duggatiṃ nābhijānāmi,","tha-ap88:3.4":"raṃsisaññāyidaṃ phalaṃ.","tha-ap88:4.1":"“Paṭisambhidā catasso … pe …","tha-ap88:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap88:5.1":"Itthaṃ sudaṃ āyasmā raṃsisaññako thero imā gāthāyo abhāsitthāti.","tha-ap88:6.1":"Dutiyaraṃsisaññakattherassāpadānaṃ chaṭṭhaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2734,"to":2734,"paras":[{"para":2734,"vripara":"35","refs":["tha-ap88:1"],"lines":["So aparabhāge pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>pabbate himavantamhī</b>tiādimāha.","Taṃ sabbaṃ uttānatthamevāti."],"lineRefs":[["tha-ap88:1"],["tha-ap88:1"]]}],"wordLinks":[["tha-ap88:1.1","pabbate himavantamhī",0,0]]},"tika":null,"tika2":null}
