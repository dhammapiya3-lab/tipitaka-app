{"suttaId":"tha-ap88","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4860,4872],"vripara":"35"},"segments":{"tha-ap88:0.3":"Dutiyaraṃsisaññakattheraapadānaṃ","tha-ap88:1.1":"“Pabbate himavantamhi, vākacīradharo ahaṃ;","tha-ap88:1.3":"Caṅkamañca samārūḷho, nisīdiṃ pācināmukho.","tha-ap88:2.1":"“Pabbate sugataṃ disvā, phussaṃ jhānarataṃ tadā;","tha-ap88:2.3":"Añjaliṃ paggahetvāna, raṃsyā cittaṃ pasādayiṃ.","tha-ap88:3.1":"“Dvenavute ito kappe, yaṃ saññamalabhiṃ tadā;","tha-ap88:3.3":"Duggatiṃ nābhijānāmi, raṃsisaññāyidaṃ phalaṃ.","tha-ap88:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap88:5.1":"Itthaṃ sudaṃ āyasmā raṃsisaññako thero imā gāthāyo abhāsitthāti.","tha-ap88:6.1":"Dutiyaraṃsisaññakattherassāpadānaṃ chaṭṭhaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2734,"to":2734,"paras":[{"para":2734,"vripara":"35","refs":["tha-ap88:1"],"lines":["So aparabhāge pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>pabbate himavantamhī</b>tiādimāha.","Taṃ sabbaṃ uttānatthamevāti."],"lineRefs":[["tha-ap88:1"],["tha-ap88:1"]]}],"wordLinks":[["tha-ap88:1.1","pabbate himavantamhī",0,0]]},"tika":null,"tika2":null}
