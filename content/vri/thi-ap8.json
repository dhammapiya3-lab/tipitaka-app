{"suttaId":"thi-ap8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[6752,6810],"vripara":"71"},"segments":{"thi-ap8:0.3":"Sattuppalamālikātherīapadānaṃ","thi-ap8:1.1":"“Nagare aruṇavatiyā,","thi-ap8:1.2":"aruṇo nāma [aruṇavā nāma (sī. pī.)] ttiyo;","thi-ap8:1.3":"Tassa rañño ahuṃ bhariyā,","thi-ap8:1.4":"vāritaṃ vārayāmahaṃ [cārikaṃ cārayāmahaṃ (sī.), na gulaṃ pādayāmahaṃ (syā.), na mālaṃ pādayāmahaṃ (pī.)]. 72.","thi-ap8:2.1":"“Sattamālaṃ gahetvāna,","thi-ap8:2.2":"uppalā devagandhikā;","thi-ap8:2.3":"Nisajja pāsādavare,","thi-ap8:2.4":"evaṃ cintesi tāvade. 73.","thi-ap8:3.1":"“‘Kiṃ me imāhi mālāhi,","thi-ap8:3.2":"sirasāropitāhi me;","thi-ap8:3.3":"Varaṃ me buddhaseṭṭhassa,","thi-ap8:3.4":"ñāṇamhi abhiropitaṃ’. 74.","thi-ap8:4.1":"“Sambuddhaṃ paṭimānentī,","thi-ap8:4.2":"dvārāsanne nisīdahaṃ;","thi-ap8:4.3":"‘Yadā ehiti sambuddho,","thi-ap8:4.4":"pūjayissaṃ mahāmuniṃ’. 75.","thi-ap8:5.1":"“Kakudho vilasantova,","thi-ap8:5.2":"migarājāva kesarī;","thi-ap8:5.3":"Bhikkhusaṅghena sahito,","thi-ap8:5.4":"āgacchi vīthiyā jino. 76.","thi-ap8:6.1":"“Buddhassa raṃsiṃ disvāna,","thi-ap8:6.2":"haṭṭhā saṃviggamānasā;","thi-ap8:6.3":"Dvāraṃ avāpuritvāna [apāpuṇitvā (syā.)],","thi-ap8:6.4":"buddhaseṭṭhamapūjayiṃ. 77.","thi-ap8:7.1":"“Satta uppalapupphāni,","thi-ap8:7.2":"parikiṇṇāni [suvitthiṇṇāni (syā.)] ambare;","thi-ap8:7.3":"Chadiṃ karonto buddhassa,","thi-ap8:7.4":"matthake dhārayanti te. 78.","thi-ap8:8.1":"“Udaggacittā sumanā,","thi-ap8:8.2":"vedajātā katañjalī;","thi-ap8:8.3":"Tattha cittaṃ pasādetvā,","thi-ap8:8.4":"tāvatiṃsamagacchahaṃ. 79.","thi-ap8:9.1":"“Mahānelassa chādanaṃ,","thi-ap8:9.2":"dhārenti mama muddhani;","thi-ap8:9.3":"Dibbagandhaṃ pavāyāmi,","thi-ap8:9.4":"sattuppalassidaṃ phalaṃ. 80.","thi-ap8:10.1":"“Kadāci nīyamānāya,","thi-ap8:10.2":"ñātisaṅghena me tadā;","thi-ap8:10.3":"Yāvatā parisā mayhaṃ,","thi-ap8:10.4":"mahānelaṃ dharīyati. 81.","thi-ap8:11.1":"“Sattati devarājūnaṃ,","thi-ap8:11.2":"mahesittamakārayiṃ;","thi-ap8:11.3":"Sabbattha issarā hutvā,","thi-ap8:11.4":"saṃsarāmi bhavābhave. 82.","thi-ap8:12.1":"“Tesaṭṭhi cakkavattīnaṃ,","thi-ap8:12.2":"mahesittamakārayiṃ;","thi-ap8:12.3":"Sabbe mamanuvattanti,","thi-ap8:12.4":"ādeyyavacanā ahuṃ. 83.","thi-ap8:13.1":"“Uppalasseva me vaṇṇo,","thi-ap8:13.2":"gandho ceva pavāyati;","thi-ap8:13.3":"Dubbaṇṇiyaṃ na jānāmi [duggatiṃ nābhijānāmi (syā. pī.)],","thi-ap8:13.4":"buddhapūjāyidaṃ phalaṃ. 84.","thi-ap8:14.1":"“Iddhipādesu kusalā,","thi-ap8:14.2":"bojjhaṅgabhāvanā ratā;","thi-ap8:14.3":"Abhiññāpāramippattā,","thi-ap8:14.4":"buddhapūjāyidaṃ phalaṃ. 85.","thi-ap8:15.1":"“Satipaṭṭhānakusalā,","thi-ap8:15.2":"samādhijhānagocarā;","thi-ap8:15.3":"Sammappadhānamanuyuttā,","thi-ap8:15.4":"buddhapūjāyidaṃ phalaṃ. 86.","thi-ap8:16.1":"“Vīriyaṃ me dhuradhorayhaṃ,","thi-ap8:16.2":"yogakkhemādhivāhanaṃ;","thi-ap8:16.3":"Sabbāsavaparikkhīṇā,","thi-ap8:16.4":"natthi dāni punabbhavo. 87.","thi-ap8:17.1":"“Ekatiṃse ito kappe,","thi-ap8:17.2":"yaṃ pupphamabhipūjayiṃ;","thi-ap8:17.3":"Duggatiṃ nābhijānāmi,","thi-ap8:17.4":"buddhapūjāyidaṃ phalaṃ. 88.","thi-ap8:18.1":"“Kilesā jhāpitā mayhaṃ…pe…","thi-ap8:18.3":"viharāmi anāsavā. 89.","thi-ap8:19.1":"“Svāgataṃ vata me āsi…pe…","thi-ap8:19.3":"kataṃ buddhassa sāsanaṃ. 90.","thi-ap8:20.1":"“Paṭisambhidā catasso…pe…","thi-ap8:20.3":"kataṃ buddhassa sāsanaṃ”.","thi-ap8:21.1":"Itthaṃ sudaṃ sattuppalamālikā bhikkhunī imā gāthāyo abhāsitthāti.","thi-ap8:22.1":"Sattuppalamālikātheriyāpadānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
