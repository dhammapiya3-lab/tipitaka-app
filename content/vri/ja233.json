{"suttaId":"ja233","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1581,1587],"vripara":"165"},"segments":{"ja233:0.4":"Vikaṇṇajātakaṃ (2-9-3)","ja233:1.1":"Kāmaṃ yahiṃ icchasi tena gaccha,","ja233:1.2":"viddhosi mammamhi [mamasmi (ka.)] vikaṇṇakena;","ja233:1.3":"Hatosi bhattena suvāditena [savāditena (sī. syā. pī.)],","ja233:1.4":"lolo ca macche anubandhamāno. 166.","ja233:2.1":"Evampi lokāmisaṃ opatanto,","ja233:2.2":"vihaññatī cittavasānuvattī;","ja233:2.3":"So haññati ñātisakhāna majjhe,","ja233:2.4":"macchānugo soriva suṃsumāroti [susumāro (ka.)].","ja233:3.1":"Vikaṇṇajātakaṃ tatiyaṃ. 234."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1457,"to":1462,"paras":[{"para":1457,"vripara":null,"refs":["ja233:1"],"lines":["Tattha <b>kāma</b>nti ekaṃsena.","<b>Yahiṃ icchasi tena gacchā</b>ti yasmiṃ icchasi, tasmiṃ gaccha.","<b>Mammamhī</b>ti mammaṭṭhāne.","<b>Vikaṇṇakenā</b>ti vikaṇṇakasallena.","<b>Hatosi bhattena suvāditena, lolo ca macche anubandhamāno</b>ti tvaṃ bherivāditasaññāya bhatte dīyamāne lolo hutvā khādanatthāya macche anubandhamāno tena savāditena bhattena hato, gataṭṭhānepi te jīvitaṃ natthīti attho.","So attano vasanaṭṭhānaṃ gantvā jīvitakkhayaṃ patto."],"lineRefs":[["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"]]},{"para":1458,"vripara":null,"refs":["ja233:1"],"lines":["Satthā imaṃ kāraṇaṃ dassetvā abhisambuddho hutvā dutiyaṃ gāthamāha – 166."],"lineRefs":[["ja233:1"]]},{"para":1460,"vripara":"166","refs":["ja233:1"],"lines":["“Evampi lokāmisaṃ opatanto, vihaññatī cittavasānuvattī;"],"lineRefs":[["ja233:1"]]},{"para":1461,"vripara":null,"refs":["ja233:1"],"lines":["So haññatī ñātisakhāna majjhe, macchānugo soriva suṃsumāro”ti."],"lineRefs":[["ja233:1"]]},{"para":1462,"vripara":null,"refs":["ja233:2"],"lines":["Tattha <b>lokāmisa</b>nti pañca kāmaguṇā.","Te hi loko iṭṭhato kantato manāpato gaṇhāti, tasmā “lokāmisa”nti vuccati.","<b>Opatanto</b>ti taṃ lokāmisaṃ anupatanto kilesavasena cittavasānuvattī puggalo vihaññati kilamati, <b>so haññatī</b>ti so evarūpo puggalo ñātīnañca sakhānañca majjhe so vikaṇṇakena viddho macchānugo suṃsumāro viya pañca kāmaguṇe manāpāti gahetvā haññati kilamati mahāvināsaṃ pāpuṇātiyevāti."],"lineRefs":[["ja233:2"],["ja233:2"],["ja233:2"]]}],"wordLinks":[["ja233:1.1","kāmaṃ",0,0],["ja233:1.1","yahiṃ icchasi tena gacchā",0,1],["ja233:1.1","mammamhī",0,2],["ja233:1.1","vikaṇṇakenā",0,3],["ja233:1.3","hatosi bhattena suvāditena lolo ca macche anubandhamāno",0,4],["ja233:2.1","lokāmisaṃ",4,0],["ja233:2.1","opatanto",4,2],["ja233:2.3","so haññatī",4,2]]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":808,"to":818,"paras":[{"para":808,"vripara":null,"refs":["ja233:1"],"lines":["3-vikaṇṇakajātakavaṇṇanā (233)"],"lineRefs":[["ja233:1"]]},{"para":809,"vripara":null,"refs":["ja233:1"],"lines":["<b>vikaṇṇakasallasadisā</b>ti kaṇṇarahitasallasadisā.","<b>viddhaṃsū</b>ti paviddhaṃsu.","pavijjhiṃsūti attho.","<b>maraṇameva pāpesu</b>nti maraṇaṃyeva āpādayiṃsu."],"lineRefs":[["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"]]},{"para":810,"vripara":null,"refs":["ja233:1"],"lines":["footnote 1.","evaṃ saṃkuṭito.","jā.","ṭṭha.","207."],"lineRefs":[["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"]]},{"para":811,"vripara":null,"refs":["ja233:1"],"lines":["footnote 2.","viddhaṃ.","jā.","ṭṭha.","207."],"lineRefs":[["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"]]},{"para":812,"vripara":null,"refs":["ja233:1"],"lines":["footnote * ācariyassapotthake pana vīṇāruṇajātavaṇṇanāti pāṭho atthi.","<b>naccagītā</b>ti naccagītakārakā.","<b>sukusalā</b>ti atichekā nāṭakā.","naccagītāni payojesunti attho.","<b>gītasaddassā</b>ti gītasadde.","bhūmatthe cetaṃ sāmivacanaṃ.","<b>macchaghaṭa</b>nti macchasamūhaṃ.","tālakkhandhapamāṇavantaṃ macchānaṃ ghaṭanti attho.","<b>devasikaṃ devasika</b>nti divase divase.","divasaṃyeva devasikaṃ.","bahunnaṃ pana atthānaṃ byāpanicchāya dvittaṃ vuttaṃ.","<b>taṇḍulambaṇa</b>nti ambaṇapamāṇaṃ taṇḍulaṃ.","<b>pācetī</b>ti pacāpeti.","pacitvā bhojāpetīti vuttaṃ hoti.","<b>bhattaṃ nassatī</b>ti bhattaṃ vinassati.","<b>bhattakammiko</b>ti bhattadāyako puriso.","<b>mamasmi</b>nti ettha mama niyāmitaṃ ṭhānanti mama.","tasmiṃ mamasminti attho daṭṭhabbo.","<b>tena ca suvāditena bhattenā</b>ti nivāpena tena bhattena ca.","casaddo sampiṇḍanattho.","macchehi ca hatoti vuttaṃ hoti.","<b>lokāmisanti pañca kāmaguṇā</b>ti pañca kāmaguṇā lokānaṃ āmisanato missīkaraṇato lokāmisanti vuccanti.","tenāha — “tehī”tiādi.","tattha hisaddo daḷhīkaraṇajotako.","pāḷiyaṃ — <b>soriva saṃsumāro</b>ti ettha ra-kāro āgamasandhijo.","so saṃsumāro viyāti atthoti dassetuṃ — “saṃsumāro viyā”ti vuttanti."],"lineRefs":[["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"]]},{"para":813,"vripara":null,"refs":["ja233:1"],"lines":["ending vikaṇṇakajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja233:1"]]},{"para":814,"vripara":null,"refs":["ja233:1"],"lines":["footnote 1.","naccagītāsu kusalā.","ṭṭha."],"lineRefs":[["ja233:1"],["ja233:1"],["ja233:1"]]},{"para":815,"vripara":null,"refs":["ja233:1"],"lines":["footnote 2.","gītasaddasmiṃ.","jā.","ṭṭha.","hoṅḥ.","gītasaddalolatāya."],"lineRefs":[["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"]]},{"para":816,"vripara":null,"refs":["ja233:1"],"lines":["footnote 3.","devasikaṃ.","ṭṭha."],"lineRefs":[["ja233:1"],["ja233:1"],["ja233:1"]]},{"para":817,"vripara":null,"refs":["ja233:1"],"lines":["footnote 4.","mammamhi.","ṭṭha.","praññ-syalaññḥrhu."],"lineRefs":[["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"]]},{"para":818,"vripara":null,"refs":["ja233:1"],"lines":["footnote 5.","tena savāditena.","ṭṭha.","208."],"lineRefs":[["ja233:1"],["ja233:1"],["ja233:1"],["ja233:1"]]}],"wordLinks":[]},"tika2":null}
