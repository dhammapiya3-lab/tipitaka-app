{"suttaId":"an4.145","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1202,1202],"vripara":"145"},"segments":{"an4.145:0.3":"Pajjotasuttaṃ","an4.145:1.1":"“Cattārome, bhikkhave, pajjotā.","an4.145:1.2":"Katame cattāro?","an4.145:1.3":"Candapajjoto, sūriyapajjoto, aggipajjoto, paññāpajjoto – ime kho, bhikkhave, cattāro pajjotā.","an4.145:1.5":"Etadaggaṃ, bhikkhave, imesaṃ catunnaṃ pajjotānaṃ yadidaṃ paññāpajjoto”ti.","an4.145:1.6":"Pañcamaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1450,"to":1451,"paras":[{"para":1450,"vripara":"142-145","refs":["an4.145:1"],"lines":["142-145. Dutiyādīsupi pabhāsanavasena candova <b>candappabhā</b>.","Ālokanavasena candova <b>candāloko</b>.","Obhāsanavasena candova <b>candobhāso</b>.","Pajjotanavasena candova <b>candapajjoto</b>ti.","Evaṃ sabbapadesupi attho veditabbo."],"lineRefs":[["an4.145:1"],["an4.145:1"],["an4.145:1"],["an4.145:1"],["an4.145:1"]]},{"para":1451,"vripara":null,"refs":["an4.145:1"],"lines":["Paṭhamakālasuttavaṇṇanā"],"lineRefs":[["an4.145:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1637,"to":1639,"paras":[{"para":1637,"vripara":"141-146","refs":["an4.145:1"],"lines":["141-146. Pañcamassa paṭhamādīni uttānatthāneva."],"lineRefs":[["an4.145:1"]]},{"para":1638,"vripara":null,"refs":[],"lines":["Ābhāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1639,"vripara":null,"refs":["an4.145:1"],"lines":["7-10. Dutiyakālasuttādivaṇṇanā"],"lineRefs":[["an4.145:1"]]}],"wordLinks":[]},"tika2":null}
