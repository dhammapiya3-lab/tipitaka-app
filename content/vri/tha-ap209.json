{"suttaId":"tha-ap209","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7528,7543],"vripara":"30"},"segments":{"tha-ap209:0.3":"Salalamāliyattheraapadānaṃ","tha-ap209:1.1":"“Kaṇikāraṃva jotantaṃ, nisinnaṃ pabbatantare;","tha-ap209:1.3":"Obhāsentaṃ disā sabbā, siddhatthaṃ narasārathiṃ.","tha-ap209:2.1":"“Dhanuṃ advejjhaṃ katvāna, usuṃ sannayhahaṃ tadā;","tha-ap209:2.3":"Pupphaṃ savaṇṭaṃ chetvāna, buddhassa abhiropayiṃ.","tha-ap209:3.1":"“Catunnavutito kappe, yaṃ pupphamabhiropayiṃ;","tha-ap209:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap209:4.1":"“Ekapaññāsito kappe, eko āsiṃ jutindharo;","tha-ap209:4.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap209:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap209:6.1":"Itthaṃ sudaṃ āyasmā salalamāliyo thero imā gāthāyo abhāsitthāti.","tha-ap209:7.1":"Salalamāliyattherassāpadānaṃ sattamaṃ."},"attha":null,"tika":null}
