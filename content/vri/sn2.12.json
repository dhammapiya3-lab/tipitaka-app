{"suttaId":"sn2.12","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1028,1034],"vripara":"93"},"segments":{"sn2.12:0.3":"Veṇḍusuttaṃ","sn2.12:1.1":"Ekamantaṃ ṭhito kho veṇḍu [veṇhu (sī.)] devaputto bhagavato santike imaṃ gāthaṃ abhāsi –","sn2.12:2.1":"“Sukhitāva te [sukhitā vata te (sī. syā. kaṃ.)] manujā,","sn2.12:2.2":"sugataṃ payirupāsiya;","sn2.12:2.3":"Yuñjaṃ [yujja (sī.), yuñja (syā. kaṃ. pī.)] gotamasāsane,","sn2.12:2.4":"appamattā nu sikkhare”ti.","sn2.12:3.1":"“Ye me pavutte siṭṭhipade [satthipade (sī. syā. kaṃ. pī.)]","sn2.12:3.2":"(veṇḍūti bhagavā),","sn2.12:3.3":"Anusikkhanti jhāyino;","sn2.12:3.4":"Kāle te appamajjantā,","sn2.12:3.5":"Na maccuvasagā siyun”ti."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":535,"to":535,"paras":[{"para":535,"vripara":"93","refs":["sn2.12:1","sn2.12:2","sn2.12:3"],"lines":["Dutiye <b>veṇḍū</b>ti tassa devaputtassa nāmaṃ.","<b>Payirupāsiyā</b>ti parirupāsitvā.","<b>Anusikkhare</b>ti sikkhanti.","<b>Siṭṭhipade</b>ti anusiṭṭhipade.","<b>Kāle te appamajjantā</b>ti kāle te appamādaṃ karontā.","Dutiyaṃ."],"lineRefs":[["sn2.12:1"],["sn2.12:2"],["sn2.12:2"],["sn2.12:3"],["sn2.12:3"],["sn2.12:3"]]}],"wordLinks":[["sn2.12:1.1","veṇḍū",0,0],["sn2.12:2.1","payirupāsiyā",0,1],["sn2.12:3.1","siṭṭhipade",0,3],["sn2.12:3.4","kāle te appamajjantā",0,4]],"before":[{"para":534,"vripara":null,"title":"Veṇḍusuttavaṇṇanā","lines":["Veṇḍusuttavaṇṇanā"]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":678,"to":678,"paras":[{"para":678,"vripara":"93","refs":["sn2.12:2","sn2.12:3"],"lines":["<b>Payirupāsiyā</b>ti payirupāsahetu.","<b>Sikkhantī</b>ti tissopi sikkhā sikkhanti.","<b>Siṭṭhipade</b>ti kilesānaṃ sāsanato vaṭṭadukkhaparittāsanato ca siṭṭhisaññite yathānusiṭṭhaṃ paṭipajjitabbato pade, saddhammeti attho.","Tenāha <b>“anusiṭṭhipade”</b>ti.","Tattha <b>anusiṭṭhī</b>ti saddhammo.","<b>Kāle</b>ti yuttapattakāle.","<b>Appamādo</b> nāma samathavipassanābhāvanā."],"lineRefs":[["sn2.12:2"],["sn2.12:3"],["sn2.12:3"],["sn2.12:3"],["sn2.12:3"],["sn2.12:3"],["sn2.12:3"]]}],"wordLinks":[["sn2.12:2.1","payirupāsiyā",0,0],["sn2.12:3.3","sikkhantī",0,1],["sn2.12:3.1","siṭṭhipade",0,2],["sn2.12:3.4","kāle",0,5]],"before":[{"para":677,"vripara":null,"title":"Veṇḍusuttavaṇṇanā","lines":["Veṇḍusuttavaṇṇanā"]}],"after":[{"para":679,"vripara":null,"title":"Veṇḍusuttavaṇṇanā","lines":["Veṇḍusuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
