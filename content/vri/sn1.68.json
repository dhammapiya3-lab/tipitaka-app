{"suttaId":"sn1.68","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[768,772],"vripara":"68"},"segments":{"sn1.68:0.3":"Pihitasuttaṃ","sn1.68:1.1":"“Kenassu pihito loko,","sn1.68:1.2":"kismiṃ loko patiṭṭhito;","sn1.68:1.3":"Kenassu uḍḍito loko,","sn1.68:1.4":"kenassu parivārito”ti.","sn1.68:2.1":"“Maccunā pihito loko,","sn1.68:2.2":"dukkhe loko patiṭṭhito;","sn1.68:2.3":"Taṇhāya uḍḍito loko,","sn1.68:2.4":"jarāya parivārito”ti. 9."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":469,"to":469,"paras":[{"para":469,"vripara":"68","refs":["sn1.68:1"],"lines":["Aṭṭhame sveva pañho devatāya heṭṭhupariyāyavasena pucchito.","Aṭṭhamaṃ. 69."],"lineRefs":[["sn1.68:1"],["sn1.68:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":581,"to":583,"paras":[{"para":581,"vripara":"68","refs":["sn1.68:1"],"lines":["<b>Pañho</b>ti ñātuṃ icchito attho.","<b>Pucchito</b>ti sattamasutte gāthāya purimaddhaṃ pacchimaddhaṃ, pacchimaṃ purimaṃ katvā aṭṭhamasutte devatāya pucchitattā vuttaṃ <b>“heṭṭhupariyāyavasena pucchito”</b>ti.","Pucchānurūpaṃ vissajjananti avuttampi siddhametanti anāhaṭaṃ."],"lineRefs":[["sn1.68:1"],["sn1.68:1"],["sn1.68:1"]]},{"para":582,"vripara":null,"refs":["sn1.68:1"],"lines":["Pihitasuttavaṇṇanā niṭṭhitā. 9."],"lineRefs":[["sn1.68:1"]]},{"para":583,"vripara":null,"refs":["sn1.68:1"],"lines":["Icchāsuttavaṇṇanā 69."],"lineRefs":[["sn1.68:1"]]}],"wordLinks":[],"before":[{"para":580,"vripara":null,"title":"Pihitasuttavaṇṇanā","lines":["Pihitasuttavaṇṇanā 68."]}]},"tika2":null}
