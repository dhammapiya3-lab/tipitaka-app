{"suttaId":"sn1.68","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[768,772],"vripara":"68"},"segments":{"sn1.68:0.3":"Pihitasuttaṃ","sn1.68:1.1":"“Kenassu pihito loko, kismiṃ loko patiṭṭhito;","sn1.68:1.3":"Kenassu uḍḍito loko, kenassu parivārito”ti.","sn1.68:2.1":"“Maccunā pihito loko, dukkhe loko patiṭṭhito;","sn1.68:2.3":"Taṇhāya uḍḍito loko, jarāya parivārito”ti."},"attha":null,"tika":null}
