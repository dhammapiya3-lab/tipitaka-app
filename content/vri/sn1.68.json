{"suttaId":"sn1.68","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[768,772],"vripara":"68"},"segments":{"sn1.68:0.3":"Pihitasuttaṃ","sn1.68:1.1":"“Kenassu pihito loko, kismiṃ loko patiṭṭhito;","sn1.68:1.3":"Kenassu uḍḍito loko, kenassu parivārito”ti.","sn1.68:2.1":"“Maccunā pihito loko, dukkhe loko patiṭṭhito;","sn1.68:2.3":"Taṇhāya uḍḍito loko, jarāya parivārito”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":469,"to":469,"paras":[{"para":469,"vripara":"68","refs":["sn1.68:1"],"lines":["Aṭṭhame sveva pañho devatāya heṭṭhupariyāyavasena pucchito.","Aṭṭhamaṃ."],"lineRefs":[["sn1.68:1"],["sn1.68:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":581,"to":583,"paras":[{"para":581,"vripara":"68","refs":["sn1.68:1"],"lines":["<b>Pañho</b>ti ñātuṃ icchito attho.","<b>Pucchito</b>ti sattamasutte gāthāya purimaddhaṃ pacchimaddhaṃ, pacchimaṃ purimaṃ katvā aṭṭhamasutte devatāya pucchitattā vuttaṃ <b>“heṭṭhupariyāyavasena pucchito”</b>ti.","Pucchānurūpaṃ vissajjananti avuttampi siddhametanti anāhaṭaṃ."],"lineRefs":[["sn1.68:1"],["sn1.68:1"],["sn1.68:1"]]},{"para":582,"vripara":null,"refs":[],"lines":["Pihitasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":583,"vripara":null,"refs":["sn1.68:1"],"lines":["Icchāsuttavaṇṇanā"],"lineRefs":[["sn1.68:1"]]}],"wordLinks":[]},"tika2":null}
