{"suttaId":"tha-ap152","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6427,6447],"vripara":"48"},"segments":{"tha-ap152:0.3":"Pallaṅkadāyakattheraapadānaṃ","tha-ap152:1.1":"“Sumedhassa bhagavato, lokajeṭṭhassa tādino;","tha-ap152:1.3":"Pallaṅko hi mayā dinno, sauttarasapacchado.","tha-ap152:2.1":"“Sattaratanasampanno, pallaṅko āsi so tadā;","tha-ap152:2.3":"Mama saṅkappamaññāya, nibbattati sadā mama.","tha-ap152:3.1":"“Tiṃsakappasahassamhi, pallaṅkamadadiṃ tadā;","tha-ap152:3.3":"Duggatiṃ nābhijānāmi, pallaṅkassa idaṃ phalaṃ.","tha-ap152:4.1":"“Vīsakappasahassamhi, suvaṇṇābhā tayo janā;","tha-ap152:4.3":"Sattaratanasampannā, cakkavattī mahabbalā.","tha-ap152:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap152:6.1":"Itthaṃ sudaṃ āyasmā pallaṅkadāyako thero imā gāthāyo abhāsitthāti.","tha-ap152:7.1":"Pallaṅkadāyakattherassāpadānaṃ dasamaṃ.","tha-ap152:8.1":"Chattavaggo pannarasamo.","tha-ap152:9.1":"Tassuddānaṃ –","tha-ap152:10.1":"Chattaṃ thambho ca vedi ca, parivārumapupphiyo;","tha-ap152:10.3":"Anulepo ca maggo ca, phalako ca vaṭaṃsako;","tha-ap152:10.5":"Pallaṅkadāyī ca gāthāyo, chappaññāsa pakittitāti."},"attha":null,"tika":null}
