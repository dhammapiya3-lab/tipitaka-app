{"suttaId":"tha-ap251","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8217,8229],"vripara":"30"},"segments":{"tha-ap251:0.3":"Bimbijāliyattheraapadānaṃ","tha-ap251:1.1":"“Padumuttaro nāma jino, sayambhū aggapuggalo;","tha-ap251:1.3":"Catusaccaṃ pakāseti, dīpeti amataṃ padaṃ.","tha-ap251:2.1":"“Bimbijālakapupphāni [bimbajālakapupphāni (ka.)], puthu katvānahaṃ tadā;","tha-ap251:2.3":"Buddhassa abhiropesiṃ, dvipadindassa tādino.","tha-ap251:3.1":"“Aṭṭhasaṭṭhimhito kappe, caturo kiñjakesarā;","tha-ap251:3.3":"Sattaratanasampannā, cakkavattī mahabbalā.","tha-ap251:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap251:5.1":"Itthaṃ sudaṃ āyasmā bimbijāliyo thero imā gāthāyo abhāsitthāti.","tha-ap251:6.1":"Bimbijāliyattherassāpadānaṃ navamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3205,"to":3205,"paras":[{"para":3205,"vripara":"31","refs":["tha-ap251:2"],"lines":["Navamāpadāne <b>bimbijālakapupphānī</b>ti rattaṅkuravakapupphāni siddhatthassa bhagavato pūjesinti attho."],"lineRefs":[["tha-ap251:2"]]}],"wordLinks":[["tha-ap251:2.1","bimbijālakapupphānī",0,0]]},"tika":null,"tika2":null}
