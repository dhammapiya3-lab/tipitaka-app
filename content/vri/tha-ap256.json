{"suttaId":"tha-ap256","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8294,8306],"vripara":"13"},"segments":{"tha-ap256:0.3":"Ticampakapupphiyattheraapadānaṃ","tha-ap256:1.1":"“Himavantassāvidūre,","tha-ap256:1.2":"vikato [vikano (sī. syā.)] nāma pabbato;","tha-ap256:1.3":"Tassa vemajjhe vasati,","tha-ap256:1.4":"samaṇo bhāvitindriyo.","tha-ap256:2.1":"“Disvāna tassopasamaṃ,","tha-ap256:2.2":"vippasannena cetasā;","tha-ap256:2.3":"Tīṇi campakapupphāni,","tha-ap256:2.4":"gahetvāna samokiriṃ.","tha-ap256:3.1":"“Ekanavutito kappe,","tha-ap256:3.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap256:3.3":"Duggatiṃ nābhijānāmi,","tha-ap256:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap256:4.1":"“Paṭisambhidā catasso … pe …","tha-ap256:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap256:5.1":"Itthaṃ sudaṃ āyasmā ticampakapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap256:6.1":"Ticampakapupphiyattherassāpadānaṃ catutthaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
