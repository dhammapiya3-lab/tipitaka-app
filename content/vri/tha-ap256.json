{"suttaId":"tha-ap256","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8294,8306],"vripara":"13"},"segments":{"tha-ap256:0.3":"Ticampakapupphiyattheraapadānaṃ","tha-ap256:1.1":"“Himavantassāvidūre, vikato [vikano (sī. syā.)] nāma pabbato;","tha-ap256:1.3":"Tassa vemajjhe vasati, samaṇo bhāvitindriyo.","tha-ap256:2.1":"“Disvāna tassopasamaṃ, vippasannena cetasā;","tha-ap256:2.3":"Tīṇi campakapupphāni, gahetvāna samokiriṃ.","tha-ap256:3.1":"“Ekanavutito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap256:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap256:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap256:5.1":"Itthaṃ sudaṃ āyasmā ticampakapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap256:6.1":"Ticampakapupphiyattherassāpadānaṃ catutthaṃ."},"attha":null,"tika":null,"tika2":null}
