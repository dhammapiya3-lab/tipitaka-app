{"suttaId":"sn47.85-94","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1135,1140],"vripara":"451-460"},"segments":{"sn47.85-94:0.3":"Esanāvaggo","sn47.85-94:1.1":"1-10. Esanādisuttadasakaṃ 451-460. Tisso imā, bhikkhave, esanā.","sn47.85-94:1.2":"Katamā tisso?","sn47.85-94:1.3":"Kāmesanā, bhavesanā, brahmacariyesanāti vitthāretabbaṃ.","sn47.85-94:1.5":"Esanāvaggo navamo.","sn47.85-94:2.0":"Tassuddānaṃ –","sn47.85-94:2.1":"Esanā vidhā āsavo, bhavo ca dukkhatā tisso;","sn47.85-94:2.3":"Khilaṃ malañca nīgho ca, vedanā taṇhā tasināya cāti."},"attha":null,"tika":null}
