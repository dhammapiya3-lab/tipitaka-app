{"suttaId":"tha-ap182","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6990,7007],"vripara":"45"},"segments":{"tha-ap182:0.3":"Saṅghupaṭṭhākattheraapadānaṃ","tha-ap182:1.1":"“Vessabhumhi bhagavati,","tha-ap182:1.2":"ahosārāmiko ahaṃ;","tha-ap182:1.3":"Pasannacitto sumano,","tha-ap182:1.4":"upaṭṭhiṃ saṅghamuttamaṃ.","tha-ap182:2.1":"“Ekattiṃse ito kappe,","tha-ap182:2.2":"yaṃ kammamakariṃ tadā;","tha-ap182:2.3":"Duggatiṃ nābhijānāmi,","tha-ap182:2.4":"upaṭṭhānassidaṃ phalaṃ.","tha-ap182:3.1":"“Ito te sattame kappe,","tha-ap182:3.2":"sattevāsuṃ samodakā;","tha-ap182:3.3":"Sattaratanasampannā,","tha-ap182:3.4":"cakkavattī mahabbalā.","tha-ap182:4.1":"“Paṭisambhidā catasso … pe …","tha-ap182:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap182:5.1":"Itthaṃ sudaṃ āyasmā saṅghupaṭṭhāko thero imā gāthāyo abhāsitthāti.","tha-ap182:6.1":"Saṅghupaṭṭhākattherassāpadānaṃ dasamaṃ.","tha-ap182:7.1":"Kumudavaggo aṭṭhārasamo.","tha-ap182:8.1":"Tassuddānaṃ –","tha-ap182:9.1":"Kumudo atha nisseṇī,","tha-ap182:9.2":"rattiko udapānado;","tha-ap182:9.3":"Sīhāsanī maggadado,","tha-ap182:9.4":"ekadīpī maṇippado;","tha-ap182:9.5":"Tikicchako upaṭṭhāko,","tha-ap182:9.6":"ekapaññāsa gāthakāti."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3161,"to":3161,"paras":[{"para":3161,"vripara":"45","refs":["tha-ap182:1"],"lines":["So ekadivasaṃ “pubbe mayā kiṃ nāma kammaṃ katvā ayaṃ lokuttarasampatti laddhā”ti attano pubbakammaṃ saritvā paccakkhato jānitvā somanassajāto pubbacaritāpadānaṃ pākaṭaṃ karonto <b>vessabhumhi bhagavatī</b>tiādimāha.","Tattha <b>ahosārāmiko ahan</b>ti ahaṃ vessabhussa bhagavato sāsane ārāmiko ahosinti attho.","Sesaṃ heṭṭhā vuttanayattā uttānatthattā ca suviññeyyamevāti."],"lineRefs":[["tha-ap182:1"],["tha-ap182:1"],["tha-ap182:1"]]}],"wordLinks":[["tha-ap182:1.1","vessabhumhi bhagavatī",0,0],["tha-ap182:1.1","ahosārāmiko ahaṃ",0,1]]},"tika":null,"tika2":null}
