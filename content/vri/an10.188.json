{"suttaId":"an10.188","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[1425,1427],"vripara":"188"},"segments":{"an10.188:0.3":"Vipākasuttaṃ","an10.188:1.1":"“Dukkhavipākañca vo, bhikkhave, dhammaṃ desessāmi sukhavipākañca.","an10.188:1.2":"Taṃ suṇātha … pe …","an10.188:1.3":"katamo ca, bhikkhave, dukkhavipāko dhammo?","an10.188:1.4":"Pāṇātipāto … pe …","an10.188:1.5":"micchādiṭṭhi –","an10.188:1.6":"ayaṃ vuccati, bhikkhave, dukkhavipāko dhammo.","an10.188:2.1":"“Katamo ca, bhikkhave, sukhavipāko dhammo?","an10.188:2.2":"Pāṇātipātā veramaṇī … pe …","an10.188:2.3":"sammādiṭṭhi –","an10.188:2.4":"ayaṃ vuccati, bhikkhave, sukhavipāko dhammo”ti.","an10.188:2.5":"Ekādasamaṃ.","an10.188:2.6":"Sādhuvaggo tatiyo."},"unsure":[],"attha":null,"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":765,"to":769,"paras":[{"para":765,"vripara":"167-210","refs":["an10.188:1"],"lines":["167-210. Dutiye ca paṭhamādīni uttānatthāni.","Dasame <b>pacchābhūmivāsino</b>ti paccantadesavāsino.","<b>Sevālamālikā</b>ti pātova udakaṃ orohitvā sevālañceva uppalādīni ca gahetvā attano udakasuddhikabhāvajānanatthañceva “lokassa ca udakena suddhi hotī”ti imassa atthassa jānanatthañca mālaṃ katvā pilandhanakā.","<b>Udakorohakā</b>ti pāto majjhanhe sāyanhe ca udakaorohaṇakā.","Tenāha <b>“sāyatatiyakaṃ udakorohaṇānuyogamanuyuttā”</b>ti.","Ekādasamādīni uttānatthāni.","Catutthe paṇṇāsake natthi vattabbaṃ."],"lineRefs":[["an10.188:1"],["an10.188:1"],["an10.188:1"],["an10.188:1"],["an10.188:1"],["an10.188:1"],["an10.188:1"]]},{"para":766,"vripara":null,"refs":["an10.188:1"],"lines":["Brāhmaṇapaccorohaṇīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an10.188:1"]]},{"para":767,"vripara":null,"refs":["an10.188:1"],"lines":["Catutthapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an10.188:1"]]},{"para":768,"vripara":null,"refs":["an10.188:1"],"lines":["(21)1. Karajakāyavaggo"],"lineRefs":[["an10.188:1"]]},{"para":769,"vripara":null,"refs":["an10.188:1"],"lines":["1-536. Paṭhamanirayasaggasuttādivaṇṇanā"],"lineRefs":[["an10.188:1"]]}],"wordLinks":[]},"tika2":null}
