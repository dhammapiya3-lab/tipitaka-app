{"suttaId":"ja240","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1639,1652],"vripara":"179"},"segments":{"ja240:0.4":"Mahāpiṅgalajātakaṃ (2-9-10)","ja240:1.1":"Sabbo jano hiṃsito piṅgalena,","ja240:1.2":"tasmiṃ mate paccayā [paccayaṃ (sī. syā. pī.)] vedayanti;","ja240:1.3":"Piyo nu te āsi akaṇhanetto,","ja240:1.4":"kasmā nu tvaṃ rodasi dvārapāla.","ja240:2.1":"Na me piyo āsi akaṇhanetto,","ja240:2.2":"bhāyāmi paccāgamanāya tassa;","ja240:2.3":"Ito gato hiṃseyya maccurājaṃ,","ja240:2.4":"so hiṃsito āneyya puna idha.","ja240:3.1":"Daḍḍho vāhasahassehi,","ja240:3.2":"sitto ghaṭasatehi so;","ja240:3.3":"Parikkhatā ca sā bhūmi,","ja240:3.4":"mā bhāyi nāgamissatīti.","ja240:4.1":"Mahāpiṅgalajātakaṃ dasamaṃ.","ja240:4.2":"Upāhanavaggo navamo.","ja240:5.1":"Tassuddānaṃ –","ja240:6.1":"Varupāhana khujja vikaṇṇakako,","ja240:6.2":"asitābhuya pañcamavacchanakho;","ja240:6.3":"Dija pemavaruttamaekapadaṃ,","ja240:6.4":"kumināmukha piṅgalakena dasāti."},"unsure":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1568,"to":1568,"paras":[{"para":1568,"vripara":null,"refs":["ja240:1"],"lines":["Tattha <b>hiṃsito</b>ti nānappakārehi daṇḍabaliādīhi pīḷito.","<b>Piṅgalenā</b>ti piṅgalakkhena.","Tassa kira dvepi akkhīni nibbiddhapiṅgalāni biḷārakkhivaṇṇāni ahesuṃ, tenevassa “piṅgalo”ti nāmaṃ akaṃsu.","<b>Paccayā vedayantī</b>ti pītiyo pavedayanti.","<b>Akaṇhanetto</b>ti piṅgalanetto.","<b>Kasmā nu tvan</b>ti kena nu kāraṇena tvaṃ rodasi.","Aṭṭhakathāyaṃ pana “kasmā tuvan”ti pāṭho."],"lineRefs":[["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"]]}],"wordLinks":[["ja240:1.1","hiṃsito",0,0],["ja240:1.1","piṅgalenā",0,1],["ja240:1.1","paccayā vedayantī",0,3],["ja240:1.3","akaṇhanetto",0,4],["ja240:1.3","kasmā nu tvaṃ",0,5]]},"tika":null,"tika2":null}
