{"suttaId":"ja240","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1639,1652],"vripara":"179"},"segments":{"ja240:0.4":"Mahāpiṅgalajātakaṃ (2-9-10)","ja240:1.1":"Sabbo jano hiṃsito piṅgalena,","ja240:1.2":"tasmiṃ mate paccayā [paccayaṃ (sī. syā. pī.)] vedayanti;","ja240:1.3":"Piyo nu te āsi akaṇhanetto,","ja240:1.4":"kasmā nu tvaṃ rodasi dvārapāla. 180.","ja240:2.1":"Na me piyo āsi akaṇhanetto,","ja240:2.2":"bhāyāmi paccāgamanāya tassa;","ja240:2.3":"Ito gato hiṃseyya maccurājaṃ,","ja240:2.4":"so hiṃsito āneyya puna idha. 181.","ja240:3.1":"Daḍḍho vāhasahassehi,","ja240:3.2":"sitto ghaṭasatehi so;","ja240:3.3":"Parikkhatā ca sā bhūmi,","ja240:3.4":"mā bhāyi nāgamissatīti.","ja240:4.1":"Mahāpiṅgalajātakaṃ dasamaṃ.","ja240:4.2":"Upāhanavaggo navamo.","ja240:5.1":"Tassuddānaṃ –","ja240:6.1":"Varupāhana khujja vikaṇṇakako,","ja240:6.2":"asitābhuya pañcamavacchanakho;","ja240:6.3":"Dija pemavaruttamaekapadaṃ,","ja240:6.4":"kumināmukha piṅgalakena dasāti. 10."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1568,"to":1568,"paras":[{"para":1568,"vripara":null,"refs":["ja240:1"],"lines":["Tattha <b>hiṃsito</b>ti nānappakārehi daṇḍabaliādīhi pīḷito.","<b>Piṅgalenā</b>ti piṅgalakkhena.","Tassa kira dvepi akkhīni nibbiddhapiṅgalāni biḷārakkhivaṇṇāni ahesuṃ, tenevassa “piṅgalo”ti nāmaṃ akaṃsu.","<b>Paccayā vedayantī</b>ti pītiyo pavedayanti.","<b>Akaṇhanetto</b>ti piṅgalanetto.","<b>Kasmā nu tva</b>nti kena nu kāraṇena tvaṃ rodasi.","Aṭṭhakathāyaṃ pana “kasmā tuva”nti pāṭho."],"lineRefs":[["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"]]}],"wordLinks":[["ja240:1.1","hiṃsito",0,0],["ja240:1.1","piṅgalenā",0,1],["ja240:1.1","paccayā vedayantī",0,3],["ja240:1.3","akaṇhanetto",0,4],["ja240:1.3","kasmā nu tvaṃ",0,5]]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":853,"to":863,"paras":[{"para":853,"vripara":null,"refs":["ja240:1"],"lines":["10-mahāpiṅgalajātakavaṇṇanā (240)"],"lineRefs":[["ja240:1"]]},{"para":854,"vripara":null,"refs":["ja240:1"],"lines":["<b>devadatte</b>tipadaṃ pathaviyaṃ nimuggeti sambandho.","<b>buddhapaṭikaṇṭako</b>ti buddhassa paṭikaṇṭako buddhassa paṭipakkhoti attho.","paṭipakkhoti kaṇṭaka-sadisattā kaṇṭakoti vuccati.","paṭipakkhavasena kaṇṭako paṭikaṇṭako-ti attho.","<b>nihatapaccāmitto</b>ti apagatapaccāmitto.","vigataveroti-"],"lineRefs":[["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"]]},{"para":855,"vripara":null,"refs":["ja240:1"],"lines":["footnote 1.","tava padesaṃ.","jā.","ṭṭha.","219."],"lineRefs":[["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"]]},{"para":856,"vripara":null,"refs":["ja240:1"],"lines":["footnote 2.","aṭṭhakathāyaṃ vilumpatīti mūlapāṭho.","vilumpateti visadisapāṭho.","ācariyassa potthake pana viluppateti mūlapāṭho.","vilumpateti visadisapāṭho bhaveyya.","tasmā evaṃ saṃvaṇṇitaṃ."],"lineRefs":[["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"]]},{"para":857,"vripara":null,"refs":["ja240:1"],"lines":["footnote 3.","vilumpana.","ṭṭha.219.","attho.","<b>paramparaghosenā</b>ti paraṃparāgataravena.","<b>yakkhabhūtadevagaṇā-</b>ti ettha bhūtasaddena gandhabbadevā gahitā.","devasaddena pana avasesadevā."],"lineRefs":[["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"]]},{"para":858,"vripara":null,"refs":["ja240:1"],"lines":["<b>daṇḍabalijaṅghakahāpaṇādiggahaṇenā</b>ti ettha daṇḍo nāma vadhabandhanādidaṇḍo ceva dhanadaṇḍo ca.","bali nāma khettavatthuādīsu uppannaāyo.","jaṅghakahāpaṇaṃ nāma maggapaṭipannānaṃ santikā uppannakahāpaṇaṃ.","ādisaddena avacchinnadāyajjapaṭiggāhakānaṃ santakādayo saṅgahitabbā.","tesaṃ daṇḍabalijaṅghakahāpaṇādīnaṃ attano pattabhāgato adhika-vasena gahaṇena.","ettha ca yaṃ yaṃ vattabbaṃ.","taṃ taṃ upari tikanipāte garudhamma- jātake vakkhāmāti.","<b>ucchughatehī</b>ti ucchupīḷanayantehi.","<b>anuddayāmattampi nāmā</b>ti kāruññacittamattampi nāma assa rañño natthīti attho.","<b>dārūnaṃ sakaṭasahassenā</b>ti haṭṭhatuṭṭhavasena sakaṭasahassamattadārūhi mahā-piṅgalaṃ jhāpetvā."],"lineRefs":[["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"]]},{"para":859,"vripara":null,"refs":["ja240:1"],"lines":["<b>raṭṭhikadovārikādayo cā</b>ti senāpatidovārikādayo ca.","senāpati hi raṭṭhassa sāmi.","anu sāmikattā raṭṭhasāmikoti vuccati.","<b>assāsanto</b>ti dīghavasena assāsaṃ karonto parodi.","<b>ussava</b>nti chaṇaṃ.","<b>nibbiddhapiṅgalānī</b>ti vinibbiddhapiṅgalāni ekaghanakaḷāravaṇṇānīti attho.","<b>biḷārakkhivaṇṇānī</b>ti biḷārassa akkhinā samānavaṇṇāni.","<b>paccayā</b>ti anu-lomavasena ayanti pavattantīti paccayā.","pītiyo.","tenāha — “pītiyo pavedayantī”ti.","<b>pavedayantī</b>ti uppajjanti pavattantīti attho.","<b>akaṇha-netto</b>ti ettha kiñcāpi akaṇhasaddena sukkādayopi gahetabbā.","akkhīnaṃ pana kaṇhaṭṭhāne vikāravasena piṅgalavaṇṇassa pavattanato piṅgalavaṇṇova gahetabbo.","piṅgalavaṇṇo hi sukkādīhipi añño samānopi kaṇhaṭṭhāne pavattanattā akaṇhoticceva vutto."],"lineRefs":[["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"]]},{"para":860,"vripara":null,"refs":["ja240:1"],"lines":["<b>kammāramuṭṭhikāyā</b>ti kammārassa ayomayamuddhani.","<b>aṭṭhaṭṭhaka</b>nti aṭṭhavāraṃ aṭṭhavāraṃ."],"lineRefs":[["ja240:1"],["ja240:1"]]},{"para":861,"vripara":null,"refs":["ja240:1"],"lines":["footnote 1.","aṭṭhaṭṭhaṃ.","jā.","ṭṭha.","221.","<b>khaṭaka</b>nti paharaṇaṃ.","khaṭa-sampakāreti muddhajapaṭhamakkharanta-dhātu.","<b>maccurāja</b>nti yamarājānaṃ sandhāyāha.","me akaṇhanettā piyo na āsi.","tassa akaṇhanettassa paccāgamanāya bhāyāmi.","ito gato maccurājaṃ hiṃseyya.","hiṃsito so maccurājā puna idha āneyyāti pāḷiyojanā.","<b>vāhasakaṭasahassenā</b>ti vāhasaṅkhātasakaṭasahassena.","<b>sāpissa āḷāhanabhūmī</b>ti assa rañño sā jhāpanasusānabhūmi-samantato khaṇitāti attho.","ettha ca kiñcāpi imasmiṃ jātake tisso gāthā sandissanti.","tatiyagāthāya pana pāḷiyaṃ anāruḷhattā.","aṭṭhakathāyeva pana āruḷhattā.","tikanipāte idaṃ asaṅgahetvā dukanipāteyeva saṅgahitanti."],"lineRefs":[["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"],["ja240:1"]]},{"para":862,"vripara":null,"refs":["ja240:1"],"lines":["ending mahāpiṅgalajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja240:1"]]},{"para":863,"vripara":null,"refs":["ja240:1"],"lines":["ending upāhanavaggo navamo."],"lineRefs":[["ja240:1"]]}],"wordLinks":[]},"tika2":null}
