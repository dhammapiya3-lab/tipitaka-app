{"suttaId":"an5.40","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[262,275],"vripara":"40"},"segments":{"an5.40:0.3":"Mahāsālaputtasuttaṃ","an5.40:1.1":"“Himavantaṃ, bhikkhave, pabbatarājaṃ nissāya mahāsālā pañcahi vaḍḍhīhi vaḍḍhanti.","an5.40:1.2":"Katamāhi pañcahi?","an5.40:1.3":"Sākhāpattapalāsena vaḍḍhanti;","an5.40:1.4":"tacena vaḍḍhanti;","an5.40:1.5":"papaṭikāya vaḍḍhanti;","an5.40:1.6":"pheggunā vaḍḍhanti;","an5.40:1.7":"sārena vaḍḍhanti.","an5.40:1.8":"Himavantaṃ, bhikkhave, pabbatarājaṃ nissāya mahāsālā imāhi pañcahi vaḍḍhīhi vaḍḍhanti.","an5.40:1.9":"Evamevaṃ kho, bhikkhave, saddhaṃ kulaputtaṃ nissāya antojano pañcahi vaḍḍhīhi vaḍḍhati.","an5.40:1.10":"Katamāhi pañcahi?","an5.40:1.11":"Saddhāya vaḍḍhati;","an5.40:1.12":"sīlena vaḍḍhati;","an5.40:1.13":"sutena vaḍḍhati;","an5.40:1.14":"cāgena vaḍḍhati;","an5.40:1.15":"paññāya vaḍḍhati.","an5.40:1.16":"Saddhaṃ, bhikkhave, kulaputtaṃ nissāya antojano imāhi pañcahi vaḍḍhīhi vaḍḍhatī”ti.","an5.40:2.1":"“Yathā hi pabbato selo,","an5.40:2.2":"araññasmiṃ brahāvane;","an5.40:2.3":"Taṃ rukkhā upanissāya,","an5.40:2.4":"vaḍḍhante te vanappatī.","an5.40:3.1":"“Tatheva sīlasampannaṃ,","an5.40:3.2":"saddhaṃ kulaputtaṃ imaṃ [kulapatiṃ idha (sī.), kulaputtaṃ idha (syā.)];","an5.40:3.3":"Upanissāya vaḍḍhanti,","an5.40:3.4":"puttadārā ca bandhavā;","an5.40:3.5":"Amaccā ñātisaṅghā ca,","an5.40:3.6":"ye cassa anujīvino.","an5.40:4.1":"“Tyassa sīlavato sīlaṃ,","an5.40:4.2":"cāgaṃ sucaritāni ca;","an5.40:4.3":"Passamānānukubbanti,","an5.40:4.4":"ye bhavanti vicakkhaṇā.","an5.40:5.1":"“Imaṃ dhammaṃ caritvāna,","an5.40:5.2":"maggaṃ [saggaṃ (syā. ka.)] sugatigāminaṃ;","an5.40:5.3":"Nandino devalokasmiṃ,","an5.40:5.4":"modanti kāmakāmino”ti.","an5.40:5.5":"dasamaṃ;","an5.40:5.6":"Sumanavaggo catuttho.","an5.40:6.0":"Tassuddānaṃ –","an5.40:6.1":"Sumanā cundī uggaho,","an5.40:6.2":"sīho dānānisaṃsako;","an5.40:6.3":"Kālabhojanasaddhā ca,","an5.40:6.4":"puttasālehi te dasāti."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":108,"to":108,"paras":[{"para":108,"vripara":"40","refs":["an5.40:1","an5.40:2"],"lines":["Dasame <b>mahāsālā</b>ti mahārukkhā.","<b>Sākhāpattapalāsena vaḍḍhantī</b>ti khuddakasākhāhi ca pattasaṅkhātena ca palāsena vaḍḍhanti.","<b>Araññasmin</b>ti agāmake padese.","<b>Brahāvane</b>ti mahāvane aṭaviyaṃ.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["an5.40:1"],["an5.40:1"],["an5.40:2"],["an5.40:2"],["an5.40:2"]]}],"wordLinks":[["an5.40:1.1","mahāsālā",0,0],["an5.40:1.8","mahāsālā",0,0],["an5.40:1.3","sākhāpattapalāsena vaḍḍhantī",0,1],["an5.40:2.1","araññasmiṃ",0,2],["an5.40:2.1","brahāvane",0,3]],"before":[{"para":107,"vripara":null,"title":"Mahāsālaputtasuttavaṇṇanā","lines":["Mahāsālaputtasuttavaṇṇanā"]}],"after":[{"para":109,"vripara":null,"title":"Mahāsālaputtasuttavaṇṇanā","lines":["Sumanavaggo catuttho."]}]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":102,"to":106,"paras":[{"para":102,"vripara":"39-40","refs":["an5.40:1"],"lines":["39-40. Navame <b>bhato</b>ti posito.","Taṃ pana bharaṇaṃ jātakālato paṭṭhāya sukhapaccayūpaharaṇena dukkhapaccayāpaharaṇena ca pavattitanti dassetuṃ <b>“amhehī”</b>tiādi vuttaṃ.","<b>Hatthapādavaḍḍhanādīhī</b>ti <b>ādi</b> -saddena mukhena siṅghānikāpanayananahāpanamaṇḍanādiñca saṅgaṇhāti.","Mātāpitūnaṃ santakaṃ khettādiṃ avināsetvā rakkhitaṃ tesaṃ paramparāya ṭhitiyā kāraṇaṃ hotīti āha <b>“amhākaṃ santakaṃ … pe … kulavaṃso ciraṃ ṭhassatī”</b>ti.","<b>Salākabhattādīni anupacchinditvā</b>ti salākabhattādīni avicchinditvā.","Yasmā dāyajjappaṭilābhassa yogyabhāvena vattamānoyeva dāyassa paṭipajjissati, na itaroti āha <b>“kulavaṃsānurūpāya paṭipattiyā”</b>tiādi.","<b>Attanā dāyajjārahaṃ karonto</b>ti attānaṃ dāyajjārahaṃ karonto.","Mātāpitaro hi attano ovāde avattamāne micchāpaṭipanne dārake vinicchayaṃ gantvā aputte karonti, te dāyajjārahā na honti.","Ovāde vattamāne pana kulasantakassa sāmike karonti.","<b>Tatiyadivasato paṭṭhāyā</b>ti matadivasato tatiyadivasato paṭṭhāya.","Sesaṃ suviññeyyameva.","Dasamaṃ uttānameva."],"lineRefs":[["an5.40:1"],["an5.40:1"],["an5.40:1"],["an5.40:1"],["an5.40:1"],["an5.40:1"],["an5.40:1"],["an5.40:1"],["an5.40:1"],["an5.40:1"],["an5.40:1"],["an5.40:1"]]},{"para":103,"vripara":null,"refs":["an5.40:1"],"lines":["Puttasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an5.40:1"]]},{"para":104,"vripara":null,"refs":["an5.40:1"],"lines":["Sumanavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an5.40:1"]]},{"para":105,"vripara":null,"refs":["an5.40:1"],"lines":["Muṇḍarājavaggo"],"lineRefs":[["an5.40:1"]]},{"para":106,"vripara":null,"refs":["an5.40:1"],"lines":["1-2. Ādiyasuttādivaṇṇanā"],"lineRefs":[["an5.40:1"]]}],"wordLinks":[]},"tika2":null}
