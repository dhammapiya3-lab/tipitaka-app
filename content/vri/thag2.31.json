{"suttaId":"thag2.31","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[967,973],"vripara":"181"},"segments":{"thag2.31:0.4":"Migasirattheragāthā","thag2.31:1.1":"“Yato ahaṃ pabbajito, sammāsambuddhasāsane;","thag2.31:1.3":"Vimuccamāno uggacchiṃ, kāmadhātuṃ upaccagaṃ.","thag2.31:2.1":"“Brahmuno pekkhamānassa, tato cittaṃ vimucci me;","thag2.31:2.3":"Akuppā me vimuttīti, sabbasaṃyojanakkhayā”ti.","thag2.31:2.5":"… Migasiro thero …."},"attha":null,"tika":null}
