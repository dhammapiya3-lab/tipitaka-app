{"suttaId":"thig2.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[142,149],"vripara":"29"},"segments":{"thig2.6:0.3":"Mettikātherīgāthā","thig2.6:1.1":"“Kiñcāpi khomhi dukkhitā,","thig2.6:1.2":"dubbalā gatayobbanā;","thig2.6:1.3":"Daṇḍamolubbha gacchāmi,","thig2.6:1.4":"pabbataṃ abhirūhiya.","thig2.6:2.1":"“Nikkhipitvāna saṅghāṭiṃ,","thig2.6:2.2":"pattakañca nikujjiya;","thig2.6:2.3":"Nisinnā camhi selamhi,","thig2.6:2.4":"atha cittaṃ vimucci me;","thig2.6:2.5":"Tisso vijjā anuppattā,","thig2.6:2.6":"kataṃ buddhassa sāsanan”ti.","thig2.6:3.1":"… Mettikā therī …."},"unsure":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":446,"to":446,"paras":[{"para":446,"vripara":null,"refs":["thig2.6:2"],"lines":["<b>Atha cittaṃ vimucci me</b>ti selamhi pāsāṇe nisinnā camhi, atha tadanantaraṃ vīriyasamatāya sammadeva yojitattā maggapaṭipāṭiyā sabbehipi āsavehi mama cittaṃ vimucci.","Sesaṃ vuttanayameva."],"lineRefs":[["thig2.6:2"],["thig2.6:2"]]}],"wordLinks":[["thig2.6:2.3","atha cittaṃ vimucci me",0,0]],"before":[{"para":426,"vripara":null,"refs":[],"lines":["Cittātherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":427,"vripara":null,"refs":[],"lines":["Mettikātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":428,"vripara":null,"refs":[],"lines":["<b>Kiñcāpi khomhi dukkhitā</b>tiādikā mettikāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ puññaṃ upacinantī siddhatthassa bhagavato kāle gahapatikule nibbattitvā viññutaṃ patvā satthu cetiye ratanena paṭimaṇḍitāya mekhalāya pūjaṃ akāsi.","Sā tena puññakammena devamanussesu saṃsarantī imasmiṃ buddhuppāde rājagahe brāhmaṇamahāsālakule nibbatti.","Sesaṃ anantare vuttasadisaṃ.","Ayaṃ pana paṭibhāgakūṭaṃ abhiruhitvā samaṇadhammaṃ karontī vipassanaṃ vaḍḍhetvā saha paṭisambhidāhi arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.1.20-25)–"],"lineRefs":[[],[],[],[],[],[]]},{"para":429,"vripara":null,"refs":[],"lines":["“Siddhatthassa bhagavato, thūpakārāpikā ahuṃ;"],"lineRefs":[[]]},{"para":430,"vripara":null,"refs":[],"lines":["Mekhalikā mayā dinnā, navakammāya satthuno."],"lineRefs":[[]]},{"para":431,"vripara":null,"refs":[],"lines":["“Niṭṭhite ca mahāthūpe, mekhalaṃ punadāsahaṃ;"],"lineRefs":[[]]},{"para":432,"vripara":null,"refs":[],"lines":["Lokanāthassa munino, pasannā sehi pāṇibhi."],"lineRefs":[[]]},{"para":433,"vripara":null,"refs":[],"lines":["“Catunnavutito kappe, yaṃ mekhalamadaṃ tadā;"],"lineRefs":[[]]},{"para":434,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, thūpakārassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":435,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":436,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā attano paṭipattiṃ paccavekkhitvā udānavasena –"],"lineRefs":[[]]},{"para":438,"vripara":"29","refs":[],"lines":["“Kiñcāpi khomhi dukkhitā, dubbalā gatayobbanā;"],"lineRefs":[[]]},{"para":439,"vripara":null,"refs":[],"lines":["Daṇḍamolubbha gacchāmi, pabbataṃ abhirūhiya."],"lineRefs":[[]]},{"para":441,"vripara":"30","refs":[],"lines":["“Nikkhipitvāna saṅghāṭiṃ, pattakañca nikujjiya;"],"lineRefs":[[]]},{"para":442,"vripara":null,"refs":[],"lines":["Nisinnā camhi selamhi, atha cittaṃ vimucci me;"],"lineRefs":[[]]},{"para":443,"vripara":null,"refs":[],"lines":["Tisso vijjā anuppattā, kataṃ buddhassa sāsanan”ti.","–"],"lineRefs":[[],[]]},{"para":444,"vripara":null,"refs":[],"lines":["Imā dve gāthā abhāsi."],"lineRefs":[[]]},{"para":445,"vripara":null,"refs":[],"lines":["Tattha <b>dukkhitā</b>ti rogābhibhavena dukkhitā sañjātadukkhā dukkhappattā.","<b>Dubbalā</b>ti tāya ceva dukkhappattiyā, jarājiṇṇatāya ca balavirahitā.","Tenāha <b>“gatayobbanā”</b>ti, addhagatāti attho."],"lineRefs":[[],[],[]]}]},"tika":null,"tika2":null}
