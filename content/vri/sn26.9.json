{"suttaId":"sn26.9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1183,1183],"vripara":"320"},"segments":{"sn26.9:0.3":"Dhātusuttaṃ","sn26.9:1.1":"Sāvatthinidānaṃ.","sn26.9:1.2":"“Yo kho, bhikkhave, pathavīdhātuyā uppādo ṭhiti abhinibbatti pātubhāvo … pe … jarāmaraṇassa pātubhāvo;","sn26.9:1.3":"yo āpodhātuyā …","sn26.9:1.4":"yo tejodhātuyā …","sn26.9:1.5":"yo vāyodhātuyā …","sn26.9:1.6":"yo ākāsadhātuyā …","sn26.9:1.7":"yo viññāṇadhātuyā uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo.","sn26.9:1.8":"Yo ca kho, bhikkhave, pathavīdhātuyā nirodho … pe … jarāmaraṇassa atthaṅgamo;","sn26.9:1.9":"yo āpodhātuyā nirodho …","sn26.9:1.10":"yo tejodhātuyā nirodho …","sn26.9:1.11":"yo vāyodhātuyā nirodho …","sn26.9:1.12":"yo ākāsadhātuyā nirodho …","sn26.9:1.13":"yo viññāṇadhātuyā nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo”ti.","sn26.9:1.14":"Navamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":452,"to":454,"paras":[{"para":452,"vripara":"312-321","refs":["sn26.9:1"],"lines":["312-321. Uppādasaṃyutte sabbaṃ pākaṭameva."],"lineRefs":[["sn26.9:1"]]},{"para":453,"vripara":null,"refs":["sn26.9:1"],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn26.9:1"]]},{"para":454,"vripara":null,"refs":["sn26.9:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.9:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":476,"to":478,"paras":[{"para":476,"vripara":"312-321","refs":["sn26.9:1"],"lines":["312-321. <b>Sabbaṃ pākaṭameva</b> apubbassa abhāvato."],"lineRefs":[["sn26.9:1"]]},{"para":477,"vripara":null,"refs":["sn26.9:1"],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn26.9:1"]]},{"para":478,"vripara":null,"refs":["sn26.9:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.9:1"