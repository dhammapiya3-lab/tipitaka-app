{"suttaId":"tha-ap517","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3271,3285],"vripara":"23"},"segments":{"tha-ap517:0.3":"Nāgapupphiyattheraapadānaṃ","tha-ap517:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ, āhutīnaṃ paṭiggahaṃ;","tha-ap517:1.3":"Rathiyaṃ paṭipajjantaṃ, nāgapupphaṃ apūjayiṃ.","tha-ap517:2.1":"“Ekanavutito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap517:2.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap517:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap517:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap517:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap517:6.1":"Itthaṃ sudaṃ āyasmā nāgapupphiyo thero imā gāthāyo Abhāsitthāti.","tha-ap517:7.1":"Nāgapupphiyattherassāpadānaṃ pañcamaṃ."},"attha":null,"tika":null}
