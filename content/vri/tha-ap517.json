{"suttaId":"tha-ap517","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3271,3285],"vripara":"23"},"segments":{"tha-ap517:0.3":"Nāgapupphiyattheraapadānaṃ","tha-ap517:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap517:1.2":"āhutīnaṃ paṭiggahaṃ;","tha-ap517:1.3":"Rathiyaṃ paṭipajjantaṃ,","tha-ap517:1.4":"nāgapupphaṃ apūjayiṃ. 24.","tha-ap517:2.1":"“Ekanavutito kappe,","tha-ap517:2.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap517:2.3":"Duggatiṃ nābhijānāmi,","tha-ap517:2.4":"buddhapūjāyidaṃ phalaṃ. 25.","tha-ap517:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap517:3.3":"viharāmi anāsavo. 26.","tha-ap517:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap517:4.3":"kataṃ buddhassa sāsanaṃ. 27.","tha-ap517:5.1":"“Paṭisambhidā catasso…pe…","tha-ap517:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap517:6.1":"Itthaṃ sudaṃ āyasmā nāgapupphiyo thero imā gāthāyo Abhāsitthāti.","tha-ap517:7.1":"Nāgapupphiyattherassāpadānaṃ pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
