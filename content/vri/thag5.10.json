{"suttaId":"thag5.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1658,1674],"vripara":"360"},"segments":{"thag5.10:0.4":"Yasadattattheragāthā","thag5.10:1.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:1.3":"Ārakā hoti saddhammā, nabhaso pathavī yathā.","thag5.10:2.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:2.3":"Parihāyati saddhammā, kāḷapakkheva candimā.","thag5.10:3.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:3.3":"Parisussati saddhamme, maccho appodake yathā.","thag5.10:4.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:4.3":"Na virūhati saddhamme, khette bījaṃva pūtikaṃ.","thag5.10:5.1":"“Yo ca tuṭṭhena cittena, suṇāti jinasāsanaṃ;","thag5.10:5.3":"Khepetvā āsave sabbe, sacchikatvā akuppataṃ;","thag5.10:5.5":"Pappuyya paramaṃ santiṃ, parinibbātināsavo”ti.","thag5.10:5.7":"… Yasadatto thero …."},"attha":null,"tika":null}
