{"suttaId":"thag5.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1658,1674],"vripara":"360"},"segments":{"thag5.10:0.4":"Yasadattattheragāthā","thag5.10:1.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:1.3":"Ārakā hoti saddhammā, nabhaso pathavī yathā.","thag5.10:2.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:2.3":"Parihāyati saddhammā, kāḷapakkheva candimā.","thag5.10:3.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:3.3":"Parisussati saddhamme, maccho appodake yathā.","thag5.10:4.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:4.3":"Na virūhati saddhamme, khette bījaṃva pūtikaṃ.","thag5.10:5.1":"“Yo ca tuṭṭhena cittena, suṇāti jinasāsanaṃ;","thag5.10:5.3":"Khepetvā āsave sabbe, sacchikatvā akuppataṃ;","thag5.10:5.5":"Pappuyya paramaṃ santiṃ, parinibbātināsavo”ti.","thag5.10:5.7":"… Yasadatto thero …."},"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":897,"to":897,"paras":[{"para":897,"vripara":null,"refs":["thag5.10:5"],"lines":["<b>Tuṭṭhena cittenā</b>ti itthambhūtalakkhaṇe karaṇavacanaṃ, attamano pamudito hutvāti attho.","<b>Khepetvā</b>ti samucchinditvā.","<b>Akuppatan</b>ti arahattaṃ.","<b>Pappuyyā</b>ti pāpuṇitvā.","<b>Paramaṃ santin</b>ti anupādisesaṃ nibbānaṃ.","Tadadhigamo cassa kevalaṃ kālāgamanameva, na kocividhoti taṃ dassetuṃ vuttaṃ <b>“parinibbātināsavo”</b>ti."],"lineRefs":[["thag5.10:5"],["thag5.10:5"],["thag5.10:5"],["thag5.10:5"],["thag5.10:5"],["thag5.10:5"]]}],"wordLinks":[["thag5.10:5.1","tuṭṭhena cittenā",0,0],["thag5.10:5.3","khepetvā",0,1],["thag5.10:5.3","akuppataṃ",0,2],["thag5.10:5.5","pappuyyā",0,3],["thag5.10:5.5","paramaṃ santiṃ",0,4],["thag5.10:5.5","parinibbātināsavo",0,5]]},"tika":null}
