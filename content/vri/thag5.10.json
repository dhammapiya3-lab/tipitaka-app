{"suttaId":"thag5.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1658,1674],"vripara":"360"},"segments":{"thag5.10:0.4":"Yasadattattheragāthā","thag5.10:1.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:1.3":"Ārakā hoti saddhammā, nabhaso pathavī yathā.","thag5.10:2.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:2.3":"Parihāyati saddhammā, kāḷapakkheva candimā.","thag5.10:3.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:3.3":"Parisussati saddhamme, maccho appodake yathā.","thag5.10:4.1":"“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;","thag5.10:4.3":"Na virūhati saddhamme, khette bījaṃva pūtikaṃ.","thag5.10:5.1":"“Yo ca tuṭṭhena cittena, suṇāti jinasāsanaṃ;","thag5.10:5.3":"Khepetvā āsave sabbe, sacchikatvā akuppataṃ;","thag5.10:5.5":"Pappuyya paramaṃ santiṃ, parinibbātināsavo”ti.","thag5.10:5.7":"… Yasadatto thero …."},"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":897,"to":897,"paras":[{"para":897,"vripara":null,"refs":["thag5.10:5"],"lines":["<b>Tuṭṭhena cittenā</b>ti itthambhūtalakkhaṇe karaṇavacanaṃ, attamano pamudito hutvāti attho.","<b>Khepetvā</b>ti samucchinditvā.","<b>Akuppatan</b>ti arahattaṃ.","<b>Pappuyyā</b>ti pāpuṇitvā.","<b>Paramaṃ santin</b>ti anupādisesaṃ nibbānaṃ.","Tadadhigamo cassa kevalaṃ kālāgamanameva, na kocividhoti taṃ dassetuṃ vuttaṃ <b>“parinibbātināsavo”</b>ti."],"lineRefs":[["thag5.10:5"],["thag5.10:5"],["thag5.10:5"],["thag5.10:5"],["thag5.10:5"],["thag5.10:5"]]}],"wordLinks":[["thag5.10:5.1","tuṭṭhena cittenā",0,0],["thag5.10:5.3","khepetvā",0,1],["thag5.10:5.3","akuppataṃ",0,2],["thag5.10:5.5","pappuyyā",0,3],["thag5.10:5.5","paramaṃ santiṃ",0,4],["thag5.10:5.5","parinibbātināsavo",0,5]],"before":[{"para":861,"vripara":null,"refs":[],"lines":["“Suvaṇṇavaṇṇaṃ sambuddhaṃ, dvattiṃsavaralakkhaṇaṃ;"],"lineRefs":[[]]},{"para":862,"vripara":null,"refs":[],"lines":["Vipinaggena gacchantaṃ, sālarājaṃva phullitaṃ."],"lineRefs":[[]]},{"para":863,"vripara":null,"refs":[],"lines":["“Tiṇattharaṃ paññāpetvā, buddhaseṭṭhaṃ ayācahaṃ;"],"lineRefs":[[]]},{"para":864,"vripara":null,"refs":[],"lines":["Anukampatu maṃ buddho, bhikkhaṃ icchāmi dātave."],"lineRefs":[[]]},{"para":865,"vripara":null,"refs":[],"lines":["“Anukampako kāruṇiko, atthadassī mahāyaso;"],"lineRefs":[[]]},{"para":866,"vripara":null,"refs":[],"lines":["Mama saṅkappamaññāya, orūhi mama assame."],"lineRefs":[[]]},{"para":867,"vripara":null,"refs":[],"lines":["“Orohitvāna sambuddho, nisīdi paṇṇasanthare;"],"lineRefs":[[]]},{"para":868,"vripara":null,"refs":[],"lines":["Bhallātakaṃ gahetvāna, buddhaseṭṭhassadāsahaṃ."],"lineRefs":[[]]},{"para":869,"vripara":null,"refs":[],"lines":["“Mama nijjhāyamānassa, paribhuñji tadā jino;"],"lineRefs":[[]]},{"para":870,"vripara":null,"refs":[],"lines":["Tattha cittaṃ pasādetvā, abhivandiṃ tadā jinaṃ."],"lineRefs":[[]]},{"para":871,"vripara":null,"refs":[],"lines":["“Aṭṭhārase kappasate, yaṃ phalamadadiṃ tadā;"],"lineRefs":[[]]},{"para":872,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, phaladānassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":873,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":874,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā aññaṃ byākarontopi imā gāthā abhāsi."],"lineRefs":[[]]},{"para":875,"vripara":null,"refs":[],"lines":["Vijitasenattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":876,"vripara":null,"refs":[],"lines":["Yasadattattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":877,"vripara":null,"refs":[],"lines":["<b>Upārambhacitto</b>tiādikā āyasmato yasadattattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacini.","Tathā hesa padumuttarassa bhagavato kāle brāhmaṇakule nibbattitvā brāhmaṇānaṃ vijjāsippesu nipphattiṃ gato kāme pahāya isipabbajjaṃ pabbajitvā araññe viharanto ekadivasaṃ satthāraṃ disvā pasannamānaso añjaliṃ paggayha abhitthavi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde mallaraṭṭhe mallarājakule nibbattitvā <b>yasadatto</b>ti laddhanāmo, vayappatto takkasilaṃ gantvā sabbasippāni sikkhitvā sabhiyena paribbājakena saddhiṃyeva cārikaṃ caramāno, anupubbena sāvatthiyaṃ bhagavantaṃ upasaṅkamitvā sabhiyena puṭṭhapañhesu vissajjiyamānesu sayaṃ otārāpekkho suṇanto nisīdi “samaṇassa gotamassa vāde dosaṃ dassāmī”ti.","Athassa bhagavā cittācāraṃ ñatvā <b>sabhiyasuttadesanāvasāne</b> (su. ni. sabhiyasutta) ovādaṃ dento –"],"lineRefs":[[],[],[],[],[],[]]},{"para":879,"vripara":"360","refs":[],"lines":["“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;"],"lineRefs":[[]]},{"para":880,"vripara":null,"refs":[],"lines":["Ārakā hoti saddhammā, nabhaso pathavī yathā."],"lineRefs":[[]]},{"para":882,"vripara":"361","refs":[],"lines":["“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;"],"lineRefs":[[]]},{"para":883,"vripara":null,"refs":[],"lines":["Parihāyati saddhammā, kāḷapakkheva candimā."],"lineRefs":[[]]},{"para":885,"vripara":"362","refs":[],"lines":["“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;"],"lineRefs":[[]]},{"para":886,"vripara":null,"refs":[],"lines":["Parisussati saddhamme, maccho appodake yathā."],"lineRefs":[[]]},{"para":888,"vripara":"363","refs":[],"lines":["“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;"],"lineRefs":[[]]},{"para":889,"vripara":null,"refs":[],"lines":["Na virūhati saddhamme, khette bījaṃva pūtikaṃ."],"lineRefs":[[]]},{"para":891,"vripara":"364","refs":[],"lines":["“Yo ca tuṭṭhena cittena, suṇāti jinasāsanaṃ;"],"lineRefs":[[]]},{"para":892,"vripara":null,"refs":[],"lines":["Khepetvā āsave sabbe, sacchikatvā akuppataṃ;"],"lineRefs":[[]]},{"para":893,"vripara":null,"refs":[],"lines":["Pappuyya paramaṃ santiṃ, parinibbātināsavo”ti.","–"],"lineRefs":[[],[]]},{"para":894,"vripara":null,"refs":[],"lines":["Imā pañca gāthā abhāsi."],"lineRefs":[[]]},{"para":895,"vripara":null,"refs":[],"lines":["Tattha <b>upārambhacitto</b>ti sārambhacitto, dosāropanādhippāyoti attho.","<b>Dummedho</b>ti nippañño.","<b>Ārakā hoti saddhammā</b>ti so tādiso puggalo nabhaso viya pathavī paṭipattisaddhammatopi dūre hoti, pageva paṭivedhasaddhammato.","“Na tvaṃ imaṃ dhammavinayaṃ ājānāsī”tiādinā (dī. ni.1.18) viggāhikakathaṃ anuyuttassa kuto santanipuṇo paṭipattisaddhammo."],"lineRefs":[[],[],[],[]]},{"para":896,"vripara":null,"refs":[],"lines":["<b>Parihāyati saddhammā</b>ti navavidhalokuttaradhammato pubbabhāgiyasaddhādisaddhammatopi nihīyati.","<b>Parisussatī</b>ti visussati kāyacittānaṃ pīṇanarasassa pītipāmojjādikusaladhammassābhāvato.","<b>Na virūhatī</b>ti virūḷhiṃ vuddhiṃ na pāpuṇāti.","<b>Pūtikan</b>ti gomayalepadānādiabhāvena pūtibhāvaṃ pattaṃ."],"lineRefs":[[],[],[],[]]}]},"tika":null,"tika2":null}
