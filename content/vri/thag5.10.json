{"suttaId":"thag5.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1658,1674],"vripara":"360"},"segments":{"thag5.10:0.4":"Yasadattattheragāthā","thag5.10:1.1":"“Upārambhacitto dummedho,","thag5.10:1.2":"suṇāti jinasāsanaṃ;","thag5.10:1.3":"Ārakā hoti saddhammā,","thag5.10:1.4":"nabhaso pathavī yathā. 361.","thag5.10:2.1":"“Upārambhacitto dummedho,","thag5.10:2.2":"suṇāti jinasāsanaṃ;","thag5.10:2.3":"Parihāyati saddhammā,","thag5.10:2.4":"kāḷapakkheva candimā. 362.","thag5.10:3.1":"“Upārambhacitto dummedho,","thag5.10:3.2":"suṇāti jinasāsanaṃ;","thag5.10:3.3":"Parisussati saddhamme,","thag5.10:3.4":"maccho appodake yathā. 363.","thag5.10:4.1":"“Upārambhacitto dummedho,","thag5.10:4.2":"suṇāti jinasāsanaṃ;","thag5.10:4.3":"Na virūhati saddhamme,","thag5.10:4.4":"khette bījaṃva pūtikaṃ. 364.","thag5.10:5.1":"“Yo ca tuṭṭhena cittena,","thag5.10:5.2":"suṇāti jinasāsanaṃ;","thag5.10:5.3":"Khepetvā āsave sabbe,","thag5.10:5.4":"sacchikatvā akuppataṃ;","thag5.10:5.5":"Pappuyya paramaṃ santiṃ,","thag5.10:5.6":"parinibbātināsavo”ti. …","thag5.10:5.7":"Yasadatto thero…. 11."},"unsure":[],"preface":[],"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":897,"to":897,"paras":[{"para":897,"vripara":null,"refs":["thag5.10:5"],"lines":["<b>Tuṭṭhena cittenā</b>ti itthambhūtalakkhaṇe karaṇavacanaṃ, attamano pamudito hutvāti attho.","<b>Khepetvā</b>ti samucchinditvā.","<b>Akuppata</b>nti arahattaṃ.","<b>Pappuyyā</b>ti pāpuṇitvā.","<b>Paramaṃ santi</b>nti anupādisesaṃ nibbānaṃ.","Tadadhigamo cassa kevalaṃ kālāgamanameva, na kocividhoti taṃ dassetuṃ vuttaṃ <b>“parinibbātināsavo”</b>ti."],"lineRefs":[["thag5.10:5"],["thag5.10:5"],["thag5.10:5"],["thag5.10:5"],["thag5.10:5"],["thag5.10:5"]]}],"wordLinks":[["thag5.10:5.1","tuṭṭhena cittenā",0,0],["thag5.10:5.3","khepetvā",0,1],["thag5.10:5.3","akuppataṃ",0,2],["thag5.10:5.5","pappuyyā",0,3],["thag5.10:5.5","paramaṃ santiṃ",0,4],["thag5.10:5.5","parinibbātināsavo",0,5]],"before":[{"para":876,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Yasadattattheragāthāvaṇṇanā"]},{"para":877,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["<b>Upārambhacitto</b>tiādikā āyasmato yasadattattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacini.","Tathā hesa padumuttarassa bhagavato kāle brāhmaṇakule nibbattitvā brāhmaṇānaṃ vijjāsippesu nipphattiṃ gato kāme pahāya isipabbajjaṃ pabbajitvā araññe viharanto ekadivasaṃ satthāraṃ disvā pasannamānaso añjaliṃ paggayha abhitthavi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde mallaraṭṭhe mallarājakule nibbattitvā <b>yasadatto</b>ti laddhanāmo, vayappatto takkasilaṃ gantvā sabbasippāni sikkhitvā sabhiyena paribbājakena saddhiṃyeva cārikaṃ caramāno, anupubbena sāvatthiyaṃ bhagavantaṃ upasaṅkamitvā sabhiyena puṭṭhapañhesu vissajjiyamānesu sayaṃ otārāpekkho suṇanto nisīdi “samaṇassa gotamassa vāde dosaṃ dassāmī”ti.","Athassa bhagavā cittācāraṃ ñatvā <b>sabhiyasuttadesanāvasāne</b> (su. ni. sabhiyasutta) ovādaṃ dento – 360."]},{"para":879,"vripara":"360","title":"Yasadattattheragāthāvaṇṇanā","lines":["“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;"]},{"para":880,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Ārakā hoti saddhammā, nabhaso pathavī yathā. 361."]},{"para":882,"vripara":"361","title":"Yasadattattheragāthāvaṇṇanā","lines":["“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;"]},{"para":883,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Parihāyati saddhammā, kāḷapakkheva candimā. 362."]},{"para":885,"vripara":"362","title":"Yasadattattheragāthāvaṇṇanā","lines":["“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;"]},{"para":886,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Parisussati saddhamme, maccho appodake yathā. 363."]},{"para":888,"vripara":"363","title":"Yasadattattheragāthāvaṇṇanā","lines":["“Upārambhacitto dummedho, suṇāti jinasāsanaṃ;"]},{"para":889,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Na virūhati saddhamme, khette bījaṃva pūtikaṃ. 364."]},{"para":891,"vripara":"364","title":"Yasadattattheragāthāvaṇṇanā","lines":["“Yo ca tuṭṭhena cittena, suṇāti jinasāsanaṃ;"]},{"para":892,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Khepetvā āsave sabbe, sacchikatvā akuppataṃ;"]},{"para":893,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Pappuyya paramaṃ santiṃ, parinibbātināsavo”ti. –"]},{"para":894,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Imā pañca gāthā abhāsi."]},{"para":895,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Tattha <b>upārambhacitto</b>ti sārambhacitto, dosāropanādhippāyoti attho.","<b>Dummedho</b>ti nippañño.","<b>Ārakā hoti saddhammā</b>ti so tādiso puggalo nabhaso viya pathavī paṭipattisaddhammatopi dūre hoti, pageva paṭivedhasaddhammato.","“Na tvaṃ imaṃ dhammavinayaṃ ājānāsī”tiādinā (dī. ni. 1.18) viggāhikakathaṃ anuyuttassa kuto santanipuṇo paṭipattisaddhammo."]},{"para":896,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["<b>Parihāyati saddhammā</b>ti navavidhalokuttaradhammato pubbabhāgiyasaddhādisaddhammatopi nihīyati.","<b>Parisussatī</b>ti visussati kāyacittānaṃ pīṇanarasassa pītipāmojjādikusaladhammassābhāvato.","<b>Na virūhatī</b>ti virūḷhiṃ vuddhiṃ na pāpuṇāti.","<b>Pūtika</b>nti gomayalepadānādiabhāvena pūtibhāvaṃ pattaṃ."]}],"after":[{"para":898,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Evaṃ satthārā ovadito saṃvegajāto pabbajitvā vipassanaṃ paṭṭhapetvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.44.35-43) –"]},{"para":899,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["“Kaṇikāraṃva jalitaṃ, dīparukkhaṃva jotitaṃ;"]},{"para":900,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Kañcanaṃva virocantaṃ, addasaṃ dvipaduttamaṃ."]},{"para":901,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["“Kamaṇḍaluṃ ṭhapetvāna, vākacīrañca kuṇḍikaṃ;"]},{"para":902,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Ekaṃsaṃ ajinaṃ katvā, buddhaseṭṭhaṃ thaviṃ ahaṃ."]},{"para":903,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["“Tamandhakāraṃ vidhamaṃ, mohajālasamākulaṃ;"]},{"para":904,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Ñāṇālokaṃ dassetvāna, nittiṇṇosi mahāmuni."]},{"para":905,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["“Samuddharasimaṃ lokaṃ, sabbāvantamanuttaraṃ;"]},{"para":906,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Ñāṇe te upamā natthi, yāvatā jagato gati."]},{"para":907,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["“Tena ñāṇena sabbaññū, iti buddho pavuccati;"]},{"para":908,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Vandāmi taṃ mahāvīraṃ, sabbaññutamanāvaraṃ."]},{"para":909,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["“Satasahassito kappe, buddhaseṭṭhaṃ thaviṃ ahaṃ;"]},{"para":910,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, ñāṇatthavāyidaṃ phalaṃ."]},{"para":911,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti."]},{"para":912,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Arahattaṃ pana patvā aññaṃ byākarontopi thero imā eva gāthā abhāsi."]},{"para":913,"vripara":null,"title":"Yasadattattheragāthāvaṇṇanā","lines":["Yasadattattheragāthāvaṇṇanā niṭṭhitā. 11."]}]},"tika":null,"tika2":null}
