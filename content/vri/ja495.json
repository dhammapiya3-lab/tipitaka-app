{"suttaId":"ja495","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[7890,8056],"vripara":"222"},"segments":{"ja495:0.4":"Dasabrāhmaṇajātakaṃ (12)","ja495:1.1":"Rājā avoca vidhuraṃ,","ja495:1.2":"dhammakāmo yudhiṭṭhilo;","ja495:1.3":"Brāhmaṇe vidhura pariyesa,","ja495:1.4":"sīlavante bahussute.","ja495:2.1":"Virate methunā dhammā,","ja495:2.2":"ye me bhuñjeyyu [bhuñjeyyuṃ (sī.)] bhojanaṃ;","ja495:2.3":"Dakkhiṇaṃ samma dassāma,","ja495:2.4":"yattha dinnaṃ mahapphalaṃ.","ja495:3.1":"Dullabhā brāhmaṇā deva,","ja495:3.2":"sīlavanto bahussutā;","ja495:3.3":"Viratā methunā dhammā,","ja495:3.4":"ye te bhuñjeyyu bhojanaṃ.","ja495:4.1":"Dasa khalu mahārāja,","ja495:4.2":"yā tā brāhmaṇajātiyo;","ja495:4.3":"Tesaṃ vibhaṅgaṃ vicayaṃ [viciya (ka.)],","ja495:4.4":"vitthārena suṇohi me.","ja495:5.1":"Pasibbake gahetvāna,","ja495:5.2":"puṇṇe mūlassa saṃvute;","ja495:5.3":"Osadhikāyo [osadhikāye (syā. ka.)] ganthenti,","ja495:5.4":"nhāpayanti [nahāyanti (sī. pī.)] japanti ca.","ja495:6.1":"Tikicchakasamā rāja,","ja495:6.2":"tepi vuccanti brāhmaṇā;","ja495:6.3":"Akkhātā te mahārāja,","ja495:6.4":"tādise nipatāmase.","ja495:7.1":"Apetā te ca [te (sī. pī.)] brahmaññā,","ja495:7.2":"(Iti rājā [rājā ca (syā. ka.)] korabyo)","ja495:7.3":"Na te vuccanti brāhmaṇā;","ja495:7.4":"Aññe vidhura pariyesa,","ja495:7.5":"sīlavante bahussute.","ja495:8.1":"Virate methunā dhammā,","ja495:8.2":"ye me bhuñjeyyu bhojanaṃ;","ja495:8.3":"Dakkhiṇaṃ samma dassāma,","ja495:8.4":"yattha dinnaṃ mahapphalaṃ.","ja495:9.1":"Kiṅkiṇikāyo [kiṅkaṇikāyo (ka.), kiṅkiṇiyo (syā.)] gahetvā [gahetvāna (sī. syā. pī.)],","ja495:9.2":"ghosenti puratopi te;","ja495:9.3":"Pesanānipi gacchanti,","ja495:9.4":"rathacariyāsu sikkhare.","ja495:10.1":"Paricārakasamā rāja,","ja495:10.2":"tepi vuccanti brāhmaṇā;","ja495:10.3":"Akkhātā te mahārāja,","ja495:10.4":"tādise nipatāmase.","ja495:11.1":"Apetā te ca brahmaññā,","ja495:11.2":"(Iti rājā korabyo)","ja495:11.3":"Na te vuccanti brāhmaṇā;","ja495:11.4":"Aññe vidhura pariyesa,","ja495:11.5":"sīlavante bahussute.","ja495:12.1":"Virate methunā dhammā,","ja495:12.2":"ye me bhuñjeyyu bhojanaṃ;","ja495:12.3":"Dakkhiṇaṃ samma dassāma,","ja495:12.4":"yattha dinnaṃ mahapphalaṃ.","ja495:13.1":"Kamaṇḍaluṃ gahetvāna,","ja495:13.2":"vaṅkadaṇḍañca brāhmaṇā;","ja495:13.3":"Paccupessanti rājāno,","ja495:13.4":"gāmesu nigamesu ca;","ja495:13.5":"Nādinne vuṭṭhahissāma,","ja495:13.6":"gāmamhi vā vanamhi vā [vāmamhi ca vanamhi ca (sī. pī.), gāmamhi nigamamhi vā (syā.)].","ja495:14.1":"Niggāhakasamā rāja,","ja495:14.2":"tepi vuccanti brāhmaṇā;","ja495:14.3":"Akkhātā te mahārāja,","ja495:14.4":"tādise nipatāmase.","ja495:15.1":"Apetā te ca brahmaññā,","ja495:15.2":"(Iti rājā korabyo)","ja495:15.3":"Na te vuccanti brāhmaṇā;","ja495:15.4":"Aññe vidhura pariyesa,","ja495:15.5":"sīlavante bahussute.","ja495:16.1":"Virate methunā dhammā,","ja495:16.2":"ye me bhuñjeyyu bhojanaṃ;","ja495:16.3":"Dakkhiṇaṃ samma dassāma,","ja495:16.4":"yattha dinnaṃ mahapphalaṃ.","ja495:17.1":"Parūḷhakacchanakhalomā,","ja495:17.2":"paṅkadantā rajassirā;","ja495:17.3":"Okiṇṇā rajareṇūhi,","ja495:17.4":"yācakā vicaranti te.","ja495:18.1":"Khāṇughātasamā rāja,","ja495:18.2":"tepi vuccanti brāhmaṇā;","ja495:18.3":"Akkhātā te mahārāja,","ja495:18.4":"tādise nipatāmase.","ja495:19.1":"Apetā te ca brahmaññā,","ja495:19.2":"(Iti rājā korabyo)","ja495:19.3":"Na te vuccanti brāhmaṇā;","ja495:19.4":"Aññe vidhura pariyesa,","ja495:19.5":"sīlavante bahussute.","ja495:20.1":"Virate methunā dhammā,","ja495:20.2":"ye me bhuñjeyyu bhojanaṃ;","ja495:20.3":"Dakkhiṇaṃ samma dassāma,","ja495:20.4":"yattha dinnaṃ mahapphalaṃ.","ja495:21.1":"Harītakaṃ [harīṭakaṃ (bahūsu)] āmalakaṃ,","ja495:21.2":"ambaṃ jambuṃ vibhītakaṃ [ambajambuvibhīṭakaṃ (sī. pī.)];","ja495:21.3":"Labujaṃ dantapoṇāni,","ja495:21.4":"beluvā badarāni ca.","ja495:22.1":"Rājāyatanaṃ ucchu-puṭaṃ,","ja495:22.2":"dhūmanettaṃ madhu-añjanaṃ;","ja495:22.3":"Uccāvacāni paṇiyāni,","ja495:22.4":"vipaṇenti janādhipa.","ja495:23.1":"Vāṇijakasamā rāja,","ja495:23.2":"tepi vuccanti brāhmaṇā;","ja495:23.3":"Akkhātā te mahārāja,","ja495:23.4":"tādise nipatāmase.","ja495:24.1":"Apetā te ca brahmaññā,","ja495:24.2":"(Iti rājā korabyo)","ja495:24.3":"Na te vuccanti brāhmaṇā;","ja495:24.4":"Aññe vidhura pariyesa,","ja495:24.5":"sīlavante bahussute.","ja495:25.1":"Virate methunā dhammā,","ja495:25.2":"ye me bhuñjeyyu bhojanaṃ;","ja495:25.3":"Dakkhiṇaṃ samma dassāma,","ja495:25.4":"yattha dinnaṃ mahapphalaṃ.","ja495:26.1":"Kasi-vāṇijjaṃ [kasiṃ vaṇijjaṃ (sī. pī.)] kārenti,","ja495:26.2":"posayanti ajeḷake;","ja495:26.3":"Kumāriyo pavecchanti,","ja495:26.4":"vivāhantāvahanti ca.","ja495:27.1":"Samā ambaṭṭhavessehi,","ja495:27.2":"tepi vuccanti brāhmaṇā;","ja495:27.3":"Akkhātā te mahārāja,","ja495:27.4":"tādise nipatāmase.","ja495:28.1":"Apetā te ca brahmaññā,","ja495:28.2":"(Iti rājā korabyo)","ja495:28.3":"Na te vuccanti brāhmaṇā;","ja495:28.4":"Aññe vidhura pariyesa,","ja495:28.5":"sīlavante bahussute.","ja495:29.1":"Virate methunā dhammā,","ja495:29.2":"ye me bhuñjeyyu bhojanaṃ;","ja495:29.3":"Dakkhiṇaṃ samma dassāma,","ja495:29.4":"yattha dinnaṃ mahapphalaṃ.","ja495:30.1":"Nikkhittabhikkhaṃ bhuñjanti,","ja495:30.2":"gāmesveke purohitā;","ja495:30.3":"Bahū te [ne (syā. ka.)] paripucchanti,","ja495:30.4":"aṇḍacchedā nilañchakā [tilañchakā (pī.)].","ja495:31.1":"Pasūpi tattha haññanti,","ja495:31.2":"mahiṃsā sūkarā ajā;","ja495:31.3":"Goghātakasamā rāja,","ja495:31.4":"tepi vuccanti brāhmaṇā;","ja495:31.5":"Akkhātā te mahārāja,","ja495:31.6":"tādise nipatāmase.","ja495:32.1":"Apetā te brahmaññā,","ja495:32.2":"(Iti rājā korabyo)","ja495:32.3":"Na te vuccanti brāhmaṇā;","ja495:32.4":"Aññe vidhura pariyesa,","ja495:32.5":"sīlavante bahussute.","ja495:33.1":"Virate methunā dhammā,","ja495:33.2":"ye me bhuñjeyyu bhojanaṃ;","ja495:33.3":"Dakkhiṇaṃ samma dassāma,","ja495:33.4":"yattha dinnaṃ mahapphalaṃ.","ja495:34.1":"Asicammaṃ gahetvāna,","ja495:34.2":"khaggaṃ paggayha brāhmaṇā;","ja495:34.3":"Vessapathesu tiṭṭhanti,","ja495:34.4":"satthaṃ abbāhayantipi.","ja495:35.1":"Samā gopanisādehi,","ja495:35.2":"tepi vuccanti brāhmaṇā;","ja495:35.3":"Akkhātā te mahārāja,","ja495:35.4":"tādise nipatāmase.","ja495:36.1":"Apetā te brahmaññā,","ja495:36.2":"(Iti rājā korabyo)","ja495:36.3":"Na te vuccanti brāhmaṇā;","ja495:36.4":"Aññe vidhura pariyesa,","ja495:36.5":"sīlavante bahussute.","ja495:37.1":"Virate methunā dhammā,","ja495:37.2":"ye me bhuñjeyyu bhojanaṃ;","ja495:37.3":"Dakkhiṇaṃ samma dassāma,","ja495:37.4":"yattha dinnaṃ mahapphalaṃ.","ja495:38.1":"Araññe kuṭikaṃ katvā,","ja495:38.2":"kūṭāni kārayanti te;","ja495:38.3":"Sasabiḷāre bādhenti,","ja495:38.4":"āgodhā macchakacchapaṃ.","ja495:39.1":"Te luddakasamā rāja [luddakā te mahārāja (sī. pī.)],","ja495:39.2":"tepi vuccanti brāhmaṇā;","ja495:39.3":"Akkhātā te mahārāja,","ja495:39.4":"tādise nipatāmase.","ja495:40.1":"Apetā te brahmaññā,","ja495:40.2":"(Iti rājā korabyo)","ja495:40.3":"Na te vuccanti brāhmaṇā;","ja495:40.4":"Aññe vidhura pariyesa,","ja495:40.5":"sīlavante bahussute.","ja495:41.1":"Virate methunā dhammā,","ja495:41.2":"ye me bhuñjeyyu bhojanaṃ;","ja495:41.3":"Dakkhiṇaṃ samma dassāma,","ja495:41.4":"yattha dinnaṃ mahapphalaṃ.","ja495:42.1":"Aññe dhanassa kāmā hi,","ja495:42.2":"heṭṭhāmañce pasakkitā [pasakkhitā (sī. syā. pī.)];","ja495:42.3":"Rājāno upari nhāyanti,","ja495:42.4":"somayāge upaṭṭhite.","ja495:43.1":"Malamajjakasamā rāja,","ja495:43.2":"tepi vuccanti brāhmaṇā;","ja495:43.3":"Akkhātā te mahārāja,","ja495:43.4":"tādise nipatāmase.","ja495:44.1":"Apetā te brahmaññā,","ja495:44.2":"(Iti rājā korabyo)","ja495:44.3":"Na te vuccanti brāhmaṇā;","ja495:44.4":"Aññe vidhura pariyesa,","ja495:44.5":"sīlavante bahussute.","ja495:45.1":"Virate methunā dhammā,","ja495:45.2":"ye me bhuñjeyyu bhojanaṃ;","ja495:45.3":"Dakkhiṇaṃ samma dassāma,","ja495:45.4":"yattha dinnaṃ mahapphalaṃ.","ja495:46.1":"Atthi kho brāhmaṇā deva,","ja495:46.2":"sīlavanto bahussutā;","ja495:46.3":"Viratā methunā dhammā,","ja495:46.4":"ye te bhuñjeyyu bhojanaṃ.","ja495:47.1":"Ekañca bhattaṃ bhuñjanti,","ja495:47.2":"na ca majjaṃ pivanti te;","ja495:47.3":"Akkhātā te mahārāja,","ja495:47.4":"tādise nipatāmase.","ja495:48.1":"Ete kho brāhmaṇā vidhura,","ja495:48.2":"sīlavanto bahussutā;","ja495:48.3":"Ete vidhura pariyesa,","ja495:48.4":"khippañca ne [khippaṃva ne (ka.)] nimantayāti.","ja495:49.1":"Dasabrāhmaṇajātakaṃ dvādasamaṃ."},"unsure":[],"attha":{"book":"Ja-a-iv","bookName":"Jātaka-aṭṭhakathā-4","vriCode":"s0513a4.att","from":3693,"to":3707,"paras":[{"para":3693,"vripara":null,"refs":["ja495:45"],"lines":["Tattha <b>sīlavante</b>ti maggenāgatasīle.","<b>Bahussute</b>ti paṭivedhabahussute.","<b>Dakkhiṇan</b>ti dānaṃ.","<b>Ye te</b>ti ye dhammikā samaṇabrāhmaṇā tava dānaṃ bhuñjeyyuṃ, te dullabhā.","<b>Brāhmaṇajātiyo</b>ti brāhmaṇakulāni.","<b>Tesaṃ vibhaṅgaṃ vicayan</b>ti tesaṃ brāhmaṇānaṃ vibhaṅgaṃ mama paññāya vicitabhāvaṃ vitthārena suṇohi.","<b>Saṃvute</b>ti baddhamukhe.","<b>Osadhikāyo ganthentī</b>ti “idaṃ imassa rogassa bhesajjaṃ, idaṃ imassa rogassa bhesajjan”ti evaṃ siloke bandhitvā manussānaṃ denti.","<b>Nhāpayantī</b>ti nahāpanaṃ nāma karonti.","<b>Japanti cā</b>ti bhūtavijjaṃ parivattenti.","<b>Tikicchakasamā</b>ti vejjasadisā.","<b>Tepi vuccantī</b>ti tepi “brāhmaṇā vā mayaṃ, abrāhmaṇā vā”ti ajānitvā vejjakammena jīvikaṃ kappentā vohārena “brāhmaṇā”ti vuccanti.","<b>Akkhātā te</b>ti ime te mayā vejjabrāhmaṇā nāma akkhātā.","<b>Nipatāmase</b>ti vadehi dāni, kiṃ tādise brāhmaṇe nipatāma, nimantanatthāya upasaṅkamāma, atthi te etehi atthoti pucchati.","<b>Brahmaññā</b>ti brāhmaṇadhammato.","<b>Na te vuccantī</b>ti te bāhitapāpatāya brāhmaṇā nāma na vuccanti."],"lineRefs":[["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"]]},{"para":3694,"vripara":null,"refs":["ja495:45"],"lines":["<b>Kiṅkiṇikāyo</b>ti mahārāja, aparepi brāhmaṇā attano brāhmaṇadhammaṃ chaḍḍetvā jīvikatthāya rājarājamahāmattānaṃ purato kaṃsatāḷe gahetvā vādentā gāyantā gacchanti.","<b>Pesanānipī</b>ti dāsakammakarā viya pesanānipi gacchanti.","<b>Rathacariyāsū</b>ti rathasippaṃ sikkhanti.","<b>Paricārakasamā</b>ti dāsakammakarasadisā.","<b>Vaṅkadaṇḍan</b>ti vaṅkadaṇḍakaṭṭhaṃ.","<b>Paccupessanti rājāno</b>ti rājarājamahāmatte paṭicca āgamma sandhāya upasevanti.","<b>Gāmesu nigamesu cā</b>ti tesaṃ nivesanadvāre nisīdanti.","<b>Niggāhakasamā</b>ti niggahakārakehi balisādhakarājapurisehi samā.","Yathā te purisā “aggahetvā na gamissāmā”ti niggahaṃ katvā gaṇhantiyeva, tathā “gāme vā vane vā aladdhā marantāpi na vuṭṭhahissāmā”ti upavasanti.","<b>Tepī</b>ti tepi balisādhakasadisā pāpadhammā."],"lineRefs":[["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"]]},{"para":3695,"vripara":null,"refs":["ja495:45"],"lines":["<b>Rajareṇūhī</b>ti rajehi ca paṃsūhi ca okiṇṇā.","<b>Yācakā</b>ti dhanayācakā.","<b>Khāṇughātasamā</b>ti malīnasarīratāya jhāmakhette khāṇughātakehi bhūmiṃ khaṇitvā jhāmakhāṇukauddharaṇakamanussehi samānā,“aggahetvā na gamissāmā”ti niccalabhāvena ṭhitattā nikhaṇitvā ṭhapitavatikhāṇukā viyātipi attho.","<b>Tepī</b>ti tepi tathā laddhaṃ dhanaṃ vaḍḍhiyā payojetvā puna tatheva ṭhitattā dussīlā brāhmaṇā."],"lineRefs":[["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"]]},{"para":3696,"vripara":null,"refs":["ja495:45"],"lines":["<b>Ucchupuṭan</b>ti ucchuñceva phāṇitapuṭañca.","<b>Madhuañjanan</b>ti madhuñceva añjanañca.","<b>Uccāvacānī</b>ti mahagghaappagghāni.","<b>Paṇiyānī</b>ti bhaṇḍāni.","<b>Vipaṇentī</b>ti vikkiṇanti.","<b>Tepī</b>ti tepi imāni ettakāni vikkiṇitvā jīvikakappakā vāṇijakabrāhmaṇā.","<b>Posayantī</b>ti gorasavikkayena jīvikakappanatthaṃ posenti.","<b>Pavecchantī</b>ti attano dhītaro hiraññasuvaṇṇaṃ gahetvā paresaṃ denti.","Te evaṃ paresaṃ dadamānā vivāhanti nāma, attano puttānaṃ atthāya gaṇhamānā āvāhanti nāma.","<b>Ambaṭṭhavessehī</b>ti kuṭumbikehi ceva gahapatīhi ca samā, tepi vohāravasena “brāhmaṇā”ti vuccanti."],"lineRefs":[["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"]]},{"para":3697,"vripara":null,"refs":["ja495:45"],"lines":["<b>Nikkhittabhikkhan</b>ti gāmapurohitā hutvā attano atthāya nibaddhabhikkhaṃ.","<b>Bahū te</b>ti bahū janā ete gāmapurohite nakkhattamuhuttamaṅgalāni pucchanti.","<b>Aṇḍacchedā nilañchakā</b>ti bhatiṃ gahetvā balibaddānaṃ aṇḍacchedakā ceva tisūlādiaṅkakaraṇena lañchakā ca, lakkhaṇakārakāti attho.","<b>Tatthā</b>ti tesaṃ gāmapurohitānaṃ gehesu maṃsavikkiṇanatthaṃ ete pasuādayopi haññanti.","<b>Tepī</b>ti tepi goghātakasamā brāhmaṇāti vuccanti."],"lineRefs":[["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"]]},{"para":3698,"vripara":null,"refs":["ja495:45"],"lines":["<b>Asicamman</b>ti asilaṭṭhiñceva kaṇḍavāraṇañca.","<b>Vessapathesū</b>ti vāṇijānaṃ gamanamaggesu.","<b>Satthaṃ abbāhayantī</b>ti satthavāhānaṃ hatthato satampi sahassampi gahetvā satthe corāṭaviṃ atibāhenti.","<b>Gopanisādehī</b>ti gopālakehi ceva nisādehi ca gāmaghātakacorehi samāti vuttaṃ.","<b>Tepī</b>ti tepi evarūpā brāhmaṇāti vuccanti.","<b>Kuṭāni kārayanti te</b>ti kūṭapāsādīni ropenti.","<b>Sasabiḷāre</b>ti sase ceva biḷāre ca.","Etena thalacare mige dasseti.","<b>Āgodhā macchakacchapan</b>ti thalajesu tāva āgodhato mahante ca khuddake ca pāṇayo bādhenti mārenti, jalajesu macchakacchape.","<b>Tepī</b>ti tepi luddakasamā brāhmaṇāti vuccanti."],"lineRefs":[["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"]]},{"para":3699,"vripara":null,"refs":["ja495:45"],"lines":["<b>Aññe dhanassa kāmā hī</b>ti apare brāhmaṇā dhanaṃ patthentā.","<b>Heṭṭhāmañce pasakkitā</b>ti “kalipavāhakammaṃ kāressāmā”ti ratanamayaṃ mañcaṃ kāretvā tassa heṭṭhā nipannā acchanti.","Atha nesaṃ somayāge upaṭṭhite rājāno upari nahāyanti, te kira somayāge niṭṭhite āgantvā tasmiṃ mañce nisīdanti.","Atha ne aññe brāhmaṇā “kaliṃ pavāhessāmā”ti nahāpenti.","Ratanamañco ceva rañño rājālaṅkāro ca sabbo heṭṭhāmañce nipannasseva hoti.","<b>Tepī</b>ti tepi malamajjakehi nahāpitehi sadisā brāhmaṇāti vuccanti."],"lineRefs":[["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"],["ja495:45"]]},{"para":3700,"vripara":null,"refs":["ja495:45"],"lines":["Evañcime vohāramattabrāhmaṇe dassetvā idāni paramatthabrāhmaṇe dassento dve gāthā abhāsi –"],"lineRefs":[["ja495:45"]]},{"para":3702,"vripara":"267","refs":["ja495:45"],"lines":["“Atthi kho brāhmaṇā deva, sīlavanto bahussutā;"],"lineRefs":[["ja495:45"]]},{"para":3703,"vripara":null,"refs":["ja495:45"],"lines":["Viratā methunā dhammā, ye te bhuñjeyyu bhojanaṃ."],"lineRefs":[["ja495:45"]]},{"para":3705,"vripara":"268","refs":["ja495:45"],"lines":["“Ekañca bhattaṃ bhuñjanti, na ca majjaṃ pivanti te;"],"lineRefs":[["ja495:45"]]},{"para":3706,"vripara":null,"refs":["ja495:45"],"lines":["Akkhātā te mahārāja, tādise nipatāmase”ti."],"lineRefs":[["ja495:45"]]},{"para":3707,"vripara":null,"refs":["ja495:45","ja495:47"],"lines":["Tattha <b>sīlavanto</b>ti ariyasīlena samannāgatā.","<b>Bahussutā</b>ti paṭivedhabāhusaccena samannāgatā.","<b>Tādise</b>ti evarūpe bāhitapāpe paccekabuddhabrāhmaṇe nimantanatthāya upasaṅkamāmāti."],"lineRefs":[["ja495:45"],["ja495:45"],["ja495:47"]]}],"wordLinks":[["ja495:45.3","dakkhiṇaṃ",0,2],["ja495:47.3","tādise",12,2]],"before":[{"para":3538,"vripara":null,"refs":[],"lines":["Evaṃ bodhisatto imā gāthāyo sabbaññutaññāṇena saṅkhipitvā kathesi.","Nārado punapi āha –","“rajjaṃ, deva, anusāsā”ti.","“Tāta, na me rajjenattho, satta vassasatāni vigataṃ dānaṃ sattāheneva dātukāmamhī”ti.","Nārado “sādhū”ti tassa vacanaṃ sampaṭicchitvā mahādānaṃ paṭiyādesi.","Rājā sattāhaṃ dānaṃ datvā sattame divase kālaṃ katvā tāvatiṃsabhavaneyeva nibbatti."],"lineRefs":[[],[],[],[],[],[]]},{"para":3539,"vripara":null,"refs":[],"lines":["Satthā imaṃ dhammadesanaṃ āharitvā “evaṃ vasitabbayuttakaṃ uposathakammaṃ nāmā”ti dassetvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne uposathikesu upāsakesu keci sotāpattiphale, keci sakadāgāmiphale, keci anāgāmiphale patiṭṭhahiṃsu.","Tadā nāradarājā sāriputto ahosi, mātali ānando, sakko anuruddho, sādhinarājā pana ahameva ahosinti."],"lineRefs":[[],[]]},{"para":3540,"vripara":null,"refs":[],"lines":["Sādhinajātakavaṇṇanā ekādasamā."],"lineRefs":[[]]},{"para":3542,"vripara":null,"refs":[],"lines":["[495]12. Dasabrāhmaṇajātakavaṇṇanā"],"lineRefs":[[]]},{"para":3543,"vripara":null,"refs":[],"lines":["<b>Rājā avoca vidhuran</b>ti idaṃ satthā jetavane viharanto asadisadānaṃ ārabbha kathesi.","Taṃ aṭṭhakanipāte <b>ādittajātake</b> (jā.1.8.69 ādayo) vitthāritameva.","Rājā kira taṃ dānaṃ dadanto satthāraṃ jeṭṭhakaṃ katvā pañca bhikkhusatāni vicinitvā gaṇhitvā mahākhīṇāsavānaṃyeva adāsi.","Athassa guṇakathaṃ kathentā “āvuso, rājā asadisadānaṃ dadanto vicinitvā mahapphalaṭṭhāne adāsī”ti dhammasabhāyaṃ kathaṃ samuṭṭhāpesuṃ.","Satthā āgantvā “kāya nuttha, bhikkhave, etarahi kathāya sannisinnā”ti pucchitvā “imāya nāmā”ti vutte “anacchariyaṃ, bhikkhave, yaṃ kosalarājā mādisassa buddhassa upaṭṭhāko hutvā viceyyadānaṃ deti, porāṇakapaṇḍitā anuppanne buddhepi viceyyadānaṃ adaṃsū”ti vatvā atītaṃ āhari."],"lineRefs":[[],[],[],[],[]]},{"para":3544,"vripara":null,"refs":[],"lines":["Atīte kururaṭṭhe indapatthanagare yudhiṭṭhilagotto korabyo nāma rājā rajjaṃ kāresi.","Tassa vidhuro nāma amacco atthañca dhammañca anusāsati.","Rājā sakalajambudīpaṃ khobhetvā mahādānaṃ deti.","Taṃ gahetvā bhuñjantesu ekopi pañcasīlamattaṃ rakkhanto nāma natthi, sabbe dussīlāva, dānaṃ rājānaṃ na toseti.","Rājā “viceyyadānaṃ mahapphalan”ti sīlavantānaṃ dātukāmo hutvā cintesi “vidhurapaṇḍitena saddhiṃ mantayissāmī”ti.","So taṃ upaṭṭhānaṃ āgataṃ āsane nisīdāpetvā pañhaṃ pucchi.","Tamatthaṃ pakāsento satthā upaḍḍhagāthamāha –"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":3546,"vripara":"222","refs":[],"lines":["“Rājā avoca vidhuraṃ, dhammakāmo yudhiṭṭhilo”ti;"],"lineRefs":[[]]},{"para":3547,"vripara":null,"refs":[],"lines":["Parato rañño ca vidhurassa ca vacanapaṭivacanaṃ hoti –"],"lineRefs":[[]]},{"para":3548,"vripara":null,"refs":[],"lines":["“Brāhmaṇe vidhura pariyesa, sīlavante bahussute."],"lineRefs":[[]]},{"para":3550,"vripara":"223","refs":[],"lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"],"lineRefs":[[]]},{"para":3551,"vripara":null,"refs":[],"lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ."],"lineRefs":[[]]},{"para":3553,"vripara":"224","refs":[],"lines":["“Dullabhā brāhmaṇā deva, sīlavanto bahussutā;"],"lineRefs":[[]]},{"para":3554,"vripara":null,"refs":[],"lines":["Viratā methunā dhammā, ye te bhuñjeyyu bhojanaṃ."],"lineRefs":[[]]},{"para":3556,"vripara":"225","refs":[],"lines":["“Dasa khalu mahārāja, yā tā brāhmaṇajātiyo;"],"lineRefs":[[]]},{"para":3557,"vripara":null,"refs":[],"lines":["Tesaṃ vibhaṅgaṃ vicayaṃ, vitthārena suṇohi me."],"lineRefs":[[]]},{"para":3559,"vripara":"226","refs":[],"lines":["“Pasibbake gahetvāna, puṇṇe mūlassa saṃvute;"],"lineRefs":[[]]},{"para":3560,"vripara":null,"refs":[],"lines":["Osadhikāyo ganthenti, nhāpayanti japanti ca."],"lineRefs":[[]]},{"para":3562,"vripara":"227","refs":[],"lines":["“Tikicchakasamā rāja, tepi vuccanti brāhmaṇā;"],"lineRefs":[[]]},{"para":3563,"vripara":null,"refs":[],"lines":["Akkhātā te mahārāja, tādise nipatāmase."],"lineRefs":[[]]},{"para":3565,"vripara":"228","refs":[],"lines":["“Apetā te ca brahmaññā,(iti rājā korabyo)"],"lineRefs":[[]]},{"para":3566,"vripara":null,"refs":[],"lines":["Na te vuccanti brāhmaṇā;"],"lineRefs":[[]]},{"para":3567,"vripara":null,"refs":[],"lines":["Aññe vidhura pariyesa, sīlavante bahussute."],"lineRefs":[[]]},{"para":3569,"vripara":"229","refs":[],"lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"],"lineRefs":[[]]},{"para":3570,"vripara":null,"refs":[],"lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ."],"lineRefs":[[]]},{"para":3572,"vripa