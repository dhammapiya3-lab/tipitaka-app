{"suttaId":"sn48.23","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1223,1223],"vripara":"493"},"segments":{"sn48.23:0.3":"Aññindriyasuttaṃ","sn48.23:1.1":"“Tīṇimāni, bhikkhave, indriyāni.","sn48.23:1.2":"Katamāni tīṇi?","sn48.23:1.3":"Anaññātaññassāmītindriyaṃ, aññindriyaṃ, aññātāvindriyaṃ –","sn48.23:1.4":"imāni kho, bhikkhave, tīṇi indriyānī”ti.","sn48.23:1.5":"Tatiyaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":562,"to":562,"paras":[{"para":562,"vripara":"493","refs":["sn48.23:1"],"lines":["Tatiye <b>anaññātaññassāmītindriyan</b>ti “anamatagge saṃsāre ajānitapubbaṃ dhammaṃ jānissāmī”ti paṭipannassa sotāpattimaggakkhaṇe uppannaṃ indriyaṃ.","<b>Aññindriyan</b>ti tesaṃyeva ñātadhammānaṃ ājānanākārena sotāpattiphalādīsu chasu ṭhānesu uppannaṃ indriyaṃ.","<b>Aññātāvindriyan</b>ti aññātāvīsu arahattaphaladhammesu uppannaṃ indriyaṃ.","Tattha tattha tena tenākārena uppannassa ñāṇassevetaṃ adhivacanaṃ.","Idampi suttaṃ atthuppattikameva.","Saṅghamajjhasmiñhi “kati nu kho lokuttarindriyānī”ti kathā udapādi, atha bhagavā tāni dassento <b>tīṇimāni, bhikkhave, indriyānī</b>tiādimāha."],"lineRefs":[["sn48.23:1"],["sn48.23:1"],["sn48.23:1"],["sn48.23:1"],["sn48.23:1"],["sn48.23:1"]]}],"wordLinks":[["sn48.23:1.3","anaññātaññassāmītindriyaṃ",0,0],["sn48.23:1.3","aññindriyaṃ",0,1],["sn48.23:1.3","aññātāvindriyaṃ",0,2],["sn48.23:1.1","tīṇimāni bhikkhave indriyānī",0,5]],"before":[{"para":561,"vripara":null,"title":"Aññindriyasuttavaṇṇanā","lines":["Aññindriyasuttavaṇṇanā"]}]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":488,"to":488,"paras":[{"para":488,"vripara":"493","refs":["sn48.23:1"],"lines":["<b>Ajānitapubbaṃ dhamman</b>ti catusaccadhammamāha, tathā <b>tesaṃyeva ñātadhammānan</b>ti.","Ayaṃ panettha attho – ājānātīti <b>aññā,</b> paṭhamamaggena ñātamanatikkamitvā jānātīti attho.","Sotāpannādīnaṃ chaariyānaṃ etaṃ nāmaṃ.","Aññassa indriyāni <b>aññindriyāni.</b>","<b>Aññātāvīsū</b>ti ājānitavantesu.","Yasmā aggaphaladhammesu ñāṇakiccaṃ sātisayaṃ, tasmā taṃ kiccaṃ sesadhammesupi samāropetvā vuttaṃ <b>“aññātāvīsu arahattaphaladhammesū”</b>ti.","<b>Tattha tattha</b> tesu tesu maggaphalesu.","<b>Tena tenākārenā</b>ti anaññātajānanādiākārena."],"lineRefs":[["sn48.23:1"],["sn48.23:1"],["sn48.23:1"],["sn48.23:1"],["sn48.23:1"],["sn48.23:1"],["sn48.23:1"],["sn48.23:1"]]}],"wordLinks":[["sn48.23:1.3","aññā",0,1]],"before":[{"para":487,"vripara":null,"title":"Aññindriyasuttavaṇṇanā","lines":["Aññindriyasuttavaṇṇanā"]}]},"tika2":null}
