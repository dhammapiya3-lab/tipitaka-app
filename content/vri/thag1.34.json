{"suttaId":"thag1.34","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[202,206],"vripara":"34"},"segments":{"thag1.34:0.4":"Posiyattheragāthā","thag1.34:1.1":"“Anāsannavarā etā, niccameva vijānatā;","thag1.34:1.3":"Gāmā araññamāgamma, tato gehaṃ upāvisi [upāvisiṃ (sī.)];","thag1.34:1.5":"Tato uṭṭhāya pakkāmi, anāmantetvā [anāmantiya (sī.)] posiyo”ti.","thag1.34:1.7":"… Posiyo thero …."},"attha":null,"tika":null}
