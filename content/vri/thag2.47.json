{"suttaId":"thag2.47","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1107,1113],"vripara":"213"},"segments":{"thag2.47:0.4":"Anūpamattheragāthā","thag2.47:1.1":"“Nandamānāgataṃ cittaṃ, sūlamāropamānakaṃ;","thag2.47:1.3":"Tena teneva vajasi, yena sūlaṃ kaliṅgaraṃ.","thag2.47:2.1":"“Tāhaṃ cittakaliṃ brūmi, taṃ brūmi cittadubbhakaṃ;","thag2.47:2.3":"Satthā te dullabho laddho, mānatthe maṃ niyojayī”ti.","thag2.47:2.5":"… Anūpamo thero …."},"attha":null,"tika":null}
