{"suttaId":"sn23.20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[941,941],"vripara":"179"},"segments":{"sn23.20:0.3":"Vayadhammasuttaṃ","sn23.20:1.1":"Sāvatthinidānaṃ.","sn23.20:1.2":"Ekamantaṃ nisinno kho āyasmā rādho bhagavantaṃ etadavoca –","sn23.20:1.3":"“‘vayadhammo, vayadhammo’ti, bhante, vuccati.","sn23.20:1.4":"Katamo nu kho, bhante, vayadhammo”ti?","sn23.20:1.5":"“Rūpaṃ kho, rādha, vayadhammo, vedanā vayadhammo, saññā vayadhammo, saṅkhārā vayadhammo, viññāṇaṃ vayadhammo.","sn23.20:1.6":"Evaṃ passaṃ … pe … nāparaṃ itthattāyāti pajānātī”ti.","sn23.20:1.8":"Dasamaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":410,"to":413,"paras":[{"para":410,"vripara":"170-181","refs":["sn23.20:1"],"lines":["170-181. Dutiyavaggassa paṭhame <b>māro, māro</b>ti maraṇaṃ pucchati.","Yasmā pana rūpādivinimuttaṃ maraṇaṃ nāma natthi, tenassa bhagavā <b>rūpaṃ kho, rādha, māro</b>tiādimāha.","Dutiye <b>māradhammo</b>ti maraṇadhammo.","Etenupāyena sabbattha attho veditabboti."],"lineRefs":[["sn23.20:1"],["sn23.20:1"],["sn23.20:1"],["sn23.20:1"]]},{"para":411,"vripara":null,"refs":[],"lines":["Dutiyo vaggo."],"lineRefs":[[]]},{"para":412,"vripara":null,"refs":[],"lines":["3-4. Āyācanavaggādi"],"lineRefs":[[]]},{"para":413,"vripara":null,"refs":["sn23.20:1"],"lines":["1-11. Mārādisuttaekādasakavaṇṇanā"],"lineRefs":[["sn23.20:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":420,"to":424,"paras":[{"para":420,"vripara":"170-181","refs":["sn23.20:1"],"lines":["170-181. <b>Rūpādivinimuttaṃ maraṇaṃ nāma natthi</b> rūpādīnaṃyeva vibhave maraṇasamaññāti.","<b>Maraṇadhammo</b> vināsabhāvo."],"lineRefs":[["sn23.20:1"],["sn23.20:1"]]},{"para":421,"vripara":null,"refs":[],"lines":["Mārasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":422,"vripara":null,"refs":[],"lines":["Dutiyavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":423,"vripara":null,"refs":[],"lines":["3-4. Āyācanavaggādi"],"lineRefs":[[]]},{"para":424,"vripara":null,"refs":["sn23.20:1"],"lines":["1-11. Mārādisuttaekādasakavaṇṇanā"],"lineRefs":[["sn23.20:1"]]}],"wordLinks":[]},"tika2":null}
