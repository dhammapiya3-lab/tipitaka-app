{"suttaId":"sn26.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1181,1181],"vripara":"319"},"segments":{"sn26.8:0.3":"Taṇhāsuttaṃ","sn26.8:1.1":"Sāvatthinidānaṃ.","sn26.8:1.2":"“Yo kho, bhikkhave, rūpataṇhāya uppādo ṭhiti … pe … jarāmaraṇassa pātubhāvo … pe … yo dhammataṇhāya uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo.","sn26.8:1.5":"Yo ca kho, bhikkhave, rūpataṇhāya nirodho … pe … jarāmaraṇassa atthaṅgamo … pe … yo dhammataṇhāya nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo”ti.","sn26.8:1.8":"Aṭṭhamaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":452,"to":454,"paras":[{"para":452,"vripara":"312-321","refs":["sn26.8:1"],"lines":["312-321. Uppādasaṃyutte sabbaṃ pākaṭameva."],"lineRefs":[["sn26.8:1"]]},{"para":453,"vripara":null,"refs":["sn26.8:1"],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn26.8:1"]]},{"para":454,"vripara":null,"refs":["sn26.8:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.8:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":476,"to":478,"paras":[{"para":476,"vripara":"312-321","refs":["sn26.8:1"],"lines":["312-321. <b>Sabbaṃ pākaṭameva</b> apubbassa abhāvato."],"lineRefs":[["sn26.8:1"]]},{"para":477,"vripara":null,"refs":["sn26.8:1"],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn26.8:1"]]},{"para":478,"vripara":null,"refs":["sn26.8:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.8:1"]]}],"wordLinks":[]},"tika2":null}
