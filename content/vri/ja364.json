{"suttaId":"ja364","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[3323,3338],"vripara":"75"},"segments":{"ja364:0.4":"Khajjopanakajātakaṃ (5-2-4)","ja364:1.1":"Ko nu santamhi pajjote, aggipariyesanaṃ caraṃ;","ja364:1.3":"Addakkhi ratti [rattiṃ (syā.)] khajjotaṃ, jātavedaṃ amaññatha.","ja364:2.1":"Svassa gomayacuṇṇāni, abhimatthaṃ tiṇāni ca;","ja364:2.3":"Viparītāya saññāya, nāsakkhi pajjaletave.","ja364:3.1":"Evampi anupāyena, atthaṃ na labhate migo [mūgo (syā.)];","ja364:3.3":"Visāṇato gavaṃ dohaṃ, yattha khīraṃ na vindati.","ja364:4.1":"Vividhehi upāyehi, atthaṃ papponti māṇavā;","ja364:4.3":"Niggahena amittānaṃ, mittānaṃ paggahena ca.","ja364:5.1":"Senāmokkhapalābhena [senī mokkhūpalābhena (syā.)], vallabhānaṃ nayena ca;","ja364:5.3":"Jagatiṃ jagatipālā, āvasanti vasundharanti.","ja364:6.1":"Khajjopanakajātakaṃ catutthaṃ."},"attha":null,"tika":null}
