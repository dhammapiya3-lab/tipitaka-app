{"suttaId":"thag2.36","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1010,1018],"vripara":"191"},"segments":{"thag2.36:0.4":"Nitakattheragāthā","thag2.36:1.1":"[udā.34 udānepi]“Kassa selūpamaṃ cittaṃ, ṭhitaṃ nānupakampati;","thag2.36:1.3":"Virattaṃ rajanīyesu, kuppanīye na kuppati;","thag2.36:1.5":"Yassevaṃ bhāvitaṃ cittaṃ, kuto taṃ dukkhamessati.","thag2.36:2.1":"“Mama selūpamaṃ cittaṃ, ṭhitaṃ nānupakampati;","thag2.36:2.3":"Virattaṃ rajanīyesu, kuppanīye na kuppati;","thag2.36:2.5":"Mamevaṃ bhāvitaṃ cittaṃ, kuto maṃ dukkhamessatī”ti.","thag2.36:2.7":"… Nitako [khitako (sī. syā.)] thero …."},"attha":null,"tika":null}
