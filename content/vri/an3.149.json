{"suttaId":"an3.149","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1244,1245],"vripara":"150"},"segments":{"an3.149:0.3":"Asucisuttaṃ","an3.149:1.1":"“Tīhi, bhikkhave…pe…","an3.149:1.2":"asucinā kāyakammena, asucinā vacīkammena, asucinā manokammena –","an3.149:1.3":"imehi kho…pe… evaṃ niraye.","an3.149:2.1":"“Tīhi, bhikkhave…pe…","an3.149:2.2":"sucinā kāyakammena, sucinā vacīkammena, sucinā manokammena –","an3.149:2.3":"imehi kho, bhikkhave, tīhi dhammehi samannāgato yathābhataṃ nikkhitto evaṃ sagge”ti.","an3.149:2.4":"Catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":978,"to":979,"paras":[{"para":978,"vripara":"147-155","refs":["an3.149:1"],"lines":["Pañcamassa paṭhame <b>yathābhataṃ nikkhitto</b>ti yathā ānetvā ṭhapito.","Dutiye <b>sāvajjenā</b>ti sadosena.","Tatiye <b>visamenā</b>ti sapakkhalanena.","<b>Samenā</b>ti apakkhalanena.","Catutthe <b>asucinā</b>ti gūthasadisena aparisuddhena amejjhena.","<b>Sucinā</b>ti parisuddhena mejjhena.","Pañcamādīni uttānāneva. 10."],"lineRefs":[["an3.149:1"],["an3.149:1"],["an3.149:1"],["an3.149:1"],["an3.149:1"],["an3.149:1"],["an3.149:1"]]},{"para":979,"vripara":null,"refs":["an3.149:1"],"lines":["Pubbaṇhasuttavaṇṇanā 156."],"lineRefs":[["an3.149:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":1009,"to":1011,"paras":[{"para":1009,"vripara":"147-156","refs":["an3.149:1"],"lines":["Maṅgalavaggo uttānatthoyeva."],"lineRefs":[["an3.149:1"]]},{"para":1010,"vripara":null,"refs":["an3.149:1"],"lines":["Tatiyapaṇṇāsakaṃ niṭṭhitaṃ. (16) 6."],"lineRefs":[["an3.149:1"]]},{"para":1011,"vripara":null,"refs":["an3.149:1"],"lines":["Acelakavaggavaṇṇanā 157-163."],"lineRefs":[["an3.149:1"]]}],"wordLinks":[]},"tika2":null}
