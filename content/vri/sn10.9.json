{"suttaId":"sn10.9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[3128,3132],"vripara":"243"},"segments":{"sn10.9:0.3":"Paṭhamasukkāsuttaṃ","sn10.9:1.1":"Ekaṃ samayaṃ bhagavā rājagahe viharati veḷuvane kalandakanivāpe.","sn10.9:1.2":"Tena kho pana samayena sukkā bhikkhunī mahatiyā parisāya parivutā dhammaṃ deseti.","sn10.9:1.3":"Atha kho sukkāya bhikkhuniyā abhippasanno yakkho rājagahe rathikāya rathikaṃ siṅghāṭakena siṅghāṭakaṃ upasaṅkamitvā tāyaṃ velāyaṃ imā gāthāyo abhāsi –","sn10.9:2.1":"“Kiṃ me katā rājagahe manussā,","sn10.9:2.2":"madhupītāva seyare;","sn10.9:2.3":"Ye sukkaṃ na payirupāsanti,","sn10.9:2.4":"desentiṃ amataṃ padaṃ.","sn10.9:3.1":"“Tañca pana appaṭivānīyaṃ,","sn10.9:3.2":"asecanakamojavaṃ;","sn10.9:3.3":"Pivanti maññe sappaññā,","sn10.9:3.4":"valāhakamiva panthagū”ti [valāhakamivaddhagūti (sī.)]. 10."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1329,"to":1330,"paras":[{"para":1329,"vripara":"243","refs":["sn10.9:1","sn10.9:2"],"lines":["Navame <b>rathikāya rathika</b>nti ekaṃ rathikaṃ gahetvā tato aparaṃ gacchanto rathikāya rathikaṃ upasaṅkamanto nāma hoti.","Siṅghāṭakepi eseva nayo.","Ettha ca <b>rathikā</b>ti racchā.","<b>Siṅghāṭaka</b>nti catukkaṃ.","<b>Kiṃ me katā</b>ti kiṃ ime katā?","Kiṃ karontīti attho.","<b>Madhupītāva</b> <b>seyare</b>ti gandhamadhupānaṃ pītā viya sayanti.","Gandhamadhupānaṃ pīto kira sīsaṃ ukkhipituṃ na sakkoti, asaññī hutvā sayateva.","Tasmā evamāha."],"lineRefs":[["sn10.9:1"],["sn10.9:1"],["sn10.9:1"],["sn10.9:1"],["sn10.9:2"],["sn10.9:2"],["sn10.9:2"],["sn10.9:2"],["sn10.9:2"]]},{"para":1330,"vripara":null,"refs":["sn10.9:3"],"lines":["<b>Tañca pana appaṭivānīya</b>nti tañca pana dhammaṃ appaṭivānīyaṃ deseti.","Bāhirakañhi sumadhurampi bhojanaṃ punappunaṃ bhuñjantassa na ruccati, “apanetha, kiṃ iminā”ti?","Paṭivānetabbaṃ apanetabbaṃ hoti, na evamayaṃ dhammo.","Imaṃ hi dhammaṃ paṇḍitā vassasatampi vassasahassampi suṇantā tittiṃ na gacchanti.","Tenāha “appaṭivānīya”nti.","<b>Asecanakamojava</b>nti anāsittakaṃ ojavantaṃ.","Yathā hi bāhirāni asambhinnapāyāsādīnipi sappimadhusakkharāhi āsittāni yojitāneva madhurāni ojavantāni honti, na evamayaṃ dhammo.","Ayaṃ hi attano dhammatāya madhuro ceva ojavā ca, na aññena upasitto.","Tenāha “asecanakamojava”nti.","<b>Pivanti maññe sappaññā</b>ti paṇḍitapurisā pivanti viya.","<b>Valāhakameva panthagū</b>ti valāhakantarato nikkhantaudakaṃ ghammābhitattā pathikā viya.","Navamaṃ. 10-11."],"lineRefs":[["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"]]}],"wordLinks":[["sn10.9:1.3","rathikāya rathikaṃ",0,0],["sn10.9:1.3","rathikā",0,2],["sn10.9:1.3","siṅghāṭakaṃ",0,3],["sn10.9:2.1","kiṃ me katā",0,4],["sn10.9:2.1","madhupītāva seyare",0,6],["sn10.9:3.1","tañca pana appaṭivānīyaṃ",1,0],["sn10.9:3.1","asecanakamojavaṃ",1,5],["sn10.9:3.3","pivanti maññe sappaññā",1,9]],"before":[{"para":1328,"vripara":null,"title":"Paṭhamasukkāsuttavaṇṇanā","lines":["Paṭhamasukkāsuttavaṇṇanā 243."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1544,"to":1545,"paras":[{"para":1544,"vripara":"243","refs":["sn10.9:1","sn10.9:2"],"lines":["<b>Rathika</b>nti racchaṃ.","<b>Gahetvā</b>ti gantvā.","<b>Siṅghāṭaka</b>nti aññattha tikoṇā racchā vuccati.","Idha pana “catukka”nti vuttaṃ.","<b>“Madhupīkā”</b>ti ettha <b>madhu</b>-saddena madhuviseso vuccatīti āha <b>“gandhamadhupānaṃ pītā viyā”</b>ti.","Sāmaññajotanā hi visese tiṭṭhatīti <b>gandhamadhū</b>ti ca ativiya madhuro madaniyo eko madhuviseso.","Tenāha <b>“asaññī hutvā sayatevā”</b>ti."],"lineRefs":[["sn10.9:1"],["sn10.9:1"],["sn10.9:1"],["sn10.9:1"],["sn10.9:2"],["sn10.9:2"],["sn10.9:2"]]},{"para":1545,"vripara":null,"refs":["sn10.9:3"],"lines":["Na paṭivānīyaṃ na apanetabbanti <b>appaṭivānīyaṃ</b>.","Tenāha <b>“bāhirakañhī”</b>tiādi.","Yaṃ kiñci santapaṇītabhāvāvahaṃ na secananti <b>asecanakaṃ</b>.","Tato eva <b>anāsittakaṃ.</b>","<b>Ojavanta</b>nti bahusammataojavantasadisatāya ojavantaṃ.","Tenāha <b>“yathā hī”</b>tiādi.","<b>Dhammatāyā</b>ti attano sabhāveneva.","<b>Madhuro</b> iṭṭho.","<b>Pivantī viyā</b>ti sukkāya bhikkhuniyā upanīyamānaṃ saddhammāmatarasaṃ attano sotañjaliṃ pūretvā odahantīva.","Valāhakato āgataṃ <b>valāhakaṃ</b>."],"lineRefs":[["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"],["sn10.9:3"]]}],"wordLinks":[["sn10.9:1.3","rathikaṃ",0,0],["sn10.9:1.3","siṅghāṭakaṃ",0,2],["sn10.9:2.1","madhu",0,4],["sn10.9:3.1","appaṭivānīyaṃ",1,0],["sn10.9:3.1","asecanakaṃ",1,2],["sn10.9:3.3","valāhakaṃ",1,9]],"before":[{"para":1543,"vripara":null,"title":"Paṭhamasukkāsuttavaṇṇanā","lines":["Paṭhamasukkāsuttavaṇṇanā 243."]}],"after":[{"para":1546,"vripara":null,"title":"Paṭhamasukkāsuttavaṇṇanā","lines":["Paṭhamasukkāsuttavaṇṇanā niṭṭhitā. 10."]}]},"tika2":null}
