{"suttaId":"ja33","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[186,189],"vripara":"33"},"segments":{"ja33:0.4":"Sammodamānajātakaṃ","ja33:1.1":"Sammodamānā gacchanti, jālamādāya pakkhino;","ja33:1.3":"Yadā te vivadissanti, tadā ehinti me vasanti.","ja33:2.1":"Sammodamānajātakaṃ tatiyaṃ."},"attha":null,"tika":null}
