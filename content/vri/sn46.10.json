{"suttaId":"sn46.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[472,477],"vripara":"191"},"segments":{"sn46.10:0.3":"Dutiyauppannasuttaṃ","sn46.10:1.1":"“Sattime, bhikkhave, bojjhaṅgā bhāvitā bahulīkatā anuppannā uppajjanti, nāññatra sugatavinayā.","sn46.10:1.2":"Katame satta?","sn46.10:1.3":"Satisambojjhaṅgo … pe … upekkhāsambojjhaṅgo –","sn46.10:1.4":"ime kho, bhikkhave, satta bojjhaṅgā bhāvitā bahulīkatā anuppannā uppajjanti, nāññatra sugatavinayā”ti.","sn46.10:1.5":"Dasamaṃ.","sn46.10:1.6":"Pabbatavaggo paṭhamo.","sn46.10:2.0":"Tassuddānaṃ –","sn46.10:2.1":"Himavantaṃ kāyaṃ sīlaṃ,","sn46.10:2.2":"vatthaṃ bhikkhu ca kuṇḍali;","sn46.10:2.3":"Kūṭañca upavānañca,","sn46.10:2.4":"uppannā apare duveti."},"unsure":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":173,"to":173,"paras":[{"para":173,"vripara":"191","refs":["sn46.10:1"],"lines":["Dasame <b>nāññatra sugatavinayā</b>ti sugatovādaṃ vinā na uppajjantīti."],"lineRefs":[["sn46.10:1"]]}],"wordLinks":[["sn46.10:1.1","nāññatra sugatavinayā",0,0],["sn46.10:1.3","nāññatra sugatavinayā",0,0]],"before":[{"para":172,"vripara":null,"refs":[],"lines":["Dutiyauppannasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
