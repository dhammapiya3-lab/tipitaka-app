{"suttaId":"thig15.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[1407,1552],"vripara":"402"},"segments":{"thig15.1:0.3":"Isidāsītherīgāthā","thig15.1:1.1":"Nagaramhi kusumanāme,","thig15.1:1.2":"pāṭaliputtamhi pathaviyā maṇḍe;","thig15.1:1.3":"Sakyakulakulīnāyo,","thig15.1:1.4":"dve bhikkhuniyo hi guṇavatiyo.","thig15.1:2.1":"Isidāsī tattha ekā,","thig15.1:2.2":"dutiyā bodhīti sīlasampannā ca;","thig15.1:2.3":"Jhānajjhāyanaratāyo,","thig15.1:2.4":"bahussutāyo dhutakilesāyo.","thig15.1:3.1":"Tā piṇḍāya caritvā,","thig15.1:3.2":"bhattatthaṃ [bhattattaṃ (sī.)] kariya dhotapattāyo;","thig15.1:3.3":"Rahitamhi sukhanisinnā,","thig15.1:3.4":"imā girā abbhudīresuṃ.","thig15.1:4.1":"“Pāsādikāsi ayye,","thig15.1:4.2":"isidāsi vayopi te aparihīno;","thig15.1:4.3":"Kiṃ disvāna byālikaṃ,","thig15.1:4.4":"athāsi nekkhammamanuyuttā”.","thig15.1:5.1":"Evamanuyuñjiyamānā sā,","thig15.1:5.2":"rahite dhammadesanākusalā;","thig15.1:5.3":"Isidāsī vacanamabravi,","thig15.1:5.4":"“suṇa bodhi yathāmhi pabbajitā.","thig15.1:6.1":"“Ujjeniyā puravare,","thig15.1:6.2":"mayhaṃ pitā sīlasaṃvuto seṭṭhi;","thig15.1:6.3":"Tassamhi ekadhītā,","thig15.1:6.4":"piyā manāpā ca dayitā ca.","thig15.1:7.1":"“Atha me sāketato varakā,","thig15.1:7.2":"āgacchumuttamakulīnā;","thig15.1:7.3":"Seṭṭhī pahūtaratano,","thig15.1:7.4":"tassa mamaṃ suṇhamadāsi tāto.","thig15.1:8.1":"“Sassuyā sassurassa ca,","thig15.1:8.2":"sāyaṃ pātaṃ paṇāmamupagamma;","thig15.1:8.3":"Sirasā karomi pāde,","thig15.1:8.4":"vandāmi yathāmhi anusiṭṭhā.","thig15.1:9.1":"“Yā mayhaṃ sāmikassa,","thig15.1:9.2":"bhaginiyo bhātuno parijano vā;","thig15.1:9.3":"Tamekavarakampi disvā,","thig15.1:9.4":"ubbiggā āsanaṃ demi.","thig15.1:10.1":"“Annena ca pānena ca,","thig15.1:10.2":"khajjena ca yañca tattha sannihitaṃ;","thig15.1:10.3":"Chādemi upanayāmi ca,","thig15.1:10.4":"demi ca yaṃ yassa patirūpaṃ.","thig15.1:11.1":"“Kālena upaṭṭhahitvā [uṭṭhahitvā (syā. ka.), upaṭṭhahituṃ (?)],","thig15.1:11.2":"gharaṃ samupagamāmi ummāre;","thig15.1:11.3":"Dhovantī hatthapāde,","thig15.1:11.4":"pañjalikā sāmikamupemi.","thig15.1:12.1":"“Kocchaṃ pasādaṃ añjaniñca,","thig15.1:12.2":"ādāsakañca gaṇhitvā;","thig15.1:12.3":"Parikammakārikā viya,","thig15.1:12.4":"sayameva patiṃ vibhūsemi.","thig15.1:13.1":"“Sayameva odanaṃ sādhayāmi,","thig15.1:13.2":"sayameva bhājanaṃ dhovantī;","thig15.1:13.3":"Mātāva ekaputtakaṃ,","thig15.1:13.4":"tathā [tadā (sī.)] bhattāraṃ paricarāmi.","thig15.1:14.1":"“Evaṃ maṃ bhattikataṃ,","thig15.1:14.2":"anurattaṃ kārikaṃ nihatamānaṃ;","thig15.1:14.3":"Uṭṭhāyikaṃ [uṭṭhāhikaṃ (ka.)] analasaṃ,","thig15.1:14.4":"sīlavatiṃ dussate bhattā.","thig15.1:15.1":"“So mātarañca pitarañca,","thig15.1:15.2":"bhaṇati ‘āpucchahaṃ gamissāmi;","thig15.1:15.3":"Isidāsiyā na saha vacchaṃ,","thig15.1:15.4":"ekāgārehaṃ [ekagharepa’ haṃ (?)] saha vatthuṃ’.","thig15.1:16.1":"“‘Mā evaṃ putta avaca,","thig15.1:16.2":"isidāsī paṇḍitā paribyattā;","thig15.1:16.3":"Uṭṭhāyikā analasā,","thig15.1:16.4":"kiṃ tuyhaṃ na rocate putta’.","thig15.1:17.1":"“‘Na ca me hiṃsati kiñci,","thig15.1:17.2":"na cahaṃ isidāsiyā saha vacchaṃ;","thig15.1:17.3":"Dessāva me alaṃ me,","thig15.1:17.4":"apucchāhaṃ [āpucchāhaṃ (syā.), āpucchahaṃ-nāpucchahaṃ (?)] gamissāmi’.","thig15.1:18.1":"“Tassa vacanaṃ suṇitvā,","thig15.1:18.2":"sassu sasuro ca maṃ apucchiṃsu;","thig15.1:18.3":"‘Kissa [kiṃsa (?)] tayā aparaddhaṃ,","thig15.1:18.4":"bhaṇa vissaṭṭhā yathābhūtaṃ’.","thig15.1:19.1":"“‘Napihaṃ aparajjhaṃ kiñci,","thig15.1:19.2":"napi hiṃsemi na bhaṇāmi dubbacanaṃ;","thig15.1:19.3":"Kiṃ sakkā kātuyye,","thig15.1:19.4":"yaṃ maṃ viddessate bhattā’.","thig15.1:20.1":"“Te maṃ pitugharaṃ paṭinayiṃsu,","thig15.1:20.2":"vimanā dukhena adhibhūtā;","thig15.1:20.3":"‘Puttamanurakkhamānā,","thig15.1:20.4":"jitāmhase rūpiniṃ lakkhiṃ’.","thig15.1:21.1":"“Atha maṃ adāsi tāto,","thig15.1:21.2":"aḍḍhassa gharamhi dutiyakulikassa;","thig15.1:21.3":"Tato upaḍḍhasuṅkena,","thig15.1:21.4":"yena maṃ vindatha seṭṭhi.","thig15.1:22.1":"“Tassapi gharamhi māsaṃ,","thig15.1:22.2":"avasiṃ atha sopi maṃ paṭiccharayi [paṭicchasi (sī. ka.), paṭicchati (syā.), paṭiccharati (ka.)];","thig15.1:22.3":"Dāsīva upaṭṭhahantiṃ,","thig15.1:22.4":"adūsikaṃ sīlasampannaṃ.","thig15.1:23.1":"“Bhikkhāya ca vicarantaṃ,","thig15.1:23.2":"damakaṃ dantaṃ me pitā bhaṇati;","thig15.1:23.3":"‘Hohisi [sohisi (sabbattha)] me jāmātā,","thig15.1:23.4":"nikkhipa poṭṭhiñca [pontiṃ (sī. syā.)] ghaṭikañca’.","thig15.1:24.1":"“Sopi vasitvā pakkhaṃ [pakkamatha (sī.)],","thig15.1:24.2":"atha tātaṃ bhaṇati ‘dehi me poṭṭhiṃ;","thig15.1:24.3":"Ghaṭikañca mallakañca,","thig15.1:24.4":"punapi bhikkhaṃ carissāmi’.","thig15.1:25.1":"“Atha naṃ bhaṇatī tāto,","thig15.1:25.2":"ammā sabbo ca me ñātigaṇavaggo;","thig15.1:25.3":"‘Kiṃ te na kīrati idha,","thig15.1:25.4":"bhaṇa khippaṃ taṃ te karihi’ti.","thig15.1:26.1":"“Evaṃ bhaṇito bhaṇati,","thig15.1:26.2":"‘yadi me attā sakkoti alaṃ mayhaṃ;","thig15.1:26.3":"Isidāsiyā na saha vacchaṃ,","thig15.1:26.4":"ekagharehaṃ saha vatthuṃ’.","thig15.1:27.1":"“Vissajjito gato so,","thig15.1:27.2":"ahampi ekākinī vicintemi;","thig15.1:27.3":"‘Āpucchitūna gacchaṃ,","thig15.1:27.4":"marituye [maritāye (sī.), marituṃ (syā.)] vā pabbajissaṃ vā’.","thig15.1:28.1":"“Atha ayyā jinadattā,","thig15.1:28.2":"āgacchī gocarāya caramānā;","thig15.1:28.3":"Tātakulaṃ vinayadharī,","thig15.1:28.4":"bahussutā sīlasampannā.","thig15.1:29.1":"“Taṃ disvāna amhākaṃ,","thig15.1:29.2":"uṭṭhāyāsanaṃ tassā paññāpayiṃ;","thig15.1:29.3":"Nisinnāya ca pāde,","thig15.1:29.4":"vanditvā bhojanamadāsiṃ.","thig15.1:30.1":"“Annena ca pānena ca,","thig15.1:30.2":"khajjena ca yañca tattha sannihitaṃ;","thig15.1:30.3":"Santappayitvā avacaṃ,","thig15.1:30.4":"‘ayye icchāmi pabbajituṃ’.","thig15.1:31.1":"“Atha maṃ bhaṇatī tāto,","thig15.1:31.2":"‘idheva puttaka [puttike (syā. ka.)] carāhi tvaṃ dhammaṃ;","thig15.1:31.3":"Annena ca pānena ca,","thig15.1:31.4":"tappaya samaṇe dvijātī ca’.","thig15.1:32.1":"“Athahaṃ bhaṇāmi tātaṃ,","thig15.1:32.2":"rodantī añjaliṃ paṇāmetvā;","thig15.1:32.3":"‘Pāpañhi mayā pakataṃ,","thig15.1:32.4":"kammaṃ taṃ nijjaressāmi’.","thig15.1:33.1":"“Atha maṃ bhaṇatī tāto,","thig15.1:33.2":"‘pāpuṇa bodhiñca aggadhammañca;","thig15.1:33.3":"Nibbānañca labhassu,","thig15.1:33.4":"yaṃ sacchikarī dvipadaseṭṭho’.","thig15.1:34.1":"“Mātāpitū abhivādayitvā,","thig15.1:34.2":"sabbañca ñātigaṇavaggaṃ;","thig15.1:34.3":"Sattāhaṃ pabbajitā,","thig15.1:34.4":"tisso vijjā aphassayiṃ.","thig15.1:35.1":"“Jānāmi attano satta,","thig15.1:35.2":"jātiyo yassayaṃ phalavipāko;","thig15.1:35.3":"Taṃ tava ācikkhissaṃ,","thig15.1:35.4":"taṃ ekamanā nisāmehi.","thig15.1:36.1":"“Nagaramhi erakacche [erakakacche (syā. ka.)],","thig15.1:36.2":"suvaṇṇakāro ahaṃ pahūtadhano;","thig15.1:36.3":"Yobbanamadena matto","thig15.1:36.4":"so, paradāraṃ asevihaṃ.","thig15.1:37.1":"“Sohaṃ tato cavitvā,","thig15.1:37.2":"nirayamhi apaccisaṃ ciraṃ;","thig15.1:37.3":"Pakko tato ca uṭṭhahitvā,","thig15.1:37.4":"makkaṭiyā kucchimokkamiṃ.","thig15.1:38.1":"“Sattāhajātakaṃ maṃ,","thig15.1:38.2":"mahākapi yūthapo nillacchesi;","thig15.1:38.3":"Tassetaṃ kammaphalaṃ,","thig15.1:38.4":"yathāpi gantvāna paradāraṃ.","thig15.1:39.1":"“Sohaṃ tato cavitvā,","thig15.1:39.2":"kālaṃ karitvā sindhavāraññe;","thig15.1:39.3":"Kāṇāya ca khañjāya ca,","thig15.1:39.4":"eḷakiyā kucchimokkamiṃ.","thig15.1:40.1":"“Dvādasa vassāni ahaṃ,","thig15.1:40.2":"nillacchito dārake parivahitvā;","thig15.1:40.3":"Kimināvaṭṭo akallo,","thig15.1:40.4":"yathāpi gantvāna paradāraṃ.","thig15.1:41.1":"“Sohaṃ tato cavitvā,","thig15.1:41.2":"govāṇijakassa gāviyā jāto;","thig15.1:41.3":"Vaccho lākhātambo,","thig15.1:41.4":"nillacchito dvādase māse.","thig15.1:42.1":"“Voḍhūna [te puna (syā. ka.), vodhuna (ka. aṭṭha.)] naṅgalamahaṃ,","thig15.1:42.2":"sakaṭañca dhārayāmi;","thig15.1:42.3":"Andhovaṭṭo akallo,","thig15.1:42.4":"yathāpi gantvāna paradāraṃ.","thig15.1:43.1":"“Sohaṃ tato cavitvā,","thig15.1:43.2":"vīthiyā dāsiyā ghare jāto;","thig15.1:43.3":"Neva mahilā na puriso,","thig15.1:43.4":"yathāpi gantvāna paradāraṃ.","thig15.1:44.1":"“Tiṃsativassamhi mato,","thig15.1:44.2":"sākaṭikakulamhi dārikā jātā;","thig15.1:44.3":"Kapaṇamhi appabhoge,","thig15.1:44.4":"dhanika [aṇika (aṭṭha.), taṃsaṃvaṇṇanāyampi atthayutti gavesitabbā] purisapātabahulamhi.","thig15.1:45.1":"“Taṃ maṃ tato satthavāho,","thig15.1:45.2":"ussannāya vipulāya vaḍḍhiyā;","thig15.1:45.3":"Okaḍḍhati vilapantiṃ,","thig15.1:45.4":"acchinditvā kulagharasmā.","thig15.1:46.1":"“Atha soḷasame vasse,","thig15.1:46.2":"disvā maṃ pattayobbanaṃ kaññaṃ;","thig15.1:46.3":"Orundhatassa putto,","thig15.1:46.4":"giridāso nāma nāmena.","thig15.1:47.1":"“Tassapi aññā bhariyā,","thig15.1:47.2":"sīlavatī guṇavatī yasavatī ca;","thig15.1:47.3":"Anurattā [anuvattā (ka.)] bhattāraṃ,","thig15.1:47.4":"tassāhaṃ [tassa taṃ (?)] viddesanamakāsiṃ.","thig15.1:48.1":"“Tassetaṃ kammaphalaṃ,","thig15.1:48.2":"yaṃ maṃ apakīritūna gacchanti;","thig15.1:48.3":"Dāsīva upaṭṭhahantiṃ,","thig15.1:48.4":"tassapi anto kato mayā”ti.","thig15.1:49.1":"… Isidāsī therī ….","thig15.1:50.1":"Cattālīsanipāto niṭṭhito."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":4121,"to":4150,"paras":[{"para":4121,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Tassā</b>ti mama bhattuno.","<b>Kissā</b>ti kiṃ assa tava sāmikassa.","<b>Tayā aparaddhaṃ</b> byālikaṃ kataṃ."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4122,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Napihaṃ aparajjhan</b>ti napi ahaṃ tassa kiñci aparajjhiṃ.","Ayameva vā pāṭho.","<b>Napi hiṃsemī</b>ti napi bādhemi.","<b>Dubbacanan</b>ti duruttavacanaṃ.","<b>Kiṃ sakkā kātuyye</b>ti kiṃ mayā kātuṃ ayye sakkā.","<b>Yaṃ maṃ viddessate bhattā</b>ti yasmā akāraṇeneva bhattā mayhaṃ viddessate viddessaṃ cittappakopaṃ karoti."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4123,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Vimanā</b>ti domanassikā.","<b>Puttamanurakkhamānā</b>ti attano puttaṃ mayhaṃ sāmikaṃ cittamanurakkhaṇena anurakkhantā.","<b>Jitāmhase rūpiniṃ lakkhin</b>ti jitā amhase jitā vatāmha rūpavatiṃ siriṃ, manussavesena carantiyā siridevatāya parihīnā vatāti attho."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4124,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Aḍḍhassa gharamhi dutiyakulikassā</b>ti paṭhamasāmikaṃ upādāya dutiyassa aḍḍhassa kulaputtassa gharamhi maṃ adāsi, dento ca tato paṭhamasuṅkato upaḍḍhasuṅkena adāsi.","<b>Yena maṃ vindatha seṭṭhī</b>ti yena suṅkena maṃ paṭhamaṃ seṭṭhi vindatha paṭilabhi, tato upaḍḍhasuṅkenāti yojanā."],"lineRefs":[["thig15.1:48"],["thig15.1:48"]]},{"para":4125,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Sopī</b>ti dutiyasāmikopi.","<b>Maṃ paṭiccharayī</b>ti maṃ nīhari, so maṃ gehato nikkaḍḍhi.","<b>Upaṭṭhahantin</b>ti dāsī viya upaṭṭhahantiṃ upaṭṭhānaṃ karontiṃ.","<b>Adūsikan</b>ti adubbhanakaṃ."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4126,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Damakan</b>ti kāruññādhiṭṭhānatāya paresaṃ cittassa damakaṃ.","Yathā pare kiñci dassanti, evaṃ attano kāyaṃ vācañca <b>dantaṃ</b> vūpasantaṃ katvā paradattabhikkhāya vicaraṇakaṃ.","<b>Jāmātā</b>ti duhitupati.","<b>Nikkhipa poṭṭhiñca ghaṭikañcā</b>ti tayā paridahitaṃ pilotikākhaṇḍañca bhikkhākapālañca chaḍḍehi."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4127,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Sopi vasitvā pakkhan</b>ti sopi bhikkhako puriso mayā saddhiṃ addhamāsamattaṃ vasitvā pakkāmi."],"lineRefs":[["thig15.1:48"]]},{"para":4128,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Atha naṃ bhaṇatī tāto</b>ti taṃ bhikkhakaṃ mama pitā mātā sabbo ca me ñātigaṇo vaggavaggo hutvā bhaṇati.","Kathaṃ?","<b>Kiṃ te na kīrati idha</b> tuyhaṃ kiṃ nāma na kirati na sādhiyati, bhaṇa khippaṃ.","<b>Taṃ te karihitī</b>ti taṃ tuyhaṃ karissati."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4129,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Yadi me attā sakkotī</b>ti yadi mayhaṃ attā attādhīno bhujisso ca hoti, <b>alaṃ mayhaṃ isidāsiyā</b> tāya payojanaṃ natthi, tasmā <b>na saha vacchaṃ</b> na saha vasissaṃ, ekaghare ahaṃ tāya saha vatthunti yojanā."],"lineRefs":[["thig15.1:48"]]},{"para":4130,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Vissajjito gato so</b>ti so bhikkhako pitarā vissajjito yathāruci gato.","<b>Ekākinī</b>ti ekikāva.","<b>Āpucchitūna gacchan</b>ti mayhaṃ pitaraṃ vissajjetvā gacchāmi.","<b>Marituye</b>ti marituṃ.","<b>Vā</b>ti vikappatthe nipāto."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4131,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Gocarāyā</b>ti bhikkhāya, tāta-kulaṃ āgacchīti yojanā."],"lineRefs":[["thig15.1:48"]]},{"para":4132,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Tan</b>ti taṃ jinadattattheriṃ.","<b>Uṭṭhāyāsanaṃ tassā paññāpayin</b>ti uṭṭhahitvā āsanaṃ tassā theriyā paññāpesiṃ."],"lineRefs":[["thig15.1:48"],["thig15.1:48"]]},{"para":4133,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Idhevā</b>ti imasmiṃ eva gehe ṭhitā.","<b>Puttakā</b>ti sāmaññavohārena dhītaraṃ anukampento ālapati.","<b>Carāhi tvaṃ dhamman</b>ti tvaṃ pabbajitvā caritabbaṃ brahmacariyādidhammaṃ cara.","<b>Dvijātī</b>ti brāhmaṇajātī."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4134,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Nijjaressāmī</b>ti jīrāpessāmi vināsessāmi."],"lineRefs":[["thig15.1:48"]]},{"para":4135,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Bodhin</b>ti saccābhisambodhiṃ, maggañāṇanti attho.","<b>Aggadhamman</b>ti phaladhammaṃ, arahattaṃ.","<b>Yaṃ sacchikarī dvipadaseṭṭho</b>ti yaṃ maggaphalanibbānasaññitaṃ lokuttaradhammaṃ dvipadānaṃ seṭṭho sammāsambuddho sacchi akāsi, taṃ labhassūti yojanā."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4136,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Sattāhaṃ pabbajitā</b>ti pabbajitā hutvā sattāhena.","<b>Aphassayin</b>ti phusiṃ sacchākāsiṃ."],"lineRefs":[["thig15.1:48"],["thig15.1:48"]]},{"para":4137,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Yassayaṃ phalavipāko</b>ti yassa pāpakammassa, ayaṃ sāmikassa amanāpabhāvasaṅkhāto nissandaphalabhūto vipāko.","<b>Taṃ tava ācikkhissan</b>ti taṃ kammaṃ tava kathessāmi.","<b>Tan</b>ti ācikkhiyamānaṃ tameva kammaṃ, taṃ vā mama vacanaṃ.","<b>Ekamanā</b>ti ekaggamanā.","Ayameva vā pāṭho."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4138,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Nagaramhi erakacche</b>ti evaṃnāmake nagare.","<b>So paradāraṃ asevihan</b>ti so ahaṃ parassa dāraṃ aseviṃ."],"lineRefs":[["thig15.1:48"],["thig15.1:48"]]},{"para":4139,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Ciraṃ pakko</b>ti bahūni vassasatasahassāni nirayagginā daḍḍho.","<b>Tato ca uṭṭhahitvā</b>ti tato nirayato vuṭṭhito cuto.","<b>Makkaṭiyā kucchimokkamin</b>ti vānariyā kucchimhi paṭisandhiṃ gaṇhiṃ."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4140,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Yūthapo</b>ti yūthapati.","<b>Nillacchesī</b>ti purisabhāvassa lakkhaṇabhūtāni bījakāni nillacchesi nīhari.","<b>Tassetaṃ kammaphalan</b>ti tassa mayhaṃ etaṃ atīte katassa kammassa phalaṃ.","<b>Yathāpi gantvāna paradāran</b>ti yathā taṃ paradāraṃ atikkamitvā."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4141,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Tato</b>ti makkaṭayonito.","<b>Sindhavāraññe</b>ti sindhavaraṭṭhe araññaṭṭhāne.","<b>Eḷakiyā</b>ti ajiyā."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4142,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Dārake parivahitvā</b>ti piṭṭhiṃ āruyha kumārake vahitvā.","<b>Kimināvaṭṭo</b>ti abhijātaṭṭhāne kimiparigatova hutvā aṭṭo aṭṭito.","<b>Akallo</b>ti gilāno, ahosīti vacanaseso."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4143,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Govāṇijakassā</b>ti gāviyo vikkiṇitvā jīvakassa.","<b>Lākhātambo</b>ti lākhārasarattehi viya tambehi lomehi samannāgato."],"lineRefs":[["thig15.1:48"],["thig15.1:48"]]},{"para":4144,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Voḍhūnā</b>ti vahitvā.","<b>Naṅgalan</b>ti sīraṃ, sakaṭañca dhārayāmīti attho.","<b>Andhovaṭṭo</b>ti kāṇova hutvā aṭṭo pīḷito."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4145,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Vīthiyā</b>ti nagaravīthiyaṃ.","<b>Dāsiyā ghare jāto</b>ti gharadāsiyā kucchimhi jāto.","“Vaṇṇadāsiyā” tipi vadanti.","<b>Neva mahilā na puriso</b>ti itthīpi purisopi na homi, jātinapuṃsakoti attho."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4146,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Tiṃsativassamhi mato</b>ti napuṃsako hutvā tiṃsavassakāle mato.","<b>Sākaṭikakulamhī</b>ti sūtakakule.","<b>Dhanikapurisapātabahulamhī</b>ti iṇāyikānaṃ purisānaṃ adhipatanabahule bahūhi iṇāyikehi abhibhavitabbe."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4147,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Ussannāyā</b>ti upacitāya.","<b>Vipulāyā</b>ti mahatiyā.","<b>Vaḍḍhiyā</b>ti iṇavaḍḍhiyā.","<b>Okaḍḍhatī</b>ti avakaḍḍhati.","<b>Kulagharasmā</b>ti mama jātakulagehato."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4148,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Orundhatassa putto</b>ti assa satthavāhassa putto, mayi paṭibaddhacitto nāmena giridāso nāma avarundhati attano pariggahabhāvena gehe karoti."],"lineRefs":[["thig15.1:48"]]},{"para":4149,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Anurattā bhattāran</b>ti bhattāraṃ anuvattikā.","<b>Tassāhaṃ viddesanamakāsin</b>ti tassa bhattuno taṃ bhariyaṃ sapattiṃ viddesanakammaṃ akāsiṃ.","Yathā taṃ so kujjhati, evaṃ paṭipajjiṃ."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]},{"para":4150,"vripara":null,"refs":["thig15.1:48"],"lines":["<b>Yaṃ maṃ apakīritūna gacchantī</b>ti yaṃ dāsī viya sakkaccaṃ upaṭṭhahantiṃ maṃ tattha tattha patino apakiritvā chaḍḍetvā anapekkhā apagacchanti.","Etaṃ tassā mayhaṃ tadā katassa paradārikakammassa sapattiṃ viddesanakammassa ca nissandaphalaṃ.","<b>Tassapi anto kato mayā</b>ti tassapi tathā anunayapāpakakammassa dāruṇassa pariyanto idāni mayā aggamaggaṃ adhigacchantiyā kato, ito paraṃ kiñci dukkhaṃ natthīti.","Yaṃ panettha antarantarā na vibhattaṃ, taṃ vuttanayattā uttānatthameva."],"lineRefs":[["thig15.1:48"],["thig15.1:48"],["thig15.1:48"],["thig15.1:48"]]}],"wordLinks":[["thig15.1:48.1","tassā",0,0],["thig15.1:48.3","tassā",0,0],["thig15.1:48.3","upaṭṭhahantiṃ",4,2],["thig15.1:48.3","vā",9,4],["thig15.1:48.1","taṃ",11,0],["thig15.1:48.1","taṃ",16,2],["thig15.1:48.1","tassetaṃ kammaphalaṃ",19,2],["thig15.1:48.1","yaṃ maṃ apakīritūna gacchantī",29,0],["thig15.1:48.3","tassapi anto kato mayā",29,2]],"before":[{"para":3956,"vripara":null,"title":"Cattālīsanipāto","lines":["Cattālīsanipāto"]},{"para":3957,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Isidāsītherīgāthāvaṇṇanā"]},{"para":3958,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Cattālīsanipāte <b>nagaramhi kusumanāme</b>tiādikā isidāsiyā theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave purisattabhāve ṭhatvā vivaṭṭūpanissayaṃ kusalaṃ upacinantī carimabhavato sattame bhave akalyāṇasannissayena paradārikakammaṃ katvā, kāyassa bhedā niraye nibbattitvā tattha bahūni vassasatāni niraye paccitvā, tato cutā tīsu jātīsu tiracchānayoniyaṃ nibbattitvā tato cutā dāsiyā kucchismiṃ napuṃsako hutvā nibbatti.","Tato pana cutā ekassa daliddassa sākaṭikassa dhītā hutvā nibbatti.","Taṃ vayappattaṃ giridāso nāma aññatarassa satthavāhassa putto attano bhariyaṃ katvā gehaṃ ānesi.","Tassa ca bhariyā atthi sīlavatī kalyāṇadhammā.","Tassaṃ issāpakatā sāmino tassā viddesanakammaṃ akāsi.","Sā tattha yāvajīvaṃ ṭhatvā kāyassa bhedā imasmiṃ buddhuppāde ujjeniyaṃ kulapadesasīlācārādiguṇehi abhisammatassa vibhavasampannassa seṭṭhissa dhītā hutvā nibbatti, <b>isidāsī</b>tissā nāmaṃ ahosi."]},{"para":3959,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Taṃ vayappattakāle mātāpitaro kularūpavayavibhavādisadisassa aññatarassa seṭṭhiputtassa adaṃsu.","Sā tassa gehe patidevatā hutvā māsamattaṃ vasi.","Athassā kammabalena sāmiko virattarūpo hutvā taṃ gharato nīhari.","Taṃ sabbaṃ pāḷito eva viññāyati.","Tesaṃ tesaṃ pana sāmikānaṃ aruccaneyyatāya saṃvegajātā pitaraṃ anujānāpetvā, jinadattāya theriyā santike pabbajitvā vipassanāya kammaṃ karontī nacirasseva saha paṭisambhidāhi arahattaṃ patvā, phalasukhena nibbānasukhena ca vītināmentī ekadivasaṃ pāṭaliputtanagare piṇḍāya caritvā pacchābhattaṃ piṇḍapātapaṭikkantā mahāgaṅgāyaṃ vālukapuline nisīditvā bodhittheriyā nāma attano sahāyattheriyā pubbapaṭipattiṃ pucchitā tamatthaṃ gāthābandhavasena vissajjesi “ujjeniyā puravare”tiādinā.","Tesaṃ pana pucchāvissajjanānaṃ sambandhaṃ dassetuṃ –"]},{"para":3961,"vripara":"402","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Nagaramhi kusumanāme, pāṭaliputtamhi pathaviyā maṇḍe;"]},{"para":3962,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Sakyakulakulīnāyo, dve bhikkhuniyo hi guṇavatiyo."]},{"para":3964,"vripara":"403","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Isidāsī tattha ekā, dutiyā bodhīti sīlasampannā ca;"]},{"para":3965,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Jhānajjhāyanaratāyo, bahussutāyo dhutakilesāyo."]},{"para":3967,"vripara":"404","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Tā piṇḍāya caritvā, bhattatthaṃ kariya dhotapattāyo;"]},{"para":3968,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Rahitamhi sukhanisinnā, imā girā abbhudīresun”ti.","–"]},{"para":3969,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Imā tisso gāthā saṅgītikārehi ṭhapitā."]},{"para":3971,"vripara":"405","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Pāsādikāsi ayye, isidāsi vayopi te aparihīno;"]},{"para":3972,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Kiṃ disvāna byālikaṃ, athāsi nekkhammamanuyuttā."]},{"para":3974,"vripara":"406","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Evamanuyuñjiyamānā sā, rahite dhammadesanākusalā;"]},{"para":3975,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Isidāsī vacanamabravi, suṇa bodhi yathāmhi pabbajitā."]},{"para":3976,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Ito paraṃ vissajjanagāthā."]},{"para":3978,"vripara":"407","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Ujjeniyā puravare, mayhaṃ pitā sīlasaṃvuto seṭṭhi;"]},{"para":3979,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Tassamhi ekadhītā, piyā manāpā ca dayitā ca."]},{"para":3981,"vripara":"408","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Atha me sāketato varakā, āgacchumuttamakulīnā;"]},{"para":3982,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Seṭṭhī pahūtaratano, tassa mamaṃ suṇumadāsi tāto."]},{"para":3984,"vripara":"409","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Sassuyā sasurassa ca, sāyaṃ pātaṃ paṇāmamupagamma;"]},{"para":3985,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Sirasā karomi pāde, vandāmi yathāmhi anusiṭṭhā."]},{"para":3987,"vripara":"410","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Yā mayhaṃ sāmikassa, bhaginiyo bhātuno parijano vā;"]},{"para":3988,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Tamekavarakampi disvā, ubbiggā āsanaṃ demi."]},{"para":3990,"vripara":"411","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Annena ca pānena ca, khajjena ca yañca tattha sannihitaṃ;"]},{"para":3991,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Chādemi upanayāmi ca, demi ca yaṃ yassa patirūpaṃ."]},{"para":3993,"vripara":"412","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Kālena upaṭṭhahitvā, gharaṃ samupagamāmi ummāre;"]},{"para":3994,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Dhovantī hatthpāde, pañjalikā sāmikamupemi."]},{"para":3996,"vripara":"413","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Kocchaṃ pasādaṃ añjaniñca, ādāsakañca gaṇhitvā;"]},{"para":3997,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Parikammakārikā viya, sayameva patiṃ vibhūsemi."]},{"para":3999,"vripara":"414","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Sayameva odanaṃ sādhayāmi, sayameva bhājanaṃ dhovantī;"]},{"para":4000,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Mātāva ekaputtakaṃ, tathā bhattāraṃ paricarāmi."]},{"para":4002,"vripara":"415","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Evaṃ maṃ bhattikataṃ, anurattaṃ kārikaṃ nihatamānaṃ;"]},{"para":4003,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Uṭṭhāyikaṃ analasaṃ, sīlavatiṃ dussate bhattā."]},{"para":4005,"vripara":"416","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“So mātarañca pitarañca, bhaṇati āpucchahaṃ gamissāmi;"]},{"para":4006,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Isidāsiyā na saha vacchaṃ, ekāgārehaṃ saha vatthuṃ."]},{"para":4008,"vripara":"417","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Mā evaṃ putta avaca, isidāsī paṇḍitā paribyattā;"]},{"para":4009,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Uṭṭhāyikā analasā, kiṃ tuyhaṃ na rocate putta."]},{"para":4011,"vripara":"418","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Na ca me hiṃsati kiñci, na cahaṃ isidāsiyā saha vacchaṃ;"]},{"para":4012,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Dessāva me alaṃ me, apucchāhaṃ gamissāmi."]},{"para":4014,"vripara":"419","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Tassa vacanaṃ suṇitvā, sassu sasuro ca maṃ apucchiṃsu;"]},{"para":4015,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Kissa tayā aparaddhaṃ, bhaṇa vissaṭṭhā yathābhūtaṃ."]},{"para":4017,"vripara":"420","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Napihaṃ aparajjhaṃ kiñci, napi hiṃsemi na bhaṇāmi dubbacanaṃ;"]},{"para":4018,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Kiṃ sakkā kātuyye, yaṃ maṃ viddessate bhattā."]},{"para":4020,"vripara":"421","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Te maṃ pitugharaṃ paṭinayiṃsu, vimanā dukhena adhibhūtā;"]},{"para":4021,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Puttamanurakkhamānā, jitāmhase rūpiniṃ lakkhiṃ."]},{"para":4023,"vripara":"422","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Atha maṃ adāsi tāto, aḍḍhassa gharamhi dutiyakulikassa;"]},{"para":4024,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Tato upaḍḍhasuṅkena, yena maṃ vindatha seṭṭhi."]},{"para":4026,"vripara":"423","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Tassapi gharamhi māsaṃ, avasiṃ atha sopi maṃ paṭiccharayi;"]},{"para":4027,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Dāsīva upaṭṭhahantiṃ, adūsikaṃ sīlasampannaṃ."]},{"para":4029,"vripara":"424","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Bhikkhāya ca vicarantaṃ, damakaṃ dantaṃ me pitā bhaṇati;"]},{"para":4030,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Hohisi me jāmātā, nikkhipa poṭṭhiñca ghaṭikañca."]},{"para":4032,"vripara":"425","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Sopi vasitvā pakkhaṃ, atha tātaṃ bhaṇati ‘dehi me poṭṭhiṃ;"]},{"para":4033,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Ghaṭikañca mallakañca, punapi bhikkhaṃ carissāmi’."]},{"para":4035,"vripara":"426","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Atha naṃ bhaṇatī tāto, ammā sabbo ca me ñātigaṇavaggo;"]},{"para":4036,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Kiṃ te na kīrati idha, bhaṇa khippaṃ taṃ te karihiti."]},{"para":4038,"vripara":"427","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Evaṃ bhaṇito bhaṇati, yadi me attā sakkoti alaṃ mayhaṃ;"]},{"para":4039,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Isidāsiyā na saha vacchaṃ, ekagharehaṃ saha vatthuṃ."]},{"para":4041,"vripara":"428","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Vissajjito gato so, ahampi ekākinī vicintemi;"]},{"para":4042,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Āpucchitūna gacchaṃ, marituye vā pabbajissaṃ vā."]},{"para":4044,"vripara":"429","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Atha ayyā jinadattā, āgacchī gocarāya caramānā;"]},{"para":4045,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Tāta kulaṃ vinayadharī, bahussutā sīlasampannā."]},{"para":4047,"vripara":"430","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Taṃ disvāna amhākaṃ, uṭṭhāyāsanaṃ tassā paññāpayiṃ;"]},{"para":4048,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Nisinnāya ca pāde, vanditvā bhojanamadāsiṃ."]},{"para":4050,"vripara":"431","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Annena ca pānena ca, khajjena ca yañca tattha sannihitaṃ;"]},{"para":4051,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Santappayitvā avacaṃ, ayye icchāmi pabbajituṃ."]},{"para":4053,"vripara":"432","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Atha maṃ bhaṇatī tāto, idheva puttaka carāhi tvaṃ dhammaṃ;"]},{"para":4054,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Annena ca pānena ca, tappaya samaṇe dvijātī ca."]},{"para":4056,"vripara":"433","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Athahaṃ bhaṇāmi tātaṃ, rodantī añjaliṃ paṇāmetvā;"]},{"para":4057,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Pāpañhi mayā pakataṃ, kammaṃ taṃ nijjaressāmi."]},{"para":4059,"vripara":"434","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Atha maṃ bhaṇatī tāto, pāpuṇa bodhiñca aggadhammañca;"]},{"para":4060,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Nibbānañca labhassu, yaṃ sacchikarī dvipadaseṭṭho."]},{"para":4062,"vripara":"435","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Mātāpitū abhivāda, yitvā sabbañca ñātigaṇavaggaṃ;"]},{"para":4063,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Sattāhaṃ pabbajitā, tisso vijjā aphassayiṃ."]},{"para":4065,"vripara":"436","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Jānāmi attano satta, jātiyo yassayaṃ phalavipāko;"]},{"para":4066,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Taṃ tava ācikkhissaṃ, taṃ ekamanā nisāmehi."]},{"para":4068,"vripara":"437","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Nagaramhi erakacche, suvaṇṇakāro ahaṃ pahūtadhano;"]},{"para":4069,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Yobbanamadena matto, so paradāraṃ asevihaṃ."]},{"para":4071,"vripara":"438","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Sohaṃ tato cavitvā, nirayamhi apaccisaṃ ciraṃ;"]},{"para":4072,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Pakko tato ca uṭṭhahitvā, makkaṭiyā kucchimokkamiṃ."]},{"para":4074,"vripara":"439","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Sattāhajātakaṃ maṃ, mahākapi yūthapo nillacchesi;"]},{"para":4075,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Tassetaṃ kammaphalaṃ, yathāpi gantvāna paradāraṃ."]},{"para":4077,"vripara":"440","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Sohaṃ tato cavitvā, kālaṃ karitvā sindhavāraññe;"]},{"para":4078,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Kāṇāya ca khañjāya ca, eḷakiyā kucchimokkamiṃ."]},{"para":4080,"vripara":"441","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Dvādasa vassāni ahaṃ, nillacchito dārake parivahitvā;"]},{"para":4081,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Kimināvaṭṭo akallo, yathāpi gantvāna paradāraṃ."]},{"para":4083,"vripara":"442","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Sohaṃ tato cavitvā, govāṇijakassa gāviyā jāto;"]},{"para":4084,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Vaccho lākhātambo, nillacchito dvādase māse."]},{"para":4086,"vripara":"443","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Voḍhūna naṅgalamahaṃ, sakaṭañca dhārayāmi;"]},{"para":4087,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Andhovaṭṭo akallo, yathāpi gantvāna paradāraṃ."]},{"para":4089,"vripara":"444","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Sohaṃ tato cavitvā, vīthiyā dāsiyā ghare jāto;"]},{"para":4090,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Neva mahilā na puriso, yathāpi gantvāna paradāraṃ."]},{"para":4092,"vripara":"445","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Tiṃsativassamhi mato, sākaṭikakulamhi dārikā jātā;"]},{"para":4093,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Kapaṇamhi appabhoge, dhanikapurisapātabahulamhi."]},{"para":4095,"vripara":"446","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Taṃ maṃ tato satthavāho, ussannāya vipulāya vaḍḍhiyā;"]},{"para":4096,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Okaḍḍhati vilapantiṃ, acchinditvā kulagharasmā."]},{"para":4098,"vripara":"447","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Atha soḷasame vasse, disvā maṃ pattayobbanaṃ kaññaṃ;"]},{"para":4099,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Orundhatassa putto, giridāso nāma nāmena."]},{"para":4101,"vripara":"448","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Tassapi aññā bhariyā, sīlavatī guṇavatī yasavatī ca;"]},{"para":4102,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Anurattā bhattāraṃ, tassāhaṃ viddesanamakāsiṃ."]},{"para":4104,"vripara":"449","title":"Isidāsītherīgāthāvaṇṇanā","lines":["“Tassetaṃ kammaphalaṃ, yaṃ maṃ apakīritūna gacchanti;"]},{"para":4105,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Dāsīva upaṭṭhahantiṃ, tassapi anto kato mayā”ti."]},{"para":4106,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Tattha <b>nagaramhi kusumanāme</b>ti “kusumapuran”ti evaṃ kusumasaddena gahitanāmake nagare, idāni taṃ nagaraṃ <b>pāṭaliputtamhī</b>ti sarūpato dasseti.","<b>Pathaviyā maṇḍe</b>ti sakalāya pathaviyā maṇḍabhūte.","<b>Sakyakulakulīnāyo</b>ti sakyakule kuladhītaro, sakyaputtassa bhagavato sāsane pabbajitatāya evaṃ vuttaṃ."]},{"para":4107,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Tatthā</b>ti tāsu dvīsu bhikkhunīsu.","<b>Bodhī</b>ti evaṃnāmikā therī.","<b>Jhānajjhāyanaratāyo</b>ti lokiyalokuttarassa jhānassa jhāyane abhiratā.","<b>Bahussutāyo</b>ti pariyattibāhusaccena bahussutā.","<b>Dhutakilesāyo</b>ti aggamaggena sabbaso samugghātitakilesā.","<b>Bhattatthaṃ kariyā</b>ti bhattakiccaṃ niṭṭhāpetvā.","<b>Rahitamhī</b>ti janarahitamhi vivittaṭṭhāne.","<b>Sukhanisinnā</b>ti pabbajjāsukhena vivekasukhena ca sukhanisinnā.","<b>Imā girā</b>ti idāni vuccamānā sukhā lāpanā.","<b>Abbhudīresun</b>ti pucchāvissajjanavasena kathayiṃsu."]},{"para":4108,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>“Pāsādikāsī”</b>ti gāthā bodhittheriyā pucchāvasena vuttā.","<b>“Evamanuyuñjiyamānā”</b>ti gāthā saṅgītikāreheva vuttā.","<b>“Ujjeniyā”</b>tiādikā hi sabbāpi isidāsiyāva vuttā.","Tattha <b>pāsādikāsī</b>ti rūpasampattiyā passantānaṃ pasādāvahā asi.","<b>Vayopi te aparihīno</b>ti tuyhaṃ vayopi na parihīno, paṭhamavaye ṭhitāsīti attho.","<b>Kiṃ disvāna byālikan</b>ti kīdisaṃ byālikaṃ dosaṃ gharāvāse ādīnavaṃ disvā.","<b>Athāsi nekkhammamanuyuttā</b>ti <b>athā</b>ti nipātamattaṃ, nekkhammaṃ pabbajjaṃ anuyuttā asi."]},{"para":4109,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Anuyuñjiyamānā</b>ti pucchiyamānā, sā isidāsīti yojanā.","<b>Rahite</b>ti suññaṭṭhāne.","<b>Suṇa bodhi yathāmhi pabbajitā</b>ti bodhittheri ahaṃ yathā pabbajitā amhi, taṃ taṃ purāṇaṃ suṇa suṇāhi."]},{"para":4110,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Ujjeniyā puravare</b>ti ujjenīnāmake avantiraṭṭhe uttamanagare.","<b>Piyā</b>ti ekadhītubhāvena piyāyitabbā.","<b>Manāpā</b>ti sīlācāraguṇena manavaḍḍhanakā.","<b>Dayitā</b>ti anukampitabbā."]},{"para":4111,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Athā</b>ti pacchā mama vayappattakāle.","<b>Me sāketato varakā</b>ti sāketanagarato mama varakā maṃ vārentā āgacchuṃ.","<b>Uttamakulīnā</b>ti tasmiṃ nagare aggakulikā, yena te pesitā, so seṭṭhi pahūtaratano.","<b>Tassa mamaṃ suṇhamadāsi tāto</b>ti tassa sāketaseṭṭhino suṇisaṃ puttassa bhariyaṃ katvā mayhaṃ pitā maṃ adāsi."]},{"para":4112,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Sāyaṃ pātan</b>ti sāyanhe pubbaṇhe ca.","<b>Paṇāmamupagamma sirasā karomī</b>ti sassuyā sasurassa ca santikaṃ upagantvā sirasā paṇāmaṃ karomi, tesaṃ pāde vandāmi.","<b>Yathāmhi anusiṭṭhā</b>ti tehi yathā anusiṭṭhā amhi, tathā karomi, tesaṃ anusiṭṭhiṃ na atikkamāmi."]},{"para":4113,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Tamekavarakampī</b>ti ekavallabhampi.","<b>Ubbiggā</b>ti tasantā.","<b>Āsanaṃ demī</b>ti yassa puggalassa yaṃ anucchavikaṃ, taṃ tassa demi."]},{"para":4114,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Tatthā</b>ti parivesanaṭṭhāne.","<b>Sannihitan</b>ti sajjitaṃ hutvā vijjamānaṃ.","<b>Chādemī</b>ti upacchādemi, upacchādetvā upanayāmi ca, upanetvā demi, dentīpi yaṃ yassa patirūpaṃ, tadeva demīti attho."]},{"para":4115,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Ummāre</b>ti dvāre.","<b>Dhovantī hatthapāde</b>ti hatthapāde dhovinī āsiṃ, dhovitvā gharaṃ samupagamāmīti yojanā."]},{"para":4116,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Kocchan</b>ti massūnaṃ kesānañca ullikhanakocchaṃ.","<b>Pasādan</b>ti gandhacuṇṇādimukhavilepanaṃ.","“Pasādhanan” tipi pāṭho, pasādhanabhaṇḍaṃ.","<b>Añjanin</b>ti añjananāḷiṃ.","<b>Parikammakārikā viyā</b>ti aggakulikā vibhavasampannāpi patiparicārikā ceṭikā viya."]},{"para":4117,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Sādhayāmī</b>ti pacāmi.","<b>Bhājanan</b>ti lohabhājanañca.","Dhovantī paricarāmīti yojanā."]},{"para":4118,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Bhattikatan</b>ti katasāmibhatikaṃ.","<b>Anurattan</b>ti anurattavantiṃ.","<b>Kārikan</b>ti tassa tasseva iti kattabbassa kārikaṃ.","<b>Nihatamānan</b>ti apanītamānaṃ.","<b>Uṭṭhāyikan</b>ti uṭṭhānavīriyasampannaṃ.","<b>Analasan</b>ti tato eva akusītaṃ.","<b>Sīlavatin</b>ti sīlācārasampannaṃ.","<b>Dussate</b>ti dussati, kujjhitvā bhaṇati."]},{"para":4119,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Bhaṇati āpucchahaṃ gamissāmī</b>ti “ahaṃ tumhe āpucchitvā yattha katthaci gamissāmī”ti so mama sāmiko attano mātarañca pitarañca bhaṇati.","Kiṃ bhaṇatīti ce āha –","<b>“isidāsiyā na saha vacchaṃ, ekāgārehaṃ saha vatthun”</b>ti.","Tattha <b>vacchan</b>ti vasissaṃ."]},{"para":4120,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["<b>Dessā</b>ti appiyā.","<b>Alaṃ me</b>ti payojanaṃ me tāya itthīti attho.","<b>Apucchāhaṃ gamissāmī</b>ti yadi me tumhe tāya saddhiṃ saṃvāsaṃ icchatha, ahaṃ tumhe apucchitvā videsaṃ pakkamissāmi."]}],"after":[{"para":4151,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Isidāsītherīgāthāvaṇṇanā niṭṭhitā."]},{"para":4152,"vripara":null,"title":"Isidāsītherīgāthāvaṇṇanā","lines":["Cattālīsanipātavaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
