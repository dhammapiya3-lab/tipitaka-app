{"suttaId":"sn51.19","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1641,1645],"vripara":"831"},"segments":{"sn51.19:0.3":"Iddhādidesanāsuttaṃ","sn51.19:1.1":"“Iddhiṃ vo, bhikkhave, desessāmi iddhipādañca iddhipādabhāvanañca iddhipādabhāvanāgāminiñca paṭipadaṃ.","sn51.19:1.2":"Taṃ suṇātha.","sn51.19:2.1":"“Katamā ca, bhikkhave, iddhi?","sn51.19:2.2":"Idha, bhikkhave, bhikkhu anekavihitaṃ iddhividhaṃ paccanubhoti – ekopi hutvā bahudhā hoti, bahudhāpi hutvā eko hoti … pe … yāva brahmalokāpi kāyena vasaṃ vatteti –","sn51.19:2.3":"ayaṃ vuccati, bhikkhave, iddhi.","sn51.19:3.1":"“Katamo ca, bhikkhave, iddhipādo?","sn51.19:3.2":"Yo so, bhikkhave, maggo yā paṭipadā iddhilābhāya iddhipaṭilābhāya saṃvattati –","sn51.19:3.3":"ayaṃ vuccati, bhikkhave, iddhipādo.","sn51.19:4.1":"“Katamā ca, bhikkhave, iddhipādabhāvanā?","sn51.19:4.2":"Idha, bhikkhave, bhikkhu chandasamādhippadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti,","sn51.19:4.3":"vīriyasamādhi … pe …","sn51.19:4.4":"cittasamādhi … pe …","sn51.19:4.5":"vīmaṃsāsamādhippadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti –","sn51.19:4.6":"ayaṃ vuccati, bhikkhave, iddhipādabhāvanā.","sn51.19:5.1":"“Katamā ca, bhikkhave, iddhipādabhāvanāgāminī paṭipadā?","sn51.19:5.2":"Ayameva ariyo aṭṭhaṅgiko maggo, seyyathidaṃ –","sn51.19:5.3":"sammādiṭṭhi, sammāsaṅkappo, sammāvācā, sammākammanto, sammāājīvo, sammāvāyāmo, sammāsati, sammāsamādhi –","sn51.19:5.4":"ayaṃ vuccati, bhikkhave, iddhipādabhāvanāgāminī paṭipadā”ti.","sn51.19:5.5":"Navamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":677,"to":677,"paras":[{"para":677,"vripara":"831","refs":["sn51.19:3"],"lines":["Navame <b>yo so bhikkhave maggo</b>ti abhiññāpādakaṃ catutthajjhānaṃ adhippetaṃ."],"lineRefs":[["sn51.19:3"]]}],"wordLinks":[["sn51.19:3.2","yo so bhikkhave maggo",0,0]],"before":[{"para":676,"vripara":null,"title":"Iddhādidesanāsuttavaṇṇanā","lines":["Iddhādidesanāsuttavaṇṇanā"]}]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":588,"to":589,"paras":[{"para":588,"vripara":"831","refs":["sn51.19:1"],"lines":["<b>Abhiññāpādakaṃ catutthajjhānaṃ adhippetaṃ</b> “iddhilābhāya pavattatī”ti vacanato."],"lineRefs":[["sn51.19:1"]]},{"para":589,"vripara":null,"refs":["sn51.19:1"],"lines":["Vibhaṅgasuttavaṇṇanā"],"lineRefs":[["sn51.19:1"]]}],"wordLinks":[],"before":[{"para":587,"vripara":null,"title":"Iddhādidesanāsuttavaṇṇanā","lines":["Iddhādidesanāsuttavaṇṇanā"]}],"after":[{"para":590,"vripara":"832","title":"Vibhaṅgasuttavaṇṇanā","lines":["<b>Chandaṃ uppādetvā</b>ti bhāvanāchandaṃ uppādetvā.","<b>Līnākāro</b>ti bhāvanācittassa layāpatti.","<b>Kosajjena</b> vokiṇṇāpajjanaṃ vuttaṃ."]}]},"tika2":null}
