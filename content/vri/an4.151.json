{"suttaId":"an4.151","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1222,1222],"vripara":"151"},"segments":{"an4.151:0.3":"Indriyasuttaṃ","an4.151:1.1":"“Cattārimāni, bhikkhave, indriyāni.","an4.151:1.2":"Katamāni cattāri?","an4.151:1.3":"Saddhindriyaṃ, vīriyindriyaṃ, satindriyaṃ, samādhindriyaṃ – imāni kho, bhikkhave, cattāri indriyānī”ti.","an4.151:1.5":"Paṭhamaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1462,"to":1462,"paras":[{"para":1462,"vripara":"151","refs":["an4.151:1"],"lines":["Catutthassa paṭhame saddhādhurena indaṭṭhaṃ karotīti <b>saddhindriyaṃ</b>.","Sesesupi eseva nayo.","Dutiye assaddhiye akampanaṭṭhena <b>saddhābalaṃ</b>.","Sesesupi eseva nayo.","Tatiye <b>anavajjabalan</b>ti niddosabalaṃ.","<b>Saṅgahabalan</b>ti saṅgaṇhitabbayuttakānaṃ saṅgaṇhanabalaṃ.","Catutthapañcamāni uttānāneva."],"lineRefs":[["an4.151:1"],["an4.151:1"],["an4.151:1"],["an4.151:1"],["an4.151:1"],["an4.151:1"],["an4.151:1"]]}],"wordLinks":[["an4.151:1.3","saddhindriyaṃ",0,0]]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1647,"to":1649,"paras":[{"para":1647,"vripara":"151-155","refs":["an4.151:1"],"lines":["151-155. Catutthassa paṭhamādīni uttānāneva."],"lineRefs":[["an4.151:1"]]},{"para":1648,"vripara":null,"refs":[],"lines":["Indriyasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1649,"vripara":null,"refs":["an4.151:1"],"lines":["6-8. Kappasuttādivaṇṇanā"],"lineRefs":[["an4.151:1"]]}],"wordLinks":[]}}
