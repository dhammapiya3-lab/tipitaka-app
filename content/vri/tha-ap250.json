{"suttaId":"tha-ap250","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8206,8215],"vripara":"27"},"segments":{"tha-ap250:0.3":"Sattalipupphapūjakattheraapadānaṃ","tha-ap250:1.1":"“Satta sattalipupphāni, sīse katvānahaṃ tadā;","tha-ap250:1.3":"Buddhassa abhiropesiṃ, vessabhumhi naruttame [vibhattivipallāso cintetabbo].","tha-ap250:2.1":"“Ekattiṃse ito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap250:2.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap250:3.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap250:4.1":"Itthaṃ sudaṃ āyasmā sattalipupphapūjako thero imā gāthāyo abhāsitthāti.","tha-ap250:5.1":"Sattalipupphapūjakattherassāpadānaṃ aṭṭhamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3204,"to":3204,"paras":[{"para":3204,"vripara":"27","refs":["tha-ap250:1"],"lines":["Aṭṭhamāpadāne <b>satta sattalipupphānī</b>ti sattalisaṅkhātāni, satta pupphāni sīsenādāya vessabhussa bhagavato <b>abhiropesiṃ</b> pūjesinti attho."],"lineRefs":[["tha-ap250:1"]]}],"wordLinks":[["tha-ap250:1.1","satta sattalipupphānī",0,0],["tha-ap250:1.3","abhiropesiṃ",0,0]]},"tika":null,"tika2":null}
