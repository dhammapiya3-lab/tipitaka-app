{"suttaId":"tha-ap562","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[6302,6471],"vripara":"122"},"segments":{"tha-ap562:0.3":"Upavānattheraapadānaṃ","tha-ap562:1.1":"“Padumuttaro nāma jino,","tha-ap562:1.2":"sabbadhammāna pāragū;","tha-ap562:1.3":"Jalitvā aggikkhandhova,","tha-ap562:1.4":"sambuddho parinibbuto.","tha-ap562:2.1":"“Mahājanā samāgamma,","tha-ap562:2.2":"pūjayitvā tathāgataṃ;","tha-ap562:2.3":"Citaṃ katvāna sugataṃ,","tha-ap562:2.4":"sarīraṃ abhiropayuṃ.","tha-ap562:3.1":"“Sarīrakiccaṃ katvāna,","tha-ap562:3.2":"dhātuṃ tattha samānayuṃ;","tha-ap562:3.3":"Sadevamanussā sabbe,","tha-ap562:3.4":"buddhathūpaṃ akaṃsu te.","tha-ap562:4.1":"“Paṭhamā kañcanamayā,","tha-ap562:4.2":"dutiyā ca maṇimayā;","tha-ap562:4.3":"Tatiyā rūpiyamayā,","tha-ap562:4.4":"catutthī phalikāmayā.","tha-ap562:5.1":"“Tattha pañcamikā ceva [tattha pañcamikā ceti (sī.)],","tha-ap562:5.2":"lohitaṅkamayā ahu;","tha-ap562:5.3":"Chaṭṭhā masāragallassa,","tha-ap562:5.4":"sabbaṃ ratanamayūpari.","tha-ap562:6.1":"“Jaṅghā maṇimayā āsi,","tha-ap562:6.2":"vedikā ratanāmayā;","tha-ap562:6.3":"Sabbasoṇṇamayo thūpo,","tha-ap562:6.4":"uddhaṃ yojanamuggato.","tha-ap562:7.1":"“Devā tattha samāgantvā,","tha-ap562:7.2":"ekato mantayuṃ tadā;","tha-ap562:7.3":"‘Mayampi thūpaṃ kassāma,","tha-ap562:7.4":"lokanāthassa tādino.","tha-ap562:8.1":"“‘Dhātu āveṇikā natthi,","tha-ap562:8.2":"sarīraṃ ekapiṇḍitaṃ;","tha-ap562:8.3":"Imamhi buddhathūpamhi,","tha-ap562:8.4":"kassāma kañcukaṃ mayaṃ’.","tha-ap562:9.1":"“Devā sattahi ratnehi,","tha-ap562:9.2":"aññaṃ vaḍḍhesuṃ yojanaṃ;","tha-ap562:9.3":"Thūpo dviyojanubbedho,","tha-ap562:9.4":"timiraṃ byapahanti so.","tha-ap562:10.1":"“Nāgā tattha samāgantvā,","tha-ap562:10.2":"ekato mantayuṃ tadā;","tha-ap562:10.3":"‘Manussā ceva devā ca,","tha-ap562:10.4":"buddhathūpaṃ akaṃsu te.","tha-ap562:11.1":"“‘Mā no pamattā assumha,","tha-ap562:11.2":"appamattā sadevakā;","tha-ap562:11.3":"Mayampi thūpaṃ kassāma,","tha-ap562:11.4":"lokanāthassa tādino’.","tha-ap562:12.1":"“Indanīlaṃ mahānīlaṃ,","tha-ap562:12.2":"atho jotirasaṃ maṇiṃ;","tha-ap562:12.3":"Ekato sannipātetvā,","tha-ap562:12.4":"buddhathūpaṃ achādayuṃ.","tha-ap562:13.1":"“Sabbaṃ maṇimayaṃ āsi,","tha-ap562:13.2":"yāvatā [tāvatā (ka.)] buddhacetiyaṃ;","tha-ap562:13.3":"Tiyojanasamubbedhaṃ,","tha-ap562:13.4":"ālokakaraṇaṃ tadā.","tha-ap562:14.1":"“Garuḷā ca samāgantvā,","tha-ap562:14.2":"ekato mantayuṃ tadā;","tha-ap562:14.3":"‘Manussā devanāgā ca,","tha-ap562:14.4":"buddhapūjaṃ akaṃsu te.","tha-ap562:15.1":"“‘Mā no pamattā assumha,","tha-ap562:15.2":"appamattā sadevakā;","tha-ap562:15.3":"Mayampi thūpaṃ kassāma,","tha-ap562:15.4":"lokanāthassa tādino’.","tha-ap562:16.1":"“Sabbaṃ maṇimayaṃ thūpaṃ,","tha-ap562:16.2":"akaruṃ te ca kañcukaṃ;","tha-ap562:16.3":"Yojanaṃ tepi vaḍḍhesuṃ,","tha-ap562:16.4":"āyataṃ buddhacetiyaṃ.","tha-ap562:17.1":"“Catuyojanamubbedho,","tha-ap562:17.2":"buddhathūpo virocati;","tha-ap562:17.3":"Obhāseti disā sabbā,","tha-ap562:17.4":"sataraṃsīva uggato.","tha-ap562:18.1":"“Kumbhaṇḍā ca samāgantvā,","tha-ap562:18.2":"ekato mantayuṃ tadā;","tha-ap562:18.3":"‘Manussā ceva devā ca,","tha-ap562:18.4":"nāgā ca garuḷā tathā.","tha-ap562:19.1":"“‘Paccekaṃ buddhaseṭṭhassa,","tha-ap562:19.2":"akaṃsu thūpamuttamaṃ;","tha-ap562:19.3":"Mā no pamattā assumha,","tha-ap562:19.4":"appamattā sadevakā.","tha-ap562:20.1":"“‘Mayampi thūpaṃ kassāma,","tha-ap562:20.2":"lokanāthassa tādino;","tha-ap562:20.3":"Ratanehi chādessāma,","tha-ap562:20.4":"āyataṃ buddhacetiyaṃ’.","tha-ap562:21.1":"“Yojanaṃ tepi vaḍḍhesuṃ,","tha-ap562:21.2":"āyataṃ buddhacetiyaṃ;","tha-ap562:21.3":"Pañcayojanamubbedho,","tha-ap562:21.4":"thūpo obhāsate tadā.","tha-ap562:22.1":"“Yakkhā tattha samāgantvā,","tha-ap562:22.2":"ekato mantayuṃ tadā;","tha-ap562:22.3":"‘Manussā devanāgā ca,","tha-ap562:22.4":"garuḷā ca kumbhaṇḍakā.","tha-ap562:23.1":"“‘Paccekaṃ buddhaseṭṭhassa,","tha-ap562:23.2":"akaṃsu thūpamuttamaṃ;","tha-ap562:23.3":"Mā no pamattā assumha,","tha-ap562:23.4":"appamattā sadevakā.","tha-ap562:24.1":"“‘Mayampi thūpaṃ kassāma,","tha-ap562:24.2":"lokanāthassa tādino;","tha-ap562:24.3":"Phalikā chādayissāma,","tha-ap562:24.4":"āyataṃ buddhacetiyaṃ’.","tha-ap562:25.1":"“Yojanaṃ tepi vaḍḍhesuṃ,","tha-ap562:25.2":"āyataṃ buddhacetiyaṃ;","tha-ap562:25.3":"Chayojanikamubbedho,","tha-ap562:25.4":"thūpo obhāsate tadā.","tha-ap562:26.1":"“Gandhabbā ca samāgantvā,","tha-ap562:26.2":"ekato mantayuṃ tadā;","tha-ap562:26.3":"‘Manujā devatā nāgā,","tha-ap562:26.4":"kumbhaṇḍā garuḷā tathā [kumbhaṇḍā ca yakkhā tathā (sī.)].","tha-ap562:27.1":"“‘Sabbe akaṃsu buddhathūpaṃ,","tha-ap562:27.2":"mayamettha akārakā;","tha-ap562:27.3":"Mayampi thūpaṃ kassāma,","tha-ap562:27.4":"lokanāthassa tādino’.","tha-ap562:28.1":"“Vediyo satta katvāna,","tha-ap562:28.2":"dhajaṃ chattaṃ akaṃsu te;","tha-ap562:28.3":"Sabbasoṇṇamayaṃ thūpaṃ,","tha-ap562:28.4":"gandhabbā kārayuṃ tadā.","tha-ap562:29.1":"“Sattayojanamubbedho,","tha-ap562:29.2":"thūpo obhāsate tadā;","tha-ap562:29.3":"Rattindivā na ñāyanti,","tha-ap562:29.4":"āloko hoti sabbadā.","tha-ap562:30.1":"“Abhibhonti na tassābhā,","tha-ap562:30.2":"candasūrā satārakā;","tha-ap562:30.3":"Samantā yojanasate,","tha-ap562:30.4":"padīpopi na pajjali.","tha-ap562:31.1":"“Tena kālena ye keci,","tha-ap562:31.2":"thūpaṃ pūjenti mānusā;","tha-ap562:31.3":"Na te thūpaṃ āruhanti,","tha-ap562:31.4":"ambare ukkhipanti te.","tha-ap562:32.1":"“Devehi ṭhapito yakkho,","tha-ap562:32.2":"abhisammatanāmako;","tha-ap562:32.3":"Dhajaṃ vā pupphadāmaṃ vā,","tha-ap562:32.4":"abhiropeti uttariṃ.","tha-ap562:33.1":"“Na te passanti taṃ yakkhaṃ,","tha-ap562:33.2":"dāmaṃ passanti gacchato;","tha-ap562:33.3":"Evaṃ passitvā gacchantā,","tha-ap562:33.4":"sabbe gacchanti suggatiṃ.","tha-ap562:34.1":"“Viruddhā ye pāvacane,","tha-ap562:34.2":"pasannā ye ca sāsane;","tha-ap562:34.3":"Pāṭihīraṃ daṭṭhukāmā,","tha-ap562:34.4":"thūpaṃ pūjenti mānusā.","tha-ap562:35.1":"“Nagare haṃsavatiyā,","tha-ap562:35.2":"ahosiṃ bhatako tadā;","tha-ap562:35.3":"Āmoditaṃ janaṃ disvā,","tha-ap562:35.4":"evaṃ cintesahaṃ tadā.","tha-ap562:36.1":"“‘Uḷāro bhagavā neso,","tha-ap562:36.2":"yassa dhātughare disaṃ;","tha-ap562:36.3":"Imā ca janatā tuṭṭhā,","tha-ap562:36.4":"kāraṃ kubbaṃ na tappare.","tha-ap562:37.1":"“‘Ahampi kāraṃ kassāmi,","tha-ap562:37.2":"lokanāthassa tādino;","tha-ap562:37.3":"Tassa dhammesu dāyādo,","tha-ap562:37.4":"bhavissāmi anāgate’.","tha-ap562:38.1":"“Sudhotaṃ rajakenāhaṃ,","tha-ap562:38.2":"uttareyyaṃ paṭaṃ mama;","tha-ap562:38.3":"Veḷagge ālaggetvāna,","tha-ap562:38.4":"dhajaṃ ukkhipimambare.","tha-ap562:39.1":"“Abhisammatako gayha,","tha-ap562:39.2":"ambare hāsi me dhajaṃ;","tha-ap562:39.3":"Vāteritaṃ dhajaṃ disvā,","tha-ap562:39.4":"bhiyyo hāsaṃ janesahaṃ.","tha-ap562:40.1":"“Tattha cittaṃ pasādetvā,","tha-ap562:40.2":"samaṇaṃ upasaṅkamiṃ;","tha-ap562:40.3":"Taṃ bhikkhuṃ abhivādetvā,","tha-ap562:40.4":"vipākaṃ pucchahaṃ dhaje.","tha-ap562:41.1":"“So me kathesi ānandī,","tha-ap562:41.2":"pītisañjananaṃ mama;","tha-ap562:41.3":"‘Tassa dhajassa vipākaṃ,","tha-ap562:41.4":"anubhossasi sabbadā.","tha-ap562:42.1":"“‘Hatthiassarathāpattī,","tha-ap562:42.2":"senā ca caturaṅginī;","tha-ap562:42.3":"Parivāressanti taṃ niccaṃ,","tha-ap562:42.4":"dhajadānassidaṃ phalaṃ.","tha-ap562:43.1":"“‘Saṭṭhituriyasahassāni,","tha-ap562:43.2":"bheriyo samalaṅkatā;","tha-ap562:43.3":"Parivāressanti taṃ niccaṃ,","tha-ap562:43.4":"dhajadānassidaṃ phalaṃ.","tha-ap562:44.1":"“‘Chaḷasītisahassāni,","tha-ap562:44.2":"nāriyo samalaṅkatā;","tha-ap562:44.3":"Vicittavatthābharaṇā,","tha-ap562:44.4":"āmukkamaṇikuṇḍalā.","tha-ap562:45.1":"“‘Āḷārapamhā hasulā,","tha-ap562:45.2":"susaññā [sutthanā (sī.) apa. thera 2.48.19 maṇipūjakattherāpadānepi] tanumajjhimā;","tha-ap562:45.3":"Parivāressanti taṃ niccaṃ,","tha-ap562:45.4":"dhajadānassidaṃ phalaṃ.","tha-ap562:46.1":"“‘Tiṃsakappasahassāni,","tha-ap562:46.2":"devaloke ramissasi;","tha-ap562:46.3":"Asītikkhattuṃ devindo,","tha-ap562:46.4":"devarajjaṃ karissasi.","tha-ap562:47.1":"“‘Sahassakkhattuṃ rājā ca,","tha-ap562:47.2":"cakkavattī bhavissati;","tha-ap562:47.3":"Padesarajjaṃ vipulaṃ,","tha-ap562:47.4":"gaṇanāto asaṅkhiyaṃ.","tha-ap562:48.1":"“‘Kappasatasahassamhi,","tha-ap562:48.2":"okkākakulasambhavo;","tha-ap562:48.3":"Gotamo nāma gottena,","tha-ap562:48.4":"satthā loke bhavissati.","tha-ap562:49.1":"“‘Devalokā cavitvāna,","tha-ap562:49.2":"sukkamūlena codito;","tha-ap562:49.3":"Puññakammena saññutto,","tha-ap562:49.4":"brahmabandhu bhavissasi.","tha-ap562:50.1":"“‘Asītikoṭiṃ chaḍḍetvā,","tha-ap562:50.2":"dāse kammakare bahū;","tha-ap562:50.3":"Gotamassa bhagavato,","tha-ap562:50.4":"sāsane pabbajissasi.","tha-ap562:51.1":"“‘Ārādhayitvā sambuddhaṃ,","tha-ap562:51.2":"gotamaṃ sakyapuṅgavaṃ;","tha-ap562:51.3":"Upavānoti nāmena,","tha-ap562:51.4":"hessasi satthu sāvako’.","tha-ap562:52.1":"“Satasahasse kataṃ kammaṃ,","tha-ap562:52.2":"phalaṃ dassesi me idha;","tha-ap562:52.3":"Sumutto saravegova,","tha-ap562:52.4":"kilese jhāpayiṃ [kilesā jhāpitā (sī.)] mama.","tha-ap562:53.1":"“Cakkavattissa santassa,","tha-ap562:53.2":"cātuddīpissarassa me;","tha-ap562:53.3":"Tīṇi yojanāni sāmantā,","tha-ap562:53.4":"ussīyanti dhajā sadā.","tha-ap562:54.1":"“Satasahassito kappe,","tha-ap562:54.2":"yaṃ kammamakariṃ tadā;","tha-ap562:54.3":"Duggatiṃ nābhijānāmi,","tha-ap562:54.4":"dhajadānassidaṃ phalaṃ.","tha-ap562:55.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap562:55.3":"viharāmi anāsavo.","tha-ap562:56.1":"“Svāgataṃ vata me āsi … pe …","tha-ap562:56.3":"kataṃ buddhassa sāsanaṃ.","tha-ap562:57.1":"“Paṭisambhidā catasso … pe …","tha-ap562:57.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap562:58.1":"Itthaṃ sudaṃ āyasmā upavānatthero imā gāthāyo Abhāsitthāti.","tha-ap562:59.1":"Upavānattherassāpadānaṃ dasamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3844,"to":3853,"paras":[{"para":3844,"vripara":"122","refs":["tha-ap562:1"],"lines":["Athāyasmā upavāno aparabhāge attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>padumuttaro nāma jino</b>tiādimāha.","Tattha <b>padumuttaro</b>tiādīni pubbe vuttatthāneva."],"lineRefs":[["tha-ap562:1"],["tha-ap562:1"]]},{"para":3845,"vripara":"123","refs":["tha-ap562:2"],"lines":["<b>Mahājanā samāgammā</b>ti sakalajambudīpavāsino rāsibhūtāti attho.","<b>Citakaṃ katvā</b>ti yojanubbedhaṃ candanarāsicitakaṃ katvā bhagavato sarīraṃ tattha abhiropayiṃsūti sambandho."],"lineRefs":[["tha-ap562:2"],["tha-ap562:2"]]},{"para":3846,"vripara":"124","refs":["tha-ap562:3"],"lines":["<b>Sarīrakiccaṃ katvānā</b>ti ādahanāti agginā dahanakiccaṃ katvāti attho."],"lineRefs":[["tha-ap562:3"]]},{"para":3847,"vripara":"127-128","refs":["tha-ap562:6"],"lines":["127-28. <b>Jaṅghā maṇimayā āsī</b>ti manussehi katathūpe jaṅghā pupphavāhatthaṃ caritaṭṭhānaṃ maṇimayā indanīlamaṇinā katāti attho.","<b>Mayampī</b>ti sabbe devā thūpaṃ karissāmāti attho."],"lineRefs":[["tha-ap562:6"],["tha-ap562:6"]]},{"para":3848,"vripara":"129","refs":["tha-ap562:8"],"lines":["<b>Dhātu āveṇikā natthī</b>ti devamanussehi visuṃ visuṃ cetiyaṃ kātuṃ āveṇikā visuṃ dhātu natthi, taṃ dassento <b>sarīraṃ ekapiṇḍitan</b>ti āha.","Adhiṭṭhānabalena sakalasarīradhātu ekaghanasilāmayapaṭimā viya ekameva ahosīti attho.","<b>Imamhi buddhathūpamhī</b>ti sakalajambudīpavāsīhi katamhi imamhi suvaṇṇathūpamhi mayaṃ sabbe samāgantvā kañcukathūpaṃ karissāmāti attho."],"lineRefs":[["tha-ap562:8"],["tha-ap562:8"],["tha-ap562:8"]]},{"para":3849,"vripara":"133","refs":["tha-ap562:12"],"lines":["<b>Indanīlaṃ mahānīlan</b>ti indīvarapupphavaṇṇābhaṃ maṇi indanīlamaṇi.","Tato adhikavaṇṇatā mahāmaṇi indanīlamaṇayo ca mahānīlamaṇayo ca jotirasamaṇijātiraṅgamaṇayo ca <b>ekato sannipātetvā</b> rāsī katvā suvaṇṇathūpe kañcukathūpaṃ katvā achādayunti sambandho."],"lineRefs":[["tha-ap562:12"],["tha-ap562:12"]]},{"para":3850,"vripara":"144","refs":["tha-ap562:23"],"lines":["<b>Paccekaṃ buddhaseṭṭhassā</b>ti buddhuttamassa pati ekaṃ visuṃ uparichadanena thūpaṃ akaṃsūti attho."],"lineRefs":[["tha-ap562:23"]]},{"para":3851,"vripara":"147","refs":["tha-ap562:23"],"lines":["<b>Kumbhaṇḍā guyhakā tathā</b>ti kumbhamattāni aṇḍāni yesaṃ devānaṃ te kumbhaṇḍā, paṭicchādetvā niguhitvā paṭicchādanato garuḷā guyhakā nāma jātā, te kumbhaṇḍā guyhakāpi thūpaṃ akaṃsūti attho."],"lineRefs":[["tha-ap562:23"]]},{"para":3852,"vripara":"151","refs":["tha-ap562:23"],"lines":["<b>Atibhonti na tassābhā</b>ti tassa cetiyassa pabhaṃ candasūriyatārakānaṃ pabhā na atibhonti, na ajjhottharantīti attho."],"lineRefs":[["tha-ap562:23"]]},{"para":3853,"vripara":"158","refs":["tha-ap562:37"],"lines":["<b>Ahampi kāraṃ kassāmī</b>ti tādino lokanāthassa thūpasmiṃ ahampi kāraṃ puññakiriyaṃ kusalakammaṃ dhajapaṭākapūjaṃ karissāmīti attho."],"lineRefs":[["tha-ap562:37"]]}],"wordLinks":[["tha-ap562:1.1","padumuttaro nāma jino",0,0],["tha-ap562:1.1","padumuttaro",0,1],["tha-ap562:2.1","mahājanā samāgammā",1,0],["tha-ap562:3.1","sarīrakiccaṃ katvānā",2,0],["tha-ap562:6.1","jaṅghā maṇimayā āsī",3,0],["tha-ap562:8.1","dhātu āveṇikā natthī",4,0],["tha-ap562:8.1","sarīraṃ ekapiṇḍitaṃ",4,0],["tha-ap562:8.3","imamhi buddhathūpamhī",4,2],["tha-ap562:12.1","indanīlaṃ mahānīlaṃ",5,0],["tha-ap562:12.3","ekato sannipātetvā",5,1],["tha-ap562:23.1","paccekaṃ buddhaseṭṭhassā",6,0],["tha-ap562:37.1","ahampi kāraṃ kassāmī",9,0]],"before":[{"para":3835,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["Upavānattheraapadānavaṇṇanā"]},{"para":3836,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["Dasamāpadāne <b>padumuttaro nāma jino</b>tiādikaṃ āyasmato upavānattherassa apadānaṃ.","Ayaṃ kira purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto kenaci kammacchiddena padumuttarassa bhagavato kāle dalliddakule nibbattitvā viññutaṃ patto bhagavati parinibbute tassa dhātuṃ gahetvā manussadevanāgagaruḷayakkhakumbhaṇḍagandhabbehi sattaratanamaye sattayojanike thūpe kate tattha sudhotaṃ attano uttarāsaṅgaṃ veḷagge ābandhitvā dhajaṃ katvā pūjaṃ akāsi.","Taṃ gahetvā abhisammatako nāma yakkhasenāpati devehi cetiyapūjārakkhaṇatthaṃ ṭhapito adissamānakāyo ākāse dhārento cetiyaṃ tikkhattuṃ padakkhiṇaṃ akāsi.","Taṃ disvā bhiyyosomattāya pasannamānaso ahosi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇakule nibbattitvā <b>upavāno</b>ti laddhanāmo vayappatto jetavanapaṭiggahaṇe buddhānubhāvaṃ disvā paṭiladdhasaddho pabbajitvā vipassanāya kammaṃ karonto chaḷabhiñño ahosi.","Athāyasmā upavāno bhagavato upaṭṭhāko ahosi.","Tena ca samayena bhagavato vātābādho uppajji.","Therassa gihisahāyo devahito nāma brāhmaṇo sāvatthiyaṃ paṭivasati.","So theraṃ catūhi paccayehi pavāresi.","Athāyasmā upavāno nivāsetvā pattacīvaraṃ gahetvā tassa brāhmaṇassa nivesanaṃ upagañchi.","Brāhmaṇo “kenaci maññe payojanena thero āgato bhavissatī”ti ñatvā “vadeyyātha, bhante, kenattho”ti āha.","Thero tassa brāhmaṇassa payojanaṃ ācikkhanto –"]},{"para":3837,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["“Arahaṃ sugato loke, vātehābādhiko muni;"]},{"para":3838,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["Sace uṇhodakaṃ atthi, munino dehi brāhmaṇa."]},{"para":3839,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["“Pūjito pūjaneyyānaṃ, sakkareyyāna sakkato;"]},{"para":3840,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["Apacitopaceyyānaṃ, tassa icchāmi hātave”ti.(theragā.185-186)–"]},{"para":3841,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["Gāthādvayaṃ abhāsi."]},{"para":3842,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["Tassattho – yo imasmiṃ loke pūjaneyyānaṃ pūjetabbehi sakkādīhi devehi mahābrahmādīhi ca brahmehi pūjito, sakkareyyānaṃ sakkātabbehi bimbisārakosalarājādīhi sakkato, apaceyyānaṃ apacāyitabbehi mahesīhi khīṇāsavehi apacito, kilesehi ārakattādinā arahaṃ, sobhanagamanādinā sugato sabbaññū muni mayhaṃ satthā devadevo sakkānaṃ atisakko brahmānaṃ atibrahmā, so dāni vātehi vātahetu vātakkhobhanimittaṃ ābādhiko jāto.","Sace, brāhmaṇa, uṇhodakaṃ atthi, tassa vātābādhavūpasamanatthaṃ taṃ hātave upanetuṃ icchāmīti."]},{"para":3843,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["Taṃ sutvā brāhmaṇo uṇhodakaṃ tadanurūpaṃ vātaharañca bhesajjaṃ bhagavato upanāmesi.","Tena ca satthu rogo vūpasami.","Tassa bhagavā anumodanaṃ akāsi."]}],"after":[{"para":3854,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["Upavānattheraapadānavaṇṇanā samattā."]}]},"tika":null,"tika2":null}
