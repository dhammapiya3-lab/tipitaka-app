{"suttaId":"thag5.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1555,1570],"vripara":"330"},"segments":{"thag5.4:0.4":"Sumanattheragāthā","thag5.4:1.1":"“Yaṃ patthayāno dhammesu, upajjhāyo anuggahi;","thag5.4:1.3":"Amataṃ abhikaṅkhantaṃ, kataṃ kattabbakaṃ mayā.","thag5.4:2.1":"“Anuppatto sacchikato, sayaṃ dhammo anītiho;","thag5.4:2.3":"Visuddhiñāṇo nikkaṅkho, byākaromi tavantike.","thag5.4:3.1":"“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;","thag5.4:3.3":"Sadattho me anuppatto, kataṃ buddhassa sāsanaṃ.","thag5.4:4.1":"“Appamattassa me sikkhā, sussutā tava sāsane;","thag5.4:4.3":"Sabbe me āsavā khīṇā, natthi dāni punabbhavo.","thag5.4:5.1":"“Anusāsi maṃ ariyavatā, anukampi anuggahi;","thag5.4:5.3":"Amogho tuyhamovādo, antevāsimhi sikkhito”ti.","thag5.4:5.5":"… Sumano thero …."},"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":637,"to":638,"paras":[{"para":637,"vripara":null,"refs":["thag5.4:5"],"lines":["<b>Sadattho</b>ti arahattaṃ.","<b>Sikkhā</b>ti adhisīlasikkhādayo.","<b>Sussutā</b>ti pariyattibāhusaccassa paṭivedhabāhusaccassa ca pāripūrivasena suṭṭhu sutā.","<b>Tava sāsane</b>ti tava ovāde anusiṭṭhiyaṃ ṭhitassa."],"lineRefs":[["thag5.4:5"],["thag5.4:5"],["thag5.4:5"],["thag5.4:5"]]},{"para":638,"vripara":null,"refs":["thag5.4:5"],"lines":["<b>Ariyavatā</b>ti suvisuddhasīlādivatasamādānena.","<b>Antevāsimhi sikkhito</b>ti tuyhaṃ samīpe ciṇṇabrahmacariyavāsatāya antevāsī sikkhitavā sikkhitaadhisīlādisikkho amhīti."],"lineRefs":[["thag5.4:5"],["thag5.4:5"]]}],"wordLinks":[["thag5.4:5.3","sikkhā",0,1],["thag5.4:5.1","ariyavatā",1,0],["thag5.4:5.3","antevāsimhi sikkhito",1,1]],"before":[{"para":595,"vripara":null,"refs":[],"lines":["Evaṃ therassa anekavāraṃ kataṃ uyyojanaṃ sirasā sampaṭicchanto valāhakadevaputto ninnañca thalañca pūrento mahāvassaṃ vassāpesi."],"lineRefs":[[]]},{"para":596,"vripara":null,"refs":[],"lines":["Girimānandattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":597,"vripara":null,"refs":[],"lines":["Sumanattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":598,"vripara":null,"refs":[],"lines":["<b>Yaṃ patthayāno</b>tiādikā āyasmato sumanattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto ito pañcanavute kappe buddhasuññe loke kulagehe nibbattitvā viññutaṃ patto ekaṃ paccekabuddhaṃ byādhitaṃ disvā harītakaṃ adāsi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde kosalaraṭṭhe gahapatikule nibbattitvā <b>sumano</b>ti laddhanāmo sukhena vaḍḍhi.","Tassa pana mātulo pabbajitvā arahā hutvā araññe viharanto sumane vayappatte taṃ pabbājetvā caritānukūlaṃ kammaṭṭhānaṃ adāsi.","So tattha yogakammaṃ karonto cattāri jhānāni pañca ca abhiññāyo nibbattesi.","Athassa thero vipassanāvidhiṃ ācikkhi.","So ca nacireneva vipassanaṃ vaḍḍhetvā arahatte patiṭṭhāsi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.44.60-71)–"],"lineRefs":[[],[],[],[],[],[],[],[],[]]},{"para":599,"vripara":null,"refs":[],"lines":["“Harītakaṃ āmalakaṃ, ambajambuvibhītakaṃ;"],"lineRefs":[[]]},{"para":600,"vripara":null,"refs":[],"lines":["Kolaṃ bhallātakaṃ billaṃ, sayameva harāmahaṃ."],"lineRefs":[[]]},{"para":601,"vripara":null,"refs":[],"lines":["“Disvāna pabbhāragataṃ, jhāyiṃ jhānarataṃ muniṃ;"],"lineRefs":[[]]},{"para":602,"vripara":null,"refs":[],"lines":["Ābādhena āpīḷentaṃ, adutīyaṃ mahāmuniṃ."],"lineRefs":[[]]},{"para":603,"vripara":null,"refs":[],"lines":["“Harītakaṃ gahetvāna, sayambhussa adāsahaṃ;"],"lineRefs":[[]]},{"para":604,"vripara":null,"refs":[],"lines":["Khādamattamhi bhesajje, byādhi passambhi tāvade."],"lineRefs":[[]]},{"para":605,"vripara":null,"refs":[],"lines":["“Pahīnadaratho buddho, anumodamakāsi me;"],"lineRefs":[[]]},{"para":606,"vripara":null,"refs":[],"lines":["Bhesajjadāneniminā, byādhivūpasamena ca."],"lineRefs":[[]]},{"para":607,"vripara":null,"refs":[],"lines":["“Devabhūto manusso vā, jāto vā aññajātiyā;"],"lineRefs":[[]]},{"para":608,"vripara":null,"refs":[],"lines":["Sabbattha sukhito hotu, mā ca te byādhimāgamā."],"lineRefs":[[]]},{"para":609,"vripara":null,"refs":[],"lines":["“Idaṃ vatvāna sambuddho, sayambhū aparājito;"],"lineRefs":[[]]},{"para":610,"vripara":null,"refs":[],"lines":["Nabhaṃ abbhuggamī dhīro, haṃsarājāva ambare."],"lineRefs":[[]]},{"para":611,"vripara":null,"refs":[],"lines":["“Yato harītakaṃ dinnaṃ, sayambhussa mahesino;"],"lineRefs":[[]]},{"para":612,"vripara":null,"refs":[],"lines":["Imaṃ jātiṃ upādāya, byādhi me nupapajjatha."],"lineRefs":[[]]},{"para":613,"vripara":null,"refs":[],"lines":["“Ayaṃ pacchimako mayhaṃ, carimo vattate bhavo;"],"lineRefs":[[]]},{"para":614,"vripara":null,"refs":[],"lines":["Tisso vijjā sacchikatā, kataṃ buddhassa sāsanaṃ."],"lineRefs":[[]]},{"para":615,"vripara":null,"refs":[],"lines":["“Catunnavutito kappe, bhesajjamadadiṃ tadā;"],"lineRefs":[[]]},{"para":616,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, bhesajjassa idaṃ phalaṃ."],"lineRefs":[[]]},{"para":617,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":618,"vripara":null,"refs":[],"lines":["Arahatte pana patiṭṭhito ekadivasaṃ mātulattherassa upaṭṭhānaṃ agamāsi.","Taṃ thero adhigamaṃ pucchi, taṃ byākaronto –"],"lineRefs":[[],[]]},{"para":620,"vripara":"330","refs":[],"lines":["“Yaṃ patthayāno dhammesu, upajjhāyo anuggahi;"],"lineRefs":[[]]},{"para":621,"vripara":null,"refs":[],"lines":["Amataṃ abhikaṅkhantaṃ, kataṃ kattabbakaṃ mayā."],"lineRefs":[[]]},{"para":623,"vripara":"331","refs":[],"lines":["“Anuppatto sacchikato, sayaṃ dhammo anītiho;"],"lineRefs":[[]]},{"para":624,"vripara":null,"refs":[],"lines":["Visuddhañāṇo nikkaṅkho, byākaromi tavantike."],"lineRefs":[[]]},{"para":626,"vripara":"332","refs":[],"lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"],"lineRefs":[[]]},{"para":627,"vripara":null,"refs":[],"lines":["Sadattho me anuppatto, kataṃ buddhassa sāsanaṃ."],"lineRefs":[[]]},{"para":629,"vripara":"333","refs":[],"lines":["“Appamattassa me sikkhā, sussutā tava sāsane;"],"lineRefs":[[]]},{"para":630,"vripara":null,"refs":[],"lines":["Sabbe me āsavā khīṇā, natthi dāni punabbhavo."],"lineRefs":[[]]},{"para":632,"vripara":"334","refs":[],"lines":["“Anusāsi maṃ ariyavatā, anukampi anuggahi;"],"lineRefs":[[]]},{"para":633,"vripara":null,"refs":[],"lines":["Amogho tuyhamovādo, antevāsimhi sikkhito”ti.","–"],"lineRefs":[[],[]]},{"para":634,"vripara":null,"refs":[],"lines":["Imāhi pañcahi gāthāhi sīhanādaṃ nadanto aññaṃ byākāsi."],"lineRefs":[[]]},{"para":635,"vripara":null,"refs":[],"lines":["Tattha <b>yaṃ patthayāno dhammesu, upajjhāyo anuggahi.</b>","<b>Amataṃ abhikaṅkhantan</b>ti samathavipassanādīsu anavajjadhammesu yaṃ dhammaṃ mayhaṃ patthayanto ākaṅkhanto upajjhāyo amataṃ nibbānaṃ abhikaṅkhantaṃ maṃ ovādadānavasena anuggaṇhi.","<b>Kataṃ kattabbakaṃ mayā</b>ti tassa adhigamatthaṃ kattabbaṃ pariññādisoḷasavidhaṃ kiccaṃ kataṃ niṭṭhāpitaṃ mayā."],"lineRefs":[[],[],[]]},{"para":636,"vripara":null,"refs":[],"lines":["Tato eva <b>anuppatto</b> adhigato catubbidhopi maggadhammo <b>sacchikato.</b>","<b>Sayaṃ dhammo anītiho</b>ti sayaṃ attanāyeva nibbānadhammo phaladhammo ca anītiho asandiddho attapaccakkho kato,“itiha, iti kirā”ti pavattiyā itihasaṅkhātaṃ saṃsayaṃ samucchindantoyeva ariyamaggo pavattati.","Tenāha <b>“visuddhañāṇo nikkaṅkho”</b>tiādi.","Tattha <b>visuddhañāṇo</b>ti sabbasaṃkilesavisuddhiyā visuddhañāṇo.","<b>Tavantike</b>ti tava samīpe."],"lineRefs":[[],[],[],[],[]]}]},"tika":null,"tika2":null}
