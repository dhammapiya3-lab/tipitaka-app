{"suttaId":"thag5.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1555,1570],"vripara":"330"},"segments":{"thag5.4:0.4":"Sumanattheragāthā","thag5.4:1.1":"“Yaṃ patthayāno dhammesu,","thag5.4:1.2":"upajjhāyo anuggahi;","thag5.4:1.3":"Amataṃ abhikaṅkhantaṃ,","thag5.4:1.4":"kataṃ kattabbakaṃ mayā.","thag5.4:2.1":"“Anuppatto sacchikato,","thag5.4:2.2":"sayaṃ dhammo anītiho;","thag5.4:2.3":"Visuddhiñāṇo nikkaṅkho,","thag5.4:2.4":"byākaromi tavantike.","thag5.4:3.1":"“Pubbenivāsaṃ jānāmi,","thag5.4:3.2":"dibbacakkhu visodhitaṃ;","thag5.4:3.3":"Sadattho me anuppatto,","thag5.4:3.4":"kataṃ buddhassa sāsanaṃ.","thag5.4:4.1":"“Appamattassa me sikkhā,","thag5.4:4.2":"sussutā tava sāsane;","thag5.4:4.3":"Sabbe me āsavā khīṇā,","thag5.4:4.4":"natthi dāni punabbhavo.","thag5.4:5.1":"“Anusāsi maṃ ariyavatā,","thag5.4:5.2":"anukampi anuggahi;","thag5.4:5.3":"Amogho tuyhamovādo,","thag5.4:5.4":"antevāsimhi sikkhito”ti.","thag5.4:5.5":"… Sumano thero …."},"unsure":[],"preface":[],"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":637,"to":638,"paras":[{"para":637,"vripara":null,"refs":["thag5.4:5"],"lines":["<b>Sadattho</b>ti arahattaṃ.","<b>Sikkhā</b>ti adhisīlasikkhādayo.","<b>Sussutā</b>ti pariyattibāhusaccassa paṭivedhabāhusaccassa ca pāripūrivasena suṭṭhu sutā.","<b>Tava sāsane</b>ti tava ovāde anusiṭṭhiyaṃ ṭhitassa."],"lineRefs":[["thag5.4:5"],["thag5.4:5"],["thag5.4:5"],["thag5.4:5"]]},{"para":638,"vripara":null,"refs":["thag5.4:5"],"lines":["<b>Ariyavatā</b>ti suvisuddhasīlādivatasamādānena.","<b>Antevāsimhi sikkhito</b>ti tuyhaṃ samīpe ciṇṇabrahmacariyavāsatāya antevāsī sikkhitavā sikkhitaadhisīlādisikkho amhīti."],"lineRefs":[["thag5.4:5"],["thag5.4:5"]]}],"wordLinks":[["thag5.4:5.3","sikkhā",0,1],["thag5.4:5.1","ariyavatā",1,0],["thag5.4:5.3","antevāsimhi sikkhito",1,1]],"before":[{"para":597,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Sumanattheragāthāvaṇṇanā"]},{"para":598,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["<b>Yaṃ patthayāno</b>tiādikā āyasmato sumanattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto ito pañcanavute kappe buddhasuññe loke kulagehe nibbattitvā viññutaṃ patto ekaṃ paccekabuddhaṃ byādhitaṃ disvā harītakaṃ adāsi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde kosalaraṭṭhe gahapatikule nibbattitvā <b>sumano</b>ti laddhanāmo sukhena vaḍḍhi.","Tassa pana mātulo pabbajitvā arahā hutvā araññe viharanto sumane vayappatte taṃ pabbājetvā caritānukūlaṃ kammaṭṭhānaṃ adāsi.","So tattha yogakammaṃ karonto cattāri jhānāni pañca ca abhiññāyo nibbattesi.","Athassa thero vipassanāvidhiṃ ācikkhi.","So ca nacireneva vipassanaṃ vaḍḍhetvā arahatte patiṭṭhāsi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.44.60-71)–"]},{"para":599,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["“Harītakaṃ āmalakaṃ, ambajambuvibhītakaṃ;"]},{"para":600,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Kolaṃ bhallātakaṃ billaṃ, sayameva harāmahaṃ."]},{"para":601,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["“Disvāna pabbhāragataṃ, jhāyiṃ jhānarataṃ muniṃ;"]},{"para":602,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Ābādhena āpīḷentaṃ, adutīyaṃ mahāmuniṃ."]},{"para":603,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["“Harītakaṃ gahetvāna, sayambhussa adāsahaṃ;"]},{"para":604,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Khādamattamhi bhesajje, byādhi passambhi tāvade."]},{"para":605,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["“Pahīnadaratho buddho, anumodamakāsi me;"]},{"para":606,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Bhesajjadāneniminā, byādhivūpasamena ca."]},{"para":607,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["“Devabhūto manusso vā, jāto vā aññajātiyā;"]},{"para":608,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Sabbattha sukhito hotu, mā ca te byādhimāgamā."]},{"para":609,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["“Idaṃ vatvāna sambuddho, sayambhū aparājito;"]},{"para":610,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Nabhaṃ abbhuggamī dhīro, haṃsarājāva ambare."]},{"para":611,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["“Yato harītakaṃ dinnaṃ, sayambhussa mahesino;"]},{"para":612,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Imaṃ jātiṃ upādāya, byādhi me nupapajjatha."]},{"para":613,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["“Ayaṃ pacchimako mayhaṃ, carimo vattate bhavo;"]},{"para":614,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Tisso vijjā sacchikatā, kataṃ buddhassa sāsanaṃ."]},{"para":615,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["“Catunnavutito kappe, bhesajjamadadiṃ tadā;"]},{"para":616,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, bhesajjassa idaṃ phalaṃ."]},{"para":617,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."]},{"para":618,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Arahatte pana patiṭṭhito ekadivasaṃ mātulattherassa upaṭṭhānaṃ agamāsi.","Taṃ thero adhigamaṃ pucchi, taṃ byākaronto –"]},{"para":620,"vripara":"330","title":"Sumanattheragāthāvaṇṇanā","lines":["“Yaṃ patthayāno dhammesu, upajjhāyo anuggahi;"]},{"para":621,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Amataṃ abhikaṅkhantaṃ, kataṃ kattabbakaṃ mayā."]},{"para":623,"vripara":"331","title":"Sumanattheragāthāvaṇṇanā","lines":["“Anuppatto sacchikato, sayaṃ dhammo anītiho;"]},{"para":624,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Visuddhañāṇo nikkaṅkho, byākaromi tavantike."]},{"para":626,"vripara":"332","title":"Sumanattheragāthāvaṇṇanā","lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"]},{"para":627,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Sadattho me anuppatto, kataṃ buddhassa sāsanaṃ."]},{"para":629,"vripara":"333","title":"Sumanattheragāthāvaṇṇanā","lines":["“Appamattassa me sikkhā, sussutā tava sāsane;"]},{"para":630,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Sabbe me āsavā khīṇā, natthi dāni punabbhavo."]},{"para":632,"vripara":"334","title":"Sumanattheragāthāvaṇṇanā","lines":["“Anusāsi maṃ ariyavatā, anukampi anuggahi;"]},{"para":633,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Amogho tuyhamovādo, antevāsimhi sikkhito”ti.","–"]},{"para":634,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Imāhi pañcahi gāthāhi sīhanādaṃ nadanto aññaṃ byākāsi."]},{"para":635,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Tattha <b>yaṃ patthayāno dhammesu, upajjhāyo anuggahi.</b>","<b>Amataṃ abhikaṅkhantan</b>ti samathavipassanādīsu anavajjadhammesu yaṃ dhammaṃ mayhaṃ patthayanto ākaṅkhanto upajjhāyo amataṃ nibbānaṃ abhikaṅkhantaṃ maṃ ovādadānavasena anuggaṇhi.","<b>Kataṃ kattabbakaṃ mayā</b>ti tassa adhigamatthaṃ kattabbaṃ pariññādisoḷasavidhaṃ kiccaṃ kataṃ niṭṭhāpitaṃ mayā."]},{"para":636,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Tato eva <b>anuppatto</b> adhigato catubbidhopi maggadhammo <b>sacchikato.</b>","<b>Sayaṃ dhammo anītiho</b>ti sayaṃ attanāyeva nibbānadhammo phaladhammo ca anītiho asandiddho attapaccakkho kato,“itiha, iti kirā”ti pavattiyā itihasaṅkhātaṃ saṃsayaṃ samucchindantoyeva ariyamaggo pavattati.","Tenāha <b>“visuddhañāṇo nikkaṅkho”</b>tiādi.","Tattha <b>visuddhañāṇo</b>ti sabbasaṃkilesavisuddhiyā visuddhañāṇo.","<b>Tavantike</b>ti tava samīpe."]}],"after":[{"para":639,"vripara":null,"title":"Sumanattheragāthāvaṇṇanā","lines":["Sumanattheragāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
