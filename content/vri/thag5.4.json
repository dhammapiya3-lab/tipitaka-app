{"suttaId":"thag5.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1555,1570],"vripara":"330"},"segments":{"thag5.4:0.4":"Sumanattheragāthā","thag5.4:1.1":"“Yaṃ patthayāno dhammesu, upajjhāyo anuggahi;","thag5.4:1.3":"Amataṃ abhikaṅkhantaṃ, kataṃ kattabbakaṃ mayā.","thag5.4:2.1":"“Anuppatto sacchikato, sayaṃ dhammo anītiho;","thag5.4:2.3":"Visuddhiñāṇo nikkaṅkho, byākaromi tavantike.","thag5.4:3.1":"“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;","thag5.4:3.3":"Sadattho me anuppatto, kataṃ buddhassa sāsanaṃ.","thag5.4:4.1":"“Appamattassa me sikkhā, sussutā tava sāsane;","thag5.4:4.3":"Sabbe me āsavā khīṇā, natthi dāni punabbhavo.","thag5.4:5.1":"“Anusāsi maṃ ariyavatā, anukampi anuggahi;","thag5.4:5.3":"Amogho tuyhamovādo, antevāsimhi sikkhito”ti.","thag5.4:5.5":"… Sumano thero …."},"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":637,"to":638,"paras":[{"para":637,"vripara":null,"refs":["thag5.4:5"],"lines":["<b>Sadattho</b>ti arahattaṃ.","<b>Sikkhā</b>ti adhisīlasikkhādayo.","<b>Sussutā</b>ti pariyattibāhusaccassa paṭivedhabāhusaccassa ca pāripūrivasena suṭṭhu sutā.","<b>Tava sāsane</b>ti tava ovāde anusiṭṭhiyaṃ ṭhitassa."],"lineRefs":[["thag5.4:5"],["thag5.4:5"],["thag5.4:5"],["thag5.4:5"]]},{"para":638,"vripara":null,"refs":["thag5.4:5"],"lines":["<b>Ariyavatā</b>ti suvisuddhasīlādivatasamādānena.","<b>Antevāsimhi sikkhito</b>ti tuyhaṃ samīpe ciṇṇabrahmacariyavāsatāya antevāsī sikkhitavā sikkhitaadhisīlādisikkho amhīti."],"lineRefs":[["thag5.4:5"],["thag5.4:5"]]}],"wordLinks":[["thag5.4:5.3","sikkhā",0,1],["thag5.4:5.1","ariyavatā",1,0],["thag5.4:5.3","antevāsimhi sikkhito",1,1]]},"tika":null,"tika2":null}
