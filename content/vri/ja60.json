{"suttaId":"ja60","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[334,341],"vripara":"60"},"segments":{"ja60:0.4":"Saṅkhadhamajātakaṃ","ja60:1.1":"Dhame dhame nātidhame,","ja60:1.2":"atidhantañhi pāpakaṃ;","ja60:1.3":"Dhantenādhigatā bhogā,","ja60:1.4":"te tāto vidhamī dhamanti.","ja60:2.1":"Saṅkhadhamajātakaṃ dasamaṃ.","ja60:2.2":"Āsīsavaggo chaṭṭho.","ja60:3.1":"Tassuddānaṃ –","ja60:4.1":"Yathā icchiṃ tathāhudakā thalā,","ja60:4.2":"sura sāduphalo ca alīnamano;","ja60:4.3":"Sampahaṭṭhamano caturo ca tayo,","ja60:4.4":"sataladdhaka bhogadhanena dasāti."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1833,"to":1833,"paras":[{"para":1833,"vripara":null,"refs":["ja60:1"],"lines":["Tattha <b>te tāto vidhamī dhaman</b>ti te saṅkhaṃ dhamitvā laddhabhoge mama pitā punappunaṃ dhamanto vidhami viddhaṃsesi vināsesīti."],"lineRefs":[["ja60:1"]]}],"wordLinks":[["ja60:1.3","te tāto vidhamī dhamaṃ",0,0]],"after":[{"para":1834,"vripara":null,"title":"[60] 10. Saṅkhadhamajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā anusandhiṃ ghaṭetvā jātakaṃ samodhānesi –","“tadā pitā dubbacabhikkhu ahosi, putto panassa ahameva ahosin”ti."]},{"para":1835,"vripara":null,"title":"[60] 10. Saṅkhadhamajātakavaṇṇanā","lines":["Saṅkhadhamajātakavaṇṇanā dasamā."]},{"para":1836,"vripara":null,"title":"[60] 10. Saṅkhadhamajātakavaṇṇanā","lines":["Āsīsavaggo chaṭṭho."]},{"para":1837,"vripara":null,"title":"[60] 10. Saṅkhadhamajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":1838,"vripara":null,"title":"[60] 10. Saṅkhadhamajātakavaṇṇanā","lines":["Mahāsīlavajanakaṃ, puṇṇapāti ca kiṃphalaṃ;"]},{"para":1839,"vripara":null,"title":"[60] 10. Saṅkhadhamajātakavaṇṇanā","lines":["Pañcāvudhakañcanakkhandhaṃ, vānarindaṃ tayodhammaṃ;"]},{"para":1840,"vripara":null,"title":"[60] 10. Saṅkhadhamajātakavaṇṇanā","lines":["Bherivādasaṅkhadhamanti."]}]},"tika":null,"tika2":null}
