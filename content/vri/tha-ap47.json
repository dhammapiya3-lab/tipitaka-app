{"suttaId":"tha-ap47","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[3723,3741],"vripara":"77"},"segments":{"tha-ap47:0.3":"Pañcahatthiyattheraapadānaṃ","tha-ap47:1.1":"“Sumedho nāma sambuddho,","tha-ap47:1.2":"gacchate antarāpaṇe;","tha-ap47:1.3":"Okkhittacakkhu [khittacakkhu (ka. sī. ka.)] mitabhāṇī,","tha-ap47:1.4":"satimā saṃvutindriyo.","tha-ap47:2.1":"“Pañca uppalahatthāni,","tha-ap47:2.2":"āveḷatthaṃ ahaṃsu me;","tha-ap47:2.3":"Tena buddhaṃ apūjesiṃ,","tha-ap47:2.4":"pasanno sehi pāṇibhi.","tha-ap47:3.1":"“Āropitā ca te pupphā,","tha-ap47:3.2":"chadanaṃ assu satthuno;","tha-ap47:3.3":"Samādhiṃsu [saṃsāviṃsu (sī.)] mahānāgaṃ,","tha-ap47:3.4":"sissā ācariyaṃ yathā.","tha-ap47:4.1":"“Tiṃsakappasahassamhi,","tha-ap47:4.2":"yaṃ pupphamabhiropayiṃ;","tha-ap47:4.3":"Duggatiṃ nābhijānāmi,","tha-ap47:4.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap47:5.1":"“Ito vīsakappasate,","tha-ap47:5.2":"ahesuṃ pañca khattiyā;","tha-ap47:5.3":"Hatthiyā nāma nāmena,","tha-ap47:5.4":"cakkavattī mahabbalā.","tha-ap47:6.1":"“Paṭisambhidā catasso … pe …","tha-ap47:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap47:7.1":"Itthaṃ sudaṃ āyasmā pañcahatthiyo thero imā gāthāyo abhāsitthāti.","tha-ap47:8.1":"Pañcahatthiyattherassāpadānaṃ pañcamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2513,"to":2513,"paras":[{"para":2513,"vripara":"77","refs":["tha-ap47:1"],"lines":["So attano pubbakammaṃ saritvā paccakkhato paññāya diṭṭhapubbacaritāpadānaṃ pakāsento <b>sumedho nāma sambuddho</b>tiādimāha.","Tattha <b>sumedho</b>ti sundarā medhā catusaccapaṭivedhapaṭisambhidādayo paññā yassa so bhagavā sumedho sambuddho <b>antarāpaṇe</b> antaravīthiyaṃ gacchatīti sambandho.","<b>Okkhittacakkhū</b>ti adhokhittacakkhu.","<b>Mitabhāṇī</b>ti pamāṇaṃ ñatvā bhaṇanasīlo, pamāṇaṃ jānitvā dhammaṃ desesīti attho.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap47:1"],["tha-ap47:1"],["tha-ap47:1"],["tha-ap47:1"],["tha-ap47:1"]]}],"wordLinks":[["tha-ap47:1.1","sumedho nāma sambuddho",0,0],["tha-ap47:1.1","antarāpaṇe",0,1],["tha-ap47:1.1","sumedho",0,1],["tha-ap47:1.3","okkhittacakkhū",0,2],["tha-ap47:1.3","mitabhāṇī",0,3]]},"tika":null,"tika2":null}
