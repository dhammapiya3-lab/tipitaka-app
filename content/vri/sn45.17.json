{"suttaId":"sn45.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[86,86],"vripara":"17"},"segments":{"sn45.17:0.3":"Dutiyaparisuddhasuttaṃ","sn45.17:1.1":"Sāvatthinidānaṃ.","sn45.17:1.2":"“Aṭṭhime, bhikkhave, dhammā parisuddhā pariyodātā anaṅgaṇā vigatūpakkilesā anuppannā uppajjanti, nāññatra sugatavinayā.","sn45.17:1.3":"Katame aṭṭha?","sn45.17:1.4":"Seyyathidaṃ – sammādiṭṭhi … pe … sammāsamādhi.","sn45.17:1.5":"Ime kho, bhikkhave, aṭṭha dhammā parisuddhā pariyodātā anaṅgaṇā vigatūpakkilesā anuppannā uppajjanti, nāññatra sugatavinayā”ti.","sn45.17:1.6":"Sattamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":62,"to":63,"paras":[{"para":62,"vripara":"13-17","refs":["sn45.17:1"],"lines":["13-17. Tatiye <b>sekkho</b>ti sikkhanasīlo.","Kiṃ sikkhatīti?","Tisso sikkhā.","<b>Sekkhāyā</b>ti tīhi phalehi catūhi ca maggehi saddhiṃ uppannāya.","Sāpi hi aniṭṭhitakiccattā attano kiccaṃ sikkhatevāti sekkhā.","Catutthapañcamachaṭṭhasattamāni uttānatthānevāti."],"lineRefs":[["sn45.17:1"],["sn45.17:1"],["sn45.17:1"],["sn45.17:1"],["sn45.17:1"],["sn45.17:1"]]},{"para":63,"vripara":null,"refs":["sn45.17:1"],"lines":["8-10. Paṭhamakukkuṭārāmasuttādivaṇṇanā"],"lineRefs":[["sn45.17:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":63,"to":66,"paras":[{"para":63,"vripara":"13-17","refs":["sn45.17:1"],"lines":["13-17. Tissannampi sikkhānaṃ sikkhanaṃ sīlaṃ etassāti <b>sikkhanasīlo</b>.","Sikkhatītipi vā <b>sekkho</b>.","Vuttañhetaṃ “sikkhatīti kho, bhikkhave, tasmā sekkhoti vuccati.","Kiñca sikkhati?","Adhisīlampi sikkhatī”tiādi (a. ni.3.86).","<b>Tīhi phalehi</b> heṭṭhā.","Sāpi catutthamaggena saddhiṃ uppannasikkhāpi.","Maggakkhaṇe hi sikkhākiccaṃ na niṭṭhitaṃ vippakatabhāvato, phalakkhaṇe pana niṭṭhitaṃ nāma.","<b>Uttānatthāneva</b> heṭṭhā vuttanayattā."],"lineRefs":[["sn45.17:1"],["sn45.17:1"],["sn45.17:1"],["sn45.17:1"],["sn45.17:1"],["sn45.17:1"],["sn45.17:1"],["sn45.17:1"],["sn45.17:1"]]},{"para":64,"vripara":null,"refs":["sn45.17:1"],"lines":["Sekkhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn45.17:1"]]},{"para":65,"vripara":null,"refs":["sn45.17:1"],"lines":["Vihāravaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn45.17:1"]]},{"para":66,"vripara":null,"refs":["sn45.17:1"],"lines":["Micchattavaggavaṇṇanā"],"lineRefs":[["sn45.17:1"]]}],"wordLinks":[]},"tika2":null}
