{"suttaId":"sn37.28","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1505,1505],"vripara":"307"},"segments":{"sn37.28:0.3":"Ekasuttaṃ","sn37.28:1.1":"“Ekena ca kho, bhikkhave, balena samannāgato puriso mātugāmaṃ abhibhuyya vattati.","sn37.28:1.2":"Katamena ekena balena?","sn37.28:1.3":"Issariyabalena abhibhūtaṃ mātugāmaṃ neva rūpabalaṃ tāyati, na bhogabalaṃ tāyati, na ñātibalaṃ tāyati, na puttabalaṃ tāyati, na sīlabalaṃ tāyatī”ti.","sn37.28:1.4":"Catutthaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":661,"to":664,"paras":[{"para":661,"vripara":"305-313","refs":["sn37.28:1"],"lines":["305-313. <b>Pasayhā</b>ti abhibhavitvā.","<b>Abhibhuyya vattatī</b>ti abhibhavati ajjhottharati.","<b>Neva rūpabalaṃ tāyatī</b>ti neva rūpabalaṃ tāyituṃ rakkhituṃ sakkoti.","<b>Nāsenteva naṃ, kule na vāsentī</b>ti “dussīlā saṃbhinnācārā atikkantamariyādā”ti gīvāyaṃ gahetvā nīharanti, na tasmiṃ kule vāsenti.","<b>Vāsenteva naṃ kule, na nāsentī</b>ti “kiṃ rūpena bhogādīhi vā, parisuddhasīlā esā ācārasampannā”ti ñatvā ñātakā tasmiṃ kule vāsentiyeva, na nāsenti.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn37.28:1"],["sn37.28:1"],["sn37.28:1"],["sn37.28:1"],["sn37.28:1"],["sn37.28:1"]]},{"para":662,"vripara":null,"refs":["sn37.28:1"],"lines":["Mātugāmasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn37.28:1"]]},{"para":663,"vripara":null,"refs":["sn37.28:1"],"lines":["Jambukhādakasaṃyuttaṃ"],"lineRefs":[["sn37.28:1"]]},{"para":664,"vripara":null,"refs":["sn37.28:1"],"lines":["Nibbānapañhāsuttavaṇṇanā"],"lineRefs":[["sn37.28:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":569,"to":573,"paras":[{"para":569,"vripara":"305-313","refs":["sn37.28:1"],"lines":["305-313. <b>Abhibhavitvā</b> sabbaṃ antojanaṃ sāmikañca.","<b>Nāsentī</b>ti nāsanaṃ adassanaṃ nenti nīharantīti attho."],"lineRefs":[["sn37.28:1"],["sn37.28:1"]]},{"para":570,"vripara":null,"refs":["sn37.28:1"],"lines":["Pasayhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn37.28:1"]]},{"para":571,"vripara":null,"refs":["sn37.28:1"],"lines":["Mātugāmasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn37.28:1"]]},{"para":572,"vripara":null,"refs":["sn37.28:1"],"lines":["Jambukhādakasaṃyuttaṃ"],"lineRefs":[["sn37.28:1"]]},{"para":573,"vripara":null,"refs":["sn37.28:1"],"lines":["Nibbānapañhasuttavaṇṇanā"],"lineRefs":[["sn37.28:1"]]}],"wordLinks":[]},"tika2":null}
