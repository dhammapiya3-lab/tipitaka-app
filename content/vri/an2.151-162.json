{"suttaId":"an2.151-162","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-ii","vriCode":"s0402m1.mul","paras":[260,272],"vripara":"152"},"segments":{"an2.151:0.2":"(14) 4. Santhāravaggo","an2.151:1.1":"“Dveme, bhikkhave, santhārā [sandhārā (ka.)].","an2.151:1.2":"Katame dve?","an2.151:1.3":"Āmisasanthāro ca dhammasanthāro ca.","an2.151:1.4":"Ime kho, bhikkhave, dve santhārā.","an2.151:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ santhārānaṃ yadidaṃ dhammasanthāro”ti.","an2.152:1.1":"“Dveme, bhikkhave, paṭisanthārā [paṭisandhārā (ka.)].","an2.152:1.2":"Katame dve?","an2.152:1.3":"Āmisapaṭisanthāro ca dhammapaṭisanthāro ca.","an2.152:1.4":"Ime kho, bhikkhave, dve paṭisanthārā.","an2.152:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ paṭisanthārānaṃ yadidaṃ dhammapaṭisanthāro”ti.","an2.153:1.1":"“Dvemā, bhikkhave, esanā.","an2.153:1.2":"Katamā dve?","an2.153:1.3":"Āmisesanā ca dhammesanā ca.","an2.153:1.4":"Imā kho, bhikkhave, dve esanā.","an2.153:1.5":"Etadaggaṃ, bhikkhave, imāsaṃ dvinnaṃ esanānaṃ yadidaṃ dhammesanā”ti.","an2.154:1.1":"“Dvemā, bhikkhave, pariyesanā.","an2.154:1.2":"Katamā dve?","an2.154:1.3":"Āmisapariyesanā ca dhammapariyesanā ca.","an2.154:1.4":"Imā kho, bhikkhave, dve pariyesanā.","an2.154:1.5":"Etadaggaṃ, bhikkhave, imāsaṃ dvinnaṃ pariyesanānaṃ yadidaṃ dhammapariyesanā”ti.","an2.155:1.1":"“Dvemā, bhikkhave, pariyeṭṭhiyo.","an2.155:1.2":"Katamā dve?","an2.155:1.3":"Āmisapariyeṭṭhi ca dhammapariyeṭṭhi ca.","an2.155:1.4":"Imā kho, bhikkhave, dve pariyeṭṭhiyo.","an2.155:1.5":"Etadaggaṃ, bhikkhave, imāsaṃ dvinnaṃ pariyeṭṭhīnaṃ yadidaṃ dhammapariyeṭṭhī”ti.","an2.156:1.1":"“Dvemā, bhikkhave, pūjā.","an2.156:1.2":"Katamā dve?","an2.156:1.3":"Āmisapūjā ca dhammapūjā ca.","an2.156:1.4":"Imā kho bhikkhave, dve pūjā.","an2.156:1.5":"Etadaggaṃ, bhikkhave, imāsaṃ dvinnaṃ pūjānaṃ yadidaṃ dhammapūjā”ti.","an2.157:1.1":"“Dvemāni, bhikkhave, ātitheyyāni.","an2.157:1.2":"Katamāni dve?","an2.157:1.3":"Āmisātitheyyañca dhammātitheyyañca.","an2.157:1.4":"Imāni kho, bhikkhave, dve ātitheyyāni.","an2.157:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ ātitheyyānaṃ yadidaṃ dhammātitheyyan”ti.","an2.158:1.1":"“Dvemā, bhikkhave, iddhiyo.","an2.158:1.2":"Katamā dve?","an2.158:1.3":"Āmisiddhi ca dhammiddhi ca.","an2.158:1.4":"Imā kho, bhikkhave, dve iddhiyo.","an2.158:1.5":"Etadaggaṃ, bhikkhave, imāsaṃ dvinnaṃ iddhīnaṃ yadidaṃ dhammiddhī”ti.","an2.159:1.1":"“Dvemā, bhikkhave, vuddhiyo.","an2.159:1.2":"Katamā dve?","an2.159:1.3":"Āmisavuddhi ca dhammavuddhi ca.","an2.159:1.4":"Imā kho, bhikkhave, dve vuddhiyo.","an2.159:1.5":"Etadaggaṃ, bhikkhave, imāsaṃ dvinnaṃ vuddhīnaṃ yadidaṃ dhammavuddhī”ti.","an2.160:1.1":"“Dvemāni, bhikkhave, ratanāni.","an2.160:1.2":"Katamāni dve?","an2.160:1.3":"Āmisaratanañca dhammaratanañca.","an2.160:1.4":"Imāni kho, bhikkhave, dve ratanāni.","an2.160:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ ratanānaṃ yadidaṃ dhammaratanan”ti.","an2.161:1.1":"“Dveme, bhikkhave, sannicayā.","an2.161:1.2":"Katame dve?","an2.161:1.3":"Āmisasannicayo ca dhammasannicayo ca.","an2.161:1.4":"Ime kho, bhikkhave, dve sannicayā.","an2.161:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sannicayānaṃ yadidaṃ dhammasannicayo”ti.","an2.162:1.1":"“Dvemāni, bhikkhave, vepullāni.","an2.162:1.2":"Katamāni dve?","an2.162:1.3":"Āmisavepullañca dhammavepullañca.","an2.162:1.4":"Imāni kho, bhikkhave, dve vepullāni.","an2.162:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ vepullānaṃ yadidaṃ dhammavepullan”ti.","an2.162:1.6":"Santhāravaggo catuttho."},"unsure":[],"attha":{"book":"Mp-ii","bookName":"Dukanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":274,"to":284,"paras":[{"para":274,"vripara":"152","refs":["an2.151"],"lines":["Catutthassa paṭhame catūhi paccayehi attano ca parassa ca antarapaṭicchādanavasena santharaṇaṃ <b>āmisasanthāro,</b> dhammena santharaṇaṃ <b>dhammasanthāro</b>.","Dutiye upasaggamattaṃ viseso."],"lineRefs":[["an2.151"],["an2.151"]]},{"para":275,"vripara":"154","refs":["an2.153"],"lines":["Tatiye vuttappakārassa āmisassa esanā <b>āmisesanā,</b> dhammassa esanā <b>dhammesanā</b>.","Catutthe upasaggamattameva viseso."],"lineRefs":[["an2.153"],["an2.153"]]},{"para":276,"vripara":"156","refs":["an2.155"],"lines":["Pañcame matthakappattā āmisapariyesanā <b>āmisapariyeṭṭhi,</b> matthakappattāva dhammapariyesanā <b>dhammapariyeṭṭhī</b>ti vuttā."],"lineRefs":[["an2.155"]]},{"para":277,"vripara":"157","refs":["an2.156"],"lines":["Chaṭṭhe āmisena pūjanaṃ <b>āmisapūjā,</b> dhammena pūjanaṃ <b>dhammapūjā</b>."],"lineRefs":[["an2.156"]]},{"para":278,"vripara":"158","refs":["an2.157"],"lines":["Sattame <b>ātitheyyānī</b>ti āgantukadānāni.","Atitheyyānītipi pāṭho."],"lineRefs":[["an2.157"],["an2.157"]]},{"para":279,"vripara":"159","refs":["an2.158"],"lines":["Aṭṭhame āmisaṃ ijjhanakasamijjhanakavasena <b>āmisiddhi,</b> dhammopi ijjhanakasamijjhanakavasena <b>dhammiddhi</b>."],"lineRefs":[["an2.158"]]},{"para":280,"vripara":"160","refs":["an2.159"],"lines":["Navame āmisena vaḍḍhanaṃ <b>āmisavuddhi,</b> dhammena vaḍḍhanaṃ <b>dhammavuddhi</b>."],"lineRefs":[["an2.159"]]},{"para":281,"vripara":"161","refs":["an2.160"],"lines":["Dasame ratikaraṇaṭṭhena āmisaṃ <b>āmisaratanaṃ,</b> dhammo <b>dhammaratanaṃ</b>."],"lineRefs":[["an2.160"]]},{"para":283,"vripara":"162","refs":["an2.161"],"lines":["Ekādasame āmisassa cinanaṃ vaḍḍhanaṃ <b>āmisasannicayo,</b> dhammassa cinanaṃ vaḍḍhanaṃ <b>dhammasannicayo</b>."],"lineRefs":[["an2.161"]]},{"para":284,"vripara":"163","refs":["an2.162"],"lines":["Dvādasame āmisassa vipulabhāvo <b>āmisavepullaṃ,</b> dhammassa vipulabhāvo <b>dhammavepullan</b>ti."],"lineRefs":[["an2.162"]]}],"wordLinks":[["an2.151:1.3","dhammasanthāro",0,0],["an2.151:1.3","āmisasanthāro",0,0],["an2.151:1.5","dhammasanthāro",0,0],["an2.153:1.3","dhammesanā",1,0],["an2.153:1.3","āmisesanā",1,0],["an2.153:1.5","dhammesanā",1,0],["an2.155:1.3","dhammapariyeṭṭhī",2,0],["an2.155:1.3","āmisapariyeṭṭhi",2,0],["an2.155:1.5","dhammapariyeṭṭhī",2,0],["an2.156:1.3","dhammapūjā",3,0],["an2.156:1.3","āmisapūjā",3,0],["an2.156:1.5","dhammapūjā",3,0],["an2.157:1.1","ātitheyyānī",4,0],["an2.157:1.4","ātitheyyānī",4,0],["an2.157:1.5","ātitheyyānī",4,0],["an2.158:1.3","dhammiddhi",5,0],["an2.158:1.3","āmisiddhi",5,0],["an2.158:1.5","dhammiddhi",5,0],["an2.159:1.3","dhammavuddhi",6,0],["an2.159:1.3","āmisavuddhi",6,0],["an2.159:1.5","dhammavuddhi",6,0],["an2.160:1.3","dhammaratanaṃ",7,0],["an2.160:1.3","āmisaratanaṃ",7,0],["an2.160:1.5","dhammaratanaṃ",7,0],["an2.161:1.3","dhammasannicayo",8,0],["an2.161:1.3","āmisasannicayo",8,0],["an2.161:1.5","dhammasannicayo",8,0],["an2.162:1.3","dhammavepullaṃ",9,0],["an2.162:1.3","āmisavepullaṃ",9,0],["an2.162:1.5","dhammavepullaṃ",9,0]],"before":[{"para":272,"vripara":null,"refs":[],"lines":["Dānavaggo tatiyo."],"lineRefs":[[]]},{"para":273,"vripara":null,"refs":[],"lines":["(14)4. Santhāravaggavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-ii","bookName":"Dukanipāta-ṭīkā","vriCode":"s0402t.tik","from":252,"to":252,"paras":[{"para":252,"vripara":"152","refs":["an2.151"],"lines":["Catutthassa paṭhame āmisassa ca dhammassa ca alābhena attano parassa ca antare sambhavantassa chiddassa vivarassa bhedassa santharaṇaṃ pidahanaṃ saṅgaṇhanaṃ santhāro.","Ayañhi lokasannivāso alabbhamānena āmisena dhammena cāti dvīhi chiddo.","Tassa taṃ chiddaṃ yathā na paññāyati, evaṃ pīṭhassa viya paccattharaṇena āmisena dhammena ca santharaṇaṃ saṅgaṇhanaṃ santhāroti vuccati.","Ettha ca āmisena saṅgaho <b>āmisasanthāro</b> nāma.","Taṃ karontena mātāpitūnaṃ bhikkhugatikassa veyyāvaccakarassa rañño corānañca aggaṃ aggahetvāpi dātuṃ vaṭṭati.","Āmasitvā dinnehi rājāno ca corā ca anatthampi karonti, jīvitakkhayampi pāpenti.","Anāmasitvā dinnena attamanā honti, coranāgavatthuādīni cettha vatthūni kathetabbāni.","Tāni samantapāsādikāya <b>vinayaṭṭhakathāyaṃ</b> (pārā.185) vitthāritāni.","Sakkaccaṃ uddesadānaṃ pāḷivaṇṇanā dhammakathākathananti evaṃ dhammena saṅgaho <b>dhammasanthāro</b> nāma."],"lineRefs":[["an2.151"],["an2.151"],["an2.151"],["an2.151"],["an2.151"],["an2.151"],["an2.151"],["an2.151"],["an2.151"]]}],"wordLinks":[["an2.151:1.3","āmisasanthāro",0,3],["an2.151:1.3","dhammasanthāro",0,8],["an2.151:1.5","dhammasanthāro",0,8]],"before":[{"para":249,"vripara":"143-151","refs":[],"lines":["143-151. Dutiyādīni ca suviññeyyāneva."],"lineRefs":[[]]},{"para":250,"vripara":null,"refs":[],"lines":["Dānavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":251,"vripara":null,"refs":[],"lines":["(14)4. Santhāravaggavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
