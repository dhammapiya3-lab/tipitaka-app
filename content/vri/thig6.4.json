{"suttaId":"thig6.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[569,587],"vripara":"145"},"segments":{"thig6.4:0.3":"Sujātātherīgāthā","thig6.4:1.1":"“Alaṅkatā suvasanā,","thig6.4:1.2":"mālinī candanokkhitā;","thig6.4:1.3":"Sabbābharaṇasañchannā,","thig6.4:1.4":"dāsīgaṇapurakkhatā. 146.","thig6.4:2.1":"“Annaṃ pānañca ādāya,","thig6.4:2.2":"khajjaṃ bhojjaṃ anappakaṃ;","thig6.4:2.3":"Gehato nikkhamitvāna,","thig6.4:2.4":"uyyānamabhihārayiṃ. 147.","thig6.4:3.1":"“Tattha ramitvā kīḷitvā,","thig6.4:3.2":"āgacchantī sakaṃ gharaṃ;","thig6.4:3.3":"Vihāraṃ daṭṭhuṃ pāvisiṃ,","thig6.4:3.4":"sākete añjanaṃ vanaṃ. 148.","thig6.4:4.1":"“Disvāna lokapajjotaṃ,","thig6.4:4.2":"vanditvāna upāvisiṃ;","thig6.4:4.3":"So me dhammamadesesi,","thig6.4:4.4":"anukampāya cakkhumā. 149.","thig6.4:5.1":"“Sutvā ca kho mahesissa,","thig6.4:5.2":"saccaṃ sampaṭivijjhahaṃ;","thig6.4:5.3":"Tattheva virajaṃ dhammaṃ,","thig6.4:5.4":"phusayiṃ amataṃ padaṃ. 150.","thig6.4:6.1":"“Tato viññātasaddhammā,","thig6.4:6.2":"pabbajiṃ anagāriyaṃ;","thig6.4:6.3":"Tisso vijjā anuppattā,","thig6.4:6.4":"amoghaṃ buddhasāsana”nti. …","thig6.4:7.1":"Sujātā therī…. 5."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":2110,"to":2136,"paras":[{"para":2110,"vripara":"145","refs":["thig6.4:1"],"lines":["“Alaṅkatā suvasanā, mālinī candanokkhitā;"],"lineRefs":[["thig6.4:1"]]},{"para":2111,"vripara":null,"refs":["thig6.4:1"],"lines":["Sabbābharaṇasañchannā, dāsīgaṇapurakkhatā. 146."],"lineRefs":[["thig6.4:1"]]},{"para":2113,"vripara":"146","refs":["thig6.4:2"],"lines":["“Annaṃ pānañca ādāya, khajjaṃ bhojjaṃ anappakaṃ;"],"lineRefs":[["thig6.4:2"]]},{"para":2114,"vripara":null,"refs":["thig6.4:2"],"lines":["Gehato nikkhamitvāna, uyyānamabhihārayiṃ. 147."],"lineRefs":[["thig6.4:2"]]},{"para":2116,"vripara":"147","refs":["thig6.4:3"],"lines":["“Tattha ramitvā kīḷitvā, āgacchantī sakaṃ gharaṃ;"],"lineRefs":[["thig6.4:3"]]},{"para":2117,"vripara":null,"refs":["thig6.4:3"],"lines":["Vihāraṃ daṭṭhuṃ pāvisiṃ, sākete añjanaṃ vanaṃ. 148."],"lineRefs":[["thig6.4:3"]]},{"para":2119,"vripara":"148","refs":["thig6.4:4"],"lines":["“Disvāna lokapajjotaṃ, vanditvāna upāvisiṃ;"],"lineRefs":[["thig6.4:4"]]},{"para":2120,"vripara":null,"refs":["thig6.4:4"],"lines":["So me dhammamadesesi, anukampāya cakkhumā. 149."],"lineRefs":[["thig6.4:4"]]},{"para":2122,"vripara":"149","refs":["thig6.4:5"],"lines":["“Sutvā ca kho mahesissa, saccaṃ sampaṭivijjhahaṃ;"],"lineRefs":[["thig6.4:5"]]},{"para":2123,"vripara":null,"refs":["thig6.4:5"],"lines":["Tattheva virajaṃ dhammaṃ, phusayiṃ amataṃ padaṃ. 150."],"lineRefs":[["thig6.4:5"]]},{"para":2125,"vripara":"150","refs":["thig6.4:6"],"lines":["“Tato viññātasaddhammā, pabbajiṃ anagāriyaṃ;"],"lineRefs":[["thig6.4:6"]]},{"para":2126,"vripara":null,"refs":["thig6.4:6"],"lines":["Tisso vijjā anuppattā, amoghaṃ buddhasāsana”nti. –"],"lineRefs":[["thig6.4:6"]]},{"para":2127,"vripara":null,"refs":["thig6.4:6"],"lines":["Imā gāthā abhāsi."],"lineRefs":[["thig6.4:6"]]},{"para":2128,"vripara":null,"refs":["thig6.4:6"],"lines":["Tattha <b>alaṅkatā</b>ti vibhūsitā.","Taṃ pana alaṅkatākāraṃ dassetuṃ <b>“suvasanā mālinī candanokkhitā”</b>ti vuttaṃ.","Tattha <b>mālinī</b>ti mālādhārinī.","<b>Candanokkhitā</b>ti candanānulittā.","<b>Sabbābharaṇasañchannā</b>ti hatthūpagādīhi sabbehi ābharaṇehi alaṅkāravasena sañchāditasarīrā."],"lineRefs":[["thig6.4:6"],["thig6.4:6"],["thig6.4:6"],["thig6.4:6"],["thig6.4:6"]]},{"para":2129,"vripara":null,"refs":["thig6.4:6"],"lines":["<b>Annaṃ</b> <b>pānañca ādāya, khajjaṃ bhojjaṃ anappaka</b>nti sāliodanādiannaṃ, ambapānādipānaṃ, piṭṭhakhādanīyādikhajjaṃ, avasiṭṭhaṃ āhārasaṅkhātaṃ bhojjañca pahūtaṃ gahetvā.","<b>Uyyānamabhihārayi</b>nti nakkhattakīḷāvasena uyyānaṃ upanesiṃ.","Annapānādiṃ tattha ānetvā saha parijanena kīḷantī ramantī paricāresinti adhippāyo."],"lineRefs":[["thig6.4:6"],["thig6.4:6"],["thig6.4:6"]]},{"para":2130,"vripara":null,"refs":["thig6.4:6"],"lines":["<b>Sākete añjanaṃ vana</b>nti sāketasamīpe añjanavane vihāraṃ pāvisiṃ."],"lineRefs":[["thig6.4:6"]]},{"para":2131,"vripara":null,"refs":["thig6.4:6"],"lines":["<b>Lokapajjota</b>nti ñāṇapajjotena lokassa pajjotabhūtaṃ."],"lineRefs":[["thig6.4:6"]]},{"para":2132,"vripara":null,"refs":["thig6.4:6"],"lines":["<b>Phusayi</b>nti phusiṃ, adhigacchinti attho.","Sesaṃ vuttanayameva."],"lineRefs":[["thig6.4:6"],["thig6.4:6"]]},{"para":2133,"vripara":null,"refs":["thig6.4:6"],"lines":["Sujātātherīgāthāvaṇṇanā niṭṭhitā. 5."],"lineRefs":[["thig6.4:6"]]},{"para":2134,"vripara":null,"refs":["thig6.4:6"],"lines":["Anopamātherīgāthāvaṇṇanā"],"lineRefs":[["thig6.4:6"]]},{"para":2135,"vripara":null,"refs":["thig6.4:6"],"lines":["<b>Ucce kule</b>tiādikā anopamāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī anukkamena vimuttiparipācanīye dhamme paribrūhitvā imasmiṃ buddhuppāde sāketanagare majjhassa nāma seṭṭhino dhītā hutvā nibbatti.","Tassā rūpasampattiyā <b>anopamā</b>ti nāmaṃ ahosi.","Tassā vayappattakāle bahū seṭṭhiputtā rājamahāmattā rājāno ca pitu dūtaṃ pāhesuṃ –","“attano dhītaraṃ anopamaṃ dehi, idañcidañca te dassāmā”ti.","Sā taṃ sutvā upanissayasampannatāya “gharāvāsena mayhaṃ attho natthī”ti satthu santikaṃ gantvā dhammaṃ sutvā ñāṇassa paripākaṃ gatattā desanānusārena vipassanaṃ ārabhitvā taṃ ussukkāpentī maggapaṭipāṭiyā tatiyaphale patiṭṭhāsi.","Sā satthāraṃ pabbajjaṃ yācitvā satthuāṇāya bhikkhunupassayaṃ upagantvā bhikkhunīnaṃ santike pabbajitvā sattame divase arahattaṃ sacchikatvā attano paṭipattiṃ paccavekkhitvā udānavasena – 151."],"lineRefs":[["thig6.4:6"],["thig6.4:6"],["thig6.4:6"],["thig6.4:6"],["thig6.4:6"],["thig6.4:6"],["thig6.4:6"]]}],"wordLinks":[]},"tika":null,"tika2":null}
