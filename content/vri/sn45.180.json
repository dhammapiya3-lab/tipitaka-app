{"suttaId":"sn45.180","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[400,414],"vripara":"181"},"segments":{"sn45.180:0.3":"Uddhambhāgiyasuttaṃ","sn45.180:1.1":"“Pañcimāni, bhikkhave, uddhambhāgiyāni saṃyojanāni.","sn45.180:1.2":"Katamāni pañca?","sn45.180:1.3":"Rūparāgo, arūparāgo, māno, uddhaccaṃ, avijjā –","sn45.180:1.4":"imāni kho, bhikkhave, pañcuddhambhāgiyāni saṃyojanāni.","sn45.180:1.5":"Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya ariyo aṭṭhaṅgiko maggo bhāvetabbo.","sn45.180:1.6":"Katamo ariyo aṭṭhaṅgiko maggo?","sn45.180:1.7":"Idha, bhikkhave, bhikkhu sammādiṭṭhiṃ bhāveti vivekanissitaṃ … pe … sammāsamādhiṃ bhāveti vivekanissitaṃ virāganissitaṃ nirodhanissitaṃ vossaggapariṇāmiṃ.","sn45.180:1.8":"Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.180:2.1":"“Pañcimāni, bhikkhave, uddhambhāgiyāni saṃyojanāni.","sn45.180:2.2":"Katamāni pañca?","sn45.180:2.3":"Rūparāgo, arūparāgo, māno, uddhaccaṃ, avijjā –","sn45.180:2.4":"imāni kho, bhikkhave, pañcuddhambhāgiyāni saṃyojanāni.","sn45.180:2.5":"Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya ariyo aṭṭhaṅgiko maggo bhāvetabbo.","sn45.180:2.6":"Katamo ariyo aṭṭhaṅgiko maggo?","sn45.180:2.7":"Idha, bhikkhave, bhikkhu sammādiṭṭhiṃ bhāveti … pe … sammāsamādhiṃ bhāveti rāgavinayapariyosānaṃ dosavinayapariyosānaṃ mohavinayapariyosānaṃ …","sn45.180:2.8":"amatogadhaṃ amataparāyanaṃ amatapariyosānaṃ …","sn45.180:2.9":"nibbānaninnaṃ nibbānapoṇaṃ nibbānapabbhāraṃ.","sn45.180:2.10":"Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.180:2.11":"Dasamaṃ.","sn45.180:2.12":"Oghavaggo aṭṭhamo.","sn45.180:3.0":"Tassuddānaṃ –","sn45.180:3.1":"Ogho yogo upādānaṃ,","sn45.180:3.2":"ganthaṃ anusayena ca;","sn45.180:3.3":"Kāmaguṇā nīvaraṇaṃ,","sn45.180:3.4":"khandhā oruddhambhāgiyāti.","sn45.180:4.0":"Vagguddānaṃ –","sn45.180:4.1":"Avijjāvaggo paṭhamo,","sn45.180:4.2":"dutiyaṃ vihāraṃ vuccati;","sn45.180:4.3":"Micchattaṃ tatiyo vaggo,","sn45.180:4.4":"catutthaṃ paṭipanneneva.","sn45.180:5.1":"Titthiyaṃ pañcamo vaggo,","sn45.180:5.2":"chaṭṭho sūriyena ca;","sn45.180:5.3":"Bahukate sattamo vaggo,","sn45.180:5.4":"uppādo aṭṭhamena ca.","sn45.180:6.1":"Divasavaggo navamo,","sn45.180:6.2":"dasamo appamādena ca;","sn45.180:6.3":"Ekādasabalavaggo,","sn45.180:6.4":"dvādasa esanā pāḷiyaṃ;","sn45.180:6.5":"Oghavaggo bhavati terasāti.","sn45.180:6.6":"Maggasaṃyuttaṃ paṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":122,"to":127,"paras":[{"para":122,"vripara":"176-181","refs":["sn45.180:1"],"lines":["176-181. <b>Kāmarāgānusayo</b>ti thāmagataṭṭhena kāmarāgova anusayo kāmarāgānusayo.","Sesesupi eseva nayo.","<b>Orambhāgiyānī</b>ti heṭṭhākoṭṭhāsiyāni.","<b>Saṃyojanānī</b>ti bandhanāni.","<b>Uddhambhāgiyānī</b>ti uparikoṭṭhāsiyāni.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn45.180:1"],["sn45.180:1"],["sn45.180:1"],["sn45.180:1"],["sn45.180:1"],["sn45.180:1"]]},{"para":123,"vripara":null,"refs":["sn45.180:1"],"lines":["Oghavaggo ekādasamo."],"lineRefs":[["sn45.180:1"]]},{"para":124,"vripara":null,"refs":["sn45.180:1"],"lines":["Maggasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn45.180:1"]]},{"para":125,"vripara":null,"refs":["sn45.180:1"],"lines":["Bojjhaṅgasaṃyuttaṃ"],"lineRefs":[["sn45.180:1"]]},{"para":126,"vripara":null,"refs":["sn45.180:1"],"lines":["Pabbatavaggo"],"lineRefs":[["sn45.180:1"]]},{"para":127,"vripara":null,"refs":["sn45.180:1"],"lines":["Himavantasuttavaṇṇanā"],"lineRefs":[["sn45.180:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":123,"to":129,"paras":[{"para":123,"vripara":"176-181","refs":["sn45.180:1"],"lines":["176-181. <b>Thāmagataṭṭhenā</b>ti sattasantāne thirabhāvūpagamanabhāvena.","<b>Thāmagatan</b>ti ca aññehi asādhāraṇo kāmarāgādīnaṃyeva āveṇiko sabhāvo daṭṭhabbo.","<b>Kāmarāgovā</b>ti kāmarāgo eva appahīno.","So sati paccayalābhe uppajjanārahatāya santāne anusetīti <b>anusayo.</b>","<b>Sesesupī</b>ti paṭighānusayādīsu.","Orambhāgo vuccati kāmadhātu rūpārūpabhāvato heṭṭhābhūtattā.","Tattha pavattiyā paccayabhāvato <b>orambhāgiyāni</b> yathā “pacchiyo goduhako”ti.","Saṃyojentīti <b>saṃyojanāni,</b> heṭṭhā viya attho vattabbo.","<b>Uddhambhāgo</b> mahaggatabhāgo, tassa hitānīti sabbaṃ heṭṭhā vuttanayattā na vuttanti adhippāyo."],"lineRefs":[["sn45.180:1"],["sn45.180:1"],["sn45.180:1"],["sn45.180:1"],["sn45.180:1"],["sn45.180:1"],["sn45.180:1"],["sn45.180:1"],["sn45.180:1"]]},{"para":124,"vripara":null,"refs":["sn45.180:1"],"lines":["Anusayasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn45.180:1"]]},{"para":125,"vripara":null,"refs":["sn45.180:1"],"lines":["Oghavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn45.180:1"]]},{"para":126,"vripara":null,"refs":["sn45.180:1"],"lines":["Maggasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn45.180:1"]]},{"para":127,"vripara":null,"refs":["sn45.180:1"],"lines":["Bojjhaṅgasaṃyuttaṃ"],"lineRefs":[["sn45.180:1"]]},{"para":128,"vripara":null,"refs":["sn45.180:1"],"lines":["Pabbatavaggo"],"lineRefs":[["sn45.180:1"]]},{"para":129,"vripara":null,"refs":["sn45.180:1"],"lines":["Himavantasuttavaṇṇanā"],"lineRefs":[["sn45.180:1"]]}],"wordLinks":[]},"tika2":null}
