{"suttaId":"sn48.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1154,1154],"vripara":"471"},"segments":{"sn48.1:0.3":"Suddhikasuttaṃ","sn48.1:1.1":"Sāvatthinidānaṃ.","sn48.1:1.3":"“Pañcimāni, bhikkhave, indriyāni.","sn48.1:1.4":"Katamāni pañca?","sn48.1:1.5":"Saddhindriyaṃ, vīriyindriyaṃ, satindriyaṃ, samādhindriyaṃ, paññindriyaṃ – imāni kho, bhikkhave, pañcindriyānī”ti.","sn48.1:1.7":"Paṭhamaṃ."},"attha":null,"tika":null}
