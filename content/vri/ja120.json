{"suttaId":"ja120","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[671,678],"vripara":"120"},"segments":{"ja120:0.4":"Bandhanamokkhajātakaṃ","ja120:1.1":"Abaddhā tattha bajjhanti,","ja120:1.2":"yattha bālā pabhāsare;","ja120:1.3":"Baddhāpi tattha muccanti,","ja120:1.4":"yattha dhīrā pabhāsareti.","ja120:2.1":"Bandhanamokkhajātakaṃ dasamaṃ.","ja120:2.2":"Haṃcivaggo [haṃsivaggo (sī. syā.)] dvādasamo.","ja120:3.1":"Tassuddānaṃ –","ja120:4.1":"Atha gadrabha sattuva kaṃsasataṃ,","ja120:4.2":"bahucinti sāsikāyātikara;","ja120:4.3":"Ativela visesamanācariyova,","ja120:4.4":"dhīrāpabhāsaratena dasāti."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2707,"to":2707,"paras":[{"para":2707,"vripara":null,"refs":["ja120:1"],"lines":["Tattha <b>abaddhā</b>ti abandhitabbayuttā.","<b>Pabhāsare</b>ti pabhāsanti vadanti kathenti."],"lineRefs":[["ja120:1"],["ja120:1"]]}],"wordLinks":[["ja120:1.1","abaddhā",0,0],["ja120:1.1","pabhāsare",0,1],["ja120:1.3","pabhāsare",0,1]],"after":[{"para":2708,"vripara":null,"title":"[120] 10. Bandhanamokkhajātakavaṇṇanā","lines":["Evaṃ mahāsatto imāya gāthāya rañño dhammaṃ desetvā “mayā imaṃ dukkhaṃ agāre vasanabhāvena laddhaṃ, idāni me agārena kiccaṃ natthi, pabbajjaṃ me anujāna, devā”ti pabbajjaṃ anujānāpetvā assumukhaṃ ñātijanaṃ mahantañca vibhavaṃ pahāya isipabbajjaṃ pabbajitvā himavante vasanto abhiññā ca samāpattiyo ca nibbattetvā brahmalokaparāyaṇo ahosi."]},{"para":2709,"vripara":null,"title":"[120] 10. Bandhanamokkhajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā duṭṭhadevī ciñcamāṇavikā ahosi, rājā ānando, purohito pana ahameva ahosin”ti."]},{"para":2710,"vripara":null,"title":"[120] 10. Bandhanamokkhajātakavaṇṇanā","lines":["Bandhanamokkhajātakavaṇṇanā dasamā."]},{"para":2711,"vripara":null,"title":"[120] 10. Bandhanamokkhajātakavaṇṇanā","lines":["Haṃcivaggo dvādasamo."]},{"para":2712,"vripara":null,"title":"[120] 10. Bandhanamokkhajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":2713,"vripara":null,"title":"[120] 10. Bandhanamokkhajātakavaṇṇanā","lines":["Gadrabhapañhā amarā, siṅgālaṃ mitacinti ca;"]},{"para":2714,"vripara":null,"title":"[120] 10. Bandhanamokkhajātakavaṇṇanā","lines":["Anusāsikadubbacaṃ, tittiraṃ vaṭṭakaṃ puna;"]},{"para":2715,"vripara":null,"title":"[120] 10. Bandhanamokkhajātakavaṇṇanā","lines":["Akālarāvi bandhananti."]}]},"tika":null,"tika2":null}
