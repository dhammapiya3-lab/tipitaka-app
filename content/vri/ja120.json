{"suttaId":"ja120","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[671,678],"vripara":"120"},"segments":{"ja120:0.4":"Bandhanamokkhajātakaṃ","ja120:1.1":"Abaddhā tattha bajjhanti, yattha bālā pabhāsare;","ja120:1.3":"Baddhāpi tattha muccanti, yattha dhīrā pabhāsareti.","ja120:2.1":"Bandhanamokkhajātakaṃ dasamaṃ.","ja120:2.2":"Haṃcivaggo [haṃsivaggo (sī. syā.)] dvādasamo.","ja120:3.1":"Tassuddānaṃ –","ja120:4.1":"Atha gadrabha sattuva kaṃsasataṃ, bahucinti sāsikāyātikara;","ja120:4.3":"Ativela visesamanācariyova, dhīrāpabhāsaratena dasāti."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2707,"to":2707,"paras":[{"para":2707,"vripara":null,"refs":["ja120:1"],"lines":["Tattha <b>abaddhā</b>ti abandhitabbayuttā.","<b>Pabhāsare</b>ti pabhāsanti vadanti kathenti."],"lineRefs":[["ja120:1"],["ja120:1"]]}],"wordLinks":[["ja120:1.1","abaddhā",0,0],["ja120:1.1","pabhāsare",0,1],["ja120:1.3","pabhāsare",0,1]]},"tika":null}
