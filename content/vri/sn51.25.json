{"suttaId":"sn51.25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1692,1692],"vripara":"837"},"segments":{"sn51.25:0.3":"Paṭhamaphalasuttaṃ","sn51.25:1.1":"“Cattārome, bhikkhave, iddhipādā.","sn51.25:1.2":"Katame cattāro?","sn51.25:1.3":"Idha, bhikkhave, bhikkhu chandasamādhippadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti, vīriyasamādhi … pe … cittasamādhi … pe … vīmaṃsāsamādhippadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti – ime kho, bhikkhave, cattāro iddhipādā.","sn51.25:1.8":"Imesaṃ kho, bhikkhave, catunnaṃ iddhipādānaṃ bhāvitattā bahulīkatattā bhikkhunā dvinnaṃ phalānaṃ aññataraṃ phalaṃ pāṭikaṅkhaṃ – diṭṭheva dhamme aññā, sati vā upādisese anāgāmitā”ti.","sn51.25:1.10":"Pañcamaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":692,"to":693,"paras":[{"para":692,"vripara":"835-842","refs":["sn51.25:1"],"lines":["835-842. Tatiye vivaṭṭapādakiddhi kathitā, tathā catutthe.","Apica dve phalāni ādiṃ katvā heṭṭhā missakiddhipādā kathitā, sattasu phalesu pubbabhāgā.","Sattamādīni cattāri heṭṭhā kathitanayāneva."],"lineRefs":[["sn51.25:1"],["sn51.25:1"],["sn51.25:1"]]},{"para":693,"vripara":null,"refs":["sn51.25:1"],"lines":["11-12. Moggallānasuttādivaṇṇanā"],"lineRefs":[["sn51.25:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":600,"to":605,"paras":[{"para":600,"vripara":"835-842","refs":["sn51.25:1"],"lines":["835-842. “Dvinnaṃ phalānan”ti āgatasuttaṃ sandhāya <b>“dve phalāni ādiṃ katvā”</b>ti vuttaṃ.","Sesaṃ suviññeyyameva."],"lineRefs":[["sn51.25:1"],["sn51.25:1"]]},{"para":601,"vripara":null,"refs":["sn51.25:1"],"lines":["Ayoguḷavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn51.25:1"]]},{"para":602,"vripara":null,"refs":["sn51.25:1"],"lines":["Iddhipādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn51.25:1"]]},{"para":603,"vripara":null,"refs":["sn51.25:1"],"lines":["Anuruddhasaṃyuttaṃ"],"lineRefs":[["sn51.25:1"]]},{"para":604,