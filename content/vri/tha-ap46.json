{"suttaId":"tha-ap46","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[3700,3721],"vripara":"70"},"segments":{"tha-ap46:0.3":"Sanniṭṭhāpakattheraapadānaṃ","tha-ap46:1.1":"“Araññe kuṭikaṃ katvā,","tha-ap46:1.2":"vasāmi pabbatantare;","tha-ap46:1.3":"Lābhālābhena santuṭṭho,","tha-ap46:1.4":"yasena ayasena ca.","tha-ap46:2.1":"“Padumuttaro lokavidū,","tha-ap46:2.2":"āhutīnaṃ paṭiggaho;","tha-ap46:2.3":"Vasīsatasahassehi [bhikkhusatasahassehi (syā.)],","tha-ap46:2.4":"āgacchi mama santikaṃ.","tha-ap46:3.1":"“Upāgataṃ mahānāgaṃ [mahāvīraṃ (sī.)],","tha-ap46:3.2":"jalajuttamanāmakaṃ;","tha-ap46:3.3":"Tiṇasantharaṃ [tiṇattharaṃ (ka.)] paññāpetvā,","tha-ap46:3.4":"adāsiṃ satthuno ahaṃ.","tha-ap46:4.1":"“Pasannacitto sumano,","tha-ap46:4.2":"āmaṇḍaṃ pānīyañcahaṃ;","tha-ap46:4.3":"Adāsiṃ ujubhūtassa,","tha-ap46:4.4":"vippasannena cetasā.","tha-ap46:5.1":"“Satasahassito kappe [satasahasse ito kappe (sī.)],","tha-ap46:5.2":"yaṃ dānamadadiṃ tadā;","tha-ap46:5.3":"Duggatiṃ nābhijānāmi,","tha-ap46:5.4":"āmaṇḍassa idaṃ phalaṃ.","tha-ap46:6.1":"“Ekatālīsakappamhi,","tha-ap46:6.2":"eko āsiṃ arindamo;","tha-ap46:6.3":"Sattaratanasampanno,","tha-ap46:6.4":"cakkavattī mahabbalo.","tha-ap46:7.1":"“Paṭisambhidā catasso … pe …","tha-ap46:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap46:8.1":"Itthaṃ sudaṃ āyasmā sanniṭṭhāpako [sannidhāpako (sī.)] thero imā gāthāyo abhāsitthāti.","tha-ap46:9.1":"Sanniṭṭhāpakattherassāpadānaṃ catutthaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2508,"to":2509,"paras":[{"para":2508,"vripara":"70","refs":["tha-ap46:1"],"lines":["Arahā pana hutvā attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>araññe kuṭikaṃ katvā</b>tiādimāha.","Tattha <b>araññe</b>ti sīhabyagghādīnaṃ bhayena manussā ettha na rajjanti na ramanti na allīyantīti araññaṃ, tasmiṃ araññe.","<b>Kuṭikan</b>ti tiṇacchadanakuṭikaṃ katvā pabbatantare <b>vasāmi</b> vāsaṃ kappesinti attho.","Lābhena ca alābhena ca yasena ca ayasena ca santuṭṭho vihāsinti sambandho."],"lineRefs":[["tha-ap46:1"],["tha-ap46:1"],["tha-ap46:1"],["tha-ap46:1"]]},{"para":2509,"vripara":"72","refs":["tha-ap46:3"],"lines":["<b>Jalajuttamanāmakan</b>ti jale jātaṃ jalajaṃ, padumaṃ, jalajaṃ uttamaṃ jalajuttamaṃ, jalajuttamena samānaṃ nāmaṃ yassa so jalajuttamanāmako, taṃ jalajuttamanāmakaṃ buddhanti attho.","Sesaṃ pāḷinayānuyogena suviññeyyamevāti."],"lineRefs":[["tha-ap46:3"],["tha-ap46:3"]]}],"wordLinks":[["tha-ap46:1.1","araññe kuṭikaṃ katvā",0,0],["tha-ap46:1.1","araññe",0,1],["tha-ap46:1.1","kuṭikaṃ",0,2],["tha-ap46:1.1","vasāmi",0,2],["tha-ap46:3.1","jalajuttamanāmakaṃ",1,0]]},"tika":null,"tika2":null}
