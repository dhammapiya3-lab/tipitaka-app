{"suttaId":"tha-ap404","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[12984,13029],"vripara":"29"},"segments":{"tha-ap404:0.3":"Puṇṇakattheraapadānaṃ","tha-ap404:1.1":"“Pabbhārakūṭaṃ nissāya,","tha-ap404:1.2":"sayambhū aparājito;","tha-ap404:1.3":"Ābādhiko ca so [ābādhiko garu (sī.)] buddho,","tha-ap404:1.4":"vasati pabbatantare.","tha-ap404:2.1":"“Mama assamasāmantā,","tha-ap404:2.2":"panādo āsi tāvade;","tha-ap404:2.3":"Buddhe nibbāyamānamhi,","tha-ap404:2.4":"āloko udapajjatha [āsi tāvade (syā. ka.)].","tha-ap404:3.1":"“Yāvatā vanasaṇḍasmiṃ,","tha-ap404:3.2":"acchakokataracchakā;","tha-ap404:3.3":"Vāḷā ca [byagghā (sī.)] kesarī sabbe,","tha-ap404:3.4":"abhigajjiṃsu tāvade.","tha-ap404:4.1":"“Uppātaṃ tamahaṃ disvā,","tha-ap404:4.2":"pabbhāraṃ agamāsahaṃ;","tha-ap404:4.3":"Tatthaddassāsiṃ sambuddhaṃ,","tha-ap404:4.4":"nibbutaṃ aparājitaṃ.","tha-ap404:5.1":"“Suphullaṃ sālarājaṃva,","tha-ap404:5.2":"sataraṃsiṃva uggataṃ;","tha-ap404:5.3":"Vītaccikaṃva aṅgāraṃ,","tha-ap404:5.4":"nibbutaṃ aparājitaṃ.","tha-ap404:6.1":"“Tiṇaṃ kaṭṭhañca pūretvā,","tha-ap404:6.2":"citakaṃ tatthakāsahaṃ;","tha-ap404:6.3":"Citakaṃ sukataṃ katvā,","tha-ap404:6.4":"sarīraṃ jhāpayiṃ ahaṃ.","tha-ap404:7.1":"“Sarīraṃ jhāpayitvāna,","tha-ap404:7.2":"gandhatoyaṃ samokiriṃ;","tha-ap404:7.3":"Antalikkhe ṭhito yakkho,","tha-ap404:7.4":"nāmamaggahi tāvade.","tha-ap404:8.1":"“Yaṃ pūritaṃ [taṃ pūritaṃ (syā.), sappurisa (ka.)] tayā kiccaṃ,","tha-ap404:8.2":"sayambhussa mahesino;","tha-ap404:8.3":"Puṇṇako nāma nāmena,","tha-ap404:8.4":"sadā hohi tuvaṃ [yadā hosi tuvaṃ (syā.), sadā hohiti tvaṃ (ka.)] mune.","tha-ap404:9.1":"“Tamhā kāyā cavitvāna,","tha-ap404:9.2":"devalokaṃ agacchahaṃ;","tha-ap404:9.3":"Tattha dibbamayo gandho,","tha-ap404:9.4":"antalikkhā pavassati [antalikkhe pavāyati (sī.)].","tha-ap404:10.1":"“Tatrāpi nāmadheyyaṃ me,","tha-ap404:10.2":"puṇṇakoti ahū tadā;","tha-ap404:10.3":"Devabhūto manusso vā,","tha-ap404:10.4":"saṅkappaṃ pūrayāmahaṃ.","tha-ap404:11.1":"“Idaṃ pacchimakaṃ mayhaṃ,","tha-ap404:11.2":"carimo vattate bhavo;","tha-ap404:11.3":"Idhāpi puṇṇako nāma,","tha-ap404:11.4":"nāmadheyyaṃ pakāsati.","tha-ap404:12.1":"“Tosayitvāna sambuddhaṃ,","tha-ap404:12.2":"gotamaṃ sakyapuṅgavaṃ;","tha-ap404:12.3":"Sabbāsave pariññāya,","tha-ap404:12.4":"viharāmi anāsavo.","tha-ap404:13.1":"“Ekanavutito kappe,","tha-ap404:13.2":"yaṃ kammamakariṃ tadā;","tha-ap404:13.3":"Duggatiṃ nābhijānāmi,","tha-ap404:13.4":"tanukiccassidaṃ phalaṃ.","tha-ap404:14.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap404:14.3":"viharāmi anāsavo.","tha-ap404:15.1":"“Svāgataṃ vata me āsi … pe …","tha-ap404:15.3":"kataṃ buddhassa sāsanaṃ.","tha-ap404:16.1":"“Paṭisambhidā catasso … pe …","tha-ap404:16.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap404:17.1":"Itthaṃ sudaṃ āyasmā puṇṇako thero imā gāthāyo abhāsitthāti.","tha-ap404:18.1":"Puṇṇakattherassāpadānaṃ dutiyaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3320,"to":3320,"paras":[{"para":3320,"vripara":"29","refs":["tha-ap404:1"],"lines":["Dutiyāpadāne <b>pabbhārakūṭaṃ nissāyā</b>tiādikaṃ āyasmato puṇṇakattherassa apadānaṃ.","Tattha himavante yakkhasenāpati hutvā parinibbutassa paccekabuddhassa āḷahanakaraṇameva nānattaṃ.","Sesaṃ pāṭhānusārena suviññeyyameva."],"lineRefs":[["tha-ap404:1"],["tha-ap404:1"],["tha-ap404:1"]]}],"wordLinks":[["tha-ap404:1.1","pabbhārakūṭaṃ nissāyā",0,0]],"before":[{"para":3319,"vripara":null,"refs":[],"lines":["Puṇṇakattheraapadānavaṇṇanā"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
