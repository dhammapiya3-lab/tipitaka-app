{"suttaId":"ja350","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[3043,3064],"vripara":"197"},"segments":{"ja350:0.4":"Devatāpañhajātakaṃ (4-5-10)","ja350:1.1":"Hanti hatthehi pādehi, mukhañca parisumbhati;","ja350:1.3":"Sa ve rāja piyo hoti, kaṃ tena tvābhipassasi [mabhipassasi (sī.)].","ja350:2.1":"Akkosati yathākāmaṃ, āgamañcassa icchati;","ja350:2.3":"Sa ve rāja piyo hoti, kaṃ tena tvābhipassasi.","ja350:3.1":"Abbhakkhāti abhūtena, alikenābhisāraye;","ja350:3.3":"Sa ve rāja piyo hoti, kaṃ tena tvābhipassasi.","ja350:4.1":"Haraṃ annañca pānañca, vatthasenāsanāni ca;","ja350:4.3":"Aññadatthuharā santā, te ve rāja piyā honti;","ja350:4.5":"Kaṃ tena tvābhipassasīti.","ja350:5.1":"Devatāpañhajātakaṃ dasamaṃ.","ja350:5.2":"Cūḷakuṇālavaggo pañcamo.","ja350:6.1":"Tassuddānaṃ –","ja350:7.1":"Narānaṃ asakkhivasimhavaro, nīliyamaggivarañca puna;","ja350:7.3":"Puna rasāyasakūṭavaro, tathārañña sārathi hanti dasāti.","ja350:8.1":"Atha vagguddānaṃ –","ja350:9.1":"Kāliṅgaṃ [vivaraṃ (bahūsu)] pucimandañca, kuṭidūsaka kokilā [kuṭidūsaṃ bahubhāṇakaṃ (bahūsu)];","ja350:9.3":"Cūḷakuṇālavaggo so, pañcamo suppakāsitoti.","ja350:10.1":"Catukkanipātaṃ niṭṭhitaṃ."},"attha":null,"tika":null}
