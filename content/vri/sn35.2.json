{"suttaId":"sn35.2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[10,10],"vripara":"2"},"segments":{"sn35.2:0.3":"Ajjhattadukkhasuttaṃ","sn35.2:1.1":"“Cakkhuṃ, bhikkhave, dukkhaṃ.","sn35.2:1.2":"Yaṃ dukkhaṃ tadanattā;","sn35.2:1.3":"yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.2:1.4":"Sotaṃ dukkhaṃ … pe …","sn35.2:1.5":"ghānaṃ dukkhaṃ …","sn35.2:1.6":"jivhā dukkhā …","sn35.2:1.7":"kāyo dukkho …","sn35.2:1.8":"mano dukkho.","sn35.2:1.9":"Yaṃ dukkhaṃ tadanattā;","sn35.2:1.10":"yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.2:1.11":"Evaṃ passaṃ … pe …","sn35.2:1.12":"nāparaṃ itthattāyāti pajānātī”ti.","sn35.2:1.13":"Dutiyaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":11,"to":12,"paras":[{"para":11,"vripara":"2-3","refs":["sn35.2:1"],"lines":["2-3. Dutiyaṃ dve lakkhaṇāni, tatiyaṃ ekalakkhaṇaṃ dassetvā kathite bujjhanakānaṃ ajjhāsayena vuttaṃ.","Sesāni pana tehi sallakkhitāni vā ettakeneva vā sallakkhessantīti."],"lineRefs":[["sn35.2:1"],["sn35.2:1"]]},{"para":12,"vripara":null,"refs":["sn35.2:1"],"lines":["4-6. Bāhirāniccasuttādivaṇṇanā"],"lineRefs":[["sn35.2:1"]]}],"wordLinks":[],"before":[{"para":10,"vripara":null,"title":"Ajjhattadukkhasuttādivaṇṇanā","lines":["2-3. Ajjhattadukkhasuttādivaṇṇanā"]}]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":12,"to":14,"paras":[{"para":12,"vripara":"2-3","refs":["sn35.2:1"],"lines":["2-3. <b>Dve lakkhaṇānī</b>ti dukkhānattalakkhaṇāni.","<b>Ekaṃ lakkhaṇan</b>ti anattalakkhaṇaṃ.","<b>Sesānī</b>ti vuttāvasesāni lakkhaṇāni.","<b>Tehī</b>ti yehi dutiyatatiyāni suttāni desitāni, tehi.","<b>Sallakkhitānī</b>ti sammadeva upadhāritāni.","<b>Ettakenā</b>ti dvinnaṃ ekasseva vā lakkhaṇassa kathanena."],"lineRefs":[["sn35.2:1"],["sn35.2:1"],["sn35.2:1"],["sn35.2:1"],["sn35.2:1"],["sn35.2:1"]]},{"para":13,"vripara":null,"refs":["sn35.2:1"],"lines":["Ajjhattadukkhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.2:1"]]},{"para":14,"vripara":null,"refs":["sn35.2:1"],"lines":["4-6. Bāhirāniccasuttādivaṇṇanā"],"lineRefs":[["sn35.2:1"]]}],"wordLinks":[],"before":[{"para":11,"vripara":null,"title":"Ajjhattadukkhasuttādivaṇṇanā","lines":["2-3. Ajjhattadukkhasuttādivaṇṇanā"]}]},"tika2":null}
