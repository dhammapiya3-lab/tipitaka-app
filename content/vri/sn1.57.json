{"suttaId":"sn1.57","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[696,700],"vripara":"57"},"segments":{"sn1.57:0.3":"Tatiyajanasuttaṃ","sn1.57:1.1":"“Kiṃsu janeti purisaṃ, kiṃsu tassa vidhāvati;","sn1.57:1.3":"Kiṃsu saṃsāramāpādi, kiṃsu tassa parāyanan”ti.","sn1.57:2.1":"“Taṇhā janeti purisaṃ, cittamassa vidhāvati;","sn1.57:2.3":"Satto saṃsāramāpādi, kammaṃ tassa parāyanan”ti."},"attha":null,"tika":null}
