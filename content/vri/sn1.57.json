{"suttaId":"sn1.57","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[696,700],"vripara":"57"},"segments":{"sn1.57:0.3":"Tatiyajanasuttaṃ","sn1.57:1.1":"“Kiṃsu janeti purisaṃ, kiṃsu tassa vidhāvati;","sn1.57:1.3":"Kiṃsu saṃsāramāpādi, kiṃsu tassa parāyanan”ti.","sn1.57:2.1":"“Taṇhā janeti purisaṃ, cittamassa vidhāvati;","sn1.57:2.3":"Satto saṃsāramāpādi, kammaṃ tassa parāyanan”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":448,"to":449,"paras":[{"para":448,"vripara":"57","refs":["sn1.57:1"],"lines":["Sattame <b>parāyaṇan</b>ti nipphatti avassayo.","Sattamaṃ."],"lineRefs":[["sn1.57:1"],["sn1.57:1"]]},{"para":449,"vripara":null,"refs":["sn1.57:1"],"lines":["Uppathasuttavaṇṇanā"],"lineRefs":[["sn1.57:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":546,"to":548,"paras":[{"para":546,"vripara":"57","refs":["sn1.57:1"],"lines":["<b>Nipphattī</b>ti iṭṭhāniṭṭhavipākānaṃ nipphajjanato nipphatti.","Tato eva <b>avassayo,</b> nipphattitavipākassa avassayo adhiṭṭhānaṃ kāraṇanti attho."],"lineRefs":[["sn1.57:1"],["sn1.57:1"]]},{"para":547,"vripara":null,"refs":["sn1.57:1"],"lines":["Tatiyajanasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn1.57:1"]]},{"para":548,"vripara":null,"refs":["sn1.57:1"],"lines":["Uppathasuttavaṇṇanā"],"lineRefs":[["sn1.57:1"]]}],"wordLinks":[]},"tika2":null}
