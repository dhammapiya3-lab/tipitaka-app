{"suttaId":"sn22.112","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[738,742],"vripara":"112"},"segments":{"sn22.112:0.3":"Dutiyachandappahānasuttaṃ","sn22.112:1.1":"Sāvatthinidānaṃ.","sn22.112:1.2":"“Rūpe, bhikkhave, yo chando yo rāgo yā nandī yā taṇhā ye upayupādānā cetaso adhiṭṭhānābhinivesānusayā, te pajahatha.","sn22.112:1.3":"Evaṃ taṃ rūpaṃ pahīnaṃ bhavissati ucchinnamūlaṃ … pe …","sn22.112:1.4":"vedanāya …","sn22.112:1.5":"saññāya …","sn22.112:1.6":"saṅkhāresu yo chando … pe …","sn22.112:1.7":"evaṃ te saṅkhārā pahīnā bhavissanti ucchinnamūlā tālāvatthukatā anabhāvaṃkatā āyatiṃ anuppādadhammā.","sn22.112:1.8":"Viññāṇe yo chando yo rāgo yā nandī yā taṇhā ye upayupādānā cetaso adhiṭṭhānābhinivesānusayā, te pajahatha.","sn22.112:1.9":"Evaṃ taṃ viññāṇaṃ pahīnaṃ bhavissati ucchinnamūlaṃ tālāvatthukataṃ anabhāvaṃkataṃ āyatiṃ anuppādadhamman”ti.","sn22.112:1.10":"Dasamaṃ.","sn22.112:1.11":"Antavaggo ekādasamo.","sn22.112:2.0":"Tassuddānaṃ –","sn22.112:2.1":"Anto dukkhañca sakkāyo,","sn22.112:2.2":"pariññeyyā samaṇā duve;","sn22.112:2.3":"Sotāpanno arahā ca,","sn22.112:2.4":"duve ca chandappahānāti."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":367,"to":370,"paras":[{"para":367,"vripara":"107-112","refs":["sn22.112:1"],"lines":["107-112. Pañcamādīsu catūsu cattāri saccāni kathitāni.","Navamadasamesu kilesappahānanti.","Pañcamādīni."],"lineRefs":[["sn22.112:1"],["sn22.112:1"],["sn22.112:1"]]},{"para":368,"vripara":null,"refs":["sn22.112:1"],"lines":["Antavaggo ekādasamo."],"lineRefs":[["sn22.112:1"]]},{"para":369,"vripara":null,"refs":["sn22.112:1"],"lines":["Dhammakathikavaggo"],"lineRefs":[["sn22.112:1"]]},{"para":370,"vripara":null,"refs":["sn22.112:1"],"lines":["1-2. Avijjāsuttādivaṇṇanā"],"lineRefs":[["sn22.112:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":359,"to":364,"paras":[{"para":359,"vripara":"107-112","refs":["sn22.112:1"],"lines":["107-112. <b>Cattāri saccāni kathitāni</b> assādādīnaṃ samudayādīnañca desitattā."],"lineRefs":[["sn22.112:1"]]},{"para":360,"vripara":null,"refs":["sn22.112:1"],"lines":["<b>Kilesappahānaṃ kathitaṃ</b> rāgappahānassa jotitattā."],"lineRefs":[["sn22.112:1"]]},{"para":361,"vripara":null,"refs":["sn22.112:1"],"lines":["Samaṇasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.112:1"]]},{"para":362,"vripara":null,"refs":["sn22.112:1"],"lines":["Antavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.112:1"]]},{"para":363,"vripara":null,"refs":["sn22.112:1"],"lines":["Dhammakathikavaggo"],"lineRefs":[["sn22.112:1"]]},{"para":364,"vripara":null,"refs":["sn22.112:1"],"lines":["1-2. Avijjāsuttādivaṇṇanā"],"lineRefs":[["sn22.112:1"]]}],"wordLinks":[]},"tika2":null}
