{"suttaId":"thig5.2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[314,329],"vripara":"72"},"segments":{"thig5.2:0.3":"Vimalātherīgāthā","thig5.2:1.1":"“Mattā vaṇṇena rūpena, sobhaggena yasena ca;","thig5.2:1.3":"Yobbanena cupatthaddhā, aññāsamatimaññihaṃ.","thig5.2:2.1":"“Vibhūsetvā imaṃ kāyaṃ, sucittaṃ bālalāpanaṃ;","thig5.2:2.3":"Aṭṭhāsiṃ vesidvāramhi, luddo pāsamivoḍḍiya.","thig5.2:3.1":"“Pilandhanaṃ vidaṃsentī, guyhaṃ pakāsikaṃ bahuṃ;","thig5.2:3.3":"Akāsiṃ vividhaṃ māyaṃ, ujjagghantī bahuṃ janaṃ.","thig5.2:4.1":"“Sājja piṇḍaṃ caritvāna, muṇḍā saṅghāṭipārutā;","thig5.2:4.3":"Nisinnā rukkhamūlamhi, avitakkassa lābhinī.","thig5.2:5.1":"“Sabbe yogā samucchinnā, ye dibbā ye ca mānusā;","thig5.2:5.3":"Khepetvā āsave sabbe, sītibhūtāmhi nibbutā”ti.","thig5.2:6.1":"… Vimalā purāṇagaṇikā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1154,"to":1154,"paras":[{"para":1154,"vripara":null,"refs":["thig5.2:5"],"lines":["<b>Sabbe yogā</b>ti kāmayogādayo cattāropi yogā.","<b>Samucchinnā</b>ti paṭhamamaggādinā yathārahaṃ sammadeva ucchinnā pahīnā.","Sesaṃ vuttanayameva."],"lineRefs":[["thig5.2:5"],["thig5.2:5"],["thig5.2:5"]]}],"wordLinks":[["thig5.2:5.1","sabbe yogā",0,0],["thig5.2:5.1","samucchinnā",0,1]]},"tika":null,"tika2":null}
