{"suttaId":"tha-ap364","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10617,10625],"vripara":"5"},"segments":{"tha-ap364:0.3":"Kakkārupupphiyattheraapadānaṃ","tha-ap364:1.1":"“Yāmā devā idhāgantvā,","tha-ap364:1.2":"gotamaṃ sirivacchasaṃ;","tha-ap364:1.3":"Kakkārumālaṃ [gokkhanumālaṃ (sī.)] paggayha,","tha-ap364:1.4":"buddhassa abhiropayiṃ.","tha-ap364:2.1":"“Dvenavute ito kappe,","tha-ap364:2.2":"yaṃ buddhamabhipūjayiṃ;","tha-ap364:2.3":"Duggatiṃ nābhijānāmi,","tha-ap364:2.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap364:3.1":"“Paṭisambhidā catasso … pe …","tha-ap364:3.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap364:4.1":"Itthaṃ sudaṃ āyasmā kakkārupupphiyo [gokkhanupupphiyo (ka.)] thero imā gāthāyo abhāsitthāti.","tha-ap364:5.1":"Kakkārupupphiyattherassāpadānaṃ dutiyaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
