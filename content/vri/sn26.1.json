{"suttaId":"sn26.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1166,1166],"vripara":"312"},"segments":{"sn26.1:0.3":"Cakkhusuttaṃ","sn26.1:1.1":"Sāvatthinidānaṃ.","sn26.1:1.2":"“Yo kho, bhikkhave, cakkhussa uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo.","sn26.1:1.3":"Yo sotassa uppādo ṭhiti…pe…","sn26.1:1.4":"yo ghānassa uppādo ṭhiti…","sn26.1:1.5":"yo jivhāya uppādo ṭhiti…","sn26.1:1.6":"yo kāyassa uppādo ṭhiti…","sn26.1:1.7":"yo manassa uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo.","sn26.1:1.8":"Yo ca, bhikkhave, cakkhussa nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo.","sn26.1:1.9":"Yo sotassa nirodho…pe…","sn26.1:1.10":"yo ghānassa nirodho…","sn26.1:1.11":"yo jivhāya nirodho…","sn26.1:1.12":"yo kāyassa nirodho…","sn26.1:1.13":"yo manassa nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo”ti.","sn26.1:1.14":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":452,"to":454,"paras":[{"para":452,"vripara":"312-321","refs":["sn26.1:1"],"lines":["Uppādasaṃyutte sabbaṃ pākaṭameva."],"lineRefs":[["sn26.1:1"]]},{"para":453,"vripara":null,"refs":["sn26.1:1"],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā. 6."],"lineRefs":[["sn26.1:1"]]},{"para":454,"vripara":null,"refs":["sn26.1:1"],"lines":["Kilesasaṃyuttavaṇṇanā 322-331."],"lineRefs":[["sn26.1:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":476,"to":478,"paras":[{"para":476,"vripara":"312-321","refs":["sn26.1:1"],"lines":["<b>Sabbaṃ</b> <b>pākaṭameva</b> apubbassa abhāvato."],"lineRefs":[["sn26.1:1"]]},{"para":477,"vripara":null,"refs":["sn26.1:1"],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā. 6."],"lineRefs":[["sn26.1:1"]]},{"para":478,"vripara"