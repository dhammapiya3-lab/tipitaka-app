{"suttaId":"tha-ap255","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8280,8292],"vripara":"9"},"segments":{"tha-ap255:0.3":"Citakapūjakattheraapadānaṃ","tha-ap255:1.1":"“Ānando nāma sambuddho, sayambhū aparājito;","tha-ap255:1.3":"Araññe parinibbāyi, amanussamhi kānane.","tha-ap255:2.1":"“Devalokā idhāgantvā, citaṃ katvānahaṃ tadā;","tha-ap255:2.3":"Sarīraṃ tattha jhāpesiṃ, sakkārañca akāsahaṃ.","tha-ap255:3.1":"“Ekanavutito kappe, yaṃ kammamakariṃ tadā;","tha-ap255:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap255:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap255:5.1":"Itthaṃ sudaṃ āyasmā citakapūjako thero imā gāthāyo abhāsitthāti.","tha-ap255:6.1":"Citakapūjakattherassāpadānaṃ tatiyaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3212,"to":3212,"paras":[{"para":3212,"vripara":"9-10","refs":["tha-ap255:1"],"lines":["9-10. Tatiyāpadāne <b>ānando nāma sambuddho</b>ti ānandaṃ tuṭṭhiṃ jananato ānando nāma paccekabuddhoti attho.","<b>Amanussamhi kānane</b>ti amanussapariggahe kānane mahāaraññe <b>parinibbāyi</b> anupādisesanibbānadhātuyā antaradhāyi, adassanaṃ agamāsīti attho.","<b>Sarīraṃ tattha jhāpesin</b>ti ahaṃ devalokā idhāgantvā tassa bhagavato sarīraṃ tattha araññe jhāpesiṃ dahanaṃ akāsinti attho."],"lineRefs":[["tha-ap255:1"],["tha-ap255:1"],["tha-ap255:1"]]}],"wordLinks":[["tha-ap255:1.1","ānando nāma sambuddho",0,0],["tha-ap255:1.3","amanussamhi kānane",0,1],["tha-ap255:1.3","parinibbāyi",0,1]]},"tika":null,"tika2":null}
