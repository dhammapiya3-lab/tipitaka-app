{"suttaId":"ja168","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1004,1010],"vripara":"35"},"segments":{"ja168:0.4":"Sakuṇagghijātakaṃ (2-2-8)","ja168:1.1":"Seno balasā patamāno, lāpaṃ gocaraṭhāyinaṃ;","ja168:1.3":"Sahasā ajjhappattova, maraṇaṃ tenupāgami.","ja168:2.1":"Sohaṃ nayena sampanno, pettike gocare rato;","ja168:2.3":"Apetasattu modāmi, sampassaṃ atthamattanoti.","ja168:3.1":"Sakuṇagghijātakaṃ aṭṭhamaṃ."},"attha":null,"tika":null}
