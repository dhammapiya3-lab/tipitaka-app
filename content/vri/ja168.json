{"suttaId":"ja168","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1004,1010],"vripara":"35"},"segments":{"ja168:0.4":"Sakuṇagghijātakaṃ (2-2-8)","ja168:1.1":"Seno balasā patamāno, lāpaṃ gocaraṭhāyinaṃ;","ja168:1.3":"Sahasā ajjhappattova, maraṇaṃ tenupāgami.","ja168:2.1":"Sohaṃ nayena sampanno, pettike gocare rato;","ja168:2.3":"Apetasattu modāmi, sampassaṃ atthamattanoti.","ja168:3.1":"Sakuṇagghijātakaṃ aṭṭhamaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":331,"to":336,"paras":[{"para":331,"vripara":null,"refs":["ja168:1"],"lines":["Tattha <b>balasā patamāno</b>ti “lāpaṃ gaṇhissāmī”ti balena thāmena patamāno.","<b>Gocaraṭhāyinan</b>ti sakavisayā nikkhamitvā gocaratthāya aṭavipariyante ṭhitaṃ.","<b>Ajjhappatto</b>ti sampatto.","<b>Maraṇaṃ tenupāgamī</b>ti tena kāraṇena maraṇaṃ patto."],"lineRefs":[["ja168:1"],["ja168:1"],["ja168:1"],["ja168:1"]]},{"para":332,"vripara":null,"refs":[],"lines":["Tasmiṃ pana maraṇaṃ patte lāpo nikkhamitvā “diṭṭhā vata me paccāmittassa piṭṭhī”ti tassa hadaye ṭhatvā udānaṃ udānento dutiyaṃ gāthamāha –"],"lineRefs":[[]]},{"para":334,"vripara":"36","refs":[],"lines":["“Sohaṃ nayena sampanno, pettike gocare rato;"],"lineRefs":[[]]},{"para":335,"vripara":null,"refs":[],"lines":["Apetasattu modāmi, sampassaṃ atthamattano”ti."],"lineRefs":[[]]},{"para":336,"vripara":null,"refs":["ja168:2"],"lines":["Tattha <b>nayenā</b>ti upāyena.","<b>Atthamattano</b>ti attano arogabhāvasaṅkhātaṃ vuḍḍhiṃ."],"lineRefs":[["ja168:2"],["ja168:2"]]}],"wordLinks":[["ja168:1.1","balasā patamāno",0,0],["ja168:1.1","gocaraṭhāyinaṃ",0,1],["ja168:1.3","ajjhappatto",0,2],["ja168:1.3","maraṇaṃ tenupāgamī",0,3],["ja168:2.1","nayenā",4,0],["ja168:2.3","atthamattano",4,1]]},"tika":null,"tika2":null}
