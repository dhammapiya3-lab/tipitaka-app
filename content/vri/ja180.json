{"suttaId":"ja180","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1107,1117],"vripara":"59"},"segments":{"ja180:0.4":"Duddadajātakaṃ (2-3-10)","ja180:1.1":"Duddadaṃ dadamānānaṃ,","ja180:1.2":"dukkaraṃ kamma kubbataṃ;","ja180:1.3":"Asanto nānukubbanti,","ja180:1.4":"sataṃ dhammo durannayo. 60.","ja180:2.1":"Tasmā satañca asataṃ,","ja180:2.2":"nānā hoti ito gati;","ja180:2.3":"Asanto nirayaṃ yanti,","ja180:2.4":"santo saggaparāyaṇāti [parāyanā (syā. ka.)].","ja180:3.1":"Duddadajātakaṃ dasamaṃ.","ja180:3.2":"Kalyāṇavaggo tatiyo.","ja180:4.1":"Tassuddānaṃ –","ja180:5.1":"Susamaññamigādhibhū māṇavako,","ja180:5.2":"vāripahūtarūpādiccupaṭṭhānā;","ja180:5.3":"Sakaḷāyasatindukapaṅka puna,","ja180:5.4":"satadhamma sududdadakena dasāti. 4."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":519,"to":519,"paras":[{"para":519,"vripara":null,"refs":["ja180:2","ja180:3"],"lines":["Tattha <b>duddada</b>nti dānaṃ nāma lobhadosavasikehi apaṇḍitehi dātuṃ na sakkā, tasmā “duddada”nti vuccati.","Taṃ dadamānānaṃ.","<b>Dukkaraṃ kamma kubbata</b>nti tadeva dānakammaṃ sabbehi kātuṃ na sakkāti dukkaraṃ.","Taṃ kurumānānaṃ.","<b>Asanto</b>ti apaṇḍitā bālā.","<b>Nānukubbantī</b>ti taṃ kammaṃ nānukaronti.","<b>Sataṃ dhammo</b>ti paṇḍitānaṃ sabhāvo.","Dānaṃ sandhāyetaṃ vuttaṃ.","<b>Durannayo</b>ti phalasambandhavasena dujjāno, evarūpassa dānassa evarūpo phalavipāko hotīti duranubodho.","Apica <b>durannayo</b>ti duradhigamo, apaṇḍitehi dānaṃ datvā dānaphalaṃ nāma laddhuṃ na sakkātipi attho.","<b>Nānā hoti ito gatī</b>ti ito cavitvā paralokaṃ gacchantānaṃ paṭisandhiggahaṇaṃ nānā hoti.","<b>Asanto nirayaṃ yantī</b>ti apaṇḍitā dussīlā dānaṃ adatvā sīlaṃ arakkhitvā nirayaṃ gacchanti.","<b>Santo saggaparāyaṇā</b>ti paṇḍitā pana dānaṃ datvā sīlaṃ rakkhitvā uposathakammaṃ karitvā tīṇi sucaritāni pūretvā saggaparāyaṇā honti, mahantaṃ saggasukhasampattiṃ anubhavantīti."],"lineRefs":[["ja180:3"],["ja180:3"],["ja180:3"],["ja180:3"],["ja180:2"],["ja180:2"],["ja180:2"],["ja180:2"],["ja180:2"],["ja180:2"],["ja180:2"],["ja180:2"],["ja180:2"]]}],"wordLinks":[["ja180:3.1","duddadaṃ",0,0],["ja180:2.3","asanto",0,4],["ja180:2.1","nānā hoti ito gatī",0,10],["ja180:2.3","asanto nirayaṃ yantī",0,11],["ja180:2.3","santo saggaparāyaṇā",0,12]],"after":[{"para":520,"vripara":null,"title":"[180] 10. Duddadajātakavaṇṇanā","lines":["Evaṃ bodhisatto anumodanaṃ katvā cattāro vassike māse tattheva vasitvā vassātikkame himavantaṃ gantvā jhānaṃ nibbattetvā aparihīnajjhāno brahmalokūpago ahosi."]},{"para":521,"vripara":null,"title":"[180] 10. Duddadajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā isigaṇo buddhaparisā ahosi, gaṇasatthā pana ahameva ahosi”nti."]},{"para":522,"vripara":null,"title":"[180] 10. Duddadajātakavaṇṇanā","lines":["Duddadajātakavaṇṇanā dasamā."]},{"para":523,"vripara":null,"title":"[180] 10. Duddadajātakavaṇṇanā","lines":["Kalyāṇavaggo tatiyo."]},{"para":524,"vripara":null,"title":"[180] 10. Duddadajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":525,"vripara":null,"title":"[180] 10. Duddadajātakavaṇṇanā","lines":["Kalyāṇadhammaṃ daddaraṃ, makkaṭi dubbhimakkaṭaṃ;"]},{"para":526,"vripara":null,"title":"[180] 10. Duddadajātakavaṇṇanā","lines":["Ādiccupaṭṭhānañceva, kaḷāyamuṭṭhi tindukaṃ;"]},{"para":527,"vripara":null,"title":"[180] 10. Duddadajātakavaṇṇanā","lines":["Kacchapaṃ satadhammañca, duddadanti ca te dasa. 4."]}]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":281,"to":288,"paras":[{"para":281,"vripara":null,"refs":["ja180:1"],"lines":["10-duddadajātakavaṇṇanā (180)"],"lineRefs":[["ja180:1"]]},{"para":282,"vripara":null,"refs":["ja180:1"],"lines":["<b>chandakaṃ saṅgharitvā</b>ti samānachandaṃ saṃharitvā.","samodhānaṃ katvāti attho.","<b>bahudāyakāpī</b>ti bahūni dātabbavatthūni dinnadāyakāpi.","<b>appadāyakāpī</b>ti appakaṃ dānavatthuṃ dinnadāyakāpi.","duddadantiādīsu ayaṃ yojanā.","duddadaṃ dadamānānaṃ dukkaraṃ kammaṃ kubbataṃ sataṃ dhammo durannayo.","taṃ duddadaṃ dukkaraṃ kammaṃ asanto nānukubbantīti.","<b>kubbata</b>nti ettha karotissa ka-kārassa antassa u-kārattaṃ ra-kārassa ba-kārattaṃ katvā rūpasiddhi veditabbā.","<b>nānukubba</b>nti ettha nānukarontīti attho daṭṭhabbo.","aṭṭhakathāyaṃ pana adhippāyamattameva dassetuṃ “nānukubbantīti taṃ kammaṃ nānukarontā"],"lineRefs":[["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"]]},{"para":283,"vripara":null,"refs":["ja180:1"],"lines":["footnote 1.","saṃharitvā.","ṭṭha.","77.","vi.","ṭṭha.","192."],"lineRefs":[["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"]]},{"para":284,"vripara":null,"refs":["ja180:1"],"lines":["footnote 2.","nānukaronti.","ṭṭha.","nisīdantī”ti āha.","katthaci pana potthakesu taṃ kammaṃ nānukaronto nisīdīti ekavacanantapāṭho dissati.","so ayutto.","<b>durannayo</b>ti ettha durasaddato nisaddo jānanattho.","jānituṃ durattā durannayo.","durannayabhāvo ca phalasambandhavasena imassa ettakaṃ phalaṃ, imassa ettakanti aparicchindana-vasena veditabbo.","tenāha — “durannayoti phalasambandhavasena dujjāno”ti ādi.","athavā durannayoti ettha nisaddo adhigamanattho.","tenāha — “apicā”ti ādi."],"lineRefs":[["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"]]},{"para":285,"vripara":null,"refs":["ja180:1"],"lines":["<b>apaṇḍitehi dānaṃ adatvā</b>ti apaṇḍitehi maccheramalavo-kiṇṇehi appamattakampi dānaṃ adatvā dānassa phalaṃ nāma laddhuṃ na sakkātipi attho.","potthakesu pana katthaci “dānaṃ datvā”ti pāṭho dissati.","tattha pana dānaphalaṃ nāmāti etaṃ maggaphalanibbānaṃ adhippetaṃ.","kiṃ vuttaṃ hoti.","apaṇḍitehi vaṭṭābhiratehi dānaṃ datvāpi dānaphalaṃ nāma laddhuṃ na sakkātīti.","katthaci pana “durandhayo”ti pāṭhaṃ likhanti.","saṃyuttanikāyaṭṭhakathāyaṃ pana “durannayoti duranūpagamano.","duppuroti attho”ti vuttaṃ.","<b>dānaṃ adatvā</b>ti kiñci dānaṃ adatvā.","<b>sīlaṃ arakkhitvā</b>ti pañcaṅgaaṭṭhaṅgādivasena sīlaṃ arakkhitvā.","<b>nirayaṃ gacchantī</b>ti idaṃ upalakkhaṇavasena vuttaṃ.","eteneva hi cattāro apāyā gahetabbāyeva.","<b>sīlaṃ rakkhitvā</b>ti pañcaṅgadasaṅgādi-vasena sīlaṃ rakkhitvā.","<b>saggaparāyaṇā</b>ti idampi upalakkhaṇavaseneva vuttaṃ.","eteneva hi sabbāpi saggamokkhasampatti gahetabbāyeva.","athavā puna gatiparāyaṇavasena vuttaṃ.","maggaphalanibbānānaṃ hi paṭisandhivasena puna gatiparāyaṇā nāma natthīti."],"lineRefs":[["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"]]},{"para":286,"vripara":null,"refs":["ja180:1"],"lines":["ending duddadajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja180:1"]]},{"para":287,"vripara":null,"refs":["ja180:1"],"lines":["ending kalyāṇavaggo tatiyo."],"lineRefs":[["ja180:1"]]},{"para":288,"vripara":null,"refs":["ja180:1"],"lines":["footnote 1.","saṃ.","ṭṭha.","57."],"lineRefs":[["ja180:1"],["ja180:1"],["ja180:1"],["ja180:1"]]}],"wordLinks":[]},"tika2":null}
