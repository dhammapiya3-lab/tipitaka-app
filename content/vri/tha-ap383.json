{"suttaId":"tha-ap383","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10938,10956],"vripara":"1"},"segments":{"tha-ap383:0.3":"Avaṭaphaladāyakattheraapadānaṃ","tha-ap383:1.1":"“Sataraṃsi nāma bhagavā,","tha-ap383:1.2":"sayambhū aparājito;","tha-ap383:1.3":"Vivekakāmo sambuddho,","tha-ap383:1.4":"gocarāyābhinikkhami. 2.","tha-ap383:2.1":"“Phalahattho ahaṃ disvā,","tha-ap383:2.2":"upagacchiṃ narāsabhaṃ;","tha-ap383:2.3":"Pasannacitto sumano,","tha-ap383:2.4":"avaṭaṃ [avaṇṭaṃ (sī.), ambaṭaṃ (syā.)] adadiṃ phalaṃ. 3.","tha-ap383:3.1":"“Catunnavutito kappe,","tha-ap383:3.2":"yaṃ phalamadadiṃ ahaṃ;","tha-ap383:3.3":"Duggatiṃ nābhijānāmi,","tha-ap383:3.4":"phaladānassidaṃ phalaṃ. 4.","tha-ap383:4.1":"“Kilesā jhāpitā mayhaṃ,","tha-ap383:4.2":"bhavā sabbe samūhatā;","tha-ap383:4.3":"Nāgova bandhanaṃ chetvā,","tha-ap383:4.4":"viharāmi anāsavo. 5.","tha-ap383:5.1":"“Svāgataṃ vata me āsi,","tha-ap383:5.2":"mama buddhassa santike;","tha-ap383:5.3":"Tisso vijjā anuppattā,","tha-ap383:5.4":"kataṃ buddhassa sāsanaṃ. 6.","tha-ap383:6.1":"“Paṭisambhidā catasso,","tha-ap383:6.2":"vimokkhāpi ca aṭṭhime;","tha-ap383:6.3":"Chaḷabhiññā sacchikatā,","tha-ap383:6.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap383:7.1":"Itthaṃ sudaṃ āyasmā avaṭaphaladāyako thero imā gāthāyo abhāsitthāti.","tha-ap383:8.1":"Avaṭaphaladāyakattherassāpadānaṃ paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
