{"suttaId":"sn42.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1762,1762],"vripara":"356"},"segments":{"sn42.4:0.3":"Hatthārohasuttaṃ","sn42.4:1.1":"Atha kho hatthāroho gāmaṇi yena bhagavā tenupasaṅkami; upasaṅkamitvā…pe…","sn42.4:1.2":"ajjatagge pāṇupetaṃ saraṇaṃ gatanti.","sn42.4:1.3":"Catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":739,"to":740,"paras":[{"para":739,"vripara":"355-357","refs":["sn42.4:1"],"lines":["Tatiye <b>yodhājīvo</b>ti yuddhena jīvikaṃ kappanako dhammasaṅgāhakattherehi evaṃ gahitanāmo.","<b>Ussahati vāyamatī</b>ti ussāhaṃ vāyāmaṃ karoti.","<b>Pariyāpādentī</b>ti maraṇaṃ paṭipajjāpenti.","<b>Dukkaṭa</b>nti duṭṭhu kataṃ.","<b>Duppaṇihita</b>nti duṭṭhu ṭhapitaṃ.","<b>Parajito nāma nirayo</b>ti ayampi na visuṃ eko nirayo, avīcisseva pana ekasmiṃ koṭṭhāse pañcāvudhasannaddhā phalakahatthā hatthiassarathe āruyha saṅgāme yujjhantā viya paccanti, taṃ sandhāyetaṃ vuttaṃ.","Catutthapañcamesupi eseva nayo. 6."],"lineRefs":[["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"]]},{"para":740,"vripara":null,"refs":["sn42.4:1"],"lines":["Asibandhakaputtasuttavaṇṇanā 358."],"lineRefs":[["sn42.4:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":658,"to":660,"paras":[{"para":658,"vripara":"355-357","refs":["sn42.4:1"],"lines":["Yujjhanaṃ yodho, so ājīvo etassāti <b>yodhājīvo</b>.","Tenāha –","<b>“yuddhena jīvikaṃ kappanako”</b>ti, <b>ussāhaṃ vāyāmaṃ karotī</b>ti yujjhanavasena ussāhaṃ vāyāmaṃ karoti.","<b>Pariyāpādentī</b>ti maraṇapariyantikaṃ āpadaṃ pāpenti.","Tenāha <b>“maraṇaṃ paṭipajjāpentī”</b>ti.","<b>Duṭṭhu ṭhapita</b>nti duṭṭhākārena attano paresañca atthāvahabhāvaṃ na gataṃ paṭipannaṃ.","Parehi saṅgāme jitā hatā ettha jāyantīti <b>parajito nāma nirayo</b>.","Asidhanugadāyasaṅkucakkāni <b>pañcāvudhāni.</b>","<b>Taṃ sandhāyā</b>ti taṃ yodhājīvaṃ puggalaṃ sandhāya.","<b>Etaṃ</b> “yo so”tiādi <b>vuttaṃ.</b>","<b>Catutthapañcamesū</b>ti hatthārohaassārohasuttesu.","<b>Eseva nayo</b>ti eso tatiye vutto eva atthato visesābhāvato."],"lineRefs":[["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"],["sn42.4:1"]]},{"para":659,"vripara":null,"refs":["sn42.4:1"],"lines":["Yodhājīvasuttādivaṇṇanā niṭṭhitā. 6."],"lineRefs":[["sn42.4:1"]]},{"para":660,"vripara":null,"refs":["sn42.4:1"],"lines":["Asibandhakaputtasuttavaṇṇanā 358."],"lineRefs":[["sn42.4:1"]]}],"wordLinks":[]},"tika2":null}
