{"suttaId":"snp4.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[2719,2743],"vripara":"794"},"segments":{"snp4.4:0.2":"Suddhaṭṭhakasuttaṃ","snp4.4:1.1":"Passāmi suddhaṃ paramaṃ arogaṃ,","snp4.4:1.2":"diṭṭhena saṃsuddhi narassa hoti;","snp4.4:1.3":"Evābhijānaṃ [etābhijānaṃ (sī. pī.)] paramanti ñatvā,","snp4.4:1.4":"suddhānupassīti pacceti ñāṇaṃ.","snp4.4:2.1":"Diṭṭhena ce suddhi narassa hoti,","snp4.4:2.2":"ñāṇena vā so pajahāti dukkhaṃ;","snp4.4:2.3":"Aññena so sujjhati sopadhīko,","snp4.4:2.4":"diṭṭhī hi naṃ pāva tathā vadānaṃ.","snp4.4:3.1":"Na brāhmaṇo aññato suddhimāha,","snp4.4:3.2":"diṭṭhe sute sīlavate mute vā;","snp4.4:3.3":"Puññe ca pāpe ca anūpalitto,","snp4.4:3.4":"attañjaho nayidha pakubbamāno.","snp4.4:4.1":"Purimaṃ pahāya aparaṃ sitāse,","snp4.4:4.2":"ejānugā te na taranti saṅgaṃ;","snp4.4:4.3":"Te uggahāyanti nirassajanti,","snp4.4:4.4":"kapīva sākhaṃ pamuñcaṃ gahāyaṃ [pamukhaṃ gahāya (syā.), pamuñca gahāya (ka.)].","snp4.4:5.1":"Sayaṃ samādāya vatāni jantu,","snp4.4:5.2":"uccāvacaṃ gacchati saññasatto;","snp4.4:5.3":"Vidvā ca vedehi samecca dhammaṃ,","snp4.4:5.4":"na uccāvacaṃ gacchati bhūripañño.","snp4.4:6.1":"Sa sabbadhammesu visenibhūto,","snp4.4:6.2":"yaṃ kiñci diṭṭhaṃ va sutaṃ mutaṃ vā;","snp4.4:6.3":"Tameva dassiṃ vivaṭaṃ carantaṃ,","snp4.4:6.4":"kenīdha lokasmi vikappayeyya.","snp4.4:7.1":"Na kappayanti na purekkharonti,","snp4.4:7.2":"accantasuddhīti na te vadanti;","snp4.4:7.3":"Ādānaganthaṃ gathitaṃ visajja,","snp4.4:7.4":"āsaṃ na kubbanti kuhiñci loke.","snp4.4:8.1":"Sīmātigo brāhmaṇo tassa natthi,","snp4.4:8.2":"ñatvā va disvā va [ñatvā ca disvā ca (ka. sī. ka.)] samuggahītaṃ;","snp4.4:8.3":"Na rāgarāgī na virāgaratto,","snp4.4:8.4":"tassīdha natthī paramuggahītanti.","snp4.4:8.5":"Suddhaṭṭhakasuttaṃ catutthaṃ niṭṭhitaṃ."},"unsure":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2226,"to":2226,"paras":[{"para":2226,"vripara":null,"refs":["snp4.4:2"],"lines":["Tattha paṭhamagāthāya tāvattho – na, bhikkhave, evarūpena dassanena suddhi hoti.","Apica kho kilesamalinattā asuddhaṃ, kilesarogānaṃ avigamā sarogameva candābhaṃ brāhmaṇaṃ aññaṃ vā evarūpaṃ disvā diṭṭhigatiko bālo abhijānāti <b>“passāmi suddhaṃ paramaṃ arogaṃ,</b> tena ca diṭṭhisaṅkhātena dassanena <b>saṃsuddhi narassa hotī”</b>ti, so evaṃ abhijānanto taṃ dassanaṃ <b>“paraman”ti ñatvā</b> tasmiṃ dassane <b>suddhānupassī</b> samāno taṃ dassanaṃ “maggañāṇan”ti <b>pacceti</b>.","Taṃ pana maggañāṇaṃ na hoti.","Tenāha –","<b>“diṭṭhena ce suddhī”</b>ti dutiyagāthaṃ."],"lineRefs":[["snp4.4:2"],["snp4.4:2"],["snp4.4:2"],["snp4.4:2"],["snp4.4:2"]]}],"wordLinks":[["snp4.4:2.1","diṭṭhena ce suddhī",0,4]]},"tika":null,"tika2":null}
