{"suttaId":"ja81","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[457,460],"vripara":"81"},"segments":{"ja81:0.4":"Surāpānajātakaṃ","ja81:1.1":"Apāyimha anaccimha,","ja81:1.2":"agāyimha rudimha ca;","ja81:1.3":"Visaññikaraṇiṃ pitvā [pītvā (sī. syā. pī.)],","ja81:1.4":"diṭṭhā nāhumha vānarāti.","ja81:2.1":"Surāpānajātakaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2206,"to":2206,"paras":[{"para":2206,"vripara":null,"refs":["ja81:1"],"lines":["Tattha <b>apāyimhā</b>ti suraṃ pivimha.","<b>Anaccimhā</b>ti taṃ pivitvā hatthapāde lāḷentā naccimha.","<b>Agāyimhā</b>ti mukhaṃ vivaritvā āyatakena sarena gāyimha.","<b>Rudimha cā</b>ti puna vippaṭisārino “evarūpaṃ nāma amhehi katan”ti rodimha ca.","<b>Visaññīkaraṇiṃ pitvā, diṭṭhā nāhumha vānarā</b>ti evarūpaṃ saññāvināsanato visaññīkaraṇiṃ suraṃ pivitvā “etadeva sādhu, yaṃ vānarā nāhumhā”ti.","Evaṃ te attano aguṇaṃ kathesuṃ."],"lineRefs":[["ja81:1"],["ja81:1"],["ja81:1"],["ja81:1"],["ja81:1"],["ja81:1"]]}],"wordLinks":[["ja81:1.1","apāyimhā",0,0],["ja81:1.1","anaccimhā",0,1],["ja81:1.1","agāyimhā",0,2],["ja81:1.1","rudimha cā",0,3]]},"tika":null,"tika2":null}
