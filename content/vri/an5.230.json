{"suttaId":"an5.230","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1477,1482],"vripara":"230"},"segments":{"an5.230:0.3":"Dutiyakaṇhasappasuttaṃ","an5.230:1.1":"“Pañcime, bhikkhave, ādīnavā kaṇhasappe.","an5.230:1.2":"Katame pañca?","an5.230:1.3":"Kodhano, upanāhī, ghoraviso, dujjivho, mittadubbhī –","an5.230:1.4":"ime kho, bhikkhave, pañca ādīnavā kaṇhasappe.","an5.230:2.1":"“Evamevaṃ kho, bhikkhave, pañcime ādīnavā mātugāme.","an5.230:2.2":"Katame pañca?","an5.230:2.3":"Kodhano, upanāhī, ghoraviso, dujjivho, mittadubbhī.","an5.230:2.4":"Tatridaṃ, bhikkhave, mātugāmassa ghoravisatā –","an5.230:2.5":"yebhuyyena, bhikkhave, mātugāmo tibbarāgo.","an5.230:2.6":"Tatridaṃ, bhikkhave, mātugāmassa dujjivhatā –","an5.230:2.7":"yebhuyyena, bhikkhave, mātugāmo pisuṇavāco.","an5.230:2.8":"Tatridaṃ, bhikkhave, mātugāmassa mittadubbhitā –","an5.230:2.9":"yebhuyyena, bhikkhave, mātugāmo aticārinī.","an5.230:2.10":"Ime kho, bhikkhave, pañca ādīnavā mātugāme”ti.","an5.230:2.11":"Dasamaṃ.","an5.230:2.12":"Dīghacārikavaggo tatiyo.","an5.230:3.0":"Tassuddānaṃ –","an5.230:3.1":"Dve dīghacārikā vuttā,","an5.230:3.2":"atinivāsamaccharī;","an5.230:3.3":"Dve ca kulūpakā bhogā,","an5.230:3.4":"bhattaṃ sappāpare duveti."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":469,"to":469,"paras":[{"para":469,"vripara":"230","refs":["an5.230:1","an5.230:2"],"lines":["Dasame <b>ghoraviso</b>ti kakkhaḷaviso.","<b>Dujjivho</b>ti dvidhā bhinnajivho.","<b>Ghoravisatā</b>ti ghoravisatāya.","Sesadvayepi eseva nayo."],"lineRefs":[["an5.230:1"],["an5.230:1"],["an5.230:2"],["an5.230:2"]]}],"wordLinks":[["an5.230:1.3","ghoraviso",0,0],["an5.230:1.3","dujjivho",0,1],["an5.230:2.4","ghoravisatā",0,2]],"before":[{"para":468,"vripara":null,"title":"Dutiyakaṇhasappasuttavaṇṇanā","lines":["Dutiyakaṇhasappasuttavaṇṇanā"]}],"after":[{"para":470,"vripara":null,"title":"Dutiyakaṇhasappasuttavaṇṇanā","lines":["Dīghacārikavaggo tatiyo."]}]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":462,"to":464,"paras":[{"para":462,"vripara":"221-230","refs":["an5.230:1"],"lines":["221-230. Tatiyassa paṭhamādīni suviññeyyāni.","Pañcame <b>raho nisajjāya āpajjatī</b>ti “yo pana bhikkhu mātugāmena saddhiṃ eko ekāya raho nisajjaṃ kappeyya, pācittiyan”ti imasmiṃ <b>sikkhāpade</b> (pāci.290) vuttaṃ āpattiṃ āpajjati.","<b>Paṭicchanne āsane āpajjatī</b>ti “yo pana bhikkhu mātugāmena raho paṭicchanne āsane nisajjaṃ kappeyya, pācittiyan”ti imasmiṃ vuttaṃ āpattiṃ āpajjati.","<b>Mātugāmassa uttari chappañcavācāhi dhammaṃ desento āpajjatī</b>ti ‘yo pana bhikkhu mātugāmassa uttari chappañcavācāhi dhammaṃ deseyya aññatra viññunā purisaviggahenā”ti (pāci.63) evaṃ vuttaṃ āpattiṃ āpajjati.","Tenāha <b>“tesaṃ tesaṃ sikkhāpadānaṃ vasena veditabbānī”</b>ti.","Chaṭṭhādīni uttānatthāni."],"lineRefs":[["an5.230:1"],["an5.230:1"],["an5.230:1"],["an5.230:1"],["an5.230:1"],["an5.230:1"]]},{"para":463,"vripara":null,"refs":["an5.230:1"],"lines":["Paṭhamadīghacārikasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an5.230:1"]]},{"para":464,"vripara":null,"refs":["an5.230:1"],"lines":["Dīghacārikavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an5.230:1"]]}],"wordLinks":[]},"tika2":null}
