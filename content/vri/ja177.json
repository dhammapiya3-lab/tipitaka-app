{"suttaId":"ja177","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1081,1087],"vripara":"53"},"segments":{"ja177:0.4":"Tindukajātakaṃ (2-3-7)","ja177:1.1":"Dhanuhatthakalāpehi, nettiṃ savaradhāribhi;","ja177:1.3":"Samantā parikiṇṇamha, kathaṃ mokkho bhavissati.","ja177:2.1":"Appeva bahukiccānaṃ, attho jāyetha koci naṃ;","ja177:2.3":"Atthi rukkhassa acchinnaṃ, khajjathaññeva tindukanti.","ja177:3.1":"Tindukajātakaṃ sattamaṃ."},"attha":null,"tika":null}
