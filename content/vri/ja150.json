{"suttaId":"ja150","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[836,850],"vripara":"150"},"segments":{"ja150:0.4":"Sañjīvajātakaṃ","ja150:1.1":"Asantaṃ yo paggaṇhāti,","ja150:1.2":"asantaṃ cūpasevati;","ja150:1.3":"Tameva ghāsaṃ kurute,","ja150:1.4":"byaggho sañjīvako yathāti.","ja150:2.1":"Sañjīvajātakaṃ dasamaṃ.","ja150:2.2":"Kakaṇṭaka [pāpasevana (ka.)] vaggo pannarasamo.","ja150:3.1":"Tassuddānaṃ –","ja150:4.1":"Sukhamedhati daṇḍavaro ca puna,","ja150:4.2":"lasi vāladhi pañcamarādhavaro;","ja150:4.3":"Samahodadhi kattika bondi puna,","ja150:4.4":"caturaṅgulabyagghavarena dasāti.","ja150:5.1":"(Uparimo paṇṇāsako.)[() sīhaḷapotthakeyeva dissati]","ja150:6.1":"Atha vagguddānaṃ –","ja150:7.1":"Apaṇṇakaṃ sīlavaggakuruṅga,","ja150:7.2":"kulāvakaṃ atthakāmena pañcamaṃ;","ja150:7.3":"Āsīso itthivaruṇaṃ apāyi,","ja150:7.4":"littavaggena te dasa;","ja150:7.5":"Parosataṃ haṃci kusanāḷi [haṃsi sarikkhaṃ (sabbattha)],","ja150:7.6":"asampadaṃ kakaṇṭakavaggo.","ja150:8.1":"Ekanipātamhilaṅkatanti.","ja150:9.1":"Ekakanipātaṃ niṭṭhitaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":3103,"to":3103,"paras":[{"para":3103,"vripara":null,"refs":["ja150:1"],"lines":["Tattha <b>asantan</b>ti tīhi duccaritehi samannāgataṃ dussīlaṃ pāpadhammaṃ.","<b>Yo paggaṇhātī</b>ti khattiyādīsu yo koci evarūpaṃ dussīlaṃ pabbajitaṃ vā cīvarādisampadānena, gahaṭṭhaṃ vā uparajjasenāpatiṭṭhānādisampadānena paggaṇhāti, sakkārasammānaṃ karotīti attho.","<b>Asantaṃ cūpasevatī</b>ti yo ca evarūpaṃ asantaṃ dussīlaṃ upasevati bhajati payirupāsati.","<b>Tameva ghāsaṃ kurute</b>ti tameva asantapaggaṇhakaṃ so dussīlo pāpapuggalo ghasati saṃkhādati vināsaṃ pāpeti.","Kathaṃ?","<b>Byaggho sañjīviko yathā</b>ti, yathā sañjīvena māṇavena mantaṃ parivattetvā matabyaggho sañjīviko jīvitasampadānena sampaggahito attano jīvitadāyakaṃ sañjīvameva jīvitā voropetvā tattheva pātesi, evaṃ aññopi yo asantapaggahaṃ karoti, so dussīlo taṃ attano sampaggāhakameva vināseti.","Evaṃ asantasampaggāhakā vināsaṃ pāpuṇantīti."],"lineRefs":[["ja150:1"],["ja150:1"],["ja150:1"],["ja150:1"],["ja150:1"],["ja150:1"],["ja150:1"]]}],"wordLinks":[["ja150:1.1","asantaṃ",0,0],["ja150:1.1","yo paggaṇhātī",0,1],["ja150:1.1","asantaṃ cūpasevatī",0,2],["ja150:1.3","tameva ghāsaṃ kurute",0,3]],"after":[{"para":3104,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Bodhisatto imāya gāthāya māṇavānaṃ dhammaṃ desetvā dānādīni puññāni katvā yathākammaṃ gato."]},{"para":3105,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā matabyagghuṭṭhāpanako māṇavo ajātasattu ahosi, disāpāmokkho ācariyo pana ahameva ahosin”ti."]},{"para":3106,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Sañjīvajātakavaṇṇanā dasamā."]},{"para":3107,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Kakaṇṭakavaggo pannarasamo."]},{"para":3108,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":3109,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Godhasiṅgālavirocaṃ, naṅguṭṭharādhakākañca;"]},{"para":3110,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Puppharattañca siṅgālaṃ, ekapaṇṇañca sañjīvaṃ."]},{"para":3111,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Atha vagguddānaṃ –"]},{"para":3112,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Apaṇṇako sīlavaggo, kuruṅgo ca kulāvako;"]},{"para":3113,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Atthakāmo ca āsīso, itthīvaruṇapāyimhā."]},{"para":3114,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Litto parosataṃ haṃci, kusanāḷā sampadāno;"]},{"para":3115,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Kakaṇṭako pannarasa, satapaṇṇāsa jātakāti."]},{"para":3116,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["Ekakanipātavaṇṇanā niṭṭhitā."]},{"para":3117,"vripara":null,"title":"[150] 10. Sañjīvajātakavaṇṇanā","lines":["(Paṭhamo bhāgo niṭṭhito)."]}]},"tika":null,"tika2":null}
