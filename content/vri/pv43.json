{"suttaId":"pv43","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[2481,2505],"vripara":"766"},"segments":{"pv43:0.3":"Gūthakhādakapetavatthu","pv43:1.1":"“Gūthakūpato uggantvā,","pv43:1.2":"ko nu dīno patiṭṭhasi [dīno hi tiṭṭhasi (sī.)];","pv43:1.3":"Nissaṃsayaṃ pāpakammanto,","pv43:1.4":"kiṃ nu saddahase tuvan”ti.","pv43:2.1":"“Ahaṃ bhadante petomhi,","pv43:2.2":"duggato yamalokiko;","pv43:2.3":"Pāpakammaṃ karitvāna,","pv43:2.4":"petalokaṃ ito gato”.","pv43:3.1":"“Kiṃ nu kāyena vācāya,","pv43:3.2":"manasā dukkaṭaṃ kataṃ;","pv43:3.3":"Kissa kammavipākena,","pv43:3.4":"idaṃ dukkhaṃ nigacchasī”ti.","pv43:4.1":"“Ahu āvāsiko mayhaṃ,","pv43:4.2":"issukī kulamaccharī;","pv43:4.3":"Ajjhosito mayhaṃ ghare,","pv43:4.4":"kadariyo paribhāsako.","pv43:5.1":"“Tassāhaṃ vacanaṃ sutvā,","pv43:5.2":"bhikkhavo paribhāsisaṃ;","pv43:5.3":"Tassa kammavipākena,","pv43:5.4":"petalokaṃ ito gato”ti.","pv43:6.1":"“Amitto mittavaṇṇena,","pv43:6.2":"yo te āsi kulūpako;","pv43:6.3":"Kāyassa bhedā duppañño,","pv43:6.4":"kiṃ nu pecca gatiṃ gato”ti.","pv43:7.1":"“Tassevāhaṃ pāpakammassa,","pv43:7.2":"sīse tiṭṭhāmi matthake;","pv43:7.3":"So ca paravisayaṃ patto,","pv43:7.4":"mameva paricārako.","pv43:8.1":"“Yaṃ bhadante hadantaññe,","pv43:8.2":"etaṃ me hoti bhojanaṃ;","pv43:8.3":"Ahañca kho yaṃ hadāmi,","pv43:8.4":"etaṃ so upajīvatī”ti.","pv43:9.1":"Gūthakhādakapetavatthu aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":3005,"to":3020,"paras":[{"para":3005,"vripara":"769","refs":["pv43:4"],"lines":["Tattha <b>ahu āvāsiko mayhan</b>ti mayhaṃ āvāse mayā katavihāre eko bhikkhu āvāsiko nibaddhavasanako ahosi.","<b>Ajjhāsito mayhaṃ ghare</b>ti kulūpakabhāvena mama gehe taṇhābhinivesavasena abhiniviṭṭho."],"lineRefs":[["pv43:4"],["pv43:4"]]},{"para":3006,"vripara":"770","refs":["pv43:5"],"lines":["<b>Tassā</b>ti tassa kulūpakabhikkhussa.","<b>Bhikkhavo</b>ti bhikkhū.","<b>Paribhāsisan</b>ti akkosiṃ.","<b>Petalokaṃ ito gato</b>ti iminā ākārena petayoniṃ upagato petabhūto."],"lineRefs":[["pv43:5"],["pv43:5"],["pv43:5"],["pv43:5"]]},{"para":3007,"vripara":null,"refs":["pv43:5"],"lines":["Taṃ sutvā thero itarassa gatiṃ pucchanto –"],"lineRefs":[["pv43:5"]]},{"para":3009,"vripara":"771","refs":["pv43:5"],"lines":["“Amitto mittavaṇṇena, yo te āsi kulūpako;"],"lineRefs":[["pv43:5"]]},{"para":3010,"vripara":null,"refs":["pv43:5"],"lines":["Kāyassa bhedā duppañño, kiṃ nu pecca gatiṃ gato”ti.","–"],"lineRefs":[["pv43:5"],["pv43:5"]]},{"para":3011,"vripara":null,"refs":["pv43:5","pv43:6"],"lines":["Gāthamāha.","Tattha <b>mittavaṇṇenā</b>ti mittapaṭirūpena mittapaṭirūpatāya."],"lineRefs":[["pv43:5"],["pv43:6"]]},{"para":3012,"vripara":null,"refs":["pv43:6"],"lines":["Puna peto therassa tamatthaṃ ācikkhanto –"],"lineRefs":[["pv43:6"]]},{"para":3014,"vripara":"772","refs":["pv43:6"],"lines":["“Tassevāhaṃ pāpakammassa, sīse tiṭṭhāmi matthake;"],"lineRefs":[["pv43:6"]]},{"para":3015,"vripara":null,"refs":["pv43:6"],"lines":["So ca paravisayaṃ patto, mameva paricārako."],"lineRefs":[["pv43:6"]]},{"para":3017,"vripara":"773","refs":["pv43:6"],"lines":["“Yaṃ bhadante hadantaññe, etaṃ me hoti bhojanaṃ;"],"lineRefs":[["pv43:6"]]},{"para":3018,"vripara":null,"refs":["pv43:6"],"lines":["Ahañca kho yaṃ hadāmi, etaṃ so upajīvatī”ti.","– gāthādvayamāha;"],"lineRefs":[["pv43:6"],["pv43:6"]]},{"para":3019,"vripara":"772","refs":["pv43:7"],"lines":["Tattha <b>tassevā</b>ti tasseva mayhaṃ pubbe kulūpakabhikkhubhūtassa petassa.","<b>Pāpakammassā</b>ti pāpasamācārassa.","<b>Sīse tiṭṭhāmi matthake</b>ti sīse tiṭṭhāmi, tiṭṭhanto ca matthake eva tiṭṭhāmi, na sīsappamāṇe ākāseti attho.","<b>Paravisayaṃ patto</b>ti manussalokaṃ upādāya paravisayabhūtaṃ pettivisayaṃ patto.","<b>Mamevā</b>ti mayhaṃ eva paricārako ahosīti vacanaseso."],"lineRefs":[["pv43:7"],["pv43:7"],["pv43:7"],["pv43:7"],["pv43:7"]]},{"para":3020,"vripara":"773","refs":["pv43:8"],"lines":["<b>Yaṃ bhadante hadantaññe</b>ti bhadante, ayya mahāmoggalāna, tassaṃ vaccakuṭiyaṃ yaṃ aññe uhadanti vaccaṃ ossajanti.","<b>Etaṃ me hoti bhojanan</b>ti etaṃ vaccaṃ mayhaṃ divase divase bhojanaṃ hoti.","<b>Yaṃ hadāmī</b>ti taṃ pana vaccaṃ khāditvā yampahaṃ vaccaṃ karomi.","<b>Etaṃ so upajīvatī</b>ti etaṃ mama vaccaṃ so kulūpakapeto divase divase khādanavasena upajīvati, attabhāvaṃ yāpetīti attho."],"lineRefs":[["pv43:8"],["pv43:8"],["pv43:8"],["pv43:8"]]}],"wordLinks":[["pv43:4.1","ahu āvāsiko mayhaṃ",0,0],["pv43:5.1","tassā",1,0],["pv43:5.3","tassā",1,0],["pv43:5.1","bhikkhavo",1,1],["pv43:5.1","paribhāsisaṃ",1,2],["pv43:5.3","petalokaṃ ito gato",1,3],["pv43:6.1","mittavaṇṇenā",5,1],["pv43:7.1","tassevā",11,0],["pv43:7.1","pāpakammassā",11,1],["pv43:7.1","sīse tiṭṭhāmi matthake",11,2],["pv43:7.3","paravisayaṃ patto",11,3],["pv43:7.3","mamevā",11,4],["pv43:8.1","yaṃ bhadante hadantaññe",12,0],["pv43:8.1","etaṃ me hoti bhojanaṃ",12,1],["pv43:8.3","yaṃ hadāmī",12,2],["pv43:8.3","etaṃ so upajīvatī",12,3]],"before":[{"para":2982,"vripara":null,"refs":[],"lines":["Evaṃ bhagavā rājaputtapetakathāya tattha sannipatitaṃ mahājanaṃ saṃvejetvā upari saccāni pakāsesi.","Saccapariyosāne bahū sotāpattiphalādīni sampāpuṇiṃsūti."],"lineRefs":[[],[]]},{"para":2983,"vripara":null,"refs":[],"lines":["Rājaputtapetavatthuvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2984,"vripara":null,"refs":[],"lines":["Gūthakhādakapetavatthuvaṇṇanā"],"lineRefs":[[]]},{"para":2985,"vripara":null,"refs":[],"lines":["<b>Gūthakūpato uggantvā</b>ti idaṃ satthari jetavane viharante ekaṃ gūthakhādakapetaṃ ārambha vuttaṃ.","Sāvatthiyā kira avidūre aññatarasmiṃ gāmake eko kuṭumbiko attano kulūpakaṃ bhikkhuṃ uddissa vihāraṃ kāresi.","Tattha nānājanapadato bhikkhū āgantvā paṭivasiṃsu.","Te disvā manussā pasannacittā paṇītena paccayena upaṭṭhahiṃsu.","Kulūpako bhikkhu taṃ asahamāno issāpakato hutvā tesaṃ bhikkhūnaṃ dosaṃ vadanto kuṭumbikaṃ ujjhāpesi.","Kuṭumbiko te bhikkhū kulūpakañca paribhavanto paribhāsi.","Atha kulūpako kālaṃ katvā tasmiṃyeva vihāre vaccakuṭiyaṃ peto hutvā nibbatti, kuṭumbiko pana kālaṃ katvā tasseva upari peto hutvā nibbatti.","Athāyasmā mahāmoggallāno taṃ disvā pucchanto –"],"lineRefs":[[],[],[],[],[],[],[],[]]},{"para":2987,"vripara":"766","refs":[],"lines":["“Gūthakūpato uggantvā, ko na dīno patiṭṭhasi;"],"lineRefs":[[]]},{"para":2988,"vripara":null,"refs":[],"lines":["Nissaṃsayaṃ pāpakammanto, kiṃ nu saddahase tuvan”ti.","–"],"lineRefs":[[],[]]},{"para":2989,"vripara":null,"refs":[],"lines":["Gāthamāha.","Taṃ sutvā peto –"],"lineRefs":[[],[]]},{"para":2991,"vripara":"767","refs":[],"lines":["“Ahaṃ bhadante petomhi, duggato yamalokiko;"],"lineRefs":[[]]},{"para":2992,"vripara":null,"refs":[],"lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gato”ti.","–"],"lineRefs":[[],[]]},{"para":2993,"vripara":null,"refs":[],"lines":["Gāthāya attānaṃ ācikkhi.","Atha naṃ thero –"],"lineRefs":[[],[]]},{"para":2995,"vripara":"768","refs":[],"lines":["“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;"],"lineRefs":[[]]},{"para":2996,"vripara":null,"refs":[],"lines":["Kissakammavipākena, idaṃ dukkhaṃ nigacchasī”ti.","–"],"lineRefs":[[],[]]},{"para":2997,"vripara":null,"refs":[],"lines":["Gāthāya tena katakammaṃ pucchi.","So peto –"],"lineRefs":[[],[]]},{"para":2999,"vripara":"769","refs":[],"lines":["“Ahu āvāsiko mayhaṃ, issukī kulamaccharī;"],"lineRefs":[[]]},{"para":3000,"vripara":null,"refs":[],"lines":["Ajjhāsito mayhaṃ ghare, kadariyo paribhāsako."],"lineRefs":[[]]},{"para":3002,"vripara":"770","refs":[],"lines":["“Tassāhaṃ vacanaṃ sutvā, bhikkhavo paribhāsisaṃ;"],"lineRefs":[[]]},{"para":3003,"vripara":null,"refs":[],"lines":["Tassakammavipākena, petalokaṃ ito gato”ti.","–"],"lineRefs":[[],[]]},{"para":3004,"vripara":null,"refs":[],"lines":["Dvīhi gāthāhi attanā katakammaṃ kathesi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
