{"suttaId":"iti73","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"It","vriCode":"s0504m.mul","paras":[663,672],"vripara":"73"},"segments":{"iti73:0.4":"Santatarasuttaṃ","iti73:1.1":"Vuttañhetaṃ bhagavatā, vuttamarahatāti me sutaṃ –","iti73:2.1":"“Rūpehi, bhikkhave, arūpā [āruppā (sī.)] santatarā, arūpehi nirodho santataro”ti.","iti73:2.2":"Etamatthaṃ bhagavā avoca.","iti73:2.3":"Tatthetaṃ iti vuccati –","iti73:3.1":"“Ye ca rūpūpagā sattā,","iti73:3.2":"ye ca arūpaṭṭhāyino [āruppaṭṭhāyino (sī.)];","iti73:3.3":"Nirodhaṃ appajānantā,","iti73:3.4":"āgantāro punabbhavaṃ.","iti73:4.1":"“Ye ca rūpe pariññāya,","iti73:4.2":"arūpesu asaṇṭhitā;","iti73:4.3":"Nirodhe ye vimuccanti,","iti73:4.4":"te janā maccuhāyino.","iti73:5.1":"“Kāyena amataṃ dhātuṃ,","iti73:5.2":"phusayitvā nirūpadhiṃ;","iti73:5.3":"Upadhippaṭinissaggaṃ,","iti73:5.4":"sacchikatvā anāsavo;","iti73:5.5":"Deseti sammāsambuddho,","iti73:5.6":"asokaṃ virajaṃ padan”ti.","iti73:6.1":"Ayampi attho vutto bhagavatā, iti me sutanti.","iti73:6.2":"Catutthaṃ."},"unsure":[],"attha":{"book":"It-a","bookName":"Itivuttaka-aṭṭhakathā","vriCode":"s0504a.att","from":1073,"to":1074,"paras":[{"para":1073,"vripara":"73","refs":["iti73:2"],"lines":["Catutthe <b>rūpehī</b>ti rūpāvacaradhammehi.","<b>Santatarā</b>ti atisayena santā.","Rūpāvacaradhammā hi kilesavikkhambhanato vitakkādioḷārikaṅgappahānato samādhibhūmibhāvato ca santā nāma, āruppā pana tehipi aṅgasantatāya ceva ārammaṇasantatāya ca atisayena santavuttikā, tena santatarāti vuttā.","<b>Nirodho</b>ti nibbānaṃ.","Saṅkhārāvasesasukhumabhāvappattitopi hi catutthāruppato phalasamāpattiyova santatarā kilesadarathapaṭipassaddhito nibbānārammaṇato ca, kimaṅgaṃ pana sabbasaṅkhārasamatho nibbānaṃ.","Tena vuttaṃ “āruppehi nirodho santataro”ti."],"lineRefs":[["iti73:2"],["iti73:2"],["iti73:2"],["iti73:2"],["iti73:2"],["iti73:2"]]},{"para":1074,"vripara":null,"refs":["iti73:3","iti73:4"],"lines":["Gāthāsu <b>rūpūpagā</b>ti rūpabhavūpagā.","Rūpabhavo hi idha rūpanti vutto,“rūpūpapattiyā maggaṃ bhāvetī”tiādīsu viya.","<b>Arūpaṭṭhāyino</b>ti arūpāvacarā.","<b>Nirodhaṃ appajānantā, āgantāro punabbhavan</b>ti etena rūpārūpāvacaradhammehi nirodhassa santabhāvameva dasseti.","<b>Arūpesu asaṇṭhitā</b>ti arūparāgena arūpabhavesu appatiṭṭhahantā, tepi parijānantāti attho.","<b>Nirodhe ye vimuccantī</b>ti ettha <b>ye</b>ti nipātamattaṃ.","Sesaṃ heṭṭhā vuttanayameva."],"lineRefs":[["iti73:3"],["iti73:3"],["iti73:3"],["iti73:3"],["iti73:4"],["iti73:4"],["iti73:4"]]}],"wordLinks":[["iti73:2.1","rūpehī",0,0],["iti73:2.1","santatarā",0,1],["iti73:2.1","nirodho",0,3],["iti73:3.1","rūpūpagā",1,0],["iti73:3.1","arūpaṭṭhāyino",1,2],["iti73:3.3","nirodhaṃ appajānantā āgantāro punabbhavaṃ",1,3],["iti73:4.1","arūpesu asaṇṭhitā",1,4],["iti73:4.1","ye",1,5],["iti73:4.3","nirodhe ye vimuccantī",1,5],["iti73:4.3","ye",1,5]],"before":[{"para":1071,"vripara":null,"refs":[],"lines":["Tatiyasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1072,"vripara":null,"refs":[],"lines":["Santatarasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
