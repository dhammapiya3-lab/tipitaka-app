{"suttaId":"ja114","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[641,644],"vripara":"114"},"segments":{"ja114:0.4":"Mitacintijātakaṃ","ja114:1.1":"Bahucintī appacintī, ubho jāle abajjhare;","ja114:1.3":"Mitacintī pamocesī, ubho tattha samāgatāti.","ja114:2.1":"Mitacintijātakaṃ catutthaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2635,"to":2635,"paras":[{"para":2635,"vripara":null,"refs":["ja114:1"],"lines":["Tattha <b>bahucintī</b>ti bahucintanatāya vitakkabahulatāya evaṃladdhanāmo.","Itaresupi dvīsu ayameva nayo.","<b>Ubho tattha samāgatā</b>ti mitacintiṃ nissāya laddhajīvitā tattha udake puna ubhopi janā mitacintinā saddhiṃ samāgatāti attho."],"lineRefs":[["ja114:1"],["ja114:1"],["ja114:1"]]}],"wordLinks":[["ja114:1.1","bahucintī",0,0],["ja114:1.3","ubho tattha samāgatā",0,2]]},"tika":null}
