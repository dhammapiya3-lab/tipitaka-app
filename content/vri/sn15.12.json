{"suttaId":"sn15.12","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[914,914],"vripara":"135"},"segments":{"sn15.12:0.3":"Sukhitasuttaṃ","sn15.12:1.1":"Sāvatthiyaṃ viharati…pe…","sn15.12:1.2":"“anamataggoyaṃ, bhikkhave, saṃsāro…pe…","sn15.12:1.3":"yaṃ, bhikkhave, passeyyātha sukhitaṃ susajjitaṃ, niṭṭhamettha gantabbaṃ –","sn15.12:1.4":"‘amhehipi evarūpaṃ paccanubhūtaṃ iminā dīghena addhunā’ti.","sn15.12:1.5":"Taṃ kissa hetu?","sn15.12:1.6":"Anamataggoyaṃ, bhikkhave, saṃsāro.","sn15.12:1.7":"Pubbā koṭi na paññāyati…pe…","sn15.12:1.8":"alaṃ vimuccitu”nti.","sn15.12:1.9":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":641,"to":641,"paras":[{"para":641,"vripara":"135","refs":["sn15.12:1"],"lines":["Dutiye <b>sukhita</b>nti sukhasamappitaṃ mahaddhanaṃ mahābhogaṃ.","<b>Susajjita</b>nti alaṅkatapaṭiyattaṃ hatthikkhandhagataṃ mahāparivāraṃ.","Dutiyaṃ. 3."],"lineRefs":[["sn15.12:1"],["sn15.12:1"],["sn15.12:1"]]}],"wordLinks":[["sn15.12:1.1","sukhitaṃ",0,0],["sn15.12:1.1","susajjitaṃ",0,1]],"before":[{"para":640,"vripara":null,"title":"Sukhitasuttavaṇṇanā","lines":["Sukhitasuttavaṇṇanā 135."]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":654,"to":654,"paras":[{"para":654,"vripara":"135","refs":["sn15.12:1"],"lines":["<b>Sukhita</b>nti sañjātasukhaṃ.","Tenāha <b>“sukhasamappita”</b>ntiādi.","<b>Susajjita</b>nti sukhumupakaraṇehi sabbathā sajjitaṃ."],"lineRefs":[["sn15.12:1"],["sn15.12:1"],["sn15.12:1"]]}],"wordLinks":[["sn15.12:1.1","sukhitaṃ",0,0],["sn15.12:1.1","susajjitaṃ",0,2]],"before":[{"para":653,"vripara":null,"title":"Sukhitasuttavaṇṇanā","lines":["Sukhitasuttavaṇṇanā 135."]}],"after":[{"para":655,"vripara":null,"title":"Sukhitasuttavaṇṇanā","lines":["Sukhitasuttavaṇṇanā niṭṭhitā. 3."]}]},"tika2":null}
