{"suttaId":"sn15.12","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[914,914],"vripara":"135"},"segments":{"sn15.12:0.3":"Sukhitasuttaṃ","sn15.12:1.1":"Sāvatthiyaṃ viharati … pe …“anamataggoyaṃ, bhikkhave, saṃsāro … pe … yaṃ, bhikkhave, passeyyātha sukhitaṃ susajjitaṃ, niṭṭhamettha gantabbaṃ –","sn15.12:1.4":"‘amhehipi evarūpaṃ paccanubhūtaṃ iminā dīghena addhunā’ti.","sn15.12:1.5":"Taṃ kissa hetu?","sn15.12:1.6":"Anamataggoyaṃ, bhikkhave, saṃsāro.","sn15.12:1.7":"Pubbā koṭi na paññāyati … pe … alaṃ vimuccitun”ti.","sn15.12:1.9":"Dutiyaṃ."},"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":641,"to":641,"paras":[{"para":641,"vripara":"135","refs":["sn15.12:1"],"lines":["Dutiye <b>sukhitan</b>ti sukhasamappitaṃ mahaddhanaṃ mahābhogaṃ.","<b>Susajjitan</b>ti alaṅkatapaṭiyattaṃ hatthikkhandhagataṃ mahāparivāraṃ.","Dutiyaṃ."],"lineRefs":[["sn15.12:1"],["sn15.12:1"],["sn15.12:1"]]}],"wordLinks":[["sn15.12:1.1","sukhitaṃ",0,0],["sn15.12:1.1","susajjitaṃ",0,1]]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":654,"to":654,"paras":[{"para":654,"vripara":"135","refs":["sn15.12:1"],"lines":["<b>Sukhitan</b>ti sañjātasukhaṃ.","Tenāha <b>“sukhasamappitan”</b>tiādi.","<b>Susajjitan</b>ti sukhumupakaraṇehi sabbathā sajjitaṃ."],"lineRefs":[["sn15.12:1"],["sn15.12:1"],["sn15.12:1"]]}],"wordLinks":[["sn15.12:1.1","sukhitaṃ",0,0],["sn15.12:1.1","susajjitaṃ",0,2]]}}
