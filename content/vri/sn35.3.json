{"suttaId":"sn35.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[12,12],"vripara":"3"},"segments":{"sn35.3:0.3":"Ajjhattānattasuttaṃ","sn35.3:1.1":"“Cakkhuṃ, bhikkhave, anattā.","sn35.3:1.2":"Yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.3:1.3":"Sotaṃ anattā … pe … ghānaṃ anattā … jivhā anattā … kāyo anattā … mano anattā.","sn35.3:1.8":"Yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.3:1.9":"Evaṃ passaṃ … pe … nāparaṃ itthattāyāti pajānātī”ti.","sn35.3:1.11":"Tatiyaṃ."},"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":11,"to":12,"paras":[{"para":11,"vripara":"2-3","refs":["sn35.3:1"],"lines":["2-3. Dutiyaṃ dve lakkhaṇāni, tatiyaṃ ekalakkhaṇaṃ dassetvā kathite bujjhanakānaṃ ajjhāsayena vuttaṃ.","Sesāni pana tehi sallakkhitāni vā ettakeneva vā sallakkhessantīti."],"lineRefs":[["sn35.3:1"],["sn35.3:1"]]},{"para":12,"vripara":null,"refs":["sn35.3:1"],"lines":["4-6. Bāhirāniccasuttādivaṇṇanā"],"lineRefs":[["sn35.3:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":12,"to":14,"paras":[{"para":12,"vripara":"2-3","refs":["sn35.3:1"],"lines":["2-3. <b>Dve lakkhaṇānī</b>ti dukkhānattalakkhaṇāni.","<b>Ekaṃ lakkhaṇan</b>ti anattalakkhaṇaṃ.","<b>Sesānī</b>ti vuttāvasesāni lakkhaṇāni.","<b>Tehī</b>ti yehi dutiyatatiyāni suttāni desitāni, tehi.","<b>Sallakkhitānī</b>ti sammadeva upadhāritāni.","<b>Ettakenā</b>ti dvinnaṃ ekasseva vā lakkhaṇassa kathanena."],"lineRefs":[["sn35.3:1"],["sn35.3:1"],["sn35.3:1"],["sn35.3:1"],["sn35.3:1"],["sn35.3:1"]]},{"para":13,"vripara":null,"refs":[],"lines":["Ajjhattadukkhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":14,"vripara":null,"refs":["sn35.3:1"],"lines":["4-6. Bāhirāniccasuttādivaṇṇanā"],"lineRefs":[["sn35.3:1"]]}],"wordLinks":[]},"tika2":null}
