{"suttaId":"sn22.141","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[838,838],"vripara":"141"},"segments":{"sn22.141:0.3":"Dutiyadukkhasuttaṃ","sn22.141:1.1":"Sāvatthinidānaṃ.","sn22.141:1.2":"“Yaṃ, bhikkhave, dukkhaṃ; tatra vo rāgo pahātabbo … pe …","sn22.141:1.3":"yaṃ, bhikkhave, dukkhaṃ; tatra vo rāgo pahātabbo”ti.","sn22.141:1.4":"Chaṭṭhaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":391,"to":394,"paras":[{"para":391,"vripara":"136-149","refs":["sn22.141:1"],"lines":["136-149. Kukkuḷavaggassa paṭhame <b>kukkuḷan</b>ti santattaṃ ādittaṃ chārikarāsiṃ viya mahāpariḷāhaṃ.","Imasmiṃ sutte dukkhalakkhaṇaṃ kathitaṃ, sesesu aniccalakkhaṇādīni.","Sabbāni cetāni pāṭiyekkaṃ puggalajjhāsayena kathitānīti."],"lineRefs":[["sn22.141:1"],["sn22.141:1"],["sn22.141:1"]]},{"para":392,"vripara":null,"refs":["sn22.141:1"],"lines":["Kukkuḷavaggo cuddasamo."],"lineRefs":[["sn22.141:1"]]},{"para":393,"vripara":null,"refs":["sn22.141:1"],"lines":["Diṭṭhivaggo"],"lineRefs":[["sn22.141:1"]]},{"para":394,"vripara":null,"refs":["sn22.141:1"],"lines":["1-9. Ajjhattasuttādivaṇṇanā"],"lineRefs":[["sn22.141:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":395,"to":399,"paras":[{"para":395,"vripara":"136-149","refs":["sn22.141:1"],"lines":["136-149. Anto aggi mahanto chārikarāsi, tattha ukkuḷavikulato akkamantaṃ yāva kesaggaṃ anudahatāya kucchitaṃ kuḷanti kukkuḷaṃ, rūpavedanādi pana tatopi kañci kālaṃ anudahanato mahāpariḷāhanaṭṭhena ca kukkuḷaṃ viyāti <b>kukkuḷaṃ.</b>","<b>Aniccalakkhaṇādīnī</b>ti aniccadukkhānattalakkhaṇāni."],"lineRefs":[["sn22.141:1"],["sn22.141:1"]]},{"para":396,"vripara":null,"refs":["sn22.141:1"],"lines":["Kukkuḷasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.141:1"]]},{"para":397,"vripara":null,"refs":["sn22.141:1"],"lines":["Kukkuḷavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.141:1"]]},{"para":398,"