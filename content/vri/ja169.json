{"suttaId":"ja169","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1012,1018],"vripara":"37"},"segments":{"ja169:0.4":"Arakajātakaṃ (2-2-9)","ja169:1.1":"Yo ve mettena cittena, sabbalokānukampati;","ja169:1.3":"Uddhaṃ adho ca tiriyaṃ, appamāṇena sabbaso.","ja169:2.1":"Appamāṇaṃ hitaṃ cittaṃ, paripuṇṇaṃ subhāvitaṃ;","ja169:2.3":"Yaṃ pamāṇakataṃ kammaṃ, na taṃ tatrāvasissatīti.","ja169:3.1":"Arakajātakaṃ navamaṃ."},"attha":null,"tika":null}
