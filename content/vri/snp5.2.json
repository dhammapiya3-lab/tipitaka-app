{"suttaId":"snp5.2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3520,3550],"vripara":"1038"},"segments":{"snp5.2:0.2":"Ajitamāṇavapucchā","snp5.2:1.1":"“Kenassu nivuto loko,","snp5.2:1.2":"(iccāyasmā ajito)","snp5.2:1.3":"Kenassu nappakāsati;","snp5.2:1.4":"Kissābhilepanaṃ brūsi,","snp5.2:1.5":"kiṃsu tassa mahabbhayaṃ”. 1039.","snp5.2:2.1":"“Avijjāya nivuto loko,","snp5.2:2.2":"(ajitāti bhagavā)","snp5.2:2.3":"Vevicchā pamādā nappakāsati;","snp5.2:2.4":"Jappābhilepanaṃ brūmi,","snp5.2:2.5":"dukkhamassa mahabbhayaṃ”. 1040.","snp5.2:3.1":"“Savanti sabbadhi sotā,","snp5.2:3.2":"(iccāyasmā ajito)","snp5.2:3.3":"Sotānaṃ kiṃ nivāraṇaṃ;","snp5.2:3.4":"Sotānaṃ saṃvaraṃ brūhi,","snp5.2:3.5":"kena sotā pidhiyyare” [pithiyyare (sī. syā. pī.), pithīyare (sī. aṭṭha.), pidhīyare (?)]. 1041.","snp5.2:4.1":"“Yāni sotāni lokasmiṃ,","snp5.2:4.2":"(ajitāti bhagavā)","snp5.2:4.3":"Sati tesaṃ nivāraṇaṃ;","snp5.2:4.4":"Sotānaṃ saṃvaraṃ brūmi,","snp5.2:4.5":"paññāyete pidhiyyare”. 1042.","snp5.2:5.1":"“Paññā ceva sati yañca [satī ceva (sī.), satī ca (syā.), satī cāpi (pī. niddesa), sati cāpi (niddesa)],","snp5.2:5.2":"(iccāyasmā ajito)","snp5.2:5.3":"Nāmarūpañca mārisa;","snp5.2:5.4":"Etaṃ me puṭṭho pabrūhi,","snp5.2:5.5":"katthetaṃ uparujjhati”. 1043.","snp5.2:6.1":"“Yametaṃ pañhaṃ apucchi,","snp5.2:6.2":"ajita taṃ vadāmi te;","snp5.2:6.3":"Yattha nāmañca rūpañca,","snp5.2:6.4":"asesaṃ uparujjhati;","snp5.2:6.5":"Viññāṇassa nirodhena,","snp5.2:6.6":"etthetaṃ uparujjhati”. 1044.","snp5.2:7.1":"“Ye ca saṅkhātadhammāse,","snp5.2:7.2":"ye ca sekhā puthū idha;","snp5.2:7.3":"Tesaṃ me nipako iriyaṃ,","snp5.2:7.4":"puṭṭho pabrūhi mārisa”. 1045.","snp5.2:8.1":"“Kāmesu nābhigijjheyya,","snp5.2:8.2":"manasānāvilo siyā;","snp5.2:8.3":"Kusalo sabbadhammānaṃ,","snp5.2:8.4":"sato bhikkhu paribbaje”ti.","snp5.2:8.5":"Ajitamāṇavapucchā paṭhamā niṭṭhitā. 2."},"unsure":[],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"