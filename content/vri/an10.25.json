{"suttaId":"an10.25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[197,197],"vripara":"25"},"segments":{"an10.25:0.3":"Kasiṇasuttaṃ","an10.25:1.1":"[dī. ni.3.346,360; a. ni.10.29]“Dasayimāni, bhikkhave, kasiṇāyatanāni.","an10.25:1.2":"Katamāni dasa?","an10.25:1.3":"Pathavīkasiṇameko sañjānāti uddhaṃ adho tiriyaṃ advayaṃ appamāṇaṃ;","an10.25:1.4":"āpokasiṇameko sañjānāti … pe …","an10.25:1.5":"tejokasiṇameko sañjānāti …","an10.25:1.6":"vāyokasiṇameko sañjānāti …","an10.25:1.7":"nīlakasiṇameko sañjānāti …","an10.25:1.8":"pītakasiṇameko sañjānāti …","an10.25:1.9":"lohitakasiṇameko sañjānāti …","an10.25:1.10":"odātakasiṇameko sañjānāti …","an10.25:1.11":"ākāsakasiṇameko sañjānāti …","an10.25:1.12":"viññāṇakasiṇameko sañjānāti uddhaṃ adho tiriyaṃ advayaṃ appamāṇaṃ.","an10.25:1.13":"Imāni kho, bhikkhave, dasa kasiṇāyatanānī”ti.","an10.25:1.14":"Pañcamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Mp-x","bookName":"Dasakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":480,"to":480,"paras":[{"para":480,"vripara":"25","refs":["an10.25:1"],"lines":["Pañcame sakalaṭṭhena kasiṇāni, tadārammaṇānaṃ dhammānaṃ khettaṭṭhena adhiṭṭhānaṭṭhena vā āyatanānīti <b>kasiṇāyatanāni.</b>","<b>Uddhan</b>ti upari gagaṇatalābhimukhaṃ.","<b>Adho</b>ti heṭṭhā bhūmitalābhimukhaṃ.","<b>Tiriyan</b>ti khettamaṇḍalaṃ viya samantā paricchinditvā.","Ekacco hi uddhameva kasiṇaṃ vaḍḍheti, ekacco adho, ekacco samantato.","Tena tena vā kāraṇena evaṃ pasāreti ālokamiva rūpadassanakāmo.","Tena vuttaṃ –","“pathavīkasiṇameko sañjānāti uddhaṃ adho tiriyan”ti.","<b>Advayan</b>ti idaṃ pana ekassa aññabhāvānupagamanatthaṃ vuttaṃ.","Yathā hi udakaṃ paviṭṭhassa sabbadisāsu udakameva hoti na aññaṃ, evameva pathavīkasiṇaṃ pathavīkasiṇameva hoti.","Natthi tassa aññakasiṇasambhedoti.","Eseva nayo sabbattha.","<b>Appamāṇan</b>ti idaṃ tassa tassa pharaṇaappamāṇavasena vuttaṃ.","Tañhi cetasā pharanto sakalameva pharati,“ayamassa ādi, idaṃ majjhan”ti pamāṇaṃ na gaṇhāti.","<b>Viññāṇakasiṇan</b>ti cettha kasiṇugghāṭimākāse pavattaviññāṇaṃ.","Tattha kasiṇavasena kasiṇugghāṭimākāse, kasiṇugghāṭimākāsavasena tattha pavattaviññāṇe uddhaṃadhotiriyatā veditabbā.","Ayamettha saṅkhepo, kammaṭṭhānabhāvanānayena panetāni pathavīkasiṇādīni vitthārato visuddhimagge (visuddhi.1.51 ādayo) vuttāneva."],"lineRefs":[["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"]]}],"wordLinks":[["an10.25:1.1","kasiṇāyatanāni",0,0],["an10.25:1.13","kasiṇāyatanāni",0,0],["an10.25:1.3","uddhaṃ",0,1],["an10.25:1.4","uddhaṃ",0,1],["an10.25:1.3","adho",0,2],["an10.25:1.4","adho",0,2],["an10.25:1.3","tiriyaṃ",0,3],["an10.25:1.4","tiriyaṃ",0,3],["an10.25:1.3","advayaṃ",0,8],["an10.25:1.4","advayaṃ",0,8],["an10.25:1.3","appamāṇaṃ",0,12],["an10.25:1.4","appamāṇaṃ",0,12],["an10.25:1.4","viññāṇakasiṇaṃ",0,14]],"before":[{"para":479,"vripara":null,"title":"Kasiṇasuttavaṇṇanā","lines":["Kasiṇasuttavaṇṇanā"]}]},"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":535,"to":535,"paras":[{"para":535,"vripara":null,"refs":["an10.25:1"],"lines":["Ekadese aṭṭhatvā anavasesapharaṇaṃ pamāṇassa aggahaṇato <b>appamāṇaṃ</b>.","Teneva hi nesaṃ kasiṇasamaññā.","Tathā cāha <b>“tañhī”</b>tiādi.","Tattha <b>cetasā pharanto</b>ti bhāvanācittena ārammaṇaṃ karonto.","Bhāvanācittañhi kasiṇaṃ parittaṃ vā vipulaṃ vā sakalameva manasi karoti, na ekadesaṃ.","Kasiṇugghāṭimākāse pavattaviññāṇaṃ pharaṇaappamāṇavasena viññāṇakasiṇanti vuttaṃ.","Tathā hi taṃ viññāṇanti vuccati.","<b>Kasiṇavasenā</b>ti ugghāṭitakasiṇavasena kasiṇugghāṭimākāse uddhaṃadhotiriyatā veditabbā.","Yattakañhi ṭhānaṃ kasiṇaṃ pasāritaṃ, tattakaṃ ākāsabhāvanāvasena ākāsaṃ hotīti.","Evaṃ yattakaṃ ṭhānaṃ ākāsaṃ hutvā upaṭṭhitaṃ, tattakaṃ sakalameva pharitvā viññāṇassa pavattanato āgamanavasena viññāṇakasiṇepi uddhaṃadhotiriyatā vuttāti āha <b>“kasiṇugghāṭimākāsavasena tattha pavattaviññāṇe uddhaṃadhotiriyatā veditabbā”</b>ti."],"lineRefs":[["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"],["an10.25:1"]]}],"wordLinks":[["an10.25:1.3","appamāṇaṃ",0,0],["an10.25:1.4","appamāṇaṃ",0,0]],"after":[{"para":536,"vripara":null,"title":"Kasiṇasuttavaṇṇanā","lines":["Kasiṇasuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
