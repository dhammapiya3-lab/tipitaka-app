{"suttaId":"tha-ap268","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8478,8487],"vripara":"23"},"segments":{"tha-ap268:0.3":"Macchadāyakattheraapadānaṃ","tha-ap268:1.1":"“Candabhāgānadītīre,","tha-ap268:1.2":"ukkuso āsahaṃ tadā;","tha-ap268:1.3":"Mahantaṃ macchaṃ paggayha,","tha-ap268:1.4":"siddhatthamunino adaṃ. 24.","tha-ap268:2.1":"“Catunnavutito kappe,","tha-ap268:2.2":"yaṃ macchamadadiṃ tadā;","tha-ap268:2.3":"Duggatiṃ nābhijānāmi,","tha-ap268:2.4":"macchadānassidaṃ phalaṃ. 25.","tha-ap268:3.1":"“Paṭisambhidā catasso…pe…","tha-ap268:3.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap268:4.1":"Itthaṃ sudaṃ āyasmā macchadāyako thero imā gāthāyo abhāsitthāti.","tha-ap268:5.1":"Macchadāyakattherassāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
