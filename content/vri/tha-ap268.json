{"suttaId":"tha-ap268","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8478,8487],"vripara":"23"},"segments":{"tha-ap268:0.3":"Macchadāyakattheraapadānaṃ","tha-ap268:1.1":"“Candabhāgānadītīre, ukkuso āsahaṃ tadā;","tha-ap268:1.3":"Mahantaṃ macchaṃ paggayha, siddhatthamunino adaṃ.","tha-ap268:2.1":"“Catunnavutito kappe, yaṃ macchamadadiṃ tadā;","tha-ap268:2.3":"Duggatiṃ nābhijānāmi, macchadānassidaṃ phalaṃ.","tha-ap268:3.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap268:4.1":"Itthaṃ sudaṃ āyasmā macchadāyako thero imā gāthāyo abhāsitthāti.","tha-ap268:5.1":"Macchadāyakattherassāpadānaṃ chaṭṭhaṃ."},"attha":null,"tika":null,"tika2":null}
