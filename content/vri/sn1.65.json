{"suttaId":"sn1.65","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[750,754],"vripara":"65"},"segments":{"sn1.65:0.3":"Bandhanasuttaṃ","sn1.65:1.1":"“Kiṃsu sambandhano loko, kiṃsu tassa vicāraṇaṃ;","sn1.65:1.3":"Kissassu vippahānena, sabbaṃ chindati bandhanan”ti.","sn1.65:2.1":"“Nandīsambandhano loko, vitakkassa vicāraṇaṃ;","sn1.65:2.3":"Taṇhāya vippahānena, sabbaṃ chindati bandhanan”ti."},"attha":null,"tika":null}
