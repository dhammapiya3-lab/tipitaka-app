{"suttaId":"vv56","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2211,2230],"vripara":"926"},"segments":{"vv56:0.4":"Paṭhamakaraṇīyavimānavatthu","vv56:1.1":"“Uccamidaṃ maṇithūṇaṃ vimānaṃ, samantato dvādasa yojanāni;","vv56:1.3":"Kūṭāgārā sattasatā uḷārā, veḷuriyathambhā rucakatthatā subhā.","vv56:2.1":"“Tatthacchasi pivasi khādasi ca, dibbā ca vīṇā pavadanti vagguṃ;","vv56:2.3":"Dibbā rasā kāmaguṇettha pañca, nāriyo ca naccanti suvaṇṇachannā.","vv56:3.1":"“Kena tetādiso vaṇṇo … pe …","vv56:3.3":"Vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv56:4.1":"So devaputto attamano … pe … yassa kammassidaṃ phalaṃ.","vv56:5.1":"“Karaṇīyāni puññāni, paṇḍitena vijānatā;","vv56:5.3":"Sammaggatesu buddhesu, yattha dinnaṃ mahapphalaṃ.","vv56:6.1":"“Atthāya vata me buddho, araññā gāmamāgato;","vv56:6.3":"Tattha cittaṃ pasādetvā, tāvatiṃsūpago ahaṃ [ahuṃ (sī.)].","vv56:7.1":"“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv56:8.1":"Paṭhamakaraṇīyavimānaṃ chaṭṭhaṃ."},"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2639,"to":2640,"paras":[{"para":2639,"vripara":"931","refs":["vv56:5"],"lines":["Tattha <b>paṇḍitenā</b>ti sappaññena.","<b>Vijānatā</b>ti attano hitāhitaṃ jānantena.","<b>Sammaggatesū</b>ti sammāpaṭipannesu, <b>buddhesū</b>ti sammāsambuddhesu."],"lineRefs":[["vv56:5"],["vv56:5"],["vv56:5"]]},{"para":2640,"vripara":"932","refs":["vv56:6"],"lines":["<b>Atthāyā</b>ti hitāya, vuḍḍhiyā vā.","<b>Araññā</b>ti vihārato, jetavanaṃ sandhāya vadati.","<b>Tāvatiṃsūpago</b>ti tāvatiṃsadevakāyaṃ, tāvatiṃsabhavanaṃ vā uppajjanavasena upagato.","Sesaṃ vuttanayameva."],"lineRefs":[["vv56:6"],["vv56:6"],["vv56:6"],["vv56:6"]]}],"wordLinks":[["vv56:5.1","paṇḍitenā",0,0],["vv56:5.1","vijānatā",0,1],["vv56:5.3","buddhesū",0,2],["vv56:5.3","sammaggatesū",0,2],["vv56:6.1","atthāyā",1,0],["vv56:6.1","araññā",1,1],["vv56:6.3","tāvatiṃsūpago",1,2]],"before":[{"para":2626,"vripara":null,"refs":[],"lines":["Dvārapālakavimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2627,"vripara":null,"refs":[],"lines":["Paṭhamakaraṇīyavimānavaṇṇanā"],"lineRefs":[[]]},{"para":2628,"vripara":null,"refs":[],"lines":["<b>Uccamidaṃ maṇithūṇan</b>ti karaṇīyavimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tena samayena sāvatthivāsī eko upāsako nhānopakaraṇāni gahetvā aciravatiṃ gantvā nhatvā āgacchanto bhagavantaṃ sāvatthiṃ piṇḍāya pavisantaṃ disvā upasaṅkamitvā vanditvā evamāha “bhante kena nimantitā”ti.","Bhagavā tuṇhī ahosi.","So kenaci animantitabhāvaṃ ñatvā āha “adhivāsetu me, bhante, bhagavā bhattaṃ anukampaṃ upādāyā”ti.","Adhivāsesi bhagavā tuṇhībhāvena.","So bhagavantaṃ attano gehaṃ netvā buddhārahaṃ āsanaṃ paññāpetvā tattha bhagavantaṃ nisīdāpetvā paṇītena annapānena santappesi.","Bhagavā katabhattakicco tassa anumodanaṃ katvā pakkāmi.","Sesaṃ anantaravimānasadisaṃ.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[]]},{"para":2629,"vripara":"926","refs":[],"lines":["“Uccamidaṃ maṇithūṇaṃ vimānaṃ … pe … nāriyo ca naccanti suvaṇṇachannā."],"lineRefs":[[]]},{"para":2630,"vripara":"928","refs":[],"lines":["“Kena tetādiso vaṇṇo … pe … vaṇṇo ca te sabbadisā pabhāsatī”ti."],"lineRefs":[[]]},{"para":2631,"vripara":"930","refs":[],"lines":["“So devaputto attamano … pe … yassa kammassidaṃ phalaṃ”."],"lineRefs":[[]]},{"para":2633,"vripara":"931","refs":[],"lines":["“Karaṇīyāni puññāni, paṇḍitena vijānatā;"],"lineRefs":[[]]},{"para":2634,"vripara":null,"refs":[],"lines":["Sammaggatesu buddhesu, yattha dinnaṃ mahapphalaṃ."],"lineRefs":[[]]},{"para":2636,"vripara":"931","refs":[],"lines":["“Atthāya vata me buddho, araññā gāmamāgato;"],"lineRefs":[[]]},{"para":2637,"vripara":null,"refs":[],"lines":["Kattha cittaṃ pasādetvā, tāvatiṃsūpago ahaṃ."],"lineRefs":[[]]},{"para":2638,"vripara":"933","refs":[],"lines":["“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
