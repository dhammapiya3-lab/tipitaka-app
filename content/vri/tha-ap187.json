{"suttaId":"tha-ap187","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7088,7106],"vripara":"24"},"segments":{"tha-ap187:0.3":"Isimuggadāyakattheraapadānaṃ","tha-ap187:1.1":"“Udentaṃ sataraṃsiṃva,","tha-ap187:1.2":"pītaraṃsiṃva [sitaraṃsiṃva (sī.)] bhāṇumaṃ;","tha-ap187:1.3":"Kakudhaṃ vilasantaṃva,","tha-ap187:1.4":"padumuttaranāyakaṃ.","tha-ap187:2.1":"“Isimuggāni pisitvā [isisuggāni piṃsetvā (sī.), isimuggaṃ nimantetvā (syā.)],","tha-ap187:2.2":"madhukhudde anīḷake;","tha-ap187:2.3":"Pāsādeva ṭhito santo,","tha-ap187:2.4":"adāsiṃ lokabandhuno.","tha-ap187:3.1":"“Aṭṭhasatasahassāni,","tha-ap187:3.2":"ahesuṃ buddhasāvakā;","tha-ap187:3.3":"Sabbesaṃ pattapūrentaṃ [pattapūraṃ taṃ (sī.)],","tha-ap187:3.4":"tato cāpi bahuttaraṃ.","tha-ap187:4.1":"“Tena cittappasādena,","tha-ap187:4.2":"sukkamūlena codito;","tha-ap187:4.3":"Kappānaṃ satasahassaṃ,","tha-ap187:4.4":"duggatiṃ nupapajjahaṃ.","tha-ap187:5.1":"“Cattālīsamhi sahasse,","tha-ap187:5.2":"kappānaṃ aṭṭhatiṃsa te;","tha-ap187:5.3":"Isimuggasanāmā [mahisamantanāmā (syā.)] te,","tha-ap187:5.4":"cakkavattī mahabbalā.","tha-ap187:6.1":"“Paṭisambhidā catasso … pe …","tha-ap187:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap187:7.1":"Itthaṃ sudaṃ āyasmā isimuggadāyako thero imā gāthāyo abhāsitthāti.","tha-ap187:8.1":"Isimuggadāyakattherassāpadānaṃ pañcamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
