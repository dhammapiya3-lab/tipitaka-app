{"suttaId":"tha-ap278","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8634,8643],"vripara":"24"},"segments":{"tha-ap278:0.3":"Potthakadāyakattheraapadānaṃ","tha-ap278:1.1":"“Satthāraṃ dhammamārabbha,","tha-ap278:1.2":"saṅghañcāpi mahesinaṃ;","tha-ap278:1.3":"Potthadānaṃ mayā dinnaṃ,","tha-ap278:1.4":"dakkhiṇeyye anuttare.","tha-ap278:2.1":"“Ekanavutito kappe,","tha-ap278:2.2":"yaṃ kammamakariṃ tadā;","tha-ap278:2.3":"Duggatiṃ nābhijānāmi,","tha-ap278:2.4":"potthadānassidaṃ phalaṃ.","tha-ap278:3.1":"“Paṭisambhidā catasso … pe …","tha-ap278:3.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap278:4.1":"Itthaṃ sudaṃ āyasmā potthakadāyako thero imā gāthāyo abhāsitthāti.","tha-ap278:5.1":"Potthakadāyakattherassāpadānaṃ chaṭṭhaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3236,"to":3236,"paras":[{"para":3236,"vripara":"24","refs":["tha-ap278:1"],"lines":["Chaṭṭhāpadāne <b>potthadānaṃ mayā dinnan</b>ti potthavaṭṭiṃ potthachalliṃ tāḷetvā kataṃ sāṭakaṃ visamaṃ gophāsukena ghaṃsitvā nimmitaṃ suttaṃ gahetvā kantitvā tena suttena nisīdanatthāya vā bhūmattharaṇatthāya vā sāṭakaṃ vāyāpetvā taṃ sāṭakaṃ mayā ratanattayassa dinnanti attho."],"lineRefs":[["tha-ap278:1"]]}],"wordLinks":[["tha-ap278:1.3","potthadānaṃ mayā dinnaṃ",0,0]]},"tika":null,"tika2":null}
