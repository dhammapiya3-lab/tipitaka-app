{"suttaId":"thig5.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[450,466],"vripara":"112"},"segments":{"thig5.10:0.3":"Paṭācārātherīgāthā","thig5.10:1.1":"“Naṅgalehi kasaṃ khettaṃ,","thig5.10:1.2":"bījāni pavapaṃ chamā;","thig5.10:1.3":"Puttadārāni posentā,","thig5.10:1.4":"dhanaṃ vindanti māṇavā. 113.","thig5.10:2.1":"“Kimahaṃ sīlasampannā,","thig5.10:2.2":"satthusāsanakārikā;","thig5.10:2.3":"Nibbānaṃ nādhigacchāmi,","thig5.10:2.4":"akusītā anuddhatā. 114.","thig5.10:3.1":"“Pāde pakkhālayitvāna,","thig5.10:3.2":"udakesu karomahaṃ;","thig5.10:3.3":"Pādodakañca disvāna,","thig5.10:3.4":"thalato ninnamāgataṃ. 115.","thig5.10:4.1":"“Tato cittaṃ samādhesiṃ,","thig5.10:4.2":"assaṃ bhadraṃvajāniyaṃ;","thig5.10:4.3":"Tato dīpaṃ gahetvāna,","thig5.10:4.4":"vihāraṃ pāvisiṃ ahaṃ;","thig5.10:4.5":"Seyyaṃ olokayitvāna,","thig5.10:4.6":"mañcakamhi upāvisiṃ. 116.","thig5.10:5.1":"“Tato sūciṃ gahetvāna,","thig5.10:5.2":"vaṭṭiṃ okassayāmahaṃ;","thig5.10:5.3":"Padīpasseva nibbānaṃ,","thig5.10:5.4":"vimokkho ahu cetaso”ti. …","thig5.10:6.1":"Paṭācārā therī…. 11."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1780,"to":1780,"paras":[{"para":1780,"vripara":null,"refs":["thig5.10:5"],"lines":["<b>Sūci</b>nti aggaḷasūciṃ.","<b>Vaṭṭiṃ okassayāmī</b>ti dīpaṃ vijjhāpetuṃ telābhimukhaṃ dīpavaṭṭiṃ ākaḍḍhemi.","<b>Vimokkho</b>ti kilesehi vimokkho.","So pana yasmā paramatthato cittassa santati, tasmā vuttaṃ <b>“cetaso”</b>ti.","Yathā pana vaṭṭitelādike paccaye sati uppajjanāraho padīpo tadabhāve anuppajjanato nibbutoti vuccati, evaṃ kilesādipaccaye sati uppajjanārahaṃ cittaṃ tadabhāve anuppajjanato vimuttanti vuccatīti āha –","“padīpasseva nibbānaṃ, vimokkho ahu cetaso”ti."],"lineRefs":[["thig5.10:5"],["thig5.10:5"],["thig5.10:5"],["thig5.10:5"],["thig5.10:5"],["thig5.10:5"]]}],"wordLinks":[["thig5.10:5.1","sūciṃ",0,0],["thig5.10:5.1","vaṭṭiṃ okassayāmī",0,1],["thig5.10:5.3","vimokkho",0,2],["thig5.10:5.3","cetaso",0,3]],"after":[{"para":1781,"vripara":null,"title":"Paṭācārātherīgāthāvaṇṇanā","lines":["Paṭācārātherīgāthāvaṇṇanā niṭṭhitā. 11."]}]},"tika":null,"tika2":null}
