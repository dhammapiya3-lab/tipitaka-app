{"suttaId":"thig5.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[450,466],"vripara":"112"},"segments":{"thig5.10:0.3":"Paṭācārātherīgāthā","thig5.10:1.1":"“Naṅgalehi kasaṃ khettaṃ, bījāni pavapaṃ chamā;","thig5.10:1.3":"Puttadārāni posentā, dhanaṃ vindanti māṇavā.","thig5.10:2.1":"“Kimahaṃ sīlasampannā, satthusāsanakārikā;","thig5.10:2.3":"Nibbānaṃ nādhigacchāmi, akusītā anuddhatā.","thig5.10:3.1":"“Pāde pakkhālayitvāna, udakesu karomahaṃ;","thig5.10:3.3":"Pādodakañca disvāna, thalato ninnamāgataṃ.","thig5.10:4.1":"“Tato cittaṃ samādhesiṃ, assaṃ bhadraṃvajāniyaṃ;","thig5.10:4.3":"Tato dīpaṃ gahetvāna, vihāraṃ pāvisiṃ ahaṃ;","thig5.10:4.5":"Seyyaṃ olokayitvāna, mañcakamhi upāvisiṃ.","thig5.10:5.1":"“Tato sūciṃ gahetvāna, vaṭṭiṃ okassayāmahaṃ;","thig5.10:5.3":"Padīpasseva nibbānaṃ, vimokkho ahu cetaso”ti.","thig5.10:6.1":"… Paṭācārā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1780,"to":1780,"paras":[{"para":1780,"vripara":null,"refs":["thig5.10:5"],"lines":["<b>Sūcin</b>ti aggaḷasūciṃ.","<b>Vaṭṭiṃ okassayāmī</b>ti dīpaṃ vijjhāpetuṃ telābhimukhaṃ dīpavaṭṭiṃ ākaḍḍhemi.","<b>Vimokkho</b>ti kilesehi vimokkho.","So pana yasmā paramatthato cittassa santati, tasmā vuttaṃ <b>“cetaso”</b>ti.","Yathā pana vaṭṭitelādike paccaye sati uppajjanāraho padīpo tadabhāve anuppajjanato nibbutoti vuccati, evaṃ kilesādipaccaye sati uppajjanārahaṃ cittaṃ tadabhāve anuppajjanato vimuttanti vuccatīti āha –","“padīpasseva nibbānaṃ, vimokkho ahu cetaso”ti."],"lineRefs":[["thig5.10:5"],["thig5.10:5"],["thig5.10:5"],["thig5.10:5"],["thig5.10:5"],["thig5.10:5"]]}],"wordLinks":[["thig5.10:5.1","sūciṃ",0,0],["thig5.10:5.1","vaṭṭiṃ okassayāmī",0,1],["thig5.10:5.3","vimokkho",0,2],["thig5.10:5.3","cetaso",0,3]],"before":[{"para":1708,"vripara":null,"refs":[],"lines":["“Komāribrahmacariyaṃ, rājakaññā sukhedhitā;"],"lineRefs":[[]]},{"para":1709,"vripara":null,"refs":[],"lines":["Buddhopaṭṭhānaniratā, muditā sattadhītaro."],"lineRefs":[[]]},{"para":1710,"vripara":null,"refs":[],"lines":["“Samaṇī samaṇaguttā ca, bhikkhunī bhikkhudāyikā;"],"lineRefs":[[]]},{"para":1711,"vripara":null,"refs":[],"lines":["Dhammā ceva sudhammā ca, sattamī saṅghadāyikā."],"lineRefs":[[]]},{"para":1712,"vripara":null,"refs":[],"lines":["“Ahaṃ uppalavaṇṇā ca, khemā bhaddā ca bhikkhunī;"],"lineRefs":[[]]},{"para":1713,"vripara":null,"refs":[],"lines":["Kisāgotamī dhammadinnā, visākhā hoti sattamī."],"lineRefs":[[]]},{"para":1714,"vripara":null,"refs":[],"lines":["“Tehi kammehi sukatehi, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":1715,"vripara":null,"refs":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":1716,"vripara":null,"refs":[],"lines":["“Pacchime ca bhave dāni, jātā seṭṭhikule ahaṃ;"],"lineRefs":[[]]},{"para":1717,"vripara":null,"refs":[],"lines":["Sāvatthiyaṃ puravare, iddhe phīte mahaddhane."],"lineRefs":[[]]},{"para":1718,"vripara":null,"refs":[],"lines":["“Yadā ca yobbanūpetā, vitakkavasagā ahaṃ;"],"lineRefs":[[]]},{"para":1719,"vripara":null,"refs":[],"lines":["Naraṃ jārapatiṃ disvā, tena saddhiṃ agacchahaṃ."],"lineRefs":[[]]},{"para":1720,"vripara":null,"refs":[],"lines":["“Ekaputtapasūtāhaṃ, dutiyo kucchiyā mama;"],"lineRefs":[[]]},{"para":1721,"vripara":null,"refs":[],"lines":["Tadāhaṃ mātāpitaro, okkhāmīti sunicchitā."],"lineRefs":[[]]},{"para":1722,"vripara":null,"refs":[],"lines":["“Nārocesiṃ patiṃ mayhaṃ, tadā tamhi pavāsite;"],"lineRefs":[[]]},{"para":1723,"vripara":null,"refs":[],"lines":["Ekikā niggatā gehā, gantuṃ sāvatthimuttamaṃ."],"lineRefs":[[]]},{"para":1724,"vripara":null,"refs":[],"lines":["“Tato me sāmi āgantvā, sambhāvesi pathe mamaṃ;"],"lineRefs":[[]]},{"para":1725,"vripara":null,"refs":[],"lines":["Tadā me kammajā vātā, uppannā atidāruṇā."],"lineRefs":[[]]},{"para":1726,"vripara":null,"refs":[],"lines":["“Uṭṭhito ca mahāmegho, pasūtisamaye mama;"],"lineRefs":[[]]},{"para":1727,"vripara":null,"refs":[],"lines":["Dabbatthāya tadā gantvā, sāmi sappena mārito."],"lineRefs":[[]]},{"para":1728,"vripara":null,"refs":[],"lines":["“Tadā vijātadukkhena, anāthā kapaṇā ahaṃ;"],"lineRefs":[[]]},{"para":1729,"vripara":null,"refs":[],"lines":["Kunnadiṃ pūritaṃ disvā, gacchantī sakulālayaṃ."],"lineRefs":[[]]},{"para":1730,"vripara":null,"refs":[],"lines":["“Bālaṃ ādāya atariṃ, pārakūle ca ekakaṃ;"],"lineRefs":[[]]},{"para":1731,"vripara":null,"refs":[],"lines":["Sāyetvā bālakaṃ puttaṃ, itaraṃ taraṇāyahaṃ."],"lineRefs":[[]]},{"para":1732,"vripara":null,"refs":[],"lines":["“Nivattā ukkuso hāsi, taruṇaṃ vilapantakaṃ;"],"lineRefs":[[]]},{"para":1733,"vripara":null,"refs":[],"lines":["Itarañca vahī soto, sāhaṃ sokasamappitā."],"lineRefs":[[]]},{"para":1734,"vripara":null,"refs":[],"lines":["“Sāvatthinagaraṃ gantvā, assosiṃ sajane mate;"],"lineRefs":[[]]},{"para":1735,"vripara":null,"refs":[],"lines":["Tadā avocaṃ sokaṭṭā, mahāsokasamappitā."],"lineRefs":[[]]},{"para":1736,"vripara":null,"refs":[],"lines":["“Ubho puttā kālaṅkatā, panthe mayhaṃ patī mato;"],"lineRefs":[[]]},{"para":1737,"vripara":null,"refs":[],"lines":["Mātā pitā ca bhātā ca, ekacitamhi ḍayhare."],"lineRefs":[[]]},{"para":1738,"vripara":null,"refs":[],"lines":["“Tadā kisā ca paṇḍu ca, anāthā dīnamānasā;"],"lineRefs":[[]]},{"para":1739,"vripara":null,"refs":[],"lines":["Ito tato bhamantīhaṃ, addasaṃ narasārathiṃ."],"lineRefs":[[]]},{"para":1740,"vripara":null,"refs":[],"lines":["“Tato avoca maṃ satthā, putte mā soci assasa;"],"lineRefs":[[]]},{"para":1741,"vripara":null,"refs":[],"lines":["Attānaṃ te gavesassu, kiṃ niratthaṃ vihaññasi."],"lineRefs":[[]]},{"para":1742,"vripara":null,"refs":[],"lines":["“Na santi puttā tāṇāya, na ñātī nāpi bandhavā;"],"lineRefs":[[]]},{"para":1743,"vripara":null,"refs":[],"lines":["Antakenādhipannassa, natthi ñātīsu tāṇatā."],"lineRefs":[[]]},{"para":1744,"vripara":null,"refs":[],"lines":["“Taṃ sutvā munino vākyaṃ, paṭhamaṃ phalamajjhagaṃ;"],"lineRefs":[[]]},{"para":1745,"vripara":null,"refs":[],"lines":["Pabbajitvāna naciraṃ, arahattamapāpuṇiṃ."],"lineRefs":[[]]},{"para":1746,"vripara":null,"refs":[],"lines":["“Iddhīsu ca vasī homi, dibbāya sotadhātuyā;"],"lineRefs":[[]]},{"para":1747,"vripara":null,"refs":[],"lines":["Paracittāni jānāmi, satthusāsanakārikā."],"lineRefs":[[]]},{"para":1748,"vripara":null,"refs":[],"lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"],"lineRefs":[[]]},{"para":1749,"vripara":null,"refs":[],"lines":["Khepetvā āsave sabbe, visuddhāsiṃ sunimmalā."],"lineRefs":[[]]},{"para":1750,"vripara":null,"refs":[],"lines":["“Tatohaṃ vinayaṃ sabbaṃ, santike sabbadassino;"],"lineRefs":[[]]},{"para":1751,"vripara":null,"refs":[],"lines":["Uggahiṃ sabbavitthāraṃ, byāhariñca yathātathaṃ."],"lineRefs":[[]]},{"para":1752,"vripara":null,"refs":[],"lines":["“Jino tasmiṃ guṇe tuṭṭho, etadagge ṭhapesi maṃ;"],"lineRefs":[[]]},{"para":1753,"vripara":null,"refs":[],"lines":["Aggā vinayadhārīnaṃ, paṭācārāva ekikā."],"lineRefs":[[]]},{"para":1754,"vripara":null,"refs":[],"lines":["“Pariciṇṇo mayā satthā, kataṃ buddhassa sāsanaṃ;"],"lineRefs":[[]]},{"para":1755,"vripara":null,"refs":[],"lines":["Ohito garuko bhāro, bhavanetti samūhatā."],"lineRefs":[[]]},{"para":1756,"vripara":null,"refs":[],"lines":["“Yassatthāya pabbajitā, agārasmānagāriyaṃ;"],"lineRefs":[[]]},{"para":1757,"vripara":null,"refs":[],"lines":["So me attho anuppatto, sabbasaṃyojanakkhayo."],"lineRefs":[[]]},{"para":1758,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":1759,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā sekkhakāle attano paṭipattiṃ paccavekkhitvā uparivisesassa nibbattitākāraṃ vibhāventī udānavasena –"],"lineRefs":[[]]},{"para":1761,"vripara":"112","refs":[],"lines":["“Naṅgalehi kasaṃ khettaṃ, bījāni pavapaṃ chamā;"],"lineRefs":[[]]},{"para":1762,"vripara":null,"refs":[],"lines":["Puttadārāni posentā, dhanaṃ vindanti māṇavā."],"lineRefs":[[]]},{"para":1764,"vripara":"113","refs":[],"lines":["“Kimahaṃ sīlasampannā, satthusāsanakārikā;"],"lineRefs":[[]]},{"para":1765,"vripara":null,"refs":[],"lines":["Nibbānaṃ nādhigacchāmi, akusītā anuddhatā."],"lineRefs":[[]]},{"para":1767,"vripara":"114","refs":[],"lines":["“Pāde pakkhālayitvāna, udakesu karomahaṃ;"],"lineRefs":[[]]},{"para":1768,"vripara":null,"refs":[],"lines":["Pādodakañca disvāna, thalato ninnamāgataṃ."],"lineRefs":[[]]},{"para":1770,"vripara":"115","refs":[],"lines":["“Tato cittaṃ samādhesiṃ, assaṃ bhadraṃvajāniyaṃ;"],"lineRefs":[[]]},{"para":1771,"vripara":null,"refs":[],"lines":["Tato dīpaṃ gahetvāna, vihāraṃ pāvisiṃ ahaṃ;"],"lineRefs":[[]]},{"para":1772,"vripara":null,"refs":[],"lines":["Seyyaṃ olokayitvāna, mañcakamhi upāvisiṃ."],"lineRefs":[[]]},{"para":1774,"vripara":"116","refs":[],"lines":["“Tato sūciṃ gahetvāna, vaṭṭiṃ okassayāmahaṃ;"],"lineRefs":[[]]},{"para":1775,"vripara":null,"refs":[],"lines":["Padīpasseva nibbānaṃ, vimokkho ahu cetaso”ti.","– imā gāthā abhāsi;"],"lineRefs":[[],[]]},{"para":1776,"vripara":null,"refs":[],"lines":["Tattha <b>kasan</b>ti kasantā kasikammaṃ karontā.","Bahutthe hi idaṃ ekavacanaṃ.","<b>Pavapan</b>ti bījāni vapantā.","<b>Chamā</b>ti chamāyaṃ.","Bhummatthe hi idaṃ paccattavacanaṃ.","Ayañhettha saṅkhepattho – ime māṇavā sattā naṅgalehi phālehi khettaṃ kasantā yathādhippāyaṃ khettabhūmiyaṃ pubbaṇṇāparaṇṇabhedāni bījāni vapantā taṃhetu taṃnimittaṃ attānaṃ puttadārādīni posentā hutvā dhanaṃ paṭilabhanti.","Evaṃ imasmiṃ loke yoniso payutto paccattapurisakāro nāma saphalo saudayo."],"lineRefs":[[],[],[],[],[],[],[]]},{"para":1777,"vripara":null,"refs":[],"lines":["Tattha <b>kimahaṃ sīlasampannā, satthusāsanakārikā.</b>","<b>Nibbānaṃ nādhigacchāmi, akusītā anuddhatā</b>ti ahaṃ suvisuddhasīlā āraddhavīriyatāya akusītā ajjhattaṃ susamāhitacittatāya anuddhatā ca hutvā catusaccakammaṭṭhānabhāvanāsaṅkhātaṃ satthu sāsanaṃ karontī kasmā nibbānaṃ nādhigacchāmi, adhigamissāmi evāti."],"lineRefs":[[],[]]},{"para":1778,"vripara":null,"refs":[],"lines":["Evaṃ pana cintetvā vipassanāya kammaṃ karontī ekadivasaṃ pādadhovanaudake nimittaṃ gaṇhi.","Tenāha <b>“pāde pakkhālayitvānā”</b>tiādi.","Tassattho – ahaṃ pāde dhovantī pādapakkhālanahetu tikkhattuṃ āsittesu udakesu thalato ninnamāgataṃ pādodakaṃ disvā nimittaṃ karomi."],"lineRefs":[[],[],[]]},{"para":1779,"vripara":null,"refs":[],"lines":["“Yathā idaṃ udakaṃ khayadhammaṃ vayadhammaṃ, evaṃ sattānaṃ āyusaṅkhārā”ti evaṃ aniccalakkhaṇaṃ, tadanusārena dukkhalakkhaṇaṃ, anattalakkhaṇañca upadhāretvā vipassanaṃ vaḍḍhentī <b>tato cittaṃ samādhesiṃ, assaṃ bhadraṃvajāniyan</b>ti yathā assaṃ bhadraṃ ājāniyaṃ kusalo sārathi sukhena sāreti, evaṃ mayhaṃ cittaṃ sukheneva samādhesiṃ, vipassanāsamādhinā samāhitaṃ akāsiṃ.","Evaṃ pana vipassanaṃ vaḍḍhentī utusappāyanijigisāya ovarakaṃ pavisantī andhakāravidhamanatthaṃ dīpaṃ gahetvā gabbhaṃ pavisitvā dīpaṃ ṭhapetvā mañcake nisinnamattāva dīpaṃ vijjhāpetuṃ aggaḷasūciyā dīpavaṭṭiṃ ākaḍḍhiṃ, tāvadeva utusappāyalābhena tassā cittaṃ samāhitaṃ ahosi, vipassanāvīthiṃ otari, maggena ghaṭṭesi.","Tato maggapaṭipāṭiyā sabbaso āsavānaṃ khayo ahosi.","Tena vuttaṃ –","<b>“tato dīpaṃ gahetvāna … pe … vimokkho ahu cetaso”</b>ti.","Tattha <b>seyyaṃ olokayitvānā</b>ti dīpālokena seyyaṃ passitvā."],"lineRefs":[[],[],[],[],[],[]]}]},"tika":null,"tika2":null}
