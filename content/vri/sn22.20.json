{"suttaId":"sn22.20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[128,128],"vripara":"20"},"segments":{"sn22.20:0.3":"Sahetuanattasuttaṃ","sn22.20:1.1":"Sāvatthinidānaṃ.","sn22.20:1.2":"“Rūpaṃ, bhikkhave, anattā.","sn22.20:1.3":"Yopi hetu yopi paccayo rūpassa uppādāya, sopi anattā.","sn22.20:1.4":"Anattasambhūtaṃ, bhikkhave, rūpaṃ kuto attā bhavissati!","sn22.20:1.5":"Vedanā anattā …","sn22.20:1.6":"saññā anattā …","sn22.20:1.7":"saṅkhārā anattā …","sn22.20:1.8":"viññāṇaṃ anattā.","sn22.20:1.9":"Yopi hetu yopi paccayo viññāṇassa uppādāya, sopi anattā.","sn22.20:1.10":"Anattasambhūtaṃ, bhikkhave, viññāṇaṃ kuto attā bhavissati!","sn22.20:1.11":"Evaṃ passaṃ … pe …","sn22.20:1.12":"nāparaṃ itthattāyāti pajānātī”ti.","sn22.20:1.13":"Navamaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":70,"to":73,"paras":[{"para":70,"vripara":"12-21","refs":["sn22.20:1"],"lines":["12-21. Aniccavagge pariyosānasuttaṃ pucchāvasikaṃ, sesāni tathā tathā bujjhanakānañca vasena desitānīti.","Paṭhamādīni."],"lineRefs":[["sn22.20:1"],["sn22.20:1"]]},{"para":71,"vripara":null,"refs":["sn22.20:1"],"lines":["Aniccavaggo dutiyo."],"lineRefs":[["sn22.20:1"]]},{"para":72,"vripara":null,"refs":["sn22.20:1"],"lines":["Bhāravaggo"],"lineRefs":[["sn22.20:1"]]},{"para":73,"vripara":null,"refs":["sn22.20:1"],"lines":["Bhārasuttavaṇṇanā"],"lineRefs":[["sn22.20:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":66,"to":70,"paras":[{"para":66,"vripara":"12-21","refs":["sn22.20:1"],"lines":["12-21. <b>Pucchāvasikaṃ</b> ānandattherassa pucchāvasena desitattā."],"lineRefs":[["sn22.20:1"]]},{"para":67,"vripara":null,"refs":["sn22.20:1"],"lines":["Aniccādisuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.20:1"]]},{"para":68,"vripara":null,"refs":["sn22.20:1"],"lines":["Aniccavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.20:1"]]},{"para":69,"vripara":n