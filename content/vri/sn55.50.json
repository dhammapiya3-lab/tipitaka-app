{"suttaId":"sn55.50","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[2346,2351],"vripara":"1046"},"segments":{"sn55.50:0.3":"Aṅgasuttaṃ","sn55.50:1.1":"“Cattārimāni, bhikkhave, sotāpattiyaṅgāni.","sn55.50:1.2":"Katamāni cattāri?","sn55.50:1.3":"Sappurisasaṃsevo, saddhammassavanaṃ, yonisomanasikāro, dhammānudhammappaṭipatti –","sn55.50:1.4":"imāni kho, bhikkhave, cattāri sotāpattiyaṅgānī”ti.","sn55.50:1.5":"Dasamaṃ.","sn55.50:1.6":"Sagāthakapuññābhisandavaggo pañcamo.","sn55.50:2.0":"Tassuddānaṃ –","sn55.50:2.1":"Abhisandā tayo vuttā,","sn55.50:2.2":"duve mahaddhanena ca;","sn55.50:2.3":"Suddhaṃ nandiyaṃ bhaddiyaṃ,","sn55.50:2.4":"mahānāmaṅgena te dasāti."},"unsure":[],"attha":null,"tika":null,"tika2":null}
