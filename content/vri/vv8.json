{"suttaId":"vv8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[207,244],"vripara":"63"},"segments":{"vv8:0.4":"Tatiyanāvāvimānavatthu","vv8:1.1":"“Suvaṇṇacchadanaṃ nāvaṃ,","vv8:1.2":"nāri āruyha tiṭṭhasi;","vv8:1.3":"Ogāhasi pokkharaṇiṃ,","vv8:1.4":"padmaṃ chindasi pāṇinā. 64.","vv8:2.1":"“Kūṭāgārā nivesā te,","vv8:2.2":"vibhattā bhāgaso mitā;","vv8:2.3":"Daddallamānā [daddaḷhamānā (ka.)] ābhanti,","vv8:2.4":"samantā caturo disā. 65.","vv8:3.1":"“Kena tetādiso vaṇṇo,","vv8:3.2":"kena te idha mijjhati;","vv8:3.3":"Uppajjanti ca te bhogā,","vv8:3.4":"ye keci manaso piyā. 66.","vv8:4.1":"“Pucchāmi taṃ devi mahānubhāve,","vv8:4.2":"manussabhūtā kimakāsi puññaṃ;","vv8:4.3":"Kenāsi evaṃ jalitānubhāvā,","vv8:4.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti. 67.","vv8:5.1":"Sā devatā attamanā,","vv8:5.2":"sambuddheneva pucchitā;","vv8:5.3":"Pañhaṃ puṭṭhā viyākāsi,","vv8:5.4":"yassa kammassidaṃ phalaṃ. 68.","vv8:6.1":"“Ahaṃ manussesu manussabhūtā,","vv8:6.2":"purimāya jātiyā manussaloke;","vv8:6.3":"Disvāna bhikkhū tasite kilante,","vv8:6.4":"uṭṭhāya pātuṃ udakaṃ adāsiṃ. 69.","vv8:7.1":"“Yo ve kilantāna pipāsitānaṃ,","vv8:7.2":"uṭṭhāya pātuṃ udakaṃ dadāti;","vv8:7.3":"Sītodakā tassa bhavanti najjo,","vv8:7.4":"pahūtamalyā bahupuṇḍarīkā. 70.","vv8:8.1":"“Taṃ āpagā anupariyanti sabbadā,","vv8:8.2":"sītodakā vālukasanthatā nadī;","vv8:8.3":"Ambā ca sālā tilakā ca jambuyo,","vv8:8.4":"uddālakā pāṭaliyo ca phullā. 71.","vv8:9.1":"“Taṃ bhūmibhāgehi upetarūpaṃ,","vv8:9.2":"vimānaseṭṭhaṃ bhusasobhamānaṃ;","vv8:9.3":"Tassīdha kammassa ayaṃ vipāko,","vv8:9.4":"etādisaṃ puññakatā labhanti. 72.","vv8:10.1":"“Kūṭāgārā nivesā me,","vv8:10.2":"vibhattā bhāgaso mitā;","vv8:10.3":"Daddallamānā ābhanti,","vv8:10.4":"samantā caturo disā. 73.","vv8:11.1":"“Tena metādiso vaṇṇo,","vv8:11.2":"tena me idha mijjhati;","vv8:11.3":"Uppajjanti ca me bhogā,","vv8:11.4":"ye keci manaso piyā. 74.","vv8:12.1":"“Akkhāmi te buddha mahānubhāva,","vv8:12.2":"manussabhūtā yamakāsi puññaṃ;","vv8:12.3":"Tenamhi evaṃ jalitānubhāvā,","vv8:12.4":"vaṇṇo ca me sabbadisā pabhāsati;","vv8:12.5":"Etassa kammassa phalaṃ mamedaṃ,","vv8:12.6":"atthāya buddho udakaṃ apāyī”ti [apāsīti (sī. syā. pī.)].","vv8:13.1":"Tatiyanāvāvimānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":375,"to":376,"paras":[{"para":375,"vripara":"72","refs":["vv8:10"],"lines":["<b>Kūṭāgārā</b>ti suvaṇṇamayakaṇṇikābaddhagehavanto.","<b>Nivesā</b>ti nivesanāni, kaccharānīti attho.","Tenāha “vibhattā bhāgaso mitā”ti.","Tāni hi catusālabhūtāni aññamaññassa paṭibimbabhūtāni viya paṭivibhattarūpāni samappamāṇatāya bhāgaso mitāni viya honti.","<b>Daddallamānā</b>ti ativiya vijjotamānā.","<b>Ābhantī</b>ti maṇiratanakanakaraṃsijālehi obhāsenti. 74."],"lineRefs":[["vv8:10"],["vv8:10"],["vv8:10"],["vv8:10"],["vv8:10"],["vv8:10"]]},{"para":376,"vripara":"74","refs":["vv8:12"],"lines":["<b>Mamā</b>ti idaṃ pubbāparāpekkhaṃ, mama kammassa mama atthāyāti ayañhettha yojanā.","<b>Udakaṃ apāyī</b>ti yadetaṃ udakadānaṃ vuttaṃ, etassa puññakammassa idaṃ phalaṃ yāyaṃ dibbasampatti, yasmā mamatthāya sadevake loke aggadakkhiṇeyyo buddho bhagavā mayā dinnaṃ udakaṃ apāyīti.","Sesaṃ vuttanayameva."],"lineRefs":[["vv8:12"],["vv8:12"],["vv8:12"]]}],"wordLinks":[["vv8:10.1","kūṭāgārā",0,0],["vv8:10.1","nivesā",0,1],["vv8:10.3","daddallamānā",0,4],["vv8:10.3","ābhantī",0,5],["vv8:12.5","mamā",1,0],["vv8:12.5","udakaṃ apāyī",1,1]],"after":[{"para":377,"vripara":null,"title":"Tatiyanāvāvimānavaṇṇanā","lines":["Evaṃ pasannamānasāya devatāya bhagavā sāmukkaṃsikaṃ dhammadesanaṃ karonto saccāni pakāsesi.","Sā desanāpariyosāne sotāpattiphale patiṭṭhahi, sampattaparisāyapi dhammadesanā sātthikā ahosi."]},{"para":378,"vripara":null,"title":"Tatiyanāvāvimānavaṇṇanā","lines":["Tatiyanāvāvimānavaṇṇanā niṭṭhitā. 9."]}]},"tika":null,"tika2":null}
