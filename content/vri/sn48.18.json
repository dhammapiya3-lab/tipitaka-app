{"suttaId":"sn48.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1207,1207],"vripara":"488"},"segments":{"sn48.18:0.3":"Paṭipannasuttaṃ","sn48.18:1.1":"“Pañcimāni, bhikkhave, indriyāni.","sn48.18:1.2":"Katamāni pañca?","sn48.18:1.3":"Saddhindriyaṃ…pe… paññindriyaṃ –","sn48.18:1.4":"imāni kho, bhikkhave, pañcindriyāni.","sn48.18:1.5":"Imesaṃ kho, bhikkhave, pañcannaṃ indriyānaṃ samattā paripūrattā arahaṃ hoti, tato mudutarehi arahattaphalasacchikiriyāya paṭipanno hoti, tato mudutarehi anāgāmī hoti, tato mudutarehi anāgāmiphalasacchikiriyāya paṭipanno hoti, tato mudutarehi sakadāgāmī hoti, tato mudutarehi sakadāgāmiphalasacchikiriyāya paṭipanno hoti, tato mudutarehi sotāpanno hoti, tato mudutarehi sotāpattiphalasacchikiriyāya paṭipanno hoti.","sn48.18:1.6":"Yassa kho, bhikkhave, imāni pañcindriyāni sabbena sabbaṃ sabbathā sabbaṃ natthi, tamahaṃ ‘bāhiro puthujjanapakkhe ṭhito’ti vadāmī”ti.","sn48.18:1.7":"Aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":554,"to":554,"paras":[{"para":554,"vripara":"488","refs":["sn48.18:1"],"lines":["Aṭṭhame <b>tato mudutarehī</b>ti maggaphalavasena nissakkaṃ veditabbaṃ.","Taṃ pāḷiyaṃ vuttameva.","<b>Bāhiro</b>ti imehi aṭṭhahi puggalehi bahibhūto.","<b>Puthujjanapakkhe ṭhito</b>ti puthujjanakoṭṭhāse ṭhito.","Imasmiṃ sutte lokuttarāneva indriyāni kathitāni. 9-10."],"lineRefs":[["sn48.18:1"],["sn48.18:1"],["sn48.18:1"],["sn48.18:1"],["sn48.18:1"]]}],"wordLinks":[["sn48.18:1.5","tato mudutarehī",0,0],["sn48.18:1.6","bāhiro",0,2],["sn48.18:1.6","puthujjanapakkhe ṭhito",0,3]]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":480,"to":481,"paras":[{"para":480,"vripara":"488","refs":["sn48.18:1"],"lines":["<b>Ta</b>nti maggaphalavasena nissakkaṃ.","<b>Pāḷiyaṃ vuttameva</b> “arahattaphalasacchikiriyāya paṭipanno hotī”tiādinā.","<b>Aṭṭhahī</b>ti catūhi phalehi catūhi ca maggehīti aṭṭhahi.","<b>Bahibhūto</b> na antobhāvo.","<b>Lokuttarāneva indriyāni kathitāni</b> maggaphalacittuppādapariyāpannattā. 9-10."],"lineRefs":[["sn48.18:1"],["sn48.18:1"],["sn48.18:1"],["sn48.18:1"],["sn48.18:1"]]},{"para":481,"vripara":null,"refs":["sn48.18:1"],"lines":["Sampannasuttādivaṇṇanā 489-490."],"lineRefs":[["sn48.18:1"]]}],"wordLinks":[]},"tika2":null}
