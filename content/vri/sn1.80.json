{"suttaId":"sn1.80","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[869,877],"vripara":"80"},"segments":{"sn1.80:0.3":"Pajjotasuttaṃ","sn1.80:1.1":"“Kiṃsu lokasmi pajjoto,","sn1.80:1.2":"kiṃsu lokasmi jāgaro;","sn1.80:1.3":"Kiṃsu kamme sajīvānaṃ,","sn1.80:1.4":"kimassa iriyāpatho.","sn1.80:2.1":"“Kiṃsu alasaṃ analasañca [kiṃ ālasyānālasyañca (ka.)],","sn1.80:2.2":"mātā puttaṃva posati;","sn1.80:2.3":"Kiṃ bhūtā upajīvanti,","sn1.80:2.4":"ye pāṇā pathavissitā”ti.","sn1.80:3.1":"“Paññā lokasmi pajjoto,","sn1.80:3.2":"sati lokasmi jāgaro;","sn1.80:3.3":"Gāvo kamme sajīvānaṃ,","sn1.80:3.4":"sītassa iriyāpatho.","sn1.80:4.1":"“Vuṭṭhi alasaṃ analasañca,","sn1.80:4.2":"mātā puttaṃva posati;","sn1.80:4.3":"Vuṭṭhiṃ bhūtā upajīvanti,","sn1.80:4.4":"ye pāṇā pathavissitā”ti. 11."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":497,"to":497,"paras":[{"para":497,"vripara":"80","refs":["sn1.80:1","sn1.80:3"],"lines":["Dasame <b>pajjoto</b>ti padīpo viya hoti.","<b>Jāgaro</b>ti jāgarabrāhmaṇo viya hoti.","<b>Gāvo kamme sajīvāna</b>nti kammena saha jīvantānaṃ gāvova kamme kammasahāyā kammadutiyakā nāma honti.","Gomaṇḍalehi saddhiṃ kasikammādīni nipphajjanti.","<b>Sītassa iriyāpatho</b>ti sītaṃ assa sattakāyassa iriyāpatho jīvitavutti.","<b>Sīta</b>nti naṅgalaṃ.","Yassa hi naṅgalehi khettaṃ appamattakampi kaṭṭhaṃ na hoti, so kathaṃ jīvissatīti vadati.","Dasamaṃ. 11."],"lineRefs":[["sn1.80:1"],["sn1.80:1"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"]]}],"wordLinks":[["sn1.80:1.1","pajjoto",0,0],["sn1.80:1.1","jāgaro",0,1],["sn1.80:3.3","gāvo kamme sajīvānaṃ",0,2],["sn1.80:3.3","sītassa iriyāpatho",0,4],["sn1.80:3.3","sītaṃ",0,5]],"before":[{"para":496,"vripara":null,"title":"Pajjotasuttavaṇṇanā","lines":["Pajjotasuttavaṇṇanā 80."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":623,"to":623,"paras":[{"para":623,"vripara":"80","refs":["sn1.80:1","sn1.80:3"],"lines":["Taṃ taṃ samavisamaṃ pajjotatīti <b>pajjoto</b>.","Padīpo andhakāraṃ vidhamitvā paccakkhato rūpagataṃ dasseti, evaṃ paññāpajjoto avijjandhakāraṃ vidhamitvā dhammānaṃ paramatthabhūtaṃ rūpaṃ dasseti.","<b>Jāgarabrāhmaṇo viyā</b>ti jāgarakhīṇāsavabrāhmaṇo viya.","So hi satipaññāvepullappattiyā sabbadāpi jāgaro hoti.","<b>Gāvo</b>ti gojātiyo.","Idaṃ gunnaṃ goṇānañca sāmaññato gahaṇaṃ.","<b>Kamme</b>ti karaṇatthe bhummavacanaṃ.","Jīvanaṃ jīvo, saha jīvenāti <b>sajīvino</b>.","Tenāha <b>“kammena saha jīvantāna”</b>nti, kasivāṇijjādikammaṃ katvā jīvantānanti attho.","<b>Gomaṇḍalehi saddhi</b>nti gogaṇena saha.","Na tena vinā kasikammādīni uppajjanti, gorasasiddhiyā ceva kasanabhāravahanasiddhiyā ca kasikammaekaccavāṇijjakammādīni ijjhanti.","<b>Sattakāyassā</b>ti āhārupajīvino sattakāyassa kasito aññathā jīvikaṃ kappentassapi kasijīvitavuttiyā mūlakāraṇaṃ phalanipphattinimittattā tassa.","<b>Iriyāpatho</b> ca iriyanakiriyānaṃ pavattanupāyo.","<b>“Sīta</b>nti naṅgalasītakamma”nti vadanti."],"lineRefs":[["sn1.80:1"],["sn1.80:1"],["sn1.80:1"],["sn1.80:1"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"],["sn1.80:3"]]}],"wordLinks":[["sn1.80:1.1","pajjoto",0,0],["sn1.80:3.3","gāvo",0,4],["sn1.80:3.3","kamme",0,6],["sn1.80:3.3","iriyāpatho",0,12],["sn1.80:3.3","sītaṃ",0,13]],"before":[{"para":622,"vripara":null,"title":"Pajjotasuttavaṇṇanā","lines":["Pajjotasuttavaṇṇanā 80."]}],"after":[{"para":624,"vripara":null,"title":"Pajjotasuttavaṇṇanā","lines":["Pajjotasuttavaṇṇanā niṭṭhitā. 11."]}]},"tika2":null}
