{"suttaId":"sn17.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1109,1109],"vripara":"167"},"segments":{"sn17.11:0.3":"Suvaṇṇapātisuttaṃ","sn17.11:1.1":"Sāvatthiyaṃ viharati … pe …","sn17.11:1.2":"“dāruṇo, bhikkhave, lābhasakkārasiloko … pe … adhigamāya.","sn17.11:1.3":"Idhāhaṃ, bhikkhave, ekaccaṃ puggalaṃ evaṃ cetasā ceto paricca pajānāmi –","sn17.11:1.4":"‘na cāyamāyasmā suvaṇṇapātiyāpi rūpiyacuṇṇaparipūrāya hetu sampajānamusā bhāseyyā’ti.","sn17.11:1.5":"Tamenaṃ passāmi aparena samayena lābhasakkārasilokena abhibhūtaṃ pariyādiṇṇacittaṃ sampajānamusā bhāsantaṃ.","sn17.11:1.6":"Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko … pe …","sn17.11:1.7":"evañhi vo, bhikkhave, sikkhitabban”ti.","sn17.11:1.8":"Paṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":803,"to":803,"paras":[{"para":803,"vripara":"167-168","refs":["sn17.11:1"],"lines":["167-168. Dutiyavaggassa paṭhame <b>sampajānamusā bhāsantan</b>ti appamattakenapi kāraṇena sampajānameva musā bhāsantaṃ.","“Sīlaṃ pūressāmī”ti saṃvihitabhikkhuṃ sinerumattopi paccayarāsi cāletuṃ na sakkoti.","Yadā pana sīlaṃ pahāya sakkāranissito hoti, tadā kuṇḍakamuṭṭhihetupi musā bhāsati, aññaṃ vā akiccaṃ karoti.","Dutiyaṃ uttānamevāti.","Paṭhamadutiyāni."],"lineRefs":[["sn17.11:1"],["sn17.11:1"],["sn17.11:1"],["sn17.11:1"],["sn17.11:1"]]}],"wordLinks":[["sn17.11:1.5","sampajānamusā bhāsantaṃ",0,0]],"before":[{"para":800,"vripara":null,"refs":[],"lines":["Paṭhamo vaggo."],"lineRefs":[[]]},{"para":801,"vripara":null,"refs":[],"lines":["Dutiyavaggo"],"lineRefs":[[]]},{"para":802,"vripara":null,"refs":[],"lines":["1-2. Suvaṇṇapātisuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":810,"to":814,"paras":[{"para":810,"vripara":"167-168","refs":["sn17.11:1"],"lines":["167-168. <b>Cāletuṃ na sakkoti</b> sīlapabbatasannissitattā.","<b>Aññaṃ vā kiccaṃ karoti</b> pageva sīlassa chaḍḍitattā.","Tatiyādīsu apubbaṃ natthi."],"lineRefs":[["sn17.11:1"],["sn17.11:1"],["sn17.11:1"]]},{"para":811,"vripara":null,"refs":["sn17.11:1"],"lines":["Suvaṇṇapātisuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn17.11:1"]]},{"para":812,"vripara":null,"refs":["sn17.11:1"],"lines":["Dutiyavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn17.11:1"]]},{"para":813,"vripara":null,"refs":["sn17.11:1"],"lines":["Tatiyavaggo"],"lineRefs":[["sn17.11:1"]]},{"para":814,"vripara":null,"refs":["sn17.11:1"],"lines":["Mātugāmasuttavaṇṇanā"],"lineRefs":[["sn17.11:1"]]}],"wordLinks":[],"before":[{"para":806,"vripara":null,"refs":[],"lines":["Sagāthakasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":807,"vripara":null,"refs":[],"lines":["Paṭhamavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":808,"vripara":null,"refs":[],"lines":["Dutiyavaggo"],"lineRefs":[[]]},{"para":809,"vripara":null,"refs":[],"lines":["1-2. Suvaṇṇapātisuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
