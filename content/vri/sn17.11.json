{"suttaId":"sn17.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1109,1109],"vripara":"167"},"segments":{"sn17.11:0.3":"Suvaṇṇapātisuttaṃ","sn17.11:1.1":"Sāvatthiyaṃ viharati…pe…","sn17.11:1.2":"“dāruṇo, bhikkhave, lābhasakkārasiloko…pe… adhigamāya.","sn17.11:1.3":"Idhāhaṃ, bhikkhave, ekaccaṃ puggalaṃ evaṃ cetasā ceto paricca pajānāmi –","sn17.11:1.4":"‘na cāyamāyasmā suvaṇṇapātiyāpi rūpiyacuṇṇaparipūrāya hetu sampajānamusā bhāseyyā’ti.","sn17.11:1.5":"Tamenaṃ passāmi aparena samayena lābhasakkārasilokena abhibhūtaṃ pariyādiṇṇacittaṃ sampajānamusā bhāsantaṃ.","sn17.11:1.6":"Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko…pe…","sn17.11:1.7":"evañhi vo, bhikkhave, sikkhitabba”nti.","sn17.11:1.8":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":803,"to":803,"paras":[{"para":803,"vripara":"167-168","refs":["sn17.11:1"],"lines":["Dutiyavaggassa paṭhame <b>sampajānamusā bhāsanta</b>nti appamattakenapi kāraṇena sampajānameva musā bhāsantaṃ.","“Sīlaṃ pūressāmī”ti saṃvihitabhikkhuṃ sinerumattopi paccayarāsi cāletuṃ na sakkoti.","Yadā pana sīlaṃ pahāya sakkāranissito hoti, tadā kuṇḍakamuṭṭhihetupi musā bhāsati, aññaṃ vā akiccaṃ karoti.","Dutiyaṃ uttānamevāti.","Paṭhamadutiyāni. 3-10."],"lineRefs":[["sn17.11:1"],["sn17.11:1"],["sn17.11:1"],["sn17.11:1"],["sn17.11:1"]]}],"wordLinks":[["sn17.11:1.5","sampajānamusā bhāsantaṃ",0,0]],"before":[{"para":801,"vripara":null,"title":"Dutiyavaggo","lines":["Dutiyavaggo 1-2."]},{"para":802,"vripara":null,"title":"Suvaṇṇapātisuttādivaṇṇanā","lines":["Suvaṇṇapātisuttādivaṇṇanā 167-168."]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":810,"to":814,"paras":[{"para":810,"vripara":"167-168","refs":["sn17.11:1"],"lines":["<b>Cāletuṃ na sakkoti</b> sīlapabbatasannissitattā.","<b>Aññaṃ vā kiccaṃ karoti</b> pageva sīlassa chaḍḍitattā.","Tatiyādīsu apubbaṃ natthi."],"lineRefs":[["sn17.11:1"],["sn17.11:1"],["sn17.11:1"]]},{"para":811,"vripara":null,"refs":["sn17.11:1"],"lines":["Suvaṇṇapātisuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn17.11:1"]]},{"para":812,"vripara":null,"refs":["sn17.11:1"],"lines":["Dutiyavaggavaṇṇanā niṭṭhitā. 3."],"lineRefs":[["sn17.11:1"]]},{"para":813,"vripara":null,"refs":["sn17.11:1"],"lines":["Tatiyavaggo 1."],"lineRefs":[["sn17.11:1"]]},{"para":814,"vripara":null,"refs":["sn17.11:1"],"lines":["Mātugāmasuttavaṇṇanā 170."],"lineRefs":[["sn17.11:1"]]}],"wordLinks":[],"before":[{"para":808,"vripara":null,"title":"Dutiyavaggo","lines":["Dutiyavaggo 1-2."]},{"para":809,"vripara":null,"title":"Suvaṇṇapātisuttādivaṇṇanā","lines":["Suvaṇṇapātisuttādivaṇṇanā 167-168."]}]},"tika2":null}
