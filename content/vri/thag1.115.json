{"suttaId":"thag1.115","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[665,668],"vripara":"115"},"segments":{"thag1.115:0.4":"Mahānāmattheragāthā","thag1.115:1.1":"“Esāvahiyyase pabbatena,","thag1.115:1.2":"bahukuṭajasallakikena [sallakitena (sī.), sallarikena (syā.)];","thag1.115:1.3":"Nesādakena girinā,","thag1.115:1.4":"yasassinā paricchadenā”ti.","thag1.115:1.5":"… Mahānāmo thero …."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2814,"to":2814,"paras":[{"para":2814,"vripara":null,"refs":["thag1.115:1"],"lines":["Tattha <b>esāvahiyyase</b>ti eso tvaṃ mahānāma avahiyyase parihāyasi.","<b>Pabbatenā</b>ti nivāsaṭṭhānabhūtena iminā pabbatena.","<b>Bahukuṭajasallakikenā</b>ti bahūhi kuṭajehi indasālarukkhehi sallakīhi indasālarukkhehi vā samannāgatena.","<b>Nesādakenā</b>ti evaṃnāmakena.","<b>Girinā</b>ti selena.","Selo hi sandhisaṅkhātehi pabbehi ṭhitattā “pabbato”ti, pasavanādivasena jalassa, sārabhūtānaṃ bhesajjādivatthūnañca giraṇato “girī”ti vuccati.","Tadubhayatthasambhavato panettha “pabbatenā”ti vatvā “girinā”ti ca vuttaṃ.","<b>Yasassinā</b>ti sabbaguṇehi vissutena pakāsena.","<b>Paricchadenā</b>ti nānāvidharukkhagacchalatāhi samantato channena, vasanaṭṭhānatāya vā tuyhaṃ paricchadabhūtena.","Ayañhettha adhippāyo – mahānāma, yadi kammaṭṭhānaṃ vissajjetvā vitakkabahulo hosi, evaṃ tvaṃ iminā chāyūdakasampannena sappāyena nivāsanaṭṭhānabhūtena nesādakagirinā parihāyasi, idānihaṃ taṃ ito pātetvā māressāmi, tasmā na labbhā vitakkavasikena bhavitunti.","Evaṃ thero attānaṃ santajjentoyeva vipassanaṃ ussukkāpetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.40.333-352)–"],"lineRefs":[["thag1.115:1"],["thag1.115:1"],["thag1.115:1"],["thag1.115:1"],["thag1.115:1"],["thag1.115:1"],["thag1.115:1"],["thag1.115:1"],["thag1.115:1"],["thag1.115:1"],["thag1.115:1"],["thag1.115:1"]]}],"wordLinks":[["thag1.115:1.1","esāvahiyyase",0,0],["thag1.115:1.1","pabbatenā",0,1],["thag1.115:1.1","bahukuṭajasallakikenā",0,2],["thag1.115:1.3","nesādakenā",0,3],["thag1.115:1.3","girinā",0,4],["thag1.115:1.3","yasassinā",0,7],["thag1.115:1.3","paricchadenā",0,8]],"before":[{"para":2809,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Mahānāmattheragāthāvaṇṇanā"]},{"para":2810,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["<b>Esāvahiyyase pabbatenā</b>ti āyasmato mahānāmattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto sumedhassa bhagavato kāle brāhmaṇakule nibbattitvā brāhmaṇavijjāsu nipphattiṃ gato gharāvāsaṃ pahāya aññatarāya nadiyā tīre assamaṃ kāretvā sambahule brāhmaṇe mante vācento viharati.","Athekadivasaṃ bhagavā taṃ anuggaṇhituṃ tassa asamapadaṃ upagacchi.","So bhagavantaṃ disvā pasannacitto āsanaṃ paññāpetvā adāsi.","Nisinne bhagavati sumadhuraṃ madhuṃ upanāmesi.","Taṃ bhagavā paribhuñjitvā heṭṭhā adhimuttattheravatthumhi vuttanayena anāgataṃ byākaritvā pakkāmi.","So tena puññakammena devaloke nibbattitvā aparāparaṃ sugatīsuyeva parivattento imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇakule nibbattitvā <b>mahānāmo</b>ti laddhanāmo viññutaṃ patto bhagavato santikaṃ upasaṅkamitvā dhammaṃ sutvā paṭiladdhasaddho pabbajitvā kammaṭṭhānaṃ gahetvā nesādake nāma pabbate viharanto kilesapariyuṭṭhānaṃ vikkhambhetuṃ asakkonto “kiṃ me iminā saṃkiliṭṭhacittassa jīvitenā”ti attabhāvaṃ nibbindanto uccaṃ pabbatasikharaṃ abhiruhitvā “ito pātetvā taṃ māressāmī”ti attānaṃ paraṃ viya niddisanto –"]},{"para":2812,"vripara":"115","title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Esāvahiyyase pabbatena, bahukuṭajasallakikena;"]},{"para":2813,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Nesādakena girinā, yasassinā paricchadenā”ti.","– gāthaṃ abhāsi;"]}],"after":[{"para":2815,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Sindhuyā nadiyā tīre, sukato assamo mama;"]},{"para":2816,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Tattha vācemahaṃ sisse, itihāsaṃ salakkhaṇaṃ."]},{"para":2817,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Dhammakāmā vinītā te, sotukāmā susāsanaṃ;"]},{"para":2818,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Chaḷaṅge pāramippattā, sindhukūle vasanti te."]},{"para":2819,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Uppātagamane ceva, lakkhaṇesu ca kovidā;"]},{"para":2820,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Uttamatthaṃ gavesantā, vasanti vipine tadā."]},{"para":2821,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Sumedho nāma sambuddho, loke uppajji tāvade;"]},{"para":2822,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Amhākaṃ anukampanto, upāgacchi vināyako."]},{"para":2823,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Upāgataṃ mahāvīraṃ, sumedhaṃ lokanāyakaṃ;"]},{"para":2824,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Tiṇasanthārakaṃ katvā, lokajeṭṭhassadāsahaṃ."]},{"para":2825,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Vipināto madhuṃ gayha, buddhaseṭṭhassadāsahaṃ;"]},{"para":2826,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Sambuddho paribhuñjitvā, idaṃ vacanamabravi."]},{"para":2827,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Yo taṃ adāsi madhuṃ me, pasanno sehi pāṇibhi;"]},{"para":2828,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."]},{"para":2829,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Iminā madhudānena, tiṇasanthārakena ca;"]},{"para":2830,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Tiṃsa kappasahassāni, devaloke ramissati."]},{"para":2831,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Tiṃsakappasahassamhi, okkākakulasambhavo;"]},{"para":2832,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Gotamo nāma gottena, satthā loke bhavissati."]},{"para":2833,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Tassa dhammesu dāyādo, oraso dhammanimmito;"]},{"para":2834,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Sabbāsave pariññāya, nibbāyissatināsavo."]},{"para":2835,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Devalokā idhāgantvā, mātukucchiṃ upāgate;"]},{"para":2836,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Madhuvassaṃ pavassittha, chādayaṃ madhunā mahiṃ."]},{"para":2837,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Mayi nikkhantamattamhi, kucchiyā ca suduttarā;"]},{"para":2838,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Tatrāpi madhuvassaṃ me, vassate niccakālikaṃ."]},{"para":2839,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Agārā abhinikkhamma, pabbajiṃ anagāriyaṃ;"]},{"para":2840,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Lābhī annassa pānassa, madhudānassidaṃ phalaṃ."]},{"para":2841,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Sabbakāmasamiddhohaṃ, bhavitvā devamānuse;"]},{"para":2842,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Teneva madhudānena, pattomhi āsavakkhayaṃ."]},{"para":2843,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Vuṭṭhamhi deve caturaṅgule tiṇe, sampupphite dharaṇīruhe sañchanne;"]},{"para":2844,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Suññe ghare maṇḍaparukkhamūlake, vasāmi niccaṃ sukhito anāsavo."]},{"para":2845,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Majjhe mahante hīne ca, bhave sabbe atikkamiṃ;"]},{"para":2846,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Ajja me āsavā khīṇā, natthi dāni punabbhavo."]},{"para":2847,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Tiṃsakappasahassamhi, yaṃ dānamadadiṃ tadā;"]},{"para":2848,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, madhudānassidaṃ phalaṃ."]},{"para":2849,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."]},{"para":2850,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Ayameva ca therassa aññābyākaraṇagāthā ahosīti."]},{"para":2851,"vripara":null,"title":"Mahānāmattheragāthāvaṇṇanā","lines":["Mahānāmattheragāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
