{"suttaId":"ja109","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[610,613],"vripara":"109"},"segments":{"ja109:0.4":"Kuṇḍapūvajātakaṃ","ja109:1.1":"Yathanno puriso hoti, tathannā tassa devatā;","ja109:1.3":"Āharetaṃ kuṇḍapūvaṃ [kaṇaṃ pūvaṃ (sī. pī.)], mā me bhāgaṃ vināsayāti.","ja109:2.1":"Kuṇḍapūvajātakaṃ navamaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2597,"to":2597,"paras":[{"para":2597,"vripara":null,"refs":["ja109:1"],"lines":["Tattha <b>yathanno</b>ti yathārūpabhojano hoti.","<b>Tathannā</b>ti tassa purisassa devatāpi tathārūpabhojanāva hoti.","<b>Āharetaṃ kuṇḍapūvan</b>ti etaṃ kuṇḍakena pakkapūvaṃ ānehi, mayhaṃ bhāgaṃ mā vināsehīti."],"lineRefs":[["ja109:1"],["ja109:1"],["ja109:1"]]}],"wordLinks":[["ja109:1.1","yathanno",0,0],["ja109:1.1","tathannā",0,1],["ja109:1.3","āharetaṃ kuṇḍapūvaṃ",0,2]]},"tika":null,"tika2":null}
