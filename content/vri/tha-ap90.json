{"suttaId":"tha-ap90","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4888,4897],"vripara":"43"},"segments":{"tha-ap90:0.3":"Saddasaññakattheraapadānaṃ","tha-ap90:1.1":"“Pabbate himavantamhi, vasāmi paṇṇasanthare;","tha-ap90:1.3":"Phussassa dhammaṃ bhaṇato, sadde cittaṃ pasādayiṃ.","tha-ap90:2.1":"“Dvenavute ito kappe, yaṃ kammamakariṃ tadā;","tha-ap90:2.3":"Duggatiṃ nābhijānāmi, puññakammassidaṃ phalaṃ.","tha-ap90:3.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap90:4.1":"Itthaṃ sudaṃ āyasmā saddasaññako thero imā gāthāyo abhāsitthāti.","tha-ap90:5.1":"Saddasaññakattherassāpadānaṃ aṭṭhamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2742,"to":2742,"paras":[{"para":2742,"vripara":"43","refs":["tha-ap90:1"],"lines":["So aparabhāge attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>pabbate himavantamhī</b>tiādimāha.","Taṃ sabbaṃ uttānatthamevāti."],"lineRefs":[["tha-ap90:1"],["tha-ap90:1"]]}],"wordLinks":[["tha-ap90:1.1","pabbate himavantamhī",0,0]]},"tika":null,"tika2":null}
