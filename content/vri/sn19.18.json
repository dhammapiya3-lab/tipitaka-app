{"suttaId":"sn19.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1275,1275],"vripara":"219"},"segments":{"sn19.18:0.3":"Pāpabhikkhunīsuttaṃ","sn19.18:1.1":"“Addasaṃ bhikkhuniṃ vehāsaṃ gacchantiṃ.","sn19.18:1.2":"Tassā saṅghāṭipi ādittā…pe…","sn19.18:1.3":"pāpabhikkhunī ahosi…pe….","sn19.18:1.4":"Aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":893,"to":896,"paras":[{"para":893,"vripara":"218-222","refs":["sn19.18:1"],"lines":["Bhikkhuvatthusmiṃ <b>pāpabhikkhū</b>ti lāmakabhikkhu.","So kira lokassa saddhādeyye cattāro paccaye paribhuñjitvā kāyavacīdvārehi asaṃyato bhinnājīvo cittakeḷiṃ kīḷanto vicari.","Tato ekaṃ buddhantaraṃ niraye paccitvā petaloke nibbattanto bhikkhusadiseneva attabhāvena nibbatti.","Bhikkhunīsikkhamānāsāmaṇerasāmaṇerīvatthūsupi ayameva vinicchayo.","Sattamādīni."],"lineRefs":[["sn19.18:1"],["sn19.18:1"],["sn19.18:1"],["sn19.18:1"],["sn19.18:1"]]},{"para":894,"vripara":null,"refs":["sn19.18:1"],"lines":["Lakkhaṇasaṃyuttavaṇṇanā niṭṭhitā. 9."],"lineRefs":[["sn19.18:1"]]},{"para":895,"vripara":null,"refs":["sn19.18:1"],"lines":["Opammasaṃyuttaṃ 1."],"lineRefs":[["sn19.18:1"]]},{"para":896,"vripara":null,"refs":["sn19.18:1"],"lines":["Kūṭasuttavaṇṇanā 223."],"lineRefs":[["sn19.18:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":919,"to":924,"paras":[{"para":919,"vripara":"218-222","refs":["sn19.18:1"],"lines":["<b>Lāmakabhikkhū</b>ti hīnācāratāya lāmako, bhikkhuvesatāya, bhikkhāhārena jīvanato ca bhikkhu.","<b>Cittakeḷi</b>nti cittaruciyaṃ taṃ taṃ kīḷanto.","<b>Ayamevā</b>ti bhikkhuvatthusmiṃ vuttanayo eva."],"lineRefs":[["sn19.18:1"],["sn19.18:1"],["sn19.18:1"]]},{"para":920,"vripara":null,"refs":["sn19.18:1"],"lines":["Pāpabhikkhusuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn19.18:1"]]},{"para":921,"vripara":null,"refs":["sn19.18:1"],"lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"],"lineRefs":[["sn19.18:1"]]},{"para":922,"vripara":null,"refs":["sn19.18:1"],"lines":["Lakkhaṇasaṃyuttavaṇṇanāya līnatthappakāsanā samattā. 9."],"lineRefs":[["sn19.18:1"]]},{"para":923,"vripara":null,"refs":["sn19.18:1"],"lines":["Opammasaṃyuttaṃ 1."],"lineRefs":[["sn19.18:1"]]},{"para":924,"vripara":null,"refs":["sn19.18:1"],"lines":["Kūṭasuttavaṇṇanā 223."],"lineRefs":[["sn19.18:1"]]}],"wordLinks":[]},"tika2":null}
