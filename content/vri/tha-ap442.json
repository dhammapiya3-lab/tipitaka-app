{"suttaId":"tha-ap442","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[790,815],"vripara":"81"},"segments":{"tha-ap442:0.3":"Ambaphaliyattheraapadānaṃ","tha-ap442:1.1":"“Padumuttarabuddhassa,","tha-ap442:1.2":"lokajeṭṭhassa tādino;","tha-ap442:1.3":"Piṇḍāya vicarantassa,","tha-ap442:1.4":"dhārato uttamaṃ yasaṃ. 82.","tha-ap442:2.1":"“Aggaphalaṃ gahetvāna,","tha-ap442:2.2":"vippasannena cetasā;","tha-ap442:2.3":"Dakkhiṇeyyassa vīrassa,","tha-ap442:2.4":"adāsiṃ satthuno ahaṃ. 83.","tha-ap442:3.1":"“Tena kammena dvipadinda [dipadinda (sī. syā. pī.)],","tha-ap442:3.2":"lokajeṭṭha narāsabha;","tha-ap442:3.3":"Pattomhi acalaṃ ṭhānaṃ,","tha-ap442:3.4":"hitvā jayaparājayaṃ. 84.","tha-ap442:4.1":"“Satasahassito kappe,","tha-ap442:4.2":"yaṃ dānamadadiṃ tadā;","tha-ap442:4.3":"Duggatiṃ nābhijānāmi,","tha-ap442:4.4":"aggadānassidaṃ phalaṃ. 85.","tha-ap442:5.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap442:5.3":"viharāmi anāsavo. 86.","tha-ap442:6.1":"“Svāgataṃ vata me āsi…pe…","tha-ap442:6.3":"kataṃ buddhassa sāsanaṃ. 87.","tha-ap442:7.1":"“Paṭisambhidā catasso…pe…","tha-ap442:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap442:8.1":"Itthaṃ sudaṃ āyasmā ambaphaliyo thero imā gāthāyo abhāsitthāti;","tha-ap442:9.1":"Ambaphaliyattherassāpadānaṃ dasamaṃ.","tha-ap442:10.1":"Ekavihārivaggo catucattālīsamo.","tha-ap442:11.1":"Tassuddānaṃ –","tha-ap442:12.1":"Thero ekavihārī ca,","tha-ap442:12.2":"saṅkhiyo pāṭihīrako;","tha-ap442:12.3":"Thaviko ucchukhaṇḍī ca,","tha-ap442:12.4":"kaḷambaambāṭakado.","tha-ap442:13.1":"Harītakambapiṇḍī ca,","tha-ap442:13.2":"ambado dasamo yati;","tha-ap442:13.3":"Chaḷasīti ca gāthāyo,","tha-ap442:13.4":"gaṇitāyo vibhāvibhi. 45."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
