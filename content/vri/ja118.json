{"suttaId":"ja118","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[661,664],"vripara":"118"},"segments":{"ja118:0.4":"Vaṭṭakajātakaṃ","ja118:1.1":"Nācintayanto puriso,","ja118:1.2":"visesamadhigacchati;","ja118:1.3":"Cintitassa phalaṃ passa,","ja118:1.4":"muttosmi vadhabandhanāti.","ja118:2.1":"Vaṭṭakajātakaṃ aṭṭhamaṃ. 119."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2682,"to":2682,"paras":[{"para":2682,"vripara":null,"refs":["ja118:1"],"lines":["Tatthāyaṃ piṇḍattho – <b>puriso</b> dukkhaṃ patvā “iminā nāma upāyena imamhā dukkhā muccissāmī”ti <b>acintayanto</b> attano dukkhā mokkhasaṅkhātaṃ visesaṃ <b>nādhigacchati</b>.","Idāni pana mayā <b>cintita</b>kammassa <b>phalaṃ passa</b>.","Teneva upāyena <b>muttosmi vadhabandhanā,</b> maraṇato ca bandhanato ca muttosmi ahanti.","Evaṃ bodhisatto attanā katakāraṇaṃ ācikkhi."],"lineRefs":[["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"]]}],"wordLinks":[["ja118:1.1","puriso",0,0],["ja118:1.3","cintita",0,1],["ja118:1.3","phalaṃ passa",0,1],["ja118:1.3","muttosmi vadhabandhanā",0,2]]},"tika":{"book":"Ja-ṭ-i","bookName":"Jātaka-abhinavaṭīkā-1","vriCode":"","from":1318,"to":1320,"paras":[{"para":1318,"vripara":null,"refs":["ja118:1"],"lines":["8-vaṭṭajātakavaṇṇanā (118)"],"lineRefs":[["ja118:1"]]},{"para":1319,"vripara":null,"refs":["ja118:1"],"lines":["<b>brahmavaṇṇī</b>ti seṭṭhavaṇṇasampannāgato.","<b>kattikachaṇe</b>ti kattika māsapuṇṇamiyaṃ kattabbe ussave.","<b>nakkhatte saṅghuṭṭhe</b> [ghuṭṭhe.(ṭṭha)] ti nakkhattasabhākīḷanatthāya saṅghuṭṭhe.","<b>kilesesū</b>ti kilesānaṃ ārammaṇesu kāmaguṇesu.","<b>punappunaṃ nibandhitvā</b>ti punappunaṃ nippīḷetvā.","<b>itthikuttaïtthilīḷāyā [itthikumbhalitāya.(ṭṭha)] </b>ti ettha itthikuttaṃ nāma itthīnaṃ kiriyā.","itthilīḷā nāma itthīnaṃ hāsaraso.","<b>dantaṭṭhike nimittaṃ gaṇhī</b>ti dantaṭṭhike ārammaṇaṃ gaṇhi.","<b>sakalampi taṃ sarīraṃ aṭṭhikasaṅkhalikā viya paññāyī</b>ti dantaṭṭhikānusārena sakalampi tassā sarīraṃ aṭṭhikasaṅkhalikā viya paññāyati.","maṃsalohitādīhi missitampi tāni apassitvā aṭṭhikasaṅkhalikā yeva aññehi amissitā viya paññāyati.","<b>osīda</b>4nti nivattitaṃ.","niṭṭhitanti attho.","<b>paridevatī</b>ti mahājano paridevati.","<b>ussārethā</b>ti apanetha.","<b>cīvarasāṭake</b>ti cīvaratthāya vāyite sāṭaketi."],"lineRefs":[["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"]]},{"para":1320,"vripara":null,"refs":["ja118:1"],"lines":["vaṭṭajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja118:1"]]}],"wordLinks":[]},"tika2":null}
