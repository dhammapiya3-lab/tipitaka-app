{"suttaId":"ja118","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[661,664],"vripara":"118"},"segments":{"ja118:0.4":"Vaṭṭakajātakaṃ","ja118:1.1":"Nācintayanto puriso,","ja118:1.2":"visesamadhigacchati;","ja118:1.3":"Cintitassa phalaṃ passa,","ja118:1.4":"muttosmi vadhabandhanāti.","ja118:2.1":"Vaṭṭakajātakaṃ aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2682,"to":2682,"paras":[{"para":2682,"vripara":null,"refs":["ja118:1"],"lines":["Tatthāyaṃ piṇḍattho – <b>puriso</b> dukkhaṃ patvā “iminā nāma upāyena imamhā dukkhā muccissāmī”ti <b>acintayanto</b> attano dukkhā mokkhasaṅkhātaṃ visesaṃ <b>nādhigacchati</b>.","Idāni pana mayā <b>cintita</b> kammassa <b>phalaṃ passa</b>.","Teneva upāyena <b>muttosmi vadhabandhanā,</b> maraṇato ca bandhanato ca muttosmi ahanti.","Evaṃ bodhisatto attanā katakāraṇaṃ ācikkhi."],"lineRefs":[["ja118:1"],["ja118:1"],["ja118:1"],["ja118:1"]]}],"wordLinks":[["ja118:1.1","puriso",0,0],["ja118:1.3","cintita",0,1],["ja118:1.3","phalaṃ passa",0,1],["ja118:1.3","muttosmi vadhabandhanā",0,2]]},"tika":null,"tika2":null}
