{"suttaId":"ja221","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1477,1483],"vripara":"141"},"segments":{"ja221:0.4":"Kāsāvajātakaṃ (2-8-1)","ja221:1.1":"Anikkasāvo kāsāvaṃ, yo vatthaṃ paridahissati [paridahessati (sī. pī.)];","ja221:1.3":"Apeto damasaccena, na so kāsāvamarahati.","ja221:2.1":"Yo ca vantakasāvassa, sīlesu susamāhito;","ja221:2.3":"Upeto damasaccena, sa ve kāsāvamarahatīti.","ja221:3.1":"Kāsāvajātakaṃ paṭhamaṃ."},"attha":null,"tika":null}
