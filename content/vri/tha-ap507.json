{"suttaId":"tha-ap507","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3074,3088],"vripara":"63"},"segments":{"tha-ap507:0.3":"Pādaphaliyattheraapadānaṃ","tha-ap507:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap507:1.2":"āhutīnaṃ paṭiggahaṃ;","tha-ap507:1.3":"Rathiyaṃ paṭipajjantaṃ,","tha-ap507:1.4":"pādaphalaṃ [vāraphalaṃ (sī.), cāraphalaṃ (syā.), pāraphalaṃ (pī.)] adāsahaṃ. 64.","tha-ap507:2.1":"“Ekanavutito kappe,","tha-ap507:2.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap507:2.3":"Duggatiṃ nābhijānāmi,","tha-ap507:2.4":"phaladānassidaṃ phalaṃ. 65.","tha-ap507:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap507:3.3":"viharāmi anāsavo. 66.","tha-ap507:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap507:4.3":"kataṃ buddhassa sāsanaṃ. 67.","tha-ap507:5.1":"“Paṭisambhidā catasso…pe…","tha-ap507:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap507:6.1":"Itthaṃ sudaṃ āyasmā pādaphaliyo thero imā gāthāyo Abhāsitthāti.","tha-ap507:7.1":"Pādaphaliyattherassāpadānaṃ pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
