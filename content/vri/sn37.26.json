{"suttaId":"sn37.26","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1501,1501],"vripara":"305"},"segments":{"sn37.26:0.3":"Pasayhasuttaṃ","sn37.26:1.1":"“Pañcimāni, bhikkhave, mātugāmassa balāni.","sn37.26:1.2":"Katamāni pañca?","sn37.26:1.3":"Rūpabalaṃ, bhogabalaṃ, ñātibalaṃ, puttabalaṃ, sīlabalaṃ –","sn37.26:1.4":"imāni kho, bhikkhave, pañca mātugāmassa balāni.","sn37.26:1.5":"Imehi kho, bhikkhave, pañcahi balehi samannāgato mātugāmo sāmikaṃ pasayha agāraṃ ajjhāvasatī”ti.","sn37.26:1.6":"Dutiyaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":661,"to":661,"paras":[{"para":661,"vripara":"305-313","refs":["sn37.26:1"],"lines":["305-313. <b>Pasayhā</b>ti abhibhavitvā.","<b>Abhibhuyya vattatī</b>ti abhibhavati ajjhottharati.","<b>Neva rūpabalaṃ tāyatī</b>ti neva rūpabalaṃ tāyituṃ rakkhituṃ sakkoti.","<b>Nāsenteva naṃ, kule na vāsentī</b>ti “dussīlā saṃbhinnācārā atikkantamariyādā”ti gīvāyaṃ gahetvā nīharanti, na tasmiṃ kule vāsenti.","<b>Vāsenteva naṃ kule, na nāsentī</b>ti “kiṃ rūpena bhogādīhi vā, parisuddhasīlā esā ācārasampannā”ti ñatvā ñātakā tasmiṃ kule vāsentiyeva, na nāsenti.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn37.26:1"],["sn37.26:1"],["sn37.26:1"],["sn37.26:1"],["sn37.26:1"],["sn37.26:1"]]}],"wordLinks":[["sn37.26:1.5","pasayhā",0,0]],"before":[{"para":660,"vripara":null,"title":"Pasayhasuttādivaṇṇanā","lines":["2-10. Pasayhasuttādivaṇṇanā"]}]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":569,"to":573,"paras":[{"para":569,"vripara":"305-313","refs":["sn37.26:1"],"lines":["305-313. <b>Abhibhavitvā</b> sabbaṃ antojanaṃ sāmikañca.","<b>Nāsentī</b>ti nāsanaṃ adassanaṃ nenti nīharantīti attho."],"lineRefs":[["sn37.26:1"],["sn37.26:1"]]},{"para":570,"vripara":null,"refs":["sn37.26:1"],"lines":["Pasayhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn37.26:1"]]},{"para":571,"vripara":null,"refs":["sn37.26:1"],"lines":["Mātugāmasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn37.26:1"]]},{"para":572,"vripara":null,"refs":["sn37.26:1"],"lines":["Jambukhādakasaṃyuttaṃ"],"lineRefs":[["sn37.26:1"]]},{"para":573,"vripara":null,"refs":["sn37.26:1"],"lines":["Nibbānapañhasuttavaṇṇanā"],"lineRefs":[["sn37.26:1"]]}],"wordLinks":[],"before":[{"para":568,"vripara":null,"title":"Pasayhasuttādivaṇṇanā","lines":["2-10. Pasayhasuttādivaṇṇanā"]}]},"tika2":null}
