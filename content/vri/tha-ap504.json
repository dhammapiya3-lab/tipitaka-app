{"suttaId":"tha-ap504","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[2999,3034],"vripara":"39"},"segments":{"tha-ap504:0.3":"Ekapattadāyakattheraapadānaṃ","tha-ap504:1.1":"“Nagare haṃsavatiyā,","tha-ap504:1.2":"kumbhakāro ahosahaṃ;","tha-ap504:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap504:1.4":"oghatiṇṇamanāsavaṃ. 40.","tha-ap504:2.1":"“Sukataṃ mattikāpattaṃ,","tha-ap504:2.2":"buddhaseṭṭhassadāsahaṃ;","tha-ap504:2.3":"Pattaṃ datvā bhagavato,","tha-ap504:2.4":"ujubhūtassa tādino. 41.","tha-ap504:3.1":"“Bhave nibbattamānohaṃ,","tha-ap504:3.2":"soṇṇathāle labhāmahaṃ;","tha-ap504:3.3":"Rūpimaye ca sovaṇṇe,","tha-ap504:3.4":"taṭṭike ca maṇīmaye. 42.","tha-ap504:4.1":"“Pātiyo paribhuñjāmi,","tha-ap504:4.2":"puññakammassidaṃ phalaṃ;","tha-ap504:4.3":"Yasānañca dhanānañca [yasasāva janānañca (syā.)],","tha-ap504:4.4":"aggabhūto [pattabhūto (sī. pī.)] ca homahaṃ. 43.","tha-ap504:5.1":"“Yathāpi bhaddake khette,","tha-ap504:5.2":"bījaṃ appampi ropitaṃ;","tha-ap504:5.3":"Sammādhāraṃ pavacchante,","tha-ap504:5.4":"phalaṃ toseti kassakaṃ. 44.","tha-ap504:6.1":"“Tathevidaṃ pattadānaṃ,","tha-ap504:6.2":"buddhakhettamhi ropitaṃ;","tha-ap504:6.3":"Pītidhāre pavassante,","tha-ap504:6.4":"phalaṃ maṃ tosayissati. 45.","tha-ap504:7.1":"“Yāvatā khettā vijjanti,","tha-ap504:7.2":"saṅghāpi ca gaṇāpi ca;","tha-ap504:7.3":"Buddhakhettasamo natthi,","tha-ap504:7.4":"sukhado sabbapāṇinaṃ. 46.","tha-ap504:8.1":"“Namo te purisājañña,","tha-ap504:8.2":"namo te purisuttama;","tha-ap504:8.3":"Ekapattaṃ daditvāna,","tha-ap504:8.4":"pattomhi acalaṃ padaṃ. 47.","tha-ap504:9.1":"“Ekanavutito kappe,","tha-ap504:9.2":"yaṃ pattamadadiṃ tadā;","tha-ap504:9.3":"Duggatiṃ nābhijānāmi,","tha-ap504:9.4":"pattadānassidaṃ phalaṃ. 48.","tha-ap504:10.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap504:10.3":"viharāmi anāsavo. 49.","tha-ap504:11.1":"“Svāgataṃ vata me āsi…pe…","tha-ap504:11.3":"kataṃ buddhassa sāsanaṃ. 50.","tha-ap504:12.1":"“Paṭisambhidā catasso…pe…","tha-ap504:12.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap504:13.1":"Itthaṃ sudaṃ āyasmā ekapattadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap504:14.1":"Ekapattadāyakattherassāpadānaṃ dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
