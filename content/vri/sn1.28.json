{"suttaId":"sn1.28","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[274,281],"vripara":"28"},"segments":{"sn1.28:0.3":"Mahaddhanasuttaṃ","sn1.28:1.1":"“Mahaddhanā mahābhogā,","sn1.28:1.2":"raṭṭhavantopi khattiyā;","sn1.28:1.3":"Aññamaññābhigijjhanti,","sn1.28:1.4":"kāmesu analaṅkatā.","sn1.28:2.1":"“Tesu ussukkajātesu,","sn1.28:2.2":"bhavasotānusārisu;","sn1.28:2.3":"Kedha taṇhaṃ [rodhataṇhaṃ (syā. kaṃ.), gedhataṇhaṃ (ka.)] pajahiṃsu [pavāhiṃsu (syā. kaṃ. ka.)],","sn1.28:2.4":"ke lokasmiṃ anussukā”ti.","sn1.28:3.1":"“Hitvā agāraṃ pabbajitā,","sn1.28:3.2":"hitvā puttaṃ pasuṃ viyaṃ;","sn1.28:3.3":"Hitvā rāgañca dosañca,","sn1.28:3.4":"avijjañca virājiya;","sn1.28:3.5":"Khīṇāsavā arahanto,","sn1.28:3.6":"te lokasmiṃ anussukā”ti."},"unsure":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":264,"to":264,"paras":[{"para":264,"vripara":"28","refs":["sn1.28:1","sn1.28:2","sn1.28:3"],"lines":["Aṭṭhame nidhānagataṃ muttasārādi mahantaṃ dhanametesanti <b>mahaddhanā</b>.","Suvaṇṇarajatabhājanādi mahābhogo etesanti <b>mahābhogā.</b>","<b>Aññamaññābhigijjhantī</b>ti aññamaññaṃ abhigijjhanti patthenti pihenti.","<b>Analaṅkatā</b>ti atittā apariyattajātā.","<b>Ussukkajātesū</b>ti nānākiccajātesu anuppannānaṃ rūpādīnaṃ uppādanatthāya uppannānaṃ anubhavanatthāya ussukkesu.","<b>Bhavasotānusārīsū</b>ti vaṭṭasotaṃ anusarantesu.","<b>Anussukā</b>ti avāvaṭā.","<b>Agāran</b>ti mātugāmena saddhiṃ gehaṃ.","<b>Virājiyā</b>ti virājetvā.","Sesaṃ uttānamevāti.","Aṭṭhamaṃ."],"lineRefs":[["sn1.28:1"],["sn1.28:1"],["sn1.28:1"],["sn1.28:1"],["sn1.28:2"],["sn1.28:2"],["sn1.28:2"],["sn1.28:3"],["sn1.28:3"],["sn1.28:3"],["sn1.28:3"]]}],"wordLinks":[["sn1.28:1.1","mahaddhanā",0,0],["sn1.28:1.1","mahābhogā",0,1],["sn1.28:1.3","aññamaññābhigijjhantī",0,2],["sn1.28:1.3","analaṅkatā",0,3],["sn1.28:2.1","ussukkajātesū",0,4],["sn1.28:2.3","anussukā",0,6],["sn1.28:3.1","agāraṃ",0,7],["sn1.28:3.3","virājiyā",0,8]],"before":[{"para":263,"vripara":null,"refs":[],"lines":["Mahaddhanasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":379,"to":379,"paras":[{"para":379,"vripara":"28","refs":["sn1.28:1","sn1.28:2","sn1.28:3"],"lines":["Nidhīyatīti <b>nidhānaṃ</b>.","Nidhātabbataṃ gataṃ nihitanti attho.","<b>Muttasārādī</b>ti muttāmaṇiveḷuriyapavāḷarajatajātarūpādi.","<b>Suvaṇṇarajatabhājanādī</b>ti <b>ādi</b> -saddena kahāpaṇa-dhaññakoṭṭhabhaṇḍādiṃ saṅgaṇhāti.","Tampi hi niccaparibbayavasena bhuñjīyatīti <b>“bhogo”</b>ti vuccati.","<b>Aññamaññaṃ abhigijjhantī</b>ti aññamaññassa santakaṃ abhigijjhanti.","Tenāha <b>“patthentī”</b>ti.","<b>Analaṅkatā</b>ti na alaṃ pariyattanti evaṃ katacittā, atricchatāmahicchatāhi abhibhūtā.","Tenāha <b>“atittā apariyattajātā”</b>ti.","<b>Ussukkajātesū</b>ti taṃtaṃkicce sañjātaussukkesu.","<b>Nānākiccajātesū</b>ti nānāvidhakiccesu, sañjātanānākiccesu vā.","Vaṭṭagāmikapasutena <b>vaṭṭasotaṃ anusarantesu</b>.","Taṇhānivāsatāya gehantipi agārantipi vuccatīti āha <b>“mātugāmena saddhiṃ gehan”</b>ti.","<b>Virājiyā</b>ti hetuatthadīpakaṃ padanti āha <b>“virājetvā”</b>ti, <b>tvā</b> -saddopi cāyaṃ hetuatthoti."],"lineRefs":[["sn1.28:1"],["sn1.28:1"],["sn1.28:1"],["sn1.28:1"],["sn1.28:1"],["sn1.28:1"],["sn1.28:1"],["sn1.28:1"],["sn1.28:1"],["sn1.28:2"],["sn1.28:2"],["sn1.28:2"],["sn1.28:2"],["sn1.28:3"]]}],"wordLinks":[["sn1.28:1.1","bhogo",0,4],["sn1.28:1.3","analaṅkatā",0,7],["sn1.28:2.1","ussukkajātesū",0,9],["sn1.28:3.1","tvā",0,13],["sn1.28:3.3","tvā",0,13],["sn1.28:3.3","virājiyā",0,13]],"before":[{"para":377,"vripara":null,"refs":[],"lines":["Sarasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":378,"vripara":null,"refs":[],"lines":["Mahaddhanasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
