{"suttaId":"iti4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"It","vriCode":"s0504m.mul","paras":[28,33],"vripara":"4"},"segments":{"iti4:0.4":"Kodhasuttaṃ","iti4:1.1":"Vuttañhetaṃ bhagavatā, vuttamarahatāti me sutaṃ –","iti4:2.1":"“Ekadhammaṃ, bhikkhave, pajahatha;","iti4:2.2":"ahaṃ vo pāṭibhogo anāgāmitāya.","iti4:2.3":"Katamaṃ ekadhammaṃ?","iti4:2.4":"Kodhaṃ, bhikkhave, ekadhammaṃ pajahatha;","iti4:2.5":"ahaṃ vo pāṭibhogo anāgāmitāyā”ti.","iti4:2.6":"Etamatthaṃ bhagavā avoca.","iti4:2.7":"Tatthetaṃ iti vuccati –","iti4:3.1":"“Yena kodhena kuddhāse, sattā gacchanti duggatiṃ;","iti4:3.3":"Taṃ kodhaṃ sammadaññāya, pajahanti vipassino;","iti4:3.5":"Pahāya na punāyanti, imaṃ lokaṃ kudācanan”ti.","iti4:4.1":"Ayampi attho vutto bhagavatā, iti me sutanti.","iti4:4.2":"Catutthaṃ."},"attha":{"book":"It-a","bookName":"Itivuttaka-aṭṭhakathā","vriCode":"s0504a.att","from":245,"to":245,"paras":[{"para":245,"vripara":"4","refs":["iti4:2","iti4:3"],"lines":["Catutthe <b>kodhan</b>ti dosaṃ.","Doso eva hi kodhapariyāyena bujjhanakānaṃ puggalānaṃ ajjhāsayavasena evaṃ vutto.","Tasmā dutiyasutte vuttanayenevettha attho veditabbo.","Apica kujjhanalakkhaṇo kodho, āghātakaraṇaraso, cittassa byāpattibhāvapaccupaṭṭhāno, cetaso pūtibhāvoti daṭṭhabboti ayampi viseso veditabbo."],"lineRefs":[["iti4:2"],["iti4:2"],["iti4:2"],["iti4:2"]]}],"wordLinks":[["iti4:2.4","kodhaṃ",0,0]]},"tika":null}
