{"suttaId":"tha-ap319","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9342,9357],"vripara":"34"},"segments":{"tha-ap319:0.3":"Saddasaññakattheraapadānaṃ","tha-ap319:1.1":"“Sudassano mahāvīro, deseti amataṃ padaṃ;","tha-ap319:1.3":"Parivuto sāvakehi, vasati gharamuttame.","tha-ap319:2.1":"“Tāya vācāya madhurāya, saṅgaṇhāti [saṅgaṇhante (sī.)] mahājanaṃ;","tha-ap319:2.3":"Ghoso ca vipulo āsi, āsīso [āsaṃso (sī.)] devamānuse.","tha-ap319:3.1":"“Nigghosasaddaṃ sutvāna, siddhatthassa mahesino;","tha-ap319:3.3":"Sadde cittaṃ pasādetvā, avandiṃ lokanāyakaṃ.","tha-ap319:4.1":"“Catunnavutito kappe, yaṃ saññamalabhiṃ tadā;","tha-ap319:4.3":"Duggatiṃ nābhijānāmi, buddhasaññāyidaṃ phalaṃ.","tha-ap319:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap319:6.1":"Itthaṃ sudaṃ āyasmā saddasaññako thero imā gāthāyo abhāsitthāti.","tha-ap319:7.1":"Saddasaññakattherassāpadānaṃ sattamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3273,"to":3273,"paras":[{"para":3273,"vripara":"34","refs":["tha-ap319:1"],"lines":["Sattamāpadāne <b>sudassano mahāvīro</b>ti sundaradassano dvattiṃsamahāpurisalakkhaṇasampannasarīrattā manoharadassano mahāvīriyo siddhattho bhagavāti sambandho.","<b>Vasatigharamuttame</b>ti uttame vihāre vasatīti attho."],"lineRefs":[["tha-ap319:1"],["tha-ap319:1"]]}],"wordLinks":[["tha-ap319:1.1","sudassano mahāvīro",0,0],["tha-ap319:1.3","vasatigharamuttame",0,1]]},"tika":null,"tika2":null}
