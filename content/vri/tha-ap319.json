{"suttaId":"tha-ap319","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9342,9357],"vripara":"34"},"segments":{"tha-ap319:0.3":"Saddasaññakattheraapadānaṃ","tha-ap319:1.1":"“Sudassano mahāvīro,","tha-ap319:1.2":"deseti amataṃ padaṃ;","tha-ap319:1.3":"Parivuto sāvakehi,","tha-ap319:1.4":"vasati gharamuttame.","tha-ap319:2.1":"“Tāya vācāya madhurāya,","tha-ap319:2.2":"saṅgaṇhāti [saṅgaṇhante (sī.)] mahājanaṃ;","tha-ap319:2.3":"Ghoso ca vipulo āsi,","tha-ap319:2.4":"āsīso [āsaṃso (sī.)] devamānuse.","tha-ap319:3.1":"“Nigghosasaddaṃ sutvāna,","tha-ap319:3.2":"siddhatthassa mahesino;","tha-ap319:3.3":"Sadde cittaṃ pasādetvā,","tha-ap319:3.4":"avandiṃ lokanāyakaṃ.","tha-ap319:4.1":"“Catunnavutito kappe,","tha-ap319:4.2":"yaṃ saññamalabhiṃ tadā;","tha-ap319:4.3":"Duggatiṃ nābhijānāmi,","tha-ap319:4.4":"buddhasaññāyidaṃ phalaṃ.","tha-ap319:5.1":"“Paṭisambhidā catasso … pe …","tha-ap319:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap319:6.1":"Itthaṃ sudaṃ āyasmā saddasaññako thero imā gāthāyo abhāsitthāti.","tha-ap319:7.1":"Saddasaññakattherassāpadānaṃ sattamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3273,"to":3273,"paras":[{"para":3273,"vripara":"34","refs":["tha-ap319:1"],"lines":["Sattamāpadāne <b>sudassano mahāvīro</b>ti sundaradassano dvattiṃsamahāpurisalakkhaṇasampannasarīrattā manoharadassano mahāvīriyo siddhattho bhagavāti sambandho.","<b>Vasatigharamuttame</b>ti uttame vihāre vasatīti attho."],"lineRefs":[["tha-ap319:1"],["tha-ap319:1"]]}],"wordLinks":[["tha-ap319:1.1","sudassano mahāvīro",0,0],["tha-ap319:1.3","vasatigharamuttame",0,1]]},"tika":null,"tika2":null}
