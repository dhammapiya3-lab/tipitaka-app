{"suttaId":"tha-ap435","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[618,644],"vripara":"26"},"segments":{"tha-ap435:0.3":"Pāṭihīrasaññakattheraapadānaṃ","tha-ap435:1.1":"“Padumuttaro nāma jino,","tha-ap435:1.2":"āhutīnaṃ paṭiggaho;","tha-ap435:1.3":"Vasīsatasahassehi,","tha-ap435:1.4":"nagaraṃ pāvisī tadā. 27.","tha-ap435:2.1":"“Nagaraṃ pavisantassa,","tha-ap435:2.2":"upasantassa tādino;","tha-ap435:2.3":"Ratanāni pajjotiṃsu [panādiṃsu (pī.)],","tha-ap435:2.4":"nigghoso āsi tāvade. 28.","tha-ap435:3.1":"“Buddhassa ānubhāvena,","tha-ap435:3.2":"bherī vajjumaghaṭṭitā;","tha-ap435:3.3":"Sayaṃ vīṇā pavajjanti,","tha-ap435:3.4":"buddhassa pavisato puraṃ. 29.","tha-ap435:4.1":"“Buddhaseṭṭhaṃ namassāmi [na passāmi (sī.)],","tha-ap435:4.2":"padumuttaramahāmuniṃ;","tha-ap435:4.3":"Pāṭihīrañca passitvā,","tha-ap435:4.4":"tattha cittaṃ pasādayiṃ. 30.","tha-ap435:5.1":"“Aho buddho aho dhammo, aho no satthusampadā;","tha-ap435:5.3":"Acetanāpi turiyā,","tha-ap435:5.4":"sayameva pavajjare. 31.","tha-ap435:6.1":"“Satasahassito kappe,","tha-ap435:6.2":"yaṃ saññamalabhiṃ tadā;","tha-ap435:6.3":"Duggatiṃ nābhijānāmi,","tha-ap435:6.4":"buddhasaññāyidaṃ phalaṃ. 32.","tha-ap435:7.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap435:7.3":"viharāmi anāsavo. 33.","tha-ap435:8.1":"“Svāgataṃ vata me āsi…pe…","tha-ap435:8.3":"kataṃ buddhassa sāsanaṃ. 34.","tha-ap435:9.1":"“Paṭisambhidā catasso…pe…","tha-ap435:9.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap435:10.1":"Itthaṃ sudaṃ āyasmā pāṭihīrasaññako thero imā gāthāyo Abhāsitthāti.","tha-ap435:11.1":"Pāṭihīrasaññakattherassāpadānaṃ tatiyaṃ. 4."},"unsure":["tha-ap435:5.1"],"preface":[],"attha":null,"tika":null,"tika2":null}
