{"suttaId":"vv12","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[330,352],"vripara":"101"},"segments":{"vv12:0.4":"Dutiyapatibbatāvimānavatthu","vv12:1.1":"“Veḷuriyathambhaṃ ruciraṃ pabhassaraṃ,","vv12:1.2":"vimānamāruyha anekacittaṃ;","vv12:1.3":"Tatthacchasi devi mahānubhāve,","vv12:1.4":"uccāvacā iddhi vikubbamānā;","vv12:1.5":"Imā ca te accharāyo samantato,","vv12:1.6":"naccanti gāyanti pamodayanti ca.","vv12:2.1":"“Deviddhipattāsi mahānubhāve,","vv12:2.2":"manussabhūtā kimakāsi puññaṃ;","vv12:2.3":"Kenāsi evaṃ jalitānubhāvā,","vv12:2.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv12:3.1":"Sā devatā attamanā,","vv12:3.2":"moggallānena pucchitā;","vv12:3.3":"Pañhaṃ puṭṭhā viyākāsi,","vv12:3.4":"yassa kammassidaṃ phalaṃ.","vv12:4.1":"“Ahaṃ manussesu manussabhūtā,","vv12:4.2":"upāsikā cakkhumato ahosiṃ;","vv12:4.3":"Pāṇātipātā viratā ahosiṃ,","vv12:4.4":"loke adinnaṃ parivajjayissaṃ.","vv12:5.1":"“Amajjapā no ca [nāpi (syā.)] musā abhāṇiṃ [abhāsiṃ (ka.)],","vv12:5.2":"sakena sāminā [sāmināva (sī.)] ahosiṃ tuṭṭhā;","vv12:5.3":"Annañca pānañca pasannacittā,","vv12:5.4":"sakkacca dānaṃ vipulaṃ adāsiṃ.","vv12:6.1":"“Tena metādiso vaṇṇo,","vv12:6.2":"tena me idha mijjhati;","vv12:6.3":"Uppajjanti ca me bhogā,","vv12:6.4":"ye keci manaso piyā.","vv12:7.1":"“Akkhāmi te bhikkhu mahānubhāva,","vv12:7.2":"manussabhūtā yamakāsi puññaṃ;","vv12:7.3":"Tenamhi evaṃ jalitānubhāvā,","vv12:7.4":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv12:8.1":"Dutiyapatibbatāvimānaṃ dvādasamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":512,"to":515,"paras":[{"para":512,"vripara":"101","refs":["vv12:1"],"lines":["Tattha <b>veḷuriyathambhan</b>ti veḷuriyamaṇimayathambhaṃ.","<b>Ruciran</b>ti ramaṇīyaṃ.","<b>Pabhassaran</b>ti ativiya bhāsuraṃ.","<b>Uccāvacā</b>ti uccā ca avacā ca, vividhāti attho."],"lineRefs":[["vv12:1"],["vv12:1"],["vv12:1"],["vv12:1"]]},{"para":513,"vripara":"104-105","refs":["vv12:4"],"lines":["104-5. <b>Upāsikā</b>ti saraṇagamanena upāsikālakkhaṇe ṭhitā.","Vuttañhi –"],"lineRefs":[["vv12:4"],["vv12:4"]]},{"para":514,"vripara":null,"refs":["vv12:4"],"lines":["“Yato kho, mahānāma, ariyasāvako buddhaṃ saraṇaṃ gato hoti, dhammaṃ saraṇaṃ gato hoti, saṅghaṃ saraṇaṃ gato hoti, ettāvatā kho, mahānāma, ariyasāvako upāsako hotī”ti (saṃ. ni.5.1033)."],"lineRefs":[["vv12:4"]]},{"para":515,"vripara":null,"refs":["vv12:4"],"lines":["<b>Cakkhumato</b>ti pañcahi cakkhūhi cakkhumato buddhassa bhagavato.","Evaṃ upāsikābhāvakittanena āsayasuddhiṃ dassetvā payogasuddhiṃ dassetuṃ <b>“pāṇātipātā viratā”</b>tiādi vuttaṃ.","Tattha <b>sakena sāminā ahosiṃ tuṭṭhā</b>ti micchācārāveramaṇimāha.","Sesaṃ heṭṭhā vuttasadisameva."],"lineRefs":[["vv12:4"],["vv12:4"],["vv12:4"],["vv12:4"]]}],"wordLinks":[["vv12:1.1","veḷuriyathambhaṃ",0,0],["vv12:1.1","ruciraṃ",0,1],["vv12:1.1","pabhassaraṃ",0,2],["vv12:1.3","uccāvacā",0,3],["vv12:4.1","upāsikā",1,0],["vv12:4.1","cakkhumato",3,0],["vv12:4.3","pāṇātipātā viratā",3,1]],"before":[{"para":484,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Dutiyapatibbatāvimānavaṇṇanā"]},{"para":485,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["<b>Veḷuriyathambhan</b>ti dutiyapatibbatāvimānaṃ.","Tassa kā uppatti?","Sāvatthiyaṃ kira aññatarā upāsikā patibbatā hutvā saddhā pasannā pañca sīlāni suvisuddhāni katvā rakkhi, yathāvibhavañca dānāni adāsi, sā kālaṃ katvā tāvatiṃsabhavane uppajji.","Sesaṃ heṭṭhā vuttanayameva."]},{"para":487,"vripara":"101","title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["“Veḷuriyathambhaṃ ruciraṃ pabhassaraṃ, vimānamāruyha anekacittaṃ;"]},{"para":488,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Tatthacchasi devi mahānubhāve, uccāvacā iddhi vikubbamānā;"]},{"para":489,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Imā ca te accharāyo samantato, naccanti gāyanti pamodayanti ca."]},{"para":491,"vripara":"102","title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["“Deviddhipattāsi mahānubhāve,"]},{"para":492,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Manussabhūtā kimakāsi puññaṃ;"]},{"para":493,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Kenāsi evaṃ jalitānubhāvā,"]},{"para":494,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Vaṇṇo ca te sabbadisā pabhāsatī”ti.","– pucchi;"]},{"para":496,"vripara":"103","title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["“Sā devatā attamanā, moggallānena pucchitā;"]},{"para":497,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Pañhaṃ puṭṭhā viyākāsi, yassa kammassidaṃ phalaṃ”."]},{"para":499,"vripara":"104","title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["“Ahaṃ manussesu manussabhūtā, upāsikā cakkhumato ahosiṃ;"]},{"para":500,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Pāṇātipātā viratā ahosiṃ, loke adinnaṃ parivajjayissaṃ."]},{"para":502,"vripara":"105","title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["“Amajjapā no ca musā abhāṇiṃ, sakena sāminā ahosiṃ tuṭṭhā;"]},{"para":503,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Annañca pānañca pasannacittā, sakkacca dānaṃ vipulaṃ adāsiṃ."]},{"para":505,"vripara":"106","title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["“Tena metādiso vaṇṇo, tena me idha mijjhati;"]},{"para":506,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Uppajjanti ca me bhogā, ye keci manaso piyā."]},{"para":508,"vripara":"107","title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["“Akkhāmi te bhikkhu mahānubhāva,"]},{"para":509,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Manussabhūtā yamakāsi puññaṃ;"]},{"para":510,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Tenamhi evaṃ jalitānubhāvā,"]},{"para":511,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Vaṇṇo ca me sabbadisā pabhāsatī”ti.","– vissajjesi;"]}],"after":[{"para":516,"vripara":null,"title":"Dutiyapatibbatāvimānavaṇṇanā","lines":["Dutiyapatibbatāvimānavaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
