{"suttaId":"tha-ap169","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6757,6772],"vripara":"33"},"segments":{"tha-ap169:0.3":"Yūthikapupphiyattheraapadānaṃ","tha-ap169:1.1":"“Candabhāgānadītīre,","tha-ap169:1.2":"anusotaṃ vajāmahaṃ;","tha-ap169:1.3":"Sayambhuṃ addasaṃ tattha,","tha-ap169:1.4":"sālarājaṃva phullitaṃ.","tha-ap169:2.1":"“Pupphaṃ yūthikamādāya,","tha-ap169:2.2":"upagacchiṃ mahāmuniṃ;","tha-ap169:2.3":"Pasannacitto sumano,","tha-ap169:2.4":"buddhassa abhiropayiṃ.","tha-ap169:3.1":"“Catunnavutito kappe,","tha-ap169:3.2":"yaṃ pupphamabhiropayiṃ;","tha-ap169:3.3":"Duggatiṃ nābhijānāmi,","tha-ap169:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap169:4.1":"“Sattasaṭṭhimhito kappe,","tha-ap169:4.2":"eko sāmuddharo ahu;","tha-ap169:4.3":"Sattaratanasampanno,","tha-ap169:4.4":"cakkavattī mahabbalo.","tha-ap169:5.1":"“Paṭisambhidā catasso … pe …","tha-ap169:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap169:6.1":"Itthaṃ sudaṃ āyasmā yūthikapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap169:7.1":"Yūthikapupphiyattherassāpadānaṃ sattamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3103,"to":3103,"paras":[{"para":3103,"vripara":"33","refs":["tha-ap169:1"],"lines":["So tattha tena puññakoṭṭhāsena devamanussesu saṃsaranto ubhayasampattiyo anubhavitvā imasmiṃ buddhuppāde kulagehe nibbatto vuddhippatto bhagavato dhammadesanaṃ sutvā pasannamānaso pabbajitvā vattapaṭipattiyā sāsanaṃ sobhento nacirasseva arahā hutvā attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>candabhāgānadītīre</b>tiādimāha.","Taṃ sabbaṃ uttānatthamevāti."],"lineRefs":[["tha-ap169:1"],["tha-ap169:1"]]}],"wordLinks":[["tha-ap169:1.1","candabhāgānadītīre",0,0]]},"tika":null,"tika2":null}
