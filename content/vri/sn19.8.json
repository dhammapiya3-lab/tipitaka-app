{"suttaId":"sn19.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1246,1246],"vripara":"209"},"segments":{"sn19.8:0.3":"Sūcilomasuttaṃ","sn19.8:1.1":"“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ sūcilomaṃ purisaṃ vehāsaṃ gacchantaṃ.","sn19.8:1.2":"Tassa tā sūciyo uppatitvā uppatitvā tasseva kāye nipatanti.","sn19.8:1.3":"So sudaṃ aṭṭassaraṃ karoti … pe …","sn19.8:1.4":"eso, bhikkhave, satto imasmiṃyeva rājagahe sūto [sārathiko (ka. vinayepi)] ahosi … pe ….","sn19.8:1.5":"Aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":873,"to":873,"paras":[{"para":873,"vripara":"209","refs":["sn19.8:1"],"lines":["Sūcilomavatthusmiṃ <b>sūto</b>ti assadamako.","Godamakotipi vadantiyeva.","Tassa patodasūciyā vijjhanabhāvoyeva nimittaṃ ahosi.","Tasmā sūcilomapeto jāto.","Aṭṭhamaṃ."],"lineRefs":[["sn19.8:1"],["sn19.8:1"],["sn19.8:1"],["sn19.8:1"],["sn19.8:1"]]}],"wordLinks":[["sn19.8:1.3","sūto",0,0]],"before":[{"para":872,"vripara":null,"refs":[],"lines":["Sūcilomasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":899,"to":899,"paras":[{"para":899,"vripara":"209","refs":["sn19.8:1"],"lines":["Suṇoti pūretīti <b>sūto,</b> assadamakādiko."],"lineRefs":[["sn19.8:1"]]}],"wordLinks":[["sn19.8:1.3","sūto",0,0]]},"tika2":null}
