{"suttaId":"an6.66","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[686,687],"vripara":"66"},"segments":{"an6.66:0.3":"Arahattasuttaṃ","an6.66:1.1":"“Cha, bhikkhave, dhamme appahāya abhabbo arahattaṃ sacchikātuṃ.","an6.66:1.2":"Katame cha?","an6.66:1.3":"Thinaṃ [thīnaṃ (sī. syā. kaṃ. pī.)], middhaṃ, uddhaccaṃ, kukkuccaṃ, assaddhiyaṃ, pamādaṃ –","an6.66:1.4":"ime kho, bhikkhave, cha dhamme appahāya abhabbo arahattaṃ sacchikātuṃ.","an6.66:2.1":"“Cha, bhikkhave, dhamme pahāya bhabbo arahattaṃ sacchikātuṃ.","an6.66:2.2":"Katame cha?","an6.66:2.3":"Thinaṃ, middhaṃ, uddhaccaṃ, kukkuccaṃ, assaddhiyaṃ, pamādaṃ –","an6.66:2.4":"ime kho, bhikkhave, cha dhamme pahāya bhabbo arahattaṃ sacchikātun”ti.","an6.66:2.5":"Dutiyaṃ."},"unsure":[],"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":723,"to":724,"paras":[{"para":723,"vripara":"65-67","refs":["an6.66:1"],"lines":["65-67. Sattamassa paṭhame <b>assaddhiyan</b>ti assaddhabhāvaṃ.","<b>Duppaññatan</b>ti nippaññabhāvaṃ.","Dutiye <b>pamādan</b>ti sativippavāsaṃ.","Tatiye <b>ābhisamācārikan</b>ti uttamasamācārabhūtaṃ vattavasena paṇṇattisīlaṃ.","<b>Sekhadhamman</b>ti sekhapaṇṇattisīlaṃ.","<b>Sīlānī</b>ti cattāri mahāsīlāni."],"lineRefs":[["an6.66:1"],["an6.66:1"],["an6.66:1"],["an6.66:1"],["an6.66:1"],["an6.66:1"]]},{"para":724,"vripara":null,"refs":["an6.66:1"],"lines":["Saṅgaṇikārāmasuttavaṇṇanā"],"lineRefs":[["an6.66:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":744,"to":746,"paras":[{"para":744,"vripara":"65-67","refs":["an6.66:1"],"lines":["65-67. Sattamassa paṭhamādīni uttānatthāni.","Tatiye abhisamācāre uttamasamācāre bhavaṃ <b>ābhisamācārikaṃ,</b> vattappaṭipattivattaṃ.","Tenāha <b>“uttamasamācārabhūtan”</b>tiādi.","<b>Sekhapaṇṇattisīlan</b>ti sekhiyavasena paññattasīlaṃ."],"lineRefs":[["an6.66:1"],["an6.66:1"],["an6.66:1"],["an6.66:1"]]},{"para":745,"vripara":null,"refs":[