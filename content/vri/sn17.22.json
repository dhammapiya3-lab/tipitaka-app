{"suttaId":"sn17.22","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1122,1122],"vripara":"171"},"segments":{"sn17.22:0.3":"Kalyāṇīsuttaṃ","sn17.22:1.1":"Sāvatthiyaṃ viharati…pe…","sn17.22:1.2":"“dāruṇo, bhikkhave, lābhasakkārasiloko…pe…","sn17.22:1.3":"na tassa, bhikkhave, janapadakalyāṇī ekā ekassa cittaṃ pariyādāya tiṭṭhati yassa lābhasakkārasiloko cittaṃ pariyādāya tiṭṭhati.","sn17.22:1.4":"Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko…pe…","sn17.22:1.5":"evañhi vo, bhikkhave, sikkhitabba”nti.","sn17.22:1.6":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":809,"to":810,"paras":[{"para":809,"vripara":"170-171","refs":["sn17.22:1"],"lines":["Tatiyavaggassa paṭhame <b>na tassa, bhikkhave, mātugāmo</b>ti na tassa raho ekakassa nisinnassa tena dhammena atthikopi mātugāmo cittaṃ pariyādātuṃ sakkoti, yassa lābhasakkārasiloko cittaṃ pariyādātuṃ sakkotīti, attho.","Dutiyaṃ uttānamevāti.","Paṭhamadutiyāni. 3-6."],"lineRefs":[["sn17.22:1"],["sn17.22:1"],["sn17.22:1"]]},{"para":810,"vripara":null,"refs":["sn17.22:1"],"lines":["Ekaputtakasuttādivaṇṇanā 172-175."],"lineRefs":[["sn17.22:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":818,"to":820,"paras":[{"para":818,"vripara":"171","refs":["sn17.22:1"],"lines":["<b>Dutiyaṃ uttānameva,</b> tasseva atthassa kevalaṃ janapadakalyāṇīvasena vuttaṃ."],"lineRefs":[["sn17.22:1"]]},{"para":819,"vripara":null,"refs":["sn17.22:1"],"lines":["Kalyāṇīsuttavaṇṇanā niṭṭhitā. 3-6."],"lineRefs":[["sn17.22:1"]]},{"para":820,"vripara":null,"refs":["sn17.22:1"],"lines":["Ekaputtakasuttādivaṇṇanā 172-175."],"lineRefs":[["sn17.22:1"]]}],"wordLinks":[],"before":[{"para":817,"vripara":null,"title":"Kalyāṇīsuttavaṇṇanā","lines":["Kalyāṇīsuttavaṇṇanā 171."]}]},"tika2":null}
