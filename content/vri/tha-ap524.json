{"suttaId":"tha-ap524","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3507,3523],"vripara":"13"},"segments":{"tha-ap524:0.3":"Mañcadāyakattheraapadānaṃ","tha-ap524:1.1":"“Vipassino bhagavato,","tha-ap524:1.2":"lokajeṭṭhassa tādino;","tha-ap524:1.3":"Ekamañcaṃ [ekaṃ veccaṃ (syā.), ekapacchaṃ (pī.)] mayā dinnaṃ,","tha-ap524:1.4":"pasannena sapāṇinā.","tha-ap524:2.1":"“Hatthiyānaṃ assayānaṃ,","tha-ap524:2.2":"dibbayānaṃ samajjhagaṃ;","tha-ap524:2.3":"Tena mañcakadānena,","tha-ap524:2.4":"pattomhi āsavakkhayaṃ.","tha-ap524:3.1":"“Ekanavutito kappe,","tha-ap524:3.2":"yaṃ mañcamadadiṃ tadā;","tha-ap524:3.3":"Duggatiṃ nābhijānāmi,","tha-ap524:3.4":"mañcadānassidaṃ phalaṃ.","tha-ap524:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap524:4.3":"viharāmi anāsavo.","tha-ap524:5.1":"“Svāgataṃ vata me āsi … pe …","tha-ap524:5.3":"kataṃ buddhassa sāsanaṃ.","tha-ap524:6.1":"“Paṭisambhidā catasso … pe …","tha-ap524:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap524:7.1":"Itthaṃ sudaṃ āyasmā mañcadāyako [veccakadāyako (syā.), saddasaññikavaggepi idaṃ § apadānaṃ dissati] thero imā gāthāyo abhāsitthāti.","tha-ap524:8.1":"Mañcadāyakattherassāpadānaṃ dutiyaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
