{"suttaId":"thag1.70","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[406,414],"vripara":"70"},"segments":{"thag1.70:0.4":"Puṇṇattheragāthā","thag1.70:1.1":"“Sīlameva idha aggaṃ, paññavā pana uttamo;","thag1.70:1.3":"Manussesu ca devesu, sīlapaññāṇato jayan”ti.","thag1.70:1.5":"… Puṇṇo thero ….","thag1.70:1.6":"Vaggo sattamo niṭṭhito.","thag1.70:2.0":"Tassuddānaṃ –","thag1.70:2.1":"Vappo ca vajjiputto ca, pakkho vimalakoṇḍañño;","thag1.70:2.3":"Ukkhepakatavaccho ca, meghiyo ekadhammiko;","thag1.70:2.5":"Ekudāniyachannā ca, puṇṇatthero mahabbaloti."},"attha":null,"tika":null}
