{"suttaId":"ja224","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1502,1508],"vripara":"147"},"segments":{"ja224:0.4":"Kumbhilajātakaṃ (2-8-4)","ja224:1.1":"Yassete caturo dhammā,","ja224:1.2":"vānarinda yathā tava;","ja224:1.3":"Saccaṃ dhammo dhiti cāgo,","ja224:1.4":"diṭṭhaṃ so ativattati.","ja224:2.1":"Yassa cete na vijjanti,","ja224:2.2":"guṇā paramabhaddakā;","ja224:2.3":"Saccaṃ dhammo dhiti cāgo,","ja224:2.4":"diṭṭhaṃ so nātivattatīti.","ja224:3.1":"Kumbhilajātakaṃ catutthaṃ."},"unsure":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1312,"to":1312,"paras":[{"para":1312,"vripara":null,"refs":["ja224:2"],"lines":["Tattha <b>guṇā paramabhaddakā</b>ti yassa ete paramabhaddakā cattāro rāsaṭṭhena piṇḍaṭṭhena guṇā na vijjanti, so paccāmittaṃ atikkamituṃ na sakkotīti.","Sesamettha sabbaṃ heṭṭhā kumbhilajātake vuttanayameva saddhiṃ samodhānenāti."],"lineRefs":[["ja224:2"],["ja224:2"]]}],"wordLinks":[["ja224:2.1","guṇā paramabhaddakā",0,0]],"before":[{"para":1300,"vripara":null,"refs":[],"lines":["Taṃ sutvā bārāṇasirājā deviyā sabbissariyaṃ adāsi.","Tato paṭṭhāya samaggā sammodamānā vasiṃsu."],"lineRefs":[[],[]]},{"para":1301,"vripara":null,"refs":[],"lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne dve jayampatikā sotāpattiphale patiṭṭhahiṃsu.","“Tadā jayampatikā ime dve jayampatikā ahesuṃ, paṇḍitāmacco pana ahameva ahosin”ti."],"lineRefs":[[],[]]},{"para":1302,"vripara":null,"refs":[],"lines":["Puṭabhattajātakavaṇṇanā tatiyā."],"lineRefs":[[]]},{"para":1304,"vripara":null,"refs":[],"lines":["[224]4. Kumbhilajātakavaṇṇanā"],"lineRefs":[[]]},{"para":1305,"vripara":null,"refs":[],"lines":["<b>Yassete caturo dhammā</b>ti idaṃ satthā veḷuvane viharanto devadattaṃ ārabbha kathesi."],"lineRefs":[[]]},{"para":1307,"vripara":"147","refs":[],"lines":["“Yassete caturo dhammā, vānarinda yathā tava;"],"lineRefs":[[]]},{"para":1308,"vripa