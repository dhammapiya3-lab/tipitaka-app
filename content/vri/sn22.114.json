{"suttaId":"sn22.114","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[747,747],"vripara":"114"},"segments":{"sn22.114:0.3":"Vijjāsuttaṃ","sn22.114:1.1":"Sāvatthinidānaṃ.","sn22.114:1.2":"Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca –","sn22.114:1.3":"“‘vijjā vijjā’ti, bhante, vuccati.","sn22.114:1.4":"Katamā nu kho, bhante, vijjā,","sn22.114:1.5":"kittāvatā ca vijjāgato hotī”ti?","sn22.114:1.6":"“Idha, bhikkhu, sutavā ariyasāvako rūpaṃ pajānāti, rūpasamudayaṃ pajānāti, rūpanirodhaṃ pajānāti, rūpanirodhagāminiṃ paṭipadaṃ pajānāti.","sn22.114:1.7":"Vedanaṃ…","sn22.114:1.8":"saññaṃ…","sn22.114:1.9":"saṅkhāre pajānāti…pe…","sn22.114:1.10":"viññāṇanirodhagāminiṃ paṭipadaṃ pajānāti.","sn22.114:1.11":"Ayaṃ vuccati, bhikkhu, vijjā.","sn22.114:1.12":"Ettāvatā ca vijjāgato hotī”ti.","sn22.114:1.13":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":371,"to":372,"paras":[{"para":371,"vripara":"113-114","refs":["sn22.114:1"],"lines":["Dhammakathikavaggassa paṭhame <b>ettāvatā ca avijjāgato hotī</b>ti yāvatā imāya catūsu saccesu aññāṇabhūtāya avijjāya samannāgato, ettāvatā avijjāgato hotīti attho.","Dutiyepi eseva nayo.","Paṭhamadutiyāni. 3."],"lineRefs":[["sn22.114:1"],["sn22.114:1"],["sn22.114:1"]]},{"para":372,"vripara":null,"refs":["sn22.114:1"],"lines":["Dhammakathikasuttavaṇṇanā 115."],"lineRefs":[["sn22.114:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":365,"to":368,"paras":[{"para":365,"vripara":"113-114","refs":["sn22.114:1"],"lines":["<b>Yāvatā</b>ti yasmā.","<b>Imāya…pe… samannāgato</b>ti “idaṃ dukkhanti yathābhūtaṃ nappajānātī”tiādinā nayena vuttāya catūsu ariyasaccesu aññāṇasabhāvāya avijjāya sammohena samannāgato.","<b>Ettāvatā</b>ti ettakena kāraṇena <b>avijjāgato</b> samaṅgībhūtena upagato, avijjāya vā upeto nāma hoti."],"lineRefs":[["sn22.114:1"],["sn22.114:1"],["sn22.114:1"]]},{"para":366,"vripara":null,"refs":["sn22.114:1"],"lines":["<b>Dutiyepī</b>ti vijjāsutte.","“Vijjāvasena desanā”ti ayameva visesoti āha <b>“eseva nayo”</b>ti."],"lineRefs":[["sn22.114:1"],["sn22.114:1"]]},{"para":367,"vripara":null,"refs":["sn22.114:1"],"lines":["Avijjāsuttādivaṇṇanā niṭṭhitā. 3."],"lineRefs":[["sn22.114:1"]]},{"para":368,"vripara":null,"refs":["sn22.114:1"],"lines":["Dhammakathikasuttavaṇṇanā 115."],"lineRefs":[["sn22.114:1"]]}],"wordLinks":[]},"tika2":null}
