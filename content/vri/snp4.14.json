{"suttaId":"snp4.14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3141,3203],"vripara":"921"},"segments":{"snp4.14:0.2":"Tuvaṭakasuttaṃ","snp4.14:1.1":"“Pucchāmi taṃ ādiccabandhu [ādiccabandhuṃ (sī. syā.)],","snp4.14:1.2":"vivekaṃ santipadañca mahesi;","snp4.14:1.3":"Kathaṃ disvā nibbāti bhikkhu,","snp4.14:1.4":"anupādiyāno lokasmiṃ kiñci”. 922.","snp4.14:2.1":"“Mūlaṃ papañcasaṅkhāya,","snp4.14:2.2":"(iti bhagavā)","snp4.14:2.3":"Mantā asmīti sabbamuparundhe [sabbamuparuddhe (syā. pī. ka.)];","snp4.14:2.4":"Yā kāci taṇhā ajjhattaṃ,","snp4.14:2.5":"Tāsaṃ vinayā [vinayāya (?)] sadā sato sikkhe. 923.","snp4.14:3.1":"“Yaṃ kiñci dhammamabhijaññā,","snp4.14:3.2":"ajjhattaṃ athavāpi bahiddhā;","snp4.14:3.3":"Na tena thāmaṃ [mānaṃ (sī. ka.)] kubbetha,","snp4.14:3.4":"na hi sā nibbuti sataṃ vuttā. 924.","snp4.14:4.1":"“Seyyo na tena maññeyya,","snp4.14:4.2":"nīceyyo athavāpi sarikkho;","snp4.14:4.3":"Phuṭṭho [puṭṭho (sī. syā. ka.)] anekarūpehi,","snp4.14:4.4":"nātumānaṃ vikappayaṃ tiṭṭhe. 925.","snp4.14:5.1":"“Ajjhattamevupasame,","snp4.14:5.2":"na aññato bhikkhu santimeseyya;","snp4.14:5.3":"Ajjhattaṃ upasantassa,","snp4.14:5.4":"natthi attā kuto nirattā vā. 926.","snp4.14:6.1":"“Majjhe yathā samuddassa,","snp4.14:6.2":"ūmi no jāyatī ṭhito hoti;","snp4.14:6.3":"Evaṃ ṭhito anejassa,","snp4.14:6.4":"ussadaṃ bhikkhu na kareyya kuhiñci”. 927.","snp4.14:7.1":"“Akittayī vivaṭacakkhu,","snp4.14:7.2":"sakkhidhammaṃ parissayavinayaṃ;","snp4.14:7.3":"Paṭipadaṃ vadehi bhaddante,","snp4.14:7.4":"pātimokkhaṃ athavāpi samādhiṃ”. 928.","snp4.14:8.1":"“Cakkhūhi neva lolassa,","snp4.14:8.2":"gāmakathāya āvaraye sotaṃ;","snp4.14:8.3":"Rase ca nānugijjheyya,","snp4.14:8.4":"na ca mamāyetha kiñci lokasmiṃ. 929.","snp4.14:9.1":"“Phassena yadā phuṭṭhassa,","snp4.14:9.2":"paridevaṃ bhikkhu na kareyya kuhiñci;","snp4.14:9.3":"Bhavañca nābhijappeyya,","snp4.14:9.4":"bheravesu ca na sampavedheyya. 930.","snp4.14:10.1":"“Annānamatho pānānaṃ,","snp4.14:10.2":"khādanīyānaṃ athopi vatthānaṃ;","snp4.14:10.3":"Laddhā na sannidhiṃ kayirā,","snp4.14:10.4":"na ca parittase tāni alabhamāno. 931.","snp4.14:11.1":"“Jhāyī na pādalolassa,","snp4.14:11.2":"virame kukkuccā nappamajjeyya;","snp4.14:11.3":"Athāsanesu sayanesu,","snp4.14:11.4":"appasaddesu bhikkhu vihareyya. 932.","snp4.14:12.1":"“Niddaṃ na bahulīkareyya,","snp4.14:12.2":"jāgariyaṃ bhajeyya ātāpī;","snp4.14:12.3":"Tandiṃ māyaṃ hassaṃ khiḍḍaṃ,","snp4.14:12.4":"methunaṃ vippajahe savibhūsaṃ. 933.","snp4.14:13.1":"“Āthabbaṇaṃ supinaṃ lakkhaṇaṃ,","snp4.14:13.2":"no vidahe athopi nakkhattaṃ;","snp4.14:13.3":"Virutañca gabbhakaraṇaṃ,","snp4.14:13.4":"tikicchaṃ māmako na seveyya. 934.","snp4.14:14.1":"“Nindāya nappavedheyya,","snp4.14:14.2":"na uṇṇameyya pasaṃsito bhikkhu;","snp4.14:14.3":"Lobhaṃ saha macchariyena,","snp4.14:14.4":"kodhaṃ pesuṇiyañca panudeyya. 935.","snp4.14:15.1":"“Kayavikkaye na tiṭṭheyya,","snp4.14:15.2":"upavādaṃ bhikkhu na kareyya kuhiñci;","snp4.14:15.3":"Gāme ca nābhisajjeyya,","snp4.14:15.4":"lābhakamyā janaṃ na lapayeyya. 936.","snp4.14:16.1":"“Na ca katthitā siyā bhikkhu,","snp4.14:16.2":"na ca vācaṃ payuttaṃ bhāseyya;","snp4.14:16.3":"Pāgabbhiyaṃ na sikkheyya,","snp4.14:16.4":"kathaṃ viggāhikaṃ na kathayeyya. 937.","snp4.14:17.1":"“Mosavajje na nīyetha,","snp4.14:17.2":"sampajāno saṭhāni na kayirā;","snp4.14:17.3":"Atha jīvitena paññāya,","snp4.14:17.4":"sīlabbatena nāññamatimaññe. 938.","snp4.14:18.1":"“Sutvā rusito bahuṃ vācaṃ,","snp4.14:18.2":"samaṇānaṃ vā puthujanānaṃ [puthuvacanānaṃ (sī. syā. pī.)];","snp4.14:18.3":"Pharusena ne na paṭivajjā,","snp4.14:18.4":"na hi santo paṭisenikaronti. 939.","snp4.14:19.1":"“Etañca dhammamaññāya,","snp4.14:19.2":"vicinaṃ bhikkhu sadā sato sikkhe;","snp4.14:19.3":"Santīti nibbutiṃ ñatvā,","snp4.14:19.4":"sāsane gotamassa na pamajjeyya. 940.","snp4.14:20.1":"“Abhibhū hi so anabhibhūto,","snp4.14:20.2":"sakkhidhammamanītihamadassī;","snp4.14:20.3":"Tasmā hi tassa bhagavato sāsane,","snp4.14:20.4":"appamatto sadā namassamanusikkhe”ti.","snp4.14:20.5":"Tuvaṭakasuttaṃ cuddasamaṃ niṭṭhitaṃ. 15."},"unsure":[],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2413,"to":2418,"paras":[{"para":2413,"vripara":"929-930","refs":["snp4.14:9"],"lines":["Athassa bhagavā yasmā indriyasaṃvaro sīlassa rakkhā, yasmā vā iminā anukkamena desiyamānā ayaṃ desanā tāsaṃ devatānaṃ sappāyā, tasmā indriyasaṃvarato pabhuti paṭipadaṃ dassento <b>“cakkhūhī”</b>tiādimāraddho.","Tattha <b>cakkhūhi neva lolassā</b>ti adiṭṭhadakkhitabbādivasena cakkhūhi lolo nevassa.","<b>Gāmakathāya āvaraye sota</b>nti tiracchānakathāto sotaṃ āvareyya.","<b>Phassenāti</b> rogaphassena.","<b>Bhavañca</b> <b>nābhijappeyyā</b>ti tassa phassassa vinodanatthāya kāmabhavādibhavañca na pattheyya.","<b>Bheravesu ca na sampavedheyyā</b>ti tassa phassassa paccayabhūtesu sīhabyagghādīsu bheravesu ca na sampavedheyya, avasesesu vā ghānindriyamanindriyavisayesu nappavedheyya.","Evaṃ paripūro indriyasaṃvaro vutto hoti.","Purimehi vā indriyasaṃvaraṃ dassetvā iminā “araññe vasatā bheravaṃ disvā vā sutvā vā na vedhitabba”nti dasseti. 931."],"lineRefs":[["snp4.14:9"],["snp4.14:9"],["snp4.14:9"],["snp4.14:9"],["snp4.14:9"],["snp4.14:9"],["snp4.14:9"],["snp4.14:9"]]},{"para":2414,"vripara":"931","refs":["snp4.14:9"],"lines":["<b>Laddhā na sannidhiṃ kayirā</b>ti etesaṃ annādīnaṃ yaṃkiñci dhammena labhitvā “araññe ca senāsane vasatā sadā dullabha”nti cintetvā sannidhiṃ na kareyya. 932."],"lineRefs":[["snp4.14:9"]]},{"para":2415,"vripara":"932","refs":["snp4.14:9"],"lines":["<b>Jhāyī</b> <b>na pādalolassā</b>ti jhānābhirato ca na pādalolo assa.","<b>Virame kukkuccā nappamajjeyyā</b>ti hatthakukkuccādikukkuccaṃ vinodeyya.","Sakkaccakāritāya cettha nappamajjeyya. 933."],"lineRefs":[["snp4.14:9"],["snp4.14:9"],["snp4.14:9"]]},{"para":2416,"vripara":"933","refs":["snp4.14:9"],"lines":["<b>Tandiṃ māyaṃ hassaṃ khiḍḍa</b>nti ālasiyañca māyañca hassañca kāyikacetasikakhiḍḍañca.","<b>Savibhūsa</b>nti saddhiṃ vibhūsāya. 934-7."],"lineRefs":[["snp4.14:9"],["snp4.14:9"]]},{"para":2417,"vripara":"934-937","refs":["snp4.14:9","snp4.14:14"],"lines":["<b>Āthabbaṇa</b>nti āthabbaṇikamantappayogaṃ.","<b>Supina</b>nti supinasatthaṃ.","<b>Lakkhaṇa</b>nti maṇilakkhaṇādiṃ.","<b>No vidahe</b>ti nappayojeyya.","<b>Viruta</b>nti migādīnaṃ vassitaṃ.","<b>Pesuṇiya</b>nti pesuññaṃ.","<b>Kayavikkaye</b>ti pañcahi sahadhammikehi saddhiṃ vañcanāvasena vā udayapatthanāvasena vā na tiṭṭheyya.","<b>Upavādaṃ bhikkhu na kareyyā</b>ti upavādakare kilese anibbattento attani parehi samaṇabrāhmaṇehi upavādaṃ na janeyya.","<b>Gāme ca nābhisajjeyyā</b>ti gāme ca gihisaṃsaggādīhi nābhisajjeyya.","<b>Lābhakamyā janaṃ na lapayeyyā</b>ti lābhakāmatāya janaṃ nālapayeyya.","<b>Payutta</b>nti cīvarādīhi sampayuttaṃ, tadatthaṃ vā payojitaṃ. 938-9."],"lineRefs":[["snp4.14:9"],["snp4.14:9"],["snp4.14:9"],["snp4.14:9"],["snp4.14:9"],["snp4.14:14"],["snp4.14:14"],["snp4.14:14"],["snp4.14:14"],["snp4.14:14"],["snp4.14:14"]]},{"para":2418,"vripara":"938-939","refs":["snp4.14:14","snp4.14:18"],"lines":["<b>Mosavajje na nīyethā</b>ti musāvāde na nīyetha.","<b>Jīvitenā</b>ti jīvikāya.","<b>Sutvā rusito bahuṃ vācaṃ, samaṇānaṃ vā puthujanāna</b>nti rusito ghaṭṭito parehi tesa samaṇānaṃ vā khattiyādibhedānaṃ vā aññesaṃ puthujanānaṃ bahumpi aniṭṭhavācaṃ sutvā.","<b>Na paṭivajjā</b>ti na paṭivadeyya.","Kiṃ kāraṇaṃ?","<b>Na hi santo paṭisenikaronti</b>. 940."],"lineRefs":[["snp4.14:14"],["snp4.14:14"],["snp4.14:18"],["snp4.14:18"],["snp4.14:18"],["snp4.14:18"]]}],"wordLinks":[["snp4.14:9.3","bhavañca nābhijappeyyā",0,4],["snp4.14:9.3","bheravesu ca na sampavedheyyā",0,5],["snp4.14:14.3","pesuṇiyaṃ",4,5],["snp4.14:18.1","sutvā rusito bahuṃ vācaṃ samaṇānaṃ vā puthujanānaṃ",5,2],["snp4.14:18.3","na paṭivajjā",5,3],["snp4.14:18.3","na hi santo paṭisenikaronti",5,5]]},"tika":null,"tika2":null}
