{"suttaId":"tha-ap230","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7921,7933],"vripara":"39"},"segments":{"tha-ap230:0.3":"Miñjavaṭaṃsakiyattheraapadānaṃ","tha-ap230:1.1":"“Nibbute lokanāthamhi,","tha-ap230:1.2":"sikhimhi vadataṃ vare;","tha-ap230:1.3":"Vaṭaṃsakehi ākiṇṇaṃ,","tha-ap230:1.4":"bodhipūjaṃ akāsahaṃ.","tha-ap230:2.1":"“Ekattiṃse ito kappe,","tha-ap230:2.2":"yaṃ pūjamakariṃ tadā;","tha-ap230:2.3":"Duggatiṃ nābhijānāmi,","tha-ap230:2.4":"bodhipūjāyidaṃ phalaṃ.","tha-ap230:3.1":"“Ito chabbīsatikappe,","tha-ap230:3.2":"ahuṃ meghabbhanāmako;","tha-ap230:3.3":"Sattaratanasampanno,","tha-ap230:3.4":"cakkavattī mahabbalo.","tha-ap230:4.1":"“Paṭisambhidā catasso … pe …","tha-ap230:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap230:5.1":"Itthaṃ sudaṃ āyasmā miñjavaṭaṃsakiyo thero imā gāthāyo abhāsitthāti.","tha-ap230:6.1":"Miñjavaṭaṃsakiyattherassāpadānaṃ aṭṭhamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
