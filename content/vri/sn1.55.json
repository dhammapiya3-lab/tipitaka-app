{"suttaId":"sn1.55","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[684,688],"vripara":"55"},"segments":{"sn1.55:0.3":"Paṭhamajanasuttaṃ","sn1.55:1.1":"“Kiṃsu janeti purisaṃ, kiṃsu tassa vidhāvati;","sn1.55:1.3":"Kiṃsu saṃsāramāpādi, kiṃsu tassa mahabbhayan”ti.","sn1.55:2.1":"“Taṇhā janeti purisaṃ, cittamassa vidhāvati;","sn1.55:2.3":"Satto saṃsāramāpādi, dukkhamassa mahabbhayan”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":446,"to":446,"paras":[{"para":446,"vripara":"55","refs":["sn1.55:1"],"lines":["Pañcame <b>vidhāvatī</b>ti parasamuddādigamanavasena ito cito ca vidhāvati.","Pañcamaṃ."],"lineRefs":[["sn1.55:1"],["sn1.55:1"]]}],"wordLinks":[["sn1.55:1.1","vidhāvatī",0,0]]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":540,"to":540,"paras":[{"para":540,"vripara":"55","refs":["sn1.55:1"],"lines":["<b>Vidhāvatī</b>ti vividhaṃ rūpaṃ padhāvati, yathākāmaṃ pavattatīti attho."],"lineRefs":[["sn1.55:1"]]}],"wordLinks":[["sn1.55:1.1","vidhāvatī",0,0]]},"tika2":null}
