{"suttaId":"tha-ap136","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6105,6129],"vripara":"26"},"segments":{"tha-ap136:0.3":"Pupphacchadaniyattheraapadānaṃ","tha-ap136:1.1":"“Sunando nāma nāmena,","tha-ap136:1.2":"brāhmaṇo mantapāragū;","tha-ap136:1.3":"Ajjhāyako yācayogo,","tha-ap136:1.4":"vājapeyyaṃ ayājayi. 27.","tha-ap136:2.1":"“Padumuttaro lokavidū,","tha-ap136:2.2":"aggo kāruṇiko isi;","tha-ap136:2.3":"Janataṃ anukampanto,","tha-ap136:2.4":"ambare caṅkamī tadā. 28.","tha-ap136:3.1":"“Caṅkamitvāna sambuddho,","tha-ap136:3.2":"sabbaññū lokanāyako;","tha-ap136:3.3":"Mettāya aphari satte,","tha-ap136:3.4":"appamāṇe [appamāṇaṃ (sī. syā.)] nirūpadhi. 29.","tha-ap136:4.1":"“Vaṇṭe chetvāna pupphāni,","tha-ap136:4.2":"brāhmaṇo mantapāragū;","tha-ap136:4.3":"Sabbe sisse samānetvā,","tha-ap136:4.4":"ākāse ukkhipāpayi. 30.","tha-ap136:5.1":"“Yāvatā nagaraṃ āsi,","tha-ap136:5.2":"pupphānaṃ chadanaṃ tadā;","tha-ap136:5.3":"Buddhassa ānubhāvena,","tha-ap136:5.4":"sattāhaṃ na vigacchatha. 31.","tha-ap136:6.1":"“Teneva sukkamūlena,","tha-ap136:6.2":"anubhotvāna sampadā;","tha-ap136:6.3":"Sabbāsave pariññāya,","tha-ap136:6.4":"tiṇṇo loke visattikaṃ. 32.","tha-ap136:7.1":"“Ekārase kappasate,","tha-ap136:7.2":"pañcatiṃsāsu khattiyā;","tha-ap136:7.3":"Ambaraṃsasanāmā te,","tha-ap136:7.4":"cakkavattī mahabbalā. 33.","tha-ap136:8.1":"“Paṭisambhidā catasso…pe…","tha-ap136:8.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap136:9.1":"Itthaṃ sudaṃ āyasmā pupphacchadaniyo thero imā gāthāyo abhāsitthāti.","tha-ap136:10.1":"Pupphacchadaniyattherassāpadānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2954,"to":2954,"paras":[{"para":2954,"vripara":"26","refs":["tha-ap136:1"],"lines":["So tena puññakammena devamanussesu sukhaṃ anubhavitvā imasmiṃ buddhuppāde sāvatthiyaṃ ekasmiṃ kulagehe nibbatto saddhājāto pabbajitvā khuraggeyeva arahattaṃ patvā attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>sunando nāma nāmenā</b>tiādimāha.","Taṃ heṭṭhā vuttanayattā suviññeyyamevāti."],"lineRefs":[["tha-ap136:1"],["tha-ap136:1"]]}],"wordLinks":[["tha-ap136:1.1","sunando nāma nāmenā",0,0]],"before":[{"para":2952,"vripara":null,"title":"Pupphacchadaniyattheraapadānavaṇṇanā","lines":["Pupphacchadaniyattheraapadānavaṇṇanā"]},{"para":2953,"vripara":null,"title":"Pupphacchadaniyattheraapadānavaṇṇanā","lines":["<b>Sunando nāma nāmenā</b>tiādikaṃ āyasmato pupphacchadaniyattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro anekesu bhavesu vivaṭṭūpanissayāni puññāni upacinanto padumuttarassa bhagavato kāle brāhmaṇakule nibbatto viññutaṃ patvā sakasippesu nipphattiṃ patto mahābhogo mahāyaso dānābhirato ahosi.","Ekadivasaṃ so “sakalajambudīpe ime yācakā nāma ‘ahaṃ dānaṃ na laddhosmī’ti vattuṃ mā labhantū”ti mahādānaṃ sajjesi.","Tadā padumuttaro bhagavā saparivāro ākāsena gacchati.","Brāhmaṇo taṃ disvā pasannacitto sakasisse pakkosāpetvā pupphāni āharāpetvā ākāse ukkhipitvā pūjesi.","Tāni sakalanagaraṃ chādetvā satta divasāni aṭṭhaṃsu. 26."]}],"after":[{"para":2955,"vripara":null,"title":"Pupphacchadaniyattheraapadānavaṇṇanā","lines":["Pupphacchadaniyattheraapadānavaṇṇanā samattā. 5."]}]},"tika":null,"tika2":null}
