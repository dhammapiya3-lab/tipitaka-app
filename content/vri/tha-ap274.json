{"suttaId":"tha-ap274","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8569,8584],"vripara":"5"},"segments":{"tha-ap274:0.3":"Tilamuṭṭhidāyakattheraapadānaṃ","tha-ap274:1.1":"“Mama saṅkappamaññāya,","tha-ap274:1.2":"satthā lokagganāyako;","tha-ap274:1.3":"Manomayena kāyena,","tha-ap274:1.4":"iddhiyā upasaṅkami.","tha-ap274:2.1":"“Satthāraṃ upasaṅkantaṃ,","tha-ap274:2.2":"vanditvā purisuttamaṃ;","tha-ap274:2.3":"Pasannacitto sumano,","tha-ap274:2.4":"tilamuṭṭhimadāsahaṃ.","tha-ap274:3.1":"“Ekanavutito kappe,","tha-ap274:3.2":"yaṃ dānamadadiṃ tadā;","tha-ap274:3.3":"Duggatiṃ nābhijānāmi,","tha-ap274:3.4":"tilamuṭṭhiyidaṃ phalaṃ.","tha-ap274:4.1":"“Ito soḷasakappamhi,","tha-ap274:4.2":"tantiso [khantiyo (syā.)] nāma khattiyo;","tha-ap274:4.3":"Sattaratanasampanno,","tha-ap274:4.4":"cakkavattī mahabbalo.","tha-ap274:5.1":"“Paṭisambhidā catasso … pe …","tha-ap274:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap274:6.1":"Itthaṃ sudaṃ āyasmā tilamuṭṭhidāyako thero imā gāthāyo abhāsitthāti.","tha-ap274:7.1":"Tilamuṭṭhidāyakattherassāpadānaṃ dutiyaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3232,"to":3232,"paras":[{"para":3232,"vripara":"5","refs":["tha-ap274:1"],"lines":["Dutiyāpadāne <b>manomayena kāyenā</b>ti yathā cittavasena pavattakāyenāti attho."],"lineRefs":[["tha-ap274:1"]]}],"wordLinks":[["tha-ap274:1.3","manomayena kāyenā",0,0]]},"tika":null,"tika2":null}
