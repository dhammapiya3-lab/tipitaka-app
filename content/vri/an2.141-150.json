{"suttaId":"an2.141-150","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-ii","vriCode":"s0402m1.mul","paras":[248,258],"vripara":"142"},"segments":{"an2.141:0.2":"(13) 3. Dānavaggo","an2.141:1.1":"“Dvemāni, bhikkhave, dānāni.","an2.141:1.2":"Katamāni dve?","an2.141:1.3":"Āmisadānañca dhammadānañca.","an2.141:1.4":"Imāni kho, bhikkhave, dve dānāni.","an2.141:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ dānānaṃ yadidaṃ dhammadānan”ti.","an2.142:1.1":"“Dveme, bhikkhave, yāgā.","an2.142:1.2":"Katame dve?","an2.142:1.3":"Āmisayāgo ca dhammayāgo ca.","an2.142:1.4":"Ime kho, bhikkhave, dve yāgā.","an2.142:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ yāgānaṃ yadidaṃ dhammayāgo”ti.","an2.143:1.1":"“Dveme, bhikkhave, cāgā.","an2.143:1.2":"Katame dve?","an2.143:1.3":"Āmisacāgo ca dhammacāgo ca.","an2.143:1.4":"Ime kho, bhikkhave, dve cāgā.","an2.143:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ cāgānaṃ yadidaṃ dhammacāgo”ti.","an2.144:1.1":"“Dveme, bhikkhave, pariccāgā.","an2.144:1.2":"Katame dve?","an2.144:1.3":"Āmisapariccāgo ca dhammapariccāgo ca.","an2.144:1.4":"Ime kho, bhikkhave, dve pariccāgā.","an2.144:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ pariccāgānaṃ yadidaṃ dhammapariccāgo”ti.","an2.145:1.1":"“Dveme, bhikkhave, bhogā.","an2.145:1.2":"Katame dve?","an2.145:1.3":"Āmisabhogo ca dhammabhogo ca.","an2.145:1.4":"Ime kho, bhikkhave, dve bhogā.","an2.145:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ bhogānaṃ yadidaṃ dhammabhogo”ti.","an2.146:1.1":"“Dveme, bhikkhave, sambhogā.","an2.146:1.2":"Katame dve?","an2.146:1.3":"Āmisasambhogo ca dhammasambhogo ca.","an2.146:1.4":"Ime kho, bhikkhave, dve sambhogā.","an2.146:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sambhogānaṃ yadidaṃ dhammasambhogo”ti.","an2.147:1.1":"“Dveme, bhikkhave, saṃvibhāgā.","an2.147:1.2":"Katame dve?","an2.147:1.3":"Āmisasaṃvibhāgo ca dhammasaṃvibhāgo ca.","an2.147:1.4":"Ime kho, bhikkhave, dve saṃvibhāgā.","an2.147:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ saṃvibhāgānaṃ yadidaṃ dhammasaṃvibhāgo”ti.","an2.148:1.1":"“Dveme, bhikkhave, saṅgahā.","an2.148:1.2":"Katame dve?","an2.148:1.3":"Āmisasaṅgaho ca dhammasaṅgaho ca.","an2.148:1.4":"Ime kho, bhikkhave, dve saṅgahā.","an2.148:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ saṅgahānaṃ yadidaṃ dhammasaṅgaho”ti.","an2.149:1.1":"“Dveme, bhikkhave, anuggahā.","an2.149:1.2":"Katame dve?","an2.149:1.3":"Āmisānuggaho ca dhammānuggaho ca.","an2.149:1.4":"Ime kho, bhikkhave, dve anuggahā.","an2.149:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ anuggahānaṃ yadidaṃ dhammānuggaho”ti.","an2.150:1.1":"“Dvemā, bhikkhave, anukampā.","an2.150:1.2":"Katamā dve?","an2.150:1.3":"Āmisānukampā ca dhammānukampā ca.","an2.150:1.4":"Imā kho, bhikkhave, dve anukampā.","an2.150:1.5":"Etadaggaṃ, bhikkhave, imāsaṃ dvinnaṃ anukampānaṃ yadidaṃ dhammānukampā”ti.","an2.150:1.6":"Dānavaggo tatiyo."},"attha":{"book":"Mp-ii","bookName":"Dukanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":264,"to":271,"paras":[{"para":264,"vripara":"142","refs":["an2.141:1"],"lines":["Tatiyassa paṭhame <b>dānānī</b>ti diyyanakavasena dānāni, deyyadhammassetaṃ nāmaṃ.","Savatthukā vā cetanā dānaṃ, sampattipariccāgassetaṃ nāmaṃ.","<b>Āmisadānan</b>ti cattāro paccayā diyyanakavasena āmisadānaṃ nāma.","<b>Dhammadānan</b>ti idhekacco amatapattipaṭipadaṃ kathetvā deti, idaṃ dhammadānaṃ nāma."],"lineRefs":[["an2.141:1"],["an2.141:1"],["an2.141:1"],["an2.141:1"]]},{"para":265,"vripara":"143","refs":["an2.142:1"],"lines":["Dutiye cattāro paccayā yajanakavasena <b>yāgo</b> nāma <b>dhammopi</b> yajanakavasena yāgoti veditabbo."],"lineRefs":[["an2.142:1"]]},{"para":266,"vripara":"144","refs":["an2.143:1"],"lines":["Tatiye āmisassa cajanaṃ <b>āmisacāgo,</b> dhammassa cajanaṃ <b>dhammacāgo</b>.","Catutthe upasaggamattaṃ viseso."],"lineRefs":[["an2.143:1"],["an2.143:1"]]},{"para":267,"vripara":"146","refs":["an2.145:1"],"lines":["Pañcame catunnaṃ paccayānaṃ bhuñjanaṃ <b>āmisabhogo,</b> dhammassa bhuñjanaṃ <b>dhammabhogo</b>.","Chaṭṭhe upasaggamattaṃ viseso."],"lineRefs":[["an2.145:1"],["an2.145:1"]]},{"para":268,"vripara":"148","refs":["an2.147:1"],"lines":["Sattame catunnaṃ paccayānaṃ saṃvibhajanaṃ <b>āmisasaṃvibhāgo,</b> dhammassa saṃvibhajanaṃ <b>dhammasaṃvibhāgo</b>."],"lineRefs":[["an2.147:1"]]},{"para":269,"vripara":"149","refs":["an2.148:1"],"lines":["Aṭṭhame catūhi paccayehi saṅgaho <b>āmisasaṅgaho,</b> dhammena saṅgaho <b>dhammasaṅgaho</b>."],"lineRefs":[["an2.148:1"]]},{"para":270,"vripara":"150","refs":["an2.149:1"],"lines":["Navame catūhi paccayehi anuggaṇhanaṃ <b>āmisānuggaho,</b> dhammena anuggaṇhanaṃ <b>dhammānuggaho</b>."],"lineRefs":[["an2.149:1"]]},{"para":271,"vripara":"151","refs":["an2.150:1"],"lines":["Dasame catūhi paccayehi anukampanaṃ <b>āmisānukampā,</b> dhammena anukampanaṃ <b>dhammānukampā</b>ti."],"lineRefs":[["an2.150:1"]]}],"wordLinks":[["an2.141:1.1","dānānī",0,0],["an2.141:1.4","dānānī",0,0],["an2.141:1.5","dānānī",0,0],["an2.141:1.3","āmisadānaṃ",0,2],["an2.141:1.3","dhammadānaṃ",0,3],["an2.141:1.5","dhammadānaṃ",0,3],["an2.142:1.1","yāgo",1,0],["an2.142:1.3","yāgo",1,0],["an2.142:1.4","yāgo",1,0],["an2.142:1.5","yāgo",1,0],["an2.143:1.3","dhammacāgo",2,0],["an2.143:1.3","āmisacāgo",2,0],["an2.143:1.5","dhammacāgo",2,0],["an2.145:1.3","dhammabhogo",3,0],["an2.145:1.3","āmisabhogo",3,0],["an2.145:1.5","dhammabhogo",3,0],["an2.147:1.3","dhammasaṃvibhāgo",4,0],["an2.147:1.3","āmisasaṃvibhāgo",4,0],["an2.147:1.5","dhammasaṃvibhāgo",4,0],["an2.148:1.3","dhammasaṅgaho",5,0],["an2.148:1.3","āmisasaṅgaho",5,0],["an2.148:1.5","dhammasaṅgaho",5,0],["an2.149:1.3","dhammānuggaho",6,0],["an2.149:1.3","āmisānuggaho",6,0],["an2.149:1.5","dhammānuggaho",6,0],["an2.150:1.3","dhammānukampā",7,0],["an2.150:1.3","āmisānukampā",7,0],["an2.150:1.5","dhammānukampā",7,0]]},"tika":{"book":"Mp-t-ii","bookName":"Dukanipāta-ṭīkā","vriCode":"s0402t.tik","from":248,"to":248,"paras":[{"para":248,"vripara":"142","refs":["an2.141:1"],"lines":["Tatiyassa paṭhame dīyatīti <b>dānaṃ,</b> deyyadhammassetaṃ adhivacanaṃ.","Dīyati anenāti vā <b>dānaṃ,</b> pariccāgacetanāyetaṃ adhivacanaṃ.","Ayaṃ duvidhopi attho idhādhippetoti āha <b>“diyyanakavasena dānānī”</b>tiādi.","Tattha <b>diyyanakavasenā</b>ti dātabbavasena.","<b>Amatapattipaṭipadan</b>ti amatappattihetubhūtaṃ sammāpaṭipadaṃ."],"lineRefs":[["an2.141:1"],["an2.141:1"],["an2.141:1"],["an2.141:1"],["an2.141:1"]]}],"wordLinks":[["an2.141:1.3","dānaṃ",0,0],["an2.141:1.5","dānaṃ",0,0],["an2.141:1.3","dānaṃ",0,1],["an2.141:1.5","dānaṃ",0,1]]}}
