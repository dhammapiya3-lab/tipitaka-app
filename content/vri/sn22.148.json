{"suttaId":"sn22.148","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[852,852],"vripara":"148"},"segments":{"sn22.148:0.3":"Dukkhānupassīsuttaṃ","sn22.148:1.1":"Sāvatthinidānaṃ.","sn22.148:1.2":"“Saddhāpabbajitassa, bhikkhave, kulaputtassa ayamanudhammo hoti –","sn22.148:1.3":"yaṃ rūpe dukkhānupassī vihareyya.","sn22.148:1.4":"Vedanāya…","sn22.148:1.5":"saññāya…","sn22.148:1.6":"saṅkhāresu…","sn22.148:1.7":"viññāṇe dukkhānupassī vihareyya…pe…","sn22.148:1.8":"‘parimuccati dukkhasmā’ti vadāmī”ti.","sn22.148:1.9":"Terasamaṃ. 14."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":391,"to":394,"paras":[{"para":391,"vripara":"136-149","refs":["sn22.148:1"],"lines":["Kukkuḷavaggassa paṭhame <b>kukkuḷa</b>nti santattaṃ ādittaṃ chārikarāsiṃ viya mahāpariḷāhaṃ.","Imasmiṃ sutte dukkhalakkhaṇaṃ kathitaṃ, sesesu aniccalakkhaṇādīni.","Sabbāni cetāni pāṭiyekkaṃ puggalajjhāsayena kathitānīti."],"lineRefs":[["sn22.148:1"],["sn22.148:1"],["sn22.148:1"]]},{"para":392,"vripara":null,"refs":["sn22.148:1"],"lines":["Kukkuḷavaggo cuddasamo. 15."],"lineRefs":[["sn22.148:1"]]},{"para":393,"vripara":null,"refs":["sn22.148:1"],"lines":["Diṭṭhivaggo 1-9."],"lineRefs":[["sn22.148:1"]]},{"para":394,"vripara":null,"refs":["sn22.148:1"],"lines":["Ajjhattasuttādivaṇṇanā 150-158."],"lineRefs":[["sn22.148:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":395,"to":399,"paras":[{"para":395,"vripara":"136-149","refs":["sn22.148:1"],"lines":["Anto aggi mahanto chārikarāsi, tattha ukkuḷavikulato akkamantaṃ yāva kesaggaṃ anudahatāya kucchitaṃ kuḷanti kukkuḷaṃ, rūpavedanādi pana tatopi kañci kālaṃ anudahanato mahāpariḷāhanaṭṭhena ca kukkuḷaṃ viyāti <b>kukkuḷaṃ.</b>","<b>Aniccalakkhaṇādīnī</b>ti aniccadukkhānattalakkhaṇāni."],"lineRefs":[["sn22.148:1"],["sn22.148:1"]]},{"para":396,"vripara":null,"refs":["sn22.148:1"],"lines":["Kukkuḷasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.148:1"]]},{"para":397,"vripara":null,"refs":["sn22.148:1"],"lines":["Kukkuḷavaggavaṇṇanā niṭṭhitā. 15."],"lineRefs":[["sn22.148:1"]]},{"para":398,"vripara":null,"refs":["sn22.148:1"],"lines":["Diṭṭhivaggo 1-9."],"lineRefs":[["sn22.148:1"]]},{"para":399,"vripara":null,"refs":["sn22.148:1"],"lines":["Ajjhattasuttādivaṇṇanā 150-158."],"lineRefs":[["sn22.148:1"]]}],"wordLinks":[]},"tika2":null}
