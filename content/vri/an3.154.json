{"suttaId":"an3.154","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1259,1259],"vripara":"155"},"segments":{"an3.154:0.3":"Vandanāsuttaṃ","an3.154:1.1":"“Tisso imā, bhikkhave, vandanā.","an3.154:1.2":"Katamā tisso?","an3.154:1.3":"Kāyena, vācāya, manasā – imā kho, bhikkhave, tisso vandanā”ti.","an3.154:1.5":"Navamaṃ."},"attha":null,"tika":null}
