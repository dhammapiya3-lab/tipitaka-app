{"suttaId":"sn45.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[41,42],"vripara":"6"},"segments":{"sn45.6:0.3":"Paṭhamaaññatarabhikkhusuttaṃ","sn45.6:1.1":"Sāvatthinidānaṃ.","sn45.6:1.2":"Atha kho aññataro bhikkhu yena bhagavā tenupasaṅkami … pe … ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca –","sn45.6:1.3":"“‘brahmacariyaṃ, brahmacariyan’ti, bhante, vuccati.","sn45.6:1.4":"Katamaṃ nu kho, bhante, brahmacariyaṃ, katamaṃ brahmacariyapariyosānan”ti?","sn45.6:2.1":"“Ayameva kho, bhikkhu, ariyo aṭṭhaṅgiko maggo brahmacariyaṃ, seyyathidaṃ –","sn45.6:2.2":"sammādiṭṭhi … pe … sammāsamādhi.","sn45.6:2.3":"Yo kho, bhikkhu, rāgakkhayo dosakkhayo mohakkhayo –","sn45.6:2.4":"idaṃ brahmacariyapariyosānan”ti.","sn45.6:2.5":"Chaṭṭhaṃ."},"unsure":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":27,"to":28,"paras":[{"para":27,"vripara":"5-6","refs":["sn45.6:1"],"lines":["5-6. Pañcame <b>ayamevā</b>ti evasaddo niyamattho.","Tena aññaṃ maggaṃ paṭikkhipati.","Imasmiṃ sutte vaṭṭadukkhañceva missakamaggo ca kathito.","Chaṭṭhaṃ uttānameva."],"lineRefs":[["sn45.6:1"],["sn45.6:1"],["sn45.6:1"],["sn45.6:1"]]},{"para":28,"vripara":null,"refs":["sn45.6:1"],"lines":["Dutiyaaññatarabhikkhusuttavaṇṇanā"],"lineRefs":[["sn45.6:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":27,"to":29,"paras":[{"para":27,"vripara":"5-6","refs":["sn45.6:1"],"lines":["5-6. <b>Niyamattho</b>ti avadhāraṇattho.","<b>Tena</b> niyamena avadhāraṇena – <b>aññaṃ maggaṃ paṭikkhipati</b> ito aññassa niyyānikamaggassa abhāvato.","“Dukkhassa pariññatthan”ti vuttattā <b>vaṭṭadukkhaṃ kathitaṃ</b>.","Ariyamagge gahite tassa pubbabhāgamaggo vipassanāya gahito evāti <b>“missakamaggo kathito”</b>ti vuttaṃ.","<b>Uttānameva</b> apubbassa abhāvā.","Ayaṃ pana viseso “rāgakkhayo”tiādīhi yadipi nibbānaṃ vuttaṃ.","Tathāpi arahattaṃ viya brahmacariyampi.","Tena nibbānaṃ eva vuccati <b>“idaṃ brahmacariyapariyosānan”</b>ti."],"lineRefs":[["sn45.6:1"],["sn45.6:1"],["sn45.6:1"],["sn45.6:1"],["sn45.6:1"],["sn45.6:1"],["sn45.6:1"],["sn45.6:1"]]},{"para":28,"vripara":null,"refs":["sn45.6:1"],"lines":["Kimatthiyasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn45.6:1"]]},{"para":29,"vripara":null,"refs":["sn45.6:1"],"lines":["Dutiyaaññatarabhikkhusuttavaṇṇanā"],"lineRefs":[["sn45.6:1"]]}],"wordLinks":[]},"tika2":null}
