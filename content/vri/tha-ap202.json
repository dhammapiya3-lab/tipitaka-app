{"suttaId":"tha-ap202","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7398,7425],"vripara":"53"},"segments":{"tha-ap202:0.3":"Yūthikapupphiyattheraapadānaṃ","tha-ap202:1.1":"“Padumuttaro nāma jino, āhutīnaṃ paṭiggaho;","tha-ap202:1.3":"Pavanā nikkhamitvāna, vihāraṃ yāti cakkhumā.","tha-ap202:2.1":"“Ubho hatthehi paggayha, yūthikaṃ pupphamuttamaṃ;","tha-ap202:2.3":"Buddhassa abhiropayiṃ, mettacittassa tādino.","tha-ap202:3.1":"“Tena cittappasādena, anubhotvāna sampadā;","tha-ap202:3.3":"Kappānaṃ satasahassaṃ, duggatiṃ nupapajjahaṃ.","tha-ap202:4.1":"“Ito paññāsakappesu, eko āsiṃ janādhipo;","tha-ap202:4.3":"Samittanandano nāma, cakkavattī mahabbalo.","tha-ap202:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap202:6.1":"Itthaṃ sudaṃ āyasmā yūthikapupphiyo thero imā gāthāyo abhāsitthāti;","tha-ap202:7.1":"Yūthikapupphiyattherassāpadānaṃ dasamaṃ.","tha-ap202:7.2":"Tamālapupphiyavaggo vīsatimo.","tha-ap202:8.1":"Tassuddānaṃ –","tha-ap202:9.1":"Tamālatiṇasanthāro, khaṇḍaphulli asokiyo;","tha-ap202:9.3":"Aṅkolakī kisalayo, tinduko nelapupphiyo;","tha-ap202:9.5":"Kiṃkaṇiko yūthiko ca, gāthā paññāsa aṭṭha cāti.","tha-ap202:10.1":"Atha vagguddānaṃ –","tha-ap202:11.1":"Bhikkhādāyī parivāro, sereyyo sobhito tathā;","tha-ap202:11.3":"Chattañca bandhujīvī ca, supāricariyopi ca.","tha-ap202:12.1":"Kumudo kuṭajo ceva, tamāli dasamo kato;","tha-ap202:12.3":"Chasatāni ca gāthāni, chasaṭṭhi ca tatuttari.","tha-ap202:13.1":"Bhikkhāvaggadasakaṃ.","tha-ap202:14.1":"Dutiyasatakaṃ samattaṃ."},"attha":null,"tika":null}
