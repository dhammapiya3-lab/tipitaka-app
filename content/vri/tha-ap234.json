{"suttaId":"tha-ap234","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7987,7999],"vripara":"5"},"segments":{"tha-ap234:0.3":"Bhājanapālakattheraapadānaṃ","tha-ap234:1.1":"“Nagare bandhumatiyā,","tha-ap234:1.2":"kumbhakāro ahaṃ tadā;","tha-ap234:1.3":"Bhājanaṃ anupālesiṃ,","tha-ap234:1.4":"bhikkhusaṅghassa tāvade. 6.","tha-ap234:2.1":"“Ekanavutito kappe,","tha-ap234:2.2":"bhājanaṃ anupālayiṃ;","tha-ap234:2.3":"Duggatiṃ nābhijānāmi,","tha-ap234:2.4":"bhājanassa idaṃ phalaṃ. 7.","tha-ap234:3.1":"“Tepaññāse ito kappe,","tha-ap234:3.2":"anantajālināmako;","tha-ap234:3.3":"Sattaratanasampanno,","tha-ap234:3.4":"cakkavattī mahabbalo. 8.","tha-ap234:4.1":"“Paṭisambhidā catasso…pe…","tha-ap234:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap234:5.1":"Itthaṃ sudaṃ āyasmā bhājanapālako [bhājanadāyako (sī. syā.)] thero imā gāthāyo abhāsitthāti.","tha-ap234:6.1":"Bhājanapālakattherassāpadānaṃ dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
