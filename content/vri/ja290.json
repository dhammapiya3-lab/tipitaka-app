{"suttaId":"ja290","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2193,2206],"vripara":"118"},"segments":{"ja290:0.4":"Sīlavīmaṃsakajātakaṃ (3-4-10)","ja290:1.1":"Sīlaṃ kireva kalyāṇaṃ,","ja290:1.2":"sīlaṃ loke anuttaraṃ;","ja290:1.3":"Passa ghoraviso nāgo,","ja290:1.4":"sīlavāti na haññati. 119.","ja290:2.1":"Sohaṃ sīlaṃ samādissaṃ,","ja290:2.2":"loke anumataṃ sivaṃ;","ja290:2.3":"Ariyavuttisamācāro,","ja290:2.4":"yena vuccati sīlavā. 120.","ja290:3.1":"Ñātīnañca piyo hoti,","ja290:3.2":"mittesu ca virocati;","ja290:3.3":"Kāyassa bhedā sugatiṃ,","ja290:3.4":"upapajjati sīlavāti.","ja290:4.1":"Sīlavīmaṃsakajātakaṃ dasamaṃ.","ja290:4.2":"Abbhantaravaggo catuttho.","ja290:5.1":"Tassuddānaṃ –","ja290:6.1":"Duma kaṃsavaruttamabyagghamigā,","ja290:6.2":"maṇayo maṇi sālukamavhayano;","ja290:6.3":"Anusāsaniyopi ca macchavaro,","ja290:6.4":"maṇikuṇḍalakena kirena dasāti. 5."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":2782,"to":2782,"paras":[{"para":2782,"vripara":null,"refs":["ja290:3","ja290:6"],"lines":["Tattha <b>sīla</b>nti ācāro.","<b>Kirā</b>ti anussavatthe nipāto.","<b>Kalyāṇa</b>nti sobhanaṃ, “sīlaṃ kireva kalyāṇa”nti evaṃ paṇḍitā vadantīti attho.","<b>Passā</b>ti attānameva vadati.","<b>Na haññatī</b>ti parampi na viheṭheti, parehipi na viheṭhīyati.","<b>Samādissa</b>nti samādiyissāmi.","<b>Anumataṃ siva</b>nti “khemaṃ nibbhaya”nti evaṃ paṇḍitehi sampaṭicchitaṃ.","<b>Yena vuccatī</b>ti yena sīlena sīlavā puriso ariyānaṃ buddhādīnaṃ paṭipattiṃ samācaranto “ariyavuttisamācāro”ti vuccati, tamahaṃ samādiyissāmīti attho.","<b>Virocatī</b>ti pabbatamatthake aggikkhandho viya virocati."],"lineRefs":[["ja290:3"],["ja290:6"],["ja290:6"],["ja290:6"],["ja290:6"],["ja290:6"],["ja290:6"],["ja290:6"],["ja290:3"]]}],"wordLinks":[["ja290:3.3","sīlaṃ",0,0],["ja290:6.3","kirā",0,1],["ja290:3.1","virocatī",0,8]],"after":[{"para":2783,"vripara":null,"title":"[290] 10. Sīlavīmaṃsakajātakavaṇṇanā","lines":["Evaṃ bodhisatto tīhi gāthāhi sīlassa vaṇṇaṃ pakāsento rañño dhammaṃ desetvā “mahārāja, mama gehe pitu santakaṃ mātu santakaṃ attanā uppāditaṃ tayā dinnañca bahu dhanaṃ atthi, pariyanto nāma na paññāyati, ahaṃ pana sīlaṃ vīmaṃsanto heraññikaphalakato kahāpaṇe gaṇhiṃ.","Idāni mayā imasmiṃ loke jātigottakulapadesānaṃ lāmakabhāvo, sīlasseva ca jeṭṭhakabhāvo ñāto, ahaṃ pabbajissāmi, pabbajjaṃ me anujānāhī”ti anujānāpetvā raññā punappunaṃ yāciyamānopi nikkhamma himavantaṃ pavisitvā isipabbajjaṃ pabbajitvā abhiññā ca samāpattiyo ca nibbattetvā brahmalokaparāyaṇo ahosi."]},{"para":2784,"vripara":null,"title":"[290] 10. Sīlavīmaṃsakajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā sīlavīmaṃsako purohito brāhmaṇo ahameva ahosi”nti."]},{"para":2785,"vripara":null,"title":"[290] 10. Sīlavīmaṃsakajātakavaṇṇanā","lines":["Sīlavīmaṃsakajātakavaṇṇanā dasamā."]},{"para":2786,"vripara":null,"title":"[290] 10. Sīlavīmaṃsakajātakavaṇṇanā","lines":["Abbhantaravaggo catuttho."]},{"para":2787,"vripara":null,"title":"[290] 10. Sīlavīmaṃsakajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":2788,"vripara":null,"title":"[290] 10. Sīlavīmaṃsakajātakavaṇṇanā","lines":["Duma kaṃsavaruttamabyagghamigā, maṇayo maṇi sālukamavhayano;"]},{"para":2789,"vripara":null,"title":"[290] 10. Sīlavīmaṃsakajātakavaṇṇanā","lines":["Anusāsaniyopi ca macchavaro, maṇikuṇḍalakena kirena dasāti. 5."]}]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":1339,"to":1345,"paras":[{"para":1339,"vripara":null,"refs":["ja290:1"],"lines":["10-sīlavīmaṃsakajātakavaṇṇanā (290)"],"lineRefs":[["ja290:1"]]},{"para":1340,"vripara":null,"refs":["ja290:1"],"lines":["<b>heraññikaphalakato</b>ti heraññikassa phalakato.","<b>passāti attānameva vadatī</b>ti passāti iminā attānameva uyyojanatthāya vadatīti attho.","<b>samādissa</b>nti ettha gāthābandhavasena ya-kāralopoti āha “samādissanti samādiyissa” nti.","<b>anumata</b>nti ettha anusaddayogattā mana-ñāṇeti dhātu sampaṭicchanatthe vattatīti āha “khemaṃ nibbhaya”nti.","evaṃ paṇḍitehi sampaṭicchitanti.","<b>jātigottakulapadesāna</b>nti jātigottakulānaṃ padesānanti."],"lineRefs":[["ja290:1"],["ja290:1"],["ja290:1"],["ja290:1"],["ja290:1"],["ja290:1"]]},{"para":1341,"vripara":null,"refs":["ja290:1"],"lines":["ending sīlavīmaṃsakajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja290:1"]]},{"para":1342,"vripara":null,"refs":["ja290:1"],"lines":["ending abbhantaravaggo catuttho."],"lineRefs":[["ja290:1"]]},{"para":1343,"vripara":null,"refs":["ja290:1"],"lines":["footnote 1.","pavattiyā.","jā.","ṭṭha."],"lineRefs":[["ja290:1"],["ja290:1"],["ja290:1"],["ja290:1"]]},{"para":1344,"vripara":null,"refs":["ja290:1"],"lines":["footnote 2.","brāhmaṇa."],"lineRefs":[["ja290:1"],["ja290:1"]]},{"para":1345,"vripara":null,"refs":["ja290:1"],"lines":["footnote 3.","samādiyissāmi.","jā.","ṭṭha."],"lineRefs":[["ja290:1"],["ja290:1"],["ja290:1"],["ja290:1"]]}],"wordLinks":[]},"tika2":null}
