{"suttaId":"thig2.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[101,107],"vripara":"19"},"segments":{"thig2.1:0.3":"Abhirūpanandātherīgāthā","thig2.1:1.1":"[apa. therī 2.4.157 apadānepi]“Āturaṃ asuciṃ pūtiṃ, passa nande samussayaṃ;","thig2.1:1.3":"Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ.","thig2.1:2.1":"“Animittañca bhāvehi, mānānusayamujjaha;","thig2.1:2.3":"Tato mānābhisamayā, upasantā carissasī”ti.","thig2.1:3.1":"Itthaṃ sudaṃ bhagavā abhirūpanandaṃ sikkhamānaṃ imāhi gāthāhi abhiṇhaṃ ovadatīti [itthaṃ sudaṃ bhagavā abhirūpanandaṃ sikkhamānaṃ imāhi gāthāhi abhiṇhaṃ ovadatīti (ka.)]."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":280,"to":335,"paras":[{"para":280,"vripara":"19","refs":["thig2.1:1"],"lines":["“Āturaṃ asuciṃ pūtiṃ, passa nande samussayaṃ;"],"lineRefs":[["thig2.1:1"]]},{"para":281,"vripara":null,"refs":[],"lines":["Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ."],"lineRefs":[[]]},{"para":283,"vripara":"20","refs":["thig2.1:2"],"lines":["“Animittañca bhāvehi, mānānusayamujjaha;"],"lineRefs":[["thig2.1:2"]]},{"para":284,"vripara":null,"refs":[],"lines":["Tato mānābhisamayā, upasantā carissasī”ti.","–"],"lineRefs":[[],[]]},{"para":285,"vripara":null,"refs":[],"lines":["Imā dve gāthā abhāsi.","Tāsaṃ attho heṭṭhā vuttanayo eva.","Gāthāpariyosāne abhirūpanandā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> –"],"lineRefs":[[],[],[],[]]},{"para":286,"vripara":null,"refs":[],"lines":["“Nagare bandhumatiyā, bandhumā nāma khattiyo;"],"lineRefs":[[]]},{"para":287,"vripara":null,"refs":[],"lines":["Tassa rañño ahuṃ bhariyā, ekajjhaṃ cārayāmahaṃ."],"lineRefs":[[]]},{"para":288,"vripara":null,"refs":[],"lines":["“Rahogatā nisīditvā, evaṃ cintesahaṃ tadā;"],"lineRefs":[[]]},{"para":289,"vripara":null,"refs":[],"lines":["Ādāya gamanīyañhi, kusalaṃ natthi me kataṃ."],"lineRefs":[[]]},{"para":290,"vripara":null,"refs":[],"lines":["“Mahābhitāpaṃ kaṭukaṃ, ghorarūpaṃ sudāruṇaṃ;"],"lineRefs":[[]]},{"para":291,"vripara":null,"refs":[],"lines":["Nirayaṃ nūna gacchāmi, ettha me natthi saṃsayo."],"lineRefs":[[]]},{"para":292,"vripara":null,"refs":[],"lines":["“Evāhaṃ cintayitvāna, pahaṃsetvāna mānasaṃ;"],"lineRefs":[[]]},{"para":293,"vripara":null,"refs":[],"lines":["Rājānaṃ upagantvāna, idaṃ vacanamabraviṃ."],"lineRefs":[[]]},{"para":294,"vripara":null,"refs":[],"lines":["“Itthī nāma mayaṃ deva, purisānugatā sadā;"],"lineRefs":[[]]},{"para":295,"vripara":null,"refs":[],"lines":["Ekaṃ me samaṇaṃ dehi, bhojayissāmi khattiya."],"lineRefs":[[]]},{"para":296,"vripara":null,"refs":[],"lines":["“Adāsi me mahārājā, samaṇaṃ bhāvitindriyaṃ;"],"lineRefs":[[]]},{"para":297,"vripara":null,"refs":[],"lines":["Tassa pattaṃ gahetvāna, paramannena pūrayiṃ."],"lineRefs":[[]]},{"para":298,"vripara":null,"refs":[],"lines":["“Pūrayitvā paramannaṃ, sahassagghanakenahaṃ;"],"lineRefs":[[]]},{"para":299,"vripara":null,"refs":[],"lines":["Vatthayugena chādetvā, adāsiṃ tuṭṭhamānasā."],"lineRefs":[[]]},{"para":300,"vripara":null,"refs":[],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":301,"vripara":null,"refs":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":302,"vripara":null,"refs":[],"lines":["“Sahassaṃ devarājūnaṃ, mahesittamakārayiṃ;"],"lineRefs":[[]]},{"para":303,"vripara":null,"refs":[],"lines":["Sahassaṃ cakkavattīnaṃ, mahesittamakārayiṃ."],"lineRefs":[[]]},{"para":304,"vripara":null,"refs":[],"lines":["“Padesarajjaṃ vipulaṃ, gaṇanāto asaṅkhiyaṃ;"],"lineRefs":[[]]},{"para":305,"vripara":null,"refs":[],"lines":["Nānāvidhaṃ bahuṃ puññaṃ, tassa kammaphalā tato."],"lineRefs":[[]]},{"para":306,"vripara":null,"refs":[],"lines":["“Uppalasseva me vaṇṇā, abhirūpā sudassanā;"],"lineRefs":[[]]},{"para":307,"vripara":null,"refs":[],"lines":["Itthī sabbaṅgasampannā, abhijātā jutindharā."],"lineRefs":[[]]},{"para":308,"vripara":null,"refs":[],"lines":["“Pacchime bhavasampatte, ajāyiṃ sākiye kule;"],"lineRefs":[[]]},{"para":309,"vripara":null,"refs":[],"lines":["Nārīsahassapāmokkhā, suddhodanasutassahaṃ."],"lineRefs":[[]]},{"para":310,"vripara":null,"refs":[],"lines":["“Nibbinditvā agārehaṃ, pabbajiṃ anagāriyaṃ;"],"lineRefs":[[]]},{"para":311,"vripara":null,"refs":[],"lines":["Sattamiṃ rattiṃ sampatvā, catusaccaṃ apāpuṇiṃ."],"lineRefs":[[]]},{"para":312,"vripara":null,"refs":[],"lines":["“Cīvarapiṇḍapātañca, paccayañca senāsanaṃ;"],"lineRefs":[[]]},{"para":313,"vripara":null,"refs":[],"lines":["Parimetuṃ na sakkomi, piṇḍapātassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":314,"vripara":null,"refs":[],"lines":["“Yaṃ mayhaṃ purimaṃ kammaṃ, kusalaṃ janitaṃ muni;"],"lineRefs":[[]]},{"para":315,"vripara":null,"refs":[],"lines":["Tuyhatthāya mahāvīra, pariciṇṇaṃ bahuṃ mayā."],"lineRefs":[[]]},{"para":316,"vripara":null,"refs":[],"lines":["“Ekatiṃse ito kappe, yaṃ dānamadadiṃ tadā;"],"lineRefs":[[]]},{"para":317,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, piṇḍapātassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":318,"vripara":null,"refs":[],"lines":["“Duve gatī pajānāmi, devattaṃ atha mānusaṃ;"],"lineRefs":[[]]},{"para":319,"vripara":null,"refs":[],"lines":["Aññaṃ gatiṃ na jānāmi, piṇḍapātassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":320,"vripara":null,"refs":[],"lines":["“Ucce kule pajānāmi, tayo sāle mahādhane;"],"lineRefs":[[]]},{"para":321,"vripara":null,"refs":[],"lines":["Aññaṃ kulaṃ na jānāmi, piṇḍapātassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":322,"vripara":null,"refs":[],"lines":["“Bhavābhave saṃsaritvā, sukkamūlena coditā;"],"lineRefs":[[]]},{"para":323,"vripara":null,"refs":[],"lines":["Amanāpaṃ na passāmi, somanassakataṃ phalaṃ."],"lineRefs":[[]]},{"para":324,"vripara":null,"refs":[],"lines":["“Iddhīsu ca vasī homi, dibbāya sotadhātuyā;"],"lineRefs":[[]]},{"para":325,"vripara":null,"refs":[],"lines":["Cetopariyañāṇassa, vasī homi mahāmune."],"lineRefs":[[]]},{"para":326,"vripara":null,"refs":[],"lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"],"lineRefs":[[]]},{"para":327,"vripara":null,"refs":[],"lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."],"lineRefs":[[]]},{"para":328,"vripara":null,"refs":[],"lines":["“Atthadhammaniruttīsu, paṭibhāne tatheva ca;"],"lineRefs":[[]]},{"para":329,"vripara":null,"refs":[],"lines":["Ñāṇaṃ mama mahāvīra, uppannaṃ tava santike."],"lineRefs":[[]]},{"para":330,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":331,"vripara":null,"refs":[],"lines":["Arahattaṃ patvā pana sā sayampi udānavasena tāyeva gāthā abhāsi, idameva cassā aññābyākaraṇaṃ ahosīti."],"lineRefs":[[]]},{"para":332,"vripara":null,"refs":[],"lines":["Abhirūpanandātherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":333,"vripara":null,"refs":[],"lines":["Jentātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":334,"vripara":null,"refs":[],"lines":["<b>Ye ime satta bojjhaṅgā</b>tiādikā jentāya theriyā gāthā.","Tassā atītaṃ paccuppannañca vatthu abhirūpanandāvatthusadisaṃ.","Ayaṃ pana vesāliyaṃ licchavirājakule nibbattīti ayameva viseso.","Satthārā desitaṃ dhammaṃ sutvā desanāpariyosāne arahattaṃ patvā attanā adhigataṃ visesaṃ paccavekkhitvā pītivasena –"],"lineRefs":[[],[],[],[]]}],"wordLinks":[]},"tika":null,"tika2":null}
