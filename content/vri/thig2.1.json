{"suttaId":"thig2.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[101,107],"vripara":"19"},"segments":{"thig2.1:0.3":"Abhirūpanandātherīgāthā","thig2.1:1.1":"[apa. therī 2.4.157 apadānepi]“Āturaṃ asuciṃ pūtiṃ, passa nande samussayaṃ;","thig2.1:1.3":"Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ.","thig2.1:2.1":"“Animittañca bhāvehi, mānānusayamujjaha;","thig2.1:2.3":"Tato mānābhisamayā, upasantā carissasī”ti.","thig2.1:3.1":"Itthaṃ sudaṃ bhagavā abhirūpanandaṃ sikkhamānaṃ imāhi gāthāhi abhiṇhaṃ ovadatīti [itthaṃ sudaṃ bhagavā abhirūpanandaṃ sikkhamānaṃ imāhi gāthāhi abhiṇhaṃ ovadatīti (ka.)]."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":280,"to":335,"paras":[{"para":280,"vripara":"19","refs":["thig2.1:1"],"lines":["“Āturaṃ asuciṃ pūtiṃ, passa nande samussayaṃ;"],"lineRefs":[["thig2.1:1"]]},{"para":281,"vripara":null,"refs":["thig2.1:1"],"lines":["Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ."],"lineRefs":[["thig2.1:1"]]},{"para":283,"vripara":"20","refs":["thig2.1:2"],"lines":["“Animittañca bhāvehi, mānānusayamujjaha;"],"lineRefs":[["thig2.1:2"]]},{"para":284,"vripara":null,"refs":["thig2.1:2"],"lines":["Tato mānābhisamayā, upasantā carissasī”ti.","–"],"lineRefs":[["thig2.1:2"],["thig2.1:2"]]},{"para":285,"vripara":null,"refs":["thig2.1:2"],"lines":["Imā dve gāthā abhāsi.","Tāsaṃ attho heṭṭhā vuttanayo eva.","Gāthāpariyosāne abhirūpanandā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> –"],"lineRefs":[["thig2.1:2"],["thig2.1:2"],["thig2.1:2"],["thig2.1:2"]]},{"para":286,"vripara":null,"refs":["thig2.1:2"],"lines":["“Nagare bandhumatiyā, bandhumā nāma khattiyo;"],"lineRefs":[["thig2.1:2"]]},{"para":287,"vripara":null,"refs":["thig2.1:2"],"lines":["Tassa rañño ahuṃ bhariyā, ekajjhaṃ cārayāmahaṃ."],"lineRefs":[["thig2.1:2"]]},{"para":288,"vripara":null,"refs":["thig2.1:2"],"lines":["“Rahogatā nisīditvā, evaṃ cintesahaṃ tadā;"],"lineRefs":[["thig2.1:2"]]},{"para":289,"vripara":null,"refs":["thig2.1:2"],"lines":["Ādāya gamanīyañhi, kusalaṃ natthi me kataṃ."],"lineRefs":[["thig2.1:2"]]},{"para":290,"vripara":null,"refs":["thig2.1:2"],"lines":["“Mahābhitāpaṃ kaṭukaṃ, ghorarūpaṃ sudāruṇaṃ;"],"lineRefs":[["thig2.1:2"]]},{"para":291,"vripara":null,"refs":["thig2.1:2"],"lines":["Nirayaṃ nūna gacchāmi, ettha me natthi saṃsayo."],"lineRefs":[["thig2.1:2"]]},{"para":292,"vripara":null,"refs":["thig2.1:2"],"lines":["“Evāhaṃ cintayitvāna, pahaṃsetvāna mānasaṃ;"],"lineRefs":[["thig2.1:2"]]},{"para":293,"vripara":null,"refs":["thig2.1:2"],"lines":["Rājānaṃ upagantvāna, idaṃ vacanamabraviṃ."],"lineRefs":[["thig2.1:2"]]},{"para":294,"vripara":null,"refs":["thig2.1:2"],"lines":["“Itthī nāma mayaṃ deva, purisānugatā sadā;"],"lineRefs":[["thig2.1:2"]]},{"para":295,"vripara":null,"refs":["thig2.1:2"],"lines":["Ekaṃ me samaṇaṃ dehi, bhojayissāmi khattiya."],"lineRefs":[["thig2.1:2"]]},{"para":296,"vripara":null,"refs":["thig2.1:2"],"lines":["“Adāsi me mahārājā, samaṇaṃ bhāvitindriyaṃ;"],"lineRefs":[["thig2.1:2"]]},{"para":297,"vripara":null,"refs":["thig2.1:2"],"lines":["Tassa pattaṃ gahetvāna, paramannena pūrayiṃ."],"lineRefs":[["thig2.1:2"]]},{"para":298,"vripara":null,"refs":["thig2.1:2"],"lines":["“Pūrayitvā paramannaṃ, sahassagghanakenahaṃ;"],"lineRefs":[["thig2.1:2"]]},{"para":299,"vripara":null,"refs":["thig2.1:2"],"lines":["Vatthayugena chādetvā, adāsiṃ tuṭṭhamānasā."],"lineRefs":[["thig2.1:2"]]},{"para":300,"vripara":null,"refs":["thig2.1:2"],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[["thig2.1:2"]]},{"para":301,"vripara":null,"refs":["thig2.1:2"],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[["thig2.1:2"]]},{"para":302,"vripara":null,"refs":["thig2.1:2"],"lines":["“Sahassaṃ devarājūnaṃ, mahesittamakārayiṃ;"],"lineRefs":[["thig2.1:2"]]},{"para":303,"vripara":null,"refs":["thig2.1:2"],"lines":["Sahassaṃ cakkavattīnaṃ, mahesittamakārayiṃ."],"lineRefs":[["thig2.1:2"]]},{"para":304,"vripara":null,"refs":["thig2.1:2"],"lines":["“Padesarajjaṃ vipulaṃ, gaṇanāto asaṅkhiyaṃ;"],"lineRefs":[["thig2.1:2"]]},{"para":305,"vripara":null,"refs":["thig2.1:2"],"lines":["Nānāvidhaṃ bahuṃ puññaṃ, tassa kammaphalā tato."],"lineRefs":[["thig2.1:2"]]},{"para":306,"vripara":null,"refs":["thig2.1:2"],"lines":["“Uppalasseva me vaṇṇā, abhirūpā sudassanā;"],"lineRefs":[["thig2.1:2"]]},{"para":307,"vripara":null,"refs":["thig2.1:2"],"lines":["Itthī sabbaṅgasampannā, abhijātā jutindharā."],"lineRefs":[["thig2.1:2"]]},{"para":308,"vripara":null,"refs":["thig2.1:2"],"lines":["“Pacchime bhavasampatte, ajāyiṃ sākiye kule;"],"lineRefs":[["thig2.1:2"]]},{"para":309,"vripara":null,"refs":["thig2.1:2"],"lines":["Nārīsahassapāmokkhā, suddhodanasutassahaṃ."],"lineRefs":[["thig2.1:2"]]},{"para":310,"vripara":null,"refs":["thig2.1:2"],"lines":["“Nibbinditvā agārehaṃ, pabbajiṃ anagāriyaṃ;"],"lineRefs":[["thig2.1:2"]]},{"para":311,"vripara":null,"refs":["thig2.1:2"],"lines":["Sattamiṃ rattiṃ sampatvā, catusaccaṃ apāpuṇiṃ."],"lineRefs":[["thig2.1:2"]]},{"para":312,"vripara":null,"refs":["thig2.1:2"],"lines":["“Cīvarapiṇḍapātañca, paccayañca senāsanaṃ;"],"lineRefs":[["thig2.1:2"]]},{"para":313,"vripara":null,"refs":["thig2.1:2"],"lines":["Parimetuṃ na sakkomi, piṇḍapātassidaṃ phalaṃ."],"lineRefs":[["thig2.1:2"]]},{"para":314,"vripara":null,"refs":["thig2.1:2"],"lines":["“Yaṃ mayhaṃ purimaṃ kammaṃ, kusalaṃ janitaṃ muni;"],"lineRefs":[["thig2.1:2"]]},{"para":315,"vripara":null,"refs":["thig2.1:2"],"lines":["Tuyhatthāya mahāvīra, pariciṇṇaṃ bahuṃ mayā."],"lineRefs":[["thig2.1:2"]]},{"para":316,"vripara":null,"refs":["thig2.1:2"],"lines":["“Ekatiṃse ito kappe, yaṃ dānamadadiṃ tadā;"],"lineRefs":[["thig2.1:2"]]},{"para":317,"vripara":null,"refs":["thig2.1:2"],"lines":["Duggatiṃ nābhijānāmi, piṇḍapātassidaṃ phalaṃ."],"lineRefs":[["thig2.1:2"]]},{"para":318,"vripara":null,"refs":["thig2.1:2"],"lines":["“Duve gatī pajānāmi, devattaṃ atha mānusaṃ;"],"lineRefs":[["thig2.1:2"]]},{"para":319,"vripara":null,"refs":["thig2.1:2"],"lines":["Aññaṃ gatiṃ na jānāmi, piṇḍapātassidaṃ phalaṃ."],"lineRefs":[["thig2.1:2"]]},{"para":320,"vripara":null,"refs":["thig2.1:2"],"lines":["“Ucce kule pajānāmi, tayo sāle mahādhane;"],"lineRefs":[["thig2.1:2"]]},{"para":321,"vripara":null,"refs":["thig2.1:2"],"lines":["Aññaṃ kulaṃ na jānāmi, piṇḍapātassidaṃ phalaṃ."],"lineRefs":[["thig2.1:2"]]},{"para":322,"vripara":null,"refs":["thig2.1:2"],"lines":["“Bhavābhave saṃsaritvā, sukkamūlena coditā;"],"lineRefs":[["thig2.1:2"]]},{"para":323,"vripara":null,"refs":["thig2.1:2"],"lines":["Amanāpaṃ na passāmi, somanassakataṃ phalaṃ."],"lineRefs":[["thig2.1:2"]]},{"para":324,"vripara":null,"refs":["thig2.1:2"],"lines":["“Iddhīsu ca vasī homi, dibbāya sotadhātuyā;"],"lineRefs":[["thig2.1:2"]]},{"para":325,"vripara":null,"refs":["thig2.1:2"],"lines":["Cetopariyañāṇassa, vasī homi mahāmune."],"lineRefs":[["thig2.1:2"]]},{"para":326,"vripara":null,"refs":["thig2.1:2"],"lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"],"lineRefs":[["thig2.1:2"]]},{"para":327,"vripara":null,"refs":["thig2.1:2"],"lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."],"lineRefs":[["thig2.1:2"]]},{"para":328,"vripara":null,"refs":["thig2.1:2"],"lines":["“Atthadhammaniruttīsu, paṭibhāne tatheva ca;"],"lineRefs":[["thig2.1:2"]]},{"para":329,"vripara":null,"refs":["thig2.1:2"],"lines":["Ñāṇaṃ mama mahāvīra, uppannaṃ tava santike."],"lineRefs":[["thig2.1:2"]]},{"para":330,"vripara":null,"refs":["thig2.1:2"],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[["thig2.1:2"]]},{"para":331,"vripara":null,"refs":["thig2.1:2"],"lines":["Arahattaṃ patvā pana sā sayampi udānavasena tāyeva gāthā abhāsi, idameva cassā aññābyākaraṇaṃ ahosīti."],"lineRefs":[["thig2.1:2"]]},{"para":332,"vripara":null,"refs":["thig2.1:2"],"lines":["Abhirūpanandātherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[["thig2.1:2"]]},{"para":333,"vripara":null,"refs":["thig2.1:2"],"lines":["Jentātherīgāthāvaṇṇanā"],"lineRefs":[["thig2.1:2"]]},{"para":334,"vripara":null,"refs":["thig2.1:2"],"lines":["<b>Ye ime satta bojjhaṅgā</b>tiādikā jentāya theriyā gāthā.","Tassā atītaṃ paccuppannañca vatthu abhirūpanandāvatthusadisaṃ.","Ayaṃ pana vesāliyaṃ licchavirājakule nibbattīti ayameva viseso.","Satthārā desitaṃ dhammaṃ sutvā desanāpariyosāne arahattaṃ patvā attanā adhigataṃ visesaṃ paccavekkhitvā pītivasena –"],"lineRefs":[["thig2.1:2"],["thig2.1:2"],["thig2.1:2"],["thig2.1:2"]]}],"wordLinks":[],"before":[{"para":273,"vripara":null,"refs":[],"lines":["Saṅghātherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":274,"vripara":null,"refs":[],"lines":["Ekakanipātavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":275,"vripara":null,"refs":[],"lines":["Dukanipāto"],"lineRefs":[[]]},{"para":276,"vripara":null,"refs":[],"lines":["Abhirūpanandātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":277,"vripara":null,"refs":[],"lines":["Dukanipāte <b>āturaṃ asuciṃ pūtin</b>tiādikā abhirūpanandāya sikkhamānāya gāthā.","Ayaṃ kira vipassissa bhagavato kāle bandhumatīnagare gahapatimahāsālassa dhītā hutvā satthu santike dhammaṃ sutvā saraṇesu ca sīlesu ca patiṭṭhitā satthari parinibbute dhātucetiyaṃ ratanapaṭimaṇḍitena suvaṇṇacchattena pūjaṃ katvā, kālaṅkatvā sagge nibbattitvā aparāparaṃ sugatīsuyeva saṃsarantī imasmiṃ buddhuppāde kapilavatthunagare khemakassa sakkassa aggamahesiyā kucchismiṃ nibbatti.","<b>Nandā</b>tissā nāmaṃ ahosi.","Sā attabhāvassa ativiya rūpasobhaggappattiyā abhirūpā dassanīyā pāsādikā abhirūpanandātveva paññāyittha.","Tassā vayappattāya vāreyyadivaseyeva varabhūto sakyakumāro kālamakāsi.","Atha naṃ mātāpitaro akāmaṃ pabbājesuṃ."],"lineRefs":[[],[],[],[],[],[]]},{"para":278,"vripara":null,"refs":[],"lines":["Sā pabbajitvāpi rūpaṃ nissāya uppannamadā “satthā rūpaṃ vivaṇṇeti garahati anekapariyāyena rūpe ādīnavaṃ dassetī”ti buddhupaṭṭhānaṃ na gacchati.","Bhagavā tassā ñāṇaparipākaṃ ñatvā mahāpajāpatiṃ āṇāpesi “sabbāpi bhikkhuniyo paṭipāṭiyā ovādaṃ āgacchantū”ti.","Sā attano vāre sampatte aññaṃ pesesi.","Bhagavā “vāre sampatte attanāva āgantabbaṃ, na aññā pesetabbā”ti āha.","Sā satthu āṇaṃ laṅghituṃ asakkontī bhikkhunīhi saddhiṃ buddhupaṭṭhānaṃ agamāsi.","Bhagavā iddhiyā ekaṃ abhirūpaṃ itthirūpaṃ māpetvā puna jarājiṇṇaṃ dassetvā saṃvegaṃ uppādetvā –"],"lineRefs":[[],[],[],[],[],[]]}]},"tika":null,"tika2":null}
