{"suttaId":"sn7.20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[2686,2691],"vripara":"206"},"segments":{"sn7.20:0.3":"Bhikkhakasuttaṃ","sn7.20:1.1":"Sāvatthinidānaṃ.","sn7.20:1.2":"Atha kho bhikkhako brāhmaṇo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavatā saddhiṃ sammodi.","sn7.20:1.3":"Sammodanīyaṃ kathaṃ sāraṇīyaṃ vītisāretvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho bhikkhako brāhmaṇo bhagavantaṃ etadavoca –","sn7.20:1.4":"“ahampi kho, bho gotama, bhikkhako, bhavampi bhikkhako, idha no kiṃ nānākaraṇa”nti?","sn7.20:2.1":"“Na tena bhikkhako hoti,","sn7.20:2.2":"yāvatā bhikkhate pare;","sn7.20:2.3":"Vissaṃ dhammaṃ samādāya,","sn7.20:2.4":"bhikkhu hoti na tāvatā.","sn7.20:3.1":"“Yodha puññañca pāpañca,","sn7.20:3.2":"bāhitvā brahmacariyaṃ;","sn7.20:3.3":"Saṅkhāya loke carati,","sn7.20:3.4":"sa ve bhikkhūti vuccatī”ti.","sn7.20:4.1":"Evaṃ vutte, bhikkhako brāhmaṇo bhagavantaṃ etadavoca –","sn7.20:4.2":"“abhikkantaṃ, bho gotama, abhikkantaṃ, bho gotama…pe…","sn7.20:4.3":"upāsakaṃ maṃ bhavaṃ gotamo dhāretu ajjatagge pāṇupetaṃ saraṇaṃ gata”nti. 11."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1145,"to":1145,"paras":[{"para":1145,"vripara":"206","refs":["sn7.20:1","sn7.20:2","sn7.20:3"],"lines":["Dasame <b>idhā</b>ti imasmiṃ bhikkhubhāve.","<b>Vissaṃ dhamma</b>nti duggandhaṃ akusaladhammaṃ.","<b>Bāhitvā</b>ti aggamaggena jahitvā.","<b>Saṅkhāyā</b>ti ñāṇena.","<b>Sa ve bhikkhūti vuccatī</b>ti so ve bhinnakilesattā bhikkhu nāma vuccati.","Dasamaṃ. 11."],"lineRefs":[["sn7.20:1"],["sn7.20:2"],["sn7.20:3"],["sn7.20:3"],["sn7.20:3"],["sn7.20:3"]]}],"wordLinks":[["sn7.20:1.4","idhā",0,0],["sn7.20:2.3","vissaṃ dhammaṃ",0,1],["sn7.20:3.1","bāhitvā",0,2],["sn7.20:3.3","saṅkhāyā",0,3],["sn7.20:3.3","sa ve bhikkhūti vuccatī",0,4]],"before":[{"para":1144,"vripara":null,"title":"Bhikkhakasuttavaṇṇanā","lines":["Bhikkhakasuttavaṇṇanā 206."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1336,"to":1336,"paras":[{"para":1336,"vripara":"206","refs":["sn7.20:2","sn7.20:3"],"lines":["Virūpaṃ gandhaṃ pasavatīti <b>visso,</b> duggandho.","<b>Bāhitvā</b>ti attano santānato bahikatvā nīharitvā.","Taṃ pana anavasesato pajahananti āha <b>“aggamaggena jahitvā”</b>ti.","Saṅkhāyati sammadeva paricchindati etāyāti <b>saṅkhā,</b> ñāṇanti āha <b>“saṅkhāyāti ñāṇenā”</b>ti.","<b>Bhinnakilesattā</b>ti niruttinayena bhikkhusaddasiddhimāha."],"lineRefs":[["sn7.20:2"],["sn7.20:3"],["sn7.20:3"],["sn7.20:3"],["sn7.20:3"]]}],"wordLinks":[["sn7.20:2.3","visso",0,0],["sn7.20:3.1","bāhitvā",0,1],["sn7.20:3.3","saṅkhā",0,3]],"after":[{"para":1337,"vripara":null,"title":"Bhikkhakasuttavaṇṇanā","lines":["Bhikkhakasuttavaṇṇanā niṭṭhitā. 11."]}]},"tika2":null}
