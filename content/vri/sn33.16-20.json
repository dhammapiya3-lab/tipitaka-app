{"suttaId":"sn33.16-20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1368,1372],"vripara":"622-626"},"segments":{"sn33.16:0.3":"16-20. Rūpaananubodhādisuttapañcakaṃ","sn33.16:1.1":"622-626. Sāvatthinidānaṃ.","sn33.16:1.2":"Ekamantaṃ nisinno kho vacchagotto paribbājako bhagavantaṃ etadavoca –","sn33.16:1.3":"ko nu kho, bho gotama, hetu, ko paccayo … pe …","sn33.16:1.4":"rūpe kho, vaccha, ananubodhā … pe … rūpanirodhagāminiyā paṭipadāya ananubodhā … pe ….","sn33.17:1.1":"Sāvatthinidānaṃ.","sn33.17:1.2":"Vedanāya kho, vaccha … pe ….","sn33.18:1.1":"Sāvatthinidānaṃ.","sn33.18:1.2":"Saññāya kho, vaccha … pe ….","sn33.19:1.1":"Sāvatthinidānaṃ.","sn33.19:1.2":"Saṅkhāresu kho, vaccha … pe ….","sn33.20:1.1":"Sāvatthinidānaṃ.","sn33.20:1.2":"Viññāṇe kho, vaccha ananubodhā … pe …","sn33.20:1.3":"viññāṇanirodhagāminiyā paṭipadāya ananubodhā.","sn33.20:1.4":"Vīsatimaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
