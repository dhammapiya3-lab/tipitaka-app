{"suttaId":"vv79","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2813,2847],"vripara":"1146"},"segments":{"vv79:0.4":"Ambavimānavatthu","vv79:1.1":"“Uccamidaṃ maṇithūṇaṃ vimānaṃ,","vv79:1.2":"samantato dvādasa yojanāni;","vv79:1.3":"Kūṭāgārā sattasatā uḷārā,","vv79:1.4":"veḷuriyathambhā rucakatthatā subhā. 1147.","vv79:2.1":"“Tatthacchasi pivasi khādasi ca,","vv79:2.2":"dibbā ca vīṇā pavadanti vagguṃ;","vv79:2.3":"Dibbā rasā kāmaguṇettha pañca,","vv79:2.4":"nāriyo ca naccanti suvaṇṇachannā. 1148.","vv79:3.1":"“Kena tetādiso vaṇṇo…pe…","vv79:3.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti. 1150.","vv79:4.1":"So devaputto attamano…pe…","vv79:4.3":"yassa kammassidaṃ phalaṃ. 1151.","vv79:5.1":"“Gimhānaṃ pacchime māse,","vv79:5.2":"patapante [patāpante (syā.), patāpente (ka.)] divaṅkare;","vv79:5.3":"Paresaṃ bhatako poso,","vv79:5.4":"ambārāmamasiñcati. 1152.","vv79:6.1":"“Atha tenāgamā bhikkhu,","vv79:6.2":"sāriputtoti vissuto;","vv79:6.3":"Kilantarūpo kāyena,","vv79:6.4":"akilantova cetasā. 1153.","vv79:7.1":"“Tañca disvāna āyantaṃ,","vv79:7.2":"avocaṃ ambasiñcako;","vv79:7.3":"Sādhu taṃ [sādhukaṃ (ka.)] bhante nhāpeyyaṃ,","vv79:7.4":"yaṃ mamassa sukhāvahaṃ. 1154.","vv79:8.1":"“Tassa me anukampāya,","vv79:8.2":"nikkhipi pattacīvaraṃ;","vv79:8.3":"Nisīdi rukkhamūlasmiṃ,","vv79:8.4":"chāyāya ekacīvaro. 1155.","vv79:9.1":"“Tañca acchena vārinā,","vv79:9.2":"pasannamānaso naro;","vv79:9.3":"Nhāpayī rukkhamūlasmiṃ,","vv79:9.4":"chāyāya ekacīvaraṃ. 1156.","vv79:10.1":"“Ambo ca sitto samaṇo ca nhāpito,","vv79:10.2":"mayā ca puññaṃ pasutaṃ anappakaṃ;","vv79:10.3":"Iti so pītiyā kāyaṃ,","vv79:10.4":"sabbaṃ pharati attano. 1157.","vv79:11.1":"“Tadeva ettakaṃ kammaṃ,","vv79:11.2":"akāsiṃ tāya jātiyā;","vv79:11.3":"Pahāya mānusaṃ dehaṃ,","vv79:11.4":"upapannomhi nandanaṃ. 1158.","vv79:12.1":"“Nandane ca vane ramme,","vv79:12.2":"nānādijagaṇāyute;","vv79:12.3":"Ramāmi naccagītehi,","vv79:12.4":"accharāhi purakkhato”ti.","vv79:13.1":"Ambavimānaṃ pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3407,"to":3411,"paras":[{"para":3407,"vripara":"1151","refs":["vv79:5"],"lines":["Tattha <b>gimhānaṃ pacchime māse</b>ti āsāḷhimāse.","<b>Patapante</b>ti ativiya dippante, sabbaso uṇhaṃ vissajjenteti attho.","<b>Divaṅkare</b>ti divākare, ayameva vā pāṭho.","<b>Asiñcatī</b>ti siñcati, -kāro nipātamattaṃ, siñcati ambarukkhamūlesu dhuvaṃ jalasekaṃ karotīti attho.","“Asiñcathā”ti ca pāṭho, siñcitthāti attho.","“Asiñcaha”nti ca paṭhanti, paresaṃ bhatako poso hutvā tadā ambārāmaṃ asiñciṃ ahanti attho. 1152."],"lineRefs":[["vv79:5"],["vv79:5"],["vv79:5"],["vv79:5"],["vv79:5"],["vv79:5"]]},{"para":3408,"vripara":"1152","refs":["vv79:6"],"lines":["<b>Tenā</b>ti yena disābhāgena so ambārāmo, tena agamā agañchi.","<b>Akilantova cetasā</b>ti cetodukkhassa maggeneva pahīnattā cetasā akilantopi samāno kilanturūpo kāyena tena maggena agamāti yojanā. 1153-4."],"lineRefs":[["vv79:6"],["vv79:6"]]},{"para":3409,"vripara":"1153-1154","refs":["vv79:7"],"lines":["<b>Avocaṃ</b> ahaṃ tadā <b>ambasiñcako</b> hutvāti yojanā.","<b>Ekacīvaro</b>ti nhāyitukāmoti adhippāyo. 1156."],"lineRefs":[["vv79:7"],["vv79:7"]]},{"para":3410,"vripara":"1156","refs":["vv79:10"],"lines":["<b>Itī</b>ti evaṃ “ambo ca sitto, samaṇo ca nhāpito, mayā ca puññaṃ pasutaṃ anappakaṃ, ekeneva payogena tividhopi attho sādhito”ti iminākārena pavattāya <b>pītiyā so</b> puriso <b>attano sabbaṃ kāyaṃ pharati,</b> nirantaraṃ phuṭaṃ karotīti yojanā.","Atītatthe cetaṃ vattamānavacanaṃ, pharīti attho. 1157."],"lineRefs":[["vv79:10"],["vv79:10"]]},{"para":3411,"vripara":"1157","refs":["vv79:11"],"lines":["<b>Tadeva ettakaṃ kamma</b>nti taṃ ettakaṃ evaṃ pānīyadānamattakaṃ kammaṃ akāsiṃ, tāya tassaṃ jātiyaṃ aññaṃ nānussarāmīti adhippāyo.","Tesaṃ vuttanayameva."],"lineRefs":[["vv79:11"],["vv79:11"]]}],"wordLinks":[["vv79:5.1","gimhānaṃ pacchime māse",0,0],["vv79:5.1","patapante",0,1],["vv79:5.1","divaṅkare",0,2],["vv79:5.3","asiñcatī",0,3],["vv79:6.1","tenā",1,0],["vv79:6.3","akilantova cetasā",1,1],["vv79:7.1","ambasiñcako",2,0],["vv79:7.1","avocaṃ",2,0],["vv79:10.3","itī",3,0],["vv79:11.1","tadeva ettakaṃ kammaṃ",4,0]],"before":[{"para":3366,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Ambavimānavaṇṇanā"]},{"para":3367,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["<b>Uccamidaṃ</b> <b>maṇithūṇa</b>nti ambavimānaṃ.","Tassa kā uppatti?","Bhagavā rājagahe viharati veḷuvane.","Tena samayena rājagahe aññataro duggatapuriso paresaṃ bhattavetanabhato hutvā ambavanaṃ rakkhati.","So ekadivasaṃ āyasmantaṃ sāriputtaṃ gimhasamaye sūriyātapasantatte uṇhavālikānippīḷite vipphandamānamarīcijālavitthate bhūmippadese tassa ambārāmassa avidūrena maggena sedāgatena gattena gacchantaṃ disvā sañjātagāravabahumāno upasaṅkamitvā evamāha “mahā ayaṃ, bhante, ghammapariḷāho, ativiya parissantarūpo viya dissati, sādhu, bhante, ayyo imaṃ ambārāmaṃ pavisitvā muhuttaṃ vissamitvā addhānaparissamaṃ paṭivinodetvā gacchatha anukampaṃ upādāyā”ti.","Thero visesato tassa cittappasādaṃ paribrūhetukāmo taṃ ārāmaṃ pavisitvā aññatarassa ambarukkhassa mūle nisīdi."]},{"para":3368,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Puna so puriso āha “sace, bhante, nhāyitukāmattha, ahaṃ ito kūpato udakaṃ uddharitvā tumhe nhāpessāmi, pānīyañca dassāmī”ti.","Theropi adhivāsesi tuṇhībhāvena.","So kūpato udakaṃ uddharitvā parissāvetvā theraṃ nhāpesi, nhāpetvā ca hatthapāde dhovitvā nisinnassa pānīyaṃ upanesi.","Thero pānīyaṃ pivitvā paṭippassaddhadaratho tassa purisassa udakadāne ceva nhāpane ca anumodanaṃ vatvā pakkāmi.","Atha so puriso “ghammābhitattassa vata therassa ghammapariḷāhaṃ paṭippassambhesiṃ, bahuṃ vata mayā puññaṃ pasuta”nti uḷārapītisomanassaṃ paṭisaṃvedesi.","So aparabhāge kālaṃ katvā tāvatiṃsesu uppajji.","Taṃ āyasmā mahāmoggallāno upasaṅkamitvā imāhi gāthāhi katapuññaṃ pucchi. 1146."]},{"para":3370,"vripara":"1146","title":"Ambavimānavaṇṇanā","lines":["“Uccamidaṃ maṇithūṇaṃ vimānaṃ, samantato dvādasa yojanāni;"]},{"para":3371,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Kūṭāgārā sattasatā uḷārā, veḷuriyathambhā rucakatthatā subhā. 1147."]},{"para":3373,"vripara":"1147","title":"Ambavimānavaṇṇanā","lines":["“Tatthacchasi pivasi khādasi ca, dibbā ca vīṇā pavadanti vagguṃ;"]},{"para":3374,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Dibbā rasā kāmaguṇettha pañca, nāriyo ca naccanti suvaṇṇachannā. 1148."]},{"para":3376,"vripara":"1148","title":"Ambavimānavaṇṇanā","lines":["“Kena tetādiso vaṇṇo…pe…"]},{"para":3377,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Vaṇṇo ca te sabbadisā pabhāsatī”ti. 1150."]},{"para":3379,"vripara":"1150","title":"Ambavimānavaṇṇanā","lines":["“So devaputto attamano…pe…"]},{"para":3380,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Yassa kammassidaṃ phalaṃ”. 1151."]},{"para":3382,"vripara":"1151","title":"Ambavimānavaṇṇanā","lines":["“Gimhānaṃ pacchime māse, patapante divaṅkare;"]},{"para":3383,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Paresaṃ bhatako poso, ambārāmamasiñcati. 1152."]},{"para":3385,"vripara":"1152","title":"Ambavimānavaṇṇanā","lines":["“Atha tenāgamā bhikkhu, sāriputtoti vissuto;"]},{"para":3386,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Kilantarūpo kāyena, akilantova cetasā. 1153."]},{"para":3388,"vripara":"1153","title":"Ambavimānavaṇṇanā","lines":["“Tañca disvāna āyantaṃ, avocaṃ ambasiñcako;"]},{"para":3389,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Sādhu taṃ bhante nhāpeyyaṃ, yaṃ mamassa sukhāvahaṃ. 1154."]},{"para":3391,"vripara":"1154","title":"Ambavimānavaṇṇanā","lines":["“Tassa me anukampāya, nikkhipi pattacīvaraṃ;"]},{"para":3392,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Nisīdi rukkhamūlasmiṃ, chāyāya ekacīvaro. 1155."]},{"para":3394,"vripara":"1155","title":"Ambavimānavaṇṇanā","lines":["“Tañca acchena vārinā, pasannamānaso naro;"]},{"para":3395,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Nhāpayī rukkhamūlasmiṃ, chāyāya ekacīvaraṃ. 1156."]},{"para":3397,"vripara":"1156","title":"Ambavimānavaṇṇanā","lines":["“Ambo ca sitto samaṇo ca nhāpito,"]},{"para":3398,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Mayā ca puññaṃ pasutaṃ anappakaṃ;"]},{"para":3399,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Iti so pītiyā kāyaṃ, sabbaṃ pharati attano. 1157."]},{"para":3401,"vripara":"1157","title":"Ambavimānavaṇṇanā","lines":["“Tadeva ettakaṃ kammaṃ, akāsiṃ tāya jātiyā;"]},{"para":3402,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Pahāya mānusaṃ dehaṃ, upapannomhi nandanaṃ. 1158."]},{"para":3404,"vripara":"1158","title":"Ambavimānavaṇṇanā","lines":["“Nandane ca vane ramme, nānādijagaṇāyute;"]},{"para":3405,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Ramāmi naccagītehi, accharāhi purakkhato”ti. –"]},{"para":3406,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Sopi tassa imāhi gāthāhi byākāsi. 1151."]}],"after":[{"para":3412,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Ambavimānavaṇṇanā niṭṭhitā. 6."]}]},"tika":null,"tika2":null}
