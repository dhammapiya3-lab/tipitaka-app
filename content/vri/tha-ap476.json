{"suttaId":"tha-ap476","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1677,1691],"vripara":"46"},"segments":{"tha-ap476:0.3":"Sumanabījaniyattheraapadānaṃ","tha-ap476:1.1":"“Vipassino bhagavato,","tha-ap476:1.2":"bodhiyā pādaputtame;","tha-ap476:1.3":"Sumano bījaniṃ gayha,","tha-ap476:1.4":"abījiṃ bodhimuttamaṃ.","tha-ap476:2.1":"“Ekanavutito kappe,","tha-ap476:2.2":"abījiṃ bodhimuttamaṃ;","tha-ap476:2.3":"Duggatiṃ nābhijānāmi,","tha-ap476:2.4":"bījanāya idaṃ phalaṃ.","tha-ap476:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap476:3.3":"viharāmi anāsavo.","tha-ap476:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap476:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap476:5.1":"“Paṭisambhidā catasso … pe …","tha-ap476:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap476:6.1":"Itthaṃ sudaṃ āyasmā sumanabījaniyo thero imā gāthāyo Abhāsitthāti.","tha-ap476:7.1":"Sumanabījaniyattherassāpadānaṃ catutthaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
