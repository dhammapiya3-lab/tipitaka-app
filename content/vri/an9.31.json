{"suttaId":"an9.31","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-ix","vriCode":"s0404m2.mul","paras":[237,241],"vripara":"31"},"segments":{"an9.31:0.3":"Anupubbanirodhasuttaṃ","an9.31:1.1":"“Navayime, bhikkhave, anupubbanirodhā.","an9.31:1.2":"Katame nava?","an9.31:1.3":"Paṭhamaṃ jhānaṃ samāpannassa kāmasaññā [āmissasaññā (syā.)] niruddhā hoti;","an9.31:1.4":"dutiyaṃ jhānaṃ samāpannassa vitakkavicārā niruddhā honti;","an9.31:1.5":"tatiyaṃ jhānaṃ samāpannassa pīti niruddhā hoti;","an9.31:1.6":"catutthaṃ jhānaṃ samāpannassa assāsapassāsā niruddhā honti;","an9.31:1.7":"ākāsānañcāyatanaṃ samāpannassa rūpasaññā niruddhā hoti;","an9.31:1.8":"viññāṇañcāyatanaṃ samāpannassa ākāsānañcāyatanasaññā niruddhā hoti;","an9.31:1.9":"ākiñcaññāyatanaṃ samāpannassa viññāṇañcāyatanasaññā niruddhā hoti;","an9.31:1.10":"nevasaññānāsaññāyatanaṃ samāpannassa ākiñcaññāyatanasaññā niruddhā hoti;","an9.31:1.11":"saññāvedayitanirodhaṃ samāpannassa saññā ca vedanā ca niruddhā honti.","an9.31:1.12":"Ime kho, bhikkhave, nava anupubbanirodhā”ti [dī. ni.3.344,349].","an9.31:1.13":"Ekādasamaṃ.","an9.31:1.14":"Sattāvāsavaggo tatiyo.","an9.31:2.0":"Tassuddānaṃ –","an9.31:2.1":"Tiṭhānaṃ khaḷuṅko taṇhā,","an9.31:2.2":"sattapaññā silāyupo;","an9.31:2.3":"Dve verā dve āghātāni,","an9.31:2.4":"anupubbanirodhena cāti."},"unsure":[],"preface":[],"attha":{"book":"Mp-ix","bookName":"Navakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":360,"to":363,"paras":[{"para":360,"vripara":"30-31","refs":["an9.31:1"],"lines":["30-31. Dasame <b>āghātapaṭivinayā</b>ti āghātassa paṭivinayakāraṇāni.","<b>Taṃ kutettha labbhā</b>ti “taṃ anatthacaraṇaṃ mā ahosī”ti etasmiṃ puggale kuto labbhā, kena kāraṇena sakkā laddhuṃ,“paro nāma parassa attano cittaruciyā anatthaṃ karotī”ti evaṃ cintetvā āghātaṃ paṭivineti.","Atha vā sacāhaṃ kopaṃ kareyyaṃ, taṃ kopakaraṇaṃ ettha puggale kuto labbhā, kena kāraṇena laddhabbanti attho.","Kuto lābhātipi pāṭho.","Sacāhaṃ ettha kopaṃ kareyyaṃ, tasmiṃ me kopakaraṇe kuto lābhā lābhā, nāma ke siyunti attho.","Imasmiñca atthe <b>tan</b>ti nipātamattameva hoti.","Ekādasame <b>anupubbanirodhā</b>ti anupaṭipāṭinirodhā.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["an9.31:1"],["an9.31:1"],["an9.31:1"],["an9.31:1"],["an9.31:1"],["an9.31:1"],["an9.31:1"],["an9.31:1"]]},{"para":361,"vripara":null,"refs":["an9.31:1"],"lines":["Sattāvāsavaggo tatiyo."],"lineRefs":[["an9.31:1"]]},{"para":362,"vripara":null,"refs":["an9.31:1"],"lines":["Mahāvaggo"],"lineRefs":[["an9.31:1"]]},{"para":363,"vripara":null,"refs":["an9.31:1"],"lines":["1-2. Anupubbavihārasuttādivaṇṇanā"],"lineRefs":[["an9.31:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-ix","bookName":"Navakanipāta-ṭīkā","vriCode":"s0404t.tik","from":413,"to":413,"paras":[{"para":413,"vripara":"31","refs":["an9.31:1"],"lines":["Ekādasame <b>anupubbanirodhā</b>ti anupubbena anukkamena pavattetabbanirodhā.","Tenāha <b>“anupaṭipāṭinirodhā”</b>ti."],"lineRefs":[["an9.31:1"],["an9.31:1"]]}],"wordLinks":[["an9.31:1.1","anupubbanirodhā",0,0],["an9.31:1.12","anupubbanirodhā",0,0]],"before":[{"para":412,"vripara":null,"title":"Anupubbanirodhasuttavaṇṇanā","lines":["Anupubbanirodhasuttavaṇṇanā"]}],"after":[{"para":414,"vripara":null,"title":"Anupubbanirodhasuttavaṇṇanā","lines":["Anupubbanirodhasuttavaṇṇanā niṭṭhitā."]},{"para":415,"vripara":null,"title":"Anupubbanirodhasuttavaṇṇanā","lines":["Sattāvāsavaggavaṇṇanā niṭṭhitā."]}]},"tika2":null}
