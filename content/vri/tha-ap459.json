{"suttaId":"tha-ap459","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1196,1231],"vripara":"37"},"segments":{"tha-ap459:0.3":"Ekachattiyattheraapadānaṃ","tha-ap459:1.1":"“Aṅgārajātā pathavī,","tha-ap459:1.2":"kukkuḷānugatā mahī;","tha-ap459:1.3":"Padumuttaro bhagavā,","tha-ap459:1.4":"abbhokāsamhi caṅkami. 38.","tha-ap459:2.1":"“Paṇḍaraṃ chattamādāya,","tha-ap459:2.2":"addhānaṃ paṭipajjahaṃ;","tha-ap459:2.3":"Tattha disvāna sambuddhaṃ,","tha-ap459:2.4":"vitti me upapajjatha. 39.","tha-ap459:3.1":"“Marīciyotthaṭā [maricimophunā (syā.), marīcivophuṭā (pī.)] bhūmi,","tha-ap459:3.2":"aṅgārāva mahī ayaṃ;","tha-ap459:3.3":"Upahanti [upavāyanti (sī. pī.)] mahāvātā,","tha-ap459:3.4":"sarīrassāsukhepanā [sarīrakāyukhepanā (syā.)]. 40.","tha-ap459:4.1":"“Sītaṃ uṇhaṃ vihanantaṃ [vihanati (syā. ka.)],","tha-ap459:4.2":"vātātapanivāraṇaṃ;","tha-ap459:4.3":"Paṭiggaṇha imaṃ chattaṃ,","tha-ap459:4.4":"phassayissāmi [passayissāmi (ka.)] nibbutiṃ. 41.","tha-ap459:5.1":"“Anukampako kāruṇiko,","tha-ap459:5.2":"padumuttaro mahāyaso;","tha-ap459:5.3":"Mama saṅkappamaññāya,","tha-ap459:5.4":"paṭiggaṇhi tadā jino. 42.","tha-ap459:6.1":"“Tiṃsakappāni devindo,","tha-ap459:6.2":"devarajjamakārayiṃ;","tha-ap459:6.3":"Satānaṃ pañcakkhattuñca,","tha-ap459:6.4":"cakkavattī ahosahaṃ. 43.","tha-ap459:7.1":"“Padesarajjaṃ vipulaṃ,","tha-ap459:7.2":"gaṇanāto asaṅkhiyaṃ;","tha-ap459:7.3":"Anubhomi sakaṃ kammaṃ,","tha-ap459:7.4":"pubbe sukatamattano. 44.","tha-ap459:8.1":"“Ayaṃ me pacchimā jāti,","tha-ap459:8.2":"carimo vattate bhavo;","tha-ap459:8.3":"Ajjāpi setacchattaṃ me,","tha-ap459:8.4":"sabbakālaṃ dharīyati. 45.","tha-ap459:9.1":"“Satasahassito kappe,","tha-ap459:9.2":"yaṃ chattamadadiṃ tadā;","tha-ap459:9.3":"Duggatiṃ nābhijānāmi,","tha-ap459:9.4":"chattadānassidaṃ phalaṃ. 46.","tha-ap459:10.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap459:10.3":"viharāmi anāsavo. 47.","tha-ap459:11.1":"“Svāgataṃ vata me āsi…pe…","tha-ap459:11.3":"kataṃ buddhassa sāsanaṃ. 48.","tha-ap459:12.1":"“Paṭisambhidā catasso…pe…","tha-ap459:12.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap459:13.1":"Itthaṃ sudaṃ āyasmā ekachattiyo thero imā gāthāyo Abhāsitthāti.","tha-ap459:14.1":"Ekachattiyattherassāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
