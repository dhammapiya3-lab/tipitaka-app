{"suttaId":"sn51.23","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1688,1688],"vripara":"835"},"segments":{"sn51.23:0.3":"Bhikkhusuttaṃ","sn51.23:1.1":"“Cattārome, bhikkhave, iddhipādā.","sn51.23:1.2":"Katame cattāro?","sn51.23:1.3":"Idha, bhikkhave, bhikkhu chandasamādhippadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti,","sn51.23:1.4":"vīriyasamādhi…pe…","sn51.23:1.5":"cittasamādhi …pe…","sn51.23:1.6":"vīmaṃsāsamādhippadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti –","sn51.23:1.7":"ime kho, bhikkhave, cattāro iddhipādā.","sn51.23:1.8":"Imesaṃ kho, bhikkhave, catunnaṃ iddhipādānaṃ bhāvitattā bahulīkatattā bhikkhu āsavānaṃ khayā anāsavaṃ cetovimuttiṃ paññāvimuttiṃ diṭṭheva dhamme sayaṃ abhiññā sacchikatvā upasampajja viharatī”ti.","sn51.23:1.9":"Tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":692,"to":693,"paras":[{"para":692,"vripara":"835-842","refs":["sn51.23:1"],"lines":["Tatiye vivaṭṭapādakiddhi kathitā, tathā catutthe.","Apica dve phalāni ādiṃ katvā heṭṭhā missakiddhipādā kathitā, sattasu phalesu pubbabhāgā.","Sattamādīni cattāri heṭṭhā kathitanayāneva. 11-12."],"lineRefs":[["sn51.23:1"],["sn51.23:1"],["sn51.23:1"]]},{"para":693,"vripara":null,"refs":["sn51.23:1"],"lines":["Moggallānasuttādivaṇṇanā 843-844."],"lineRefs":[["sn51.23:1"]]}],"wordLinks":[],"before":[{"para":691,"vripara":null,"title":"Bhikkhusuttādivaṇṇanā","lines":["Bhikkhusuttādivaṇṇanā 835-842."]}]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":600,"to":605,"paras":[{"para":600,"vripara":"835-842","refs":["sn51.23:1"],"lines":["“Dvinnaṃ phalāna”nti āgatasuttaṃ sandhāya <b>“dve phalāni ādiṃ katvā”</b>ti vuttaṃ.","Sesaṃ suviññeyyameva."],"lineRefs":[["sn51.23:1"],["sn51.23:1"]]},{"para":601,"vripara":null,"refs":["sn51.23:1"],"lines":["Ayoguḷavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn51.23:1"]]},{"para":602,"vripara":null,"refs":["sn51.23:1"],"lines":["Iddhipādasaṃyuttavaṇṇanā niṭṭhitā. 8."],"lineRefs":[["sn51.23:1"]]},{"para":603,"vripara":null,"refs":["sn51.23:1"],"lines":["Anuruddhasaṃyuttaṃ 1."],"lineRefs":[["sn51.23:1"]]},{"para":604,"vripara":null,"refs":["sn51.23:1"],"lines":["Rahogatavaggo 1-2."],"lineRefs":[["sn51.23:1"]]},{"para":605,"vripara":null,"refs":["sn51.23:1"],"lines":["Paṭhamarahogatasuttādivaṇṇanā 899-900."],"lineRefs":[["sn51.23:1"]]}],"wordLinks":[],"before":[{"para":599,"vripara":null,"title":"Bhikkhusuttādivaṇṇanā","lines":["Bhikkhusuttādivaṇṇanā 835-842."]}]},"tika2":null}
