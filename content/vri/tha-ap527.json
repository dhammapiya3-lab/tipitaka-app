{"suttaId":"tha-ap527","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3563,3577],"vripara":"31"},"segments":{"tha-ap527:0.3":"Supaṭadāyakattheraapadānaṃ","tha-ap527:1.1":"“Divāvihārā nikkhanto,","tha-ap527:1.2":"vipassī lokanāyako;","tha-ap527:1.3":"Lahuṃ supaṭakaṃ [supaṭikaṃ (syā.), pūpapavaṃ (pī.)] datvā,","tha-ap527:1.4":"kappaṃ saggamhi modahaṃ. 32.","tha-ap527:2.1":"“Ekanavutito kappe,","tha-ap527:2.2":"supaṭakamadāsahaṃ;","tha-ap527:2.3":"Duggatiṃ nābhijānāmi,","tha-ap527:2.4":"supaṭassa idaṃ phalaṃ. 33.","tha-ap527:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap527:3.3":"viharāmi anāsavo. 34.","tha-ap527:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap527:4.3":"kataṃ buddhassa sāsanaṃ. 35.","tha-ap527:5.1":"“Paṭisambhidā catasso…pe…","tha-ap527:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap527:6.1":"Itthaṃ sudaṃ āyasmā supaṭadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap527:7.1":"Supaṭadāyakattherassāpadānaṃ pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
