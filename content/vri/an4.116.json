{"suttaId":"an4.116","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1074,1075],"vripara":"116"},"segments":{"an4.116:0.3":"Appamādasuttaṃ","an4.116:1.1":"“Catūhi, bhikkhave, ṭhānehi appamādo karaṇīyo.","an4.116:1.2":"Katamehi catūhi?","an4.116:1.3":"Kāyaduccaritaṃ, bhikkhave, pajahatha, kāyasucaritaṃ bhāvetha;","an4.116:1.4":"tattha ca mā pamādattha.","an4.116:1.5":"Vacīduccaritaṃ, bhikkhave, pajahatha, vacīsucaritaṃ bhāvetha;","an4.116:1.6":"tattha ca mā pamādattha.","an4.116:1.7":"Manoduccaritaṃ, bhikkhave, pajahatha, manosucaritaṃ bhāvetha;","an4.116:1.8":"tattha ca mā pamādattha.","an4.116:1.9":"Micchādiṭṭhiṃ, bhikkhave, pajahatha, sammādiṭṭhiṃ bhāvetha;","an4.116:1.10":"tattha ca mā pamādattha.","an4.116:2.1":"“Yato kho, bhikkhave, bhikkhuno kāyaduccaritaṃ pahīnaṃ hoti kāyasucaritaṃ bhāvitaṃ, vacīduccaritaṃ pahīnaṃ hoti vacīsucaritaṃ bhāvitaṃ, manoduccaritaṃ pahīnaṃ hoti manosucaritaṃ bhāvitaṃ, micchādiṭṭhi pahīnā hoti sammādiṭṭhi bhāvitā, so na bhāyati samparāyikassa maraṇassā”ti.","an4.116:2.2":"Chaṭṭhaṃ."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1397,"to":1397,"paras":[{"para":1397,"vripara":"116","refs":["an4.116:2"],"lines":["Chaṭṭhe <b>yato kho</b>ti yadā kho.","<b>Samparāyikassā</b>ti desanāmattametaṃ, khīṇāsavo pana neva samparāyikassa, na diṭṭhadhammikassa maraṇassa bhāyati.","Sova idha adhippeto.","Keci pana “sammādiṭṭhi bhāvitāti vacanato sotāpannaṃ ādiṃ katvā sabbepi ariyā adhippetā”ti vadanti."],"lineRefs":[["an4.116:2"],["an4.116:2"],["an4.116:2"],["an4.116:2"]]}],"wordLinks":[["an4.116:2.1","yato kho",0,0],["an4.116:2.1","samparāyikassā",0,1]],"before":[{"para":1396,"vripara":null,"title":"Appamādasuttavaṇṇanā","lines":["Appamādasuttavaṇṇanā"]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1578,"to":1580,"paras":[{"para":1578,"vripara":"111-117","refs":["an4.116:1"],"lines":["111-117. Dutiyassa paṭhame <b>assadamme</b>ti dammanayogge asse.","<b>Sāretī</b>ti sikkhāpeti pavatteti.","Sesamettha uttānameva.","Dutiyādīni uttānatthāneva."],"lineRefs":[["an4.116:1"],["an4.116:1"],["an4.116:1"],["an4.116:1"]]},{"para":1579,"vripara":null,"refs":["an4.116:1"],"lines":["Kesisuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an4.116:1"]]},{"para":1580,"vripara":null,"refs":["an4.116:1"],"lines":["8-10. Saṃvejanīyasuttādivaṇṇanā"],"lineRefs":[["an4.116:1"]]}],"wordLinks":[]},"tika2":null}
