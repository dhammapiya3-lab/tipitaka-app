{"suttaId":"an3.134","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1190,1190],"vripara":"135"},"segments":{"an3.134:0.3":"Parisāsuttaṃ","an3.134:1.1":"“Tisso imā, bhikkhave, parisā.","an3.134:1.2":"Katamā tisso?","an3.134:1.3":"Ukkācitavinītā parisā, paṭipucchāvinītā parisā, yāvatāvinītā [yāvatajjhāvinītā (aṭṭhakathāyaṃ pāṭhantaraṃ)] parisā – imā kho, bhikkhave, tisso parisā”ti.","an3.134:1.5":"Dutiyaṃ."},"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":958,"to":958,"paras":[{"para":958,"vripara":"135","refs":["an3.134:1"],"lines":["Dutiye <b>ukkācitavinītā</b>ti appaṭipucchitvā vinītā dubbinītaparisā.","<b>Paṭipucchāvinītā</b>ti pucchitvā vinītā suvinītaparisā.","<b>Yāvatāvinītā</b>ti pamāṇavasena vinītā, pamāṇaṃ ñatvā vinītaparisāti attho.","“Yāvatajjhā”ti pāḷiyā pana yāva ajjhāsayāti attho, ajjhāsayaṃ ñatvā vinītaparisāti vuttaṃ hoti.","Tatiyaṃ uttānameva."],"lineRefs":[["an3.134:1"],["an3.134:1"],["an3.134:1"],["an3.134:1"],["an3.134:1"]]}],"wordLinks":[["an3.134:1.3","ukkācitavinītā",0,0],["an3.134:1.3","paṭipucchāvinītā",0,1],["an3.134:1.3","yāvatāvinītā",0,2]]},"tika":null}
