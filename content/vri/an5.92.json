{"suttaId":"an5.92","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[718,718],"vripara":"92"},"segments":{"an5.92:0.3":"Dutiyasampadāsuttaṃ","an5.92:1.1":"“Pañcimā, bhikkhave, sampadā.","an5.92:1.2":"Katamā pañca?","an5.92:1.3":"Sīlasampadā, samādhisampadā, paññāsampadā, vimuttisampadā, vimuttiñāṇadassanasampadā –","an5.92:1.4":"imā kho, bhikkhave, pañca sampadā”ti.","an5.92:1.5":"Dutiyaṃ."},"unsure":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":214,"to":215,"paras":[{"para":214,"vripara":"91-92","refs":["an5.92:1"],"lines":["91-92. Pañcamassa paṭhame pañca sampadā missikā kathitā.","Dutiye purimā catasso missikā, pañcamī lokikāva."],"lineRefs":[["an5.92:1"],["an5.92:1"]]},{"para":215,"vripara":null,"refs":["an5.92:1"],"lines":["Byākaraṇasuttavaṇṇanā"],"lineRefs":[["an5.92:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":220,"to":223,"paras":[{"para":220,"vripara":"91-100","refs":["an5.92:1"],"lines":["91-100. Pañcamassa paṭhame dutiye ca natthi vattabbaṃ.","Tatiye ājānanato <b>aññā,</b> uparimaggapaññā heṭṭhimamaggena ñātapariññāya eva jānanato.","Tassā pana phalabhāvato maggaphalapaññā taṃsahagatā sammāsaṅkappādayo ca idha “aññā”ti vuttā.","Aññāya byākaraṇāni <b>aññābyākaraṇāni</b>.","Tenevāha <b>“aññābyākaraṇānīti arahattabyākaraṇānī”</b>ti.","<b>Adhigatamānenā</b>ti appatte pattasaññī, anadhigate adhigatasaññī hutvā adhigataṃ mayāti mānena.","Catutthādīni uttānatthāneva."],"lineRefs":[["an5.92:1"],["an5.92:1"],["an5.92:1"],["an5.92:1"],["an5.92:1"],["an5.92:1"],["an5.92:1"]]},{"para":221,"vripara":null,"refs":["an5.92:1"],"lines":["Paṭhamasampadāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an5.92:1"]]},{"para":222,"vripara":null,"refs":["an5.92:1"],"lines":["Kakudhavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an5.92:1"]]},{"para":223,"vripara":null,"refs":["an5.92:1"],"lines":["Dutiyapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an5.92:1"]]}],"wordLinks":[]},"tika2":null}
