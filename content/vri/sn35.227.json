{"suttaId":"sn35.227","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1064,1070],"vripara":"227"},"segments":{"sn35.227:0.3":"Bāhirāyatanaanattasuttaṃ","sn35.227:1.1":"“Rūpā, bhikkhave, anattā. Saddā … gandhā … rasā … phoṭṭhabbā … dhammā anattā.","sn35.227:1.2":"Evaṃ passaṃ … pe …","sn35.227:1.3":"nāparaṃ itthattāyāti pajānātī”ti.","sn35.227:1.4":"Saṭṭhipeyyālavaggo sattarasamo.","sn35.227:2.0":"Tassuddānaṃ –","sn35.227:2.1":"Chandenaṭṭhārasa honti,","sn35.227:2.2":"atītena ca dve nava;","sn35.227:2.3":"Yadaniccāṭṭhārasa vuttā,","sn35.227:2.4":"tayo ajjhattabāhirā;","sn35.227:2.5":"Peyyālo saṭṭhiko vutto,","sn35.227:2.6":"buddhenādiccabandhunāti.","sn35.227:2.7":"Suttantāni saṭṭhi."},"unsure":[],"attha":null,"tika":null,"tika2":null}
