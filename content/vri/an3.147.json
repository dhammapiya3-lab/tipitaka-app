{"suttaId":"an3.147","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1238,1239],"vripara":"148"},"segments":{"an3.147:0.3":"Sāvajjasuttaṃ","an3.147:1.1":"“Tīhi, bhikkhave, dhammehi samannāgato yathābhataṃ nikkhitto evaṃ niraye.","an3.147:1.2":"Katamehi tīhi?","an3.147:1.3":"Sāvajjena kāyakammena, sāvajjena vacīkammena, sāvajjena manokammena – imehi kho, bhikkhave, tīhi dhammehi samannāgato yathābhataṃ nikkhitto evaṃ niraye.","an3.147:2.1":"“Tīhi, bhikkhave, dhammehi samannāgato yathābhataṃ nikkhitto evaṃ sagge.","an3.147:2.2":"Katamehi tīhi?","an3.147:2.3":"Anavajjena kāyakammena, anavajjena vacīkammena, anavajjena manokammena – imehi kho … pe … evaṃ sagge”ti.","an3.147:2.5":"Dutiyaṃ."},"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":978,"to":979,"paras":[{"para":978,"vripara":"147-155","refs":["an3.147:1"],"lines":["147-155. Pañcamassa paṭhame <b>yathābhataṃ nikkhitto</b>ti yathā ānetvā ṭhapito.","Dutiye <b>sāvajjenā</b>ti sadosena.","Tatiye <b>visamenā</b>ti sapakkhalanena.","<b>Samenā</b>ti apakkhalanena.","Catutthe <b>asucinā</b>ti gūthasadisena aparisuddhena amejjhena.","<b>Sucinā</b>ti parisuddhena mejjhena.","Pañcamādīni uttānāneva."],"lineRefs":[["an3.147:1"],["an3.147:1"],["an3.147:1"],["an3.147:1"],["an3.147:1"],["an3.147:1"],["an3.147:1"]]},{"para":979,"vripara":null,"refs":["an3.147:1"],"lines":["Pubbaṇhasuttavaṇṇanā"],"lineRefs":[["an3.147:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":1009,"to":1011,"paras":[{"para":1009,"vripara":"147-156","refs":["an3.147:1"],"lines":["147-156. Maṅgalavaggo uttānatthoyeva."],"lineRefs":[["an3.147:1"]]},{"para":1010,"vripara":null,"refs":["an3.147:1"],"lines":["Tatiyapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an3.147:1"]]},{"para":1011,"vripara":null,"refs":["an3.147:1"],"lines":["(16)6. Acelakavaggavaṇṇanā"],"lineRefs":[["an3.147:1"]]}],"wordLinks":[]},"tika2":null}
