{"suttaId":"ja345","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2973,2985],"vripara":"177"},"segments":{"ja345:0.4":"Gajakumbhajātakaṃ (4-5-5)","ja345:1.1":"Vanaṃ yadaggi dahati, pāvako kaṇhavattanī;","ja345:1.3":"Kathaṃ karosi pacalaka, evaṃ dandhaparakkamo.","ja345:2.1":"Bahūni rukkhachiddāni, pathabyā vivarāni ca;","ja345:2.3":"Tāni ce nābhisambhoma, hoti no kālapariyāyo.","ja345:3.1":"Yo dandhakāle tarati, taraṇīye ca dandhati;","ja345:3.3":"Sukkhapaṇṇaṃva akkamma, atthaṃ bhañjati attano.","ja345:4.1":"Yo dandhakāle dandheti, taraṇīye ca tārayi;","ja345:4.3":"Sasīva rattiṃ vibhajaṃ, tassattho paripūratīti.","ja345:5.1":"Gajakumbhajātakaṃ pañcamaṃ."},"attha":null,"tika":null}
