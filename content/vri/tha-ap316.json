{"suttaId":"tha-ap316","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9276,9294],"vripara":"14"},"segments":{"tha-ap316:0.3":"Sattapadumiyattheraapadānaṃ","tha-ap316:1.1":"“Nadīkūle vasāmahaṃ,","tha-ap316:1.2":"nesādo nāma brāhmaṇo;","tha-ap316:1.3":"Satapattehi pupphehi,","tha-ap316:1.4":"sammajjitvāna assamaṃ. 15.","tha-ap316:2.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap316:2.2":"siddhatthaṃ lokanāyakaṃ;","tha-ap316:2.3":"Disvā nabhena [vanena (syā. ka.)] gacchantaṃ,","tha-ap316:2.4":"hāso me udapajjatha. 16.","tha-ap316:3.1":"“Paccuggantvāna sambuddhaṃ,","tha-ap316:3.2":"lokajeṭṭhaṃ narāsabhaṃ;","tha-ap316:3.3":"Assamaṃ atināmetvā,","tha-ap316:3.4":"jalajaggehi okiriṃ. 17.","tha-ap316:4.1":"“Catunnavutito kappe,","tha-ap316:4.2":"yaṃ pupphamabhiropayiṃ;","tha-ap316:4.3":"Duggatiṃ nābhijānāmi,","tha-ap316:4.4":"buddhapūjāyidaṃ phalaṃ. 18.","tha-ap316:5.1":"“Ito te sattame kappe,","tha-ap316:5.2":"caturo pādapāvarā;","tha-ap316:5.3":"Sattaratanasampannā,","tha-ap316:5.4":"cakkavattī mahabbalā. 19.","tha-ap316:6.1":"“Paṭisambhidā catasso…pe…","tha-ap316:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap316:7.1":"Itthaṃ sudaṃ āyasmā sattapadumiyo thero imā gāthāyo abhāsitthāti.","tha-ap316:8.1":"Sattapadumiyattherassāpadānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3270,"to":3270,"paras":[{"para":3270,"vripara":"16","refs":["tha-ap316:3"],"lines":["Catutthāpadāne <b>jalajaggehi okiri</b>nti jalajehi uttamehi uppalapadumādīhi pupphehi okiriṃ pūjesinti attho."],"lineRefs":[["tha-ap316:3"]]}],"wordLinks":[["tha-ap316:3.3","jalajaggehi okiriṃ",0,0]],"before":[{"para":3267,"vripara":null,"title":"Ārakkhadāyakavaggo","lines":["Ārakkhadāyakavaggo 1-10."]},{"para":3268,"vripara":null,"title":"Ārakkhadāyakattheraapadānādivaṇṇanā","lines":["Ārakkhadāyakattheraapadānādivaṇṇanā"]},{"para":3269,"vripara":null,"title":"Ārakkhadāyakattheraapadānādivaṇṇanā","lines":["Bāttiṃsatimavagge paṭhamadutiyatatiyāpadānāni suviññeyyāneva. 16."]}],"after":[{"para":3271,"vripara":null,"title":"Ārakkhadāyakattheraapadānādivaṇṇanā","lines":["Pañcamāpadānaṃ uttānameva. 26-27."]}]},"tika":null,"tika2":null}
