{"suttaId":"tha-ap194","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7241,7259],"vripara":"6"},"segments":{"tha-ap194:0.3":"Tiṇasanthārakattheraapadānaṃ","tha-ap194:1.1":"“Yadā vanavāsī [yaṃ dāyavāsiko (sī.)] isi, tiṇaṃ lāyati satthuno;","tha-ap194:1.3":"Sabbe padakkhiṇāvaṭṭā [padakkhiṇāvattā (sī. syā.)],","tha-ap194:1.4":"pathabyā [puthavyā (sī.)] nipatiṃsu te.","tha-ap194:2.1":"“Tamahaṃ tiṇamādāya,","tha-ap194:2.2":"santhariṃ dharaṇuttame;","tha-ap194:2.3":"Tīṇeva tālapattāni,","tha-ap194:2.4":"āharitvānahaṃ tadā.","tha-ap194:3.1":"“Tiṇena chadanaṃ katvā,","tha-ap194:3.2":"siddhatthassa adāsahaṃ;","tha-ap194:3.3":"Sattāhaṃ dhārayuṃ tassa [tattha (syā.)],","tha-ap194:3.4":"devamānusasatthuno.","tha-ap194:4.1":"“Catunnavutito kappe,","tha-ap194:4.2":"yaṃ tiṇaṃ adadiṃ tadā;","tha-ap194:4.3":"Duggatiṃ nābhijānāmi,","tha-ap194:4.4":"tiṇadānassidaṃ phalaṃ.","tha-ap194:5.1":"“Pañcasaṭṭhimhito kappe,","tha-ap194:5.2":"cattārosuṃ mahaddhanā;","tha-ap194:5.3":"Sattaratanasampannā,","tha-ap194:5.4":"cakkavattī mahabbalā.","tha-ap194:6.1":"“Paṭisambhidā catasso … pe …","tha-ap194:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap194:7.1":"Itthaṃ sudaṃ āyasmā tiṇasanthārako thero imā gāthāyo abhāsitthāti.","tha-ap194:8.1":"Tiṇasanthārakattherassāpadānaṃ dutiyaṃ."},"unsure":["tha-ap194:1.1"],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3171,"to":3171,"paras":[{"para":3171,"vripara":"6","refs":["tha-ap194:1"],"lines":["Dutiyattherāpadāne <b>yaṃ dāyavāsiko isī</b>ti isipabbajjaṃ pabbajitvā vane vasanabhāvena <b>dāyavāsiko isī</b>ti saṅkhaṃ gato, attano anukampāya taṃ vanaṃ upagatassa siddhatthassa satthuno vasanamaṇḍapacchādanatthāya yaṃ tiṇaṃ, taṃ <b>lāyati</b> chindatīti attho.","Dabbachadanaṃ katvā anekehi khuddakadaṇḍakehi maṇḍapaṃ katvā taṃ tiṇena chādetvā <b>siddhatthassa</b> bhagavato ahaṃ <b>adāsiṃ</b> pūjesinti attho."],"lineRefs":[["tha-ap194:1"],["tha-ap194:1"]]}],"wordLinks":[["tha-ap194:1.1","lāyati",0,0]],"before":[{"para":3162,"vripara":null,"refs":[],"lines":["Saṅghupaṭṭhākattheraapadānavaṇṇanā samattā."],"lineRefs":[[]]},{"para":3163,"vripara":null,"refs":[],"lines":["Aṭṭhārasamavaggavaṇṇanā samattā."],"lineRefs":[[]]},{"para":3164,"vripara":null,"refs":[],"lines":["Kuṭajapupphiyavaggo"],"lineRefs":[[]]},{"para":3165,"vripara":null,"refs":[],"lines":["1-10. Kuṭajapupphiyattheraapadānādivaṇṇanā"],"lineRefs":[[]]},{"para":3166,"vripara":null,"refs":[],"lines":["Ito parampi ekūnavīsatimavagge āgatānaṃ imesaṃ kuṭajapupphiyattherādīnaṃ dasannaṃ therānaṃ apubbaṃ natthi.","Tesañhi therānaṃ purimabuddhānaṃ santike katapuññasambhārānaṃ vasena pākaṭanāmāni ceva nivāsanagarādīni ca heṭṭhā vuttanayeneva veditabbānīti taṃ sabbaṃ apadānaṃ suviññeyyamevāti."],"lineRefs":[[],[]]},{"para":3167,"vripara":null,"refs":[],"lines":["Ekūnavīsatimavaggavaṇṇanā samattā."],"lineRefs":[[]]},{"para":3168,"vripara":null,"refs":[],"lines":["Tamālapupphiyavaggo"],"lineRefs":[[]]},{"para":3169,"vripara":null,"refs":[],"lines":["1-10. Tamālapupphiyattheraapadānādivaṇṇanā"],"lineRefs":[[]]},{"para":3170,"vripara":null,"refs":[],"lines":["Vīsatime vagge paṭhamattherāpadānaṃ uttānameva."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
