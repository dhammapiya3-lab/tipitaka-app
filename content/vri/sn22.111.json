{"suttaId":"sn22.111","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[736,736],"vripara":"111"},"segments":{"sn22.111:0.3":"Chandappahānasuttaṃ","sn22.111:1.1":"Sāvatthinidānaṃ.","sn22.111:1.2":"“Rūpe, bhikkhave, yo chando yo rāgo yā nandī yā taṇhā, taṃ pajahatha.","sn22.111:1.3":"Evaṃ taṃ rūpaṃ pahīnaṃ bhavissati ucchinnamūlaṃ tālāvatthukataṃ anabhāvaṃkataṃ āyatiṃ anuppādadhammaṃ.","sn22.111:1.4":"Vedanāya … pe …","sn22.111:1.5":"saññāya …","sn22.111:1.6":"saṅkhāresu …","sn22.111:1.7":"viññāṇe yo chando yo rāgo yā nandī yā taṇhā, taṃ pajahatha.","sn22.111:1.8":"Evaṃ taṃ viññāṇaṃ pahīnaṃ bhavissati ucchinnamūlaṃ tālāvatthukataṃ anabhāvaṃkataṃ āyatiṃ anuppādadhamman”ti.","sn22.111:1.9":"Navamaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":367,"to":370,"paras":[{"para":367,"vripara":"107-112","refs":["sn22.111:1"],"lines":["107-112. Pañcamādīsu catūsu cattāri saccāni kathitāni.","Navamadasamesu kilesappahānanti.","Pañcamādīni."],"lineRefs":[["sn22.111:1"],["sn22.111:1"],["sn22.111:1"]]},{"para":368,"vripara":null,"refs":["sn22.111:1"],"lines":["Antavaggo ekādasamo."],"lineRefs":[["sn22.111:1"]]},{"para":369,"vripara":null,"refs":["sn22.111:1"],"lines":["Dhammakathikavaggo"],"lineRefs":[["sn22.111:1"]]},{"para":370,"vripara":null,"refs":["sn22.111:1"],"lines":["1-2. Avijjāsuttādivaṇṇanā"],"lineRefs":[["sn22.111:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":359,"to":364,"paras":[{"para":359,"vripara":"107-112","refs":["sn22.111:1"],"lines":["107-112. <b>Cattāri saccāni kathitāni</b> assādādīnaṃ samudayādīnañca desitattā."],"lineRefs":[["sn22.111:1"]]},{"para":360,"vripara":null,"refs":["sn22.111:1"],"lines":["<b>Kilesappahānaṃ kathitaṃ</b> rāgappahānassa jotitattā."],"lineRefs":[["sn22.111:1"]]},{"para":361,"vripara":null,"refs":["sn22.111:1"],"lines":["Samaṇasuttādivaṇṇanā niṭṭhitā."],"lineRefs