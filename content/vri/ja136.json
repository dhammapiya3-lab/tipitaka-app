{"suttaId":"ja136","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[761,764],"vripara":"136"},"segments":{"ja136:0.4":"Suvaṇṇahaṃsajātakaṃ","ja136:1.1":"Yaṃ laddhaṃ tena tuṭṭhabbaṃ, atilobho hi pāpako;","ja136:1.3":"Haṃsarājaṃ gahetvāna, suvaṇṇā parihāyathāti.","ja136:2.1":"Suvaṇṇahaṃsajātakaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
