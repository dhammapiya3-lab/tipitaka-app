{"suttaId":"sn2.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1080,1090],"vripara":"99"},"segments":{"sn2.18:0.3":"Kakudhasuttaṃ","sn2.18:1.1":"Evaṃ me sutaṃ –","sn2.18:1.2":"ekaṃ samayaṃ bhagavā sākete viharati añjanavane migadāye.","sn2.18:1.3":"Atha kho kakudho devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ añjanavanaṃ obhāsetvā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. Ekamantaṃ ṭhito kho kakudho devaputto bhagavantaṃ etadavoca –","sn2.18:1.4":"“nandasi, samaṇā”ti?","sn2.18:1.5":"“Kiṃ laddhā, āvuso”ti?","sn2.18:1.6":"“Tena hi, samaṇa, socasī”ti?","sn2.18:1.7":"“Kiṃ jīyittha, āvuso”ti?","sn2.18:1.8":"“Tena hi, samaṇa, neva nandasi na ca [neva (sī. syā. kaṃ.)] socasī”ti?","sn2.18:1.9":"“Evamāvuso”ti.","sn2.18:2.1":"“Kacci tvaṃ anagho [anigho (sabbattha)] bhikkhu,","sn2.18:2.2":"kacci nandī [nandi (sī. syā. kaṃ.)] na vijjati;","sn2.18:2.3":"Kacci taṃ ekamāsīnaṃ,","sn2.18:2.4":"aratī nābhikīratī”ti.","sn2.18:3.1":"“Anagho ve ahaṃ yakkha,","sn2.18:3.2":"atho nandī na vijjati;","sn2.18:3.3":"Atho maṃ ekamāsīnaṃ,","sn2.18:3.4":"aratī nābhikīratī”ti.","sn2.18:4.1":"“Kathaṃ tvaṃ anagho bhikkhu,","sn2.18:4.2":"kathaṃ nandī na vijjati;","sn2.18:4.3":"Kathaṃ taṃ ekamāsīnaṃ,","sn2.18:4.4":"aratī nābhikīratī”ti.","sn2.18:5.1":"“Aghajātassa ve nandī,","sn2.18:5.2":"nandījātassa ve aghaṃ;","sn2.18:5.3":"Anandī anagho bhikkhu,","sn2.18:5.4":"evaṃ jānāhi āvuso”ti.","sn2.18:6.1":"“Cirassaṃ vata passāmi,","sn2.18:6.2":"brāhmaṇaṃ parinibbutaṃ;","sn2.18:6.3":"Anandiṃ anaghaṃ bhikkhuṃ,","sn2.18:6.4":"tiṇṇaṃ loke visattika” ntntti."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":549,"to":549,"paras":[{"para":549,"vripara":"99","refs":["sn2.18:1","sn2.18:2","sn2.18:5"],"lines":["Aṭṭhame <b>kakudho devaputto</b>ti ayaṃ kira kolanagare mahāmoggallānattherassa upaṭṭhākaputto daharakāleyeva therassa santike vasanto jhānaṃ nibbattetvā kālaṅkato, brahmaloke uppajji.","Tatrāpi naṃ kakudho brahmātveva sañjānanti.","<b>Nandasī</b>ti tussasi.","<b>Kiṃ laddhā</b>ti tuṭṭhi nāma kiñci manāpaṃ labhitvā hoti, tasmā evamāha.","<b>Kiṃ jīyitthā</b>ti yassa hi kiñci manāpaṃ cīvarādivatthu jiṇṇaṃ hoti, so socati, tasmā evamāha.","<b>Aratī nābhikīratī</b>ti ukkaṇṭhitā nābhibhavati.","<b>Aghajātassā</b>ti dukkhajātassa, vaṭṭadukkhe ṭhitassāti attho.","<b>Nandījātassā</b>ti jātataṇhassa.","<b>Aghan</b>ti evarūpassa hi vaṭṭadukkhaṃ āgatameva hoti.","“Dukkhī sukhaṃ patthayatī”ti hi vuttaṃ.","Iti aghajātassa nandī hoti, sukhavipariṇāmena dukkhaṃ āgatamevāti nandījātassa aghaṃ hoti.","Aṭṭhamaṃ."],"lineRefs":[["sn2.18:1"],["sn2.18:1"],["sn2.18:1"],["sn2.18:1"],["sn2.18:1"],["sn2.18:2"],["sn2.18:5"],["sn2.18:5"],["sn2.18:5"],["sn2.18:5"],["sn2.18:5"],["sn2.18:5"]]}],"wordLinks":[["sn2.18:1.3","kakudho devaputto",0,0],["sn2.18:1.4","nandasī",0,2],["sn2.18:1.8","nandasī",0,2],["sn2.18:1.5","kiṃ laddhā",0,3],["sn2.18:1.7","kiṃ jīyitthā",0,4],["sn2.18:2.3","aratī nābhikīratī",0,5],["sn2.18:5.1","aghajātassā",0,6],["sn2.18:5.1","nandījātassā",0,7],["sn2.18:5.1","aghaṃ",0,8]],"before":[{"para":548,"vripara":null,"title":"Kakudhasuttādivaṇṇanā","lines":["8-10. Kakudhasuttādivaṇṇanā"]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":700,"to":701,"paras":[{"para":700,"vripara":"99","refs":["sn2.18:1"],"lines":["“Nandāmī”ti vutte nandī nāma pabbajitassa malanti codetukāmo devaputto <b>“nandasī”</b>ti pucchi.","Athassa bhagavā taṃ paṭikkhipanto <b>“kiṃ laddhā”</b>ti?","Āha.","Tena “tayā mama adhippetanandiyā idha paccayo eva natthi, kuto sā nandī”ti dasseti.","Tenāha <b>“tuṭṭhi nāmā”</b>tiādi.","Atha devaputto nandiyā asati sokena bhavitabbaṃ, soko ca pabbajitassa malanti codento āha <b>“tena hi, samaṇa, socasī”</b>ti.","Bhagavā tampi paṭikkhipanto <b>“kiṃ jīyitthā”</b>tiādimāha.","Kiṃ maṃ jinātīti attho?"],"lineRefs":[["sn2.18:1"],["sn2.18:1"],["sn2.18:1"],["sn2.18:1"],["sn2.18:1"],["sn2.18:1"],["sn2.18:1"],["sn2.18:1"]]},{"para":701,"vripara":null,"refs":["sn2.18:1","sn2.18:2","sn2.18:4","sn2.18:5"],"lines":["Yadi te nandisokā na santi hāsavatthuno lābhassa jāniyā ca abhāvato, ekavihārino pana aratiyā bhavitabbanti āha –","<b>“kacci taṃ ekamāsīnaṃ, aratī nābhikīratī”</b>ti.","Tasmimpi bhagavatā paṭikkhitte atha nesampi nandisokāratīnaṃ abhāve kāraṇaṃ pucchanto <b>“kathaṃ tvan”</b>ti gāthamāha?","Athassa bhagavā taṃ kāraṇaṃ pavedento <b>“aghajātassā”</b>ti gāthamāha.","Tattha <b>aghajātassā</b>ti aghe jātassa.","Tenāha <b>“vaṭṭadukkhe ṭhitassā”</b>ti.","<b>Jātataṇhassa</b> appahīnataṇhassa <b>vaṭṭadukkhaṃ āgatameva</b> kāraṇassa appahīnattā.","Tasseva hi kāraṇassa appahīnataṃ dassento <b>“dukkhī sukhaṃ patthayatīti hi vuttan”</b>ti āha.","Dukkhappavattiyā sāpi taṇhāppavatti tena dassitā.","<b>Itī</b>tiādinā vuttamevatthaṃ nigamanavasena dasseti."],"lineRefs":[["sn2.18:1"],["sn2.18:2"],["sn2.18:4"],["sn2.18:5"],["sn2.18:5"],["sn2.18:5"],["sn2.18:5"],["sn2.18:5"],["sn2.18:5"],["sn2.18:5"]]}],"wordLinks":[["sn2.18:1.4","nandasī",0,0],["sn2.18:1.8","nandasī",0,0],["sn2.18:1.5","kiṃ laddhā",0,1],["sn2.18:1.6","tena hi samaṇa socasī",0,5],["sn2.18:1.7","kiṃ jīyitthā",0,6],["sn2.18:2.3","kacci taṃ ekamāsīnaṃ aratī nābhikīratī",1,1],["sn2.18:4.1","kathaṃ tvaṃ",1,2],["sn2.18:5.1","aghajātassā",1,3],["sn2.18:5.1","aghajātassā",1,4]],"before":[{"para":699,"vripara":null,"title":"Kakudhasuttavaṇṇanā","lines":["Kakudhasuttavaṇṇanā"]}],"after":[{"para":702,"vripara":null,"title":"Kakudhasuttavaṇṇanā","lines":["Kakudhasuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
