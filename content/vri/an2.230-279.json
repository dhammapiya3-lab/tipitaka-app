{"suttaId":"an2.230-279","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-ii","vriCode":"s0402m1.mul","paras":[306,307],"vripara":"191-200"},"segments":{"an2.230-279:0.2":"Akusalapeyyālaṃ","an2.230-279:1.1":"191-200. “Dveme, bhikkhave, dhammā akusalā … dveme, bhikkhave, dhammā kusalā … dveme, bhikkhave, dhammā sāvajjā … dveme, bhikkhave, dhammā anavajjā … dveme, bhikkhave, dhammā dukkhudrayā … dveme, bhikkhave, dhammā sukhudrayā … dveme, bhikkhave, dhammā dukkhavipākā … dveme, bhikkhave, dhammā sukhavipākā … dveme, bhikkhave, dhammā sabyābajjhā … dveme, bhikkhave, dhammā abyābajjhā.","an2.230-279:1.2":"Katame dve?","an2.230-279:1.3":"Akkodho ca anupanāho ca … amakkho ca apaḷāso ca … anissā ca amacchariyañca … amāyā ca asāṭheyyañca … hirī ca ottappañca.","an2.230-279:1.4":"Ime kho, bhikkhave, dve dhammā abyābajjhā”ti.","an2.230-279:1.5":"Akusalapeyyālaṃ niṭṭhitaṃ."},"unsure":[],"preface":[],"attha":{"book":"Mp-ii","bookName":"Dukanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":310,"to":310,"paras":[{"para":310,"vripara":"191-200","refs":["an2.230-279:1"],"lines":["191-200. <b>Sāvajjā</b>ti sadosā.","<b>Anavajjā</b>ti niddosā.","<b>Dukkhudrayā</b>ti dukkhavaḍḍhikā.","<b>Sukhudriyā</b>ti sukhavaḍḍhikā.","<b>Sabyābajjhā</b>ti sadukkhā.","<b>Abyābajjhā</b>ti niddukkhā.","Ettāvatā vaṭṭavivaṭṭameva kathitaṃ."],"lineRefs":[["an2.230-279:1"],["an2.230-279:1"],["an2.230-279:1"],["an2.230-279:1"],["an2.230-279:1"],["an2.230-279:1"],["an2.230-279:1"]]}],"wordLinks":[["an2.230-279:1.1","sāvajjā",0,0],["an2.230-279:1.1","anavajjā",0,1],["an2.230-279:1.1","dukkhudrayā",0,2],["an2.230-279:1.1","sabyābajjhā",0,4],["an2.230-279:1.1","abyābajjhā",0,5],["an2.230-279:1.4","abyābajjhā",0,5]],"before":[{"para":309,"vripara":null,"title":"Akusalapeyyālaṃ","lines":["Akusalapeyyālaṃ"]}],"after":[{"para":311,"vripara":null,"title":"Akusalapeyyālaṃ","lines":["Akusalapeyyālaṃ niṭṭhitaṃ."]}]},"tika":{"book":"Mp-t-ii","bookName":"Dukanipāta-ṭīkā","vriCode":"s0402t.tik","from":287,"to":288,"paras":[{"para":287,"vripara":"191-200","refs":["an2.230-279:1"],"lines":["191-200. Dukkhassa vaḍḍhi etesanti <b>dukkhavaḍḍhikā</b>.","Ye hi dukkhaṃ vaḍḍhenti, punappunaṃ uppādenti, dukkhassa vaḍḍhi tesaṃ atthīti evaṃ vuttaṃ.","<b>Sukhavaḍḍhikā</b>ti etthāpi eseva nayo."],"lineRefs":[["an2.230-279:1"],["an2.230-279:1"],["an2.230-279:1"]]},{"para":288,"vripara":null,"refs":["an2.230-279:1"],"lines":["Vinayapeyyālaṃ"],"lineRefs":[["an2.230-279:1"]]}],"wordLinks":[],"before":[{"para":286,"vripara":null,"title":"Akusalapeyyālaṃ","lines":["Akusalapeyyālaṃ"]}]},"tika2":null}
