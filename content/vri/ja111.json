{"suttaId":"ja111","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[625,628],"vripara":"111"},"segments":{"ja111:0.4":"Gadrabhapañhajātakaṃ","ja111:1.1":"Haṃci [haṃsi (sī. syā.), hañci (?)] tuvaṃ evamaññasi seyyo,","ja111:1.2":"puttena pitāti rājaseṭṭha;","ja111:1.3":"Handassatarassa te ayaṃ,","ja111:1.4":"assatarassa hi gadrabho pitāti.","ja111:2.1":"Gadrabhapañhajātakaṃ paṭhamaṃ. 112."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-vi-b","bookName":"Jātaka-aṭṭhakathā-5","vriCode":"s0513a4.att","from":5800,"to":5804,"paras":[{"para":5800,"vripara":"111","refs":["ja111:1"],"lines":["“Katthacchatī kattha mupeti ṭhānaṃ, vīthissa kā nhānagatassa hoti;"],"lineRefs":[["ja111:1"]]},{"para":5801,"vripara":null,"refs":["ja111:1"],"lines":["Kathañhi so nhāyati nāgarājā, kathaṃ vijānemu gatiṃ gajassā”ti."],"lineRefs":[["ja111:1"]]},{"para":5802,"vripara":null,"refs":["ja111:1"],"lines":["Tattha <b>katthacchatī</b>ti kattha vasati.","<b>Kattha mupetī</b>ti kattha upeti, kattha tiṭṭhatīti attho.","<b>Vīthissa kā</b>ti tassa nhānagatassa kā vīthi hoti, kataramaggena so gacchati.","<b>Kathaṃ vijānemu gati</b>nti tayā akathite mayaṃ kathaṃ tassa nāgarājassa gatiṃ vijānissāma, tasmā kathehi noti attho."],"lineRefs":[["ja111:1"],["ja111:1"],["ja111:1"],["ja111:1"]]},{"para":5803,"vripara":null,"refs":["ja111:1"],"lines":["Tato sā jātissarañāṇena paccakkhato diṭṭhaṭṭhānaṃ tassa ācikkhantī dve gāthā abhāsi – 112."],"lineRefs":[["ja111:1"]]}],"wordLinks":[]},"tika":{"book":"Ja-ṭ-i","bookName":"Jātaka-abhinavaṭīkā-1","vriCode":"","from":1295,"to":1297,"paras":[{"para":1295,"vripara":null,"refs":["ja111:1"],"lines":["1-gadrabhapaŭhajātakavaṇṇanā (111)"],"lineRefs":[["ja111:1"]]},{"para":1296,"vripara":null,"refs":["ja111:1"],"lines":["gadrabhapaŭhajātakampi umaṅgajātake yeva āvi bhavissatīti niddisituṃ -- “hasituṃ.pa.","āvi bhavissatī”ti āhāti."],"lineRefs":[["ja111:1"],["ja111:1"]]},{"para":1297,"vripara":null,"refs":["ja111:1"],"lines":[