{"suttaId":"tha-ap203","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7428,7441],"vripara":"1"},"segments":{"tha-ap203:0.3":"Kaṇikārapupphiyattheraapadānaṃ","tha-ap203:1.1":"“Kaṇikāraṃ pupphitaṃ disvā, ocinitvānahaṃ tadā;","tha-ap203:1.3":"Tissassa abhiropesiṃ, oghatiṇṇassa tādino.","tha-ap203:2.1":"“Dvenavute ito kappe, yaṃ pupphamabhiropayiṃ;","tha-ap203:2.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap203:3.1":"“Pañcattiṃse ito kappe, aruṇapāṇīti vissuto;","tha-ap203:3.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap203:4.1":"“Paṭisambhidā catasso, vimokkhāpi ca aṭṭhime;","tha-ap203:4.3":"Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanaṃ”.","tha-ap203:5.1":"Itthaṃ sudaṃ āyasmā kaṇikārapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap203:6.1":"Kaṇikārapupphiyattherassāpadānaṃ paṭhamaṃ."},"attha":null,"tika":null}
