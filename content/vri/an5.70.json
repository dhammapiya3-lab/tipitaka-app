{"suttaId":"an5.70","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[561,565],"vripara":"70"},"segments":{"an5.70:0.3":"Āsavakkhayasuttaṃ","an5.70:1.1":"“Pañcime, bhikkhave, dhammā bhāvitā bahulīkatā āsavānaṃ khayāya saṃvattanti.","an5.70:1.2":"Katame pañca?","an5.70:1.3":"Idha, bhikkhave, bhikkhu asubhānupassī kāye viharati, āhāre paṭikūlasaññī, sabbaloke anabhiratasaññī, sabbasaṅkhāresu aniccānupassī, maraṇasaññā kho panassa ajjhattaṃ sūpaṭṭhitā hoti.","an5.70:1.4":"Ime kho, bhikkhave, pañca dhammā bhāvitā bahulīkatā āsavānaṃ khayāya saṃvattantī”ti.","an5.70:1.5":"Dasamaṃ.","an5.70:1.6":"Saññāvaggo dutiyo.","an5.70:2.0":"Tassuddānaṃ –","an5.70:2.1":"Dve ca saññā dve vaḍḍhī ca,","an5.70:2.2":"sākacchena ca sājīvaṃ;","an5.70:2.3":"Iddhipādā ca dve vuttā,","an5.70:2.4":"nibbidā cāsavakkhayāti."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":162,"to":165,"paras":[{"para":162,"vripara":"67-70","refs":["an5.70:1"],"lines":["67-70. Sattame <b>ussoḷhī</b>ti adhimattavīriyaṃ.","Aṭṭhame attano bodhimaṇḍe paṭividdhe āgamanaiddhipāde kathetvā upari attanova cha abhiññā kathesīti.","Navamadasamesu vipassanā kathitā.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["an5.70:1"],["an5.70:1"],["an5.70:1"],["an5.70:1"]]},{"para":163,"vripara":null,"refs":["an5.70:1"],"lines":["Saññāvaggo dutiyo."],"lineRefs":[["an5.70:1"]]},{"para":164,"vripara":null,"refs":["an5.70:1"],"lines":["(8)3. Yodhājīvavaggo"],"lineRefs":[["an5.70:1"]]},{"para":165,"vripara":null,"refs":["an5.70:1"],"lines":["Paṭhamacetovimuttiphalasuttavaṇṇanā"],"lineRefs":[["an5.70:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":161,"to":165,"paras":[{"para":161,"vripara":"66-70","refs":["an5.70:1"],"lines":["66-70. Chaṭṭhe saha ājīvanti etthāti <b>sājīvo,</b> pañhassa pucchanaṃ vissajjanañca.","Tenāha <b>“sājīvoti pañhapucchanañceva pañhavissajjanañcā”</b>tiādi.","<b>Abhisaṅkhatan</b>ti citaṃ.","Sattamādīni uttānatthāneva."],"lineRefs":[["an5.70:1"],["an5.70:1"],["an5.70:1"],["an5.70:1"]]},{"para":162,"vripara":null,"refs":["an5.70:1"],"lines":["Sājīvasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an5.70:1"]]},{"para":163,"vripara":null,"refs":["an5.70:1"],"lines":["Saññāvaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an5.70:1"]]},{"para":164,"vripara":null,"refs":["an5.70:1"],"lines":["(8)3. Yodhājīvavaggo"],"lineRefs":[["an5.70:1"]]},{"para":165,"vripara":null,"refs":["an5.70:1"],"lines":["1-2. Paṭhamacetovimuttiphalasuttādivaṇṇanā"],"lineRefs":[["an5.70:1"]]}],"wordLinks":[]},"tika2":null}
