{"suttaId":"tha-ap105","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5197,5215],"vripara":"13"},"segments":{"tha-ap105:0.3":"Uppalahatthiyattheraapadānaṃ","tha-ap105:1.1":"“Tivarāyaṃ nivāsīhaṃ,","tha-ap105:1.2":"ahosiṃ māliko tadā;","tha-ap105:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap105:1.4":"siddhatthaṃ lokapūjitaṃ [lokanāyakaṃ (sī.)].","tha-ap105:2.1":"“Pasannacitto sumano,","tha-ap105:2.2":"pupphahatthamadāsahaṃ;","tha-ap105:2.3":"Yattha yatthupapajjāmi,","tha-ap105:2.4":"tassa kammassa vāhasā.","tha-ap105:3.1":"“Anubhomi phalaṃ iṭṭhaṃ,","tha-ap105:3.2":"pubbe sukatamattano;","tha-ap105:3.3":"Parikkhitto sumallehi,","tha-ap105:3.4":"pupphadānassidaṃ phalaṃ.","tha-ap105:4.1":"“Catunnavutito kappe,","tha-ap105:4.2":"yaṃ pupphamabhiropayiṃ;","tha-ap105:4.3":"Duggatiṃ nābhijānāmi,","tha-ap105:4.4":"pupphapūjāyidaṃ [buddhapūjāyidaṃ (sī.)] phalaṃ.","tha-ap105:5.1":"“Catunnavutupādāya,","tha-ap105:5.2":"ṭhapetvā vattamānakaṃ;","tha-ap105:5.3":"Pañcarājasatā tattha,","tha-ap105:5.4":"najjasamasanāmakā [najjupamasanāmakā (sī. syā.)].","tha-ap105:6.1":"“Paṭisambhidā catasso … pe …","tha-ap105:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap105:7.1":"Itthaṃ sudaṃ āyasmā uppalahatthiyo thero imā gāthāyo abhāsitthāti.","tha-ap105:8.1":"Uppalahatthiyattherassāpadānaṃ tatiyaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2808,"to":2809,"paras":[{"para":2808,"vripara":"13","refs":["tha-ap105:1"],"lines":["So aparabhāge attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>tivarāyaṃ nivāsīhan</b>tiādimāha.","Tattha <b>tivarā</b>ti tīhi vārehi kāritaṃ sañcaritaṃ paṭicchannaṃ nagaraṃ, tassaṃ tivarāyaṃ nivāsī, vasanasīlo nivāsanaṭṭhānagehe vā vasanto ahanti attho.","<b>Ahosiṃ māliko tadā</b>ti tadā nibbānatthāya puññasambhārakaraṇasamaye māliko mālākārova pupphāni kayavikkayaṃ katvā jīvanto ahosinti attho."],"lineRefs":[["tha-ap105:1"],["tha-ap105:1"],["tha-ap105:1"]]},{"para":2809,"vripara":"14","refs":["tha-ap105:2"],"lines":["<b>Pupphahatthamadāsahan</b>ti siddhatthaṃ bhagavantaṃ disvā uppalakalāpaṃ adāsiṃ pūjesinti attho.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["tha-ap105:2"],["tha-ap105:2"]]}],"wordLinks":[["tha-ap105:1.1","tivarāyaṃ nivāsīhaṃ",0,0],["tha-ap105:1.1","tivarā",0,1],["tha-ap105:1.1","ahosiṃ māliko tadā",0,2],["tha-ap105:2.1","pupphahatthamadāsahaṃ",1,0]]},"tika":null,"tika2":null}
