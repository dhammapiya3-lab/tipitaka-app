{"suttaId":"sn22.139","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[834,834],"vripara":"139"},"segments":{"sn22.139:0.3":"Tatiyaaniccasuttaṃ","sn22.139:1.1":"Sāvatthinidānaṃ.","sn22.139:1.2":"“Yaṃ, bhikkhave, aniccaṃ; tatra vo chandarāgo pahātabbo.","sn22.139:1.3":"Kiñca, bhikkhave, aniccaṃ?","sn22.139:1.4":"Rūpaṃ, bhikkhave, aniccaṃ, tatra vo chandarāgo pahātabbo.","sn22.139:1.5":"Vedanā aniccā …","sn22.139:1.6":"saññā …","sn22.139:1.7":"saṅkhārā …","sn22.139:1.8":"viññāṇaṃ aniccaṃ; tatra vo chandarāgo pahātabbo.","sn22.139:1.9":"Yaṃ, bhikkhave, aniccaṃ; tatra vo chandarāgo pahātabbo”ti.","sn22.139:1.10":"Catutthaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":391,"to":394,"paras":[{"para":391,"vripara":"136-149","refs":["sn22.139:1"],"lines":["136-149. Kukkuḷavaggassa paṭhame <b>kukkuḷan</b>ti santattaṃ ādittaṃ chārikarāsiṃ viya mahāpariḷāhaṃ.","Imasmiṃ sutte dukkhalakkhaṇaṃ kathitaṃ, sesesu aniccalakkhaṇādīni.","Sabbāni cetāni pāṭiyekkaṃ puggalajjhāsayena kathitānīti."],"lineRefs":[["sn22.139:1"],["sn22.139:1"],["sn22.139:1"]]},{"para":392,"vripara":null,"refs":["sn22.139:1"],"lines":["Kukkuḷavaggo cuddasamo."],"lineRefs":[["sn22.139:1"]]},{"para":393,"vripara":null,"refs":["sn22.139:1"],"lines":["Diṭṭhivaggo"],"lineRefs":[["sn22.139:1"]]},{"para":394,"vripara":null,"refs":["sn22.139:1"],"lines":["1-9. Ajjhattasuttādivaṇṇanā"],"lineRefs":[["sn22.139:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":395,"to":399,"paras":[{"para":395,"vripara":"136-149","refs":["sn22.139:1"],"lines":["136-149. Anto aggi mahanto chārikarāsi, tattha ukkuḷavikulato akkamantaṃ yāva kesaggaṃ anudahatāya kucchitaṃ kuḷanti kukkuḷaṃ, rūpavedanādi pana tatopi kañci kālaṃ anudahanato mahāpariḷāhanaṭṭhena ca kukkuḷaṃ viyāti <b>kukkuḷaṃ.</b>","<b>Aniccalakkhaṇādīnī</b>ti aniccadukkhānattalakkhaṇāni."],"lineRefs":[["sn22.139:1"],["sn22.139:1"]]},{"para":396,"vripara":null,"refs":["sn22.139:1"],"lines":["Kukkuḷasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.139:1"]]},{"para":397,"vripara":null,"refs":["sn22.139:1"],"lines":["Kukkuḷavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.139:1"]]},{"para":398,"vripara":null,"refs":["sn22.139:1"],"lines":["Diṭṭhivaggo"],"lineRefs":[["sn22.139:1"]]},{"para":399,"vripara":null,"refs":["sn22.139:1"],"lines":["1-9. Ajjhattasuttādivaṇṇanā"],"lineRefs":[["sn22.139:1"]]}],"wordLinks":[]},"tika2":null}
