{"suttaId":"an8.67","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-viii","vriCode":"s0404m1.mul","paras":[844,844],"vripara":"67"},"segments":{"an8.67:0.3":"Anariyavohārasuttaṃ","an8.67:1.1":"“Aṭṭhime, bhikkhave, anariyavohārā.","an8.67:1.2":"Katame aṭṭha?","an8.67:1.3":"Adiṭṭhe diṭṭhavāditā, asute sutavāditā, amute mutavāditā, aviññāte viññātavāditā, diṭṭhe adiṭṭhavāditā, sute asutavāditā, mute amutavāditā, viññāte aviññātavāditā.","an8.67:1.4":"Ime kho, bhikkhave, aṭṭha anariyavohārā”ti.","an8.67:1.5":"Sattamaṃ."},"attha":{"book":"Mp-viii","bookName":"Aṭṭhakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":224,"to":224,"paras":[{"para":224,"vripara":"67-68","refs":["an8.67:1"],"lines":["67-68. Sattame <b>anariyavohārā</b>ti na ariyakathā sadosakathā.","Yāhi cetanāhi te vohāre voharanti, tāsaṃ etaṃ nāmaṃ.","Aṭṭhame vuttapaṭipakkhanayena attho veditabbo."],"lineRefs":[["an8.67:1"],["an8.67:1"],["an8.67:1"]]}],"wordLinks":[["an8.67:1.1","anariyavohārā",0,0],["an8.67:1.4","anariyavohārā",0,0]]},"tika":{"book":"Mp-t-viii","bookName":"Aṭṭhakanipāta-ṭīkā","vriCode":"s0404t.tik","from":217,"to":217,"paras":[{"para":217,"vripara":"67","refs":["an8.67:1"],"lines":["Sattame anariyānaṃ lāmakānaṃ vohāro <b>anariyavohāro.</b>","<b>Diṭṭhavāditā</b>ti diṭṭhaṃ mayāti evaṃ vāditā.","Evaṃ sesesupi.","Ettha ca taṃtaṃsamuṭṭhāpakacetanāvasena attho veditabbo.","Tenāha <b>“yāhi cetanāhī”</b>tiādi."],"lineRefs":[["an8.67:1"],["an8.67:1"],["an8.67:1"],["an8.67:1"],["an8.67:1"]]}],"wordLinks":[["an8.67:1.1","anariyavohāro",0,0],["an8.67:1.4","anariyavohāro",0,0],["an8.67:1.3","diṭṭhavāditā",0,1]]}}
