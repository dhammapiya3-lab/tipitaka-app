{"suttaId":"thag2.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[778,790],"vripara":"139"},"segments":{"thag2.10:0.4":"Vasabhattheragāthā","thag2.10:1.1":"“Pubbe hanati attānaṃ,","thag2.10:1.2":"pacchā hanati so pare;","thag2.10:1.3":"Suhataṃ hanti attānaṃ,","thag2.10:1.4":"vītaṃseneva pakkhimā.","thag2.10:2.1":"“Na brāhmaṇo bahivaṇṇo,","thag2.10:2.2":"anto vaṇṇo hi brāhmaṇo;","thag2.10:2.3":"Yasmiṃ pāpāni kammāni,","thag2.10:2.4":"sa ve kaṇho sujampatī”ti.","thag2.10:2.5":"… Vasabho thero ….","thag2.10:2.6":"Vaggo paṭhamo niṭṭhito.","thag2.10:3.0":"Tassuddānaṃ –","thag2.10:3.1":"Uttaro ceva piṇḍolo,","thag2.10:3.2":"valliyo tīriyo isi;","thag2.10:3.3":"Ajino ca meḷajino,","thag2.10:3.4":"rādho surādho gotamo;","thag2.10:3.5":"Vasabhena ime honti,","thag2.10:3.6":"dasa therā mahiddhikāti."},"unsure":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":3349,"to":3349,"paras":[{"para":3349,"vripara":null,"refs":["thag2.10:2"],"lines":["Evaṃ bāhiraparimajjanamatte ṭhitā puggalā suddhā nāma na honti, abbhantarasuddhiyā eva pana suddhā hontīti dassento <b>“na brāhmaṇo”</b>ti dutiyaṃ gāthamāha.","Tassattho – iriyāpathasaṇṭhapanādibahisampattimattena brāhmaṇo na hoti.","Sampattiattho hi idha <b>vaṇṇa</b> -saddo.","Abbhantare pana sīlādisampattiyā brāhmaṇo hoti,“bāhitapāpo <b>brāhmaṇo”</b>ti katvā.","Tasmā <b>“yasmiṃ pāpāni</b> lāmakāni <b>kammāni</b> saṃvijjanti, ekaṃsena so <b>kaṇho</b> nihīnapuggalo”ti <b>sujampati,</b> devānaminda, jānāhi.","Taṃ sutvā sakko kuhakabhikkhuṃ tajjetvā “dhamme vattāhī”ti ovaditvā sakaṭṭhānameva gato."],"lineRefs":[["thag2.10:2"],["thag2.10:2"],["thag2.10:2"],["thag2.10:2"],["thag2.10:2"],["thag2.10:2"]]}],"wordLinks":[["thag2.10:2.1","na brāhmaṇo",0,0],["thag2.10:2.1","vaṇṇa",0,2],["thag2.10:2.1","brāhmaṇo",0,3],["thag2.10:2.3","kammāni",0,4],["thag2.10:2.3","kaṇho",0,4],["thag2.10:2.3","sujampati",0,4],["thag2.10:2.3","yasmiṃ pāpāni",0,4]],"before":[{"para":3271,"vripara":null,"refs":[],"lines":["Gotamattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3272,"vripara":null,"refs":[],"lines":["Vasabhattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":3273,"vripara":null,"refs":[],"lines":["<b>Pubbe hanati attānan</b>ti āyasmato vasabhattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto buddhasuññe loke brāhmaṇakule nibbattitvā vayappatto brāhmaṇānaṃ vijjāsippesu nipphattiṃ gantvā nekkhammajjhāsayatāya gharāvāsaṃ pahāya tāpasapabbajjaṃ pabbajitvā cuddasasahassatāpasaparivāro himavantassa avidūre samagge nāma pabbate assamaṃ kāretvā vasanto jhānābhiññāyo nibbattetvā tāpasānaṃ ovādānusāsaniyo dento ekadivasaṃ evaṃ cintesi –","“ahaṃ kho dāni imehi tāpasehi sakkato garukato pūjito viharāmi, mayā pana pūjetabbo na upalabbhati, dukkho kho panāyaṃ loke yadidaṃ agaruvāso”ti.","Evaṃ pana cintetvā purimabuddhesu katādhikāratāya purimabuddhānaṃ cetiye attanā kataṃ pūjāsakkāraṃ anussaritvā “yaṃnūnāhaṃ purimabuddhe uddissa pulinacetiyaṃ katvā pūjaṃ kareyyan”ti haṭṭhatuṭṭho iddhiyā pulinathūpaṃ suvaṇṇamayaṃ māpetvā suvaṇṇamayādīhi tisahassamattehi pupphehi devasikaṃ pūjaṃ karonto yāvatāyukaṃ puññāni katvā aparihīnajjhāno kālaṃ katvā brahmaloke nibbatto.","Tatthapi yāvatāyukaṃ ṭhatvā tato cuto tāvatiṃse nibbattitvā aparāparaṃ devamanussesu saṃsaranto imasmiṃ buddhuppāde vesāliyaṃ licchavirājakule nibbattitvā <b>vasabho</b>ti laddhanāmo vayappatto bhagavato vesāligamane buddhānubhāvaṃ disvā paṭiladdhasaddho pabbajitvā vipassanaṃ paṭṭhapetvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.50.57-92)–"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":3274,"vripara":null,"refs":[],"lines":["“Himavantassāvidūre, samaggo nāma pabbato;"],"lineRefs":[[]]},{"para":3275,"vripara":null,"refs":[],"lines":["Assamo sukato mayhaṃ, paṇṇasālā sumāpitā."],"lineRefs":[[]]},{"para":3276,"vripara":null,"refs":[],"lines":["“Nārado nāma nāmena, jaṭilo uggatāpano;"],"lineRefs":[[]]},{"para":3277,"vripara":null,"refs":[],"lines":["Catuddasasahassāni, sissā paricaranti maṃ."],"lineRefs":[[]]},{"para":3278,"vripara":null,"refs":[],"lines":["“Paṭisallīnako santo, evaṃ cintesahaṃ tadā;"],"lineRefs":[[]]},{"para":3279,"vripara":null,"refs":[],"lines":["Sabbo jano maṃ pūjeti, nāhaṃ pūjemi kiñcanaṃ."],"lineRefs":[[]]},{"para":3280,"vripara":null,"refs":[],"lines":["“Na me ovādako atthi, vattā koci na vijjati;"],"lineRefs":[[]]},{"para":3281,"vripara":null,"refs":[],"lines":["Anācariyupajjhāyo, vane vāsaṃ upemahaṃ."],"lineRefs":[[]]},{"para":3282,"vripara":null,"refs":[],"lines":["“Upāsamāno yamahaṃ, garucittaṃ upaṭṭhahe;"],"lineRefs":[[]]},{"para":3283,"vripara":null,"refs":[],"lines":["So me ācariyo natthi, vanavāso niratthako."],"lineRefs":[[]]},{"para":3284,"vripara":null,"refs":[],"lines":["“Āyāgaṃ me gavesissaṃ, garuṃ bhāvaniyaṃ tathā;"],"lineRefs":[[]]},{"para":3285,"vripara":null,"refs":[],"lines":["Sāvassayo vasissāmi, na koci garahissati."],"lineRefs":[[]]},{"para":3286,"vripara":null,"refs":[],"lines":["“Uttānakūlā nadikā, supatitthā manoramā;"],"lineRefs":[[]]},{"para":3287,"vripara":null,"refs":[],"lines":["Saṃsuddhapulinākiṇṇā, avidūre mamassamaṃ."],"lineRefs":[[]]},{"para":3288,"vripara":null,"refs":[],"lines":["“Nadiṃ amarikaṃ nāma, upagantvānahaṃ tadā;"],"lineRefs":[[]]},{"para":3289,"vripara":null,"refs":[],"lines":["Saṃvaḍḍhayitvā pulinaṃ, akaṃ pulinacetiyaṃ."],"lineRefs":[[]]},{"para":3290,"vripara":null,"refs":[],"lines":["“Ye te ahesuṃ sambuddhā, bhavantakaraṇā munī;"],"lineRefs":[[]]},{"para":3291,"vripara":null,"refs":[],"lines":["Tesaṃ etādiso thūpo, taṃ nimittaṃ karomahaṃ."],"lineRefs":[[]]},{"para":3292,"vripara":null,"refs":[],"lines":["“Karitvā pulinaṃ thūpaṃ, sovaṇṇaṃ māpayiṃ ahaṃ;"],"lineRefs":[[]]},{"para":3293,"vripara":null,"refs":[],"lines":["Soṇṇakiṅkaṇipupphāni, sahasse tīṇi pūjayiṃ."],"lineRefs":[[]]},{"para":3294,"vripara":null,"refs":[],"lines":["“Sāyapātaṃ namassāmi, vedajāto katañjalī;"],"lineRefs":[[]]},{"para":3295,"vripara":null,"refs":[],"lines":["Sammukhā viya sambuddhaṃ, vandiṃ pulinacetiyaṃ."],"lineRefs":[[]]},{"para":3296,"vripara":null,"refs":[],"lines":["“Yadā kilesā jāyanti, vitakkā gehanissitā;"],"lineRefs":[[]]},{"para":3297,"vripara":null,"refs":[],"lines":["Sarāmi sukataṃ thūpaṃ, paccavekkhāmi tāvade."],"lineRefs":[[]]},{"para":3298,"vripara":null,"refs":[],"lines":["“Upanissāya viharaṃ, satthavāhaṃ vināyakaṃ;"],"lineRefs":[[]]},{"para":3299,"vripara":null,"refs":[],"lines":["Kilese saṃvaseyyāsi, na yuttaṃ tava mārisa."],"lineRefs":[[]]},{"para":3300,"vripara":null,"refs":[],"lines":["“Saha āvajjite thūpe, gāravaṃ hoti me tadā;"],"lineRefs":[[]]},{"para":3301,"vripara":null,"refs":[],"lines":["Kuvitakke vinodesiṃ, nāgo tuttaṭṭito yathā."],"lineRefs":[[]]},{"para":3302,"vripara":null,"refs":[],"lines":["“Evaṃ viharamānaṃ maṃ, maccurājābhimaddatha;"],"lineRefs":[[]]},{"para":3303,"vripara":null,"refs":[],"lines":["Tattha kālaṅkato santo, brahmalokamagacchahaṃ."],"lineRefs":[[]]},{"para":3304,"vripara":null,"refs":[],"lines":["“Yāvatāyuṃ vasitvāna, tidive upapajjahaṃ;"],"lineRefs":[[]]},{"para":3305,"vripara":null,"refs":[],"lines":["Asītikkhattuṃ devindo, devarajjamakārayiṃ."],"lineRefs":[[]]},{"para":3306,"vripara":null,"refs":[],"lines":["“Satānaṃ tīṇikkhattuñca, cakkavattī ahosahaṃ;"],"lineRefs":[[]]},{"para":3307,"vripara":null,"refs":[],"lines":["Padesarajjaṃ vipulaṃ, gaṇanāto asaṅkhiyaṃ."],"lineRefs":[[]]},{"para":3308,"vripara":null,"refs":[],"lines":["“Soṇṇakiṅkaṇipupphānaṃ, vipākaṃ anubhomahaṃ;"],"lineRefs":[[]]},{"para":3309,"vripara":null,"refs":[],"lines":["Dhātīsatasahassāni, parivārenti maṃ bhave."],"lineRefs":[[]]},{"para":3310,"vripara":null,"refs":[],"lines":["“Thūpassa pariciṇṇattā, rajojallaṃ na limpati;"],"lineRefs":[[]]},{"para":3311,"vripara":null,"refs":[],"lines":["Gatte sedā na muccanti, suppabhāso bhavāmahaṃ."],"lineRefs":[[]]},{"para":3312,"vripara":null,"refs":[],"lines":["“Aho me sukato thūpo, sudiṭṭhāmarikā nadī;"],"lineRefs":[[]]},{"para":3313,"vripara":null,"refs":[],"lines":["Thūpaṃ katvāna pulinaṃ, pattomhi acalaṃ padaṃ."],"lineRefs":[[]]},{"para":3314,"vripara":null,"refs":[],"lines":["“Kusalaṃ kattukāmena, jantunā sāragāhinā;"],"lineRefs":[[]]},{"para":3315,"vripara":null,"refs":[],"lines":["Natthi khettaṃ akhettaṃ vā, paṭipattīva sādhakā."],"lineRefs":[[]]},{"para":3316,"vripara":null,"refs":[],"lines":["“Yathāpi balavā poso, aṇṇavaṃtaritussahe;"],"lineRefs":[[]]},{"para":3317,"vripara":null,"refs":[],"lines":["Parittaṃ kaṭṭhamādāya, pakkhandeyya mahāsaraṃ."],"lineRefs":[[]]},{"para":3318,"vripara":null,"refs":[],"lines":["“Imāhaṃ kaṭṭhaṃ nissāya, tarissāmi mahodadhiṃ;"],"lineRefs":[[]]},{"para":3319,"vripara":null,"refs":[],"lines":["Ussāhena vīriyena, tareyya udadhiṃ naro."],"lineRefs":[[]]},{"para":3320,"vripara":null,"refs":[],"lines":["“Tatheva me kataṃ kammaṃ, parittaṃ thokakañca yaṃ;"],"lineRefs":[[]]},{"para":3321,"vripara":null,"refs":[],"lines":["Taṃ kammaṃ upanissāya, saṃsāraṃ samatikkamiṃ."],"lineRefs":[[]]},{"para":3322,"vripara":null,"refs":[],"lines":["“Pacchime bhave sampatte, sukkamūlena codito;"],"lineRefs":[[]]},{"para":3323,"vripara":null,"refs":[],"lines":["Sāvatthiyaṃ pure jāto, mahāsāle suaḍḍhake."],"lineRefs":[[]]},{"para":3324,"vripara":null,"refs":[],"lines":["“Saddhā mātā pitā mayhaṃ, buddhassa saraṇaṃ gatā;"],"lineRefs":[[]]},{"para":3325,"vripara":null,"refs":[],"lines":["Ubho diṭṭhapadā ete, anuvattanti sāsanaṃ."],"lineRefs":[[]]},{"para":3326,"vripara":null,"refs":[],"lines":["“Bodhipapaṭikaṃ gayha, soṇṇathūpamakārayuṃ;"],"lineRefs":[[]]},{"para":3327,"vripara":null,"refs":[],"lines":["Sāyapātaṃ namassanti, sakyaputtassa sammukhā."],"lineRefs":[[]]},{"para":3328,"vripara":null,"refs":[],"lines":["“Uposathamhi divase, soṇṇathūpaṃ vinīharuṃ;"],"lineRefs":[[]]},{"para":3329,"vripara":null,"refs":[],"lines":["Buddhassa vaṇṇaṃ kittentā, tiyāmaṃ vītināmayuṃ."],"lineRefs":[[]]},{"para":3330,"vripara":null,"refs":[],"lines":["“Saha disvānahaṃ thūpaṃ, sariṃ pulinacetiyaṃ;"],"lineRefs":[[]]},{"para":3331,"vripara":null,"refs":[],"lines":["Ekāsane nisīditvā, arahattamapāpuṇiṃ."],"lineRefs":[[]]},{"para":3332,"vripara":null,"refs":[],"lines":["“Gavesamāno taṃ vīraṃ, dhammasenāpatiddasaṃ;"],"lineRefs":[[]]},{"para":3333,"vripara":null,"refs":[],"lines":["Agārā nikkhamitvāna, pabbajiṃ tassa santike."],"lineRefs":[[]]},{"para":3334,"vripara":null,"refs":[],"lines":["“Jātiyā sattavassena, arahattamapāpuṇiṃ;"],"lineRefs":[[]]},{"para":3335,"vripara":null,"refs":[],"lines":["Upasampādayī buddho, guṇamaññāya cakkhumā."],"lineRefs":[[]]},{"para":3336,"vripara":null,"refs":[],"lines":["“Dārakeneva santena, kiriyaṃ niṭṭhitaṃ mayā;"],"lineRefs":[[]]},{"para":3337,"vripara":null,"refs":[],"lines":["Kataṃ me karaṇīyajja, sakyaputtassa sāsane."],"lineRefs":[[]]},{"para":3338,"vripara":null,"refs":[],"lines":["“Sabbaverabhayātīto, sabbasaṅgātigo isi;"],"lineRefs":[[]]},{"para":3339,"vripara":null,"refs":[],"lines":["Sāvako te mahāvīra, soṇṇathūpassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":3340,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":3341,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā dāyakānuggahaṃ karonto tehi upanīte paccaye na paṭikkhipati, yathāladdheyeva paribhuñjati.","Taṃ puthujjanā “ayaṃ kāyadaḷhibahulo arakkhitacitto”ti maññamānā avamaññanti.","Thero taṃ agaṇentova viharati.","Tassa pana avidūre aññataro kuhakabhikkhu pāpiccho samāno appiccho viya santuṭṭho viya attānaṃ dassento lokaṃ vañcento viharati.","Mahājano taṃ arahantaṃ viya sambhāveti.","Athassa sakko devānamindo taṃ pavattiṃ ñatvā theraṃ upasaṅkamitvā,“bhante, kiṃ nāma kuhako karotī”ti pucchi.","Thero pāpicchaṃ garahanto –"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":3343,"vripara":"139","refs":[],"lines":["“Pubbe hanati attānaṃ, pacchā hanati so pare;"],"lineRefs":[[]]},{"para":3344,"vripara":null,"refs":[],"lines":["Suhataṃ hanti attānaṃ, vītaṃseneva pakkhimā."],"lineRefs":[[]]},{"para":3346,"vripara":"140","refs":[],"lines":["“Na brāhmaṇo bahivaṇṇo, antovaṇṇo hi brāhmaṇo;"],"lineRefs":[[]]},{"para":3347,"vripara":null,"refs":[],"lines":["Yasmiṃ pāpāni kammāni, sa ve kaṇho sujampatī”ti.","– gāthādvayamāha;"],"lineRefs":[[],[]]},{"para":3348,"vripara":null,"refs":[],"lines":["Tattha <b>pubbe hanati attānan</b>ti kuhakapuggalo attano kuhakavuttiyā lokaṃ vañcento pāpicchatādīhi pāpadhammehi paṭhamameva attānaṃ hanati, attano kusalakoṭṭhāsaṃ vināseti.","<b>Pacchā hanati so pare</b>ti so kuhako paṭhamaṃ tāva vuttanayena attānaṃ hantvā pacchā pare yehi “ayaṃ bhikkhu pesalo ariyo”ti vā sambhāventehi kārā katā, te hanati tesaṃ kārāni attani katāni amahapphalāni katvā paccayavināsanena vināseti.","Satipi kuhakassa ubhayahanane attahanane pana ayaṃ visesoti dassento āha <b>suhataṃ hanti attānan</b>ti.","So kuhako attānaṃ hananto suhataṃ katvā hanti vināseti, yathā kiṃ?","<b>Vītaṃseneva pakkhimā</b>ti, <b>vītaṃso</b>ti dīpakasakuṇo, tena.","<b>Pakkhimā</b>ti sākuṇiko.","Yathā tena vītaṃsasakuṇena aññe sakuṇe vañcetvā hananto attānaṃ idha lokepi hanati viññugarahasāvajjasabhāvādinā, samparāyaṃ pana duggatiparikkilesena hanatiyeva, na pana te sakuṇe pacchā hantuṃ sakkoti, evaṃ kuhakopi kohaññena lokaṃ vañcetvā idha lokepi attānaṃ hanati vippaṭisāraviññugarahādīhi, paralokepi duggatiparikkilesehi, na pana te paccayadāyake apāyadukkhaṃ pāpeti.","Apica kuhako dakkhiṇāya amahapphalabhāvakaraṇeneva dāyakaṃ hanatīti vutto, na nipphalabhāvakaraṇena.","Vuttañhetaṃ bhagavatā –","“dussīlassa manussabhūtassa dānaṃ datvā sahassaguṇā dakkhiṇā pāṭikaṅkhitabbā”ti (ma. ni.3.379).","Tenāha <b>“suhataṃ hanti attānan”</b>ti."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[]]}]},"tika":null,"tika2":null}
