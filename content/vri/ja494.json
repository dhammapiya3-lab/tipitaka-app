{"suttaId":"ja494","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[7822,7888],"vripara":"202"},"segments":{"ja494:0.4":"Sādhinajātakaṃ (11)","ja494:1.1":"Abbhuto vata lokasmiṃ,","ja494:1.2":"uppajji lomahaṃsano;","ja494:1.3":"Dibbo ratho pāturahu,","ja494:1.4":"vedehassa yasassino. 203.","ja494:2.1":"Devaputto mahiddhiko,","ja494:2.2":"mātali [mātalī (sī.)] devasārathi;","ja494:2.3":"Nimantayittha rājānaṃ,","ja494:2.4":"vedehaṃ mithilaggahaṃ. 204.","ja494:3.1":"Ehimaṃ rathamāruyha,","ja494:3.2":"rājaseṭṭha disampati;","ja494:3.3":"Devā dassanakāmā te,","ja494:3.4":"tāvatiṃsā saindakā;","ja494:3.5":"Saramānā hi te devā,","ja494:3.6":"sudhammāyaṃ samacchare. 205.","ja494:4.1":"Tato ca rājā sādhino [sādhīno (sī. pī.)],","ja494:4.2":"vedeho mithilaggaho [pamukho rathamāruhi (sī. pī.)];","ja494:4.3":"Sahassayuttamāruyha [yuttaṃ abhiruyha (sī.)],","ja494:4.4":"agā devāna santike;","ja494:4.5":"Taṃ devā paṭinandiṃsu,","ja494:4.6":"disvā rājānamāgataṃ. 206.","ja494:5.1":"Svāgataṃ te mahārāja,","ja494:5.2":"atho te adurāgataṃ;","ja494:5.3":"Nisīda dāni rājīsi [rājisi (sī. syā. pī.)],","ja494:5.4":"devarājassa santike. 207.","ja494:6.1":"Sakkopi paṭinandittha,","ja494:6.2":"vedehaṃ mithilaggahaṃ;","ja494:6.3":"Nimantayittha [nimantayī ca (sī. pī.)] kāmehi,","ja494:6.4":"āsanena ca vāsavo. 208.","ja494:7.1":"Sādhu khosi anuppatto,","ja494:7.2":"āvāsaṃ vasavattinaṃ;","ja494:7.3":"Vasa devesu rājīsi,","ja494:7.4":"sabbakāmasamiddhisu;","ja494:7.5":"Tāvatiṃsesu devesu,","ja494:7.6":"bhuñja kāme amānuse. 209.","ja494:8.1":"Ahaṃ pure saggagato ramāmi,","ja494:8.2":"naccehi gītehi ca vāditehi;","ja494:8.3":"So dāni ajja na ramāmi sagge,","ja494:8.4":"āyuṃ nu khīṇo [khīṇaṃ (syā.)] maraṇaṃ nu santike;","ja494:8.5":"Udāhu mūḷhosmi janindaseṭṭha. 210.","ja494:9.1":"Na tāyu [na cāyu (sī. pī. ka.)] khīṇaṃ maraṇañca [maraṇaṃ te (sī. pī.)] dūre,","ja494:9.2":"na cāpi mūḷho naravīraseṭṭha;","ja494:9.3":"Tuyhañca [tavañca (sī. pī.), tava ca (ka.)] puññāni parittakāni,","ja494:9.4":"yesaṃ vipākaṃ idha vedayittho [vedayato (pī. ka.)]. 211.","ja494:10.1":"Vasa devānubhāvena,","ja494:10.2":"rājaseṭṭha disampati;","ja494:10.3":"Tāvatiṃsesu devesu,","ja494:10.4":"bhuñja kāme amānuse. 212.","ja494:11.1":"Yathā yācitakaṃ yānaṃ,","ja494:11.2":"yathā yācitakaṃ dhanaṃ;","ja494:11.3":"Evaṃ sampadamevetaṃ,","ja494:11.4":"yaṃ parato dānapaccayā. 213.","ja494:12.1":"Na cāhametamicchāmi,","ja494:12.2":"yaṃ parato dānapaccayā;","ja494:12.3":"Sayaṃkatāni puññāni,","ja494:12.4":"taṃ me āveṇikaṃ [āveṇiyaṃ (sī. syā. pī.), āvenikaṃ (ka.)] dhanaṃ. 214.","ja494:13.1":"Sohaṃ gantvā manussesu,","ja494:13.2":"kāhāmi kusalaṃ bahuṃ;","ja494:13.3":"Dānena samacariyāya,","ja494:13.4":"saṃyamena damena ca;","ja494:13.5":"Yaṃ katvā sukhito hoti,","ja494:13.6":"na ca pacchānutappati. 215.","ja494:14.1":"Imāni tāni khettāni,","ja494:14.2":"imaṃ nikkhaṃ sukuṇḍalaṃ;","ja494:14.3":"Imā tā haritānūpā,","ja494:14.4":"imā najjo savantiyo. 216.","ja494:15.1":"Imā tā pokkharaṇī rammā,","ja494:15.2":"cakkavākapakūjitā [cakkavākūpakūjitā (sī. pī.)];","ja494:15.3":"Mandālakehi sañchannā,","ja494:15.4":"padumuppalakehi ca;","ja494:15.5":"Yassimāni mamāyiṃsu,","ja494:15.6":"kiṃ nu te disataṃ gatā. 217.","ja494:16.1":"Tānīdha khettāni so bhūmibhāgo,","ja494:16.2":"teyeva ārāmavanupacārā [te ārāmā te vana’me pacārā (sī. pī.), te yeva ārāmavanāni sañcarā (ka.)];","ja494:16.3":"Tameva mayhaṃ janataṃ apassato,","ja494:16.4":"suññaṃva me nārada khāyate disā. 218.","ja494:17.1":"Diṭṭhā mayā vimānāni,","ja494:17.2":"obhāsentā catuddisā;","ja494:17.3":"Sammukhā devarājassa,","ja494:17.4":"tidasānañca sammukhā. 219.","ja494:18.1":"Vutthaṃ me bhavanaṃ dibyaṃ [dibbaṃ (sī. pī.)],","ja494:18.2":"bhuttā kāmā amānusā;","ja494:18.3":"Tāvatiṃsesu devesu,","ja494:18.4":"sabbakāmasamiddhisu. 220.","ja494:19.1":"Sohaṃ etādisaṃ hitvā,","ja494:19.2":"puññāyamhi idhāgato;","ja494:19.3":"Dhammameva carissāmi,","ja494:19.4":"nāhaṃ rajjena atthiko. 221.","ja494:20.1":"Adaṇḍāvacaraṃ maggaṃ,","ja494:20.2":"sammāsambuddhadesitaṃ;","ja494:20.3":"Taṃ maggaṃ paṭipajjissaṃ,","ja494:20.4":"yena gacchanti subbatāti.","ja494:21.1":"Sādhinajātakaṃ [sādhinarājajātakaṃ (syā.)] ekādasamaṃ. 495."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iv","bookName":"Jātaka-aṭṭhakathā-4","vriCode":"s0513a4.att","from":3491,"to":3537,"paras":[{"para":3491,"vripara":null,"refs":["ja494:8"],"lines":["Tattha <b>āyuṃ nu khīṇo</b>ti kiṃ nu mama sarasena jīvitindriyaṃ khīṇaṃ, udāhu upacchedakakammavasena maraṇaṃ santike jātanti pucchati.","<b>Janindaseṭṭhā</b>ti janindānaṃ devānaṃ seṭṭha."],"lineRefs":[["ja494:8"],["ja494:8"]]},{"para":3492,"vripara":null,"refs":["ja494:8"],"lines":["Atha naṃ sakko āha – 210."],"lineRefs":[["ja494:8"]]},{"para":3494,"vripara":"210","refs":["ja494:8"],"lines":["“Na tāyu khīṇaṃ maraṇañca dūre, na cāpi mūḷho naravīraseṭṭha;"],"lineRefs":[["ja494:8"]]},{"para":3495,"vripara":null,"refs":["ja494:8"],"lines":["Tuyhañca puññāni parittakāni, yesaṃ vipākaṃ idha vedayittho. 211."],"lineRefs":[["ja494:8"]]},{"para":3497,"vripara":"211","refs":["ja494:8"],"lines":["“Vasa devānubhāvena, rājaseṭṭha disampati;"],"lineRefs":[["ja494:8"]]},{"para":3498,"vripara":null,"refs":["ja494:8"],"lines":["Tāvatiṃsesu devesu, bhuñja kāme amānuse”ti."],"lineRefs":[["ja494:8"]]},{"para":3499,"vripara":null,"refs":["ja494:8","ja494:10"],"lines":["Tattha <b>“parittakānī”</b>ti idaṃ tena attabhāvena devaloke vipākadāyakāni puññāni sandhāya vuttaṃ, itarāni panassa puññāni pathaviyaṃ paṃsu viya appamāṇāni.","<b>Vasa devānubhāvenā</b>ti ahaṃ te attano puññāni majjhe bhinditvā dassāmi, mamānubhāvena vasāti taṃ samassāsento āha."],"lineRefs":[["ja494:8"],["ja494:10"]]},{"para":3500,"vripara":null,"refs":["ja494:10"],"lines":["Atha naṃ paṭikkhipanto mahāsatto āha – 212."],"lineRefs":[["ja494:10"]]},{"para":3502,"vripara":"212","refs":["ja494:10"],"lines":["“Yathā yācitakaṃ yānaṃ, yathā yācitakaṃ dhanaṃ;"],"lineRefs":[["ja494:10"]]},{"para":3503,"vripara":null,"refs":["ja494:10"],"lines":["Evaṃsampadamevetaṃ, yaṃ parato dānapaccayā. 213."],"lineRefs":[["ja494:10"]]},{"para":3505,"vripara":"213","refs":["ja494:10"],"lines":["“Na cāhametamicchāmi, yaṃ parato dānapaccayā;"],"lineRefs":[["ja494:10"]]},{"para":3506,"vripara":null,"refs":["ja494:10"],"lines":["Sayaṃkatāni puññāni, taṃ me āveṇikaṃ dhanaṃ. 214."],"lineRefs":[["ja494:10"]]},{"para":3508,"vripara":"214","refs":["ja494:10"],"lines":["“Sohaṃ gantvā manussesu, kāhāmi kusalaṃ bahuṃ;"],"lineRefs":[["ja494:10"]]},{"para":3509,"vripara":null,"refs":["ja494:10"],"lines":["Dānena samacariyāya, saṃyamena damena ca;"],"lineRefs":[["ja494:10"]]},{"para":3510,"vripara":null,"refs":["ja494:10"],"lines":["Yaṃ katvā sukhito hoti, na ca pacchānutappatī”ti."],"lineRefs":[["ja494:10"]]},{"para":3511,"vripara":null,"refs":["ja494:10","ja494:13"],"lines":["Tattha <b>yaṃ parato dānapaccayā</b>ti yaṃ parena dinnattā labbhati, taṃ yācitakasadisameva hoti.","Yācitakañhi tuṭṭhakāle denti, atuṭṭhakāle acchinditvā gaṇhantīti vadati.","<b>Samacariyāyā</b>ti kāyādīhi pāpassa akaraṇena.","<b>Saṃyamenā</b>ti sīlasaṃyamena.","<b>Damenā</b>ti indriyadamanena.","<b>Yaṃ katvā</b>ti yaṃ karitvā sukhito ceva hoti na ca pacchānutappati, tathārūpameva kammaṃ karissāmīti."],"lineRefs":[["ja494:10"],["ja494:10"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"]]},{"para":3512,"vripara":null,"refs":["ja494:13"],"lines":["Athassa vacanaṃ sutvā sakko mātaliṃ āṇāpesi “gaccha, tāta, sādhinarājānaṃ mithilaṃ netvā uyyāne otārehī”ti.","So tathā akāsi.","Rājā uyyāne caṅkamati.","Atha naṃ uyyānapālo disvā pucchitvā gantvā nāradarañño ārocesi.","So rañño āgatabhāvaṃ sutvā “tvaṃ purato gantvā uyyānaṃ sajjetvā tassa ca mayhañca dve āsanāni paññāpehī”ti uyyānapālaṃ uyyojesi.","So tathā akāsi.","Atha naṃ rājā pucchi “kassa dve āsanāni paññāpesī”ti?","“Ekaṃ tumhākaṃ, ekaṃ amhākaṃ rañño”ti.","Atha naṃ rājā “ko añño satto mama santike āsane nisīdissatī”ti vatvā ekasmiṃ nisīditvā ekasmiṃ pāde ṭhapesi.","Nāradarājā āgantvā tassa pāde vanditvā ekamantaṃ nisīdi.","So kirassa sattamo panattā.","Tadā kira vassasatāyukakālova hoti.","Mahāsatto pana attano puññabalena ettakaṃ kālaṃ vītināmesi.","So nāradaṃ hatthe gahetvā uyyāne vicaranto tisso gāthā abhāsi – 215."],"lineRefs":[["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"],["ja494:13"]]},{"para":3514,"vripara":"215","refs":["ja494:13"],"lines":["“Imāni tāni khettāni, imaṃ nikkhaṃ sukuṇḍalaṃ;"],"lineRefs":[["ja494:13"]]},{"para":3515,"vripara":null,"refs":["ja494:13"],"lines":["Imā tā haritānūpā, imā najjo savantiyo. 216."],"lineRefs":[["ja494:13"]]},{"para":3517,"vripara":"216","refs":["ja494:13"],"lines":["“Imā tā pokkharaṇī rammā, cakkavākapakūjitā;"],"lineRefs":[["ja494:13"]]},{"para":3518,"vripara":null,"refs":["ja494:13"],"lines":["Mandālakehi sañchannā, padumuppalakehi ca;"],"lineRefs":[["ja494:13"]]},{"para":3519,"vripara":null,"refs":["ja494:13"],"lines":["Yassimāni mamāyiṃsu, kiṃ nu te disataṃ gatā. 217."],"lineRefs":[["ja494:13"]]},{"para":3521,"vripara":"217","refs":["ja494:13"],"lines":["“Tānīdha khettāni so bhūmibhāgo, teyeva ārāmavanūpacārā;"],"lineRefs":[["ja494:13"]]},{"para":3522,"vripara":null,"refs":["ja494:13"],"lines":["Tameva mayhaṃ janataṃ apassato, suññaṃva me nārada khāyate disā”ti."],"lineRefs":[["ja494:13"]]},{"para":3523,"vripara":null,"refs":["ja494:16"],"lines":["Tattha <b>khettānī</b>ti bhūmibhāge sandhāyāha.","<b>Imaṃ nikkha</b>nti imaṃ tādisameva udakaniddhamanaṃ.","<b>Sukuṇḍala</b>nti sobhanena musalapavesanakuṇḍalena samannāgataṃ.","<b>Haritānūpā</b>ti udakaniddhamanassa ubhosu passesu haritatiṇasañchannā anūpabhūmiyo.","<b>Yassimāni mamāyiṃsū</b>ti tāta nārada, ye mama upaṭṭhākā ca orodhā ca imasmiṃ uyyāne mahantena yasena mayā saddhiṃ vicarantā imāni ṭhānāni mamāyiṃsu piyāyiṃsu, kataraṃ nu te disataṃ gatā, kattha te pesitā.","<b>Tānīdha khettānī</b>ti imasmiṃ uyyāne tāneva etāni uparopanakaviruhanaṭṭhānāni.","<b>Teyeva ārāmavanūpacārā</b>ti ime teyeva ārāmavanūpacārā, vihārabhūmiyoti attho."],"lineRefs":[["ja494:16"],["ja494:16"],["ja494:16"],["ja494:16"],["ja494:16"],["ja494:16"],["ja494:16"]]},{"para":3524,"vripara":null,"refs":["ja494:16"],"lines":["Atha naṃ nārado āha –","“deva, tumhākaṃ devalokagatānaṃ idāni satta vassasatāni, ahaṃ vo sattamo panattā, tumhākaṃ upaṭṭhākā ca orodhā ca maraṇamukhaṃ pattā, idaṃ vo attano santakaṃ rajjaṃ, anubhavatha na”nti.","Rājā “tāta nārada, nāhaṃ idhāgacchanto rajjatthāya āgato, puññakaraṇatthāyamhi āgato, ahaṃ puññameva karissāmī”ti vatvā gāthā āha – 218."],"lineRefs":[["ja494:16"],["ja494:16"],["ja494:16"]]},{"para":3526,"vripara":"218","refs":["ja494:16"],"lines":["“Diṭṭhā mayā vimānāni, obhāsentā catuddisā;"],"lineRefs":[["ja494:16"]]},{"para":3527,"vripara":null,"refs":["ja494:16"],"lines":["Sammukhā devarājassa, tidasānañca sammukhā. 219."],"lineRefs":[["ja494:16"]]},{"para":3529,"vripara":"219","refs":["ja494:16"],"lines":["“Vutthaṃ me bhavanaṃ dibyaṃ, bhuttā kāmā amānusā;"],"lineRefs":[["ja494:16"]]},{"para":3530,"vripara":null,"refs":["ja494:16"],"lines":["Tāvatiṃsesu devesu, sabbakāmasamiddhisu. 220."],"lineRefs":[["ja494:16"]]},{"para":3532,"vripara":"220","refs":["ja494:16"],"lines":["“Sohaṃ etādisaṃ hitvā, puññāyamhi idhāgato;"],"lineRefs":[["ja494:16"]]},{"para":3533,"vripara":null,"refs":["ja494:16"],"lines":["Dhammameva carissāmi, nāhaṃ rajjena atthiko. 221."],"lineRefs":[["ja494:16"]]},{"para":3535,"vripara":"221","refs":["ja494:16"],"lines":["“Adaṇḍāvacaraṃ maggaṃ, sammāsambuddhadesitaṃ;"],"lineRefs":[["ja494:16"]]},{"para":3536,"vripara":null,"refs":["ja494:16"],"lines":["Taṃ maggaṃ paṭipajjissaṃ, yena gacchanti subbatā”ti."],"lineRefs":[["ja494:16"]]},{"para":3537,"vripara":null,"refs":["ja494:16","ja494:20"],"lines":["Tattha <b>vutthaṃ me bhavanaṃ dibya</b>nti vejayantaṃ sandhāya āha.","<b>Sohaṃ etādisa</b>nti tāta nārada, sohaṃ buddhañāṇena aparicchindanīyaṃ evarūpaṃ kāmaguṇasampattiṃ pahāya puññakaraṇatthāya idhāgato.","<b>Adaṇḍāvacara</b>nti adaṇḍehi nikkhittadaṇḍahatthehi avacaritabbaṃ sammādiṭṭhipurekkhāraṃ aṭṭhaṅgikaṃ maggaṃ.","<b>Subbatā</b>ti yena maggena subbatā sabbaññubuddhā gacchanti, ahampi agatapubbaṃ disaṃ gantuṃ bodhitale nisīditvā tameva maggaṃ paṭipajjissāmīti."],"lineRefs":[["ja494:16"],["ja494:16"],["ja494:20"],["ja494:20"]]}],"wordLinks":[["ja494:8.3","āyuṃ nu khīṇo",0,0],["ja494:8.5","janindaseṭṭhā",0,1],["ja494:10.1","vasa devānubhāvenā",6,1],["ja494:13.3","samacariyāyā",15,2],["ja494:13.3","saṃyamenā",15,3],["ja494:13.3","damenā",15,4],["ja494:13.5","yaṃ katvā",15,5],["ja494:16.1","khettānī",24,0],["ja494:16.1","tānīdha khettānī",24,5],["ja494:20.1","adaṇḍāvacaraṃ",34,2],["ja494:20.3","subbatā",34,3]],"after":[{"para":3538,"vripara":null,"title":"[494] 11. Sādhinajātakavaṇṇanā","lines":["Evaṃ bodhisatto imā gāthāyo sabbaññutaññāṇena saṅkhipitvā kathesi.","Nārado punapi āha –","“rajjaṃ, deva, anusāsā”ti.","“Tāta, na me rajjenattho, satta vassasatāni vigataṃ dānaṃ sattāheneva dātukāmamhī”ti.","Nārado “sādhū”ti tassa vacanaṃ sampaṭicchitvā mahādānaṃ paṭiyādesi.","Rājā sattāhaṃ dānaṃ datvā sattame divase kālaṃ katvā tāvatiṃsabhavaneyeva nibbatti."]},{"para":3539,"vripara":null,"title":"[494] 11. Sādhinajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā “evaṃ vasitabbayuttakaṃ uposathakammaṃ nāmā”ti dassetvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne uposathikesu upāsakesu keci sotāpattiphale, keci sakadāgāmiphale, keci anāgāmiphale patiṭṭhahiṃsu.","Tadā nāradarājā sāriputto ahosi, mātali ānando, sakko anuruddho, sādhinarājā pana ahameva ahosinti."]},{"para":3540,"vripara":null,"title":"[494] 11. Sādhinajātakavaṇṇanā","lines":["Sādhinajātakavaṇṇanā ekādasamā. [495] 12."]},{"para":3542,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dasabrāhmaṇajātakavaṇṇanā"]},{"para":3543,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["<b>Rājā</b> <b>avoca vidhura</b>nti idaṃ satthā jetavane viharanto asadisadānaṃ ārabbha kathesi.","Taṃ aṭṭhakanipāte <b>ādittajātake</b> (jā. 1.8.69 ādayo) vitthāritameva.","Rājā kira taṃ dānaṃ dadanto satthāraṃ jeṭṭhakaṃ katvā pañca bhikkhusatāni vicinitvā gaṇhitvā mahākhīṇāsavānaṃyeva adāsi.","Athassa guṇakathaṃ kathentā “āvuso, rājā asadisadānaṃ dadanto vicinitvā mahapphalaṭṭhāne adāsī”ti dhammasabhāyaṃ kathaṃ samuṭṭhāpesuṃ.","Satthā āgantvā “kāya nuttha, bhikkhave, etarahi kathāya sannisinnā”ti pucchitvā “imāya nāmā”ti vutte “anacchariyaṃ, bhikkhave, yaṃ kosalarājā mādisassa buddhassa upaṭṭhāko hutvā viceyyadānaṃ deti, porāṇakapaṇḍitā anuppanne buddhepi viceyyadānaṃ adaṃsū”ti vatvā atītaṃ āhari."]},{"para":3544,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Atīte kururaṭṭhe indapatthanagare yudhiṭṭhilagotto korabyo nāma rājā rajjaṃ kāresi.","Tassa vidhuro nāma amacco atthañca dhammañca anusāsati.","Rājā sakalajambudīpaṃ khobhetvā mahādānaṃ deti.","Taṃ gahetvā bhuñjantesu ekopi pañcasīlamattaṃ rakkhanto nāma natthi, sabbe dussīlāva, dānaṃ rājānaṃ na toseti.","Rājā “viceyyadānaṃ mahapphala”nti sīlavantānaṃ dātukāmo hutvā cintesi “vidhurapaṇḍitena saddhiṃ mantayissāmī”ti.","So taṃ upaṭṭhānaṃ āgataṃ āsane nisīdāpetvā pañhaṃ pucchi.","Tamatthaṃ pakāsento satthā upaḍḍhagāthamāha – 222."]},{"para":3546,"vripara":"222","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Rājā avoca vidhuraṃ, dhammakāmo yudhiṭṭhilo”ti;"]},{"para":3547,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Parato rañño ca vidhurassa ca vacanapaṭivacanaṃ hoti –"]},{"para":3548,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Brāhmaṇe vidhura pariyesa, sīlavante bahussute. 223."]},{"para":3550,"vripara":"223","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3551,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ. 224."]},{"para":3553,"vripara":"224","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Dullabhā brāhmaṇā deva, sīlavanto bahussutā;"]},{"para":3554,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Viratā methunā dhammā, ye te bhuñjeyyu bhojanaṃ. 225."]},{"para":3556,"vripara":"225","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Dasa khalu mahārāja, yā tā brāhmaṇajātiyo;"]},{"para":3557,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Tesaṃ vibhaṅgaṃ vicayaṃ, vitthārena suṇohi me. 226."]},{"para":3559,"vripara":"226","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Pasibbake gahetvāna, puṇṇe mūlassa saṃvute;"]},{"para":3560,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Osadhikāyo ganthenti, nhāpayanti japanti ca. 227."]},{"para":3562,"vripara":"227","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Tikicchakasamā rāja, tepi vuccanti brāhmaṇā;"]},{"para":3563,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Akkhātā te mahārāja, tādise nipatāmase. 228."]},{"para":3565,"vripara":"228","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Apetā te ca brahmaññā, (iti rājā korabyo)"]},{"para":3566,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Na te vuccanti brāhmaṇā;"]},{"para":3567,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Aññe vidhura pariyesa, sīlavante bahussute. 229."]},{"para":3569,"vripara":"229","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3570,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ. 230."]},{"para":3572,"vripara":"230","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Kiṅkiṇikāyo gahetvā, ghosenti puratopi te;"]},{"para":3573,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Pesanānipi gacchanti, rathacariyāsu sikkhare. 231."]},{"para":3575,"vripara":"231","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Paricārakasamā rāja, tepi vuccanti brāhmaṇā;"]},{"para":3576,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Akkhātā te mahārāja, tādise nipatāmase. 232."]},{"para":3578,"vripara":"232","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Apetā te ca brahmaññā, (iti rājā korabyo)"]},{"para":3579,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Na te vuccanti brāhmaṇā;"]},{"para":3580,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Aññe vidhura pariyesa, sīlavante bahussute. 233."]},{"para":3582,"vripara":"233","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3583,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ. 234."]},{"para":3585,"vripara":"234","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Kamaṇḍaluṃ gahetvāna, vaṅkadaṇḍañca brāhmaṇā;"]},{"para":3586,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Paccupessanti rājāno, gāmesu nigamesu ca;"]},{"para":3587,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Nādinne vuṭṭhahissāma, gāmamhi vā vanamhi vā. 235."]},{"para":3589,"vripara":"235","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Niggāhakasamā rāja, tepi vuccanti brāhmaṇā;"]},{"para":3590,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Akkhātā te mahārāja, tādise nipatāmase. 236."]},{"para":3592,"vripara":"236","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Apetā te ca brahmaññā, (iti rājā korabyo)"]},{"para":3593,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Na te vuccanti brāhmaṇā;"]},{"para":3594,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Aññe vidhura pariyesa, sīlavante bahussute. 237."]},{"para":3596,"vripara":"237","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3597,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ. 238."]},{"para":3599,"vripara":"238","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Parūḷhakacchanakhalomā, paṅkadantā rajassirā;"]},{"para":3600,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Okiṇṇā rajareṇūhi, yācakā vicaranti te. 239."]},{"para":3602,"vripara":"239","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Khāṇughātasamā rāja, tepi vuccanti brāhmaṇā;"]},{"para":3603,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Akkhātā te mahārāja, tādise nipatāmase. 240."]},{"para":3605,"vripara":"240","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Apetā te ca brahmaññā, (iti rājā korabyo)"]},{"para":3606,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Na te vuccanti brāhmaṇā;"]},{"para":3607,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Aññe vidhura pariyesa, sīlavante bahussute. 241."]},{"para":3609,"vripara":"241","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3610,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ. 242."]},{"para":3612,"vripara":"242","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Harītakaṃ āmalakaṃ, ambaṃ jambuṃ vibhītakaṃ;"]},{"para":3613,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Labujaṃ dantapoṇāni, beluvā badarāni ca. 243."]},{"para":3615,"vripara":"243","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Rājāyatanaṃ ucchupuṭaṃ, dhūmanettaṃ madhuañjanaṃ;"]},{"para":3616,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Uccāvacāni paṇiyāni, vipaṇenti janādhipa. 244."]},{"para":3618,"vripara":"244","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Vāṇijakasamā rāja, tepi vuccanti brāhmaṇā;"]},{"para":3619,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Akkhātā te mahārāja, tādise nipatāmase. 245."]},{"para":3621,"vripara":"245","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Apetā te ca brahmaññā, (iti rājā korabyo)"]},{"para":3622,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Na te vuccanti brāhmaṇā;"]},{"para":3623,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Aññe vidhura pariyesa, sīlavante bahussute. 246."]},{"para":3625,"vripara":"246","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3626,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ. 247."]},{"para":3628,"vripara":"247","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Kasivāṇijjaṃ kārenti, posayanti ajeḷake;"]},{"para":3629,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Kumāriyo pavecchanti, vivāhantāvahanti ca. 248."]},{"para":3631,"vripara":"248","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Samā ambaṭṭhavessehi, tepi vuccanti brāhmaṇā;"]},{"para":3632,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Akkhātā te mahārāja, tādise nipatāmase. 249."]},{"para":3634,"vripara":"249","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Apetā te ca brahmaññā, (iti rājā korabyo)"]},{"para":3635,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Na te vuccanti brāhmaṇā;"]},{"para":3636,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Aññe vidhura pariyesa, sīlavante bahussute. 250."]},{"para":3638,"vripara":"250","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3639,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ. 251."]},{"para":3641,"vripara":"251","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Nikkhittabhikkhaṃ bhuñjanti, gāmesveke purohitā;"]},{"para":3642,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Bahū te paripucchanti, aṇḍacchedā nilañchakā. 252."]},{"para":3644,"vripara":"252","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Pasūpi tattha haññanti, mahiṃsā sūkarā ajā;"]},{"para":3645,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Goghātakasamā rāja, tepi vuccanti brāhmaṇā;"]},{"para":3646,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Akkhātā te mahārāja, tādise nipatāmase. 253."]},{"para":3648,"vripara":"253","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Apetā te ca brahmaññā, (iti rājā korabyo)"]},{"para":3649,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Na te vuccanti brāhmaṇā;"]},{"para":3650,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Aññe vidhura pariyesa, sīlavante bahussute. 254."]},{"para":3652,"vripara":"254","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3653,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ. 255."]},{"para":3655,"vripara":"255","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Asicammaṃ gahetvāna, khaggaṃ paggayha brāhmaṇā;"]},{"para":3656,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Vessapathesu tiṭṭhanti, satthaṃ abbāhayantipi. 256."]},{"para":3658,"vripara":"256","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Samā gopanisādehi, tepi vuccanti brāhmaṇā;"]},{"para":3659,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Akkhātā te mahārāja, tādise nipatāmase. 257."]},{"para":3661,"vripara":"257","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Apetā te ca brahmaññā, (iti rājā korabyo)"]},{"para":3662,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Na te vuccanti brāhmaṇā;"]},{"para":3663,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Aññe vidhura pariyesa, sīlavante bahussute. 258."]},{"para":3665,"vripara":"258","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3666,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ. 259."]},{"para":3668,"vripara":"259","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Araññe kuṭikaṃ katvā, kuṭāni kārayanti te;"]},{"para":3669,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Sasabiḷāre bādhenti, āgodhā macchakacchapaṃ. 260."]},{"para":3671,"vripara":"260","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Te luddakasamā rāja, tepi vuccanti brāhmaṇā;"]},{"para":3672,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Akkhātā te mahārāja, tādise nipatāmase. 261."]},{"para":3674,"vripara":"261","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Apetā te ca brahmaññā, (iti rājā korabyo)"]},{"para":3675,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Na te vuccanti brāhmaṇā;"]},{"para":3676,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Aññe vidhura pariyesa, sīlavante bahussute. 262."]},{"para":3678,"vripara":"262","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3679,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphalaṃ. 263."]},{"para":3681,"vripara":"263","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Aññe dhanassa kāmā hi, heṭṭhāmañce pasakkitā;"]},{"para":3682,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Rājāno upari nhāyanti, somayāge upaṭṭhite. 264."]},{"para":3684,"vripara":"264","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Malamajjakasamā rāja, tepi vuccanti brāhmaṇā;"]},{"para":3685,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Akkhātā te mahārāja, tādise nipatāmase. 265."]},{"para":3687,"vripara":"265","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Apetā te ca brahmaññā, (iti rājā korabyo)"]},{"para":3688,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Na te vuccanti brāhmaṇā;"]},{"para":3689,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Aññe vidhura pariyesa, sīlavante bahussute. 266."]},{"para":3691,"vripara":"266","title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["“Virate methunā dhammā, ye me bhuñjeyyu bhojanaṃ;"]},{"para":3692,"vripara":null,"title":"[495] 12. Dasabrāhmaṇajātakavaṇṇanā","lines":["Dakkhiṇaṃ samma dassāma, yattha dinnaṃ mahapphala”nti."]}]},"tika":{"book":"Ja-ṭ-iii","bookName":"Jātaka-abhinavaṭīkā-3","vriCode":"","from":551,"to":557,"paras":[{"para":551,"vripara":null,"refs":["ja494:1"],"lines":["11-sādhinajātakavaṇṇanā (494)"],"lineRefs":[["ja494:1"]]},{"para":552,"vripara":null,"refs":["ja494:1"],"lines":["<b>unnaṅgalaṃ katvā</b>ti ettha attho heṭṭhā vuttanayena veditabbo.","<b>veyakaraṇa</b>nti [vayakaraṇaṃ. chaṭṭha.] viyākaraṇaṃ dānavasena vibhajanakaraṇaṃ.","<b>manomayasindha-vayutta</b>nti manato nibbattehi sindhavehi yuttaṃ.","nimmitehi sindhavehi yuttanti attho.","<b>sīhapañjaraümmāre</b>ti sīhapañjarassa ummāre.","<b>ārohaṇasajjaṃ katvā aṭṭhāsī</b>ti ārohaṇatthāya vidhānaṃ katvā aṭṭhāsi."],"lineRefs":[["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"]]},{"para":553,"vripara":null,"refs":["ja494:1"],"lines":["pāḷiyaṃ <b>tāvatiṃsā</b>ti tāvatiṃse bhavā tāvatiṃsā.","<b>saïnda-kā</b>ti indena sakkena saha ye vattantīti saïndakā.","<b>saramānā</b>ti anussaramānā.","daṭṭhuṃ ākaṅkhamānāti vuttaṃ hoti.","<b>acchantī</b>ti vasanti.","<b>agā devāna santike</b>ti ettha devānanti vattabbe chandānurakkhanatthaṃ niggahitalopaṃ katvā evaṃ vuttaṃ.","tenāha “devānaṃ santikaṃ agamāsī”ti.","<b>tasmi</b>nti sādhinarājasmiṃ.","<b>so</b>ti ratho.","pāḷiyaṃ <b>rājīsī</b>ti rājāyeva sīlasampannatāya isisadisattā rājisīti vuttaṃ.","<b>kāmehī</b>ti paṇḍu-kambalasilāsanato aññehi vatthukāmehi."],"lineRefs":[["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"]]},{"para":554,"vripara":null,"refs":["ja494:1"],"lines":["<b>devaloke vasanaka</b>nti devaloke vasanatthāya kataṃ puññaṃ khīṇaṃ.","<b>ajjā</b>ti devagaṇanāya sallakkhetvā raññā vuttaṃ.","<b>yaṃ parena dinnattā labhati.","taṃ yācitakasadisameva hotī</b>ti yaṃ dhanaṃ parena mūlacchajjavasena dinnattā labhati.","taṃ mūlacchajjavasena dinnampi yācitaka-sadisameva hoti.","parāyattattāti sambandho.","pāḷiyaṃ <b>āvenika</b>nti [āveṇikaṃ. chaṭṭha.] ettha āveno vuccati puthu.","tena pavattaṃ āveṇikanti attho.","nakārassa pana ṇakārattaṃ veditabbaṃ.","<b>sajjetvā</b>ti vidhāyitvā.","visodhe-tvāti vuttaṃ hoti.","bodhisatto pana manussattabhāve nikativāre devalokaṃ gato hoti cattāro mandhāturājakāle sādhinarāja-kāle guttilavīṇāvādanakāle nimimahārājakāleti.","so mandhātukāle devaloke asaṅkhyeyyakālaṃ vasi.","tasmiṃ hi vasamāneyeva chattiṃsa sakkā caviṃsu.","sādhinarājakāle sattāhaṃ vasi.","manussagaṇanāya sattavassasatāni honti.","guttilavīṇāvādanakāle ca nimirājakāle ca muhuttamattaṃ vasi.","manussagaṇanāya sattadivasāni hontīti.","ayamattho majjhimanikāye majjhimapaṇṇāse magghadevasuttaṭṭha-kathāyaṃ vutto.","<b>atha naṃ rājā ko añño satto mama santike āsane nisīdissatīti vatvā</b>ti tasmiṃ kāle uyyānapālaṃ rājā attano vayo vuḍḍhabhāvaṃ paṭicca ko añño satto mama santike samabhūte āsane nisīdissatīti vatvā ekasmiṃ nisīditvā ekasmiṃ pāde ṭhapesi.","<b>so kirassā</b>ti so nāradarājā assa sādhinarājassa rājaparivattavasena sattannaṃ rājūnaṃ pūraṇo panatto puttassa puttoti attho.","<b>tadā kira vassasatāyukakālova ahosī</b>ti vassasataāyuppamāṇo kāloyeva ahosi.","na nimijātakādīsu viya anekavassasatāyukakāloti."],"lineRefs":[["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"]]},{"para":555,"vripara":null,"refs":["ja494:1"],"lines":["<b>khettānī</b>ti ettha sassavirūhaṇaṭṭhānaṃpi gahetabbanti āha “khettā-nīti bhūmibhāge sandhāyāhā”ti.","<b>tādisamevā</b>ti khettānaṃ pamāṇena upamānetvā vuttaṃ.","<b>udaka [musala. chaṭṭha.] pavesanakuṇḍalenā</b>ti udakaṃ khettesu pavesanatthāya katena kaṭṭhaveḷuādimayāya doṇiyā sampannāgataṃ.","udakapavesanadoṇi hi kaṃ udakaṃ uḍeti umbheti ukkhipati pavesati etenāti kuṇḍalanti vuccati.","<b>anupā</b>ti anugatā āpā etthāti anupā.","āpasaddassa ākarassa ukārattaṃ veditabbaṃ.","parasaralopo vā.","“anupo salilapāyo”ti vuttaṃ."],"lineRefs":[["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"]]},{"para":556,"vripara":null,"refs":["ja494:1"],"lines":["pāḷiyaṃ <b>diṭṭhā mayā vimānānī</b>ti mayā vimānāni diṭṭhāni.","<b>obhā-sentā catuddisā</b>ti catūsu disāsu obhāsantāni.","<b>vuṭṭhaṃ [vuttaṃ. chaṭṭha.] me bhavanaṃ dibya</b>nti vasitaṃ mayā bhavane dibbeti attho.","athavā mayā bhavanaṃ dibyaṃ paribhuttanti attho.","<b>buddhañāṇena aparicchindanīya</b>nti buddhānaṃ ñāṇenapi aparicchindanīyaṃ.","evarūpaṃ kāmaguṇasampattiṃ pahāya puññakaraṇatthāya idhāgatoti attho.","idañca paricchindituṃ dukkarataṃ sandhāya vuttaṃ.","na buddhañāṇena aparicchindanīyaṃ nāma atthi.","yadi hi buddhañāṇena aparicchindanīyaṃ kiñci atthaṃ.","evaṃsati buddhānaṃ asabbaññutā bhaveyyāti.","<b>nikkhitta-daṇḍahatthehī</b>ti hatthato nikkhipitvā ṭhapitehi daṇḍehi.","<b>sabbaññuta-ñāṇena saṅkhipitvā</b>ti sabbaññutañāṇena tulayitvā sadisākāraṃ katvāti attho.","saṃpubbo hettha khipa saddo ākārattho.","bhūmattharaṇa-saṅkhepesūti ādīsu viya.","<b>vigata</b>nti akaraṇavasena vinābhūtanti."],"lineRefs":[["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"],["ja494:1"]]},{"para":557,"vripara":null,"refs":["ja494:1"],"lines":["sādhinajātakaṃ."],"lineRefs":[["ja494:1"]]}],"wordLinks":[]},"tika2":null}
