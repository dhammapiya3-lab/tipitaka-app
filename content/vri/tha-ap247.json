{"suttaId":"tha-ap247","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8170,8179],"vripara":"17"},"segments":{"tha-ap247:0.3":"Kuṭidhūpakattheraapadānaṃ","tha-ap247:1.1":"“Siddhatthassa bhagavato, ahosiṃ kuṭigopako;","tha-ap247:1.3":"Kālena kālaṃ dhūpesiṃ, pasanno sehi pāṇibhi.","tha-ap247:2.1":"“Catunnavutito kappe, yaṃ kammamakariṃ tadā;","tha-ap247:2.3":"Duggatiṃ nābhijānāmi, dhūpadānassidaṃ [buddhapūjāyidaṃ (sī.)] phalaṃ.","tha-ap247:3.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap247:4.1":"Itthaṃ sudaṃ āyasmā kuṭidhūpako thero imā gāthāyo abhāsitthāti.","tha-ap247:5.1":"Kuṭidhūpakattherassāpadānaṃ pañcamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3202,"to":3202,"paras":[{"para":3202,"vripara":"17","refs":["tha-ap247:1"],"lines":["Pañcamāpadāne <b>kuṭigopako</b>ti senāsanapālako.","<b>Kālena kālaṃ dhūpesin</b>ti sampattasampattakālānukāle dhūpesiṃ, dhūpena sugandhaṃ akāsinti attho.","Siddhatthassa bhagavato gandhakuṭikālānusāridhūpena dhūpesiṃ vāsesinti attho."],"lineRefs":[["tha-ap247:1"],["tha-ap247:1"],["tha-ap247:1"]]}],"wordLinks":[["tha-ap247:1.1","kuṭigopako",0,0],["tha-ap247:1.3","kālena kālaṃ dhūpesiṃ",0,1]]},"tika":null,"tika2":null}
