{"suttaId":"sn46.40","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[591,597],"vripara":"221"},"segments":{"sn46.40:0.3":"Nīvaraṇasuttaṃ","sn46.40:1.1":"“Pañcime, bhikkhave, nīvaraṇā andhakaraṇā acakkhukaraṇā aññāṇakaraṇā paññānirodhikā vighātapakkhiyā anibbānasaṃvattanikā.","sn46.40:1.2":"Katame pañca?","sn46.40:1.3":"Kāmacchandanīvaraṇaṃ, bhikkhave, andhakaraṇaṃ acakkhukaraṇaṃ aññāṇakaraṇaṃ paññānirodhikaṃ vighātapakkhiyaṃ anibbānasaṃvattanikaṃ.","sn46.40:1.4":"Byāpādanīvaraṇaṃ, bhikkhave … pe …","sn46.40:1.5":"thinamiddhanīvaraṇaṃ, bhikkhave …","sn46.40:1.6":"uddhaccakukkuccanīvaraṇaṃ, bhikkhave …","sn46.40:1.7":"vicikicchānīvaraṇaṃ, bhikkhave, andhakaraṇaṃ acakkhukaraṇaṃ aññāṇakaraṇaṃ paññānirodhikaṃ vighātapakkhiyaṃ anibbānasaṃvattanikaṃ.","sn46.40:1.8":"Ime kho, bhikkhave, pañca nīvaraṇā andhakaraṇā acakkhukaraṇā aññāṇakaraṇā paññānirodhikā vighātapakkhiyā anibbānasaṃvattanikā.","sn46.40:2.1":"“Sattime, bhikkhave, bojjhaṅgā cakkhukaraṇā ñāṇakaraṇā paññābuddhiyā avighātapakkhiyā nibbānasaṃvattanikā.","sn46.40:2.2":"Katame satta?","sn46.40:2.3":"Satisambojjhaṅgo, bhikkhave, cakkhukaraṇo ñāṇakaraṇo paññābuddhiyo avighātapakkhiyo nibbānasaṃvattaniko … pe … upekkhāsambojjhaṅgo, bhikkhave, cakkhukaraṇo ñāṇakaraṇo paññābuddhiyo avighātapakkhiyo nibbānasaṃvattaniko.","sn46.40:2.4":"Ime kho, bhikkhave, satta bojjhaṅgā cakkhukaraṇā ñāṇakaraṇā paññābuddhiyā avighātapakkhiyā nibbānasaṃvattanikā”ti.","sn46.40:2.5":"Dasamaṃ.","sn46.40:2.6":"Nīvaraṇavaggo catuttho.","sn46.40:3.0":"Tassuddānaṃ –","sn46.40:3.1":"Dve kusalā kilesā ca,","sn46.40:3.2":"dve yoniso ca buddhi ca;","sn46.40:3.3":"Āvaraṇā nīvaraṇā rukkhaṃ,","sn46.40:3.4":"nīvaraṇañca te dasāti."},"unsure":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":204,"to":204,"paras":[{"para":204,"vripara":"221","refs":["sn46.40:1"],"lines":["Dasame <b>andhakaraṇā</b>ti andhabhāvakaraṇā.","<b>Acakkhukaraṇā</b>ti paññācakkhussa akaraṇā.","<b>Paññānirodhikā</b>ti paññāya nirodhanā.","<b>Vighātapakkhiyā</b>ti dukkhapakkhikā.","<b>Anibbānasaṃvattanikā</b>ti nibbānatthāya asaṃvattanikā.","Sesaṃ sabbattha uttānatthameva.","Sakalepi imasmiṃ vagge missakabojjhaṅgāva kathitāti."],"lineRefs":[["sn46.40:1"],["sn46.40:1"],["sn46.40:1"],["sn46.40:1"],["sn46.40:1"],["sn46.40:1"],["sn46.40:1"]]}],"wordLinks":[["sn46.40:1.1","andhakaraṇā",0,0],["sn46.40:1.3","andhakaraṇā",0,0],["sn46.40:1.4","andhakaraṇā",0,0],["sn46.40:1.8","andhakaraṇā",0,0],["sn46.40:1.1","acakkhukaraṇā",0,1],["sn46.40:1.3","acakkhukaraṇā",0,1],["sn46.40:1.4","acakkhukaraṇā",0,1],["sn46.40:1.8","acakkhukaraṇā",0,1],["sn46.40:1.1","paññānirodhikā",0,2],["sn46.40:1.3","paññānirodhikā",0,2],["sn46.40:1.4","paññānirodhikā",0,2],["sn46.40:1.8","paññānirodhikā",0,2],["sn46.40:1.1","vighātapakkhiyā",0,3],["sn46.40:1.3","vighātapakkhiyā",0,3],["sn46.40:1.4","vighātapakkhiyā",0,3],["sn46.40:1.8","vighātapakkhiyā",0,3],["sn46.40:1.1","anibbānasaṃvattanikā",0,4],["sn46.40:1.3","anibbānasaṃvattanikā",0,4],["sn46.40:1.4","anibbānasaṃvattanikā",0,4],["sn46.40:1.8","anibbānasaṃvattanikā",0,4]],"before":[{"para":203,"vripara":null,"refs":[],"lines":["Nīvaraṇasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":209,"to":209,"paras":[{"para":209,"vripara":"221","refs":["sn46.40:1"],"lines":["<b>Andhabhāvakaraṇā</b> paññācakkhussa vibandhanato.","Tathā hi te “acakkhukaraṇā paññānirodhikā”ti vuttā.","Vihanati vibādhatīti <b>vighāto,</b> dukkhanti āha <b>“vighātapakkhiyāti dukkhapakkhikā”</b>ti.","Nibbānatthāya na saṃvattantīti <b>anibbānasaṃvattanikā.</b>","<b>Missakabojjhaṅgāva kathitā</b> pubbabhāgikānaṃ kathitattā."],"lineRefs":[["sn46.40:1"],["sn46.40:1"],["sn46.40:1"],["sn46.40:1"],["sn46.40:1"]]}],"wordLinks":[["sn46.40:1.1","vighāto",0,2],["sn46.40:1.3","vighāto",0,2],["sn46.40:1.4","vighāto",0,2],["sn46.40:1.8","vighāto",0,2],["sn46.40:1.1","anibbānasaṃvattanikā",0,3],["sn46.40:1.3","anibbānasaṃvattanikā",0,3],["sn46.40:1.4","anibbānasaṃvattanikā",0,3],["sn46.40:1.8","anibbānasaṃvattanikā",0,3]],"before":[{"para":208,"vripara":null,"refs":[],"lines":["Nīvaraṇasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
