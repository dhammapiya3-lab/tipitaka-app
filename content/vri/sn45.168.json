{"suttaId":"sn45.168","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[369,369],"vripara":"168"},"segments":{"sn45.168:0.3":"Nīghasuttaṃ","sn45.168:1.1":"“Tayome, bhikkhave, nīghā.","sn45.168:1.2":"Katame tayo?","sn45.168:1.3":"Rāgo nīgho, doso nīgho, moho nīgho – ime kho, bhikkhave, tayo nīghā.","sn45.168:1.5":"Imesaṃ kho, bhikkhave, tiṇṇannaṃ nīghānaṃ abhiññāya pariññāya parikkhayāya pahānāya … pe … ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.168:1.6":"Aṭṭhamaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":114,"to":117,"paras":[{"para":114,"vripara":"162-171","refs":["sn45.168:1"],"lines":["162-171. <b>Vidhā</b>ti mānakoṭṭhāsā mānaṭhapanā vā.","<b>Seyyohamasmīti vidhā</b>ti ahamasmi seyyoti evaṃ mānakoṭṭhāso mānaṭhapanā vā.","<b>Nīghā</b>ti dukkhā.","Vacanattho panettha yassa uppajjanti, taṃ purisaṃ nīhanantīti nīghā.","Sesamettha uttānamevāti."],"lineRefs":[["sn45.168:1"],["sn45.168:1"],["sn45.168:1"],["sn45.168:1"],["sn45.168:1"]]},{"para":115,"vripara":null,"refs":[],"lines":["Esanāvaggo dasamo."],"lineRefs":[[]]},{"para":116,"vripara":null,"refs":[],"lines":["Oghavaggo"],"lineRefs":[[]]},{"para":117,"vripara":null,"refs":["sn45.168:1"],"lines":["1-2. Oghasuttādivaṇṇanā"],"lineRefs":[["sn45.168:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":114,"to":117,"paras":[{"para":114,"vripara":"162-171","refs":["sn45.168:1"],"lines":["162-171. Seyyohamasmītiādinā taṃtaṃvibhāgena dhīyanti vidhīyantīti <b>vidhā,</b> mānakoṭṭhāsā, mānaṭṭhapanā vā.","<b>Nīhanantī</b>ti vibādhenti."],"lineRefs":[["sn45.168:1"],["sn45.168:1"]]},{"para":115,"vripara":null,"refs":[],"lines":["Esanāvaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":116,"vripara":null,"refs":[],"lines":["Oghavaggo"],"lineRefs":[[]]},{"para":117,"vripara":null,"refs":["sn45.168:1"],"lines":["1-2. Oghasuttādivaṇṇanā"],"lineRefs":[["sn45.168:1"]]}],"wordLinks":[]}