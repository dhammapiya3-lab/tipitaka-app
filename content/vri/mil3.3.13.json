{"suttaId":"mil3.3.13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Mil","vriCode":"s0518m.nrf","paras":[366,369],"vripara":"13"},"segments":{"mil3.3.13:0.3":"Vitakkalakkhaṇapañho","mil3.3.13:1.1":"“Bhante nāgasena, kiṃlakkhaṇo vitakko”ti?","mil3.3.13:1.2":"“Appanālakkhaṇo mahārāja, vitakko”ti.","mil3.3.13:2.1":"“Opammaṃ karohī”ti.","mil3.3.13:2.2":"“Yathā, mahārāja, vaḍḍhakī suparikammakataṃ dāruṃ sandhismiṃ appeti,","mil3.3.13:2.3":"evameva kho, mahārāja, appanālakkhaṇo vitakko”ti.","mil3.3.13:3.1":"“Kallosi, bhante nāgasenā”ti.","mil3.3.13:4.1":"Vitakkalakkhaṇapañho terasamo. 14."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
