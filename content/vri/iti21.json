{"suttaId":"iti21","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"It","vriCode":"s0504m.mul","paras":[162,170],"vripara":"21"},"segments":{"iti21:0.4":"Pasannacittasuttaṃ","iti21:1.1":"Vuttañhetaṃ bhagavatā, vuttamarahatāti me sutaṃ –","iti21:2.1":"“Idhāhaṃ, bhikkhave, ekaccaṃ puggalaṃ pasannacittaṃ evaṃ cetasā ceto paricca pajānāmi –","iti21:2.2":"‘imamhi cāyaṃ samaye puggalo kālaṃ kareyya yathābhataṃ nikkhitto evaṃ sagge’.","iti21:2.3":"Taṃ kissa hetu?","iti21:2.4":"Cittaṃ hissa, bhikkhave, pasannaṃ.","iti21:2.5":"Cetopasādahetu kho pana, bhikkhave, evamidhekacce sattā kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjantī”ti.","iti21:2.6":"Etamatthaṃ bhagavā avoca.","iti21:2.7":"Tatthetaṃ iti vuccati –","iti21:3.1":"“Pasannacittaṃ ñatvāna,","iti21:3.2":"ekaccaṃ idha puggalaṃ;","iti21:3.3":"Etamatthañca byākāsi,","iti21:3.4":"buddho bhikkhūna santike.","iti21:4.1":"“Imamhi cāyaṃ samaye,","iti21:4.2":"kālaṃ kayirātha puggalo;","iti21:4.3":"Sugatiṃ upapajjeyya,","iti21:4.4":"cittaṃ hissa pasāditaṃ.","iti21:5.1":"“Yathā haritvā nikkhipeyya,","iti21:5.2":"evameva tathāvidho;","iti21:5.3":"Cetopasādahetu hi,","iti21:5.4":"sattā gacchanti suggati”nti.","iti21:6.1":"Ayampi attho vutto bhagavatā, iti me sutanti.","iti21:6.2":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"It-a","bookName":"Itivuttaka-aṭṭhakathā","vriCode":"s0504a.att","from":343,"to":343,"paras":[{"para":343,"vripara":"21","refs":["iti21:2"],"lines":["Tatiyavaggassa paṭhame <b>pasannacitta</b>nti ratanattayasaddhāya kammaphalasaddhāya ca pasannamānasaṃ.","<b>Sugati</b>nti sundaraṃ gatiṃ, sukhassa vā gatinti sugatiṃ.","<b>Sagga</b>nti rūpādisampattīhi suṭṭhu agganti <b>saggaṃ.</b>","<b>Loka</b>nti lokiyanti ettha puññapāpaphalāni, lujjanaṭṭheneva vā lokaṃ.","Ettha ca sugatiggahaṇena manussagatipi saṅgayhati, saggaggahaṇena devagati eva.","Sesaṃ heṭṭhā vuttanayameva."],"lineRefs":[["iti21:2"],["iti21:2"],["iti21:2"],["iti21:2"],["iti21:2"],["iti21:2"]]}],"wordLinks":[["iti21:2.1","pasannacittaṃ",0,0],["iti21:2.5","sugatiṃ",0,1],["iti21:2.5","saggaṃ",0,2],["iti21:2.5","lokaṃ",0,3]],"before":[{"para":341,"vripara":null,"title":"Tatiyavaggo","lines":["Tatiyavaggo 1."]},{"para":342,"vripara":null,"title":"Pasannacittasuttavaṇṇanā","lines":["Pasannacittasuttavaṇṇanā 21."]}],"after":[{"para":344,"vripara":null,"title":"Pasannacittasuttavaṇṇanā","lines":["Paṭhamasuttavaṇṇanā niṭṭhitā. 2."]}]},"tika":null,"tika2":null}
