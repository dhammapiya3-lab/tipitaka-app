{"suttaId":"sn48.22","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1221,1221],"vripara":"492"},"segments":{"sn48.22:0.3":"Jīvitindriyasuttaṃ","sn48.22:1.1":"“Tīṇimāni, bhikkhave, indriyāni.","sn48.22:1.2":"Katamāni tīṇi?","sn48.22:1.3":"Itthindriyaṃ, purisindriyaṃ, jīvitindriyaṃ –","sn48.22:1.4":"imāni kho, bhikkhave, tīṇi indriyānī”ti.","sn48.22:1.5":"Dutiyaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":560,"to":560,"paras":[{"para":560,"vripara":"492","refs":["sn48.22:1"],"lines":["Tatiyavaggassa dutiye <b>itthindriyan</b>tiādīsu itthibhāve indaṭṭhaṃ karotīti <b>itthindriyaṃ</b>.","Purisabhāve indaṭṭhaṃ karotīti <b>purisindriyaṃ</b>.","Jīvite indaṭṭhaṃ karotīti <b>jīvitindriyaṃ</b>.","Atthuppattikaṃ kiretaṃ suttaṃ.","Saṅghamajjhasmiñhi “kati nu kho vaṭṭindriyānī”ti kathā udapādi, atha bhagavā vaṭṭindriyāni dassento <b>tīṇimāni bhikkhave</b>tiādimāha."],"lineRefs":[["sn48.22:1"],["sn48.22:1"],["sn48.22:1"],["sn48.22:1"],["sn48.22:1"]]}],"wordLinks":[["sn48.22:1.3","itthindriyaṃ",0,0],["sn48.22:1.3","purisindriyaṃ",0,1],["sn48.22:1.3","jīvitindriyaṃ",0,2],["sn48.22:1.1","tīṇimāni bhikkhave",0,4]]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":486,"to":486,"paras":[{"para":486,"vripara":"492","refs":["sn48.22:1"],"lines":["<b>Itthibhāve</b>ti itthitāya.","<b>Indaṭṭhaṃ karoti</b> tathāsattajanasāmaññakāraṇabhāvato.","Itthiyā eva indriyaṃ <b>itthindriyaṃ</b>.","Esa nayo purisindriye.","<b>Jīvite</b>ti sahajātadhammānaṃ jīvane pālane pavattane.","<b>Vaṭṭindriyānī</b>ti vaṭṭahetubhūtāni indriyāni.","Imesu hi upādinnaindriyesu sati vaṭṭaṃ vattati paññāyati."],"lineRefs":[["sn48.22:1"],["sn48.22:1"],["sn48.22:1"],["sn48.22:1"],["sn48.22:1"],["sn48.22:1"],["sn48.22:1"]]}],"wordLinks":[["sn48.22:1.3","itthindriyaṃ",0,2],["sn48.22:1.3","jīvite",0,4]]},"tika2":null}
