{"suttaId":"thig6.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[629,647],"vripara":"163"},"segments":{"thig6.7:0.3":"Guttātherīgāthā","thig6.7:1.1":"“Gutte yadatthaṃ pabbajjā,","thig6.7:1.2":"hitvā puttaṃ vasuṃ piyaṃ;","thig6.7:1.3":"Tameva anubrūhehi,","thig6.7:1.4":"mā cittassa vasaṃ gami.","thig6.7:2.1":"“Cittena vañcitā sattā,","thig6.7:2.2":"mārassa visaye ratā;","thig6.7:2.3":"Anekajātisaṃsāraṃ,","thig6.7:2.4":"sandhāvanti aviddasū.","thig6.7:3.1":"“Kāmacchandañca byāpādaṃ,","thig6.7:3.2":"sakkāyadiṭṭhimeva ca;","thig6.7:3.3":"Sīlabbataparāmāsaṃ,","thig6.7:3.4":"vicikicchañca pañcamaṃ.","thig6.7:4.1":"“Saṃyojanāni etāni,","thig6.7:4.2":"pajahitvāna bhikkhunī;","thig6.7:4.3":"Orambhāgamanīyāni,","thig6.7:4.4":"nayidaṃ punarehisi.","thig6.7:5.1":"“Rāgaṃ mānaṃ avijjañca,","thig6.7:5.2":"uddhaccañca vivajjiya;","thig6.7:5.3":"Saṃyojanāni chetvāna,","thig6.7:5.4":"dukkhassantaṃ karissasi.","thig6.7:6.1":"“Khepetvā jātisaṃsāraṃ,","thig6.7:6.2":"pariññāya punabbhavaṃ;","thig6.7:6.3":"Diṭṭheva dhamme nicchātā,","thig6.7:6.4":"upasantā carissatī”ti.","thig6.7:7.1":"… Guttā therī …."},"unsure":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":2597,"to":2597,"paras":[{"para":2597,"vripara":null,"refs":["thig6.7:6"],"lines":["<b>Khepetvā jātisaṃsāran</b>ti jāti samūlikasaṃsārapavattiṃ pariyosāpetvā.","<b>Nicchātā</b>ti nittaṇhā.","<b>Upasantā</b>ti sabbaso kilesānaṃ vūpasamena upasantā.","Sesaṃ vuttanayameva."],"lineRefs":[["thig6.7:6"],["thig6.7:6"],["thig6.7:6"],["thig6.7:6"]]}],"wordLinks":[["thig6.7:6.1","khepetvā jātisaṃsāraṃ",0,0],["thig6.7:6.3","nicchātā",0,1],["thig6.7:6.3","upasantā",0,2]],"before":[{"para":2187,"vripara":null,"refs":[],"lines":["Athekadā mahāpajāpatigotamī satthari vesāliyaṃ viharante mahāvane kūṭāgārasālāyaṃ sayaṃ vesāliyaṃ bhikkhunupassaye viharantī pubbaṇhasamayaṃ vesāliyaṃ piṇḍāya caritvā bhattaṃ bhuñjitvā attano divāṭṭhāne yathāparicchinnakālaṃ phalasamāpattisukhena vītināmetvā phalasamāpattito vuṭṭhāya attano paṭipattiṃ paccavekkhitvā somanassajātā attano āyusaṅkhāre āvajjentī tesaṃ khīṇabhāvaṃ ñatvā evaṃ cintesi –","“yaṃnūnāhaṃ vihāraṃ gantvā bhagavantaṃ anujānāpetvā manobhāvanīye ca there sabbeva sabrahmacariye āpucchitvā idheva āgantvā parinibbāyeyyan”ti.","Yathā ca theriyā, evaṃ tassā parivārabhūtānaṃ pañcannaṃ bhikkhunisatānaṃ parivitakko ahosi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.2.97-288)–"],"lineRefs":[[],[],[],[]]},{"para":2188,"vripara":null,"refs":[],"lines":["“Ekadā lokapajjoto, vesāliyaṃ mahāvane;"],"lineRefs":[[]]},{"para":2189,"vripara":null,"refs":[],"lines":["Kūṭāgāre kusālāyaṃ, vasate narasārathi."],"lineRefs":[[]]},{"para":2190,"vripara":null,"refs":[],"lines":["“Tadā jinassa mātucchā, mahāgotami bhikkhunī;"],"lineRefs":[[]]},{"para":2191,"vripara":null,"refs":[],"lines":["Tahiṃ kate pure ramme, vasī bhikkhunupassaye."],"lineRefs":[[]]},{"para":2192,"vripara":null,"refs":[],"lines":["“Bhikkhunīhi vimuttāhi, satehi saha pañcahi;"],"lineRefs":[[]]},{"para":2193,"vripara":null,"refs":[],"lines":["Rahogatāya tassevaṃ, citassāsi vitakkitaṃ."],"lineRefs":[[]]},{"para":2194,"vripara":null,"refs":[],"lines":["“Buddhassa parinibbānaṃ, sāvakaggayugassa vā;"],"lineRefs":[[]]},{"para":2195,"vripara":null,"refs":[],"lines":["Rāhulānandanandānaṃ, nāhaṃ lacchāmi passituṃ."],"lineRefs":[[]]},{"para":2196,"vripara":null,"refs":[],"lines":["“Buddhassa parinibbānā, sāvakaggayugassa vā;"],"lineRefs":[[]]},{"para":2197,"vripara":null,"refs":[],"lines":["Mahākassapanandānaṃ, ānandarāhulāna ca."],"lineRefs":[[]]},{"para":2198,"vripara":null,"refs":[],"lines":["“Paṭikaccāyusaṅkhāraṃ, osajjitvāna nibbutiṃ;"],"lineRefs":[[]]},{"para":2199,"vripara":null,"refs":[],"lines":["Gaccheyyaṃ lokanāthena, anuññātā mahesinā."],"lineRefs":[[]]},{"para":2200,"vripara":null,"refs":[],"lines":["“Tathā pañcasatānampi, bhikkhunīnaṃ vitakkitaṃ;"],"lineRefs":[[]]},{"para":2201,"vripara":null,"refs":[],"lines":["Āsi khemādikānampi, etadeva vitakkitaṃ."],"lineRefs":[[]]},{"para":2202,"vripara":null,"refs":[],"lines":["“Bhūmicālo tadā asi, nāditā devadundubhī;"],"lineRefs":[[]]},{"para":2203,"vripara":null,"refs":[],"lines":["Upassayādhivatthāyo, devatā sokapīḷitā."],"lineRefs":[[]]},{"para":2204,"vripara":null,"refs":[],"lines":["“Vilapantā sukaruṇaṃ, tatthassūni pavattayuṃ;"],"lineRefs":[[]]},{"para":2205,"vripara":null,"refs":[],"lines":["Mittā bhikkhuniyo tāhi, upagantvāna gotamiṃ."],"lineRefs":[[]]},{"para":2206,"vripara":null,"refs":[],"lines":["“Nipacca sirasā pāde, idaṃ vacanamabravuṃ;"],"lineRefs":[[]]},{"para":2207,"vripara":null,"refs":[],"lines":["Tattha toyalavāsittā, mayamayye rahogatā."],"lineRefs":[[]]},{"para":2208,"vripara":null,"refs":[],"lines":["“Sā calā calitā bhūmi, nāditā devadundubhī;"],"lineRefs":[[]]},{"para":2209,"vripara":null,"refs":[],"lines":["Paridevā ca suyyante, kimatthaṃ nūna gotamī."],"lineRefs":[[]]},{"para":2210,"vripara":null,"refs":[],"lines":["“Tadā avoca sā sabbaṃ, yathāparivitakkitaṃ;"],"lineRefs":[[]]},{"para":2211,"vripara":null,"refs":[],"lines":["Tāyopi sabbā āhaṃsu, yathāparivitakkitaṃ."],"lineRefs":[[]]},{"para":2212,"vripara":null,"refs":[],"lines":["“Yadi te rucitaṃ ayye, nibbānaṃ paramaṃ sivaṃ;"],"lineRefs":[[]]},{"para":2213,"vripara":null,"refs":[],"lines":["Nibbāyissāma sabbāpi, buddhānuññāya subbate."],"lineRefs":[[]]},{"para":2214,"vripara":null,"refs":[],"lines":["“Mayaṃ sahāva nikkhantā, gharāpi ca bhavāpi ca;"],"lineRefs":[[]]},{"para":2215,"vripara":null,"refs":[],"lines":["Sahāyeva gamissāma, nibbānaṃ padamuttamaṃ."],"lineRefs":[[]]},{"para":2216,"vripara":null,"refs":[],"lines":["“Nibbānāya vajantīnaṃ, kiṃ vakkhāmīti sā vadaṃ;"],"lineRefs":[[]]},{"para":2217,"vripara":null,"refs":[],"lines":["Saha sabbāhi niggañchi, bhikkhunīnilayā tadā."],"lineRefs":[[]]},{"para":2218,"vripara":null,"refs":[],"lines":["“Upassaye yādhivatthā, devatā tā khamantu me;"],"lineRefs":[[]]},{"para":2219,"vripara":null,"refs":[],"lines":["Bhikkhunīnilayassedaṃ, pacchimaṃ dassanaṃ mama."],"lineRefs":[[]]},{"para":2220,"vripara":null,"refs":[],"lines":["“Na jarā maccu vā yattha, appiyehi samāgamo;"],"lineRefs":[[]]},{"para":2221,"vripara":null,"refs":[],"lines":["Piyehi na viyogotthi, taṃ vajissaṃ asaṅkhataṃ."],"lineRefs":[[]]},{"para":2222,"vripara":null,"refs":[],"lines":["“Avītarāgā taṃ sutvā, vacanaṃ sugatorasā;"],"lineRefs":[[]]},{"para":2223,"vripara":null,"refs":[],"lines":["Sokaṭṭā parideviṃsu, aho no appapuññatā."],"lineRefs":[[]]},{"para":2224,"vripara":null,"refs":[],"lines":["“Bhikkhunīnilayo suñño, bhūto tāhi vinā ayaṃ;"],"lineRefs":[[]]},{"para":2225,"vripara":null,"refs":[],"lines":["Pabhāte viya tārāyo, na dissanti jinorasā."],"lineRefs":[[]]},{"para":2226,"vripara":null,"refs":[],"lines":["“Nibbānaṃ gotamī yāti, satehi saha pañcahi;"],"lineRefs":[[]]},{"para":2227,"vripara":null,"refs":[],"lines":["Nadīsatehiva saha, gaṅgā pañcahi sāgaraṃ."],"lineRefs":[[]]},{"para":2228,"vripara":null,"refs":[],"lines":["“Rathiyāya vajantiyo, disvā saddhā upāsikā;"],"lineRefs":[[]]},{"para":2229,"vripara":null,"refs":[],"lines":["Gharā nikkhamma pādesu, nipacca idamabravuṃ."],"lineRefs":[[]]},{"para":2230,"vripara":null,"refs":[],"lines":["“Pasīdassu mahābhoge, anāthāyo vihāya no;"],"lineRefs":[[]]},{"para":2231,"vripara":null,"refs":[],"lines":["Tayā na yuttā nibbātuṃ, icchaṭṭā vilapiṃsu tā."],"lineRefs":[[]]},{"para":2232,"vripara":null,"refs":[],"lines":["“Tāsaṃ sokapahānatthaṃ, avoca madhuraṃ giraṃ;"],"lineRefs":[[]]},{"para":2233,"vripara":null,"refs":[],"lines":["Ruditena alaṃ puttā, hāsakāloyamajja vo."],"lineRefs":[[]]},{"para":2234,"vripara":null,"refs":[],"lines":["“Pariññātaṃ mayā dukkhaṃ, dukkhahetu vivajjito;"],"lineRefs":[[]]},{"para":2235,"vripara":null,"refs":[],"lines":["Nirodho me sacchikato, maggo cāpi subhāvito."],"lineRefs":[[]]},{"para":2236,"vripara":null,"refs":[],"lines":["“Pariciṇṇo mayā satthā, kataṃ buddhassa sāsanaṃ;"],"lineRefs":[[]]},{"para":2237,"vripara":null,"refs":[],"lines":["Ohito garuko bhāro, bhavanetti samūhatā."],"lineRefs":[[]]},{"para":2238,"vripara":null,"refs":[],"lines":["“Yassatthāya pabbajitā, agārasmānagāriyaṃ;"],"lineRefs":[[]]},{"para":2239,"vripara":null,"refs":[],"lines":["So me attho anuppatto, sabbasaṃyojanakkhayo."],"lineRefs":[[]]},{"para":2240,"vripara":null,"refs":[],"lines":["“Buddho tassa ca saddhammo, anūno yāva tiṭṭhati;"],"lineRefs":[[]]},{"para":2241,"vripara":null,"refs":[],"lines":["Nibbātuṃ tāva kālo me, mā maṃ socatha puttikā."],"lineRefs":[[]]},{"para":2242,"vripara":null,"refs":[],"lines":["“Koṇḍaññānandanandādī, tiṭṭhanti rāhulo jino;"],"lineRefs":[[]]},{"para":2243,"vripara":null,"refs":[],"lines":["Sukhito sahito saṅgho, hatadabbā ca titthiyā."],"lineRefs":[[]]},{"para":2244,"vripara":null,"refs":[],"lines":["“Okkākavaṃsassa yaso, ussito māramaddano;"],"lineRefs":[[]]},{"para":2245,"vripara":null,"refs":[],"lines":["Nanu sampati kālo me, nibbānatthāya puttikā."],"lineRefs":[[]]},{"para":2246,"vripara":null,"refs":[],"lines":["“Cirappabhuti yaṃ mayhaṃ, patthitaṃ ajja sijjhate;"],"lineRefs":[[]]},{"para":2247,"vripara":null,"refs":[],"lines":["Ānandabherikāloyaṃ, kiṃ vo assūhi puttikā."],"lineRefs":[[]]},{"para":2248,"vripara":null,"refs":[],"lines":["“Sace mayi dayā atthi, yadi catthi kataññutā;"],"lineRefs":[[]]},{"para":2249,"vripara":null,"refs":[],"lines":["Saddhammaṭṭhitiyā sabbā, karotha vīriyaṃ daḷhaṃ."],"lineRefs":[[]]},{"para":2250,"vripara":null,"refs":[],"lines":["“Thīnaṃ adāsi pabbajjaṃ, sambuddho yācito mayā;"],"lineRefs":[[]]},{"para":2251,"vripara":null,"refs":[],"lines":["Tasmā yathāhaṃ nandissaṃ, tathā tamanutiṭṭhatha."],"lineRefs":[[]]},{"para":2252,"vripara":null,"refs":[],"lines":["“Tā evamanusāsitvā, bhikkhunīhi purakkhatā;"],"lineRefs":[[]]},{"para":2253,"vripara":null,"refs":[],"lines":["Upecca buddhaṃ vanditvā, idaṃ vacanamabravi."],"lineRefs":[[]]},{"para":2254,"vripara":null,"refs":[],"lines":["“Ahaṃ sugata te mātā, tvañca vīra pitā mama;"],"lineRefs":[[]]},{"para":2255,"vripara":null,"refs":[],"lines":["Saddhammasukhada nātha, tayi jātāmhi gotama."],"lineRefs":[[]]},{"para":2256,"vripara":null,"refs":[],"lines":["“Saṃvaddhitoyaṃ sugata, rūpakāyo mayā tava;"],"lineRefs":[[]]},{"para":2257,"vripara":null,"refs":[],"lines":["Anindito dhammakāyo, mama saṃvaddhito tayā."],"lineRefs":[[]]},{"para":2258,"vripara":null,"refs":[],"lines":["“Muhuttaṃ taṇhāsamaṇaṃ, khīraṃ tvaṃ pāyito mayā;"],"lineRefs":[[]]},{"para":2259,"vripara":null,"refs":[],"lines":["Tayāhaṃ santamaccantaṃ, dhammakhīrañhi pāyitā."],"lineRefs":[[]]},{"para":2260,"vripara":null,"refs":[],"lines":["“Bandhanārakkhaṇe mayhaṃ, aṇaṇo tvaṃ mahāmune;"],"lineRefs":[[]]},{"para":2261,"vripara":null,"refs":[],"lines":["Puttakāmā thiyo yācaṃ, labhanti tādisaṃ sutaṃ."],"lineRefs":[[]]},{"para":2262,"vripara":null,"refs":[],"lines":["“Mandhātādinarindānaṃ, yā mātā sā bhavaṇṇave;"],"lineRefs":[[]]},{"para":2263,"vripara":null,"refs":[],"lines":["Nimuggāhaṃ tayā putta, tāritā bhavasāgarā."],"lineRefs":[[]]},{"para":2264,"vripara":null,"refs":[],"lines":["“Rañño mātā mahesīti, sulabhaṃ nāmamitthinaṃ;"],"lineRefs":[[]]},{"para":2265,"vripara":null,"refs":[],"lines":["Buddhamātāti yaṃ nāmaṃ, etaṃ paramadullabhaṃ."],"lineRefs":[[]]},{"para":2266,"vripara":null,"refs":[],"lines":["“Tañca laddhaṃ mahāvīra, paṇidhānaṃ mamaṃ tayā;"],"lineRefs":[[]]},{"para":2267,"vripara":null,"refs":[],"lines":["Aṇukaṃ vā mahantaṃ vā, taṃ sabbaṃ pūritaṃ mayā."],"lineRefs":[[]]},{"para":2268,"vripara":null,"refs":[],"lines":["“Parinibbātumicchāmi, vihāyemaṃ kaḷevaraṃ;"],"lineRefs":[[]]},{"para":2269,"vripara":null,"refs":[],"lines":["Anujānāhi me vīra, dukkhantakara nāyaka."],"lineRefs":[[]]},{"para":2270,"vripara":null,"refs":[],"lines":["“Cakkaṅkusadhajākiṇṇe, pāde kamalakomale;"],"lineRefs":[[]]},{"para":2271,"vripara":null,"refs":[],"lines":["Pasārehi paṇāmaṃ te, karissaṃ puttauttame."],"lineRefs":[[]]},{"para":2272,"vripara":null,"refs":[],"lines":["“Suvaṇṇarāsisaṅkāsaṃ, sarīraṃ kuru pākaṭaṃ;"],"lineRefs":[[]]},{"para":2273,"vripara":null,"refs":[],"lines":["Katvā dehaṃ sudiṭṭhaṃ te, santiṃ gacchāmi nāyaka."],"lineRefs":[[]]},{"para":2274,"vripara":null,"refs":[],"lines":["“Dvattiṃsalakkhaṇūpetaṃ, suppabhālaṅkataṃ tanuṃ;"],"lineRefs":[[]]},{"para":2275,"vripara":null,"refs":[],"lines":["Sañjhāghanāva bālakkaṃ, mātucchaṃ dassayī jino."],"lineRefs":[[]]},{"para":2276,"vripara":null,"refs":[],"lines":["“Phullāravindasaṃkāse, taruṇādiccasappabhe;"],"lineRefs":[[]]},{"para":2277,"vripara":null,"refs":[],"lines":["Cakkaṅkite pādatale, tato sā sirasā pati."],"lineRefs":[[]]},{"para":2278,"vripara":null,"refs":[],"lines":["“Paṇamāmi narādicca, ādiccakulaketukaṃ;"],"lineRefs":[[]]},{"para":2279,"vripara":null,"refs":[],"lines":["Pacchime maraṇe mayhaṃ, na taṃ ikkhāmahaṃ puno."],"lineRefs":[[]]},{"para":2280,"vripara":null,"refs":[],"lines":["“Itthiyo nāma lokagga, sabbadosākarā matā;"],"lineRefs":[[]]},{"para":2281,"vripara":null,"refs":[],"lines":["Yadi ko catthi doso me, khamassu karuṇākara."],"lineRefs":[[]]},{"para":2282,"vripara":null,"refs":[],"lines":["“Itthikānañca pabbajjaṃ, haṃ taṃ yāciṃ punappunaṃ;"],"lineRefs":[[]]},{"para":2283,"vripara":null,"refs":[],"lines":["Tattha ce atthi doso me, taṃ khamassu narāsabha."],"lineRefs":[[]]},{"para":2284,"vripara":null,"refs":[],"lines":["“Mayā bhikkhuniyo vīra, tavānuññāya sāsitā;"],"lineRefs":[[]]},{"para":2285,"vripara":null,"refs":[],"lines":["Tatra ce atthi dunnītaṃ, taṃ khamassu khamādhipa."],"lineRefs":[[]]},{"para":2286,"vripara":null,"refs":[],"lines":["“Akkhante nāma khantabbaṃ, kiṃ bhave guṇabhūsane;"],"lineRefs":[[]]},{"para":2287,"vripara":null,"refs":[],"lines":["Kimuttaraṃ te vatthāmi, nibbānāya vajantiyā."],"lineRefs":[[]]},{"para":2288,"vripara":null,"refs":[],"lines":["“Suddhe anūne mama bhikkhusaṅghe, lokā ito nissarituṃ khamante;"],"lineRefs":[[]]},{"para":2289,"vripara":null,"refs":[],"lines":["Pabhātakāle byasanaṅgatānaṃ, disvāna niyyātiva candalekhā."],"lineRefs":[[]]},{"para":2290,"vripara":null,"refs":[],"lines":["“Tadetarā bhikkhuniyo jinaggaṃ, tārāva candānugatā sumeruṃ;"],"lineRefs":[[]]},{"para":2291,"vripara":null,"refs":[],"lines":["Padakkhiṇaṃ kacca nipacca pāde, ṭhitā mukhantaṃ samudikkhamānā."],"lineRefs":[[]]},{"para":2292,"vripara":null,"refs":[],"lines":["“Na tittipubbaṃ tava dassanena, cakkhuṃ na sotaṃ tava bhāsitena;"],"lineRefs":[[]]},{"para":2293,"vripara":null,"refs":[],"lines":["Cittaṃ mamaṃ kevalamekameva, pappuyya taṃ dhammarasena titti."],"lineRefs":[[]]},{"para":2294,"vripara":null,"refs":[],"lines":["“Nadato parisāyaṃ te, vāditabbapahārino;"],"lineRefs":[[]]},{"para":2295,"vripara":null,"refs":[],"lines":["Ye te dakkhanti vadanaṃ, dhaññā te narapuṅgava."],"lineRefs":[[]]},{"para":2296,"vripara":null,"refs":[],"lines":["“Dīghaṅgulī tambanakhe, subhe āyatapaṇhike;"],"lineRefs":[[]]},{"para":2297,"vripara":null,"refs":[],"lines":["Ye pāde paṇamissanti, tepi dhaññā guṇandhara."],"lineRefs":[[]]},{"para":2298,"vripara":null,"refs":[],"lines":["“Madhurāni pahaṭṭhāni, dosagghāni hitāni ca;"],"lineRefs":[[]]},{"para":2299,"vripara":null,"refs":[],"lines":["Ye te vākyāni suyyanti, tepi dhaññā naruttama."],"lineRefs":[[]]},{"para":2300,"vripara":null,"refs":[],"lines":["“Dhaññāhaṃ te mahāvīra, pādapūjanatapparā;"],"lineRefs":[[]]},{"para":2301,"vripara":null,"refs":[],"lines":["Tiṇṇasaṃsārakantārā, suvākyena sirīmato."],"lineRefs":[[]]},{"para":2302,"vripara":null,"refs":[],"lines":["“Tato sā anusāvetvā, bhikkhusaṅghampi subbatā;"],"lineRefs":[[]]},{"para":2303,"vripara":null,"refs":[],"lines":["Rāhulānandanande ca, vanditvā idamabravi."],"lineRefs":[[]]},{"para":2304,"vripara":null,"refs":[],"lines":["“Āsīvisālayasame, rogāvāse kaḷevare;"],"lineRefs":[[]]},{"para":2305,"vripara":null,"refs":[],"lines":["Nibbindā dukkhasaṅghāṭe, jarāmaraṇagocare."],"lineRefs":[[]]},{"para":2306,"vripara":null,"refs":[],"lines":["“Nānākalimalākiṇṇe, parāyatte nirīhake;"],"lineRefs":[[]]},{"para":2307,"vripara":null,"refs":[],"lines":["Tena nibbātumicchāmi, anumaññatha puttakā."],"lineRefs":[[]]},{"para":2308,"vripara":null,"refs":[],"lines":["“Nando rāhulabhaddo ca, vītasokā nirāsavā;"],"lineRefs":[[]]},{"para":2309,"vripara":null,"refs":[],"lines":["Ṭhitācalaṭṭhiti thirā, dhammatamanucintayuṃ."],"lineRefs":[[]]},{"para":2310,"vripara":null,"refs":[],"lines":["“Dhiratthu saṅkhataṃ lolaṃ, asāraṃ kadalūpamaṃ;"],"lineRefs":[[]]},{"para":2311,"vripara":null,"refs":[],"lines":["Māyāmarīcisadisaṃ, ittaraṃ anavaṭṭhitaṃ."],"lineRefs":[[]]},{"para":2312,"vripara":null,"refs":[],"lines":["“Yattha nāma jinassāyaṃ, mātucchā buddhaposikā;"],"lineRefs":[[]]},{"para":2313,"vripara":null,"refs":[],"lines":["Gotamī nidhanaṃ yāti, aniccaṃ sabbasaṅkhataṃ."],"lineRefs":[[]]},{"para":2314,"vripara":null,"refs":[],"lines":["“Ānando ca tadā sekho, sokaṭṭo jinavacchalo;"],"lineRefs":[[]]},{"para":2315,"vripara":null,"refs":[],"lines":["Tatthassūni karonto so, karuṇaṃ paridevati."],"lineRefs":[[]]},{"para":2316,"vripara":null,"refs":[],"lines":["“Hā santiṃ gotamī yāti, nūna buddhopi nibbutiṃ;"],"lineRefs":[[]]},{"para":2317,"vripara":null,"refs":[],"lines":["Gacchati na cireneva, aggiriva nirindhano."],"lineRefs":[[]]},{"para":2318,"vripara":null,"refs":[],"lines":["“Evaṃ vilāpamānaṃ taṃ, ānandaṃ āha gotamī;"],"lineRefs":[[]]},{"para":2319,"vripara":null,"refs":[],"lines":["Sutasāgaragambhīra, buddhopaṭṭhāna tappara."],"lineRefs":[[]]},{"para":2320,"vripara":null,"refs":[],"lines":["“Na yuttaṃ socituṃ putta, hāsakāle upaṭṭhite;"],"lineRefs":[[]]},{"para":2321,"vripara":null,"refs":[],"lines":["Tayā me saraṇaṃ putta, nibbānaṃ tamupāgataṃ."],"lineRefs":[[]]},{"para":2322,"vripara":null,"refs":[],"lines":["“Tayā tāta samajjhiṭṭho, pabbajjaṃ anujāni no;"],"lineRefs":[[]]},{"para":2323,"vripara":null,"refs":[],"lines":["Mā putta vimano hohi, saphalo te parissamo."],"lineRefs":[[]]},{"para":2324,"vripara":null,"refs":[],"lines":["“Yaṃ na diṭṭhaṃ purāṇehi, titthikācariyehipi;"],"lineRefs":[[]]},{"para":2325,"vripara":null,"refs":[],"lines":["Taṃ padaṃ sukumārīhi, sattavassāhi veditaṃ."],"lineRefs":[[]]},{"para":2326,"vripara":null,"refs":[],"lines":["“Buddhasāsanapāleta, pacchimaṃ dassanaṃ tava;"],"lineRefs":[[]]},{"para":2327,"vripara":null,"refs":[],"lines":["Tattha gacchāmahaṃ putta, gato yattha na dissate."],"lineRefs":[[]]},{"para":2328,"vripara":null,"refs":[],"lines":["“Kadāci dhammaṃ desento, khipī lokagganāyako;"],"lineRefs":[[]]},{"para":2329,"vripara":null,"refs":[],"lines":["Tadāhaṃ āsīsavācaṃ, avocaṃ anukampikā."],"lineRefs":[[]]},{"para":2330,"vripara":null,"refs":[],"lines":["“Ciraṃ jīva mahāvīra, kappaṃ tiṭṭha mahāmune;"],"lineRefs":[[]]},{"para":2331,"vripara":null,"refs":[],"lines":["Sabbalokassa atthāya, bhavassu ajarāmaro."],"lineRefs":[[]]},{"para":2332,"vripara":null,"refs":[],"lines":["“Taṃ tathāvādiniṃ buddho, mamaṃ so etadabravi;"],"lineRefs":[[]]},{"para":2333,"vripara":null,"refs":[],"lines":["Na hevaṃ vandiyā buddhā, yathā vandasi gotamī."],"lineRefs":[[]]},{"para":2334,"vripara":null,"refs":[],"lines":["“Kathaṃ carahi sabbaññū, vanditabbā tathāgatā;"],"lineRefs":[[]]},{"para":2335,"vripara":null,"refs":[],"lines":["Kathaṃ avandiyā buddhā, taṃ me akkhāhi pucchito."],"lineRefs":[[]]},{"para":2336,"vripara":null,"refs":[],"lines":["“Āraddhavīriye pahitatte, niccaṃ daḷhaparakkame;"],"lineRefs":[[]]},{"para":2337,"vripara":null,"refs":[],"lines":["Samagge sāvake passa, etaṃ buddhānavandanaṃ."],"lineRefs":[[]]},{"para":2338,"vripara":null,"refs":[],"lines":["“Tato upassayaṃ gantvā, ekikāhaṃ vicintayiṃ;"],"lineRefs":[[]]},{"para":2339,"vripara":null,"refs":[],"lines":["Samaggaparisaṃ nātho, rodhesi tibhavantago."],"lineRefs":[[]]},{"para":2340,"vripara":null,"refs":[],"lines":["“Handāhaṃ parinibbissaṃ, mā vipattitamaddasaṃ;"],"lineRefs":[[]]},{"para":2341,"vripara":null,"refs":[],"lines":["Evāhaṃ cintayitvāna, disvāna isisattamaṃ."],"lineRefs":[[]]},{"para":2342,"vripara":null,"refs":[],"lines":["“Parinibbānakālaṃ me, ārocesiṃ vināyakaṃ;"],"lineRefs":[[]]},{"para":2343,"vripara":null,"refs":[],"lines":["Tato so samanuññāsi, kālaṃ jānāhi gotamī."],"lineRefs":[[]]},{"para":2344,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ, bhavā sabbe samūhatā;"],"lineRefs":[[]]},{"para":2345,"vripara":null,"refs":[],"lines":["Nāgova bandhanaṃ chetvā, viharāmi anāsavā."],"lineRefs":[[]]},{"para":2346,"vripara":null,"refs":[],"lines":["“Svāgataṃ vata me āsi, mama buddhassa santike;"],"lineRefs":[[]]},{"para":2347,"vripara":null,"refs":[],"lines":["Tisso vijjā anuppattā, kataṃ buddhassa sāsanaṃ."],"lineRefs":[[]]},{"para":2348,"vripara":null,"refs":[],"lines":["“Paṭisambhidā catasso, vimokkhāpi ca aṭṭhime;"],"lineRefs":[[]]},{"para":2349,"vripara":null,"refs":[],"lines":["Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanaṃ."],"lineRefs":[[]]},{"para":2350,"vripara":null,"refs":[],"lines":["“Thīnaṃ dhammābhisamaye, ye bālā vimatiṃ gatā;"],"lineRefs":[[]]},{"para":2351,"vripara":null,"refs":[],"lines":["Tesaṃ diṭṭhippahānatthaṃ, iddhiṃ dassehi gotamī."],"lineRefs":[[]]},{"para":2352,"vripara":null,"refs":[],"lines":["“Tadā nipacca sambuddhaṃ, uppatitvāna ambaraṃ;"],"lineRefs":[[]]},{"para":2353,"vripara":null,"refs":[],"lines":["Iddhī anekā dassesi, buddhānuññāya gotamī."],"lineRefs":[[]]},{"para":2354,"vripara":null,"refs":[],"lines":["“Ekikā bahudhā āsi, bahudhā cekikā tathā;"],"lineRefs":[[]]},{"para":2355,"vripara":null,"refs":[],"lines":["Āvibhāvaṃ tirobhāvaṃ, tirokuṭṭaṃ tironagaṃ."],"lineRefs":[[]]},{"para":2356,"vripara":null,"refs":[],"lines":["“Asajjamānā agamā, bhūmiyampi nimujjatha;"],"lineRefs":[[]]},{"para":2357,"vripara":null,"refs":[],"lines":["Abhijjamāne udake, agañchi mahiyā yathā."],"lineRefs":[[]]},{"para":2358,"vripara":null,"refs":[],"lines":["“Sakuṇīva tathākāse, pallaṅkena kamī tadā;"],"lineRefs":[[]]},{"para":2359,"vripara":null,"refs":[],"lines":["Vasaṃ vattesi kāyena, yāva brahmanivesanaṃ."],"lineRefs":[[]]},{"para":2360,"vripara":null,"refs":[],"lines":["“Sineruṃ daṇḍaṃ katvāna, chattaṃ katvā mahāmahiṃ;"],"lineRefs":[[]]},{"para":2361,"vripara":null,"refs":[],"lines":["Samūlaṃ parivattetvā, dhārayaṃ caṅkamī nabhe."],"lineRefs":[[]]},{"para":2362,"vripara":null,"refs":[],"lines":["“Chassūrodayakāleva, lokañcākāsi dhūmikaṃ;"],"lineRefs":[[]]},{"para":2363,"vripara":null,"refs":[],"lines":["Yugante viya lokaṃ sā, jālāmālākulaṃ akā."],"lineRefs":[[]]},{"para":2364,"vripara":null,"refs":[],"lines":["“Mucalindaṃ mahāselaṃ, merumūlanadantare;"],"lineRefs":[[]]},{"para":2365,"vripara":null,"refs":[],"lines":["Sāsapāriva sabbāni, ekenaggahi muṭṭhinā."],"lineRefs":[[]]},{"para":2366,"vripara":null,"refs":[],"lines":["“Aṅgulaggena chādesi, bhākaraṃ sanisākaraṃ;"],"lineRefs":[[]]},{"para":2367,"vripara":null,"refs":[],"lines":["Candasūrasahassāni, āveḷamiva dhārayi."],"lineRefs":[[]]},{"para":2368,"vripara":null,"refs":[],"lines":["“Catusāgaratoyāni, dhārayī ekapāṇinā;"],"lineRefs":[[]]},{"para":2369,"vripara":null,"refs":[],"lines":["Yugantajaladākāraṃ, mahāvassaṃ pavassatha."],"lineRefs":[[]]},{"para":2370,"vripara":null,"refs":[],"lines":["“Cakkavattiṃ saparisaṃ, māpayī sā nabhattale;"],"lineRefs":[[]]},{"para":2371,"vripara":null,"refs":[],"lines":["Garuḷaṃ dviradaṃ sīhaṃ, vinadantaṃ padassayi."],"lineRefs":[[]]},{"para":2372,"vripara":null,"refs":[],"lines":["“Ekikā abhinimmitvā, appameyyaṃ bhikkhunīgaṇaṃ;"],"lineRefs":[[]]},{"para":2373,"vripara":null,"refs":[],"lines":["Puna antaradhāpetvā, ekikā munimabravi."],"lineRefs":[[]]},{"para":2374,"vripara":null,"refs":[],"lines":["“Mātucchā te mahāvīra, tava sāsanakārikā;"],"lineRefs":[[]]},{"para":2375,"vripara":null,"refs":[],"lines":["Anuppattā sakaṃ atthaṃ, pāde vandāmi cakkhuma."],"lineRefs":[[]]},{"para":2376,"vripara":null,"refs":[],"lines":["“Dassetvā vividhā iddhī, orohitvā nabhattalā;"],"lineRefs":[[]]},{"para":2377,"vripara":null,"refs":[],"lines":["Vanditvā lokapajjotaṃ, ekamantaṃ nisīdi sā."],"lineRefs":[[]]},{"para":2378,"vripara":null,"refs":[],"lines":["“Sā vīsavassasatikā, jātiyāhaṃ mahāmune;"],"lineRefs":[[]]},{"para":2379,"vripara":null,"refs":[],"lines":["Alamettāvatā vīra, nibbāyissāmi nāyaka."],"lineRefs":[[]]},{"para":2380,"vripara":null,"refs":[],"lines":["“Tadātivimhitā sabbā, parisā sā katañjalī;"],"lineRefs":[[]]},{"para":2381,"vripara":null,"refs":[],"lines":["Avocayye kathaṃ āsi, atuliddhiparakkamā."],"lineRefs":[[]]},{"para":2382,"vripara":null,"refs":[],"lines":["“Padumuttaro nāma jino, sabbadhammesu cakkhumā;"],"lineRefs":[[]]},{"para":2383,"vripara":null,"refs":[],"lines":["Ito satasahassamhi, kappe uppajji nāyako."],"lineRefs":[[]]},{"para":2384,"vripara":null,"refs":[],"lines":["“Tadāhaṃ haṃsavatiyaṃ, jātāmaccakule ahuṃ;"],"lineRefs":[[]]},{"para":2385,"vripara":null,"refs":[],"lines":["Sabbopakārasampanne, iddhe phīte mahaddhane."],"lineRefs":[[]]},{"para":2386,"vripara":null,"refs":[],"lines":["“Kadāci pitunā saddhiṃ, dāsīgaṇapurakkhatā;"],"lineRefs":[[]]},{"para":2387,"vripara":null,"refs":[],"lines":["Mahatā parivārena, taṃ upecca narāsabhaṃ."],"lineRefs":[[]]},{"para":2388,"vripara":null,"refs":[],"lines":["“Vāsavaṃ viya vassantaṃ, dhammameghaṃ anāsavaṃ;"],"lineRefs":[[]]},{"para":2389,"vripara":null,"refs":[],"lines":["Saradādiccasadisaṃ, raṃsijālasamujjalaṃ."],"lineRefs":[[]]},{"para":2390,"vripara":null,"refs":[],"lines":["“Disvā cittaṃ pasādetvā, sutvā cassa subhāsitaṃ;"],"lineRefs":[[]]},{"para":2391,"vripara":null,"refs":[],"lines":["Mātucchaṃ bhikkhuniṃ agge, ṭhapentaṃ naranāyakaṃ."],"lineRefs":[[]]},{"para":2392,"vripara":null,"refs":[],"lines":["“Sutvā datvā mahādānaṃ, sattāhaṃ tassa tādino;"],"lineRefs":[[]]},{"para":2393,"vripara":null,"refs":[],"lines":["Sasaṅghassa naraggassa, paccayāni bahūni ca."],"lineRefs":[[]]},{"para":2394,"vripara":null,"refs":[],"lines":["“Nipacca pādamūlamhi, taṃ ṭhānamabhipatthayiṃ;"],"lineRefs":[[]]},{"para":2395,"vripara":null,"refs":[],"lines":["Tato mahāparisatiṃ, avoca isisattamo."],"lineRefs":[[]]},{"para":2396,"vripara":null,"refs":[],"lines":["“Yā sasaṅghaṃ abhojesi, sattāhaṃ lokanāyakaṃ;"],"lineRefs":[[]]},{"para":2397,"vripara":null,"refs":[],"lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."],"lineRefs":[[]]},{"para":2398,"vripara":null,"refs":[],"lines":["“Satasahassito kappe, okkākakulasambhavo;"],"lineRefs":[[]]},{"para":2399,"vripara":null,"refs":[],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[[]]},{"para":2400,"vripara":null,"refs":[],"lines":["Tassa dhammesu dāyādā, orasā dhammanimmitā;"],"lineRefs":[[]]},{"para":2401,"vripara":null,"refs":[],"lines":["Gotamī nāma nāmena, hessati satthu sāvikā."],"lineRefs":[[]]},{"para":2402,"vripara":null,"refs":[],"lines":["“Tassa buddhassa mātucchā, jīvitāpādikā ayaṃ;"],"lineRefs":[[]]},{"para":2403,"vripara":null,"refs":[],"lines":["Rattaññūnañca aggattaṃ, bhikkhunīnaṃ labhissati."],"lineRefs":[[]]},{"para":2404,"vripara":null,"refs":[],"lines":["“Taṃ sutvāna pamoditvā, yāvajīvaṃ tadā jinaṃ;"],"lineRefs":[[]]},{"para":2405,"vripara":null,"refs":[],"lines":["Paccayehi upaṭṭhitvā, tato kālaṅkatā ahaṃ."],"lineRefs":[[]]},{"para":2406,"vripara":null,"refs":[],"lines":["“Tāvatiṃsesu devesu, sabbakāmasamiddhisu;"],"lineRefs":[[]]},{"para":2407,"vripara":null,"refs":[],"lines":["Nibbattā dasahaṅgehi, aññe abhibhaviṃ ahaṃ."],"lineRefs":[[]]},{"para":2408,"vripara":null,"refs":[],"lines":["“Rūpasaddehi gandhehi, rasehi phusanehi ca;"],"lineRefs":[[]]},{"para":2409,"vripara":null,"refs":[],"lines":["Āyunāpi ca vaṇṇena, sukhena yasasāpi ca."],"lineRefs":[[]]},{"para":2410,"vripara":null,"refs":[],"lines":["“Tathevādhipateyyena, adhigayha virocahaṃ;"],"lineRefs":[[]]},{"para":2411,"vripara":null,"refs":[],"lines":["Ahosiṃ amarindassa, mahesī dayitā tahiṃ."],"lineRefs":[[]]},{"para":2412,"vripara":null,"refs":[],"lines":["“Saṃsāre saṃsarantīhaṃ, kammavāyusameritā;"],"lineRefs":[[]]},{"para":2413,"vripara":null,"refs":[],"lines":["Kāsissa rañño visaye, ajāyiṃ dāsagāmake."],"lineRefs":[[]]},{"para":2414,"vripara":null,"refs":[],"lines":["“Pañcadāsasatānūnā, nivasanti tahiṃ tadā;"],"lineRefs":[[]]},{"para":2415,"vripara":null,"refs":[],"lines":["Sabbesaṃ tattha yo jeṭṭho, tassa jāyā ahosahaṃ."],"lineRefs":[[]]},{"para":2416,"vripara":null,"refs":[],"lines":["“Sayambhuno pañcasatā, gāmaṃ piṇḍāya pāvisuṃ;"],"lineRefs":[[]]},{"para":2417,"vripara":null,"refs":[],"lines":["Te disvāna ahaṃ tuṭṭhā, saha sabbāhi itthibhi."],"lineRefs":[[]]},{"para":2418,"vripara":null,"refs":[],"lines":["“Pūgā hutvāva sabbāyo, catumāse upaṭṭhahuṃ;"],"lineRefs":[[]]},{"para":2419,"vripara":null,"refs":[],"lines":["Ticīvarāni datvāna, saṃsarimha sasāmikā."],"lineRefs":[[]]},{"para":2420,"vripara":null,"refs":[],"lines":["“Tato cutā sabbāpi tā, tāvatiṃsagatā mayaṃ;"],"lineRefs":[[]]},{"para":2421,"vripara":null,"refs":[],"lines":["Pacchime ca bhave dāni, jātā devadahe pure."],"lineRefs":[[]]},{"para":2422,"vripara":null,"refs":[],"lines":["“Pitā añjanasakko me, mātā mama sulakkhaṇā;"],"lineRefs":[[]]},{"para":2423,"vripara":null,"refs":[],"lines":["Tato kapilavatthusmiṃ, suddhodanagharaṃ gatā."],"lineRefs":[[]]},{"para":2424,"vripara":null,"refs":[],"lines":["“Sesā sakyakule jātā, sakyānaṃ gharamāgamuṃ;"],"lineRefs":[[]]},{"para":2425,"vripara":null,"refs":[],"lines":["Ahaṃ visiṭṭhā sabbāsaṃ, jinassāpādikā ahuṃ."],"lineRefs":[[]]},{"para":2426,"vripara":null,"refs":[],"lines":["“Mama puttobhinikkhamma, buddho āsi vināyako;"],"lineRefs":[[]]},{"para":2427,"vripara":null,"refs":[],"lines":["Pacchāhaṃ pabbajitvāna, satehi saha pañcahi."],"lineRefs":[[]]},{"para":2428,"vripara":null,"refs":[],"lines":["“Sākiyānīhi dhīrāhi, saha santisukhaṃ phusiṃ;"],"lineRefs":[[]]},{"para":2429,"vripara":null,"refs":[],"lines":["Ye tadā pubbajātiyaṃ, amhākaṃ āsu sāmino."],"lineRefs":[[]]},{"para":2430,"vripara":null,"refs":[],"lines":["“Sahapuññassa kattāro, mahāsamayakārakā;"],"lineRefs":[[]]},{"para":2431,"vripara":null,"refs":[],"lines":["Phusiṃsu arahattaṃ te, sugatenānukampitā."],"lineRefs":[[]]},{"para":2432,"vripara":null,"refs":[],"lines":["“Tadetarā bhikkhuniyo, āruhiṃsu nabhattalaṃ;"],"lineRefs":[[]]},{"para":2433,"vripara":null,"refs":[],"lines":["Saṃgatā viya tārāyo, virociṃsu mahiddhikā."],"lineRefs":[[]]},{"para":2434,"vripara":null,"refs":[],"lines":["“Iddhī anekā dassesuṃ, piḷandhavikatiṃ yathā;"],"lineRefs":[[]]},{"para":2435,"vripara":null,"refs":[],"lines":["Kammāro kanakasseva, kammaññassa susikkhito."],"lineRefs":[[]]},{"para":2436,"vripara":null,"refs":[],"lines":["“Dassetvā pāṭihīrāni, vicittāni bahūni ca;"],"lineRefs":[[]]},{"para":2437,"vripara":null,"refs":[],"lines":["Tosetvā vādipavaraṃ, muniṃ saparisaṃ tadā."],"lineRefs":[[]]},{"para":2438,"vripara":null,"refs":[],"lines":["“Orohitvāna gaganā, vanditvā isisattamaṃ;"],"lineRefs":[[]]},{"para":2439,"vripara":null,"refs":[],"lines":["Anuññātā naraggena, yathāṭhāne nisīdisuṃ."],"lineRefs":[[]]},{"para":2440,"vripara":null,"refs":[],"lines":["“Ahonukampikā amhaṃ, sabbāsaṃ cira gotamī;"],"lineRefs":[[]]},{"para":2441,"vripara":null,"refs":[],"lines":["Vāsitā tava puññehi, pattā no āsavakkhayaṃ."],"lineRefs":[[]]},{"para":2442,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā amhaṃ, bhavā sabbe samūhatā;"],"lineRefs":[[]]},{"para":2443,"vripara":null,"refs":[],"lines":["Nāgīva bandhanaṃ chetvā, viharāma anāsavā."],"lineRefs":[[]]},{"para":2444,"vripara":null,"refs":[],"lines":["“Svāgataṃ vata no āsi, buddhaseṭṭhassa santike;"],"lineRefs":[[]]},{"para":2445,"vripara":null,"refs":[],"lines":["Tisso vijjā anuppattā, kataṃ buddhassa sāsanaṃ."],"lineRefs":[[]]},{"para":2446,"vripara":null,"refs":[],"lines":["“Paṭisambhidā catasso, vimokkhāpi ca aṭṭhime;"],"lineRefs":[[]]},{"para":2447,"vripara":null,"refs":[],"lines":["Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanaṃ."],"lineRefs":[[]]},{"para":2448,"vripara":null,"refs":[],"lines":["“Iddhīsu ca vasī homa, dibbāya sotadhātuyā;"],"lineRefs":[[]]},{"para":2449,"vripara":null,"refs":[],"lines":["Cetopariyañāṇassa, vasī homa mahāmune."],"lineRefs":[[]]},{"para":2450,"vripara":null,"refs":[],"lines":["“Pubbenivāsaṃ jānāma, dibbacakkhu visodhitaṃ;"],"lineRefs":[[]]},{"para":2451,"vripara":null,"refs":[],"lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavā."],"lineRefs":[[]]},{"para":2452,"vripara":null,"refs":[],"lines":["“Atthe dhamme ca nerutte, paṭibhāne ca vijjati;"],"lineRefs":[[]]},{"para":2453,"vripara":null,"refs":[],"lines":["Ñāṇaṃ amhaṃ mahāvīra, uppannaṃ tava santike."],"lineRefs":[[]]},{"para":2454,"vripara":null,"refs":[],"lines":["“Asmābhi pariciṇṇosi, mettacittā hi nāyaka;"],"lineRefs":[[]]},{"para":2455,"vripara":null,"refs":[],"lines":["Anujānāhi sabbāsaṃ, nibbānāya mahāmune."],"lineRefs":[[]]},{"para":2456,"vripara":null,"refs":[],"lines":["“Nibbāyissāma iccevaṃ, kiṃ vakkhāmi vadantiyo;"],"lineRefs":[[]]},{"para":2457,"vripara":null,"refs":[],"lines":["Yassa dāni ca vo kālaṃ, maññathāti jinobravi."],"lineRefs":[[]]},{"para":2458,"vripara":null,"refs":[],"lines":["“Gotamīādikā tāyo, tadā bhikkhuniyo jinaṃ;"],"lineRefs":[[]]},{"para":2459,"vripara":null,"refs":[],"lines":["Vanditvā āsanā tamhā, vuṭṭhāya āgamiṃsu tā."],"lineRefs":[[]]},{"para":2460,"vripara":null,"refs":[],"lines":["“Mahatā janakāyena, saha lokagganāyako;"],"lineRefs":[[]]},{"para":2461,"vripara":null,"refs":[],"lines":["Anusaṃyāyī so vīro, mātucchaṃ yāvakoṭṭhakaṃ."],"lineRefs":[[]]},{"para":2462,"vripara":null,"refs":[],"lines":["“Tadā nipati pādesu, gotamī lokabandhuno;"],"lineRefs":[[]]},{"para":2463,"vripara":null,"refs":[],"lines":["Saheva tāhi sabbāhi, pacchimaṃ pādavandanaṃ."],"lineRefs":[[]]},{"para":2464,"vripara":null,"refs":[],"lines":["“Idaṃ pacchimakaṃ mayhaṃ, lokanāthassa dassanaṃ;"],"lineRefs":[[]]},{"para":2465,"vripara":null,"refs":[],"lines":["Na puno amatākāraṃ, passissāmi mukhaṃ tava."],"lineRefs":[[]]},{"para":2466,"vripara":null,"refs":[],"lines":["“Na ca me vandanaṃ vīra, tava pāde sukomale;"],"lineRefs":[[]]},{"para":2467,"vripara":null,"refs":[],"lines":["Samphusissati lokagga, ajja gacchāmi nibbutiṃ."],"lineRefs":[[]]},{"para":2468,"vripara":null,"refs":[],"lines":["“Rūpena kiṃ tavānena, diṭṭhe dhamme yathātathe;"],"lineRefs":[[]]},{"para":2469,"vripara":null,"refs":[],"lines":["Sabbaṃ saṅkhatamevetaṃ, anassāsikamittaraṃ."],"lineRefs":[[]]},{"para":2470,"vripara":null,"refs":[],"lines":["“Sā saha tāhi gantvāna, bhikkhunupassayaṃ sakaṃ;"],"lineRefs":[[]]},{"para":2471,"vripara":null,"refs":[],"lines":["Aḍḍhapallaṅkamābhujja, nisīdi paramāsane."],"lineRefs":[[]]},{"para":2472,"vripara":null,"refs":[],"lines":["“Tadā upāsikā tattha, buddhasāsanavacchalā;"],"lineRefs":[[]]},{"para":2473,"vripara":null,"refs":[],"lines":["Tassā pavattiṃ sutvāna, upesuṃ pādavandikā."],"lineRefs":[[]]},{"para":2474,"vripara":null,"refs":[],"lines":["“Karehi uraṃ pahantā, chinnamūlā yathā latā;"],"lineRefs":[[]]},{"para":2475,"vripara":null,"refs":[],"lines":["Rodantā karuṇaṃ ravaṃ, sokaṭṭā bhūmipātitā."],"lineRefs":[[]]},{"para":2476,"vripara":null,"refs":[],"lines":["“Mā no saraṇade nāthe, vihāya gami nibbutiṃ;"],"lineRefs":[[]]},{"para":2477,"vripara":null,"refs":[],"lines":["Nipatitvāna yācāma, sabbāyo sirasā mayaṃ."],"lineRefs":[[]]},{"para":2478,"vripara":null,"refs":[],"lines":["“Yā padhānatamā tāsaṃ, saddhā paññā upāsikā;"],"lineRefs":[[]]},{"para":2479,"vripara":null,"refs":[],"lines":["Tassā sīsaṃ pamajjantī, idaṃ vacanamabravi."],"lineRefs":[[]]},{"para":2480,"vripara":null,"refs":[],"lines":["“Alaṃ puttā visādena, mārapāsānuvattinā;"],"lineRefs":[[]]},{"para":2481,"vripara":null,"refs":[],"lines":["Aniccaṃ saṅkhataṃ sabbaṃ, viyogantaṃ calācalaṃ."],"lineRefs":[[]]},{"para":2482,"vripara":null,"refs":[],"lines":["“Tato sā tā visajjitvā, paṭhamaṃ jhānamuttamaṃ;"],"lineRefs":[[]]},{"para":2483,"vripara":null,"refs":[],"lines":["Dutiyañca tatiyañca, samāpajji catutthakaṃ."],"lineRefs":[[]]},{"para":2484,"vripara":null,"refs":[],"lines":["“Ākāsāyatanañceva, viññāṇāyatanaṃ tathā;"],"lineRefs":[[]]},{"para":2485,"vripara":null,"refs":[],"lines":["Ākiñcaṃ nevasaññañca, samāpajji yathākkamaṃ."],"lineRefs":[[]]},{"para":2486,"vripara":null,"refs":[],"lines":["“Paṭilomena jhānāni, samāpajjittha gotamī;"],"lineRefs":[[]]},{"para":2487,"vripara":null,"refs":[],"lines":["Yāvatā paṭhamaṃ jhānaṃ, tato yāvacatutthakaṃ."],"lineRefs":[[]]},{"para":2488,"vripara":null,"refs":[],"lines":["“Tato vuṭṭhāya nibbāyi, dīpaccīva nirāsavā;"],"lineRefs":[[]]},{"para":2489,"vripara":null,"refs":[],"lines":["Bhūmicālo mahā āsi, nabhasā vijjutā pati."],"lineRefs":[[]]},{"para":2490,"vripara":null,"refs":[],"lines":["“Panāditā dundubhiyo, parideviṃsu devatā;"],"lineRefs":[[]]},{"para":2491,"vripara":null,"refs":[],"lines":["Pupphavuṭṭhī ca gaganā, abhivassatha medaniṃ."],"lineRefs":[[]]},{"para":2492,"vripara":null,"refs":[],"lines":["“Kampito merurājāpi, raṅgamajjhe yathā naṭo;"],"lineRefs":[[]]},{"para":2493,"vripara":null,"refs":[],"lines":["Sokena cātidīnova, viravo āsi sāgaro."],"lineRefs":[[]]},{"para":2494,"vripara":null,"refs":[],"lines":["“Devā nāgāsurā brahmā, saṃviggāhiṃsu taṅkhaṇe;"],"lineRefs":[[]]},{"para":2495,"vripara":null,"refs":[],"lines":["Aniccā vata saṅkhārā, yathāyaṃ vilayaṃ gatā."],"lineRefs":[[]]},{"para":2496,"vripara":null,"refs":[],"lines":["“Yā ce maṃ parivāriṃsu, satthu sāsanakārikā;"],"lineRefs":[[]]},{"para":2497,"vripara":null,"refs":[],"lines":["Tayopi anupādānā, dīpacci viya nibbutā."],"lineRefs":[[]]},{"para":2498,"vripara":null,"refs":[],"lines":["“Hā yogā vippayogantā, hāniccaṃ sabbasaṅkhataṃ;"],"lineRefs":[[]]},{"para":2499,"vripara":null,"refs":[],"lines":["Hā jīvitaṃ vināsantaṃ, iccāsi paridevanā."],"lineRefs":[[]]},{"para":2500,"vripara":null,"refs":[],"lines":["“Tato devā ca brahmā ca, lokadhammānuvattanaṃ;"],"lineRefs":[[]]},{"para":2501,"vripara":null,"refs":[],"lines":["Kālānurūpaṃ kubbanti, upetvā isisattamaṃ."],"lineRefs":[[]]},{"para":2502,"vripara":null,"refs":[],"lines":["“Tadā āmantayī satthā, ānandaṃ sutasāgaraṃ;"],"lineRefs":[[]]},{"para":2503,"vripara":null,"refs":[],"lines":["Gacchānanda nivedehi, bhikkhūnaṃ mātu nibbutiṃ."],"lineRefs":[[]]},{"para":2504,"vripara":null,"refs":[],"lines":["“Tadānando nirānando, assunā puṇṇalocano;"],"lineRefs":[[]]},{"para":2505,"vripara":null,"refs":[],"lines":["Gaggarena sarenāha, samāgacchantu bhikkhavo."],"lineRefs":[[]]},{"para":2506,"vripara":null,"refs":[],"lines":["“Pubbadakkhiṇapacchāsu, uttarāya ca santike;"],"lineRefs":[[]]},{"para":2507,"vripara":null,"refs":[],"lines":["Suṇantu bhāsitaṃ mayhaṃ, bhikkhavo sugatorasā."],"lineRefs":[[]]},{"para":2508,"vripara":null,"refs":[],"lines":["“Yā vaḍḍhayi payattena, sarīraṃ pacchimaṃ mune;"],"lineRefs":[[]]},{"para":2509,"vripara":null,"refs":[],"lines":["Sā gotamī gatā santiṃ, tārāva sūriyodaye."],"lineRefs":[[]]},{"para":2510,"vripara":null,"refs":[],"lines":["“Buddhamātāpi paññattiṃ, ṭhapayitvā gatāsamaṃ;"],"lineRefs":[[]]},{"para":2511,"vripara":null,"refs":[],"lines":["Na yattha pañcanettopi, gatiṃ dakkhati nāyako."],"lineRefs":[[]]},{"para":2512,"vripara":null,"refs":[],"lines":["“Yassatthi sugate saddhā, yo ca piyo mahāmune;"],"lineRefs":[[]]},{"para":2513,"vripara":null,"refs":[],"lines":["Buddhamātussa sakkāraṃ, karotu sugatoraso."],"lineRefs":[[]]},{"para":2514,"vripara":null,"refs":[],"lines":["“Sudūraṭṭhāpi taṃ sutvā, sīghamāgacchu bhikkhavo;"],"lineRefs":[[]]},{"para":2515,"vripara":null,"refs":[],"lines":["Keci buddhānubhāvena, keci iddhīsu kovidā."],"lineRefs":[[]]},{"para":2516,"vripara":null,"refs":[],"lines":["“Kūṭāgāravare ramme, sabbasoṇṇamaye subhe;"],"lineRefs":[[]]},{"para":2517,"vripara":null,"refs":[],"lines":["Mañcakaṃ samāropesuṃ, yattha suttāsi gotamī."],"lineRefs":[[]]},{"para":2518,"vripara":null,"refs":[],"lines":["“Cattāro lokapālā te, aṃsehi samadhārayuṃ;"],"lineRefs":[[]]},{"para":2519,"vripara":null,"refs":[],"lines":["Sesā sakkādikā devā, kūṭāgāre samaggahuṃ."],"lineRefs":[[]]},{"para":2520,"vripara":null,"refs":[],"lines":["“Kūṭāgārāni sabbāni, āsuṃ pañcasatānipi;"],"lineRefs":[[]]},{"para":2521,"vripara":null,"refs":[],"lines":["Saradādiccavaṇṇāni, vissakammakatāni hi."],"lineRefs":[[]]},{"para":2522,"vripara":null,"refs":[],"lines":["“Sabbā tāpi bhikkhuniyo, āsuṃ mañcesu sāyitā;"],"lineRefs":[[]]},{"para":2523,"vripara":null,"refs":[],"lines":["Devānaṃ khandhamāruḷhā, niyyanti anupubbaso."],"lineRefs":[[]]},{"para":2524,"vripara":null,"refs":[],"lines":["“Sabbaso chāditaṃ āsi, vitānena nabhattalaṃ;"],"lineRefs":[[]]},{"para":2525,"vripara":null,"refs":[],"lines":["Satārā candasūrā ca, lañchitā kanakāmayā."],"lineRefs":[[]]},{"para":2526,"vripara":null,"refs":[],"lines":["“Paṭākā ussitānekā, vitatā pupphakañcukā;"],"lineRefs":[[]]},{"para":2527,"vripara":null,"refs":[],"lines":["Ogatākāsapadumā, mahiyā pupphamuggataṃ."],"lineRefs":[[]]},{"para":2528,"vripara":null,"refs":[],"lines":["“Dissanti candasūriyā, pajjalanti ca tārakā;"],"lineRefs":[[]]},{"para":2529,"vripara":null,"refs":[],"lines":["Majjhaṃ gatopi cādicco, na tāpesi sasī yathā."],"lineRefs":[[]]},{"para":2530,"vripara":null,"refs":[],"lines":["“Devā dibbehi gandhehi, mālehi surabhīhi ca;"],"lineRefs":[[]]},{"para":2531,"vripara":null,"refs":[],"lines":["Vāditehi ca naccehi, saṅgītīhi ca pūjayuṃ."],"lineRefs":[[]]},{"para":2532,"vripara":null,"refs":[],"lines":["“Nāgāsurā ca brahmāno, yathāsatti yathābalaṃ;"],"lineRefs":[[]]},{"para":2533,"vripara":null,"refs":[],"lines":["Pūjayiṃsu ca niyyantiṃ, nibbutaṃ buddhamātaraṃ."],"lineRefs":[[]]},{"para":2534,"vripara":null,"refs":[],"lines":["“Sabbāyo purato nītā, nibbutā sugatorasā;"],"lineRefs":[[]]},{"para":2535,"vripara":null,"refs":[],"lines":["Gotamī niyyate pacchā, sakkatā buddhaposikā."],"lineRefs":[[]]},{"para":2536,"vripara":null,"refs":[],"lines":["“Purato devamanujā, sanāgāsurabrahmakā;"],"lineRefs":[[]]},{"para":2537,"vripara":null,"refs":[],"lines":["Pacchā sasāvako buddho, pūjatthaṃ yāti mātuyā."],"lineRefs":[[]]},{"para":2538,"vripara":null,"refs":[],"lines":["“Buddhassa parinibbānaṃ, nedisaṃ āsi yādisaṃ;"],"lineRefs":[[]]},{"para":2539,"vripara":null,"refs":[],"lines":["Gotamīparinibbānaṃ, atevacchariyaṃ ahu."],"lineRefs":[[]]},{"para":2540,"vripara":null,"refs":[],"lines":["“Buddho buddhassa nibbāne, nopaṭiyādi bhikkhavo;"],"lineRefs":[[]]},{"para":2541,"vripara":null,"refs":[],"lines":["Buddho gotaminibbāne, sāriputtādikā tathā."],"lineRefs":[[]]},{"para":2542,"vripara":null,"refs":[],"lines":["“Citakāni karitvāna, sabbagandhamayāni te;"],"lineRefs":[[]]},{"para":2543,"vripara":null,"refs":[],"lines":["Gandhacuṇṇapakiṇṇāni, jhāpayiṃsu ca tā tahiṃ."],"lineRefs":[[]]},{"para":2544,"vripara":null,"refs":[],"lines":["“Sesabhāgāni ḍayhiṃsu, aṭṭhī sesāni sabbaso;"],"lineRefs":[[]]},{"para":2545,"vripara":null,"refs":[],"lines":["Ānando ca tadāvoca, saṃvegajanakaṃ vaco."],"lineRefs":[[]]},{"para":2546,"vripara":null,"refs":[],"lines":["“Gotamī nidhanaṃ yātā, ḍayhañcassa sarīrakaṃ;"],"lineRefs":[[]]},{"para":2547,"vripara":null,"refs":[],"lines":["Saṅketaṃ buddhanibbānaṃ, na cirena bhavissati."],"lineRefs":[[]]},{"para":2548,"vripara":null,"refs":[],"lines":["“Tato gotamidhātūni, tassā pattagatāni so;"],"lineRefs":[[]]},{"para":2549,"vripara":null,"refs":[],"lines":["Upanāmesi nāthassa, ānando buddhacodito."],"lineRefs":[[]]},{"para":2550,"vripara":null,"refs":[],"lines":["“Pāṇinā tāni paggayha, avoca isisattamo;"],"lineRefs":[[]]},{"para":2551,"vripara":null,"refs":[],"lines":["Mahato sāravantassa, yathā rukkhassa tiṭṭhato."],"lineRefs":[[]]},{"para":2552,"vripara":null,"refs":[],"lines":["“Yo so mahattaro khandho, palujjeyya aniccatā;"],"lineRefs":[[]]},{"para":2553,"vripara":null,"refs":[],"lines":["Tathā bhikkhunisaṅghassa, gotamī parinibbutā."],"lineRefs":[[]]},{"para":2554,"vripara":null,"refs":[],"lines":["“Aho acchariyaṃ mayhaṃ, nibbutāyapi mātuyā;"],"lineRefs":[[]]},{"para":2555,"vripara":null,"refs":[],"lines":["Sārīramattasesāya, natthi sokapariddavo."],"lineRefs":[[]]},{"para":2556,"vripara":null,"refs":[],"lines":["“Na sociyā paresaṃ sā, tiṇṇasaṃsārasāgarā;"],"lineRefs":[[]]},{"para":2557,"vripara":null,"refs":[],"lines":["Parivajjitasantāpā, sītibhūtā sunibbutā."],"lineRefs":[[]]},{"para":2558,"vripara":null,"refs":[],"lines":["“Paṇḍitāsi mahāpaññā, puthupaññā tatheva ca;"],"lineRefs":[[]]},{"para":2559,"vripara":null,"refs":[],"lines":["Rattaññū bhikkhunīnaṃ sā, evaṃ dhāretha bhikkhavo."],"lineRefs":[[]]},{"para":2560,"vripara":null,"refs":[],"lines":["“Iddhīsu ca vasī āsi, dibbāya sotadhātuyā;"],"lineRefs":[[]]},{"para":2561,"vripara":null,"refs":[],"lines":["Cetopariyañāṇassa, vasī āsi ca gotamī."],"lineRefs":[[]]},{"para":2562,"vripara":null,"refs":[],"lines":["“Pubbenivāsamaññāsi, dibbacakkhu visodhitaṃ;"],"lineRefs":[[]]},{"para":2563,"vripara":null,"refs":[],"lines":["Sabbāsavaparikkhīṇā, natthi tassā punabbhavo."],"lineRefs":[[]]},{"para":2564,"vripara":null,"refs":[],"lines":["“Atthadhammaniruttīsu, paṭibhāne tatheva ca;"],"lineRefs":[[]]},{"para":2565,"vripara":null,"refs":[],"lines":["Parisuddhaṃ ahu ñāṇaṃ, tasmā socaniyā na sā."],"lineRefs":[[]]},{"para":2566,"vripara":null,"refs":[],"lines":["“Ayoghanahatasseva, jalato jātavedassa;"],"lineRefs":[[]]},{"para":2567,"vripara":null,"refs":[],"lines":["Anupubbūpasantassa, yathā na ñāyate gati."],"lineRefs":[[]]},{"para":2568,"vripara":null,"refs":[],"lines":["“Evaṃ sammā vimuttānaṃ, kāmabandhoghatārinaṃ;"],"lineRefs":[[]]},{"para":2569,"vripara":null,"refs":[],"lines":["Paññāpetuṃ gati natthi, pattānaṃ acalaṃ sukhaṃ."],"lineRefs":[[]]},{"para":2570,"vripara":null,"refs":[],"lines":["“Attadīpā tato hotha, satipaṭṭhānagocarā;"],"lineRefs":[[]]},{"para":2571,"vripara":null,"refs":[],"lines":["Bhāvetvā sattabojjhaṅge, dukkhassantaṃ karissathā”ti.(apa. therī 2.2.97-288);"],"lineRefs":[[]]},{"para":2572,"vripara":null,"refs":[],"lines":["Mahāpajāpatigotamītherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2573,"vripara":null,"refs":[],"lines":["Guttātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":2574,"vripara":null,"refs":[],"lines":["<b>Gutte yadatthaṃ pabbajjā</b>tiādikā guttāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī anukkamena sambhatavimokkhasambhārā hutvā, paripakkakusalamūlā sugatīsuyeva saṃsarantī imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇakule nibbattā, <b>guttā</b>tissā nāmaṃ ahosi.","Sā viññutaṃ patvā upanissayasampattiyā codiyamānā gharāvāsaṃ jigucchantī mātāpitaro anujānāpetvā mahāpajāpatigotamiyā santike pabbaji.","Pabbajitvā ca vipassanaṃ paṭṭhapetvā bhāvanaṃ anuyuñjantiyā tassā cittaṃ cirakālaparicayena bahiddhārammaṇe vidhāvati, ekaggaṃ nāhosi.","Satthā disvā taṃ anuggaṇhanto, gandhakuṭiyaṃ yathānisinnova obhāsaṃ pharitvā tassā āsanne ākāse nisinnaṃ viya attānaṃ dassetvā ovadanto –"],"lineRefs":[[],[],[],[],[]]},{"para":2576,"vripara":"163","refs":[],"lines":["“Gutte yadatthaṃ pabbajjā, hitvā puttaṃ vasuṃ piyaṃ;"],"lineRefs":[[]]},{"para":2577,"vripara":null,"refs":[],"lines":["Tameva anubrūhehi, mā cittassa vasaṃ gami."],"lineRefs":[[]]},{"para":2579,"vripara":"164","refs":[],"lines":["“Cittena vañcitā sattā, mārassa visaye ratā;"],"lineRefs":[[]]},{"para":2580,"vripara":null,"refs":[],"lines":["Anekajātisaṃsāraṃ, sandhāvanti aviddasū."],"lineRefs":[[]]},{"para":2582,"vripara":"165","refs":[],"lines":["“Kāmācchandañca byāpādaṃ, sakkāyadiṭṭhimeva ca;"],"lineRefs":[[]]},{"para":2583,"vripara":null,"refs":[],"lines":["Sīlabbataparāmāsaṃ, vicikicchaṃ ca pañcamaṃ."],"lineRefs":[[]]},{"para":2585,"vripara":"166","refs":[],"lines":["“Saṃyojanāni etāni, pajahitvāna bhikkhunī;"],"lineRefs":[[]]},{"para":2586,"vripara":null,"refs":[],"lines":["Orambhāgamanīyāni, nayidaṃ punarehisi."],"lineRefs":[[]]},{"para":2588,"vripara":"167","refs":[],"lines":["“Rāgaṃ mānaṃ avijjañca, uddhaccañca vivajjiya;"],"lineRefs":[[]]},{"para":2589,"vripara":null,"refs":[],"lines":["Saṃyojanāni chetvāna, dukkhassantaṃ karissasi."],"lineRefs":[[]]},{"para":2591,"vripara":"168","refs":[],"lines":["“Khepetvā jātisaṃsāraṃ, pariññāya punabbhavaṃ;"],"lineRefs":[[]]},{"para":2592,"vripara":null,"refs":[],"lines":["Diṭṭheva dhamme nicchātā, upasantā carissasī”ti.","– imā gāthā ābhāsi;"],"lineRefs":[[],[]]},{"para":2593,"vripara":null,"refs":[],"lines":["Tattha <b>tameva anubrūhehī</b>ti <b>yadatthaṃ</b> yassa kilesaparinibbānassa khandhaparinibbānassa ca atthāya.","<b>Hitvā puttaṃ vasuṃ piyan</b>ti piyāyitabbaṃ ñātiparivaṭṭaṃ bhogakkhandhañca hitvā mama sāsane <b>pabbajjā</b> brahmacariyavāso icchito, tameva vaḍḍheyyāsi sampādeyyāsi.","<b>Mā cittassa vasaṃ gamī</b>ti dīgharattaṃ rūpādiārammaṇavasena vaḍḍhitassa kūṭacittassa vasaṃ mā gacchi."],"lineRefs":[[],[],[]]},{"para":2594,"vripara":null,"refs":[],"lines":["Yasmā cittaṃ nāmetaṃ māyūpamaṃ, yena vañcitā andhaputhujjanā māravasānugā saṃsāraṃ nātivattanti.","Tena vuttaṃ <b>“cittena vañcitā”</b>tiādi."],"lineRefs":[[],[]]},{"para":2595,"vripara":null,"refs":[],"lines":["<b>Saṃyojanāni etānī</b>ti etāni <b>“kāmacchandañca byāpādan”</b>tiādinā yathāvuttāni pañca bandhanaṭṭhena saṃyojanāni.","<b>Pajahitvānā</b>ti anāgāmimaggena samucchinditvā.","<b>Bhikkhunī</b>ti tassā ālapanaṃ.","<b>Orambhāgamanīyānī</b>ti rūpārūpadhātuto heṭṭhābhāge kāmadhātuyaṃ manussajīvassa hitāni upakārāni tattha paṭisandhiyā paccayabhāvato.","Ma-kāro padasandhikaro.","“Oramāgamanīyānī”ti pāḷi, so evattho.","<b>Nayidaṃ punarehisī</b>ti orambhāgiyānaṃ saṃyojanānaṃ pahānena idaṃ kāmaṭṭhānaṃ kāmabhavaṃ paṭisandhivasena puna nāgamissasi.","Ra-kāro padasandhikaro.","“Itthan”ti vā pāḷi, itthattaṃ kāmabhavamicceva attho."],"lineRefs":[[],[],[],[],[],[],[],[],[]]},{"para":2596,"vripara":null,"refs":[],"lines":["<b>Rāgan</b>ti rūparāgañca arūparāgañca.","<b>Mānan</b>ti aggamaggavajjhaṃ mānaṃ.","<b>Avijjañca uddhaccañcā</b>ti etthāpi eseva nayo.","<b>Vivajjiyā</b>ti vipassanāya vikkhambhetvā.","<b>Saṃyojanāni chetvānā</b>ti etāni rūparāgādīni pañcuddhambhāgiyāni saṃyojanāni arahattamaggena samucchinditvā.","<b>Dukkhassantaṃ karissasī</b>ti sabbassāpi vaṭṭadukkhassa pariyantaṃ pariyosānaṃ pāpuṇissasi."],"lineRefs":[[],[],[],[],[],[]]}]},"tika":null,"tika2":null}
