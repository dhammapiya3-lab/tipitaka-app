{"suttaId":"thig6.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[629,647],"vripara":"163"},"segments":{"thig6.7:0.3":"Guttātherīgāthā","thig6.7:1.1":"“Gutte yadatthaṃ pabbajjā, hitvā puttaṃ vasuṃ piyaṃ;","thig6.7:1.3":"Tameva anubrūhehi, mā cittassa vasaṃ gami.","thig6.7:2.1":"“Cittena vañcitā sattā, mārassa visaye ratā;","thig6.7:2.3":"Anekajātisaṃsāraṃ, sandhāvanti aviddasū.","thig6.7:3.1":"“Kāmacchandañca byāpādaṃ, sakkāyadiṭṭhimeva ca;","thig6.7:3.3":"Sīlabbataparāmāsaṃ, vicikicchañca pañcamaṃ.","thig6.7:4.1":"“Saṃyojanāni etāni, pajahitvāna bhikkhunī;","thig6.7:4.3":"Orambhāgamanīyāni, nayidaṃ punarehisi.","thig6.7:5.1":"“Rāgaṃ mānaṃ avijjañca, uddhaccañca vivajjiya;","thig6.7:5.3":"Saṃyojanāni chetvāna, dukkhassantaṃ karissasi.","thig6.7:6.1":"“Khepetvā jātisaṃsāraṃ, pariññāya punabbhavaṃ;","thig6.7:6.3":"Diṭṭheva dhamme nicchātā, upasantā carissatī”ti.","thig6.7:7.1":"… Guttā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":2597,"to":2597,"paras":[{"para":2597,"vripara":null,"refs":["thig6.7:6"],"lines":["<b>Khepetvā jātisaṃsāran</b>ti jāti samūlikasaṃsārapavattiṃ pariyosāpetvā.","<b>Nicchātā</b>ti nittaṇhā.","<b>Upasantā</b>ti sabbaso kilesānaṃ vūpasamena upasantā.","Sesaṃ vuttanayameva."],"lineRefs":[["thig6.7:6"],["thig6.7:6"],["thig6.7:6"],["thig6.7:6"]]}],"wordLinks":[["thig6.7:6.1","khepetvā jātisaṃsāraṃ",0,0],["thig6.7:6.3","nicchātā",0,1],["thig6.7:6.3","upasantā",0,2]]},"tika":null}
