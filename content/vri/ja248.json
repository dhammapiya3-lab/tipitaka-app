{"suttaId":"ja248","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1711,1717],"vripara":"196"},"segments":{"ja248:0.4":"Kiṃsukopamajātakaṃ (2-10-8)","ja248:1.1":"Sabbehi kiṃsuko diṭṭho, kiṃnvettha vicikicchatha;","ja248:1.3":"Na hi sabbesu ṭhānesu,","ja248:1.4":"sārathī paripucchito. 197.","ja248:2.1":"Evaṃ sabbehi ñāṇehi,","ja248:2.2":"yesaṃ dhammā ajānitā;","ja248:2.3":"Te ve dhammesu kaṅkhanti,","ja248:2.4":"kiṃsukasmiṃva bhātaroti.","ja248:3.1":"Kiṃsukopamajātakaṃ aṭṭhamaṃ. 249."},"unsure":["ja248:1.1"],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1729,"to":1729,"paras":[{"para":1729,"vripara":null,"refs":["ja248:1"],"lines":["Tattha <b>na hi sabbesu ṭhānesu, sārathī paripucchito</b>ti sabbehi vo kiṃsuko diṭṭho, kiṃ nu tumhe ettha vicikicchatha, sabbesu ṭhānesu kiṃsukoveso, tumhehi pana na hi sabbesu ṭhānesu sārathi paripucchito, tena vo kaṅkhā uppannāti."],"lineRefs":[["ja248:1"]]}],"wordLinks":[["ja248:1.3","na hi sabbesu ṭhānesu sārathī paripucchito",0,0]]},"tika":null,"tika2":null}
