{"suttaId":"an5.125","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[863,864],"vripara":"125"},"segments":{"an5.125:0.3":"Paṭhamaanāyussāsuttaṃ","an5.125:1.1":"“Pañcime, bhikkhave, dhammā anāyussā.","an5.125:1.2":"Katame pañca?","an5.125:1.3":"Asappāyakārī hoti, sappāye mattaṃ na jānāti, apariṇatabhojī ca hoti, akālacārī ca hoti, abrahmacārī ca.","an5.125:1.4":"Ime kho, bhikkhave, pañca dhammā anāyussā.","an5.125:2.1":"“Pañcime, bhikkhave, dhammā āyussā.","an5.125:2.2":"Katame pañca?","an5.125:2.3":"Sappāyakārī hoti, sappāye mattaṃ jānāti, pariṇatabhojī ca hoti, kālacārī ca hoti, brahmacārī ca.","an5.125:2.4":"Ime kho, bhikkhave, pañca dhammā āyussā”ti.","an5.125:2.5":"Pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":260,"to":260,"paras":[{"para":260,"vripara":"125-126","refs":["an5.125:1"],"lines":["Pañcame <b>anāyussā</b>ti āyupacchedanā, na āyuvaḍḍhanā.","Chaṭṭhepi eseva nayo. 7."],"lineRefs":[["an5.125:1"],["an5.125:1"]]}],"wordLinks":[["an5.125:1.1","anāyussā",0,0],["an5.125:1.4","anāyussā",0,0]],"before":[{"para":259,"vripara":null,"title":"Anāyussāsuttadvayavaṇṇanā","lines":["Anāyussāsuttadvayavaṇṇanā 125-126."]}]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":248,"to":250,"paras":[{"para":248,"vripara":"124-130","refs":["an5.125:1"],"lines":["Tatiyo vaggo uttānatthoyeva. (14) 4."],"lineRefs":[["an5.125:1"]]},{"para":249,"vripara":null,"refs":["an5.125:1"],"lines":["Rājavaggo 1."],"lineRefs":[["an5.125:1"]]},{"para":250,"vripara":null,"refs":["an5.125:1"],"lines":["Paṭhamacakkānuvattanasuttavaṇṇanā 131."],"lineRefs":[["an5.125:1"]]}],"wordLinks":[]},"tika2":null}
