{"suttaId":"tha-ap454","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1106,1129],"vripara":"9"},"segments":{"tha-ap454:0.3":"Morahatthiyattheraapadānaṃ","tha-ap454:1.1":"“Morahatthaṃ gahetvāna,","tha-ap454:1.2":"upesiṃ lokanāyakaṃ;","tha-ap454:1.3":"Pasannacitto sumano,","tha-ap454:1.4":"morahatthamadāsahaṃ. 10.","tha-ap454:2.1":"“Iminā morahatthena,","tha-ap454:2.2":"cetanāpaṇidhīhi ca;","tha-ap454:2.3":"Nibbāyiṃsu tayo aggī,","tha-ap454:2.4":"labhāmi vipulaṃ sukhaṃ. 11.","tha-ap454:3.1":"“Aho buddho aho dhammo, aho no satthusampadā;","tha-ap454:3.3":"Datvānahaṃ morahatthaṃ,","tha-ap454:3.4":"labhāmi vipulaṃ sukhaṃ. 12.","tha-ap454:4.1":"“Tiyaggī [tidhaggī (syā. ka.), tivaggī (pī.)] nibbutā mayhaṃ,","tha-ap454:4.2":"bhavā sabbe samūhatā;","tha-ap454:4.3":"Sabbāsavā parikkhīṇā,","tha-ap454:4.4":"natthi dāni punabbhavo. 13.","tha-ap454:5.1":"“Ekatiṃse ito kappe,","tha-ap454:5.2":"yaṃ dānamadadiṃ tadā;","tha-ap454:5.3":"Duggatiṃ nābhijānāmi,","tha-ap454:5.4":"morahatthassidaṃ phalaṃ. 14.","tha-ap454:6.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap454:6.3":"viharāmi anāsavo. 15.","tha-ap454:7.1":"“Svāgataṃ vata me āsi…pe…","tha-ap454:7.3":"kataṃ buddhassa sāsanaṃ. 16.","tha-ap454:8.1":"“Paṭisambhidā catasso…pe…","tha-ap454:8.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap454:9.1":"Itthaṃ sudaṃ āyasmā morahatthiyo thero imā gāthāyo Abhāsitthāti.","tha-ap454:10.1":"Morahatthiyattherassāpadānaṃ dutiyaṃ. 3."},"unsure":["tha-ap454:3.1"],"preface":[],"attha":null,"tika":null,"tika2":null}
