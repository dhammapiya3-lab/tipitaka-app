{"suttaId":"tha-ap455","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1131,1145],"vripara":"17"},"segments":{"tha-ap455:0.3":"Sīhāsanabījiyattheraapadānaṃ","tha-ap455:1.1":"“Tissassāhaṃ bhagavato,","tha-ap455:1.2":"bodhirukkhamavandiyaṃ;","tha-ap455:1.3":"Paggayha bījaniṃ tattha,","tha-ap455:1.4":"sīhāsanamabījahaṃ [mabījayiṃ (sī.), mavijjahaṃ (syā.)].","tha-ap455:2.1":"“Dvenavute ito kappe,","tha-ap455:2.2":"sīhāsanamabījahaṃ;","tha-ap455:2.3":"Duggatiṃ nābhijānāmi,","tha-ap455:2.4":"bījanāya idaṃ phalaṃ.","tha-ap455:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap455:3.3":"viharāmi anāsavo.","tha-ap455:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap455:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap455:5.1":"“Paṭisambhidā catasso … pe …","tha-ap455:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap455:6.1":"Itthaṃ sudaṃ āyasmā sīhāsanabījiyo thero imā Gāthāyo abhāsitthāti.","tha-ap455:7.1":"Sīhāsanabījiyattherassāpadānaṃ tatiyaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
