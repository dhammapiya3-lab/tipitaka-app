{"suttaId":"ja181","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1120,1126],"vripara":"61"},"segments":{"ja181:0.4":"Asadisajātakaṃ (2-4-1)","ja181:1.1":"Dhanuggaho asadiso, rājaputto mahabbalo;","ja181:1.3":"Dūrepātī akkhaṇavedhī, mahākāyappadālano.","ja181:2.1":"Sabbāmitte raṇaṃ katvā, na ca kañci viheṭhayi;","ja181:2.3":"Bhātaraṃ sotthiṃ katvāna, saṃyamaṃ ajjhupāgamīti.","ja181:3.1":"Asadisajātakaṃ paṭhamaṃ."},"attha":null,"tika":null}
