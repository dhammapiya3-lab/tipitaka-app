{"suttaId":"an6.107","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[816,816],"vripara":"107"},"segments":{"an6.107:0.3":"Rāgasuttaṃ","an6.107:1.1":"“Tayome, bhikkhave, dhammā.","an6.107:1.2":"Katame tayo?","an6.107:1.3":"Rāgo, doso, moho.","an6.107:1.4":"Ime kho, bhikkhave, tayo dhammā.","an6.107:1.5":"Imesaṃ kho, bhikkhave, tiṇṇaṃ dhammānaṃ pahānāya tayo dhammā bhāvetabbā.","an6.107:1.6":"Katame tayo?","an6.107:1.7":"Rāgassa pahānāya asubhā bhāvetabbā, dosassa pahānāya mettā bhāvetabbā, mohassa pahānāya paññā bhāvetabbā.","an6.107:1.8":"Imesaṃ kho, bhikkhave, tiṇṇaṃ dhammānaṃ pahānāya ime tayo dhammā bhāvetabbā”ti.","an6.107:1.9":"Paṭhamaṃ."},"unsure":[],"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":776,"to":776,"paras":[{"para":776,"vripara":"107","refs":["an6.107:1"],"lines":["Ekādasamassa paṭhame <b>asubhā</b>ti asubhakammaṭṭhānaṃ.","<b>Mettā</b>ti mettākammaṭṭhānaṃ.","<b>Paññā</b>ti sahavipassanā maggapaññā."],"lineRefs":[["an6.107:1"],["an6.107:1"],["an6.107:1"]]}],"wordLinks":[["an6.107:1.7","asubhā",0,0],["an6.107:1.7","mettā",0,1],["an6.107:1.7","paññā",0,2]],"before":[{"para":772,"vripara":null,"refs":[],"lines":["Ānisaṃsavaggo dasamo."],"lineRefs":[[]]},{"para":773,"vripara":null,"refs":[],"lines":["Dutiyapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[[]]},{"para":774,"vripara":null,"refs":[],"lines":["Tikavaggo"],"lineRefs":[[]]},{"para":775,"vripara":null,"refs":[],"lines":["Rāgasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":788,"to":788,"paras":[{"para":788,"vripara":"107-116","refs":["an6.107:1"],"lines":["107-116. Ekādasamavaggo uttānatthoyeva."],"lineRefs":[["an6.107:1"]]}],"wordLinks":[]},"tika2":null}
