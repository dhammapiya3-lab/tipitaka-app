{"suttaId":"tha-ap170","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6774,6792],"vripara":"38"},"segments":{"tha-ap170:0.3":"Dussadāyakattheraapadānaṃ","tha-ap170:1.1":"“Tivarāyaṃ pure ramme,","tha-ap170:1.2":"rājaputtosahaṃ [rājaputto ahaṃ (sī. syā.)] tadā;","tha-ap170:1.3":"Paṇṇākāraṃ labhitvāna,","tha-ap170:1.4":"upasantassadāsahaṃ.","tha-ap170:2.1":"“Adhivāsesi bhagavā,","tha-ap170:2.2":"vatthaṃ [navaṃ (ka.)] hatthena āmasi;","tha-ap170:2.3":"Siddhattho adhivāsetvā,","tha-ap170:2.4":"vehāsaṃ nabhamuggami.","tha-ap170:3.1":"“Buddhassa gacchamānassa,","tha-ap170:3.2":"dussā dhāvanti pacchato;","tha-ap170:3.3":"Tattha cittaṃ pasādesiṃ,","tha-ap170:3.4":"buddho no aggapuggalo.","tha-ap170:4.1":"“Catunnavutito kappe,","tha-ap170:4.2":"yaṃ dussamadadiṃ tadā;","tha-ap170:4.3":"Duggatiṃ nābhijānāmi,","tha-ap170:4.4":"dussadānassidaṃ phalaṃ.","tha-ap170:5.1":"“Sattasaṭṭhimhito kappe,","tha-ap170:5.2":"cakkavattī tadā ahu;","tha-ap170:5.3":"Parisuddhoti nāmena,","tha-ap170:5.4":"manujindo mahabbalo.","tha-ap170:6.1":"“Paṭisambhidā catasso … pe …","tha-ap170:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap170:7.1":"Itthaṃ sudaṃ āyasmā dussadāyako thero imā gāthāyo abhāsitthāti.","tha-ap170:8.1":"Dussadāyakattherassāpadānaṃ aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3107,"to":3107,"paras":[{"para":3107,"vripara":"38","refs":["tha-ap170:1"],"lines":["So ekadivasaṃ attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>tivarāyaṃ pure ramme</b>tiādimāha.","Tattha tivaranāmake nagare ramaṇīye ahaṃ rājaputto hutvā siddhatthaṃ bhagavantaṃ vatthena pūjesinti attho.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap170:1"],["tha-ap170:1"],["tha-ap170:1"]]}],"wordLinks":[["tha-ap170:1.1","tivarāyaṃ pure ramme",0,0]]},"tika":null,"tika2":null}
