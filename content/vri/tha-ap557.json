{"suttaId":"tha-ap557","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[6075,6092],"vripara":"49"},"segments":{"tha-ap557:0.3":"Vajjīputtattheraapadānaṃ","tha-ap557:1.1":"“Sahassaraṃsī bhagavā, sayambhū aparājito;","tha-ap557:1.3":"Vivekā vuṭṭhahitvāna, gocarāyābhinikkhami.","tha-ap557:2.1":"“Phalahattho ahaṃ disvā, upagacchiṃ narāsabhaṃ;","tha-ap557:2.3":"Pasannacitto sumano, savaṇṭaṃ adadiṃ phalaṃ.","tha-ap557:3.1":"“Catunnavutito kappe, yaṃ phalaṃ adadiṃ tadā;","tha-ap557:3.3":"Duggatiṃ nābhijānāmi, phaladānassidaṃ phalaṃ.","tha-ap557:4.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap557:5.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap557:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap557:7.1":"Itthaṃ sudaṃ āyasmā vajjīputto thero imā gāthāyo Abhāsitthāti.","tha-ap557:8.1":"Vajjīputtattherassāpadānaṃ pañcamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3810,"to":3810,"paras":[{"para":3810,"vripara":"49","refs":["tha-ap557:1"],"lines":["Vajjiputtatthero aparabhāge somanassajāto attano pubbacaritāpadānaṃ pakāsento <b>sahassaraṃsī bhagavā</b>tiādimāha.","Tattha <b>sahassaraṃsī</b>ti ettha “anekasatasahassaraṃsī”ti vattabbe gāthābandhasukhatthaṃ “sahassaraṃsī”ti vuttanti veditabbaṃ.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap557:1"],["tha-ap557:1"],["tha-ap557:1"]]}],"wordLinks":[["tha-ap557:1.1","sahassaraṃsī bhagavā",0,0],["tha-ap557:1.1","sahassaraṃsī",0,1]]},"tika":null}
