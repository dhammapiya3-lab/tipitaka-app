{"suttaId":"sn1.15","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[116,119],"vripara":"15"},"segments":{"sn1.15:0.3":"Saṇamānasuttaṃ","sn1.15:1.1":"“Ṭhite majjhanhike [majjhantike (sabbattha)] kāle,","sn1.15:1.2":"sannisīvesu pakkhisu.","sn1.15:1.3":"Saṇateva brahāraññaṃ [mahāraññaṃ (ka. sī. syā. kaṃ. ka.)],","sn1.15:1.4":"taṃ bhayaṃ paṭibhāti man”ti.","sn1.15:2.1":"“Ṭhite majjhanhike kāle,","sn1.15:2.2":"sannisīvesu pakkhisu;","sn1.15:2.3":"Saṇateva brahāraññaṃ,","sn1.15:2.4":"sā rati paṭibhāti man”ti."},"unsure":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":184,"to":189,"paras":[{"para":184,"vripara":"15","refs":["sn1.15:1"],"lines":["Pañcame <b>ṭhite majjhanhike</b>ti ṭhitamajjhanhike.","<b>Sannisīvesū</b>ti yathā phāsukaṭṭhānaṃ upagantvā sannisinnesu vissamamānesu.","Ṭhitamajjhanhikakālo nāmesa sabbasattānaṃ iriyāpathadubbalyakālo.","Idha pana pakkhīnaṃyeva vasena dassito.","<b>Saṇatevā</b>ti saṇati viya mahāviravaṃ viya muccati.","Saṇamānameva cettha “saṇatevā”ti vuttaṃ.","Tappaṭibhāgaṃ nāmetaṃ.","Nidāghasamayasmiñhi ṭhitamajjhanhikakāle catuppadagaṇesu ceva pakkhīgaṇesu ca sannisinnesu vātapūritānaṃ susirarukkhānañceva chiddaveṇupabbānañca khandhena khandhaṃ sākhāya sākhaṃ saṅghaṭṭayantānaṃ pādapānañca araññamajjhe mahāsaddo uppajjati.","Taṃ sandhāyetaṃ vuttaṃ.","<b>Taṃ bhayaṃ paṭibhāti man</b>ti taṃ evarūpe kāle mahāaraññassa saṇamānaṃ mayhaṃ bhayaṃ hutvā upaṭṭhāti.","Dandhapaññā kiresā devatā tasmiṃ khaṇe attano nisajjaphāsukaṃ kathāphāsukaṃ dutiyakaṃ alabhantī evamāha.","Yasmā pana tādise kāle piṇḍapātapaṭikkantassa vivitte araññāyatane kammaṭṭhānaṃ gahetvā nisinnassa bhikkhuno anappakaṃ sukhaṃ uppajjati, yaṃ sandhāya vuttaṃ –"],"lineRefs":[["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"]]},{"para":185,"vripara":null,"refs":["sn1.15:1"],"lines":["“Suññāgāraṃ paviṭṭhassa, santacittassa bhikkhuno;"],"lineRefs":[["sn1.15:1"]]},{"para":186,"vripara":null,"refs":["sn1.15:1"],"lines":["Amānusī ratī hoti, sammā dhammaṃ vipassato”ti.(dha. pa.373) ca,"],"lineRefs":[["sn1.15:1"]]},{"para":187,"vripara":null,"refs":["sn1.15:1"],"lines":["“Purato pacchato vāpi, aparo ce na vijjati;"],"lineRefs":[["sn1.15:1"]]},{"para":188,"vripara":null,"refs":["sn1.15:1"],"lines":["Atīva phāsu bhavati, ekassa vasato vane”ti.(theragā.537) ca;"],"lineRefs":[["sn1.15:1"]]},{"para":189,"vripara":null,"refs":["sn1.15:1","sn1.15:2"],"lines":["Tasmā bhagavā dutiyaṃ gāthamāha.","Tattha <b>sā rati paṭibhāti man</b>ti yā evarūpe kāle ekakassa nisajjā nāma, sā rati mayhaṃ upaṭṭhātīti attho.","Sesaṃ tādisamevāti."],"lineRefs":[["sn1.15:1"],["sn1.15:2"],["sn1.15:2"]]}],"wordLinks":[["sn1.15:1.1","ṭhite majjhanhike",0,0],["sn1.15:1.1","sannisīvesū",0,1],["sn1.15:1.3","saṇatevā",0,4],["sn1.15:1.3","taṃ bhayaṃ paṭibhāti maṃ",0,9],["sn1.15:2.3","sā rati paṭibhāti maṃ",5,1]],"before":[{"para":182,"vripara":null,"refs":[],"lines":["Khattiyasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":183,"vripara":null,"refs":[],"lines":["Saṇamānasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":298,"to":298,"paras":[{"para":298,"vripara":"15","refs":["sn1.15:1"],"lines":["<b>Ṭhite majjhanhike</b>ti pubbaddhaṃ nikkhamitvā aparaddhaṃ appatvā ṭhitamajjhanhe.","<b>Sannisīvesū</b>ti parissamavinodanatthaṃ sabbaso sannisīdantesu.","Da-kārassa hi va-kāraṃ katvā niddeso.","Tenāha <b>“sannisinnesu vissamamānesū”</b>ti.","<b>Sabbasattānan</b>ti sabbesañca āhārūpajīvitasattānaṃ ghammatāpane santattakāyānaṃ <b>iriyāpathadubbalyakālo</b>ti ṭhānādiiriyāpathassa asamatthakālo.","<b>Saṇati viyā</b>ti saddaṃ karoti viya, yathā taṃ aññampi mahāvanaṃ vakkhamānanayena.","Tenāha <b>“tappaṭibhāgaṃ nāmetan”</b>ti <b>chiddaveṇupabbānan</b>ti randhajātakīcakamahāveḷupabbānaṃ.","<b>Dutiyakaṃ</b> sahāyaṃ alabhantī anabhiratiparitassanāya evamāha.","<b>Anappakaṃ sukhan</b>ti vipulaṃ uḷāraṃ vivekasukhaṃ."],"lineRefs":[["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"],["sn1.15:1"]]}],"wordLinks":[["sn1.15:1.1","ṭhite majjhanhike",0,0],["sn1.15:1.1","sannisīvesū",0,1]],"before":[{"para":296,"vripara":null,"refs":[],"lines":["Khattiyasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":297,"vripara":null,"refs":[],"lines":["Saṇamānasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
