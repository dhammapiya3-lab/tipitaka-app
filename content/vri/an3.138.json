{"suttaId":"an3.138","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1200,1200],"vripara":"139"},"segments":{"an3.138:0.3":"Sampadāsuttaṃ","an3.138:1.1":"“Tisso imā, bhikkhave, sampadā.","an3.138:1.2":"Katamā tisso?","an3.138:1.3":"Saddhāsampadā, sīlasampadā, paññāsampadā – imā kho, bhikkhave, tisso sampadā”ti.","an3.138:1.5":"Chaṭṭhaṃ."},"attha":null,"tika":null}
