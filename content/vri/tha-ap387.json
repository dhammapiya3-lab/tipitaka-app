{"suttaId":"tha-ap387","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[11016,11028],"vripara":"26"},"segments":{"tha-ap387:0.3":"Phārusaphaladāyakattheraapadānaṃ","tha-ap387:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap387:1.2":"āhutīnaṃ paṭiggahaṃ;","tha-ap387:1.3":"Rathiyaṃ paṭipajjantaṃ,","tha-ap387:1.4":"phārusaphalamadāsahaṃ.","tha-ap387:2.1":"“Ekanavutito kappe,","tha-ap387:2.2":"yaṃ phalamadadiṃ ahaṃ;","tha-ap387:2.3":"Duggatiṃ nābhijānāmi,","tha-ap387:2.4":"phaladānassidaṃ phalaṃ.","tha-ap387:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap387:3.3":"viharāmi anāsavo.","tha-ap387:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap387:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap387:5.1":"“Paṭisambhidā catasso … pe …","tha-ap387:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap387:6.1":"Itthaṃ sudaṃ āyasmā phārusaphaladāyako thero imā gāthāyo abhāsitthāti.","tha-ap387:7.1":"Phārusaphaladāyakattherassāpadānaṃ pañcamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
