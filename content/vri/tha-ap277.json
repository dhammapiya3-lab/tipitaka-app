{"suttaId":"tha-ap277","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8617,8632],"vripara":"19"},"segments":{"tha-ap277:0.3":"Ekañjalikattheraapadānaṃ","tha-ap277:1.1":"“Udumbare vasantassa, niyate paṇṇasanthare;","tha-ap277:1.3":"Vutthokāso mayā dinno, samaṇassa mahesino.","tha-ap277:2.1":"“Tissassa dvipadindassa, lokanāthassa tādino;","tha-ap277:2.3":"Añjaliṃ paggahetvāna, santhariṃ pupphasantharaṃ.","tha-ap277:3.1":"“Dvenavute ito kappe, yaṃ kariṃ pupphasantharaṃ;","tha-ap277:3.3":"Duggatiṃ nābhijānāmi, santharassa idaṃ phalaṃ.","tha-ap277:4.1":"“Ito cuddasakappamhi, ahosiṃ manujādhipo;","tha-ap277:4.3":"Ekaañjaliko nāma, cakkavattī mahabbalo.","tha-ap277:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap277:6.1":"Itthaṃ sudaṃ āyasmā ekañjaliko thero imā gāthāyo abhāsitthāti.","tha-ap277:7.1":"Ekañjalikattherassāpadānaṃ pañcamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3235,"to":3235,"paras":[{"para":3235,"vripara":"19","refs":["tha-ap277:1"],"words":["udumbare vasantassā","niyate paṇṇasanthare","vutthokāso mayā dinno"],"lines":["Pañcamāpadāne <b>udumbare vasantassā</b>ti udumbararukkhamūle rukkhacchāyāya vasantassa tissassa bhagavato.","<b>Niyate paṇṇasanthare</b>ti niyāmite paṭibaddhe paṇṇasanthare sākhābhaṅgāsane nisinnassa.","<b>Vutthokāso mayā dinno</b>ti vivittokāse maṇḍapadvārādīhi pihitokāso mayā dinno sampāditoti attho."],"lineRefs":[["tha-ap277:1"],["tha-ap277:1"],["tha-ap277:1"]]}]},"tika":null}
