{"suttaId":"tha-ap277","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8617,8632],"vripara":"19"},"segments":{"tha-ap277:0.3":"Ekañjalikattheraapadānaṃ","tha-ap277:1.1":"“Udumbare vasantassa,","tha-ap277:1.2":"niyate paṇṇasanthare;","tha-ap277:1.3":"Vutthokāso mayā dinno,","tha-ap277:1.4":"samaṇassa mahesino.","tha-ap277:2.1":"“Tissassa dvipadindassa,","tha-ap277:2.2":"lokanāthassa tādino;","tha-ap277:2.3":"Añjaliṃ paggahetvāna,","tha-ap277:2.4":"santhariṃ pupphasantharaṃ.","tha-ap277:3.1":"“Dvenavute ito kappe,","tha-ap277:3.2":"yaṃ kariṃ pupphasantharaṃ;","tha-ap277:3.3":"Duggatiṃ nābhijānāmi,","tha-ap277:3.4":"santharassa idaṃ phalaṃ.","tha-ap277:4.1":"“Ito cuddasakappamhi,","tha-ap277:4.2":"ahosiṃ manujādhipo;","tha-ap277:4.3":"Ekaañjaliko nāma,","tha-ap277:4.4":"cakkavattī mahabbalo.","tha-ap277:5.1":"“Paṭisambhidā catasso … pe …","tha-ap277:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap277:6.1":"Itthaṃ sudaṃ āyasmā ekañjaliko thero imā gāthāyo abhāsitthāti.","tha-ap277:7.1":"Ekañjalikattherassāpadānaṃ pañcamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3235,"to":3235,"paras":[{"para":3235,"vripara":"19","refs":["tha-ap277:1"],"lines":["Pañcamāpadāne <b>udumbare vasantassā</b>ti udumbararukkhamūle rukkhacchāyāya vasantassa tissassa bhagavato.","<b>Niyate paṇṇasanthare</b>ti niyāmite paṭibaddhe paṇṇasanthare sākhābhaṅgāsane nisinnassa.","<b>Vutthokāso mayā dinno</b>ti vivittokāse maṇḍapadvārādīhi pihitokāso mayā dinno sampāditoti attho."],"lineRefs":[["tha-ap277:1"],["tha-ap277:1"],["tha-ap277:1"]]}],"wordLinks":[["tha-ap277:1.1","udumbare vasantassā",0,0],["tha-ap277:1.1","niyate paṇṇasanthare",0,1],["tha-ap277:1.3","vutthokāso mayā dinno",0,2]],"before":[{"para":3234,"vripara":"14","refs":[],"lines":["Catutthāpadāne <b>akakkasacittassāthā</b>ti apharusacittassa, <b>atha</b> -saddo padapūraṇe."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
