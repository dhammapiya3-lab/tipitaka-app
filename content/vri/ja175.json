{"suttaId":"ja175","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1065,1071],"vripara":"49"},"segments":{"ja175:0.4":"Ādiccupaṭṭhānajātakaṃ (2-3-5)","ja175:1.1":"Sabbesu kira bhūtesu, santi sīlasamāhitā;","ja175:1.3":"Passa sākhāmigaṃ jammaṃ, ādiccamupatiṭṭhati.","ja175:2.1":"Nāssa sīlaṃ vijānātha, anaññāya pasaṃsatha;","ja175:2.3":"Aggihuttañca uhannaṃ [ūhantaṃ (sī.), ūhanaṃ (syā.), ūhanti (pī.), uhadaṃ (ka.)], dve ca bhinnā kamaṇḍalūti.","ja175:3.1":"Ādiccupaṭṭhānajātakaṃ pañcamaṃ."},"attha":null,"tika":null}
