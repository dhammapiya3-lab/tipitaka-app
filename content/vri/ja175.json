{"suttaId":"ja175","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1065,1071],"vripara":"49"},"segments":{"ja175:0.4":"Ādiccupaṭṭhānajātakaṃ (2-3-5)","ja175:1.1":"Sabbesu kira bhūtesu, santi sīlasamāhitā;","ja175:1.3":"Passa sākhāmigaṃ jammaṃ, ādiccamupatiṭṭhati.","ja175:2.1":"Nāssa sīlaṃ vijānātha, anaññāya pasaṃsatha;","ja175:2.3":"Aggihuttañca uhannaṃ [ūhantaṃ (sī.), ūhanaṃ (syā.), ūhanti (pī.), uhadaṃ (ka.)], dve ca bhinnā kamaṇḍalūti.","ja175:3.1":"Ādiccupaṭṭhānajātakaṃ pañcamaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":434,"to":439,"paras":[{"para":434,"vripara":null,"refs":["ja175:1"],"lines":["Tattha <b>santi sīlasamāhitā</b>ti sīlena samannāgatā saṃvijjanti, sīlavantā ca samāhitā ca ekaggacittā saṃvijjantītipi attho.","<b>Jamman</b>ti lāmakaṃ.","<b>Ādiccamupatiṭṭhatī</b>ti sūriyaṃ namassamāno tiṭṭhati."],"lineRefs":[["ja175:1"],["ja175:1"],["ja175:1"]]},{"para":435,"vripara":null,"refs":[],"lines":["Evaṃ te manusse tassa guṇaṃ kathente disvā bodhisatto “tumhe imassa lolamakkaṭassa sīlācāraṃ ajānitvā avatthusmiṃyeva pasannā”ti vatvā dutiyaṃ gāthamāha –"],"lineRefs":[[]]},{"para":437,"vripara":"50","refs":[],"lines":["“Nāssa sīlaṃ vijānātha, anaññāya pasaṃsatha;"],"lineRefs":[[]]},{"para":438,"vripara":null,"refs":[],"lines":["Aggihuttañca uhannaṃ, dve ca bhinnā kamaṇḍalū”ti."],"lineRefs":[[]]},{"para":439,"vripara":null,"refs":["ja175:2"],"lines":["Tattha <b>anaññāyā</b>ti ajānitvā.","<b>Uhannan</b>ti iminā pāpamakkaṭena ūhadaṃ.","<b>Kamaṇḍalū</b>ti kuṇḍikā.","“Dve ca kuṇḍikā tena bhinnā”ti evamassa aguṇaṃ kathesi."],"lineRefs":[["ja175:2"],["ja175:2"],["ja175:2"],["ja175:2"]]}],"wordLinks":[["ja175:1.1","santi sīlasamāhitā",0,0],["ja175:1.3","jammaṃ",0,1],["ja175:1.3","ādiccamupatiṭṭhatī",0,2],["ja175:2.1","anaññāyā",4,0],["ja175:2.3","uhannaṃ",4,1],["ja175:2.3","kamaṇḍalū",4,2]]},"tika":null,"tika2":null}
