{"suttaId":"pv6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[97,125],"vripara":"26"},"segments":{"pv6:0.3":"Pañcaputtakhādapetivatthu","pv6:1.1":"“Naggā dubbaṇṇarūpāsi,","pv6:1.2":"duggandhā pūti vāyasi;","pv6:1.3":"Makkhikāhi parikiṇṇā [makkhikāparikiṇṇā ca (sī.)],","pv6:1.4":"kā nu tvaṃ idha tiṭṭhasī”ti.","pv6:2.1":"“Ahaṃ bhadante [bhaddante (ka.)] petīmhi,","pv6:2.2":"duggatā yamalokikā;","pv6:2.3":"Pāpakammaṃ karitvāna,","pv6:2.4":"petalokaṃ ito gatā.","pv6:3.1":"“Kālena pañca puttāni,","pv6:3.2":"sāyaṃ pañca punāpare;","pv6:3.3":"Vijāyitvāna khādāmi,","pv6:3.4":"tepi nā honti me alaṃ.","pv6:4.1":"“Pariḍayhati dhūmāyati,","pv6:4.2":"khudāya [khuddāya (ka.)] hadayaṃ mama;","pv6:4.3":"Pānīyaṃ na labhe pātuṃ,","pv6:4.4":"passa maṃ byasanaṃ gatan”ti.","pv6:5.1":"“Kiṃ nu kāyena vācāya,","pv6:5.2":"manasā dukkaṭaṃ kataṃ;","pv6:5.3":"Kissa kammavipākena,","pv6:5.4":"puttamaṃsāni khādasī”ti.","pv6:6.1":"“Sapatī [sapattī (sī.)] me gabbhinī āsi,","pv6:6.2":"tassā pāpaṃ acetayiṃ;","pv6:6.3":"Sāhaṃ paduṭṭhamanasā,","pv6:6.4":"akariṃ gabbhapātanaṃ.","pv6:7.1":"“Tassā dvemāsiko gabbho,","pv6:7.2":"lohitaññeva pagghari;","pv6:7.3":"Tadassā mātā kupitā,","pv6:7.4":"mayhaṃ ñātī samānayi;","pv6:7.5":"Sapathañca maṃ kāresi,","pv6:7.6":"paribhāsāpayī ca maṃ.","pv6:8.1":"“Sāhaṃ ghorañca sapathaṃ,","pv6:8.2":"musāvādaṃ abhāsisaṃ;","pv6:8.3":"Puttamaṃsāni khādāmi,","pv6:8.4":"sace taṃ pakataṃ mayā.","pv6:9.1":"“Tassa kammassa vipākena [vipākaṃ (syā. ka.)],","pv6:9.2":"musāvādassa cūbhayaṃ;","pv6:9.3":"Puttamaṃsāni khādāmi,","pv6:9.4":"pubbalohitamakkhitā”ti.","pv6:10.1":"Pañcaputtakhādapetivatthu [pañcaputtakhādapetavatthu (sī. syā. pī.) evamuparipi] chaṭṭhaṃ."},"unsure":[],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":209,"to":244,"paras":[{"para":209,"vripara":null,"refs":["pv6:1"],"lines":["Gāthāya paṭipucchi.","Tattha <b>naggā</b>ti niccoḷā.","<b>Dubbaṇṇarūpāsī</b>ti ṇavirūpā ativiya bībhaccharūpena samannāgatā asi.","<b>Duggandhā</b>ti aniṭṭhagandhā.","<b>Pūti vāyasī</b>ti sarīrato kuṇapagandhaṃ vāyasi.","<b>Makkhikāhi parikiṇṇā</b>ti nīlamakkhikāhi samantato ākiṇṇā.","<b>Kā nu tvaṃ idha tiṭṭhasī</b>ti kā nāma evarūpā imasmiṃ ṭhāne tiṭṭhasi, ito cito ca vicarasīti attho."],"lineRefs":[["pv6:1"],["pv6:1"],["pv6:1"],["pv6:1"],["pv6:1"],["pv6:1"],["pv6:1"]]},{"para":210,"vripara":null,"refs":["pv6:1"],"lines":["Atha sā petī mahātherena evaṃ puṭṭhā attānaṃ pakāsentī sattānaṃ saṃvegaṃ janentī –"],"lineRefs":[["pv6:1"]]},{"para":212,"vripara":"27","refs":["pv6:1"],"lines":["“Ahaṃ bhadante petīmhi, duggatā yamalokikā;"],"lineRefs":[["pv6:1"]]},{"para":213,"vripara":null,"refs":["pv6:1"],"lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gatā."],"lineRefs":[["pv6:1"]]},{"para":215,"vripara":"28","refs":["pv6:1"],"lines":["“Kālena pañca puttāni, sāyaṃ pañca punāpare;"],"lineRefs":[["pv6:1"]]},{"para":216,"vripara":null,"refs":["pv6:1"],"lines":["Vijāyitvāna khādāmi, tepi nā honti me alaṃ."],"lineRefs":[["pv6:1"]]},{"para":218,"vripara":"29","refs":["pv6:1"],"lines":["“Pariḍayhati dhūmāyati, khudāya hadayaṃ mama;"],"lineRefs":[["pv6:1"]]},{"para":219,"vripara":null,"refs":["pv6:1"],"lines":["Pānīyaṃ na labhe pātuṃ, passa maṃ byasanaṃ gatan”ti.","–"],"lineRefs":[["pv6:1"],["pv6:1"]]},{"para":220,"vripara":null,"refs":["pv6:1"],"lines":["Imā tisso gāthā abhāsi."],"lineRefs":[["pv6:1"]]},{"para":221,"vripara":"27","refs":["pv6:2"],"lines":["Tattha <b>bhadante</b>ti theraṃ gāravena ālapati.","<b>Duggatā</b>ti duggatiṃ gatā.","<b>Yamalokikā</b>ti “yamaloko”ti laddhanāme petaloke tattha pariyāpannabhāvena viditā.","<b>Ito gatā</b>ti ito manussalokato petalokaṃ upapajjanavasena gatā, upapannāti attho."],"lineRefs":[["pv6:2"],["pv6:2"],["pv6:2"],["pv6:2"]]},{"para":222,"vripara":"28","refs":["pv6:3"],"lines":["<b>Kālenā</b>ti rattiyā vibhātakāle.","Bhummatthe hi etaṃ karaṇavacanaṃ.","<b>Pañca puttānī</b>ti pañca putte.","Liṅgavipallāsena hetaṃ vuttaṃ.","<b>Sāyaṃ pañca punāpare</b>ti sāyanhakāle puna apare pañca putte khādāmīti yojanā.","<b>Vijāyitvānā</b>ti divase divase dasa dasa putte vijāyitvā.","<b>Tepi nā honti me alan</b>ti tepi dasaputtā ekadivasaṃ mayhaṃ khudāya paṭighātāya ahaṃ pariyattā na honti.","Gāthāsukhatthañhettha nā-iti dīghaṃ katvā vuttaṃ."],"lineRefs":[["pv6:3"],["pv6:3"],["pv6:3"],["pv6:3"],["pv6:3"],["pv6:3"],["pv6:3"],["pv6:3"]]},{"para":223,"vripara":"29","refs":["pv6:4"],"lines":["<b>Pariḍayhati dhūmāyati khudāya hadayaṃ mamā</b>ti khudāya jighacchāya bādhiyamānāya mama hadayapadeso udaragginā parisamantato jhāyati dhūmāyati santappati.","<b>Pānīyaṃ na labhe pātun</b>ti pipāsābhibhūtā tattha tattha vicarantī pānīyampi pātuṃ na labhāmi.","<b>Passa maṃ byasanaṃ gatan</b>ti petūpapattiyā sādhāraṇaṃ asādhāraṇañca imaṃ īdisaṃ byasanaṃ upagataṃ maṃ passa, bhanteti attanā anubhaviyamānaṃ dukkhaṃ therassa pavedesi."],"lineRefs":[["pv6:4"],["pv6:4"],["pv6:4"]]},{"para":224,"vripara":null,"refs":["pv6:4"],"lines":["Taṃ sutvā thero tāya katakammaṃ pucchanto –"],"lineRefs":[["pv6:4"]]},{"para":226,"vripara":"30","refs":["pv6:4"],"lines":["“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;"],"lineRefs":[["pv6:4"]]},{"para":227,"vripara":null,"refs":["pv6:4"],"lines":["Kissa kammavipākena, puttamaṃsāni khādasī”ti.","–"],"lineRefs":[["pv6:4"],["pv6:4"]]},{"para":228,"vripara":null,"refs":["pv6:4","pv6:5"],"lines":["Gāthamāha.","Tattha <b>dukkaṭan</b>ti duccaritaṃ.","<b>Kissa kammavipākenā</b>ti kīdisassa kammassa vipākena, kiṃ pāṇātipātassa, udāhu adinnādānādīsu aññatarassāti attho.","“Kena kammavipākenā”ti keci paṭhanti."],"lineRefs":[["pv6:4"],["pv6:5"],["pv6:5"],["pv6:5"]]},{"para":229,"vripara":null,"refs":["pv6:5"],"lines":["Atha sā petī attanā katakammaṃ therassa kathentī –"],"lineRefs":[["pv6:5"]]},{"para":231,"vripara":"31","refs":["pv6:5"],"lines":["“Sapatī me gabbhinī āsi, tassā pāpaṃ acetayiṃ;"],"lineRefs":[["pv6:5"]]},{"para":232,"vripara":null,"refs":["pv6:5"],"lines":["Sāhaṃ paduṭṭhamanasā, akariṃ gabbhapātanaṃ."],"lineRefs":[["pv6:5"]]},{"para":234,"vripara":"32","refs":["pv6:5"],"lines":["“Tassa dvemāsiko gabbho, lohitaññeva pagghari;"],"lineRefs":[["pv6:5"]]},{"para":235,"vripara":null,"refs":["pv6:5"],"lines":["Tadassā mātā kupitā, mayhaṃ ñātī samānayi;"],"lineRefs":[["pv6:5"]]},{"para":236,"vripara":null,"refs":["pv6:5"],"lines":["Sapathañca maṃ akāresi, paribhāsāpayī ca maṃ."],"lineRefs":[["pv6:5"]]},{"para":238,"vripara":"33","refs":["pv6:5"],"lines":["“Sāhaṃ ghorañca sapathaṃ, musāvādaṃ abhāsisaṃ;"],"lineRefs":[["pv6:5"]]},{"para":239,"vripara":null,"refs":["pv6:5"],"lines":["‘Puttamaṃsāni khādāmi, sace taṃ pakataṃ mayā’."],"lineRefs":[["pv6:5"]]},{"para":241,"vripara":"34","refs":["pv6:5"],"lines":["“Tassa kammassa vipākena, musāvādassa cūbhayaṃ;"],"lineRefs":[["pv6:5"]]},{"para":242,"vripara":null,"refs":["pv6:5"],"lines":["Puttamaṃsāni khādāmi, pubbalohitamakkhitā”ti.","– gāthāyo abhāsi;"],"lineRefs":[["pv6:5"],["pv6:5"]]},{"para":243,"vripara":"31-32","refs":["pv6:6"],"lines":["31-32. Tattha <b>sapatī</b>ti samānapatikā itthī vuccati.","<b>Tassā pāpaṃ acetayin</b>ti tassa sapatiyā pāpaṃ luddakaṃ kammaṃ acetayiṃ.","<b>Paduṭṭhamanasā</b>ti paduṭṭhacittā, paduṭṭhena vā manasā.","<b>Dvemāsiko</b>ti dvemāsajāto patiṭṭhito hutvā dvemāsikā.","<b>Lohitaññeva paggharī</b>ti vipajjamāno ruhiraññeva hutvā vissandi.","<b>Tadassā mātā kupitā, mayhaṃ ñātī samānayī</b>ti tadā assā sapatiyā mātā mayhaṃ kupitā attano ñātake samodhānesi.","“Tatassā”ti vā pāṭho, tato assāti padavibhāgo."],"lineRefs":[["pv6:6"],["pv6:6"],["pv6:6"],["pv6:6"],["pv6:6"],["pv6:6"],["pv6:6"]]},{"para":244,"vripara":"33-34","refs":["pv6:8"],"lines":["33-34. <b>Sapathan</b>ti sapanaṃ.","<b>Paribhāsāpayī</b>ti bhayena tajjāpesi.","<b>Sapathaṃ musāvādaṃ abhāsisan</b>ti “sace taṃ mayā kataṃ, īdisī bhaveyyan”ti katameva pāpaṃ akataṃ katvā dassentī musāvādaṃ abhūtaṃ sapathaṃ abhāsiṃ.","<b>Muttamaṃsāni khādāmi, sacetaṃ pakataṃ mayā</b>ti idaṃ tadā sapathassa katākāradassanaṃ.","Yadi etaṃ gabbhapātanapāpaṃ mayā kataṃ, āyatiṃ punabbhavābhinibbattiyaṃ mayhaṃ puttamaṃsāniyeva khādeyyanti attho.","<b>Tassa kammassā</b>ti tassa gabbhapātanavasena pakatassa pāṇātipātakammassa.","<b>Musāvādassa cā</b>ti musāvādakammassa ca.","<b>Ubhayan</b>ti ubhayassapi kammassa ubhayena vipākena.","Karaṇatthe hi idaṃ paccattavacanaṃ.","<b>Pubbalohitamakkhitā</b>ti pasavanavasena paribhijjanavasena ca pubbena ca lohitena ca makkhitā hutvā puttamaṃsāni khādāmīti yojanā."],"lineRefs":[["pv6:8"],["pv6:8"],["pv6:8"],["pv6:8"],["pv6:8"],["pv6:8"],["pv6:8"],["pv6:8"],["pv6:8"],["pv6:8"]]}],"wordLinks":[["pv6:1.1","naggā",0,1],["pv6:1.1","dubbaṇṇarūpāsī",0,2],["pv6:1.1","duggandhā",0,3],["pv6:1.1","pūti vāyasī",0,4],["pv6:1.3","makkhikāhi parikiṇṇā",0,5],["pv6:1.3","kā nu tvaṃ idha tiṭṭhasī",0,6],["pv6:2.1","bhadante",9,0],["pv6:2.1","duggatā",9,1],["pv6:2.1","yamalokikā",9,2],["pv6:2.3","ito gatā",9,3],["pv6:3.1","kālenā",10,0],["pv6:3.1","pañca puttānī",10,2],["pv6:3.1","sāyaṃ pañca punāpare",10,4],["pv6:3.3","vijāyitvānā",10,5],["pv6:3.3","tepi nā honti me alaṃ",10,6],["pv6:4.1","pariḍayhati dhūmāyati khudāya hadayaṃ mamā",11,0],["pv6:4.3","pānīyaṃ na labhe pātuṃ",11,1],["pv6:4.3","passa maṃ byasanaṃ gataṃ",11,2],["pv6:5.1","dukkaṭaṃ",15,1],["pv6:5.3","kissa kammavipākenā",15,2],["pv6:6.1","sapatī",26,0],["pv6:6.1","tassā pāpaṃ acetayiṃ",26,1],["pv6:6.3","paduṭṭhamanasā",26,2],["pv6:8.1","sapathaṃ",27,0],["pv6:8.1","sapathaṃ musāvādaṃ abhāsisaṃ",27,2]],"before":[{"para":201,"vripara":null,"refs":[],"lines":["Desanāpariyosāne ca pettivisayūpapattiādīnavasaṃvaṇṇanena saṃviggahadayānaṃ yoniso padahataṃ caturāsītiyā pāṇasahassānaṃ dhammābhisamayo ahosi.","Dutiyadivasepi devamanussānaṃ idameva tirokuṭṭadesanaṃ desesi.","Evaṃ yāva satta divasā tādisova dhammābhisamayo ahosīti."],"lineRefs":[[],[],[]]},{"para":202,"vripara":null,"refs":[],"lines":["Tirokuṭṭapetavatthuvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":203,"vripara":null,"refs":[],"lines":["Pañcaputtakhādakapetivatthuvaṇṇanā"],"lineRefs":[[]]},{"para":204,"vripara":null,"refs":[],"lines":["<b>Naggā dubbaṇṇarūpāsī</b>ti idaṃ satthari sāvatthiyaṃ viharante pañcaputtakhādakapetiṃ ārabbha vuttaṃ.","Sāvatthiyā kira avidūre gāmake aññatarassa kuṭumbikassa bhariyā vañjhā ahosi.","Tassa ñātakā etadavocuṃ –","“tava pajāpati vañjhā, aññaṃ te kaññaṃ ānemā”ti.","So tasso bhariyāya sinehena na icchi.","Athassa bhariyā taṃ pavattiṃ sutvā sāmikaṃ evamāha –","“sāmi, ahaṃ vañjhā, aññā kaññā ānetabbā, mā te kulavaṃso upacchijjī”ti.","So tāya nippīḷiyamāno aññaṃ kaññaṃ ānesi.","Sā aparena samayena gabbhinī ahosi.","Vañjhitthī –","“ayaṃ puttaṃ labhitvā imassa gehassa issarā bhavissatī”ti issāpakatā tassā gabbhapātanūpāyaṃ pariyesantī aññataraṃ paribbājikaṃ annapānādīhi saṅgaṇhitvā tāya tassā gabbhapātanaṃ dāpesi.","Sā gabbhe patite attano mātuyā ārocesi, mātā attano ñātake samodhānetvā tamatthaṃ nivedesi.","Te vañjhitthiṃ etadavocuṃ –","“tayā imissā gabbho pātito”ti?","“Nāhaṃ pātemī”ti.","“Sace tayā gabbho na pātito, sapathaṃ karohī”ti.","“Sace mayā gabbho pātito, duggatiparāyaṇā khuppipāsābhibhūtā sāyaṃ pātaṃ pañca pañca putte vijāyitvā khāditvā tittiṃ na gaccheyyaṃ, niccaṃ duggandhā makkhikāparikiṇṇā ca bhaveyyan”ti musā vatvā sapathaṃ akāsi.","Sā nacirasseva kālaṃ katvā tasseva gāmassa avidūre dubbaṇṇarūpā petī hutvā nibbatti."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":205,"vripara":null,"refs":[],"lines":["Tadā janapade vutthavassā aṭṭha therā satthu dassanatthaṃ sāvatthiṃ āgacchantā tassa gāmassa avidūre chāyūdakasampanne araññaṭṭhāne vāsaṃ upagacchiṃsu.","Atha sā petī therānaṃ attānaṃ dassesi.","Tesu saṅghatthero taṃ petiṃ –"],"lineRefs":[[],[],[]]},{"para":207,"vripara":"26","refs":[],"lines":["“Naggā dubbaṇṇarūpāsi, duggandhā pūti vāyasi;"],"lineRefs":[[]]},{"para":208,"vripara":null,"refs":[],"lines":["Makkhikāhi parikiṇṇā, kā nu tvaṃ idha tiṭṭhasī”ti.","–"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
