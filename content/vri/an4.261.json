{"suttaId":"an4.261","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1895,1895],"vripara":"261"},"segments":{"an4.261:0.3":"Balasuttaṃ","an4.261:1.1":"“Cattārimāni, bhikkhave, balāni.","an4.261:1.2":"Katamāni cattāri?","an4.261:1.3":"Vīriyabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ – imāni kho, bhikkhave, cattāri balānī”ti.","an4.261:1.5":"Aṭṭhamaṃ."},"attha":null,"tika":null}
