{"suttaId":"an4.261","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1895,1895],"vripara":"261"},"segments":{"an4.261:0.3":"Balasuttaṃ","an4.261:1.1":"“Cattārimāni, bhikkhave, balāni.","an4.261:1.2":"Katamāni cattāri?","an4.261:1.3":"Vīriyabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ –","an4.261:1.4":"imāni kho, bhikkhave, cattāri balānī”ti.","an4.261:1.5":"Aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1715,"to":1717,"paras":[{"para":1715,"vripara":"258-263","refs":["an4.261:1"],"lines":["258-263. Pañcame <b>ādhipacce ṭhapentī</b>ti bhaṇḍāgārikaṭṭhāne ṭhapenti.","Chaṭṭhe <b>vaṇṇasampanno</b>ti sarīravaṇṇena samannāgato.","<b>Balasampanno</b>ti kāyabalena samannāgato.","Bhikkhuvāre <b>vaṇṇasampanno</b>ti guṇavaṇṇena samannāgato.","<b>Balasampanno</b>ti vīriyabalena samannāgato.","<b>Javasampanno</b>ti ñāṇajavena samannāgato.","Sattamepi eseva nayo.","Sesamettha uttānamevāti."],"lineRefs":[["an4.261:1"],["an4.261:1"],["an4.261:1"],["an4.261:1"],["an4.261:1"],["an4.261:1"],["an4.261:1"],["an4.261:1"]]},{"para":1716,"vripara":null,"refs":["an4.261:1"],"lines":["Abhiññāvaggo chaṭṭho."],"lineRefs":[["an4.261:1"]]},{"para":1717,"vripara":null,"refs":["an4.261:1"],"lines":["(27)7. Kammapathavaggavaṇṇanā"],"lineRefs":[["an4.261:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1920,"to":1920,"paras":[{"para":1920,"vripara":"257-263","refs":["an4.261:1"],"lines":["257-263. Catutthe <b>apasādetī</b>ti niggaṇhāti.","<b>Ussādetī</b>ti paggaṇhāti.","Apasādanākāraṃ ussādanākārañca vibhāvetuṃ <b>“kathan”</b>tiādi āraddhaṃ.","Pañcamādīni uttānāneva.","Sesaṃ suviññeyyameva."],"lineRefs":[["an4.261:1"],["an4.261:1"],["an4.261:1"],["an4.261:1"],["an4.261:1"]]}],"wordLinks":[]},"tika2":null}
