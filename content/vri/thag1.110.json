{"suttaId":"thag1.110","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[634,642],"vripara":"110"},"segments":{"thag1.110:0.4":"Usabhattheragāthā","thag1.110:1.1":"“Nagā nagaggesu susaṃvirūḷhā, udaggameghena navena sittā;","thag1.110:1.3":"Vivekakāmassa araññasaññino, janeti bhiyyo usabhassa kalyatan”ti.","thag1.110:1.5":"… Usabho thero ….","thag1.110:1.6":"Vaggo ekādasamo niṭṭhito.","thag1.110:2.0":"Tassuddānaṃ –","thag1.110:2.1":"Belaṭṭhāniko setuccho, bandhuro khitako isi;","thag1.110:2.3":"Malitavambho suhemanto, dhammasavo dhammasavapitā;","thag1.110:2.5":"Saṅgharakkhitatthero ca, usabho ca mahāmunīti."},"attha":null,"tika":null}
