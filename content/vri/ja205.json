{"suttaId":"ja205","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1336,1343],"vripara":"109"},"segments":{"ja205:0.4":"Gaṅgeyyajātakaṃ (2-6-5)","ja205:1.1":"Sobhati maccho gaṅgeyyo, atho sobhati yāmuno [sobhanti macchā gaṅgeyyā, atho sobhanti yāmunā (syā. pī.)];","ja205:1.3":"Catuppadoyaṃ puriso, nigrodhaparimaṇḍalo;","ja205:1.5":"Īsakāyata [īsamāyata (ka.)] gīvo ca, sabbeva atirocati.","ja205:2.1":"Yaṃ pucchito na taṃ akkhāsi [akkhā (sī. syā. pī.)], aññaṃ akkhāsi [akkhāti (syā. pī.)] pucchito;","ja205:2.3":"Attappasaṃsako poso, nāyaṃ asmāka ruccatīti.","ja205:3.1":"Gaṅgeyyajātakaṃ pañcamaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":950,"to":955,"paras":[{"para":950,"vripara":null,"refs":["ja205:1"],"lines":["Tattha <b>catuppadoyan</b>ti catuppado ayaṃ.","<b>Puriso</b>ti attānaṃ sandhāya vadati.","<b>Nigrodhaparimaṇḍalo</b>ti sujāto nigrodho viya parimaṇḍalo.","<b>Īsakāyatagīvo</b>ti rathīsā viya āyatagīvo.","<b>Sabbeva atirocatī</b>ti evaṃ saṇṭhānasampanno kacchapo sabbeva atirocati, ahameva sabbe tumhe atikkamitvā sobhāmīti vadati."],"lineRefs":[["ja205:1"],["ja205:1"],["ja205:1"],["ja205:1"],["ja205:1"]]},{"para":951,"vripara":null,"refs":[],"lines":["Macchā tassa kathaṃ hutvā “ambho!","Pāpakacchapa amhehi pucchitaṃ akathetvā aññameva kathesī”ti vatvā dutiyaṃ gāthamāha –"],"lineRefs":[[],[]]},{"para":953,"vripara":"110","refs":[],"lines":["“Yaṃ pucchito na taṃ akkhāsi, aññaṃ akkhāsi pucchito;"],"lineRefs":[[]]},{"para":954,"vripara":null,"refs":[],"lines":["Atthappasaṃsako poso, nāyaṃ asmāka ruccatī”ti."],"lineRefs":[[]]},{"para":955,"vripara":null,"refs":["ja205:2"],"lines":["Tattha <b>attappasaṃsako</b>ti attānaṃ pasaṃsanasīlo attukkaṃsako poso.","<b>Nāyaṃ asmāka ruccatī</b>ti ayaṃ pāpakacchapo amhākaṃ na ruccati na khamatīti kacchapassa upari udakaṃ khipitvā sakaṭṭhānameva gamiṃsu."],"lineRefs":[["ja205:2"],["ja205:2"]]}],"wordLinks":[["ja205:1.3","catuppadoyaṃ"