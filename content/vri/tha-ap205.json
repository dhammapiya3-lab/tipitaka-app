{"suttaId":"tha-ap205","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7460,7475],"vripara":"10"},"segments":{"tha-ap205:0.3":"Kiṅkaṇipupphiyattheraapadānaṃ","tha-ap205:1.1":"“Kañcanagghiyasaṅkāso,","tha-ap205:1.2":"sabbaññū lokanāyako;","tha-ap205:1.3":"Odakaṃ dahamoggayha,","tha-ap205:1.4":"sināyi lokanāyako. 11.","tha-ap205:2.1":"“Paggayha kiṅkaṇiṃ [kiṅkiṇiṃ (sī.)] pupphaṃ,","tha-ap205:2.2":"vipassissābhiropayiṃ;","tha-ap205:2.3":"Udaggacitto sumano,","tha-ap205:2.4":"dvipadindassa tādino. 12.","tha-ap205:3.1":"“Ekanavutito kappe,","tha-ap205:3.2":"yaṃ pupphamabhiropayiṃ;","tha-ap205:3.3":"Duggatiṃ nābhijānāmi,","tha-ap205:3.4":"buddhapūjāyidaṃ phalaṃ. 13.","tha-ap205:4.1":"“Sattavīsatikappamhi,","tha-ap205:4.2":"rājā bhīmaratho ahu;","tha-ap205:4.3":"Sattaratanasampanno,","tha-ap205:4.4":"cakkavattī mahabbalo. 14.","tha-ap205:5.1":"“Paṭisambhidā catasso…pe…","tha-ap205:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap205:6.1":"Itthaṃ sudaṃ āyasmā kiṅkaṇipupphiyo [kiṅkiṇikapupphiyo (sī.)] thero imā gāthāyo abhāsitthāti.","tha-ap205:7.1":"Kiṅkaṇipupphiyattherassāpadānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
