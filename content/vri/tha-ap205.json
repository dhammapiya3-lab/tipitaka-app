{"suttaId":"tha-ap205","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7460,7475],"vripara":"10"},"segments":{"tha-ap205:0.3":"Kiṅkaṇipupphiyattheraapadānaṃ","tha-ap205:1.1":"“Kañcanagghiyasaṅkāso, sabbaññū lokanāyako;","tha-ap205:1.3":"Odakaṃ dahamoggayha, sināyi lokanāyako.","tha-ap205:2.1":"“Paggayha kiṅkaṇiṃ [kiṅkiṇiṃ (sī.)] pupphaṃ, vipassissābhiropayiṃ;","tha-ap205:2.3":"Udaggacitto sumano, dvipadindassa tādino.","tha-ap205:3.1":"“Ekanavutito kappe, yaṃ pupphamabhiropayiṃ;","tha-ap205:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap205:4.1":"“Sattavīsatikappamhi, rājā bhīmaratho ahu;","tha-ap205:4.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap205:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap205:6.1":"Itthaṃ sudaṃ āyasmā kiṅkaṇipupphiyo [kiṅkiṇikapupphiyo (sī.)] thero imā gāthāyo abhāsitthāti.","tha-ap205:7.1":"Kiṅkaṇipupphiyattherassāpadānaṃ tatiyaṃ."},"attha":null,"tika":null}
