{"suttaId":"thag2.26","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[921,927],"vripara":"171"},"segments":{"thag2.26:0.4":"Puṇṇamāsattheragāthā","thag2.26:1.1":"“Pañca nīvaraṇe hitvā, yogakkhemassa pattiyā;","thag2.26:1.3":"Dhammādāsaṃ gahetvāna, ñāṇadassanamattano.","thag2.26:2.1":"“Paccavekkhiṃ imaṃ kāyaṃ, sabbaṃ santarabāhiraṃ;","thag2.26:2.3":"Ajjhattañca bahiddhā ca, tuccho kāyo adissathā”ti.","thag2.26:2.5":"… Puṇṇamāso thero …."},"attha":null,"tika":null}
