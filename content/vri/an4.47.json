{"suttaId":"an4.47","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[513,523],"vripara":"47"},"segments":{"an4.47:0.3":"Suvidūrasuttaṃ","an4.47:1.1":"“Cattārimāni, bhikkhave, suvidūravidūrāni.","an4.47:1.2":"Katamāni cattāri?","an4.47:1.3":"Nabhañca, bhikkhave, pathavī ca;","an4.47:1.4":"idaṃ paṭhamaṃ suvidūravidūre.","an4.47:1.5":"Orimañca, bhikkhave, tīraṃ samuddassa pārimañca;","an4.47:1.6":"idaṃ dutiyaṃ suvidūravidūre.","an4.47:1.7":"Yato ca, bhikkhave, verocano abbhudeti yattha ca atthameti [atthaṅgameti (syā.), veti (ka.)];","an4.47:1.8":"idaṃ tatiyaṃ suvidūravidūre.","an4.47:1.9":"Satañca, bhikkhave, dhammo asatañca dhammo;","an4.47:1.10":"idaṃ catutthaṃ suvidūravidūre.","an4.47:1.11":"Imāni kho, bhikkhave, cattāri suvidūravidūrānī”ti.","an4.47:2.1":"[jā.2.21.414,448]“Nabhañca dūre pathavī ca dūre,","an4.47:2.2":"Pāraṃ samuddassa tadāhu dūre;","an4.47:2.3":"Yato ca verocano abbhudeti,","an4.47:2.4":"Pabhaṅkaro yattha ca atthameti;","an4.47:2.5":"Tato have dūrataraṃ vadanti,","an4.47:2.6":"Satañca dhammaṃ asatañca dhammaṃ.","an4.47:3.1":"“Abyāyiko hoti sataṃ samāgamo,","an4.47:3.2":"Yāvāpi [yāvampi (sī. syā. kaṃ. pī.)] tiṭṭheyya tatheva hoti;","an4.47:3.3":"Khippañhi veti asataṃ samāgamo,","an4.47:3.4":"Tasmā sataṃ dhammo asabbhi ārakā”ti.","an4.47:3.5":"sattamaṃ;"},"unsure":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1244,"to":1245,"paras":[{"para":1244,"vripara":"47","refs":["an4.47:1"],"lines":["Sattame <b>suvidūravidūrānī</b>ti kenaci pariyāyena anāsannāni hutvā suvidūrāneva vidūrāni.","<b>Nabhañca, bhikkhave, pathavī cā</b>ti ākāsañca mahāpathavī ca.","Tattha kiñcāpi pathavito ākāsaṃ nāma na dūre, dvaṅgulamattepi hoti.","Aññamaññaṃ alagganaṭṭhena pana “suvidūravidūre”ti vuttaṃ.","<b>Verocano</b>ti sūriyo.","<b>Satañca, bhikkhave, dhammo</b>ti catusatipaṭṭhānādibhedo sattatiṃsabodhipakkhiyadhammo.","<b>Asatañca dhammo</b>ti dvāsaṭṭhidiṭṭhigatabhedo assaddhammo."],"lineRefs":[["an4.47:1"],["an4.47:1"],["an4.47:1"],["an4.47:1"],["an4.47:1"],["an4.47:1"],["an4.47:1"]]},{"para":1245,"vripara":null,"refs":["an4.47:2","an4.47:3"],"lines":["<b>Pabhaṅkaro</b>ti ālokakaro.","<b>Abyāyiko hotī</b>ti avigacchanasabhāvo hoti.","<b>Sataṃ samāgamo</b>ti paṇḍitānaṃ mittasanthavavasena samāgamo.","<b>Yāvāpi tiṭṭheyyā</b>ti yattakaṃ addhānaṃ tiṭṭheyya.","<b>Tatheva hotī</b>ti tādisova hoti, pakatiṃ na jahati.","<b>Khippaṃ hi vetī</b>ti sīghaṃ vigacchati."],"lineRefs":[["an4.47:2"],["an4.47:3"],["an4.47:3"],["an4.47:3"],["an4.47:3"],["an4.47:3"]]}],"wordLinks":[["an4.47:1.1","suvidūravidūrānī",0,0],["an4.47:1.11","suvidūravidūrānī",0,0],["an4.47:1.3","nabhañca bhikkhave pathavī cā",0,1],["an4.47:1.7","verocano",0,4],["an4.47:1.9","satañca bhikkhave dhammo",0,5],["an4.47:1.9","asatañca dhammo",0,6],["an4.47:2.4","pabhaṅkaro",1,0],["an4.47:3.1","abyāyiko hotī",1,1],["an4.47:3.1","sataṃ samāgamo",1,2],["an4.47:3.3","sataṃ samāgamo",1,2],["an4.47:3.2","yāvāpi tiṭṭheyyā",1,3],["an4.47:3.2","tatheva hotī",1,4]],"before":[{"para":1243,"vripara":null,"refs":[],"lines":["Suvidūrasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1424,"to":1424,"paras":[{"para":1424,"vripara":"47","refs":["an4.47:1"],"lines":["Sattame <b>suvidūravidūra</b> -saddānaṃ samānatthānaṃyeva ekattha gahaṇaṃ idha niddeso dūrāsannabhāvassa apekkhāsiddhattā idhādhippetassa dūrabhāvassa kenaci pariyāyena anāsannabhāvadassanatthaṃ katanti āha <b>“kenaci pariyāyena anāsannāni hutvā”</b>tiādi.","Sesamettha uttānameva."],"lineRefs":[["an4.47:1"],["an4.47:1"]]}],"wordLinks":[["an4.47:1.1","suvidūravidūra",0,0],["an4.47:1.4","suvidūravidūra",0,0],["an4.47:1.6","suvidūravidūra",0,0],["an4.47:1.8","suvidūravidūra",0,0],["an4.47:1.10","suvidūravidūra",0,0],["an4.47:1.11","suvidūravidūra",0,0]]},"tika2":null}
