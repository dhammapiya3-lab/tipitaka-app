{"suttaId":"sn1.79","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[861,867],"vripara":"79"},"segments":{"sn1.79:0.3":"Pātheyyasuttaṃ","sn1.79:1.1":"“Kiṃsu bandhati pātheyyaṃ,","sn1.79:1.2":"kiṃsu bhogānamāsayo;","sn1.79:1.3":"Kiṃsu naraṃ parikassati,","sn1.79:1.4":"kiṃsu lokasmi dujjahaṃ;","sn1.79:1.5":"Kismiṃ baddhā puthū sattā,","sn1.79:1.6":"pāsena sakuṇī yathā”ti.","sn1.79:2.1":"“Saddhā bandhati pātheyyaṃ,","sn1.79:2.2":"sirī bhogānamāsayo;","sn1.79:2.3":"Icchā naraṃ parikassati,","sn1.79:2.4":"icchā lokasmi dujjahā;","sn1.79:2.5":"Icchābaddhā puthū sattā,","sn1.79:2.6":"pāsena sakuṇī yathā”ti. 10."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":495,"to":495,"paras":[{"para":495,"vripara":"79","refs":["sn1.79:2"],"lines":["Navame <b>saddhā bandhati pātheyya</b>nti saddhaṃ uppādetvā dānaṃ deti, sīlaṃ rakkhati, uposathakammaṃ karoti, tenetaṃ vuttaṃ.","<b>Sirī</b>ti issariyaṃ.","<b>Āsayo</b>ti vasanaṭṭhānaṃ.","Issariye hi abhimukhībhūte thalatopi jalatopi bhogā āgacchantiyeva.","Tenetaṃ vuttaṃ.","<b>Parikassatī</b>ti parikaḍḍhati.","Navamaṃ. 10."],"lineRefs":[["sn1.79:2"],["sn1.79:2"],["sn1.79:2"],["sn1.79:2"],["sn1.79:2"],["sn1.79:2"],["sn1.79:2"]]}],"wordLinks":[["sn1.79:2.1","saddhā bandhati pātheyyaṃ",0,0],["sn1.79:2.1","sirī",0,1],["sn1.79:2.1","āsayo",0,2],["sn1.79:2.3","parikassatī",0,5]],"before":[{"para":494,"vripara":null,"title":"Pātheyyasuttavaṇṇanā","lines":["Pātheyyasuttavaṇṇanā 79."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":620,"to":620,"paras":[{"para":620,"vripara":"79","refs":["sn1.79:2"],"lines":["<b>Saddhā bandhati pātheyya</b>nti saddhā nāma sattassa maraṇavasena mahāpathaṃ saṃvajato mahākantāraṃ paṭipajjato mahāviduggaṃ pakkhandato pātheyyapuṭaṃ bandhati sambalaṃ sajjeti.","Kathanti āha <b>“saddhaṃ uppādetvā”</b>tiādi.","<b>Etaṃ vutta</b>nti “saddhā bandhati pātheyya”nti etaṃ gāthāpadaṃ vuttaṃ bhagavatā.","<b>Sirī</b>ti katapuññehi sevīyati tehi paṭilabhīyatīti sirī.","<b>Issariyaṃ</b> vibhavo.","Āsayitabbato <b>āsayo, vasanaṭṭhānaṃ</b> niketanti attho.","<b>Parikaḍḍhatī</b>ti icchāvasikaṃ puggalaṃ tattha tattha upakaḍḍhati."],"lineRefs":[["sn1.79:2"],["sn1.79:2"],["sn1.79:2"],["sn1.79:2"],["sn1.79:2"],["sn1.79:2"],["sn1.79:2"]]}],"wordLinks":[["sn1.79:2.1","saddhā bandhati pātheyyaṃ",0,0],["sn1.79:2.1","sirī",0,3]],"before":[{"para":619,"vripara":null,"title":"Pātheyyasuttavaṇṇanā","lines":["Pātheyyasuttavaṇṇanā 79."]}],"after":[{"para":621,"vripara":null,"title":"Pātheyyasuttavaṇṇanā","lines":["Pātheyyasuttavaṇṇanā niṭṭhitā. 10."]}]},"tika2":null}
