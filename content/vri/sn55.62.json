{"suttaId":"sn55.62","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[2400,2400],"vripara":"1058"},"segments":{"sn55.62:0.3":"Mahāpaññāsuttaṃ","sn55.62:1.1":"“Cattārome, bhikkhave, dhammā bhāvitā bahulīkatā mahāpaññatāya saṃvattanti.","sn55.62:1.2":"Katame cattāro?","sn55.62:1.3":"Sappurisasaṃsevo, saddhammassavanaṃ, yonisomanasikāro, dhammānudhammappaṭipatti –","sn55.62:1.4":"ime kho, bhikkhave, cattāro dhammā bhāvitā bahulīkatā mahāpaññatā saṃvattantī”ti.","sn55.62:1.5":"Paṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":862,"to":862,"paras":[{"para":862,"vripara":"1058","refs":["sn55.62:1"],"lines":["Sattame <b>mahāpaññatāya saṃvattantī</b>tiādīsu “mahante atthe pariggaṇhātīti mahāpaññā”tiādinā paṭisambhidāyaṃ (paṭi. ma.2.4) vuttanayeneva sabbattha sabbapadesu attho veditabbo.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["sn55.62:1"],["sn55.62:1"]]}],"wordLinks":[["sn55.62:1.1","mahāpaññatāya saṃvattantī",0,0]]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":748,"to":753,"paras":[{"para":748,"vripara":"1058","refs":["sn55.62:1"],"lines":["<b>Mahante atthe pariggaṇhātī</b>ti saccapaṭiccasamuppādādike mahāvitthāre atthe paricchijja asesetvā muṭṭhigate viya katvā gaṇhāti.","Sesaṃ heṭṭhā vuttanayameva."],"lineRefs":[["sn55.62:1"],["sn55.62:1"]]},{"para":749,"vripara":null,"refs":["sn55.62:1"],"lines":["Mahāpaññavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn55.62:1"]]},{"para":750,"vripara":null,"refs":["sn55.62:1"],"lines":["Sotāpattisaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn55.62:1"]]},{"para":751,"vripara":null,"refs":["sn55.62:1"],"lines":["Saccasaṃyuttaṃ"],"lineRefs":[["sn55.62:1"]]},{"para":752,"vripara":null,"refs":["sn55.62:1"],"lines":["Samādhivaggo"],"lineRefs":[["sn55.62:1"]]},{"para":753,"vripara":null,"refs":["sn55.62:1"],"lines":["Samādhisuttavaṇṇanā"],"lineRefs":[["sn55.62:1"]]}],"wordLinks":[],"before":[{"para":