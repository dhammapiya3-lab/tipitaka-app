{"suttaId":"sn45.176","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[392,392],"vripara":"177"},"segments":{"sn45.176:0.3":"Kāmaguṇasuttaṃ","sn45.176:1.1":"“Pañcime, bhikkhave, kāmaguṇā.","sn45.176:1.2":"Katame pañca?","sn45.176:1.3":"Cakkhuviññeyyā rūpā iṭṭhā kantā manāpā piyarūpā kāmūpasaṃhitā rajanīyā, sotaviññeyyā saddā … pe … ghānaviññeyyā gandhā … pe … jivhāviññeyyā rasā … pe … kāyaviññeyyā phoṭṭhabbā iṭṭhā kantā manāpā piyarūpā kāmūpasaṃhitā rajanīyā – ime kho, bhikkhave, pañca kāmaguṇā.","sn45.176:1.8":"Imesaṃ kho, bhikkhave, pañcannaṃ kāmaguṇānaṃ abhiññāya pariññāya parikkhayāya pahānāya … pe … ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.176:1.9":"Chaṭṭhaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":122,"to":127,"paras":[{"para":122,"vripara":"176-181","refs":["sn45.176:1"],"lines":["176-181. <b>Kāmarāgānusayo</b>ti thāmagataṭṭhena kāmarāgova anusayo kāmarāgānusayo.","Sesesupi eseva nayo.","<b>Orambhāgiyānī</b>ti heṭṭhākoṭṭhāsiyāni.","<b>Saṃyojanānī</b>ti bandhanāni.","<b>Uddhambhāgiyānī</b>ti uparikoṭṭhāsiyāni.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn45.176:1"],["sn45.176:1"],["sn45.176:1"],["sn45.176:1"],["sn45.176:1"],["sn45.176:1"]]},{"para":123,"vripara":null,"refs":[],"lines":["Oghavaggo ekādasamo."],"lineRefs":[[]]},{"para":124,"vripara":null,"refs":[],"lines":["Maggasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":125,"vripara":null,"refs":[],"lines":["Bojjhaṅgasaṃyuttaṃ"],"lineRefs":[[]]},{"para":126,"vripara":null,"refs":[],"lines":["Pabbatavaggo"],"lineRefs":[[]]},{"para":127,"vripara":null,"refs":["sn45.176:1"],"lines":["Himavantasuttavaṇṇanā"],"lineRefs":[["sn45.176:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":123,"to":129,"paras":[{"para":123,"vripara":"176-181","refs":["sn45.176:1"],"lines":["176-181. <b>Thāmagataṭṭhenā</b>ti sattasantāne thirabhāvūpagamanabhāvena.","<b>Thāmagatan</b>ti ca aññehi asādhāraṇo kāmarāgādīnaṃyeva āveṇiko sabhāvo daṭṭhabbo.","<b>Kāmarāgovā</b>ti kāmarāgo eva appahīno.","So sati paccayalābhe uppajjanārahatāya santāne anusetīti <b>anusayo.</b>","<b>Sesesupī</b>ti paṭighānusayādīsu.","Orambhāgo vuccati kāmadhātu rūpārūpabhāvato heṭṭhābhūtattā.","Tattha pavattiyā paccayabhāvato <b>orambhāgiyāni</b> yathā “pacchiyo goduhako”ti.","Saṃyojentīti <b>saṃyojanāni,</b> heṭṭhā viya attho vattabbo.","<b>Uddhambhāgo</b> mahaggatabhāgo, tassa hitānīti sabbaṃ heṭṭhā vuttanayattā na vuttanti adhippāyo."],"lineRefs":[["sn45.176:1"],["sn45.176:1"],["sn45.176:1"],["sn45.176:1"],["sn45.176:1"],["sn45.176:1"],["sn45.176:1"],["sn45.176:1"],["sn45.176:1"]]},{"para":124,"vripara":null,"refs":[],"lines":["Anusayasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":125,"vripara":null,"refs":[],"lines":["Oghavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":126,"vripara":null,"refs":[],"lines":["Maggasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":127,"vripara":null,"refs":[],"lines":["Bojjhaṅgasaṃyuttaṃ"],"lineRefs":[[]]},{"para":128,"vripara":null,"refs":[],"lines":["Pabbatavaggo"],"lineRefs":[[]]},{"para":129,"vripara":null,"refs":["sn45.176:1"],"lines":["Himavantasuttavaṇṇanā"],"lineRefs":[["sn45.176:1"]]}],"wordLinks":[]}}
