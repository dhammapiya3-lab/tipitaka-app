{"suttaId":"tha-ap299","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8979,8994],"vripara":"31"},"segments":{"tha-ap299:0.3":"Desakittakattheraapadānaṃ","tha-ap299:1.1":"“Upasālakanāmohaṃ,","tha-ap299:1.2":"ahosiṃ brāhmaṇo tadā;","tha-ap299:1.3":"Kānanaṃ vanamogāḷhaṃ,","tha-ap299:1.4":"lokajeṭṭhaṃ narāsabhaṃ. 32.","tha-ap299:2.1":"“Disvāna vandiṃ pādesu,","tha-ap299:2.2":"lokāhutipaṭiggahaṃ;","tha-ap299:2.3":"Pasannacittaṃ maṃ ñatvā,","tha-ap299:2.4":"buddho antaradhāyatha. 33.","tha-ap299:3.1":"“Kānanā abhinikkhamma,","tha-ap299:3.2":"buddhaseṭṭhamanussariṃ;","tha-ap299:3.3":"Taṃ desaṃ kittayitvāna,","tha-ap299:3.4":"kappaṃ saggamhi modahaṃ. 34.","tha-ap299:4.1":"“Dvenavute ito kappe,","tha-ap299:4.2":"yaṃ desamabhikittayiṃ;","tha-ap299:4.3":"Duggatiṃ nābhijānāmi,","tha-ap299:4.4":"kittanāya idaṃ phalaṃ. 35.","tha-ap299:5.1":"“Paṭisambhidā catasso…pe…","tha-ap299:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap299:6.1":"Itthaṃ sudaṃ āyasmā desakittako thero imā gāthāyo abhāsitthāti.","tha-ap299:7.1":"Desakittakattherassāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
