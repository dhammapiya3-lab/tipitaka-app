{"suttaId":"sn11.25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[3485,3498],"vripara":"271"},"segments":{"sn11.25:0.3":"Akkodhasuttaṃ","sn11.25:1.1":"Evaṃ me sutaṃ –","sn11.25:1.2":"ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme.","sn11.25:1.3":"Tatra kho bhagavā bhikkhū … pe … bhagavā etadavoca –","sn11.25:1.4":"“bhūtapubbaṃ, bhikkhave, sakko devānamindo sudhammāyaṃ sabhāyaṃ deve tāvatiṃse anunayamāno tāyaṃ velāyaṃ imaṃ gāthaṃ abhāsi –","sn11.25:2.1":"“Mā vo kodho ajjhabhavi,","sn11.25:2.2":"mā ca kujjhittha kujjhataṃ;","sn11.25:2.3":"Akkodho avihiṃsā ca,","sn11.25:2.4":"ariyesu ca paṭipadā [vasatī sadā (sī. syā. kaṃ. pī.)];","sn11.25:2.5":"Atha pāpajanaṃ kodho,","sn11.25:2.6":"pabbatovābhimaddatī”ti.","sn11.25:2.7":"Tatiyo vaggo.","sn11.25:3.0":"Tassuddānaṃ –","sn11.25:3.1":"Chetvā dubbaṇṇiyamāyā,","sn11.25:3.2":"accayena akodhano;","sn11.25:3.3":"Desitaṃ buddhaseṭṭhena,","sn11.25:3.4":"idañhi sakkapañcakanti.","sn11.25:3.5":"Sakkasaṃyuttaṃ samattaṃ.","sn11.25:3.6":"Sagāthāvaggo paṭhamo.","sn11.25:4.0":"Tassuddānaṃ –","sn11.25:4.1":"Devatā devaputto ca,","sn11.25:4.2":"rājā māro ca bhikkhunī;","sn11.25:4.3":"Brahmā brāhmaṇa vaṅgīso,","sn11.25:4.4":"vanayakkhena vāsavoti.","sn11.25:4.5":"Sagāthāvaggasaṃyuttapāḷi niṭṭhitā."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1473,"to":1473,"paras":[{"para":1473,"vripara":"271","refs":["sn11.25:2"],"lines":["Pañcame <b>mā vo kodho ajjhabhavī</b>ti kodho tumhe mā abhibhavi, tumheva kodhaṃ abhibhavatha.","<b>Mā ca kujjhittha kujjhitan</b>ti kujjhantānaṃ mā paṭikujjhittha.","<b>Akkodho</b>ti mettā ca mettāpubbabhāgo ca.","<b>Avihiṃsā</b>ti karuṇā ca karuṇāpubbabhāgo ca.","<b>Atha pāpajanaṃ kodho, pabbatovābhimaddatī</b>ti lāmakajanaṃ pabbato viya kodho abhimaddatīti.","Pañcamaṃ."],"lineRefs":[["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"]]}],"wordLinks":[["sn11.25:2.1","mā vo kodho ajjhabhavī",0,0],["sn11.25:2.3","akkodho",0,2],["sn11.25:2.3","avihiṃsā",0,3],["sn11.25:2.5","atha pāpajanaṃ kodho pabbatovābhimaddatī",0,4]],"before":[{"para":1472,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Akkodhasuttavaṇṇanā"]}],"after":[{"para":1474,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Tatiyo vaggo."]},{"para":1475,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Sakkasaṃyuttavaṇṇanā niṭṭhitā."]},{"para":1476,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Iti sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"]},{"para":1477,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Sagāthāvaggavaṇṇanā niṭṭhitā."]},{"para":1478,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Saṃyuttanikāya-aṭṭhakathāya paṭhamo bhāgo."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1698,"to":1698,"paras":[{"para":1698,"vripara":"271","refs":["sn11.25:2"],"lines":["<b>Kodho tumhe mā abhibhavī</b>ti ettha kodhena anabhibhavanīyattaṃ khantimettākaruṇāditappaṭipakkhadhammaparibrūhanena.","Tathā hi taṃsamaṅgino kodho abhibhuyyatīti āha <b>“tumheva kodhaṃ abhibhavatha.</b>","<b>Kujjhantānaṃ mā paṭikujjhitthā”</b>ti.","<b>Paṭipadā</b>ti esā paṭipatti.","<b>Mettā</b>ti appanāppattā mettā.","Tadupacāro <b>mettāpubbabhāgo</b>.","Na vihiṃsati kiñci etāyāti <b>avihiṃsā.</b>","<b>Karuṇā</b>ti appanāppattakaruṇā veditabbā.","Tadupacāro <b>karuṇāpubbabhāgo.</b>","<b>Lāmakajanan</b>ti khantiādīsu yonisomanasikārābhāvena gārayhasamācārasamāyogena ca nihīnaṃ janaṃ.","Paccayaparisuddhiyā <b>kodho</b> abhimaddamāno puggalaṃ <b>abhimaddati,</b> tassa so paṭisaṅkhānabhāvanābalehi sammadeva pahātabboti."],"lineRefs":[["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"],["sn11.25:2"]]}],"wordLinks":[["sn11.25:2.3","paṭipadā",0,3],["sn11.25:2.3","avihiṃsā",0,6],["sn11.25:2.1","kodho",0,10],["sn11.25:2.3","kodho",0,10],["sn11.25:2.5","kodho",0,10]],"before":[{"para":1697,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Akkodhasuttavaṇṇanā"]}],"after":[{"para":1699,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Akkodhasuttavaṇṇanā niṭṭhitā."]},{"para":1700,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Tatiyavaggavaṇṇanā niṭṭhitā."]},{"para":1701,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"]},{"para":1702,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Sakkasaṃyuttavaṇṇanāya līnatthappakāsanā samattā."]},{"para":1703,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Niṭṭhitā ca sāratthappakāsiniyā"]},{"para":1704,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Saṃyuttanikāya-aṭṭhakathāya sagāthāvaggavaṇṇanā."]},{"para":1705,"vripara":null,"title":"Akkodhasuttavaṇṇanā","lines":["Paṭhamo bhāgo niṭṭhito."]}]},"tika2":null}
