{"suttaId":"sn46.45","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[608,608],"vripara":"226"},"segments":{"sn46.45:0.3":"Paññavantasuttaṃ","sn46.45:1.1":"“‘Paññavā aneḷamūgo, paññavā aneḷamūgo’ti, bhante, vuccati.","sn46.45:1.2":"Kittāvatā nu kho, bhante, ‘paññavā aneḷamūgo’ti vuccatī”ti?","sn46.45:1.3":"“Sattannaṃ kho, bhikkhu, bojjhaṅgānaṃ bhāvitattā bahulīkatattā ‘paññavā aneḷamūgo’ti vuccati.","sn46.45:1.4":"Katamesaṃ sattannaṃ?","sn46.45:1.5":"Satisambojjhaṅgassa…pe… upekkhāsambojjhaṅgassa –","sn46.45:1.6":"imesaṃ kho, bhikkhu, sattannaṃ bojjhaṅgānaṃ bhāvitattā bahulīkatattā ‘paññavā aneḷamūgo’ti vuccatī”ti.","sn46.45:1.7":"Pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":221,"to":224,"paras":[{"para":221,"vripara":"225-231","refs":["sn46.45:1"],"lines":["Catutthe <b>eḷamūgo</b>ti mukhena vācaṃ nicchāretuṃ sakkontopi dosehi mūgo asampannavacano.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn46.45:1"],["sn46.45:1"]]},{"para":222,"vripara":null,"refs":["sn46.45:1"],"lines":["Cakkavattivaggo. 6."],"lineRefs":[["sn46.45:1"]]},{"para":223,"vripara":null,"refs":["sn46.45:1"],"lines":["Sākacchavaggo 1."],"lineRefs":[["sn46.45:1"]]},{"para":224,"vripara":null,"refs":["sn46.45:1"],"lines":["Āhārasuttavaṇṇanā 232."],"lineRefs":[["sn46.45:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":220,"to":223,"paras":[{"para":220,"vripara":"225-231","refs":["sn46.45:1"],"lines":["Eḷaṃ vuccati doso, eḷena mūgo viyāti <b>eḷamūgo</b>ti imamatthaṃ dassento <b>“mukhena vāca”</b>ntiādimāha."],"lineRefs":[["sn46.45:1"]]},{"para":221,"vripara":null,"refs":["sn46.45:1"],"lines":["Cakkavattivaggavaṇṇanā niṭṭhitā. 6."],"lineRefs":[["sn46.45:1"]]},{"para":222,"vripara":null,"refs":["sn46.45:1"],"lines":["Sākacchavaggo 1."],"lineRefs":[["sn46.45:1"]]},{"para":223,"vripara":null,"refs":["sn46.45:1"],"lines