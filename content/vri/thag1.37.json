{"suttaId":"thag1.37","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[218,222],"vripara":"37"},"segments":{"thag1.37:0.4":"Kumāputtasahāyakattheragāthā","thag1.37:1.1":"“Nānājanapadaṃ yanti, vicarantā asaññatā;","thag1.37:1.3":"Samādhiñca virādhenti, kiṃsu raṭṭhacariyā karissati;","thag1.37:1.5":"Tasmā vineyya sārambhaṃ, jhāyeyya apurakkhato”ti.","thag1.37:1.7":"… Kumāputtattherassa sahāyako thero …."},"attha":null,"tika":null}
