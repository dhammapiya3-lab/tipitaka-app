{"suttaId":"tha-ap366","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10642,10653],"vripara":"12"},"segments":{"tha-ap366:0.3":"Kesarapupphiyattheraapadānaṃ","tha-ap366:1.1":"“Vijjādharo tadā āsiṃ,","tha-ap366:1.2":"himavantamhi pabbate;","tha-ap366:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap366:1.4":"caṅkamantaṃ mahāyasaṃ.","tha-ap366:2.1":"“Tīṇi kesarapupphāni [kesaripupphāni (sī.)],","tha-ap366:2.2":"sīse katvānahaṃ tadā;","tha-ap366:2.3":"Upasaṅkamma sambuddhaṃ,","tha-ap366:2.4":"vessabhuṃ abhipūjayiṃ.","tha-ap366:3.1":"“Ekattiṃse ito kappe,","tha-ap366:3.2":"yaṃ kammamakariṃ tadā;","tha-ap366:3.3":"Duggatiṃ nābhijānāmi,","tha-ap366:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap366:4.1":"“Paṭisambhidā catasso … pe …","tha-ap366:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap366:5.1":"Itthaṃ sudaṃ āyasmā kesarapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap366:6.1":"Kesarapupphiyattherassāpadānaṃ catutthaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
