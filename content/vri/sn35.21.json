{"suttaId":"sn35.21","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[61,62],"vripara":"21"},"segments":{"sn35.21:0.3":"Paṭhamadukkhuppādasuttaṃ","sn35.21:1.1":"“Yo, bhikkhave, cakkhussa uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo.","sn35.21:1.2":"Yo sotassa … pe …","sn35.21:1.3":"yo ghānassa …","sn35.21:1.4":"yo jivhāya …","sn35.21:1.5":"yo kāyassa …","sn35.21:1.6":"yo manassa uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo.","sn35.21:2.1":"“Yo ca kho, bhikkhave, cakkhussa nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo.","sn35.21:2.2":"Yo sotassa …","sn35.21:2.3":"yo ghānassa …","sn35.21:2.4":"yo jivhāya …","sn35.21:2.5":"yo kāyassa …","sn35.21:2.6":"yo manassa nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo”ti.","sn35.21:2.7":"Navamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":23,"to":26,"paras":[{"para":23,"vripara":"19-22","refs":["sn35.21:1"],"lines":["19-22. Sattamādīsu catūsu vaṭṭavivaṭṭameva kathitaṃ.","Anupubbakathā pana nesaṃ heṭṭhā vuttanayeneva veditabbāti."],"lineRefs":[["sn35.21:1"],["sn35.21:1"]]},{"para":24,"vripara":null,"refs":["sn35.21:1"],"lines":["Yamakavaggo dutiyo."],"lineRefs":[["sn35.21:1"]]},{"para":25,"vripara":null,"refs":["sn35.21:1"],"lines":["Sabbavaggo"],"lineRefs":[["sn35.21:1"]]},{"para":26,"vripara":null,"refs":["sn35.21:1"],"lines":["Sabbasuttavaṇṇanā"],"lineRefs":[["sn35.21:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":29,"to":33,"paras":[{"para":29,"vripara":"19-22","refs":["sn35.21:1"],"lines":["19-22. <b>Vaṭṭavivaṭṭameva kathitaṃ</b> abhinandanānaṃ uppādanirodhānañca vasena desanāya pavattattā.","<b>Anupubbakathā</b>ti ādito paṭṭhāya padatthavaṇṇanā.","<b>Nesan</b>ti suttānaṃ."],"lineRefs":[["sn35.21:1"],["sn35.21:1"],["sn35.21:1"]]},{"para":30,"vripara":null,"refs":["sn35.21:1"],"lines":["Paṭhamābhinandasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.21:1"]]},{"para":31,"vripara":null,"refs":["sn35.21:1"],"lines":["Yamakavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.21:1"]]},{"para":32,"vripara":null,"refs":["sn35.21:1"],"lines":["Sabbavaggo"],"lineRefs":[["sn35.21:1"]]},{"para":33,"vripara":null,"refs":["sn35.21:1"],"lines":["Sabbasuttavaṇṇanā"],"lineRefs":[["sn35.21:1"]]}],"wordLinks":[]},"tika2":null}
