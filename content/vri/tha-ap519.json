{"suttaId":"tha-ap519","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3315,3335],"vripara":"37"},"segments":{"tha-ap519:0.3":"Kuṭajapupphiyattheraapadānaṃ","tha-ap519:1.1":"“Himavantassāvidūre,","tha-ap519:1.2":"vasalo [cāvalo (sī. pī.), accayo (syā.)] nāma pabbato;","tha-ap519:1.3":"Buddho sudassano nāma,","tha-ap519:1.4":"vasate pabbatantare. 38.","tha-ap519:2.1":"“Pupphaṃ hemavantaṃ gayha,","tha-ap519:2.2":"vehāsaṃ agamāsahaṃ;","tha-ap519:2.3":"Tatthaddasāsiṃ sambuddhaṃ,","tha-ap519:2.4":"oghatiṇṇamanāsavaṃ. 39.","tha-ap519:3.1":"“Pupphaṃ kuṭajamādāya,","tha-ap519:3.2":"sire katvāna añjaliṃ [katvānahaṃ tadā (syā. pī. ka.)];","tha-ap519:3.3":"Buddhassa abhiropesiṃ,","tha-ap519:3.4":"sayambhussa mahesino. 40.","tha-ap519:4.1":"“Ekatiṃse ito kappe,","tha-ap519:4.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap519:4.3":"Duggatiṃ nābhijānāmi,","tha-ap519:4.4":"buddhapūjāyidaṃ phalaṃ. 41.","tha-ap519:5.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap519:5.3":"viharāmi anāsavo. 42.","tha-ap519:6.1":"“Svāgataṃ vata me āsi…pe…","tha-ap519:6.3":"kataṃ buddhassa sāsanaṃ. 43.","tha-ap519:7.1":"“Paṭisambhidā catasso…pe…","tha-ap519:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap519:8.1":"Itthaṃ sudaṃ āyasmā kuṭajapupphiyo thero imā gāthāyo Abhāsitthāti.","tha-ap519:9.1":"Kuṭajapupphiyattherassāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
