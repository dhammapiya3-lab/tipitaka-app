{"suttaId":"tha-ap157","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6531,6546],"vripara":"25"},"segments":{"tha-ap157:0.3":"Mandāravapupphapūjakattheraapadānaṃ","tha-ap157:1.1":"“Devaputto ahaṃ santo, pūjayiṃ sikhināyakaṃ;","tha-ap157:1.3":"Mandāravena pupphena, buddhassa abhiropayiṃ.","tha-ap157:2.1":"“Sattāhaṃ chadanaṃ āsi, dibbaṃ mālaṃ tathāgate;","tha-ap157:2.3":"Sabbe janā samāgantvā, namassiṃsu tathāgataṃ.","tha-ap157:3.1":"“Ekattiṃse ito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap157:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap157:4.1":"“Ito ca dasame kappe, rājāhosiṃ jutindharo;","tha-ap157:4.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap157:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap157:6.1":"Itthaṃ sudaṃ āyasmā mandāravapupphapūjako thero imā gāthāyo abhāsitthāti.","tha-ap157:7.1":"Mandāravapupphapūjakattherassāpadānaṃ pañcamaṃ."},"attha":null,"tika":null,"tika2":null}
