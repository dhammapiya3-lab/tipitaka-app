{"suttaId":"sn46.66","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[764,768],"vripara":"247"},"segments":{"sn46.66:0.3":"Ānāpānasuttaṃ","sn46.66:1.1":"“Ānāpānassati, bhikkhave, bhāvitā…pe…","sn46.66:1.2":"dasamaṃ.","sn46.66:1.3":"Ānāpānavaggo sattamo.","sn46.66:2.0":"Tassuddānaṃ –","sn46.66:2.1":"Aṭṭhikapuḷavakaṃ vinīlakaṃ,","sn46.66:2.2":"vicchiddakaṃ uddhumātena pañcamaṃ;","sn46.66:2.3":"Mettā karuṇā muditā","sn46.66:2.4":"upekkhā, ānāpānena te dasāti. 8."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":300,"to":302,"paras":[{"para":300,"vripara":"239-247","refs":["sn46.66:1"],"lines":["<b>Puḷavakasaññā</b>ti puḷavaṃ puḷavanti bhāventassa uppannasaññā.","<b>Vinīlakasaññā</b>dīsupi eseva nayo.","Vinicchayakathā panettha saddhiṃ bhāvanānayena visuddhimagge (visuddhi. 1.102) vuttā.","<b>Mettā</b>dayo tikacatukkajjhānavasena veditabbā, <b>upekkhā</b> catutthajjhānavaseneva. 8."],"lineRefs":[["sn46.66:1"],["sn46.66:1"],["sn46.66:1"],["sn46.66:1"]]},{"para":301,"vripara":null,"refs":["sn46.66:1"],"lines":["Nirodhavaggo 1-10."],"lineRefs":[["sn46.66:1"]]},{"para":302,"vripara":null,"refs":["sn46.66:1"],"lines":["Asubhasuttādivaṇṇanā 248-257."],"lineRefs":[["sn46.66:1"]]}],"wordLinks":[]},"tika":null,"tika2":null}
