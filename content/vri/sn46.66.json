{"suttaId":"sn46.66","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[764,768],"vripara":"247"},"segments":{"sn46.66:0.3":"Ānāpānasuttaṃ","sn46.66:1.1":"“Ānāpānassati, bhikkhave, bhāvitā … pe … dasamaṃ.","sn46.66:1.3":"Ānāpānavaggo sattamo.","sn46.66:2.0":"Tassuddānaṃ –","sn46.66:2.1":"Aṭṭhikapuḷavakaṃ vinīlakaṃ, vicchiddakaṃ uddhumātena pañcamaṃ;","sn46.66:2.3":"Mettā karuṇā muditā upekkhā, ānāpānena te dasāti."},"attha":null,"tika":null}
