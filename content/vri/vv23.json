{"suttaId":"vv23","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[712,745],"vripara":"217"},"segments":{"vv23:0.4":"Soṇadinnāvimānavatthu","vv23:1.1":"“Abhikkantena vaṇṇena,","vv23:1.2":"yā tvaṃ tiṭṭhasi devate;","vv23:1.3":"Obhāsentī disā sabbā,","vv23:1.4":"osadhī viya tārakā.","vv23:2.1":"“Kena tetādiso vaṇṇo,","vv23:2.2":"kena te idha mijjhati;","vv23:2.3":"Uppajjanti ca te bhogā,","vv23:2.4":"ye keci manaso piyā.","vv23:3.1":"“Pucchāmi taṃ devi mahānubhāve,","vv23:3.2":"manussabhūtā kimakāsi puññaṃ;","vv23:3.3":"Kenāsi evaṃ jalitānubhāvā,","vv23:3.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv23:4.1":"Sā devatā attamanā,","vv23:4.2":"moggallānena pucchitā;","vv23:4.3":"Pañhaṃ puṭṭhā viyākāsi,","vv23:4.4":"yassa kammassidaṃ phalaṃ.","vv23:5.1":"“Soṇadinnāti maṃ aññaṃsu,","vv23:5.2":"nāḷandāyaṃ upāsikā;","vv23:5.3":"Saddhā sīlena sampannā,","vv23:5.4":"saṃvibhāgaratā sadā.","vv23:6.1":"“Acchādanañca bhattañca,","vv23:6.2":"senāsanaṃ padīpiyaṃ;","vv23:6.3":"Adāsiṃ ujubhūtesu,","vv23:6.4":"vippasannena cetasā.","vv23:7.1":"“Cātuddasiṃ pañcadasiṃ,","vv23:7.2":"yā ca pakkhassa aṭṭhamī;","vv23:7.3":"Pāṭihāriyapakkhañca,","vv23:7.4":"aṭṭhaṅgasusamāgataṃ.","vv23:8.1":"“Uposathaṃ upavasissaṃ,","vv23:8.2":"sadā sīlesu saṃvutā;","vv23:8.3":"Saññamā saṃvibhāgā ca,","vv23:8.4":"vimānaṃ āvasāmahaṃ.","vv23:9.1":"“Pāṇātipātā viratā,","vv23:9.2":"musāvādā ca saññatā;","vv23:9.3":"Theyyā ca aticārā ca,","vv23:9.4":"majjapānā ca ārakā.","vv23:10.1":"“Pañcasikkhāpade ratā,","vv23:10.2":"ariyasaccāna kovidā;","vv23:10.3":"Upāsikā cakkhumato,","vv23:10.4":"gotamassa yasassino.","vv23:11.1":"“Tena metādiso vaṇṇo … pe …","vv23:11.3":"Vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv23:12.1":"Soṇadinnāvimānaṃ chaṭṭhaṃ."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1026,"to":1046,"paras":[{"para":1026,"vripara":"217","refs":["vv23:1"],"lines":["“Abhikkantena vaṇṇena, yā tvaṃ tiṭṭhasi devate;"],"lineRefs":[["vv23:1"]]},{"para":1027,"vripara":null,"refs":["vv23:1"],"lines":["Obhāsentī disā sabbā, osadhī viya tārakā."],"lineRefs":[["vv23:1"]]},{"para":1029,"vripara":"218","refs":["vv23:2"],"lines":["“Kena tetādiso vaṇṇo, kena te idha mijjhati;"],"lineRefs":[["vv23:2"]]},{"para":1030,"vripara":null,"refs":["vv23:2"],"lines":["Uppajjanti ca te bhogā, ye keci manaso piyā."],"lineRefs":[["vv23:2"]]},{"para":1032,"vripara":"219","refs":["vv23:3"],"lines":["“Pucchāmi taṃ devi mahānubhāve, manussabhūtā kimakāsi puññaṃ;"],"lineRefs":[["vv23:3"]]},{"para":1033,"vripara":null,"refs":["vv23:3"],"lines":["Kenāsi evaṃ jalitānubhāvā, vaṇṇo ca te sabbadisā pabhāsatī”ti.","–"],"lineRefs":[["vv23:3"],["vv23:3"]]},{"para":1034,"vripara":null,"refs":["vv23:3"],"lines":["Imāhi tīhi gāthāhi paṭipucchi."],"lineRefs":[["vv23:3"]]},{"para":1036,"vripara":"220","refs":["vv23:4"],"lines":["“Sā devatā attamanā, moggallānena pucchitā;"],"lineRefs":[["vv23:4"]]},{"para":1037,"vripara":null,"refs":["vv23:4"],"lines":["Pañhaṃ puṭṭhā viyākāsi, yassa kammassidaṃ phalaṃ”."],"lineRefs":[["vv23:4"]]},{"para":1039,"vripara":"221-226","refs":["vv23:5"],"lines":["221-226. “Soṇadinnāti maṃ aññaṃsu … pe … gotamassa yasassino."],"lineRefs":[["vv23:5"]]},{"para":1041,"vripara":"227","refs":["vv23:11"],"lines":["“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti.","–"],"lineRefs":[["vv23:11"],["vv23:11"]]},{"para":1042,"vripara":null,"refs":["vv23:11"],"lines":["Devatā byākāsi.","Taṃ sabbaṃ heṭṭhā vuttanayameva."],"lineRefs":[["vv23:11"],["vv23:11"]]},{"para":1043,"vripara":null,"refs":["vv23:11"],"lines":["Soṇadinnāvimānavaṇṇanā niṭṭhitā."],"lineRefs":[["vv23:11"]]},{"para":1044,"vripara":null,"refs":["vv23:11"],"lines":["Uposathāvimānavaṇṇanā"],"lineRefs":[["vv23:11"]]},{"para":1045,"vripara":null,"refs":["vv23:11"],"lines":["<b>Abhikkantena vaṇṇenā</b>ti uposathāvimānaṃ.","Idha aṭṭhuppattiyaṃ sākete uposathā nāma ekā upāsikāti ayameva viseso, sesaṃ anantaravimānasadisaṃ.","Tena vuttaṃ –"],"lineRefs":[["vv23:11"],["vv23:11"],["vv23:11"]]}],"wordLinks":[],"before":[{"para":1021,"vripara":null,"refs":[],"lines":["Atha bhagavā mātudevaputtappamukhānaṃ dasasahassilokadhātuvāsīnaṃ devabrahmasaṅghānaṃ tayo māse abhidhammapiṭakaṃ desetvā manussalokaṃ āgantvā bhadditthivimānaṃ bhikkhūnaṃ desesi.","Sā desanā sampattaparisāya sātthikā ahosīti."],"lineRefs":[[],[]]},{"para":1022,"vripara":null,"refs":[],"lines":["Bhadditthivimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1023,"vripara":null,"refs":[],"lines":["Soṇadinnāvimānavaṇṇanā"],"lineRefs":[[]]},{"para":1024,"vripara":null,"refs":[],"lines":["<b>Abhikkantena vaṇṇenā</b>ti soṇadinnāvimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tena ca samayena nāḷandāyaṃ soṇadinnā nāma ekā upāsikā saddhā pasannā bhikkhūnaṃ catūhi paccayehi sakkaccaṃ upaṭṭhahantī suvisuddhaniccasīlā aṭṭhaṅgasamannāgataṃ uposathampi upavasati.","Sā dhammasavanasappāyaṃ paṭilabhitvā upanissayasampannatāya catusaccakammaṭṭhānaṃ paribrūhantī sotāpannā ahosi.","Atha aññatarena rogena phuṭṭhā kālaṃ katvā tāvatiṃsesu uppajji.","Taṃ āyasmā mahāmoggallāno –"],"lineRefs":[[],[],[],[],[],[],[]]}]},"tika":null,"tika2":null}
