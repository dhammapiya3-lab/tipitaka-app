{"suttaId":"an10.195","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[1448,1449],"vripara":"195"},"segments":{"an10.195:0.3":"Bhāvetabbadhammasuttaṃ","an10.195:1.1":"“Bhāvetabbañca vo, bhikkhave, dhammaṃ desessāmi na bhāvetabbañca.","an10.195:1.2":"Taṃ suṇātha … pe …","an10.195:1.3":"katamo ca, bhikkhave, na bhāvetabbo dhammo?","an10.195:1.4":"Pāṇātipāto … pe …","an10.195:1.5":"micchādiṭṭhi –","an10.195:1.6":"ayaṃ vuccati, bhikkhave, na bhāvetabbo dhammo.","an10.195:2.1":"“Katamo ca, bhikkhave, bhāvetabbo dhammo?","an10.195:2.2":"Pāṇātipātā veramaṇī … pe …","an10.195:2.3":"sammādiṭṭhi –","an10.195:2.4":"ayaṃ vuccati, bhikkhave, bhāvetabbo dhammo”ti.","an10.195:2.5":"Sattamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":765,"to":769,"paras":[{"para":765,"vripara":"167-210","refs":["an10.195:1"],"lines":["167-210. Dutiye ca paṭhamādīni uttānatthāni.","Dasame <b>pacchābhūmivāsino</b>ti paccantadesavāsino.","<b>Sevālamālikā</b>ti pātova udakaṃ orohitvā sevālañceva uppalādīni ca gahetvā attano udakasuddhikabhāvajānanatthañceva “lokassa ca udakena suddhi hotī”ti imassa atthassa jānanatthañca mālaṃ katvā pilandhanakā.","<b>Udakorohakā</b>ti pāto majjhanhe sāyanhe ca udakaorohaṇakā.","Tenāha <b>“sāyatatiyakaṃ udakorohaṇānuyogamanuyuttā”</b>ti.","Ekādasamādīni uttānatthāni.","Catutthe paṇṇāsake natthi vattabbaṃ."],"lineRefs":[["an10.195:1"],["an10.195:1"],["an10.195:1"],["an10.195:1"],["an10.195:1"],["an10.195:1"],["an10.195:1"]]},{"para":766,"vripara":null,"refs":["an10.195:1"],"lines":["Brāhmaṇapaccorohaṇīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an10.195:1"]]},{"para":767,"vripara":null,"refs":["an10.195:1"],"lines":["Catutthapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an10.195:1"]]},{"para":768,"vripara":null,"refs":["an10.195:1"],"lines":["(21)1. Karajakāyavaggo"],"lineRefs":[["an10.195:1"]]},{"para":769,"vripara":null,"refs":["an10.195:1"],"lines":