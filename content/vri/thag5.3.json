{"suttaId":"thag5.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1540,1553],"vripara":"325"},"segments":{"thag5.3:0.4":"Girimānandattheragāthā","thag5.3:1.1":"“Vassati devo yathā sugītaṃ, channā me kuṭikā sukhā nivātā;","thag5.3:1.3":"Tassaṃ viharāmi vūpasanto, atha ce patthayasī pavassa deva.","thag5.3:2.1":"“Vassati devo yathā sugītaṃ, channā me kuṭikā sukhā nivātā;","thag5.3:2.3":"Tassaṃ viharāmi santacitto, atha ce patthayasī pavassa deva.","thag5.3:3.1":"“Vassati devo … pe … tassaṃ viharāmi vītarāgo … pe ….","thag5.3:4.1":"“Vassati devo … pe … tassaṃ viharāmi vītadoso … pe ….","thag5.3:5.1":"“Vassati devo … pe … tassaṃ viharāmi vītamoho;","thag5.3:5.4":"Atha ce patthayasī pavassa devā”ti.","thag5.3:5.5":"… Girimānando thero …."},"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":594,"to":594,"paras":[{"para":594,"vripara":null,"refs":["thag5.3:5"],"lines":["Tattha <b>yathāsugītan</b>ti sugītānurūpaṃ, sundarassa attano meghagītassa anurūpamevāti attho.","Valāhako hi yathā agajjanto kevalaṃ vassanto na sobhati, evaṃ satapaṭalasahassapaṭalena uṭṭhahitvā thanayanto gajjanto vijjullatā nicchārentopi avassanto na sobhati, tathābhūto pana hutvā vassanto sobhatīti vuttaṃ “vassati devo yathāsugītan”ti.","Tenāha –","“abhitthanaya, pajjunna”,(cariyā.3.89; jā.1.1.75)“gajjitā ceva vassitā cā”ti (a. ni.4.101; pu. pa.157) ca.","<b>Tassaṃ viharāmī</b>ti tassaṃ kuṭikāyaṃ ariyavihāragabbhena iriyāpathavihārena viharāmi.","<b>Vūpasantacitto</b>ti aggaphalasamādhinā sammadeva upasantamānaso."],"lineRefs":[["thag5.3:5"],["thag5.3:5"],["thag5.3:5"],["thag5.3:5"],["thag5.3:5"],["thag5.3:5"]]}],"wordLinks":[["thag5.3:5.1","tassaṃ viharāmī",0,4]],"before":[{"para":521,"vripara":null,"refs":[],"lines":["Subhūtattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":522,"vripara":null,"refs":[],"lines":["Girimānandattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":523,"vripara":null,"refs":[],"lines":["<b>Vassati devo</b>tiādikā āyasmato girimānandattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto sumedhassa bhagavato kāle kulagehe nibbattitvā vayappatto gharāvāsaṃ vasanto attano bhariyāya putte ca kālaṅkate sokasallasamappito araññaṃ paviṭṭho satthārā tattha gantvā dhammaṃ kathetvā sokasalle abbūḷhe pasannamānaso sugandhapupphehi pūjetvā pañcapatiṭṭhitena vanditvā sirasi añjaliṃ katvā abhitthavi."],"lineRefs":[[],[],[]]},{"para":524,"vripara":null,"refs":[],"lines":["So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde rājagahe bimbisārarañño purohitassa putto hutvā nibbatti, <b>girimānando</b>tissa nāmaṃ ahosi.","So viññutaṃ patto satthu rājagahagamane buddhānubhāvaṃ disvā paṭiladdhasaddho pabbajitvā samaṇadhammaṃ karonto katipayaṃ divasaṃ gāmakāvāse vasitvā satthāraṃ vandituṃ rājagahaṃ agamāsi.","Bimbisāramahārājā tassa āgamanaṃ sutvā upasaṅkamitvā “idheva, bhante, vasatha, ahaṃ catūhi paccayehi upaṭṭhahāmī”ti sampavāretvā gato bahukiccatāya na sari.","“Thero abbhokāse vasatī”ti devatā therassa temanabhayena vassaṃ vāresuṃ.","Rājā avassanakāraṇaṃ sallakkhetvā therassa kuṭikaṃ kārāpesi.","Thero kuṭikāyaṃ vasanto senāsanasappāyalābhena samādhānaṃ labhitvā vīriyasamataṃ yojetvā vipassanaṃ ussukkāpetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.40.419-448)–"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":525,"vripara":null,"refs":[],"lines":["“Bhariyā me kālaṅkatā, putto sivathikaṃ gato;"],"lineRefs":[[]]},{"para":526,"vripara":null,"refs":[],"lines":["Mātā pitā matā bhātā, ekacitamhi ḍayhare."],"lineRefs":[[]]},{"para":527,"vripara":null,"refs":[],"lines":["“Tena sokena santatto, kiso paṇḍu ahosahaṃ;"],"lineRefs":[[]]},{"para":528,"vripara":null,"refs":[],"lines":["Cittakkhepo ca me āsi, tena sokena aṭṭito."],"lineRefs":[[]]},{"para":529,"vripara":null,"refs":[],"lines":["“Sokasallaparetohaṃ, vanantamupasaṅkamiṃ;"],"lineRefs":[[]]},{"para":530,"vripara":null,"refs":[],"lines":["Pavattaphalaṃ bhuñjitvā, rukkhamūle vasāmahaṃ."],"lineRefs":[[]]},{"para":531,"vripara":null,"refs":[],"lines":["“Sumedho nāma sambuddho, dukkhassantakaro jino;"],"lineRefs":[[]]},{"para":532,"vripara":null,"refs":[],"lines":["Mamuddharitukāmo so, āgañchi mama santikaṃ."],"lineRefs":[[]]},{"para":533,"vripara":null,"refs":[],"lines":["“Padasaddaṃ suṇitvāna, sumedhassa mahesino;"],"lineRefs":[[]]},{"para":534,"vripara":null,"refs":[],"lines":["Paggahetvānahaṃ sīsaṃ, ullokesiṃ mahāmuniṃ."],"lineRefs":[[]]},{"para":535,"vripara":null,"refs":[],"lines":["“Upāgate mahāvīre, pīti me udapajjatha;"],"lineRefs":[[]]},{"para":536,"vripara":null,"refs":[],"lines":["Tadāsimekaggamano, disvā taṃ lokanāyakaṃ."],"lineRefs":[[]]},{"para":537,"vripara":null,"refs":[],"lines":["“Satiṃ paṭilabhitvāna, paṇṇamuṭṭhimadāsahaṃ;"],"lineRefs":[[]]},{"para":538,"vripara":null,"refs":[],"lines":["Nisīdi bhagavā tattha, anukampāya cakkhumā."],"lineRefs":[[]]},{"para":539,"vripara":null,"refs":[],"lines":["“Nisajja tattha bhagavā, sumedho lokanāyako;"],"lineRefs":[[]]},{"para":540,"vripara":null,"refs":[],"lines":["Dhammaṃ me kathayī buddho, sokasallavinodanaṃ."],"lineRefs":[[]]},{"para":541,"vripara":null,"refs":[],"lines":["“Anavhitā tato āguṃ, ananuññātā ito gatā;"],"lineRefs":[[]]},{"para":542,"vripara":null,"refs":[],"lines":["Yathāgatā tathā gatā, tattha kā paridevanā."],"lineRefs":[[]]},{"para":543,"vripara":null,"refs":[],"lines":["“Yathāpi pathikā sattā, vassamānāya vuṭṭhiyā;"],"lineRefs":[[]]},{"para":544,"vripara":null,"refs":[],"lines":["Sabhaṇḍā upagacchanti, vassassāpatanāya te."],"lineRefs":[[]]},{"para":545,"vripara":null,"refs":[],"lines":["“Vasse ca te oramite, sampayanti yadicchakaṃ;"],"lineRefs":[[]]},{"para":546,"vripara":null,"refs":[],"lines":["Evaṃ mātā pitā tuyhaṃ, tattha kā paridevanā."],"lineRefs":[[]]},{"para":547,"vripara":null,"refs":[],"lines":["“Āgantukā pāhunakā, caliteritakampitā;"],"lineRefs":[[]]},{"para":548,"vripara":null,"refs":[],"lines":["Evaṃ mātā pitā tuyhaṃ, tattha kā paridevanā."],"lineRefs":[[]]},{"para":549,"vripara":null,"refs":[],"lines":["“Yathāpi urago jiṇṇaṃ, hitvā gacchati saṃ tacaṃ;"],"lineRefs":[[]]},{"para":550,"vripara":null,"refs":[],"lines":["Evaṃ mātā pitā tuyhaṃ, saṃ tanuṃ idha hīyare."],"lineRefs":[[]]},{"para":551,"vripara":null,"refs":[],"lines":["“Buddhassa giramaññāya, sokasallaṃ vivajjayiṃ;"],"lineRefs":[[]]},{"para":552,"vripara":null,"refs":[],"lines":["Pāmojjaṃ janayitvāna, buddhaseṭṭhaṃ avandahaṃ."],"lineRefs":[[]]},{"para":553,"vripara":null,"refs":[],"lines":["“Vanditvāna mahānāgaṃ, pūjayiṃ girimañjariṃ;"],"lineRefs":[[]]},{"para":554,"vripara":null,"refs":[],"lines":["Dibbagandhaṃ sampavantaṃ, sumedhaṃ lokanāyakaṃ."],"lineRefs":[[]]},{"para":555,"vripara":null,"refs":[],"lines":["“Pūjayitvāna sambuddhaṃ, sire katvāna añjaliṃ;"],"lineRefs":[[]]},{"para":556,"vripara":null,"refs":[],"lines":["Anussaraṃ guṇaggāni, santhaviṃ lokanāyakaṃ."],"lineRefs":[[]]},{"para":557,"vripara":null,"refs":[],"lines":["“Nittiṇṇosi mahāvīra, sabbaññu lokanāyaka;"],"lineRefs":[[]]},{"para":558,"vripara":null,"refs":[],"lines":["Sabbe satte uddharasi, ñāṇena tvaṃ mahāmune."],"lineRefs":[[]]},{"para":559,"vripara":null,"refs":[],"lines":["“Vimatiṃ dveḷhakaṃ vāpi, sañchindasi mahāmune;"],"lineRefs":[[]]},{"para":560,"vripara":null,"refs":[],"lines":["Paṭipādesi me maggaṃ, tava ñāṇena cakkhuma."],"lineRefs":[[]]},{"para":561,"vripara":null,"refs":[],"lines":["“Arahā vasipattā ca, chaḷabhiññā mahiddhikā;"],"lineRefs":[[]]},{"para":562,"vripara":null,"refs":[],"lines":["Antalikkhacarā dhīrā, parivārenti tāvade."],"lineRefs":[[]]},{"para":563,"vripara":null,"refs":[],"lines":["“Paṭipannā ca sekhā ca, phalaṭṭhā santi sāvakā;"],"lineRefs":[[]]},{"para":564,"vripara":null,"refs":[],"lines":["Surodayeva padumā, pupphanti tava sāvakā."],"lineRefs":[[]]},{"para":565,"vripara":null,"refs":[],"lines":["“Mahāsamuddovakkhobho, atulopi duruttaro;"],"lineRefs":[[]]},{"para":566,"vripara":null,"refs":[],"lines":["Evaṃ ñāṇena sampanno, appameyyosi cakkhuma."],"lineRefs":[[]]},{"para":567,"vripara":null,"refs":[],"lines":["“Vanditvāhaṃ lokajinaṃ, cakkhumantaṃ mahāyasaṃ;"],"lineRefs":[[]]},{"para":568,"vripara":null,"refs":[],"lines":["Puthudisā namassanto, paṭikuṭiko āgañchahaṃ."],"lineRefs":[[]]},{"para":569,"vripara":null,"refs":[],"lines":["“Devalokā cavitvāna, sampajāno patissato;"],"lineRefs":[[]]},{"para":570,"vripara":null,"refs":[],"lines":["Okkamiṃ mātuyā kucchiṃ, sandhāvanto bhavābhave."],"lineRefs":[[]]},{"para":571,"vripara":null,"refs":[],"lines":["“Agārā abhinikkhamma, pabbajiṃ anagāriyaṃ;"],"lineRefs":[[]]},{"para":572,"vripara":null,"refs":[],"lines":["Ātāpī nipako jhāyī, paṭisallānagocaro."],"lineRefs":[[]]},{"para":573,"vripara":null,"refs":[],"lines":["“Padhānaṃ padahitvāna, tosayitvā mahāmuniṃ;"],"lineRefs":[[]]},{"para":574,"vripara":null,"refs":[],"lines":["Candovabbhaghanā mutto, vicarāmi ahaṃ sadā."],"lineRefs":[[]]},{"para":575,"vripara":null,"refs":[],"lines":["“Vivekamanuyuttomhi, upasanto nirūpadhi;"],"lineRefs":[[]]},{"para":576,"vripara":null,"refs":[],"lines":["Sabbāsave pariññāya, viharāmi anāsavo."],"lineRefs":[[]]},{"para":577,"vripara":null,"refs":[],"lines":["“Tiṃsakappasahassamhi, yaṃ buddhamabhipūjayiṃ;"],"lineRefs":[[]]},{"para":578,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":579,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":580,"vripara":null,"refs":[],"lines":["Atha therassa arahattappattiyā haṭṭhatuṭṭhe viya deve vassante upari taṃ vassane niyojanamukhena aññaṃ byākaronto –"],"lineRefs":[[]]},{"para":582,"vripara":"325","refs":[],"lines":["“Vassati devo yathāsugītaṃ, channā me kuṭikā sukhā nivātā;"],"lineRefs":[[]]},{"para":583,"vripara":null,"refs":[],"lines":["Tassaṃ viharāmi vūpasanto, atha ce patthayasī pavassa deva."],"lineRefs":[[]]},{"para":585,"vripara":"326","refs":[],"lines":["“Vassati devo yathāsugītaṃ, channā me kuṭikā sukhā nivātā;"],"lineRefs":[[]]},{"para":586,"vripara":null,"refs":[],"lines":["Tassaṃ viharāmi santacitto, atha ce patthayasī pavassa deva."],"lineRefs":[[]]},{"para":588,"vripara":"327","refs":[],"lines":["“Vassati devo … pe … tassaṃ viharāmi vītarāgo … pe …."],"lineRefs":[[]]},{"para":590,"vripara":"328","refs":[],"lines":["“Vassati devo … pe … tassaṃ viharāmi vītadoso … pe …."],"lineRefs":[[]]},{"para":592,"vripara":"329","refs":[],"lines":["“Vassati devo … pe … tassaṃ viharāmi vītamoho;"],"lineRefs":[[]]},{"para":593,"vripara":null,"refs":[],"lines":["Atha ce patthayasī pavassa devā”ti.","– imā pañca gāthā abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
