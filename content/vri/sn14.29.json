{"suttaId":"sn14.29","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[816,822],"vripara":"113"},"segments":{"sn14.29:0.3":"Dasaṅgasuttaṃ","sn14.29:1.1":"Sāvatthiyaṃ viharati…pe…","sn14.29:1.2":"“dhātusova, bhikkhave, sattā saṃsandanti samenti.","sn14.29:1.3":"Micchādiṭṭhikā micchādiṭṭhikehi saddhiṃ saṃsandanti samenti;","sn14.29:1.4":"micchāsaṅkappā…pe…","sn14.29:1.5":"micchāvācā…","sn14.29:1.6":"micchākammantā…","sn14.29:1.7":"micchāājīvā…","sn14.29:1.8":"micchāvāyāmā…","sn14.29:1.9":"micchāsatino …","sn14.29:1.10":"micchāsamādhino micchāsamādhīhi saddhiṃ saṃsandanti samenti;","sn14.29:1.11":"micchāñāṇino micchāñāṇīhi saddhiṃ saṃsandanti samenti;","sn14.29:1.12":"micchāvimuttino micchāvimuttīhi saddhiṃ saṃsandanti samenti”.","sn14.29:2.1":"“Sammādiṭṭhikā sammādiṭṭhikehi saddhiṃ saṃsandanti samenti;","sn14.29:2.2":"sammāsaṅkappā…pe…","sn14.29:2.3":"sammāvācā…","sn14.29:2.4":"sammākammantā…","sn14.29:2.5":"sammāājīvā…","sn14.29:2.6":"sammāvāyāmā…","sn14.29:2.7":"sammāsatino…","sn14.29:2.8":"sammāsamādhino…","sn14.29:2.9":"sammāñāṇino sammāñāṇīhi saddhiṃ saṃsandanti samenti;","sn14.29:2.10":"sammāvimuttino sammāvimuttīhi saddhiṃ saṃsandanti samentī”ti.","sn14.29:2.11":"Sattamaṃ.","sn14.29:2.12":"Sattannaṃ suttantānaṃ uddānaṃ –","sn14.29:3.1":"Asamāhitaṃ dussīlaṃ,","sn14.29:3.2":"pañca sikkhāpadāni ca;","sn14.29:3.3":"Satta kammapathā vuttā,","sn14.29:3.4":"dasakammapathena ca;","sn14.29:3.5":"Chaṭṭhaṃ aṭṭhaṅgiko vutto,","sn14.29:3.6":"dasaṅgena ca sattamaṃ.","sn14.29:3.7":"Kammapathavaggo tatiyo. 4."},"unsure":["sn14.29:2.12"],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":592,"to":592,"paras":[{"para":592,"vripara":"113","refs":["sn14.29:1","sn14.29:2"],"lines":["Sattamaṃ dasamicchattasammattavasena.","Tattha <b>micchāñāṇino</b>ti micchāpaccavekkhaṇena samannāgatāti attho.","<b>Micchāvimuttino</b>ti aniyyānikavimuttino kusalavimuttīti gahetvā ṭhitā.","<b>Sammāñāṇino</b>ti sammāpaccavekkhaṇā.","<b>Sammāvimuttino</b>ti niyyānikāya phalavimuttiyā samannāgatāti.","Sattamaṃ."],"lineRefs":[["sn14.29:1"],["sn14.29:1"],["sn14.29:1"],["sn14.29:2"],["sn14.29:2"],["sn14.29:2"]]}],"wordLinks":[["sn14.29:1.11","micchāñāṇino",0,1],["sn14.29:1.12","micchāvimuttino",0,2],["sn14.29:2.2","sammāñāṇino",0,3],["sn14.29:2.10","sammāvimuttino",0,4]],"after":[{"para":593,"vripara":null,"title":"Dasaṅgasuttavaṇṇanā","lines":["Kammapathavaggo tatiyo. 4."]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":585,"to":585,"paras":[{"para":585,"vripara":"113","refs":["sn14.29:1"],"lines":["<b>Micchattasammattavasenā</b>ti ettha micchābhāvo <b>micchattaṃ,</b> tathā sammābhāvo <b>sammattaṃ</b>.","Tathā tathā pavattā akusalakkhandhāva micchāsati, evaṃ micchāñāṇampi daṭṭhabbaṃ.","Na hi ñāṇassa micchābhāvo nāma atthi.","Tasmā <b>micchāñāṇino</b>ti micchāsaññāṇāti attho, ayoniso pavattacittuppādāti adhippāyo.","<b>Micchāpaccavekkhaṇenā</b>ti micchādiṭṭhiādīnaṃ micchā ayoniso paccavekkhaṇena.","<b>Kusalavimuttī</b>ti pakatipurisasantarajānanaṃ, guṇaviyuttassa attano sakattani avaṭṭhānanti evamādiṃ akusalapavattiṃ “kusalavimuttī”ti gahetvā ṭhitā micchāvimuttikā.","<b>Sammāpaccavekkhaṇā</b>ti jhānavimokkhādīsu sammā aviparītaṃ pavattā paccavekkhaṇā."],"lineRefs":[["sn14.29:1"],["sn14.29:1"],["sn14.29:1"],["sn14.29:1"],["sn14.29:1"],["sn14.29:1"],["sn14.29:1"]]}],"wordLinks":[["sn14.29:1.11","micchāñāṇino",0,3]],"after":[{"para":586,"vripara":null,"title":"Dasaṅgasuttavaṇṇanā","lines":["Dasaṅgasuttavaṇṇanā niṭṭhitā."]},{"para":587,"vripara":null,"title":"Dasaṅgasuttavaṇṇanā","lines":["Tatiyavaggavaṇṇanā niṭṭhitā. 4."]}]},"tika2":null}
