{"suttaId":"bv19","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[2306,2388],"vripara":"1"},"segments":{"bv19:0.2":"Tissabuddhavaṃso","bv19:1.1":"Siddhatthassa aparena,","bv19:1.2":"asamo appaṭipuggalo;","bv19:1.3":"Anantatejo amitayaso,","bv19:1.4":"tisso lokagganāyako.","bv19:2.1":"Tamandhakāraṃ vidhamitvā,","bv19:2.2":"obhāsetvā sadevakaṃ;","bv19:2.3":"Anukampako mahāvīro,","bv19:2.4":"loke uppajji cakkhumā.","bv19:3.1":"Tassāpi atulā iddhi,","bv19:3.2":"atulaṃ sīlaṃ samādhi ca;","bv19:3.3":"Sabbattha pāramiṃ gantvā,","bv19:3.4":"dhammacakkaṃ pavattayi.","bv19:4.1":"So buddho dasasahassimhi,","bv19:4.2":"viññāpesi giraṃ suciṃ;","bv19:4.3":"Koṭisatāni abhisamiṃsu,","bv19:4.4":"paṭhame dhammadesane.","bv19:5.1":"Dutiyo navutikoṭīnaṃ,","bv19:5.2":"tatiyo saṭṭhikoṭiyo;","bv19:5.3":"Bandhanāto pamocesi,","bv19:5.4":"satte [sampatte (ka.)] naramarū tadā.","bv19:6.1":"Sannipātā tayo āsuṃ,","bv19:6.2":"tisse lokagganāyake;","bv19:6.3":"Khīṇāsavānaṃ vimalānaṃ,","bv19:6.4":"santacittāna tādinaṃ.","bv19:7.1":"Khīṇāsavasatasahassānaṃ,","bv19:7.2":"paṭhamo āsi samāgamo;","bv19:7.3":"Navutisatasahassānaṃ,","bv19:7.4":"dutiyo āsi samāgamo.","bv19:8.1":"Asītisatasahassānaṃ,","bv19:8.2":"tatiyo āsi samāgamo;","bv19:8.3":"Khīṇāsavānaṃ vimalānaṃ,","bv19:8.4":"pupphitānaṃ vimuttiyā.","bv19:9.1":"Ahaṃ tena samayena,","bv19:9.2":"sujāto nāma khattiyo;","bv19:9.3":"Mahābhogaṃ chaḍḍayitvā,","bv19:9.4":"pabbajiṃ isipabbajaṃ.","bv19:10.1":"Mayi pabbajite sante,","bv19:10.2":"uppajji lokanāyako;","bv19:10.3":"Buddhoti saddaṃ sutvāna,","bv19:10.4":"pīti me upapajjatha.","bv19:11.1":"Dibbaṃ mandāravaṃ pupphaṃ,","bv19:11.2":"padumaṃ pārichattakaṃ;","bv19:11.3":"Ubho hatthehi paggayha,","bv19:11.4":"dhunamāno upāgamiṃ.","bv19:12.1":"Catuvaṇṇaparivutaṃ,","bv19:12.2":"tissaṃ lokagganāyakaṃ;","bv19:12.3":"Tamahaṃ pupphaṃ gahetvā,","bv19:12.4":"matthake dhārayiṃ jinaṃ.","bv19:13.1":"Sopi maṃ buddho byākāsi,","bv19:13.2":"janamajjhe nisīdiya;","bv19:13.3":"“Dvenavute ito kappe,","bv19:13.4":"ayaṃ buddho bhavissati.","bv19:14.1":"“Padhānaṃ padahitvāna … pe …","bv19:14.3":"hessāma sammukhā imaṃ”.","bv19:15.1":"Tassāpi vacanaṃ sutvā,","bv19:15.2":"bhiyyo cittaṃ pasādayiṃ;","bv19:15.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv19:15.4":"dasapāramipūriyā.","bv19:16.1":"Khemakaṃ nāma nagaraṃ,","bv19:16.2":"janasandho nāma khattiyo;","bv19:16.3":"Padumā nāma janikā,","bv19:16.4":"tissassa ca mahesino.","bv19:17.1":"Sattavassasahassāni,","bv19:17.2":"agāraṃ ajjha so vasi;","bv19:17.3":"Guhāsela nārisaya nisabhā [kumudo nāḷiyo padumo (ka.)],","bv19:17.4":"tayo pāsādamuttamā.","bv19:18.1":"Samatiṃsasahassāni,","bv19:18.2":"nāriyo samalaṅkatā;","bv19:18.3":"Subhaddānāmikā nārī,","bv19:18.4":"ānando nāma atrajo.","bv19:19.1":"Nimitte caturo disvā,","bv19:19.2":"assayānena nikkhami;","bv19:19.3":"Anūnaaṭṭhamāsāni,","bv19:19.4":"padhānaṃ padahī jino.","bv19:20.1":"Brahmunā yācito santo,","bv19:20.2":"tisso lokagganāyako;","bv19:20.3":"Vatti cakkaṃ mahāvīro,","bv19:20.4":"yasavatiyamuttame.","bv19:21.1":"Brahmadevo udayo ca,","bv19:21.2":"ahesuṃ aggasāvakā;","bv19:21.3":"Samaṅgo nāmupaṭṭhāko,","bv19:21.4":"tissassa ca mahesino.","bv19:22.1":"Phussā ceva sudattā ca,","bv19:22.2":"ahesuṃ aggasāvikā;","bv19:22.3":"Bodhi tassa bhagavato,","bv19:22.4":"asanoti pavuccati.","bv19:23.1":"Sambalo ca sirimā ceva,","bv19:23.2":"ahesuṃ aggupaṭṭhakā;","bv19:23.3":"Kisāgotamī upasenā,","bv19:23.4":"ahesuṃ aggupaṭṭhikā.","bv19:24.1":"So buddho saṭṭhiratano,","bv19:24.2":"ahu uccattane jino;","bv19:24.3":"Anūpamo asadiso,","bv19:24.4":"himavā viya dissati.","bv19:25.1":"Tassāpi atulatejassa,","bv19:25.2":"āyu āsi anuttaro;","bv19:25.3":"Vassasatasahassāni,","bv19:25.4":"loke aṭṭhāsi cakkhumā.","bv19:26.1":"Uttamaṃ pavaraṃ seṭṭhaṃ,","bv19:26.2":"anubhotvā mahāyasaṃ;","bv19:26.3":"Jalitvā aggikkhandhova,","bv19:26.4":"nibbuto so sasāvako.","bv19:27.1":"Valāhakova anilena,","bv19:27.2":"sūriyena viya ussavo;","bv19:27.3":"Andhakārova padīpena,","bv19:27.4":"nibbuto so sasāvako.","bv19:28.1":"Tisso jinavaro buddho,","bv19:28.2":"nandārāmamhi nibbuto;","bv19:28.3":"Tatthevassa jinathūpo,","bv19:28.4":"tīṇiyojanamuggatoti.","bv19:29.1":"Tissassa bhagavato vaṃso sattarasamo."},"unsure":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":3160,"to":3219,"paras":[{"para":3160,"vripara":null,"refs":["bv19:4"],"lines":["Tattha <b>sabbatthā</b>ti sabbesu dhammesu pāraṃ gantvā.","<b>Dasasahassimhī</b>ti dasasahassiyaṃ athāparena samayena tissena satthārā saddhiṃ pabbajitānaṃ bhikkhūnaṃ koṭi mahāpurisassa gaṇavāsaṃ pahāya bodhimūlamupagamanasamaye aññatra gatā.","Sā tissena sammāsambuddhena dhammacakkaṃ pavattitan”ti sutvā yasavatīmigadāyaṃ āgantvā dasabalamabhivādetvā taṃ parivāretvā nisīdi.","Tesaṃ bhagavā dhammaṃ desesi, tadā navutiyā koṭīnaṃ dutiyābhisamayo ahosi.","Puna mahāmaṅgalasamāgame maṅgalapariyosāne saṭṭhiyā koṭīnaṃ tatiyo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv19:4"],["bv19:4"],["bv19:4"],["bv19:4"],["bv19:4"],["bv19:4"]]},{"para":3162,"vripara":"5","refs":["bv19:4"],"lines":["“Dutiyo navutikoṭīnaṃ, tatiyo saṭṭhikoṭiyo;"],"lineRefs":[["bv19:4"]]},{"para":3163,"vripara":null,"refs":["bv19:4"],"lines":["Bandhanāto pamocesi, satte naramarū tadā”ti."],"lineRefs":[["bv19:4"]]},{"para":3164,"vripara":null,"refs":["bv19:5"],"lines":["Tattha <b>dutiyo navutikoṭīnan</b>ti dutiyo abhisamayo ahosi navutikoṭipāṇīnanti attho.","<b>Bandhanāto</b>ti bandhanato, dasahi saṃyojanehi parimocesīti attho.","Idāni parimocite satte sarūpato dassento <b>“naramarū”</b>ti āha.","<b>Naramarū</b>ti narāmare."],"lineRefs":[["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"]]},{"para":3165,"vripara":null,"refs":["bv19:5"],"lines":["Yasavatīnagare kira antovassaṃ pabbajitānaṃ arahantānaṃ satasahassehi parivuto pavāresi, so paṭhamo sannipāto ahosi.","Ubhato sujātassa sujātassa nāma rañño nārivāhanakumāro nārivāhananagaraṃ anuppatte bhagavati lokanāthe saparivāro paccuggantvā dasabalaṃ sabhikkhusaṅghaṃ nimantetvā sattāhaṃ asadisadānaṃ datvā attano rajjaṃ puttassa niyyātetvā saparivāro sabbalokādhipatissa tissasammāsambuddhassa santike ehibhikkhupabbajjāya pabbaji.","Tassa kira sā pabbajjā sabbadisāsu pākaṭā ahosi.","Tasmā tato tato āgantvā nārivāhanakumāraṃ mahājano anupabbaji.","Tadā tathāgato navutiyā bhikkhusatasahassassa majjhagato pātimokkhaṃ uddisi, so dutiyo sannipāto ahosi.","Puna khemavatīnagare ñātisamāgame buddhavaṃsadhammakathaṃ sutvā asītisatasahassāni tassa santike pabbajitvā arahattaṃ pāpuṇiṃsu, tehi parivuto sugato pātimokkhaṃ uddisi, so tatiyo sannipāto ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"]]},{"para":3167,"vripara":"6","refs":["bv19:5"],"lines":["“Sannipātā tayo āsuṃ, tisse lokagganāyake;"],"lineRefs":[["bv19:5"]]},{"para":3168,"vripara":null,"refs":["bv19:5"],"lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ."],"lineRefs":[["bv19:5"]]},{"para":3170,"vripara":"7","refs":["bv19:5"],"lines":["“Khīṇāsavasatasahassānaṃ, paṭhamo āsi samāgamo;"],"lineRefs":[["bv19:5"]]},{"para":3171,"vripara":null,"refs":["bv19:5"],"lines":["Navutisatasahassānaṃ, dutiyo āsi samāgamo."],"lineRefs":[["bv19:5"]]},{"para":3173,"vripara":"8","refs":["bv19:5"],"lines":["“Asītisatasahassānaṃ, tatiyo āsi samāgamo;"],"lineRefs":[["bv19:5"]]},{"para":3174,"vripara":null,"refs":["bv19:5"],"lines":["Khīṇāsavānaṃ vimalānaṃ, pupphitānaṃ vimuttiyā”ti."],"lineRefs":[["bv19:5"]]},{"para":3175,"vripara":null,"refs":["bv19:5"],"lines":["Tadā amhākaṃ bodhisatto yasavatīnagare sujāto nāma rājā hutvā iddhaṃ phītaṃ janapadaṃ anekakoṭidhanasannicayaṃ anurāgamupagatahadayañca parijanaṃ tiṇanaḷamiva pariccajitvā jātiādīsu saṃviggahadayo nikkhamitvā tāpasapabbajjaṃ pabbajitvā mahiddhiko mahānubhāvo hutvā “buddho loke uppanno”ti sutvā pañcavaṇṇāya pītiyā phuṭasarīro hutvā sapatisso tissaṃ bhagavantaṃ upasaṅkamitvā vanditvā cintesi –","“handāhaṃ mandāravapāricchattakādīhi dibbakusumehi bhagavantaṃ pūjessāmī”ti.","Atha so evaṃ cintetvā iddhiyā saggalokaṃ gantvā cittalatāvanaṃ pavisitvā padumapāricchattakamandāravādīhi dibbakusumehi ratanamayaṃ caṅkoṭakaṃ gāvutappamāṇaṃ pūretvā gahetvā gaganatalena āgantvā dibbehi surabhikusumehi bhagavantaṃ pūjesi.","Ekañca maṇidaṇḍakaṃ suvaṇṇamayakaṇṇikaṃ padumarāgamaṇimayapaṇṇaṃ sugandhakesaracchattaṃ viya padumacchattaṃ bhagavato sirasi dhārayanto catuparisamajjhe aṭṭhāsi.","Atha bhagavā naṃ –","“ito dvenavute kappe gotamo nāma buddho bhavissatī”ti byākāsi.","Tena vuttaṃ –"],"lineRefs":[["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"]]},{"para":3177,"vripara":"9","refs":["bv19:5"],"lines":["“Ahaṃ tena samayena, sujāto nāma khattiyo;"],"lineRefs":[["bv19:5"]]},{"para":3178,"vripara":null,"refs":["bv19:5"],"lines":["Mahābhogaṃ chaḍḍayitvā, pabbajiṃ isipabbajaṃ."],"lineRefs":[["bv19:5"]]},{"para":3180,"vripara":"10","refs":["bv19:5"],"lines":["“Mayi pabbajite sante, uppajji lokanāyako;"],"lineRefs":[["bv19:5"]]},{"para":3181,"vripara":null,"refs":["bv19:5"],"lines":["Buddhoti saddaṃ sutvāna, pīti me upapajjatha."],"lineRefs":[["bv19:5"]]},{"para":3183,"vripara":"11","refs":["bv19:5"],"lines":["“Dibbaṃ mandāravaṃ pupphaṃ, padumaṃ pārichattakaṃ;"],"lineRefs":[["bv19:5"]]},{"para":3184,"vripara":null,"refs":["bv19:5"],"lines":["Ubho hatthehi paggayha, dhunamāno upāgamiṃ."],"lineRefs":[["bv19:5"]]},{"para":3186,"vripara":"12","refs":["bv19:5"],"lines":["“Cātuvaṇṇaparivutaṃ, tissaṃ lokagganāyakaṃ;"],"lineRefs":[["bv19:5"]]},{"para":3187,"vripara":null,"refs":["bv19:5"],"lines":["Tamahaṃ pupphaṃ gahetvā, matthake dhārayiṃ jinaṃ."],"lineRefs":[["bv19:5"]]},{"para":3189,"vripara":"13","refs":["bv19:5"],"lines":["“Sopi maṃ buddho byākāsi, janamajjhe nisīdiya;"],"lineRefs":[["bv19:5"]]},{"para":3190,"vripara":null,"refs":["bv19:5"],"lines":["Dvenavute ito kappe, ayaṃ buddho bhavissati."],"lineRefs":[["bv19:5"]]},{"para":3192,"vripara":"14","refs":["bv19:5"],"lines":["“Padhānaṃ padahitvāna … pe … hessāma sammukhā imaṃ."],"lineRefs":[["bv19:5"]]},{"para":3194,"vripara":"15","refs":["bv19:5"],"lines":["“Tassāpi vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[["bv19:5"]]},{"para":3195,"vripara":null,"refs":["bv19:5"],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā”ti."],"lineRefs":[["bv19:5"]]},{"para":3196,"vripara":null,"refs":["bv19:5"],"lines":["Tattha <b>mayi pabbajite</b>ti mayi pabbajitabhāvaṃ upagate.","“Mama pabbajitaṃ santan”ti potthakesu likhanti, so pamādalekhoti veditabbo.","<b>Upapajjathā</b>ti uppajjittha.","<b>Ubho hatthehī</b>ti ubhehi hatthehi.","<b>Paggayhā</b>ti gahetvāna.","<b>Dhunamāno</b>ti vākacīrāni vidhunamānova.","<b>Cātuvaṇṇaparivutan</b>ti catuparisaparivutaṃ, khattiyabrāhmaṇagahapatisamaṇaparivutanti attho.","“Catuvaṇṇehi parivutan”ti paṭhanti keci."],"lineRefs":[["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"]]},{"para":3197,"vripara":null,"refs":["bv19:5"],"lines":["Tassa pana bhagavato khemaṃ nāma nagaraṃ ahosi.","Janasandho nāma khattiyo pitā, padumā nāma janikā, brahmadevo ca udayo ca dve aggasāvakā, samaṅgo nāmupaṭṭhāko, phussā ca sudattā ca dve aggasāvikā, asanarukkho bodhi, sarīraṃ saṭṭhihatthubbedhaṃ ahosi, vassasatasahassaṃ āyu, subhaddā nāma aggamahesī, ānando nāma putto, turaṅgayānena nikkhami.","Tena vuttaṃ –"],"lineRefs":[["bv19:5"],["bv19:5"],["bv19:5"]]},{"para":3199,"vripara":"16","refs":["bv19:5"],"lines":["“Khemakaṃ nāma nagaraṃ, janasandho nāma khattiyo;"],"lineRefs":[["bv19:5"]]},{"para":3200,"vripara":null,"refs":["bv19:5"],"lines":["Padumā nāma janikā, tissassa ca mahesino."],"lineRefs":[["bv19:5"]]},{"para":3202,"vripara":"21","refs":["bv19:5"],"lines":["“Brahmadevo ca udayo ca, ahesuṃ aggasāvakā;"],"lineRefs":[["bv19:5"]]},{"para":3203,"vripara":null,"refs":["bv19:5"],"lines":["Samaṅgo nāmupaṭṭhāko, tissassa ca mahesino."],"lineRefs":[["bv19:5"]]},{"para":3205,"vripara":"22","refs":["bv19:5"],"lines":["“Phussā ceva sudattā ca, ahesuṃ aggasāvikā;"],"lineRefs":[["bv19:5"]]},{"para":3206,"vripara":null,"refs":["bv19:5"],"lines":["Bodhi tassa bhagavato, asanoti pavuccati."],"lineRefs":[["bv19:5"]]},{"para":3208,"vripara":"24","refs":["bv19:5"],"lines":["“So buddho saṭṭhiratano, ahu uccattane jino;"],"lineRefs":[["bv19:5"]]},{"para":3209,"vripara":null,"refs":["bv19:5"],"lines":["Anūpamo asadiso, himavā viya dissati."],"lineRefs":[["bv19:5"]]},{"para":3211,"vripara":"25","refs":["bv19:5"],"lines":["“Tassāpi atulatejassa, āyu āsi anuttaro;"],"lineRefs":[["bv19:5"]]},{"para":3212,"vripara":null,"refs":["bv19:5"],"lines":["Vassasatasahassāni, loke aṭṭhāsi cakkhumā."],"lineRefs":[["bv19:5"]]},{"para":3214,"vripara":"26","refs":["bv19:5"],"lines":["“Uttamaṃ pavaraṃ seṭṭhaṃ, anubhotvā mahāyasaṃ;"],"lineRefs":[["bv19:5"]]},{"para":3215,"vripara":null,"refs":["bv19:5"],"lines":["Jalitvā aggikkhandhova, nibbuto so sasāvako."],"lineRefs":[["bv19:5"]]},{"para":3217,"vripara":"27","refs":["bv19:5"],"lines":["“Valāhakova anilena, sūriyena viya ussavo;"],"lineRefs":[["bv19:5"]]},{"para":3218,"vripara":null,"refs":["bv19:5"],"lines":["Andhakārova padīpena, nibbuto so sasāvako”ti."],"lineRefs":[["bv19:5"]]},{"para":3219,"vripara":null,"refs":["bv19:5","bv19:27"],"lines":["Tattha <b>uccattane</b>ti uccabhāvena.","<b>Himavā viya dissatī</b>ti himavāva padissati.","Ayameva vā pāṭho.","Yathā yojanānaṃ satānucco himavā pañcapabbato sudūre ṭhitānampi uccabhāvena ca sommabhāvena ca atiramaṇīyo hutvā dissati, evaṃ bhagavāpi dissatīti attho.","<b>Anuttaro</b>ti nātidīgho nātirasso.","Āyu vassasatasahassanti attho.","<b>Uttamaṃ pavaraṃ seṭṭhan</b>ti aññamaññavevacanāni.","<b>Ussavo</b>ti himabindu valāhakaussavaandhakārā viya anilasūriyadīpehi aniccatānilasūriyadīpehi upadduto parinibbuto sasāvako bhagavāti attho."],"lineRefs":[["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:5"],["bv19:27"]]}],"wordLinks":[["bv19:4.1","dasasahassimhī",0,1],["bv19:5.1","dutiyo navutikoṭīnaṃ",3,0],["bv19:5.3","bandhanāto",3,1],["bv19:5.3","naramarū",3,2],["bv19:5.3","naramarū",3,3],["bv19:27.1","ussavo",41,7]],"before":[{"para":3142,"vripara":null,"refs":[],"lines":["Siddhattho kira satthā kañcanaveḷunagare anomuyyāne parinibbāyi.","Tatthevassa ratanamayaṃ catuyojanubbedhaṃ cetiyamakaṃsūti.","Sesagāthāsu sabbattha pākaṭamevāti."],"lineRefs":[[],[],[]]},{"para":3143,"vripara":null,"refs":[],"lines":["Siddhatthabuddhavaṃsavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3144,"vripara":null,"refs":[],"lines":["Niṭṭhito soḷasamo buddhavaṃso."],"lineRefs":[[]]},{"para":3145,"vripara":null,"refs":[],"lines":["Tissabuddhavaṃsavaṇṇanā"],"lineRefs":[[]]},{"para":3146,"vripara":null,"refs":[],"lines":["Tassa pana siddhatthassa bhagavato aparabhāge eko kappo buddhasuñño ahosi.","Ito dvānavutikappamatthake <b>tisso, phusso</b>ti ekasmiṃ kappe dve buddhā nibbattiṃsu.","Tattha <b>tisso</b> nāma mahāpuriso pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā khemakanagare janasandhassa nāma rañño aggamahesiyā padumadalasadisanayanāya padumānāmāya deviyā kucchismiṃ paṭisandhiṃ gahetvā dasannaṃ māsānaṃ accayena anomuyyāne mātukucchito nikkhami.","Sattavassasahassāni agāraṃ ajjhāvasi.","Tassa guhāsela-nārisaya-nisabhanāmakā tayo pāsādā ahesuṃ.","Subhaddādevippamukhāni tettiṃsa itthisahassāni ahesuṃ."],"lineRefs":[[],[],[],[],[],[]]},{"para":3147,"vripara":null,"refs":[],"lines":["So cattāri nimittāni disvā subhaddādeviyā putte ānandakumāre uppanne sonuttaraṃ nāma anuttaraṃ turaṅgavaramāruyha mahābhinikkhamanaṃ nikkhamitvā pabbaji.","Taṃ manussānaṃ koṭi anupabbaji.","So tehi parivuto aṭṭha māse padhānacariyaṃ caritvā visākhapuṇṇamāya vīranigame vīraseṭṭhissa dhītāya dinnaṃ madhupāyāsaṃ paribhuñjitvā salalavane divāvihāraṃ vītināmetvā sāyanhasamaye vijitasaṅgāmakena nāma yavapālena upanītā aṭṭha tiṇamuṭṭhiyo gahetvā asanabodhiṃ upasaṅkamitvā cattālīsahatthavitthataṃ tiṇasantharaṃ santharitvā tattha pallaṅkaṃ ābhujitvā samāraṃ mārabalaṃ vidhamitvā adhigatasabbaññutaññāṇo –","“anekajātisaṃsāraṃ … pe … taṇhānaṃ khayamajjhagā”ti udānaṃ udānetvā sattasattāhaṃ bodhisamīpeyeva vītināmetvā yasavatī nagare brahmadevaṃ udayañca dve rājaputte saparivāre upanissayasampanne ākāsena gantvā yasavatīmigadāye otaritvā uyyānapālena rājaputte pakkosāpetvā tesaṃ saparivārānaṃ avisārinā byāpinā madhurena brahmassarena dasasahassilokadhātuṃ viññāpentova dhammacakkaṃ pavattesi, tadā koṭisatānaṃ paṭhamo dhammābhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[]]},{"para":3149,"vripara":"1","refs":[],"lines":["“Siddhatthassa aparena, asamo appaṭipuggalo;"],"lineRefs":[[]]},{"para":3150,"vripara":null,"refs":[],"lines":["Anantatejo amitayaso, tisso lokagganāyako."],"lineRefs":[[]]},{"para":3152,"vripara":"2","refs":[],"lines":["“Tamandhakāraṃ vidhamitvā, obhāsetvā sadevakaṃ;"],"lineRefs":[[]]},{"para":3153,"vripara":null,"refs":[],"lines":["Anukampako mahāvīro, loke uppajji cakkhumā."],"lineRefs":[[]]},{"para":3155,"vripara":"3","refs":[],"lines":["“Tassāpi atulā iddhi, atulaṃ sīlaṃ samādhi ca;"],"lineRefs":[[]]},{"para":3156,"vripara":null,"refs":[],"lines":["Sabbattha pāramiṃ gantvā, dhammacakkaṃ pavattayi."],"lineRefs":[[]]},{"para":3158,"vripara":"4","refs":[],"lines":["“So buddho dasasahassimhi, viññāpesi giraṃ suciṃ;"],"lineRefs":[[]]},{"para":3159,"vripara":null,"refs":[],"lines":["Koṭisatāni abhisamiṃsu, paṭhame dhammadesane”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
