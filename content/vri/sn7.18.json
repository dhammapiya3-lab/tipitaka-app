{"suttaId":"sn7.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[2657,2678],"vripara":"204"},"segments":{"sn7.18:0.3":"Kaṭṭhahārasuttaṃ","sn7.18:1.1":"Ekaṃ samayaṃ bhagavā kosalesu viharati aññatarasmiṃ vanasaṇḍe.","sn7.18:1.2":"Tena kho pana samayena aññatarassa bhāradvājagottassa brāhmaṇassa sambahulā antevāsikā kaṭṭhahārakā māṇavakā yena vanasaṇḍo tenupasaṅkamiṃsu; upasaṅkamitvā addasaṃsu bhagavantaṃ tasmiṃ vanasaṇḍe nisinnaṃ pallaṅkaṃ ābhujitvā ujuṃ kāyaṃ paṇidhāya parimukhaṃ satiṃ upaṭṭhapetvā. Disvāna yena bhāradvājagotto brāhmaṇo tenupasaṅkamiṃsu; upasaṅkamitvā bhāradvājagottaṃ brāhmaṇaṃ etadavocuṃ –","sn7.18:1.3":"“yagghe, bhavaṃ jāneyyāsi!","sn7.18:1.4":"Asukasmiṃ vanasaṇḍe samaṇo nisinno pallaṅkaṃ ābhujitvā ujuṃ kāyaṃ paṇidhāya parimukhaṃ satiṃ upaṭṭhapetvā”.","sn7.18:1.5":"Atha kho bhāradvājagotto brāhmaṇo tehi māṇavakehi saddhiṃ yena so vanasaṇḍo tenupasaṅkami.","sn7.18:1.6":"Addasā kho bhagavantaṃ tasmiṃ vanasaṇḍe nisinnaṃ pallaṅkaṃ ābhujitvā ujuṃ kāyaṃ paṇidhāya parimukhaṃ satiṃ upaṭṭhapetvā.","sn7.18:1.7":"Disvāna yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ gāthāya ajjhabhāsi –","sn7.18:2.1":"“Gambhīrarūpe bahubherave vane,","sn7.18:2.2":"Suññaṃ araññaṃ vijanaṃ vigāhiya;","sn7.18:2.3":"Aniñjamānena ṭhitena vaggunā,","sn7.18:2.4":"Sucārurūpaṃ vata bhikkhu jhāyasi.","sn7.18:3.1":"“Na yattha gītaṃ napi yattha vāditaṃ,","sn7.18:3.2":"Eko araññe vanavassito muni;","sn7.18:3.3":"Accherarūpaṃ paṭibhāti maṃ idaṃ,","sn7.18:3.4":"Yadekako pītimano vane vase.","sn7.18:4.1":"“Maññāmahaṃ lokādhipatisahabyataṃ,","sn7.18:4.2":"Ākaṅkhamāno tidivaṃ anuttaraṃ;","sn7.18:4.3":"Kasmā bhavaṃ vijanamaraññamassito,","sn7.18:4.4":"Tapo idha kubbasi brahmapattiyā”ti.","sn7.18:5.1":"“Yā kāci kaṅkhā abhinandanā vā,","sn7.18:5.2":"Anekadhātūsu puthū sadāsitā;","sn7.18:5.3":"Aññāṇamūlappabhavā pajappitā,","sn7.18:5.4":"Sabbā mayā byantikatā samūlikā.","sn7.18:6.1":"“Svāhaṃ akaṅkho asito anūpayo,","sn7.18:6.2":"Sabbesu dhammesu visuddhadassano;","sn7.18:6.3":"Pappuyya sambodhimanuttaraṃ sivaṃ,","sn7.18:6.4":"Jhāyāmahaṃ brahma raho visārado”ti.","sn7.18:7.1":"Evaṃ vutte, bhāradvājagotto brāhmaṇo bhagavantaṃ etadavoca –","sn7.18:7.2":"“abhikkantaṃ, bho gotama abhikkantaṃ, bho gotama … pe … ajjatagge pāṇupetaṃ saraṇaṃ gatan”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1136,"to":1141,"paras":[{"para":1136,"vripara":"204","refs":["sn7.18:1","sn7.18:2"],"lines":["Aṭṭhame <b>antevāsikā</b>ti veyyāvaccaṃ katvā sippuggaṇhanakā dhammantevāsikā.","<b>Nisinnan</b>ti chabbaṇṇarasmiyo vissajjetvā nisinnaṃ.","<b>Gambhīrarūpe</b>ti gambhīrasabhāve."],"lineRefs":[["sn7.18:1"],["sn7.18:1"],["sn7.18:2"]]},{"para":1137,"vripara":null,"refs":["sn7.18:2"],"lines":["<b>Bahubherave</b>ti tatraṭṭhakasaviññāṇakaaviññāṇakabheravehi bahubherave.","<b>Vigāhiyā</b>ti anupavisitvā.","<b>Aniñjamānenā</b>tiādīni kāyavisesanāni, evarūpena kāyenāti attho.","<b>Sucārurūpaṃ vatā</b>ti atisundaraṃ vata jhānaṃ jhāyasīti vadati."],"lineRefs":[["sn7.18:2"],["sn7.18:2"],["sn7.18:2"],["sn7.18:2"]]},{"para":1138,"vripara":null,"refs":["sn7.18:3"],"lines":["<b>Vanavassito munī</b>ti vanaṃ avassito buddhamuni.","<b>Idan</b>ti idaṃ tumhākaṃ evaṃ vane nisinnakāraṇaṃ mayhaṃ accherarūpaṃ paṭibhāti.","<b>Pītimano</b>ti tuṭṭhacitto.","<b>Vane vase</b>ti vanamhi vasi."],"lineRefs":[["sn7.18:3"],["sn7.18:3"],["sn7.18:3"],["sn7.18:3"]]},{"para":1139,"vripara":null,"refs":["sn7.18:4"],"lines":["<b>Maññāmahan</b>ti maññāmi ahaṃ.","<b>Lokādhipatisahabyatan</b>ti lokādhipatimahābrahmunā sahabhāvaṃ.","<b>Ākaṅkhamāno</b>ti icchamāno.","<b>Tidivaṃ anuttaran</b>ti idaṃ brahmalokameva sandhāyāha.","<b>Kasmā bhavaṃ vijanamaraññamassito</b>ti ahaṃ tāva brahmalokaṃ ākaṅkhamānoti maññāmi.","Yadi evaṃ na hoti, atha me ācikkha, kasmā bhavanti?","Pucchati.","<b>Brahmapattiyā</b>ti seṭṭhapattiyā.","Idha idaṃ tapo kasmā karosīti aparenapi ākārena pucchati."],"lineRefs":[["sn7.18:4"],["sn7.18:4"],["sn7.18:4"],["sn7.18:4"],["sn7.18:4"],["sn7.18:4"],["sn7.18:4"],["sn7.18:4"],["sn7.18:4"]]},{"para":1140,"vripara":null,"refs":["sn7.18:4","sn7.18:5"],"lines":["<b>Kaṅkhā</b>ti taṇhā.","<b>Abhinandanā</b>ti abhinandanavasena taṇhāva vuttā.","<b>Anekadhātūsū</b>ti anekasabhāvesu ārammaṇesu.","<b>Puthū</b>ti nānappakārā taṇhā sesakilesā vā.","<b>Sadāsitā</b>ti niccakālaṃ avassitā.","<b>Aññāṇamūlappabhavā</b>ti avijjāmūlā hutvā jātā.","<b>Pajappitā</b>ti taṇhāva “idampi mayhaṃ, idampi mayhan”ti pajappāpanavasena pajappitā nāmāti vuttā.","<b>Sabbā mayā byantikatā</b>ti sabbā taṇhā mayā aggamaggena vigatantā nirantā katā.","<b>Samūlikā</b>ti saddhiṃ aññāṇamūlena."],"lineRefs":[["sn7.18:4"],["sn7.18:5"],["sn7.18:5"],["sn7.18:5"],["sn7.18:5"],["sn7.18:5"],["sn7.18:5"],["sn7.18:5"],["sn7.18:5"]]},{"para":1141,"vripara":null,"refs":["sn7.18:6"],"lines":["<b>Anūpayo</b>ti anupagamano.","<b>Sabbesu dhammesu visuddhadassano</b>ti iminā sabbaññutaññāṇaṃ dīpeti.","<b>Sambodhimanuttaran</b>ti arahattaṃ sandhāyāha.","<b>Sivan</b>ti seṭṭhaṃ.","<b>Jhāyāmī</b>ti dvīhi jhānehi jhāyāmi.","<b>Visārado</b>ti vigatasārajjo.","Aṭṭhamaṃ."],"lineRefs":[["sn7.18:6"],["sn7.18:6"],["sn7.18:6"],["sn7.18:6"],["sn7.18:6"],["sn7.18:6"],["sn7.18:6"]]}],"wordLinks":[["sn7.18:1.2","antevāsikā",0,0],["sn7.18:1.2","nisinnaṃ",0,1],["sn7.18:1.6","nisinnaṃ",0,1],["sn7.18:2.1","gambhīrarūpe",0,2],["sn7.18:2.1","bahubherave",1,0],["sn7.18:2.2","vigāhiyā",1,1],["sn7.18:2.3","aniñjamānenā",1,2],["sn7.18:2.4","sucārurūpaṃ vatā",1,3],["sn7.18:3.2","vanavassito munī",2,0],["sn7.18:3.3","idaṃ",2,1],["sn7.18:3.4","pītimano",2,2],["sn7.18:3.4","vane vase",2,3],["sn7.18:4.1","maññāmahaṃ",3,0],["sn7.18:4.1","lokādhipatisahabyataṃ",3,1],["sn7.18:4.2","ākaṅkhamāno",3,2],["sn7.18:4.2","tidivaṃ anuttaraṃ",3,3],["sn7.18:4.3","kasmā bhavaṃ vijanamaraññamassito",3,4],["sn7.18:4.4","brahmapattiyā",3,7],["sn7.18:4.2","kaṅkhā",4,0],["sn7.18:5.1","abhinandanā",4,1],["sn7.18:5.2","anekadhātūsū",4,2],["sn7.18:5.2","puthū",4,3],["sn7.18:5.2","sadāsitā",4,4],["sn7.18:5.3","aññāṇamūlappabhavā",4,5],["sn7.18:5.3","pajappitā",4,6],["sn7.18:5.4","sabbā mayā byantikatā",4,7],["sn7.18:5.4","samūlikā",4,8],["sn7.18:6.1","anūpayo",5,0],["sn7.18:6.2","sabbesu dhammesu visuddhadassano",5,1],["sn7.18:6.3","sambodhimanuttaraṃ",5,2],["sn7.18:6.3","sivaṃ",5,3],["sn7.18:6.4","jhāyāmī",5,4],["sn7.18:6.4","visārado",5,5]]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1326,"to":1327,"paras":[{"para":1326,"vripara":null,"refs":["sn7.18:2"],"lines":["<b>Bahubherave</b>ti bahubhayānake.","<b>Aniñjamānenā</b>ti itthambhūtatthe karaṇavacanaṃ.","<b>Atisundaraṃ vatā</b>ti evaṃ sante nāma araññe evaṃ niccalakāyo nisinno jhāyanto ativiya sundarañca jhānaṃ jhāyasīti vadati."],"lineRefs":[["sn7.18:2"],["sn7.18:2"],["sn7.18:2"]]},{"para":1327,"vripara":null,"refs":["sn7.18:3"],"lines":["<b>Accherarūpan</b>ti acchariyabhāvaṃ.","<b>Seṭṭhappattiyā</b>ti seṭṭhabhāvappattiyā."],"lineRefs":[["sn7.18:3"],["sn7.18:3"]]}],"wordLinks":[["sn7.18:2.1","bahubherave",0,0],["sn7.18:2.3","aniñjamānenā",0,1],["sn7.18:3.3","accherarūpaṃ",1,0]]}}
