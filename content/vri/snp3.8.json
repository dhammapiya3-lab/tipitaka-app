{"suttaId":"snp3.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[1997,2058],"vripara":"579"},"segments":{"snp3.8:0.2":"Sallasuttaṃ","snp3.8:1.1":"Animittamanaññātaṃ,","snp3.8:1.2":"maccānaṃ idha jīvitaṃ;","snp3.8:1.3":"Kasirañca parittañca,","snp3.8:1.4":"tañca dukkhena saṃyutaṃ.","snp3.8:2.1":"Na hi so upakkamo atthi,","snp3.8:2.2":"yena jātā na miyyare;","snp3.8:2.3":"Jarampi patvā maraṇaṃ,","snp3.8:2.4":"evaṃdhammā hi pāṇino.","snp3.8:3.1":"Phalānamiva pakkānaṃ,","snp3.8:3.2":"pāto patanato [papatato (sī. pī. aṭṭha.)] bhayaṃ;","snp3.8:3.3":"Evaṃ jātāna maccānaṃ,","snp3.8:3.4":"niccaṃ maraṇato bhayaṃ.","snp3.8:4.1":"Yathāpi kumbhakārassa,","snp3.8:4.2":"katā mattikabhājanā;","snp3.8:4.3":"Sabbe bhedanapariyantā [bhedapariyantā (syā.)],","snp3.8:4.4":"evaṃ maccāna jīvitaṃ.","snp3.8:5.1":"Daharā ca mahantā ca,","snp3.8:5.2":"ye bālā ye ca paṇḍitā;","snp3.8:5.3":"Sabbe maccuvasaṃ yanti,","snp3.8:5.4":"sabbe maccuparāyaṇā.","snp3.8:6.1":"Tesaṃ maccuparetānaṃ,","snp3.8:6.2":"gacchataṃ paralokato;","snp3.8:6.3":"Na pitā tāyate puttaṃ,","snp3.8:6.4":"ñātī vā pana ñātake.","snp3.8:7.1":"Pekkhataṃ yeva ñātīnaṃ,","snp3.8:7.2":"passa lālapataṃ puthu;","snp3.8:7.3":"Ekamekova maccānaṃ,","snp3.8:7.4":"govajjho viya nīyati [niyyati (bahūsu)].","snp3.8:8.1":"Evamabbhāhato loko,","snp3.8:8.2":"maccunā ca jarāya ca;","snp3.8:8.3":"Tasmā dhīrā na socanti,","snp3.8:8.4":"viditvā lokapariyāyaṃ.","snp3.8:9.1":"Yassa maggaṃ na jānāsi,","snp3.8:9.2":"āgatassa gatassa vā;","snp3.8:9.3":"Ubho ante asampassaṃ,","snp3.8:9.4":"niratthaṃ paridevasi.","snp3.8:10.1":"Paridevayamāno ce,","snp3.8:10.2":"kiñcidatthaṃ udabbahe;","snp3.8:10.3":"Sammūḷho hiṃsamattānaṃ,","snp3.8:10.4":"kayirā ce naṃ vicakkhaṇo.","snp3.8:11.1":"Na hi ruṇṇena sokena,","snp3.8:11.2":"santiṃ pappoti cetaso;","snp3.8:11.3":"Bhiyyassuppajjate dukkhaṃ,","snp3.8:11.4":"sarīraṃ cupahaññati.","snp3.8:12.1":"Kiso vivaṇṇo bhavati,","snp3.8:12.2":"hiṃsamattānamattanā;","snp3.8:12.3":"Na tena petā pālenti,","snp3.8:12.4":"niratthā paridevanā.","snp3.8:13.1":"Sokamappajahaṃ jantu,","snp3.8:13.2":"bhiyyo dukkhaṃ nigacchati;","snp3.8:13.3":"Anutthunanto kālaṅkataṃ [kālakataṃ (sī. syā.)],","snp3.8:13.4":"sokassa vasamanvagū.","snp3.8:14.1":"Aññepi passa gamine,","snp3.8:14.2":"yathākammūpage nare;","snp3.8:14.3":"Maccuno vasamāgamma,","snp3.8:14.4":"phandantevidha pāṇino.","snp3.8:15.1":"Yena yena hi maññanti,","snp3.8:15.2":"tato taṃ hoti aññathā;","snp3.8:15.3":"Etādiso vinābhāvo,","snp3.8:15.4":"passa lokassa pariyāyaṃ.","snp3.8:16.1":"Api vassasataṃ jīve,","snp3.8:16.2":"bhiyyo vā pana māṇavo;","snp3.8:16.3":"Ñātisaṅghā vinā hoti,","snp3.8:16.4":"jahāti idha jīvitaṃ.","snp3.8:17.1":"Tasmā arahato sutvā,","snp3.8:17.2":"vineyya paridevitaṃ;","snp3.8:17.3":"Petaṃ kālaṅkataṃ disvā,","snp3.8:17.4":"neso labbhā mayā iti.","snp3.8:18.1":"Yathā saraṇamādittaṃ,","snp3.8:18.2":"vārinā parinibbaye [parinibbuto (sī. ka.)];","snp3.8:18.3":"Evampi dhīro sapañño,","snp3.8:18.4":"paṇḍito kusalo naro;","snp3.8:18.5":"Khippamuppatitaṃ sokaṃ,","snp3.8:18.6":"vāto tūlaṃva dhaṃsaye.","snp3.8:19.1":"Paridevaṃ pajappañca,","snp3.8:19.2":"domanassañca attano;","snp3.8:19.3":"Attano sukhamesāno,","snp3.8:19.4":"abbahe sallamattano.","snp3.8:20.1":"Abbuḷhasallo asito,","snp3.8:20.2":"santiṃ pappuyya cetaso;","snp3.8:20.3":"Sabbasokaṃ atikkanto,","snp3.8:20.4":"asoko hoti nibbutoti.","snp3.8:20.5":"Sallasuttaṃ aṭṭhamaṃ niṭṭhitaṃ."},"unsure":[],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":1984,"to":1984,"paras":[{"para":1984,"vripara":"598-599","refs":["snp3.8:20"],"lines":["598-9. Na kevalañca sokameva, <b>paridevaṃ … pe … sallamattano.</b>","<b>Tattha pajappan</b>ti <b>taṇhaṃ.</b>","<b>Domanassan</b>ti cetasikadukkhaṃ.","<b>Abbahe</b>ti uddhare.","<b>Sallan</b>ti etameva tippakāraṃ dunnīharaṇaṭṭhena antovijjhanaṭṭhena ca sallaṃ.","Pubbe vuttaṃ sattavidhaṃ rāgādisallaṃ vā.","Etasmiñhi abbūḷhe salle abbūḷhasallo … pe … nibbutoti arahattanikūṭena desanaṃ niṭṭhāpesi.","Tattha <b>asito</b>ti taṇhādiṭṭhīhi anissito.","<b>Pappuyyā</b>ti pāpuṇitvā.","Sesaṃ idha ito pubbe vuttattā uttānatthameva, tasmā na vaṇṇitaṃ."],"lineRefs":[["snp3.8:20"],["snp3.8:20"],["snp3.8:20"],["snp3.8:20"],["snp3.8:20"],["snp3.8:20"],["snp3.8:20"],["snp3.8:20"],["snp3.8:20"],["snp3.8:20"]]}],"wordLinks":[["snp3.8:20.5","sallaṃ",0,4],["snp3.8:20.1","asito",0,7],["snp3.8:20.1","pappuyyā",0,8]]},"tika":null,"tika2":null}
