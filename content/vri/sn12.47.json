{"suttaId":"sn12.47","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[360,363],"vripara":"47"},"segments":{"sn12.47:0.3":"Jāṇussoṇisuttaṃ","sn12.47:1.1":"Sāvatthiyaṃ viharati.","sn12.47:1.2":"Atha kho jāṇussoṇi brāhmaṇo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavatā saddhiṃ … pe … ekamantaṃ nisinno kho jāṇussoṇi brāhmaṇo bhagavantaṃ etadavoca –","sn12.47:2.1":"“Kiṃ nu kho, bho, gotama, sabbamatthī”ti?","sn12.47:2.2":"“‘Sabbamatthī’ti kho, brāhmaṇa, ayameko anto”.","sn12.47:3.1":"“Kiṃ pana, bho gotama, sabbaṃ natthī”ti?","sn12.47:3.2":"“‘Sabbaṃ natthī’ti kho, brāhmaṇa, ayaṃ dutiyo anto.","sn12.47:3.3":"Ete te, brāhmaṇa, ubho ante anupagamma majjhena tathāgato dhammaṃ deseti –","sn12.47:3.4":"‘avijjāpaccayā saṅkhārā;","sn12.47:3.5":"saṅkhārapaccayā viññāṇaṃ … pe …","sn12.47:3.6":"evametassa kevalassa dukkhakkhandhassa samudayo hoti.","sn12.47:3.7":"Avijjāya tveva asesavirāganirodhā saṅkhāranirodho;","sn12.47:3.8":"saṅkhāranirodhā viññāṇanirodho … pe …","sn12.47:3.9":"evametassa kevalassa dukkhakkhandhassa nirodho hotī’”ti.","sn12.47:4.1":"Evaṃ vutte, jāṇussoṇi brāhmaṇo bhagavantaṃ etadavoca –","sn12.47:4.2":"“abhikkantaṃ bho gotama … pe …","sn12.47:4.3":"pāṇupetaṃ saraṇaṃ gatan”ti.","sn12.47:4.4":"Sattamaṃ."},"unsure":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":280,"to":280,"paras":[{"para":280,"vripara":"47","refs":["sn12.47:1"],"lines":["Sattame <b>jāṇussoṇī</b>ti ṭhānantaravasena evaṃladdhanāmo asītikoṭivibhavo mahāpurohito.","Sattamaṃ."],"lineRefs":[["sn12.47:1"],["sn12.47:1"]]}],"wordLinks":[["sn12.47:1.2","jāṇussoṇī",0,0]],"before":[{"para":279,"vripara":null,"refs":[],"lines":["Jāṇussoṇisuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":293,"to":295,"paras":[{"para":293,"vripara":"47","refs":["sn12.47:1"],"lines":["<b>Evaṃladdhanāmo</b>ti “jāṇussoṇī”ti evaṃladdhanāmo rañño santikā adhigatanāmo."],"lineRefs":[["sn12.47:1"]]},{"para":294,"vripara":null,"refs":["sn12.47:1"],"lines":["Jāṇussoṇisuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn12.47:1"]]},{"para":295,"vripara":null,"refs":["sn12.47:1"],"lines":["Lokāyatikasuttavaṇṇanā"],"lineRefs":[["sn12.47:1"]]}],"wordLinks":[]},"tika2":null}
