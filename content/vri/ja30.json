{"suttaId":"ja30","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[166,173],"vripara":"30"},"segments":{"ja30:0.4":"Munikajātakaṃ","ja30:1.1":"Mā munikassa pihayi, āturannāni bhuñjati;","ja30:1.3":"Appossukko bhusaṃ khāda, etaṃ dīghāyulakkhaṇanti.","ja30:2.1":"Munikajātakaṃ dasamaṃ.","ja30:2.2":"Kuruṅgavaggo tatiyo.","ja30:3.1":"Tassuddānaṃ –","ja30:4.1":"Kuruṅgassa kukkuragojavaro, puna vāḷavassasirivhayano [sirivayano (sabbattha)];","ja30:4.3":"Mahiḷāmukhanāmanuññavaro, vahate dhura munikena dasāti."},"attha":null,"tika":null}
