{"suttaId":"thag7.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[2053,2074],"vripara":"473"},"segments":{"thag7.3:0.4":"Bhaddattheragāthā","thag7.3:1.1":"“Ekaputto ahaṃ āsiṃ,","thag7.3:1.2":"piyo mātu piyo pitu;","thag7.3:1.3":"Bahūhi vatacariyāhi,","thag7.3:1.4":"laddho āyācanāhi ca.","thag7.3:2.1":"“Te ca maṃ anukampāya,","thag7.3:2.2":"atthakāmā hitesino;","thag7.3:2.3":"Ubho pitā ca mātā ca,","thag7.3:2.4":"buddhassa upanāmayuṃ”.","thag7.3:3.1":"“Kicchā laddho ayaṃ putto,","thag7.3:3.2":"sukhumālo sukhedhito;","thag7.3:3.3":"Imaṃ dadāma te nātha,","thag7.3:3.4":"jinassa paricārakaṃ”.","thag7.3:4.1":"“Satthā ca maṃ paṭiggayha,","thag7.3:4.2":"ānandaṃ etadabravi;","thag7.3:4.3":"‘Pabbājehi imaṃ khippaṃ,","thag7.3:4.4":"hessatyājāniyo ayaṃ.","thag7.3:5.1":"“Pabbājetvāna maṃ satthā,","thag7.3:5.2":"vihāraṃ pāvisī jino;","thag7.3:5.3":"Anoggatasmiṃ sūriyasmiṃ,","thag7.3:5.4":"tato cittaṃ vimucci me.","thag7.3:6.1":"“Tato satthā nirākatvā,","thag7.3:6.2":"paṭisallānavuṭṭhito;","thag7.3:6.3":"‘Ehi bhaddā’ti maṃ āha,","thag7.3:6.4":"sā me āsūpasampadā.","thag7.3:7.1":"“Jātiyā sattavassena,","thag7.3:7.2":"laddhā me upasampadā;","thag7.3:7.3":"Tisso vijjā anuppattā,","thag7.3:7.4":"aho dhammasudhammatā”ti.","thag7.3:7.5":"… Bhaddo thero …."},"unsure":[],"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":1699,"to":1700,"paras":[{"para":1699,"vripara":null,"refs":["thag7.3:7"],"lines":["<b>Tato</b>ti mama āsavakkhayato pacchā.","<b>Nirākatvā</b>ti attanā samāpannaṃ phalasamāpattiṃ appetvā tato vuṭṭhāya.","Tenāha <b>“paṭisallānavuṭṭhito”</b>ti.","<b>Sā me āsūpasampadā</b>ti yā maṃ uddissa “ehi, bhaddā”ti satthu vācā pavattā, sā eva me mayhaṃ upasampadā āsi.","Evaṃ <b>jātiyā sattavassena, laddhā me upasampadā</b>ti sātisayaṃ satthārā attano kataṃ anuggahaṃ sāsanassa ca niyyānikataṃ dasseti.","Tenāha <b>“aho dhammasudhammatā”</b>ti."],"lineRefs":[["thag7.3:7"],["thag7.3:7"],["thag7.3:7"],["thag7.3:7"],["thag7.3:7"],["thag7.3:7"]]},{"para":1700,"vripara":null,"refs":["thag7.3:7"],"lines":["Ettha ca “cittaṃ vimucci me”ti khīṇāsavabhāvaṃ pakāsetvāpi puna <b>“tisso vijjā anuppattā”</b>ti lokiyābhiññekadesadassanaṃ chaḷabhiññabhāvavibhāvanatthaṃ.","Tenāha apadāne “chaḷabhiññā sacchikatā”ti."],"lineRefs":[["thag7.3:7"],["thag7.3:7"]]}],"wordLinks":[["thag7.3:7.1","jātiyā sattavassena laddhā me upasampadā",0,4],["thag7.3:7.3","aho dhammasudhammatā",0,5],["thag7.3:7.3","tisso vijjā anuppattā",1,0]],"before":[{"para":1634,"vripara":null,"refs":[],"lines":["Lakuṇḍakabhaddiyattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1635,"vripara":null,"refs":[],"lines":["Bhaddattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":1636,"vripara":null,"refs":[],"lines":["<b>Ekaputto</b>tiādikā āyasmato bhaddattherassa gāthā.","Kā uppatti?","Ayaṃ kira padumuttaraṃ bhagavantaṃ bhikkhusaṅghañca satasahassaparimāṇaṃ cīvarādīhi catūhi paccayehi pūjesi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde sāvatthiyaṃ seṭṭhikule nibbatti.","Nibbattamāno ca aputtakesu mātāpitūsu devatāyācanādīni katvāpi alabhantesu satthāraṃ upasaṅkamitvā “sace, bhante, mayaṃ ekaṃ puttaṃ lacchāma, taṃ tumhākaṃ dāsatthāya dassāmā”ti vatvā āyācitvā gatesu satthu adhippāyaṃ ñatvā aññataro devaputto khīṇāyuko hutvā ṭhito sakkena devaraññā “amukasmiṃ kule nibbattāhī”ti āṇatto tattha nibbatti, <b>bhaddo</b>tissa nāmaṃ akaṃsu.","Taṃ sattavassuddesikaṃ jātaṃ mātāpitaro alaṅkaritvā bhagavato santikaṃ netvā “ayaṃ so, bhante, tumhe āyācitvā laddhadārako, imaṃ tumhākaṃ niyyātemā”ti āhaṃsu.","Satthā ānandattheraṃ āṇāpesi –","“imaṃ pabbājehī”ti.","Āṇāpetvā ca gandhakuṭiṃ pāvisi.","Thero taṃ pabbājetvā saṅkhepena vipassanāmukhaṃ ācikkhi.","So upanissayasampannattā vipassanāya kammaṃ karonto sūriye anoggateyeva bhāvanaṃ ussukkāpetvā chaḷabhiñño ahosi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.5.54-69)–"],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":1637,"vripara":null,"refs":[],"lines":["“Padumuttarasambuddhaṃ, mettacittaṃ mahāmuniṃ;"],"lineRefs":[[]]},{"para":1638,"vripara":null,"refs":[],"lines":["Upeti janatā sabbā, sabbalokagganāyakaṃ."],"lineRefs":[[]]},{"para":1639,"vripara":null,"refs":[],"lines":["“Sattukañca baddhakañca, āmisaṃ pānabhojanaṃ;"],"lineRefs":[[]]},{"para":1640,"vripara":null,"refs":[],"lines":["Dadanti satthuno sabbe, puññakkhette anuttare."],"lineRefs":[[]]},{"para":1641,"vripara":null,"refs":[],"lines":["“Ahampi dānaṃ dassāmi, devadevassa tādino;"],"lineRefs":[[]]},{"para":1642,"vripara":null,"refs":[],"lines":["Buddhaseṭṭhaṃ nimantetvā, saṅghampi ca anuttaraṃ."],"lineRefs":[[]]},{"para":1643,"vripara":null,"refs":[],"lines":["“Uyyojitā mayā cete, nimantesuṃ tathāgataṃ;"],"lineRefs":[[]]},{"para":1644,"vripara":null,"refs":[],"lines":["Kevalaṃ bhikkhusaṅghañca, puññakkhettaṃ anuttaraṃ."],"lineRefs":[[]]},{"para":1645,"vripara":null,"refs":[],"lines":["“Satasahassapallaṅkaṃ, sovaṇṇaṃ gonakatthataṃ;"],"lineRefs":[[]]},{"para":1646,"vripara":null,"refs":[],"lines":["Tūlikāpaṭalikāya, khomakappāsikehi ca;"],"lineRefs":[[]]},{"para":1647,"vripara":null,"refs":[],"lines":["Mahārahaṃ paññāpayiṃ, āsanaṃ buddhayuttakaṃ."],"lineRefs":[[]]},{"para":1648,"vripara":null,"refs":[],"lines":["“Padumuttaro lokavidū, devadevo narāsabho;"],"lineRefs":[[]]},{"para":1649,"vripara":null,"refs":[],"lines":["Bhikkhusaṅghaparibyūḷho, mama dvāramupāgami."],"lineRefs":[[]]},{"para":1650,"vripara":null,"refs":[],"lines":["“Paccuggantvāna sambuddhaṃ, lokanāthaṃ yasassinaṃ;"],"lineRefs":[[]]},{"para":1651,"vripara":null,"refs":[],"lines":["Pasannacitto sumano, abhināmayiṃ saṅgharaṃ."],"lineRefs":[[]]},{"para":1652,"vripara":null,"refs":[],"lines":["“Bhikkhūnaṃ satasahassaṃ, buddhañca lokanāyakaṃ;"],"lineRefs":[[]]},{"para":1653,"vripara":null,"refs":[],"lines":["Pasannacitto sumano, paramannena tappayiṃ."],"lineRefs":[[]]},{"para":1654,"vripara":null,"refs":[],"lines":["“Padumuttaro lokavidū, āhutīnaṃ paṭiggaho;"],"lineRefs":[[]]},{"para":1655,"vripara":null,"refs":[],"lines":["Bhikkhusaṅghe nisīditvā, imā gāthā abhāsatha."],"lineRefs":[[]]},{"para":1656,"vripara":null,"refs":[],"lines":["“Yenidaṃ āsanaṃ dinnaṃ, sovaṇṇaṃ gonakatthataṃ;"],"lineRefs":[[]]},{"para":1657,"vripara":null,"refs":[],"lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."],"lineRefs":[[]]},{"para":1658,"vripara":null,"refs":[],"lines":["“Catusattatikkhattuṃ so, devarajjaṃ karissati;"],"lineRefs":[[]]},{"para":1659,"vripara":null,"refs":[],"lines":["Anubhossati sampattiṃ, accharāhi purakkhato."],"lineRefs":[[]]},{"para":1660,"vripara":null,"refs":[],"lines":["“Padesarajjaṃ sahassaṃ, vasudhaṃ āvasissati;"],"lineRefs":[[]]},{"para":1661,"vripara":null,"refs":[],"lines":["Ekapaññāsakkhattuñca, cakkavattī bhavissati."],"lineRefs":[[]]},{"para":1662,"vripara":null,"refs":[],"lines":["“Sabbāsu bhavayonīsu, uccākulī bhavissati;"],"lineRefs":[[]]},{"para":1663,"vripara":null,"refs":[],"lines":["So ca pacchā pabbajitvā, sukkamūlena codito;"],"lineRefs":[[]]},{"para":1664,"vripara":null,"refs":[],"lines":["Bhaddiyo nāma nāmena, hessati satthu sāvako."],"lineRefs":[[]]},{"para":1665,"vripara":null,"refs":[],"lines":["“Vivekamanuyuttomhi, pantasenanivāsahaṃ;"],"lineRefs":[[]]},{"para":1666,"vripara":null,"refs":[],"lines":["Phalañcādhigataṃ sabbaṃ, cattaklesomhi ajjahaṃ."],"lineRefs":[[]]},{"para":1667,"vripara":null,"refs":[],"lines":["“Mama sabbaṃ abhiññāya, sabbaññū lokanāyako;"],"lineRefs":[[]]},{"para":1668,"vripara":null,"refs":[],"lines":["Bhikkhusaṅghe nisīditvā, etadagge ṭhapesi maṃ."],"lineRefs":[[]]},{"para":1669,"vripara":null,"refs":[],"lines":["“Paṭisambhidā catasso, vimokkhāpi ca aṭṭhime;"],"lineRefs":[[]]},{"para":1670,"vripara":null,"refs":[],"lines":["Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":1671,"vripara":null,"refs":[],"lines":["Tassa bhagavā chaḷabhiññuppattiṃ ñatvā “ehi, bhaddā”ti āha.","So tāvadeva satthāraṃ upasaṅkamitvā vanditvā pañjaliko satthu samīpe aṭṭhāsi, sā eva cassa upasampadā ahosi.","Buddhūpasampadā nāma kiresā.","Thero jātito paṭṭhāya attano pavattiyā kathanamukhena aññaṃ byākaronto –"],"lineRefs":[[],[],[],[]]},{"para":1673,"vripara":"473","refs":[],"lines":["“Ekaputto ahaṃ āsiṃ, piyo mātu piyo pitu;"],"lineRefs":[[]]},{"para":1674,"vripara":null,"refs":[],"lines":["Bahūhi vatacariyāhi, laddho āyācanāhi ca."],"lineRefs":[[]]},{"para":1676,"vripara":"474","refs":[],"lines":["“Te ca maṃ anukampāya, atthakāmā hitesino;"],"lineRefs":[[]]},{"para":1677,"vripara":null,"refs":[],"lines":["Ubho pitā ca mātā ca, buddhassa upanāmayuṃ."],"lineRefs":[[]]},{"para":1679,"vripara":"475","refs":[],"lines":["“Kicchā laddho ayaṃ putto, sukhumālo sukhedhito;"],"lineRefs":[[]]},{"para":1680,"vripara":null,"refs":[],"lines":["Imaṃ dadāma te nātha, jinassa paricārakaṃ."],"lineRefs":[[]]},{"para":1682,"vripara":"476","refs":[],"lines":["“Satthā ca maṃ paṭiggayha, ānandaṃ etadabravi;"],"lineRefs":[[]]},{"para":1683,"vripara":null,"refs":[],"lines":["Pabbājehi imaṃ khippaṃ, hessatyājāniyo ayaṃ."],"lineRefs":[[]]},{"para":1685,"vripara":"477","refs":[],"lines":["“Pabbājetvāna maṃ satthā, vihāraṃ pāvisī jino;"],"lineRefs":[[]]},{"para":1686,"vripara":null,"refs":[],"lines":["Anoggatasmiṃ sūriyasmiṃ, tato cittaṃ vimucci me."],"lineRefs":[[]]},{"para":1688,"vripara":"478","refs":[],"lines":["“Tato satthā nirākatvā, paṭisallānavuṭṭhito;"],"lineRefs":[[]]},{"para":1689,"vripara":null,"refs":[],"lines":["Ehi bhaddāti maṃ āha, sā me āsūpasampadā."],"lineRefs":[[]]},{"para":1691,"vripara":"479","refs":[],"lines":["“Jātiyā sattavassena, laddhā me upasampadā;"],"lineRefs":[[]]},{"para":1692,"vripara":null,"refs":[],"lines":["Tisso vijjā anuppattā, aho dhammasudhammatā”ti.","–"],"lineRefs":[[],[]]},{"para":1693,"vripara":null,"refs":[],"lines":["Imā gāthā abhāsi."],"lineRefs":[[]]},{"para":1694,"vripara":null,"refs":[],"lines":["Tattha <b>vatacariyāhī</b>ti,“evaṃ katvā puttaṃ labhissathā”ti vuttaṃ samaṇabrāhmaṇānaṃ vacanaṃ sutvā, khīraṃ pāyitvā, anasanādivatacaraṇehi.","<b>Āyācanāhī</b>ti devatāyācanāhi satthuāyācanāya ca, idameva cettha kāraṇaṃ, itaraṃ thero mātāpitūnaṃ paṭipattidassanatthañceva kicchaladdhabhāvadassanatthañca vadati."],"lineRefs":[[],[]]},{"para":1695,"vripara":null,"refs":[],"lines":["<b>Te</b>ti mātāpitaro.","<b>Upanāmayun</b>ti upanāmesuṃ."],"lineRefs":[[],[]]},{"para":1696,"vripara":null,"refs":[],"lines":["<b>Sukhedhito</b>ti sukhasaṃvaḍḍhito.","<b>Te</b>ti tuyhaṃ.","<b>Paricārakan</b>ti kiṃkāraṃ."],"lineRefs":[[],[],[]]},{"para":1697,"vripara":null,"refs":[],"lines":["<b>Hessatyājāniyo ayan</b>ti ayaṃ dārako mama sāsane ājānīyo bhavissati.","Tasmā khippaṃ ajjeva pabbājehīti etaṃ <b>abravi,</b> āha."],"lineRefs":[[],[]]},{"para":1698,"vripara":null,"refs":[],"lines":["<b>Pabbājetvānā</b>ti ānandattherena pabbājetvā.","<b>Vihāran</b>ti gandhakuṭiṃ.","<b>Anoggatasmiṃ sūriyasmin</b>ti sūriye anatthaṅgateyeva.","<b>Tato cittaṃ vimucci me</b>ti tato vipassanārambhato paraṃ na cireneva khaṇena sabbāsavehi me cittaṃ vimucci, khīṇāsavo ahosiṃ."],"lineRefs":[[],[],[],[]]}]},"tika":null,"tika2":null}
