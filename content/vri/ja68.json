{"suttaId":"ja68","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[380,383],"vripara":"68"},"segments":{"ja68:0.4":"Sāketajātakaṃ","ja68:1.1":"Yasmiṃ mano nivisati, cittañcāpi [cittaṃ vāpi (katthaci)] pasīdati;","ja68:1.3":"Adiṭṭhapubbake pose, kāmaṃ tasmimpi vissaseti.","ja68:2.1":"Sāketajātakaṃ aṭṭhamaṃ."},"attha":null,"tika":null}
