{"suttaId":"ja68","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[380,383],"vripara":"68"},"segments":{"ja68:0.4":"Sāketajātakaṃ","ja68:1.1":"Yasmiṃ mano nivisati,","ja68:1.2":"cittañcāpi [cittaṃ vāpi (katthaci)] pasīdati;","ja68:1.3":"Adiṭṭhapubbake pose,","ja68:1.4":"kāmaṃ tasmimpi vissaseti.","ja68:2.1":"Sāketajātakaṃ aṭṭhamaṃ. 69."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1965,"to":1965,"paras":[{"para":1965,"vripara":null,"refs":["ja68:1"],"lines":["Tattha <b>yasmiṃ mano nivisatī</b>ti yasmiṃ puggale diṭṭhamatteyeva cittaṃ patiṭṭhāti.","<b>Cittañcāpi pasīdatī</b>ti yasmiṃ diṭṭhamatte cittaṃ pasīdati, mudukaṃ hoti.","<b>Adiṭṭhapubbake pose</b>ti pakatiyā tasmiṃ attabhāve adiṭṭhapubbepi puggale.","<b>Kāmaṃ tasmimpi vissase</b>ti anubhūtapubbasineheneva tasmimpi puggale ekaṃsena vissase, vissāsaṃ āpajjatiyevāti attho."],"lineRefs":[["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"]]}],"wordLinks":[["ja68:1.1","yasmiṃ mano nivisatī",0,0],["ja68:1.1","cittañcāpi pasīdatī",0,1],["ja68:1.3","adiṭṭhapubbake pose",0,2],["ja68:1.3","kāmaṃ tasmimpi vissase",0,3]]},"tika":{"book":"Ja-ṭ-i","bookName":"Jātaka-abhinavaṭīkā-1","vriCode":"","from":1040,"to":1042,"paras":[{"para":1040,"vripara":null,"refs":["ja68:1"],"lines":["8-sāketajātakavaṇṇanā (68)"],"lineRefs":[["ja68:1"]]},{"para":1041,"vripara":null,"refs":["ja68:1"],"lines":["<b>añjanavane</b>ti añjanaṃ nāma eko tiṇaviseso.","tassa bāhulla tāya taṃ vanaṃ añjanavananti vuccati.","<b>jarāsutta</b>nti suttanipāte [suttani. 405] saṅgahāruḷhaṃ jarāsuttaṃ katheti.","<b>cittañcāpī</b>ti ettha cāpīti evatthe nipātasamudayo.","eko vā nipāto.","yasmiṃ mano nivisatīti ettha vuttaṃ manosaṅkhātaṃ cittaṃyevāti attho.","athavā ekassāpi atthassa nāmantaravasena apekkhitvā cittañcāpīti vuttaṃ.","na manoyeva.","athakho cittañcāpīti attho.","athavā nivisatīti atthantaraṃ apekkhitvā cittañcāpīti vuttaṃ.","cāpisaddo hi pasīdatīti iminā sambandhitabbo.","yasmiṃ na mano nivisatiyeva.","atha kho cittaṃ pasīdaticāpīti attho.","<b>kāmaṃ tasmiṃ pi vissase</b>ti ettha kāmaṃ saddo ekaṃsatthe nipāto.","tenāha 'ekaṃsenā'ti."],"lineRefs":[["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"],["ja68:1"]]},{"para":1042,"vripara":null,"refs":["ja68:1"],"lines":["sāketajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja68:1"]]}],"wordLinks":[]},"tika2":null}
