{"suttaId":"ja56","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[313,317],"vripara":"56"},"segments":{"ja56:0.4":"Kañcanakkhandhajātakaṃ","ja56:1.1":"Yo pahaṭṭhena cittena, pahaṭṭhamanaso naro;","ja56:1.3":"Bhāveti kusalaṃ dhammaṃ, yogakkhemassa pattiyā;","ja56:1.5":"Pāpuṇe anupubbena, sabbasaṃyojanakkhayanti.","ja56:2.1":"Kañcanakkhandhajātakaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
