{"suttaId":"ja56","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[313,317],"vripara":"56"},"segments":{"ja56:0.4":"Kañcanakkhandhajātakaṃ","ja56:1.1":"Yo pahaṭṭhena cittena, pahaṭṭhamanaso naro;","ja56:1.3":"Bhāveti kusalaṃ dhammaṃ, yogakkhemassa pattiyā;","ja56:1.5":"Pāpuṇe anupubbena, sabbasaṃyojanakkhayanti.","ja56:2.1":"Kañcanakkhandhajātakaṃ chaṭṭhaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1787,"to":1787,"paras":[{"para":1787,"vripara":null,"refs":["ja56:1"],"lines":["Tattha <b>pahaṭṭhenā</b>ti vinīvaraṇena.","<b>Pahaṭṭhamanaso</b>ti tāya eva vinīvaraṇatāya pahaṭṭhamānaso, suvaṇṇaṃ viya pahaṃsitvā samujjotitasappabhāsacitto hutvāti attho."],"lineRefs":[["ja56:1"],["ja56:1"]]}],"wordLinks":[["ja56:1.1","pahaṭṭhenā",0,0],["ja56:1.1","pahaṭṭhamanaso",0,1]]},"tika":null,"tika2":null}
