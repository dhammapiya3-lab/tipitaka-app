{"suttaId":"tha-ap245","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8142,8157],"vripara":"9"},"segments":{"tha-ap245:0.3":"Naḷinakesariyattheraapadānaṃ","tha-ap245:1.1":"“Jātassarassa vemajjhe, vasāmi jalakukkuṭo;","tha-ap245:1.3":"Addasāhaṃ [athaddasaṃ (sī. syā.)] devadevaṃ, gacchantaṃ anilañjase.","tha-ap245:2.1":"“Tuṇḍena kesariṃ [kesaraṃ (syā.)] gayha, vippasannena cetasā;","tha-ap245:2.3":"Buddhassa abhiropesiṃ, tissassa lokabandhuno.","tha-ap245:3.1":"“Dvenavute ito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap245:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap245:4.1":"“Tesattatimhi kappamhi, satta kesaranāmakā [satapattasanāmako (sī. syā.)];","tha-ap245:4.3":"Sattaratanasampannā, cakkavattī mahabbalā.","tha-ap245:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap245:6.1":"Itthaṃ sudaṃ āyasmā naḷinakesariyo thero imā gāthāyo abhāsitthāti.","tha-ap245:7.1":"Naḷinakesariyattherassāpadānaṃ tatiyaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3200,"to":3200,"paras":[{"para":3200,"vripara":"9-10","refs":["tha-ap245:1"],"lines":["9-10. Tatiyāpadāne <b>jalakukkuṭo</b>ti jātassare caramānakukkuṭo.","<b>Tuṇḍena kesariṃ gayhā</b>ti padumapupphaṃ mukhatuṇḍena ḍaṃsitvā ākāsena gacchantassa <b>tissassa</b> bhagavato <b>abhiropesiṃ</b> pūjesinti attho."],"lineRefs":[["tha-ap245:1"],["tha-ap245:1"]]}],"wordLinks":[["tha-ap245:1.1","jalakukkuṭo",0,0]]},"tika":null}
