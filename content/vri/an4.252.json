{"suttaId":"an4.252","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1850,1850],"vripara":"252"},"segments":{"an4.252:0.3":"Tatiyavohārasuttaṃ","an4.252:1.1":"“Cattārome, bhikkhave, anariyavohārā.","an4.252:1.2":"Katame cattāro?","an4.252:1.3":"Diṭṭhe adiṭṭhavāditā, sute asutavāditā, mute amutavāditā, viññāte aviññātavāditā – ime kho, bhikkhave, cattāro anariyavohārā”ti.","an4.252:1.5":"Dasamaṃ."},"attha":null,"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1910,"to":1915,"paras":[{"para":1910,"vripara":"250-253","refs":["an4.252:1"],"lines":["250-253. Aṭṭhame <b>anariyānan</b>ti asādhūnaṃ nihīnānaṃ.","<b>Vohārā</b>ti saṃvohārā abhilāpā vā,“diṭṭhaṃ mayā”ti evaṃvāditā.","Ettha ca taṃtaṃsamuṭṭhāpakacetanāvasena attho veditabbo.","Navamādīsu natthi vattabbaṃ."],"lineRefs":[["an4.252:1"],["an4.252:1"],["an4.252:1"],["an4.252:1"]]},{"para":1911,"vripara":null,"refs":[],"lines":["Paṭhamavohārasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1912,"vripara":null,"refs":[],"lines":["Āpattibhayavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1913,"vripara":null,"refs":[],"lines":["Pañcamapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[[]]},{"para":1914,"vripara":null,"refs":[],"lines":["(26)6. Abhiññāvaggo"],"lineRefs":[[]]},{"para":1915,"vripara":null,"refs":["an4.252:1"],"lines":["1-3. Abhiññāsuttādivaṇṇanā"],"lineRefs":[["an4.252:1"]]}],"wordLinks":[]}}
