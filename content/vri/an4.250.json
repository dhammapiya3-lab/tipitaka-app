{"suttaId":"an4.250","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1846,1846],"vripara":"250"},"segments":{"an4.250:0.3":"Paṭhamavohārasuttaṃ","an4.250:1.1":"“Cattārome, bhikkhave, anariyavohārā.","an4.250:1.2":"Katame cattāro?","an4.250:1.3":"Adiṭṭhe diṭṭhavāditā, asute sutavāditā, amute mutavāditā, aviññāte viññātavāditā – ime kho, bhikkhave, cattāro anariyavohārā”ti.","an4.250:1.5":"Aṭṭhamaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1706,"to":1706,"paras":[{"para":1706,"vripara":"250","refs":["an4.250:1"],"lines":["Aṭṭhame <b>anariyavohārā</b>ti anariyānaṃ kathā.","Sesesupi eseva nayo."],"lineRefs":[["an4.250:1"],["an4.250:1"]]}],"wordLinks":[["an4.250:1.1","anariyavohārā",0,0],["an4.250:1.3","anariyavohārā",0,0]]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1910,"to":1910,"paras":[{"para":1910,"vripara":"250-253","refs":["an4.250:1"],"lines":["250-253. Aṭṭhame <b>anariyānan</b>ti asādhūnaṃ nihīnānaṃ.","<b>Vohārā</b>ti saṃvohārā abhilāpā vā,“diṭṭhaṃ mayā”ti evaṃvāditā.","Ettha ca taṃtaṃsamuṭṭhāpakacetanāvasena attho veditabbo.","Navamādīsu natthi vattabbaṃ."],"lineRefs":[["an4.250:1"],["an4.250:1"],["an4.250:1"],["an4.250:1"]]}],"wordLinks":[["an4.250:1.1","vohārā",0,1],["an4.250:1.3","vohārā",0,1]]},"tika2":null}
