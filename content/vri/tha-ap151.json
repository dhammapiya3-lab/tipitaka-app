{"suttaId":"tha-ap151","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6410,6425],"vripara":"43"},"segments":{"tha-ap151:0.3":"Vaṭaṃsakiyattheraapadānaṃ","tha-ap151:1.1":"“Sumedho nāma nāmena,","tha-ap151:1.2":"sayambhū aparājito;","tha-ap151:1.3":"Vivekamanubrūhanto,","tha-ap151:1.4":"ajjhogahi mahāvanaṃ.","tha-ap151:2.1":"“Saḷalaṃ pupphitaṃ disvā,","tha-ap151:2.2":"ganthitvāna [bandhitvāna (sī.)] vaṭaṃsakaṃ;","tha-ap151:2.3":"Buddhassa abhiropesiṃ,","tha-ap151:2.4":"sammukhā lokanāyakaṃ.","tha-ap151:3.1":"“Tiṃsakappasahassamhi,","tha-ap151:3.2":"yaṃ pupphamabhiropayiṃ;","tha-ap151:3.3":"Duggatiṃ nābhijānāmi,","tha-ap151:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap151:4.1":"“Ūnavīse kappasate,","tha-ap151:4.2":"soḷasāsuṃ sunimmitā;","tha-ap151:4.3":"Sattaratanasampannā,","tha-ap151:4.4":"cakkavattī mahabbalā.","tha-ap151:5.1":"“Paṭisambhidā catasso … pe …","tha-ap151:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap151:6.1":"Itthaṃ sudaṃ āyasmā vaṭaṃsakiyo thero imā gāthāyo abhāsitthāti.","tha-ap151:7.1":"Vaṭaṃsakiyattherassāpadānaṃ navamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3022,"to":3022,"paras":[{"para":3022,"vripara":"43","refs":["tha-ap151:1"],"lines":["So aparabhāge pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>sumedho nāma nāmenā</b>tiādi vuttaṃ.","<b>Vivekamanubrūhanto</b>ti janākiṇṇataṃ pahāya janavivekaṃ cittavivekañca anubrūhanto vaḍḍhento bahulīkaronto mahāvanaṃ ajjhogāhi pāvisīti attho.","Sesaṃ uttānatthamevāti."],"lineRefs":[["tha-ap151:1"],["tha-ap151:1"],["tha-ap151:1"]]}],"wordLinks":[["tha-ap151:1.1","sumedho nāma nāmenā",0,0],["tha-ap151:1.3","vivekamanubrūhanto",0,1]]},"tika":null,"tika2":null}
