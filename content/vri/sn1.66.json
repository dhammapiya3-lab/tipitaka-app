{"suttaId":"sn1.66","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[756,760],"vripara":"66"},"segments":{"sn1.66:0.3":"Attahatasuttaṃ","sn1.66:1.1":"“Kenassubbhāhato loko, kenassu parivārito;","sn1.66:1.3":"Kena sallena otiṇṇo, kissa dhūpāyito sadā”ti.","sn1.66:2.1":"“Maccunābbhāhato loko, jarāya parivārito;","sn1.66:2.3":"Taṇhāsallena otiṇṇo, icchādhūpāyito sadā”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":466,"to":466,"paras":[{"para":466,"vripara":"66","refs":["sn1.66:1","sn1.66:2"],"words":["kenassubbhāhato","icchādhūpāyito"],"lines":["Chaṭṭhe <b>kenassubbhāhato</b>ti kena abbhāhato.","Su-kāro nipātamattaṃ.","<b>Icchādhūpāyito</b>ti icchāya āditto.","Chaṭṭhaṃ."],"lineRefs":[["sn1.66:1"],["sn1.66:1"],["sn1.66:2"],["sn1.66:2"]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":575,"to":575,"paras":[{"para":575,"vripara":"66","refs":["sn1.66:2"],"words":["icchādhūpāyito"],"lines":["“Kenassubbhāhato”ti pāṭhoti adhippāyena <b>“su-kāro nipātamattan”</b>ti āha,“kenassabbhāhato”ti pana pāṭhe u-kāralopena padasandhi.","<b>Icchādhūpāyito</b>ti asampattavisayicchālakkhaṇāya taṇhāya santāpito daḍḍho.","Tenāha <b>“icchāya āditto”</b>ti."],"lineRefs":[["sn1.66:2"],["sn1.66:2"],["sn1.66:2"]]}]}}
