{"suttaId":"ja238","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1622,1629],"vripara":"175"},"segments":{"ja238:0.4":"Ekapadajātakaṃ (2-9-8)","ja238:1.1":"Iṅgha ekapadaṃ tāta,","ja238:1.2":"anekatthapadassitaṃ [padanissitaṃ (sī. pī.)];","ja238:1.3":"Kiñci saṅgāhikaṃ brūsi,","ja238:1.4":"yenatthe sādhayemase. 176.","ja238:2.1":"Dakkheyyekapadaṃ tāta,","ja238:2.2":"anekatthapadassitaṃ;","ja238:2.3":"Tañca sīlena saññuttaṃ,","ja238:2.4":"khantiyā upapāditaṃ;","ja238:2.5":"Alaṃ mitte sukhāpetuṃ,","ja238:2.6":"amittānaṃ dukhāya cāti.","ja238:3.1":"Ekapadajātakaṃ aṭṭhamaṃ. 239."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1535,"to":1541,"paras":[{"para":1535,"vripara":null,"refs":["ja238:1"],"lines":["Tattha <b>iṅghā</b>ti yācanatthe codanatthe vā nipāto.","<b>Ekapada</b>nti ekaṃ kāraṇapadaṃ, ekaṃ kāraṇūpasañhitaṃ vā byañjanapadaṃ.","<b>Anekatthapadassita</b>nti anekāni atthapadāni kāraṇapadāni nissitaṃ.","<b>Kiñci saṅgāhikaṃ brūsī</b>ti kiñci ekapadaṃ bahūnaṃ padānaṃ saṅgāhikaṃ brūhi, ayameva vā pāṭho.","<b>Yenatthe sādhayemase</b>ti yena ekena padena anekatthanissitena mayaṃ attano vuḍḍhiṃ sādheyyāma, taṃ me kathehīti pucchi."],"lineRefs":[["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"]]},{"para":1536,"vripara":null,"refs":["ja238:1"],"lines":["Athassa pitā kathento dutiyaṃ gāthamāha – 176."],"lineRefs":[["ja238:1"]]},{"para":1538,"vripara":"176","refs":["ja238:1"],"lines":["“Dakkheyyekapadaṃ tāta, anekatthapadassitaṃ;"],"lineRefs":[["ja238:1"]]},{"para":1539,"vripara":null,"refs":["ja238:1"],"lines":["Tañca sīlena saññuttaṃ, khantiyā upapāditaṃ;"],"lineRefs":[["ja238:1"]]},{"para":1540,"vripara":null,"refs":["ja238:1"],"lines":["Alaṃ mitte sukhāpetuṃ, amittānaṃ dukhāya cā”ti."],"lineRefs":[["ja238:1"]]},{"para":1541,"vripara":null,"refs":["ja238:2"],"lines":["Tattha <b>dakkheyyekapada</b>nti dakkheyyaṃ ekapadaṃ.","Dakkheyyaṃ nāma lābhuppādakassa chekassa kusalassa ñāṇasampayuttaṃ vīriyaṃ.","<b>Anekatthapadassita</b>nti evaṃ vuttappakāraṃ vīriyaṃ anekehi atthapadehi nissitaṃ.","Katarehīti?","Sīlādīhi.","Teneva <b>“tañca sīlena saññutta”</b>ntiādimāha.","Tassattho – tañca panetaṃ vīriyaṃ ācārasīlasampayuttaṃ adhivāsanakhantiyā upetaṃ mitte sukhāpetuṃ amittānañca dukkhāya alaṃ samatthaṃ.","Ko hi nāma lābhuppādakañāṇasampayuttakusalavīriyasamannāgato ācārakhantisampanno mitte sukhāpetuṃ, amitte vā dukkhāpetuṃ na sakkotīti."],"lineRefs":[["ja238:2"],["ja238:2"],["ja238:2"],["ja238:2"],["ja238:2"],["ja238:2"],["ja238:2"],["ja238:2"]]}],"wordLinks":[["ja238:1.1","iṅghā",0,0],["ja238:1.1","ekapadaṃ",0,1],["ja238:1.1","anekatthapadassitaṃ",0,2],["ja238:1.3","kiñci saṅgāhikaṃ brūsī",0,3],["ja238:1.3","yenatthe sādhayemase",0,4],["ja238:2.1","dakkheyyekapadaṃ",5,0],["ja238:2.1","anekatthapadassitaṃ",5,2],["ja238:2.3","tañca sīlena saññuttaṃ",5,5]]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":839,"to":845,"paras":[{"para":839,"vripara":null,"refs":["ja238:1"],"lines":["8-ekapadajātakavaṇṇanā (238)"],"lineRefs":[["ja238:1"]]},{"para":840,"vripara":null,"refs":["ja238:1"],"lines":["<b>sāvatthivāsiko kiresa kuṭumbiko</b>ti eso kira kuṭumbiko sāvatthivāsiko ahosīti sambandho.","<b>athassā</b>ti atha assa kuṭumbikassa.","<b>so “buddhavisayo esa peŭhā”</b>ti so kuṭumbiko esa peŭhā buddhānaṃ visayo.","<b>ta</b>nti paŭhaṃ.","idañca tena attano maññanākāravasena vuttaṃ.","bodhisattopi hi taṃ kathetuṃ samattho yevāti.","bhagavā pana pubbe attanā kathitaniyāmeneva taṃ jānāpesi.","tenāha — “satthā”tiādi."],"lineRefs":[["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"]]},{"para":841,"vripara":null,"refs":["ja238:1"],"lines":["<b>yācanatthe</b>ti āsīsanatthe.","<b>codanatetha</b>ti pesanatthe.","<b>kāraṇapada</b>nti kāraṇasaṅkhataṃ padaṃ.","kāraṇatthaṃ padanti attho.","<b>kāraṇūpa-saṃhita</b>nti kāraṇapaṭisaṃyuttaṃ.","<b>byañjanapada</b>nti byañjanasaṅkhātaṃ padaṃ.","<b>atthapadānī</b>ti atthajātāni.","<b>kāraṇapadānī</b>ti kāraṇajātāni.","<b>ayameva vā pāṭho</b>ti ta-kārantavasena saṅgāhitanti vā pāṭho dissati. <b>yena tena padena anekatthanissitenā</b>ti yādisena ekapadaṃ anekatthapadanissitanti yathāvuttena tena padena anekatthanissitena."],"lineRefs":[["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"]]},{"para":842,"vripara":null,"refs":["ja238:1"],"lines":["footnote 1.","pubbesu potthakesu “saṅgāhita”nti atthi maññe."],"lineRefs":[["ja238:1"],["ja238:1"]]},{"para":843,"vripara":null,"refs":["ja238:1"],"lines":["footnote 2.","ekena.","jā.","ṭṭha.","217."],"lineRefs":[["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"]]},{"para":844,"vripara":null,"refs":["ja238:1"],"lines":["<b>dakkheyya</b>nti dakkhassa chekassa idaṃ dakkheyyanti saddasiddhi veditabbā.","tenāha — “dakkheyyaṃ nāmā”tiādi.","<b>lābhuppādakassā</b>ti lābhaṃ dhanaṃ uppādetuṃ samatthassa chekassa kusalassāti attho.","dakkhasaddasāmatthi-yeneva idaṃ ñāṇasampayuttaṃyeva vīriyaṃ gahetabbanti āha “ñāṇasampayuttaṃ vīriya”nti.","<b>anekatthapadassita</b>nti yadā vīriyena saddhiṃ sesadhammā gahetabbā.","tadā anekatthapadāni sitaṃ nissitanti viggahavākyaṃ adhippetaṃ.","yadā pana ñāṇasampayuttavīriyameva kammabhāvena gaṇhāti.","tadā sesadhammā karaṇabhāvena gahetabbā.","tena <b>anekatthapadassita</b>nti anekāni atthapadāni kāraṇapadāni nissitanti pubbe vatvā, puna pacchā anekatthapadassitanti evaṃ vuttappakāraṃ vīriyaṃ anekehi atthapadehi nissitanti vuttaṃ.","tattha <b>vuttappakāraṃ vīriya</b>nti ñāṇasampayuttavīriyaṃ.","<b>katarehī</b>ti katamehi anekehi atthapadehi nissitanti attho.","<b>sīlādīhī</b>ti vīriyato sesehi sīlādīhi.","<b>upeta</b>nti iminā upapajjanaṃ upapāditaṃ upasampajjananti attho dassito.","<b>ko hi nāma lābhuppādaka-ñāṇasampayuttakusalavīriyasampannāgato</b>ti lābhuppādakañāṇa-sampayuttakusalavīriyena sampannāgato.","<b>ācārakhantīsampanno</b>ti ācārakhantīhi sampanno.","ko hi nāma puggalo mitte sukhāpetuṃ amitte vā dukkhāpetuṃ na sakkoti.","sakkoti yevāti attho.","ettha ca lābhuppādakañāṇasampayuttaakusalavīriyasampannogatoti katthaci saha akārena pāṭho dissati.","so apāṭhoti."],"lineRefs":[["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"]]},{"para":845,"vripara":null,"refs":["ja238:1"],"lines":["ending ekapadajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja238:1"]]}],"wordLinks":[]},"tika2":null}
