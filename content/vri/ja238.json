{"suttaId":"ja238","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1622,1629],"vripara":"175"},"segments":{"ja238:0.4":"Ekapadajātakaṃ (2-9-8)","ja238:1.1":"Iṅgha ekapadaṃ tāta, anekatthapadassitaṃ [padanissitaṃ (sī. pī.)];","ja238:1.3":"Kiñci saṅgāhikaṃ brūsi, yenatthe sādhayemase.","ja238:2.1":"Dakkheyyekapadaṃ tāta, anekatthapadassitaṃ;","ja238:2.3":"Tañca sīlena saññuttaṃ, khantiyā upapāditaṃ;","ja238:2.5":"Alaṃ mitte sukhāpetuṃ, amittānaṃ dukhāya cāti.","ja238:3.1":"Ekapadajātakaṃ aṭṭhamaṃ."},"attha":null,"tika":null}
