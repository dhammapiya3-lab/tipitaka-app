{"suttaId":"ja238","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1622,1629],"vripara":"175"},"segments":{"ja238:0.4":"Ekapadajātakaṃ (2-9-8)","ja238:1.1":"Iṅgha ekapadaṃ tāta,","ja238:1.2":"anekatthapadassitaṃ [padanissitaṃ (sī. pī.)];","ja238:1.3":"Kiñci saṅgāhikaṃ brūsi,","ja238:1.4":"yenatthe sādhayemase.","ja238:2.1":"Dakkheyyekapadaṃ tāta,","ja238:2.2":"anekatthapadassitaṃ;","ja238:2.3":"Tañca sīlena saññuttaṃ,","ja238:2.4":"khantiyā upapāditaṃ;","ja238:2.5":"Alaṃ mitte sukhāpetuṃ,","ja238:2.6":"amittānaṃ dukhāya cāti.","ja238:3.1":"Ekapadajātakaṃ aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1535,"to":1541,"paras":[{"para":1535,"vripara":null,"refs":["ja238:1"],"lines":["Tattha <b>iṅghā</b>ti yācanatthe codanatthe vā nipāto.","<b>Ekapadan</b>ti ekaṃ kāraṇapadaṃ, ekaṃ kāraṇūpasañhitaṃ vā byañjanapadaṃ.","<b>Anekatthapadassitan</b>ti anekāni atthapadāni kāraṇapadāni nissitaṃ.","<b>Kiñci saṅgāhikaṃ brūsī</b>ti kiñci ekapadaṃ bahūnaṃ padānaṃ saṅgāhikaṃ brūhi, ayameva vā pāṭho.","<b>Yenatthe sādhayemase</b>ti yena ekena padena anekatthanissitena mayaṃ attano vuḍḍhiṃ sādheyyāma, taṃ me kathehīti pucchi."],"lineRefs":[["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"],["ja238:1"]]},{"para":1536,"vripara":null,"refs":["ja238:1"],"lines":["Athassa pitā kathento dutiyaṃ gāthamāha –"],"lineRefs":[["ja238:1"]]},{"para":1538,"vripara":"176","refs":["ja238:1"],"lines":["“Dakkheyyekapadaṃ tāta, anekatthapadassitaṃ;"],"lineRefs":[["ja238:1"]]},{"para":1539,"vripara":null,"refs":["ja238:1"],"lines":["Tañca sīlena saññuttaṃ, khantiyā upapāditaṃ;"],"lineRefs":[["ja238:1"]]},{"para":1540,"vripara":null,"refs":["ja238:1"],"lines":["Alaṃ mitte sukhāpetuṃ, amittānaṃ dukhāya cā”ti."],"lineRefs":[["ja238:1"]]},{"para":1541,"vripara":null,"refs":["ja238:2"],"lines":["Tattha <b>dakkheyyekapadan</b>ti dakkheyyaṃ ekapadaṃ.","Dakkheyyaṃ nāma lābhuppādakassa chekassa kusalassa ñāṇasampayuttaṃ vīriyaṃ.","<b>Anekatthapadassitan</b>ti evaṃ vuttappakāraṃ vīriyaṃ anekehi atthapadehi nissitaṃ.","Katarehīti?","Sīlādīhi.","Teneva <b>“tañca sīlena saññuttan”</b>tiādimāha.","Tassattho – tañca panetaṃ vīriyaṃ ācārasīlasampayuttaṃ adhivāsanakhantiyā upetaṃ mitte sukhāpetuṃ amittānañca dukkhāya alaṃ samatthaṃ.","Ko hi nāma lābhuppādakañāṇasampayuttakusalavīriyasamannāgato ācārakhantisampanno mitte sukhāpetuṃ, amitte vā dukkhāpetuṃ na sakkotīti."],"lineRefs":[["ja238:2"],["ja238:2"],["ja238:2"],["ja238:2"],["ja238:2"],["ja238:2"],["ja238:2"],["ja238:2"]]}],"wordLinks":[["ja238:1.1","iṅghā",0,0],["ja238:1.1","ekapadaṃ",0,1],["ja238:1.1","anekatthapadassitaṃ",0,2],["ja238:1.3","kiñci saṅgāhikaṃ brūsī",0,3],["ja238:1.3","yenatthe sādhayemase",0,4],["ja238:2.1","dakkheyyekapadaṃ",5,0],["ja238:2.1","anekatthapadassitaṃ",5,2],["ja238:2.3","tañca sīlena saññuttaṃ",5,5]]},"tika":null,"tika2":null}
