{"suttaId":"ja284","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2126,2135],"vripara":"100"},"segments":{"ja284:0.4":"Sirijātakaṃ (3-4-4)","ja284:1.1":"Yaṃ ussukā saṅgharanti, alakkhikā bahuṃ dhanaṃ;","ja284:1.3":"Sippavanto asippā ca, lakkhivā tāni bhuñjati.","ja284:2.1":"Sabbattha katapuññassa, aticcaññeva pāṇino;","ja284:2.3":"Uppajjanti bahū bhogā, appanāyatanesupi.","ja284:3.1":"Kukkuṭo [kukkuṭa (sī. pī.), kukkuṭā (sī. nissaya, saddanīti)] maṇayo daṇḍo, thiyo ca puññalakkhaṇā;","ja284:3.3":"Uppajjanti apāpassa, katapuññassa jantunoti.","ja284:4.1":"Sirijātakaṃ catutthaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":2637,"to":2657,"paras":[{"para":2637,"vripara":null,"refs":["ja284:2"],"lines":["<b>Aticcaññeva pāṇino</b>ti aticca aññe eva pāṇino.","Eva-kāro purimapadena yojetabbo, sabbattheva katapuññassa aññe akatapuññe satte atikkamitvāti attho.","<b>Appanāyatanesupī</b>ti api anāyatanesupi aratanākaresu ratanāni asuvaṇṇāyatanādīsu suvaṇṇādīni ahatthāyatanādīsu hatthiādayoti saviññāṇakaaviññāṇakā bahū bhogā uppajjanti.","Tattha muttāmaṇiādīnaṃ anākare uppattiyaṃ duṭṭhagāmaṇiabhayamahārājassa vatthu kathetabbaṃ."],"lineRefs":[["ja284:2"],["ja284:2"],["ja284:2"],["ja284:2"]]},{"para":2638,"vripara":null,"refs":[],"lines":["Satthā pana imā gāthā vatvā “gahapati, imesaṃ sattānaṃ puññasadisaṃ aññaṃ āyatanaṃ nāma natthi, puññavantānañhi anākaresu ratanāni uppajjantiyevā”ti vatvā imaṃ dhammaṃ desesi –"],"lineRefs":[[]]},{"para":2639,"vripara":null,"refs":[],"lines":["“Esa devamanussānaṃ, sabbakāmadado nidhi;"],"lineRefs":[[]]},{"para":2640,"vripara":null,"refs":[],"lines":["Yaṃ yadevābhipatthenti, sabbametena labbhati."],"lineRefs":[[]]},{"para":2641,"vripara":null,"refs":[],"lines":["“Suvaṇṇatā susaratā, susaṇṭhānā surūpatā;"],"lineRefs":[[]]},{"para":2642,"vripara":null,"refs":[],"lines":["Ādhipaccaparivāro, sabbametena labbhati."],"lineRefs":[[]]},{"para":2643,"vripara":null,"refs":[],"lines":["“Padesarajjaṃ issariyaṃ, cakkavattisukhaṃ piyaṃ;"],"lineRefs":[[]]},{"para":2644,"vripara":null,"refs":[],"lines":["Devarajjampi dibbesu, sabbametena labbhati."],"lineRefs":[[]]},{"para":2645,"vripara":null,"refs":[],"lines":["“Mānussikā ca sampatti, devaloke ca yā rati;"],"lineRefs":[[]]},{"para":2646,"vripara":null,"refs":[],"lines":["Yā ca nibbānasampatti, sabbametena labbhati."],"lineRefs":[[]]},{"para":2647,"vripara":null,"refs":[],"lines":["“Mittasampadamāgamma, yonisova payuñjato;"],"lineRefs":[[]]},{"para":2648,"vripara":null,"refs":[],"lines":["Vijjāvimuttivasībhāvo, sabbametena labbhati."],"lineRefs":[[]]},{"para":2649,"vripara":null,"refs":[],"lines":["“Paṭisambhidā vimokkhā ca, yā ca sāvakapāramī;"],"lineRefs":[[]]},{"para":2650,"vripara":null,"refs":[],"lines":["Paccekabodhi buddhabhūmi, sabbametena labbhati."],"lineRefs":[[]]},{"para":2651,"vripara":null,"refs":[],"lines":["“Evaṃ mahatthikā esā, yadidaṃ puññasampadā;"],"lineRefs":[[]]},{"para":2652,"vripara":null,"refs":[],"lines":["Tasmā dhīrā pasaṃsanti, paṇḍitā katapuññatan”ti.(khu. pā.8.10-16);"],"lineRefs":[[]]},{"para":2653,"vripara":null,"refs":[],"lines":["Idāni yesu anāthapiṇḍikassa sirī patiṭṭhitā, tāni ratanāni dassetuṃ <b>“kukkuṭo”</b>tiādimāha."],"lineRefs":[[]]},{"para":2655,"vripara":"102","refs":[],"lines":["“Kukkuṭo maṇayo daṇḍo, thiyo ca puññalakkhaṇā;"],"lineRefs":[[]]},{"para":2656,"vripara":null,"refs":[],"lines":["Uppajjanti apāpassa, katapuññassa jantuno”ti."],"lineRefs":[[]]},{"para":2657,"vripara":null,"refs":["ja284:3"],"lines":["Tattha <b>daṇḍo</b>ti ārakkhayaṭṭhiṃ sandhāya vuttaṃ, <b>thiyo</b>ti seṭṭhibhariyaṃ puññalakkhaṇadeviṃ.","Sesamettha uttānameva.","Gāthaṃ vatvā ca pana jātakaṃ samodhānesi –","“tadā rājā ānando ahosi, kulūpakatāpaso pana ahameva sammāsambuddho ahosin”ti."],"lineRefs":[["ja284:3"],["ja284:3"],["ja284:3"],["ja284:3"]]}],"wordLinks":[["ja284:2.1","aticcaññeva pāṇino",0,0],["ja284:2.3","appanāyatanesupī",0,2],["ja284:3.1","daṇḍo",19,0],["ja284:3.1","thiyo",19,0]]},"tika":null}
