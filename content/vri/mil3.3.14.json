{"suttaId":"mil3.3.14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Mil","vriCode":"s0518m.nrf","paras":[371,376],"vripara":"14"},"segments":{"mil3.3.14:0.3":"Vicāralakkhaṇapañho","mil3.3.14:1.1":"“Bhante nāgasena, kiṃlakkhaṇo vicāro”ti?","mil3.3.14:1.2":"“Anumajjanalakkhaṇo, mahārāja, vicāro”ti.","mil3.3.14:2.1":"“Opammaṃ karohī”ti.","mil3.3.14:2.2":"“Yathā, mahārāja, kaṃsathālaṃ ākoṭitaṃ pacchā anuravati anusandahati [anusaddāyati (ka.)], yathā, mahārāja, ākoṭanā, evaṃ vitakko daṭṭhabbo.","mil3.3.14:2.3":"Yathā anuravanā [anumajjanā (ka.)], evaṃ vicāro daṭṭhabbo”ti.","mil3.3.14:3.1":"“Kallosi, bhante nāgasenā”ti.","mil3.3.14:4.1":"Vicāralakkhaṇapañho cuddasamo.","mil3.3.14:5.1":"Vicāravaggo tatiyo.","mil3.3.14:6.1":"Imasmiṃ vagge cuddasa pañhā."},"unsure":[],"attha":null,"tika":null,"tika2":null}
