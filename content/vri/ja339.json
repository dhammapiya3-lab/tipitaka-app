{"suttaId":"ja339","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2884,2896],"vripara":"153"},"segments":{"ja339:0.4":"Bāverujātakaṃ (4-4-9)","ja339:1.1":"Adassanena morassa, sikhino mañjubhāṇino;","ja339:1.3":"Kākaṃ tattha apūjesuṃ, maṃsena ca phalena ca.","ja339:2.1":"Yadā ca sarasampanno, moro bāverumāgamā;","ja339:2.3":"Atha lābho ca sakkāro, vāyasassa ahāyatha.","ja339:3.1":"Yāva nuppajjatī buddho, dhammarājā pabhaṅkaro;","ja339:3.3":"Tāva aññe apūjesuṃ, puthū samaṇabrāhmaṇe.","ja339:4.1":"Yadā ca sarasampanno, buddho dhammaṃ adesayi;","ja339:4.3":"Atha lābho ca sakkāro, titthiyānaṃ ahāyathāti.","ja339:5.1":"Bāverujātakaṃ navamaṃ."},"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":1021,"to":1021,"paras":[{"para":1021,"vripara":null,"refs":["ja339:4"],"lines":["Tattha <b>sikhino</b>ti sikhāya samannāgatassa.","<b>Mañjubhāṇino</b>ti madhurassarassa.","<b>Apūjesun</b>ti apūjayiṃsu.","<b>Maṃsena ca phalena cā</b>ti nānappakārena maṃsena phalāphalena ca.","<b>Bāverumāgamā</b>ti bāveruraṭṭhaṃ āgato.","“Bhāverū” tipi pāṭho.","<b>Ahāyathā</b>ti parihīno.","<b>Dhammarājā</b>ti navahi lokuttaradhammehi parisaṃ rañjetīti dhammarājā.","<b>Pabhaṅkaro</b>ti sattalokaokāsalokasaṅkhāralokesu ālokassa katattā pabhaṅkaro.","<b>Sarasampanno</b>ti brahmassarena samannāgato.","<b>Dhammaṃ adesayī</b>ti catusaccadhammaṃ pakāsesīti."],"lineRefs":[["ja339:4"],["ja339:4"],["ja339:4"],["ja339:4"],["ja339:4"],["ja339:4"],["ja339:4"],["ja339:4"],["ja339:4"],["ja339:4"],["ja339:4"]]}],"wordLinks":[["ja339:4.3","ahāyathā",0,6],["ja339:4.1","sarasampanno",0,9],["ja339:4.1","dhammaṃ adesayī",0,10]]},"tika":null,"tika2":null}
