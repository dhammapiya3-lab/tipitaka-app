{"suttaId":"vv29","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[883,913],"vripara":"286"},"segments":{"vv29:0.4":"Uḷāravimānavatthu","vv29:1.1":"“Uḷāro te yaso vaṇṇo,","vv29:1.2":"sabbā obhāsate disā;","vv29:1.3":"Nāriyo naccanti gāyanti,","vv29:1.4":"devaputtā alaṅkatā. 287.","vv29:2.1":"“Modenti parivārenti,","vv29:2.2":"tava pūjāya devate;","vv29:2.3":"Sovaṇṇāni vimānāni,","vv29:2.4":"tavimāni sudassane. 288.","vv29:3.1":"“Tuvaṃsi issarā tesaṃ,","vv29:3.2":"sabbakāmasamiddhinī;","vv29:3.3":"Abhijātā mahantāsi,","vv29:3.4":"devakāye pamodasi;","vv29:3.5":"Devate pucchitācikkha,","vv29:3.6":"kissa kammassidaṃ phala”nti. 289.","vv29:4.1":"“Ahaṃ manussesu manussabhūtā,","vv29:4.2":"purimāya jātiyā manussaloke;","vv29:4.3":"Dussīlakule suṇisā ahosiṃ,","vv29:4.4":"assaddhesu kadariyesu ahaṃ. 290.","vv29:5.1":"“Saddhā sīlena sampannā,","vv29:5.2":"saṃvibhāgaratā sadā;","vv29:5.3":"Piṇḍāya caramānassa,","vv29:5.4":"apūvaṃ te adāsahaṃ. 291.","vv29:6.1":"“Tadāhaṃ sassuyācikkhiṃ,","vv29:6.2":"samaṇo āgato idha;","vv29:6.3":"Tassa adāsahaṃ pūvaṃ,","vv29:6.4":"pasannā sehi pāṇibhi. 292.","vv29:7.1":"“Itissā sassu paribhāsi,","vv29:7.2":"avinītāsi tvaṃ [avinītā tuvaṃ (sī.)] vadhu;","vv29:7.3":"Na maṃ sampucchituṃ icchi,","vv29:7.4":"samaṇassa dadāmahaṃ. 293.","vv29:8.1":"“Tato me sassu kupitā,","vv29:8.2":"pahāsi musalena maṃ;","vv29:8.3":"Kūṭaṅgacchi avadhi maṃ,","vv29:8.4":"nāsakkhiṃ jīvituṃ ciraṃ. 294.","vv29:9.1":"“Sā ahaṃ kāyassa bhedā,","vv29:9.2":"vippamuttā tato cutā;","vv29:9.3":"Devānaṃ tāvatiṃsānaṃ,","vv29:9.4":"upapannā sahabyataṃ. 295.","vv29:10.1":"“Tena metādiso vaṇṇo…pe…","vv29:10.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv29:11.1":"Uḷāravimānaṃ paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1158,"to":1187,"paras":[{"para":1158,"vripara":"286","refs":["vv29:1"],"lines":["Tattha <b>yaso</b>ti parivāro.","<b>Vaṇṇo</b>ti vaṇṇanibhā sarīrobhāso.","“Uḷāro”ti pana visesetvā vuttattā tassā devatāya parivārasampatti ca vaṇṇasampatti ca vuttā hoti.","Tāsu “uḷāro te vaṇṇo”ti saṅkhepato vuttaṃ vaṇṇasampattiṃ visayavasena vitthārato dassetuṃ “sabbā obhāsate disā”ti vatvā “uḷāro te yaso”ti vuttaṃ parivārasampattiṃ vatthuvasena vitthārato dassetuṃ “nāriyo naccantī”tiādi vuttaṃ.","Tattha <b>sabbā obhāsate disā</b>ti sabbāsu disāsu vijjotate, sabbā vā disā obhāsayate, vijjotayatīti attho.","“Obhāsate”ti padassa “obhāsante”ti keci vacanavipallāsena atthaṃ vadanti, tehi “vaṇṇenā”ti vibhatti vipariṇāmetabbā.","Vaṇṇenāti ca hetumhi karaṇavacanaṃ, vaṇṇena hetubhūtenāti attho.","“Sabbā disā”ti ca jātivasena disāsāmaññe apekkhite vacanavipallāsenapi payojanaṃ natthi.","<b>Nāriyo</b>ti etthāpi “alaṅkatā”ti padaṃ ānetvā sambandhitabbaṃ.","<b>Devaputtā</b>ti ettha ca-saddo luttaniddiṭṭho.","Tena nāriyo devaputtā cāti samuccayo veditabbo. 287."],"lineRefs":[["vv29:1"],["vv29:1"],["vv29:1"],["vv29:1"],["vv29:1"],["vv29:1"],["vv29:1"],["vv29:1"],["vv29:1"],["vv29:1"],["vv29:1"]]},{"para":1159,"vripara":"287","refs":["vv29:2"],"lines":["<b>Modentī</b>ti pamodayanti.","<b>Pūjāyā</b>ti pūjanatthaṃ pūjānimittaṃ vā, naccanti gāyantīti yojanā.","<b>Tavimānī</b>ti tava imāni. 288."],"lineRefs":[["vv29:2"],["vv29:2"],["vv29:2"]]},{"para":1160,"vripara":"288","refs":["vv29:3"],"lines":["<b>Sabbakāmasamiddhinī</b>ti sabbehi pañcahi kāmaguṇehi, sabbehi vā tayā kāmitehi icchitehi vatthūhi samiddhā.","<b>Abhijātā</b>ti sujātā.","<b>Mahantāsī</b>ti mahatī mahānubhāvā asi.","<b>Devakāye pamodasī</b>ti imasmiṃ devanikāye dibbasampattihetukena paramena pamodanena pamodasi."],"lineRefs":[["vv29:3"],["vv29:3"],["vv29:3"],["vv29:3"]]},{"para":1161,"vripara":null,"refs":["vv29:3"],"lines":["Evaṃ therena pucchitā sā devatā tamatthaṃ vissajjesi – 289."],"lineRefs":[["vv29:3"]]},{"para":1163,"vripara":"289","refs":["vv29:3"],"lines":["“Ahaṃ manussesu manussabhūtā, purimāya jātiyā manussaloke;"],"lineRefs":[["vv29:3"]]},{"para":1164,"vripara":null,"refs":["vv29:3"],"lines":["Dussīlakule suṇisā ahosiṃ, assaddhesu kadariyesu ahaṃ. 290."],"lineRefs":[["vv29:3"]]},{"para":1166,"vripara":"290","refs":["vv29:3"],"lines":["“Saddhā sīlena sampannā, saṃvibhāgaratā sadā;"],"lineRefs":[["vv29:3"]]},{"para":1167,"vripara":null,"refs":["vv29:3"],"lines":["Piṇḍāya caramānassa, apūvaṃ te adāsahaṃ. 291."],"lineRefs":[["vv29:3"]]},{"para":1169,"vripara":"291","refs":["vv29:3"],"lines":["“Tadāhaṃ sassuyācikkhiṃ, ‘samaṇo āgato idha;"],"lineRefs":[["vv29:3"]]},{"para":1170,"vripara":null,"refs":["vv29:3"],"lines":["Tassa adāsahaṃ pūvaṃ, pasannā sehi pāṇibhi’. 292."],"lineRefs":[["vv29:3"]]},{"para":1172,"vripara":"292","refs":["vv29:3"],"lines":["“Itissā sassu paribhāsi, avinītāsi tvaṃ vadhu;"],"lineRefs":[["vv29:3"]]},{"para":1173,"vripara":null,"refs":["vv29:3"],"lines":["Na maṃ sampucchituṃ icchi, ‘samaṇassa dadāmahaṃ’. 293."],"lineRefs":[["vv29:3"]]},{"para":1175,"vripara":"293","refs":["vv29:3"],"lines":["“Tato me sassu kupitā, pahāsi musalena maṃ;"],"lineRefs":[["vv29:3"]]},{"para":1176,"vripara":null,"refs":["vv29:3"],"lines":["Kūṭaṅgacchi avadhi maṃ, nāsakkhiṃ jīvituṃ ciraṃ. 294."],"lineRefs":[["vv29:3"]]},{"para":1178,"vripara":"294","refs":["vv29:3"],"lines":["“Ahaṃ kāyassa bhedā, vippamuttā tato cutā;"],"lineRefs":[["vv29:3"]]},{"para":1179,"vripara":null,"refs":["vv29:3"],"lines":["Devānaṃ tāvatiṃsānaṃ, upapannā sahabyataṃ. 295."],"lineRefs":[["vv29:3"]]},{"para":1181,"vripara":"295","refs":["vv29:3"],"lines":["“Tena metādiso vaṇṇo…pe…"],"lineRefs":[["vv29:3"]]},{"para":1182,"vripara":null,"refs":["vv29:3"],"lines":["Vaṇṇo ca me sabbadisā pabhāsatī”ti. 289."],"lineRefs":[["vv29:3"]]},{"para":1183,"vripara":"289","refs":["vv29:4"],"lines":["Tattha <b>assaddhesū</b>ti ratanattayasaddhāya kammaphalasaddhāya ca abhāvena assaddhesu, thaddhamacchariyatāya <b>kadariyesu</b> sassuādīsu ahaṃ saddhā sīlena sampannā ahosinti yojanā. 290-1."],"lineRefs":[["vv29:4"]]},{"para":1184,"vripara":"290-291","refs":["vv29:5"],"lines":["<b>Apūva</b>nti kapallapūvaṃ.","<b>Te</b>ti nipātamattaṃ.","<b>Sassuyā ācikkhiṃ</b> gahitabhāvañāpanatthañca anumodanatthañcāti adhippāyo. 292."],"lineRefs":[["vv29:5"],["vv29:5"],["vv29:5"]]},{"para":1185,"vripara":"292","refs":["vv29:7"],"lines":["<b>Itissā</b>ti ettha <b>assā</b>ti nipātamattaṃ.","<b>Samaṇassa dadāmaha</b>nti ahaṃ samaṇassa apūvaṃ dadāmīti.","Yasmā na maṃ sampucchituṃ icchi, tasmā tvaṃ vadhu avinītāsīti sassu paribhāsīti yojanā. 293."],"lineRefs":[["vv29:7"],["vv29:7"],["vv29:7"]]},{"para":1186,"vripara":"293","refs":["vv29:8"],"lines":["<b>Pahāsī</b>ti pahari.","<b>Kūṭaṅgacchi avadhi ma</b>nti ettha <b>kūṭa</b>nti aṃsakūṭaṃ vuttaṃ purimapadalopena, kūṭameva aṅganti kūṭaṅgaṃ, taṃ chindatīti kūṭaṅgacchi.","Evaṃ kodhābhibhūtā hutvā maṃ avadhi, mama aṃsakūṭaṃ chindi, teneva upakkamena matattā maṃ māresīti attho.","Tenāha <b>“nāsakkhiṃ jīvituṃ cira”</b>nti. 294."],"lineRefs":[["vv29:8"],["vv29:8"],["vv29:8"],["vv29:8"]]},{"para":1187,"vripara":"294","refs":["vv29:9"],"lines":["<b>Vippamuttā</b>ti tato dukkhato suṭṭhu muttā.","Sesaṃ vuttanayameva."],"lineRefs":[["vv29:9"],["vv29:9"]]}],"wordLinks":[["vv29:1.1","yaso",0,0],["vv29:1.1","vaṇṇo",0,1],["vv29:1.1","sabbā obhāsate disā",0,4],["vv29:1.3","nāriyo",0,8],["vv29:1.3","devaputtā",0,9],["vv29:2.1","modentī",1,0],["vv29:2.1","pūjāyā",1,1],["vv29:2.3","tavimānī",1,2],["vv29:3.1","sabbakāmasamiddhinī",2,0],["vv29:3.3","abhijātā",2,1],["vv29:3.3","mahantāsī",2,2],["vv29:3.3","devakāye pamodasī",2,3],["vv29:4.3","assaddhesū",18,0],["vv29:4.3","kadariyesu",18,0],["vv29:5.3","apūvaṃ",19,0],["vv29:5.3","te",19,1],["vv29:7.1","assā",20,0],["vv29:7.1","itissā",20,0],["vv29:7.3","assā",20,0],["vv29:7.3","samaṇassa dadāmahaṃ",20,1],["vv29:8.1","pahāsī",21,0],["vv29:8.3","kūṭaṃ",21,1],["vv29:8.3","kūṭaṅgacchi avadhi maṃ",21,1],["vv29:8.3","nāsakkhiṃ jīvituṃ ciraṃ",21,3],["vv29:9.1","vippamuttā",22,0]],"after":[{"para":1188,"vripara":null,"title":"Uḷāravimānavaṇṇanā","lines":["Uḷāravimānavaṇṇanā niṭṭhitā. 2."]}]},"tika":null,"tika2":null}
