{"suttaId":"an4.142","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1196,1196],"vripara":"142"},"segments":{"an4.142:0.3":"Pabhāsuttaṃ","an4.142:1.1":"“Catasso imā, bhikkhave, pabhā.","an4.142:1.2":"Katamā catasso?","an4.142:1.3":"Candappabhā, sūriyappabhā, aggippabhā, paññāpabhā – imā kho, bhikkhave, catasso pabhā.","an4.142:1.5":"Etadaggaṃ, bhikkhave, imāsaṃ catunnaṃ pabhānaṃ yadidaṃ paññāpabhā”ti.","an4.142:1.6":"Dutiyaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1450,"to":1450,"paras":[{"para":1450,"vripara":"142-145","refs":["an4.142:1"],"words":["candappabhā"],"lines":["142-145. Dutiyādīsupi pabhāsanavasena candova <b>candappabhā</b>.","Ālokanavasena candova <b>candāloko</b>.","Obhāsanavasena candova <b>candobhāso</b>.","Pajjotanavasena candova <b>candapajjoto</b>ti.","Evaṃ sabbapadesupi attho veditabbo."],"lineRefs":[["an4.142:1"],["an4.142:1"],["an4.142:1"],["an4.142:1"],["an4.142:1"]]}]},"tika":null}
