{"suttaId":"an4.142","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1196,1196],"vripara":"142"},"segments":{"an4.142:0.3":"Pabhāsuttaṃ","an4.142:1.1":"“Catasso imā, bhikkhave, pabhā.","an4.142:1.2":"Katamā catasso?","an4.142:1.3":"Candappabhā, sūriyappabhā, aggippabhā, paññāpabhā –","an4.142:1.4":"imā kho, bhikkhave, catasso pabhā.","an4.142:1.5":"Etadaggaṃ, bhikkhave, imāsaṃ catunnaṃ pabhānaṃ yadidaṃ paññāpabhā”ti.","an4.142:1.6":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1450,"to":1450,"paras":[{"para":1450,"vripara":"142-145","refs":["an4.142:1"],"lines":["Dutiyādīsupi pabhāsanavasena candova <b>candappabhā</b>.","Ālokanavasena candova <b>candāloko</b>.","Obhāsanavasena candova <b>candobhāso</b>.","Pajjotanavasena candova <b>candapajjoto</b>ti.","Evaṃ sabbapadesupi attho veditabbo. 6."],"lineRefs":[["an4.142:1"],["an4.142:1"],["an4.142:1"],["an4.142:1"],["an4.142:1"]]}],"wordLinks":[["an4.142:1.3","candappabhā",0,0]],"before":[{"para":1449,"vripara":null,"title":"Pabhāsuttādivaṇṇanā","lines":["Pabhāsuttādivaṇṇanā 142-145."]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1637,"to":1639,"paras":[{"para":1637,"vripara":"141-146","refs":["an4.142:1"],"lines":["Pañcamassa paṭhamādīni uttānatthāneva."],"lineRefs":[["an4.142:1"]]},{"para":1638,"vripara":null,"refs":["an4.142:1"],"lines":["Ābhāsuttādivaṇṇanā niṭṭhitā. 7-10."],"lineRefs":[["an4.142:1"]]},{"para":1639,"vripara":null,"refs":["an4.142:1"],"lines":["Dutiyakālasuttādivaṇṇanā 147-150."],"lineRefs":[["an4.142:1"]]}],"wordLinks":[]},"tika2":null}
