{"suttaId":"thag1.120","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[690,702],"vripara":"120"},"segments":{"thag1.120:0.4":"Isidattattheragāthā","thag1.120:1.1":"“Pañcakkhandhā pariññātā, tiṭṭhanti chinnamūlakā;","thag1.120:1.3":"Dukkhakkhayo anuppatto, patto me āsavakkhayo”ti.","thag1.120:1.5":"… Isidatto thero ….","thag1.120:1.6":"Vaggo dvādasamo niṭṭhito.","thag1.120:2.0":"Tassuddānaṃ –","thag1.120:2.1":"Jento ca vacchagotto ca, vaccho ca vanasavhayo;","thag1.120:2.3":"Adhimutto mahānāmo, pārāpariyo yasopi ca;","thag1.120:2.5":"Kimilo vajjiputto ca, isidatto mahāyasoti.","thag1.120:2.7":"Ekakanipāto niṭṭhito.","thag1.120:3.0":"Tatruddānaṃ –","thag1.120:3.1":"Vīsuttarasataṃ therā, katakiccā anāsavā;","thag1.120:3.3":"Ekakeva nipātamhi, susaṅgītā mahesibhīti."},"attha":null,"tika":null}
