{"suttaId":"an5.129","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[875,875],"vripara":"129"},"segments":{"an5.129:0.3":"Parikuppasuttaṃ","an5.129:1.1":"“Pañcime, bhikkhave, āpāyikā nerayikā parikuppā atekicchā.","an5.129:1.2":"Katame pañca?","an5.129:1.3":"Mātā [mātaraṃ (ka.)] jīvitā voropitā hoti, pitā [pitaraṃ (ka.)] jīvitā voropito [voropitā (ka.)] hoti, arahaṃ [arahantaṃ (ka.), arahā (syā.)] jīvitā voropito hoti, tathāgatassa duṭṭhena cittena lohitaṃ uppāditaṃ hoti, saṅgho bhinno hoti.","an5.129:1.4":"Ime kho, bhikkhave, pañca āpāyikā nerayikā parikuppā atekicchā”ti.","an5.129:1.5":"Navamaṃ."},"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":264,"to":264,"paras":[{"para":264,"vripara":"129","refs":["an5.129:1"],"words":["āpāyikā","nerayikā","parikuppā","atekicchā"],"lines":["Navame <b>āpāyikā</b>ti apāyagāmino.","<b>Nerayikā</b>ti nirayagāmino.","<b>Parikuppā</b>ti parikuppanasabhāvā purāṇavaṇasadisā.","<b>Atekicchā</b>ti akattabbaparikammā.","Dasamaṃ uttānatthamevāti."],"lineRefs":[["an5.129:1"],["an5.129:1"],["an5.129:1"],["an5.129:1"],["an5.129:1"]]}]},"tika":null}
