{"suttaId":"an5.129","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[875,875],"vripara":"129"},"segments":{"an5.129:0.3":"Parikuppasuttaṃ","an5.129:1.1":"“Pañcime, bhikkhave, āpāyikā nerayikā parikuppā atekicchā.","an5.129:1.2":"Katame pañca?","an5.129:1.3":"Mātā [mātaraṃ (ka.)] jīvitā voropitā hoti, pitā [pitaraṃ (ka.)] jīvitā voropito [voropitā (ka.)] hoti, arahaṃ [arahantaṃ (ka.), arahā (syā.)] jīvitā voropito hoti, tathāgatassa duṭṭhena cittena lohitaṃ uppāditaṃ hoti, saṅgho bhinno hoti.","an5.129:1.4":"Ime kho, bhikkhave, pañca āpāyikā nerayikā parikuppā atekicchā”ti.","an5.129:1.5":"Navamaṃ."},"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":264,"to":264,"paras":[{"para":264,"vripara":"129","refs":["an5.129:1"],"lines":["Navame <b>āpāyikā</b>ti apāyagāmino.","<b>Nerayikā</b>ti nirayagāmino.","<b>Parikuppā</b>ti parikuppanasabhāvā purāṇavaṇasadisā.","<b>Atekicchā</b>ti akattabbaparikammā.","Dasamaṃ uttānatthamevāti."],"lineRefs":[["an5.129:1"],["an5.129:1"],["an5.129:1"],["an5.129:1"],["an5.129:1"]]}],"wordLinks":[["an5.129:1.1","āpāyikā",0,0],["an5.129:1.4","āpāyikā",0,0],["an5.129:1.1","nerayikā",0,1],["an5.129:1.4","nerayikā",0,1],["an5.129:1.1","parikuppā",0,2],["an5.129:1.4","parikuppā",0,2],["an5.129:1.1","atekicchā",0,3],["an5.129:1.4","atekicchā",0,3]]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":248,"to":250,"paras":[{"para":248,"vripara":"124-130","refs":["an5.129:1"],"lines":["124-130. Tatiyo vaggo uttānatthoyeva."],"lineRefs":[["an5.129:1"]]},{"para":249,"vripara":null,"refs":[],"lines":["(14)4. Rājavaggo"],"lineRefs":[[]]},{"para":250,"vripara":null,"refs":["an5.129:1"],"lines":["Paṭhamacakkānuvattanasuttavaṇṇanā"],"lineRefs":[["an5.129:1"]]}],"wordLinks":[]},"tika2":null}
