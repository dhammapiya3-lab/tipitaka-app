{"suttaId":"thag1.57","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[334,337],"vripara":"57"},"segments":{"thag1.57:0.4":"Dutiyakuṭivihārittheragāthā","thag1.57:1.1":"“Ayamāhu purāṇiyā kuṭi,","thag1.57:1.2":"aññaṃ patthayase navaṃ kuṭiṃ;","thag1.57:1.3":"Āsaṃ kuṭiyā virājaya,","thag1.57:1.4":"dukkhā bhikkhu puna navā kuṭī”ti. …","thag1.57:1.5":"Dutiyakuṭivihāritthero…. 8."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":1460,"to":1482,"paras":[{"para":1460,"vripara":"57","refs":["thag1.57:1"],"lines":["Tattha <b>aya</b>nti āsannapaccakkhavacanaṃ.","<b>Āhū</b>ti ahosīti attho.","Gāthāsukhatthañhi dīghaṃ katvā vuttaṃ.","<b>Purāṇiyā</b>ti purātanī addhagatā.","<b>Aññaṃ patthayase navaṃ kuṭi</b>nti imissā kuṭiyā purāṇabhāvena jiṇṇatāya ito aññaṃ idāni nibbattanīyatāya navaṃ kuṭiṃ patthayase patthesi āsīsasi.","Sabbena sabbaṃ pana <b>āsaṃ kuṭiyā virājaya</b> purāṇiyaṃ viya navāyampi kuṭiyaṃ āsaṃ taṇhaṃ apekkhaṃ virājehi, sabbaso tattha virattacitto hohi.","Kasmā?","Yasmā <b>dukkhā bhikkhu puna navā</b> nāma <b>kuṭi</b> bhikkhu puna idāni nibbattiyamānā dukkhāvahattā dukkhā, tasmā aññaṃ navaṃ dukkhaṃ anuppādento yathānibbattāyaṃ purāṇiyaṃyeva kuṭiyaṃ ṭhatvā attanā katabbaṃ karohīti.","Ayañhettha adhippāyo – tvaṃ, bhikkhu, “ayaṃ purāṇī tiṇakuṭikā jiṇṇā”ti aññaṃ navaṃ tiṇakuṭikaṃ kātuṃ icchasi, na samaṇadhammaṃ, evaṃ icchanto pana bhāvanāya ananuyuñjanena punabbhavābhinibbattiyā anativattanato āyatiṃ attabhāvakuṭimpi patthento kātuṃ icchantoyeva nāma hoti.","Sā pana navā tiṇakuṭi viya karaṇadukkhena tato bhiyyopi jarāmaraṇasokaparidevādidukkhasaṃsaṭṭhatāya dukkhā, tasmā tiṇakuṭiyaṃ viya attabhāvakuṭiyaṃ āsaṃ apekkhaṃ virājaya sabbaso tattha virattacitto hohi, evaṃ te vaṭṭadukkhaṃ na bhavissatīti.","Devatāya ca vacanaṃ sutvā thero saṃvegajāto vipassanaṃ paṭṭhapetvā ghaṭento vāyamanto nacirasseva arahatte patiṭṭhāsi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.11.36-46) –"],"lineRefs":[["thag1.57:1"],["thag1.57:1"],["thag1.57:1"],["thag1.57:1"],["thag1.57:1"],["thag1.57:1"],["thag1.57:1"],["thag1.57:1"],["thag1.57:1"],["thag1.57:1"],["thag1.57:1"],["thag1.57:1"]]},{"para":1461,"vripara":null,"refs":["thag1.57:1"],"lines":["“Padumuttarabuddhassa, lokajeṭṭhassa tādino;"],"lineRefs":[["thag1.57:1"]]},{"para":1462,"vripara":null,"refs":["thag1.57:1"],"lines":["Tiṇatthare nisinnassa, upasantassa tādino."],"lineRefs":[["thag1.57:1"]]},{"para":1463,"vripara":null,"refs":["thag1.57:1"],"lines":["“Naḷamālaṃ gahetvāna, bandhitvā bījaniṃ ahaṃ;"],"lineRefs":[["thag1.57:1"]]},{"para":1464,"vripara":null,"refs":["thag1.57:1"],"lines":["Buddhassa upanāmesiṃ, dvipadindassa tādino."],"lineRefs":[["thag1.57:1"]]},{"para":1465,"vripara":null,"refs":["thag1.57:1"],"lines":["“Paṭiggahetvā sabbaññū, bījaniṃ lokanāyako;"],"lineRefs":[["thag1.57:1"]]},{"para":1466,"vripara":null,"refs":["thag1.57:1"],"lines":["Mama saṅkappamaññāya, imaṃ gāthaṃ abhāsatha."],"lineRefs":[["thag1.57:1"]]},{"para":1467,"vripara":null,"refs":["thag1.57:1"],"lines":["“Yathā me kāyo nibbāti, pariḷāho na vijjati;"],"lineRefs":[["thag1.57:1"]]},{"para":1468,"vripara":null,"refs":["thag1.57:1"],"lines":["Tatheva tividhaggīhi, cittaṃ tava vimuccatu."],"lineRefs":[["thag1.57:1"]]},{"para":1469,"vripara":null,"refs":["thag1.57:1"],"lines":["“Sabbe devā samāgacchuṃ, ye keci vananissitā;"],"lineRefs":[["thag1.57:1"]]},{"para":1470,"vripara":null,"refs":["thag1.57:1"],"lines":["Sossāma buddhavacanaṃ, hāsayantañca dāyakaṃ."],"lineRefs":[["thag1.57:1"]]},{"para":1471,"vripara":null,"refs":["thag1.57:1"],"lines":["“Nisinno bhagavā tattha, devasaṅghapurakkhato;"],"lineRefs":[["thag1.57:1"]]},{"para":1472,"vripara":null,"refs":["thag1.57:1"],"lines":["Dāyakaṃ sampahaṃsento, imā gāthā abhāsatha."],"lineRefs":[["thag1.57:1"]]},{"para":1473,"vripara":null,"refs":["thag1.57:1"],"lines":["“Iminā bījanidānena, cittassa paṇidhīhi ca;"],"lineRefs":[["thag1.57:1"]]},{"para":1474,"vripara":null,"refs":["thag1.57:1"],"lines":["Subbato nāma nāmena, cakkavattī bhavissati."],"lineRefs":[["thag1.57:1"]]},{"para":1475,"vripara":null,"refs":["thag1.57:1"],"lines":["“Tena kammāvasesena, sukkamūlena codito;"],"lineRefs":[["thag1.57:1"]]},{"para":1476,"vripara":null,"refs":["thag1.57:1"],"lines":["Māluto nāma nāmena, cakkavattī bhavissati."],"lineRefs":[["thag1.57:1"]]},{"para":1477,"vripara":null,"refs":["thag1.57:1"],"lines":["“Iminā bījanidānena, sammānavipulena ca;"],"lineRefs":[["thag1.57:1"]]},{"para":1478,"vripara":null,"refs":["thag1.57:1"],"lines":["Kappasatasahassampi, duggatiṃ nupapajjati."],"lineRefs":[["thag1.57:1"]]},{"para":1479,"vripara":null,"refs":["thag1.57:1"],"lines":["“Tiṃsakappasahassamhi, subbatā aṭṭhatiṃsa te;"],"lineRefs":[["thag1.57:1"]]},{"para":1480,"vripara":null,"refs":["thag1.57:1"],"lines":["Ekūnatiṃsasahasse, aṭṭha mālutanāmakā."],"lineRefs":[["thag1.57:1"]]},{"para":1481,"vripara":null,"refs":["thag1.57:1"],"lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti."],"lineRefs":[["thag1.57:1"]]},{"para":1482,"vripara":null,"refs":["thag1.57:1"],"lines":["Arahatte pana patiṭṭhito “ayaṃ me arahattappattiyā aṅkusabhūtā”ti tameva gāthaṃ paccudāhāsi.","Sāyeva ca therassa aññābyākaraṇagāthā ahosi.","Kuṭiovādena laddhavisesattā cassa <b>kuṭivihārī</b>tveva samaññā ahosīti."],"lineRefs":[["thag1.57:1"],["thag1.57:1"],["thag1.57:1"]]}],"wordLinks":[["thag1.57:1.1","ayaṃ",0,0],["thag1.57:1.3","ayaṃ",0,0],["thag1.57:1.1","āhū",0,1],["thag1.57:1.1","purāṇiyā",0,3],["thag1.57:1.1","aññaṃ patthayase navaṃ kuṭiṃ",0,4],["thag1.57:1.3","āsaṃ kuṭiyā virājaya",0,5],["thag1.57:1.1","kuṭi",0,7],["thag1.57:1.3","dukkhā bhikkhu puna navā",0,7],["thag1.57:1.3","kuṭi",0,7],["thag1.57:1.5","kuṭi",0,7],["thag1.57:1.5","kuṭivihārī",22,2]],"before":[{"para":1458,"vripara":null,"title":"Dutiyakuṭivihārittheragāthāvaṇṇanā","lines":["Dutiyakuṭivihārittheragāthāvaṇṇanā"]},{"para":1459,"vripara":null,"title":"Dutiyakuṭivihārittheragāthāvaṇṇanā","lines":["<b>Ayamāhu</b> <b>purāṇiyā</b>ti āyasmato kuṭivihārittherassa gāthā.","Kā uppatti?","So kira padumuttarassa bhagavato pasannamānaso pariḷāhakāle naḷavilīvehi viracitaṃ bījaniṃ adāsi.","Taṃ satthā anumodanagāthāya sampahaṃsesi.","Sesaṃ yadettha vattabbaṃ, taṃ añjanavaniyattheravatthumhi vuttasadisameva.","Ayaṃ pana viseso – ayaṃ kira vuttanayena pabbajitvā aññatarāya purāṇakuṭikāya viharanto samaṇadhammaṃ acintetvā, “ayaṃ kuṭikā jiṇṇā, aññaṃ kuṭikaṃ kātuṃ vaṭṭatī”ti navakammavasena cittaṃ uppādesi.","Tassa atthakāmā devatā saṃvegajananatthaṃ imaṃ uttānobhāsaṃ gambhīratthaṃ <b>“ayamāhu”</b>ti gāthamāha. 57."]}],"after":[{"para":1483,"vripara":null,"title":"Dutiyakuṭivihārittheragāthāvaṇṇanā","lines":["Dutiyakuṭivihārittheragāthāvaṇṇanā niṭṭhitā. 8."]}]},"tika":null,"tika2":null}
