{"suttaId":"ja263","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1884,1893],"vripara":"37"},"segments":{"ja263:0.4":"Cūḷapalobhanajātakaṃ (3-2-3)","ja263:1.1":"Abhijjamāne vārismiṃ, sayaṃ [ayaṃ (ka.)] āgamma iddhiyā;","ja263:1.3":"Missībhāvitthiyā gantvā, saṃsīdasi [saṃsīdati (ka.)] mahaṇṇave.","ja263:2.1":"Āvaṭṭanī mahāmāyā, brahmacariyavikopanā;","ja263:2.3":"Sīdanti naṃ viditvāna, ārakā parivajjaye.","ja263:3.1":"Yaṃ etā upasevanti, chandasā vā dhanena vā;","ja263:3.3":"Jātavedova saṃ ṭhānaṃ, khippaṃ anudahanti nanti.","ja263:4.1":"Cūḷapalobhana [cullapalobhana (sī. syā. pī.)] jātakaṃ tatiyaṃ."},"attha":null,"tika":null}
