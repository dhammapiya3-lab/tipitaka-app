{"suttaId":"sn35.137","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[898,898],"vripara":"137"},"segments":{"sn35.137:0.3":"Dutiyarūpārāmasuttaṃ","sn35.137:1.1":"“Rūpārāmā, bhikkhave, devamanussā rūparatā rūpasammuditā.","sn35.137:1.2":"Rūpavipariṇāmavirāganirodhā dukkhā, bhikkhave, devamanussā viharanti.","sn35.137:1.3":"Saddārāmā …","sn35.137:1.4":"gandhārāmā …","sn35.137:1.5":"rasārāmā …","sn35.137:1.6":"phoṭṭhabbārāmā …","sn35.137:1.7":"dhammārāmā, bhikkhave, devamanussā dhammaratā dhammasammuditā.","sn35.137:1.8":"Dhammavipariṇāmavirāganirodhā dukkhā, bhikkhave, devamanussā viharanti.","sn35.137:1.9":"Tathāgato ca, bhikkhave, arahaṃ sammāsambuddho rūpānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na rūpārāmo na rūparato na rūpasammudito.","sn35.137:1.10":"Rūpavipariṇāmavirāganirodhā sukho, bhikkhave, tathāgato viharati.","sn35.137:1.11":"Saddānaṃ …","sn35.137:1.12":"gandhānaṃ …","sn35.137:1.13":"rasānaṃ …","sn35.137:1.14":"phoṭṭhabbānaṃ …","sn35.137:1.15":"dhammānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na dhammārāmo na dhammarato na dhammasammudito.","sn35.137:1.16":"Dhammavipariṇāmavirāganirodhā sukho, bhikkhave, tathāgato viharatī”ti.","sn35.137:1.17":"Catutthaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":263,"to":266,"paras":[{"para":263,"vripara":"137-145","refs":["sn35.137:1"],"lines":["137-145. Catutthaṃ suddhikaṃ katvā desiyamāne bujjhanakānaṃ ajjhāsayena vuttaṃ.","Pañcamādīni tathā tathā bujjhantānaṃ ajjhāsayena vuttāni.","Attho pana tesaṃ pākaṭoyevāti."],"lineRefs":[["sn35.137:1"],["sn35.137:1"],["sn35.137:1"]]},{"para":264,"vripara":null,"refs":["sn35.137:1"],"lines":["Devadahavaggo cuddasamo."],"lineRefs":[["sn35.137:1"]]},{"para":265,"vripara":null,"refs":["sn35.137:1"],"lines":["Navapurāṇavaggo"],"lineRefs":[["sn35.137:1"]]},{"para":266,"vripara":null,"refs":["sn35.137:1"],"lines":["Kammanirodhasuttavaṇṇanā"],"lineRefs":[["sn35.137:1"]]}],"wordLinks":[],"before":[{"para":262,"vripara":null,"title":"Dutiyarūpārāmasuttādivaṇṇanā","lines":["4-12. Dutiyarūpārāmasuttādivaṇṇanā"]}]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":273,"to":277,"paras":[{"para":273,"vripara":"137-145","refs":["sn35.137:1"],"lines":["137-145. <b>Suddhikaṃ katvā</b> gāthābandhanena vinā kevalaṃ cuṇṇiyapadavaseneva.","<b>Tathā tathā</b>ti ajjhattikāni bāhirāni ca āyatanāni aniccalakkhaṇena dukkhānattalakkhaṇehi ca yojetvā dassanavasena."],"lineRefs":[["sn35.137:1"],["sn35.137:1"]]},{"para":274,"vripara":null,"refs":["sn35.137:1"],"lines":["Dutiyarūpārāmasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.137:1"]]},{"para":275,"vripara":null,"refs":["sn35.137:1"],"lines":["Devadahavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.137:1"]]},{"para":276,"vripara":null,"refs":["sn35.137:1"],"lines":["Navapurāṇavaggo"],"lineRefs":[["sn35.137:1"]]},{"para":277,"vripara":null,"refs":["sn35.137:1"],"lines":["Kammanirodhasuttavaṇṇanā"],"lineRefs":[["sn35.137:1"]]}],"wordLinks":[],"before":[{"para":272,"vripara":null,"title":"Dutiyarūpārāmasuttādivaṇṇanā","lines":["4-12. Dutiyarūpārāmasuttādivaṇṇanā"]}]},"tika2":null}
