{"suttaId":"thig1.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[21,24],"vripara":"4"},"segments":{"thig1.4:0.3":"Tissātherīgāthā","thig1.4:1.1":"“Tisse sikkhassu sikkhāya, mā taṃ yogā upaccaguṃ;","thig1.4:1.3":"Sabbayogavisaṃyuttā, cara loke anāsavā”ti.","thig1.4:2.1":"… Tissā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":80,"to":80,"paras":[{"para":80,"vripara":null,"refs":["thig1.4:1"],"lines":["Tattha <b>tisse</b>ti tassā ālapanaṃ.","<b>Sikkhassu sikkhāyā</b>ti adhisīlasikkhādikāya tividhāya sikkhāya sikkha, maggasampayuttā tisso sikkhāyo sampādehīti attho.","Idāni tāsaṃ sampādane kāraṇamāha <b>“mā taṃ yogā upaccagun”</b>ti manussattaṃ, indriyāvekallaṃ, buddhuppādo, saddhāpaṭilābhoti ime yogā samayā dullabhakkhaṇā taṃ mā atikkamuṃ.","Kāmayogādayo eva vā cattāro <b>yogā</b> taṃ <b>mā upaccaguṃ</b> mā abhibhaveyyuṃ.","<b>Sabbayogavisaṃyuttā</b>ti sabbehi kāmayogādīhi yogehi vimuttā tato eva anāsavā hutvā loke cara, diṭṭhasukhavihārena viharāhīti attho."],"lineRefs":[["thig1.4:1"],["thig1.4:1"],["thig1.4:1"],["thig1.4:1"],["thig1.4:1"]]}],"wordLinks":[["thig1.4:1.1","tisse",0,0],["thig1.4:1.1","sikkhassu sikkhāyā",0,1],["thig1.4:1.1","mā taṃ yogā upaccaguṃ",0,2],["thig1.4:1.1","yogā",0,3],["thig1.4:1.3","yogā",0,3],["thig1.4:1.3","sabbayogavisaṃyuttā",0,4]],"before":[{"para":58,"vripara":null,"refs":[],"lines":["Sā taṃ gāthaṃ sutvā vipassanaṃ vaḍḍhetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.1.37-45)–"],"lineRefs":[[],[]]},{"para":59,"vripara":null,"refs":[],"lines":["“Candabhāgānadītīre, ahosiṃ kinnarī tadā;"],"lineRefs":[[]]},{"para":60,"vripara":null,"refs":[],"lines":["Addasaṃ virajaṃ buddhaṃ, sayambhuṃ aparājitaṃ."],"lineRefs":[[]]},{"para":61,"vripara":null,"refs":[],"lines":["“Pasannacittā sumanā, vedajātā katañjalī;"],"lineRefs":[[]]},{"para":62,"vripara":null,"refs":[],"lines":["Naḷamālaṃ gahetvāna, sayambhuṃ abhipūjayiṃ."],"lineRefs":[[]]},{"para":63,"vripara":null,"refs":[],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":64,"vripara":null,"refs":[],"lines":["Jahitvā kinnarīdehaṃ, agacchiṃ tidasaṃ gatiṃ."],"lineRefs":[[]]},{"para":65,"vripara":null,"refs":[],"lines":["“Chattiṃsadevarājūnaṃ, mahesittamakārayiṃ;"],"lineRefs":[[]]},{"para":66,"vripara":null,"refs":[],"lines":["Dasannaṃ cakkavattīnaṃ, mahesittamakārayiṃ;"],"lineRefs":[[]]},{"para":67,"vripara":null,"refs":[],"lines":["Saṃvejetvāna me cittaṃ, pabbajiṃ anagāriyaṃ."],"lineRefs":[[]]},{"para":68,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ, bhavā sabbe samūhatā;"],"lineRefs":[[]]},{"para":69,"vripara":null,"refs":[],"lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."],"lineRefs":[[]]},{"para":70,"vripara":null,"refs":[],"lines":["“Catunnavutito kappe, yaṃ pupphamabhipūjayiṃ;"],"lineRefs":[[]]},{"para":71,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, pupphapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":72,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":73,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā sā therī tameva gāthaṃ udānesi.","Ayameva cassā aññābyākaraṇagāthā ahosīti."],"lineRefs":[[],[]]},{"para":74,"vripara":null,"refs":[],"lines":["Puṇṇātherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":75,"vripara":null,"refs":[],"lines":["Tissātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":76,"vripara":null,"refs":[],"lines":["<b>Tisse sikkhassu sikkhāyā</b>ti tissāya sikkhamānāya gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinitvā sambhatakusalapaccayā imasmiṃ buddhuppāde kapilavatthusmiṃ sakyarājakule nibbattitvā vayappattā bodhisattassa orodhabhūtā pacchā mahāpajāpatigotamiyā saddhiṃ nikkhamitvā pabbajitvā vipassanāya kammaṃ karoti.","Tassā satthā heṭṭhā vuttanayeneva obhāsaṃ vissajjetvā –"],"lineRefs":[[],[],[]]},{"para":78,"vripara":"4","refs":[],"lines":["“Tisse sikkhassu sikkhāya, mā taṃ yogā upaccaguṃ;"],"lineRefs":[[]]},{"para":79,"vripara":null,"refs":[],"lines":["Sabbayogavisaṃyuttā, cara loke anāsavā”ti.","– gāthaṃ abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
