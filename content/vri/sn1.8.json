{"suttaId":"sn1.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[56,60],"vripara":"8"},"segments":{"sn1.8:0.3":"Susammuṭṭhasuttaṃ","sn1.8:1.1":"Sāvatthinidānaṃ.","sn1.8:1.2":"Ekamantaṃ ṭhitā kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi –","sn1.8:2.1":"“Yesaṃ dhammā susammuṭṭhā,","sn1.8:2.2":"paravādesu nīyare;","sn1.8:2.3":"Suttā te nappabujjhanti,","sn1.8:2.4":"kālo tesaṃ pabujjhitu”nti.","sn1.8:3.1":"“Yesaṃ dhammā asammuṭṭhā,","sn1.8:3.2":"paravādesu na nīyare;","sn1.8:3.3":"Te sambuddhā sammadaññā,","sn1.8:3.4":"caranti visame sama”nti. 9."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":150,"to":150,"paras":[{"para":150,"vripara":"8","refs":["sn1.8:2","sn1.8:3"],"lines":["Aṭṭhame <b>susammuṭṭhā</b>ti paññāya appaṭividdhabhāveneva sunaṭṭhā.","Yathā hi dve khettāni kasitvā, ekaṃ vapitvā, bahudhaññaṃ adhigatassa avāpitakhettato aladdhaṃ sandhāya “bahuṃ me dhaññaṃ naṭṭha”nti vadanto aladdhameva “naṭṭha”nti vadati, evamidhāpi appaṭividitāva susammuṭṭhā nāma.","<b>Asammuṭṭhā</b>ti paññāya paṭividdhabhāveneva anaṭṭhā.","Sesaṃ purimasadisamevāti."],"lineRefs":[["sn1.8:2"],["sn1.8:2"],["sn1.8:3"],["sn1.8:3"]]}],"wordLinks":[["sn1.8:2.1","susammuṭṭhā",0,0],["sn1.8:3.1","asammuṭṭhā",0,2]],"before":[{"para":149,"vripara":null,"title":"Susammuṭṭhasuttavaṇṇanā","lines":["Susammuṭṭhasuttavaṇṇanā 8."]}],"after":[{"para":151,"vripara":null,"title":"Susammuṭṭhasuttavaṇṇanā","lines":["Susammuṭṭhasuttavaṇṇanā niṭṭhitā. 9."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":257,"to":257,"paras":[{"para":257,"vripara":"8","refs":["sn1.8:2"],"lines":["<b>Susammuṭṭhā</b>ti suṭṭhu ativiya sammuṭṭhā.","Satta sekkhā hi susammusitā vinaṭṭhā.","Kathaṃ pana te anadhigatā naṭṭhā nāma hontīti āha <b>“yathā hī”</b>tiādi.","<b>Adhigatassā</b>ti adhigato assa.","So vadantoti sambandho.","<b>Sesa</b>nti “dhammā”tiādi.","<b>Purimasadisamevā</b>ti anantaragāthāya vuttasadisameva."],"lineRefs":[["sn1.8:2"],["sn1.8:2"],["sn1.8:2"],["sn1.8:2"],["sn1.8:2"],["sn1.8:2"],["sn1.8:2"]]}],"wordLinks":[["sn1.8:2.1","susammuṭṭhā",0,0]]},"tika2":null}
