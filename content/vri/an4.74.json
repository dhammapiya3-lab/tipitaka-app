{"suttaId":"an4.74","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[835,835],"vripara":"74"},"segments":{"an4.74:0.3":"Paṭhamaaggasuttaṃ","an4.74:1.1":"“Cattārimāni, bhikkhave, aggāni.","an4.74:1.2":"Katamāni cattāri?","an4.74:1.3":"Sīlaggaṃ, samādhiggaṃ [samādhaggaṃ (sī. syā. kaṃ)], paññāggaṃ, vimuttaggaṃ –","an4.74:1.4":"imāni kho, bhikkhave, cattāri aggānī”ti.","an4.74:1.5":"Catutthaṃ."},"unsure":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1317,"to":1317,"paras":[{"para":1317,"vripara":"74-75","refs":["an4.74:1"],"lines":["74-75. Catutthe <b>sīlaggan</b>ti aggappattaṃ uttamasīlaṃ.","Eseva nayo sabbattha.","Pañcame <b>rūpaggan</b>ti yaṃ rūpaṃ sammasitvā arahattaṃ pāpuṇāti, idaṃ rūpaggaṃ nāma.","Sesesupi eseva nayo.","<b>Bhavaggan</b>ti ettha pana yasmiṃ attabhāve ṭhito arahattaṃ pāpuṇāti, etaṃ bhavaggaṃ nāmāti."],"lineRefs":[["an4.74:1"],["an4.74:1"],["an4.74:1"],["an4.74:1"],["an4.74:1"]]}],"wordLinks":[["an4.74:1.3","sīlaggaṃ",0,0]],"before":[{"para":1316,"vripara":null,"refs":[],"lines":["4-5. Aggasuttadvayavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1494,"to":1496,"paras":[{"para":1494,"vripara":"73-75","refs":["an4.74:1"],"lines":["73-75. Tatiye <b>pañhatthāya abhinīto</b>ti pañhakaraṇatthāya abhimukhaṃ nīto.","<b>Alambitaṃ katvā</b>ti alambaṃ katvā, ayameva vā pāṭho, vipalambaṃ akatvāti attho.","<b>Avajānātī</b>ti avaññaṃ karoti, nindatīti attho.","Catutthapañcame natthi vattabbaṃ."],"lineRefs":[["an4.74:1"],["an4.74:1"],["an4.74:1"],["an4.74:1"]]},{"para":1495,"vripara":null,"refs":["an4.74:1"],"lines":["Sappurisasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an4.74:1"]]},{"para":1496,"vripara":null,"refs":["an4.74:1"],"lines":["Kusinārasuttavaṇṇanā"],"lineRefs":[["an4.74:1"]]}],"wordLinks":[]},"tika2":null}
