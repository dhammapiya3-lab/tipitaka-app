{"suttaId":"sn48.20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1212,1216],"vripara":"490"},"segments":{"sn48.20:0.3":"Āsavakkhayasuttaṃ","sn48.20:1.1":"“Pañcimāni, bhikkhave, indriyāni.","sn48.20:1.2":"Katamāni pañca?","sn48.20:1.3":"Saddhindriyaṃ … pe … paññindriyaṃ – imāni kho, bhikkhave, pañcindriyāni.","sn48.20:1.5":"Imesaṃ kho, bhikkhave, pañcannaṃ indriyānaṃ bhāvitattā bahulīkatattā bhikkhu āsavānaṃ khayā anāsavaṃ cetovimuttiṃ paññāvimuttiṃ diṭṭheva dhamme sayaṃ abhiññā sacchikatvā upasampajja viharatī”ti.","sn48.20:1.6":"Dasamaṃ.","sn48.20:1.7":"Mudutaravaggo dutiyo.","sn48.20:2.0":"Tassuddānaṃ –","sn48.20:2.1":"Paṭilābho tayo saṃkhittā, vitthārā apare tayo;","sn48.20:2.3":"Paṭipanno ca sampanno [paṭipanno cūpasamo (syā. kaṃ. pī. ka.)], dasamaṃ āsavakkhayanti."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":556,"to":559,"paras":[{"para":556,"vripara":"489-490","refs":["sn48.20:1"],"lines":["489-490. Navame <b>indriyasampanno</b>ti paripuṇṇindriyo.","Dasamaṃ uttānameva.","Imasmiṃ suttadvaye missakāni indriyāni kathitānīti."],"lineRefs":[["sn48.20:1"],["sn48.20:1"],["sn48.20:1"]]},{"para":557,"vripara":null,"refs":[],"lines":["Mudutaravaggo dutiyo."],"lineRefs":[[]]},{"para":558,"vripara":null,"refs":[],"lines":["Chaḷindriyavaggo"],"lineRefs":[[]]},{"para":559,"vripara":null,"refs":["sn48.20:1"],"lines":["Jīvitindriyasuttavaṇṇanā"],"lineRefs":[["sn48.20:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":482,"to":485,"paras":[{"para":482,"vripara":"489-490","refs":["sn48.20:1"],"lines":["489-490. <b>Indriyasampanno</b>ti ettha <b>sampanna</b> saddo paripūriatthoti āha <b>“paripuṇṇindriyo”</b>ti.","<b>Missakāni indriyāni kathitāni</b> sāmaññatova desitattā."],"lineRefs":[["sn48.20:1"],["sn48.20:1"]]},{"para":483,"vripara":null,"refs":[],"lines":["Mudutaravaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":484,"vripara":null,"refs":[],"lines":["Chaḷindriyavaggo"],"lineRefs":[[]]},{"para":485,"vripara":null,"refs":["sn48.20:1"],"lines":["Jīvitindriyasuttavaṇṇanā"],"lineRefs":[["sn48.20:1"]]}],"wordLinks":[]}}
