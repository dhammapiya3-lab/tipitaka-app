{"suttaId":"tha-ap275","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8586,8598],"vripara":"10"},"segments":{"tha-ap275:0.3":"Caṅkoṭakiyattheraapadānaṃ","tha-ap275:1.1":"“Mahāsamuddaṃ nissāya,","tha-ap275:1.2":"vasatī pabbatantare;","tha-ap275:1.3":"Paccuggantvāna katvāna [paccuggantvāna’kāsahaṃ (aṭṭha.), paccuggamanaṃ katvāna (?)],","tha-ap275:1.4":"caṅkoṭaka [caṅgoṭaka (sī.)] madāsahaṃ. 11.","tha-ap275:2.1":"“Siddhatthassa mahesino,","tha-ap275:2.2":"sabbasattānukampino [sayambhussānukampino (syā.)];","tha-ap275:2.3":"Pupphacaṅkoṭakaṃ datvā,","tha-ap275:2.4":"kappaṃ saggamhi modahaṃ. 12.","tha-ap275:3.1":"“Catunnavutito kappe,","tha-ap275:3.2":"caṅkoṭakamadaṃ tadā;","tha-ap275:3.3":"Duggatiṃ nābhijānāmi,","tha-ap275:3.4":"caṅkoṭakassidaṃ phalaṃ. 13.","tha-ap275:4.1":"“Paṭisambhidā catasso…pe…","tha-ap275:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap275:5.1":"Itthaṃ sudaṃ āyasmā caṅkoṭakiyo thero imā gāthāyo abhāsitthāti.","tha-ap275:6.1":"Caṅkoṭakiyattherassāpadānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3233,"to":3233,"paras":[{"para":3233,"vripara":"10","refs":["tha-ap275:1"],"lines":["Tatiyāpadāne <b>mahāsamuddaṃ nissāyā</b>ti mahāsāgarāsanne ṭhitassa pabbatassa antare pabbataleṇeti attho.","Siddhattho bhagavā vivekakāmatāya <b>vasati</b> paṭivasatīti attho.","<b>Paccuggantvānakāsaha</b>nti ahaṃ tassa bhagavato paṭiuggantvā samīpaṃ gantvā vandanādipuññaṃ akāsinti attho.","<b>Caṅkoṭakamadāsaha</b>nti siddhatthassa bhagavato ahaṃ pupphabharitaṃ caṅkoṭakaṃ kadambaṃ adāsiṃ pūjesinti attho. 14."],"lineRefs":[["tha-ap275:1"],["tha-ap275:1"],["tha-ap275:1"],["tha-ap275:1"]]}],"wordLinks":[["tha-ap275:1.1","mahāsamuddaṃ nissāyā",0,0],["tha-ap275:1.1","vasati",0,1],["tha-ap275:1.3","caṅkoṭakamadāsahaṃ",0,3]],"after":[{"para":3234,"vripara":"14","title":"Suvaṇṇabibbohaniyattheraapadānādivaṇṇanā","lines":["Catutthāpadāne <b>akakkasacittassāthā</b>ti apharusacittassa, <b>atha</b>-saddo padapūraṇe. 19."]}]},"tika":null,"tika2":null}
