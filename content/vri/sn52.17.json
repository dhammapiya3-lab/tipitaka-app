{"suttaId":"sn52.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1826,1826],"vripara":"915"},"segments":{"sn52.17:0.3":"Sabbatthagāminisuttaṃ","sn52.17:1.1":"“Imesañca panāhaṃ, āvuso, catunnaṃ satipaṭṭhānānaṃ bhāvitattā bahulīkatattā sabbatthagāminippaṭipadaṃ yathābhūtaṃ pajānāmī”ti.","sn52.17:1.2":"Sattamaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":711,"to":713,"paras":[{"para":711,"vripara":"909-922","refs":["sn52.17:1"],"lines":["909-922. Dutiyavagge <b>ṭhānañca ṭhānato</b>tiādīhi thero dasabalañāṇaṃ paṭijānāti.","Kimpanetaṃ sāvakānaṃ hotīti?","Ekadesena hoti, sabbaññubuddhānaṃ panetaṃ nippadesaṃ sabbākāraparipūranti."],"lineRefs":[["sn52.17:1"],["sn52.17:1"],["sn52.17:1"]]},{"para":712,"vripara":null,"refs":[],"lines":["Anuruddhasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":713,"vripara":null,"refs":["sn52.17:1"],"lines":["Jhānasaṃyuttavaṇṇanā"],"lineRefs":[["sn52.17:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":615,"to":618,"paras":[{"para":615,"vripara":"909-922","refs":["sn52.17:1"],"lines":["909-922. <b>Dasabalañāṇan</b>ti dasavidhabalañāṇaṃ.","<b>Ekadesenā</b>ti padesavasena.","Sāvakānampi attano abhinīhārānurūpaṃ ñāṇaṃ pavattatīti te kālapadesavasena ceva yathāparicayasattapadesavasena ca ṭhānānīti jānanti, sammāsambuddhānaṃ pana anantañāṇatāya sabbattheva appaṭihatameva ñāṇanti āha –","<b>“sabbaññubuddhānaṃ panā”</b>tiādi.","<b>Etaṃ</b> dasabalañāṇaṃ anantavisayattā <b>nippadesaṃ</b> anūnatāya <b>sabbākāraparipūraṃ</b>."],"lineRefs":[["sn52.17:1"],["sn52.17:1"],["sn52.17:1"],["sn52.17:1"],["sn52.17:1"]]},{"para":616,"vripara":null,"refs":[],"lines":["Dutiyavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":617,"vripara":null,"refs":[],"lines":["Anuruddhasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":618,"vripara":null,"refs":["sn52.17:1"],"lines":["Jhānasaṃyuttavaṇṇanā"],"lineRefs":[["