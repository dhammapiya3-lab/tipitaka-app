{"suttaId":"sn46.46","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[610,610],"vripara":"227"},"segments":{"sn46.46:0.3":"Daliddasuttaṃ","sn46.46:1.1":"“‘Daliddo, daliddo’ti, bhante, vuccati.","sn46.46:1.2":"Kittāvatā nu kho, bhante,‘daliddo’ti vuccatī”ti?","sn46.46:1.3":"“Sattannaṃ kho, bhikkhu, bojjhaṅgānaṃ abhāvitattā abahulīkatattā ‘daliddo’ti vuccati.","sn46.46:1.4":"Katamesaṃ sattannaṃ?","sn46.46:1.5":"Satisambojjhaṅgassa … pe … upekkhāsambojjhaṅgassa –","sn46.46:1.6":"imesaṃ kho, bhikkhu, sattannaṃ bojjhaṅgānaṃ abhāvitattā abahulīkatattā ‘daliddo’ti vuccatī”ti.","sn46.46:1.7":"Chaṭṭhaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":221,"to":224,"paras":[{"para":221,"vripara":"225-231","refs":["sn46.46:1"],"lines":["225-231. Catutthe <b>eḷamūgo</b>ti mukhena vācaṃ nicchāretuṃ sakkontopi dosehi mūgo asampannavacano.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn46.46:1"],["sn46.46:1"]]},{"para":222,"vripara":null,"refs":["sn46.46:1"],"lines":["Cakkavattivaggo."],"lineRefs":[["sn46.46:1"]]},{"para":223,"vripara":null,"refs":["sn46.46:1"],"lines":["Sākacchavaggo"],"lineRefs":[["sn46.46:1"]]},{"para":224,"vripara":null,"refs":["sn46.46:1"],"lines":["Āhārasuttavaṇṇanā"],"lineRefs":[["sn46.46:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":220,"to":223,"paras":[{"para":220,"vripara":"225-231","refs":["sn46.46:1"],"lines":["225-231. Eḷaṃ vuccati doso, eḷena mūgo viyāti <b>eḷamūgo</b>ti imamatthaṃ dassento <b>“mukhena vācan”</b>tiādimāha."],"lineRefs":[["sn46.46:1"]]},{"para":221,"vripara":null,"refs":["sn46.46:1"],"lines":["Cakkavattivaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn46.46:1"]]},{"para":222,"vripara":null,"refs":["sn46.46:1"],"lines":["Sākacchavaggo"],"lineRefs":[["sn46.46:1"]]},{"para":223,"vripara":null,"refs":["sn46.46:1"],"lines":["Āhārasuttavaṇṇanā"],"lineRefs":[["sn46.46:1"]