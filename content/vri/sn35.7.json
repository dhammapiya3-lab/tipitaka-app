{"suttaId":"sn35.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[20,20],"vripara":"7"},"segments":{"sn35.7:0.3":"Ajjhattāniccātītānāgatasuttaṃ","sn35.7:1.1":"“Cakkhuṃ, bhikkhave, aniccaṃ atītānāgataṃ;","sn35.7:1.2":"ko pana vādo paccuppannassa!","sn35.7:1.3":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītasmiṃ cakkhusmiṃ anapekkho hoti;","sn35.7:1.4":"anāgataṃ cakkhuṃ nābhinandati;","sn35.7:1.5":"paccuppannassa cakkhussa nibbidāya virāgāya nirodhāya paṭipanno hoti.","sn35.7:1.6":"Sotaṃ aniccaṃ …","sn35.7:1.7":"ghānaṃ aniccaṃ …","sn35.7:1.8":"jivhā aniccā atītānāgatā;","sn35.7:1.9":"ko pana vādo paccuppannāya!","sn35.7:1.10":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītāya jivhāya anapekkho hoti;","sn35.7:1.11":"anāgataṃ jivhaṃ nābhinandati;","sn35.7:1.12":"paccuppannāya jivhāya nibbidāya virāgāya nirodhāya paṭipanno hoti.","sn35.7:1.13":"Kāyo anicco … pe …","sn35.7:1.14":"mano anicco atītānāgato;","sn35.7:1.15":"ko pana vādo paccuppannassa!","sn35.7:1.16":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītasmiṃ manasmiṃ anapekkho hoti;","sn35.7:1.17":"anāgataṃ manaṃ nābhinandati;","sn35.7:1.18":"paccuppannassa manassa nibbidāya virāgāya nirodhāya paṭipanno hotī”ti.","sn35.7:1.19":"Sattamaṃ."},"unsure":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":15,"to":18,"paras":[{"para":15,"vripara":"7-12","refs":["sn35.7:1"],"lines":["7-12. Sattamādīni atītānāgatesu cakkhādīsu aniccalakkhaṇādīni sallakkhetvā paccuppannesu balavagāhena kilamantānaṃ vasena vuttāni.","Sesaṃ sabbattha heṭṭhā vuttanayamevāti."],"lineRefs":[["sn35.7:1"],["sn35.7:1"]]},{"para":16,"vripara":null,"refs":["sn35.7:1"],"lines":["Aniccavaggo paṭhamo."],"lineRefs":[["sn35.7:1"]]},{"para":17,"vripara":null,"refs":["sn35.7:1"],"lines":["Yamakavaggo"],"lineRefs":[["sn35.7:1"]]},{"para":18,"vripara":null,"refs":["sn35.7:1"],"lines":["1-4. Paṭhamapubbesambodhasuttādivaṇṇanā"],"lineRefs":[["sn35.7:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":18,"to":22,"paras":[{"para":18,"vripara":"7-12","refs":["sn35.7:1"],"lines":["7-12. <b>Sallakkhetvā</b>ti atītānāgatānaṃ avijjamānattā gāhassa daḷhatāya sallakkhetvā.","<b>Paccuppannesu</b> vijjamānattā balavatā taṇhādigāhena vipassanāvīthiṃ paṭipādetuṃ <b>kilamantānaṃ</b> vineyyānaṃ <b>vasena</b>."],"lineRefs":[["sn35.7:1"],["sn35.7:1"]]},{"para":19,"vripara":null,"refs":["sn35.7:1"],"lines":["Ajjhattāniccātītānāgatasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.7:1"]]},{"para":20,"vripara":null,"refs":["sn35.7:1"],"lines":["Aniccavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.7:1"]]},{"para":21,"vripara":null,"refs":["sn35.7:1"],"lines":["Yamakavaggo"],"lineRefs":[["sn35.7:1"]]},{"para":22,"vripara":null,"refs":["sn35.7:1"],"lines":["1-4. Paṭhamapubbesambodhasuttādivaṇṇanā"],"lineRefs":[["sn35.7:1"]]}],"wordLinks":[]},"tika2":null}
