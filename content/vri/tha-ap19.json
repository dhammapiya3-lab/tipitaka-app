{"suttaId":"tha-ap19","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[2325,2361],"vripara":"86"},"segments":{"tha-ap19:0.3":"Upasenavaṅgantaputtattheraapadānaṃ","tha-ap19:1.1":"“Padumuttaraṃ bhagavantaṃ,","tha-ap19:1.2":"lokajeṭṭhaṃ narāsabhaṃ;","tha-ap19:1.3":"Pabbhāramhi nisīdantaṃ,","tha-ap19:1.4":"upagacchiṃ naruttamaṃ.","tha-ap19:2.1":"“Kaṇikārapupphaṃ [kaṇikāraṃ pupphitaṃ (sī. syā.)] disvā,","tha-ap19:2.2":"vaṇṭe chetvānahaṃ tadā;","tha-ap19:2.3":"Alaṅkaritvā chattamhi,","tha-ap19:2.4":"buddhassa abhiropayiṃ.","tha-ap19:3.1":"“Piṇḍapātañca pādāsiṃ,","tha-ap19:3.2":"paramannaṃ subhojanaṃ;","tha-ap19:3.3":"Buddhena navame tattha,","tha-ap19:3.4":"samaṇe aṭṭha bhojayiṃ.","tha-ap19:4.1":"“Anumodi mahāvīro,","tha-ap19:4.2":"sayambhū aggapuggalo;","tha-ap19:4.3":"Iminā chattadānena,","tha-ap19:4.4":"paramannapavecchanā.","tha-ap19:5.1":"“Tena cittappasādena,","tha-ap19:5.2":"sampattimanubhossasi;","tha-ap19:5.3":"Chattiṃsakkhattuṃ devindo,","tha-ap19:5.4":"devarajjaṃ karissati.","tha-ap19:6.1":"“Ekavīsatikkhattuñca,","tha-ap19:6.2":"cakkavattī bhavissati;","tha-ap19:6.3":"Padesarajjaṃ vipulaṃ,","tha-ap19:6.4":"gaṇanāto asaṅkhiyaṃ.","tha-ap19:7.1":"“Satasahassito kappe,","tha-ap19:7.2":"okkākakulasambhavo;","tha-ap19:7.3":"Gotamo nāma gottena,","tha-ap19:7.4":"satthā loke bhavissati [yaṃ vadanti sumedhoti, bhūripaññaṃ sumedhasaṃ; kappeto satasahasse, esa buddho bhavissati;(ka.)].","tha-ap19:8.1":"“Sāsane dibbamānamhi,","tha-ap19:8.2":"manussattaṃ gamissati;","tha-ap19:8.3":"Tassa dhammesu dāyādo,","tha-ap19:8.4":"oraso dhammanimmito.","tha-ap19:9.1":"“Upasenoti nāmena,","tha-ap19:9.2":"hessati satthu sāvako;","tha-ap19:9.3":"[idaṃ pādadvayaṃ theragāthāaṭṭhakathāyameva dissati] Samantapāsādikattā,","tha-ap19:9.4":"aggaṭṭhāne ṭhapessati","tha-ap19:10.1":"“Carimaṃ vattate mayhaṃ,","tha-ap19:10.2":"bhavā sabbe samūhatā;","tha-ap19:10.3":"Dhāremi antimaṃ dehaṃ,","tha-ap19:10.4":"jetvā māraṃ savāhanaṃ [savāhiniṃ (?)].","tha-ap19:11.1":"“Paṭisambhidā catasso,","tha-ap19:11.2":"vimokkhāpi ca aṭṭhime;","tha-ap19:11.3":"Chaḷabhiññā sacchikatā,","tha-ap19:11.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap19:12.1":"Itthaṃ sudaṃ āyasmā upaseno vaṅgantaputto thero imā gāthāyo abhāsitthāti.","tha-ap19:13.1":"Upasenavaṅgantaputtattherassāpadānaṃ sattamaṃ.","tha-ap19:13.2":"Tatiyabhāṇavāraṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2233,"to":2235,"paras":[{"para":2233,"vripara":"86","refs":["tha-ap19:1"],"lines":["So evaṃ pattaetadaggaṭṭhāno attano pubbakammaṃ saritvā somanassavasena pubbacaritāpadānaṃ pakāsento <b>padumuttaraṃ bhagavantan</b>tiādimāha.","<b>Pabbhāramhi nisīdantan</b>ti purato bhāraṃ namitaṃ onamitanti pabbhāraṃ vivekakāmaṃ vanamajjhe sayaṃjātapabbatapabbhāre nisinnaṃ <b>naruttamaṃ</b> bhagavantaṃ ahaṃ <b>upagacchiṃ</b> samīpaṃ gatoti attho."],"lineRefs":[["tha-ap19:1"],["tha-ap19:1"]]},{"para":2234,"vripara":"87","refs":["tha-ap19:1","tha-ap19:2"],"lines":["<b>Kaṇikārapuppha disvā</b>ti tathā upagacchanto tasmiṃ padese supupphitaṃ kaṇikāraṃ disvā.","<b>Vaṇṭe chetvānahaṃ tadā</b>ti tasmiṃ tathāgatassa diṭṭhakāle taṃ pupphaṃ vaṇṭe vaṇṭasmiṃ chetvāna chinditvāna.","<b>Alaṅkaritvā chattamhī</b>ti tena pupphena chattaṃ chādetvā.","<b>Buddhassa abhiropayin</b>ti pabbhāre nisinnassa buddhassa muddhani akāsinti attho."],"lineRefs":[["tha-ap19:1"],["tha-ap19:2"],["tha-ap19:2"],["tha-ap19:2"]]},{"para":2235,"vripara":"88","refs":["tha-ap19:3"],"lines":["<b>Piṇḍapātañca pādāsin</b>ti tasmiṃyeva nisinnassa bhagavato piṇḍapātaṃ pakārena adāsiṃ bhojesinti attho.","<b>Paramannaṃ subhojanan</b>ti sundarabhojanasaṅkhātaṃ paramannaṃ uttamāhāraṃ.","<b>Buddhena navame tatthā</b>ti tasmiṃ vivekaṭṭhāne buddhena saha navame aṭṭha <b>samaṇe</b> samitapāpe khīṇāsavabhikkhū bhojesinti attho."],"lineRefs":[["tha-ap19:3"],["tha-ap19:3"],["tha-ap19:3"]]}],"wordLinks":[["tha-ap19:1.1","padumuttaraṃ bhagavantaṃ",0,0],["tha-ap19:1.3","naruttamaṃ",0,1],["tha-ap19:1.3","pabbhāramhi nisīdantaṃ",0,1],["tha-ap19:1.3","upagacchiṃ",0,1],["tha-ap19:2.1","vaṇṭe chetvānahaṃ tadā",1,1],["tha-ap19:2.3","alaṅkaritvā chattamhī",1,2],["tha-ap19:2.3","buddhassa abhiropayiṃ",1,3],["tha-ap19:3.1","piṇḍapātañca pādāsiṃ",2,0],["tha-ap19:3.1","paramannaṃ subhojanaṃ",2,1],["tha-ap19:3.3","buddhena navame tatthā",2,2],["tha-ap19:3.3","samaṇe",2,2]]},"tika":null,"tika2":null}
