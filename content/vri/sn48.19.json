{"suttaId":"sn48.19","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1209,1210],"vripara":"489"},"segments":{"sn48.19:0.3":"Sampannasuttaṃ","sn48.19:1.1":"Atha kho aññataro bhikkhu yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca –","sn48.19:2.1":"“‘Indriyasampanno, indriyasampanno’ti, bhante, vuccati.","sn48.19:2.2":"Kittāvatā nu kho, bhante, indriyasampanno hotī”ti?","sn48.19:2.3":"“Idha, bhikkhu, bhikkhu saddhindriyaṃ bhāveti upasamagāmiṃ sambodhagāmiṃ, vīriyindriyaṃ bhāveti upasamagāmiṃ sambodhagāmiṃ, satindriyaṃ bhāveti upasamagāmiṃ sambodhagāmiṃ, samādhindriyaṃ bhāveti upasamagāmiṃ sambodhagāmiṃ, paññindriyaṃ bhāveti upasamagāmiṃ sambodhagāmiṃ.","sn48.19:2.4":"Ettāvatā kho, bhikkhu, bhikkhu indriyasampanno hotī”ti.","sn48.19:2.5":"Navamaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":556,"to":556,"paras":[{"para":556,"vripara":"489-490","refs":["sn48.19:2"],"lines":["489-490. Navame <b>indriyasampanno</b>ti paripuṇṇindriyo.","Dasamaṃ uttānameva.","Imasmiṃ suttadvaye missakāni indriyāni kathitānīti."],"lineRefs":[["sn48.19:2"],["sn48.19:2"],["sn48.19:2"]]}],"wordLinks":[["sn48.19:2.1","indriyasampanno",0,0],["sn48.19:2.2","indriyasampanno",0,0],["sn48.19:2.4","indriyasampanno",0,0]],"before":[{"para":555,"vripara":null,"refs":[],"lines":["9-10. Sampannasuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":482,"to":482,"paras":[{"para":482,"vripara":"489-490","refs":["sn48.19:2"],"lines":["489-490. <b>Indriyasampanno</b>ti ettha <b>sampanna</b> saddo paripūriatthoti āha <b>“paripuṇṇindriyo”</b>ti.","<b>Missakāni indriyāni kathitāni</b> sāmaññatova desitattā."],"lineRefs":[["sn48.19:2"],["sn48.19:2"]]}],"wordLinks":[["sn48.19:2.1","indriyasampanno",0,0],["sn48.19:2.1","sampanna",0,0],["sn48.19:2.2","indriyasampanno",0,0],["sn48.19:2.2","sampanna",0,0],["sn48.19:2.4","indriyasampanno",0,0],["sn48.19:2.4","sampanna",0,0]]},"tika2":null}
