{"suttaId":"tha-ap457","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1163,1177],"vripara":"27"},"segments":{"tha-ap457:0.3":"Akkamanadāyakattheraapadānaṃ","tha-ap457:1.1":"“Kakusandhassa munino, brāhmaṇassa vusīmato;","tha-ap457:1.3":"Divāvihāraṃ vajato, akkamanamadāsahaṃ.","tha-ap457:2.1":"“Imasmiṃyeva kappamhi, yaṃ dānamadadiṃ tadā;","tha-ap457:2.3":"Duggatiṃ nābhijānāmi, akkamanassidaṃ phalaṃ.","tha-ap457:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap457:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap457:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap457:6.1":"Itthaṃ sudaṃ āyasmā akkamanadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap457:7.1":"Akkamanadāyakattherassāpadānaṃ pañcamaṃ."},"attha":null,"tika":null}
