{"suttaId":"tha-ap457","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1163,1177],"vripara":"27"},"segments":{"tha-ap457:0.3":"Akkamanadāyakattheraapadānaṃ","tha-ap457:1.1":"“Kakusandhassa munino,","tha-ap457:1.2":"brāhmaṇassa vusīmato;","tha-ap457:1.3":"Divāvihāraṃ vajato,","tha-ap457:1.4":"akkamanamadāsahaṃ.","tha-ap457:2.1":"“Imasmiṃyeva kappamhi,","tha-ap457:2.2":"yaṃ dānamadadiṃ tadā;","tha-ap457:2.3":"Duggatiṃ nābhijānāmi,","tha-ap457:2.4":"akkamanassidaṃ phalaṃ.","tha-ap457:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap457:3.3":"viharāmi anāsavo.","tha-ap457:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap457:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap457:5.1":"“Paṭisambhidā catasso … pe …","tha-ap457:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap457:6.1":"Itthaṃ sudaṃ āyasmā akkamanadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap457:7.1":"Akkamanadāyakattherassāpadānaṃ pañcamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
