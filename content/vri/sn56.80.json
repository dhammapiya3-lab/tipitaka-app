{"suttaId":"sn56.80","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[2765,2770],"vripara":"1150"},"segments":{"sn56.80:0.3":"Gandhavilepanasuttaṃ","sn56.80:1.1":"… Pe …“evameva kho, bhikkhave, appakā te sattā ye mālāgandhavilepanadhāraṇamaṇḍanavibhūsanaṭṭhānā paṭiviratā; atha kho eteva bahutarā sattā ye mālāgandhavilepanadhāraṇamaṇḍanavibhūsanaṭṭhānā appaṭiviratā … pe ….","sn56.80:1.2":"Dasamaṃ.","sn56.80:1.3":"Dutiyaāmakadhaññapeyyālavaggo aṭṭhamo.","sn56.80:2.0":"Tassuddānaṃ –","sn56.80:2.1":"Pāṇaṃ adinnaṃ kāmesu,","sn56.80:2.2":"musāvādañca pesuññaṃ;","sn56.80:2.3":"Pharusaṃ samphappalāpaṃ,","sn56.80:2.4":"bījañca vikālaṃ gandhanti."},"unsure":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":956,"to":956,"paras":[{"para":956,"vripara":"1150","refs":["sn56.80:1"],"lines":["Mālādīsu <b>mālā</b>ti yaṃ kiñci pupphaṃ.","<b>Gandhan</b>ti yaṃ kiñci gandhajātaṃ.","<b>Vilepanan</b>ti chavirāgakaraṇaṃ.","Tattha piḷandhantā dhārenti nāma, ūnaṭṭhānaṃ pūrentā maṇḍenti nāma, gandhavasena chavirāgavasena ca sādiyantā vibhūsenti nāma.","<b>Ṭhānaṃ</b> vuccati kāraṇaṃ.","Tasmā yāya dussīlyacetanāya tāni mālādhāraṇādīni mahājano karoti, tato paṭiviratāti attho."],"lineRefs":[["sn56.80:1"],["sn56.80:1"],["sn56.80:1"],["sn56.80:1"],["sn56.80:1"],["sn56.80:1"]]}],"wordLinks":[["sn56.80:1.1","mālā",0,0],["sn56.80:1.1","gandhaṃ",0,1],["sn56.80:1.1","vilepanaṃ",0,2]],"before":[{"para":955,"vripara":null,"refs":[],"lines":["Gandhavilepanasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":822,"to":824,"paras":[{"para":822,"vripara":"1150","refs":["sn56.80:1"],"lines":["<b>Yaṃ kiñci pupphan</b>ti ganthimaṃ aganthimaṃ vā yaṃ kiñci pupphajātaṃ, tathā pisitādibhedaṃ <b>yaṃ kiñci gandhajātaṃ.</b>"],"lineRefs":[["sn56.80:1"]]},{"para":823,"vripara":null,"refs":["sn56.80:1"],"lines":["Tatiyaāmakadhaññapeyyālavaggo"],"lineRefs":[["sn56.80:1"]]}