{"suttaId":"sn37.33","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1516,1516],"vripara":"312"},"segments":{"sn37.33:0.3":"Pañcasīlavisāradasuttaṃ","sn37.33:1.1":"“Pañcahi, bhikkhave, dhammehi samannāgato mātugāmo visārado agāraṃ ajjhāvasati.","sn37.33:1.2":"Katamehi pañcahi?","sn37.33:1.3":"Pāṇātipātā paṭivirato ca hoti, adinnādānā paṭivirato ca hoti, kāmesumicchācārā paṭivirato ca hoti, musāvādā paṭivirato ca hoti, surāmerayamajjappamādaṭṭhānā paṭivirato ca hoti – imehi kho, bhikkhave, pañcahi dhammehi samannāgato mātugāmo visārado agāraṃ ajjhāvasatī”ti.","sn37.33:1.5":"Navamaṃ."},"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":661,"to":664,"paras":[{"para":661,"vripara":"305-313","refs":["sn37.33:1"],"lines":["305-313. <b>Pasayhā</b>ti abhibhavitvā.","<b>Abhibhuyya vattatī</b>ti abhibhavati ajjhottharati.","<b>Neva rūpabalaṃ tāyatī</b>ti neva rūpabalaṃ tāyituṃ rakkhituṃ sakkoti.","<b>Nāsenteva naṃ, kule na vāsentī</b>ti “dussīlā saṃbhinnācārā atikkantamariyādā”ti gīvāyaṃ gahetvā nīharanti, na tasmiṃ kule vāsenti.","<b>Vāsenteva naṃ kule, na nāsentī</b>ti “kiṃ rūpena bhogādīhi vā, parisuddhasīlā esā ācārasampannā”ti ñatvā ñātakā tasmiṃ kule vāsentiyeva, na nāsenti.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn37.33:1"],["sn37.33:1"],["sn37.33:1"],["sn37.33:1"],["sn37.33:1"],["sn37.33:1"]]},{"para":662,"vripara":null,"refs":[],"lines":["Mātugāmasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":663,"vripara":null,"refs":[],"lines":["Jambukhādakasaṃyuttaṃ"],"lineRefs":[[]]},{"para":664,"vripara":null,"refs":["sn37.33:1"],"lines":["Nibbānapañhāsuttavaṇṇanā"],"lineRefs":[["sn37.33:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":569,"to":573,"paras":[{"para":569,"vripara":"305-313","refs":["sn37.33:1"],"lines":["305-313. <b>Abhibhavitvā</b> sabbaṃ antojanaṃ sāmikañca.","<b>Nāsentī</b>ti nāsanaṃ adassanaṃ nenti nīharantīti attho."],"lineRefs":[["sn37.33:1"],["sn37.33:1"]]},{"para":570,"vripara":null,"refs":[],"lines":["Pasayhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":571,"vripara":null,"refs":[],"lines":["Mātugāmasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":572,"vripara":null,"refs":[],"lines":["Jambukhādakasaṃyuttaṃ"],"lineRefs":[[]]},{"para":573,"vripara":null,"refs":["sn37.33:1"],"lines":["Nibbānapañhasuttavaṇṇanā"],"lineRefs":[["sn37.33:1"]]}],"wordLinks":[]}}
