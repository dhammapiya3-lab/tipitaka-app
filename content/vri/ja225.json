{"suttaId":"ja225","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1510,1516],"vripara":"149"},"segments":{"ja225:0.4":"Khantivaṇṇajātakaṃ (2-8-5)","ja225:1.1":"Atthi me puriso deva, sabbakiccesu byāvaṭo [vāvaṭo (ka.)];","ja225:1.3":"Tassa cekoparādhatthi, tattha tvaṃ kinti maññasi.","ja225:2.1":"Amhākampatthi puriso, ediso idha vijjati;","ja225:2.3":"Dullabho aṅgasampanno, khantirasmāka ruccatīti.","ja225:3.1":"Khantivaṇṇajātakaṃ pañcamaṃ."},"attha":null,"tika":null}
