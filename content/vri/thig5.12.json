{"suttaId":"thig5.12","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[489,505],"vripara":"122"},"segments":{"thig5.12:0.3":"Candātherīgāthā","thig5.12:1.1":"“Duggatāhaṃ pure āsiṃ, vidhavā ca aputtikā;","thig5.12:1.3":"Vinā mittehi ñātīhi, bhattacoḷassa nādhigaṃ.","thig5.12:2.1":"“Pattaṃ daṇḍañca gaṇhitvā, bhikkhamānā kulā kulaṃ;","thig5.12:2.3":"Sītuṇhena ca ḍayhantī, satta vassāni cārihaṃ.","thig5.12:3.1":"“Bhikkhuniṃ puna disvāna, annapānassa lābhiniṃ;","thig5.12:3.3":"Upasaṅkamma avocaṃ [avociṃ (ka.)],‘pabbajjaṃ anagāriyaṃ’.","thig5.12:4.1":"“Sā ca maṃ anukampāya, pabbājesi paṭācārā;","thig5.12:4.3":"Tato maṃ ovaditvāna, paramatthe niyojayi.","thig5.12:5.1":"“Tassāhaṃ vacanaṃ sutvā, akāsiṃ anusāsaniṃ;","thig5.12:5.3":"Amogho ayyāyovādo, tevijjāmhi anāsavā”ti.","thig5.12:6.1":"… Candā therī ….","thig5.12:7.1":"Pañcakanipāto niṭṭhito."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1812,"to":1836,"paras":[{"para":1812,"vripara":"122","refs":["thig5.12:1"],"lines":["“Duggatāhaṃ pure āsiṃ, vidhavā ca aputtikā;"],"lineRefs":[["thig5.12:1"]]},{"para":1813,"vripara":null,"refs":[],"lines":["Vinā mittehi ñātīhi, bhattacoḷassa nādhigaṃ."],"lineRefs":[[]]},{"para":1815,"vripara":"123","refs":["thig5.12:2"],"lines":["“Pattaṃ daṇḍañca gaṇhitvā, bhikkhamānā kulā kulaṃ;"],"lineRefs":[["thig5.12:2"]]},{"para":1816,"vripara":null,"refs":[],"lines":["Sītuṇhena ca ḍayhantī, satta vassāni cārihaṃ."],"lineRefs":[[]]},{"para":1818,"vripara":"124","refs":["thig5.12:3"],"lines":["“Bhikkhuniṃ puna disvāna, annapānassa lābhiniṃ;"],"lineRefs":[["thig5.12:3"]]},{"para":1819,"vripara":null,"refs":[],"lines":["Upasaṅkammaṃ avocaṃ, pabbajjaṃ anagāriyaṃ."],"lineRefs":[[]]},{"para":1821,"vripara":"125","refs":["thig5.12:4"],"lines":["“Sā ca maṃ anukampāya, pabbājesi paṭācārā;"],"lineRefs":[["thig5.12:4"]]},{"para":1822,"vripara":null,"refs":[],"lines":["Tato maṃ ovaditvāna, paramatthe niyojayi."],"lineRefs":[[]]},{"para":1824,"vripara":"126","refs":["thig5.12:5"],"lines":["“Tassāhaṃ vacanaṃ sutvā, akāsiṃ anusāsaniṃ;"],"lineRefs":[["thig5.12:5"]]},{"para":1825,"vripara":null,"refs":[],"lines":["Amogho ayyāyovādo, tevijjāmhi anāsavā”ti.","–"],"lineRefs":[[],[]]},{"para":1826,"vripara":null,"refs":[],"lines":["Udānavasena imā gāthā abhāsi."],"lineRefs":[[]]},{"para":1827,"vripara":null,"refs":[],"lines":["Tattha <b>duggatā</b>ti daliddā.","<b>Pure</b>ti pabbajitato pubbe.","Pabbajitakālato paṭṭhāya hi idha puggalo bhogehi aḍḍho vā daliddo vāti na vattabbo.","Guṇehi pana ayaṃ therī aḍḍhāyeva.","Tenāha “duggatāhaṃ pure āsin”ti.","<b>Vidhavā</b>ti dhavo vuccati sāmiko, tadabhāvā vidhavā, matapatikāti attho.","<b>Aputtikā</b>ti puttarahitā.","<b>Vinā mittehī</b>ti mittehi bandhavehi ca parihīnā rahitā.","<b>Bhattacoḷassa nādhigan</b>ti bhattassa coḷassa ca pāripūriṃ nādhigacchiṃ, kevalaṃ pana bhikkhāpiṇḍassa pilotikākhaṇḍassa ca vasena ghāsacchādanamattameva alatthanti adhippāyo.","Tenāha <b>“pattaṃ daṇḍañca gaṇhitvā”</b>tiādi."],"lineRefs":[[],[],[],[],[],[],[],[],[],[]]},{"para":1828,"vripara":null,"refs":[],"lines":["Tattha <b>pattan</b>ti mattikābhājanaṃ.","<b>Daṇḍan</b>ti goṇasunakhādipariharaṇadaṇḍakaṃ.","<b>Kulā kulan</b>ti kulato kulaṃ.","<b>Sītuṇhena ca ḍayhantī</b>ti vasanagehābhāvato sītena ca uṇhena ca pīḷiyamānā."],"lineRefs":[[],[],[],[]]},{"para":1829,"vripara":null,"refs":[],"lines":["<b>Bhikkhunin</b>ti paṭācārātheriṃ sandhāya vadati.","<b>Punā</b>ti pacchā, sattasaṃvaccharato aparabhāge."],"lineRefs":[[],[]]},{"para":1830,"vripara":null,"refs":[],"lines":["<b>Paramatthe</b>ti parame uttame atthe, nibbānagāminiyā paṭipadāya nibbāne ca.","<b>Niyojayī</b>ti kammaṭṭhānaṃ ācikkhantī niyojesi.","Sesaṃ vuttanayameva."],"lineRefs":[[],[],[]]},{"para":1831,"vripara":null,"refs":[],"lines":["Candātherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1832,"vripara":null,"refs":[],"lines":["Pañcakanipātavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1833,"vripara":null,"refs":[],"lines":["Chakkanipāto"],"lineRefs":[[]]},{"para":1834,"vripara":null,"refs":[],"lines":["Pañcasatamattātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":1835,"vripara":null,"refs":[],"lines":["Chakkanipāte <b>yassa maggaṃ na jānāsī</b>tiādikā pañcasatamattānaṃ therīnaṃ gāthā.","Imāpi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantiyo anukkamena upacitavimokkhasambhārā hutvā imasmiṃ buddhuppāde tattha tattha kulagehe nibbattitvā vayappattā mātāpitūhi patikulaṃ ānītā tattha tattha putte labhitvā gharāvāsaṃ vasantiyo samānajātikassa tādisassa kammassa katattā sabbāva mataputtā hutvā, puttasokena abhibhūtā paṭācārāya theriyā santikaṃ upasaṅkamitvā vanditvā nisinnā attano sokakāraṇaṃ ārocesuṃ.","Therī tāsaṃ sokaṃ vinodentī –"],"lineRefs":[[],[],[]]}],"wordLinks":[]},"tika":null}
