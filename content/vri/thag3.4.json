{"suttaId":"thag3.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1174,1183],"vripara":"228"},"segments":{"thag3.4:0.4":"Dhaniyattheragāthā","thag3.4:1.1":"“Sukhaṃ ce jīvituṃ icche, sāmaññasmiṃ apekkhavā;","thag3.4:1.3":"Saṅghikaṃ nātimaññeyya, cīvaraṃ pānabhojanaṃ.","thag3.4:2.1":"“Sukhaṃ ce jīvituṃ icche, sāmaññasmiṃ apekkhavā;","thag3.4:2.3":"Ahi mūsikasobbhaṃva, sevetha sayanāsanaṃ.","thag3.4:3.1":"“Sukhaṃ ce jīvituṃ icche, sāmaññasmiṃ apekkhavā;","thag3.4:3.3":"Itarītarena tusseyya, ekadhammañca bhāvaye”ti.","thag3.4:3.5":"… Dhaniyo thero …."},"attha":null,"tika":null}
