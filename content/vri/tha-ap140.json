{"suttaId":"tha-ap140","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6200,6215],"vripara":"55"},"segments":{"tha-ap140:0.3":"Ekapasādaniyattheraapadānaṃ","tha-ap140:1.1":"“Nārado iti me nāmaṃ [nārado iti nāmena (syā. ka.) upari tevīsatimavagge pana chaṭṭhāpadāne “me nāmaṃ “icceva dissati],","tha-ap140:1.2":"kesavo iti maṃ vidū;","tha-ap140:1.3":"Kusalākusalaṃ esaṃ,","tha-ap140:1.4":"agamaṃ buddhasantikaṃ.","tha-ap140:2.1":"“Mettacitto kāruṇiko,","tha-ap140:2.2":"atthadassī mahāmuni;","tha-ap140:2.3":"Assāsayanto satte so,","tha-ap140:2.4":"dhammaṃ deseti cakkhumā.","tha-ap140:3.1":"“Sakaṃ cittaṃ pasādetvā,","tha-ap140:3.2":"sire katvāna añjaliṃ;","tha-ap140:3.3":"Satthāraṃ abhivādetvā,","tha-ap140:3.4":"pakkāmiṃ pācināmukho.","tha-ap140:4.1":"“Sattarase kappasate,","tha-ap140:4.2":"rājā āsi mahīpati;","tha-ap140:4.3":"Amittatāpano nāma,","tha-ap140:4.4":"cakkavattī mahabbalo.","tha-ap140:5.1":"“Paṭisambhidā catasso … pe …","tha-ap140:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap140:6.1":"Itthaṃ sudaṃ āyasmā ekapasādaniyo thero imā gāthāyo abhāsitthāti.","tha-ap140:7.1":"Ekapasādaniyattherassāpadānaṃ aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2970,"to":2970,"paras":[{"para":2970,"vripara":"55","refs":["tha-ap140:1"],"lines":["So aparabhāge attano katakusalakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>nārado iti me nāman</b>tiādimāha.","Tattha <b>nārado</b>ti jātivasena suddhasarīrattā natthi rajo dhūli malaṃ etassāti nārado, ja-kārassa da-kāraṃ katvā nāradoti kuladattikaṃ nāmaṃ.","<b>Kesavo</b>ti kisavacchagotte jātattā kesavo nāradakesavo iti maṃ janā <b>vidū</b> jānantīti attho.","Sesaṃ pākaṭamevāti."],"lineRefs":[["tha-ap140:1"],["tha-ap140:1"],["tha-ap140:1"],["tha-ap140:1"]]}],"wordLinks":[["tha-ap140:1.1","nārado iti me nāmaṃ",0,0],["tha-ap140:1.1","nārado",0,1],["tha-ap140:1.1","kesavo",0,2],["tha-ap140:1.1","vidū",0,2]]},"tika":null,"tika2":null}
