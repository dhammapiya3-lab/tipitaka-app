{"suttaId":"vv85","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[3244,3279],"vripara":"1282"},"segments":{"vv85:0.4":"Sunikkhittavimānavatthu","vv85:1.1":"“Uccamidaṃ maṇithūṇaṃ vimānaṃ,","vv85:1.2":"samantato dvādasa yojanāni;","vv85:1.3":"Kūṭāgārā sattasatā uḷārā,","vv85:1.4":"veḷuriyathambhā rucakatthatā subhā.","vv85:2.1":"“Tatthacchasi pivasi khādasi ca,","vv85:2.2":"dibbā ca vīṇā pavadanti vagguṃ;","vv85:2.3":"Dibbā rasā kāmaguṇettha pañca,","vv85:2.4":"nāriyo ca naccanti suvaṇṇachannā.","vv85:3.1":"“Kena tetādiso vaṇṇo,","vv85:3.2":"kena te idha mijjhati;","vv85:3.3":"Uppajjanti ca te bhogā,","vv85:3.4":"ye keci manaso piyā.","vv85:4.1":"“Pucchāmi ‘taṃ deva mahānubhāva,","vv85:4.2":"manussabhūto kimakāsi puññaṃ;","vv85:4.3":"Kenāsi evaṃ jalitānubhāvo,","vv85:4.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv85:5.1":"So devaputto attamano,","vv85:5.2":"moggallānena pucchito;","vv85:5.3":"Pañhaṃ puṭṭho viyākāsi,","vv85:5.4":"yassa kammassidaṃ phalaṃ.","vv85:6.1":"“Dunnikkhittaṃ mālaṃ sunikkhipitvā,","vv85:6.2":"patiṭṭhapetvā sugatassa thūpe;","vv85:6.3":"Mahiddhiko camhi mahānubhāvo,","vv85:6.4":"dibbehi kāmehi samaṅgibhūto.","vv85:7.1":"“Tena metādiso vaṇṇo,","vv85:7.2":"Tena me idha mijjhati;","vv85:7.3":"Uppajjanti ca me bhogā,","vv85:7.4":"Ye keci manaso piyā.","vv85:8.1":"“Akkhāmi te bhikkhu mahānubhāva,","vv85:8.2":"Manussabhūto yamahaṃ akāsiṃ;","vv85:8.3":"Tenamhi evaṃ jalitānubhāvo,","vv85:8.4":"Vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv85:9.1":"Sunikkhittavimānaṃ ekādasamaṃ.","vv85:9.2":"Sunikkhittavaggo sattamo niṭṭhito.","vv85:10.1":"Tassuddānaṃ –","vv85:11.1":"Dve daliddā vanavihārā,","vv85:11.2":"bhatako gopālakaṇḍakā;","vv85:11.3":"Anekavaṇṇamaṭṭhakuṇḍalī,","vv85:11.4":"serīsako sunikkhittaṃ;","vv85:11.5":"Purisānaṃ tatiyo vaggo pavuccatīti.","vv85:12.1":"Bhāṇavāraṃ catutthaṃ niṭṭhitaṃ.","vv85:13.1":"Vimānavatthupāḷi niṭṭhitā."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3984,"to":3984,"paras":[{"para":3984,"vripara":"1287","refs":["vv85:6"],"lines":["Tattha <b>dunnikkhittaṃ mālan</b>ti cetiye pūjākaraṇaṭṭhāne nirantaraṭṭhapanādinā racanāvisesena aṭṭhapetvā yathānikkhittatāya na suṭṭhu nikkhittaṃ, vātena vā paharitvā dunnikkhittaṃ pupphaṃ.","<b>Sunikkhipitvā</b>ti suṭṭhu nikkhipitvā racanāvisesena dassanīyaṃ pāsādikaṃ katvā nikkhipiya.","<b>Patiṭṭhapetvā</b>ti vibhattivisesādivasena pupphaṃ patiṭṭhāpetvā.","Taṃ vā pupphaṃ nikkhipanto satthu cetiyaṃ uddissa mama santāne kusaladhammaṃ patiṭṭhāpetvāti evaṃ ettha attho daṭṭhabbo.","Sesaṃ vuttanayameva."],"lineRefs":[["vv85:6"],["vv85:6"],["vv85:6"],["vv85:6"],["vv85:6"]]}],"wordLinks":[["vv85:6.1","dunnikkhittaṃ mālaṃ",0,0],["vv85:6.1","sunikkhipitvā",0,1],["vv85:6.1","patiṭṭhapetvā",0,2]],"before":[{"para":3953,"vripara":null,"refs":[],"lines":["Sambhavo pana upāsako pāyāsissa devaputtassa tesañca vāṇijānaṃ vacanapaṭivacanavasena pavattaṃ gāthābandhaṃ sutaniyāmeneva uggahetvā therānaṃ ārocesi.","Pāyāsidevaputto āyasmato sambhavattherassa kathesīti apare.","Taṃ yasattherappamukhā mahātherā dutiyasaṅgītiyaṃ saṅgahaṃ āropesuṃ.","Sambhavo pana upāsako mātāpitūnaṃ accayena pabbajitvā arahatte patiṭṭhāsi."],"lineRefs":[[],[],[],[]]},{"para":3954,"vripara":null,"refs":[],"lines":["Serīsakavimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3955,"vripara":null,"refs":[],"lines":["Sunikkhittavimānavaṇṇanā"],"lineRefs":[[]]},{"para":3956,"vripara":null,"refs":[],"lines":["<b>Uccamidaṃ maṇithūṇaṃ vimānan</b>ti sunikkhittavimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tena samayena āyasmā mahāmoggallāno heṭṭhā vuttanayeneva devacārikaṃ caranto tāvatiṃsabhavanaṃ upagato.","Tasmiñca khaṇe aññataro devaputto attano vimānadvāre ṭhito āyasmantaṃ mahāmoggallānaṃ disvā sañjātagāravabahumāno upasaṅkamitvā pañcapatiṭṭhitena vanditvā añjaliṃ paggayha aṭṭhāsi."],"lineRefs":[[],[],[],[],[]]},{"para":3957,"vripara":null,"refs":[],"lines":["So kira atīte kassapasammāsambuddhe parinibbute tassa sarīradhātuyo pakkhipitvā yojanike kanakathūpe ca kate catasso parisā kālena kālaṃ upasaṅkamitvā gandhapupphadhūpādīhi cetiye pūjaṃ karonti, tattha aññataro upāsako aññesu pupphapūjaṃ katvā gatesu tehi pūjitaṭṭhāne dunnikkhittāni pupphāni disvā tattheva tāni sammadeva ṭhapento sannivesavasena dassanīyaṃ pāsādikaṃ vibhattivisesayuttaṃ pupphapūjaṃ akāsi.","Katvā ca pana etaṃ ārammaṇaṃ gaṇhanto satthu guṇe anussaritvā pasannacitto taṃ puññaṃ hadaye ṭhapesi."],"lineRefs":[[],[]]},{"para":3958,"vripara":null,"refs":[],"lines":["So aparabhāge kālaṃ katvā tasseva kammassa ānubhāvena tāvatiṃsabhavane dvādasayojanike kanakavimāne nibbatti, mahānubhāvo mahā cassa parivāro ahosi.","Taṃ sandhāya vuttaṃ “tasmiñca khaṇe aññataro devaputto … pe … aṭṭhāsī”ti.","Atha naṃ āyasmā mahāmoggallāno yathāladdhasampattikittanamukhena katasucaritakammaṃ imāhi gāthāhi pucchi –"],"lineRefs":[[],[],[]]},{"para":3960,"vripara":"1282","refs":[],"lines":["“Uccamidaṃ maṇithūṇaṃ vimānaṃ, samantato dvādasayojanāni;"],"lineRefs":[[]]},{"para":3961,"vripara":null,"refs":[],"lines":["Kūṭāgārā sattasatā uḷārā, veḷuriyathambhā rucakatthatā subhā."],"lineRefs":[[]]},{"para":3963,"vripara":"1283","refs":[],"lines":["“Tatthacchasi pivasi khādasi ca, dibbā ca vīṇā pavadanti vagguṃ;"],"lineRefs":[[]]},{"para":3964,"vripara":null,"refs":[],"lines":["Dibbā rasā kāmaguṇettha pañca, nāriyo ca naccanti suvaṇṇachannā."],"lineRefs":[[]]},{"para":3966,"vripara":"1284","refs":[],"lines":["“Kena tetādiso vaṇṇo, kena te idha mijjhati;"],"lineRefs":[[]]},{"para":3967,"vripara":null,"refs":[],"lines":["Uppajjanti ca te bhogā, ye keci manaso piyā."],"lineRefs":[[]]},{"para":3969,"vripara":"1285","refs":[],"lines":["“Pucchāmi taṃ deva mahānubhāva, manussabhūto kimakāsi puññaṃ;"],"lineRefs":[[]]},{"para":3970,"vripara":null,"refs":[],"lines":["Kenāsi evaṃ jalitānubhāvo, vaṇṇo ca te sabbadisā pabhāsatī”ti."],"lineRefs":[[]]},{"para":3971,"vripara":null,"refs":[],"lines":["Sopi tassa attano katakammaṃ imāhi gāthāhi kathesi.","Taṃ dassentā saṅgītikārā āhaṃsu –"],"lineRefs":[[],[]]},{"para":3973,"vripara":"1286","refs":[],"lines":["“So devaputto attamano, moggallānena pucchito;"],"lineRefs":[[]]},{"para":3974,"vripara":null,"refs":[],"lines":["Pañhaṃ puṭṭho viyākāsi, yassa kammassidaṃ phalaṃ”."],"lineRefs":[[]]},{"para":3976,"vripara":"1287","refs":[],"lines":["“Dunnikkhittaṃ mālaṃ sunikkhipitvā, patiṭṭhapetvā sugatassa thūpe;"],"lineRefs":[[]]},{"para":3977,"vripara":null,"refs":[],"lines":["Mahiddhiko camhi mahānubhāvo, dibbehi kāmehi samaṅgibhūto."],"lineRefs":[[]]},{"para":3979,"vripara":"1288","refs":[],"lines":["“Tena metādiso vaṇṇo, tena me idha mijjhati;"],"lineRefs":[[]]},{"para":3980,"vripara":null,"refs":[],"lines":["Uppajjanti ca me bhogā, ye keci manaso piyā."],"lineRefs":[[]]},{"para":3982,"vripara":"1289","refs":[],"lines":["“Akkhāmi te bhikkhu mahānubhāva, manussabhūto yamahaṃ akāsiṃ;"],"lineRefs":[[]]},{"para":3983,"vripara":null,"refs":[],"lines":["Tenamhi evaṃ jalitānubhāvo, vaṇṇo ca me sabbadisā pabhāsatī”ti."],"lineRefs":[[]]}],"after":[{"para":3985,"vripara":null,"lines":["Evaṃ devaputtena attano sucaritakamme pakāsite thero tassa dhammaṃ desetvā āgantvā bhagavato tamatthaṃ nivedesi.","Bhagavā taṃ aṭṭhuppattiṃ katvā sampattamahājanassa dhammaṃ desesi.","Desanā mahājanassa sātthikā ahosīti."]},{"para":3986,"vripara":null,"lines":["Sunikkhittavimānavaṇṇanā niṭṭhitā."]},{"para":3987,"vripara":null,"lines":["Iti paramatthadīpaniyā khuddaka-aṭṭhakathāya vimānavatthusmiṃ"]},{"para":3988,"vripara":null,"lines":["Ekādasavatthupaṭimaṇḍitassa sattamassa"]},{"para":3989,"vripara":null,"lines":["Sunikkhittavaggassa atthavaṇṇanā niṭṭhitā."]},{"para":3990,"vripara":null,"lines":["Niṭṭhitā ca purisavimānavaṇṇanā."]},{"para":3991,"vripara":null,"lines":["Nigamanakathā"]},{"para":3992,"vripara":null,"lines":["Ettāvatā ca –"]},{"para":3993,"vripara":null,"lines":["Devatānaṃ vimānādi-sampattiṃ tassa kāraṇaṃ;"]},{"para":3994,"vripara":null,"lines":["Pakāsayantī sattānaṃ, sabbalokahitāvahā."]},{"para":3995,"vripara":null,"lines":["Appakānampi kārānaṃ, yā vibhāveti desanā;"]},{"para":3996,"vripara":null,"lines":["Uḷāraphalataṃ citta-khettasampattiyogato."]},{"para":3997,"vripara":null,"lines":["Yaṃ kathāvatthukusalā, supariññātavatthukā;"]},{"para":3998,"vripara":null,"lines":["<b>Vimānavatthu</b> icceva, saṅgāyiṃsu mahesayo."]},{"para":3999,"vripara":null,"lines":["Tassa atthaṃ pakāsetuṃ, porāṇaṭṭhakathānayaṃ;"]},{"para":4000,"vripara":null,"lines":["Sannissāya samāraddhā, atthasaṃvaṇṇanā mayā."]},{"para":4001,"vripara":null,"lines":["Yā tattha paramatthānaṃ, tattha tattha yathārahaṃ;"]},{"para":4002,"vripara":null,"lines":["Pakāsanā <b>paramattha-dīpanī</b> nāma nāmato."]},{"para":4003,"vripara":null,"lines":["Sampattā pariniṭṭhānaṃ, anākulavinicchayā;"]},{"para":4004,"vripara":null,"lines":["Sā sattarasamattāya, pāḷiyā bhāṇavārato."]},{"para":4005,"vripara":null,"lines":["Iti taṃ saṅkharontena, yaṃ taṃ adhigataṃ mayā;"]},{"para":4006,"vripara":null,"lines":["Puññaṃ tassānubhāvena, lokanāthassa sāsanaṃ."]},{"para":4007,"vripara":null,"lines":["Ogāhetvā visuddhāya, sīlādipaṭipattiyā;"]},{"para":4008,"vripara":null,"lines":["Sabbepi dehino hontu, vimuttirasabhāgino."]},{"para":4009,"vripara":null,"lines":["Ciraṃ tiṭṭhatu lokasmiṃ, sammāsambuddhasāsanaṃ;"]},{"para":4010,"vripara":null,"lines":["Tasmiṃ sagāravā niccaṃ, hontu sabbepi pāṇino."]},{"para":4011,"vripara":null,"lines":["Sammā vassatu kālena, devopi jagatīpati;"]},{"para":4012,"vripara":null,"lines":["Saddhammanirato lokaṃ, dhammeneva pasāsatūti."]},{"para":4013,"vripara":null,"lines":["Iti badaratitthavihāravāsinā <b>ācariyadhammapālena</b>"]},{"para":4014,"vripara":null,"lines":["Katāya"]},{"para":4015,"vripara":null,"lines":["Paramatthadīpaniyā khuddaka-aṭṭhakathāya"]},{"para":4016,"vripara":null,"lines":["Vimānavatthuatthavaṇṇanā niṭṭhitā."]},{"para":4017,"vripara":null,"lines":["Vimānavatthu-aṭṭhakathā samattā."]}]},"tika":null,"tika2":null}
