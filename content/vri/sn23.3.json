{"suttaId":"sn23.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[901,901],"vripara":"162"},"segments":{"sn23.3:0.3":"Bhavanettisuttaṃ","sn23.3:1.1":"Sāvatthinidānaṃ.","sn23.3:1.2":"Ekamantaṃ nisinno kho āyasmā rādho bhagavantaṃ etadavoca –","sn23.3:1.3":"“‘bhavanettinirodho [bhavanetti (sī. syā. kaṃ. pī.)], bhavanettinirodho’ti [bhavanettīti (sī. syā. kaṃ.)], bhante, vuccati.","sn23.3:1.4":"Katamā nu kho, bhante, bhavanetti, katamo bhavanettinirodho”ti?","sn23.3:1.5":"“Rūpe kho, rādha, yo chando yo rāgo yā nandī yā taṇhā ye upayupādānā cetaso adhiṭṭhānābhinivesānusayā –","sn23.3:1.6":"ayaṃ vuccati bhavanetti.","sn23.3:1.7":"Tesaṃ nirodho [nirodhā (sī. syā. kaṃ. pī.)] bhavanettinirodho.","sn23.3:1.8":"Vedanāya…","sn23.3:1.9":"saññāya…","sn23.3:1.10":"saṅkhāresu …","sn23.3:1.11":"viññāṇe yo chando…pe… adhiṭṭhānābhinivesānusayā –","sn23.3:1.12":"ayaṃ vuccati bhavanetti.","sn23.3:1.13":"Tesaṃ nirodho bhavanettinirodho”ti.","sn23.3:1.14":"Tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":406,"to":409,"paras":[{"para":406,"vripara":"161-169","refs":["sn23.3:1"],"lines":["Dutiye <b>satto satto</b>ti laggapucchā.","<b>Tatra satto tatra visatto</b>ti tatra laggo tatra vilaggo.","<b>Paṃsvāgārakehī</b>ti paṃsugharakehi.","<b>Keḷāyantī</b>ti kīḷanti.","<b>Dhanāyantī</b>ti dhanaṃ viya maññanti.","<b>Mamāyantī</b>ti “mama idaṃ, mama ida”nti mamattaṃ karonti, aññassa phusitumpi na denti.","<b>Vikīḷaniyaṃ karontī</b>ti “niṭṭhitā kīḷā”ti te bhindamānā kīḷāvigamaṃ karonti.","Tatiye <b>bhavanettī</b>ti bhavarajju.","Catutthaṃ uttānameva.","Pañcamādīsu catūsu cattāri saccāni kathitāni, dvīsu kilesappahānanti.","Dutiyādīni."],"lineRefs":[["sn23.3:1"],["sn23.3:1"],["sn23.3:1"],["sn23.3:1"],["sn23.3:1"],["sn23.3:1"],["sn23.3:1"],["sn23.3:1"],["sn23.3:1"],["sn23.3:1"],["sn23.3:1"]]},{"para":407,"vripara":null,"refs":["sn23.3:1"],"lines":["Paṭhamo vaggo. 2."],"lineRefs":[["sn23.3:1"]]},{"para":408,"vripara":null,"refs":["sn23.3:1"],"lines":["Dutiyavaggo 1-12."],"lineRefs":[["sn23.3:1"]]},{"para":409,"vripara":null,"refs":["sn23.3:1"],"lines":["Mārasuttādivaṇṇanā 170-181."],"lineRefs":[["sn23.3:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":415,"to":419,"paras":[{"para":415,"vripara":"161-169","refs":["sn23.3:1"],"lines":["<b>Laggapucchā</b>ti lagganassa bajjhanassa pucchā.","Yadi rūpādīsu sattattā satto, khīṇāsavā kathaṃ sattāti?","Sattabhūtapubbāti katvā.","<b>Kīḷāvigama</b>nti kīḷāya apanayanaṃ oramaṇaṃ.","Yantarajju viya bhavapabandhassa nayanato <b>bhavarajjū</b>ti taṇhā vuttā."],"lineRefs":[["sn23.3:1"],["sn23.3:1"],["sn23.3:1"],["sn23.3:1"],["sn23.3:1"]]},{"para":416,"vripara":null,"refs":["sn23.3:1"],"lines":["Sattasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn23.3:1"]]},{"para":417,"vripara":null,"refs":["sn23.3:1"],"lines":["Paṭhamavaggavaṇṇanā niṭṭhitā. 2."],"lineRefs":[["sn23.3:1"]]},{"para":418,"vripara":null,"refs":["sn23.3:1"],"lines":["Dutiyavaggo 1-12."],"lineRefs":[["sn23.3:1"]]},{"para":419,"vripara":null,"refs":["sn23.3:1"],"lines":["Mārasuttādivaṇṇanā 170-181."],"lineRefs":[["sn23.3:1"]]}],"wordLinks":[]},"tika2":null}
