{"suttaId":"ja220","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1463,1474],"vripara":"139"},"segments":{"ja220:0.4":"Dhammadhajajātakaṃ (2-7-10)","ja220:1.1":"Sukhaṃ jīvitarūposi, raṭṭhā vivanamāgato;","ja220:1.3":"So ekako rukkhamūle [araññasmiṃ (sī. syā. pī.)], kapaṇo viya jhāyasi.","ja220:2.1":"Sukhaṃ jīvitarūposmi, raṭṭhā vivanamāgato;","ja220:2.3":"So ekako rukkhamūle, kapaṇo viya jhāyāmi;","ja220:2.5":"Sataṃ dhammaṃ anussaraṃti.","ja220:3.1":"Dhammadhajajātakaṃ dasamaṃ.","ja220:3.2":"Bīraṇathambhavaggo sattamo.","ja220:4.1":"Tassuddānaṃ –","ja220:5.1":"Atha bīraṇathambhavaro ca naṭo, bharurājavaruttamapuṇṇanadī;","ja220:5.3":"Bahubhāṇi aggipavane mūsikā, sahalambatthano kapaṇena dasāti."},"attha":null,"tika":null}
