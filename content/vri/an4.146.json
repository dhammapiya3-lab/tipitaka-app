{"suttaId":"an4.146","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1204,1204],"vripara":"146"},"segments":{"an4.146:0.3":"Paṭhamakālasuttaṃ","an4.146:1.1":"“Cattārome, bhikkhave, kālā.","an4.146:1.2":"Katame cattāro?","an4.146:1.3":"Kālena dhammassavanaṃ, kālena dhammasākacchā, kālena sammasanā [kālena samatho (sī. syā. kaṃ. pī.)], kālena vipassanā – ime kho, bhikkhave, cattāro kālā”ti.","an4.146:1.5":"Chaṭṭhaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1452,"to":1452,"paras":[{"para":1452,"vripara":"146","refs":["an4.146:1"],"words":["kālā","kālena dhammassavanaṃ","dhammasākacchā"],"lines":["Chaṭṭhe <b>kālā</b>ti yuttappayuttakālā.","<b>Kālena dhammassavanan</b>ti yuttappayuttakāle dhammassavanaṃ.","<b>Dhammasākacchā</b>ti pañhapucchanavissajjanavasena pavattā saṃsandanakathā."],"lineRefs":[["an4.146:1"],["an4.146:1"],["an4.146:1"]]}]},"tika":null}
