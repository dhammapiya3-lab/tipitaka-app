{"suttaId":"an4.146","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1204,1204],"vripara":"146"},"segments":{"an4.146:0.3":"Paṭhamakālasuttaṃ","an4.146:1.1":"“Cattārome, bhikkhave, kālā.","an4.146:1.2":"Katame cattāro?","an4.146:1.3":"Kālena dhammassavanaṃ, kālena dhammasākacchā, kālena sammasanā [kālena samatho (sī. syā. kaṃ. pī.)], kālena vipassanā – ime kho, bhikkhave, cattāro kālā”ti.","an4.146:1.5":"Chaṭṭhaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1452,"to":1452,"paras":[{"para":1452,"vripara":"146","refs":["an4.146:1"],"lines":["Chaṭṭhe <b>kālā</b>ti yuttappayuttakālā.","<b>Kālena dhammassavanan</b>ti yuttappayuttakāle dhammassavanaṃ.","<b>Dhammasākacchā</b>ti pañhapucchanavissajjanavasena pavattā saṃsandanakathā."],"lineRefs":[["an4.146:1"],["an4.146:1"],["an4.146:1"]]}],"wordLinks":[["an4.146:1.1","kālā",0,0],["an4.146:1.3","kālā",0,0],["an4.146:1.3","kālena dhammassavanaṃ",0,1],["an4.146:1.3","dhammasākacchā",0,2]]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1637,"to":1639,"paras":[{"para":1637,"vripara":"141-146","refs":["an4.146:1"],"lines":["141-146. Pañcamassa paṭhamādīni uttānatthāneva."],"lineRefs":[["an4.146:1"]]},{"para":1638,"vripara":null,"refs":[],"lines":["Ābhāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1639,"vripara":null,"refs":["an4.146:1"],"lines":["7-10. Dutiyakālasuttādivaṇṇanā"],"lineRefs":[["an4.146:1"]]}],"wordLinks":[]},"tika2":null}
