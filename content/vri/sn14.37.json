{"suttaId":"sn14.37","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[853,854],"vripara":"121"},"segments":{"sn14.37:0.3":"Samaṇabrāhmaṇasuttaṃ","sn14.37:1.1":"Sāvatthiyaṃ viharati … pe …","sn14.37:1.2":"“catasso imā, bhikkhave, dhātuyo.","sn14.37:1.3":"Katamā catasso?","sn14.37:1.4":"Pathavīdhātu, āpodhātu, tejodhātu, vāyodhātu.","sn14.37:1.5":"Ye hi keci, bhikkhave, samaṇā vā brāhmaṇā vā imāsaṃ catunnaṃ dhātūnaṃ assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti,","sn14.37:1.6":"na me te, bhikkhave, samaṇā vā brāhmaṇā vā samaṇesu vā samaṇasammatā brāhmaṇesu vā brāhmaṇasammatā; na ca pana te āyasmanto sāmaññatthaṃ vā brahmaññatthaṃ vā diṭṭheva dhamme sayaṃ abhiññā sacchikatvā upasampajja viharanti”.","sn14.37:2.1":"“Ye ca kho keci, bhikkhave, samaṇā vā brāhmaṇā vā imāsaṃ catunnaṃ dhātūnaṃ assādañca ādīnavañca nissaraṇañca yathābhūtaṃ pajānanti,","sn14.37:2.2":"te ca kho me, bhikkhave, samaṇā vā brāhmaṇā vā samaṇesu ceva samaṇasammatā brāhmaṇesu ca brāhmaṇasammatā; te ca panāyasmanto sāmaññatthañca brahmaññatthañca diṭṭheva dhamme sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti.","sn14.37:2.3":"Aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":613,"to":618,"paras":[{"para":613,"vripara":"119-123","refs":["sn14.37:1"],"lines":["119-123. Chaṭṭhasattamesu vivaṭṭaṃ, avasāne tīsu catusaccamevāti.","Chaṭṭhādīni."],"lineRefs":[["sn14.37:1"],["sn14.37:1"]]},{"para":614,"vripara":null,"refs":["sn14.37:1"],"lines":["Catuttho vaggo."],"lineRefs":[["sn14.37:1"]]},{"para":615,"vripara":null,"refs":["sn14.37:1"],"lines":["Dhātusaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn14.37:1"]]},{"para":616,"vripara":null,"refs":["sn14.37:1"],"lines":["Anamataggasaṃyuttaṃ"],"lineRefs":[["sn14.37:1"]]},{"para":617,"vripara":null,"refs":["sn14.37:1"],"lines":["Paṭhamavaggo"],"lineRefs":[["sn14.37:1"]]},{"para":618,"vripara":null,"refs":["sn14.37:1"],"lines":["Tiṇakaṭṭhasuttavaṇṇanā"],"lineRefs":[["sn14.37:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":611,"to":618,"paras":[{"para":611,"vripara":"119-123","refs":["sn14.37:1"],"lines":["119-123. Chaṭṭhasattamesu vaṭṭavivaṭṭaṃ kathitaṃ.","Aṭṭhakathāyaṃ pana <b>“vivaṭṭaṃ kathitan”</b>ti vuttaṃ.","<b>Tīsu</b> suttesu.","<b>Catusaccamevā</b>ti cattāri saccāni samāhaṭāni catusaccanti tesaṃ ekajjhaṃ gahaṇaṃ, niyamo pana tabbinimuttassa paramatthassa abhāvato."],"lineRefs":[["sn14.37:1"],["sn14.37:1"],["sn14.37:1"],["sn14.37:1"]]},{"para":612,"vripara":null,"refs":["sn14.37:1"],"lines":["Abhinandasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn14.37:1"]]},{"para":613,"vripara":null,"refs":["sn14.37:1"],"lines":["Catutthavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn14.37:1"]]},{"para":614,"vripara":null,"refs":["sn14.37:1"],"lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"],"lineRefs":[["sn14.37:1"]]},{"para":615,"vripara":null,"refs":["sn14.37:1"],"lines":["Dhātusaṃyuttavaṇṇanāya līnatthappakāsanā samattā."],"lineRefs":[["sn14.37:1"]]},{"para":616,"vripara":null,"refs":["sn14.37:1"],"lines":["Anamataggasaṃyuttaṃ"],"lineRefs":[["sn14.37:1"]]},{"para":617,"vripara":null,"refs":["sn14.37:1"],"lines":["Paṭhamavaggo"],"lineRefs":[["sn14.37:1"]]},{"para":618,"vripara":null,"refs":["sn14.37:1"],"lines":["Tiṇakaṭṭhasuttavaṇṇanā"],"lineRefs":[["sn14.37:1"]]}],"wordLinks":[]},"tika2":null}
