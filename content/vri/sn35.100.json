{"suttaId":"sn35.100","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[600,600],"vripara":"100"},"segments":{"sn35.100:0.3":"Paṭisallānasuttaṃ","sn35.100:1.1":"“Paṭisallāne [paṭisallānaṃ (sī. pī. ka.), paṭisallīnā (syā. kaṃ.)], bhikkhave, yogamāpajjatha.","sn35.100:1.2":"Paṭisallīno, bhikkhave, bhikkhu yathābhūtaṃ pajānāti.","sn35.100:1.3":"Kiñca yathābhūtaṃ pajānāti?","sn35.100:1.4":"‘Cakkhu anicca’nti yathābhūtaṃ pajānāti;","sn35.100:1.5":"‘rūpā aniccā’ti yathābhūtaṃ pajānāti;","sn35.100:1.6":"‘cakkhuviññāṇaṃ anicca’nti yathābhūtaṃ pajānāti;","sn35.100:1.7":"‘cakkhusamphasso anicco’ti yathābhūtaṃ pajānāti.","sn35.100:1.8":"‘Yampidaṃ cakkhusamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi anicca’nti yathābhūtaṃ pajānāti…pe… ‘yampidaṃ manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi anicca’nti yathābhūtaṃ pajānāti.","sn35.100:1.9":"Paṭisallāne, bhikkhave, yogamāpajjatha.","sn35.100:1.10":"Paṭisallīno, bhikkhave, bhikkhu yathābhūtaṃ pajānātī”ti.","sn35.100:1.11":"Sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":177,"to":178,"paras":[{"para":177,"vripara":"100","refs":["sn35.100:1"],"lines":["Sattame <b>paṭisallāna</b>nti kāyavivekaṃ.","Idañhi suttaṃ kāyavivekena parihāyamāne disvā, “imesaṃ kāyavivekaṃ labhantānaṃ kammaṭṭhānaṃ phātiṃ gamissatī”ti ñatvā kathitaṃ. 8-9."],"lineRefs":[["sn35.100:1"],["sn35.100:1"]]},{"para":178,"vripara":null,"refs":["sn35.100:1"],"lines":["Paṭhamanatumhākaṃsuttādivaṇṇanā 101-102."],"lineRefs":[["sn35.100:1"]]}],"wordLinks":[],"before":[{"para":176,"vripara":null,"title":"Paṭisallānasuttavaṇṇanā","lines":["Paṭisallānasuttavaṇṇanā 100."]}]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":183,"to":184,"paras":[{"para":183,"vripara":"100","refs":["sn35.100:1"],"lines":["<b>Kammaṭṭhāna</b>nti samathavipassanākammaṭṭhānaṃ. 8-9."],"lineRefs":[["sn35.100:1"]]},{"para":184,"vripara":null,"refs":["sn35.100:1"],"lines":["Paṭhamanatumhākaṃsuttādivaṇṇanā 101-102."],"lineRefs":[["sn35.100:1"]]}],"wordLinks":[]},"tika2":null}
