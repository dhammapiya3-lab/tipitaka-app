{"suttaId":"sn35.237","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1147,1153],"vripara":"237"},"segments":{"sn35.237:0.3":"Dutiyahatthapādopamasuttaṃ","sn35.237:1.1":"“Hatthesu, bhikkhave, sati ādānanikkhepanaṃ hoti;","sn35.237:1.2":"pādesu sati abhikkamapaṭikkamo hoti;","sn35.237:1.3":"pabbesu sati samiñjanapasāraṇaṃ hoti;","sn35.237:1.4":"kucchismiṃ sati jighacchā pipāsā hoti.","sn35.237:1.5":"Evameva kho, bhikkhave, cakkhusmiṃ sati cakkhusamphassapaccayā uppajjati ajjhattaṃ sukhaṃ dukkhaṃ…pe…","sn35.237:1.6":"jivhāya sati…pe…","sn35.237:1.7":"manasmiṃ sati manosamphassapaccayā uppajjati ajjhattaṃ sukhaṃ dukkhaṃ…pe….","sn35.237:2.1":"“Hatthesu, bhikkhave, asati ādānanikkhepanaṃ na hoti;","sn35.237:2.2":"pādesu asati abhikkamapaṭikkamo na hoti;","sn35.237:2.3":"pabbesu asati samiñjanapasāraṇaṃ na hoti;","sn35.237:2.4":"kucchismiṃ asati jighacchā pipāsā na hoti.","sn35.237:2.5":"Evameva kho, bhikkhave, cakkhusmiṃ asati cakkhusamphassapaccayā nuppajjati ajjhattaṃ sukhaṃ dukkhaṃ…pe…","sn35.237:2.6":"jivhāya asati jivhāsamphassapaccayā nuppajjati…pe…","sn35.237:2.7":"manasmiṃ asati manosamphassapaccayā nuppajjati ajjhattaṃ sukhaṃ dukkha”nti.","sn35.237:2.8":"Dasamaṃ.","sn35.237:2.9":"Samuddavaggo aṭṭharasamo.","sn35.237:3.0":"Tassuddānaṃ –","sn35.237:3.1":"Dve samuddā bāḷisiko,","sn35.237:3.2":"khīrarukkhena koṭṭhiko;","sn35.237:3.3":"Kāmabhū udāyī ceva,","sn35.237:3.4":"ādittena ca aṭṭhamaṃ;","sn35.237:3.5":"Hatthapādūpamā dveti,","sn35.237:3.6":"vaggo tena pavuccatīti. 19."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":308,"to":311,"paras":[{"para":308,"vripara":"236-237","refs":["sn35.237:1"],"lines":["Navame <b>hatthesu, bhikkhave, satī</b>ti hatthesu vijjamānesu.","Dasame <b>na hotī</b>ti vuccamāne bujjhanakānaṃ ajjhāsayavasena vuttaṃ.","Dvīsupi cetesu vipākasukhadukkhameva dassetvā vaṭṭavivaṭṭaṃ kathitanti."],"lineRefs":[["sn35.237:1"],["sn35.237:1"],["sn35.237:1"]]},{"para":309,"vripara":null,"refs":["sn35.237:1"],"lines":["Samuddavaggo niṭṭhito. 19."],"lineRefs":[["sn35.237:1"]]},{"para":310,"vripara":null,"refs":["sn35.237:1"],"lines":["Āsīvisavaggo 1."],"lineRefs":[["sn35.237:1"]]},{"para":311,"vripara":null,"refs":["sn35.237:1"],"lines":["Āsīvisopamasuttavaṇṇanā 238."],"lineRefs":[["sn35.237:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":334,"to":338,"paras":[{"para":334,"vripara":"236-237","refs":["sn35.237:1"],"lines":["Navamaṃ “paññāyatī”ti vuccamāne bujjhanakānaṃ ajjhāsayavasena vuttanti āha –","<b>“dasame na hotīti vuccamāne”</b>tiādi.","Ettakameva hi dvinnaṃ suttānaṃ visesoti."],"lineRefs":[["sn35.237:1"],["sn35.237:1"],["sn35.237:1"]]},{"para":335,"vripara":null,"refs":["sn35.237:1"],"lines":["Paṭhamahatthapādopamasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.237:1"]]},{"para":336,"vripara":null,"refs":["sn35.237:1"],"lines":["Samuddavaggavaṇṇanā niṭṭhitā. 19."],"lineRefs":[["sn35.237:1"]]},{"para":337,"vripara":null,"refs":["sn35.237:1"],"lines":["Āsīvisavaggo 1."],"lineRefs":[["sn35.237:1"]]},{"para":338,"vripara":null,"refs":["sn35.237:1"],"lines":["Āsīvisopamasuttavaṇṇanā 238."],"lineRefs":[["sn35.237:1"]]}],"wordLinks":[],"after":[{"para":339,"vripara":"238","title":"Āsīvisopamasuttavaṇṇanā","lines":["Ye bhikkhū tadā bhagavantaṃ parivāretvā nisinnā, tesu keci ekavihārino, keci attadutiyā, keci attatatiyā, keci attacatutthā, keci attapañcamā hutvā araññāyatanesu viharantīti vuttaṃ –","<b>“ekacārika…pe… pañcacārike”</b>ti.","Samānajjhāsayatā <b>sabhāgavuttino</b>.","Kammaṭṭhānānuyuñjanassa <b>kārake</b>.","Tato eva tattha <b>yuttapayutte.</b>","<b>Puggalajjhāsayena</b> kāraṇabhūtena.","<b>Paccayabhūta</b>nti apassayabhūtaṃ.","“Seyyathāpi, bhikkhave”ti ārabhitvā yāva “tiṇṇo pāraṅgato thale tiṭṭhati brāhmaṇo”ti ayaṃ mātikānikkhepo.","Tesaṃ mātikāya vitthārabhājanaṃ.","<b>Vāsanā bhavissatī</b>ti vāsanāvahaṃ bhavissati.","<b>Sineruṃ ukkhipanto viyā</b>tiādi imissā desanāya anaññasādhāraṇatāya sudukkarabhāvadassanaṃ."]}]},"tika2":null}
