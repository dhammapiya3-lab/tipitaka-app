{"suttaId":"ja211","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1390,1396],"vripara":"121"},"segments":{"ja211:0.4":"Somadattajātakaṃ (2-7-1)","ja211:1.1":"Akāsi yoggaṃ dhuvamappamatto, saṃvaccharaṃ bīraṇathambhakasmiṃ;","ja211:1.3":"Byākāsi saññaṃ parisaṃ vigayha, na niyyamo tāyati appapaññaṃ.","ja211:2.1":"Dvayaṃ yācanako tāta, somadatta nigacchati;","ja211:2.3":"Alābhaṃ dhanalābhaṃ vā, evaṃ dhammā hi yācanāti.","ja211:3.1":"Somadattajātakaṃ paṭhamaṃ."},"attha":null,"tika":null}
