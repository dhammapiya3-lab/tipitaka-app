{"suttaId":"ja103","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[579,582],"vripara":"103"},"segments":{"ja103:0.4":"Verijātakaṃ","ja103:1.1":"Yattha verī nivisati [nivasati (sī. ka.)],","ja103:1.2":"na vase tattha paṇḍito;","ja103:1.3":"Ekarattaṃ dirattaṃ vā,","ja103:1.4":"dukkhaṃ vasati verisūti.","ja103:2.1":"Verijātakaṃ tatiyaṃ. 104."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2526,"to":2526,"paras":[{"para":2526,"vripara":null,"refs":["ja103:1"],"lines":["Tattha <b>verī</b>ti veracetanāsamaṅgipuggalo.","<b>Nivisatī</b>ti patiṭṭhāti.","<b>Na vase tattha paṇḍito</b>ti so verīpuggalo yasmiṃ ṭhāne patiṭṭhito hutvā vasati, tattha paṇḍito paṇḍiccena samannāgato na vaseyya.","Kiṃkāraṇā?","<b>Ekarattaṃ dirattaṃ vā, dukkhaṃ vasati verisū</b>ti, verīnañhi antare vasanto ekāhampi dvīhampi dukkhameva vasatīti attho."],"lineRefs":[["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"]]}],"wordLinks":[["ja103:1.1","verī",0,0],["ja103:1.3","verī",0,0],["ja103:1.1","nivisatī",0,1],["ja103:1.1","na vase tattha paṇḍito",0,2],["ja103:1.3","ekarattaṃ dirattaṃ vā dukkhaṃ vasati verisū",0,4]],"after":[{"para":2527,"vripara":null,"title":"[103] 3. Verijātakavaṇṇanā","lines":["Evaṃ mahāsatto udānaṃ udānetvā dānādīni puññāni katvā yathākammaṃ gato."]},{"para":2528,"vripara":null,"title":"[103] 3. Verijātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā ahameva bārāṇasiseṭṭhi ahosi”nti."]},{"para":2529,"vripara":null,"title":"[103] 3. Verijātakavaṇṇanā","lines":["Verijātakavaṇṇanā tatiyā. [104] 4."]},{"para":2531,"vripara":null,"title":"[104] 4. Mittavindakajātakavaṇṇanā","lines":["Mittavindakajātakavaṇṇanā"]},{"para":2532,"vripara":null,"title":"[104] 4. Mittavindakajātakavaṇṇanā","lines":["<b>Catubbhi aṭṭhajjhagamā</b>ti idaṃ satthā jetavane viharanto ekaṃ dubbacabhikkhuṃ ārabbha kathesi.","Vatthu heṭṭhā mittavindakajātake vuttanayena vitthāretabbaṃ.","Idaṃ pana jātakaṃ kassapabuddhakālikaṃ.","Tasmiñhi kāle uracakkaṃ ukkhipitvā niraye paccamāno eko nerayikasatto “bhante, kiṃ nu kho pāpakammaṃ akāsi”nti bodhisattaṃ pucchi.","Bodhisatto “tayā idañcidañca pāpakammaṃ kata”nti vatvā imaṃ gāthamāha – 104."]},{"para":2534,"vripara":"104","title":"[104] 4. Mittavindakajātakavaṇṇanā","lines":["“Catubbhi aṭṭhajjhagamā, aṭṭhāhipi ca soḷasa;"]},{"para":2535,"vripara":null,"title":"[104] 4. Mittavindakajātakavaṇṇanā","lines":["Soḷasāhi ca bāttiṃsa, atricchaṃ cakkamāsado;"]},{"para":2536,"vripara":null,"title":"[104] 4. Mittavindakajātakavaṇṇanā","lines":["Icchāhatassa posassa, cakkaṃ bhamati matthake”ti."]}]},"tika":{"book":"Ja-ṭ-i","bookName":"Jātaka-abhinavaṭīkā-1","vriCode":"","from":1267,"to":1269,"paras":[{"para":1267,"vripara":null,"refs":["ja103:1"],"lines":["3-verijātakavaṇṇanā (103)"],"lineRefs":[["ja103:1"]]},{"para":1268,"vripara":null,"refs":["ja103:1"],"lines":["<b>pājetvā</b>ti uyyojetvā.","<b>avilumpamānā [avilambamānā. jā. ṭṭha. 1. 437] </b>ti yāva avilumpamānā.","tāva attano vasanaṭṭhānameva gamiṃsu.","vīranaṃ virundhanaṃ veraṃ.","cetanā.","taṃ etassa atthīti verī.","taṃsamaṅgīpuggalo.","tenāha “verīti veracetanāsamaṅgīpuggalo”ti.","<b>ekarattaṃ dvirattaṃ [dirattaṃ vā.(chaṭṭha)] vā</b>ti ettha samāse i-kārassa a-kārattaṃ.","ratti-saddo idha ahasaddapariyāyo.","tenāha “ekāhampi dvīhampī”ti.","<b>verīsū</b>ti ettha sāmīatthe bhummavacanaṃ.","tañca “antare”-ti ajjhoharitabbapadena sambandhitabbanti dassetuṃ “verīna”nti ādimāhāti."],"lineRefs":[["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"],["ja103:1"]]},{"para":1269,"vripara":null,"refs":["ja103:1"],"lines":["verījātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja103:1"]]}],"wordLinks":[]},"tika2":null}
