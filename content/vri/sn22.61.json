{"suttaId":"sn22.61","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[347,347],"vripara":"61"},"segments":{"sn22.61:0.3":"Ādittasuttaṃ","sn22.61:1.1":"Sāvatthinidānaṃ.","sn22.61:1.2":"“Rūpaṃ, bhikkhave, ādittaṃ, vedanā ādittā, saññā ādittā, saṅkhārā ādittā, viññāṇaṃ ādittaṃ.","sn22.61:1.3":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako rūpasmimpi nibbindati, vedanāyapi … saññāyapi … saṅkhāresupi … viññāṇasmimpi nibbindati.","sn22.61:1.4":"Nibbindaṃ virajjati; virāgā vimuccati. Vimuttasmiṃ vimuttamiti ñāṇaṃ hoti.","sn22.61:1.5":"‘Khīṇā jāti, vusitaṃ brahmacariyaṃ, kataṃ karaṇīyaṃ, nāparaṃ itthattāyā’ti pajānātī”ti.","sn22.61:1.6":"Navamaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":163,"to":163,"paras":[{"para":163,"vripara":"61","refs":["sn22.61:1"],"lines":["Navame <b>ādittan</b>ti ekādasahi aggīhi ādittaṃ pajjalitaṃ.","Iti dvīsupi imesu suttesu dukkhalakkhaṇameva kathitaṃ.","Navamaṃ."],"lineRefs":[["sn22.61:1"],["sn22.61:1"],["sn22.61:1"]]}],"wordLinks":[["sn22.61:1.2","ādittaṃ",0,0]],"before":[{"para":162,"vripara":null,"refs":[],"lines":["Ādittasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":168,"to":170,"paras":[{"para":168,"vripara":"61","refs":["sn22.61:1"],"lines":["<b>Ekādasahī</b>ti rāgādīhi upāyāsapariyosānehi ekādasahi santāpanaṭṭhena aggīhi.","<b>Dvīsū</b>ti aṭṭhamanavamesu.","<b>Dukkhalakkhaṇamevā</b>ti tabbahulatāya tappadhānatāya ca vuttaṃ."],"lineRefs":[["sn22.61:1"],["sn22.61:1"],["sn22.61:1"]]},{"para":169,"vripara":null,"refs":["sn22.61:1"],"lines":["Ādittasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.61:1"]]},{"para":170,"vripara":null,"refs":["sn22.61:1"],"lines":["Niruttipathasuttavaṇṇanā"],"lineRefs":[["sn22.61:1"]]}],"wordLinks":[]},"tika2":null}
