{"suttaId":"thag3.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1306,1324],"vripara":"264"},"segments":{"thag3.16:0.4":"Vimalattheragāthā","thag3.16:1.1":"“Pāpamitte vivajjetvā, bhajeyyuttamapuggalaṃ;","thag3.16:1.3":"Ovāde cassa tiṭṭheyya, patthento acalaṃ sukhaṃ.","thag3.16:2.1":"“Parittaṃ dārumāruyha, yathā sīde mahaṇṇave;","thag3.16:2.3":"Evaṃ kusītamāgamma, sādhujīvīpi sīdati;","thag3.16:2.5":"Tasmā taṃ parivajjeyya, kusītaṃ hīnavīriyaṃ.","thag3.16:3.1":"“Pavivittehi ariyehi, pahitattehi jhāyibhi;","thag3.16:3.3":"Niccaṃ āraddhavīriyehi, paṇḍitehi sahāvase”ti.","thag3.16:3.5":"… Vimalo thero ….","thag3.16:3.6":"Tikanipāto niṭṭhito.","thag3.16:4.0":"Tatruddānaṃ –","thag3.16:4.1":"Aṅgaṇiko bhāradvājo, paccayo bākulo isi;","thag3.16:4.3":"Dhaniyo mātaṅgaputto, sobhito vāraṇo isi.","thag3.16:5.1":"Vassiko ca yasojo ca, sāṭimattiyupāli ca;","thag3.16:5.3":"Uttarapālo abhibhūto, gotamo hāritopi ca.","thag3.16:6.1":"Thero tikanipātamhi, nibbāne vimalo kato;","thag3.16:6.3":"Aṭṭhatālīsa gāthāyo, therā soḷasa kittitāti."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":5399,"to":5406,"paras":[{"para":5399,"vripara":"264","refs":["thag3.16:1"],"lines":["“Pāpamitte vivajjetvā, bhajeyyuttamapuggalaṃ;"],"lineRefs":[["thag3.16:1"]]},{"para":5400,"vripara":null,"refs":[],"lines":["Ovāde cassa tiṭṭheyya, patthento acalaṃ sukhaṃ."],"lineRefs":[[]]},{"para":5402,"vripara":"265","refs":["thag3.16:2"],"lines":["“Parittaṃ dārumāruyha, yathā sīde mahaṇṇave;"],"lineRefs":[["thag3.16:2"]]},{"para":5403,"vripara":null,"refs":[],"lines":["Evaṃ kusītamāgamma, sādhujīvīpi sīdati;"],"lineRefs":[[]]},{"para":5404,"vripara":null,"refs":[],"lines":["Tasmā taṃ parivajjeyya, kusītaṃ hīnavīriyaṃ."],"lineRefs":[[]]},{"para":5406,"vripara":"266","refs":["thag3.16:3"],"lines":["“Pavivittehi ariyehi, pahitattehi jhāyibhi;"],"lineRefs":[["thag3.16:3"]]}],"wordLinks":[]},"tika":null}
