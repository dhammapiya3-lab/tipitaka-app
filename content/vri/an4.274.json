{"suttaId":"an4.274","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1940,1940],"vripara":"274"},"segments":{"an4.274:0.3":"Satipaṭṭhānasuttaṃ","an4.274:1.1":"“Rāgassa, bhikkhave, abhiññāya cattāro dhammā bhāvetabbā.","an4.274:1.2":"Katame cattāro?","an4.274:1.3":"Idha, bhikkhave, bhikkhu kāye kāyānupassī viharati ātāpī sampajāno satimā vineyya loke abhijjhādomanassaṃ;","an4.274:1.4":"vedanāsu … pe … citte … pe … dhammesu dhammānupassī viharati ātāpī sampajāno satimā vineyya loke abhijjhādomanassaṃ.","an4.274:1.5":"Rāgassa, bhikkhave, abhiññāya ime cattāro dhammā bhāvetabbā”ti.","an4.274:1.6":"Paṭhamaṃ."},"unsure":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1720,"to":1720,"paras":[{"para":1720,"vripara":"274-783","refs":["an4.274:1"],"lines":["274-783. Rāgapeyyālaṃ arahattaṃ pāpetvā kathitaṃ.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["an4.274:1"],["an4.274:1"]]}],"wordLinks":[],"after":[{"para":1721,"vripara":null,"lines":["Manorathapūraṇiyā aṅguttaranikāya-aṭṭhakathāya"]},{"para":1722,"vripara":null,"lines":["Catukkanipātassa saṃvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
