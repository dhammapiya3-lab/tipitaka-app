{"suttaId":"thag16.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[3206,3278],"vripara":"818"},"segments":{"thag16.6:0.4":"Selattheragāthā","thag16.6:1.1":"“Paripuṇṇakāyo suruci,","thag16.6:1.2":"sujāto cārudassano;","thag16.6:1.3":"Suvaṇṇavaṇṇosi bhagavā,","thag16.6:1.4":"susukkadāṭhosi vīriyavā [susukkadāṭho virīyavā (sī.)]. 819.","thag16.6:2.1":"“Narassa hi sujātassa,","thag16.6:2.2":"ye bhavanti viyañjanā;","thag16.6:2.3":"Sabbe te tava kāyasmiṃ,","thag16.6:2.4":"mahāpurisalakkhaṇā. 820.","thag16.6:3.1":"“Pasannanetto sumukho,","thag16.6:3.2":"brahā uju patāpavā;","thag16.6:3.3":"Majjhe samaṇasaṅghassa,","thag16.6:3.4":"ādiccova virocasi. 821.","thag16.6:4.1":"“Kalyāṇadassano bhikkhu,","thag16.6:4.2":"kañcanasannibhattaco;","thag16.6:4.3":"Kiṃ te samaṇabhāvena,","thag16.6:4.4":"evaṃ uttamavaṇṇino. 822.","thag16.6:5.1":"“Rājā arahasi bhavituṃ,","thag16.6:5.2":"cakkavattī rathesabho;","thag16.6:5.3":"Cāturanto vijitāvī,","thag16.6:5.4":"jambusaṇḍassa [jambumaṇḍassa (ka.)] issaro. 823.","thag16.6:6.1":"“Khattiyā bhogī rājāno [bhogā rājāno (sī. ka.), bhojarājāno (syā.)],","thag16.6:6.2":"anuyantā bhavanti te;","thag16.6:6.3":"Rājābhirājā [rājādhirājā (sī. ka.)] manujindo,","thag16.6:6.4":"rajjaṃ kārehi gotama”. 824.","thag16.6:7.1":"“Rājāhamasmi sela,","thag16.6:7.2":"(selāti bhagavā)","thag16.6:7.3":"dhammarājā anuttaro;","thag16.6:7.4":"Dhammena cakkaṃ vattemi,","thag16.6:7.5":"cakkaṃ appaṭivattiyaṃ”. 825.","thag16.6:8.1":"“Sambuddho paṭijānāsi,","thag16.6:8.2":"(iti selo brāhmaṇo)","thag16.6:8.3":"dhammarājā anuttaro;","thag16.6:8.4":"‘Dhammena cakkaṃ vattemi’,","thag16.6:8.5":"iti bhāsatha gotama. 826.","thag16.6:9.1":"“Ko nu senāpati bhoto,","thag16.6:9.2":"sāvako satthuranvayo [anvayo (sī.)];","thag16.6:9.3":"Ko tetamanuvatteti,","thag16.6:9.4":"dhammacakkaṃ pavattitaṃ”. 827.","thag16.6:10.1":"“Mayā pavattitaṃ cakkaṃ,","thag16.6:10.2":"(selāti bhagavā)","thag16.6:10.3":"dhammacakkaṃ anuttaraṃ;","thag16.6:10.4":"Sāriputto anuvatteti,","thag16.6:10.5":"anujāto tathāgataṃ. 828.","thag16.6:11.1":"“Abhiññeyyaṃ abhiññātaṃ,","thag16.6:11.2":"bhāvetabbañca bhāvitaṃ;","thag16.6:11.3":"Pahātabbaṃ pahīnaṃ me,","thag16.6:11.4":"tasmā buddhosmi brāhmaṇa. 829.","thag16.6:12.1":"“Vinayassu mayi kaṅkhaṃ,","thag16.6:12.2":"adhimuñcassu brāhmaṇa;","thag16.6:12.3":"Dullabhaṃ dassanaṃ hoti,","thag16.6:12.4":"sambuddhānaṃ abhiṇhaso. 830.","thag16.6:13.1":"“Yesaṃ ve dullabho loke,","thag16.6:13.2":"pātubhāvo abhiṇhaso;","thag16.6:13.3":"Sohaṃ brāhmaṇa buddhosmi,","thag16.6:13.4":"sallakatto [sallakanto (sī.)] anuttaro. 831.","thag16.6:14.1":"“Brahmabhūto atitulo,","thag16.6:14.2":"mārasenappamaddano;","thag16.6:14.3":"Sabbāmitte vase [vasī (syā. ka., ma. ni. 2.399; su. ni. 966)] katvā,","thag16.6:14.4":"modāmi akutobhayo”. 832.","thag16.6:15.1":"“Idaṃ bhonto nisāmetha,","thag16.6:15.2":"yathā bhāsati cakkhumā;","thag16.6:15.3":"Sallakatto mahāvīro,","thag16.6:15.4":"sīhova nadatī vane. 833.","thag16.6:16.1":"“Brahmabhūtaṃ atitulaṃ,","thag16.6:16.2":"mārasenappamaddanaṃ;","thag16.6:16.3":"Ko disvā nappasīdeyya,","thag16.6:16.4":"api kaṇhābhijātiko. 834.","thag16.6:17.1":"“Yo maṃ icchati anvetu,","thag16.6:17.2":"yo vā nicchati gacchatu;","thag16.6:17.3":"Idhāhaṃ pabbajissāmi,","thag16.6:17.4":"varapaññassa santike”. 835.","thag16.6:18.1":"“Etaṃ ce ruccati bhoto,","thag16.6:18.2":"sammāsambuddhasāsanaṃ;","thag16.6:18.3":"Mayampi pabbajissāma,","thag16.6:18.4":"varapaññassa santike. 836.","thag16.6:19.1":"“Brāhmaṇā tisatā ime,","thag16.6:19.2":"yācanti pañjalīkatā;","thag16.6:19.3":"‘Brahmacariyaṃ carissāma,","thag16.6:19.4":"bhagavā tava santike’”. 837.","thag16.6:20.1":"“Svākhātaṃ brahmacariyaṃ,","thag16.6:20.2":"(selāti bhagavā)","thag16.6:20.3":"sandiṭṭhikamakālikaṃ;","thag16.6:20.4":"Yattha amoghā pabbajjā,","thag16.6:20.5":"appamattassa sikkhato”. 838.","thag16.6:21.1":"“Yaṃ taṃ saraṇamāgamha [saraṇamāgamma (sabbattha)],","thag16.6:21.2":"ito aṭṭhame [aṭṭhami (syā. ka.)] cakkhuma;","thag16.6:21.3":"Sattarattena bhagavā,","thag16.6:21.4":"dantāmha tava sāsane. 839.","thag16.6:22.1":"“Tuvaṃ buddho tuvaṃ satthā,","thag16.6:22.2":"tuvaṃ mārābhibhū muni;","thag16.6:22.3":"Tuvaṃ anusaye chetvā,","thag16.6:22.4":"tiṇṇo tāresimaṃ pajaṃ. 840.","thag16.6:23.1":"“Upadhī te samatikkantā,","thag16.6:23.2":"āsavā te padālitā;","thag16.6:23.3":"Sīhova anupādāno,","thag16.6:23.4":"pahīnabhayabheravo. 841.","thag16.6:24.1":"“Bhikkhavo tisatā ime,","thag16.6:24.2":"tiṭṭhanti pañjalīkatā;","thag16.6:24.3":"Pāde vīra pasārehi,","thag16.6:24.4":"nāgā vandantu satthuno”ti. …","thag16.6:24.5":"Selo thero…. 7."},"unsure":[],"preface":[],"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":3661,"to":3721,"paras":[{"para":3661,"vripara":null,"refs":["thag16.6:6"],"lines":["<b>Khattiyā</b>ti jātikhattiyā.","<b>Bhogī</b>ti bhogiyā.","<b>Rājāno</b>ti ye keci rajjaṃ kārentā.","<b>Anuyantā</b>ti anugāmino sevakā.","<b>Rājābhirājā</b>ti rājūnaṃ pūjanīyo rājā hutvā, cakkavattīti adhippāyo.","<b>Manujindo</b>ti manussādhipati, manussānaṃ paramissaroti attho."],"lineRefs":[["thag16.6:6"],["thag16.6:6"],["thag16.6:6"],["thag16.6:6"],["thag16.6:6"],["thag16.6:6"]]},{"para":3662,"vripara":null,"refs":["thag16.6:6"],"lines":["Evaṃ selena vutte bhagavā “ye te bhavanti arahanto sammāsambuddhā, te sake vaṇṇe bhaññamāne attānaṃ pātukarontī”ti imaṃ selassa manorathaṃ pūrento – 824."],"lineRefs":[["thag16.6:6"]]},{"para":3664,"vripara":"824","refs":["thag16.6:6"],"lines":["“Rājāhamasmi sela, (selāti bhagavā) dhammarājā anuttaro;"],"lineRefs":[["thag16.6:6"]]},{"para":3665,"vripara":null,"refs":["thag16.6:6"],"lines":["Dhammena cakkaṃ vattemi, cakkaṃ appaṭivattiya”nti. –","imaṃ gāthamāha;"],"lineRefs":[["thag16.6:6"],["thag16.6:6"]]},{"para":3666,"vripara":null,"refs":["thag16.6:7"],"lines":["Tatrāyaṃ adhippāyo – yaṃ maṃ tvaṃ, sela, yācasi, “rājā arahasi bhavituṃ cakkavattī”ti, ettha appossukko hohi, <b>rājāhamasmi,</b> sati ca rājatte yathā añño rājā samānopi yojanasataṃ vā anusāsati, dve tīṇi cattāri pañca yojanasatāni vā yojanasahassaṃ vā cakkavattī hutvāpi catudīpapariyantamattaṃ vā, nāhamevaṃ paricchinnavisayo.","Ahañhi <b>dhammarājā anuttaro</b> bhavaggato avīcipariyantaṃ katvā tiriyaṃ aparimeyyalokadhātuyo anusāsāmi.","Yāvatā hi apadādibhedā sattā, ahaṃ tesaṃ aggo.","Na hi me koci sīlena vā…pe… vimuttiñāṇadassanena vā sadiso natthi, kuto bhiyyo.","Svāhaṃ evaṃ dhammarājā anuttaro, anuttareneva catusatipaṭṭhānādibhedabodhipakkhiyasaṅkhātena <b>dhammena cakkaṃ vattemi,</b> “idaṃ pajahatha, idaṃ upasampajja viharathā”tiādinā āṇācakkaṃ.","“Idaṃ kho pana, bhikkhave, dukkhaṃ ariyasacca”ntiādinā (mahāva. 14; saṃ. ni. 5.1081) pariyattidhammena dhammacakkameva vā.","<b>Cakkaṃ appaṭivattiya</b>nti yaṃ cakkaṃ appaṭivattiyaṃ hoti samaṇena vā…pe… kenaci vā lokasminti."],"lineRefs":[["thag16.6:7"],["thag16.6:7"],["thag16.6:7"],["thag16.6:7"],["thag16.6:7"],["thag16.6:7"],["thag16.6:7"]]},{"para":3667,"vripara":null,"refs":["thag16.6:7"],"lines":["Evaṃ attānamāvikarontaṃ bhagavantaṃ disvā pītisomanassajāto selo puna daḷhīkaraṇatthaṃ – 825."],"lineRefs":[["thag16.6:7"]]},{"para":3669,"vripara":"825","refs":["thag16.6:7"],"lines":["“Sambuddho paṭijānāsi, (iti selo brāhmaṇo) dhammarājā anuttaro;"],"lineRefs":[["thag16.6:7"]]},{"para":3670,"vripara":null,"refs":["thag16.6:7"],"lines":["Dhammena cakkaṃ vattemi, iti bhāsatha gotama. 826."],"lineRefs":[["thag16.6:7"]]},{"para":3672,"vripara":"826","refs":["thag16.6:7"],"lines":["“Ko nu senāpati bhoto, sāvako satthuranvayo;"],"lineRefs":[["thag16.6:7"]]},{"para":3673,"vripara":null,"refs":["thag16.6:7"],"lines":["Ko tetamanuvatteti, dhammacakkaṃ pavattita”nti. –","gāthādvayamāha;"],"lineRefs":[["thag16.6:7"],["thag16.6:7"]]},{"para":3674,"vripara":null,"refs":["thag16.6:9"],"lines":["Tattha <b>ko nu senāpatī</b>ti dhammarañño bhoto dhammena pavattitassa cakkassa anupavattanako senāpati ko nūti pucchi."],"lineRefs":[["thag16.6:9"]]},{"para":3675,"vripara":null,"refs":["thag16.6:9"],"lines":["Tena ca samayena bhagavato dakkhiṇapasse āyasmā sāriputto nisinno hoti, suvaṇṇapuñjo viya siriyā sobhamāno.","Taṃ dassento bhagavā – 827."],"lineRefs":[["thag16.6:9"],["thag16.6:9"]]},{"para":3677,"vripara":"827","refs":["thag16.6:9"],"lines":["“Mayā pavattitaṃ cakkaṃ, (selāti bhagavā) dhammacakkaṃ anuttaraṃ;"],"lineRefs":[["thag16.6:9"]]},{"para":3678,"vripara":null,"refs":["thag16.6:9"],"lines":["Sāriputto anuvatteti, anujāto tathāgata”nti. –","gāthamāha;"],"lineRefs":[["thag16.6:9"],["thag16.6:9"]]},{"para":3679,"vripara":null,"refs":["thag16.6:10"],"lines":["Tattha <b>anujāto tathāgata</b>nti, tathāgataṃ anujāto, tathā gatena hetunā ariyāya jātiyā jātoti attho."],"lineRefs":[["thag16.6:10"]]},{"para":3680,"vripara":null,"refs":["thag16.6:10"],"lines":["Evaṃ “ko nu senāpati bhoto”ti selena vuttapañhaṃ byākaritvā yaṃ selo āha “sambuddho paṭijānāsī”ti tattha naṃ nikkaṅkhaṃ kātukāmo “nāhaṃ paṭiññāmatteneva paṭijānāmi, api cāhaṃ iminā kāraṇena buddho”ti ñāpetuṃ – 828."],"lineRefs":[["thag16.6:10"]]},{"para":3682,"vripara":"828","refs":["thag16.6:10"],"lines":["“Abhiññeyyaṃ abhiññātaṃ, bhāvetabbañca bhāvitaṃ;"],"lineRefs":[["thag16.6:10"]]},{"para":3683,"vripara":null,"refs":["thag16.6:10"],"lines":["Pahātabbaṃ pahīnaṃ me, tasmā buddhosmi brāhmaṇā”ti. –","gāthamāha;"],"lineRefs":[["thag16.6:10"],["thag16.6:10"]]},{"para":3684,"vripara":null,"refs":["thag16.6:11"],"lines":["Tattha <b>abhiññeyya</b>nti cattāri saccāni cattāri ariyasaccāni.","Catunnañhi saccānaṃ ariyasaccānañca sāmaññaggahaṇametaṃ yadidaṃ abhiññeyyanti.","Tattha ariyasaccesu yaṃ bhāvetabbaṃ maggasaccaṃ, yañca pahātabbaṃ samudayasaccaṃ, tadubhayaggahaṇena tesaṃ phalabhūtāni nirodhasaccadukkhasaccānipi gahitāneva honti hetuggahaṇeneva phalasiddhito.","Tena tattha “sacchikātabbaṃ sacchikataṃ, pariññeyyaṃ pariññāta”nti idampi vuttameva hoti.","“Abhiññeyyaṃ abhiññāta”nti vā iminā ca sabbassapi ñeyyassa abhiññātasambuddhabhāvaṃ uddesavasena pakāsetvā tadekadesaṃ niddesavasena dassento <b>“bhāvetabbañca bhāvita”</b>ntiādimāha.","Atha vā <b>“bhāvetabbaṃ bhāvitaṃ, pahātabbaṃ pahīna”</b>nti iminā attano ñāṇapahānasampadākittanamukhena taṃmūlakattā sabbepi buddhaguṇā kittitā hontīti āha <b>“tasmā buddhosmi, brāhmaṇā”</b>ti.","Abhiññeyyaabhiññātaggahaṇena hi sabbaso vijjāvimuttīnaṃ gahitattā saphalaṃ catusaccabhāvaṃ saddhiṃ hetusampattiyā dassento bujjhitabbaṃ sabbaṃ bujjhitvā buddho jātosmīti ñāyena hetunā attano buddhabhāvaṃ vibhāveti."],"lineRefs":[["thag16.6:11"],["thag16.6:11"],["thag16.6:11"],["thag16.6:11"],["thag16.6:11"],["thag16.6:11"],["thag16.6:11"]]},{"para":3685,"vripara":null,"refs":["thag16.6:11"],"lines":["Evaṃ nippariyāyena attānaṃ pātukaritvā attani kaṅkhāvitaraṇatthaṃ brāhmaṇaṃ ussāhento – 829."],"lineRefs":[["thag16.6:11"]]},{"para":3687,"vripara":"829","refs":["thag16.6:11"],"lines":["“Vinayassu mayi kaṅkhaṃ, adhimuccassu brāhmaṇa;"],"lineRefs":[["thag16.6:11"]]},{"para":3688,"vripara":null,"refs":["thag16.6:11"],"lines":["Dullabhaṃ dassanaṃ hoti, sambuddhānaṃ abhiṇhaso. 830."],"lineRefs":[["thag16.6:11"]]},{"para":3690,"vripara":"830","refs":["thag16.6:11"],"lines":["“Yesaṃ ve dullabho loke, pātubhāvo abhiṇhaso;"],"lineRefs":[["thag16.6:11"]]},{"para":3691,"vripara":null,"refs":["thag16.6:11"],"lines":["Sohaṃ brāhmaṇa buddhosmi, sallakatto anuttaro. 831."],"lineRefs":[["thag16.6:11"]]},{"para":3693,"vripara":"831","refs":["thag16.6:11"],"lines":["“Brahmabhūto atitulo, mārasenappamaddano;"],"lineRefs":[["thag16.6:11"]]},{"para":3694,"vripara":null,"refs":["thag16.6:11"],"lines":["Sabbāmitte vase katvā, modāmi akutobhayo”ti. –","gāthattayamāha;"],"lineRefs":[["thag16.6:11"],["thag16.6:11"]]},{"para":3695,"vripara":null,"refs":["thag16.6:11","thag16.6:14"],"lines":["Tattha <b>vinayassū</b>ti vinehi chinda.","<b>Kaṅkha</b>nti vicikicchaṃ.","<b>Adhimuccassū</b>ti adhimokkhaṃ kara “sammāsambuddho”ti saddaha.","<b>Dullabhaṃ dassanaṃ hoti, sambuddhāna</b>nti yato kappānaṃ asaṅkhyeyyampi buddhasuñño loko hoti.","<b>Sallakatto</b>ti, rāgādisallakattano.","<b>Brahmabhūto</b>ti seṭṭhabhūto.","<b>Atitulo</b>ti tulaṃ atīto, nirupamoti attho.","<b>Mārasenappamaddano</b>ti “kāmā te paṭhamā senā”ti (su. ni. 438; mahāni. 28; cūḷani. nandamāṇavapucchāniddesa 47) evaṃ āgatāya mārasenāya pamaddano.","<b>Sabbāmitte</b>ti khandhakilesābhisaṅkhāramaccudevaputtamārasaṅkhāte sabbapaccatthike.","<b>Vase katvā</b>ti attano vase katvā.","<b>Modāmi akutobhayo</b>ti kutoci nibbhayo samādhisukhena, phalanibbānasukhena ca modāmi."],"lineRefs":[["thag16.6:11"],["thag16.6:11"],["thag16.6:11"],["thag16.6:11"],["thag16.6:11"],["thag16.6:14"],["thag16.6:14"],["thag16.6:14"],["thag16.6:14"],["thag16.6:14"],["thag16.6:14"]]},{"para":3696,"vripara":null,"refs":["thag16.6:14"],"lines":["Evaṃ vutte selo brāhmaṇo tāvadeva bhagavati sañjātapasādo pabbajjāpekkho hutvā – 832."],"lineRefs":[["thag16.6:14"]]},{"para":3698,"vripara":"832","refs":["thag16.6:14"],"lines":["“Idaṃ bhonto nisāmetha, yathā bhāsati cakkhumā;"],"lineRefs":[["thag16.6:14"]]},{"para":3699,"vripara":null,"refs":["thag16.6:14"],"lines":["Sallakatto mahāvīro, sīhova nadatī vane. 833."],"lineRefs":[["thag16.6:14"]]},{"para":3701,"vripara":"833","refs":["thag16.6:14"],"lines":["“Brahmabhūtaṃ atitulaṃ, mārasenappamaddanaṃ;"],"lineRefs":[["thag16.6:14"]]},{"para":3702,"vripara":null,"refs":["thag16.6:14"],"lines":["Ko disvā nappasīdeyya, api kaṇhābhijātiko. 834."],"lineRefs":[["thag16.6:14"]]},{"para":3704,"vripara":"834","refs":["thag16.6:14"],"lines":["“Yo maṃ icchati anvetu, yo vā nicchati gacchatu;"],"lineRefs":[["thag16.6:14"]]},{"para":3705,"vripara":null,"refs":["thag16.6:14"],"lines":["Idhāhaṃ pabbajissāmi, varapaññassa santike”ti. –"],"lineRefs":[["thag16.6:14"]]},{"para":3706,"vripara":null,"refs":["thag16.6:14"],"lines":["Gāthattayamāha.","Yathā taṃ paripākagatāya upanissayasampattiyā codiyamāno."],"lineRefs":[["thag16.6:14"],["thag16.6:14"]]},{"para":3707,"vripara":null,"refs":["thag16.6:14"],"lines":["Tattha <b>kaṇhābhijātiko</b>ti, nīcajātiko, tamotamaparāyaṇabhāve ṭhito."],"lineRefs":[["thag16.6:14"]]},{"para":3708,"vripara":null,"refs":["thag16.6:14"],"lines":["Tato tepi māṇavakā hetusampannatāya tattheva pabbajjāpekkhā hutvā – 835."],"lineRefs":[["thag16.6:14"]]},{"para":3710,"vripara":"835","refs":["thag16.6:14"],"lines":["“Etaṃ ce ruccati bhoto, sammāsambuddhasāsanaṃ;"],"lineRefs":[["thag16.6:14"]]},{"para":3711,"vripara":null,"refs":["thag16.6:14"],"lines":["Mayampi pabbajissāma, varapaññassa santike”ti. –"],"lineRefs":[["thag16.6:14"]]},{"para":3712,"vripara":null,"refs":["thag16.6:14"],"lines":["Gāthamāhaṃsu, yathā taṃ tena saddhiṃ katādhikārā kulaputtā."],"lineRefs":[["thag16.6:14"]]},{"para":3713,"vripara":null,"refs":["thag16.6:14"],"lines":["Atha selo tesu māṇavakesu tuṭṭhacitto te dassento pabbajjañca yācamāno – 836."],"lineRefs":[["thag16.6:14"]]},{"para":3715,"vripara":"836","refs":["thag16.6:14"],"lines":["“Brāhmaṇā tisatā ime, yācanti pañjalīkatā;"],"lineRefs":[["thag16.6:14"]]},{"para":3716,"vripara":null,"refs":["thag16.6:14"],"lines":["Brahmacariyaṃ carissāma, bhagavā tava santike”ti. –","gāthamāha;"],"lineRefs":[["thag16.6:14"],["thag16.6:14"]]},{"para":3717,"vripara":null,"refs":["thag16.6:14"],"lines":["Tato bhagavā yasmā selo heṭṭhā vuttanayena padumuttarassa bhagavato kāle tesaṃyeva tiṇṇaṃ purisasatānaṃ gaṇajeṭṭho hutvā ropitakusalamūlo, idāni pacchimabhavepi tesaṃyeva ācariyo hutvā nibbatto, ñāṇañcassa tesañca paripakkaṃ, ehibhikkhubhāvassa ca upanissayo atthi, tasmā te sabbeva ehibhikkhubhāvena pabbajjāya pabbājento – 837."],"lineRefs":[["thag16.6:14"]]},{"para":3719,"vripara":"837","refs":["thag16.6:14"],"lines":["“Svākhātaṃ brahmacariyaṃ, (selāti bhagavā) sandiṭṭhikamakālikaṃ;"],"lineRefs":[["thag16.6:14"]]},{"para":3720,"vripara":null,"refs":["thag16.6:14"],"lines":["Yattha amoghā pabbajjā, appamattassa sikkhato”ti. –","gāthamāha;"],"lineRefs":[["thag16.6:14"],["thag16.6:14"]]},{"para":3721,"vripara":null,"refs":["thag16.6:20"],"lines":["Tattha <b>sandiṭṭhika</b>nti paccakkhaṃ.","<b>Akālika</b>nti maggānantaraphaluppattito na kālantare pattabbaphalaṃ.","<b>Yatthā</b>ti yaṃnimittā.","Maggabrahmacariyanimittā hi pabbajjā amoghā anipphalā, yatthāti vā yasmiṃ sāsane <b>appamattassa</b> sativippavāsarahitassa tīsu sikkhāsu <b>sikkhato</b>."],"lineRefs":[["thag16.6:20"],["thag16.6:20"],["thag16.6:20"],["thag16.6:20"]]}],"wordLinks":[["thag16.6:6.1","khattiyā",0,0],["thag16.6:6.1","bhogī",0,1],["thag16.6:6.1","rājāno",0,2],["thag16.6:6.1","anuyantā",0,3],["thag16.6:6.3","rājābhirājā",0,4],["thag16.6:6.3","manujindo",0,5],["thag16.6:7.1","rājāhamasmi",4,0],["thag16.6:7.1","dhammarājā anuttaro",4,1],["thag16.6:7.4","dhammena cakkaṃ vattemi",4,4],["thag16.6:7.4","cakkaṃ appaṭivattiyaṃ",4,6],["thag16.6:9.1","ko nu senāpatī",10,0],["thag16.6:10.4","anujāto tathāgataṃ",14,0],["thag16.6:11.1","abhiññeyyaṃ",18,0],["thag16.6:11.1","bhāvetabbañca bhāvitaṃ",18,4],["thag16.6:11.3","tasmā buddhosmi brāhmaṇā",18,5],["thag16.6:14.1","brahmabhūto",26,5],["thag16.6:14.1","atitulo",26,6],["thag16.6:14.1","mārasenappamaddano",26,7],["thag16.6:14.3","sabbāmitte",26,8],["thag16.6:14.3","vase katvā",26,9],["thag16.6:14.3","modāmi akutobhayo",26,10],["thag16.6:20.1","sandiṭṭhikaṃ",46,0],["thag16.6:20.1","akālikaṃ",46,1],["thag16.6:20.4","yatthā",46,2],["thag16.6:20.4","appamattassa",46,3],["thag16.6:20.4","sikkhato",46,3]],"before":[{"para":3633,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Selattheragāthāvaṇṇanā"]},{"para":3634,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["<b>Paripuṇṇakāyo</b>tiādikā āyasmato selattherassa gāthā.","Kā uppatti?","Ayaṃ kira padumuttarabhagavato kāle kulagehe nibbattitvā viññutaṃ patto gaṇapāmokkho hutvā tīṇi purisasatāni samādapetvā tehi saddhiṃ satthu gandhakuṭiṃ kāretvā katapariyositāya gandhakuṭiyā sabhikkhusaṅghassa bhagavato mahādānaṃ pavattetvā satthāraṃ bhikkhū ca ticīvarena acchādesi.","So tena puññakammena ekaṃ buddhantaraṃ devaloke eva vasitvā tato cuto devamanussesu saṃsaranto imasmiṃ buddhuppāde aṅguttarāpesu āpaṇe nāma brāhmaṇagāme brāhmaṇakule nibbattitvā <b>selo</b>ti laddhanāmo ahosi.","So vayappatto tīsu vedesu, brāhmaṇasippesu ca nipphattiṃ gantvā tīṇi māṇavakasatāni mante vācento āpaṇe paṭivasati.","Tena ca samayena satthā sāvatthito nikkhamitvā aḍḍhateḷasahi bhikkhusatehi saddhiṃ aṅguttarāpesu cārikaṃ caranto selassa, antevāsikānañca ñāṇaparipākaṃ disvā aññatarasmiṃ vanasaṇḍe viharati.","Atha keṇiyo nāma jaṭilo satthu āgamanaṃ sutvā tattha gantvā saddhiṃ bhikkhusaṅghena satthāraṃ svātanāya nimantetvā sake assame pahūtaṃ khādanīyaṃ bhojanīyaṃ paṭiyādeti.","Tasmiñca samaye selo brāhmaṇo saddhiṃ tīhi māṇavakasatehi jaṅghāvihāraṃ anuvicaranto keṇiyassa assamaṃ pavisitvā jaṭile kaṭṭhaphālanuddhanasampādanādinā dānūpakaraṇaṃ sajjente disvā, “kiṃ nu kho te, keṇiya, mahāyañño paccupaṭṭhito”tiādiṃ pucchitvā tena “buddho bhagavā mayā svātanāya nimantito”ti vutte “buddho”ti vacanaṃ sutvāva haṭṭho udaggo pītisomanassajāto tāvadeva māṇavakehi saddhiṃ satthāraṃ upasaṅkamitvā katapaṭisanthāro ekamantaṃ nisinno bhagavato kāye bāttiṃsamahāpurisalakkhaṇāni disvā “imehi lakkhaṇehi samannāgato rājā vā hoti cakkavattī, buddho vā loke vivaṭṭacchado, ayaṃ pana pabbajito, no ca kho naṃ jānāmi ‘buddho vā, no vā’, sutaṃ kho pana metaṃ brāhmaṇānaṃ vuddhānaṃ mahallakānaṃ ācariyapācariyānaṃ bhāsamānānaṃ ‘ye te bhavanti arahanto sammāsambuddhā, te sake vaṇṇe bhaññamāne attānaṃ pātukarontī’ti asammāsambuddho hi sammukhe ṭhatvā buddhaguṇehi abhitthavīyamāno sārajjati maṅkubhāvaṃ āpajjati avesārajjappattatāya ananuyogakkhamattā, yaṃnūnāhaṃ samaṇaṃ gotamaṃ sammukhā sāruppāhi gāthāhi abhitthaveyya”nti evaṃ pana cintetvā – 818."]},{"para":3636,"vripara":"818","title":"Selattheragāthāvaṇṇanā","lines":["“Paripuṇṇakāyo suruci, sujāto cārudassano;"]},{"para":3637,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Suvaṇṇavaṇṇosi bhagavā, susukkadāṭhosi vīriyavā. 819."]},{"para":3639,"vripara":"819","title":"Selattheragāthāvaṇṇanā","lines":["“Narassa hi sujātassa, ye bhavanti viyañjanā;"]},{"para":3640,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sabbe te tava kāyasmiṃ, mahāpurisalakkhaṇā. 820."]},{"para":3642,"vripara":"820","title":"Selattheragāthāvaṇṇanā","lines":["“Pasannanetto sumukho, brahā uju patāpavā;"]},{"para":3643,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Majjhe samaṇasaṅghassa, ādiccova virocasi. 821."]},{"para":3645,"vripara":"821","title":"Selattheragāthāvaṇṇanā","lines":["“Kalyāṇadassano bhikkhu, kañcanasannibhattaco;"]},{"para":3646,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Kiṃ te samaṇabhāvena, evaṃ uttamavaṇṇino. 822."]},{"para":3648,"vripara":"822","title":"Selattheragāthāvaṇṇanā","lines":["“Rājā arahasi bhavituṃ, cakkavattī rathesabho;"]},{"para":3649,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Cāturanto vijitāvī, jambusaṇḍassa issaro. 823."]},{"para":3651,"vripara":"823","title":"Selattheragāthāvaṇṇanā","lines":["“Khattiyā bhogī rājāno, anuyantā bhavanti te;"]},{"para":3652,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Rājābhirājā manujindo, rajjaṃ kārehi gotamā”ti. –"]},{"para":3653,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Chahi gāthāhi bhagavantaṃ abhitthavi."]},{"para":3654,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tattha <b>paripuṇṇakāyo</b>ti abhibyattarūpānaṃ dvattiṃsāya mahāpurisalakkhaṇānaṃ paripuṇṇatāya ahīnaṅgapaccaṅgatāya ca paripuṇṇasarīro.","<b>Surucī</b>ti sundarasarīrappabho.","<b>Sujāto</b>ti ārohapariṇāhasampattiyā, saṇṭhānasampattiyā ca sunibbatto.","<b>Cārudassano</b>ti sucirampi passantānaṃ atittijanakaṃ appaṭikkūlaṃ ramaṇīyaṃ cāru eva dassanaṃ assāti cārudassano.","Keci panāhu “cārudassanoti sundaranetto”ti.","<b>Suvaṇṇavaṇṇo</b>ti suvaṇṇasadisavaṇṇo.","<b>Asī</b>ti bhavasi, idaṃ padaṃ “paripuṇṇakāyo asī”tiādinā sabbapadehi yojetabbaṃ.","<b>Susukkadāṭho</b>ti suṭṭhu sukkadāṭho.","Bhagavato hi dāṭhāhi candakiraṇā viya dhavalarasmiyo niccharanti.","<b>Vīriyavā</b>ti vīriyapāramīpāripūriyā caturaṅgasamannāgatavīriyādhiṭṭhānato catubbidhassa sammappadhānassa sampattiyā ca atisayayutto."]},{"para":3655,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["<b>Narassa hi sujātassā</b>ti samatiṃsāya pāramīnaṃ, ariyassa vā cakkavattīvattassa paripūritattā suṭṭhu sammadeva jātassa narassa, mahāpurisassāti attho.","<b>Sabbe te</b>ti ye mahāpurisabhāvaṃ loke aggapuggalabhāvaṃ byañjayantīti <b>byañjanā</b>ti laddhavohārasuppatiṭṭhitapādatādibāttiṃsamahāpurisalakkhaṇasaṅkhātā tambanakhatuṅganakhatādiasītianubyañjanasaṅkhātā ca rūpaguṇā, te anavasesā, tava kāyasmiṃ santīti vacanaseso."]},{"para":3656,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["<b>Mahāpurisalakkhaṇā</b>ti pubbe vuttabyañjanāneva vacanantarena nigamento āha."]},{"para":3657,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Idāni tesu lakkhaṇesu attanā abhirucitehi lakkhaṇehi bhagavantaṃ thomento <b>“pasannanetto”</b>tiādimāha.","Bhagavā hi pañca vaṇṇapasādasampattiyā <b>pasannanetto</b>.","Paripuṇṇacandamaṇḍalasadisamukhatāya <b>sumukho</b>.","Ārohapariṇāhasampattiyā <b>brahā</b>.","Brahmujugattatāya <b>uju</b>.","Jutimantatāya <b>patāpavā</b>."]},{"para":3658,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Idāni tameva patāpavantataṃ ādiccūpamāya vibhāvento <b>“majjhe samaṇasaṅghassā”</b>tiādimāha.","Tattha <b>ādiccova virocasī</b>ti yathā ādicco uggacchanto sabbaṃ tamagataṃ vidhametvā ālokaṃ karonto virocati, evaṃ tvampi anto ceva bahi ca sabbaṃ avijjātamaṃ viddhaṃsetvā ñāṇālokaṃ karonto virocasi."]},{"para":3659,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Dassanīyarūpatāya aṅgīgatānaṃ dassanasampattīnaṃ āvahanato, kalyāṇehi pañcahi dassanehi samannāgatattā ca <b>kalyāṇadassano.</b>","<b>Uttamavaṇṇino</b>ti uttamavaṇṇasampannassa."]},{"para":3660,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["<b>Cakkavattī</b>ti cakkaratanaṃ vatteti, catūhi sampatticakkehi vatteti, tehi ca pare vatteti.","Parahitāya iriyāpathacakkānaṃ vatto etasmiṃ atthīti cakkavattī.","Atha vā catūhi acchariyadhammehi ca saṅgahavatthūhi ca samannāgamena parehi anabhibhavanīyassa āṇācakkassa vatto etasmiṃ atthītipi cakkavattī.","<b>Rathesabho</b>ti rathikesu ājānīyausabhapuriso, mahārathikoti attho.","<b>Cāturanto</b>ti catusamuddantāya pathaviyā issaro.","<b>Vijitāvī</b>ti vijitavijayo.","<b>Jambusaṇḍassā</b>ti jambudīpassa, pākaṭena hi issariyāni dassento evamāha.","Cakkavattī pana saparittadīpānaṃ catunnampi mahādīpānaṃ issarova."]}],"after":[{"para":3722,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Evañca vatvā “etha, bhikkhavo”ti bhagavā avoca.","Tāvadeva te sabbe iddhimayapattacīvaradharā hutvā saṭṭhivassikattherā viya bhagavantaṃ abhivādetvā parivāresuṃ.","So evaṃ pabbajitvā vipassanāya kammaṃ karonto sattame divase sapariso arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.40.208-303) –"]},{"para":3723,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Nagare haṃsavatiyā, vīthisāmī ahosahaṃ;"]},{"para":3724,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Mama ñātī samānetvā, idaṃ vacanamabraviṃ."]},{"para":3725,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Buddho loke samuppanno, puññakkhetto anuttaro;"]},{"para":3726,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Āsi so sabbalokassa, āhutīnaṃ paṭiggaho."]},{"para":3727,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Khattiyā negamā ceva, mahāsālā ca brāhmaṇā;"]},{"para":3728,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pasannacittā sumanā, pūgadhammaṃ akaṃsu te."]},{"para":3729,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Hatthārohā anīkaṭṭhā, rathikā pattikārakā;"]},{"para":3730,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pasannacittā sumanā, pūgadhammaṃ akaṃsu te."]},{"para":3731,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Uggā ca rājaputtā ca, vesiyānā ca brāhmaṇā;"]},{"para":3732,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pasannacittā sumanā, pūgadhammaṃ akaṃsu te."]},{"para":3733,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Āḷārikā kappakā ca, nhāpakā mālakārakā;"]},{"para":3734,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pasannacittā sumanā, pūgadhammaṃ akaṃsu te."]},{"para":3735,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Rajakā pesakārā ca, cammakārā ca nhāpitā;"]},{"para":3736,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pasannacittā sumanā, pūgadhammaṃ akaṃsu te."]},{"para":3737,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Usukārā bhamakārā, cammakārā ca tacchakā;"]},{"para":3738,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pasannacittā sumanā, pūgadhammaṃ akaṃsu te."]},{"para":3739,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Kammārā soṇṇakārā ca, tipulohakarā tathā;"]},{"para":3740,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pasannacittā sumanā, pūgadhammaṃ akaṃsu te."]},{"para":3741,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Bhatakā ceṭakā ceva, dāsakammakarā bahū;"]},{"para":3742,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Yathāsakena thāmena, pūgadhammaṃ akaṃsu te."]},{"para":3743,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Udahārā kaṭṭhahārā, kassakā tiṇahārakā;"]},{"para":3744,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Yathāsakena thāmena, pūgadhammaṃ akaṃsu te."]},{"para":3745,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Pupphikā mālikā ceva, paṇṇikā phalahārakā;"]},{"para":3746,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Yathāsakena thāmena, pūgadhammaṃ akaṃsu te."]},{"para":3747,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Gaṇikā kumbhadāsī ca, pūvikā macchikāpi ca;"]},{"para":3748,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Yathāsakena thāmena, pūgadhammaṃ akaṃsu te."]},{"para":3749,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Etha sabbe samāgantvā, gaṇaṃ bandhāma ekato;"]},{"para":3750,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Adhikāraṃ karissāma, puññakkhette anuttare."]},{"para":3751,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Te me sutvāna vacanaṃ, gaṇaṃ bandhiṃsu tāvade;"]},{"para":3752,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Upaṭṭhānasālaṃ sukataṃ, bhikkhusaṅghassa kārayuṃ."]},{"para":3753,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Niṭṭhāpetvāna taṃ sālaṃ, udaggo tuṭṭhamānaso;"]},{"para":3754,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pareto tehi sabbehi, sambuddhamupasaṅkamiṃ."]},{"para":3755,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Upasaṅkamma sambuddhaṃ, lokanāthaṃ narāsabhaṃ;"]},{"para":3756,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Vanditvā satthuno pāde, idaṃ vacanamabraviṃ."]},{"para":3757,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Ime tīṇi satā vīra, purisā ekato gaṇā;"]},{"para":3758,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Upaṭṭhānasālaṃ sukataṃ, niyyādenti tuvaṃ muni."]},{"para":3759,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Bhikkhusaṅghassa purato, sampaṭicchatva cakkhumā;"]},{"para":3760,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tiṇṇaṃ satānaṃ purato, imā gāthā abhāsatha."]},{"para":3761,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Tisatāpi ca jeṭṭho ca, anuvattiṃsu ekato;"]},{"para":3762,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sampattiñhi karitvāna, sabbe anubhavissatha."]},{"para":3763,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Pacchime bhave sampatte, sītibhāvamanuttaraṃ;"]},{"para":3764,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Ajaraṃ amataṃ santaṃ, nibbānaṃ phassayissatha."]},{"para":3765,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Evaṃ buddho viyākāsi, sabbaññū samaṇuttaro;"]},{"para":3766,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Buddhassa vacanaṃ sutvā, somanassaṃ pavedayiṃ."]},{"para":3767,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Tiṃsakappasahassāni, devaloke ramiṃ ahaṃ;"]},{"para":3768,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Devādhipo pañcasataṃ, devarajjamakārayiṃ."]},{"para":3769,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Sahassakkhattuṃ rājā ca, cakkavattī ahosahaṃ;"]},{"para":3770,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Devarajjaṃ karontassa, mahādevā avandisuṃ."]},{"para":3771,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Idha mānusake rajjaṃ, parisā honti bandhavā;"]},{"para":3772,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pacchime bhave sampatte, vāseṭṭho nāma brāhmaṇo."]},{"para":3773,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Asītikoṭi nicayo, tassa putto ahosahaṃ;"]},{"para":3774,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Selo iti mamaṃ nāmaṃ, chaḷaṅge pāramiṃ gato."]},{"para":3775,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Jaṅghāvihāraṃ vicaraṃ, sasissehi purakkhato;"]},{"para":3776,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Jaṭābhārikabharitaṃ, keṇiyaṃ nāma tāpasaṃ."]},{"para":3777,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Paṭiyattāhutiṃ disvā, idaṃ vacanamabraviṃ;"]},{"para":3778,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Āvāho vā vivāho vā, rājā vā te nimantito."]},{"para":3779,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Āhutiṃ yiṭṭhukāmohaṃ, brāhmaṇe devasammate;"]},{"para":3780,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Na nimantemi rājānaṃ, āhutī me na vijjati."]},{"para":3781,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Na catthi mayhamāvāho, vivāho me na vijjati;"]},{"para":3782,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sakyānaṃ nandijanano, seṭṭho loke sadevake."]},{"para":3783,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Sabbalokahitatthāya, sabbasattasukhāvaho;"]},{"para":3784,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["So me nimantito ajja, tassetaṃ paṭiyādanaṃ."]},{"para":3785,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Timbarūsakavaṇṇābho, appameyyo anūpamo;"]},{"para":3786,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Rūpenāsadiso buddho, svātanāya nimantito."]},{"para":3787,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Ukkāmukhapahaṭṭhova, khadiraṅgārasannibho;"]},{"para":3788,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Vijjūpamo mahāvīro, so me buddho nimantito."]},{"para":3789,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Pabbatagge yathā acci, puṇṇamāyeva candimā;"]},{"para":3790,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Naḷaggivaṇṇasaṅkāso, so me buddho nimantito."]},{"para":3791,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Asambhīto bhayātīto, bhavantakaraṇo muni;"]},{"para":3792,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sīhūpamo mahāvīro, so me buddho nimantito."]},{"para":3793,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Kusalo buddhadhammehi, apasayho parehi so;"]},{"para":3794,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Nāgūpamo mahāvīro, so me buddho nimantito."]},{"para":3795,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Saddhammācārakusalo, buddhanāgo asādiso;"]},{"para":3796,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Usabhūpamo mahāvīro, so me buddho nimantito."]},{"para":3797,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Anantavaṇṇo amitayaso, vicittasabbalakkhaṇo;"]},{"para":3798,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sakkūpamo mahāvīro, so me buddho nimantito."]},{"para":3799,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Vasī gaṇī patāpī ca, tejassī ca durāsado;"]},{"para":3800,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Brahmūpamo mahāvīro, so me buddho nimantito."]},{"para":3801,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Pattadhammo dasabalo, balātibalapārago;"]},{"para":3802,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Dharaṇūpamo mahāvīro, so me buddho nimantito."]},{"para":3803,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Sīlavīcisamākiṇṇo, dhammaviññāṇakhobhito;"]},{"para":3804,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Udadhūpamo mahāvīro, so me buddho nimantito."]},{"para":3805,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Durāsado duppasaho, acalo uggato brahā;"]},{"para":3806,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Nerūpamo mahāvīro, so me buddho nimantito."]},{"para":3807,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Anantañāṇo asamasamo, atulo aggataṃ gato;"]},{"para":3808,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Gaganūpamo mahāvīro, so me buddho nimantito."]},{"para":3809,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Patiṭṭhā bhayabhītānaṃ, tāṇo saraṇagāminaṃ;"]},{"para":3810,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Assāsako mahāvīro, so me buddho nimantito."]},{"para":3811,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Āsayo buddhimantānaṃ, puññakkhettaṃ sukhesinaṃ;"]},{"para":3812,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Ratanākaro mahāvīro, so me buddho nimantito."]},{"para":3813,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Assāsako vedakaro, sāmaññaphaladāyako;"]},{"para":3814,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Meghūpamo mahāvīro, so me buddho nimantito."]},{"para":3815,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Lokacakkhu mahātejo, sabbatamavinodano;"]},{"para":3816,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sūriyūpamo mahāvīro, so me buddho nimantito."]},{"para":3817,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Ārammaṇavimuttīsu, sabhāvadassano muni;"]},{"para":3818,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Candūpamo mahāvīro, so me buddho nimantito."]},{"para":3819,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Buddho samussito loke, lakkhaṇehi alaṅkato;"]},{"para":3820,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Appameyyo mahāvīro, so me buddho nimantito."]},{"para":3821,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Yassa ñāṇaṃ appameyyaṃ, sīlaṃ yassa anūpamaṃ;"]},{"para":3822,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Vimutti asadisā yassa, so me buddho nimantito."]},{"para":3823,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Yassa dhīti asadisā, thāmo yassa acintiyo;"]},{"para":3824,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Yassa parakkamo jeṭṭho, so me buddho nimantito."]},{"para":3825,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Rāgo doso ca moho ca, visā sabbe samūhatā;"]},{"para":3826,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Agadūpamo mahāvīro, so me buddho nimantito."]},{"para":3827,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Klesabyādhibahudukkha-sabbatamavinodano;"]},{"para":3828,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Vejjūpamo mahāvīro, so me buddho nimantito."]},{"para":3829,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Buddhoti bho yaṃ vadesi, ghosopeso sudullabho;"]},{"para":3830,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Buddho buddhoti sutvāna, pīti me udapajjatha."]},{"para":3831,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Abbhantaraṃ agaṇhantaṃ, pīti me bahi nicchare;"]},{"para":3832,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sohaṃ pītimano santo, idaṃ vacanamabraviṃ."]},{"para":3833,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Kahaṃ nu kho so bhagavā, lokajeṭṭho narāsabho;"]},{"para":3834,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tattha gantvā namassissaṃ, sāmaññaphaladāyakaṃ."]},{"para":3835,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Paggayha dakkhiṇaṃ bāhuṃ, vedajāto katañjalī;"]},{"para":3836,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Ācikkhi me dhammarājaṃ, sokasallavinodanaṃ."]},{"para":3837,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Udentaṃva mahāmeghaṃ, nīlaṃ añjanasannibhaṃ;"]},{"para":3838,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sāgaraṃ viya dissantaṃ, passasetaṃ mahāvanaṃ."]},{"para":3839,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Ettha so vasate buddho, adantadamako muni;"]},{"para":3840,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Vinayanto ca veneyye, bodhento bodhipakkhiye."]},{"para":3841,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Pipāsitova udakaṃ, bhojanaṃva jighacchito;"]},{"para":3842,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Gāvī yathā vacchagiddhā, evāhaṃ viciniṃ jinaṃ."]},{"para":3843,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Ācāraupacāraññū, dhammānucchavisaṃvaraṃ;"]},{"para":3844,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sikkhāpemi sake sisse, gacchante jinasantikaṃ."]},{"para":3845,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Durāsadā bhagavanto, sīhāva ekacārino;"]},{"para":3846,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pade padaṃ nikkhipantā, āgaccheyyātha māṇavā."]},{"para":3847,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Āsīviso yathā ghoro, migarājāva kesarī;"]},{"para":3848,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Mattova kuñjaro dantī, evaṃ buddhā durāsadā."]},{"para":3849,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Ukkāsitañca khipitaṃ, ajjhupekkhiya māṇavā;"]},{"para":3850,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pade padaṃ nikkhipantā, upetha buddhasantikaṃ."]},{"para":3851,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Paṭisallānagarukā, appasaddā durāsadā;"]},{"para":3852,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Durūpasaṅkamā buddhā, garū honti sadevake."]},{"para":3853,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Yadāhaṃ pañhaṃ pucchāmi, paṭisammodayāmi vā;"]},{"para":3854,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Appasaddā tadā hotha, munibhūtāva tiṭṭhatha."]},{"para":3855,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Yaṃ so deseti sambuddho, khemaṃ nibbānapattiyā;"]},{"para":3856,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tamevatthaṃ nisāmetha, saddhammasavanaṃ sukhaṃ."]},{"para":3857,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Upasaṅkamma sambuddhaṃ, sammodiṃ muninā ahaṃ;"]},{"para":3858,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Taṃ kathaṃ vītisāretvā, lakkhaṇe upadhārayiṃ."]},{"para":3859,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Lakkhaṇe dve ca kaṅkhāmi, passāmi tiṃsalakkhaṇe;"]},{"para":3860,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Kosohitavatthaguyhaṃ, iddhiyā dassayī muni."]},{"para":3861,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Jivhaṃ ninnāmayitvāna, kaṇṇasote ca nāsike;"]},{"para":3862,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Paṭimasi nalāṭantaṃ, kevalaṃ chādayī jino."]},{"para":3863,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Tassāhaṃ lakkhaṇe disvā, paripuṇṇe sabyañjane;"]},{"para":3864,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Buddhoti niṭṭhaṃ gantvāna, saha sissehi pabbajiṃ."]},{"para":3865,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Satehi tīhi sahito, pabbajiṃ anagāriyaṃ;"]},{"para":3866,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Aḍḍhamāse asampatte, sabbe pattāmha nibbutiṃ."]},{"para":3867,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Ekato kammaṃ katvāna, puññakkhette anuttare;"]},{"para":3868,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Ekato saṃsaritvāna, ekato vinivattayuṃ."]},{"para":3869,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Gopānasiyo datvāna, pūgadhamme vasiṃ ahaṃ"]},{"para":3870,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tena kammena sukatena, aṭṭha hetū labhāmahaṃ."]},{"para":3871,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Disāsu pūjito homi, bhogā ca amitā mama;"]},{"para":3872,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Patiṭṭhā homi sabbesaṃ, tāso mama na vijjati."]},{"para":3873,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Byādhayo me na vijjanti, dīghāyuṃ pālayāmi ca;"]},{"para":3874,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sukhumacchaviko homi, āvāse patthite vase."]},{"para":3875,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Aṭṭha gopānasī datvā, pūgadhamme vasiṃ ahaṃ;"]},{"para":3876,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Paṭisambhidārahattañca, etaṃ me aparaṭṭhamaṃ."]},{"para":3877,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Sabbavositavosāno, katakicco anāsavo;"]},{"para":3878,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Aṭṭha gopānasī nāma, tava putto mahāmuni."]},{"para":3879,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Pañca thambhāni datvāna, pūgadhamme vasiṃ ahaṃ;"]},{"para":3880,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tena kammena sukatena, pañca hetū labhāmahaṃ."]},{"para":3881,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Acalo homi mettāya, anūnaṅgo bhavāmahaṃ;"]},{"para":3882,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Ādeyyavacano homi, na dhaṃsemi yathā ahaṃ."]},{"para":3883,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Abhantaṃ hoti me cittaṃ, akhilo homi kassaci;"]},{"para":3884,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tena kammena sukatena, vimalo homi sāsane."]},{"para":3885,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Sagāravo sappatisso, katakicco anāsavo;"]},{"para":3886,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sāvako te mahāvīra, bhikkhu taṃ vandate muni."]},{"para":3887,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Katvā sukatapallaṅkaṃ, sālāyaṃ paññapesahaṃ;"]},{"para":3888,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tena kammena sukatena, pañca hetū labhāmahaṃ."]},{"para":3889,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Ucce kule pajāyitvā, mahābhogo bhavāmahaṃ;"]},{"para":3890,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sabbasampattiko homi, maccheraṃ me na vijjati."]},{"para":3891,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Gamane patthite mayhaṃ, pallaṅko upatiṭṭhati;"]},{"para":3892,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Saha pallaṅkaseṭṭhena, gacchāmi mama patthitaṃ."]},{"para":3893,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Tena pallaṅkadānena, tamaṃ sabbaṃ vinodayiṃ;"]},{"para":3894,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sabbābhiññābalappatto, thero vandati taṃ muni."]},{"para":3895,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Parikiccattakiccāni, sabbakiccāni sādhayiṃ;"]},{"para":3896,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tena kammena sukatena, pāvisiṃ abhayaṃ puraṃ."]},{"para":3897,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Pariniṭṭhitasālamhi, paribhogamadāsahaṃ;"]},{"para":3898,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tena kammena sukatena, seṭṭhattaṃ ajjhupāgato."]},{"para":3899,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Ye keci damakā loke, hatthiasse damenti ye;"]},{"para":3900,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Karitvā kāraṇā nānā, dāruṇena damenti te."]},{"para":3901,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Na hevaṃ tvaṃ mahāvīra, damesi naranāriyo;"]},{"para":3902,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Adaṇḍena asatthena, damesi uttame dame."]},{"para":3903,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Dānassa vaṇṇe kittento, desanākusalo muni;"]},{"para":3904,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Ekapañhaṃ kathentova, bodhesi tisate muni."]},{"para":3905,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Dantā mayaṃ sārathinā, suvimuttā anāsavā;"]},{"para":3906,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sabbābhiññābalapattā, nibbutā upadhikkhaye."]},{"para":3907,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Satasahassito kappe, yaṃ dānamadadiṃ tadā;"]},{"para":3908,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Atikkantā bhayā sabbe, sālādānassidaṃ phalaṃ."]},{"para":3909,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti."]},{"para":3910,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Arahattaṃ pana patvā satthāraṃ upasaṅkamitvā aññaṃ byākaronto – 838."]},{"para":3912,"vripara":"838","title":"Selattheragāthāvaṇṇanā","lines":["“Yaṃ taṃ saraṇamāgamha, ito aṭṭhame cakkhuma;"]},{"para":3913,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sattarattena bhagavā, dantāmha tava sāsane”ti. –"]},{"para":3914,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Gāthamāha.","Tassattho – pañcahi cakkhūhi <b>cakkhuma</b> bhagavā yasmā mayaṃ ito atīte <b>aṭṭhame</b> divase taṃ saraṇaṃ <b>agamimha</b>.","Tasmā sattarattena tava sāsane damakena <b>dantā amha,</b> aho <b>te</b> saraṇagamanassa ānubhāvoti.","Tato paraṃ – 839."]},{"para":3916,"vripara":"839","title":"Selattheragāthāvaṇṇanā","lines":["“Tuvaṃ buddho tuvaṃ satthā, tuvaṃ mārābhibhū muni;"]},{"para":3917,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tuvaṃ anusaye chetvā, tiṇṇo tāresimaṃ pajaṃ. 840."]},{"para":3919,"vripara":"840","title":"Selattheragāthāvaṇṇanā","lines":["“Upadhī te samatikkantā, āsavā te padālitā;"]},{"para":3920,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Sīhova anupādāno, pahīnabhayabheravo”ti. –"]},{"para":3921,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Imāhi dvīhi gāthāhi abhitthavitvā osānagāthāya satthāraṃ vandanaṃ yācati – 841."]},{"para":3923,"vripara":"841","title":"Selattheragāthāvaṇṇanā","lines":["“Bhikkhavo tisatā ime, tiṭṭhanti pañjalīkatā;"]},{"para":3924,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Pāde vīra pasārehi, nāgā vandantu satthuno”ti."]},{"para":3925,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Tattha <b>tuvaṃ buddho</b>ti tvameva imasmiṃ loke sabbaññubuddho.","Diṭṭhadhammikādiatthena sattānaṃ anusāsanato tvameva <b>satthā</b>.","Sabbesaṃ mārānaṃ abhibhavanato <b>mārābhibhū</b>.","Munibhāvato <b>muni.</b>","<b>Anusaye</b> <b>chetvā</b>ti kāmarāgādike anusaye ariyamaggasatthena chinditvā.","<b>Tiṇṇo</b>ti sayaṃ saṃsāramahoghaṃ tiṇṇo, desanāhatthena imaṃ <b>pajaṃ</b> sattakāyaṃ tāresi.","<b>Upadhī</b>ti khandhūpadhiādayo sabbe upadhī.","<b>Adupādāno</b>ti sabbaso pahīnakāmupādānādiko.","Evaṃ vatvā thero sapariso satthāraṃ abhivandatīti."]},{"para":3926,"vripara":null,"title":"Selattheragāthāvaṇṇanā","lines":["Selattheragāthāvaṇṇanā niṭṭhitā. 7."]}]},"tika":null,"tika2":null}
