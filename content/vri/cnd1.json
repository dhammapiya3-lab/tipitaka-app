{"suttaId":"cnd1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Nidd-ii","vriCode":"s0516m.mul","paras":[7,177],"vripara":"1"},"segments":{"cnd1:0.4":"Vatthugāthā","cnd1:1.1":"Kosalānaṃ purā rammā,","cnd1:1.2":"agamā dakkhiṇāpathaṃ;","cnd1:1.3":"Ākiñcaññaṃ patthayāno,","cnd1:1.4":"brāhmaṇo mantapāragū. 2.","cnd1:2.1":"So assakassa visaye,","cnd1:2.2":"maḷakassa [aḷakassa (su. ni. 983) muḷakassa (syā.), mūḷhakassa (ka.)] samāsane [samāsanne (ka.)];","cnd1:2.3":"Vasi godhāvarīkūle,","cnd1:2.4":"uñchena ca phalena ca. 3.","cnd1:3.1":"Tasseva [taṃyeva (ka.) aṭṭhakathā oloketabbā] upanissāya,","cnd1:3.2":"gāmo ca vipulo ahu;","cnd1:3.3":"Tato jātena āyena,","cnd1:3.4":"mahāyaññamakappayi. 4.","cnd1:4.1":"Mahāyaññaṃ yajitvāna,","cnd1:4.2":"puna pāvisi assamaṃ;","cnd1:4.3":"Tasmiṃ paṭipaviṭṭhamhi,","cnd1:4.4":"añño āgañchi brāhmaṇo. 5.","cnd1:5.1":"Ugghaṭṭapādo tasito [tassito (ka.)],","cnd1:5.2":"paṅkadanto rajassiro;","cnd1:5.3":"So ca naṃ upasaṅkamma,","cnd1:5.4":"satāni pañca yācati. 6.","cnd1:6.1":"Tamenaṃ bāvarī disvā,","cnd1:6.2":"āsanena nimantayi;","cnd1:6.3":"Sukhañca kusalaṃ pucchi,","cnd1:6.4":"idaṃ vacanamabravi [vacanamabruvi (sī.)]. 7.","cnd1:7.1":"“Yaṃ kho mama deyyadhammaṃ,","cnd1:7.2":"sabbaṃ visajjitaṃ mayā;","cnd1:7.3":"Anujānāhi me brahme,","cnd1:7.4":"natthi pañcasatāni me”. 8.","cnd1:8.1":"“Sace me yācamānassa,","cnd1:8.2":"bhavaṃ nānupadassati [padessati (ka.)];","cnd1:8.3":"Sattame divase tuyhaṃ,","cnd1:8.4":"muddhā phalatu sattadhā”. 9.","cnd1:9.1":"Abhisaṅkharitvā kuhako,","cnd1:9.2":"bheravaṃ so akittayi;","cnd1:9.3":"Tassa taṃ vacanaṃ sutvā,","cnd1:9.4":"bāvarī dukkhito ahu. 10.","cnd1:10.1":"Ussussati anāhāro,","cnd1:10.2":"sokasallasamappito;","cnd1:10.3":"Athopi evaṃ cittassa,","cnd1:10.4":"jhāne na ramatī mano. 11.","cnd1:11.1":"Utrastaṃ dukkhitaṃ disvā,","cnd1:11.2":"devatā atthakāminī;","cnd1:11.3":"Bāvariṃ upasaṅkamma,","cnd1:11.4":"idaṃ vacanamabravi. 12.","cnd1:12.1":"“Na so muddhaṃ pajānāti,","cnd1:12.2":"kuhako so dhanatthiko;","cnd1:12.3":"Muddhani muddhapāte [muddhanimmuddhapāte (ka.)] vā,","cnd1:12.4":"ñāṇaṃ tassa na vijjati”. 13.","cnd1:13.1":"“Bhotī [bhoti (ka.)] carahi jānāti,","cnd1:13.2":"taṃ me akkhāhi pucchitā;","cnd1:13.3":"Muddhaṃ muddhādhipātañca [muddhātipātañca (ka.)],","cnd1:13.4":"taṃ suṇoma vaco tava”. 14.","cnd1:14.1":"“Ahampetaṃ na jānāmi,","cnd1:14.2":"ñāṇaṃ mettha na vijjati;","cnd1:14.3":"Muddhani muddhādhipāte ca,","cnd1:14.4":"jinānañhettha [janānañhettha (ka.)] dassanaṃ”. 15.","cnd1:15.1":"“Atha ko carahi [yo carati (ka.)] jānāti,","cnd1:15.2":"asmiṃ pathavimaṇḍale [puthavimaṇḍale (sī.)];","cnd1:15.3":"Muddhaṃ muddhādhipātañca,","cnd1:15.4":"taṃ me akkhāhi devate”. 16.","cnd1:16.1":"“Purā kapilavatthumhā,","cnd1:16.2":"nikkhanto lokanāyako;","cnd1:16.3":"Apacco okkākarājassa,","cnd1:16.4":"sakyaputto pabhaṅkaro. 17.","cnd1:17.1":"“So hi brāhmaṇa sambuddho,","cnd1:17.2":"sabbadhammāna pāragū;","cnd1:17.3":"Sabbābhiññābalappatto [phalappatto (ka.)],","cnd1:17.4":"sabbadhammesu cakkhumā;","cnd1:17.5":"Sabbakammakkhayaṃ patto,","cnd1:17.6":"vimutto upadhikkhaye. 18.","cnd1:18.1":"“Buddho so bhagavā loke,","cnd1:18.2":"dhammaṃ deseti cakkhumā;","cnd1:18.3":"Taṃ tvaṃ gantvāna pucchassu,","cnd1:18.4":"so te taṃ byākarissati”. 19.","cnd1:19.1":"Sambuddhoti vaco sutvā,","cnd1:19.2":"udaggo bāvarī ahu;","cnd1:19.3":"Sokassa tanuko āsi,","cnd1:19.4":"pītiñca vipulaṃ labhi. 20.","cnd1:20.1":"So bāvarī attamano udaggo,","cnd1:20.2":"taṃ devataṃ pucchati vedajāto;","cnd1:20.3":"“Katamamhi gāme nigamamhi vā pana,","cnd1:20.4":"katamamhi vā janapade lokanātho;","cnd1:20.5":"Yattha gantvāna passemu,","cnd1:20.6":"sambuddhaṃ dvipaduttamaṃ”. 21.","cnd1:21.1":"“Sāvatthiyaṃ kosalamandire jino,","cnd1:21.2":"pahūtapañño varabhūrimedhaso;","cnd1:21.3":"So sakyaputto vidhuro anāsavo,","cnd1:21.4":"muddhādhipātassa vidū narāsabho”. 22.","cnd1:22.1":"Tato āmantayī sisse,","cnd1:22.2":"brāhmaṇe mantapāragū [pārage (syā.)];","cnd1:22.3":"“Etha māṇavā akkhissaṃ,","cnd1:22.4":"suṇātha vacanaṃ mama. 23.","cnd1:23.1":"“Yasseso dullabho loke,","cnd1:23.2":"pātubhāvo abhiṇhaso;","cnd1:23.3":"Svājja lokamhi uppanno,","cnd1:23.4":"sambuddho iti vissuto;","cnd1:23.5":"Khippaṃ gantvāna sāvatthiṃ,","cnd1:23.6":"passavho dvipaduttamaṃ”. 24.","cnd1:24.1":"“Kathaṃ carahi jānemu,","cnd1:24.2":"disvā buddhoti brāhmaṇa;","cnd1:24.3":"Ajānataṃ no pabrūhi,","cnd1:24.4":"yathā jānemu taṃ mayaṃ”. 25.","cnd1:25.1":"“Āgatāni hi mantesu,","cnd1:25.2":"mahāpurisalakkhaṇā;","cnd1:25.3":"Dvattiṃsāni ca byākkhātā,","cnd1:25.4":"samattā anupubbaso. 26.","cnd1:26.1":"“Yassete honti gattesu,","cnd1:26.2":"mahāpurisalakkhaṇā;","cnd1:26.3":"Dveyeva tassa gatiyo,","cnd1:26.4":"tatiyā hi na vijjati. 27.","cnd1:27.1":"“Sace agāraṃ āvasati,","cnd1:27.2":"vijeyya pathaviṃ imaṃ;","cnd1:27.3":"Adaṇḍena asatthena,","cnd1:27.4":"dhammena anusāsati. 28.","cnd1:28.1":"“Sace ca so pabbajati,","cnd1:28.2":"agārā anagāriyaṃ;","cnd1:28.3":"Vivaṭṭacchado [vivattacchaddo (sī.)] sambuddho,","cnd1:28.4":"arahā bhavati anuttaro. 29.","cnd1:29.1":"“Jātiṃ gottañca lakkhaṇaṃ,","cnd1:29.2":"mante sisse punāpare;","cnd1:29.3":"Muddhaṃ muddhādhipātañca,","cnd1:29.4":"manasāyeva pucchatha. 30.","cnd1:30.1":"“Anāvaraṇadassāvī,","cnd1:30.2":"yadi buddho bhavissati;","cnd1:30.3":"Manasā pucchite pañhe,","cnd1:30.4":"vācāya visajjissati” [vissajissati (ka.)]. 31.","cnd1:31.1":"Bāvarissa vaco sutvā,","cnd1:31.2":"sissā soḷasa brāhmaṇā;","cnd1:31.3":"Ajito tissametteyyo,","cnd1:31.4":"puṇṇako atha mettagū. 32.","cnd1:32.1":"Dhotako upasīvo ca,","cnd1:32.2":"nando ca atha hemako;","cnd1:32.3":"Todeyya-kappā dubhayo,","cnd1:32.4":"jatukaṇṇī ca paṇḍito. 33.","cnd1:33.1":"Bhadrāvudho udayo ca,","cnd1:33.2":"posālo cāpi brāhmaṇo;","cnd1:33.3":"Mogharājā ca medhāvī,","cnd1:33.4":"piṅgiyo ca mahāisi. 34.","cnd1:34.1":"Paccekagaṇino sabbe,","cnd1:34.2":"sabbalokassa vissutā;","cnd1:34.3":"Jhāyī jhānaratā dhīrā,","cnd1:34.4":"pubbavāsanavāsitā. 35.","cnd1:35.1":"Bāvariṃ abhivādetvā,","cnd1:35.2":"katvā ca naṃ padakkhiṇaṃ;","cnd1:35.3":"Jaṭājinadharā sabbe,","cnd1:35.4":"pakkāmuṃ uttarāmukhā. 36.","cnd1:36.1":"Maḷakassa patiṭṭhānaṃ,","cnd1:36.2":"puramāhissatiṃ [puramāhiyati (ka.)] tadā [sadā (ka.)];","cnd1:36.3":"Ujjeniñcāpi gonaddhaṃ,","cnd1:36.4":"vedisaṃ vanasavhayaṃ. 37.","cnd1:37.1":"Kosambiñcāpi sāketaṃ,","cnd1:37.2":"sāvatthiñca puruttamaṃ;","cnd1:37.3":"Setabyaṃ kapilavatthuṃ,","cnd1:37.4":"kusinārañca mandiraṃ. 38.","cnd1:38.1":"Pāvañca bhoganagaraṃ,","cnd1:38.2":"vesāliṃ māgadhaṃ puraṃ;","cnd1:38.3":"Pāsāṇakaṃ cetiyañca,","cnd1:38.4":"ramaṇīyaṃ manoramaṃ. 39.","cnd1:39.1":"Tasitovudakaṃ sītaṃ,","cnd1:39.2":"mahālābhaṃva vāṇijo;","cnd1:39.3":"Chāyaṃ ghammābhitattova","cnd1:39.4":"turitā pabbatamāruhuṃ. 40.","cnd1:40.1":"Bhagavā tamhi samaye,","cnd1:40.2":"bhikkhusaṅghapurakkhato;","cnd1:40.3":"Bhikkhūnaṃ dhammaṃ deseti,","cnd1:40.4":"sīhova nadatī vane. 41.","cnd1:41.1":"Ajito addasa buddhaṃ,","cnd1:41.2":"pītaraṃsiṃva [jitaraṃsiṃ sītaraṃsiṃ (ka.), vītaraṃsiṃ (sī. syā.)] bhāṇumaṃ;","cnd1:41.3":"Candaṃ yathā pannarase,","cnd1:41.4":"paripūraṃ [pāripūriṃ (sī. syā.)] upāgataṃ. 42.","cnd1:42.1":"Athassa gatte disvāna,","cnd1:42.2":"paripūrañca byañjanaṃ;","cnd1:42.3":"Ekamantaṃ ṭhito haṭṭho,","cnd1:42.4":"manopañhe apucchatha. 43.","cnd1:43.1":"“Ādissa jammanaṃ brūhi,","cnd1:43.2":"gottaṃ brūhi salakkhaṇaṃ;","cnd1:43.3":"Mantesu pāramiṃ brūhi,","cnd1:43.4":"kati vāceti brāhmaṇo”. 44.","cnd1:44.1":"“Vīsaṃ vassasataṃ āyu,","cnd1:44.2":"so ca gottena bāvarī;","cnd1:44.3":"Tīṇissa lakkhaṇā gatte,","cnd1:44.4":"tiṇṇaṃ vedāna pāragū. 45.","cnd1:45.1":"“Lakkhaṇe itihāse ca,","cnd1:45.2":"sanighaṇḍusakeṭubhe;","cnd1:45.3":"Pañcasatāni vāceti,","cnd1:45.4":"sadhamme pāramiṃ gato”. 46.","cnd1:46.1":"“Lakkhaṇānaṃ pavicayaṃ,","cnd1:46.2":"bāvarissa naruttama;","cnd1:46.3":"Taṇhacchida [kaṅkhacchida (ka.)] pakāsehi,","cnd1:46.4":"mā no kaṅkhāyitaṃ ahu”. 47.","cnd1:47.1":"“Mukhaṃ jivhāya chādeti,","cnd1:47.2":"uṇṇassa bhamukantare;","cnd1:47.3":"Kosohitaṃ vatthaguyhaṃ,","cnd1:47.4":"evaṃ jānāhi māṇava”. 48.","cnd1:48.1":"Pucchañhi kiñci asuṇanto,","cnd1:48.2":"sutvā pañhe viyākate;","cnd1:48.3":"Vicinteti jano sabbo,","cnd1:48.4":"vedajāto katañjalī. 49.","cnd1:49.1":"“Ko nu devo vā brahmā vā,","cnd1:49.2":"indo vāpi sujampati;","cnd1:49.3":"Manasā pucchite pañhe,","cnd1:49.4":"kametaṃ paṭibhāsati. 50.","cnd1:50.1":"“Muddhaṃ muddhādhipātañca,","cnd1:50.2":"bāvarī paripucchati;","cnd1:50.3":"Taṃ byākarohi bhagavā,","cnd1:50.4":"kaṅkhaṃ vinaya no ise”. 51.","cnd1:51.1":"“Avijjā muddhāti jānāhi,","cnd1:51.2":"vijjā muddhādhipātinī;","cnd1:51.3":"Saddhāsatisamādhīhi,","cnd1:51.4":"chandavīriyena saṃyutā”. 52.","cnd1:52.1":"Tato vedena mahatā,","cnd1:52.2":"santhambhetvāna māṇavo;","cnd1:52.3":"Ekaṃsaṃ ajinaṃ katvā,","cnd1:52.4":"pādesu sirasā pati. 53.","cnd1:53.1":"“Bāvarī brāhmaṇo bhoto,","cnd1:53.2":"saha sissehi mārisa;","cnd1:53.3":"Udaggacitto sumano,","cnd1:53.4":"pāde vandati cakkhuma”. 54.","cnd1:54.1":"“Sukhito bāvarī hotu,","cnd1:54.2":"saha sissehi brāhmaṇo;","cnd1:54.3":"Tvañcāpi sukhito hohi,","cnd1:54.4":"ciraṃ jīvāhi māṇava. 55.","cnd1:55.1":"“Bāvarissa ca tuyhaṃ vā,","cnd1:55.2":"sabbesaṃ sabbasaṃsayaṃ;","cnd1:55.3":"Katāvakāsā pucchavho,","cnd1:55.4":"yaṃ kiñci manasicchatha”. 56.","cnd1:56.1":"Sambuddhena katokāso,","cnd1:56.2":"nisīditvāna pañjalī;","cnd1:56.3":"Ajito paṭhamaṃ pañhaṃ,","cnd1:56.4":"tattha pucchi tathāgataṃ.","cnd1:56.5":"Vatthugāthā niṭṭhitā. 1."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
