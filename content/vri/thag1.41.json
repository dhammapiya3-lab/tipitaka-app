{"suttaId":"thag1.41","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[245,248],"vripara":"41"},"segments":{"thag1.41:0.4":"Sirivaḍḍhattheragāthā","thag1.41:1.1":"“Vivaramanupatanti vijjutā, vebhārassa ca paṇḍavassa ca;","thag1.41:1.3":"Nagavivaragato ca jhāyati, putto appaṭimassa tādino”ti.","thag1.41:1.5":"… Sirivaḍḍho thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":1171,"to":1171,"paras":[{"para":1171,"vripara":"41","refs":["thag1.41:1"],"lines":["Tattha <b>vivaran</b>ti antarā vemajjhaṃ.","<b>Anupatantī</b>ti anulakkhaṇe patanti pavattanti, vijjotantīti attho.","Vijjotanameva hi vijjullatānaṃ pavatti nāma.","<b>Anu</b> -saddayogena cettha upayogavacanaṃ, yathā “rukkhamanuvijjotantī”ti.","<b>Vijjutā</b>ti sateratā.","<b>Vebhārassa ca paṇḍavassa cā</b>ti vebhārapabbatassa ca paṇḍavapabbatassa ca vivaramanupatantīti yojanā.","<b>Nagavivaragato</b>ti nagavivaraṃ pabbataguhaṃ upagato.","<b>Jhāyatī</b>ti ārammaṇūpanijjhānena lakkhaṇūpanijjhānena ca jhāyati, samathavipassanaṃ ussukkāpento bhāveti.","<b>Putto appaṭimassa tādino</b>ti sīlakkhandhādidhammakāyasampattiyā rūpakāyasampattiyā ca anupamassa upamārahitassa iṭṭhāniṭṭhādīsu tādilakkhaṇasampattiyā tādino buddhassa bhagavato orasaputto.","Puttavacaneneva cettha therena satthu anujātabhāvadīpanena aññā byākatāti veditabbaṃ."],"lineRefs":[["thag1.41:1"],["thag1.41:1"],["thag1.41:1"],["thag1.41:1"],["thag1.41:1"],["thag1.41:1"],["thag1.41:1"],["thag1.41:1"],["thag1.41:1"],["thag1.41:1"]]}],"wordLinks":[["thag1.41:1.1","vivaraṃ",0,0],["thag1.41:1.3","vivaraṃ",0,0],["thag1.41:1.1","anupatantī",0,1],["thag1.41:1.1","anu",0,3],["thag1.41:1.1","vijjutā",0,4],["thag1.41:1.1","vebhārassa ca paṇḍavassa cā",0,5],["thag1.41:1.3","nagavivaragato",0,6],["thag1.41:1.3","jhāyatī",0,7],["thag1.41:1.3","putto appaṭimassa tādino",0,8]]},"tika":null}
