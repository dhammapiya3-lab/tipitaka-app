{"suttaId":"sn22.151","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[863,863],"vripara":"151"},"segments":{"sn22.151:0.3":"Etaṃmamasuttaṃ","sn22.151:1.1":"Sāvatthinidānaṃ.","sn22.151:1.2":"“Kismiṃ nu kho, bhikkhave, sati, kiṃ upādāya, kiṃ abhinivissa –","sn22.151:1.3":"‘etaṃ mama, esohamasmi, eso me attā’ti samanupassatī”ti?","sn22.151:1.4":"Bhagavaṃmūlakā no, bhante, dhammā…pe…","sn22.151:1.5":"“rūpe kho, bhikkhave, sati, rūpaṃ upādāya, rūpaṃ abhinivissa …pe…","sn22.151:1.6":"viññāṇe sati, viññāṇaṃ upādāya, viññāṇaṃ abhinivissa –","sn22.151:1.7":"‘etaṃ mama, esohamasmi, eso me attā’ti samanupassati.","sn22.151:1.8":"Taṃ kiṃ maññatha, bhikkhave,","sn22.151:1.9":"rūpaṃ niccaṃ vā aniccaṃ vā”ti?","sn22.151:1.10":"“Aniccaṃ, bhante”…pe…","sn22.151:1.11":"vipariṇāmadhammaṃ, api nu taṃ anupādāya etaṃ mama, esohamasmi, eso me attāti samanupasseyyāti?","sn22.151:1.12":"“No hetaṃ, bhante”.","sn22.151:1.13":"“Vedanā…","sn22.151:1.14":"saññā…","sn22.151:1.15":"saṅkhārā…","sn22.151:1.16":"viññāṇaṃ niccaṃ vā aniccaṃ vā”ti?","sn22.151:1.17":"“Aniccaṃ bhante”…pe…","sn22.151:1.18":"vipariṇāmadhammaṃ, api nu taṃ anupādāya etaṃ mama, esohamasmi, eso me attāti samanupasseyyāti?","sn22.151:1.19":"“No hetaṃ, bhante”.","sn22.151:1.20":"“Evaṃ passaṃ..","sn22.151:1.21":"pe… nāparaṃ itthattāyāti pajānātī”ti.","sn22.151:1.22":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":395,"to":396,"paras":[{"para":395,"vripara":"150-158","refs":["sn22.151:1"],"lines":["Diṭṭhivaggassa paṭhame <b>kiṃ upādāyā</b>ti kiṃ paṭicca.","Dutiye <b>kiṃ abhinivissā</b>ti kiṃ abhinivisitvā, paccayaṃ katvāti attho.","Tatiyādīsu <b>diṭṭhī</b>tiādīni puggalajjhāsayena vuttāni.","Paṭhamādīni. 10."],"lineRefs":[["sn22.151:1"],["sn22.151:1"],["sn22.151:1"],["sn22.151:1"]]},{"para":396,"vripara":null,"refs":["sn22.151:1"],"lines":["Ānandasuttavaṇṇanā 159."],"lineRefs":[["sn22.151:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":400,"to":402,"paras":[{"para":400,"vripara":"150-158","refs":["sn22.151:1"],"lines":["<b>Paccayaṃ katvā</b>ti abhinivesapaccayaṃ katvā.","Ādisaddena micchādiṭṭhisakkāyadiṭṭhiattānudiṭṭhi saññojanābhinivesa-vinibandhaajjhosānāni saṅgaṇhāti.","Tattha <b>abhinivesā</b> taṇhāmānadiṭṭhiyo.","<b>Vinibandhā</b> “kāye avītarāgo hotī”tiādinā (dī. ni. 3.320; ma. ni. 1.186) āgatacetasovinibandhā.","<b>Ajjhosānā</b>ti taṇhādiṭṭhijjhosānāni.","Sesāni suviññeyyāneva."],"lineRefs":[["sn22.151:1"],["sn22.151:1"],["sn22.151:1"],["sn22.151:1"],["sn22.151:1"],["sn22.151:1"]]},{"para":401,"vripara":null,"refs":["sn22.151:1"],"lines":["Ajjhattasuttādivaṇṇanā niṭṭhitā. 10."],"lineRefs":[["sn22.151:1"]]},{"para":402,"vripara":null,"refs":["sn22.151:1"],"lines":["Ānandasuttavaṇṇanā 159."],"lineRefs":[["sn22.151:1"]]}],"wordLinks":[]},"tika2":null}
