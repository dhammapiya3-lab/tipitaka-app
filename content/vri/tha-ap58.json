{"suttaId":"tha-ap58","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4081,4102],"vripara":"43"},"segments":{"tha-ap58:0.3":"Saparivārāsanattheraapadānaṃ","tha-ap58:1.1":"“Padumuttarabuddhassa,","tha-ap58:1.2":"piṇḍapātaṃ adāsahaṃ;","tha-ap58:1.3":"Gantvā kiliṭṭhakaṃ ṭhānaṃ [taṃ bhojanaṭṭhānaṃ (sī.)],","tha-ap58:1.4":"mallikāhi parikkhitaṃ [parikkhipiṃ (sī.)].","tha-ap58:2.1":"“Tamhāsanamhi āsīno,","tha-ap58:2.2":"buddho lokagganāyako;","tha-ap58:2.3":"Akittayi piṇḍapātaṃ,","tha-ap58:2.4":"ujubhūto samāhito.","tha-ap58:3.1":"“Yathāpi bhaddake khette,","tha-ap58:3.2":"bījaṃ appampi ropitaṃ;","tha-ap58:3.3":"Sammā dhāraṃ pavecchante,","tha-ap58:3.4":"phalaṃ toseti kassakaṃ.","tha-ap58:4.1":"“Tathevāyaṃ piṇḍapāto,","tha-ap58:4.2":"sukhette ropito tayā;","tha-ap58:4.3":"Bhave nibbattamānamhi,","tha-ap58:4.4":"phalaṃ te [nibbattamānaṃ hi, phalato (sī.)] tosayissati [tappayissati (ka.)].","tha-ap58:5.1":"“Idaṃ vatvāna sambuddho,","tha-ap58:5.2":"jalajuttamanāmako;","tha-ap58:5.3":"Piṇḍapātaṃ gahetvāna,","tha-ap58:5.4":"pakkāmi uttarāmukho.","tha-ap58:6.1":"“Saṃvuto pātimokkhasmiṃ,","tha-ap58:6.2":"indriyesu ca pañcasu;","tha-ap58:6.3":"Pavivekamanuyutto,","tha-ap58:6.4":"viharāmi anāsavo.","tha-ap58:7.1":"“Paṭisambhidā catasso … pe …","tha-ap58:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap58:8.1":"Itthaṃ sudaṃ āyasmā saparivārāsano thero imā gāthāyo abhāsitthāti.","tha-ap58:9.1":"Saparivārāsanattherassāpadānaṃ chaṭṭhaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2578,"to":2580,"paras":[{"para":2578,"vripara":"43","refs":["tha-ap58:1"],"lines":["So evaṃ pattasantipado “kena nu kho puññena idaṃ santipadaṃ anuppattan”ti ñāṇena upadhārento pubbakammaṃ disvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>padumuttarabuddhassā</b>tiādimāha.","Taṃ vuttatthameva.","<b>Piṇḍapātaṃ adāsahan</b>ti tattha tattha laddhānaṃ piṇḍānaṃ kabaḷaṃ kabaḷaṃ katvā pātabbato khāditabbato āhāro piṇḍapāto, taṃ piṇḍapātaṃ bhagavato adāsiṃ, bhagavantaṃ bhojesinti attho."],"lineRefs":[["tha-ap58:1"],["tha-ap58:1"],["tha-ap58:1"]]},{"para":2579,"vripara":"44","refs":["tha-ap58:2"],"lines":["<b>Akittayi piṇḍapātan</b>ti mayā dinnapiṇḍapātassa guṇaṃ ānisaṃsaṃ pakāsesīti attho."],"lineRefs":[["tha-ap58:2"]]},{"para":2580,"vripara":"48","refs":["tha-ap58:6"],"lines":["<b>Saṃvuto pātimokkhasmin</b>ti pātimokkhasaṃvarasīlena saṃvuto pihito paṭicchannoti attho.","<b>Indriyesu ca pañcasū</b>ti cakkhundriyādīsu pañcasu indriyesu rūpādīhi gopito indriyasaṃvarasīlañca gopitoti attho.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap58:6"],["tha-ap58:6"],["tha-ap58:6"]]}],"wordLinks":[["tha-ap58:1.1","padumuttarabuddhassā",0,0],["tha-ap58:1.1","piṇḍapātaṃ adāsahaṃ",0,2],["tha-ap58:2.3","akittayi piṇḍapātaṃ",1,0],["tha-ap58:6.1","saṃvuto pātimokkhasmiṃ",2,0],["tha-ap58:6.1","indriyesu ca pañcasū",2,1]]},"tika":null,"tika2":null}
