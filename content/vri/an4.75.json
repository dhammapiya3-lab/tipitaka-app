{"suttaId":"an4.75","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[837,837],"vripara":"75"},"segments":{"an4.75:0.3":"Dutiyaaggasuttaṃ","an4.75:1.1":"“Cattārimāni, bhikkhave, aggāni.","an4.75:1.2":"Katamāni cattāri?","an4.75:1.3":"Rūpaggaṃ, vedanāggaṃ, saññāggaṃ, bhavaggaṃ – imāni kho, bhikkhave, cattāri aggānī”ti.","an4.75:1.5":"Pañcamaṃ."},"attha":null,"tika":null}
