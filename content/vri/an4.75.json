{"suttaId":"an4.75","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[837,837],"vripara":"75"},"segments":{"an4.75:0.3":"Dutiyaaggasuttaṃ","an4.75:1.1":"“Cattārimāni, bhikkhave, aggāni.","an4.75:1.2":"Katamāni cattāri?","an4.75:1.3":"Rūpaggaṃ, vedanāggaṃ, saññāggaṃ, bhavaggaṃ –","an4.75:1.4":"imāni kho, bhikkhave, cattāri aggānī”ti.","an4.75:1.5":"Pañcamaṃ."},"unsure":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1317,"to":1318,"paras":[{"para":1317,"vripara":"74-75","refs":["an4.75:1"],"lines":["74-75. Catutthe <b>sīlaggan</b>ti aggappattaṃ uttamasīlaṃ.","Eseva nayo sabbattha.","Pañcame <b>rūpaggan</b>ti yaṃ rūpaṃ sammasitvā arahattaṃ pāpuṇāti, idaṃ rūpaggaṃ nāma.","Sesesupi eseva nayo.","<b>Bhavaggan</b>ti ettha pana yasmiṃ attabhāve ṭhito arahattaṃ pāpuṇāti, etaṃ bhavaggaṃ nāmāti."],"lineRefs":[["an4.75:1"],["an4.75:1"],["an4.75:1"],["an4.75:1"],["an4.75:1"]]},{"para":1318,"vripara":null,"refs":["an4.75:1"],"lines":["Kusinārasuttavaṇṇanā"],"lineRefs":[["an4.75:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1494,"to":1496,"paras":[{"para":1494,"vripara":"73-75","refs":["an4.75:1"],"lines":["73-75. Tatiye <b>pañhatthāya abhinīto</b>ti pañhakaraṇatthāya abhimukhaṃ nīto.","<b>Alambitaṃ katvā</b>ti alambaṃ katvā, ayameva vā pāṭho, vipalambaṃ akatvāti attho.","<b>Avajānātī</b>ti avaññaṃ karoti, nindatīti attho.","Catutthapañcame natthi vattabbaṃ."],"lineRefs":[["an4.75:1"],["an4.75:1"],["an4.75:1"],["an4.75:1"]]},{"para":1495,"vripara":null,"refs":["an4.75:1"],"lines":["Sappurisasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an4.75:1"]]},{"para":1496,"vripara":null,"refs":["an4.75:1"],"lines":["Kusinārasuttavaṇṇanā"],"lineRefs":[["an4.75:1"]]}],"wordLinks":[]},"tika2":null}
