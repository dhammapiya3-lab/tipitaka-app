{"suttaId":"pv27","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[1328,1426],"vripara":"408"},"segments":{"pv27:0.3":"Sāṇavāsītherapetavatthu","pv27:1.1":"Kuṇḍināgariyo thero,","pv27:1.2":"sāṇavāsi [sānuvāsi (sī.), sānavāsi (syā.)] nivāsiko;","pv27:1.3":"Poṭṭhapādoti nāmena,","pv27:1.4":"samaṇo bhāvitindriyo.","pv27:2.1":"Tassa mātā pitā bhātā,","pv27:2.2":"duggatā yamalokikā;","pv27:2.3":"Pāpakammaṃ karitvāna,","pv27:2.4":"petalokaṃ ito gatā.","pv27:3.1":"Te duggatā sūcikaṭṭā,","pv27:3.2":"kilantā naggino kisā;","pv27:3.3":"Uttasantā [ottappantā (syā. ka.)] mahattāsā [mahātāsā (sī.)],","pv27:3.4":"na dassenti kurūrino [kuruddino (ka.)].","pv27:4.1":"Tassa bhātā vitaritvā,","pv27:4.2":"naggo ekapathekako;","pv27:4.3":"Catukuṇḍiko bhavitvāna,","pv27:4.4":"therassa dassayītumaṃ.","pv27:5.1":"Thero cāmanasikatvā,","pv27:5.2":"tuṇhībhūto atikkami;","pv27:5.3":"So ca viññāpayī theraṃ,","pv27:5.4":"‘bhātā petagato ahaṃ’.","pv27:6.1":"“Mātā pitā ca te bhante,","pv27:6.2":"duggatā yamalokikā;","pv27:6.3":"Pāpakammaṃ karitvāna,","pv27:6.4":"petalokaṃ ito gatā.","pv27:7.1":"“Te duggatā sūcikaṭṭā,","pv27:7.2":"kilantā naggino kisā;","pv27:7.3":"Uttasantā mahattāsā,","pv27:7.4":"na dassenti kurūrino.","pv27:8.1":"“Anukampassu kāruṇiko,","pv27:8.2":"datvā anvādisāhi no;","pv27:8.3":"Tava dinnena dānena,","pv27:8.4":"yāpessanti kurūrino”ti.","pv27:9.1":"Thero caritvā piṇḍāya,","pv27:9.2":"bhikkhū aññe ca dvādasa;","pv27:9.3":"Ekajjhaṃ sannipatiṃsu,","pv27:9.4":"bhattavissaggakāraṇā.","pv27:10.1":"Thero sabbeva te āha,","pv27:10.2":"“yathāladdhaṃ dadātha me;","pv27:10.3":"Saṅghabhattaṃ karissāmi,","pv27:10.4":"anukampāya ñātinaṃ”.","pv27:11.1":"Niyyādayiṃsu therassa,","pv27:11.2":"thero saṅghaṃ nimantayi;","pv27:11.3":"Datvā anvādisi thero,","pv27:11.4":"mātu pitu ca bhātuno;","pv27:11.5":"“Idaṃ me ñātīnaṃ hotu,","pv27:11.6":"sukhitā hontu ñātayo”.","pv27:12.1":"Samanantarānuddiṭṭhe,","pv27:12.2":"bhojanaṃ udapajjatha;","pv27:12.3":"Suciṃ paṇītaṃ sampannaṃ,","pv27:12.4":"anekarasabyañjanaṃ.","pv27:13.1":"Tato uddassayī [uddisayī (sī. ka.), uddissati (syā. ka.)] bhātā,","pv27:13.2":"vaṇṇavā balavā sukhī;","pv27:13.3":"“Pahūtaṃ bhojanaṃ bhante,","pv27:13.4":"passa naggāmhase mayaṃ;","pv27:13.5":"Tathā bhante parakkama,","pv27:13.6":"yathā vatthaṃ labhāmase”ti.","pv27:14.1":"Thero saṅkārakūṭamhā,","pv27:14.2":"uccinitvāna nantake;","pv27:14.3":"Pilotikaṃ paṭaṃ katvā,","pv27:14.4":"saṅghe cātuddise adā.","pv27:15.1":"Datvā anvādisī thero,","pv27:15.2":"mātu pitu ca bhātuno;","pv27:15.3":"“Idaṃ me ñātīnaṃ hotu,","pv27:15.4":"sukhitā hontu ñātayo”.","pv27:16.1":"Samanantarānuddiṭṭhe,","pv27:16.2":"vatthāni udapajjisuṃ;","pv27:16.3":"Tato suvatthavasano,","pv27:16.4":"therassa dassayītumaṃ.","pv27:17.1":"“Yāvatā nandarājassa,","pv27:17.2":"vijitasmiṃ paṭicchadā;","pv27:17.3":"Tato bahutarā bhante,","pv27:17.4":"vatthānacchādanāni no.","pv27:18.1":"“Koseyyakambalīyāni,","pv27:18.2":"khoma kappāsikāni ca;","pv27:18.3":"Vipulā ca mahagghā ca,","pv27:18.4":"tepākāsevalambare.","pv27:19.1":"“Te mayaṃ paridahāma,","pv27:19.2":"yaṃ yaṃ hi manaso piyaṃ;","pv27:19.3":"Tathā bhante parakkama,","pv27:19.4":"yathā gehaṃ labhāmase”ti.","pv27:20.1":"Thero paṇṇakuṭiṃ katvā,","pv27:20.2":"saṅghe cātuddise adā;","pv27:20.3":"Datvā anvādisī thero,","pv27:20.4":"mātu pitu ca bhātuno;","pv27:20.5":"“Idaṃ me ñātīnaṃ hotu,","pv27:20.6":"sukhitā hontu ñātayo”.","pv27:21.1":"Samanantarānuddiṭṭhe,","pv27:21.2":"gharāni udapajjisuṃ;","pv27:21.3":"Kūṭāgāranivesanā,","pv27:21.4":"vibhattā bhāgaso mitā.","pv27:22.1":"“Na manussesu īdisā,","pv27:22.2":"yādisā no gharā idha;","pv27:22.3":"Api dibbesu yādisā,","pv27:22.4":"tādisā no gharā idha.","pv27:23.1":"“Daddallamānā ābhenti [ābhanti (ka.)],","pv27:23.2":"samantā caturo disā;","pv27:23.3":"‘Tathā bhante parakkama,","pv27:23.4":"yathā pānīyaṃ labhāmase”ti.","pv27:24.1":"Thero karaṇaṃ [karakaṃ (sī. syā. pī.)] pūretvā,","pv27:24.2":"saṅghe cātuddise adā;","pv27:24.3":"Datvā anvādisī thero,","pv27:24.4":"mātu pitu ca bhātuno;","pv27:24.5":"“Idaṃ me ñātīnaṃ hotu,","pv27:24.6":"sukhitā hontu ñātayo’.","pv27:25.1":"Samanantarānuddiṭṭhe,","pv27:25.2":"pānīyaṃ udapajjatha;","pv27:25.3":"Gambhīrā caturassā ca,","pv27:25.4":"pokkharañño sunimmitā.","pv27:26.1":"Sītodikā suppatitthā,","pv27:26.2":"sītā appaṭigandhiyā;","pv27:26.3":"Padumuppalasañchannā,","pv27:26.4":"vārikiñjakkhapūritā.","pv27:27.1":"Tattha nhatvā pivitvā ca,","pv27:27.2":"therassa paṭidassayuṃ;","pv27:27.3":"“Pahūtaṃ pānīyaṃ bhante,","pv27:27.4":"pādā dukkhā phalanti no”.","pv27:28.1":"“Āhiṇḍamānā khañjāma,","pv27:28.2":"sakkhare kusakaṇṭake;","pv27:28.3":"‘Tathā bhante parakkama,","pv27:28.4":"yathā yānaṃ labhāmase’”ti.","pv27:29.1":"Thero sipāṭikaṃ laddhā,","pv27:29.2":"saṅghe cātuddise adā;","pv27:29.3":"Datvā anvādisī thero,","pv27:29.4":"mātu pitu ca bhātuno;","pv27:29.5":"“Idaṃ me ñātīnaṃ hotu,","pv27:29.6":"sukhitā hontu ñātayo”.","pv27:30.1":"Samanantarānuddiṭṭhe,","pv27:30.2":"petā rathena māgamuṃ;","pv27:30.3":"“Anukampitamha bhadante,","pv27:30.4":"bhattenacchādanena ca.","pv27:31.1":"“Gharena pānīyadānena,","pv27:31.2":"yānadānena cūbhayaṃ;","pv27:31.3":"Muniṃ kāruṇikaṃ loke,","pv27:31.4":"bhante vanditumāgatā”ti.","pv27:32.1":"Sāṇavāsītherapetavatthu dutiyaṃ."},"unsure":[],"preface":[],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":1832,"to":1921,"paras":[{"para":1832,"vripara":"408-409","refs":["pv27:1"],"lines":["408-9. Tattha <b>kuṇḍināgariyo thero</b>ti evaṃnāmake nagare jātasaṃvaḍḍhatthero,“kuṇḍikanagaro thero” tipi pāṭho, so evattho.","<b>Sāṇavāsinivāsiko</b>ti sāṇapabbatavāsī.","<b>Poṭṭhapādoti nāmenā</b>ti nāmena poṭṭhapādo nāma.","<b>Samaṇo</b>ti samitapāpo.","<b>Bhāvitindriyo</b>ti ariyamaggabhāvanāya bhāvitasaddhādiindriyo, arahāti attho.","<b>Tassā</b>ti tassa sāṇavāsittherassa.","<b>Duggatā</b>ti duggatigatā."],"lineRefs":[["pv27:1"],["pv27:1"],["pv27:1"],["pv27:1"],["pv27:1"],["pv27:1"],["pv27:1"]]},{"para":1833,"vripara":"410","refs":["pv27:3"],"lines":["<b>Sūcikaṭṭā</b>ti pūtinā lūkhagattā aṭṭakā, sūcikāti laddhanāmāya khuppipāsāya aṭṭā pīḷitā.","“Sūcikaṇṭhā”ti keci paṭhanti, sūcichiddasadisamukhadvārāti attho.","<b>Kilantā</b>ti kilantakāyacittā.","<b>Naggino</b>ti naggarūpā niccoḷā.","<b>Kisā</b>ti aṭṭhittacamattasarīratāya kisadehā.","<b>Uttasantā</b>ti “ayaṃ samaṇo amhākaṃ putto”ti ottappena utrāsaṃ āpajjantā.","<b>Mahattāsā</b>ti attanā pubbe katakammaṃ paṭicca sañjātamahābhayā.","<b>Na dassentī</b>ti attānaṃ na dassenti, sammukhībhāvaṃ na gacchanti.","<b>Kurūrino</b>ti dāruṇakammantā."],"lineRefs":[["pv27:3"],["pv27:3"],["pv27:3"],["pv27:3"],["pv27:3"],["pv27:3"],["pv27:3"],["pv27:3"],["pv27:3"]]},{"para":1834,"vripara":"411","refs":["pv27:4"],"lines":["<b>Tassa bhātā</b>ti sāṇavāsittherassa bhātā.","<b>Vitaritvā</b>ti vitiṇṇo hutvā, ottappasantāsabhayāti attho.","Vituritvāti vā pāṭho, turito hutvā, taramānarūpo hutvāti vuttaṃ hoti.","<b>Ekapathe</b>ti ekapadikamagge.","<b>Ekako</b>ti ekiko adutiyo.","<b>Catukuṇḍiko bhavitvānā</b>ti catūhi aṅgehi kuṇḍeti attabhāvaṃ pavattetīti catukuṇḍiko, dvīhi jāṇūhi dvīhi hatthehi gacchanto tiṭṭhanto ca, evaṃbhūto hutvāti attho.","So hi evaṃ purato kopīnapaṭicchādanā hotīti tathā akāsi.","<b>Therassa dassayītuman</b>ti therassa attānaṃ uddisayi dassesi."],"lineRefs":[["pv27:4"],["pv27:4"],["pv27:4"],["pv27:4"],["pv27:4"],["pv27:4"],["pv27:4"],["pv27:4"]]},{"para":1835,"vripara":"412","refs":["pv27:4","pv27:5"],"lines":["<b>Amanasikatvā</b>ti “ayaṃ nāma eso”ti evaṃ manasi akaritvā anāvajjetvā.","<b>So cā</b>ti so peto.","<b>Bhātā petagato ahan</b>ti “ahaṃ atītattabhāve bhātā, idāni petabhūto idhāgato”ti vatvā viññāpayi theranti yojanā."],"lineRefs":[["pv27:4"],["pv27:5"],["pv27:5"]]},{"para":1836,"vripara":"413-415","refs":["pv27:6"],"lines":["413-5. Yathā pana viññāpayi, taṃ dassetuṃ <b>“mātā pitā cā”</b>tiādinā tisso gāthā vuttā.","Tattha <b>mātā pitā ca te</b>ti tava mātā ca pitā ca.","<b>Anukampassū</b>ti anuggaṇha anudayaṃ karohi.","<b>Anvādisāhī</b>ti ādisa.","<b>No</b>ti amhākaṃ.","<b>Tava dinnenā</b>ti tayā dinnena."],"lineRefs":[["pv27:6"],["pv27:6"],["pv27:6"],["pv27:6"],["pv27:6"],["pv27:6"]]},{"para":1837,"vripara":null,"refs":["pv27:6"],"lines":["Taṃ sutvā thero yathā paṭipajji, taṃ dassetuṃ –"],"lineRefs":[["pv27:6"]]},{"para":1839,"vripara":"416","refs":["pv27:6"],"lines":["“Thero caritvā piṇḍāya, bhikkhū aññe ca dvādasa;"],"lineRefs":[["pv27:6"]]},{"para":1840,"vripara":null,"refs":["pv27:6"],"lines":["Ekajjhaṃ sannipatiṃsu, bhattavissaggakāraṇā."],"lineRefs":[["pv27:6"]]},{"para":1842,"vripara":"417","refs":["pv27:6"],"lines":["“Thero sabbeva te āha, yathāladdhaṃ dadātha me;"],"lineRefs":[["pv27:6"]]},{"para":1843,"vripara":null,"refs":["pv27:6"],"lines":["Saṅghabhattaṃ karissāmi, anukampāya ñātinaṃ."],"lineRefs":[["pv27:6"]]},{"para":1845,"vripara":"418","refs":["pv27:6"],"lines":["“Niyyādayiṃsu therassa, thero saṅghaṃ nimantayi;"],"lineRefs":[["pv27:6"]]},{"para":1846,"vripara":null,"refs":["pv27:6"],"lines":["Datvā anvādisi thero, mātu pitu ca bhātuno;"],"lineRefs":[["pv27:6"]]},{"para":1847,"vripara":null,"refs":["pv27:6"],"lines":["‘Idaṃ me ñātīnaṃ hotu, sukhitā hontu ñātayo’."],"lineRefs":[["pv27:6"]]},{"para":1849,"vripara":"419","refs":["pv27:6"],"lines":["“Samanantarānuddiṭṭhe, bhojanaṃ udapajjatha;"],"lineRefs":[["pv27:6"]]},{"para":1850,"vripara":null,"refs":["pv27:6"],"lines":["Suciṃ paṇītaṃ sampannaṃ, anekarasabyañjanaṃ."],"lineRefs":[["pv27:6"]]},{"para":1852,"vripara":"420","refs":["pv27:6"],"lines":["“Tato uddassayī bhātā, vaṇṇavā balavā sukhī;"],"lineRefs":[["pv27:6"]]},{"para":1853,"vripara":null,"refs":["pv27:6"],"lines":["Pahūtaṃ bhojanaṃ bhante, passa naggāmhase mayaṃ;"],"lineRefs":[["pv27:6"]]},{"para":1854,"vripara":null,"refs":["pv27:6"],"lines":["Tathā bhante parakkama, yathā vatthaṃ labhāmase."],"lineRefs":[["pv27:6"]]},{"para":1856,"vripara":"421","refs":["pv27:6"],"lines":["“Thero saṅkārakūṭamhā, uccinitvāna nantake;"],"lineRefs":[["pv27:6"]]},{"para":1857,"vripara":null,"refs":["pv27:6"],"lines":["Pilotikaṃ paṭaṃ katvā, saṅghe cātuddise adā."],"lineRefs":[["pv27:6"]]},{"para":1859,"vripara":"422","refs":["pv27:6"],"lines":["“Datvā anvādisī thero, mātu pitu ca bhātuno;"],"lineRefs":[["pv27:6"]]},{"para":1860,"vripara":null,"refs":["pv27:6"],"lines":["‘Idaṃ me ñātīnaṃ hotu, sukhitā hontu ñātayo’."],"lineRefs":[["pv27:6"]]},{"para":1862,"vripara":"423","refs":["pv27:6"],"lines":["“Samanantarānuddiṭṭhe, vatthāni udapajjisuṃ;"],"lineRefs":[["pv27:6"]]},{"para":1863,"vripara":null,"refs":["pv27:6"],"lines":["Tato suvatthavasano, therassa dassayītumaṃ."],"lineRefs":[["pv27:6"]]},{"para":1865,"vripara":"424","refs":["pv27:6"],"lines":["“Yāvatā nandarājassa, vijitasmiṃ paṭicchadā;"],"lineRefs":[["pv27:6"]]},{"para":1866,"vripara":null,"refs":["pv27:6"],"lines":["Tato bahutarā bhante, vatthānacchādanāni no."],"lineRefs":[["pv27:6"]]},{"para":1868,"vripara":"425","refs":["pv27:6"],"lines":["“Koseyyakambalīyāni, khomakappāsikāni ca;"],"lineRefs":[["pv27:6"]]},{"para":1869,"vripara":null,"refs":["pv27:6"],"lines":["Vipulā ca mahagghā ca, tepākāsevalambare."],"lineRefs":[["pv27:6"]]},{"para":1871,"vripara":"426","refs":["pv27:6"],"lines":["“Te mayaṃ paridahāma, yaṃ yañhi manaso piyaṃ;"],"lineRefs":[["pv27:6"]]},{"para":1872,"vripara":null,"refs":["pv27:6"],"lines":["Tathā bhante parakkama, yathā gehaṃ labhāmase."],"lineRefs":[["pv27:6"]]},{"para":1874,"vripara":"427","refs":["pv27:6"],"lines":["“Thero paṇṇakuṭiṃ katvā, saṅghe cātuddise adā;"],"lineRefs":[["pv27:6"]]},{"para":1875,"vripara":null,"refs":["pv27:6"],"lines":["Datvā ca anvādisī thero, mātu pitu ca bhātuno;"],"lineRefs":[["pv27:6"]]},{"para":1876,"vripara":null,"refs":["pv27:6"],"lines":["‘Idaṃ me ñātīnaṃ hotu, sukhitā hontu ñātayo’."],"lineRefs":[["pv27:6"]]},{"para":1878,"vripara":"428","refs":["pv27:6"],"lines":["“Samanantarānuddiṭṭhe, gharāni udapajjisuṃ;"],"lineRefs":[["pv27:6"]]},{"para":1879,"vripara":null,"refs":["pv27:6"],"lines":["Kūṭāgāranivesanā, vibhattā bhāgaso mitā."],"lineRefs":[["pv27:6"]]},{"para":1881,"vripara":"429","refs":["pv27:6"],"lines":["“Na manussesu īdisā, yādisā no gharā idha;"],"lineRefs":[["pv27:6"]]},{"para":1882,"vripara":null,"refs":["pv27:6"],"lines":["Api dibbesu yādisā, tādisā no gharā idha."],"lineRefs":[["pv27:6"]]},{"para":1884,"vripara":"430","refs":["pv27:6"],"lines":["“Daddallamānā ābhenti, samantā caturo disā;"],"lineRefs":[["pv27:6"]]},{"para":1885,"vripara":null,"refs":["pv27:6"],"lines":["Tathā bhante parakkama, yathā pānīyaṃ labhāmase."],"lineRefs":[["pv27:6"]]},{"para":1887,"vripara":"431","refs":["pv27:6"],"lines":["“Thero karaṇaṃ pūretvā, saṅghe cātuddise adā;"],"lineRefs":[["pv27:6"]]},{"para":1888,"vripara":null,"refs":["pv27:6"],"lines":["Datvā anvādisī thero, mātu pitu ca bhātuno;"],"lineRefs":[["pv27:6"]]},{"para":1889,"vripara":null,"refs":["pv27:6"],"lines":["‘Idaṃ me ñātīnaṃ hotu, sukhitā hontu ñātayo’."],"lineRefs":[["pv27:6"]]},{"para":1891,"vripara":"432","refs":["pv27:6"],"lines":["“Samanantarānuddiṭṭhe, pānīyaṃ udapajjatha;"],"lineRefs":[["pv27:6"]]},{"para":1892,"vripara":null,"refs":["pv27:6"],"lines":["Gambhīrā caturassā ca, pokkharañño sunimmitā."],"lineRefs":[["pv27:6"]]},{"para":1894,"vripara":"433","refs":["pv27:6"],"lines":["“Sītodikā suppatitthā, sītā appaṭigandhiyā;"],"lineRefs":[["pv27:6"]]},{"para":1895,"vripara":null,"refs":["pv27:6"],"lines":["Padumuppalasañchannā, vārikiñjakkhapūritā."],"lineRefs":[["pv27:6"]]},{"para":1897,"vripara":"434","refs":["pv27:6"],"lines":["“Tattha nhatvā pivitvā ca, therassa paṭidassayuṃ;"],"lineRefs":[["pv27:6"]]},{"para":1898,"vripara":null,"refs":["pv27:6"],"lines":["Pahūtaṃ pānīyaṃ bhante, pādā dukkhā phalanti no."],"lineRefs":[["pv27:6"]]},{"para":1900,"vripara":"435","refs":["pv27:6"],"lines":["“Āhiṇḍamānā khañjāma, sakkhare kusakaṇṭake;"],"lineRefs":[["pv27:6"]]},{"para":1901,"vripara":null,"refs":["pv27:6"],"lines":["Tathā bhante parakkama, yathā yānaṃ labhāmase."],"lineRefs":[["pv27:6"]]},{"para":1903,"vripara":"436","refs":["pv27:6"],"lines":["“Thero sipāṭikaṃ laddhā, saṅghe cātuddise adā;"],"lineRefs":[["pv27:6"]]},{"para":1904,"vripara":null,"refs":["pv27:6"],"lines":["Datvā anvādisī thero, mātu pitu ca bhātuno;"],"lineRefs":[["pv27:6"]]},{"para":1905,"vripara":null,"refs":["pv27:6"],"lines":["‘Idaṃ me ñātīnaṃ hotu, sukhitā hontu ñātayo’."],"lineRefs":[["pv27:6"]]},{"para":1907,"vripara":"437","refs":["pv27:6"],"lines":["“Samanantarānuddiṭṭhe, petā rathena māgamuṃ;"],"lineRefs":[["pv27:6"]]},{"para":1908,"vripara":null,"refs":["pv27:6"],"lines":["Anukampitamha bhadante, bhattenacchādanena ca."],"lineRefs":[["pv27:6"]]},{"para":1910,"vripara":"438","refs":["pv27:6"],"lines":["“Gharena pānīyadānena, yānadānena cūbhayaṃ;"],"lineRefs":[["pv27:6"]]},{"para":1911,"vripara":null,"refs":["pv27:6"],"lines":["Muniṃ kāruṇikaṃ loke, bhante vanditumāgatā”ti.","– gāthāyo āhaṃsu;"],"lineRefs":[["pv27:6"],["pv27:6"]]},{"para":1912,"vripara":"416-417","refs":["pv27:9"],"lines":["416-7. Tattha <b>thero caritvā piṇḍāyā</b>ti thero piṇḍāpātacārikāya caritvā.","<b>Bhikkhū aññe ca dvādasā</b>ti therena saha vasantā aññe ca dvādasa bhikkhū <b>ekajjhaṃ</b> ekato <b>sannipatiṃsu</b>.","Kasmāti ce?","<b>Bhattavissaggakāraṇā</b>ti bhattakiccakāraṇā bhuñjananimittaṃ.","<b>Te</b>ti te bhikkhū.","<b>Yathāladdhan</b>ti yaṃ yaṃ laddhaṃ.","<b>Dadāthā</b>ti detha."],"lineRefs":[["pv27:9"],["pv27:9"],["pv27:9"],["pv27:9"],["pv27:9"],["pv27:9"],["pv27:9"]]},{"para":1913,"vripara":"418","refs":["pv27:11"],"lines":["<b>Niyyādayiṃsū</b>ti adaṃsu.","<b>Saṅghaṃ nimantayī</b>ti te eva dvādasa bhikkhū saṅghuddesavasena taṃ bhattaṃ dātuṃ nimantesi.","<b>Anvādisī</b>ti ādisi.","Tattha yesaṃ anvādisi, te dassetuṃ <b>“mātu pitu ca bhātuno, idaṃ me ñātīnaṃ hotu, sukhitā hontu ñātayo”</b>ti vuttaṃ."],"lineRefs":[["pv27:11"],["pv27:11"],["pv27:11"],["pv27:11"]]},{"para":1914,"vripara":"419","refs":["pv27:12"],"lines":["<b>Samanantarānuddiṭṭhe</b>ti uddiṭṭhasamanantarameva.","<b>Bhojanaṃ udapajjathā</b>ti tesaṃ petānaṃ bhojanaṃ uppajji.","Kīdisanti āha <b>“sucin”</b>tiādi.","Tattha <b>anekarasabyañjanan</b>ti nānārasehi byañjanehi yuttaṃ, atha vā anekarasaṃ anekabyañjanañca.","<b>Tato</b>ti bhojanalābhato pacchā."],"lineRefs":[["pv27:12"],["pv27:12"],["pv27:12"],["pv27:12"],["pv27:12"]]},{"para":1915,"vripara":"420","refs":["pv27:13"],"lines":["<b>Uddassayī bhātā</b>ti bhātikabhūto peto therassa attānaṃ dassesi.","<b>Vaṇṇavā balavā sukhī</b>ti tena bhojanalābhena tāvadeva rūpasampanno balasampanno sukhitova hutvā.","<b>Pahūtaṃ bhojanaṃ, bhante</b>ti, bhante, tava dānānubhāvena pahūtaṃ anappakaṃ bhojanaṃ amhehi laddhaṃ.","<b>Passa naggāmhase</b>ti olokehi, naggikā pana amha, tasmā tathā, bhante, <b>parakkama</b> payogaṃ karohi.","<b>Yathā vatthaṃ labhāmase</b>ti yena pakārena yādisena payogena sabbeva mayaṃ vatthāni labheyyāma, tathā vāyamathāti attho."],"lineRefs":[["pv27:13"],["pv27:13"],["pv27:13"],["pv27:13"],["pv27:13"]]},{"para":1916,"vripara":"421","refs":["pv27:14"],"lines":["<b>Saṅkārakūṭamhā</b>ti tattha tattha saṅkāraṭṭhānato.","<b>Uccinitvānā</b>ti gavesanavasena gahetvā.","<b>Nantake</b>ti chinnapariyante chaḍḍitadussakhaṇḍe.","Te pana yasmā khaṇḍabhūtā pilotikā nāma honti, tāhi ca thero cīvaraṃ katvā saṅghassa adāsi, tasmā āha <b>“pilotikaṃ paṭaṃ katvā, saṅghe cātuddise adā”</b>ti.","Tattha <b>saṅghe cātuddise adā</b>ti catūhipi disāhi āgatabhikkhusaṅghassa adāsi.","Sampadānatthe hi idaṃ bhummavacanaṃ."],"lineRefs":[["pv27:14"],["pv27:14"],["pv27:14"],["pv27:14"],["pv27:14"],["pv27:14"]]},{"para":1917,"vripara":"423-424","refs":["pv27:16"],"lines":["423-4. <b>Suvatthavasano</b>ti sundaravatthavasano.","<b>Therassa dassayītuman</b>ti therassa attānaṃ dassayi dassesi, pākaṭo ahosi.","Paṭicchādayati etthāti <b>paṭicchadā</b>."],"lineRefs":[["pv27:16"],["pv27:16"],["pv27:16"]]},{"para":1918,"vripara":"428-429","refs":["pv27:21"],"lines":["428-9. <b>Kūṭāgāranivesanā</b>ti kūṭāgārabhūtā tadaññanivesanasaṅkhātā ca gharā.","Liṅgavipallāsavasena hetaṃ vuttaṃ.","<b>Vibhattā</b>ti samacaturassaāyatavaṭṭasaṇṭhānādivasena vibhattā.","<b>Bhāgaso mitā</b>ti bhāgena paricchinnā.","<b>No</b>ti amhākaṃ.","<b>Idhā</b>ti imasmiṃ petaloke.","<b>Api dibbesū</b>ti <b>apī</b>ti nipātamattaṃ, devalokesūti attho."],"lineRefs":[["pv27:21"],["pv27:21"],["pv27:21"],["pv27:21"],["pv27:21"],["pv27:21"],["pv27:21"]]},{"para":1919,"vripara":"431","refs":["pv27:24"],"lines":["<b>Karaṇan</b>ti dhamakaraṇaṃ.","<b>Pūretvā</b>ti udakassa pūretvā.","<b>Vārikiñjakkhapūritā</b>ti tattha tattha vārimatthake padumuppalādīnaṃ kesarabhārehi sañchāditavasena pūritā.","<b>Phalantī</b>ti pupphanti, paṇhikapariyantādīsu vidālentīti attho."],"lineRefs":[["pv27:24"],["pv27:24"],["pv27:24"],["pv27:24"]]},{"para":1920,"vripara":"435-436","refs":["pv27:28"],"lines":["435-6. <b>Āhiṇḍamānā</b>ti vicaramānā.","<b>Khañjāmā</b>ti khañjanavasena gacchāma.","<b>Sakkhare kusakaṇṭake</b>ti sakkharavati kusakaṇṭakavati ca bhūmibhāge, sakkhare kusakaṇṭake ca akkamantāti attho.","<b>Yānan</b>ti rathavayhādikaṃ yaṃkiñci yānaṃ.","<b>Sipāṭikan</b>ti ekapaṭalaupāhanaṃ."],"lineRefs":[["pv27:28"],["pv27:28"],["pv27:28"],["pv27:28"],["pv27:28"]]},{"para":1921,"vripara":"437-438","refs":["pv27:30"],"lines":["437-8. <b>Rathena māgamun</b>ti makāro padasandhikaro, rathena āgamaṃsu.","<b>Ubhayan</b>ti ubhayena dānena, yānadānena ceva bhattādicatupaccayadānena ca.","Pānīyadānena hettha bhesajjadānampi saṅgahitaṃ.","Sesaṃ heṭṭhā vuttanayattā uttānamevāti."],"lineRefs":[["pv27:30"],["pv27:30"],["pv27:30"],["pv27:30"]]}],"wordLinks":[["pv27:1.1","kuṇḍināgariyo thero",0,0],["pv27:1.1","sāṇavāsinivāsiko",0,1],["pv27:1.3","poṭṭhapādoti nāmenā",0,2],["pv27:1.3","samaṇo",0,3],["pv27:1.3","bhāvitindriyo",0,4],["pv27:3.1","sūcikaṭṭā",1,0],["pv27:3.1","kilantā",1,2],["pv27:3.1","naggino",1,3],["pv27:3.1","kisā",1,4],["pv27:3.3","uttasantā",1,5],["pv27:3.3","mahattāsā",1,6],["pv27:3.3","na dassentī",1,7],["pv27:3.3","kurūrino",1,8],["pv27:4.1","tassa bhātā",2,0],["pv27:4.1","vitaritvā",2,1],["pv27:4.1","ekapathe",2,3],["pv27:4.1","ekako",2,4],["pv27:4.3","catukuṇḍiko bhavitvānā",2,5],["pv27:4.3","therassa dassayītumaṃ",2,7],["pv27:5.3","so cā",3,1],["pv27:5.3","bhātā petagato ahaṃ",3,2],["pv27:6.1","mātā pitā cā",4,0],["pv27:6.1","mātā pitā ca te",4,1],["pv27:9.1","thero caritvā piṇḍāyā",57,0],["pv27:9.1","bhikkhū aññe ca dvādasā",57,1],["pv27:9.3","ekajjhaṃ",57,1],["pv27:9.3","sannipatiṃsu",57,1],["pv27:9.3","bhattavissaggakāraṇā",57,3],["pv27:11.1","niyyādayiṃsū",58,0],["pv27:11.1","saṅghaṃ nimantayī",58,1],["pv27:11.3","anvādisī",58,2],["pv27:12.1","samanantarānuddiṭṭhe",59,0],["pv27:12.1","bhojanaṃ udapajjathā",59,1],["pv27:12.3","suciṃ",59,2],["pv27:12.3","anekarasabyañjanaṃ",59,3],["pv27:13.1","uddassayī bhātā",60,0],["pv27:13.1","vaṇṇavā balavā sukhī",60,1],["pv27:13.3","pahūtaṃ bhojanaṃ bhante",60,2],["pv27:13.3","passa naggāmhase",60,3],["pv27:13.5","parakkama",60,3],["pv27:13.5","yathā vatthaṃ labhāmase",60,4],["pv27:14.1","saṅkārakūṭamhā",61,0],["pv27:14.1","uccinitvānā",61,1],["pv27:14.1","nantake",61,2],["pv27:14.3","pilotikaṃ paṭaṃ katvā saṅghe cātuddise adā",61,3],["pv27:14.3","saṅghe cātuddise adā",61,4],["pv27:16.3","suvatthavasano",62,0],["pv27:16.3","therassa dassayītumaṃ",62,1],["pv27:21.3","kūṭāgāranivesanā",63,0],["pv27:21.3","vibhattā",63,2],["pv27:21.3","bhāgaso mitā",63,3],["pv27:24.1","karaṇaṃ",64,0],["pv27:24.1","pūretvā",64,1],["pv27:28.1","āhiṇḍamānā",65,0],["pv27:28.1","khañjāmā",65,1],["pv27:28.1","sakkhare kusakaṇṭake",65,2],["pv27:28.3","yānaṃ",65,3],["pv27:30.1","rathena māgamuṃ",66,0]],"before":[{"para":1803,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Sāṇavāsittherapetavatthuvaṇṇanā"]},{"para":1804,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["<b>Kuṇḍināgariyo thero</b>ti idaṃ satthari veḷuvane viharante āyasmato sāṇavāsittherassa ñātipete ārabbha vuttaṃ.","Atīte kira bārāṇasiyaṃ kitavassa nāma rañño putto uyyānakīḷaṃ kīḷitvā nivattanto sunettaṃ nāma paccekabuddhaṃ piṇḍāya caritvā nagarato nikkhamantaṃ disvā issariyamadamatto hutvā “kathañhi nāma mayhaṃ añjaliṃ akatvā ayaṃ muṇḍako gacchatī”ti paduṭṭhacitto hatthikkhandhato otaritvā “kacci te piṇḍapāto laddho”ti ālapanto hatthato pattaṃ gahetvā pathaviyaṃ pātetvā bhindi.","Atha naṃ sabbattha tādibhāvappattiyā nibbikāraṃ karuṇāvipphārasomanassanipātapasannacittameva olokentaṃ aṭṭhānāghātena dūsitacitto “kiṃ maṃ kitavassa rañño puttaṃ na jānāsi, tvaṃ olokayanto mayhaṃ kiṃ karissasī”ti vatvā avahasanto pakkāmi.","Pakkantamattasseva cassa narakaggidāhapaṭibhāgo balavasarīradāho uppajji.","So tena mahāsantāpenābhibhūtakāyo atibāḷhaṃ dukkhavedanābhitunno kālaṃ katvā avīcīmahāniraye nibbatti."]},{"para":1805,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["So tattha dakkhiṇapassena vāmapassena uttāno avakujjoti bahūhi pakārehi parivattitvā caturāsīti vassasahassāni paccitvā tato cuto petesu apirimitakālaṃ khuppipāsādidukkhaṃ anubhavitvā tato cuto imasmiṃ buddhuppāde kuṇḍinagarassa samīpe kevaṭṭagāme nibbatti.","Tassa jātissarañāṇaṃ uppajji, tena so pubbe attanā anubhūtapubbaṃ dukkhaṃ anussaranto vayappattopi pāpabhayena ñātakehipi saddhiṃ macchabandhanatthaṃ na gacchati.","Tesu gacchantesu macche ghātetuṃ anicchanto nilīyati, gato ca jālaṃ bhindati, jīvante vā macche gahetvā udake vissajjeti, tassa taṃ kiriyaṃ arocantā ñātakā gehato taṃ nīhariṃsu.","Eko panassa bhātā sinehabaddhahadayo ahosi."]},{"para":1806,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Tena ca samayena āyasmā ānando kuṇḍinagaraṃ upanissāya sāṇapabbate viharati.","Atha so kevaṭṭaputto ñātakehi pariccatto hutvā ito cito ca paribbhamanto taṃ padesaṃ patto bhojanavelāya therassa santikaṃ upasaṅkami.","Thero taṃ pucchitvā bhojanena atthikabhāvaṃ ñatvā tassa bhattaṃ datvā katabhattakicco sabbaṃ taṃ pavattiṃ ñatvā dhammakathāya pasannamānasaṃ ñatvā “pabbajissasi, āvuso”ti?","“Āma, bhante, pabbajissāmī”ti.","Thero taṃ pabbājetvā tena saddhiṃ bhagavato santikaṃ agamāsi.","Atha naṃ satthā āha –","“ānanda, imaṃ sāmaṇeraṃ anukampeyyāsī”ti.","So ca akatakusalattā appalābho ahosi.","Atha naṃ satthā anuggaṇhanto bhikkhūnaṃ paribhogatthāya pānīyaghaṭānaṃ paripūraṇe niyojesi.","Taṃ disvā upāsakā tassa bahūni niccabhattāni paṭṭhapesuṃ."]},{"para":1807,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["So aparena samayena laddhūpasampado arahattaṃ patvā thero hutvā dvādasahi bhikkhūhi saddhiṃ sāṇapabbate vasi.","Tassa pana ñātakā pañcasatamattā anupacitakusalakammā upacitamaccherādipāpadhammā kālaṃ katvā petesu nibbattiṃsu.","Tassa pana mātāpitaro “esa amhehi pubbe gehato nikkaḍḍhito”ti sārajjamānā taṃ anupasaṅkamitvā tasmiṃ baddhasinehaṃ bhātikaṃ pesesuṃ.","So therassa gāmaṃ piṇḍāya paviṭṭhasamaye dakkhiṇajāṇumaṇḍalaṃ pathaviyaṃ patiṭṭhāpetvā katañjalī attānaṃ dassetvā <b>“mātā pitā ca te, bhante”</b>tiādigāthā avoca.","<b>Kuṇḍināgariyo thero</b>tiādayo pana ādito pañca gāthā tāsaṃ sambandhadassanatthaṃ dhammasaṅgāhakehi ṭhapitā."]},{"para":1809,"vripara":"408","title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["“Kuṇḍināgariyo thero, sāṇavāsinivāsiko;"]},{"para":1810,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Poṭṭhapādoti nāmena, samaṇo bhāvitindriyo."]},{"para":1812,"vripara":"409","title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["“Tassa mātā pitā bhātā, duggatā yamalokikā;"]},{"para":1813,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gatā."]},{"para":1815,"vripara":"410","title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["“Te duggatā sūcikaṭṭā, kilantā naggino kisā;"]},{"para":1816,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Uttasantā mahattāsā, na dassenti kurūrino."]},{"para":1818,"vripara":"411","title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["“Tassa bhātā vitaritvā, naggo ekapathekako;"]},{"para":1819,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Catukuṇḍiko bhavitvāna, therassa dassayītumaṃ."]},{"para":1821,"vripara":"412","title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["“Thero cāmanasikatvā, tuṇhībhūto atikkami;"]},{"para":1822,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["So ca viññāpayī theraṃ,‘bhātā petagato ahaṃ’."]},{"para":1824,"vripara":"413","title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["“Mātā pitā ca te bhante, duggatā yamalokikā;"]},{"para":1825,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gatā."]},{"para":1827,"vripara":"414","title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["“Tena duggatā sūcikaṭṭā, kilantā naggino kisā;"]},{"para":1828,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Uttasantā mahattāsā, na dassenti kurūrino."]},{"para":1830,"vripara":"415","title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["“Anukampassu kāruṇiko, datvā anvādisāhi no;"]},{"para":1831,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Tava dinnena dānena, yāpessanti kurūrino”ti."]}],"after":[{"para":1922,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Thero taṃ pavattiṃ bhagavato ārocesi.","Bhagavā tamatthaṃ aṭṭhuppattiṃ katvā “yathā ime etarahi, evaṃ tvampi ito anantarātīte attabhāve peto hutvā mahādukkhaṃ anubhavī”ti vatvā therena yācito suttapetavatthuṃ kathetvā sampattaparisāya dhammaṃ desesi.","Taṃ sutvā mahājano sañjātasaṃvego dānasīlādipuññakammanirato ahosīti."]},{"para":1923,"vripara":null,"title":"Sāṇavāsittherapetavatthuvaṇṇanā","lines":["Sāṇavāsittherapetavatthuvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
