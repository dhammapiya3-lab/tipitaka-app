{"suttaId":"sn46.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[502,513],"vripara":"198"},"segments":{"sn46.17:0.3":"Pāraṅgamasuttaṃ","sn46.17:1.1":"“Sattime, bhikkhave, bojjhaṅgā bhāvitā bahulīkatā apārā pāraṃ gamanāya saṃvattanti.","sn46.17:1.2":"Katame satta?","sn46.17:1.3":"Satisambojjhaṅgo…pe… upekkhāsambojjhaṅgo –","sn46.17:1.4":"ime kho, bhikkhave, satta bojjhaṅgā bhāvitā bahulīkatā apārā pāraṃ gamanāya saṃvattantī”ti.","sn46.17:2.1":"“Appakā te manussesu,","sn46.17:2.2":"ye janā pāragāmino;","sn46.17:2.3":"Athāyaṃ itarā pajā,","sn46.17:2.4":"tīramevānudhāvati.","sn46.17:3.1":"“Ye ca kho sammadakkhāte,","sn46.17:3.2":"dhamme dhammānuvattino;","sn46.17:3.3":"Te janā pāramessanti,","sn46.17:3.4":"maccudheyyaṃ suduttaraṃ.","sn46.17:4.1":"“Kaṇhaṃ dhammaṃ vippahāya,","sn46.17:4.2":"sukkaṃ bhāvetha paṇḍito;","sn46.17:4.3":"Okā anokamāgamma,","sn46.17:4.4":"viveke yattha dūramaṃ.","sn46.17:5.1":"“Tatrābhiratimiccheyya,","sn46.17:5.2":"hitvā kāme akiñcano;","sn46.17:5.3":"Pariyodapeyya attānaṃ,","sn46.17:5.4":"cittaklesehi paṇḍito.","sn46.17:6.1":"“Yesaṃ sambodhiyaṅgesu,","sn46.17:6.2":"sammā cittaṃ subhāvitaṃ;","sn46.17:6.3":"Ādānappaṭinissagge,","sn46.17:6.4":"anupādāya ye ratā;","sn46.17:6.5":"Khīṇāsavā jutimanto,","sn46.17:6.6":"te loke parinibbutā”ti.","sn46.17:6.7":"sattamaṃ; 8."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":179,"to":182,"paras":[{"para":179,"vripara":"195-201","refs":["sn46.17:1"],"lines":["Catutthe <b>tathā pahīno cāyasmato mahākassapassa so ābādho ahosī</b>ti therassa kira imaṃ bojjhaṅgabhāvanaṃ sādhukaṃ suṇantassa etadahosi “mayhaṃ pabbajitadivasato sattame divase saccāni paṭivijjhantassa ime bojjhaṅgā pātubhūtā”ti.","Athassa “niyyānikaṃ vata satthusāsana”nti cintayato lohitaṃ pasīdi, upādārūpaṃ visuddhaṃ ahosi, pokkharapatte patitaudakabindu viya sarīrato rogo vinivattitvā gato.","Tena vuttaṃ “tathā pahīno cāyasmato mahākassapassa so ābādho ahosī”ti.","Pañcamachaṭṭhesupi eseva nayo.","Imesaṃ pana tiṇṇampi janānaṃ pabbatapāde pupphitavisarukkhavātasamphassena uppanno mandasītajaro ābādhoti veditabbo.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["sn46.17:1"],["sn46.17:1"],["sn46.17:1"],["sn46.17:1"],["sn46.17:1"],["sn46.17:1"]]},{"para":180,"vripara":null,"refs":["sn46.17:1"],"lines":["Gilānavaggo. 3."],"lineRefs":[["sn46.17:1"]]},{"para":181,"vripara":null,"refs":["sn46.17:1"],"lines":["Udāyivaggo 1-2."],"lineRefs":[["sn46.17:1"]]},{"para":182,"vripara":null,"refs":["sn46.17:1"],"lines":["Bodhāyasuttādivaṇṇanā 202-203."],"lineRefs":[["sn46.17:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":184,"to":187,"paras":[{"para":184,"vripara":"195-201","refs":["sn46.17:1"],"lines":["<b>Visuddhaṃ ahosi</b> visabhāgadhātukkhobhaṃ vūpasamentaṃ.","Tenāha –","<b>“pokkharapatte …pe… vinivattitvā gato”</b>ti.","<b>Eseva nayo</b> pāḷito atthato ca catutthena pañcamachaṭṭhānaṃ samānattā.","<b>Visarukkhavātasamphassenā</b>ti visarukkhasannissitavātasamphassena.","<b>Mandasītajaro</b>ti muduko sītajaro.","<b>Sesa</b>nti vuttāvasesaṃ.","<b>Sabbatthā</b>ti sattamādīsu catūsu."],"lineRefs":[["sn46.17:1"],["sn46.17:1"],["sn46.17:1"],["sn46.17:1"],["sn46.17:1"],["sn46.17:1"],["sn46.17:1"],["sn46.17:1"]]},{"para":185,"vripara":null,"refs":["sn46.17:1"],"lines":["Gilānavaggavaṇṇanā niṭṭhitā. 3."],"lineRefs":[["sn46.17:1"]]},{"para":186,"vripara":null,"refs":["sn46.17:1"],"lines":["Udāyivaggo 1-2."],"lineRefs":[["sn46.17:1"]]},{"para":187,"vripara":null,"refs":["sn46.17:1"],"lines":["Bodhāyasuttādivaṇṇanā 202-203."],"lineRefs":[["sn46.17:1"]]}],"wordLinks":[]},"tika2":null}
