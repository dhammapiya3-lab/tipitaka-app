{"suttaId":"tha-ap233","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7972,7985],"vripara":"1"},"segments":{"tha-ap233:0.3":"Udakāsanadāyakattheraapadānaṃ","tha-ap233:1.1":"“Ārāmadvārā nikkhamma, phalakaṃ santhariṃ ahaṃ;","tha-ap233:1.3":"Udakañca upaṭṭhāsiṃ, uttamatthassa pattiyā.","tha-ap233:2.1":"“Ekattiṃse ito kappe, yaṃ kammamakariṃ tadā;","tha-ap233:2.3":"Duggatiṃ nābhijānāmi, āsane codake phalaṃ.","tha-ap233:3.1":"“Ito pannarase kappe, abhisāmasamavhayo;","tha-ap233:3.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap233:4.1":"“Paṭisambhidā catasso, vimokkhāpi ca aṭṭhime;","tha-ap233:4.3":"Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanaṃ”.","tha-ap233:5.1":"Itthaṃ sudaṃ āyasmā udakāsanadāyako thero imā gāthāyo abhāsitthāti.","tha-ap233:6.1":"Udakāsanadāyakattherassāpadānaṃ paṭhamaṃ."},"attha":null,"tika":null,"tika2":null}
