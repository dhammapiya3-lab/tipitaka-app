{"suttaId":"tha-ap233","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7972,7985],"vripara":"1"},"segments":{"tha-ap233:0.3":"Udakāsanadāyakattheraapadānaṃ","tha-ap233:1.1":"“Ārāmadvārā nikkhamma,","tha-ap233:1.2":"phalakaṃ santhariṃ ahaṃ;","tha-ap233:1.3":"Udakañca upaṭṭhāsiṃ,","tha-ap233:1.4":"uttamatthassa pattiyā.","tha-ap233:2.1":"“Ekattiṃse ito kappe,","tha-ap233:2.2":"yaṃ kammamakariṃ tadā;","tha-ap233:2.3":"Duggatiṃ nābhijānāmi,","tha-ap233:2.4":"āsane codake phalaṃ.","tha-ap233:3.1":"“Ito pannarase kappe,","tha-ap233:3.2":"abhisāmasamavhayo;","tha-ap233:3.3":"Sattaratanasampanno,","tha-ap233:3.4":"cakkavattī mahabbalo.","tha-ap233:4.1":"“Paṭisambhidā catasso,","tha-ap233:4.2":"vimokkhāpi ca aṭṭhime;","tha-ap233:4.3":"Chaḷabhiññā sacchikatā,","tha-ap233:4.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap233:5.1":"Itthaṃ sudaṃ āyasmā udakāsanadāyako thero imā gāthāyo abhāsitthāti.","tha-ap233:6.1":"Udakāsanadāyakattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
