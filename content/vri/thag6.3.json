{"suttaId":"thag6.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1757,1775],"vripara":"387"},"segments":{"thag6.3:0.4":"Mahānāgattheragāthā","thag6.3:1.1":"“Yassa sabrahmacārīsu, gāravo nūpalabbhati;","thag6.3:1.3":"Parihāyati saddhammā, maccho appodake yathā.","thag6.3:2.1":"“Yassa sabrahmacārīsu, gāravo nūpalabbhati;","thag6.3:2.3":"Na virūhati saddhamme, khette bījaṃva pūtikaṃ.","thag6.3:3.1":"“Yassa sabrahmacārīsu, gāravo nūpalabbhati;","thag6.3:3.3":"Ārakā hoti nibbānā [nibbāṇā (sī.)], dhammarājassa sāsane.","thag6.3:4.1":"“Yassa sabrahmacārīsu, gāravo upalabbhati;","thag6.3:4.3":"Na vihāyati saddhammā, maccho bavhodake [bahvodake (sī.), bahodake (syā.)] yathā.","thag6.3:5.1":"“Yassa sabrahmacārīsu, gāravo upalabbhati;","thag6.3:5.3":"So virūhati saddhamme, khette bījaṃva bhaddakaṃ.","thag6.3:6.1":"“Yassa sabrahmacārīsu, gāravo upalabbhati;","thag6.3:6.3":"Santike hoti nibbānaṃ [nibbāṇaṃ (sī.)], dhammarājassa sāsane”ti.","thag6.3:6.5":"… Mahānāgo thero …."},"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":1177,"to":1177,"paras":[{"para":1177,"vripara":null,"refs":["thag6.3:6"],"lines":["Tattha <b>sabrahmacārīsū</b>ti samānaṃ brahmaṃ sīlādidhammaṃ carantīti sabrahmacārino, sīladiṭṭhisāmaññagatā sahadhammikā, tesu.","<b>Gāravo</b>ti garubhāvo sīlādiguṇanimittaṃ garukaraṇaṃ.","<b>Nūpalabbhatī</b>ti na vijjati na pavattati, na upatiṭṭhatīti attho.","<b>Nibbānā</b>ti kilesānaṃ nibbāpanato kilesakkhayāti attho.","<b>Dhammarājassā</b>ti satthuno.","Satthā hi sadevakaṃ lokaṃ yathārahaṃ lokiyalokuttarena dhammena rañjeti tosetīti <b>dhammarājā</b>.","Ettha ca “dhammarājassa sāsane”ti iminā nibbānaṃ nāma dhammarājasseva sāsane, na aññattha.","Tattha yo sabrahmacārīsu gāravarahito, so yathā nibbānā ārakā hoti, tathā dhammarājassa sāsanatopi ārakā hotīti dasseti.","<b>Bavhodake</b>ti bahuudake.","<b>Santike hoti nibbānan</b>ti nibbānaṃ tassa santike samīpe eva hoti.","Sesaṃ vuttanayameva.","Imā eva ca therassa aññābyākaraṇagāthā ahesuṃ."],"lineRefs":[["thag6.3:6"],["thag6.3:6"],["thag6.3:6"],["thag6.3:6"],["thag6.3:6"],["thag6.3:6"],["thag6.3:6"],["thag6.3:6"],["thag6.3:6"],["thag6.3:6"],["thag6.3:6"],["thag6.3:6"]]}],"wordLinks":[["thag6.3:6.1","sabrahmacārīsū",0,0],["thag6.3:6.1","gāravo",0,1],["thag6.3:6.3","nibbānā",0,3],["thag6.3:6.3","dhammarājassā",0,4],["thag6.3:6.3","dhammarājā",0,5],["thag6.3:6.3","santike hoti nibbānaṃ",0,9]],"before":[{"para":1133,"vripara":null,"refs":[],"lines":["“Nagare bandhumatiyā, vejjo āsiṃ susikkhito;"],"lineRefs":[[]]},{"para":1134,"vripara":null,"refs":[],"lines":["Āturānaṃ sadukkhānaṃ, mahājanasukhāvaho."],"lineRefs":[[]]},{"para":1135,"vripara":null,"refs":[],"lines":["“Byādhitaṃ samaṇaṃ disvā, sīlavantaṃ mahājutiṃ;"],"lineRefs":[[]]},{"para":1136,"vripara":null,"refs":[],"lines":["Pasannacitto sumano, bhesajjamadadiṃ tadā."],"lineRefs":[[]]},{"para":1137,"vripara":null,"refs":[],"lines":["“Arogo āsi teneva, samaṇo saṃvutindriyo;"],"lineRefs":[[]]},{"para":1138,"vripara":null,"refs":[],"lines":["Asoko nāma nāmena, upaṭṭhāko vipassino."],"lineRefs":[[]]},{"para":1139,"vripara":null,"refs":[],"lines":["“Ekanavutito kappe, yaṃ osadhamadāsahaṃ;"],"lineRefs":[[]]},{"para":1140,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, bhesajjassa idaṃ phalaṃ."],"lineRefs":[[]]},{"para":1141,"vripara":null,"refs":[],"lines":["“Ito ca aṭṭhame kappe, sabbosadhasanāmako;"],"lineRefs":[[]]},{"para":1142,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahapphalo."],"lineRefs":[[]]},{"para":1143,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":1144,"vripara":null,"refs":[],"lines":["Ettha ca bindusārarañño kāle imassa therassa uppannattā tatiyasaṅgītiyaṃ imā gāthā saṅgītāti veditabbā."],"lineRefs":[[]]},{"para":1145,"vripara":null,"refs":[],"lines":["Tekicchakārittheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1146,"vripara":null,"refs":[],"lines":["Mahānāgattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":1147,"vripara":null,"refs":[],"lines":["<b>Yassa sabrahmacārīsū</b>tiādikā āyasmato mahānāgattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinanto kakusandhassa bhagavato kāle kulagehe nibbattitvā viññutaṃ patto ekadivasaṃ kakusandhaṃ bhagavantaṃ araññaṃ ajjhogāhetvā aññatarasmiṃ rukkhamūle jhānasukhena nisinnaṃ disvā pasannamānaso tassa dāḷimaphalaṃ adāsi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde sākete madhuvāseṭṭhassa nāma brāhmaṇassa putto hutvā nibbatti, <b>mahānāgo</b>tissa nāmaṃ ahosi.","So viññutaṃ patto bhagavati sākete añjanavane viharante āyasmato gavampatittherassa pāṭihāriyaṃ disvā paṭiladdhasaddho therasseva santike pabbajitvā tassovāde ṭhatvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.45.1-7)–"],"lineRefs":[[],[],[],[],[],[]]},{"para":1148,"vripara":null,"refs":[],"lines":["“Kakusandho mahāvīro, sabbadhammāna pāragū;"],"lineRefs":[[]]},{"para":1149,"vripara":null,"refs":[],"lines":["Gaṇamhā vūpakaṭṭho so, agamāsi vanantaraṃ."],"lineRefs":[[]]},{"para":1150,"vripara":null,"refs":[],"lines":["“Bījamiñjaṃ gahetvāna, latāya āvuṇiṃ ahaṃ;"],"lineRefs":[[]]},{"para":1151,"vripara":null,"refs":[],"lines":["Bhagavā tamhi samaye, jhāyate pabbatantare."],"lineRefs":[[]]},{"para":1152,"vripara":null,"refs":[],"lines":["“Disvānahaṃ devadevaṃ, vippasannena cetasā;"],"lineRefs":[[]]},{"para":1153,"vripara":null,"refs":[],"lines":["Dakkhiṇeyyassa vīrassa, bījamiñjamadāsahaṃ."],"lineRefs":[[]]},{"para":1154,"vripara":null,"refs":[],"lines":["“Imasmiṃyeva kappamhi, yaṃ miñjamadadiṃ tadā;"],"lineRefs":[[]]},{"para":1155,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, bījamiñjassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":1156,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":1157,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā vimuttisukhena viharanto thero chabbaggiye bhikkhū sabrahmacārīsu gāravaṃ akatvā viharante disvā tesaṃ ovādadānavasena –"],"lineRefs":[[]]},{"para":1159,"vripara":"387","refs":[],"lines":["“Yassa sabrahmacārīsu, gāravo nūpalabbhati;"],"lineRefs":[[]]},{"para":1160,"vripara":null,"refs":[],"lines":["Parihāyati saddhammā, maccho appodake yathā."],"lineRefs":[[]]},{"para":1162,"vripara":"388","refs":[],"lines":["“Yassa sabrahmacārīsu, gāravo nūpalabbhati;"],"lineRefs":[[]]},{"para":1163,"vripara":null,"refs":[],"lines":["Na virūhati saddhamme, khette bījaṃva pūtikaṃ."],"lineRefs":[[]]},{"para":1165,"vripara":"389","refs":[],"lines":["“Yassa sabrahmacārīsu, gāravo nūpalabbhati;"],"lineRefs":[[]]},{"para":1166,"vripara":null,"refs":[],"lines":["Ārakā hoti nibbānā, dhammarājassa sāsane."],"lineRefs":[[]]},{"para":1168,"vripara":"390","refs":[],"lines":["“Yassa sabrahmacārīsu, gāravo upalabbhati;"],"lineRefs":[[]]},{"para":1169,"vripara":null,"refs":[],"lines":["Na vihāyati saddhammā, maccho bavhodake yathā."],"lineRefs":[[]]},{"para":1171,"vripara":"391","refs":[],"lines":["“Yassa sabrahmacārīsu, gāravo upalabbhati;"],"lineRefs":[[]]},{"para":1172,"vripara":null,"refs":[],"lines":["So virūhati saddhamme, khette bījaṃva bhaddakaṃ."],"lineRefs":[[]]},{"para":1174,"vripara":"392","refs":[],"lines":["“Yassa sabrahmacārīsu, gāravo upalabbhati;"],"lineRefs":[[]]},{"para":1175,"vripara":null,"refs":[],"lines":["Santike hoti nibbānaṃ, dhammarājassa sāsane”ti.","–"],"lineRefs":[[],[]]},{"para":1176,"vripara":null,"refs":[],"lines":["Imā cha gāthā abhāsi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
