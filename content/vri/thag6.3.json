{"suttaId":"thag6.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1757,1775],"vripara":"387"},"segments":{"thag6.3:0.4":"Mahānāgattheragāthā","thag6.3:1.1":"“Yassa sabrahmacārīsu, gāravo nūpalabbhati;","thag6.3:1.3":"Parihāyati saddhammā, maccho appodake yathā.","thag6.3:2.1":"“Yassa sabrahmacārīsu, gāravo nūpalabbhati;","thag6.3:2.3":"Na virūhati saddhamme, khette bījaṃva pūtikaṃ.","thag6.3:3.1":"“Yassa sabrahmacārīsu, gāravo nūpalabbhati;","thag6.3:3.3":"Ārakā hoti nibbānā [nibbāṇā (sī.)], dhammarājassa sāsane.","thag6.3:4.1":"“Yassa sabrahmacārīsu, gāravo upalabbhati;","thag6.3:4.3":"Na vihāyati saddhammā, maccho bavhodake [bahvodake (sī.), bahodake (syā.)] yathā.","thag6.3:5.1":"“Yassa sabrahmacārīsu, gāravo upalabbhati;","thag6.3:5.3":"So virūhati saddhamme, khette bījaṃva bhaddakaṃ.","thag6.3:6.1":"“Yassa sabrahmacārīsu, gāravo upalabbhati;","thag6.3:6.3":"Santike hoti nibbānaṃ [nibbāṇaṃ (sī.)], dhammarājassa sāsane”ti.","thag6.3:6.5":"… Mahānāgo thero …."},"attha":null,"tika":null}
