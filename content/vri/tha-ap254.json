{"suttaId":"tha-ap254","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8266,8278],"vripara":"5"},"segments":{"tha-ap254:0.3":"Ekāsanadāyakattheraapadānaṃ","tha-ap254:1.1":"“Vijahitvā devavaṇṇaṃ,","tha-ap254:1.2":"sabhariyo idhāgamiṃ;","tha-ap254:1.3":"Adhikāraṃ kattukāmo,","tha-ap254:1.4":"buddhaseṭṭhassa sāsane.","tha-ap254:2.1":"“Devalo nāma nāmena,","tha-ap254:2.2":"padumuttarasāvako;","tha-ap254:2.3":"Tassa bhikkhā mayā dinnā,","tha-ap254:2.4":"vippasannena cetasā.","tha-ap254:3.1":"“Satasahassito kappe,","tha-ap254:3.2":"yaṃ kammamakariṃ tadā;","tha-ap254:3.3":"Duggatiṃ nābhijānāmi,","tha-ap254:3.4":"piṇḍapātassidaṃ phalaṃ.","tha-ap254:4.1":"“Paṭisambhidā catasso … pe …","tha-ap254:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap254:5.1":"Itthaṃ sudaṃ āyasmā ekāsanadāyako thero imā gāthāyo abhāsitthāti.","tha-ap254:6.1":"Ekāsanadāyakattherassāpadānaṃ dutiyaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3211,"to":3211,"paras":[{"para":3211,"vripara":"5-6","refs":["tha-ap254:1"],"lines":["5-6. Dutiyāpadāne <b>vijahitvā devavaṇṇan</b>ti devatā sarīraṃ vijahitvā chaḍḍetvā, manussasarīraṃ nimminitvāti attho.","<b>Adhikāraṃ kattukāmo</b>ti adhikakiriyaṃ puññasambhāraṃ kattukāmo devaro nāma ahaṃ devarājā bhariyāya saha buddhaseṭṭhassa sāsane sādaratāya <b>idha</b> imasmiṃ manussaloke <b>āgamiṃ</b> āgatoti attho.","<b>Tassa bhikkhā mayā dinnā</b>ti padumuttarassa bhagavato yo nāmena <b>devalo</b> nāma sāvako ahosi, tassa sāvakassa mayā vippasannena cetasā <b>bhikkhā dinnā</b> piṇḍapāto dinnoti attho."],"lineRefs":[["tha-ap254:1"],["tha-ap254:1"],["tha-ap254:1"]]}],"wordLinks":[["tha-ap254:1.1","vijahitvā devavaṇṇaṃ",0,0],["tha-ap254:1.1","idha",0,1],["tha-ap254:1.1","āgamiṃ",0,1],["tha-ap254:1.3","adhikāraṃ kattukāmo",0,1]]},"tika":null,"tika2":null}
