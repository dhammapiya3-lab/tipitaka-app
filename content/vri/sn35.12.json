{"suttaId":"sn35.12","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[30,34],"vripara":"12"},"segments":{"sn35.12:0.3":"Bāhirānattātītānāgatasuttaṃ","sn35.12:1.1":"“Rūpā, bhikkhave, anattā atītānāgatā;","sn35.12:1.2":"ko pana vādo paccuppannānaṃ!","sn35.12:1.3":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītesu rūpesu anapekkho hoti;","sn35.12:1.4":"anāgate rūpe nābhinandati;","sn35.12:1.5":"paccuppannānaṃ rūpānaṃ nibbidāya virāgāya nirodhāya paṭipanno hoti.","sn35.12:1.6":"Saddā…","sn35.12:1.7":"gandhā…","sn35.12:1.8":"rasā…","sn35.12:1.9":"phoṭṭhabbā…","sn35.12:1.10":"dhammā anattā atītānāgatā;","sn35.12:1.11":"ko pana vādo paccuppannānaṃ!","sn35.12:1.12":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītesu dhammesu anapekkho hoti;","sn35.12:1.13":"anāgate dhamme nābhinandati;","sn35.12:1.14":"paccuppannānaṃ dhammānaṃ nibbidāya virāgāya nirodhāya paṭipanno hotī”ti.","sn35.12:1.15":"Dvādasamaṃ.","sn35.12:1.16":"Aniccavaggo paṭhamo.","sn35.12:2.0":"Tassuddānaṃ –","sn35.12:2.1":"Aniccaṃ dukkhaṃ anattā ca,","sn35.12:2.2":"tayo ajjhattabāhirā;","sn35.12:2.3":"Yadaniccena tayo vuttā,","sn35.12:2.4":"te te ajjhattabāhirāti. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":15,"to":18,"paras":[{"para":15,"vripara":"7-12","refs":["sn35.12:1"],"lines":["Sattamādīni atītānāgatesu cakkhādīsu aniccalakkhaṇādīni sallakkhetvā paccuppannesu balavagāhena kilamantānaṃ vasena vuttāni.","Sesaṃ sabbattha heṭṭhā vuttanayamevāti."],"lineRefs":[["sn35.12:1"],["sn35.12:1"]]},{"para":16,"vripara":null,"refs":["sn35.12:1"],"lines":["Aniccavaggo paṭhamo. 2."],"lineRefs":[["sn35.12:1"]]},{"para":17,"vripara":null,"refs":["sn35.12:1"],"lines":["Yamakavaggo 1-4."],"lineRefs":[["sn35.12:1"]]},{"para":18,"vripara":null,"refs":["sn35.12:1"],"lines":["Paṭhamapubbesambodhasuttādivaṇṇanā 13-16."],"lineRefs":[["sn35.12:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"S