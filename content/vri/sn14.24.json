{"suttaId":"sn14.24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[802,803],"vripara":"108"},"segments":{"sn14.24:0.3":"Dussīlasuttaṃ","sn14.24:1.1":"Sāvatthiyaṃ viharati … pe …“dhātusova, bhikkhave, sattā saṃsandanti samenti.","sn14.24:1.3":"Assaddhā assaddhehi saddhiṃ saṃsandanti samenti;","sn14.24:1.4":"ahirikā ahirikehi saddhiṃ saṃsandanti samenti;","sn14.24:1.5":"anottappino anottappīhi saddhiṃ saṃsandanti samenti;","sn14.24:1.6":"dussīlā dussīlehi saddhiṃ saṃsandanti samenti;","sn14.24:1.7":"duppaññā duppaññehi saddhiṃ saṃsandanti samenti”.","sn14.24:2.1":"“Saddhā saddhehi saddhiṃ saṃsandanti samenti;","sn14.24:2.2":"hirimanā hirimanehi saddhiṃ saṃsandanti samenti;","sn14.24:2.3":"ottappino ottappīhi saddhiṃ saṃsandanti samenti;","sn14.24:2.4":"sīlavanto sīlavantehi saddhiṃ saṃsandanti samenti;","sn14.24:2.5":"paññavanto paññavantehi saddhiṃ saṃsandanti samentī”ti.","sn14.24:2.6":"Dutiyaṃ."},"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":560,"to":561,"paras":[{"para":560,"vripara":"107-108","refs":["sn14.24:1"],"lines":["107-108. Ito paresu paṭhamaṃ assaddhādipañcakavasena vuttaṃ, tathā dutiyaṃ.","Paṭhame pana asamāhitapadaṃ catutthaṃ, dutiye dussīlapadaṃ.","Evaṃ vuccamāne bujjhanakapuggalānaṃ ajjhāsayena hi etāni vuttāni.","Ettha <b>asamāhitā</b>ti upacārappanāsamādhirahitā.","<b>Dussīlā</b>ti nissīlā.","Paṭhamadutiyāni."],"lineRefs":[["sn14.24:1"],["sn14.24:1"],["sn14.24:1"],["sn14.24:1"],["sn14.24:1"],["sn14.24:1"]]},{"para":561,"vripara":null,"refs":["sn14.24:1"],"lines":["3-5. Pañcasikkhāpadasuttādivaṇṇanā"],"lineRefs":[["sn14.24:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":565,"to":567,"paras":[{"para":565,"vripara":"107-108","refs":["sn14.24:1"],"lines":["107-108. <b>Ito paresū</b>ti ito dutiyavaggato paresu suttesu.","<b>Paṭhaman</b>ti paṭhamavagge paṭhamaṃ.","Kasmā panettha evaṃ desanā pavattāti āha <b>“evaṃ vuccamāne”</b>tiādi."],"lineRefs":[["sn14.24:1"],["sn14.24:1"],["sn14.24:1"]]},{"para":566,"vripara":null,"refs":[],"lines":["Asamāhitasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":567,"vripara":null,"refs":["sn14.24:1"],"lines":["3-5. Pañcasikkhāpadasuttādivaṇṇanā"],"lineRefs":[["sn14.24:1"]]}],"wordLinks":[]},"tika2":null}
