{"suttaId":"tha-ap417","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[14405,14420],"vripara":"118"},"segments":{"tha-ap417:0.3":"Nāgapallavattheraapadānaṃ","tha-ap417:1.1":"“Nagare bandhumatiyā,","tha-ap417:1.2":"rājuyyāne vasāmahaṃ;","tha-ap417:1.3":"Mama assamasāmantā,","tha-ap417:1.4":"nisīdi lokanāyako.","tha-ap417:2.1":"“Nāgapallavamādāya,","tha-ap417:2.2":"buddhassa abhiropayiṃ;","tha-ap417:2.3":"Pasannacitto sumano,","tha-ap417:2.4":"sugataṃ abhivādayiṃ.","tha-ap417:3.1":"“Ekanavutito kappe,","tha-ap417:3.2":"yaṃ pallavamapūjayiṃ;","tha-ap417:3.3":"Duggatiṃ nābhijānāmi,","tha-ap417:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap417:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap417:4.3":"viharāmi anāsavo.","tha-ap417:5.1":"“Svāgataṃ vata me āsi … pe …","tha-ap417:5.3":"kataṃ buddhassa sāsanaṃ.","tha-ap417:6.1":"“Paṭisambhidā catasso … pe …","tha-ap417:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap417:7.1":"Itthaṃ sudaṃ āyasmā nāgapallavo thero imā gāthāyo abhāsitthāti.","tha-ap417:8.1":"Nāgapallavattherassāpadānaṃ pañcamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
