{"suttaId":"thag5.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1624,1639],"vripara":"350"},"segments":{"thag5.8:0.4":"Vakkalittheragāthā","thag5.8:1.1":"“Vātarogābhinīto tvaṃ, viharaṃ kānane vane;","thag5.8:1.3":"Paviṭṭhagocare lūkhe, kathaṃ bhikkhu karissasi.","thag5.8:2.1":"“Pītisukhena vipulena, pharamāno samussayaṃ;","thag5.8:2.3":"Lūkhampi abhisambhonto, viharissāmi kānane.","thag5.8:3.1":"“Bhāvento satipaṭṭhāne, indriyāni balāni ca;","thag5.8:3.3":"Bojjhaṅgāni ca bhāvento, viharissāmi kānane.","thag5.8:4.1":"“Āraddhavīriye pahitatte, niccaṃ daḷhaparakkame [āraddhavīriyo pahitatto, niccaṃ daḷhaparakkamo (sī.)];","thag5.8:4.3":"Samagge sahite disvā, viharissāmi kānane.","thag5.8:5.1":"“Anussaranto sambuddhaṃ, aggaṃ dantaṃ samāhitaṃ;","thag5.8:5.3":"Atandito rattindivaṃ, viharissāmi kānane”ti.","thag5.8:5.5":"… Vakkalitthero …."},"attha":null,"tika":null}
