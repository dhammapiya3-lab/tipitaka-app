{"suttaId":"tha-ap197","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7298,7313],"vripara":"23"},"segments":{"tha-ap197:0.3":"Aṅkolakattheraapadānaṃ","tha-ap197:1.1":"“Aṅkolaṃ pupphitaṃ disvā, mālāvaraṃ sakosakaṃ [samogadhaṃ (syā.)];","tha-ap197:1.3":"Ocinitvāna taṃ pupphaṃ, agamaṃ buddhasantikaṃ.","tha-ap197:2.1":"“Siddhattho tamhi samaye, patilīno mahāmuni;","tha-ap197:2.3":"Muhuttaṃ paṭimānetvā, guhāyaṃ pupphamokiriṃ.","tha-ap197:3.1":"“Catunnavutito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap197:3.3":"Duggatiṃ nābhijānāmi, pupphadānassidaṃ [buddhapūjāyidaṃ (sī. syā.)] phalaṃ.","tha-ap197:4.1":"“Chattiṃsamhi ito kappe, āseko devagajjito;","tha-ap197:4.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap197:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap197:6.1":"Itthaṃ sudaṃ āyasmā aṅkolako thero imā gāthāyo abhāsitthāti.","tha-ap197:7.1":"Aṅkolakattherassāpadānaṃ pañcamaṃ."},"attha":null,"tika":null,"tika2":null}
