{"suttaId":"tha-ap197","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7298,7313],"vripara":"23"},"segments":{"tha-ap197:0.3":"Aṅkolakattheraapadānaṃ","tha-ap197:1.1":"“Aṅkolaṃ pupphitaṃ disvā,","tha-ap197:1.2":"mālāvaraṃ sakosakaṃ [samogadhaṃ (syā.)];","tha-ap197:1.3":"Ocinitvāna taṃ pupphaṃ,","tha-ap197:1.4":"agamaṃ buddhasantikaṃ.","tha-ap197:2.1":"“Siddhattho tamhi samaye,","tha-ap197:2.2":"patilīno mahāmuni;","tha-ap197:2.3":"Muhuttaṃ paṭimānetvā,","tha-ap197:2.4":"guhāyaṃ pupphamokiriṃ.","tha-ap197:3.1":"“Catunnavutito kappe,","tha-ap197:3.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap197:3.3":"Duggatiṃ nābhijānāmi,","tha-ap197:3.4":"pupphadānassidaṃ [buddhapūjāyidaṃ (sī. syā.)] phalaṃ.","tha-ap197:4.1":"“Chattiṃsamhi ito kappe,","tha-ap197:4.2":"āseko devagajjito;","tha-ap197:4.3":"Sattaratanasampanno,","tha-ap197:4.4":"cakkavattī mahabbalo.","tha-ap197:5.1":"“Paṭisambhidā catasso … pe …","tha-ap197:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap197:6.1":"Itthaṃ sudaṃ āyasmā aṅkolako thero imā gāthāyo abhāsitthāti.","tha-ap197:7.1":"Aṅkolakattherassāpadānaṃ pañcamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
