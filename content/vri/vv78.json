{"suttaId":"vv78","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2775,2811],"vripara":"1134"},"segments":{"vv78:0.4":"Suvaṇṇavimānavatthu","vv78:1.1":"“Sovaṇṇamaye pabbatasmiṃ, vimānaṃ sabbatopabhaṃ;","vv78:1.3":"Hemajālapaṭicchannaṃ [hemajālakapacchannaṃ (sī.)], kiṅkiṇi [kiṅkaṇika (syā. ka.), kiṅkiṇika (pī.)] jālakappitaṃ.","vv78:2.1":"“Aṭṭhaṃsā sukatā thambhā, sabbe veḷuriyāmayā;","vv78:2.3":"Ekamekāya aṃsiyā, ratanā satta nimmitā.","vv78:3.1":"“Veḷuriyasuvaṇṇassa, phalikā rūpiyassa ca;","vv78:3.3":"Masāragallamuttāhi, lohitaṅgamaṇīhi ca.","vv78:4.1":"“Citrā manoramā bhūmi, na tatthuddhaṃsatī rajo;","vv78:4.3":"Gopāṇasīgaṇā pītā, kūṭaṃ dhārenti nimmitā.","vv78:5.1":"“Sopāṇāni ca cattāri, nimmitā caturo disā;","vv78:5.3":"Nānāratanagabbhehi, ādiccova virocati.","vv78:6.1":"“Vediyā catasso tattha, vibhattā bhāgaso mitā;","vv78:6.3":"Daddallamānā ābhanti, samantā caturo disā.","vv78:7.1":"“Tasmiṃ vimāne pavare, devaputto mahappabho;","vv78:7.3":"Atirocasi vaṇṇena, udayantova bhāṇumā.","vv78:8.1":"“Dānassa te idaṃ phalaṃ, atho sīlassa vā pana;","vv78:8.3":"Atho añjalikammassa, taṃ me akkhāhi pucchito”.","vv78:9.1":"So devaputto attamano … pe … yassa kammassidaṃ phalaṃ.","vv78:10.1":"“Ahaṃ andhakavindasmiṃ, buddhassādiccabandhuno;","vv78:10.3":"Vihāraṃ satthu kāresiṃ, pasanno sehi pāṇibhi.","vv78:11.1":"“Tattha gandhañca mālañca, paccayañca [paccaggañca (sī.), paccagghañca (?)] vilepanaṃ;","vv78:11.3":"Vihāraṃ satthu adāsiṃ, vippasannena cetasā;","vv78:11.5":"Tena mayhaṃ idaṃ laddhaṃ, vasaṃ vattemi nandane.","vv78:12.1":"“Nandane ca vane [nandane pavane (sī. syā.)] ramme, nānādijagaṇāyute;","vv78:12.3":"Ramāmi naccagītehi, accharāhi purakkhato”ti.","vv78:13.1":"Suvaṇṇavimānaṃ catutthaṃ."},"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3355,"to":3363,"paras":[{"para":3355,"vripara":"1134","refs":["vv78:1"],"words":["sabbatopabhaṃ","kiṅkiṇijālakappitaṃ"],"lines":["Tattha <b>sabbatopabhan</b>ti sabbabhāgehi pabhāsantaṃ pabhāmuñcanakaṃ.","<b>Kiṅkiṇijālakappitan</b>ti kappitakiṅkiṇikajālaṃ."],"lineRefs":[["vv78:1"],["vv78:1"]]},{"para":3356,"vripara":"1135","refs":["vv78:2"],"words":["sabbe veḷuriyāmayā","ekamekāya aṃsiyā","ratanā satta nimmitā"],"lines":["<b>Sabbe veḷuriyāmayā</b>ti sabbe thambhā veḷuriyamaṇimayā.","Tattha pana <b>ekamekāya aṃsiyā</b>ti aṭṭhaṃsesu thambhesu ekamekasmiṃ aṃsabhāge.","<b>Ratanā satta nimmitā</b>ti sattaratanakammanimmitā, ekeko aṃso sattaratanamayoti attho."],"lineRefs":[["vv78:2"],["vv78:2"],["vv78:2"]]},{"para":3357,"vripara":"1136","refs":["vv78:3"],"words":["phalikā rūpiyassa cā","masāragallamuttāhī","lohitaṅgamaṇīhi cā"],"lines":["<b>“Veḷūriyasuvaṇṇassā”</b>tiādinā nānāratanāni dasseti.","Tattha <b>veḷūriyasuvaṇṇassā</b>ti veḷuriyena ca suvaṇṇena ca nimmitā, citrāti vā yojanā.","Karaṇatthe hi idaṃ sāmivacanaṃ.","<b>Phalikā rūpiyassa cā</b>ti etthāpi eseva nayo.","<b>Masāragallamuttāhī</b>ti kabaramaṇīhi.","<b>Lohitaṅgamaṇīhi cā</b>ti rattamaṇīhi."],"lineRefs":[["vv78:3"],["vv78:3"],["vv78:3"],["vv78:3"],["vv78:3"],["vv78:3"]]},{"para":3358,"vripara":"1137","refs":["vv78:4"],"words":["na tatthuddhaṃsatī rajo","pītā","kūṭaṃ dhārentī"],"lines":["<b>Na tatthuddhaṃsatī rajo</b>ti maṇimayabhūmikattā na tasmiṃ vimāne rajo uggacchati.","<b>Gopānasīgaṇā</b>ti gopānasīsamūhā.","<b>Pītā</b>ti pītavaṇṇā, suvaṇṇamayā ceva phussarāgādimaṇimayā cāti attho.","<b>Kūṭaṃ dhārentī</b>ti sattaratanamayaṃ kaṇṇikaṃ dhārenti."],"lineRefs":[["vv78:4"],["vv78:4"],["vv78:4"],["vv78:4"]]},{"para":3359,"vripara":"1138-1139","refs":["vv78:5"],"words":["nānāratanagabbhehī"],"lines":["1138-9. <b>Nānāratanagabbhehī</b>ti nānāratanamayehi ovarakehi.","<b>Vediyā</b>ti vedikā.","<b>Catasso</b>ti catūsu disāsu catasso.","Tenāha <b>“samantā caturo disā”</b>ti."],"lineRefs":[["vv78:5"],["vv78:5"],["vv78:5"],["vv78:5"]]},{"para":3360,"vripara":"1140","refs":["vv78:7"],"words":["mahappabho","udayanto","bhāṇumā"],"lines":["<b>Mahappabho</b>ti mahājutiko.","<b>Udayanto</b>ti uggacchanto.","<b>Bhāṇumā</b>ti ādicco."],"lineRefs":[["vv78:7"],["vv78:7"],["vv78:7"]]},{"para":3361,"vripara":"1143","refs":["vv78:10"],"words":["sehi pāṇibhī"],"lines":["<b>Sehi pāṇibhī</b>ti kāyasāraṃ puññaṃ pasavanto attano pāṇīhi taṃ taṃ kiccaṃ karonto vihāraṃ satthu kāresinti yojanā.","Atha vā <b>sehi pāṇibhī</b>ti tattha andhakavindasmiṃ gandhañca mālañca paccayañca vilepanañca pūjāvasena.","Yathā kathaṃ?","Vihārañca vippasannena cetasā satthuno adāsiṃ pūjesiṃ niyyādesiṃ cāti evamettha yojanā veditabbā."],"lineRefs":[["vv78:10"],["vv78:10"],["vv78:10"],["vv78:10"]]},{"para":3362,"vripara":"1144","refs":["vv78:11"],"words":["tenā","mayhaṃ","idaṃ","vasaṃ vattemī"],"lines":["<b>Tenā</b>ti tena yathāvuttena puññakammena kāraṇabhūtena.","<b>Mayhan</b>ti mayā.","<b>Idan</b>ti idaṃ puññaphalaṃ, idaṃ vā dibbaṃ ādhipateyyaṃ.","Tenāha <b>“vasaṃ vattemī”</b>ti."],"lineRefs":[["vv78:11"],["vv78:11"],["vv78:11"],["vv78:11"]]},{"para":3363,"vripara":"1145","refs":["vv78:12"],"words":["nandane"],"lines":["<b>Nandane</b>ti nandiyā dibbasamiddhiyā uppajjanaṭṭhāne imasmiṃ devaloke, tatthāpi visesato nandane vane ramme, evaṃ ramaṇīye imasmiṃ nandane vane ramāmīti yojanā.","Sesaṃ vuttanayameva."],"lineRefs":[["vv78:12"],["vv78:12"]]}]},"tika":null}
