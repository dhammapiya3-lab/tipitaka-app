{"suttaId":"sn35.170","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1010,1010],"vripara":"170"},"segments":{"sn35.170:0.3":"Ajjhattaaniccachandarāgasuttaṃ","sn35.170:1.1":"“Yaṃ, bhikkhave, aniccaṃ, tatra vo chandarāgo pahātabbo.","sn35.170:1.2":"Kiñca, bhikkhave, aniccaṃ?","sn35.170:1.3":"Cakkhu, bhikkhave, aniccaṃ;","sn35.170:1.4":"tatra vo chandarāgo pahātabbo … pe …","sn35.170:1.5":"jivhā aniccā;","sn35.170:1.6":"tatra vo chandarāgo pahātabbo … pe …","sn35.170:1.7":"mano anicco;","sn35.170:1.8":"tatra vo chandarāgo pahātabbo.","sn35.170:1.9":"Yaṃ, bhikkhave, aniccaṃ, tatra vo chandarāgo pahātabbo”ti."},"unsure":[],"attha":null,"tika":null,"tika2":null}
