{"suttaId":"an6.65","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[683,684],"vripara":"65"},"segments":{"an6.65:0.3":"Anāgāmiphalasuttaṃ","an6.65:1.1":"“Cha, bhikkhave, dhamme appahāya abhabbo anāgāmiphalaṃ sacchikātuṃ.","an6.65:1.2":"Katame cha?","an6.65:1.3":"Assaddhiyaṃ, ahirikaṃ, anottappaṃ, kosajjaṃ, muṭṭhassaccaṃ, duppaññataṃ –","an6.65:1.4":"ime kho, bhikkhave, cha dhamme appahāya abhabbo anāgāmiphalaṃ sacchikātuṃ.","an6.65:2.1":"“Cha, bhikkhave, dhamme pahāya bhabbo anāgāmiphalaṃ sacchikātuṃ.","an6.65:2.2":"Katame cha?","an6.65:2.3":"Assaddhiyaṃ, ahirikaṃ, anottappaṃ, kosajjaṃ, muṭṭhassaccaṃ, duppaññataṃ –","an6.65:2.4":"ime kho, bhikkhave, cha dhamme pahāya bhabbo anāgāmiphalaṃ sacchikātu”nti.","an6.65:2.5":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":723,"to":723,"paras":[{"para":723,"vripara":"65-67","refs":["an6.65:1"],"lines":["Sattamassa paṭhame <b>assaddhiya</b>nti assaddhabhāvaṃ.","<b>Duppaññata</b>nti nippaññabhāvaṃ.","Dutiye <b>pamāda</b>nti sativippavāsaṃ.","Tatiye <b>ābhisamācārika</b>nti uttamasamācārabhūtaṃ vattavasena paṇṇattisīlaṃ.","<b>Sekhadhamma</b>nti sekhapaṇṇattisīlaṃ.","<b>Sīlānī</b>ti cattāri mahāsīlāni. 4."],"lineRefs":[["an6.65:1"],["an6.65:1"],["an6.65:1"],["an6.65:1"],["an6.65:1"],["an6.65:1"]]}],"wordLinks":[["an6.65:1.3","assaddhiyaṃ",0,0],["an6.65:1.3","duppaññataṃ",0,1]],"before":[{"para":721,"vripara":null,"title":"Devatāvaggo","lines":["Devatāvaggo 1-3."]},{"para":722,"vripara":null,"title":"Anāgāmiphalasuttādivaṇṇanā","lines":["Anāgāmiphalasuttādivaṇṇanā 65-67."]}]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":744,"to":746,"paras":[{"para":744,"vripara":"65-67","refs":["an6.65:1"],"lines":["Sattamassa paṭhamādīni uttānatthāni.","Tatiye abhisamācāre uttamasamācāre bhavaṃ <b>ābhisamācārikaṃ,</b> vattappaṭipattivattaṃ.","Tenāha <b>“uttamasamācārabhūta