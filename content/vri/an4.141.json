{"suttaId":"an4.141","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1194,1194],"vripara":"141"},"segments":{"an4.141:0.3":"Ābhāsuttaṃ","an4.141:1.1":"“Catasso imā, bhikkhave, ābhā.","an4.141:1.2":"Katamā catasso?","an4.141:1.3":"Candābhā, sūriyābhā, aggābhā, paññābhā – imā kho, bhikkhave, catasso ābhā.","an4.141:1.5":"Etadaggaṃ, bhikkhave, imāsaṃ catunnaṃ [catassannaṃ (syā. kaṃ.) saddanītipadamālā passitabbā] ābhānaṃ yadidaṃ paññābhā”ti.","an4.141:1.6":"Paṭhamaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1448,"to":1448,"paras":[{"para":1448,"vripara":"141","refs":["an4.141:1"],"lines":["Pañcamassa paṭhame ābhāsanavasena candova <b>candābhā</b>.","Sesapadesupi eseva nayo."],"lineRefs":[["an4.141:1"],["an4.141:1"]]}],"wordLinks":[["an4.141:1.3","candābhā",0,0]]},"tika":null}
