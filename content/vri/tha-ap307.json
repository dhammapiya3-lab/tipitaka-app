{"suttaId":"tha-ap307","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9116,9128],"vripara":"20"},"segments":{"tha-ap307:0.3":"Phaladāyakattheraapadānaṃ","tha-ap307:1.1":"“Bhāgīrathīnadītīre, ahosi assamo tadā;","tha-ap307:1.3":"Tamahaṃ assamaṃ gacchiṃ, phalahattho apekkhavā.","tha-ap307:2.1":"“Vipassiṃ tattha addakkhiṃ, pītaraṃsiṃva bhāṇumaṃ;","tha-ap307:2.3":"Yaṃ me atthi phalaṃ sabbaṃ, adāsiṃ satthuno ahaṃ.","tha-ap307:3.1":"“Ekanavutito kappe, yaṃ phalaṃ adadiṃ tadā;","tha-ap307:3.3":"Duggatiṃ nābhijānāmi, phaladānassidaṃ phalaṃ.","tha-ap307:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap307:5.1":"Itthaṃ sudaṃ āyasmā phaladāyako thero imā gāthāyo abhāsitthāti.","tha-ap307:6.1":"Phaladāyakattherassāpadānaṃ pañcamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3262,"to":3262,"paras":[{"para":3262,"vripara":"20","refs":["tha-ap307:1"],"lines":["Pañcamāpadāne <b>phalahattho apekkhavā</b>ti vipassiṃ bhagavantaṃ disvā madhurāni phalāni gahetvā apekkhavā aturito saṇikaṃ assamaṃ gañchinti attho."],"lineRefs":[["tha-ap307:1"]]}],"wordLinks":[["tha-ap307:1.3","phalahattho apekkhavā",0,0]]},"tika":null}
