{"suttaId":"thig3.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[187,197],"vripara":"39"},"segments":{"thig3.1:0.3":"Aparāsāmātherīgāthā","thig3.1:1.1":"“Paṇṇavīsativassāni,","thig3.1:1.2":"yato pabbajitāya me;","thig3.1:1.3":"Nābhijānāmi cittassa,","thig3.1:1.4":"samaṃ laddhaṃ kudācanaṃ.","thig3.1:2.1":"“Aladdhā cetaso santiṃ,","thig3.1:2.2":"citte avasavattinī;","thig3.1:2.3":"Tato saṃvegamāpādiṃ,","thig3.1:2.4":"saritvā jinasāsanaṃ.","thig3.1:3.1":"“Bahūhi dukkhadhammehi,","thig3.1:3.2":"appamādaratāya me;","thig3.1:3.3":"Taṇhakkhayo anuppatto,","thig3.1:3.4":"kataṃ buddhassa sāsanaṃ;","thig3.1:3.5":"Ajja me sattamī ratti,","thig3.1:3.6":"yato taṇhā visositā”ti.","thig3.1:4.1":"… Aparā sāmā therī …."},"unsure":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":599,"to":652,"paras":[{"para":599,"vripara":"39","refs":["thig3.1:1"],"lines":["“Paṇṇavīsati vassāni, yato pabbajitāya me;"],"lineRefs":[["thig3.1:1"]]},{"para":600,"vripara":null,"refs":["thig3.1:1"],"lines":["Nābhijānāmi cittassa, samaṃ laddhaṃ kudācanaṃ."],"lineRefs":[["thig3.1:1"]]},{"para":602,"vripara":"40","refs":["thig3.1:2"],"lines":["“Aladdhā cetaso santiṃ, citte avasavattinī;"],"lineRefs":[["thig3.1:2"]]},{"para":603,"vripara":null,"refs":["thig3.1:2"],"lines":["Tato saṃvegamāpādiṃ, saritvā jinasāsanaṃ."],"lineRefs":[["thig3.1:2"]]},{"para":605,"vripara":"41","refs":["thig3.1:3"],"lines":["“Bahūhi dukkhadhammehi, appamādaratāya me;"],"lineRefs":[["thig3.1:3"]]},{"para":606,"vripara":null,"refs":["thig3.1:3"],"lines":["Taṇhakkhayo anuppatto, kataṃ buddhassa sāsanaṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":607,"vripara":null,"refs":["thig3.1:3"],"lines":["Ajja me sattamī ratti, yato taṇhā visositā”ti.","–"],"lineRefs":[["thig3.1:3"],["thig3.1:3"]]},{"para":608,"vripara":null,"refs":["thig3.1:3"],"lines":["Imā gāthā abhāsi."],"lineRefs":[["thig3.1:3"]]},{"para":609,"vripara":null,"refs":["thig3.1:3"],"lines":["Tattha <b>cittassa saman</b>ti cittassa vūpasamaṃ, cetosamathamaggaphalasamādhīti attho."],"lineRefs":[["thig3.1:3"]]},{"para":610,"vripara":null,"refs":["thig3.1:3"],"lines":["<b>Tato</b>ti tasmā cittavasaṃ vattetuṃ asamatthabhāvato.","<b>Saṃvegamāpādin</b>ti satthari dharantepi pabbajitakiccaṃ matthakaṃ pāpetuṃ asakkontī pacchā kathaṃ pāpayissāmīti saṃvegaṃ ñāṇutrāsaṃ āpajjiṃ.","<b>Saritvā jinasāsanan</b>ti kāṇakacchapopamādisatthuovādaṃ (saṃ. ni.5.1117; ma. ni.3.252) anussaritvā.","Sesaṃ vuttanayameva."],"lineRefs":[["thig3.1:3"],["thig3.1:3"],["thig3.1:3"],["thig3.1:3"]]},{"para":611,"vripara":null,"refs":["thig3.1:3"],"lines":["Aparāsāmātherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[["thig3.1:3"]]},{"para":612,"vripara":null,"refs":["thig3.1:3"],"lines":["Uttamātherīgāthāvaṇṇanā"],"lineRefs":[["thig3.1:3"]]},{"para":613,"vripara":null,"refs":["thig3.1:3"],"lines":["<b>Catukkhattuṃ pañcakkhattun</b>tiādikā uttamāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī vipassissa bhagavato kāle bandhumatīnagare aññatarassa kuṭumbikassa gehe gharadāsī hutvā nibbatti.","Sā vayappattā attano ayyakānaṃ veyyāvaccaṃ karontī jīvati.","Tena ca samayena bandhumarājā puṇṇamīdivase uposathiko hutvā purebhattaṃ dānāni datvā pacchābhattaṃ gantvā dhammaṃ suṇāti.","Atha mahājanā yathā rājā paṭipajjati, tatheva puṇṇamīdivase uposathaṅgāni samādāya vattanti.","Athassā dāsiyā etadahosi –","“etarahi kho mahārājā mahājanā ca uposathaṅgāni samādāya vattanti, yaṃnūnāhaṃ uposathadivasesu uposathasīlaṃ samādāya vatteyyan”ti.","Sā tathā karontī suparisuddhaṃ uposathasīlaṃ rakkhitvā tāvatiṃsesu nibbattā aparāparaṃ sugatīsuyeva saṃsarantī imasmiṃ buddhuppāde sāvatthiyaṃ seṭṭhikule nibbattitvā viññutaṃ patvā paṭācārāya theriyā santike dhammaṃ sutvā pabbajitvā vipassanaṃ paṭṭhapetvā taṃ matthakaṃ pāpetuṃ nāsakkhi.","Paṭācārā therī tassā cittācāraṃ ñatvā ovādamadāsi.","Sā tassā ovāde ṭhatvā saha paṭisambhidāhi arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.2.1-21)–"],"lineRefs":[["thig3.1:3"],["thig3.1:3"],["thig3.1:3"],["thig3.1:3"],["thig3.1:3"],["thig3.1:3"],["thig3.1:3"],["thig3.1:3"],["thig3.1:3"],["thig3.1:3"],["thig3.1:3"]]},{"para":614,"vripara":null,"refs":["thig3.1:3"],"lines":["“Nagare bandhumatiyā, bandhumā nāma khattiyo;"],"lineRefs":[["thig3.1:3"]]},{"para":615,"vripara":null,"refs":["thig3.1:3"],"lines":["Divase puṇṇamāya so, upavasi uposathaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":616,"vripara":null,"refs":["thig3.1:3"],"lines":["“Ahaṃ tena samayena, kumbhadāsī ahaṃ tahiṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":617,"vripara":null,"refs":["thig3.1:3"],"lines":["Disvā sarājakaṃ senaṃ, evāhaṃ cintayiṃ tadā."],"lineRefs":[["thig3.1:3"]]},{"para":618,"vripara":null,"refs":["thig3.1:3"],"lines":["“Rājāpi rajjaṃ chaḍḍetvā, upavasi uposathaṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":619,"vripara":null,"refs":["thig3.1:3"],"lines":["Saphalaṃ nūna taṃ kammaṃ, janakāyo pamodito."],"lineRefs":[["thig3.1:3"]]},{"para":620,"vripara":null,"refs":["thig3.1:3"],"lines":["“Yoniso paccavekkhitvā, duggaccañca daliddataṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":621,"vripara":null,"refs":["thig3.1:3"],"lines":["Mānasaṃ sampahaṃsitvā, upavasiṃ uposathaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":622,"vripara":null,"refs":["thig3.1:3"],"lines":["“Ahaṃ uposathaṃ katvā, sammāsambuddhasāsane;"],"lineRefs":[["thig3.1:3"]]},{"para":623,"vripara":null,"refs":["thig3.1:3"],"lines":["Tena kammena sukatena, tāvatiṃsamagacchahaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":624,"vripara":null,"refs":["thig3.1:3"],"lines":["“Tattha me sukataṃ byamhaṃ, ubbhayojanamuggataṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":625,"vripara":null,"refs":["thig3.1:3"],"lines":["Kūṭāgāravarūpetaṃ, mahāsanasubhūsitaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":626,"vripara":null,"refs":["thig3.1:3"],"lines":["“Accharā satasahassā, upatiṭṭhanti maṃ sadā;"],"lineRefs":[["thig3.1:3"]]},{"para":627,"vripara":null,"refs":["thig3.1:3"],"lines":["Aññe deve atikkamma, atirocāmi sabbadā."],"lineRefs":[["thig3.1:3"]]},{"para":628,"vripara":null,"refs":["thig3.1:3"],"lines":["“Catusaṭṭhidevarājūnaṃ, mahesittamakārayiṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":629,"vripara":null,"refs":["thig3.1:3"],"lines":["Tesaṭṭhicakkavattīnaṃ, mahesittamakārayiṃ."],"lineRefs":[["thig3.1:3"]]},{"para":630,"vripara":null,"refs":["thig3.1:3"],"lines":["“Suvaṇṇavaṇṇā hutvāna, bhavesu saṃsarāmahaṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":631,"vripara":null,"refs":["thig3.1:3"],"lines":["Sabbattha pavarā homi, uposathassidaṃ phalaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":632,"vripara":null,"refs":["thig3.1:3"],"lines":["“Hatthiyānaṃ assayānaṃ, rathayānañca sīvikaṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":633,"vripara":null,"refs":["thig3.1:3"],"lines":["Labhāmi sabbamevetaṃ, uposathassidaṃ phalaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":634,"vripara":null,"refs":["thig3.1:3"],"lines":["“Soṇṇamayaṃ rūpimayaṃ, athopi phalikāmayaṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":635,"vripara":null,"refs":["thig3.1:3"],"lines":["Lohitaṅgamayañceva, sabbaṃ paṭilabhāmahaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":636,"vripara":null,"refs":["thig3.1:3"],"lines":["“Koseyyakambaliyāni, khomakappāsikāni ca;"],"lineRefs":[["thig3.1:3"]]},{"para":637,"vripara":null,"refs":["thig3.1:3"],"lines":["Mahagghāni ca vatthāni, sabbaṃ paṭilabhāmahaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":638,"vripara":null,"refs":["thig3.1:3"],"lines":["“Annaṃ pānaṃ khādanīyaṃ, vatthasenāsanāni ca;"],"lineRefs":[["thig3.1:3"]]},{"para":639,"vripara":null,"refs":["thig3.1:3"],"lines":["Sabbametaṃ paṭilabhe, uposathassidaṃ phalaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":640,"vripara":null,"refs":["thig3.1:3"],"lines":["“Varagandhañca mālañca, cuṇṇakañca vilepanaṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":641,"vripara":null,"refs":["thig3.1:3"],"lines":["Sabbametaṃ paṭilabhe, uposathassidaṃ phalaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":642,"vripara":null,"refs":["thig3.1:3"],"lines":["“Kūṭāgārañca pāsādaṃ, maṇḍapaṃ hammiyaṃ guhaṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":643,"vripara":null,"refs":["thig3.1:3"],"lines":["Sabbametaṃ paṭilabhe, uposathassidaṃ phalaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":644,"vripara":null,"refs":["thig3.1:3"],"lines":["“Jātiyā sattavassāhaṃ, pabbajiṃ anagāriyaṃ;"],"lineRefs":[["thig3.1:3"]]},{"para":645,"vripara":null,"refs":["thig3.1:3"],"lines":["Aḍḍhamāse asampatte, arahattamapāpuṇiṃ."],"lineRefs":[["thig3.1:3"]]},{"para":646,"vripara":null,"refs":["thig3.1:3"],"lines":["“Kilesā jhāpitā mayhaṃ, bhavā sabbe samūhatā;"],"lineRefs":[["thig3.1:3"]]},{"para":647,"vripara":null,"refs":["thig3.1:3"],"lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."],"lineRefs":[["thig3.1:3"]]},{"para":648,"vripara":null,"refs":["thig3.1:3"],"lines":["“Ekanavutito kappe, yaṃ kammamakariṃ tadā;"],"lineRefs":[["thig3.1:3"]]},{"para":649,"vripara":null,"refs":["thig3.1:3"],"lines":["Duggatiṃ nābhijānāmi, uposathassidaṃ phalaṃ."],"lineRefs":[["thig3.1:3"]]},{"para":650,"vripara":null,"refs":["thig3.1:3"],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[["thig3.1:3"]]},{"para":651,"vripara":null,"refs":["thig3.1:3"],"lines":["Arahattaṃ pana patvā attano paṭipattiṃ paccavekkhitvā udānavasena –"],"lineRefs":[["thig3.1:3"]]}],"wordLinks":[]},"tika":null,"tika2":null}
