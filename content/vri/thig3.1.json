{"suttaId":"thig3.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[187,197],"vripara":"39"},"segments":{"thig3.1:0.3":"Aparāsāmātherīgāthā","thig3.1:1.1":"“Paṇṇavīsativassāni, yato pabbajitāya me;","thig3.1:1.3":"Nābhijānāmi cittassa, samaṃ laddhaṃ kudācanaṃ.","thig3.1:2.1":"“Aladdhā cetaso santiṃ, citte avasavattinī;","thig3.1:2.3":"Tato saṃvegamāpādiṃ, saritvā jinasāsanaṃ.","thig3.1:3.1":"“Bahūhi dukkhadhammehi, appamādaratāya me;","thig3.1:3.3":"Taṇhakkhayo anuppatto, kataṃ buddhassa sāsanaṃ;","thig3.1:3.5":"Ajja me sattamī ratti, yato taṇhā visositā”ti.","thig3.1:4.1":"… Aparā sāmā therī …."},"attha":null,"tika":null}
