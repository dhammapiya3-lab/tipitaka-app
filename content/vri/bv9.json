{"suttaId":"bv9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[1423,1508],"vripara":"1"},"segments":{"bv9:0.2":"Anomadassībuddhavaṃso","bv9:1.1":"Sobhitassa aparena,","bv9:1.2":"sambuddho dvipaduttamo;","bv9:1.3":"Anomadassī amitayaso,","bv9:1.4":"tejassī duratikkamo.","bv9:2.1":"So chetvā bandhanaṃ sabbaṃ,","bv9:2.2":"viddhaṃsetvā tayo bhave;","bv9:2.3":"Anivattigamanaṃ maggaṃ,","bv9:2.4":"desesi devamānuse.","bv9:3.1":"Sāgarova asaṅkhobho, pabbatova durāsado;","bv9:3.3":"Ākāsova ananto so,","bv9:3.4":"sālarājāva phullito.","bv9:4.1":"Dassanenapi taṃ buddhaṃ,","bv9:4.2":"tositā honti pāṇino;","bv9:4.3":"Byāharantaṃ giraṃ sutvā,","bv9:4.4":"amataṃ pāpuṇanti te.","bv9:5.1":"Dhammābhisamayo tassa,","bv9:5.2":"iddho phīto tadā ahu;","bv9:5.3":"Koṭisatāni abhisamiṃsu,","bv9:5.4":"paṭhame dhammadesane.","bv9:6.1":"Tato paraṃ abhisamaye,","bv9:6.2":"vassante dhammavuṭṭhiyo;","bv9:6.3":"Asītikoṭiyobhisamiṃsu,","bv9:6.4":"dutiye dhammadesane.","bv9:7.1":"Tatoparañhi vassante,","bv9:7.2":"tappayante ca pāṇinaṃ;","bv9:7.3":"Aṭṭhasattatikoṭīnaṃ,","bv9:7.4":"tatiyābhisamayo ahu.","bv9:8.1":"Sannipātā tayo āsuṃ,","bv9:8.2":"tassāpi ca mahesino;","bv9:8.3":"Abhiññābalappattānaṃ,","bv9:8.4":"pupphitānaṃ vimuttiyā.","bv9:9.1":"Aṭṭhasatasahassānaṃ,","bv9:9.2":"sannipāto tadā ahu;","bv9:9.3":"Pahīnamadamohānaṃ,","bv9:9.4":"santacittāna tādinaṃ.","bv9:10.1":"Sattasatasahassānaṃ,","bv9:10.2":"dutiyo āsi samāgamo;","bv9:10.3":"Anaṅgaṇānaṃ virajānaṃ,","bv9:10.4":"upasantāna tādinaṃ.","bv9:11.1":"Channaṃ satasahassānaṃ,","bv9:11.2":"tatiyo āsi samāgamo;","bv9:11.3":"Abhiññābalappattānaṃ,","bv9:11.4":"nibbutānaṃ tapassinaṃ.","bv9:12.1":"Ahaṃ tena samayena,","bv9:12.2":"yakkho āsiṃ mahiddhiko;","bv9:12.3":"Nekānaṃ yakkhakoṭīnaṃ,","bv9:12.4":"vasavattimhi issaro.","bv9:13.1":"Tadāpi taṃ buddhavaraṃ,","bv9:13.2":"upagantvā mahesinaṃ;","bv9:13.3":"Annapānena tappesiṃ,","bv9:13.4":"sasaṅghaṃ lokanāyakaṃ.","bv9:14.1":"Sopi maṃ tadā byākāsi,","bv9:14.2":"visuddhanayano muni;","bv9:14.3":"“Aparimeyyito kappe,","bv9:14.4":"ayaṃ buddho bhavissati.","bv9:15.1":"“Padhānaṃ padahitvāna … pe …","bv9:15.3":"hessāma sammukhā imaṃ”.","bv9:16.1":"Tassāpi vacanaṃ sutvā,","bv9:16.2":"haṭṭho saṃviggamānaso;","bv9:16.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv9:16.4":"dasapāramipūriyā.","bv9:17.1":"Nagaraṃ candavatī nāma,","bv9:17.2":"yasavā nāma khattiyo;","bv9:17.3":"Mātā yasodharā nāma,","bv9:17.4":"anomadassissa satthuno.","bv9:18.1":"Dasavassasahassāni,","bv9:18.2":"agāraṃ ajjha so vasi;","bv9:18.3":"Sirī upasirī vaḍḍho,","bv9:18.4":"tayo pāsādamuttamā.","bv9:19.1":"Tevīsatisahassāni,","bv9:19.2":"nāriyo samalaṅkatā;","bv9:19.3":"Sirimā nāma sā nārī,","bv9:19.4":"upavāṇo nāma atrajo.","bv9:20.1":"Nimitte caturo disvā,","bv9:20.2":"sivikāyābhinikkhami;","bv9:20.3":"Anūnadasamāsāni,","bv9:20.4":"padhānaṃ padahī jino.","bv9:21.1":"Brahmunā yācito santo,","bv9:21.2":"anomadassī mahāmuni;","bv9:21.3":"Vatti cakkaṃ mahāvīro,","bv9:21.4":"uyyāne so sudassane [sudassanuyyānamuttame (syā. kaṃ.)].","bv9:22.1":"Nisabho ca anomo ca [asoko ca (sī.)],","bv9:22.2":"ahesuṃ aggasāvakā;","bv9:22.3":"Varuṇo nāmupaṭṭhāko,","bv9:22.4":"anomadassissa satthuno.","bv9:23.1":"Sundarī ca sumanā ca,","bv9:23.2":"ahesuṃ aggasāvikā;","bv9:23.3":"Bodhi tassa bhagavato,","bv9:23.4":"ajjunoti pavuccati.","bv9:24.1":"Nandivaḍḍho sirivaḍḍho,","bv9:24.2":"ahesuṃ aggupaṭṭhakā;","bv9:24.3":"Uppalā ceva padumā ca,","bv9:24.4":"ahesuṃ aggupaṭṭhikā.","bv9:25.1":"Aṭṭhapaṇṇāsaratanaṃ,","bv9:25.2":"accuggato mahāmuni;","bv9:25.3":"Pabhā niddhāvatī tassa,","bv9:25.4":"sataraṃsīva uggato.","bv9:26.1":"Vassasatasahassāni,","bv9:26.2":"āyu vijjati tāvade;","bv9:26.3":"Tāvatā tiṭṭhamāno so,","bv9:26.4":"tāresi janataṃ bahuṃ.","bv9:27.1":"Supupphitaṃ pāvacanaṃ,","bv9:27.2":"arahantehi tādihi;","bv9:27.3":"Vītarāgehi vimalehi,","bv9:27.4":"sobhittha jinasāsanaṃ.","bv9:28.1":"So ca satthā amitayaso,","bv9:28.2":"yugāni tāni atuliyāni;","bv9:28.3":"Sabbaṃ tamantarahitaṃ,","bv9:28.4":"nanu rittā sabbasaṅkhārā.","bv9:29.1":"Anomadassī jino satthā,","bv9:29.2":"dhammārāmamhi nibbuto;","bv9:29.3":"Tatthevassa jinathūpo,","bv9:29.4":"ubbedho pañcavīsatīti.","bv9:30.1":"Anomadassissa bhagavato vaṃso sattamo."},"unsure":["bv9:3.1"],"preface":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":2281,"to":2350,"paras":[{"para":2281,"vripara":null,"refs":["bv9:4"],"lines":["<b>Asaṅkhobho</b>ti khobhetuṃ cāletuṃ asakkuṇeyyoti akkhobhiyo.","Yathā hi samuddo caturāsītiyojanasahassagambhīro anekayojanasahassabhūtāvāso akkhobhiyo, evaṃ akkhobhiyoti attho.","<b>Ākāsova ananto</b>ti yathā pana ākāsassa anto natthi, atha kho ananto appameyyo apāro, evaṃ bhagavāpi buddhaguṇehi ananto appameyyo apāro.","<b>So</b>ti so bhagavā.","<b>Sālarājāva phullito</b>ti sabbalakkhaṇānubyañjanasamalaṅkatasarīrattā suphullitasālarājā viya sobhatīti attho.","<b>Dassanenapi taṃ buddhan</b>ti tassa buddhassa dassanenāpīti attho.","Īdisesupi sāmivacanaṃ payujjanti saddasatthavidū.","<b>Tositā</b>ti paritositā pīṇitā.","<b>Byāharantan</b>ti byāharantassa, sāmiatthe upayogavacanaṃ.","<b>Amatan</b>ti nibbānaṃ.","<b>Pāpuṇantī</b>ti adhigacchanti.","<b>Te</b>ti ye tassa giraṃ dhammadesanaṃ suṇanti, te amataṃ pāpuṇantīti attho."],"lineRefs":[["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"]]},{"para":2282,"vripara":null,"refs":["bv9:4"],"lines":["Bhagavā pana bodhimūle sattasattāhaṃ vītināmetvā brahmunā āyācito dhammadesanāya buddhacakkhunā lokaṃ olokento attanā saha pabbajite tikoṭisaṅkhe jane upanissayasampanne disvā –","“kattha nu kho te etarahi viharantī”ti upadhārento subhavatīnagare sudassanuyyāne viharante disvā ākāsena gantvā sudassanuyyāne otari.","So tehi parivuto sadevamanussāya parisāya majjhe dhammacakkaṃ pavattesi.","Tattha koṭisatānaṃ paṭhamābhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"],["bv9:4"]]},{"para":2284,"vripara":"5","refs":["bv9:4"],"lines":["“Dhammābhisamayo tassa, iddho phīto tadā ahu;"],"lineRefs":[["bv9:4"]]},{"para":2285,"vripara":null,"refs":["bv9:4"],"lines":["Koṭisatāni abhisamiṃsu, paṭhame dhammadesane”ti."],"lineRefs":[["bv9:4"]]},{"para":2286,"vripara":null,"refs":["bv9:5"],"lines":["Tattha <b>phīto</b>ti phātippatto bāhujaññavasena.","<b>Koṭisatānī</b>ti koṭīnaṃ satāni koṭisatāni.","“Koṭisatayo” tipi pāṭho, tassa satakoṭiyoti attho."],"lineRefs":[["bv9:5"],["bv9:5"],["bv9:5"]]},{"para":2287,"vripara":null,"refs":["bv9:5"],"lines":["Athāparena samayena osadhīnagaradvāre asanarukkhamūle yamakapāṭihāriyaṃ katvā asurehi durabhibhavane tāvatiṃsabhavane paṇḍukambalasilāyaṃ nisinno temāsaṃ abhidhammavassaṃ vassāpayi.","Tadā asītidevatākoṭiyo abhisamiṃsu.","Tena vuttaṃ –"],"lineRefs":[["bv9:5"],["bv9:5"],["bv9:5"]]},{"para":2289,"vripara":"6","refs":["bv9:5"],"lines":["“Tato paraṃ abhisamaye, vassante dhammavuṭṭhiyo;"],"lineRefs":[["bv9:5"]]},{"para":2290,"vripara":null,"refs":["bv9:5"],"lines":["Asītikoṭiyobhisamiṃsu, dutiye dhammadesane”ti."],"lineRefs":[["bv9:5"]]},{"para":2291,"vripara":null,"refs":["bv9:6"],"lines":["Tattha <b>vassante</b>ti buddhamahāmeghe vassante.","<b>Dhammavuṭṭhiyo</b>ti dhammakathāvassavuṭṭhiyo."],"lineRefs":[["bv9:6"],["bv9:6"]]},{"para":2292,"vripara":null,"refs":["bv9:6"],"lines":["Tato aparena samayena maṅgalapañhāniddese aṭṭhasattati koṭiyo abhisamiṃsu.","So tatiyo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv9:6"],["bv9:6"],["bv9:6"]]},{"para":2294,"vripara":"7","refs":["bv9:6"],"lines":["“Tato parampi vassante, tappayante ca pāṇinaṃ;"],"lineRefs":[["bv9:6"]]},{"para":2295,"vripara":null,"refs":["bv9:6"],"lines":["Aṭṭhasattatikoṭīnaṃ, tatiyābhisamayo ahū”ti."],"lineRefs":[["bv9:6"]]},{"para":2296,"vripara":null,"refs":["bv9:7"],"lines":["Tattha <b>vassante</b>ti dhammakathāsaliladhāraṃ vassante.","<b>Tappayante</b>ti dhammāmatavassena tappayante, tappanaṃ karonte bhagavatīti attho."],"lineRefs":[["bv9:7"],["bv9:7"]]},{"para":2297,"vripara":null,"refs":["bv9:7"],"lines":["Anomadassissapi bhagavato tayo sāvakasannipātā ahesuṃ.","Tattha soreyyanagare isidattassa rañño dhamme desiyamāne pasīditvā ehibhikkhupabbajjāya pabbajitānaṃ aṭṭhannaṃ arahantasatasahassānaṃ majjhe pātimokkhaṃ uddisi.","Ayaṃ paṭhamo sannipāto ahosi.","Rādhavatīnagare sundarindharassa nāma rañño dhamme desiyamāne ehibhikkhupabbajjāya pabbajitānaṃ sattannaṃ arahantasatasahassānaṃ majjhe pātimokkhaṃ uddisi.","Ayaṃ dutiyo sannipāto ahosi.","Puna soreyyanagareyeva soreyyaraññā saha ehibhikkhupabbajjāya pabbajitānaṃ channaṃ arahantasatasahassānaṃ majjhe pātimokkhaṃ uddisi.","Ayaṃ tatiyo sannipāto ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv9:7"],["bv9:7"],["bv9:7"],["bv9:7"],["bv9:7"],["bv9:7"],["bv9:7"],["bv9:7"]]},{"para":2299,"vripara":"8","refs":["bv9:7"],"lines":["“Sannipātā tayo āsuṃ, tassāpi ca mahesino;"],"lineRefs":[["bv9:7"]]},{"para":2300,"vripara":null,"refs":["bv9:7"],"lines":["Abhiññābalappattānaṃ, pupphitānaṃ vimuttiyā."],"lineRefs":[["bv9:7"]]},{"para":2302,"vripara":"9","refs":["bv9:7"],"lines":["“Aṭṭhasatasahassānaṃ, sannipāto tadā ahu;"],"lineRefs":[["bv9:7"]]},{"para":2303,"vripara":null,"refs":["bv9:7"],"lines":["Pahīnamadamohānaṃ, santacittāna tādinaṃ."],"lineRefs":[["bv9:7"]]},{"para":2305,"vripara":"10","refs":["bv9:7"],"lines":["“Sattasatasahassānaṃ, dutiyo āsi samāgamo;"],"lineRefs":[["bv9:7"]]},{"para":2306,"vripara":null,"refs":["bv9:7"],"lines":["Anaṅgaṇānaṃ virajānaṃ, upasantāna tādinaṃ."],"lineRefs":[["bv9:7"]]},{"para":2308,"vripara":"11","refs":["bv9:7"],"lines":["“Channaṃ satasahassānaṃ, tatiyo āsi samāgamo;"],"lineRefs":[["bv9:7"]]},{"para":2309,"vripara":null,"refs":["bv9:7"],"lines":["Abhiññābalappattānaṃ, nibbutānaṃ tapassinan”ti."],"lineRefs":[["bv9:7"]]},{"para":2310,"vripara":null,"refs":["bv9:7","bv9:11"],"lines":["Tattha <b>tassāpi ca mahesino</b>ti tassa mahesino anomadassissāpi.","“Tassāpi dvipaduttamo” tipi pāṭho, tassapi dvipaduttamassāti attho.","Lakkhaṇaṃ saddasatthato gahetabbaṃ.","<b>Abhiññābalappattānan</b>ti abhiññānaṃ balappattānaṃ, ciṇṇavasitāya khippanisantibhāvena abhiññāsu thirabhāvappattānanti attho.","<b>Pupphitānan</b>ti sabbaphāliphullabhāvena ativiya sobhaggappattānaṃ.","<b>Vimuttiyā</b>ti arahattaphalavimuttiyā."],"lineRefs":[["bv9:7"],["bv9:7"],["bv9:7"],["bv9:11"],["bv9:11"],["bv9:11"]]},{"para":2311,"vripara":null,"refs":["bv9:11"],"lines":["<b>Anaṅgaṇānan</b>ti ettha ayaṃ <b>aṅgaṇa</b> -saddo katthaci kilesesu dissati.","Yathāha –","“tattha katamāni tīṇi aṅgaṇāni?","Rāgo aṅgaṇaṃ doso aṅgaṇaṃ moho aṅgaṇan”ti (vibha.924).","“Pāpakānaṃ kho etaṃ, āvuso, akusalānaṃ icchāvacarānaṃ adhivacanaṃ yadidaṃ aṅgaṇan”ti (ma. ni.1.60).","Katthaci kismiñci male?","Yathāha –","“tasseva rajassa vā aṅgaṇassa vā pahānāya vāyamatī”ti (ma. ni.1.184).","Katthaci tathārūpe bhūmibhāge “cetiyaṅgaṇaṃ bodhiyaṅgaṇaṃ rājaṅgaṇan”ti.","Idha pana kilesesu daṭṭhabbo.","Tasmā nikkilesānanti attho (ma. ni. aṭṭha.1.57).","<b>Virajānan</b>ti tasseva vevacanaṃ.","<b>Tapassinan</b>ti kilesakkhayakaro ariyamaggasaṅkhāto tapo yesaṃ atthi te tapassino, tesaṃ tapassīnaṃ, khīṇāsavānanti attho."],"lineRefs":[["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"]]},{"para":2312,"vripara":null,"refs":["bv9:11"],"lines":["Tadā amhākaṃ bodhisatto eko mahesakkho yakkhasenāpati ahosi mahiddhiko mahānubhāvo anekakoṭisatasahassānaṃ yakkhānaṃ adhipati.","So “buddho loke uppanno”ti sutvā āgantvā paramaruciradassanaṃ sattaratanamayaṃ abhirucirarajanikaramaṇḍalasadisaṃ maṇḍapaṃ nimminitvā tattha sattāhaṃ mahādānaṃ buddhappamukhassa saṅghassa adāsi.","Atha naṃ bhagavā bhattānumodanasamaye “anāgate kappasatasahassādhike ekasmiṃ asaṅkhyeyye atikkante gotamo nāma buddho bhavissatī”ti byākāsi.","Tena vuttaṃ –"],"lineRefs":[["bv9:11"],["bv9:11"],["bv9:11"],["bv9:11"]]},{"para":2314,"vripara":"12","refs":["bv9:11"],"lines":["“Ahaṃ tena samayena, yakkho āsiṃ mahiddhiko;"],"lineRefs":[["bv9:11"]]},{"para":2315,"vripara":null,"refs":["bv9:11"],"lines":["Nekānaṃ yakkhakoṭīnaṃ, vasavattimhi issaro."],"lineRefs":[["bv9:11"]]},{"para":2317,"vripara":"13","refs":["bv9:11"],"lines":["“Tadāpi taṃ buddhavaraṃ, upagantvā mahesinaṃ;"],"lineRefs":[["bv9:11"]]},{"para":2318,"vripara":null,"refs":["bv9:11"],"lines":["Annapānena tappesiṃ, sasaṅghaṃ lokanāyakaṃ."],"lineRefs":[["bv9:11"]]},{"para":2320,"vripara":"14","refs":["bv9:11"],"lines":["“Sopi maṃ tadā byākāsi, visuddhanayano muni;"],"lineRefs":[["bv9:11"]]},{"para":2321,"vripara":null,"refs":["bv9:11"],"lines":["Aparimeyyito kappe, ayaṃ buddho bhavissati."],"lineRefs":[["bv9:11"]]},{"para":2323,"vripara":"15","refs":["bv9:11"],"lines":["“Padhānaṃ padahitvāna … pe … hessāma sammukhā imaṃ."],"lineRefs":[["bv9:11"]]},{"para":2325,"vripara":"16","refs":["bv9:11"],"lines":["“Tassāpi vacanaṃ sutvā, haṭṭho saṃviggamānaso;"],"lineRefs":[["bv9:11"]]},{"para":2326,"vripara":null,"refs":["bv9:11"],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā”ti."],"lineRefs":[["bv9:11"]]},{"para":2327,"vripara":null,"refs":["bv9:16"],"lines":["Tattha <b>uttariṃ vatamadhiṭṭhāsin</b>ti pāramipūraṇatthāya bhiyyopi daḷhataraṃ parakkamamakāsīti attho."],"lineRefs":[["bv9:16"]]},{"para":2328,"vripara":null,"refs":["bv9:16"],"lines":["Tassa pana <b>anomadassissa</b> bhagavato candavatī nāma nagaraṃ ahosi, yasavā nāma rājā pitā, yasodharā nāma mātā, nisabho ca anomo ca dve aggasāvakā, varuṇo nāmupaṭṭhāko, sundarī ca sumanā ca dve aggasāvikā, ajjunarukkho bodhi, sarīraṃ aṭṭhapaṇṇāsahatthubbedhaṃ ahosi, vassasatasahassaṃ āyu, sirimā nāma aggamahesī, upavāṇo nāmassa putto, dasavassasahassāni agāraṃ ajjhāvasi.","So sivikāyānena nikkhami.","Sivikāyānena gamanaṃ pana sobhitabuddhavaṃsavaṇṇanāya pāsādagamane vuttanayeneva veditabbaṃ.","Dhammako nāma rājā upaṭṭhāko.","Dhammārāme kira bhagavā vihāsīti.","Tena vuttaṃ –"],"lineRefs":[["bv9:16"],["bv9:16"],["bv9:16"],["bv9:16"],["bv9:16"],["bv9:16"]]},{"para":2330,"vripara":"17","refs":["bv9:16"],"lines":["“Nagaraṃ candavatī nāma, yasavā nāma khattiyo;"],"lineRefs":[["bv9:16"]]},{"para":2331,"vripara":null,"refs":["bv9:16"],"lines":["Mātā yasodharā nāma, anomadassissa satthuno."],"lineRefs":[["bv9:16"]]},{"para":2333,"vripara":"22","refs":["bv9:16"],"lines":["“Nisabho ca anomo ca, ahesuṃ aggasāvakā;"],"lineRefs":[["bv9:16"]]},{"para":2334,"vripara":null,"refs":["bv9:16"],"lines":["Varuṇo nāmupaṭṭhāko, anomadassissa satthuno."],"lineRefs":[["bv9:16"]]},{"para":2336,"vripara":"23","refs":["bv9:16"],"lines":["“Sundarī ca sumanā ca, ahesuṃ aggasāvikā;"],"lineRefs":[["bv9:16"]]},{"para":2337,"vripara":null,"refs":["bv9:16"],"lines":["Bodhi tassa bhagavato, ajjunoti pavuccati."],"lineRefs":[["bv9:16"]]},{"para":2339,"vripara":"25","refs":["bv9:16"],"lines":["“Aṭṭhapaṇṇāsaratanaṃ, accuggato mahāmuni;"],"lineRefs":[["bv9:16"]]},{"para":2340,"vripara":null,"refs":["bv9:16"],"lines":["Pabhā niddhāvatī tassa, sataraṃsīva uggato."],"lineRefs":[["bv9:16"]]},{"para":2342,"vripara":"26","refs":["bv9:16"],"lines":["“Vassasatasahassāni, āyu vijjati tāvade;"],"lineRefs":[["bv9:16"]]},{"para":2343,"vripara":null,"refs":["bv9:16"],"lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[["bv9:16"]]},{"para":2345,"vripara":"27","refs":["bv9:16"],"lines":["“Supupphitaṃ pāvacanaṃ, arahantehi tādihi;"],"lineRefs":[["bv9:16"]]},{"para":2346,"vripara":null,"refs":["bv9:16"],"lines":["Vītarāgehi vimalehi, sobhittha jinasāsanaṃ."],"lineRefs":[["bv9:16"]]},{"para":2348,"vripara":"28","refs":["bv9:16"],"lines":["“So ca satthā amitayaso, yugāni tāni atuliyāni;"],"lineRefs":[["bv9:16"]]},{"para":2349,"vripara":null,"refs":["bv9:16"],"lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā”ti."],"lineRefs":[["bv9:16"]]},{"para":2350,"vripara":null,"refs":["bv9:16","bv9:28"],"lines":["Tattha <b>pabhā niddhāvatī</b>ti tassa sarīrato pabhā nikkhamati.","Sarīrappabhā panassa niccakālaṃ dvādasayojanappamāṇaṃ padesaṃ pharitvā tiṭṭhati.","<b>Yugāni tānī</b>ti aggasāvakayugādīni yugaḷāni.","<b>Sabbaṃ tamantarahitan</b>ti vuttappakāraṃ sabbampi aniccamukhaṃ paviṭṭhaṃ vinaṭṭhanti attho.","“Nanu rittakameva saṅkhārā” tipi pāṭho, tassa nanu rittakā tucchakāyeva sabbe saṅkhārāti attho.","<b>Ma</b> -kāro padasandhikaro.","Sesagāthāsu sabbattha uttānamevāti."],"lineRefs":[["bv9:16"],["bv9:16"],["bv9:28"],["bv9:28"],["bv9:28"],["bv9:28"],["bv9:28"]]}],"wordLinks":[["bv9:4.1","dassanenapi taṃ buddhaṃ",0,5],["bv9:4.1","tositā",0,7],["bv9:4.3","byāharantaṃ",0,8],["bv9:4.3","amataṃ",0,9],["bv9:4.3","pāpuṇantī",0,10],["bv9:4.3","te",0,11],["bv9:5.1","phīto",4,0],["bv9:5.3","koṭisatānī",4,1],["bv9:6.1","vassante",8,0],["bv9:6.1","dhammavuṭṭhiyo",8,1],["bv9:7.1","vassante",12,0],["bv9:7.1","tappayante",12,1],["bv9:11.3","abhiññābalappattānaṃ",22,3],["bv9:11.3","tapassinaṃ",23,12],["bv9:16.3","uttariṃ vatamadhiṭṭhāsiṃ",34,0],["bv9:28.1","yugāni tānī",50,2],["bv9:28.3","sabbaṃ tamantarahitaṃ",50,3],["bv9:28.3","ma",50,5]],"before":[{"para":2264,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Anomadassībuddhavaṃsavaṇṇanā"]},{"para":2265,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Sobhitabuddhe pana parinibbute tassa aparabhāge ekamasaṅkhyeyyaṃ buddhuppādarahitaṃ ahosi.","Atīte pana tasmiṃ asaṅkhyeyye ekasmiṃ kappe tayo buddhā nibbattiṃsu <b>anomadassī, padumo, nārado</b>ti.","Tattha <b>anomadassī</b> bhagavā soḷasa asaṅkhyeyyāni kappasatasahassañca pāramiyo pūretvā tusitapure nibbattitvā devehi abhiyācito tato cavitvā candavatiyaṃ nāma rājadhāniyaṃ yasavā nāmassa rañño kule samussitacārupayodharāya yasodharāya nāma aggamahesiyā kucchismiṃ paṭisandhiṃ aggahesi.","Anomadassikumāre kira yasodharāya deviyā kucchigate tassa puññappabhāvena pabhā asītihatthappamāṇaṃ ṭhānaṃ pharitvā aṭṭhāsi.","Candasūriyappabhāhi anabhibhavanīyāva ahosi.","Sā dasannaṃ māsānaṃ accayena bodhisattaṃ sucandanuyyāne vijāyi.","Pāṭihāriyāni heṭṭhā vuttanayāneva."]},{"para":2266,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Nāmaggahaṇadivase panassa nāmaṃ gaṇhantā, yasmā jātiyaṃ ākāsato satta ratanāni patiṃsu, tasmā anomānaṃ ratanānaṃ uppattihetubhūtattā “anomadassī”ti nāmamakaṃsu.","So anukkamena vuddhippatto dibbehi kāmaguṇehi paricāriyamāno dasavassasahassāni agāraṃ ajjhāvasi.","Tassa kira siri upasiri sirivaḍḍhoti tayo pāsādā ahesuṃ.","Sirimādevippamukhāni tevīsati itthisahassāni paccupaṭṭhitāni ahesuṃ.","So sirimāya deviyā upavāṇe nāma putte jāte cattāri nimittāni disvā sivikāyānena mahābhinikkhamanaṃ nikkhamitvā pabbaji.","Taṃ tisso janakoṭiyo anupabbajiṃsu."]},{"para":2267,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Tehi parivuto mahāpuriso dasa māse padhānacariyaṃ cari.","Tato visākhapuṇṇamāya anupamabrāhmaṇagāme piṇḍāya caritvā anupamaseṭṭhidhītāya dinnaṃ madhupāyāsaṃ paribhuñjitvā sālavane divāvihāraṃ vītināmetvā anomanāmājīvakena dinnā aṭṭha tiṇamuṭṭhiyo gahetvā ajjunarukkhabodhiṃ padakkhiṇaṃ katvā aṭṭhattiṃsahatthavitthataṃ tiṇasantharaṃ santharitvā caturaṅgavīriyaṃ adhiṭṭhāya pallaṅkaṃ ābhujitvā samāraṃ mārabalaṃ viddhaṃsetvā tīsu yāmesu tisso vijjā uppādetvā –","“anekajātisaṃsāraṃ … pe … taṇhānaṃ khayamajjhagā”ti udānaṃ udānesi.","Tena vuttaṃ –"]},{"para":2269,"vripara":"1","title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["“Sobhitassa aparena, sambuddho dvipaduttamo;"]},{"para":2270,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Anomadassī amitayaso, tejassī duratikkamo."]},{"para":2272,"vripara":"2","title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["“So chetvā bandhanaṃ sabbaṃ, viddhaṃsetvā tayo bhave;"]},{"para":2273,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Anivattigamanaṃ maggaṃ, desesi devamānuse."]},{"para":2275,"vripara":"3","title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["“Sāgarova asaṅkhobho, pabbatova durāsado;"]},{"para":2276,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Ākāsova ananto so, sālarājāva phullito."]},{"para":2278,"vripara":"4","title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["“Dassanenapi taṃ buddhaṃ, tositā honti pāṇino;"]},{"para":2279,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Byāharantaṃ giraṃ sutvā, amataṃ pāpuṇanti te”ti."]},{"para":2280,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Tattha <b>anomadassī</b>ti anupamadassano, amitadassano vā.","<b>Amitayaso</b>ti amitaparivāro, amitakitti vā.","<b>Tejassī</b>ti sīlasamādhipaññātejena samannāgato.","<b>Duratikkamo</b>ti duppadhaṃsiyo, aññena devena vā mārena vā kenaci vā atikkamituṃ asakkuṇeyyoti attho.","<b>So chetvā bandhanaṃ sabban</b>ti sabbaṃ dasavidhaṃ saṃyojanaṃ chinditvā.","<b>Viddhaṃsetvā tayo bhave</b>ti tibhavūpagaṃ kammaṃ kammakkhayakarañāṇena viddhaṃsetvā, abhāvaṃ katvāti attho.","<b>Anivattigamanaṃ maggan</b>ti nivattiyā pavattiyā paṭipakkhabhūtaṃ nibbānaṃ anivattīti vuccati, taṃ anivattiṃ gacchati anenāti anivattigamano.","Taṃ anivattigamanaṃ aṭṭhaṅgikaṃ maggaṃ desesīti attho.","“Dassetī” tipi pāṭho, soyevattho.","<b>Devamānuse</b>ti devamanussānaṃ, sāmiatthe upayogavacanaṃ daṭṭhabbaṃ."]}],"after":[{"para":2351,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Imassa pana anomadassissa bhagavato santike sāriputto ca mahāmoggallāno cāti ime dve aggasāvakā aggasāvakabhāvatthāya paṇidhānamakaṃsu.","Imesaṃ pana therānaṃ vatthu cettha kathetabbaṃ.","Mayā ganthavitthārabhayena na uddhaṭanti."]},{"para":2352,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Anomadassībuddhavaṃsavaṇṇanā niṭṭhitā."]},{"para":2353,"vripara":null,"title":"Anomadassībuddhavaṃsavaṇṇanā","lines":["Niṭṭhito sattamo buddhavaṃso."]}]},"tika":null,"tika2":null}
