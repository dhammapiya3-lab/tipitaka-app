{"suttaId":"sn52.24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1840,1845],"vripara":"922"},"segments":{"sn52.24:0.3":"Āsavakkhayasuttaṃ","sn52.24:1.1":"“Imesañca panāhaṃ, āvuso, catunnaṃ satipaṭṭhānānaṃ bhāvitattā bahulīkatattā āsavānaṃ khayā anāsavaṃ cetovimuttiṃ paññāvimuttiṃ diṭṭhe dhamme sayaṃ abhiññā sacchikatvā upasampajja viharāmī”ti.","sn52.24:1.2":"Cuddasamaṃ.","sn52.24:1.3":"Dutiyo vaggo.","sn52.24:2.0":"Tassuddānaṃ –","sn52.24:2.1":"Mahābhiññaṃ iddhi dibbaṃ,","sn52.24:2.2":"cetopariyaṃ ṭhānaṃ kammaṃ;","sn52.24:2.3":"Sabbatthadhātudhimutti,","sn52.24:2.4":"indriyaṃ jhānaṃ tisso vijjāti.","sn52.24:2.5":"Anuruddhasaṃyuttaṃ aṭṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":711,"to":713,"paras":[{"para":711,"vripara":"909-922","refs":["sn52.24:1"],"lines":["909-922. Dutiyavagge <b>ṭhānañca ṭhānato</b>tiādīhi thero dasabalañāṇaṃ paṭijānāti.","Kimpanetaṃ sāvakānaṃ hotīti?","Ekadesena hoti, sabbaññubuddhānaṃ panetaṃ nippadesaṃ sabbākāraparipūranti."],"lineRefs":[["sn52.24:1"],["sn52.24:1"],["sn52.24:1"]]},{"para":712,"vripara":null,"refs":["sn52.24:1"],"lines":["Anuruddhasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn52.24:1"]]},{"para":713,"vripara":null,"refs":["sn52.24:1"],"lines":["Jhānasaṃyuttavaṇṇanā"],"lineRefs":[["sn52.24:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":615,"to":618,"paras":[{"para":615,"vripara":"909-922","refs":["sn52.24:1"],"lines":["909-922. <b>Dasabalañāṇan</b>ti dasavidhabalañāṇaṃ.","<b>Ekadesenā</b>ti padesavasena.","Sāvakānampi attano abhinīhārānurūpaṃ ñāṇaṃ pavattatīti te kālapadesavasena ceva yathāparicayasattapadesavasena ca ṭhānānīti jānanti, sammāsambuddhānaṃ pana anantañāṇatāya sabbattheva appaṭihatameva ñāṇanti āha –","<b>“sabbaññubuddhānaṃ panā”</b>tiādi.","<b>Etaṃ</b> dasabalañāṇaṃ anantavisayattā <b>nippadesaṃ</b> anūnatāya <b>sabbākāraparipūraṃ</b>."],"lineRefs":[["sn52.24:1"],["sn52.24:1"],["sn52.24:1"],["sn52.24:1"],["sn52.24:1"]]},{"para":616,"vripara":null,"refs":["sn52.24:1"],"lines":["Dutiyavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn52.24:1"]]},{"para":617,"vripara":null,"refs":["sn52.24:1"],"lines":["Anuruddhasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn52.24:1"]]},{"para":618,"vripara":null,"refs":["sn52.24:1"],"lines":["Jhānasaṃyuttavaṇṇanā"],"lineRefs":[["sn52.24:1"]]}],"wordLinks":[]},"tika2":null}
