{"suttaId":"tha-ap508","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3090,3107],"vripara":"68"},"segments":{"tha-ap508:0.3":"Mātuluṅgaphaladāyakattheraapadānaṃ","tha-ap508:1.1":"“Kaṇikāraṃva jalitaṃ,","tha-ap508:1.2":"puṇṇamāyeva candimaṃ;","tha-ap508:1.3":"Jalantaṃ dīparukkhaṃva,","tha-ap508:1.4":"addasaṃ lokanāyakaṃ. 69.","tha-ap508:2.1":"“Mātuluṅgaphalaṃ gayha,","tha-ap508:2.2":"adāsiṃ satthuno ahaṃ;","tha-ap508:2.3":"Dakkhiṇeyyassa vīrassa [dhīrassa (sī.)],","tha-ap508:2.4":"pasanno sehi pāṇibhi. 70.","tha-ap508:3.1":"“Ekatiṃse ito kappe,","tha-ap508:3.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap508:3.3":"Duggatiṃ nābhijānāmi,","tha-ap508:3.4":"phaladānassidaṃ phalaṃ. 71.","tha-ap508:4.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap508:4.3":"viharāmi anāsavo. 72.","tha-ap508:5.1":"“Svāgataṃ vata me āsi…pe…","tha-ap508:5.3":"kataṃ buddhassa sāsanaṃ. 73.","tha-ap508:6.1":"“Paṭisambhidā catasso…pe…","tha-ap508:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap508:7.1":"Itthaṃ sudaṃ āyasmā mātuluṅgaphaladāyako thero imā Gāthāyo abhāsitthāti.","tha-ap508:8.1":"Mātuluṅgaphaladāyakattherassāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
