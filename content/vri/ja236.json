{"suttaId":"ja236","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1606,1612],"vripara":"171"},"segments":{"ja236:0.4":"Bakajātakaṃ (2-9-6)","ja236:1.1":"Bhaddako vatayaṃ pakkhī, dijo kumudasannibho;","ja236:1.3":"Vūpasantehi pakkhehi, mandamandova jhāyati.","ja236:2.1":"Nāssa sīlaṃ vijānātha, anaññāya pasaṃsatha;","ja236:2.3":"Amhe dijo na pāleti, tena pakkhī na phandatīti.","ja236:3.1":"Bakajātakaṃ chaṭṭhaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1506,"to":1511,"paras":[{"para":1506,"vripara":null,"refs":["ja236:1"],"lines":["Tattha <b>mandamandova jhāyatī</b>ti abalabalo viya hutvā kiñci ajānanto viya ekakova jhāyatīti."],"lineRefs":[["ja236:1"]]},{"para":1507,"vripara":null,"refs":["ja236:1"],"lines":["Atha naṃ bodhisatto oloketvā dutiyaṃ gāthamāha –"],"lineRefs":[["ja236:1"]]},{"para":1509,"vripara":"172","refs":["ja236:1"],"lines":["“Nāssa sīlaṃ vijānātha, anaññāya pasaṃsatha;"],"lineRefs":[["ja236:1"]]},{"para":1510,"vripara":null,"refs":["ja236:1"],"lines":["Amhe dijo na pāleti, tena pakkhī na phandatī”ti."],"lineRefs":[["ja236:1"]]},{"para":1511,"vripara":null,"refs":["ja236:2"],"lines":["Tattha <b>anaññāyā</b>ti ajānitvā.","<b>Amhe dijo na pāletī</b>ti esa dijo amhe na rakkhati na gopāyati,“kataraṃ nu kho etesu kabaḷaṃ karissāmī”ti upadhāreti.","<b>Tena pakkhī na phandatī</b>ti tenāyaṃ sakuṇo na phandati na calatīti.","Evaṃ vutte macchagaṇo udakaṃ khobhetvā bakaṃ palāpesi."],"lineRefs":[["ja236:2"],["ja236:2"],["ja236:2"],["ja236:2"]]}],"wordLinks":[["ja236:1.3","mandamandova jhāyatī",0,0],["ja236:2.1","anaññāyā",4,0],["ja236:2.3","amhe dijo na pāletī",4,1],["ja236:2.3","tena pakkhī na phandatī",4,2]]},"tika":null,"tika2":null}
