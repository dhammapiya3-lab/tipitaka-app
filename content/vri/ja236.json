{"suttaId":"ja236","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1606,1612],"vripara":"171"},"segments":{"ja236:0.4":"Bakajātakaṃ (2-9-6)","ja236:1.1":"Bhaddako vatayaṃ pakkhī, dijo kumudasannibho;","ja236:1.3":"Vūpasantehi pakkhehi, mandamandova jhāyati.","ja236:2.1":"Nāssa sīlaṃ vijānātha, anaññāya pasaṃsatha;","ja236:2.3":"Amhe dijo na pāleti, tena pakkhī na phandatīti.","ja236:3.1":"Bakajātakaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
