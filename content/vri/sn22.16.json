{"suttaId":"sn22.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[120,120],"vripara":"16"},"segments":{"sn22.16:0.3":"Yaṃdukkhasuttaṃ","sn22.16:1.1":"Sāvatthinidānaṃ.","sn22.16:1.2":"“Rūpaṃ, bhikkhave, dukkhaṃ.","sn22.16:1.3":"Yaṃ dukkhaṃ tadanattā;","sn22.16:1.4":"yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn22.16:1.5":"Vedanā dukkhā …","sn22.16:1.6":"saññā dukkhā …","sn22.16:1.7":"saṅkhārā dukkhā …","sn22.16:1.8":"viññāṇaṃ dukkhaṃ.","sn22.16:1.9":"Yaṃ dukkhaṃ tadanattā;","sn22.16:1.10":"yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn22.16:1.11":"Evaṃ passaṃ … pe …","sn22.16:1.12":"nāparaṃ itthattāyāti pajānātī”ti.","sn22.16:1.13":"Pañcamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":70,"to":73,"paras":[{"para":70,"vripara":"12-21","refs":["sn22.16:1"],"lines":["12-21. Aniccavagge pariyosānasuttaṃ pucchāvasikaṃ, sesāni tathā tathā bujjhanakānañca vasena desitānīti.","Paṭhamādīni."],"lineRefs":[["sn22.16:1"],["sn22.16:1"]]},{"para":71,"vripara":null,"refs":["sn22.16:1"],"lines":["Aniccavaggo dutiyo."],"lineRefs":[["sn22.16:1"]]},{"para":72,"vripara":null,"refs":["sn22.16:1"],"lines":["Bhāravaggo"],"lineRefs":[["sn22.16:1"]]},{"para":73,"vripara":null,"refs":["sn22.16:1"],"lines":["Bhārasuttavaṇṇanā"],"lineRefs":[["sn22.16:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":66,"to":70,"paras":[{"para":66,"vripara":"12-21","refs":["sn22.16:1"],"lines":["12-21. <b>Pucchāvasikaṃ</b> ānandattherassa pucchāvasena desitattā."],"lineRefs":[["sn22.16:1"]]},{"para":67,"vripara":null,"refs":["sn22.16:1"],"lines":["Aniccādisuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.16:1"]]},{"para":68,"vripara":null,"refs":["sn22.16:1"],"lines":["Aniccavaggavaṇṇanā niṭṭhitā."],"lineRefs":