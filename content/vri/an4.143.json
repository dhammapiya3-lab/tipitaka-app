{"suttaId":"an4.143","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1198,1198],"vripara":"143"},"segments":{"an4.143:0.3":"Ālokasuttaṃ","an4.143:1.1":"“Cattārome, bhikkhave, ālokā.","an4.143:1.2":"Katame cattāro?","an4.143:1.3":"Candāloko, sūriyāloko, aggāloko, paññāloko – ime kho, bhikkhave, cattāro ālokā.","an4.143:1.5":"Etadaggaṃ, bhikkhave, imesaṃ catunnaṃ ālokānaṃ yadidaṃ paññāloko”ti.","an4.143:1.6":"Tatiyaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1450,"to":1451,"paras":[{"para":1450,"vripara":"142-145","refs":["an4.143:1"],"lines":["142-145. Dutiyādīsupi pabhāsanavasena candova <b>candappabhā</b>.","Ālokanavasena candova <b>candāloko</b>.","Obhāsanavasena candova <b>candobhāso</b>.","Pajjotanavasena candova <b>candapajjoto</b>ti.","Evaṃ sabbapadesupi attho veditabbo."],"lineRefs":[["an4.143:1"],["an4.143:1"],["an4.143:1"],["an4.143:1"],["an4.143:1"]]},{"para":1451,"vripara":null,"refs":["an4.143:1"],"lines":["Paṭhamakālasuttavaṇṇanā"],"lineRefs":[["an4.143:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1637,"to":1639,"paras":[{"para":1637,"vripara":"141-146","refs":["an4.143:1"],"lines":["141-146. Pañcamassa paṭhamādīni uttānatthāneva."],"lineRefs":[["an4.143:1"]]},{"para":1638,"vripara":null,"refs":[],"lines":["Ābhāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1639,"vripara":null,"refs":["an4.143:1"],"lines":["7-10. Dutiyakālasuttādivaṇṇanā"],"lineRefs":[["an4.143:1"]]}],"wordLinks":[]}}
