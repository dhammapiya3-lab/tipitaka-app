{"suttaId":"tha-ap131","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5967,5985],"vripara":"91"},"segments":{"tha-ap131:0.3":"Gaṇṭhipupphiyattheraapadānaṃ","tha-ap131:1.1":"“Suvaṇṇavaṇṇo sambuddho,","tha-ap131:1.2":"vipassī dakkhiṇāraho;","tha-ap131:1.3":"Purakkhato sāvakehi,","tha-ap131:1.4":"ārāmā abhinikkhami.","tha-ap131:2.1":"“Disvānahaṃ buddhaseṭṭhaṃ,","tha-ap131:2.2":"sabbaññuṃ tamanāsakaṃ;","tha-ap131:2.3":"Pasannacitto sumano,","tha-ap131:2.4":"gaṇṭhipupphaṃ [gatamaggaṃ (syā. ka.)] apūjayiṃ.","tha-ap131:3.1":"“Tena cittappasādena,","tha-ap131:3.2":"dvipadindassa tādino;","tha-ap131:3.3":"Haṭṭho haṭṭhena cittena,","tha-ap131:3.4":"puna vandiṃ tathāgataṃ.","tha-ap131:4.1":"“Ekanavutito kappe,","tha-ap131:4.2":"yaṃ pupphamabhiropayiṃ;","tha-ap131:4.3":"Duggatiṃ nābhijānāmi,","tha-ap131:4.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap131:5.1":"“Ekatālīsito kappe,","tha-ap131:5.2":"caraṇo nāma khattiyo;","tha-ap131:5.3":"Sattaratanasampanno,","tha-ap131:5.4":"cakkavattī mahabbalo.","tha-ap131:6.1":"“Paṭisambhidā catasso … pe …","tha-ap131:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap131:7.1":"Itthaṃ sudaṃ āyasmā gaṇṭhipupphiyo [gandhapupphiyo (syā. ka.)] thero imā gāthāyo abhāsitthāti.","tha-ap131:8.1":"Gaṇṭhipupphiyattherassāpadānaṃ navamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2929,"to":2929,"paras":[{"para":2929,"vripara":"91","refs":["tha-ap131:1"],"lines":["So ekadivasaṃ pubbe katapuññaṃ saritvā somanassajāto “iminā kusalenāhaṃ nibbānaṃ patto”ti pubbacaritāpadānaṃ pakāsento <b>suvaṇṇavaṇṇo sambuddho</b>tiādimāha.","Taṃ sabbaṃ heṭṭhā vuttanayattā uttānatthamevāti."],"lineRefs":[["tha-ap131:1"],["tha-ap131:1"]]}],"wordLinks":[["tha-ap131:1.1","suvaṇṇavaṇṇo sambuddho",0,0]],"before":[{"para":2926,"vripara":null,"refs":[],"lines":["Ñāṇasaññikattheraapadānavaṇṇanā samattā."],"lineRefs":[[]]},{"para":2927,"vripara":null,"refs":[],"lines":["Gaṇṭhipupphiyattheraapadānavaṇṇanā"],"lineRefs":[[]]},{"para":2928,"vripara":null,"refs":[],"lines":["<b>Suvaṇṇavaṇṇo sambuddho</b>tiādikaṃ āyasmato gaṇṭhipupphiyattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro anekāsu jātīsu katapuññasañcayo vipassissa bhagavato kāle ekasmiṃ kulagehe nibbatto upabhogaparibhogehi anūno ekadivasaṃ vipassiṃ bhagavantaṃ sagaṇaṃ disvā pasannamānaso lājāpañcamehi pupphehi pūjesi.","So teneva cittappasādena yāvatāyukaṃ ṭhatvā tato devaloke nibbatto dibbasampattiṃ anubhavitvā aparabhāge manussesu manussasampattiṃ anubhavitvā imasmiṃ buddhuppāde ekasmiṃ kulagehe nibbatto saddhājāto pabbajitvā nacirasseva arahattaṃ pāpuṇi."],"lineRefs":[[],[],[]]}]},"tika":null,"tika2":null}
