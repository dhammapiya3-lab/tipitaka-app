{"suttaId":"thig1.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[93,98],"vripara":"18"},"segments":{"thig1.18:0.3":"Saṅghātherīgāthā","thig1.18:1.1":"“Hitvā ghare pabbajitvā [pabbajitā (sī. aṭṭha.)],","thig1.18:1.2":"hitvā puttaṃ pasuṃ piyaṃ;","thig1.18:1.3":"Hitvā rāgañca dosañca,","thig1.18:1.4":"avijjañca virājiya;","thig1.18:1.5":"Samūlaṃ taṇhamabbuyha,","thig1.18:1.6":"upasantāmhi nibbutā”ti. …","thig1.18:2.1":"Saṅghā therī….","thig1.18:3.1":"Ekakanipāto niṭṭhito. 2."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":272,"to":272,"paras":[{"para":272,"vripara":null,"refs":["thig1.18:1"],"lines":["Tattha <b>hitvā</b>ti chaḍḍetvā.","<b>Ghare</b>ti gehaṃ.","Gharasaddo hi ekasmimpi abhidheyye kadāci bahūsu bījaṃ viya rūḷhivasena voharīyati.","<b>Hitvā puttaṃ pasuṃ piya</b>nti piyāyitabbe putte ceva gomahiṃsādike pasū ca tappaṭibaddhachandarāgappahānena pahāya.","<b>Hitvā rāgañca dosañcā</b>ti rajjanasabhāvaṃ rāgaṃ, dussanasabhāvaṃ dosañca ariyamaggena samucchinditvā.","<b>Avijjañca virājiyā</b>ti sabbākusalesu pubbaṅgamaṃ mohañca virājetvā maggena samugghāṭetvā icceva attho.","Sesaṃ vuttanayameva."],"lineRefs":[["thig1.18:1"],["thig1.18:1"],["thig1.18:1"],["thig1.18:1"],["thig1.18:1"],["thig1.18:1"],["thig1.18:1"]]}],"wordLinks":[["thig1.18:1.1","hitvā",0,0],["thig1.18:1.3","hitvā",0,0],["thig1.18:1.1","ghare",0,1],["thig1.18:1.1","hitvā puttaṃ pasuṃ piyaṃ",0,3],["thig1.18:1.3","hitvā rāgañca dosañcā",0,4],["thig1.18:1.3","avijjañca virājiyā",0,5]],"before":[{"para":266,"vripara":null,"title":"Saṅghātherīgāthāvaṇṇanā","lines":["Saṅghātherīgāthāvaṇṇanā"]},{"para":267,"vripara":null,"title":"Saṅghātherīgāthāvaṇṇanā","lines":["<b>Hitvā ghare pabbajitvā</b>ti saṅghāya theriyā gāthā.","Tassā vatthu dhīrātheriyā vatthusadisaṃ.","Gāthā pana – 18."]},{"para":269,"vripara":"18","title":"Saṅghātherīgāthāvaṇṇanā","lines":["“Hitvā ghare pabbajitvā, hitvā puttaṃ