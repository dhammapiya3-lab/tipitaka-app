{"suttaId":"thig1.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[56,60],"vripara":"11"},"segments":{"thig1.11:0.3":"Muttātherīgāthā","thig1.11:1.1":"“Sumuttā sādhumuttāmhi, tīhi khujjehi muttiyā;","thig1.11:1.3":"Udukkhalena musalena, patinā khujjakena ca;","thig1.11:1.5":"Muttāmhi jātimaraṇā, bhavanetti samūhatā”ti.","thig1.11:2.1":"… Muttā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":145,"to":145,"paras":[{"para":145,"vripara":null,"refs":["thig1.11:1"],"lines":["Tattha <b>sumuttā</b>ti suṭṭhu muttā.","<b>Sādhumuttāmhī</b>ti sādhu sammadeva muttā amhi.","Kuto pana sumuttā sādhumuttāti āha <b>“tīhi khujjehi muttiyā”</b>ti, tīhi vaṅkakehi parimuttiyāti attho.","Idāni tāni sarūpato dassentī <b>“udukkhalena musalena, patinā khujjakena cā”</b>ti āha.","Udukkhale hi dhaññaṃ pakkhipantiyā parivattentiyā musalena koṭṭentiyā ca piṭṭhi onāmetabbā hotīti khujjakaraṇahetutāya tadubhayaṃ “khujjan”ti vuttaṃ.","Sāmiko panassā khujjo eva.","Idāni yassā muttiyā nidassanavasena tīhi khujjehi mutti vuttā.","Tameva dassentī <b>“muttāmhi jātimaraṇā”</b>ti vatvā tattha kāraṇamāha <b>“bhavanetti samūhatā”</b>ti.","Tassattho – na kevalamahaṃ tīhi khujjehi eva muttā, atha kho sabbasmā jātimaraṇāpi, yasmā sabbassāpi bhavassa netti nāyikā taṇhā aggamaggena mayā samugghāṭitāti."],"lineRefs":[["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"]]}],"wordLinks":[["thig1.11:1.1","sumuttā",0,0],["thig1.11:1.1","sādhumuttāmhī",0,1],["thig1.11:1.1","tīhi khujjehi muttiyā",0,2],["thig1.11:1.3","udukkhalena musalena patinā khujjakena cā",0,3],["thig1.11:1.5","bhavanetti samūhatā",0,7],["thig1.11:1.5","muttāmhi jātimaraṇā",0,7]],"before":[{"para":109,"vripara":null,"refs":[],"lines":["Tissāditherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":110,"vripara":null,"refs":[],"lines":["Niṭṭhitā paṭhamavaggavaṇṇanā."],"lineRefs":[[]]},{"para":111,"vripara":null,"refs":[],"lines":["Muttātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":112,"vripara":null,"refs":[],"lines":["<b>Sumuttā sādhumuttāmhī</b>tiādikā muttātheriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave kusalaṃ upacinitvā imasmiṃ buddhuppāde kosalajanapade <b>oghātakassa</b> nāma daliddabrāhmaṇassa dhītā hutvā nibbatti, taṃ vayappattakāle mātāpitaro ekassa khujjabrāhmaṇassa adaṃsu.","Sā tena gharāvāsaṃ arocantī taṃ anujānāpetvā pabbajitvā vipassanāya kammaṃ karoti.","Tassā bahiddhārammaṇesu cittaṃ vidhāvati, sā taṃ niggaṇhantī “sumuttā sādhumuttāmhī”ti gāthaṃ vadantīyeva vipassanaṃ ussukkāpetvā saha paṭisambhidāhi arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> –"],"lineRefs":[[],[],[],[],[]]},{"para":113,"vripara":null,"refs":[],"lines":["“Padumuttaro nāma jino, sabbadhammesu cakkhumā;"],"lineRefs":[[]]},{"para":114,"vripara":null,"refs":[],"lines":["Pāṇine anugaṇhanto, piṇḍāya pāvisī puraṃ."],"lineRefs":[[]]},{"para":115,"vripara":null,"refs":[],"lines":["“Tassa āgacchato satthu, sabbe nagaravāsino;"],"lineRefs":[[]]},{"para":116,"vripara":null,"refs":[],"lines":["Haṭṭhatuṭṭhā samāgantvā, vālikā ākiriṃsu te."],"lineRefs":[[]]},{"para":117,"vripara":null,"refs":[],"lines":["“Vīthisammajjanaṃ katvā, kadalipuṇṇakaddhaje;"],"lineRefs":[[]]},{"para":118,"vripara":null,"refs":[],"lines":["Dhūmaṃ cuṇṇañca māsañca, sakkāraṃ kacca satthuno."],"lineRefs":[[]]},{"para":119,"vripara":null,"refs":[],"lines":["“Maṇḍapaṃ paṭiyādetvā, nimantetvā vināyakaṃ;"],"lineRefs":[[]]},{"para":120,"vripara":null,"refs":[],"lines":["Mahādānaṃ daditvāna, sambodhiṃ abhipatthayi."],"lineRefs":[[]]},{"para":121,"vripara":null,"refs":[],"lines":["“Padumuttaro mahāvīro, hārako sabbapāṇinaṃ;"],"lineRefs":[[]]},{"para":122,"vripara":null,"refs":[],"lines":["Anumodaniyaṃ katvā, byākāsi aggapuggalo."],"lineRefs":[[]]},{"para":123,"vripara":null,"refs":[],"lines":["“Satasahasse atikkante, kappo hessati bhaddako;"],"lineRefs":[[]]},{"para":124,"vripara":null,"refs":[],"lines":["Bhavābhave sukhaṃ laddhā, pāpuṇissasi bodhiyaṃ."],"lineRefs":[[]]},{"para":125,"vripara":null,"refs":[],"lines":["“Hatthakammañca ye keci, katāvī naranāriyo;"],"lineRefs":[[]]},{"para":126,"vripara":null,"refs":[],"lines":["Anāgatamhi addhāne, sabbā hessanti sammukhā."],"lineRefs":[[]]},{"para":127,"vripara":null,"refs":[],"lines":["“Tena kammavipākena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":128,"vripara":null,"refs":[],"lines":["Uppannadevabhavane, tuyhaṃ tā paricārikā."],"lineRefs":[[]]},{"para":129,"vripara":null,"refs":[],"lines":["“Dibbaṃ sukhamasaṅkhyeyyaṃ, mānusañca asaṅkhiyaṃ;"],"lineRefs":[[]]},{"para":130,"vripara":null,"refs":[],"lines":["Anubhonti ciraṃ kālaṃ, saṃsarimha bhavābhave."],"lineRefs":[[]]},{"para":131,"vripara":null,"refs":[],"lines":["“Satasahassito kappe, yaṃ kammamakariṃ tadā;"],"lineRefs":[[]]},{"para":132,"vripara":null,"refs":[],"lines":["Sukhumālā manussesu, atho devapuresu ca."],"lineRefs":[[]]},{"para":133,"vripara":null,"refs":[],"lines":["“Rūpaṃ bhogaṃ yasaṃ āyuṃ, atho kittisukhaṃ piyaṃ;"],"lineRefs":[[]]},{"para":134,"vripara":null,"refs":[],"lines":["Labhāmi satataṃ sabbaṃ, sukataṃ kammasampadaṃ."],"lineRefs":[[]]},{"para":135,"vripara":null,"refs":[],"lines":["“Pacchime bhave sampatte, jātāhaṃ brāhmaṇe kule;"],"lineRefs":[[]]},{"para":136,"vripara":null,"refs":[],"lines":["Sukhumālahatthapādā, ramaṇiye nivesane."],"lineRefs":[[]]},{"para":137,"vripara":null,"refs":[],"lines":["“Sabbakālampi pathavī, na passāmanalaṅkataṃ;"],"lineRefs":[[]]},{"para":138,"vripara":null,"refs":[],"lines":["Cikkhallabhūmiṃ asuciṃ, na passāmi kudācanaṃ."],"lineRefs":[[]]},{"para":139,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":140,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā udānentī –"],"lineRefs":[[]]},{"para":142,"vripara":"11","refs":[],"lines":["“Sumuttā sādhumuttāmhi, tīhi khujjehi muttiyā;"],"lineRefs":[[]]},{"para":143,"vripara":null,"refs":[],"lines":["Udukkhalena musalena, patinā khujjakena ca;"],"lineRefs":[[]]},{"para":144,"vripara":null,"refs":[],"lines":["Muttāmhi jātimaraṇā, bhavanetti samūhatā”ti.","– imaṃ gāthaṃ abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
