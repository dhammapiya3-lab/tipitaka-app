{"suttaId":"thig1.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[56,60],"vripara":"11"},"segments":{"thig1.11:0.3":"Muttātherīgāthā","thig1.11:1.1":"“Sumuttā sādhumuttāmhi,","thig1.11:1.2":"tīhi khujjehi muttiyā;","thig1.11:1.3":"Udukkhalena musalena,","thig1.11:1.4":"patinā khujjakena ca;","thig1.11:1.5":"Muttāmhi jātimaraṇā,","thig1.11:1.6":"bhavanetti samūhatā”ti.","thig1.11:2.1":"… Muttā therī …."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":145,"to":145,"paras":[{"para":145,"vripara":null,"refs":["thig1.11:1"],"lines":["Tattha <b>sumuttā</b>ti suṭṭhu muttā.","<b>Sādhumuttāmhī</b>ti sādhu sammadeva muttā amhi.","Kuto pana sumuttā sādhumuttāti āha <b>“tīhi khujjehi muttiyā”</b>ti, tīhi vaṅkakehi parimuttiyāti attho.","Idāni tāni sarūpato dassentī <b>“udukkhalena musalena, patinā khujjakena cā”</b>ti āha.","Udukkhale hi dhaññaṃ pakkhipantiyā parivattentiyā musalena koṭṭentiyā ca piṭṭhi onāmetabbā hotīti khujjakaraṇahetutāya tadubhayaṃ “khujjan”ti vuttaṃ.","Sāmiko panassā khujjo eva.","Idāni yassā muttiyā nidassanavasena tīhi khujjehi mutti vuttā.","Tameva dassentī <b>“muttāmhi jātimaraṇā”</b>ti vatvā tattha kāraṇamāha <b>“bhavanetti samūhatā”</b>ti.","Tassattho – na kevalamahaṃ tīhi khujjehi eva muttā, atha kho sabbasmā jātimaraṇāpi, yasmā sabbassāpi bhavassa netti nāyikā taṇhā aggamaggena mayā samugghāṭitāti."],"lineRefs":[["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"],["thig1.11:1"]]}],"wordLinks":[["thig1.11:1.1","sumuttā",0,0],["thig1.11:1.1","sādhumuttāmhī",0,1],["thig1.11:1.1","tīhi khujjehi muttiyā",0,2],["thig1.11:1.3","udukkhalena musalena patinā khujjakena cā",0,3],["thig1.11:1.5","bhavanetti samūhatā",0,7],["thig1.11:1.5","muttāmhi jātimaraṇā",0,7]],"before":[{"para":111,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Muttātherīgāthāvaṇṇanā"]},{"para":112,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["<b>Sumuttā sādhumuttāmhī</b>tiādikā muttātheriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave kusalaṃ upacinitvā imasmiṃ buddhuppāde kosalajanapade <b>oghātakassa</b> nāma daliddabrāhmaṇassa dhītā hutvā nibbatti, taṃ vayappattakāle mātāpitaro ekassa khujjabrāhmaṇassa adaṃsu.","Sā tena gharāvāsaṃ arocantī taṃ anujānāpetvā pabbajitvā vipassanāya kammaṃ karoti.","Tassā bahiddhārammaṇesu cittaṃ vidhāvati, sā taṃ niggaṇhantī “sumuttā sādhumuttāmhī”ti gāthaṃ vadantīyeva vipassanaṃ ussukkāpetvā saha paṭisambhidāhi arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> –"]},{"para":113,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Padumuttaro nāma jino, sabbadhammesu cakkhumā;"]},{"para":114,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Pāṇine anugaṇhanto, piṇḍāya pāvisī puraṃ."]},{"para":115,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Tassa āgacchato satthu, sabbe nagaravāsino;"]},{"para":116,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Haṭṭhatuṭṭhā samāgantvā, vālikā ākiriṃsu te."]},{"para":117,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Vīthisammajjanaṃ katvā, kadalipuṇṇakaddhaje;"]},{"para":118,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Dhūmaṃ cuṇṇañca māsañca, sakkāraṃ kacca satthuno."]},{"para":119,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Maṇḍapaṃ paṭiyādetvā, nimantetvā vināyakaṃ;"]},{"para":120,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Mahādānaṃ daditvāna, sambodhiṃ abhipatthayi."]},{"para":121,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Padumuttaro mahāvīro, hārako sabbapāṇinaṃ;"]},{"para":122,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Anumodaniyaṃ katvā, byākāsi aggapuggalo."]},{"para":123,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Satasahasse atikkante, kappo hessati bhaddako;"]},{"para":124,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Bhavābhave sukhaṃ laddhā, pāpuṇissasi bodhiyaṃ."]},{"para":125,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Hatthakammañca ye keci, katāvī naranāriyo;"]},{"para":126,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Anāgatamhi addhāne, sabbā hessanti sammukhā."]},{"para":127,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Tena kammavipākena, cetanāpaṇidhīhi ca;"]},{"para":128,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Uppannadevabhavane, tuyhaṃ tā paricārikā."]},{"para":129,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Dibbaṃ sukhamasaṅkhyeyyaṃ, mānusañca asaṅkhiyaṃ;"]},{"para":130,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Anubhonti ciraṃ kālaṃ, saṃsarimha bhavābhave."]},{"para":131,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Satasahassito kappe, yaṃ kammamakariṃ tadā;"]},{"para":132,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Sukhumālā manussesu, atho devapuresu ca."]},{"para":133,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Rūpaṃ bhogaṃ yasaṃ āyuṃ, atho kittisukhaṃ piyaṃ;"]},{"para":134,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Labhāmi satataṃ sabbaṃ, sukataṃ kammasampadaṃ."]},{"para":135,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Pacchime bhave sampatte, jātāhaṃ brāhmaṇe kule;"]},{"para":136,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Sukhumālahatthapādā, ramaṇiye nivesane."]},{"para":137,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Sabbakālampi pathavī, na passāmanalaṅkataṃ;"]},{"para":138,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Cikkhallabhūmiṃ asuciṃ, na passāmi kudācanaṃ."]},{"para":139,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."]},{"para":140,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Arahattaṃ pana patvā udānentī –"]},{"para":142,"vripara":"11","title":"Muttātherīgāthāvaṇṇanā","lines":["“Sumuttā sādhumuttāmhi, tīhi khujjehi muttiyā;"]},{"para":143,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Udukkhalena musalena, patinā khujjakena ca;"]},{"para":144,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Muttāmhi jātimaraṇā, bhavanetti samūhatā”ti.","– imaṃ gāthaṃ abhāsi;"]}],"after":[{"para":146,"vripara":null,"title":"Muttātherīgāthāvaṇṇanā","lines":["Muttātherīgāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
