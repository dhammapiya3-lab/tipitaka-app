{"suttaId":"an5.244","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1526,1526],"vripara":"244"},"segments":{"an5.244:0.3":"Paṭhamamanoduccaritasuttaṃ","an5.244:1.1":"“Pañcime, bhikkhave, ādīnavā manoduccarite…pe… ānisaṃsā manosucarite.","an5.244:1.2":"Katame pañca?","an5.244:1.3":"Attāpi attānaṃ na upavadati;","an5.244:1.4":"anuvicca viññū pasaṃsanti;","an5.244:1.5":"kalyāṇo kittisaddo abbhuggacchati;","an5.244:1.6":"asammūḷho kālaṃ karoti;","an5.244:1.7":"kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati.","an5.244:1.8":"Ime kho, bhikkhave, pañca ānisaṃsā manosucarite”ti.","an5.244:1.9":"Catutthaṃ. 5."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
