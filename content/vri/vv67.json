{"suttaId":"vv67","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2589,2612],"vripara":"1060"},"segments":{"vv67:0.4":"Phaladāyakavimānavatthu","vv67:1.1":"“Uccamidaṃ maṇithūṇaṃ vimānaṃ,","vv67:1.2":"samantato soḷasa yojanāni;","vv67:1.3":"Kūṭāgārā sattasatā uḷārā,","vv67:1.4":"veḷuriyathambhā rucakatthatā subhā. 1061.","vv67:2.1":"“Tatthacchasi pivasi khādasi ca,","vv67:2.2":"dibbā ca vīṇā pavadanti vagguṃ;","vv67:2.3":"Aṭṭhaṭṭhakā sikkhitā sādhurūpā,","vv67:2.4":"dibbā ca kaññā tidasacarā uḷārā;","vv67:2.5":"Naccanti gāyanti pamodayanti. 1062.","vv67:3.1":"“Deviddhipattosi mahānubhāvo,","vv67:3.2":"manussabhūto kimakāsi puññaṃ;","vv67:3.3":"Kenāsi evaṃ jalitānubhāvo,","vv67:3.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti. 1063.","vv67:4.1":"So devaputto attamano…pe…","vv67:4.3":"yassa kammassidaṃ phalaṃ. 1064.","vv67:5.1":"“Phaladāyī phalaṃ vipulaṃ labhati,","vv67:5.2":"dadamujugatesu pasannamānaso;","vv67:5.3":"So hi pamodati [modati (sī. syā. pī.)] saggagato tidive [tattha (ka.)],","vv67:5.4":"anubhoti ca puññaphalaṃ vipulaṃ. 1065.","vv67:6.1":"“Tavevāhaṃ [tathevāhaṃ (sī. syā. pī.)] mahāmuni,","vv67:6.2":"adāsiṃ caturo phale. 1066.","vv67:7.1":"“Tasmā hi phalaṃ alameva dātuṃ,","vv67:7.2":"niccaṃ manussena sukhatthikena;","vv67:7.3":"Dibbāni vā patthayatā sukhāni,","vv67:7.4":"manussasobhaggatamicchatā vā. 1067.","vv67:8.1":"“Tena metādiso vaṇṇo…pe…","vv67:8.3":"Vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv67:9.1":"Phaladāyakavimānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3122,"to":3124,"paras":[{"para":3122,"vripara":"1061","refs":["vv67:2"],"lines":["Tattha <b>aṭṭhaṭṭhakā</b>ti ekekasmiṃ kūṭāgāre aṭṭhaṭṭhakā catusaṭṭhiparimāṇā.","<b>Sādhurūpā</b>ti rūpasampattiyā ca sīlācārasampattiyā ca sikkhāsampattiyā ca sundarasabhāvā.","<b>Dibbā ca kaññā</b>ti devaccharāyo.","<b>Tidasacarā</b>ti tidasesu sukhācārā sukhavihāriniyo.","<b>Uḷārā</b>ti uḷāravibhavā. 1064."],"lineRefs":[["vv67:2"],["vv67:2"],["vv67:2"],["vv67:2"],["vv67:2"]]},{"para":3123,"vripara":"1064","refs":["vv67:5"],"lines":["<b>Phaladāyī</b>ti attanā ambaphalassa dinnattā attānaṃ sandhāya vadati.","<b>Phala</b>nti puññaphalaṃ.","<b>Vipula</b>nti mahantaṃ labhati manussaloke patiṭṭhitoti adhippāyo.","<b>Dada</b>nti dadanto dānahetu.","<b>Ujugatesū</b>ti ujupaṭipannesu.","<b>Saggagato</b>ti uppajjanavasena saggaṃ gato, tatthāpi <b>tidive</b> tāvatiṃsabhavane <b>anubhoti ca puññaphalaṃ vipulaṃ</b> yathāhaṃ, evaṃ aññopīti attho. 1066."],"lineRefs":[["vv67:5"],["vv67:5"],["vv67:5"],["vv67:5"],["vv67:5"],["vv67:5"]]},{"para":3124,"vripara":"1066","refs":["vv67:7"],"lines":["<b>Tasmā</b>ti yasmā catunnaṃ phalānaṃ dānamattena īdisī sampatti adhigatā, tasmā.","<b>Alameva</b> yuttameva.","<b>Nicca</b>nti sabbakālaṃ.","<b>Dibbānī</b>ti devalokapariyāpannāni.","<b>Manussasobhaggata</b>nti manussesu subhagabhāvaṃ.","Sesaṃ vuttanayameva."],"lineRefs":[["vv67:7"],["vv67:7"],["vv67:7"],["vv67:7"],["vv67:7"],["vv67:7"]]}],"wordLinks":[["vv67:2.3","aṭṭhaṭṭhakā",0,0],["vv67:2.3","sādhurūpā",0,1],["vv67:2.3","dibbā ca kaññā",0,2],["vv67:2.3","tidasacarā",0,3],["vv67:2.3","uḷārā",0,4],["vv67:5.1","phaladāyī",1,0],["vv67:5.1","phalaṃ",1,1],["vv67:5.3","phalaṃ",1,1],["vv67:5.1","vipulaṃ",1,2],["vv67:5.3","vipulaṃ",1,2],["vv67:5.1","dadaṃ",1,3],["vv67:5.1","ujugatesū",1,4],["vv67:5.3","anubhoti ca puññaphalaṃ vipulaṃ",1,5],["vv67:5.3","saggagato",1,5],["vv67:5.3","tidive",1,5],["vv67:7.1","tasmā",2,0],["vv67:7.1","alameva",2,1],["vv67:7.1","niccaṃ",2,2],["vv67:7.3","dibbānī",2,3],["vv67:7.3","manussasobhaggataṃ",2,4]],"after":[{"para":3125,"vripara":null,"title":"Phaladāyakavimānavaṇṇanā","lines":["Phaladāyakavimānavaṇṇanā niṭṭhitā. 4."]}]},"tika":null,"tika2":null}
