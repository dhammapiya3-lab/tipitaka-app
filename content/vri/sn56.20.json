{"suttaId":"sn56.20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[2526,2531],"vripara":"1090"},"segments":{"sn56.20:0.3":"Tathasuttaṃ","sn56.20:1.1":"“Cattārimāni, bhikkhave, tathāni avitathāni anaññathāni.","sn56.20:1.2":"Katamāni cattāri?","sn56.20:1.3":"‘Idaṃ dukkha’nti, bhikkhave, tathametaṃ avitathametaṃ anaññathametaṃ;","sn56.20:1.4":"‘ayaṃ dukkhasamudayo’ti tathametaṃ avitathametaṃ anaññathametaṃ;","sn56.20:1.5":"‘ayaṃ dukkhanirodho’ti tathametaṃ avitathametaṃ anaññathametaṃ;","sn56.20:1.6":"‘ayaṃ dukkhanirodhagāminī paṭipadā’ti tathametaṃ avitathametaṃ anaññathametaṃ –","sn56.20:1.7":"imāni kho, bhikkhave, cattāri tathāni avitathāni anaññathāni.","sn56.20:2.1":"“Tasmātiha, bhikkhave, ‘idaṃ dukkha’nti yogo karaṇīyo…pe… ‘ayaṃ dukkhanirodhagāminī paṭipadā’ti yogo karaṇīyo”ti.","sn56.20:2.2":"Dasamaṃ.","sn56.20:2.3":"Dhammacakkappavattanavaggo dutiyo.","sn56.20:3.0":"Tassuddānaṃ –","sn56.20:3.1":"Dhammacakkaṃ tathāgataṃ,","sn56.20:3.2":"khandhā āyatanena ca;","sn56.20:3.3":"Dhāraṇā ca dve avijjā,","sn56.20:3.4":"vijjā saṅkāsanā tathāti. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":893,"to":893,"paras":[{"para":893,"vripara":"1090","refs":["sn56.20:1"],"lines":["Dasame sabhāvāvijahanaṭṭhena <b>tathaṃ</b>.","Dukkhañhi dukkhameva vuttaṃ.","Sabhāvassa amoghatāya <b>avitathaṃ</b>.","Na hi dukkhaṃ adukkhaṃ nāma hoti.","Aññabhāvānupagamena <b>anaññathaṃ</b>.","Na hi dukkhaṃ samudayādibhāvaṃ upagacchati.","<b>Samudayādīsu</b>pi eseva nayoti."],"lineRefs":[["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"]]}],"wordLinks":[["sn56.20:1.3","tathaṃ",0,0],["sn56.20:1.4","tathaṃ",0,0],["sn56.20:1.5","tathaṃ",0,0],["sn56.20:1.6","tathaṃ",0,0],["sn56.20:1.3","avitathaṃ",0,2],["sn56.20:1.4","avitathaṃ",0,2],["sn56.20:1.5","avitathaṃ",0,2],["sn56.20:1.6","avitathaṃ",0,2],["sn56.20:1.3","anaññathaṃ",0,4],["sn56.20:1.4","anaññathaṃ",0,4],["sn56.20:1.5","anaññathaṃ",0,4],["sn56.20:1.6","anaññathaṃ",0,4],["sn56.20:1.4","samudayādīsu",0,6]],"before":[{"para":892,"vripara":null,"title":"Tathasuttavaṇṇanā","lines":["Tathasuttavaṇṇanā 1090."]}],"after":[{"para":894,"vripara":null,"title":"Tathasuttavaṇṇanā","lines":["Dhammacakkappavattanavaggo dutiyo. 3."]}]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":772,"to":772,"paras":[{"para":772,"vripara":"1090","refs":["sn56.20:1"],"lines":["<b>Sabhāvāvijahanaṭṭhenā</b>ti attano dukkhasabhāvassa kadācipi apariccajanena tathasabhāvaṃ.","Tenāha <b>“dukkhañhi dukkhameva vutta”</b>nti.","<b>Sabhāvassā</b>ti dukkhasabhāvassa.","<b>Amoghatāyā</b>ti avañjhatāya.","<b>Avitatha</b>nti na vitathaṃ.","Tenāha <b>“na hi dukkhaṃ adukkhaṃ nāma hotī”</b>ti.","<b>Aññabhāvānupagamenā</b>ti samudayādisabhāvānupagamanena musā na hotīti añño aññathā na hotīti <b>anaññathaṃ</b>.","Tenāha <b>“na hī”</b>tiādi."],"lineRefs":[["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"]]}],"wordLinks":[["sn56.20:1.3","avitathaṃ",0,4],["sn56.20:1.4","avitathaṃ",0,4],["sn56.20:1.5","avitathaṃ",0,4],["sn56.20:1.6","avitathaṃ",0,4],["sn56.20:1.3","anaññathaṃ",0,6],["sn56.20:1.4","anaññathaṃ",0,6],["sn56.20:1.5","anaññathaṃ",0,6],["sn56.20:1.6","anaññathaṃ",0,6]],"before":[{"para":771,"vripara":null,"title":"Tathasuttavaṇṇanā","lines":["Tathasuttavaṇṇanā 1090."]}],"after":[{"para":773,"vripara":null,"title":"Tathasuttavaṇṇanā","lines":["Dhammacakkappavattanavaggavaṇṇanā niṭṭhitā. 3."]}]},"tika2":null}
