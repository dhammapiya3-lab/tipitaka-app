{"suttaId":"sn56.20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[2526,2531],"vripara":"1090"},"segments":{"sn56.20:0.3":"Tathasuttaṃ","sn56.20:1.1":"“Cattārimāni, bhikkhave, tathāni avitathāni anaññathāni.","sn56.20:1.2":"Katamāni cattāri?","sn56.20:1.3":"‘Idaṃ dukkhan’ti, bhikkhave, tathametaṃ avitathametaṃ anaññathametaṃ;","sn56.20:1.4":"‘ayaṃ dukkhasamudayo’ti tathametaṃ avitathametaṃ anaññathametaṃ;","sn56.20:1.5":"‘ayaṃ dukkhanirodho’ti tathametaṃ avitathametaṃ anaññathametaṃ;","sn56.20:1.6":"‘ayaṃ dukkhanirodhagāminī paṭipadā’ti tathametaṃ avitathametaṃ anaññathametaṃ – imāni kho, bhikkhave, cattāri tathāni avitathāni anaññathāni.","sn56.20:2.1":"“Tasmātiha, bhikkhave,‘idaṃ dukkhan’ti yogo karaṇīyo … pe …‘ayaṃ dukkhanirodhagāminī paṭipadā’ti yogo karaṇīyo”ti.","sn56.20:2.2":"Dasamaṃ.","sn56.20:2.3":"Dhammacakkappavattanavaggo dutiyo.","sn56.20:3.0":"Tassuddānaṃ –","sn56.20:3.1":"Dhammacakkaṃ tathāgataṃ, khandhā āyatanena ca;","sn56.20:3.3":"Dhāraṇā ca dve avijjā, vijjā saṅkāsanā tathāti."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":893,"to":893,"paras":[{"para":893,"vripara":"1090","refs":["sn56.20:1"],"words":["tathaṃ","avitathaṃ","anaññathaṃ","samudayādīsu"],"lines":["Dasame sabhāvāvijahanaṭṭhena <b>tathaṃ</b>.","Dukkhañhi dukkhameva vuttaṃ.","Sabhāvassa amoghatāya <b>avitathaṃ</b>.","Na hi dukkhaṃ adukkhaṃ nāma hoti.","Aññabhāvānupagamena <b>anaññathaṃ</b>.","Na hi dukkhaṃ samudayādibhāvaṃ upagacchati.","<b>Samudayādīsu</b> pi eseva nayoti."],"lineRefs":[["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"]]}]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":772,"to":772,"paras":[{"para":772,"vripara":"1090","refs":["sn56.20:1"],"words":["avitathaṃ","anaññathaṃ"],"lines":["<b>Sabhāvāvijahanaṭṭhenā</b>ti attano dukkhasabhāvassa kadācipi apariccajanena tathasabhāvaṃ.","Tenāha <b>“dukkhañhi dukkhameva vuttan”</b>ti.","<b>Sabhāvassā</b>ti dukkhasabhāvassa.","<b>Amoghatāyā</b>ti avañjhatāya.","<b>Avitathan</b>ti na vitathaṃ.","Tenāha <b>“na hi dukkhaṃ adukkhaṃ nāma hotī”</b>ti.","<b>Aññabhāvānupagamenā</b>ti samudayādisabhāvānupagamanena musā na hotīti añño aññathā na hotīti <b>anaññathaṃ</b>.","Tenāha <b>“na hī”</b>tiādi."],"lineRefs":[["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"],["sn56.20:1"]]}]}}
