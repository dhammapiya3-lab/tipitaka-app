{"suttaId":"an6.116","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[834,838],"vripara":"116"},"segments":{"an6.116:0.3":"Uddhaccasuttaṃ","an6.116:1.1":"“Tayome, bhikkhave, dhammā.","an6.116:1.2":"Katame tayo?","an6.116:1.3":"Uddhaccaṃ, asaṃvaro, pamādo.","an6.116:1.4":"Ime kho, bhikkhave, tayo dhammā.","an6.116:1.5":"Imesaṃ kho, bhikkhave, tiṇṇaṃ dhammānaṃ pahānāya tayo dhammā bhāvetabbā.","an6.116:1.6":"Katame tayo?","an6.116:1.7":"Uddhaccassa pahānāya samatho bhāvetabbo, asaṃvarassa pahānāya saṃvaro bhāvetabbo, pamādassa pahānāya appamādo bhāvetabbo.","an6.116:1.8":"Imesaṃ kho, bhikkhave, tiṇṇaṃ dhammānaṃ pahānāya ime tayo dhammā bhāvetabbā”ti.","an6.116:1.9":"Dasamaṃ.","an6.116:1.10":"Tikavaggo ekādasamo.[paṭhamo (syā.)]","an6.116:2.0":"Tassuddānaṃ –","an6.116:2.1":"Rāgaduccaritavitakka, saññā dhātūti vuccati;","an6.116:2.3":"Assādaaratituṭṭhi, duve ca uddhaccena vaggoti."},"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":782,"to":782,"paras":[{"para":782,"vripara":"116","refs":["an6.116:1"],"lines":["Dasame <b>asaṃvaro</b>ti anadhivāsakabhāvo.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["an6.116:1"],["an6.116:1"]]}],"wordLinks":[["an6.116:1.3","asaṃvaro",0,0],["an6.116:1.7","asaṃvaro",0,0]]},"tika":null}
