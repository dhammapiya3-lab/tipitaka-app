{"suttaId":"sn25.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1144,1144],"vripara":"304"},"segments":{"sn25.3:0.3":"Viññāṇasuttaṃ","sn25.3:1.1":"Sāvatthinidānaṃ.","sn25.3:1.2":"“Cakkhuviññāṇaṃ, bhikkhave, aniccaṃ vipariṇāmi aññathābhāvi;","sn25.3:1.3":"sotaviññāṇaṃ … ghānaviññāṇaṃ … jivhāviññāṇaṃ … kāyaviññāṇaṃ … manoviññāṇaṃ aniccaṃ vipariṇāmi aññathābhāvi.","sn25.3:1.8":"Yo bhikkhave … pe … sambodhiparāyano”ti.","sn25.3:1.10":"Tatiyaṃ."},"attha":null,"tika":null}
