{"suttaId":"sn22.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[102,102],"vripara":"10"},"segments":{"sn22.10:0.3":"Kālattayadukkhasuttaṃ","sn22.10:1.1":"Sāvatthinidānaṃ.","sn22.10:1.2":"“Rūpaṃ, bhikkhave, dukkhaṃ atītānāgataṃ;","sn22.10:1.3":"ko pana vādo paccuppannassa!","sn22.10:1.4":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītasmiṃ rūpasmiṃ anapekkho hoti;","sn22.10:1.5":"anāgataṃ rūpaṃ nābhinandati;","sn22.10:1.6":"paccuppannassa rūpassa nibbidāya virāgāya nirodhāya paṭipanno hoti.","sn22.10:1.7":"Vedanā dukkhā …","sn22.10:1.8":"saññā dukkhā …","sn22.10:1.9":"saṅkhārā dukkhā …","sn22.10:1.10":"viññāṇaṃ dukkhaṃ atītānāgataṃ;","sn22.10:1.11":"ko pana vādo paccuppannassa!","sn22.10:1.12":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītasmiṃ viññāṇasmiṃ anapekkho hoti;","sn22.10:1.13":"anāgataṃ viññāṇaṃ nābhinandati;","sn22.10:1.14":"paccuppannassa viññāṇassa nibbidāya virāgāya nirodhāya paṭipanno hotī”ti.","sn22.10:1.15":"Dasamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":66,"to":69,"paras":[{"para":66,"vripara":"10-11","refs":["sn22.10:1"],"lines":["10-11. Dasamekādasamāni <b>dukkhaṃ anattā</b>ti padehi visesetvā tathārūpeneva puggalajjhāsayena kathitānīti.","Dasamekādasamāni."],"lineRefs":[["sn22.10:1"],["sn22.10:1"]]},{"para":67,"vripara":null,"refs":["sn22.10:1"],"lines":["Nakulapituvaggo paṭhamo."],"lineRefs":[["sn22.10:1"]]},{"para":68,"vripara":null,"refs":["sn22.10:1"],"lines":["Aniccavaggo"],"lineRefs":[["sn22.10:1"]]},{"para":69,"vripara":null,"refs":["sn22.10:1"],"lines":["1-10. Aniccasuttādivaṇṇanā"],"lineRefs":[["sn22.10:1"]]}],"wordLinks":[],"before":[{"para":65,"vripara":null,"title":"Kālattayadukkhasuttādivaṇṇanā","lines":["10-11. Kālattayadukkhasuttādivaṇṇanā"]}]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":61,"to":65,"paras":[{"para":61,"vripara":"10-11","refs":["sn22.10:1"],"lines":["10-11. <b>Tathārūpenevā</b>ti yathārūpeneva puggalajjhāsayena navamaṃ suttaṃ kathitaṃ, tathārūpenevāti.","Te kira bhikkhū atītānāgataṃ “dukkhan”ti sallakkhetvā, tathā “anattā”ti sallakkhetvā paccuppanne kilamiṃsu.","“Atha nesan”tiādi sabbaṃ heṭṭhā vuttanayena vattabbaṃ."],"lineRefs":[["sn22.10:1"],["sn22.10:1"],["sn22.10:1"]]},{"para":62,"vripara":null,"refs":["sn22.10:1"],"lines":["Kālattayadukkhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.10:1"]]},{"para":63,"vripara":null,"refs":["sn22.10:1"],"lines":["Nakulapituvaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.10:1"]]},{"para":64,"vripara":null,"refs":["sn22.10:1"],"lines":["Aniccavaggo"],"lineRefs":[["sn22.10:1"]]},{"para":65,"vripara":null,"refs":["sn22.10:1"],"lines":["1-10. Aniccādisuttavaṇṇanā"],"lineRefs":[["sn22.10:1"]]}],"wordLinks":[],"before":[{"para":60,"vripara":null,"title":"Kālattayadukkhasuttādivaṇṇanā","lines":["10-11. Kālattayadukkhasuttādivaṇṇanā"]}]},"tika2":null}
