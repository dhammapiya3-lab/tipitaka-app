{"suttaId":"pv51","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[2618,2655],"vripara":"806"},"segments":{"pv51:0.3":"Saṭṭhikūṭapetavatthu","pv51:1.1":"“Kiṃ nu ummattarūpova, migo bhantova dhāvasi;","pv51:1.3":"Nissaṃsayaṃ pāpakammanto [pāpakammaṃ (syā. pī.)], kiṃ nu saddāyase tuvan”ti.","pv51:2.1":"“Ahaṃ bhadante petomhi, duggato yamalokiko;","pv51:2.3":"Pāpakammaṃ karitvāna, petalokaṃ ito gato.","pv51:3.1":"“Saṭṭhi kūṭasahassāni, paripuṇṇāni sabbaso;","pv51:3.3":"Sīse mayhaṃ nipatanti, te bhindanti ca matthakan”ti.","pv51:4.1":"“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;","pv51:4.3":"Kissa kammavipākena, idaṃ dukkhaṃ nigacchasi.","pv51:5.1":"“Saṭṭhi kūṭasahassāni, paripuṇṇāni sabbaso;","pv51:5.3":"Sīse tuyhaṃ nipatanti, te bhindanti ca matthakan”ti.","pv51:6.1":"“Athaddasāsiṃ sambuddhaṃ, sunettaṃ bhāvitindriyaṃ;","pv51:6.3":"Nisinnaṃ rukkhamūlasmiṃ, jhāyantaṃ akutobhayaṃ.","pv51:7.1":"“Sālittakappahārena, bhindissaṃ tassa matthakaṃ;","pv51:7.3":"Tassa kammavipākena, idaṃ dukkhaṃ nigacchisaṃ.","pv51:8.1":"“Saṭṭhi kūṭasahassāni, paripuṇṇāni sabbaso;","pv51:8.3":"Sīse mayhaṃ nipatanti, te bhindanti ca [nipatanti, vo bhindanteva (sī. dhammapadaṭṭhakathā)] matthakan”ti.","pv51:9.1":"“Dhammena te kāpurisa, saṭṭhikūṭasahassāni, paripuṇṇāni sabbaso;","pv51:9.4":"Sīse tuyhaṃ nipatanti, te bhindanti ca matthakan”ti.","pv51:10.1":"Saṭṭhikūṭapetavatthu soḷasamaṃ.","pv51:11.1":"Mahāvaggo catuttho niṭṭhito.","pv51:12.1":"Tassuddānaṃ –","pv51:13.1":"Ambasakkaro serīsako, piṅgalo revati ucchu;","pv51:13.3":"Dve kumārā duve gūthā, gaṇapāṭaliambavanaṃ.","pv51:14.1":"Akkharukkhabhogasaṃharā, seṭṭhiputtasaṭṭhikūṭā;","pv51:14.3":"Iti soḷasavatthūni, vaggo tena pavuccati.","pv51:15.1":"Atha vagguddānaṃ –","pv51:16.1":"Urago uparivaggo, cūḷamahāti catudhā;","pv51:16.3":"Vatthūni ekapaññāsaṃ, catudhā bhāṇavārato.","pv51:17.1":"Petavatthupāḷi niṭṭhitā."},"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":3171,"to":3206,"paras":[{"para":3171,"vripara":null,"refs":["pv51:1"],"words":["ummattarūpovā","migo bhantova dhāvasī","kiṃ nu saddāyase tuvaṃ"],"lines":["Imāya gāthāya paṭipucchi.","Tattha <b>ummattarūpovā</b>ti ummattakasabhāvo viya ummādappatto viya.","<b>Migo bhantova dhāvasī</b>ti bhantamigo viya ito cito ca dhāvasi.","So hi tesu ayokūṭesu nipatantesu parittāṇaṃ apassanto “na siyā nu kho evaṃ pahāro”ti itopi ettopi palāyati.","Te pana kammavegukkhittā yattha katthaci ṭhitassa matthakeyeva nipatanti.","<b>Kiṃ nu saddāyase tuvan</b>ti kiṃ nu kho tuvaṃ saddaṃ karosi, ativiya vissaraṃ karonto vicarasi."],"lineRefs":[["pv51:1"],["pv51:1"],["pv51:1"],["pv51:1"],["pv51:1"],["pv51:1"]]},{"para":3172,"vripara":null,"refs":[],"words":[],"lines":["Taṃ sutvā peto –"],"lineRefs":[[]]},{"para":3174,"vripara":"807","refs":[],"words":[],"lines":["“Ahaṃ bhadante petomhi, duggato yamalokiko;"],"lineRefs":[[]]},{"para":3175,"vripara":null,"refs":[],"words":[],"lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gato."],"lineRefs":[[]]},{"para":3177,"vripara":"808","refs":[],"words":[],"lines":["“Saṭṭhi kūṭasahassāni, paripuṇṇāni sabbaso;"],"lineRefs":[[]]},{"para":3178,"vripara":null,"refs":[],"words":[],"lines":["Sīse mayhaṃ nipatanti, te bhindanti ca matthakan”ti.","–"],"lineRefs":[[],[]]},{"para":3179,"vripara":null,"refs":["pv51:3"],"words":["saṭṭhi kūṭasahassānī","paripuṇṇānī","sabbaso"],"lines":["Dvīhi gāthāhi paṭivacanaṃ adāsi.","Tattha <b>saṭṭhi kūṭasahassānī</b>ti saṭṭhimattāni ayokūṭasahassāni.","<b>Paripuṇṇānī</b>ti anūnāni.","<b>Sabbaso</b>ti sabbabhāgato.","Tassa kira saṭṭhiyā ayokūṭasahassānaṃ patanappahonakaṃ mahantaṃ pabbatakūṭappamāṇaṃ sīsaṃ nibbatti.","Taṃ tassa vālaggakoṭinitudanamattampi ṭhānaṃ asesetvā tāni kūṭāni patantāni matthakaṃ bhindanti, tena so aṭṭassaraṃ karoti.","Tena vuttaṃ <b>“sabbaso sīse mayhaṃ nipatanti, te bhindanti ca matthakan”</b>ti."],"lineRefs":[["pv51:3"],["pv51:3"],["pv51:3"],["pv51:3"],["pv51:3"],["pv51:3"],["pv51:3"]]},{"para":3180,"vripara":null,"refs":[],"words":[],"lines":["Atha naṃ thero katakammaṃ pucchanto –"],"lineRefs":[[]]},{"para":3182,"vripara":"809","refs":[],"words":[],"lines":["“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;"],"lineRefs":[[]]},{"para":3183,"vripara":null,"refs":[],"words":[],"lines":["Kissa kammavipākena, idaṃ dukkhaṃ nigacchasi."],"lineRefs":[[]]},{"para":3185,"vripara":"810","refs":[],"words":[],"lines":["“Saṭṭhi kūṭasahassāni, paripuṇṇāni sabbaso;"],"lineRefs":[[]]},{"para":3186,"vripara":null,"refs":[],"words":[],"lines":["Sīse tuyhaṃ nipatanti, te bhindanti ca matthakan”ti.","–"],"lineRefs":[[],[]]},{"para":3187,"vripara":null,"refs":[],"words":[],"lines":["Dve gāthā abhāsi."],"lineRefs":[[]]},{"para":3188,"vripara":null,"refs":[],"words":[],"lines":["Tassa peto attanā katakammaṃ ācikkhanto –"],"lineRefs":[[]]},{"para":3190,"vripara":"811","refs":[],"words":[],"lines":["“Athaddasāsiṃ sambuddhaṃ, sunettaṃ bhāvitindriyaṃ;"],"lineRefs":[[]]},{"para":3191,"vripara":null,"refs":[],"words":[],"lines":["Nisinnaṃ rukkhamūlasmiṃ, jhāyantaṃ akutobhayaṃ."],"lineRefs":[[]]},{"para":3193,"vripara":"812","refs":[],"words":[],"lines":["“Sālittakappahārena, bhindissaṃ tassa matthakaṃ;"],"lineRefs":[[]]},{"para":3194,"vripara":null,"refs":[],"words":[],"lines":["Tassakammavipākena, idaṃ dukkhaṃ nigacchisaṃ."],"lineRefs":[[]]},{"para":3196,"vripara":"813","refs":[],"words":[],"lines":["“Saṭṭhi kūṭasahassāni, paripuṇṇāni sabbaso;"],"lineRefs":[[]]},{"para":3197,"vripara":null,"refs":[],"words":[],"lines":["Sīse mayhaṃ nipatanti, te bhindanti ca matthakan”ti.","–"],"lineRefs":[[],[]]},{"para":3198,"vripara":null,"refs":[],"words":[],"lines":["Tisso gāthāyo abhāsi."],"lineRefs":[[]]},{"para":3199,"vripara":"811","refs":["pv51:6"],"words":["sambuddhaṃ","sunettaṃ","bhāvitindriyaṃ"],"lines":["Tattha <b>sambuddhan</b>ti paccekasambuddhaṃ.","<b>Sunettan</b>ti evaṃnāmakaṃ.","<b>Bhāvitindriyan</b>ti ariyamaggabhāvanāya bhāvitasaddhādiindriyaṃ."],"lineRefs":[["pv51:6"],["pv51:6"],["pv51:6"]]},{"para":3200,"vripara":"812-813","refs":["pv51:7"],"words":["sālittakappahārenā","bhindissaṃ"],"lines":["812-13. <b>Sālittakappahārenā</b>ti sālittakaṃ vuccati dhanukena, aṅgulīhi eva vā sakkharakhipanapayogo.","Tathā hi sakkharāya pahārenāti vā pāṭho.","<b>Bhindissan</b>ti bhindiṃ."],"lineRefs":[["pv51:7"],["pv51:7"],["pv51:7"]]},{"para":3201,"vripara":null,"refs":[],"words":[],"lines":["Taṃ sutvā thero “attano katakammānurūpameva idāni purāṇakammassa idaṃ phalaṃ paṭilabhatī”ti dassento –"],"lineRefs":[[]]},{"para":3203,"vripara":"814","refs":[],"words":[],"lines":["“Dhammena te kāpurisa;"],"lineRefs":[[]]},{"para":3204,"vripara":null,"refs":[],"words":[],"lines":["Saṭṭhi kūṭasahassāni, paripuṇṇāni sabbaso;"],"lineRefs":[[]]},{"para":3205,"vripara":null,"refs":[],"words":[],"lines":["Sīse tuyhaṃ nipatanti, te bhindanti ca matthakan”ti.","–"],"lineRefs":[[],[]]},{"para":3206,"vripara":null,"refs":["pv51:9","pv51:14"],"words":["dhammenā","te"],"lines":["Osānagāthamāha.","Tattha <b>dhammenā</b>ti anurūpakāraṇena.","<b>Te</b>ti tava, tasmiṃ paccekabuddhe aparajjhantena tayā katassa pāpakammassa anucchavikamevetaṃ phalaṃ tuyhaṃ upanītaṃ.","Tasmā kenaci devena vā mārena vā brahmunā vā api sammāsambuddhenapi appaṭibāhanīyametanti dasseti."],"lineRefs":[["pv51:9"],["pv51:9"],["pv51:9"],["pv51:9"]]}]},"tika":null}
