{"suttaId":"tha-ap82","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4658,4744],"vripara":"48"},"segments":{"tha-ap82:0.3":"Tipadumiyattheraapadānaṃ","tha-ap82:1.1":"“Padumuttaro nāma jino,","tha-ap82:1.2":"sabbadhammāna pāragū;","tha-ap82:1.3":"Danto dantaparivuto,","tha-ap82:1.4":"nagarā nikkhamī tadā. 49.","tha-ap82:2.1":"“Nagare haṃsavatiyaṃ,","tha-ap82:2.2":"ahosiṃ māliko tadā;","tha-ap82:2.3":"Yaṃ tattha uttamaṃ toṇi, padmapupphāni [uttamaṃ pupphaṃ, tīṇi pupphāni (sī.)] aggahiṃ. 50.","tha-ap82:3.1":"“Addasaṃ virajaṃ buddhaṃ,","tha-ap82:3.2":"paṭimaggantarāpaṇe;","tha-ap82:3.3":"Saha [sohaṃ (sī.)] disvāna sambuddhaṃ,","tha-ap82:3.4":"evaṃ cintesahaṃ tadā. 51.","tha-ap82:4.1":"“Kiṃ me imehi pupphehi,","tha-ap82:4.2":"rañño upanitehi me;","tha-ap82:4.3":"Gāmaṃ vā gāmakhettaṃ vā,","tha-ap82:4.4":"sahassaṃ vā labheyyahaṃ. 52.","tha-ap82:5.1":"“Adantadamanaṃ vīraṃ,","tha-ap82:5.2":"sabbasattasukhāvahaṃ;","tha-ap82:5.3":"Lokanāthaṃ pūjayitvā,","tha-ap82:5.4":"lacchāmi amataṃ dhanaṃ. 53.","tha-ap82:6.1":"“Evāhaṃ cintayitvāna,","tha-ap82:6.2":"sakaṃ cittaṃ pasādayiṃ;","tha-ap82:6.3":"Tīṇi lohitake gayha,","tha-ap82:6.4":"ākāse ukkhipiṃ tadā. 54.","tha-ap82:7.1":"“Mayā ukkhittamattamhi,","tha-ap82:7.2":"ākāse patthariṃsu te;","tha-ap82:7.3":"Dhāriṃsu matthake tattha,","tha-ap82:7.4":"uddhaṃvaṇṭā adhomukhā. 55.","tha-ap82:8.1":"“Ye keci manujā disvā,","tha-ap82:8.2":"ukkuṭṭhiṃ sampavattayuṃ;","tha-ap82:8.3":"Devatā antalikkhamhi,","tha-ap82:8.4":"sādhukāraṃ pavattayuṃ. 56.","tha-ap82:9.1":"“Accheraṃ loke uppannaṃ,","tha-ap82:9.2":"buddhaseṭṭhassa vāhasā;","tha-ap82:9.3":"Sabbe dhammaṃ suṇissāma,","tha-ap82:9.4":"pupphānaṃ vāhasā mayaṃ. 57.","tha-ap82:10.1":"“Padumuttaro lokavidū,","tha-ap82:10.2":"āhutīnaṃ paṭiggaho;","tha-ap82:10.3":"Vīthiyañhi ṭhito santo,","tha-ap82:10.4":"imā gāthā abhāsatha. 58.","tha-ap82:11.1":"“‘Yo so buddhaṃ apūjesi,","tha-ap82:11.2":"rattapadmehi [rattapadumehi (sī. syā.)] māṇavo;","tha-ap82:11.3":"Tamahaṃ kittayissāmi,","tha-ap82:11.4":"suṇātha mama bhāsato. 59.","tha-ap82:12.1":"“‘Tiṃsakappasahassāni,","tha-ap82:12.2":"devaloke ramissati;","tha-ap82:12.3":"Tiṃsakappāni [tiṃsakkhattuñca (syā.)] devindo,","tha-ap82:12.4":"devarajjaṃ karissati. 60.","tha-ap82:13.1":"“‘Mahāvitthārikaṃ nāma,","tha-ap82:13.2":"byamhaṃ hessati tāvade;","tha-ap82:13.3":"Tiyojanasatubbiddhaṃ,","tha-ap82:13.4":"diyaḍḍhasatavitthataṃ. 61.","tha-ap82:14.1":"“‘Cattārisatasahassāni,","tha-ap82:14.2":"niyyūhā ca sumāpitā;","tha-ap82:14.3":"Kūṭāgāravarūpetā,","tha-ap82:14.4":"mahāsayanamaṇḍitā. 62.","tha-ap82:15.1":"“‘Koṭisatasahassiyo,","tha-ap82:15.2":"parivāressanti accharā;","tha-ap82:15.3":"Kusalā naccagītassa,","tha-ap82:15.4":"vāditepi padakkhiṇā. 63.","tha-ap82:16.1":"“‘Etādise byamhavare,","tha-ap82:16.2":"nārīgaṇasamākule;","tha-ap82:16.3":"Vassissati pupphavasso,","tha-ap82:16.4":"dibbo [pada (ka.)] lohitako sadā. 64.","tha-ap82:17.1":"“‘Bhittikhīle nāgadante,","tha-ap82:17.2":"dvārabāhāya toraṇe;","tha-ap82:17.3":"Cakkamattā lohitakā,","tha-ap82:17.4":"olambissanti tāvade. 65.","tha-ap82:18.1":"“‘Pattena pattasañchanne,","tha-ap82:18.2":"antobyamhavare imaṃ;","tha-ap82:18.3":"Attharitvā pārupitvā,","tha-ap82:18.4":"tuvaṭṭissanti tāvade. 66.","tha-ap82:19.1":"“‘Bhavanaṃ parivāretvā,","tha-ap82:19.2":"samantā satayojane;","tha-ap82:19.3":"Tepi padmā [te visuddhā (sī. syā.)] lohitakā,","tha-ap82:19.4":"dibbagandhaṃ pavāyare. 67.","tha-ap82:20.1":"“‘Pañcasattatikkhattuñca,","tha-ap82:20.2":"cakkavattī bhavissati;","tha-ap82:20.3":"Padesarajjaṃ vipulaṃ,","tha-ap82:20.4":"gaṇanāto asaṅkhiyaṃ. 68.","tha-ap82:21.1":"“‘Sampattiyo duve bhutvā,","tha-ap82:21.2":"anīti anupaddavo;","tha-ap82:21.3":"Sampatte pariyosāne,","tha-ap82:21.4":"nibbānaṃ pāpuṇissati’ [phassayissati (sī.), passayissati (ka.)]. 69.","tha-ap82:22.1":"“Sudiṭṭho vata me buddho,","tha-ap82:22.2":"vāṇijjaṃ supayojitaṃ;","tha-ap82:22.3":"Padmāni tīṇi pūjetvā,","tha-ap82:22.4":"anubhosiṃ tisampadā [anubhūyanti sampadā (ka.)]. 70.","tha-ap82:23.1":"“Ajja me dhammappattassa,","tha-ap82:23.2":"vippamuttassa sabbaso;","tha-ap82:23.3":"Supupphitaṃ lohitakaṃ,","tha-ap82:23.4":"dhārayissati matthake. 71.","tha-ap82:24.1":"“Mama kammaṃ kathentassa,","tha-ap82:24.2":"padumuttarasatthuno;","tha-ap82:24.3":"Satapāṇasahassānaṃ,","tha-ap82:24.4":"dhammābhisamayo ahu. 72.","tha-ap82:25.1":"“Satasahassito kappe,","tha-ap82:25.2":"yaṃ buddhamabhipūjayiṃ;","tha-ap82:25.3":"Duggatiṃ nābhijānāmi,","tha-ap82:25.4":"tipadumānidaṃ phalaṃ. 73.","tha-ap82:26.1":"“Kilesā jhāpitā mayhaṃ,","tha-ap82:26.2":"bhavā sabbe samūhatā;","tha-ap82:26.3":"Sabbāsavā parikkhīṇā,","tha-ap82:26.4":"natthi dāni punabbhavo. 74.","tha-ap82:27.1":"“Paṭisambhidā catasso…pe…","tha-ap82:27.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap82:28.1":"Itthaṃ sudaṃ āyasmā tipadumiyo thero imā gāthāyo abhāsitthāti.","tha-ap82:29.1":"Tipadumiyattherassāpadānaṃ dasamaṃ.","tha-ap82:30.1":"Nāgasamālavaggo aṭṭhamo.","tha-ap82:31.1":"Tassuddānaṃ –","tha-ap82:32.1":"Nāgasamālo padasaññī,","tha-ap82:32.2":"saññakāluvadāyako;","tha-ap82:32.3":"Ekasaññī tiṇasanthāro,","tha-ap82:32.4":"sūcipāṭalipupphiyo;","tha-ap82:32.5":"Ṭhitañjalī tipadumī,","tha-ap82:32.6":"gāthāyo pañcasattati. 9."},"unsure":["tha-ap82:2.3"],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2702,"to":2702,"paras":[{"para":2702,"vripara":"48","refs":["tha-ap82:1"],"lines":["So attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>padumuttaro</b> <b>nāma jino</b>tiādimāha.","Tassattho heṭṭhā vuttova.","<b>Sabbadhammāna pāragū</b>ti sabbesaṃ navalokuttaradhammānaṃ pāraṃ nibbānaṃ gato paccakkhaṃ katoti attho.","<b>Danto dantaparivuto</b>ti sayaṃ kāyavācādīhi danto etadagge ṭhapitehi sāvakehi parivutoti attho.","Sesaṃ sabbattha sambandhavasena uttānatthamevāti."],"lineRefs":[["tha-ap82:1"],["tha-ap82:1"],["tha-ap82:1"],["tha-ap82:1"],["tha-ap82:1"]]}],"wordLinks":[["tha-ap82:1.1","padumuttaro nāma jino",0,0],["tha-ap82:1.1","sabbadhammāna pāragū",0,2],["tha-ap82:1.3","danto dantaparivuto",0,3]],"before":[{"para":2700,"vripara":null,"title":"Tipadumiyattheraapadānavaṇṇanā","lines":["Tipadumiyattheraapadānavaṇṇanā"]},{"para":2701,"vripara":null,"title":"Tipadumiyattheraapadānavaṇṇanā","lines":["<b>Padumuttaro nāma jino</b>tiādikaṃ āyasmato tipadumiyattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto padumuttarassa bhagavato kāle haṃsavatiyaṃ mālākārakulagehe nibbatto vuddhippatto mālākārakammaṃ katvā vasanto ekadivasaṃ anekavidhāni jalajathalajapupphāni gahetvā rañño santikaṃ gantukāmo evaṃ cintesi –","“rājā imāni tāva pupphāni disvā pasanno sahassaṃ vā dhanaṃ gāmādikaṃ vā dadeyya, lokanāthaṃ pana pūjetvā nibbānāmatadhanaṃ labhāmi, kiṃ me etesu sundara”nti tena “bhagavantaṃ pūjetvā saggamokkhasampattiyo nipphādetuṃ vaṭṭatī”ti cintetvā vaṇṇavantaṃ atīva rattapupphattayaṃ gahetvā pūjesi.","Tāni gantvā ākāsaṃ chādetvā pattharitvā aṭṭhaṃsu.","Nagaravāsino acchariyabbhutacittajātā celukkhepasahassāni pavattayiṃsu.","Taṃ disvā bhagavā anumodanaṃ akāsi.","So tena puññena devamanussesu sampattiyo anubhavitvā imasmiṃ buddhuppāde gahapatikule nibbatto vuddhimanvāya satthari pasīditvā dhammaṃ sutvā paṭiladdhasaddho pabbajitvā nacirasseva arahā ahosi. 48."]}],"after":[{"para":2703,"vripara":null,"title":"Tipadumiyattheraapadānavaṇṇanā","lines":["Tipadumiyattheraapadānavaṇṇanā samattā."]},{"para":2704,"vripara":null,"title":"Tipadumiyattheraapadānavaṇṇanā","lines":["Aṭṭhamavaggavaṇṇanā samattā. 9."]}]},"tika":null,"tika2":null}
