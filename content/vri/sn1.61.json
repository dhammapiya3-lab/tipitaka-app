{"suttaId":"sn1.61","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[726,730],"vripara":"61"},"segments":{"sn1.61:0.3":"Nāmasuttaṃ","sn1.61:1.1":"“Kiṃsu sabbaṃ addhabhavi [anvabhavi (sī.)],","sn1.61:1.2":"kismā bhiyyo na vijjati;","sn1.61:1.3":"Kissassu ekadhammassa,","sn1.61:1.4":"sabbeva vasamanvagū”ti [vasamaddhagū (ka.)].","sn1.61:2.1":"“Nāmaṃ sabbaṃ addhabhavi,","sn1.61:2.2":"nāmā bhiyyo na vijjati;","sn1.61:2.3":"Nāmassa ekadhammassa,","sn1.61:2.4":"sabbeva vasamanvagū”ti. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":458,"to":458,"paras":[{"para":458,"vripara":"61","refs":["sn1.61:2"],"lines":["Addhavaggassa paṭhame <b>nāmaṃ sabbaṃ addhabhavī</b>ti nāmaṃ sabbaṃ abhibhavati anupatati.","Opapātikena vā hi kittimena vā nāmena mutto satto vā saṅkhāro vā natthi.","Yassapi hi rukkhassa vā pāsāṇassa vā “idaṃ nāma nāma”nti na jānanti, anāmakotveva tassa nāmaṃ hoti.","Paṭhamaṃ. 2-3."],"lineRefs":[["sn1.61:2"],["sn1.61:2"],["sn1.61:2"],["sn1.61:2"]]}],"wordLinks":[["sn1.61:2.1","nāmaṃ sabbaṃ addhabhavī",0,0]],"before":[{"para":456,"vripara":null,"title":"Addhavaggo","lines":["Addhavaggo 1."]},{"para":457,"vripara":null,"title":"Nāmasuttavaṇṇanā","lines":["Nāmasuttavaṇṇanā 61."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":560,"to":560,"paras":[{"para":560,"vripara":"61","refs":["sn1.61:2"],"lines":["<b>Nāma</b>nti sāmaññanāmādibhedaṃ nāmaṃ.","<b>Sabba</b>nti sabbaṃ paññattipathaṃ sabbaṃ ñeyyapavattipathaṃ.","<b>Addhabhavī</b>ti kāmaṃ pāḷiyaṃ atītakālaniddeso kato, taṃ pana lakkhaṇamattaṃ.","<b>Abhibhavati anupatatī</b>ti etena abhibhavo anupatanaṃ pavatti evāti dasseti.","Taṃ panassa abhibhavanaṃ appavisaye anāmasitvā mahāvisayānaṃ vasena dassento <b>“opapātikena vā”</b>tiādimāha.","<b>Tassa nāmaṃ hotī</b>ti tassa rukkhapāsāṇādikassa anāmakoicceva samaññā hoti, tathā naṃ sañjānantīti attho."],"lineRefs":[[