{"suttaId":"tha-ap186","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7068,7086],"vripara":"18"},"segments":{"tha-ap186:0.3":"Pañcahatthiyattheraapadānaṃ","tha-ap186:1.1":"“Tisso nāmāsi bhagavā,","tha-ap186:1.2":"lokajeṭṭho narāsabho;","tha-ap186:1.3":"Purakkhato sāvakehi,","tha-ap186:1.4":"rathiyaṃ paṭipajjatha. 19.","tha-ap186:2.1":"“Pañca uppalahatthā ca,","tha-ap186:2.2":"cāturā ṭhapitā mayā;","tha-ap186:2.3":"Āhutiṃ dātukāmohaṃ,","tha-ap186:2.4":"paggaṇhiṃ vatasiddhiyā [puttomhi hitasiddhiyā (syā.)]. 20.","tha-ap186:3.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap186:3.2":"gacchantaṃ antarāpaṇe;","tha-ap186:3.3":"Buddharaṃsīhi phuṭṭhosmi [buddharaṃsyābhiphuṭṭhomhi (sī.), buddharaṃsābhighuṭṭhosmi (ka.)],","tha-ap186:3.4":"pūjesiṃ dvipaduttamaṃ. 21.","tha-ap186:4.1":"“Dvenavute ito kappe,","tha-ap186:4.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap186:4.3":"Duggatiṃ nābhijānāmi,","tha-ap186:4.4":"buddhapūjāyidaṃ phalaṃ. 22.","tha-ap186:5.1":"“Ito terasakappamhi,","tha-ap186:5.2":"pañca susabhasammatā;","tha-ap186:5.3":"Sattaratanasampannā,","tha-ap186:5.4":"cakkavattī mahabbalā. 23.","tha-ap186:6.1":"“Paṭisambhidā catasso…pe…","tha-ap186:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap186:7.1":"Itthaṃ sudaṃ āyasmā pañcahatthiyo thero imā gāthāyo abhāsitthāti.","tha-ap186:8.1":"Pañcahatthiyattherassāpadānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
