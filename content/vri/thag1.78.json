{"suttaId":"thag1.78","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[452,455],"vripara":"78"},"segments":{"thag1.78:0.4":"Meṇḍasirattheragāthā","thag1.78:1.1":"“Anekajātisaṃsāraṃ,","thag1.78:1.2":"sandhāvissaṃ anibbisaṃ;","thag1.78:1.3":"Tassa me dukkhajātassa,","thag1.78:1.4":"dukkhakkhandho aparaddho”ti.","thag1.78:1.5":"… Meṇḍasiro thero …."},"unsure":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2047,"to":2047,"paras":[{"para":2047,"vripara":null,"refs":["thag1.78:1"],"lines":["Tattha <b>anekajātisaṃsāran</b>ti anekajātisatasahassasaṅkhyaṃ idaṃ saṃsāravaṭṭaṃ, addhuno adhippetattā accantasaṃyogekavacanaṃ.","<b>Sandhāvissan</b>ti saṃsariṃ, aparāparaṃ cavanuppajjanavasena paribbhamiṃ.","<b>Anibbisan</b>ti tassa nivattakañāṇaṃ avindanto alabhanto.","<b>Tassa me</b>ti evaṃ saṃsarantassa me.","<b>Dukkhajātassā</b>ti jātiādivasena uppannadukkhassa, tissannaṃ vā dukkhatānaṃ vasena dukkhasabhāvassa.","<b>Dukkhakkhandho</b>ti kammakilesavipākavaṭṭappakāro dukkharāsi.","<b>Aparaddho</b>ti arahattamaggappattito paṭṭhāya paribbhaṭṭho cuto na abhinibbattissati.","“Aparaṭṭho”ti vā pāṭho, apagatasamiddhito samucchinnakāraṇattā apagatoti attho.","Idameva ca therassa aññābyākaraṇaṃ ahosi."],"lineRefs":[["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"]]}],"wordLinks":[["thag1.78:1.1","anekajātisaṃsāraṃ",0,0],["thag1.78:1.1","sandhāvissaṃ",0,1],["thag1.78:1.1","anibbisaṃ",0,2],["thag1.78:1.3","tassa me",0,3],["thag1.78:1.3","dukkhajātassā",0,4],["thag1.78:1.3","dukkhakkhandho",0,5],["thag1.78:1.3","aparaddho",0,6]],"before":[{"para":2011,"vripara":null,"refs":[],"lines":["“Suvaṇṇavaṇṇo sambuddho, vipassī dakkhiṇāraho;"],"lineRefs":[[]]},{"para":2012,"vripara":null,"refs":[],"lines":["Purakkhato sāvakehi, ārāmā abhinikkhami."],"lineRefs":[[]]},{"para":2013,"vripara":null,"refs":[],"lines":["“Disvānahaṃ buddhaseṭṭhaṃ, sabbaññuṃ tamanāsakaṃ;"],"lineRefs":[[]]},{"para":2014,"vripara":null,"refs":[],"lines":["Pasannacitto sumano, gaṇṭhipupphaṃ apūjayiṃ."],"lineRefs":[[]]},{"para":2015,"vripara":null,"refs":[],"lines":["“Tena cittappasādena, dvipadindassa tādino;"],"lineRefs":[[]]},{"para":2016,"vripara":null,"refs":[],"lines":["Haṭṭho haṭṭhena cittena, puna vandiṃ tathāgataṃ."],"lineRefs":[[]]},{"para":2017,"vripara":null,"refs":[],"lines":["“Ekanavutito kappe, yaṃ pupphamabhiropayiṃ;"],"lineRefs":[[]]},{"para":2018,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":2019,"vripara":null,"refs":[],"lines":["“Ekatālīsito kappe, caraṇo nāma khattiyo;"],"lineRefs":[[]]},{"para":2020,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":2021,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":2022,"vripara":null,"refs":[],"lines":["Ayameva ca therassa aññābyākaraṇagāthā ahosīti."],"lineRefs":[[]]},{"para":2023,"vripara":null,"refs":[],"lines":["Hatthārohaputtattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2024,"vripara":null,"refs":[],"lines":["Meṇḍasirattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":2025,"vripara":null,"refs":[],"lines":["<b>Anekajātisaṃsāran</b>ti āyasmato meṇḍasirattherassa gāthā.","Kā uppatti?","Sopi kira purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni karonto ito ekanavute kappe brāhmaṇakule nibbattitvā vayappatto kāme pahāya isipabbajjaṃ pabbajitvā mahatā isigaṇena saddhiṃ himavante vasanto satthāraṃ disvā pasannamānaso isigaṇena padumāni āharāpetvā satthu pupphapūjaṃ katvā sāvake appamādapaṭipattiyaṃ ovaditvā kālaṃ katvā devaloke nibbatto aparāparaṃ saṃsaranto imasmiṃ buddhuppāde sākete gahapatikule nibbatti, tassa meṇḍasarikkhasīsatāya <b>meṇḍasiro</b> tveva samaññā ahosi.","So bhagavati sākete añjanavane viharante satthāraṃ upasaṅkamitvā paṭiladdhasaddho pabbajitvā samathavipassanāsu kammaṃ karonto chaḷabhiñño ahosi.","Teva vuttaṃ <b>apadāne</b> (apa. thera 1.13.97-105)–"],"lineRefs":[[],[],[],[],[]]},{"para":2026,"vripara":null,"refs":[],"lines":["“Himavantassāvidūre, gotamo nāma pabbato;"],"lineRefs":[[]]},{"para":2027,"vripara":null,"refs":[],"lines":["Nānārukkhehi sañchanno, mahābhūtagaṇālayo."],"lineRefs":[[]]},{"para":2028,"vripara":null,"refs":[],"lines":["“Vemajjhamhi ca tassāsi, assamo abhinimmito;"],"lineRefs":[[]]},{"para":2029,"vripara":null,"refs":[],"lines":["Purakkhato sasissehi, vasāmi assame ahaṃ."],"lineRefs":[[]]},{"para":2030,"vripara":null,"refs":[],"lines":["“Āyantu me sissagaṇā, padumaṃ āharantu me;"],"lineRefs":[[]]},{"para":2031,"vripara":null,"refs":[],"lines":["Buddhapūjaṃ karissāmi, dvipadindassa tādino."],"lineRefs":[[]]},{"para":2032,"vripara":null,"refs":[],"lines":["“Evanti te paṭissutvā, padumaṃ āhariṃsu me;"],"lineRefs":[[]]},{"para":2033,"vripara":null,"refs":[],"lines":["Tathā nimittaṃ katvāhaṃ, buddhassa abhiropayiṃ."],"lineRefs":[[]]},{"para":2034,"vripara":null,"refs":[],"lines":["“Sisse tadā samānetvā, sādhukaṃ anusāsahaṃ;"],"lineRefs":[[]]},{"para":2035,"vripara":null,"refs":[],"lines":["Mā kho tumhe pamajjittha, appamādo sukhāvaho."],"lineRefs":[[]]},{"para":2036,"vripara":null,"refs":[],"lines":["“Evaṃ samanusāsitvā, te sisse vacanakkhame;"],"lineRefs":[[]]},{"para":2037,"vripara":null,"refs":[],"lines":["Appamādaguṇe yutto, tadā kālaṅkato ahaṃ."],"lineRefs":[[]]},{"para":2038,"vripara":null,"refs":[],"lines":["“Ekanavutito kappe, yaṃ pupphamabhiropayiṃ;"],"lineRefs":[[]]},{"para":2039,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":2040,"vripara":null,"refs":[],"lines":["“Ekapaññāsakappamhi, rājā āsiṃ jaluttamo;"],"lineRefs":[[]]},{"para":2041,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":2042,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":2043,"vripara":null,"refs":[],"lines":["So attano pubbenivāsaṃ anussaranto –"],"lineRefs":[[]]},{"para":2045,"vripara":"78","refs":[],"lines":["“Anekajātisaṃsāraṃ, sandhāvissaṃ anibbisaṃ;"],"lineRefs":[[]]},{"para":2046,"vripara":null,"refs":[],"lines":["Tassa me dukkhajātassa, dukkhakkhandho aparaddho”ti.","– gāthaṃ abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
