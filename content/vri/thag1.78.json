{"suttaId":"thag1.78","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[452,455],"vripara":"78"},"segments":{"thag1.78:0.4":"Meṇḍasirattheragāthā","thag1.78:1.1":"“Anekajātisaṃsāraṃ, sandhāvissaṃ anibbisaṃ;","thag1.78:1.3":"Tassa me dukkhajātassa, dukkhakkhandho aparaddho”ti.","thag1.78:1.5":"… Meṇḍasiro thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2047,"to":2047,"paras":[{"para":2047,"vripara":null,"refs":["thag1.78:1"],"lines":["Tattha <b>anekajātisaṃsāran</b>ti anekajātisatasahassasaṅkhyaṃ idaṃ saṃsāravaṭṭaṃ, addhuno adhippetattā accantasaṃyogekavacanaṃ.","<b>Sandhāvissan</b>ti saṃsariṃ, aparāparaṃ cavanuppajjanavasena paribbhamiṃ.","<b>Anibbisan</b>ti tassa nivattakañāṇaṃ avindanto alabhanto.","<b>Tassa me</b>ti evaṃ saṃsarantassa me.","<b>Dukkhajātassā</b>ti jātiādivasena uppannadukkhassa, tissannaṃ vā dukkhatānaṃ vasena dukkhasabhāvassa.","<b>Dukkhakkhandho</b>ti kammakilesavipākavaṭṭappakāro dukkharāsi.","<b>Aparaddho</b>ti arahattamaggappattito paṭṭhāya paribbhaṭṭho cuto na abhinibbattissati.","“Aparaṭṭho”ti vā pāṭho, apagatasamiddhito samucchinnakāraṇattā apagatoti attho.","Idameva ca therassa aññābyākaraṇaṃ ahosi."],"lineRefs":[["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"]]}],"wordLinks":[["thag1.78:1.1","anekajātisaṃsāraṃ",0,0],["thag1.78:1.1","sandhāvissaṃ",0,1],["thag1.78:1.1","anibbisaṃ",0,2],["thag1.78:1.3","tassa me",0,3],["thag1.78:1.3","dukkhajātassā",0,4],["thag1.78:1.3","dukkhakkhandho",0,5],["thag1.78:1.3","aparaddho",0,6]]},"tika":null}
