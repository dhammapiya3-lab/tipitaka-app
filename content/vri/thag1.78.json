{"suttaId":"thag1.78","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[452,455],"vripara":"78"},"segments":{"thag1.78:0.4":"Meṇḍasirattheragāthā","thag1.78:1.1":"“Anekajātisaṃsāraṃ,","thag1.78:1.2":"sandhāvissaṃ anibbisaṃ;","thag1.78:1.3":"Tassa me dukkhajātassa,","thag1.78:1.4":"dukkhakkhandho aparaddho”ti.","thag1.78:1.5":"… Meṇḍasiro thero …."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2047,"to":2047,"paras":[{"para":2047,"vripara":null,"refs":["thag1.78:1"],"lines":["Tattha <b>anekajātisaṃsāran</b>ti anekajātisatasahassasaṅkhyaṃ idaṃ saṃsāravaṭṭaṃ, addhuno adhippetattā accantasaṃyogekavacanaṃ.","<b>Sandhāvissan</b>ti saṃsariṃ, aparāparaṃ cavanuppajjanavasena paribbhamiṃ.","<b>Anibbisan</b>ti tassa nivattakañāṇaṃ avindanto alabhanto.","<b>Tassa me</b>ti evaṃ saṃsarantassa me.","<b>Dukkhajātassā</b>ti jātiādivasena uppannadukkhassa, tissannaṃ vā dukkhatānaṃ vasena dukkhasabhāvassa.","<b>Dukkhakkhandho</b>ti kammakilesavipākavaṭṭappakāro dukkharāsi.","<b>Aparaddho</b>ti arahattamaggappattito paṭṭhāya paribbhaṭṭho cuto na abhinibbattissati.","“Aparaṭṭho”ti vā pāṭho, apagatasamiddhito samucchinnakāraṇattā apagatoti attho.","Idameva ca therassa aññābyākaraṇaṃ ahosi."],"lineRefs":[["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"],["thag1.78:1"]]}],"wordLinks":[["thag1.78:1.1","anekajātisaṃsāraṃ",0,0],["thag1.78:1.1","sandhāvissaṃ",0,1],["thag1.78:1.1","anibbisaṃ",0,2],["thag1.78:1.3","tassa me",0,3],["thag1.78:1.3","dukkhajātassā",0,4],["thag1.78:1.3","dukkhakkhandho",0,5],["thag1.78:1.3","aparaddho",0,6]],"before":[{"para":2024,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Meṇḍasirattheragāthāvaṇṇanā"]},{"para":2025,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["<b>Anekajātisaṃsāran</b>ti āyasmato meṇḍasirattherassa gāthā.","Kā uppatti?","Sopi kira purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni karonto ito ekanavute kappe brāhmaṇakule nibbattitvā vayappatto kāme pahāya isipabbajjaṃ pabbajitvā mahatā isigaṇena saddhiṃ himavante vasanto satthāraṃ disvā pasannamānaso isigaṇena padumāni āharāpetvā satthu pupphapūjaṃ katvā sāvake appamādapaṭipattiyaṃ ovaditvā kālaṃ katvā devaloke nibbatto aparāparaṃ saṃsaranto imasmiṃ buddhuppāde sākete gahapatikule nibbatti, tassa meṇḍasarikkhasīsatāya <b>meṇḍasiro</b> tveva samaññā ahosi.","So bhagavati sākete añjanavane viharante satthāraṃ upasaṅkamitvā paṭiladdhasaddho pabbajitvā samathavipassanāsu kammaṃ karonto chaḷabhiñño ahosi.","Teva vuttaṃ <b>apadāne</b> (apa. thera 1.13.97-105)–"]},{"para":2026,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["“Himavantassāvidūre, gotamo nāma pabbato;"]},{"para":2027,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Nānārukkhehi sañchanno, mahābhūtagaṇālayo."]},{"para":2028,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["“Vemajjhamhi ca tassāsi, assamo abhinimmito;"]},{"para":2029,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Purakkhato sasissehi, vasāmi assame ahaṃ."]},{"para":2030,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["“Āyantu me sissagaṇā, padumaṃ āharantu me;"]},{"para":2031,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Buddhapūjaṃ karissāmi, dvipadindassa tādino."]},{"para":2032,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["“Evanti te paṭissutvā, padumaṃ āhariṃsu me;"]},{"para":2033,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Tathā nimittaṃ katvāhaṃ, buddhassa abhiropayiṃ."]},{"para":2034,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["“Sisse tadā samānetvā, sādhukaṃ anusāsahaṃ;"]},{"para":2035,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Mā kho tumhe pamajjittha, appamādo sukhāvaho."]},{"para":2036,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["“Evaṃ samanusāsitvā, te sisse vacanakkhame;"]},{"para":2037,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Appamādaguṇe yutto, tadā kālaṅkato ahaṃ."]},{"para":2038,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["“Ekanavutito kappe, yaṃ pupphamabhiropayiṃ;"]},{"para":2039,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."]},{"para":2040,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["“Ekapaññāsakappamhi, rājā āsiṃ jaluttamo;"]},{"para":2041,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Sattaratanasampanno, cakkavattī mahabbalo."]},{"para":2042,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."]},{"para":2043,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["So attano pubbenivāsaṃ anussaranto –"]},{"para":2045,"vripara":"78","title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["“Anekajātisaṃsāraṃ, sandhāvissaṃ anibbisaṃ;"]},{"para":2046,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Tassa me dukkhajātassa, dukkhakkhandho aparaddho”ti.","– gāthaṃ abhāsi;"]}],"after":[{"para":2048,"vripara":null,"title":"Meṇḍasirattheragāthāvaṇṇanā","lines":["Meṇḍasirattheragāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
