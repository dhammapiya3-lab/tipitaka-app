{"suttaId":"ja239","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1631,1637],"vripara":"177"},"segments":{"ja239:0.4":"Haritamaṇḍūkajātakaṃ (2-9-9)","ja239:1.1":"Āsīvisampi maṃ [āsīvisaṃ mamaṃ (sī. pī.)] santaṃ,","ja239:1.2":"paviṭṭhaṃ kumināmukhaṃ;","ja239:1.3":"Ruccate haritāmātā,","ja239:1.4":"yaṃ maṃ khādanti macchakā. 178.","ja239:2.1":"Vilumpateva puriso,","ja239:2.2":"yāvassa upakappati;","ja239:2.3":"Yadā caññe vilumpanti,","ja239:2.4":"so vilutto vilumpatīti [viluppatīti (?)].","ja239:3.1":"Haritamaṇḍūkajātakaṃ navamaṃ. 240."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1552,"to":1557,"paras":[{"para":1552,"vripara":null,"refs":["ja239:1"],"lines":["Tattha <b>āsīvisampi maṃ santa</b>nti maṃ āgatavisaṃ samānaṃ.","<b>Ruccate haritāmātā, yaṃ maṃ khādanti macchakā</b>ti etaṃ tava ruccati haritamaṇḍūkaputtāti vadati."],"lineRefs":[["ja239:1"],["ja239:1"]]},{"para":1553,"vripara":null,"refs":["ja239:1"],"lines":["Atha naṃ haritamaṇḍūko “āma, samma, ruccatī”ti.","“Kiṃkāraṇā”ti?","“Sace tvampi tava padesaṃ āgate macche khādasi, macchāpi attano padesaṃ āgataṃ taṃ khādanti, attano visaye padese gocarabhūmiyaṃ abalavā nāma natthī”ti vatvā dutiyaṃ gāthamāha – 178."],"lineRefs":[["ja239:1"],["ja239:1"],["ja239:1"]]},{"para":1555,"vripara":"178","refs":["ja239:1"],"lines":["“Vilumpateva puriso, yāvassa upakappati;"],"lineRefs":[["ja239:1"]]},{"para":1556,"vripara":null,"refs":["ja239:1"],"lines":["Yadā caññe vilumpanti, so vilutto vilumpatī”ti."],"lineRefs":[["ja239:1"]]},{"para":1557,"vripara":null,"refs":["ja239:2"],"lines":["Tattha <b>vilumpateva puriso, yāvassa upakappatī</b>ti yāva assa purisassa issariyaṃ upakappati ijjhati pavattati, tāva so aññaṃ vilumpatiyeva.","“Yāva so upakappatī”tipi pāṭho, yattakaṃ kālaṃ so puriso sakkoti vilumpitunti attho.","<b>Yadā caññe vilumpantī</b>ti yadā ca aññe issarā hutvā vilumpanti.","<b>So vilutto vilumpatī</b>ti atha so vilumpako aññehi vilumpati.","“Vilumpate”tipi pāṭho, ayamevattho.","“Vilumpana”ntipi paṭhanti, tassattho na sameti.","Evaṃ “vilumpako puna vilumpaṃ pāpuṇātī”ti bodhisattena aḍḍe vinicchite udakāsīvisassa dubbalabhāvaṃ ñatvā “paccāmittaṃ gaṇhissāmā”ti macchagaṇā kumīnamukhā nikkhamitvā tattheva naṃ jīvitakkhayaṃ pāpetvā pakkamuṃ."],"lineRefs":[["ja239:2"],["ja239:2"],["ja239:2"],["ja239:2"],["ja239:2"],["ja239:2"],["ja239:2"]]}],"wordLinks":[["ja239:1.1","āsīvisampi maṃ santaṃ",0,0],["ja239:1.3","ruccate haritāmātā yaṃ maṃ khādanti macchakā",0,1],["ja239:2.1","vilumpateva puriso yāvassa upakappatī",4,0],["ja239:2.3","yadā caññe vilumpantī",4,2],["ja239:2.3","so vilutto vilumpatī",4,3]]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":846,"to":852,"paras":[{"para":846,"vripara":null,"refs":["ja239:1"],"lines":["9-haritamaṇḍūkajātakavaṇṇanā (239)"],"lineRefs":[["ja239:1"]]},{"para":847,"vripara":null,"refs":["ja239:1"],"lines":["<b>kosalarājāssā</b>ti pasenadīkosalarañño.","<b>pitā mahākosalo</b>ti pitubhūto mahākosalo.","<b>bimbisārarañño</b>ti evaṃ nāmakassa rañño.","bimbaṃ vuccati sarīraṃ.","tassa bimbisārarañño.","<b>nhanamūla</b>nti gandhanhanassa mūlaṃ.","<b>kāsikagāmaka</b>nti so kira gāmako pubbe kāsikaraṭṭhe niviṭṭho.","pacchā pana kosalarājā yujjhitvā vilumpitvā attano vase patiṭṭhāpesi.","tassa ca kāsikaraṭṭhato laddhattā kāsikagāmakanti samaññā ahosi.","kāsikagāmakanti ekassa gāmassa nāmamattantipi vadanti keci.","<b>corassā</b>ti pitaraṃ māretvā rajjasampattiyā vilumpanato corassa thenakassa.","<b>dhajanti</b> vejayantadhajaṃ.","<b>mātula</b>nti mātuyā bhātaraṃ."],"lineRefs":[["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"]]},{"para":848,"vripara":null,"refs":["ja239:1"],"lines":["<b>maṇḍūkayoniya</b>nti nīlamaṇḍūkayoniyaṃ.","yo kaṇḍakotipi vuccati.","<b>macchagahaṇatthayā</b>ti macchānaṃ gahaṇatthāya.","<b>udakāsīviso</b>ti udake avacārako āsīviso.","yo deḍḍubhoti vuccati.","tassa pana vaṇṇavasena āsīvisasadisatāya āsīvisoti vuccati.","na sīghavisatāya.","<b>ekalohita</b>nti kumīnantare ekalohitaṃ.","<b>kumīna-sūlamatthake</b>ti kumīnadaṇḍamatthake.","<b>vinicchayaṭṭhāna</b>nti vivādassa kalahassa vūpasamanatthāya dinnavinicchayaṃ alabhanto.","<b>āgatavisa</b>nti idaṃ tassa jātiyā anurūpavasena mandavīsataṃ sandhāya vuttaṃ.","na sīghavisataṃ.","<b>āgatavisa</b>nti ca sampannāgatavisanti attho.","keci pana āsivisoti ettha āsisaddassa atthaṃ dasseti āgatavisanti imināti vadanti.","na panetaṃ daṭṭhabbaṃ.","āgatavisanti iminā hi labhitabbatthamattameva dassetīti.","āsivisasaddassa pana attho heṭṭhā vutto."],"lineRefs":[["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"]]},{"para":849,"vripara":null,"refs":["ja239:1"],"lines":["footnote 1.","nhānamūlaṃ.","chaṭṭha."],"lineRefs":[["ja239:1"],["ja239:1"],["ja239:1"]]},{"para":850,"vripara":null,"refs":["ja239:1"],"lines":["footnote 2.","macche gahaṇatthāya.","chaṭṭha."],"lineRefs":[["ja239:1"],["ja239:1"],["ja239:1"]]},{"para":851,"vripara":null,"refs":["ja239:1"],"lines":["pāḷiyaṃ — <b>kumināmukha</b>nti ettha kuminamukhanti vattabbe a-kārassa ā-kāraṃ katvā kumināmukhanti vuttaṃ.","<b>haritāmātā</b>ti haritāya mātuyā apaccaṃ haritāmātāti nibbacanaṃ daṭṭhabbaṃ.","apaccatthe āpaccayo daṭṭhabbo.","vicitrā hi taddhitavuttīti.","tenāha — “haritamaṇḍūkaputtāti vadatī”ti.","haritamātāti vattabbe chandānurakkharaṇatthaṃ haritāmātāti vuttaṃ.","pāḷiyaṃ — yaṃ yena kāraṇena macchakā maṃ khādanti.","etaṃ tava ruccate haritamātāti yojanā.","<b>tambadesa</b>nti tava padesaṃ.","tava padeso tambadesoti viggaho.","samāse hi tumhasaddassa taṃādeso hotīti.","lupa- adassaneti dhātussa rudhādidivādigaṇavasena dvigaṇikattā “vilumpatetipi pāṭho.","ayamevatthoti vuttaṃ.","vilumpatetipi niggahitāgamavasena pāṭho dissati.","ayamevattho.","nāññatthoti attho.","<b>vilimpatītipi paṭhantī</b>ti vilimpatipi keci paṭhanti.","<b>tassattho na sametī</b>ti tassa pāṭhassa lipa- ālimpaneti dhātuvasena attho na sameti.","na yujjatīti vuttaṃ hoti.","<b>vinicchite</b>ti tasmiṃ aḍḍe vinicchiteti."],"lineRefs":[["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"],["ja239:1"]]},{"para":852,"vripara":null,"refs":["ja239:1"],"lines":["ending haritamaṇḍūkajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja239:1"]]}],"wordLinks":[]},"tika2":null}
