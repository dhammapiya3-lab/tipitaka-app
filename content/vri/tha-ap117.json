{"suttaId":"tha-ap117","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5508,5535],"vripara":"40"},"segments":{"tha-ap117:0.3":"Suvaṇṇapupphiyattheraapadānaṃ","tha-ap117:1.1":"“Vipassī nāma bhagavā,","tha-ap117:1.2":"lokajeṭṭho narāsabho;","tha-ap117:1.3":"Nisinno janakāyassa,","tha-ap117:1.4":"desesi amataṃ padaṃ. 41.","tha-ap117:2.1":"“Tassāhaṃ dhammaṃ sutvāna,","tha-ap117:2.2":"dvipadindassa tādino;","tha-ap117:2.3":"Soṇṇapupphāni cattāri,","tha-ap117:2.4":"buddhassa abhiropayiṃ. 42.","tha-ap117:3.1":"“Suvaṇṇacchadanaṃ āsi,","tha-ap117:3.2":"yāvatā parisā tadā;","tha-ap117:3.3":"Buddhābhā ca suvaṇṇābhā,","tha-ap117:3.4":"āloko vipulo ahu. 43.","tha-ap117:4.1":"“Udaggacitto sumano,","tha-ap117:4.2":"vedajāto katañjalī;","tha-ap117:4.3":"Vittisañjanano tesaṃ,","tha-ap117:4.4":"diṭṭhadhammasukhāvaho. 44.","tha-ap117:5.1":"“Āyācitvāna sambuddhaṃ,","tha-ap117:5.2":"vanditvāna ca subbataṃ;","tha-ap117:5.3":"Pāmojjaṃ janayitvāna,","tha-ap117:5.4":"sakaṃ bhavanupāgamiṃ. 45.","tha-ap117:6.1":"“Bhavane upaviṭṭhohaṃ,","tha-ap117:6.2":"buddhaseṭṭhaṃ anussariṃ;","tha-ap117:6.3":"Tena cittappasādena,","tha-ap117:6.4":"tusitaṃ upapajjahaṃ. 46.","tha-ap117:7.1":"“Ekanavutito kappe,","tha-ap117:7.2":"yaṃ pupphamabhiropayiṃ;","tha-ap117:7.3":"Duggatiṃ nābhijānāmi,","tha-ap117:7.4":"buddhapūjāyidaṃ phalaṃ. 47.","tha-ap117:8.1":"“Soḷasāsiṃsu rājāno,","tha-ap117:8.2":"nemisammatanāmakā;","tha-ap117:8.3":"Tetālīse ito kappe,","tha-ap117:8.4":"cakkavattī mahabbalā. 48.","tha-ap117:9.1":"“Paṭisambhidā catasso…pe…","tha-ap117:9.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap117:10.1":"Itthaṃ sudaṃ āyasmā suvaṇṇapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap117:11.1":"Suvaṇṇapupphiyattherassāpadānaṃ pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2864,"to":2865,"paras":[{"para":2864,"vripara":"40","refs":["tha-ap117:1"],"lines":["So aparabhāge pubbakammaṃ saritvā somanassajāto attano pubbacaritāpadānaṃ pakāsento <b>vipassī nāma bhagavā</b>tiādimāha.","Taṃ heṭṭhā vuttatthameva. 44."],"lineRefs":[["tha-ap117:1"],["tha-ap117:1"]]},{"para":2865,"vripara":"44","refs":["tha-ap117:5"],"lines":["<b>Pāmojjaṃ janayitvānā</b>ti balavapītiṃ uppādetvā “pāmojjaṃ āmodanā pamodanā hāso pahāso vitti odagyaṃ attamanatā cittassā”tiādīsu (dha. sa. 9, 86; mahāni. 1) viya attamanatā sakabhāvaṃ uppādetvāti attho.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["tha-ap117:5"],["tha-ap117:5"]]}],"wordLinks":[["tha-ap117:1.1","vipassī nāma bhagavā",0,0],["tha-ap117:5.3","pāmojjaṃ janayitvānā",1,0]],"before":[{"para":2862,"vripara":null,"title":"Suvaṇṇapupphiyattheraapadānavaṇṇanā","lines":["Suvaṇṇapupphiyattheraapadānavaṇṇanā"]},{"para":2863,"vripara":null,"title":"Suvaṇṇapupphiyattheraapadānavaṇṇanā","lines":["<b>Vipassī</b> <b>nāma bhagavā</b>tiādikaṃ āyasmato suvaṇṇapupphiyattherassa apadānaṃ.","Ayampi purimajinavaresu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto vipassissa bhagavato kāle ekasmiṃ ṭhāne bhūmaṭṭhakadevaputto hutvā nibbatto tassa bhagavato dhammaṃ sutvā pasannamānaso catūhi suvaṇṇapupphehi pūjesi.","Tāni pupphāni ākāse suvaṇṇavitānaṃ hutvā chādesuṃ, suvaṇṇapabhā ca buddhassa sarīrapabhā ca ekato hutvā mahāobhāso ahosi.","So atirekataraṃ pasanno sakabhavanaṃ gatopi saratiyeva.","So tena puññakammena tusitabhavanādisugatīsuyeva saṃsaranto dibbasampattiṃ anubhavitvā imasmiṃ buddhuppāde kulagehe nibbatto viññutaṃ patto satthu dhammadesanaṃ sutvā sāsane uraṃ datvā pabbajito nacirasseva arahā ahosi. 40."]}],"after":[{"para":2866,"vripara":null,"title":"Suvaṇṇapupphiyattheraapadānavaṇṇanā","lines":["Suvaṇṇapupphiyattheraapadānavaṇṇanā samattā. 6."]}]},"tika":null,"tika2":null}
