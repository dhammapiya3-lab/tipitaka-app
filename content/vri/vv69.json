{"suttaId":"vv69","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2629,2634],"vripara":"1075"},"segments":{"vv69:0.4":"Dutiyaupassayadāyakavimānavatthu","vv69:1.1":"Sūriyo yathā vigatavalāhake nabhe … pe ….","vv69:2.1":"(Yathā purimavimānaṃ tathā vitthāretabbaṃ).","vv69:3.1":"“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv69:4.1":"Dutiyaupassayadāyakavimānaṃ pañcamaṃ."},"attha":null,"tika":null}
