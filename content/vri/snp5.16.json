{"suttaId":"snp5.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3861,3875],"vripara":"1122"},"segments":{"snp5.16:0.2":"Mogharājamāṇavapucchā","snp5.16:1.1":"“Dvāhaṃ sakkaṃ apucchissaṃ,(iccāyasmā mogharājā)","snp5.16:1.3":"Na me byākāsi cakkhumā;","snp5.16:1.4":"Yāvatatiyañca devīsi, byākarotīti me sutaṃ.","snp5.16:2.1":"“Ayaṃ loko paro loko, brahmaloko sadevako;","snp5.16:2.3":"Diṭṭhiṃ te nābhijānāti, gotamassa yasassino.","snp5.16:3.1":"“Evaṃ abhikkantadassāviṃ, atthi pañhena āgamaṃ;","snp5.16:3.3":"Kathaṃ lokaṃ avekkhantaṃ, maccurājā na passati”.","snp5.16:4.1":"“Suññato lokaṃ avekkhassu, mogharāja sadā sato;","snp5.16:4.3":"Attānudiṭṭhiṃ ūhacca, evaṃ maccutaro siyā;","snp5.16:4.5":"Evaṃ lokaṃ avekkhantaṃ, maccurājā na passatī”ti.","snp5.16:4.7":"Mogharājamāṇavapucchā pannarasamā niṭṭhitā."},"attha":null,"tika":null}
