{"suttaId":"ja165","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[980,986],"vripara":"29"},"segments":{"ja165:0.4":"Nakulajātakaṃ (2-2-5)","ja165:1.1":"Sandhiṃ katvā amittena, aṇḍajena jalābuja;","ja165:1.3":"Vivariya dāṭhaṃ sesi [sayasi (sī. syā. pī.)], kuto te bhayamāgataṃ.","ja165:2.1":"Saṅketheva [saṅkateva (ka.)] amittasmiṃ, mittasmimpi na vissase;","ja165:2.3":"Abhayā bhayamuppannaṃ, api mūlāni kantatīti [mūlaṃ nikantatīti (sī.)].","ja165:3.1":"Nakulajātakaṃ pañcamaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":281,"to":286,"paras":[{"para":281,"vripara":null,"refs":["ja165:1"],"lines":["Tattha <b>sandhiṃ katvā</b>ti mittabhāvaṃ karitvā.","<b>Aṇḍajenā</b>ti aṇḍakose nibbattena nāgena.","<b>Jalābujā</b>ti nakulaṃ ālapati.","So hi jalābumhi jātattā “jalābujo”ti vuccati.","<b>Vivariyā</b>ti vivaritvā."],"lineRefs":[["ja165:1"],["ja165:1"],["ja165:1"],["ja165:1"],["ja165:1"]]},{"para":282,"vripara":null,"refs":[],"lines":["Evaṃ bodhisattena vutto nakulo “ayya, paccāmitto nāma na avajānitabbo āsaṅkitabboyevā”ti vatvā dutiyaṃ gāthamāha –"],"lineRefs":[[]]},{"para":284,"vripara":"30","refs":[],"lines":["“Saṅketheva amittasmiṃ, mittasmimpi na vissase;"],"lineRefs":[[]]},{"para":285,"vripara":null,"refs":[],"lines":["Abhayā bhayamuppannaṃ, api mūlāni kantatī”ti."],"lineRefs":[[]]},{"para":286,"vripara":null,"refs":["ja165:2"],"lines":["Tattha <b>abhayā bhayamuppannan</b>ti na ito te bhayamuppannanti abhayo, ko so?","Mitto.","Yañhi mittasmimpi vissāse sati tato bhayaṃ uppajjati, taṃ <b>mūlāni</b> pi <b>kantati,</b> mittassa sabbarandhānaṃ viditattā mūlaghaccāya saṃvattatīti attho."],"lineRefs":[["ja165:2"],["ja165:2"],["ja165:2"]]}],"wordLinks":[["ja165:1.1","sandhiṃ katvā",0,0],["ja165:1.1","aṇḍajenā",0,1],["ja165:1.1","jalābujā",0,2],["ja165:1.3","vivariyā",0,4],["ja165:2.3","abhayā bhayamuppannaṃ",4,0],["ja165:2.3","kantati",4,2],["ja165:2.3","mūlāni",4,2]]},"tika":null,"tika2":null}
