{"suttaId":"iti72","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"It","vriCode":"s0504m.mul","paras":[655,661],"vripara":"72"},"segments":{"iti72:0.4":"Nissaraṇiyasuttaṃ","iti72:1.1":"Vuttañhetaṃ bhagavatā, vuttamarahatāti me sutaṃ –","iti72:2.1":"“Tisso imā, bhikkhave, nissaraṇiyā [nissāraṇīyā (a. ni. 5.200)] dhātuyo.","iti72:2.2":"Katamā tisso?","iti72:2.3":"Kāmānametaṃ nissaraṇaṃ yadidaṃ nekkhammaṃ, rūpānametaṃ nissaraṇaṃ yadidaṃ āruppaṃ, yaṃ kho pana kiñci bhūtaṃ saṅkhataṃ paṭiccasamuppannaṃ nirodho tassa nissaraṇaṃ –","iti72:2.4":"imā kho, bhikkhave, tisso nissaraṇiyā dhātuyo”ti.","iti72:2.5":"Etamatthaṃ bhagavā avoca.","iti72:2.6":"Tatthetaṃ iti vuccati –","iti72:3.1":"“Kāmanissaraṇaṃ ñatvā,","iti72:3.2":"rūpānañca atikkamaṃ;","iti72:3.3":"Sabbasaṅkhārasamathaṃ,","iti72:3.4":"phusaṃ ātāpi sabbadā.","iti72:4.1":"“Sa ve sammaddaso bhikkhu,","iti72:4.2":"yato tattha vimuccati;","iti72:4.3":"Abhiññāvosito santo,","iti72:4.4":"sa ve yogātigo munī”ti.","iti72:5.1":"Ayampi attho vutto bhagavatā, iti me sutanti.","iti72:5.2":"Tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":{"book":"It-a","bookName":"Itivuttaka-aṭṭhakathā","vriCode":"s0504a.att","from":1064,"to":1070,"paras":[{"para":1064,"vripara":"72","refs":["iti72:2"],"lines":["Tatiye <b>nissaraṇiyā</b>ti nissaraṇapaṭisaṃyuttā.","<b>Dhātuyo</b>ti sattasuññasabhāvā.","<b>Kāmāna</b>nti kilesakāmānañceva vatthukāmānañca.","Atha vā <b>kāmāna</b>nti kilesakāmānaṃ.","Kilesakāmato hi nissaraṇā vatthukāmehipi nissaraṇaṃyeva hoti, na aññathā.","Vuttañhetaṃ –"],"lineRefs":[["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"]]},{"para":1065,"vripara":null,"refs":["iti72:2"],"lines":["“Na te kāmā yāni citrāni loke,"],"lineRefs":[["iti72:2"]]},{"para":1066,"vripara":null,"refs":["iti72:2"],"lines":["Saṅkapparāgo purisassa kāmo;"],"lineRefs":[["iti72:2"]]},{"para":1067,"vripara":null,"refs":["iti72:2"],"lines":["Tiṭṭhanti citrāni tatheva loke,"],"lineRefs":[["iti72:2"]]},{"para":1068,"vripara":null,"refs":["iti72:2"],"lines":["Athettha dhīrā vinayanti chanda”nti. (a. ni. 6.63);"],"lineRefs":[["iti72:2"]]},{"para":1069,"vripara":null,"refs":["iti72:2"],"lines":["<b>Nissaraṇa</b>nti apagamo.","<b>Nekkhamma</b>nti paṭhamajjhānaṃ, visesato taṃ asubhārammaṇaṃ daṭṭhabbaṃ.","Yo pana taṃ jhānaṃ pādakaṃ katvā saṅkhāre sammasitvā tatiyamaggaṃ patvā anāgāmimaggena nibbānaṃ sacchikaroti, tassa cittaṃ accantameva kāmehi nissaṭanti idaṃ ukkaṭṭhato kāmānaṃ nissaraṇaṃ veditabbaṃ.","<b>Rūpāna</b>nti rūpadhammānaṃ, visesena saddhiṃ ārammaṇehi kusalavipākakiriyābhedato sabbesaṃ rūpāvacaradhammānaṃ.","<b>Āruppa</b>nti arūpāvacarajjhānaṃ.","Keci pana “kāmāna”nti padassa “sabbesaṃ kāmāvacaradhammāna”nti atthaṃ vadanti.","“Nekkhamma”nti ca “pañca rūpāvacarajjhānānī”ti.","Taṃ aṭṭhakathāsu natthi, na yujjati ca.","<b>Bhūta</b>nti jātaṃ.","<b>Saṅkhata</b>nti samecca sambhuyya paccayehi kataṃ.","<b>Paṭiccasamuppanna</b>nti kāraṇato nibbattaṃ.","Tīhipi padehi tebhūmake dhamme anavasesato pariyādiyati.","<b>Nirodho</b>ti nibbānaṃ.","Ettha ca paṭhamāya dhātuyā kāmapariññā vuttā, dutiyāya rūpapariññā, tatiyāya sabbasaṅkhatapariññā sabbabhavasamatikkamo vutto."],"lineRefs":[["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"],["iti72:2"]]},{"para":1070,"vripara":null,"refs":["iti72:3"],"lines":["Gāthāsu <b>kāmanissaraṇaṃ ñatvā</b>ti “idaṃ kāmanissaraṇaṃ – evañca kāmato nissaraṇa”nti jānitvā.","Atikkamati etenāti atikkamo, atikkamanūpāyo, taṃ <b>atikkamaṃ</b> āruppaṃ ñatvā.","Sabbe saṅkhārā samanti vūpasamanti etthāti <b>sabbasaṅkhārasamatho,</b> nibbānaṃ, taṃ <b>phusaṃ</b> phusanto.","Sesaṃ heṭṭhā vuttanayameva."],"lineRefs":[["iti72:3"],["iti72:3"],["iti72:3"],["iti72:3"]]}],"wordLinks":[["iti72:2.1","nissaraṇiyā",0,0],["iti72:2.3","nissaraṇiyā",0,0],["iti72:2.1","dhātuyo",0,1],["iti72:2.3","dhātuyo",0,1],["iti72:2.3","kāmānaṃ",0,2],["iti72:2.3","kāmānaṃ",0,3],["iti72:2.3","nissaraṇaṃ",5,0],["iti72:2.3","nekkhammaṃ",5,1],["iti72:2.3","rūpānaṃ",5,3],["iti72:2.3","āruppaṃ",5,4],["iti72:2.3","bhūtaṃ",5,8],["iti72:2.3","saṅkhataṃ",5,9],["iti72:2.3","paṭiccasamuppannaṃ",5,10],["iti72:2.3","nirodho",5,12],["iti72:3.1","kāmanissaraṇaṃ ñatvā",6,0],["iti72:3.1","atikkamaṃ",6,1],["iti72:3.3","phusaṃ",6,2],["iti72:3.3","sabbasaṅkhārasamatho",6,2]],"after":[{"para":1071,"vripara":null,"title":"Nissaraṇiyasuttavaṇṇanā","lines":["Tatiyasuttavaṇṇanā niṭṭhitā. 4."]}]},"tika":null,"tika2":null}
