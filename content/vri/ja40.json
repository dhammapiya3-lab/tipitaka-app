{"suttaId":"ja40","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[221,228],"vripara":"40"},"segments":{"ja40:0.4":"Khadiraṅgārajātakaṃ","ja40:1.1":"Kāmaṃ patāmi nirayaṃ, uddhaṃpādo avaṃsiro;","ja40:1.3":"Nānariyaṃ karissāmi, handa piṇḍaṃ paṭiggahāti.","ja40:2.1":"Khadiraṅgārajātakaṃ dasamaṃ.","ja40:2.2":"Kulāvakavaggo catuttho.","ja40:3.1":"Tassuddānaṃ –","ja40:4.1":"Sirimātali dhītara pakkhivaro, ratiyāgato mātāpitā ca puna;","ja40:4.3":"Jagatīruha vuḍḍha sukakkaṭako, tathā nandakapiṇḍavarena dasāti."},"attha":null,"tika":null}
