{"suttaId":"sn11.19","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[3421,3434],"vripara":"265"},"segments":{"sn11.19:0.3":"Satthāravandanāsuttaṃ","sn11.19:1.1":"Sāvatthiyaṃ jetavane.","sn11.19:1.2":"“Bhūtapubbaṃ, bhikkhave, sakko devānamindo mātaliṃ saṅgāhakaṃ āmantesi –","sn11.19:1.3":"‘yojehi, samma mātali, sahassayuttaṃ ājaññarathaṃ, uyyānabhūmiṃ gacchāma subhūmiṃ dassanāyā’ti.","sn11.19:1.4":"‘Evaṃ bhaddantavā’ti kho, bhikkhave, mātali saṅgāhako sakkassa devānamindassa paṭissutvā sahassayuttaṃ ājaññarathaṃ yojetvā sakkassa devānamindassa paṭivedesi –","sn11.19:1.5":"‘yutto kho te, mārisa, sahassayutto ājaññaratho.","sn11.19:1.6":"Yassa dāni kālaṃ maññasī’”ti.","sn11.19:1.7":"Atha kho, bhikkhave, sakko devānamindo vejayantapāsādā orohanto añjaliṃ katvā sudaṃ bhagavantaṃ namassati.","sn11.19:1.8":"Atha kho, bhikkhave, mātali saṅgāhako sakkaṃ devānamindaṃ gāthāya ajjhabhāsi –","sn11.19:2.1":"“Yañhi devā manussā ca,","sn11.19:2.2":"taṃ namassanti vāsava;","sn11.19:2.3":"Atha ko nāma so yakkho,","sn11.19:2.4":"yaṃ tvaṃ sakka namassasī”ti.","sn11.19:3.1":"“Yo idha sammāsambuddho,","sn11.19:3.2":"asmiṃ loke sadevake;","sn11.19:3.3":"Anomanāmaṃ satthāraṃ,","sn11.19:3.4":"taṃ namassāmi mātali.","sn11.19:4.1":"“Yesaṃ rāgo ca doso ca,","sn11.19:4.2":"avijjā ca virājitā;","sn11.19:4.3":"Khīṇāsavā arahanto,","sn11.19:4.4":"te namassāmi mātali.","sn11.19:5.1":"“Ye rāgadosavinayā,","sn11.19:5.2":"avijjāsamatikkamā;","sn11.19:5.3":"Sekkhā apacayārāmā,","sn11.19:5.4":"appamattānusikkhare;","sn11.19:5.5":"Te namassāmi mātalī”ti.","sn11.19:6.1":"“Seṭṭhā hi kira lokasmiṃ,","sn11.19:6.2":"ye tvaṃ sakka namassasi;","sn11.19:6.3":"Ahampi te namassāmi,","sn11.19:6.4":"ye namassasi vāsavā”ti.","sn11.19:7.1":"“Idaṃ vatvāna maghavā,","sn11.19:7.2":"devarājā sujampati;","sn11.19:7.3":"Bhagavantaṃ namassitvā,","sn11.19:7.4":"pamukho rathamāruhī”ti."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1458,"to":1458,"paras":[{"para":1458,"vripara":"265","refs":["sn11.19:1","sn11.19:2","sn11.19:3","sn11.19:5"],"lines":["Navame <b>bhagavantaṃ namassatī</b>ti ekaṃsaṃ uttariyaṃ dukulaṃ katvā, brahmajāṇuko hutvā sirasi añjaliṃ ṭhapetvā namassati.","<b>So yakkho</b>ti so sakko.","<b>Anomanāman</b>ti sabbaguṇehi omakabhāvassa natthitāya sabbaguṇanemittakehi nāmehi anomanāmaṃ.","<b>Avijjāsamatikkamā</b>ti catusaccapaṭicchādikāya vaṭṭamūlakaavijjāya samatikkamena.","<b>Sekkhā</b>ti satta sekkhā.","<b>Apacayārāmā</b>ti vaṭṭaviddhaṃsane ratā.","<b>Sikkhare</b>ti sikkhanti.","Navamaṃ."],"lineRefs":[["sn11.19:1"],["sn11.19:2"],["sn11.19:3"],["sn11.19:5"],["sn11.19:5"],["sn11.19:5"],["sn11.19:5"],["sn11.19:5"]]}],"wordLinks":[["sn11.19:1.7","bhagavantaṃ namassatī",0,0],["sn11.19:2.3","so yakkho",0,1],["sn11.19:3.3","anomanāmaṃ",0,2],["sn11.19:5.1","avijjāsamatikkamā",0,3],["sn11.19:5.3","sekkhā",0,4],["sn11.19:5.3","apacayārāmā",0,5],["sn11.19:5.3","sikkhare",0,6]],"before":[{"para":1457,"vripara":null,"title":"Satthāravandanāsuttavaṇṇanā","lines":["Satthāravandanāsuttavaṇṇanā"]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1674,"to":1677,"paras":[{"para":1674,"vripara":"265","refs":["sn11.19:2"],"lines":["<b>Brahmajāṇuko</b>ti dakkhiṇajāṇumaṇḍalaṃ pathaviyaṃ ṭhapetvā vandamāno brahmajāṇuko nāma tathābhūto hutvā.","Yajitabbato <b>yakkho,</b> pūjanīyo.","Evaṃ pūjāvisesayogato sakkoti āha <b>“so yakkhoti so sakko”</b>ti.","Sakkassa namakkārabhājanabhūtañhi pucchanto mātali <b>“ko nāma so yakkho”</b>ti āha.","<b>Guṇanemittakehī</b>ti guṇahetukehi anantāni hi buddhānaṃ nāmāni, tāni ca kho sabbānipi guṇanemittakāneva.","Anantaguṇattā.","Vuttañhetaṃ –"],"lineRefs":[["sn11.19:2"],["sn11.19:2"],["sn11.19:2"],["sn11.19:2"],["sn11.19:2"],["sn11.19:2"],["sn11.19:2"]]},{"para":1675,"vripara":null,"refs":["sn11.19:2"],"lines":["“Asaṅkhyeyyāni nāmāni, saguṇena mahesino;"],"lineRefs":[["sn11.19:2"]]},{"para":1676,"vripara":null,"refs":["sn11.19:2"],"lines":["Guṇena nāmamuddheyyaṃ, api nāmasahassato”ti.","–"],"lineRefs":[["sn11.19:2"],["sn11.19:2"]]},{"para":1677,"vripara":null,"refs":["sn11.19:3","sn11.19:5"],"lines":["Tasmā <b>anomanāman</b>ti paripuṇṇaguṇanāmanti attho.","<b>Samatikkamenā</b>ti sammā samucchindanavasena atikkamanena.","Kilesārīnaṃ apetacayoti <b>apacayo,</b> so āramitabbaṭṭhena ārāmo etesanti <b>apacayārāmā</b>.","Tenāha <b>“vaṭṭaviddhaṃsane ratā”</b>ti."],"lineRefs":[["sn11.19:3"],["sn11.19:3"],["sn11.19:5"],["sn11.19:5"]]}],"wordLinks":[["sn11.19:2.3","yakkho",0,1],["sn11.19:2.3","ko nāma so yakkho",0,3],["sn11.19:3.3","anomanāmaṃ",3,0],["sn11.19:5.3","apacayo",3,2],["sn11.19:5.3","apacayārāmā",3,2]],"before":[{"para":1673,"vripara":null,"title":"Satthāravandanāsuttavaṇṇanā","lines":["Satthāravandanāsuttavaṇṇanā"]}],"after":[{"para":1678,"vripara":null,"title":"Satthāravandanāsuttavaṇṇanā","lines":["Satthāravandanāsuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
