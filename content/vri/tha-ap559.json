{"suttaId":"tha-ap559","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[6211,6225],"vripara":"93"},"segments":{"tha-ap559:0.3":"Aparauttarattheraapadānaṃ","tha-ap559:1.1":"“Nibbute lokanāthamhi, siddhatthe lokanāyake;","tha-ap559:1.3":"Mama ñātī samānetvā, dhātupūjaṃ akāsahaṃ.","tha-ap559:2.1":"“Catunnavutito kappe, yaṃ dhātumabhipūjayiṃ;","tha-ap559:2.3":"Duggatiṃ nābhijānāmi, dhātupūjāyidaṃ phalaṃ.","tha-ap559:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap559:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap559:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap559:6.1":"Itthaṃ sudaṃ āyasmā aparauttaratthero imā gāthāyo Abhāsitthāti.","tha-ap559:7.1":"Aparassa uttarattherassāpadānaṃ sattamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3822,"to":3822,"paras":[{"para":3822,"vripara":"93","refs":["tha-ap559:1"],"lines":["Arahattaṃ pana patvā somanassajāto attano pubbacaritāpadānaṃ pakāsento <b>nibbute lokanāthamhī</b>tiādimāha.","Taṃ sabbaṃ heṭṭhā vuttanayattā uttānatthamevāti."],"lineRefs":[["tha-ap559:1"],["tha-ap559:1"]]}],"wordLinks":[["tha-ap559:1.1","nibbute lokanāthamhī",0,0]]},"tika":null}
