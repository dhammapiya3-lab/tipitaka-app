{"suttaId":"sn11.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[3395,3404],"vripara":"263"},"segments":{"sn11.17:0.3":"Buddhavandanāsuttaṃ","sn11.17:1.1":"Sāvatthiyaṃ jetavane.","sn11.17:1.2":"Tena kho pana samayena bhagavā divāvihāragato hoti paṭisallīno.","sn11.17:1.3":"Atha kho sakko ca devānamindo brahmā ca sahampati yena bhagavā tenupasaṅkamiṃsu; upasaṅkamitvā paccekaṃ dvārabāhaṃ nissāya aṭṭhaṃsu.","sn11.17:1.4":"Atha kho sakko devānamindo bhagavato santike imaṃ gāthaṃ abhāsi –","sn11.17:2.1":"“Uṭṭhehi vīra vijitasaṅgāma,","sn11.17:2.2":"Pannabhāra anaṇa vicara loke;","sn11.17:2.3":"Cittañca te suvimuttaṃ,","sn11.17:2.4":"Cando yathā pannarasāya rattin”ti.","sn11.17:3.1":"“Na kho, devānaminda, tathāgatā evaṃ vanditabbā.","sn11.17:3.2":"Evañca kho, devānaminda, tathāgatā vanditabbā –","sn11.17:4.1":"“Uṭṭhehi vīra vijitasaṅgāma,","sn11.17:4.2":"Satthavāha anaṇa vicara loke;","sn11.17:4.3":"Desassu bhagavā dhammaṃ,","sn11.17:4.4":"Aññātāro bhavissantī”ti."},"unsure":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1454,"to":1454,"paras":[{"para":1454,"vripara":"263","refs":["sn11.17:2"],"lines":["Sattame <b>uṭṭhehī</b>ti uṭṭhaha, ghaṭa, vāyama.","<b>Vijitasaṅgāmā</b>ti rāgādīnañceva dvādasayojanikassa ca mārabalassa jitattā bhagavantaṃ evaṃ ālapati.","<b>Pannabhārā</b>ti oropitakhandhakilesābhisaṅkhārabhāra.","<b>Pannarasāya rattin</b>ti pannarasāya puṇṇamāya rattiṃ.","Sattamaṃ."],"lineRefs":[["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"]]}],"wordLinks":[["sn11.17:2.1","uṭṭhehī",0,0],["sn11.17:2.1","vijitasaṅgāmā",0,1],["sn11.17:2.2","pannabhārā",0,2],["sn11.17:2.4","pannarasāya rattiṃ",0,3]],"before":[{"para":1453,"vripara":null,"refs":[],"lines":["Buddhavandanāsuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1668,"to":1668,"paras":[{"para":1668,"vripara":"263","refs":["sn11.17:2"],"lines":["<b>Uṭṭhahā</b>ti uṭṭhānaṃ kāyikavīriyaṃ karohi.","Tenāha <b>“vicara, loke”</b>ti.","Cetasikavīriyaṃ pana bhagavatā matthakaṃ pāpitameva.","Tenāha <b>“vijitasaṅgāmā”</b>ti.","<b>Dvādasayojanikassa</b> uccabhāvena.","Vitthārato pana āyāmato ca anekayojanasatasahassaparimāṇacakkavāḷaṃ atibyāpetvā ṭhitassa.","<b>Pannabhārā</b>ti pātitabhāra.","Nikkhepitabbato bhārāti āha <b>“oropitakhandhā”</b>tiādi.","Te hi taṃsamaṅgino puggalassa sampātanaṭṭhena <b>bhārā</b> nāma.","Vuttañhetaṃ “bhārā have pañcakkhandhā”ti (saṃ. ni.3.22).","Tadekadesā ca <b>kilesābhisaṅkhārā.</b>","<b>Pannarasāya puṇṇamāya rattin</b>ti yathā pannarasapuṇṇamāya rattiyaṃ paripuṇṇakāle upakkilesavimutto cando sobhati, evaṃ tava cittaṃ sabbaso upakkilesavimuttaṃ sobhatīti adhippāyo."],"lineRefs":[["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"],["sn11.17:2"]]}],"wordLinks":[["sn11.17:2.2","vicara loke",0,1],["sn11.17:2.1","vijitasaṅgāmā",0,3],["sn11.17:2.2","pannabhārā",0,6],["sn11.17:2.2","bhārā",0,8]]},"tika2":null}
