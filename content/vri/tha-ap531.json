{"suttaId":"tha-ap531","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3697,3717],"vripara":"74"},"segments":{"tha-ap531:0.3":"Āmaṇḍaphaladāyakattheraapadānaṃ","tha-ap531:1.1":"“Padumuttaro nāma jino,","tha-ap531:1.2":"sabbadhammāna pāragū;","tha-ap531:1.3":"Vuṭṭhahitvā samādhimhā,","tha-ap531:1.4":"caṅkamī lokanāyako.","tha-ap531:2.1":"“Khāribhāraṃ gahetvāna,","tha-ap531:2.2":"āharanto phalaṃ tadā;","tha-ap531:2.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap531:2.4":"caṅkamantaṃ mahāmuniṃ.","tha-ap531:3.1":"“Pasannacitto sumano,","tha-ap531:3.2":"sire katvāna añjaliṃ;","tha-ap531:3.3":"Sambuddhaṃ abhivādetvā,","tha-ap531:3.4":"āmaṇḍamadadiṃ phalaṃ.","tha-ap531:4.1":"“Satasahassito kappe,","tha-ap531:4.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap531:4.3":"Duggatiṃ nābhijānāmi,","tha-ap531:4.4":"āmaṇḍassa idaṃ phalaṃ.","tha-ap531:5.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap531:5.3":"viharāmi anāsavo.","tha-ap531:6.1":"“Svāgataṃ vata me āsi … pe …","tha-ap531:6.3":"kataṃ buddhassa sāsanaṃ.","tha-ap531:7.1":"“Paṭisambhidā catasso … pe …","tha-ap531:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap531:8.1":"Itthaṃ sudaṃ āyasmā āmaṇḍaphaladāyako thero imā Gāthāyo abhāsitthāti.","tha-ap531:9.1":"Āmaṇḍaphaladāyakattherassāpadānaṃ navamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
