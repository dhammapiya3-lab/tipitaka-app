{"suttaId":"sn14.38","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[856,856],"vripara":"122"},"segments":{"sn14.38:0.3":"Dutiyasamaṇabrāhmaṇasuttaṃ","sn14.38:1.1":"Sāvatthiyaṃ viharati … pe …","sn14.38:1.2":"“catasso imā, bhikkhave, dhātuyo.","sn14.38:1.3":"Katamā catasso?","sn14.38:1.4":"Pathavīdhātu, āpodhātu, tejodhātu, vāyodhātu.","sn14.38:1.5":"Ye hi keci, bhikkhave, samaṇā vā brāhmaṇā vā imāsaṃ catunnaṃ dhātūnaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti … pe … pajānanti … pe …","sn14.38:1.8":"sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti.","sn14.38:1.9":"Navamaṃ."},"unsure":["sn14.38:1.5"],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":613,"to":618,"paras":[{"para":613,"vripara":"119-123","refs":["sn14.38:1"],"lines":["119-123. Chaṭṭhasattamesu vivaṭṭaṃ, avasāne tīsu catusaccamevāti.","Chaṭṭhādīni."],"lineRefs":[["sn14.38:1"],["sn14.38:1"]]},{"para":614,"vripara":null,"refs":["sn14.38:1"],"lines":["Catuttho vaggo."],"lineRefs":[["sn14.38:1"]]},{"para":615,"vripara":null,"refs":["sn14.38:1"],"lines":["Dhātusaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn14.38:1"]]},{"para":616,"vripara":null,"refs":["sn14.38:1"],"lines":["Anamataggasaṃyuttaṃ"],"lineRefs":[["sn14.38:1"]]},{"para":617,"vripara":null,"refs":["sn14.38:1"],"lines":["Paṭhamavaggo"],"lineRefs":[["sn14.38:1"]]},{"para":618,"vripara":null,"refs":["sn14.38:1"],"lines":["Tiṇakaṭṭhasuttavaṇṇanā"],"lineRefs":[["sn14.38:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":611,"to":618,"paras":[{"para":611,"vripara":"119-123","refs":["sn14.38:1"],"lines":["119-123. Chaṭṭhasattamesu vaṭṭavivaṭṭaṃ kathitaṃ.","Aṭṭhakathāyaṃ pana <b>“vivaṭṭaṃ kathitan”</b>ti vuttaṃ.","<b>Tīsu</b> suttesu.","<b>Catusaccamevā</b>ti cattāri saccāni samāhaṭāni catusaccanti tesaṃ ekajjhaṃ gahaṇaṃ, niyamo pana tabbinimuttassa paramatthassa abhāvato."],"lineRefs":[["sn14.38:1"],["sn14.38:1"],["sn14.38:1"],["sn14.38:1"]]},{"para":612,"vripara":null,"refs":["sn14.38:1"],"lines":["Abhinandasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn14.38:1"]]},{"para":613,"vripara":null,"refs":["sn14.38:1"],"lines":["Catutthavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn14.38:1"]]},{"para":614,"vripara":null,"refs":["sn14.38:1"],"lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"],"lineRefs":[["sn14.38:1"]]},{"para":615,"vripara":null,"refs":["sn14.38:1"],"lines":["Dhātusaṃyuttavaṇṇanāya līnatthappakāsanā samattā."],"lineRefs":[["sn14.38:1"]]},{"para":616,"vripara":null,"refs":["sn14.38:1"],"lines":["Anamataggasaṃyuttaṃ"],"lineRefs":[["sn14.38:1"]]},{"para":617,"vripara":null,"refs":["sn14.38:1"],"lines":["Paṭhamavaggo"],"lineRefs":[["sn14.38:1"]]},{"para":618,"vripara":null,"refs":["sn14.38:1"],"lines":["Tiṇakaṭṭhasuttavaṇṇanā"],"lineRefs":[["sn14.38:1"]]}],"wordLinks":[]},"tika2":null}
