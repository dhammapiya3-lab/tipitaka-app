{"suttaId":"an4.263","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1900,1905],"vripara":"263"},"segments":{"an4.263:0.3":"Kammasuttaṃ","an4.263:1.1":"“Catūhi, bhikkhave, dhammehi samannāgato bālo abyatto asappuriso khataṃ upahataṃ attānaṃ pariharati, sāvajjo ca hoti sānuvajjo viññūnaṃ, bahuñca apuññaṃ pasavati.","an4.263:1.2":"Katamehi catūhi?","an4.263:1.3":"Sāvajjena kāyakammena, sāvajjena vacīkammena, sāvajjena manokammena, sāvajjāya diṭṭhiyā –","an4.263:1.4":"imehi kho, bhikkhave, catūhi dhammehi samannāgato bālo abyatto asappuriso khataṃ upahataṃ attānaṃ pariharati, sāvajjo ca hoti sānuvajjo viññūnaṃ, bahuñca apuññaṃ pasavati.","an4.263:2.1":"“Catūhi, bhikkhave, dhammehi samannāgato paṇḍito viyatto sappuriso akkhataṃ anupahataṃ attānaṃ pariharati, anavajjo ca hoti ananuvajjo viññūnaṃ, bahuñca puññaṃ pasavati.","an4.263:2.2":"Katamehi catūhi?","an4.263:2.3":"Anavajjena kāyakammena, anavajjena vacīkammena, anavajjena manokammena, anavajjāya diṭṭhiyā –","an4.263:2.4":"imehi kho, bhikkhave, catūhi dhammehi samannāgato paṇḍito viyatto sappuriso akkhataṃ anupahataṃ attānaṃ pariharati, anavajjo ca hoti ananuvajjo viññūnaṃ, bahuñca puññaṃ pasavatī”ti.","an4.263:2.5":"Dasamaṃ.","an4.263:2.6":"Abhiññāvaggo chaṭṭho.","an4.263:3.0":"Tassuddānaṃ –","an4.263:3.1":"Abhiññā pariyesanā,","an4.263:3.2":"saṅgahaṃ mālukyaputto;","an4.263:3.3":"Kulaṃ dve ca ājānīyā,","an4.263:3.4":"balaṃ araññakammunāti. (27) 7."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1715,"to":1717,"paras":[{"para":1715,"vripara":"258-263","refs":["an4.263:1"],"lines":["Pañcame <b>ādhipacce ṭhapentī</b>ti bhaṇḍāgārikaṭṭhāne ṭhapenti.","Chaṭṭhe <b>vaṇṇasampanno</b>ti sarīravaṇṇena samannāgato.","<b>Balasampanno</b>ti kāyabalena samannāgato.","Bhikkhuvāre <b>vaṇṇasampanno</b>ti guṇavaṇṇena samannāgato.","<b>Balasampanno</b>ti vīriyabalena samannāgato.","<b>Javasampanno</b>ti ñāṇajavena samannāgato.","Sattamepi eseva nayo.","Sesamettha uttānamevāti."],"lineRefs":[["an4.263:1"],["an4.263:1"],["an4.263:1"],["an4.263:1"],["an4.263:1"],["an4.263:1"],["an4.263:1"],["an4.263:1"]]},{"para":1716,"vripara":null,"refs":["an4.263:1"],"lines":["Abhiññāvaggo chaṭṭho. (27) 7."],"lineRefs":[["an4.263:1"]]},{"para":1717,"vripara":null,"refs":["an4.263:1"],"lines":["Kammapathavaggavaṇṇanā 264-273."],"lineRefs":[["an4.263:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1920,"to":1920,"paras":[{"para":1920,"vripara":"257-263","refs":["an4.263:1"],"lines":["Catutthe <b>apasādetī</b>ti niggaṇhāti.","<b>Ussādetī</b>ti paggaṇhāti.","Apasādanākāraṃ ussādanākārañca vibhāvetuṃ <b>“katha”</b>ntiādi āraddhaṃ.","Pañcamādīni uttānāneva.","Sesaṃ suviññeyyameva."],"lineRefs":[["an4.263:1"],["an4.263:1"],["an4.263:1"],["an4.263:1"],["an4.263:1"]]}],"wordLinks":[],"after":[{"para":1921,"vripara":null,"title":"Mālukyaputtasuttādivaṇṇanā","lines":["Mālukyaputtasuttādivaṇṇanā niṭṭhitā."]},{"para":1922,"vripara":null,"title":"Mālukyaputtasuttādivaṇṇanā","lines":["Abhiññāvaggavaṇṇanā niṭṭhitā."]},{"para":1923,"vripara":null,"title":"Mālukyaputtasuttādivaṇṇanā","lines":["Iti manorathapūraṇiyā aṅguttaranikāya-aṭṭhakathāya"]},{"para":1924,"vripara":null,"title":"Mālukyaputtasuttādivaṇṇanā","lines":["Catukkanipātavaṇṇanāya anuttānatthadīpanā samattā."]},{"para":1925,"vripara":null,"title":"Mālukyaputtasuttādivaṇṇanā","lines":["Dutiyo bhāgo niṭṭhito."]}]},"tika2":null}
