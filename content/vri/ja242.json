{"suttaId":"ja242","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1663,1669],"vripara":"184"},"segments":{"ja242:0.4":"Sunakhajātakaṃ (2-10-2)","ja242:1.1":"Bālo vatāyaṃ sunakho,","ja242:1.2":"yo varattaṃ [yo ca yottaṃ (ka.)] na khādati;","ja242:1.3":"Bandhanā ca pamuñceyya,","ja242:1.4":"asito ca gharaṃ vaje.","ja242:2.1":"Aṭṭhitaṃ me manasmiṃ me,","ja242:2.2":"atho me hadaye kataṃ;","ja242:2.3":"Kālañca paṭikaṅkhāmi,","ja242:2.4":"yāva passupatū jano [pasupatujjano (syā. ka.)].","ja242:3.1":"Sunakhajātakaṃ dutiyaṃ."},"unsure":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1610,"to":1615,"paras":[{"para":1610,"vripara":null,"refs":["ja242:1"],"lines":["Tattha <b>pamuñceyyā</b>ti pamoceyya, ayameva vā pāṭho.","<b>Asito ca gharaṃ vaje</b>ti asito suhito hutvā attano vasanaṭṭhānaṃ gaccheyya."],"lineRefs":[["ja242:1"],["ja242:1"]]},{"para":1611,"vripara":null,"refs":["ja242:1"],"lines":["Taṃ sutvā sunakho dutiyaṃ gāthamāha –"],"lineRefs":[["ja242:1"]]},{"para":1613,"vripara":"185","refs":["ja242:1"],"lines":["“Aṭṭhitaṃ me manasmiṃ me, atho me hadaye kataṃ;"],"lineRefs":[["ja242:1"]]},{"para":1614,"vripara":null,"refs":["ja242:1"],"lines":["Kālañca paṭikaṅkhāmi, yāva passupatū jano”ti."],"lineRefs":[["ja242:1"]]},{"para":1615,"vripara":null,"refs":["ja242:2"],"lines":["Tattha <b>aṭṭhitaṃ me manasmiṃ me</b>ti yaṃ tumhe kathetha, taṃ mayā adhiṭṭhitameva, manasmiṃyeva me etaṃ.","<b>Atho me hadaye katan</b>ti atha ca pana me tumhākaṃ vacanaṃ hadaye katameva.","<b>Kālañca paṭikaṅkhāmī</b>ti kālaṃ paṭimānemi.","<b>Yāva passupatū jano</b>ti yāvāyaṃ mahājano pasupatu niddaṃ okkamatu, tāvāhaṃ kālaṃ paṭimānemi.","Itarathā hi “ayaṃ sunakho palāyatī”ti ravo uppajjeyya, tasmā rattibhāge sabbesaṃ suttakāle cammayottaṃ khāditvā palāyissāmīti.","So evaṃ vatvā mahājane niddaṃ okkante yottaṃ khāditvā suhito hutvā palāyitvā attano sāmikānaṃ gharameva gato."],"lineRefs":[["ja242:2"],["ja242:2"],["ja242:2"],["ja242:2"],["ja242:2"],["ja242:2"]]}],"wordLinks":[["ja242:1.3","pamuñceyyā",0,0],["ja242:1.3","asito ca gharaṃ vaje",0,1],["ja242:2.1","aṭṭhitaṃ me manasmiṃ me",4,0],["ja242:2.1","atho me hadaye kataṃ",4,1],["ja242:2.3","kālañca paṭikaṅkhāmī",4,2],["ja242:2.3","yāva passupatū jano",4,3]]},"tika":null,"tika2":null}
