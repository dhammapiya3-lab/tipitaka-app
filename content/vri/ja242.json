{"suttaId":"ja242","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1663,1669],"vripara":"184"},"segments":{"ja242:0.4":"Sunakhajātakaṃ (2-10-2)","ja242:1.1":"Bālo vatāyaṃ sunakho,","ja242:1.2":"yo varattaṃ [yo ca yottaṃ (ka.)] na khādati;","ja242:1.3":"Bandhanā ca pamuñceyya,","ja242:1.4":"asito ca gharaṃ vaje. 185.","ja242:2.1":"Aṭṭhitaṃ me manasmiṃ me,","ja242:2.2":"atho me hadaye kataṃ;","ja242:2.3":"Kālañca paṭikaṅkhāmi,","ja242:2.4":"yāva passupatū jano [pasupatujjano (syā. ka.)].","ja242:3.1":"Sunakhajātakaṃ dutiyaṃ. 243."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1610,"to":1615,"paras":[{"para":1610,"vripara":null,"refs":["ja242:1"],"lines":["Tattha <b>pamuñceyyā</b>ti pamoceyya, ayameva vā pāṭho.","<b>Asito ca gharaṃ vaje</b>ti asito suhito hutvā attano vasanaṭṭhānaṃ gaccheyya."],"lineRefs":[["ja242:1"],["ja242:1"]]},{"para":1611,"vripara":null,"refs":["ja242:1"],"lines":["Taṃ sutvā sunakho dutiyaṃ gāthamāha – 185."],"lineRefs":[["ja242:1"]]},{"para":1613,"vripara":"185","refs":["ja242:1"],"lines":["“Aṭṭhitaṃ me manasmiṃ me, atho me hadaye kataṃ;"],"lineRefs":[["ja242:1"]]},{"para":1614,"vripara":null,"refs":["ja242:1"],"lines":["Kālañca paṭikaṅkhāmi, yāva passupatū jano”ti."],"lineRefs":[["ja242:1"]]},{"para":1615,"vripara":null,"refs":["ja242:2"],"lines":["Tattha <b>aṭṭhitaṃ me manasmiṃ me</b>ti yaṃ tumhe kathetha, taṃ mayā adhiṭṭhitameva, manasmiṃyeva me etaṃ.","<b>Atho me hadaye kata</b>nti atha ca pana me tumhākaṃ vacanaṃ hadaye katameva.","<b>Kālañca paṭikaṅkhāmī</b>ti kālaṃ paṭimānemi.","<b>Yāva passupatū jano</b>ti yāvāyaṃ mahājano pasupatu niddaṃ okkamatu, tāvāhaṃ kālaṃ paṭimānemi.","Itarathā hi “ayaṃ sunakho palāyatī”ti ravo uppajjeyya, tasmā rattibhāge sabbesaṃ suttakāle cammayottaṃ khāditvā palāyissāmīti.","So evaṃ vatvā mahājane niddaṃ okkante yottaṃ khāditvā suhito hutvā palāyitvā attano sāmikānaṃ gharameva gato."],"lineRefs":[["ja242:2"],["ja242:2"],["ja242:2"],["ja242:2"],["ja242:2"],["ja242:2"]]}],"wordLinks":[["ja242:1.3","pamuñceyyā",0,0],["ja242:1.3","asito ca gharaṃ vaje",0,1],["ja242:2.1","aṭṭhitaṃ me manasmiṃ me",4,0],["ja242:2.1","atho me hadaye kataṃ",4,1],["ja242:2.3","kālañca paṭikaṅkhāmī",4,2],["ja242:2.3","yāva passupatū jano",4,3]]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":872,"to":874,"paras":[{"para":872,"vripara":null,"refs":["ja242:1"],"lines":["2-sunakhajātakavaṇṇanā (242)"],"lineRefs":[["ja242:1"]]},{"para":873,"vripara":null,"refs":["ja242:1"],"lines":["<b>ambaṇakoṭṭhake</b>ti suvānakoṭṭhake ālindakoṭṭhake.","suvānā hi dvārakoṭṭhakānaṃ ālinde vasanti.","suvānaṃ?","ālindaṃ pana ambaṇanti vuccati.","<b>āsanasālāya</b>nti bhattabhuñjanasālāyaṃ.","bhattaggeti attho.","<b>pānīyahārikā</b>ti pānīyaṃ harantā.","vighāsādāti attho.","<b>gaddūlenā</b>ti sunakhānaṃ yottena.","taṃ hi gaddeti bandhati etenāti gaddūloti vuccati.","<b>na vassī</b>ti na saddaṃ akāsi.","<b>suhito</b>ti sukhito.","<b>adhiṭṭhitaṃ me</b>tiadhiṭṭhitaṃ mayāti attho.","<b>manasmiṃ me</b>ti mayhaṃ manasmiṃ etaṃ adhiṭṭhitanti attho.","tenāha — “adhiṭṭhitaṃ me manasmiṃ meti yaṃ tumhe”tiādi.","<b>itarathā</b>ti aññathā kālaṃ apatimānetvā palāyante.","<b>vippajje-yyā</b>ti vippattiṃ āpajjeyyāti."],"lineRefs":[["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"],["ja242:1"]]},{"para":874,"vripara":null,"refs":["ja242:1"],"lines":["ending sunakhajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja242:1"]]}],"wordLinks":[]},"tika2":null}
