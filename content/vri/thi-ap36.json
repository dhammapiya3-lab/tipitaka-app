{"suttaId":"thi-ap36","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[10385,10458],"vripara":"143"},"segments":{"thi-ap36:0.3":"Abhirūpanandātherīapadānaṃ","thi-ap36:1.1":"“Ekanavutito kappe,","thi-ap36:1.2":"vipassī nāma nāyako;","thi-ap36:1.3":"Uppajji cārudassano,","thi-ap36:1.4":"sabbadhammesu cakkhumā.","thi-ap36:2.1":"“Tadāhaṃ bandhumatiyaṃ,","thi-ap36:2.2":"iddhe phīte mahākule;","thi-ap36:2.3":"Jātā surūpā dayitā,","thi-ap36:2.4":"pūjanīyā janassa ca.","thi-ap36:3.1":"“Upagantvā mahāvīraṃ,","thi-ap36:3.2":"vipassiṃ lokanāyakaṃ;","thi-ap36:3.3":"Dhammaṃ suṇitvā saraṇaṃ,","thi-ap36:3.4":"upesiṃ naranāyakaṃ.","thi-ap36:4.1":"“Sīlesu saṃvutā hutvā,","thi-ap36:4.2":"nibbute ca naruttame;","thi-ap36:4.3":"Dhātuthūpassa upari,","thi-ap36:4.4":"soṇṇacchattamapūjayiṃ.","thi-ap36:5.1":"“Muttacāgā sīlavatī,","thi-ap36:5.2":"yāvajīvaṃ tato cutā;","thi-ap36:5.3":"Jahitvā mānusaṃ dehaṃ,","thi-ap36:5.4":"tāvatiṃsūpagā ahaṃ.","thi-ap36:6.1":"“Tadā dasahi ṭhānehi,","thi-ap36:6.2":"adhibhotvāna sesake [adhibhotvā asesato (syā.)];","thi-ap36:6.3":"Rūpasaddehi gandhehi,","thi-ap36:6.4":"rasehi phusanehi ca.","thi-ap36:7.1":"“Āyunāpi ca vaṇṇena,","thi-ap36:7.2":"sukhena yasasāpi ca;","thi-ap36:7.3":"Tathevādhipateyyena,","thi-ap36:7.4":"adhigayha virocahaṃ.","thi-ap36:8.1":"“Pacchime ca bhave dāni,","thi-ap36:8.2":"jātāhaṃ kapilavhaye;","thi-ap36:8.3":"Dhītā khemakasakkassa,","thi-ap36:8.4":"nandā nāmāti vissutā.","thi-ap36:9.1":"“Abhirūpasampadampi [abhirupaṃ upapadaṃ (sī.), abhirupaṃ uppādaṃ (pī.)],","thi-ap36:9.2":"ahu me kantisūcakaṃ;","thi-ap36:9.3":"Yadāhaṃ yobbanappattā,","thi-ap36:9.4":"rūpalāvaññabhūsitā.","thi-ap36:10.1":"“Tadā [tadā mamatthaṃ (sī.), idha mamatte (syā. ka.)] matthe sakyānaṃ,","thi-ap36:10.2":"vivādo sumahā ahu;","thi-ap36:10.3":"Pabbājesi tato tāto,","thi-ap36:10.4":"mā sakyā vinassiṃsuti.","thi-ap36:11.1":"“Pabbajitvā tathāgataṃ,","thi-ap36:11.2":"rūpadessiṃ naruttamaṃ;","thi-ap36:11.3":"Sutvāna nopagacchāmi,","thi-ap36:11.4":"mama rūpena gabbitā.","thi-ap36:12.1":"“Ovādampi na gacchāmi,","thi-ap36:12.2":"buddhadassanabhīrutā;","thi-ap36:12.3":"Tadā jino upāyena,","thi-ap36:12.4":"upanetvā sasantikaṃ.","thi-ap36:13.1":"“Tissitthiyo [tisso thīyo (sī. pī.)] nidassesi,","thi-ap36:13.2":"iddhiyā maggakovido;","thi-ap36:13.3":"Accharārūpasadisaṃ,","thi-ap36:13.4":"taruṇiṃ jaritaṃ [jarikaṃ (syā. ka.)] mataṃ.","thi-ap36:14.1":"“Tāyo disvā susaṃviggā,","thi-ap36:14.2":"virattāse kaḷevare;","thi-ap36:14.3":"Aṭṭhāsiṃ bhavanibbindā,","thi-ap36:14.4":"tadā maṃ āha nāyako.","thi-ap36:15.1":"“‘Āturaṃ asuciṃ pūtiṃ,","thi-ap36:15.2":"passa nande samussayaṃ;","thi-ap36:15.3":"Uggharantaṃ paggharantaṃ,","thi-ap36:15.4":"bālānaṃ abhinanditaṃ.","thi-ap36:16.1":"“‘Asubhāya cittaṃ bhāvehi,","thi-ap36:16.2":"ekaggaṃ susamāhitaṃ;","thi-ap36:16.3":"Yathā idaṃ tathā etaṃ,","thi-ap36:16.4":"yathā etaṃ tathā idaṃ.","thi-ap36:17.1":"“‘Evametaṃ avekkhantī,","thi-ap36:17.2":"rattindivamatanditā;","thi-ap36:17.3":"Tato sakāya paññāya,","thi-ap36:17.4":"abhinibbijjha vacchasi’.","thi-ap36:18.1":"“Tassā me appamattāya,","thi-ap36:18.2":"vicarantiyā [vicarantvādha (sī.), vicinantīdha (syā. pī.)] yoniso;","thi-ap36:18.3":"Yathābhūtaṃ ayaṃ kāyo,","thi-ap36:18.4":"diṭṭho santarabāhiro.","thi-ap36:19.1":"“Atha nibbindahaṃ kāye,","thi-ap36:19.2":"ajjhattañca virajjahaṃ;","thi-ap36:19.3":"Appamattā visaṃyuttā,","thi-ap36:19.4":"upasantāmhi nibbutā.","thi-ap36:20.1":"“Iddhīsu ca vasī homi,","thi-ap36:20.2":"dibbāya sotadhātuyā;","thi-ap36:20.3":"Cetopariyañāṇassa,","thi-ap36:20.4":"vasī homi mahāmune.","thi-ap36:21.1":"“Pubbenivāsaṃ jānāmi,","thi-ap36:21.2":"dibbacakkhu visodhitaṃ;","thi-ap36:21.3":"Sabbāsavaparikkhīṇā,","thi-ap36:21.4":"natthi dāni punabbhavo.","thi-ap36:22.1":"“Atthadhammaniruttīsu,","thi-ap36:22.2":"paṭibhāne tatheva ca;","thi-ap36:22.3":"Ñāṇaṃ mama mahāvīra,","thi-ap36:22.4":"uppannaṃ tava santike.","thi-ap36:23.1":"“Kilesā jhāpitā mayhaṃ … pe …","thi-ap36:23.3":"viharāmi anāsavā.","thi-ap36:24.1":"“Svāgataṃ vata me āsi … pe …","thi-ap36:24.3":"kataṃ buddhassa sāsanaṃ.","thi-ap36:25.1":"“Paṭisambhidā catasso … pe …","thi-ap36:25.3":"kataṃ buddhassa sāsanaṃ”.","thi-ap36:26.1":"Itthaṃ sudaṃ abhirūpanandā bhikkhunī imā gāthāyo abhāsitthāti.","thi-ap36:27.1":"Abhirūpanandātheriyāpadānaṃ chaṭṭhaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":1465,"to":1561,"paras":[{"para":1465,"vripara":"143","refs":["thi-ap36:1"],"lines":["“Asakkharā apabbhārā, sādu appaṭigandhikā;"],"lineRefs":[["thi-ap36:1"]]},{"para":1466,"vripara":null,"refs":["thi-ap36:1"],"lines":["Sandatī nadikā tattha, sobhayantā mamassamaṃ”."],"lineRefs":[["thi-ap36:1"]]},{"para":1467,"vripara":null,"refs":["thi-ap36:1"],"lines":["Tattha <b>asakkharā</b>ti “pulinākiṇṇā”ti vuttattā asakkharā sakkharavirahitā.","<b>Apabbhārā</b>ti pabbhāravirahitā, agambhīrakūlāti attho.","<b>Sādu appaṭigandhikā</b>ti sādurasodakā duggandharahitā mayhaṃ assamapadaṃ sobhayantī <b>nadikā</b> khuddakanadī <b>sandati</b> pavattatīti attho."],"lineRefs":[["thi-ap36:1"],["thi-ap36:1"],["thi-ap36:1"]]},{"para":1469,"vripara":"144","refs":["thi-ap36:2"],"lines":["“Kumbhīlā makarā cettha, susumārā ca kacchapā;"],"lineRefs":[["thi-ap36:2"]]},{"para":1470,"vripara":null,"refs":["thi-ap36:2"],"lines":["Sandati nadikā tattha, sobhayantā mamassamaṃ”."],"lineRefs":[["thi-ap36:2"]]},{"para":1471,"vripara":null,"refs":["thi-ap36:2"],"lines":["Tattha <b>kumbhīla</b> macchā <b>makara</b> macchā ca <b>susumārā</b> caṇḍamacchā ca <b>kacchapa</b> macchā ca <b>ettha</b> etissaṃ nadiyaṃ kīḷantā ahesunti sambandho.","Mamassamaṃ sobhayantā <b>nadikā</b> khuddakanadī <b>sandati</b> pavattatīti sambandho."],"lineRefs":[["thi-ap36:2"],["thi-ap36:2"]]},{"para":1473,"vripara":"145","refs":["thi-ap36:3"],"lines":["“Pāṭhīnā pāvusā macchā, balajā muñjarohitā;"],"lineRefs":[["thi-ap36:3"]]},{"para":1474,"vripara":null,"refs":["thi-ap36:3"],"lines":["Vaggaḷā papatāyantā, sobhayanti mamassamaṃ”."],"lineRefs":[["thi-ap36:3"]]},{"para":1475,"vripara":null,"refs":["thi-ap36:3"],"lines":["<b>Pāṭhīna</b> macchā ca <b>pāvusā macchā</b> ca <b>balaja</b> macchā ca <b>muñja</b> macchā <b>rohita</b> macchā ca <b>vaggaḷa</b> macchā ca ete sabbe macchajātikā ito cito ca <b>papatāyantā</b> nadiyā saddhiṃ pavattantā mama assamapadaṃ sobhayantīti attho."],"lineRefs":[["thi-ap36:3"]]},{"para":1477,"vripara":"146","refs":["thi-ap36:4"],"lines":["“Ubho kūlesu nadiyā, pupphino phalino dumā;"],"lineRefs":[["thi-ap36:4"]]},{"para":1478,"vripara":null,"refs":["thi-ap36:4"],"lines":["Ubhato abhilambantā, sobhayanti mamassamaṃ”."],"lineRefs":[["thi-ap36:4"]]},{"para":1479,"vripara":null,"refs":["thi-ap36:4"],"lines":["Tattha <b>ubho kūlesū</b>ti tassā nadiyā ubhosu passesu dhuva <b>pupphino</b> dhuva <b>phalino</b> rukkhā <b>ubhato abhilambantā</b> nadiyā ubho tīre heṭṭhā onamantā mama assamaṃ sobhayantīti attho."],"lineRefs":[["thi-ap36:4"]]},{"para":1481,"vripara":"147","refs":["thi-ap36:5"],"lines":["“Ambā sālā ca tilakā, pāṭalī sinduvārakā;"],"lineRefs":[["thi-ap36:5"]]},{"para":1482,"vripara":null,"refs":["thi-ap36:5"],"lines":["Dibbagandhā sampavanti, pupphitā mama assame”."],"lineRefs":[["thi-ap36:5"]]},{"para":1483,"vripara":null,"refs":["thi-ap36:5"],"lines":["Tattha <b>ambā</b>ti madhupiṇḍiambā ca <b>sāla</b> rukkhā ca <b>tilaka</b> rukkhā ca <b>pāṭali</b> rukkhā ca <b>sinduvāraka</b> rukkhā ca ete rukkhā niccakālaṃ <b>pupphitā</b> pupphantā.","Dibbā gandhā iva mama assame sugandhā <b>sampavanti</b> samantato pavāyantīti attho."],"lineRefs":[["thi-ap36:5"],["thi-ap36:5"]]},{"para":1485,"vripara":"148","refs":["thi-ap36:6"],"lines":["“Campakā saḷalā nīpā, nāgapunnāgaketakā;"],"lineRefs":[["thi-ap36:6"]]},{"para":1486,"vripara":null,"refs":["thi-ap36:6"],"lines":["Dibbagandhā sampavanti, pupphitā mama assame”."],"lineRefs":[["thi-ap36:6"]]},{"para":1487,"vripara":null,"refs":["thi-ap36:6"],"lines":["Tattha <b>campaka</b> rukkhā ca <b>saḷala</b> rukkhā ca suvaṇṇavaṭṭalasadisapupphā <b>nīpa</b> rukkhā ca <b>nāga</b> rukkhā ca <b>punnāga</b> rukkhā ca sugandhayantā <b>ketaka</b> rukkhā ca ete sabbe rukkhā dibbā gandhāriva mama assame <b>pupphitā</b> phullitā <b>sampavanti</b> sugandhaṃ suṭṭhu pavāyantīti attho."],"lineRefs":[["thi-ap36:6"]]},{"para":1489,"vripara":"149","refs":["thi-ap36:7"],"lines":["Asokā ca “adhimuttā asokā ca, bhaginīmālā ca pupphitā;"],"lineRefs":[["thi-ap36:7"]]},{"para":1490,"vripara":null,"refs":["thi-ap36:7"],"lines":["Aṅkolā bimbijālā ca, pupphitā mama assame”."],"lineRefs":[["thi-ap36:7"]]},{"para":1491,"vripara":null,"refs":["thi-ap36:7"],"lines":["Tattha pupphitā <b>adhimuttaka</b> rukkhā ca pupphitā <b>asoka</b> rukkhā ca pupphitā <b>bhaginīmālā ca</b> pupphitā <b>aṅkolā</b> ca pupphitā <b>bimbijālā</b> ca ete rukkhā mama assame phullitā sobhayantīti sambandho."],"lineRefs":[["thi-ap36:7"]]},{"para":1493,"vripara":"150","refs":["thi-ap36:8"],"lines":["“Ketakā kandali ceva, godhukā tiṇasūlikā;"],"lineRefs":[["thi-ap36:8"]]},{"para":1494,"vripara":null,"refs":["thi-ap36:8"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["thi-ap36:8"]]},{"para":1495,"vripara":null,"refs":["thi-ap36:8"],"lines":["Tattha <b>ketakā</b>ti sugandhaketakagacchā ca.","<b>Kandali</b> rukkhā ca <b>godhuka</b> rukkhā ca <b>tiṇasūlika</b> gacchā ca ete sabbe rukkhajātikā dibbagandhaṃ pavāyamānā mama assamaṃ sakalaṃ sobhayantīti attho."],"lineRefs":[["thi-ap36:8"],["thi-ap36:8"]]},{"para":1497,"vripara":"151","refs":["thi-ap36:9"],"lines":["“Kaṇikārā kaṇṇikā ca, asanā ajjunā bahū;"],"lineRefs":[["thi-ap36:9"]]},{"para":1498,"vripara":null,"refs":["thi-ap36:9"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["thi-ap36:9"]]},{"para":1499,"vripara":null,"refs":["thi-ap36:9"],"lines":["Ete kaṇikārādayo rukkhā mama assamaṃ sakalaṃ sobhayantā dibbagandhaṃ sampavāyantīti sambandho."],"lineRefs":[["thi-ap36:9"]]},{"para":1501,"vripara":"152","refs":["thi-ap36:10"],"lines":["“Punnāgā giripunnāgā, koviḷārā ca pupphitā;"],"lineRefs":[["thi-ap36:10"]]},{"para":1502,"vripara":null,"refs":["thi-ap36:10"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["thi-ap36:10"]]},{"para":1503,"vripara":null,"refs":["thi-ap36:10"],"lines":["Punnāgādayo rukkhā dibbagandhaṃ pavāyamānā mama assamaṃ sobhayantīti attho."],"lineRefs":[["thi-ap36:10"]]},{"para":1505,"vripara":"153","refs":["thi-ap36:11"],"lines":["“Uddālakā ca kuṭajā, kadambā vakulā bahū;"],"lineRefs":[["thi-ap36:11"]]},{"para":1506,"vripara":null,"refs":["thi-ap36:11"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["thi-ap36:11"]]},{"para":1507,"vripara":null,"refs":["thi-ap36:11"],"lines":["Uddālakādayo rukkhā dibbagandhaṃ vāyamānā mama assamaṃ sobhayantīti sambandho."],"lineRefs":[["thi-ap36:11"]]},{"para":1509,"vripara":"154","refs":["thi-ap36:12"],"lines":["“Āḷakā isimuggā ca, kadalimātuluṅgiyo;"],"lineRefs":[["thi-ap36:12"]]},{"para":1510,"vripara":null,"refs":["thi-ap36:12"],"lines":["Gandhodakena saṃvaḍḍhā, phalāni dhārayanti te”."],"lineRefs":[["thi-ap36:12"]]},{"para":1511,"vripara":null,"refs":["thi-ap36:12"],"lines":["Tattha ete āḷakādayo gacchā candanādisugandhagandhodakena vaḍḍhitvā suvaṇṇaphalāni dhārentā mama assamaṃ sobhayantīti attho."],"lineRefs":[["thi-ap36:12"]]},{"para":1513,"vripara":"155","refs":["thi-ap36:13"],"lines":["“Aññe pupphanti padumā, aññe jāyanti kesarī;"],"lineRefs":[["thi-ap36:13"]]},{"para":1514,"vripara":null,"refs":["thi-ap36:13"],"lines":["Aññe opupphā padumā, pupphitā taḷāke tadā”."],"lineRefs":[["thi-ap36:13"]]},{"para":1515,"vripara":null,"refs":["thi-ap36:13"],"lines":["Tattha <b>aññe pupphanti padumā</b>ti mama assamassa avidūre taḷāke aññe ekacce padumā pupphanti, ekacce <b>kesarī</b> padumā <b>jāyanti</b> nibbattanti, ekacce padumā <b>opupphā</b> vigalitapattakesarāti attho."],"lineRefs":[["thi-ap36:13"]]},{"para":1517,"vripara":"156","refs":["thi-ap36:14"],"lines":["“Gabbhaṃ gaṇhanti padumā, niddhāvanti muḷāliyo;"],"lineRefs":[["thi-ap36:14"]]},{"para":1518,"vripara":null,"refs":["thi-ap36:14"],"lines":["Siṅghāṭipattamākiṇṇā, sobhanti taḷāke tadā”."],"lineRefs":[["thi-ap36:14"]]},{"para":1519,"vripara":null,"refs":["thi-ap36:14"],"lines":["Tattha <b>gabbhaṃ gaṇhanti padumā</b>ti tadā tāpasena hutvā mama vasanasamaye ekacce padumā taḷākabbhantare makuḷapupphādayo gaṇhanti.","<b>Muḷāliyo</b> padumamūlā <b>niddhāvanti</b> ito kaddamabbhantarato hatthidāṭhā viya gacchantīti attho.","Pattapupphamākiṇṇā gahanībhūtā siṅghāṭiyo sobhayantīti attho."],"lineRefs":[["thi-ap36:14"],["thi-ap36:14"],["thi-ap36:14"]]},{"para":1521,"vripara":"157","refs":["thi-ap36:15"],"lines":["“Nayitā ambagandhī ca, uttalī bandhujīvakā;"],"lineRefs":[["thi-ap36:15"]]},{"para":1522,"vripara":null,"refs":["thi-ap36:15"],"lines":["Dibbagandhā sampavanti, pupphitā taḷāke tadā”."],"lineRefs":[["thi-ap36:15"]]},{"para":1523,"vripara":null,"refs":["thi-ap36:15"],"lines":["<b>Tadā</b> mama vasanasamaye taḷākassa samīpe <b>nayitā</b> ca gacchā <b>ambagandhī ca</b> gacchā <b>uttalī</b> nāma gacchā ca <b>bandhujīvakā</b> ca ete sabbe gacchā <b>pupphitā</b> pupphadhāritā sugandhavāhakā taḷākaṃ sobhayantīti attho."],"lineRefs":[["thi-ap36:15"]]},{"para":1525,"vripara":"158","refs":["thi-ap36:16"],"lines":["“Pāṭhīnā pāvusā macchā, balajā muñjarohitā;"],"lineRefs":[["thi-ap36:16"]]},{"para":1526,"vripara":null,"refs":["thi-ap36:16"],"lines":["Saṃgulā maggurā ceva, vasanti taḷāke tadā”."],"lineRefs":[["thi-ap36:16"]]},{"para":1527,"vripara":null,"refs":["thi-ap36:16"],"lines":["<b>Tadā</b> mama vasanasamaye nibbhītā pāṭhīnādayo macchā <b>taḷāke</b> vasantīti sambandho."],"lineRefs":[["thi-ap36:16"]]},{"para":1529,"vripara":"159","refs":["thi-ap36:17"],"lines":["“Kumbhīlā susumārā ca, tantigāhā ca rakkhasā;"],"lineRefs":[["thi-ap36:17"]]},{"para":1530,"vripara":null,"refs":["thi-ap36:17"],"lines":["Oguhā ajagarā ca, vasanti taḷāke tadā”."],"lineRefs":[["thi-ap36:17"]]},{"para":1531,"vripara":null,"refs":["thi-ap36:17"],"lines":["<b>Tadā</b> mama vasanasamaye mama assamasamīpe <b>taḷāke</b> ete kumbhīlādayo macchā nibbhītā nirūpaddavā vasantīti sambandho."],"lineRefs":[["thi-ap36:17"]]},{"para":1533,"vripara":"160","refs":["thi-ap36:18"],"lines":["“Pārevatā ravihaṃsā, cakkavākā nadīcarā;"],"lineRefs":[["thi-ap36:18"]]},{"para":1534,"vripara":null,"refs":["thi-ap36:18"],"lines":["Kokilā sukasāḷikā, upajīvanti taṃ saraṃ”."],"lineRefs":[["thi-ap36:18"]]},{"para":1535,"vripara":null,"refs":["thi-ap36:18"],"lines":["Tattha mama assamasamīpe saraṃ nissāya <b>pārevatā</b> pakkhī ca <b>ravihaṃsā</b> pakkhī ca <b>nadīcarā cakkavāka</b> pakkhī ca <b>kokilā</b> pakkhī ca <b>suka</b> pakkhī ca <b>sāḷikā</b> pakkhī ca taṃ saraṃ upanissāya jīvantīti sambandho."],"lineRefs":[["thi-ap36:18"]]},{"para":1537,"vripara":"161","refs":["thi-ap36:19"],"lines":["“Kukutthakā kuḷīrakā, vane pokkharasātakā;"],"lineRefs":[["thi-ap36:19"]]},{"para":1538,"vripara":null,"refs":["thi-ap36:19"],"lines":["Dindibhā suvapotā ca, upajīvanti taṃ saraṃ”."],"lineRefs":[["thi-ap36:19"]]},{"para":1539,"vripara":null,"refs":["thi-ap36:19"],"lines":["Tattha <b>kukutthakā</b>ti evaṃnāmikā pakkhī ca.","<b>Kuḷīrakā</b>ti evaṃnāmikā pakkhī ca.","Vane <b>pokkharasātakā</b> pakkhī ca <b>dindibhā</b> pakkhī ca <b>suvapotā</b> pakkhī ca ete sabbe pakkhino taṃ mama assamasamīpe saraṃ nissāya jīvantīti sambandho."],"lineRefs":[["thi-ap36:19"],["thi-ap36:19"],["thi-ap36:19"]]},{"para":1541,"vripara":"162","refs":["thi-ap36:20"],"lines":["“Haṃsā koñcā mayūrā ca, kokilā tambacūḷakā;"],"lineRefs":[["thi-ap36:20"]]},{"para":1542,"vripara":null,"refs":["thi-ap36:20"],"lines":["Pammakā jīvaṃjīvā ca, upajīvanti taṃ saraṃ”."],"lineRefs":[["thi-ap36:20"]]},{"para":1543,"vripara":null,"refs":["thi-ap36:20"],"lines":["Sabbe ete haṃsādayo pakkhino taṃ saraṃ upanissāya jīvanti jīvikaṃ pālentīti attho."],"lineRefs":[["thi-ap36:20"]]},{"para":1545,"vripara":"163","refs":["thi-ap36:21"],"lines":["“Kosikā poṭṭhasīsā ca, kurarā senakā bahū;"],"lineRefs":[["thi-ap36:21"]]},{"para":1546,"vripara":null,"refs":["thi-ap36:21"],"lines":["Mahākāḷā ca sakuṇā, upajīvanti taṃ saraṃ”."],"lineRefs":[["thi-ap36:21"]]},{"para":1547,"vripara":null,"refs":["thi-ap36:21"],"lines":["Tattha <b>kosikā</b> ca pakkhī <b>poṭṭhasīsā</b> ca pakkhī <b>kurarā</b> ca pakkhī <b>senakā</b> ca pakkhī <b>mahākāḷā</b> ca pakkhī thale <b>bahū</b> pakkhino taṃ saraṃ tassa sarassa samīpe <b>jīvanti</b> jīvikaṃ kappentīti attho."],"lineRefs":[["thi-ap36:21"]]},{"para":1549,"vripara":"164","refs":["thi-ap36:22"],"lines":["“Pasadā ca varāhā ca, camarā gaṇḍakā bahū;"],"lineRefs":[["thi-ap36:22"]]},{"para":1550,"vripara":null,"refs":["thi-ap36:22"],"lines":["Rohiccā sukapotā ca, upajīvanti taṃ saraṃ”."],"lineRefs":[["thi-ap36:22"]]},{"para":1551,"vripara":null,"refs":["thi-ap36:22"],"lines":["Tattha pasadādayo ete migā <b>taṃ saraṃ</b> tasmiṃ sarasamīpe, bhummatthe upayogavacanaṃ, jīvitaṃ paripālentā viharantīti attho."],"lineRefs":[["thi-ap36:22"]]},{"para":1553,"vripara":"165","refs":["thi-ap36:23"],"lines":["“Sīhabyagghā ca dīpī ca, acchakokataracchakā;"],"lineRefs":[["thi-ap36:23"]]},{"para":1554,"vripara":null,"refs":["thi-ap36:23"],"lines":["Tidhā pabhinnamātaṅgā, upajīvanti taṃ saraṃ”."],"lineRefs":[["thi-ap36:23"]]},{"para":1555,"vripara":null,"refs":["thi-ap36:23"],"lines":["Ete sīhādayo catuppadā sarasamīpe upaddavarahitā jīvantīti sambandho."],"lineRefs":[["thi-ap36:23"]]},{"para":1557,"vripara":"166","refs":["thi-ap36:24"],"lines":["“Kinnarā vānarā ceva, athopi vanakammikā;"],"lineRefs":[["thi-ap36:24"]]},{"para":1558,"vripara":null,"refs":["thi-ap36:24"],"lines":["Cetā ca luddakā ceva, upajīvanti taṃ saraṃ”."],"lineRefs":[["thi-ap36:24"]]},{"para":1559,"vripara":null,"refs":["thi-ap36:24"],"lines":["Ettha ete evaṃnāmikā kinnarādayo sattā tasmiṃ sarasamīpe vasantīti attho."],"lineRefs":[["thi-ap36:24"]]},{"para":1561,"vripara":"167","refs":["thi-ap36:25"],"lines":["“Tindukāni piyālāni, madhukekā sumāriyo;"],"lineRefs":[["thi-ap36:25"]]}],"wordLinks":[]},"tika":null,"tika2":null}
