{"suttaId":"pv26","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[1261,1326],"vripara":"387"},"segments":{"pv26:0.3":"Abhijjamānapetavatthu","pv26:1.1":"“Abhijjamāne vārimhi,","pv26:1.2":"gaṅgāya idha gacchasi;","pv26:1.3":"Naggo pubbaddhapetova","pv26:1.4":"māladhārī alaṅkato;","pv26:1.5":"Kuhiṃ gamissasi peta,","pv26:1.6":"kattha vāso bhavissatī”ti.","pv26:2.1":"“Cundaṭṭhilaṃ [cundaṭṭhikaṃ (sī.)] gamissāmi,","pv26:2.2":"peto so iti bhāsati;","pv26:2.3":"Antare vāsabhagāmaṃ,","pv26:2.4":"bārāṇasiṃ ca [bārāṇasiyā ca (sī. syā.)] santike”.","pv26:3.1":"Tañca disvā mahāmatto,","pv26:3.2":"koliyo iti vissuto;","pv26:3.3":"Sattuṃ bhattañca petassa,","pv26:3.4":"pītakañca yugaṃ adā.","pv26:4.1":"Nāvāya tiṭṭhamānāya,","pv26:4.2":"kappakassa adāpayi;","pv26:4.3":"Kappakassa padinnamhi,","pv26:4.4":"ṭhāne petassa dissatha [petassu’ dissatha (sī.), petassu’ dicchatha (?)].","pv26:5.1":"Tato suvatthavasano,","pv26:5.2":"māladhārī alaṅkato;","pv26:5.3":"Ṭhāne ṭhitassa petassa,","pv26:5.4":"dakkhiṇā upakappatha;","pv26:5.5":"Tasmā dajjetha petānaṃ,","pv26:5.6":"anukampāya punappunaṃ.","pv26:6.1":"Sātunnavasanā [sāhunnavāsino (syā. pī.), sāhundavāsino (ka.)] eke,","pv26:6.2":"aññe kesanivāsanā [kesanivāsino (syā. ka.)];","pv26:6.3":"Petā bhattāya gacchanti,","pv26:6.4":"pakkamanti disodisaṃ.","pv26:7.1":"Dūre eke [dūre petā (ka.)] padhāvitvā,","pv26:7.2":"aladdhāva nivattare;","pv26:7.3":"Chātā pamucchitā bhantā,","pv26:7.4":"bhūmiyaṃ paṭisumbhitā.","pv26:8.1":"Te ca [keci (sī. syā.)] tattha papatitā [papatitvā (sī.), ca patitā (syā.)],","pv26:8.2":"bhūmiyaṃ paṭisumbhitā;","pv26:8.3":"Pubbe akatakalyāṇā,","pv26:8.4":"aggidaḍḍhāva ātape.","pv26:9.1":"“Mayaṃ pubbe pāpadhammā,","pv26:9.2":"gharaṇī kulamātaro;","pv26:9.3":"Santesu deyyadhammesu,","pv26:9.4":"dīpaṃ nākamha attano.","pv26:10.1":"“Pahūtaṃ annapānampi,","pv26:10.2":"apissu avakirīyati;","pv26:10.3":"Sammaggate pabbajite,","pv26:10.4":"na ca kiñci adamhase.","pv26:11.1":"“Akammakāmā alasā,","pv26:11.2":"sādukāmā mahagghasā;","pv26:11.3":"Ālopapiṇḍadātāro,","pv26:11.4":"paṭiggahe paribhāsimhase [paribhāsitā (syā. ka.)].","pv26:12.1":"“Te gharā tā ca dāsiyo,","pv26:12.2":"tānevābharaṇāni no;","pv26:12.3":"Te aññe paricārenti,","pv26:12.4":"mayaṃ dukkhassa bhāgino.","pv26:13.1":"“Veṇī vā avaññā honti,","pv26:13.2":"rathakārī ca dubbhikā;","pv26:13.3":"Caṇḍālī kapaṇā honti,","pv26:13.4":"kappakā [nhāpikā (sī.)] ca punappunaṃ.","pv26:14.1":"“Yāni yāni nihīnāni,","pv26:14.2":"kulāni kapaṇāni ca;","pv26:14.3":"Tesu tesveva jāyanti,","pv26:14.4":"esā maccharino gati.","pv26:15.1":"“Pubbe ca katakalyāṇā,","pv26:15.2":"dāyakā vītamaccharā;","pv26:15.3":"Saggaṃ te paripūrenti,","pv26:15.4":"obhāsenti ca nandanaṃ.","pv26:16.1":"“Vejayante ca pāsāde,","pv26:16.2":"ramitvā kāmakāmino;","pv26:16.3":"Uccākulesu jāyanti,","pv26:16.4":"sabhogesu tato cutā.","pv26:17.1":"“Kūṭāgāre ca pāsāde,","pv26:17.2":"pallaṅke gonakatthate;","pv26:17.3":"Bījitaṅgā [vījitaṅgā (sī. syā.)] morahatthehi,","pv26:17.4":"kule jātā yasassino.","pv26:18.1":"“Aṅkato aṅkaṃ gacchanti,","pv26:18.2":"māladhārī alaṅkatā;","pv26:18.3":"Dhātiyo upatiṭṭhanti,","pv26:18.4":"sāyaṃ pātaṃ sukhesino.","pv26:19.1":"“Nayidaṃ akatapuññānaṃ,","pv26:19.2":"katapuññānamevidaṃ;","pv26:19.3":"Asokaṃ nandanaṃ rammaṃ,","pv26:19.4":"tidasānaṃ mahāvanaṃ.","pv26:20.1":"“Sukhaṃ akatapuññānaṃ,","pv26:20.2":"idha natthi parattha ca;","pv26:20.3":"Sukhañca katapuññānaṃ,","pv26:20.4":"idha ceva parattha ca.","pv26:21.1":"“Tesaṃ sahabyakāmānaṃ,","pv26:21.2":"kattabbaṃ kusalaṃ bahuṃ;","pv26:21.3":"Katapuññā hi modanti,","pv26:21.4":"sagge bhogasamaṅgino”ti.","pv26:22.1":"Abhijjamānapetavatthu paṭhamaṃ."},"unsure":[],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":1716,"to":1800,"paras":[{"para":1716,"vripara":null,"refs":["pv26:1"],"lines":["Gāthamāha.","Tattha <b>abhijjamāne</b>ti padanikkhepena abhijjamāne saṅghāte, <b>vārimhi gaṅgāyā</b>ti gaṅgāya nadiyā udake.","<b>Idhā</b>ti imasmiṃ ṭhāne.","<b>Pubbaddhapetovā</b>ti kāyassa purimaddhena apeto viya apetayoniko devaputto viya.","Kathaṃ?","<b>Māladhārī alaṅkato</b>ti, mālāhi piḷandhitvā alaṅkatasīsaggoti attho.","<b>Kattha vāso bhavissatī</b>ti katarasmiṃ gāme dese vā tuyhaṃ nivāso bhavissati, taṃ kathehīti attho."],"lineRefs":[["pv26:1"],["pv26:1"],["pv26:1"],["pv26:1"],["pv26:1"],["pv26:1"],["pv26:1"]]},{"para":1717,"vripara":null,"refs":["pv26:1"],"lines":["Idāni yaṃ tadā tena petena koliyena ca vuttaṃ, taṃ dassetuṃ saṅgītikārā –"],"lineRefs":[["pv26:1"]]},{"para":1719,"vripara":"388","refs":["pv26:1"],"lines":["“Cundaṭṭhilaṃ gamissāmi, peto so iti bhāsati;"],"lineRefs":[["pv26:1"]]},{"para":1720,"vripara":null,"refs":["pv26:1"],"lines":["Antare vāsabhagāmaṃ, bārāṇasiñca santike."],"lineRefs":[["pv26:1"]]},{"para":1722,"vripara":"389","refs":["pv26:1"],"lines":["“Tañca disvā mahāmatto, koliyo iti vissuto;"],"lineRefs":[["pv26:1"]]},{"para":1723,"vripara":null,"refs":["pv26:1"],"lines":["Sattuṃ bhattañca petassa, pītakañca yugaṃ adā."],"lineRefs":[["pv26:1"]]},{"para":1725,"vripara":"390","refs":["pv26:1"],"lines":["“Nāvāya tiṭṭhamānāya, kappakassa adāpayi;"],"lineRefs":[["pv26:1"]]},{"para":1726,"vripara":null,"refs":["pv26:1"],"lines":["Kappakassa padinnamhi, ṭhāne petassa dissatha."],"lineRefs":[["pv26:1"]]},{"para":1728,"vripara":"391","refs":["pv26:1"],"lines":["“Tato suvatthavasano, māladhārī alaṅkato;"],"lineRefs":[["pv26:1"]]},{"para":1729,"vripara":null,"refs":["pv26:1"],"lines":["Ṭhāne ṭhitassa petassa, dakkhiṇā upakappatha;"],"lineRefs":[["pv26:1"]]},{"para":1730,"vripara":null,"refs":["pv26:1"],"lines":["Tasmā dajjetha petānaṃ, anukampāya punappunan”ti.","– gāthāyo avocuṃ;"],"lineRefs":[["pv26:1"],["pv26:1"]]},{"para":1731,"vripara":"388","refs":["pv26:2"],"lines":["Tattha <b>cundaṭṭhilan</b>ti evaṃnāmakaṃ gāmaṃ.","<b>Antare vāsabhagāmaṃ, bārāṇasiñca santike</b>ti vāsabhagāmassa ca bārāṇasiyā ca vemajjhe.","Antarā-saddayogena hetaṃ sāmyatthe upayogavacanaṃ.","Bārāṇasiyā santike hi so gāmoti.","Ayañhettha attho – antare vāsabhagāmassa ca bārāṇasiyā ca yo cundaṭṭhilanāmako gāmo bārāṇasiyā avidūre, taṃ gāmaṃ gamissāmīti."],"lineRefs":[["pv26:2"],["pv26:2"],["pv26:2"],["pv26:2"],["pv26:2"]]},{"para":1732,"vripara":"389","refs":["pv26:3"],"lines":["<b>Koliyo iti vissuto</b>ti koliyoti evaṃpakāsitanāmo.","<b>Sattuṃ bhattañcā</b>ti sattuñceva bhattañca.","<b>Pītakañca yugaṃ adā</b>ti pītakaṃ suvaṇṇavaṇṇaṃ ekaṃ vatthayugañca adāsi."],"lineRefs":[["pv26:3"],["pv26:3"],["pv26:3"]]},{"para":1733,"vripara":"390","refs":["pv26:4"],"lines":["Kadā adāsīti ce āha <b>nāvāya tiṭṭhamānāya.</b>","<b>Kappakassa adāpayī</b>ti gacchantiṃ nāvaṃ ṭhapetvā tattha ekassa nhāpitassa upāsakassa dāpesi, dinnamhi vatthayugeti yojanā.","<b>Ṭhāne</b>ti ṭhānaso taṅkhaṇaññeva.","<b>Petassa dissathā</b>ti petassa sarīre paññāyittha, tassa nivāsanapārupanavatthaṃ sampajji.","Tenāha <b>“tato suvatthavasano, māladhārī alaṅkato”</b>ti, suvatthavasano mālābharaṇehi sumaṇḍitapasādhito.","<b>Ṭhāne ṭhitassa petassa, dakkhiṇā upakappathā</b>ti dakkhiṇeyyaṭṭhāne ṭhitā panesā dakkhiṇā tassa petassa yasmā upakappati, viniyogaṃ agamāsi.","<b>Tasmā dajjetha petānaṃ, anukampāya punappunan</b>ti petānaṃ anukampāya pete uddissa punappunaṃ dakkhiṇaṃ dadeyyāti attho."],"lineRefs":[["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"]]},{"para":1734,"vripara":null,"refs":["pv26:4"],"lines":["Atha so koliyamahāmatto taṃ petaṃ anukampamāno dānavidhiṃ sampādetvā anusotaṃ āgantvā sūriye uggacchante bārāṇasiṃ sampāpuṇi.","Bhagavā ca tesaṃ anuggahatthaṃ ākāsena āgantvā gaṅgātīre aṭṭhāsi.","Koliyamahāmattopi nāvāto otaritvā haṭṭhapahaṭṭho bhagavantaṃ nimantesi –","“adhivāsetha me, bhante, bhagavā ajjatanāya bhattaṃ anukampaṃ upādāyā”ti.","Adhivāsesi bhagavā tuṇhībhāvena.","So bhagavato adhivāsanaṃ viditvā tāvadeva ramaṇīye bhūmibhāge mahantaṃ sākhāmaṇḍapaṃ upari catūsu ca passesu nānāvirāgavaṇṇavicittavividhavasanasamalaṅkataṃ kāretvā tattha bhagavato āsanaṃ paññāpetvā adāsi.","Nisīdi bhagavā paññatte āsane."],"lineRefs":[["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"]]},{"para":1735,"vripara":null,"refs":["pv26:4"],"lines":["Atha so mahāmatto bhagavantaṃ upasaṅkamitvā gandhapupphādīhi pūjetvā vanditvā ekamantaṃ nisinno heṭṭhā attano vuttavacanaṃ petassa ca paṭivacanaṃ bhagavato ārocesi.","Bhagavā “bhikkhusaṅgho āgacchatū”ti cintesi.","Cintitasamanantarameva buddhānubhāvasañcodito suvaṇṇahaṃsagaṇo viya dhataraṭṭhahaṃsarājaṃ bhikkhusaṅgho dhammarājaṃ samparivāresi.","Tāvadeva mahājano sannipati “uḷārā dhammadesanā bhavissatī”ti.","Taṃ disvā pasannamānaso mahāmatto buddhappamukhaṃ bhikkhusaṅghaṃ paṇītena khādanīyena bhojanīyena santappesi.","Bhagavā katabhattakicco mahājanassa anukampāya “bārāṇasisamīpagāmavāsino sannipatantū”ti adhiṭṭhāsi.","Sabbe ca te iddhibalena mahājanā sannipatiṃsu, uḷāre cassa pete pākaṭe akāsi.","Tesu keci chinnabhinnapilotikakhaṇḍadharā, keci attano keseheva paṭicchāditakopinā, keci naggā yathājātarūpā khuppipāsābhibhūtā tacapariyonaddhā aṭṭhimattasarīrā ito cito ca paribbhamantā mahājanassa paccakkhato paññāyiṃsu."],"lineRefs":[["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"],["pv26:4"]]},{"para":1736,"vripara":null,"refs":["pv26:4"],"lines":["Atha bhagavā tathārūpaṃ iddhābhisaṅkhāraṃ abhisaṅkhāsi, yathā te ekajjhaṃ sannipatitvā attanā kataṃ pāpakammaṃ mahājanassa pavedesuṃ.","Tamatthaṃ dīpentā saṅgītikārā –"],"lineRefs":[["pv26:4"],["pv26:4"]]},{"para":1738,"vripara":"392","refs":["pv26:4"],"lines":["“Sātunnavasanā eke, aññe kesanivāsanā;"],"lineRefs":[["pv26:4"]]},{"para":1739,"vripara":null,"refs":["pv26:4"],"lines":["Petā bhattāya gacchanti, pakkamanti disodisaṃ."],"lineRefs":[["pv26:4"]]},{"para":1741,"vripara":"393","refs":["pv26:4"],"lines":["“Dūre eke padhāvitvā, aladdhāva nivattare;"],"lineRefs":[["pv26:4"]]},{"para":1742,"vripara":null,"refs":["pv26:4"],"lines":["Chātā pamucchitā bhantā, bhūmiyaṃ paṭisumbhitā."],"lineRefs":[["pv26:4"]]},{"para":1744,"vripara":"394","refs":["pv26:4"],"lines":["“Keci tattha papatitvā, bhūmiyaṃ paṭisumbhitā;"],"lineRefs":[["pv26:4"]]},{"para":1745,"vripara":null,"refs":["pv26:4"],"lines":["Pubbe akatakalyāṇā, aggidaḍḍhāva ātape."],"lineRefs":[["pv26:4"]]},{"para":1747,"vripara":"395","refs":["pv26:4"],"lines":["“Mayaṃ pubbe pāpadhammā, gharaṇī kulamātaro;"],"lineRefs":[["pv26:4"]]},{"para":1748,"vripara":null,"refs":["pv26:4"],"lines":["Santesu deyyadhammesu, dīpaṃ nākamha attano."],"lineRefs":[["pv26:4"]]},{"para":1750,"vripara":"396","refs":["pv26:4"],"lines":["“Pahūtaṃ annapānampi, apissu avakirīyati;"],"lineRefs":[["pv26:4"]]},{"para":1751,"vripara":null,"refs":["pv26:4"],"lines":["Sammaggate pabbajite, na ca kiñci adamhase."],"lineRefs":[["pv26:4"]]},{"para":1753,"vripara":"397","refs":["pv26:4"],"lines":["“Akammakāmā alasā, sādukāmā mahagghasā;"],"lineRefs":[["pv26:4"]]},{"para":1754,"vripara":null,"refs":["pv26:4"],"lines":["Ālopapiṇḍadātāro, paṭiggahe paribhāsimhase."],"lineRefs":[["pv26:4"]]},{"para":1756,"vripara":"398","refs":["pv26:4"],"lines":["“Te gharā tā ca dāsiyo, tānevābharaṇāni no;"],"lineRefs":[["pv26:4"]]},{"para":1757,"vripara":null,"refs":["pv26:4"],"lines":["Te aññe paricārenti, mayaṃ dukkhassa bhāgino."],"lineRefs":[["pv26:4"]]},{"para":1759,"vripara":"399","refs":["pv26:4"],"lines":["“Veṇī vā avaññā honti, rathakārī ca dubbhikā;"],"lineRefs":[["pv26:4"]]},{"para":1760,"vripara":null,"refs":["pv26:4"],"lines":["Caṇḍālī kapaṇā honti, kappakā ca punappunaṃ."],"lineRefs":[["pv26:4"]]},{"para":1762,"vripara":"400","refs":["pv26:4"],"lines":["“Yāni yāni nihīnāni, kulāni kapaṇāni ca;"],"lineRefs":[["pv26:4"]]},{"para":1763,"vripara":null,"refs":["pv26:4"],"lines":["Tesu tesveva jāyanti, esā maccharino gati."],"lineRefs":[["pv26:4"]]},{"para":1765,"vripara":"401","refs":["pv26:4"],"lines":["“Pubbe ca katakalyāṇā, dāyakā vītamaccharā;"],"lineRefs":[["pv26:4"]]},{"para":1766,"vripara":null,"refs":["pv26:4"],"lines":["Saggaṃ te paripūrenti, obhāsenti ca nandanaṃ."],"lineRefs":[["pv26:4"]]},{"para":1768,"vripara":"402","refs":["pv26:4"],"lines":["“Vejayante ca pāsāde, ramitvā kāmakāmino;"],"lineRefs":[["pv26:4"]]},{"para":1769,"vripara":null,"refs":["pv26:4"],"lines":["Uccākulesu jāyanti, sabhogesu tato cutā."],"lineRefs":[["pv26:4"]]},{"para":1771,"vripara":"403","refs":["pv26:4"],"lines":["“Kūṭāgāre ca pāsāde, pallaṅke ponakatthate;"],"lineRefs":[["pv26:4"]]},{"para":1772,"vripara":null,"refs":["pv26:4"],"lines":["Bījitaṅgā morahatthehi, kule jātā yasassino."],"lineRefs":[["pv26:4"]]},{"para":1774,"vripara":"404","refs":["pv26:4"],"lines":["“Aṅkato aṅkaṃ gacchanti, māladhārī alaṅkatā;"],"lineRefs":[["pv26:4"]]},{"para":1775,"vripara":null,"refs":["pv26:4"],"lines":["Dhātiyo upatiṭṭhanti, sāyaṃ pātaṃ sukhesino."],"lineRefs":[["pv26:4"]]},{"para":1777,"vripara":"405","refs":["pv26:4"],"lines":["“Nayidaṃ akatapuññānaṃ, katapuññānamevidaṃ;"],"lineRefs":[["pv26:4"]]},{"para":1778,"vripara":null,"refs":["pv26:4"],"lines":["Asokaṃ nandanaṃ rammaṃ, tidasānaṃ mahāvanaṃ."],"lineRefs":[["pv26:4"]]},{"para":1780,"vripara":"406","refs":["pv26:4"],"lines":["“Sukhaṃ akatapuññānaṃ, idha natthi parattha ca;"],"lineRefs":[["pv26:4"]]},{"para":1781,"vripara":null,"refs":["pv26:4"],"lines":["Sukhañca katapuññānaṃ, idha ceva parattha ca."],"lineRefs":[["pv26:4"]]},{"para":1783,"vripara":"407","refs":["pv26:4"],"lines":["“Tesaṃ sahabyakāmānaṃ, kattabbaṃ kusalaṃ bahuṃ;"],"lineRefs":[["pv26:4"]]},{"para":1784,"vripara":null,"refs":["pv26:4"],"lines":["Katapuññā hi modanti, sagge bhogasamaṅgino”ti.","– gāthāyo avocuṃ;"],"lineRefs":[["pv26:4"],["pv26:4"]]},{"para":1785,"vripara":"392","refs":["pv26:6"],"lines":["Tattha <b>sātunnavasanā</b>ti chinnabhinnapilotikakhaṇḍanivāsanā.","<b>Eke</b>ti ekacce.","<b>Kesanivāsanā</b>ti keseheva paṭicchāditakopinā.","<b>Bhattāya gacchantī</b>ti “appeva nāma ito gatā yattha vā tattha vā kiñci ucchiṭṭhabhattaṃ vā vamitabhattaṃ vā gabbhamalādikaṃ vā labheyyāmā”ti katthacideva aṭṭhatvā ghāsatthāya gacchanti.","<b>Pakkamanti disodisan</b>ti disato disaṃ anekayojanantarikaṃ ṭhānaṃ pakkamanti."],"lineRefs":[["pv26:6"],["pv26:6"],["pv26:6"],["pv26:6"],["pv26:6"]]},{"para":1786,"vripara":"393","refs":["pv26:7"],"lines":["<b>Dūre</b>ti dūreva ṭhāne.","<b>Eke</b>ti ekacce petā.","<b>Padhāvitvā</b>ti ghāsatthāya upadhāvitvā.","<b>Aladdhāva nivattare</b>ti kiñci ghāsaṃ vā pānīyaṃ vā alabhitvā eva nivattanti.","<b>Pamucchitā</b>ti khuppipāsādidukkhena sañjātamucchā.","<b>Bhantā</b>ti paribbhamantā.","<b>Bhūmiyaṃ paṭisumbhitā</b>ti tāya eva mucchāya uppattiyā ṭhatvā avakkhittamattikāpiṇḍā viya vissussitvā pathaviyaṃ patitā."],"lineRefs":[["pv26:7"],["pv26:7"],["pv26:7"],["pv26:7"],["pv26:7"],["pv26:7"],["pv26:7"]]},{"para":1787,"vripara":"394","refs":["pv26:8"],"lines":["<b>Tatthā</b>ti gataṭṭhāne.","<b>Bhūmiyaṃ paṭisumbhitā</b>ti papāte patitā viya jighacchādidukkhena ṭhātuṃ asamatthabhāvena bhūmiyaṃ patitā, tattha vā gataṭṭhāne ghāsādīnaṃ alābhena chinnāsā hutvā kenaci paṭimukhaṃ sumbhitā pothitā viya bhūmiyaṃ patitā hontīti attho.","<b>Pubbe akatakalyāṇā</b>ti purimabhave akatakusalā.","<b>Aggidaḍḍhāva ātape</b>ti nidāghakāle ātapaṭṭhāne agginā daḍḍhā viya, khuppipāsagginā ḍayhamānā mahādukkhaṃ anubhavantīti attho."],"lineRefs":[["pv26:8"],["pv26:8"],["pv26:8"],["pv26:8"]]},{"para":1788,"vripara":"395","refs":["pv26:9"],"lines":["<b>Pubbe</b>ti atītabhave.","<b>Pāpadhammā</b>ti issukīmaccharīādibhāvena lāmakasabhāvā.","<b>Gharaṇī</b>ti gharasāminiyo.","<b>Kulamātaro</b>ti kuladārakānaṃ mātaro, kulapurisānaṃ vā mātaro.","<b>Dīpan</b>ti patiṭṭhaṃ, puññanti attho.","Tañhi sattānaṃ sugatīsu patiṭṭhābhāvato “patiṭṭhā”ti vuccati.","<b>Nākamhā</b>ti na karimha."],"lineRefs":[["pv26:9"],["pv26:9"],["pv26:9"],["pv26:9"],["pv26:9"],["pv26:9"],["pv26:9"]]},{"para":1789,"vripara":"396","refs":["pv26:10"],"lines":["<b>Pahūtan</b>ti bahuṃ.","<b>Annapānampī</b>ti annañca pānañca.","<b>Apissu avakirīyatī</b>ti <b>sū</b>ti nipātamattaṃ, api avakirīyati chaṭṭīyati.","<b>Sammaggate</b>ti sammā gate sammā paṭipanne sammā paṭipannāya.","<b>Pabbajite</b>ti pabbajitāya.","Sampadāne hi idaṃ bhummavacanaṃ.","Sammaggate vā pabbajite sati labbhamāneti attho.","<b>Na ca kiñci adamhase</b>ti “kiñcimattampi deyyadhammaṃ nādamhā”ti vippaṭisārābhibhūtā vadanti."],"lineRefs":[["pv26:10"],["pv26:10"],["pv26:10"],["pv26:10"],["pv26:10"],["pv26:10"],["pv26:10"],["pv26:10"]]},{"para":1790,"vripara":"397","refs":["pv26:11"],"lines":["<b>Akammakāmā</b>ti sādhūti akattabbaṃ kammaṃ akusalaṃ kāmentīti akammakāmā, sādhūhi vā kattabbaṃ kusalaṃ kāmentīti kammakāmā, na kammakāmāti akammakāmā, kusaladhammesu acchandikāti attho.","<b>Alasā</b>ti kusītā kusalakammakaraṇe nibbīriyā.","<b>Sādukāmā</b>ti sātamadhuravatthupiyā.","<b>Mahagghasā</b>ti mahābhojanā, ubhayenāpi sundarañca madhurañca bhojanaṃ labhitvā atthikānaṃ kiñci adatvā sayameva bhuñjitāroti dasseti.","<b>Ālopapiṇḍadātāro</b>ti ālopamattassapi bhojanapiṇḍassa dāyakā.","<b>Paṭiggahe</b>ti tassa paṭiggaṇhanake.","<b>Paribhāsimhase</b>ti paribhavaṃ karontā bhāsimha, avamaññimha uppaṇḍimhā cāti attho."],"lineRefs":[["pv26:11"],["pv26:11"],["pv26:11"],["pv26:11"],["pv26:11"],["pv26:11"],["pv26:11"]]},{"para":1791,"vripara":"398","refs":["pv26:12"],"lines":["<b>Te gharā</b>ti yattha mayaṃ pubbe “amhākaṃ gharan”ti mamattaṃ akarimhā, tāni gharāni yathāṭhitāni, idāni no na kiñci upakappatīti adhippāyo.","<b>Tā ca dāsiyo tānevābharaṇāni no</b>ti etthāpi eseva nayo.","Tattha <b>no</b>ti amhākaṃ.","<b>Te</b>ti te gharādike.","<b>Aññe paricārenti</b>, paribhogādivasena viniyogaṃ karontīti attho.","<b>Mayaṃ dukkhassa bhāgino</b>ti mayaṃ pana pubbe kevalaṃ kīḷanappasutā hutvā sāpateyyaṃ pahāya gamanīyaṃ anugāmikaṃ kātuṃ ajānantā idāni khuppipāsādidukkhassa bhāgino bhavāmāti attānaṃ garahantā vadanti."],"lineRefs":[["pv26:12"],["pv26:12"],["pv26:12"],["pv26:12"],["pv26:12"],["pv26:12"]]},{"para":1792,"vripara":"399","refs":["pv26:12","pv26:13"],"lines":["Idāni yasmā petayonito cavitvā manussesu uppajjantāpi sattā yebhuyyena tasseva kammassa vipākāvasesena hīnajātikā kapaṇavuttinova honti, tasmā tamatthaṃ dassetuṃ <b>“veṇivā”</b>tiādinā dve gāthā vuttā.","Tattha <b>veṇivā</b>ti venajātikā, vilīvakārā naḷakārā hontīti attho.","<b>Vā</b> -saddo aniyamattho.","<b>Avaññā</b>ti avaññeyyā, avajānitabbāti vuttaṃ hoti.","“Vambhanā”ti vā pāṭho, parehi bādhanīyāti attho.","<b>Rathakārī</b>ti cammakārino.","<b>Dubbhikā</b>ti mittadubbhikā mittānaṃ bādhikā.","<b>Caṇḍālī</b>ti caṇḍālajātikā.","<b>Kapaṇā</b>ti vanibbakā ativiya kāruññappattā.","<b>Kappakā</b>ti kappakajātikā, sabbattha “honti punappunan”ti yojanā, aparāparampi imesu nihīnakulesu uppajjantīti vuttaṃ hoti."],"lineRefs":[["pv26:12"],["pv26:12"],["pv26:13"],["pv26:13"],["pv26:13"],["pv26:13"],["pv26:13"],["pv26:13"],["pv26:13"],["pv26:13"]]},{"para":1793,"vripara":"400","refs":["pv26:14"],"lines":["<b>Tesu tesveva jāyantī</b>ti yāni yāni aññānipi nesādapukkusakulādīni kapaṇāni ativiya vambhaniyāni paramaduggatāni ca, tesu tesu eva nihīnakulesu macchariyamalena petesu nibbattitvā tato cutā nibbattanti.","Tenāha <b>“esā maccharino gatī”</b>ti."],"lineRefs":[["pv26:14"],["pv26:14"]]},{"para":1794,"vripara":"401","refs":["pv26:15"],"lines":["Evaṃ akatapuññānaṃ sattānaṃ gatiṃ dassetvā idāni katapuññānaṃ gatiṃ dassetuṃ <b>“pubbe ca katakalyāṇā”</b>ti satta gāthā vuttā.","Tattha <b>saggaṃ te paripūrentī</b>ti ye pubbe purimajātiyaṃ katakalyāṇā dāyakā dānapuññābhiratā vigatamalamaccherā, te attano rūpasampattiyā ceva parivārasampattiyā ca saggaṃ devalokaṃ paripūrenti paripuṇṇaṃ karonti.","<b>Obhāsenti ca nandanan</b>ti na kevalaṃ paripūrentiyeva, atha kho kapparukkhādīnaṃ pabhāhi sabhāveneva obhāsamānampi nandanavanaṃ attano vatthābharaṇajutīhi sarīrappabhāya ca abhibhavitvā ceva obhāsetvā ca jotenti."],"lineRefs":[["pv26:15"],["pv26:15"],["pv26:15"]]},{"para":1795,"vripara":"402","refs":["pv26:16"],"lines":["<b>Kāmakāmino</b>ti yathicchitesu kāmaguṇesu yathākāmaṃ paribhogavanto.","<b>Uccākulesū</b>ti uccesu khattiyakulādīsu kulesu.","<b>Sabhogesū</b>ti mahāvibhavesu.","<b>Tato cutā</b>ti tato devalokato cutā."],"lineRefs":[["pv26:16"],["pv26:16"],["pv26:16"],["pv26:16"]]},{"para":1796,"vripara":"403","refs":["pv26:17"],"lines":["<b>Kūṭāgāre ca pāsāde</b>ti kūṭāgāre ca pāsāde ca.","<b>Bījitaṅgā</b>ti bījiyamānadehā.","<b>Morahatthehī</b>ti morapiñchapaṭimaṇḍitabījanīhatthehi.","<b>Yasassino</b>ti parivāravanto ramantīti adhippāyo."],"lineRefs":[["pv26:17"],["pv26:17"],["pv26:17"],["pv26:17"]]},{"para":1797,"vripara":"404","refs":["pv26:18"],"lines":["<b>Aṅkato aṅkaṃ gacchantī</b>ti dārakakālepi ñātīnaṃ dhātīnañca aṅkaṭṭhānato aṅkaṭṭhānameva gacchanti, na bhūmitalanti adhippāyo.","<b>Upatiṭṭhantī</b>ti upaṭṭhānaṃ karonti.","<b>Sukhesino</b>ti sukhamicchantā,“mā sītaṃ vā uṇhaṃ vā”ti appakampi dukkhaṃ pariharantā upatiṭṭhantīti adhippāyo."],"lineRefs":[["pv26:18"],["pv26:18"],["pv26:18"]]},{"para":1798,"vripara":"405","refs":["pv26:19"],"lines":["<b>Nayidaṃ akatapuññānan</b>ti idaṃ sokavatthuabhāvato asokaṃ rammaṃ ramaṇīyaṃ tidasānaṃ tāvatiṃsadevānaṃ <b>mahāvanaṃ</b> mahāupavanabhūtaṃ <b>nandanaṃ</b> nandanavanaṃ akatapuññānaṃ na hoti, tehi laddhuṃ na sakkāti attho."],"lineRefs":[["pv26:19"]]},{"para":1799,"vripara":"406","refs":["pv26:20"],"lines":["<b>Idhā</b>ti imasmiṃ manussaloke visesato puññaṃ karīyati, taṃ sandhāyāha.","<b>Idhā</b>ti vā diṭṭhadhamme.","<b>Paratthā</b>ti samparāye."],"lineRefs":[["pv26:20"],["pv26:20"],["pv26:20"]]},{"para":1800,"vripara":"407","refs":["pv26:21"],"lines":["<b>Tesan</b>ti tehi yathāvuttehi devehi.","<b>Sahabyakāmānan</b>ti sahabhāvaṃ icchantehi.","<b>Bhogasamaṅgino</b>ti bhogehi samannāgatā, dibbehi pañcakāmaguṇehi samappitā modantīti attho.","Sesaṃ uttānatthameva."],"lineRefs":[["pv26:21"],["pv26:21"],["pv26:21"],["pv26:21"]]}],"wordLinks":[["pv26:1.1","abhijjamāne",0,1],["pv26:1.1","vārimhi gaṅgāyā",0,1],["pv26:1.1","idhā",0,2],["pv26:1.3","pubbaddhapetovā",0,3],["pv26:1.3","māladhārī alaṅkato",0,5],["pv26:1.5","kattha vāso bhavissatī",0,6],["pv26:2.1","cundaṭṭhilaṃ",11,0],["pv26:3