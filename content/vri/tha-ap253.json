{"suttaId":"tha-ap253","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8251,8264],"vripara":"1"},"segments":{"tha-ap253:0.3":"Thomakattheraapadānaṃ","tha-ap253:1.1":"“Devaloke ṭhito santo, vipassissa mahesino;","tha-ap253:1.3":"Dhammaṃ suṇitvā mudito, imaṃ vācaṃ abhāsahaṃ.","tha-ap253:2.1":"“‘Namo te purisājañña, namo te purisuttama;","tha-ap253:2.3":"Bahujjanaṃ [bahuṃ janaṃ (sī.)] tārayasi, desento amataṃ padaṃ’.","tha-ap253:3.1":"“Ekanavutito kappe, yaṃ vācamabhaṇiṃ tadā;","tha-ap253:3.3":"Duggatiṃ nābhijānāmi, thomanāya idaṃ phalaṃ.","tha-ap253:4.1":"“Paṭisambhidā catasso, vimokkhāpi ca aṭṭhime;","tha-ap253:4.3":"Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanaṃ”.","tha-ap253:5.1":"Itthaṃ sudaṃ āyasmā thomako thero imā gāthāyo abhāsitthāti.","tha-ap253:6.1":"Thomakattherassāpadānaṃ paṭhamaṃ."},"attha":null,"tika":null,"tika2":null}
