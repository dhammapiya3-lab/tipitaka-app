{"suttaId":"thag2.27","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[929,935],"vripara":"173"},"segments":{"thag2.27:0.4":"Nandakattheragāthā","thag2.27:1.1":"“Yathāpi bhaddo ājañño, khalitvā patitiṭṭhati;","thag2.27:1.3":"Bhiyyo laddāna saṃvegaṃ, adīno vahate dhuraṃ.","thag2.27:2.1":"“Evaṃ dassanasampannaṃ, sammāsambuddhasāvakaṃ;","thag2.27:2.3":"Ājānīyaṃ maṃ dhāretha, puttaṃ buddhassa orasan”ti.","thag2.27:2.5":"… Nandako thero …."},"attha":null,"tika":null}
