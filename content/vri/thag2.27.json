{"suttaId":"thag2.27","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[929,935],"vripara":"173"},"segments":{"thag2.27:0.4":"Nandakattheragāthā","thag2.27:1.1":"“Yathāpi bhaddo ājañño, khalitvā patitiṭṭhati;","thag2.27:1.3":"Bhiyyo laddāna saṃvegaṃ, adīno vahate dhuraṃ.","thag2.27:2.1":"“Evaṃ dassanasampannaṃ, sammāsambuddhasāvakaṃ;","thag2.27:2.3":"Ājānīyaṃ maṃ dhāretha, puttaṃ buddhassa orasan”ti.","thag2.27:2.5":"… Nandako thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":4002,"to":4045,"paras":[{"para":4002,"vripara":"173","refs":["thag2.27:1"],"lines":["“Yathāpi bhaddo ājañño, khalitvā patitiṭṭhati;"],"lineRefs":[["thag2.27:1"]]},{"para":4003,"vripara":null,"refs":["thag2.27:1"],"lines":["Bhiyyo laddhāna saṃvegaṃ, adīno vahate dhuraṃ."],"lineRefs":[["thag2.27:1"]]},{"para":4005,"vripara":"174","refs":["thag2.27:2"],"lines":["“Evaṃ dassanasampannaṃ, sammāsambuddhasāvakaṃ;"],"lineRefs":[["thag2.27:2"]]},{"para":4006,"vripara":null,"refs":["thag2.27:2"],"lines":["Ājānīyaṃ maṃ dhāretha, puttaṃ buddhassa orasan”ti.","– gāthādvayaṃ abhāsi;"],"lineRefs":[["thag2.27:2"],["thag2.27:2"]]},{"para":4007,"vripara":null,"refs":["thag2.27:2"],"lines":["Tattha <b>bhiyyo laddhāna saṃvegaṃ, adīno vahate dhuran</b>ti “mayhaṃ jātibalavīriyānaṃ ananucchavikametaṃ yadidaṃ āgatassa bhārassa avahanan”ti saṃvegaṃ labhitvā adīno adīnamānaso alīnacitto.","“Alīno”ti vā pāṭho, so eva attho.","Bhiyyo punappunaṃ bhiyyosomattāya attano dhuraṃ bhāraṃ vahate ubbahati.","Sesaṃ heṭṭhā ramaṇīyavihārittherassa gāthāvaṇṇanāyaṃ vuttanayameva."],"lineRefs":[["thag2.27:2"],["thag2.27:2"],["thag2.27:2"],["thag2.27:2"]]},{"para":4008,"vripara":null,"refs":["thag2.27:2"],"lines":["Nandakattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[["thag2.27:2"]]},{"para":4009,"vripara":null,"refs":["thag2.27:2"],"lines":["Bharatattheragāthāvaṇṇanā"],"lineRefs":[["thag2.27:2"]]},{"para":4010,"vripara":null,"refs":["thag2.27:2"],"lines":["<b>Ehi</b>, <b>nandaka, gacchāmā</b>ti āyasmato bharatattherassa gāthā.","Kā uppatti?","Ayaṃ kira anomadassissa bhagavato kāle kulagehe nibbattitvā viññutaṃ patto ekadivasaṃ manuññadassanaṃ mudusukhasamphassaṃ upāhanadvayaṃ gahetvā gacchanto satthāraṃ caṅkamantaṃ disvā pasannamānaso upāhanā upanāmetvā,“abhiruhatu bhagavā upāhanā, yaṃ mama assa dīgharattaṃ hitāya sukhāyā”ti āha.","Abhiruhi bhagavā tassa anuggaṇhanatthaṃ upāhanā.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde campānagare gahapatikule nibbatti, <b>bharato</b>tissa nāmaṃ ahosi.","So viññutaṃ patto soṇattherassa pabbajitabhāvaṃ sutvā “sopi nāma pabbajī”ti sañjātasaṃvego pabbajitvā katapubbakicco vipassanāya kammaṃ karonto nacirasseva chaḷabhiñño ahosi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.48.71-89)–"],"lineRefs":[["thag2.27:2"],["thag2.27:2"],["thag2.27:2"],["thag2.27:2"],["thag2.27:2"],["thag2.27:2"],["thag2.27:2"]]},{"para":4011,"vripara":null,"refs":["thag2.27:2"],"lines":["“Anomadassī bhagavā, lokajeṭṭho narāsabho;"],"lineRefs":[["thag2.27:2"]]},{"para":4012,"vripara":null,"refs":["thag2.27:2"],"lines":["Divāvihārā nikkhamma, pathamāruhi cakkhumā."],"lineRefs":[["thag2.27:2"]]},{"para":4013,"vripara":null,"refs":["thag2.27:2"],"lines":["“Pānadhiṃ sukataṃ gayha, addhānaṃ paṭipajjahaṃ;"],"lineRefs":[["thag2.27:2"]]},{"para":4014,"vripara":null,"refs":["thag2.27:2"],"lines":["Tatthaddasāsiṃ sambuddhaṃ, pattikaṃ cārudassanaṃ."],"lineRefs":[["thag2.27:2"]]},{"para":4015,"vripara":null,"refs":["thag2.27:2"],"lines":["“Sakaṃ cittaṃ pasādetvā, nīharitvāna pānadhiṃ;"],"lineRefs":[["thag2.27:2"]]},{"para":4016,"vripara":null,"refs":["thag2.27:2"],"lines":["Pādamūle ṭhapetvāna, idaṃ vacanamabraviṃ."],"lineRefs":[["thag2.27:2"]]},{"para":4017,"vripara":null,"refs":["thag2.27:2"],"lines":["“Abhirūha mahāvīra, sugatinda vināyaka;"],"lineRefs":[["thag2.27:2"]]},{"para":4018,"vripara":null,"refs":["thag2.27:2"],"lines":["Ito phalaṃ labhissāmi, so me attho samijjhatu."],"lineRefs":[["thag2.27:2"]]},{"para":4019,"vripara":null,"refs":["thag2.27:2"],"lines":["“Anomadassī bhagavā, lokajeṭṭho narāsabho;"],"lineRefs":[["thag2.27:2"]]},{"para":4020,"vripara":null,"refs":["thag2.27:2"],"lines":["Pānadhiṃ abhirūhitvā, idaṃ vacanamabravi."],"lineRefs":[["thag2.27:2"]]},{"para":4021,"vripara":null,"refs":["thag2.27:2"],"lines":["“Yo pānadhiṃ me adāsi, pasanno sehi pāṇibhi;"],"lineRefs":[["thag2.27:2"]]},{"para":4022,"vripara":null,"refs":["thag2.27:2"],"lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."],"lineRefs":[["thag2.27:2"]]},{"para":4023,"vripara":null,"refs":["thag2.27:2"],"lines":["“Buddhassa giramaññāya, sabbe devā samāgatā;"],"lineRefs":[["thag2.27:2"]]},{"para":4024,"vripara":null,"refs":["thag2.27:2"],"lines":["Udaggacittā sumanā, vedajātā katañjalī."],"lineRefs":[["thag2.27:2"]]},{"para":4025,"vripara":null,"refs":["thag2.27:2"],"lines":["“Pānadhīnaṃ padānena, sukhitoyaṃ bhavissati;"],"lineRefs":[["thag2.27:2"]]},{"para":4026,"vripara":null,"refs":["thag2.27:2"],"lines":["Pañcapaññāsakkhattuñca, devarajjaṃ karissati."],"lineRefs":[["thag2.27:2"]]},{"para":4027,"vripara":null,"refs":["thag2.27:2"],"lines":["“Sahassakkhattuṃ rājā ca, cakkavattī bhavissati;"],"lineRefs":[["thag2.27:2"]]},{"para":4028,"vripara":null,"refs":["thag2.27:2"],"lines":["Padesarajjaṃ vipulaṃ, gaṇanāto asaṅkhiyaṃ."],"lineRefs":[["thag2.27:2"]]},{"para":4029,"vripara":null,"refs":["thag2.27:2"],"lines":["“Aparimeyye ito kappe, okkākakulasambhavo;"],"lineRefs":[["thag2.27:2"]]},{"para":4030,"vripara":null,"refs":["thag2.27:2"],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[["thag2.27:2"]]},{"para":4031,"vripara":null,"refs":["thag2.27:2"],"lines":["“Tassa dhammesu dāyādo, oraso dhammanimmito;"],"lineRefs":[["thag2.27:2"]]},{"para":4032,"vripara":null,"refs":["thag2.27:2"],"lines":["Sabbāsave pariññāya, nibbāyissatināsavo."],"lineRefs":[["thag2.27:2"]]},{"para":4033,"vripara":null,"refs":["thag2.27:2"],"lines":["“Devaloke manusse vā, nibbattissati puññavā;"],"lineRefs":[["thag2.27:2"]]},{"para":4034,"vripara":null,"refs":["thag2.27:2"],"lines":["Devayānapaṭibhāgaṃ, yānaṃ paṭilabhissati."],"lineRefs":[["thag2.27:2"]]},{"para":4035,"vripara":null,"refs":["thag2.27:2"],"lines":["“Pāsādā sivikā vayhaṃ, hatthino samalaṅkatā;"],"lineRefs":[["thag2.27:2"]]},{"para":4036,"vripara":null,"refs":["thag2.27:2"],"lines":["Rathā vājaññasaṃyuttā, sadā pātubhavanti me."],"lineRefs":[["thag2.27:2"]]},{"para":4037,"vripara":null,"refs":["thag2.27:2"],"lines":["“Agārā nikkhamantopi, rathena nikkhamiṃ ahaṃ;"],"lineRefs":[["thag2.27:2"]]},{"para":4038,"vripara":null,"refs":["thag2.27:2"],"lines":["Kesesu chijjamānesu, arahattamapāpuṇiṃ."],"lineRefs":[["thag2.27:2"]]},{"para":4039,"vripara":null,"refs":["thag2.27:2"],"lines":["“Lābhā mayhaṃ suladdhaṃ me, vāṇijjaṃ suppayojitaṃ;"],"lineRefs":[["thag2.27:2"]]},{"para":4040,"vripara":null,"refs":["thag2.27:2"],"lines":["Datvāna pānadhiṃ ekaṃ, pattomhi acalaṃ padaṃ."],"lineRefs":[["thag2.27:2"]]},{"para":4041,"vripara":null,"refs":["thag2.27:2"],"lines":["“Aparimeyye ito kappe, yaṃ pānadhimadāsahaṃ;"],"lineRefs":[["thag2.27:2"]]},{"para":4042,"vripara":null,"refs":["thag2.27:2"],"lines":["Duggatiṃ nābhijānāmi, pānadhissa idaṃ phalaṃ."],"lineRefs":[["thag2.27:2"]]},{"para":4043,"vripara":null,"refs":["thag2.27:2"],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[["thag2.27:2"]]},{"para":4044,"vripara":null,"refs":["thag2.27:2"],"lines":["Chaḷabhiñño pana hutvā attano kaniṭṭhabhātikena nandakattherena heṭṭhā vuttanayena aññābyākaraṇe kate “idāni nandakopi arahā jāto, handa mayaṃ ubhopi satthu santikaṃ gantvā vusitabrahmacariyataṃ nivedessāmāti uppannaṃ parivitakkaṃ nandakattherassa kathento –"],"lineRefs":[["thag2.27:2"]]}],"wordLinks":[],"before":[{"para":3989,"vripara":null,"refs":[],"lines":["Puṇṇamāsattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3990,"vripara":null,"refs":[],"lines":["Nandakattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":3991,"vripara":null,"refs":[],"lines":["<b>Yathāpi bhaddo ājañño</b>ti āyasmato nandakattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni karonto sikhissa bhagavato kāle paccantadese uppajjitvā viññutaṃ patto vanacāriko hutvā vicaranto ekadivasaṃ satthu caṅkamanaṭṭhānaṃ disvā pasannacitto vālukā okiri.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde campāyaṃ gahapatikule nibbatti, tassa <b>nandako</b>ti nāmaṃ akaṃsu.","Jeṭṭhakabhātā panassa bharato nāma.","Tassa pubbayogo anantaravatthusmiṃ āvibhavissati.","Te ubhopi viññutaṃ patvā āyasmantaṃ soṇaṃ koḷivisaṃ pabbajitaṃ sutvā “soṇopi nāma tathāsukhumālo pabbaji, kimaṅgaṃ pana mayan”ti pabbajiṃsu.","Tesu bharato nacirasseva vipassanaṃ vaḍḍhetvā chaḷabhiñño ahosi.","Nandako pana kilesānaṃ balavabhāvena tāva vipassanaṃ ussukkāpetuṃ nāsakkhi, vipassanāya kammaṃ karoti eva.","Athassa bharatatthero āsayaṃ ñatvā avassayo bhavitukāmo taṃ pacchāsamaṇaṃ katvā vihārato nikkhamitvā maggasamīpe nisinno vipassanākathaṃ kathesi."],"lineRefs":[[],[],[],[],[],[],[],[],[],[]]},{"para":3992,"vripara":null,"refs":[],"lines":["Tena ca samayena sakaṭasatthe gacchante eko sakaṭe yutto goṇo cikkhallaṭṭhāne sakaṭaṃ uddharituṃ asakkonto paripati.","Tato naṃ satthavāho sakaṭā mocetvā tiṇañca pānīyañca datvā parissamaṃ apanetvā puna dhure yojesi.","Tato goṇo vūpasantaparissamo laddhabalo taṃ sakaṭaṃ cikkhallaṭṭhānato uddharitvā thale patiṭṭhāpesi.","Atha bharatatthero nandakassa “passasi no tvaṃ, āvuso nandaka, imassa kamman”ti taṃ nidassetvā tena “passāmī”ti vutte “imamatthaṃ suṭṭhu upadhārehī”ti āha.","Itaro “yathāyaṃ goṇo vūpasantaparissamo paṅkaṭṭhānato bhāraṃ ubbahati, evaṃ mayāpi saṃsārapaṅkato attā uddharitabbo”ti tamevārammaṇaṃ katvā vipassanāya kammaṃ karonto nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.48.90-95)–"],"lineRefs":[[],[],[],[],[],[]]},{"para":3993,"vripara":null,"refs":[],"lines":["“Migaluddo pure āsiṃ, araññe kānane ahaṃ;"],"lineRefs":[[]]},{"para":3994,"vripara":null,"refs":[],"lines":["Vātamigaṃ gavesanto, caṅkamaṃ addasaṃ ahaṃ."],"lineRefs":[[]]},{"para":3995,"vripara":null,"refs":[],"lines":["“Ucchaṅgena pulinaṃ gayha, caṅkame okiriṃ ahaṃ;"],"lineRefs":[[]]},{"para":3996,"vripara":null,"refs":[],"lines":["Pasannacitto sumano, sugatassa sirīmato."],"lineRefs":[[]]},{"para":3997,"vripara":null,"refs":[],"lines":["“Ekatiṃse ito kappe, pulinaṃ okiriṃ ahaṃ;"],"lineRefs":[[]]},{"para":3998,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, pulinassa idaṃ phalaṃ."],"lineRefs":[[]]},{"para":3999,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":4000,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā attano jeṭṭhabhātikassa bharatattherassa santike aññaṃ byākaronto –"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
