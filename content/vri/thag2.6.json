{"suttaId":"thag2.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[746,752],"vripara":"131"},"segments":{"thag2.6:0.4":"Meḷajinattheragāthā","thag2.6:1.1":"“Yadāhaṃ dhammamassosiṃ, bhāsamānassa satthuno;","thag2.6:1.3":"Na kaṅkhamabhijānāmi, sabbaññūaparājite.","thag2.6:2.1":"“Satthavāhe mahāvīre, sārathīnaṃ varuttame;","thag2.6:2.3":"Magge paṭipadāyaṃ vā, kaṅkhā mayhaṃ na vijjatī”ti.","thag2.6:2.5":"… Meḷajino thero …."},"attha":null,"tika":null}
