{"suttaId":"tha-ap392","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[11130,11248],"vripara":"64"},"segments":{"tha-ap392:0.3":"Pubbakammapilotikabuddhaapadānaṃ","tha-ap392:1.1":"“Anotattasarāsanne,","tha-ap392:1.2":"ramaṇīye silātale;","tha-ap392:1.3":"Nānāratanapajjote,","tha-ap392:1.4":"nānāgandhavanantare.","tha-ap392:2.1":"“Mahatā bhikkhusaṅghena,","tha-ap392:2.2":"pareto [upeto (udānaṭṭhakathāyaṃ 4 vagge,8 sutte)] lokanāyako;","tha-ap392:2.3":"Āsīno byākarī tattha,","tha-ap392:2.4":"pubbakammāni attano.","tha-ap392:3.1":"[suṇātha bhikkhave mayhaṃ, yaṃ kammaṃ pakataṃ mayā; ekaṃ araññikaṃ bhikkhuṃ, disvā dinnaṃ pilotikaṃ; patthitaṃ paṭhamaṃ buddhaṃ, buddhattāya mayā tadā; pilotiyassa kammassa, buddhattepi vipaccati; gopālako pure āsiṃ, gāviṃ pājeti gocaraṃ; pivantiṃ udakaṃ āvilaṃ, gāviṃ disvā nivārayiṃ; tena kammavipākena, idha pacchimake bhave; vipāsito yadicchakaṃ, na hi pātuṃ labhāmahaṃ (syā.)]“Suṇātha bhikkhavo mayhaṃ,","tha-ap392:3.2":"yaṃ kammaṃ pakataṃ mayā;","tha-ap392:3.3":"Pilotikassa kammassa,","tha-ap392:3.4":"buddhattepi vipaccati [suṇātha bhikkhave mayhaṃ, yaṃ kammaṃ pakataṃ mayā; ekaṃ araññikaṃ bhikkhuṃ, disvā dinnaṃ pilotikaṃ; patthitaṃ paṭhamaṃ buddhaṃ, buddhattāya mayā tadā; pilotiyassa kammassa, buddhattepi vipaccati; gopālako pure āsiṃ, gāviṃ pājeti gocaraṃ; pivantiṃ udakaṃ āvilaṃ, gāviṃ disvā nivārayiṃ; tena kammavipākena, idha pacchimake bhave; vipāsito yadicchakaṃ, na hi pātuṃ labhāmahaṃ (syā.)]. [1]","tha-ap392:4.1":"“Munāḷi nāmahaṃ dhutto,","tha-ap392:4.2":"pubbe aññāsu jātisu [aññāya jātiyā (udāna aṭṭha.)];","tha-ap392:4.3":"Paccekabuddhaṃ surabhiṃ [sarabhuṃ (sī.)],","tha-ap392:4.4":"abbhācikkhiṃ adūsakaṃ.","tha-ap392:5.1":"“Tena kammavipākena,","tha-ap392:5.2":"niraye saṃsariṃ ciraṃ;","tha-ap392:5.3":"Bahūvassasahassāni,","tha-ap392:5.4":"dukkhaṃ vedesi vedanaṃ.","tha-ap392:6.1":"“Tena kammāvasesena,","tha-ap392:6.2":"idha pacchimake bhave;","tha-ap392:6.3":"Abbhakkhānaṃ mayā laddhaṃ,","tha-ap392:6.4":"sundarikāya kāraṇā. [2]","tha-ap392:7.1":"“Sabbābhibhussa buddhassa,","tha-ap392:7.2":"nando nāmāsi sāvako;","tha-ap392:7.3":"Taṃ abbhakkhāya niraye,","tha-ap392:7.4":"ciraṃ saṃsaritaṃ mayā.","tha-ap392:8.1":"“Dasavassasahassāni,","tha-ap392:8.2":"niraye saṃsariṃ ciraṃ;","tha-ap392:8.3":"Manussabhāvaṃ laddhāhaṃ,","tha-ap392:8.4":"abbhakkhānaṃ bahuṃ labhiṃ.","tha-ap392:9.1":"“Tena kammāvasesena,","tha-ap392:9.2":"ciñcamānavikā mamaṃ;","tha-ap392:9.3":"Abbhācikkhi abhūtena,","tha-ap392:9.4":"janakāyassa aggato. [3]","tha-ap392:10.1":"“Brāhmaṇo sutavā āsiṃ,","tha-ap392:10.2":"ahaṃ sakkatapūjito;","tha-ap392:10.3":"Mahāvane pañcasate,","tha-ap392:10.4":"mante vācemi māṇave.","tha-ap392:11.1":"“Tatthāgato [tamāgato (ka.)] isi bhīmo,","tha-ap392:11.2":"pañcābhiñño mahiddhiko;","tha-ap392:11.3":"Taṃ cāhaṃ āgataṃ disvā,","tha-ap392:11.4":"abbhācikkhiṃ adūsakaṃ.","tha-ap392:12.1":"“Tatohaṃ avacaṃ sisse,","tha-ap392:12.2":"kāmabhogī ayaṃ isi;","tha-ap392:12.3":"Mayhampi bhāsamānassa,","tha-ap392:12.4":"anumodiṃsu māṇavā.","tha-ap392:13.1":"“Tato māṇavakā sabbe,","tha-ap392:13.2":"bhikkhamānaṃ kule kule;","tha-ap392:13.3":"Mahājanassa āhaṃsu,","tha-ap392:13.4":"kāmabhogī ayaṃ isi.","tha-ap392:14.1":"“Tena kammavipākena,","tha-ap392:14.2":"pañca bhikkhusatā ime;","tha-ap392:14.3":"Abbhakkhānaṃ labhuṃ sabbe,","tha-ap392:14.4":"sundarikāya kāraṇā. [4]","tha-ap392:15.1":"“Vemātubhātaraṃ pubbe,","tha-ap392:15.2":"dhanahetu haniṃ ahaṃ;","tha-ap392:15.3":"Pakkhipiṃ giriduggasmiṃ,","tha-ap392:15.4":"silāya ca apiṃsayiṃ.","tha-ap392:16.1":"“Tena kammavipākena,","tha-ap392:16.2":"devadatto silaṃ khipi;","tha-ap392:16.3":"Aṅguṭṭhaṃ piṃsayī pāde,","tha-ap392:16.4":"mama pāsāṇasakkharā. [5]","tha-ap392:17.1":"“Purehaṃ dārako hutvā,","tha-ap392:17.2":"kīḷamāno mahāpathe;","tha-ap392:17.3":"Paccekabuddhaṃ disvāna,","tha-ap392:17.4":"magge sakalikaṃ [sakkhalikaṃ (ka.)] khipiṃ [dahiṃ (syā.)].","tha-ap392:18.1":"“Tena kammavipākena,","tha-ap392:18.2":"idha pacchimake bhave;","tha-ap392:18.3":"Vadhatthaṃ maṃ devadatto,","tha-ap392:18.4":"abhimāre payojayi. [6]","tha-ap392:19.1":"“Hatthāroho pure āsiṃ,","tha-ap392:19.2":"paccekamunimuttamaṃ;","tha-ap392:19.3":"Piṇḍāya vicarantaṃ taṃ,","tha-ap392:19.4":"āsādesiṃ gajenahaṃ.","tha-ap392:20.1":"“Tena kammavipākena,","tha-ap392:20.2":"bhanto [danto (ka.)] nāḷāgirī gajo;","tha-ap392:20.3":"Giribbaje puravare,","tha-ap392:20.4":"dāruṇo samupāgami [maṃ upāgami (sī.)]. [7]","tha-ap392:21.1":"“Rājāhaṃ patthivo [pattiko (syā. ka.), khattiyo (udāna aṭṭha.)] āsiṃ,","tha-ap392:21.2":"sattiyā purisaṃ haniṃ;","tha-ap392:21.3":"Tena kammavipākena,","tha-ap392:21.4":"niraye paccisaṃ bhusaṃ.","tha-ap392:22.1":"“Kammuno tassa sesena,","tha-ap392:22.2":"idāni sakalaṃ mama;","tha-ap392:22.3":"Pāde chaviṃ pakappesi [pakopesi (sī.)],","tha-ap392:22.4":"na hi kammaṃ vinassati. [8]","tha-ap392:23.1":"“Ahaṃ kevaṭṭagāmasmiṃ,","tha-ap392:23.2":"ahuṃ kevaṭṭadārako;","tha-ap392:23.3":"Macchake ghātite disvā,","tha-ap392:23.4":"janayiṃ somanassakaṃ [somanassahaṃ (udāna aṭṭha.)].","tha-ap392:24.1":"“Tena kammavipākena,","tha-ap392:24.2":"sīsadukkhaṃ ahū mama;","tha-ap392:24.3":"Sabbe sakkā ca haññiṃsu,","tha-ap392:24.4":"yadā hani viṭaṭūbho [viṭaṭubho (syā. ka.)]. [9]","tha-ap392:25.1":"“Phussassāhaṃ pāvacane,","tha-ap392:25.2":"sāvake paribhāsayiṃ;","tha-ap392:25.3":"Yavaṃ khādatha bhuñjatha,","tha-ap392:25.4":"mā ca bhuñjatha sālayo.","tha-ap392:26.1":"“Tena kammavipākena,","tha-ap392:26.2":"temāsaṃ khāditaṃ yavaṃ;","tha-ap392:26.3":"Nimantito brāhmaṇena,","tha-ap392:26.4":"verañjāyaṃ vasiṃ tadā. [10]","tha-ap392:27.1":"“Nibbuddhe vattamānamhi,","tha-ap392:27.2":"mallaputtaṃ niheṭhayiṃ [nisedhayiṃ (syā. ka.)];","tha-ap392:27.3":"Tena kammavipākena,","tha-ap392:27.4":"piṭṭhidukkhaṃ ahū mama. [11]","tha-ap392:28.1":"“Tikicchako ahaṃ āsiṃ,","tha-ap392:28.2":"seṭṭhiputtaṃ virecayiṃ;","tha-ap392:28.3":"Tena kammavipākena,","tha-ap392:28.4":"hoti pakkhandikā mama. [12]","tha-ap392:29.1":"“Avacāhaṃ jotipālo,","tha-ap392:29.2":"sugataṃ kassapaṃ tadā;","tha-ap392:29.3":"Kuto nu bodhi muṇḍassa,","tha-ap392:29.4":"bodhi paramadullabhā.","tha-ap392:30.1":"“Tena kammavipākena,","tha-ap392:30.2":"acariṃ dukkaraṃ bahuṃ;","tha-ap392:30.3":"Chabbassānuruveḷāyaṃ,","tha-ap392:30.4":"tato bodhimapāpuṇiṃ.","tha-ap392:31.1":"“Nāhaṃ etena maggena,","tha-ap392:31.2":"pāpuṇiṃ bodhimuttamaṃ;","tha-ap392:31.3":"Kummaggena gavesissaṃ,","tha-ap392:31.4":"pubbakammena vārito.","tha-ap392:32.1":"“Puññapāpaparikkhīṇo,","tha-ap392:32.2":"sabbasantāpavajjito;","tha-ap392:32.3":"Asoko anupāyāso,","tha-ap392:32.4":"nibbāyissamanāsavo.","tha-ap392:33.1":"“Evaṃ jino viyākāsi,","tha-ap392:33.2":"bhikkhusaṅghassa aggato;","tha-ap392:33.3":"Sabbābhiññābalappatto,","tha-ap392:33.4":"anotatte mahāsare”ti.","tha-ap392:34.1":"Itthaṃ sudaṃ bhagavā attano pubbacaritaṃ kammapilotikaṃ nāma buddhāpadānadhammapariyāyaṃ abhāsitthāti.","tha-ap392:35.1":"Pubbakammapilotikaṃ nāma buddhāpadānaṃ dasamaṃ.","tha-ap392:36.1":"Avaṭaphalavaggo ekūnacattālīsamo.","tha-ap392:37.1":"Tassuddānaṃ –","tha-ap392:38.1":"Avaṭaṃ labujañceva,","tha-ap392:38.2":"udumbarapilakkhu ca;","tha-ap392:38.3":"Phāru vallī ca kadalī,","tha-ap392:38.4":"panaso koṭivīsako.","tha-ap392:39.1":"Pubbakammapiloti ca,","tha-ap392:39.2":"apadānaṃ mahesino;","tha-ap392:39.3":"Gāthāyo ekanavuti,","tha-ap392:39.4":"gaṇitāyo vibhāvibhi.","tha-ap392:40.1":"Cuddasamaṃ bhāṇavāraṃ."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3293,"to":3294,"paras":[{"para":3293,"vripara":"64","refs":["tha-ap392:1"],"lines":["Dasamāpadāne <b>anotattasarāsanne</b>ti pabbatakūṭehi paṭicchannattā candimasūriyānaṃ santāpehi otattaṃ uṇhaṃ udakaṃ ettha natthīti anotatto.","Saranti gacchanti pabhavanti sandanti etasmā mahānadiyoti saro.","Sīhamukhādīhi nikkhantā mahānadiyo tikkhattuṃ tikkhattuṃ padakkhiṇaṃ katvā nikkhantanikkhantadisābhāgena saranti gacchantīti attho.","Anotatto ca so saro cāti anotattasaro.","Tassa āsannaṃ samīpaṭṭhānanti anotattasarāsannaṃ, tasmiṃ anotattasarāsanne, samīpeti attho.","<b>Ramaṇīye</b>ti devadānavagandhabbakinnaroragabuddhapaccekabuddhādīhi ramitabbaṃ allīyitabbanti ramaṇīyaṃ, tasmiṃ ramaṇīye.","<b>Silātale</b>ti ekagghanapabbatasilātaleti attho.","<b>Nānāratanapajjote</b>ti padumarāgaveḷuriyādinānāanekehi ratanehi pajjote pakārena jotamāne.","<b>Nānāgandhavanantare</b>ti nānappakārehi candanāgarukappūratamālatilakāsokanāgapunnāgaketakādīhi anekehi sugandhapupphehi gahanībhūtavanantare silātaleti sambandho."],"lineRefs":[["tha-ap392:1"],["tha-ap392:1"],["tha-ap392:1"],["tha-ap392:1"],["tha-ap392:1"],["tha-ap392:1"],["tha-ap392:1"],["tha-ap392:1"],["tha-ap392:1"]]},{"para":3294,"vripara":"65","refs":["tha-ap392:2"],"lines":["Guṇamahantatāya saṅkhyāmahantatāya ca <b>mahatā bhikkhusaṅghena, pareto</b> parivuto <b>lokanāyako</b> lokattayasāmisammāsambuddho tattha silāsane nisinno attano pubbāni kammāni <b>byākarī</b> visesena pākaṭamakāsīti attho.","Sesamettha heṭṭhā buddhāpadāne (apa. thera 1.1.1 ādayo) vuttattā uttānatthattā ca suviññeyyameva.","Buddhāpadāne antogadhampi idhāpadāne kusalākusalaṃ kammasaṃsūcakattā vaggasaṅgahavasena dhammasaṅgāhakattherā saṅgāyiṃsūti."],"lineRefs":[["tha-ap392:2"],["tha-ap392:2"],["tha-ap392:2"]]}],"wordLinks":[["tha-ap392:1.1","anotattasarāsanne",0,0],["tha-ap392:1.1","ramaṇīye",0,5],["tha-ap392:1.1","silātale",0,6],["tha-ap392:1.3","nānāratanapajjote",0,7],["tha-ap392:1.3","nānāgandhavanantare",0,8],["tha-ap392:2.1","lokanāyako",1,0],["tha-ap392:2.1","mahatā bhikkhusaṅghena pareto",1,0],["tha-ap392:2.3","byākarī",1,0]],"before":[{"para":3292,"vripara":null,"title":"Pubbakammapilotikabuddhaapadānavaṇṇanā","lines":["Pubbakammapilotikabuddhaapadānavaṇṇanā"]}],"after":[{"para":3295,"vripara":null,"title":"Pubbakammapilotikabuddhaapadānavaṇṇanā","lines":["Pubbakammapilotikabuddhaapadānavaṇṇanā samattā."]},{"para":3296,"vripara":null,"title":"Pubbakammapilotikabuddhaapadānavaṇṇanā","lines":["Ekūnacattālīsamavaggavaṇṇanā samattā."]}]},"tika":null,"tika2":null}
