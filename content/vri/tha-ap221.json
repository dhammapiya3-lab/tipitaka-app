{"suttaId":"tha-ap221","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7748,7769],"vripara":"44"},"segments":{"tha-ap221:0.3":"Sappidāyakattheraapadānaṃ","tha-ap221:1.1":"“Nisinno pāsādavare, nārīgaṇapurakkhato;","tha-ap221:1.3":"Byādhitaṃ samaṇaṃ disvā, abhināmesahaṃ gharaṃ.","tha-ap221:2.1":"“Upaviṭṭhaṃ mahāvīraṃ, devadevaṃ narāsabhaṃ;","tha-ap221:2.3":"Sappitelaṃ mayā dinnaṃ, siddhatthassa mahesino.","tha-ap221:3.1":"“Passaddhadarathaṃ disvā, vippasannamukhindriyaṃ;","tha-ap221:3.3":"Vanditvā satthuno pāde, anusaṃsāvayiṃ pure.","tha-ap221:4.1":"“Disvā maṃ suppasannattaṃ [suppasannantaṃ (syā. ka.) suppasannacittanti attho], iddhiyā pāramiṅgato;","tha-ap221:4.3":"Nabhaṃ abbhuggamī dhīro, haṃsarājāva ambare.","tha-ap221:5.1":"“Catunnavutito kappe, yaṃ dānamadadiṃ tadā;","tha-ap221:5.3":"Duggatiṃ nābhijānāmi, sappitelassidaṃ phalaṃ.","tha-ap221:6.1":"“Ito sattarase kappe, jutideva [dutideva (syā.), tutideva (ka.)] sanāmako;","tha-ap221:6.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap221:7.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap221:8.1":"Itthaṃ sudaṃ āyasmā sappidāyako thero imā gāthāyo abhāsitthāti.","tha-ap221:9.1":"Sappidāyakattherassāpadānaṃ navamaṃ."},"attha":null,"tika":null,"tika2":null}
