{"suttaId":"tha-ap221","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7748,7769],"vripara":"44"},"segments":{"tha-ap221:0.3":"Sappidāyakattheraapadānaṃ","tha-ap221:1.1":"“Nisinno pāsādavare,","tha-ap221:1.2":"nārīgaṇapurakkhato;","tha-ap221:1.3":"Byādhitaṃ samaṇaṃ disvā,","tha-ap221:1.4":"abhināmesahaṃ gharaṃ. 45.","tha-ap221:2.1":"“Upaviṭṭhaṃ mahāvīraṃ,","tha-ap221:2.2":"devadevaṃ narāsabhaṃ;","tha-ap221:2.3":"Sappitelaṃ mayā dinnaṃ,","tha-ap221:2.4":"siddhatthassa mahesino. 46.","tha-ap221:3.1":"“Passaddhadarathaṃ disvā,","tha-ap221:3.2":"vippasannamukhindriyaṃ;","tha-ap221:3.3":"Vanditvā satthuno pāde,","tha-ap221:3.4":"anusaṃsāvayiṃ pure. 47.","tha-ap221:4.1":"“Disvā maṃ suppasannattaṃ [suppasannantaṃ (syā. ka.) suppasannacittanti attho],","tha-ap221:4.2":"iddhiyā pāramiṅgato;","tha-ap221:4.3":"Nabhaṃ abbhuggamī dhīro,","tha-ap221:4.4":"haṃsarājāva ambare. 48.","tha-ap221:5.1":"“Catunnavutito kappe,","tha-ap221:5.2":"yaṃ dānamadadiṃ tadā;","tha-ap221:5.3":"Duggatiṃ nābhijānāmi,","tha-ap221:5.4":"sappitelassidaṃ phalaṃ. 49.","tha-ap221:6.1":"“Ito sattarase kappe,","tha-ap221:6.2":"jutideva [dutideva (syā.), tutideva (ka.)] sanāmako;","tha-ap221:6.3":"Sattaratanasampanno,","tha-ap221:6.4":"cakkavattī mahabbalo. 50.","tha-ap221:7.1":"“Paṭisambhidā catasso…pe…","tha-ap221:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap221:8.1":"Itthaṃ sudaṃ āyasmā sappidāyako thero imā gāthāyo abhāsitthāti.","tha-ap221:9.1":"Sappidāyakattherassāpadānaṃ navamaṃ. 10."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
