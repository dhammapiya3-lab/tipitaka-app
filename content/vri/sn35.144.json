{"suttaId":"sn35.144","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[912,912],"vripara":"144"},"segments":{"sn35.144:0.3":"Bāhiradukkhahetusuttaṃ","sn35.144:1.1":"“Rūpā, bhikkhave, dukkhā.","sn35.144:1.2":"Yopi hetu, yopi paccayo rūpānaṃ uppādāya, sopi dukkho.","sn35.144:1.3":"Dukkhasambhūtā, bhikkhave, rūpā kuto sukhā bhavissanti!","sn35.144:1.4":"Saddā …","sn35.144:1.5":"gandhā …","sn35.144:1.6":"rasā …","sn35.144:1.7":"phoṭṭhabbā …","sn35.144:1.8":"dhammā dukkhā.","sn35.144:1.9":"Yopi hetu, yopi paccayo dhammānaṃ uppādāya, sopi dukkho.","sn35.144:1.10":"Dukkhasambhūtā, bhikkhave, dhammā kuto sukhā bhavissanti!","sn35.144:1.11":"Evaṃ passaṃ … pe …‘khīṇā jāti, vusitaṃ brahmacariyaṃ, kataṃ karaṇīyaṃ, nāparaṃ itthattāyā’ti pajānātī”ti.","sn35.144:1.13":"Ekādasamaṃ."},"unsure":["sn35.144:1.11"],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":263,"to":266,"paras":[{"para":263,"vripara":"137-145","refs":["sn35.144:1"],"lines":["137-145. Catutthaṃ suddhikaṃ katvā desiyamāne bujjhanakānaṃ ajjhāsayena vuttaṃ.","Pañcamādīni tathā tathā bujjhantānaṃ ajjhāsayena vuttāni.","Attho pana tesaṃ pākaṭoyevāti."],"lineRefs":[["sn35.144:1"],["sn35.144:1"],["sn35.144:1"]]},{"para":264,"vripara":null,"refs":["sn35.144:1"],"lines":["Devadahavaggo cuddasamo."],"lineRefs":[["sn35.144:1"]]},{"para":265,"vripara":null,"refs":["sn35.144:1"],"lines":["Navapurāṇavaggo"],"lineRefs":[["sn35.144:1"]]},{"para":266,"vripara":null,"refs":["sn35.144:1"],"lines":["Kammanirodhasuttavaṇṇanā"],"lineRefs":[["sn35.144:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":273,"to":277,"paras":[{"para":273,"vripara":"137-145","refs":["sn35.144:1"],"lines":["137-145. <b>Suddhikaṃ katvā</b> gāthābandhanena vinā kevalaṃ cuṇṇiyapadavaseneva.","<b>Tathā tathā</b>ti ajjhattikāni bāhirāni ca āyatanāni aniccalakkhaṇena dukkhānattalakkhaṇehi ca yojetvā dassanavasena."],"lineRefs":[["sn35.144:1"],["sn35.144:1"]]},{"para":274,"vripara":null,"refs":["sn35.144:1"],"lines":["Dutiyarūpārāmasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.144:1"]]},{"para":275,"vripara":null,"refs":["sn35.144:1"],"lines":["Devadahavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.144:1"]]},{"para":276,"vripara":null,"refs":["sn35.144:1"],"lines":["Navapurāṇavaggo"],"lineRefs":[["sn35.144:1"]]},{"para":277,"vripara":null,"refs":["sn35.144:1"],"lines":["Kammanirodhasuttavaṇṇanā"],"lineRefs":[["sn35.144:1"]]}],"wordLinks":[]},"tika2":null}
