{"suttaId":"an4.152","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1224,1224],"vripara":"152"},"segments":{"an4.152:0.3":"Saddhābalasuttaṃ","an4.152:1.1":"“Cattārimāni, bhikkhave, balāni.","an4.152:1.2":"Katamāni cattāri?","an4.152:1.3":"Saddhābalaṃ, vīriyabalaṃ, satibalaṃ, samādhibalaṃ – imāni kho, bhikkhave, cattāri balānī”ti.","an4.152:1.5":"Dutiyaṃ."},"attha":null,"tika":null}
