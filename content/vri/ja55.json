{"suttaId":"ja55","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[307,311],"vripara":"55"},"segments":{"ja55:0.4":"Pañcāvudhajātakaṃ","ja55:1.1":"Yo alīnena cittena, alīnamanaso naro;","ja55:1.3":"Bhāveti kusalaṃ dhammaṃ, yogakkhemassa pattiyā;","ja55:1.5":"Pāpuṇe anupubbena, sabbasaṃyojanakkhayanti.","ja55:2.1":"Pañcāvudhajātakaṃ pañcamaṃ."},"attha":null,"tika":null}
