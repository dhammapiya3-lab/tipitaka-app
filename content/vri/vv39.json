{"suttaId":"vv39","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1528,1552],"vripara":"689"},"segments":{"vv39:0.4":"Mañjiṭṭhakavimānavatthu","vv39:1.1":"“Mañjiṭṭhake [mañjeṭṭhake (sī.)] vimānasmiṃ, soṇṇavālukasanthate [sovaṇṇavālukasanthate (syā. pī.), sovaṇṇavālikasanthate (ka.)];","vv39:1.3":"Pañcaṅgike turiyena [turiyena (sī. syā. pī.)], ramasi suppavādite.","vv39:2.1":"“Tamhā vimānā oruyha, nimmitā ratanāmayā;","vv39:2.3":"Ogāhasi sālavanaṃ, pupphitaṃ sabbakālikaṃ.","vv39:3.1":"“Yassa yasseva sālassa, mūle tiṭṭhasi devate;","vv39:3.3":"So so muñcati pupphāni, onamitvā dumuttamo.","vv39:4.1":"“Vāteritaṃ sālavanaṃ, ādhutaṃ [ādhūtaṃ (sī.)] dijasevitaṃ;","vv39:4.3":"Vāti gandho disā sabbā, rukkho mañjūsako yathā.","vv39:5.1":"“Ghāyase taṃ sucigandhaṃ, rūpaṃ passasi amānusaṃ;","vv39:5.3":"Devate pucchitācikkha, kissa kammassidaṃ phalan”ti.","vv39:6.1":"“Ahaṃ manussesu manussabhūtā, dāsī ayirakule [ayyirakule (syā. ka.)] ahuṃ;","vv39:6.3":"Buddhaṃ nisinnaṃ disvāna, sālapupphehi okiriṃ.","vv39:7.1":"“Vaṭaṃsakañca sukataṃ, sālapupphamayaṃ ahaṃ;","vv39:7.3":"Buddhassa upanāmesiṃ, pasannā sehi pāṇibhi.","vv39:8.1":"“Tāhaṃ kammaṃ karitvāna, kusalaṃ buddhavaṇṇitaṃ;","vv39:8.3":"Apetasokā sukhitā, sampamodāmanāmayā”ti.","vv39:9.1":"Mañjiṭṭhakavimānaṃ paṭhamaṃ."},"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1792,"to":1805,"paras":[{"para":1792,"vripara":"689","refs":["vv39:1"],"words":["mañjiṭṭhake vimānasmiṃ","soṇṇavālukasanthate","ramasi suppavādite"],"lines":["Tattha <b>mañjiṭṭhake vimānasmin</b>ti rattaphalikamaye vimāne.","Sinduvārakaṇavīramakulasadisavaṇṇañhi “mañjiṭṭhakan”ti vuccati.","<b>Soṇṇavālukasanthate</b>ti samantato vippakiṇṇāhi suvaṇṇavālukāhi santhatabhūmibhāge.","<b>Ramasi suppavādite</b>ti suṭṭhu pavāditena pañcaṅgikena tūriyena abhiramasi."],"lineRefs":[["vv39:1"],["vv39:1"],["vv39:1"],["vv39:1"]]},{"para":1793,"vripara":"690","refs":["vv39:2"],"words":["ogāhasī","sabbakālikaṃ"],"lines":["<b>Nimittā ratanāmayā</b>ti tava sucaritasippinā abhinimmitā ratanamayā vimānā.","<b>Ogāhasī</b>ti pavisasi.","<b>Sabbakālikan</b>ti sabbakāle sukhaṃ sabbautusappāyaṃ, sabbakāle pupphanakaṃ vā."],"lineRefs":[["vv39:2"],["vv39:2"],["vv39:2"]]},{"para":1794,"vripara":"692","refs":["vv39:4"],"words":["vāteritaṃ","ādhutaṃ","dijasevitaṃ"],"lines":["<b>Vāteritan</b>ti yathā pupphāni okiranti, evaṃ vātena īritaṃ calitaṃ.","<b>Ādhutan</b>ti mandena mālutena saṇikasaṇikaṃ vidhūpayamānaṃ.","<b>Dijasevitan</b>ti mayūrakokilādisakuṇasaṅghehi upasevitaṃ."],"lineRefs":[["vv39:4"],["vv39:4"],["vv39:4"]]},{"para":1795,"vripara":null,"refs":[],"words":[],"lines":["Evaṃ therena puṭṭhā sā devatā imāhi gāthāhi byākāsi –"],"lineRefs":[[]]},{"para":1797,"vripara":"694","refs":[],"words":[],"lines":["“Ahaṃ manussesu manussabhūtā, dāsī ayirakule ahuṃ;"],"lineRefs":[[]]},{"para":1798,"vripara":null,"refs":[],"words":[],"lines":["Buddhaṃ nisinnaṃ disvāna, sālapupphehi okiriṃ."],"lineRefs":[[]]},{"para":1800,"vripara":"695","refs":[],"words":[],"lines":["“Vaṭaṃsakañca sukataṃ, sālapupphamayaṃ ahaṃ;"],"lineRefs":[[]]},{"para":1801,"vripara":null,"refs":[],"words":[],"lines":["Buddhassa upanāmesiṃ, pasannā sehi pāṇibhi."],"lineRefs":[[]]},{"para":1803,"vripara":"696","refs":[],"words":[],"lines":["“Tāhaṃ kammaṃ karitvāna, kusalaṃ buddhavaṇṇitaṃ;"],"lineRefs":[[]]},{"para":1804,"vripara":null,"refs":[],"words":[],"lines":["Apetasokā sukhitā, sampamodāmanāmayā”ti."],"lineRefs":[[]]},{"para":1805,"vripara":"694-695","refs":["vv39:6"],"words":["ayirakule","ahuṃ","okiriṃ"],"lines":["694-5. Tattha <b>ayirakule</b>ti ayyakule, sāmikageheti attho.","<b>Ahun</b>ti ahosiṃ.","<b>Okirin</b>ti pupphehi vippakiriṃ.","<b>Upanāmesin</b>ti pūjāvasena upanāmesiṃ.","Sesaṃ vuttanayameva."],"lineRefs":[["vv39:6"],["vv39:6"],["vv39:6"],["vv39:6"],["vv39:6"]]}]},"tika":null}
