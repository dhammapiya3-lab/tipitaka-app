{"suttaId":"vv39","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1528,1552],"vripara":"689"},"segments":{"vv39:0.4":"Mañjiṭṭhakavimānavatthu","vv39:1.1":"“Mañjiṭṭhake [mañjeṭṭhake (sī.)] vimānasmiṃ,","vv39:1.2":"soṇṇavālukasanthate [sovaṇṇavālukasanthate (syā. pī.), sovaṇṇavālikasanthate (ka.)];","vv39:1.3":"Pañcaṅgike turiyena [turiyena (sī. syā. pī.)],","vv39:1.4":"ramasi suppavādite. 690.","vv39:2.1":"“Tamhā vimānā oruyha,","vv39:2.2":"nimmitā ratanāmayā;","vv39:2.3":"Ogāhasi sālavanaṃ,","vv39:2.4":"pupphitaṃ sabbakālikaṃ. 691.","vv39:3.1":"“Yassa yasseva sālassa,","vv39:3.2":"mūle tiṭṭhasi devate;","vv39:3.3":"So so muñcati pupphāni,","vv39:3.4":"onamitvā dumuttamo. 692.","vv39:4.1":"“Vāteritaṃ sālavanaṃ,","vv39:4.2":"ādhutaṃ [ādhūtaṃ (sī.)] dijasevitaṃ;","vv39:4.3":"Vāti gandho disā sabbā,","vv39:4.4":"rukkho mañjūsako yathā. 693.","vv39:5.1":"“Ghāyase taṃ sucigandhaṃ,","vv39:5.2":"rūpaṃ passasi amānusaṃ;","vv39:5.3":"Devate pucchitācikkha,","vv39:5.4":"kissa kammassidaṃ phala”nti. 694.","vv39:6.1":"“Ahaṃ manussesu manussabhūtā,","vv39:6.2":"dāsī ayirakule [ayyirakule (syā. ka.)] ahuṃ;","vv39:6.3":"Buddhaṃ nisinnaṃ disvāna,","vv39:6.4":"sālapupphehi okiriṃ. 695.","vv39:7.1":"“Vaṭaṃsakañca sukataṃ,","vv39:7.2":"sālapupphamayaṃ ahaṃ;","vv39:7.3":"Buddhassa upanāmesiṃ,","vv39:7.4":"pasannā sehi pāṇibhi. 696.","vv39:8.1":"“Tāhaṃ kammaṃ karitvāna,","vv39:8.2":"kusalaṃ buddhavaṇṇitaṃ;","vv39:8.3":"Apetasokā sukhitā,","vv39:8.4":"sampamodāmanāmayā”ti.","vv39:9.1":"Mañjiṭṭhakavimānaṃ paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1792,"to":1805,"paras":[{"para":1792,"vripara":"689","refs":["vv39:1"],"lines":["Tattha <b>mañjiṭṭhake vimānasmi</b>nti rattaphalikamaye vimāne.","Sinduvārakaṇavīramakulasadisavaṇṇañhi “mañjiṭṭhaka”nti vuccati.","<b>Soṇṇavālukasanthate</b>ti samantato vippakiṇṇāhi suvaṇṇavālukāhi santhatabhūmibhāge.","<b>Ramasi suppavādite</b>ti suṭṭhu pavāditena pañcaṅgikena tūriyena abhiramasi. 690."],"lineRefs":[["vv39:1"],["vv39:1"],["vv39:1"],["vv39:1"]]},{"para":1793,"vripara":"690","refs":["vv39:1","vv39:2"],"lines":["<b>Nimittā</b> <b>ratanāmayā</b>ti tava sucaritasippinā abhinimmitā ratanamayā vimānā.","<b>Ogāhasī</b>ti pavisasi.","<b>Sabbakālika</b>nti sabbakāle sukhaṃ sabbautusappāyaṃ, sabbakāle pupphanakaṃ vā. 692."],"lineRefs":[["vv39:1"],["vv39:2"],["vv39:2"]]},{"para":1794,"vripara":"692","refs":["vv39:4"],"lines":["<b>Vāterita</b>nti yathā pupphāni okiranti, evaṃ vātena īritaṃ calitaṃ.","<b>Ādhuta</b>nti mandena mālutena saṇikasaṇikaṃ vidhūpayamānaṃ.","<b>Dijasevita</b>nti mayūrakokilādisakuṇasaṅghehi upasevitaṃ."],"lineRefs":[["vv39:4"],["vv39:4"],["vv39:4"]]},{"para":1795,"vripara":null,"refs":["vv39:4"],"lines":["Evaṃ therena puṭṭhā sā devatā imāhi gāthāhi byākāsi – 694."],"lineRefs":[["vv39:4"]]},{"para":1797,"vripara":"694","refs":["vv39:4"],"lines":["“Ahaṃ manussesu manussabhūtā, dāsī ayirakule ahuṃ;"],"lineRefs":[["vv39:4"]]},{"para":1798,"vripara":null,"refs":["vv39:4"],"lines":["Buddhaṃ nisinnaṃ disvāna, sālapupphehi okiriṃ. 695."],"lineRefs":[["vv39:4"]]},{"para":1800,"vripara":"695","refs":["vv39:4"],"lines":["“Vaṭaṃsakañca sukataṃ, sālapupphamayaṃ ahaṃ;"],"lineRefs":[["vv39:4"]]},{"para":1801,"vripara":null,"refs":["vv39:4"],"lines":["Buddhassa upanāmesiṃ, pasannā sehi pāṇibhi. 696."],"lineRefs":[["vv39:4"]]},{"para":1803,"vripara":"696","refs":["vv39:4"],"lines":["“Tāhaṃ kammaṃ karitvāna, kusalaṃ buddhavaṇṇitaṃ;"],"lineRefs":[["vv39:4"]]},{"para":1804,"vripara":null,"refs":["vv39:4"],"lines":["Apetasokā sukhitā, sampamodāmanāmayā”ti. 694-5."],"lineRefs":[["vv39:4"]]},{"para":1805,"vripara":"694-695","refs":["vv39:6"],"lines":["Tattha <b>ayirakule</b>ti ayyakule, sāmikageheti attho.","<b>Ahu</b>nti ahosiṃ.","<b>Okiri</b>nti pupphehi vippakiriṃ.","<b>Upanāmesi</b>nti pūjāvasena upanāmesiṃ.","Sesaṃ vuttanayameva."],"lineRefs":[["vv39:6"],["vv39:6"],["vv39:6"],["vv39:6"],["vv39:6"]]}],"wordLinks":[["vv39:1.1","mañjiṭṭhake vimānasmiṃ",0,0],["vv39:1.1","soṇṇavālukasanthate",0,2],["vv39:1.3","ramasi suppavādite",0,3],["vv39:2.3","ogāhasī",1,1],["vv39:2.3","sabbakālikaṃ",1,2],["vv39:4.1","vāteritaṃ",2,0],["vv39:4.1","ādhutaṃ",2,1],["vv39:4.1","dijasevitaṃ",2,2],["vv39:6.1","ayirakule",10,0],["vv39:6.1","ahuṃ",10,1],["vv39:6.3","okiriṃ",10,2]],"before":[{"para":1774,"vripara":null,"title":"Mañjiṭṭhakavaggo","lines":["Mañjiṭṭhakavaggo 1."]},{"para":1775,"vripara":null,"title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["Mañjiṭṭhakavimānavaṇṇanā"]},{"para":1776,"vripara":null,"title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["Mañjiṭṭhakavagge <b>mañjiṭṭhake vimānasmi</b>nti mañjiṭṭhakavimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tattha aññataro upāsako bhagavantaṃ nimantetvā anantaravimāne vuttanayeneva maṇḍapaṃ sajjetvā tattha nisinnaṃ satthāraṃ pūjetvā dānaṃ deti.","Tena ca samayena aññatarā kuladāsī andhavane supupphitaṃ sālarukkhaṃ disvā tattha pupphāni gahetvā hīrehi āvuṇitvā vaṭaṃsake katvā puna bahūni muttapupphāni aggapupphāni ca gahetvā nagaraṃ paviṭṭhā.","Tasmiṃ maṇḍape yugandharapabbatakucchiṃ obhāsayamānaṃ bālasūriyaṃ viya chabbaṇṇabuddharaṃsiyo vissajjetvā nisinnaṃ, bhagavantaṃ disvā pasannacittā tehi pupphehi pūjentī vaṭaṃsakāni āsanassa samantato ṭhapetvā itarāni ca pupphāni okiritvā sakkaccaṃ vanditvā tikkhattuṃ padakkhiṇaṃ katvā agamāsi.","Sā aparabhāge kālaṃ katvā tāvatiṃsabhavane nibbatti, tattha tassā rattaphalikamayaṃ vimānaṃ, tassa ca purato suvaṇṇavālukāsanthatabhūmibhāgaṃ mahantaṃ sālavanaṃ pāturahosi.","Sā yadā vimānato nikkhamitvā sālavanaṃ pavisati, tadā sālasākhā onamitvā tassā upari kusumāni okiranti.","Taṃ āyasmā mahāmoggallāno heṭṭhā vuttanayena upagantvā imāhi gāthāhi katakammaṃ pucchi – 689."]},{"para":1778,"vripara":"689","title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["“Mañjiṭṭhake vimānasmiṃ, soṇṇavālukasanthate;"]},{"para":1779,"vripara":null,"title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["Pañcaṅgikena tūriyena, ramasi suppavādite. 690."]},{"para":1781,"vripara":"690","title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["“Tamhā vimānā oruyha, nimmitā ratanāmayā;"]},{"para":1782,"vripara":null,"title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["Ogāhasi sālavanaṃ, pupphitaṃ sabbakālikaṃ. 691."]},{"para":1784,"vripara":"691","title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["“Yassa yasseva sālassa, mūle tiṭṭhasi devate;"]},{"para":1785,"vripara":null,"title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["So so muñcati pupphāni, onamitvā dumuttamo. 692."]},{"para":1787,"vripara":"692","title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["“Vāteritaṃ sālavanaṃ, ādhutaṃ dijasevitaṃ;"]},{"para":1788,"vripara":null,"title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["Vāti gandho disā sabbā, rukkho mañjūsako yathā. 693."]},{"para":1790,"vripara":"693","title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["“Ghāyase taṃ sucigandhaṃ, rūpaṃ passasi amānusaṃ;"]},{"para":1791,"vripara":null,"title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["Devate pucchitācikkha, kissa kammassidaṃ phala”nti. 689."]}],"after":[{"para":1806,"vripara":null,"title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["Athāyasmā mahāmoggallāno saparivārāya tassā devatāya dhammaṃ desetvā manussalokaṃ āgantvā bhagavato tamatthaṃ nivedesi.","Bhagavā taṃ aṭṭhuppattiṃ katvā sampattamahājanassa dhammaṃ desesi.","Desanā sadevakassa lokassa sātthikā ahosīti."]},{"para":1807,"vripara":null,"title":"Mañjiṭṭhakavimānavaṇṇanā","lines":["Mañjiṭṭhakavimānavaṇṇanā niṭṭhitā. 2."]}]},"tika":null,"tika2":null}
