{"suttaId":"thag3.14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1284,1293],"vripara":"258"},"segments":{"thag3.14:0.4":"Gotamattheragāthā","thag3.14:1.1":"“Saṃsaraṃ hi nirayaṃ agacchissaṃ, petalokamagamaṃ punappunaṃ;","thag3.14:1.3":"Dukkhamamhipi tiracchānayoniyaṃ, nekadhā hi vusitaṃ ciraṃ mayā.","thag3.14:2.1":"“Mānusopi ca bhavobhirādhito, saggakāyamagamaṃ sakiṃ sakiṃ;","thag3.14:2.3":"Rūpadhātusu arūpadhātusu, nevasaññisu asaññisuṭṭhitaṃ.","thag3.14:3.1":"“Sambhavā suviditā asārakā, saṅkhatā pacalitā saderitā;","thag3.14:3.3":"Taṃ viditvā mahamattasambhavaṃ, santimeva satimā samajjhagan”ti.","thag3.14:3.5":"… Gotamo thero …."},"attha":null,"tika":null}
