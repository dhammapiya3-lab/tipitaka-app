{"suttaId":"snp4.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[2745,2769],"vripara":"802"},"segments":{"snp4.5:0.2":"Paramaṭṭhakasuttaṃ","snp4.5:1.1":"Paramanti diṭṭhīsu paribbasāno,","snp4.5:1.2":"yaduttari kurute jantu loke;","snp4.5:1.3":"Hīnāti aññe tato sabbamāha,","snp4.5:1.4":"tasmā vivādāni avītivatto. 803.","snp4.5:2.1":"Yadattanī passati ānisaṃsaṃ,","snp4.5:2.2":"diṭṭhe sute sīlavate [sīlabbate (syā.)] mute vā;","snp4.5:2.3":"Tadeva so tattha samuggahāya,","snp4.5:2.4":"nihīnato passati sabbamaññaṃ. 804.","snp4.5:3.1":"Taṃ vāpi ganthaṃ kusalā vadanti,","snp4.5:3.2":"yaṃ nissito passati hīnamaññaṃ;","snp4.5:3.3":"Tasmā hi diṭṭhaṃ va sutaṃ mutaṃ vā,","snp4.5:3.4":"sīlabbataṃ bhikkhu na nissayeyya. 805.","snp4.5:4.1":"Diṭṭhimpi lokasmiṃ na kappayeyya,","snp4.5:4.2":"ñāṇena vā sīlavatena vāpi;","snp4.5:4.3":"Samoti attānamanūpaneyya,","snp4.5:4.4":"hīno na maññetha visesi vāpi. 806.","snp4.5:5.1":"Attaṃ pahāya anupādiyāno,","snp4.5:5.2":"ñāṇepi so nissayaṃ no karoti;","snp4.5:5.3":"Sa ve viyattesu [viyuttesu (sī. aṭṭha.), dviyattesu (ka.)] na vaggasārī,","snp4.5:5.4":"diṭṭhimpi [diṭṭhimapi (ka.)] so na pacceti kiñci. 807.","snp4.5:6.1":"Yassūbhayante paṇidhīdha natthi,","snp4.5:6.2":"bhavābhavāya idha vā huraṃ vā;","snp4.5:6.3":"Nivesanā tassa na santi keci,","snp4.5:6.4":"dhammesu niccheyya samuggahītaṃ. 808.","snp4.5:7.1":"Tassīdha diṭṭhe va sute mute vā,","snp4.5:7.2":"pakappitā natthi aṇūpi saññā;","snp4.5:7.3":"Taṃ brāhmaṇaṃ diṭṭhimanādiyānaṃ,","snp4.5:7.4":"kenīdha lokasmiṃ vikappayeyya. 809.","snp4.5:8.1":"Na kappayanti na purekkharonti,","snp4.5:8.2":"dhammāpi tesaṃ na paṭicchitāse;","snp4.5:8.3":"Na brāhmaṇo sīlavatena neyyo,","snp4.5:8.4":"pāraṅgato na pacceti tādīti.","snp4.5:8.5":"Paramaṭṭhakasuttaṃ pañcamaṃ niṭṭhitaṃ. 6."},"unsure":[],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2243,"to":2243,"paras":[{"para":2243,"vripara":"808-810","refs":["snp4.5:7"],"lines":["Idāni yo so imāya gāthāya vutto khīṇāsavo, tassa vaṇṇabhaṇanatthaṃ <b>“yassūbhayante”</b>tiādikā tisso gāthāyo āha.","Tattha <b>ubhayante</b>ti pubbe vuttaphassādibhede.","<b>Paṇidhī</b>ti taṇhā.","<b>Bhavābhavāyā</b>ti punappunabhavāya.","<b>Idha vā huraṃ vā</b>ti sakattabhāvādibhede idha vā parattabhāvādibhede parattha vā.","<b>Diṭṭhe vā</b>ti diṭṭhasuddhiyā vā.","Esa nayo sutādīsu.","<b>Saññā</b>ti saññāsamuṭṭhāpikā diṭṭhi.","<b>Dhammāpi</b> <b>tesaṃ na paṭicchitāse</b>ti dvāsaṭṭhidiṭṭhigatadhammāpi tesaṃ “idameva saccaṃ moghamañña”nti evaṃ na paṭicchitā.","<b>Pāraṅgato na pacceti tādī</b>ti nibbānapāraṃ gato tena tena maggena pahīne kilese puna nāgacchati, pañcahi ca ākārehi tādī hotīti.","Sesaṃ pākaṭamevāti."],"lineRefs":[["snp4.5:7"],["snp4.5:7"],["snp4.5:7"],["snp4.5:7"],["snp4.5:7"],["snp4.5:7"],["snp4.5:7"],["snp4.5:7"],["snp4.5:7"],["snp4.5:7"],["snp4.5:7"]]}],"wordLinks":[["snp4.5:7.1","diṭṭhe vā",0,5],["snp4.5:7.1","saññā",0,7]]},"tika":null,"tika2":null}
