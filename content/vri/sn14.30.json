{"suttaId":"sn14.30","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[825,825],"vripara":"114"},"segments":{"sn14.30:0.3":"Catudhātusuttaṃ","sn14.30:1.1":"Ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme … pe …“catasso imā, bhikkhave, dhātuyo.","sn14.30:1.3":"Katamā catasso?","sn14.30:1.4":"Pathavīdhātu, āpodhātu, tejodhātu, vāyodhātu – imā kho, bhikkhave, catasso dhātuyo”ti.","sn14.30:1.6":"Paṭhamaṃ."},"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":596,"to":596,"paras":[{"para":596,"vripara":"114","refs":["sn14.30:1"],"words":["pathavīdhātū","āpodhātū","tejodhātū","vāyodhātū"],"lines":["Catutthavaggassa paṭhame <b>pathavīdhātū</b>ti patiṭṭhādhātu.","<b>Āpodhātū</b>ti ābandhanadhātu.","<b>Tejodhātū</b>ti paripācanadhātu.","<b>Vāyodhātū</b>ti vitthambhanadhātu.","Ayamettha saṅkhepo, vitthārato pana vīsatikoṭṭhāsādivasena etā kathetabbā.","Paṭhamaṃ."],"lineRefs":[["sn14.30:1"],["sn14.30:1"],["sn14.30:1"],["sn14.30:1"],["sn14.30:1"],["sn14.30:1"]]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":590,"to":590,"paras":[{"para":590,"vripara":"114","refs":["sn14.30:1"],"words":["etā"],"lines":["<b>Patiṭṭhādhātū</b>ti sahajātānaṃ dhammānaṃ patiṭṭhābhūtā dhātu.","<b>Ābandhanadhātū</b>ti nahāniyacuṇṇassa udakaṃ viya sahajātadhammānaṃ ābandhanabhūtā dhātu.","<b>Paripācanadhātū</b>ti sūriyo phalādīnaṃ viya sahajātadhammānaṃ paripācanabhūtā dhātu.","<b>Vitthambhanadhātū</b>ti dutiyo viya sahajātadhammānaṃ vitthambhanabhūtā dhātu.","Kesādayo <b>vīsati koṭṭhāsā.</b>","<b>Ādi</b> -saddena pittādayo santappanādayo uddhaṅgamā vātādayo gahitā.","<b>Etā</b>ti dhātuyo."],"lineRefs":[["sn14.30:1"],["sn14.30:1"],["sn14.30:1"],["sn14.30:1"],["sn14.30:1"],["sn14.30:1"],["sn14.30:1"]]}]}}
