{"suttaId":"ja86","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[483,486],"vripara":"86"},"segments":{"ja86:0.4":"Sīlavīmaṃsakajātakaṃ","ja86:1.1":"Sīlaṃ kireva kalyāṇaṃ, sīlaṃ loke anuttaraṃ;","ja86:1.3":"Passa ghoraviso nāgo, sīlavāti na haññatīti.","ja86:2.1":"Sīlavīmaṃsakajātakaṃ chaṭṭhaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2265,"to":2265,"paras":[{"para":2265,"vripara":null,"refs":["ja86:1"],"lines":["Tattha <b>sīlaṃ kirevā</b>ti kāyavācācittehi avītikkamasaṅkhātaṃ ācārasīlameva.","<b>Kirā</b>ti anussavavasena vadati.","<b>Kalyāṇan</b>ti sundarataraṃ.","<b>Anuttaran</b>ti jeṭṭhakaṃ sabbaguṇadāyakaṃ.","<b>Passā</b>ti attanā diṭṭhakāraṇaṃ abhimukhaṃ karonto katheti.","<b>Sīlavāti na haññatī</b>ti ghoravisopi samāno aḍaṃsanaaviheṭhanamattakena sīlavāti pasaṃsaṃ labhati, na haññati na vihaññatīti.","Imināpi kāraṇena sīlameva uttamanti."],"lineRefs":[["ja86:1"],["ja86:1"],["ja86:1"],["ja86:1"],["ja86:1"],["ja86:1"],["ja86:1"]]}],"wordLinks":[["ja86:1.1","sīlaṃ kirevā",0,0],["ja86:1.1","kirā",0,1],["ja86:1.1","kalyāṇaṃ",0,2],["ja86:1.1","anuttaraṃ",0,3],["ja86:1.3","passā",0,4],["ja86:1.3","sīlavāti na haññatī",0,5]]},"tika":null,"tika2":null}
