{"suttaId":"sn2.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[914,920],"vripara":"85"},"segments":{"sn2.4:0.3":"Māgadhasuttaṃ","sn2.4:1.1":"Sāvatthinidānaṃ.","sn2.4:1.2":"Ekamantaṃ ṭhito kho māgadho devaputto bhagavantaṃ gāthāya ajjhabhāsi –","sn2.4:2.1":"“Kati lokasmiṃ pajjotā,","sn2.4:2.2":"yehi loko pakāsati;","sn2.4:2.3":"Bhavantaṃ puṭṭhumāgamma,","sn2.4:2.4":"kathaṃ jānemu taṃ mayan”ti.","sn2.4:3.1":"“Cattāro loke pajjotā,","sn2.4:3.2":"pañcamettha na vijjati;","sn2.4:3.3":"Divā tapati ādicco,","sn2.4:3.4":"rattimābhāti candimā.","sn2.4:4.1":"“Atha aggi divārattiṃ,","sn2.4:4.2":"tattha tattha pakāsati;","sn2.4:4.3":"Sambuddho tapataṃ seṭṭho,","sn2.4:4.4":"esā ābhā anuttarā”ti."},"unsure":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":514,"to":515,"paras":[{"para":514,"vripara":"85","refs":["sn2.4:1"],"lines":["Catutthaṃ vuttatthameva.","Catutthaṃ."],"lineRefs":[["sn2.4:1"],["sn2.4:1"]]},{"para":515,"vripara":null,"refs":["sn2.4:1"],"lines":["Dāmalisuttavaṇṇanā"],"lineRefs":[["sn2.4:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":645,"to":647,"paras":[{"para":645,"vripara":"85","refs":["sn2.4:1"],"lines":["<b>Catutthasuttaṃ vuttatthamevā</b>ti devatāsaṃyutte saṃvaṇṇitatthameva, tasmā idha na vattabbo atthoti adhippāyo."],"lineRefs":[["sn2.4:1"]]},{"para":646,"vripara":null,"refs":["sn2.4:1"],"lines":["Māgadhasuttavaṇṇanā niṭṭhitā"],"lineRefs":[["sn2.4:1"]]},{"para":647,"vripara":null,"refs":["sn2.4:1"],"lines":["Dāmalisuttavaṇṇanā"],"lineRefs":[["sn2.4:1"]]}],"wordLinks":[]},"tika2":null}
