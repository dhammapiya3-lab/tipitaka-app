{"suttaId":"tha-ap310","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9179,9191],"vripara":"39"},"segments":{"tha-ap310:0.3":"Anulepadāyakattheraapadānaṃ","tha-ap310:1.1":"“Atthadassissa munino, addasaṃ sāvakaṃ ahaṃ;","tha-ap310:1.3":"Navakammaṃ karontassa, sīmāya upagacchahaṃ.","tha-ap310:2.1":"“Niṭṭhite navakamme ca, anulepamadāsahaṃ;","tha-ap310:2.3":"Pasannacitto sumano, puññakkhette anuttare.","tha-ap310:3.1":"“Aṭṭhārase kappasate, yaṃ kammamakariṃ tadā;","tha-ap310:3.3":"Duggatiṃ nābhijānāmi, anulepassidaṃ phalaṃ.","tha-ap310:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap310:5.1":"Itthaṃ sudaṃ āyasmā anulepadāyako thero imā gāthāyo abhāsitthāti.","tha-ap310:6.1":"Anulepadāyakattherassāpadānaṃ aṭṭhamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3264,"to":3264,"paras":[{"para":3264,"vripara":"40","refs":["tha-ap310:2"],"lines":["Aṭṭhamāpadāne <b>niṭṭhite navakamme cā</b>ti sīmāya navakamme niṭṭhaṃ gate sati.","<b>Anulepamadāsahan</b>ti anupacchā sudhālepaṃ adāsiṃ, sudhāya lepāpesinti attho."],"lineRefs":[["tha-ap310:2"],["tha-ap310:2"]]}],"wordLinks":[["tha-ap310:2.1","niṭṭhite navakamme cā",0,0],["tha-ap310:2.1","anulepamadāsahaṃ",0,1]]},"tika":null,"tika2":null}
