{"suttaId":"tha-ap554","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[6011,6029],"vripara":"29"},"segments":{"tha-ap554:0.3":"Nadīkassapattheraapadānaṃ","tha-ap554:1.1":"“Padumuttarassa bhagavato, lokajeṭṭhassa tādino;","tha-ap554:1.3":"Piṇḍacāraṃ carantassa, vārato uttamaṃ yasaṃ;","tha-ap554:1.5":"Aggaphalaṃ gahetvāna, adāsiṃ satthuno ahaṃ.","tha-ap554:2.1":"“Tena kammena devindo, lokajeṭṭho narāsabho;","tha-ap554:2.3":"Sampattomhi acalaṃ ṭhānaṃ, hitvā jayaparājayaṃ.","tha-ap554:3.1":"“Satasahassito kappe, yaṃ phalaṃ adadiṃ tadā;","tha-ap554:3.3":"Duggatiṃ nābhijānāmi, aggadānassidaṃ phalaṃ.","tha-ap554:4.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap554:5.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap554:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap554:7.1":"Itthaṃ sudaṃ āyasmā nadīkassapo thero imā gāthāyo Abhāsitthāti.","tha-ap554:8.1":"Nadīkassapattherassāpadānaṃ dutiyaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3794,"to":3794,"paras":[{"para":3794,"vripara":"29","refs":["tha-ap554:1"],"lines":["Evaṃ ādittapariyāyadesanaṃ sutvā saha paṭisambhidāhi arahattaṃ sampatto nadīkassapo thero somanassajāto attano pubbacaritāpadānaṃ pakāsento <b>padumuttarassa bhagavato</b>tiādimāha.","Tattha <b>aggaphalan</b>ti uttamaphalaṃ, attanā ropitaambarukkhassa ādimhi gahitaphalaṃ vā.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap554:1"],["tha-ap554:1"],["tha-ap554:1"]]}],"wordLinks":[["tha-ap554:1.1","padumuttarassa bhagavato",0,0],["tha-ap554:1.5","aggaphalaṃ",0,1]]},"tika":null,"tika2":null}
