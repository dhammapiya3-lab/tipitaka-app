{"suttaId":"sn22.107","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[728,728],"vripara":"107"},"segments":{"sn22.107:0.3":"Samaṇasuttaṃ","sn22.107:1.1":"Sāvatthinidānaṃ.","sn22.107:1.2":"“Pañcime, bhikkhave, upādānakkhandhā.","sn22.107:1.3":"Katame pañca?","sn22.107:1.4":"Seyyathidaṃ – rūpupādānakkhandho … pe … viññāṇupādānakkhandho.","sn22.107:1.5":"Ye hi keci, bhikkhave, samaṇā vā brāhmaṇā vā imesaṃ pañcannaṃ upādānakkhandhānaṃ assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti … pe …","sn22.107:1.6":"pajānanti, sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti.","sn22.107:1.7":"Pañcamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":367,"to":370,"paras":[{"para":367,"vripara":"107-112","refs":["sn22.107:1"],"lines":["107-112. Pañcamādīsu catūsu cattāri saccāni kathitāni.","Navamadasamesu kilesappahānanti.","Pañcamādīni."],"lineRefs":[["sn22.107:1"],["sn22.107:1"],["sn22.107:1"]]},{"para":368,"vripara":null,"refs":["sn22.107:1"],"lines":["Antavaggo ekādasamo."],"lineRefs":[["sn22.107:1"]]},{"para":369,"vripara":null,"refs":["sn22.107:1"],"lines":["Dhammakathikavaggo"],"lineRefs":[["sn22.107:1"]]},{"para":370,"vripara":null,"refs":["sn22.107:1"],"lines":["1-2. Avijjāsuttādivaṇṇanā"],"lineRefs":[["sn22.107:1"]]}],"wordLinks":[],"before":[{"para":366,"vripara":null,"title":"Samaṇasuttādivaṇṇanā","lines":["5-10. Samaṇasuttādivaṇṇanā"]}]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":359,"to":364,"paras":[{"para":359,"vripara":"107-112","refs":["sn22.107:1"],"lines":["107-112. <b>Cattāri saccāni kathitāni</b> assādādīnaṃ samudayādīnañca desitattā."],"lineRefs":[["sn22.107:1"]]},{"para":360,"vripara":null,"refs":["sn22.107:1"],"lines":["<b>Kilesappahānaṃ kathitaṃ</b> rāgappahānassa jotitattā."],"lineRefs":[["sn22.107:1"]]},{"para":361,"vripara":null,"refs":["sn22.107:1"],"lines":["Samaṇasuttādivaṇ