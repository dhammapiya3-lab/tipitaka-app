{"suttaId":"tha-ap102","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5126,5153],"vripara":"56"},"segments":{"tha-ap102:0.3":"Buddhupaṭṭhākattheraapadānaṃ","tha-ap102:1.1":"“Vipassissa bhagavato, ahosiṃ saṅkhadhammako;","tha-ap102:1.3":"Niccupaṭṭhānayuttomhi, sugatassa mahesino.","tha-ap102:2.1":"“Upaṭṭhānaphalaṃ passa, lokanāthassa tādino;","tha-ap102:2.3":"Saṭṭhitūriyasahassāni, parivārenti maṃ sadā.","tha-ap102:3.1":"“Ekanavutito kappe, upaṭṭhahiṃ mahāisiṃ;","tha-ap102:3.3":"Duggatiṃ nābhijānāmi, upaṭṭhānassidaṃ phalaṃ.","tha-ap102:4.1":"“Catuvīse [catunavute (syā.)] ito kappe, mahānigghosanāmakā;","tha-ap102:4.3":"Soḷasāsiṃsu rājāno, cakkavattī mahabbalā.","tha-ap102:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap102:6.1":"Itthaṃ sudaṃ āyasmā buddhupaṭṭhāko thero imā gāthāyo abhāsitthāti.","tha-ap102:7.1":"Buddhupaṭṭhākattherassāpadānaṃ dasamaṃ.","tha-ap102:7.2":"Sudhāvaggo dasamo.","tha-ap102:8.1":"Tassuddānaṃ –","tha-ap102:9.1":"Sudhā sucinti ceḷañca, sūcī ca gandhamāliyo;","tha-ap102:9.3":"Tipupphiyo madhusenā, veyyāvacco cupaṭṭhako;","tha-ap102:9.5":"Samasaṭṭhi ca gāthāyo, asmiṃ vagge pakittitā.","tha-ap102:10.1":"Atha vagguddānaṃ –","tha-ap102:11.1":"Buddhavaggo hi paṭhamo, sīhāsani subhūti ca;","tha-ap102:11.3":"Kuṇḍadhāno upāli ca, bījanisakacinti ca.","tha-ap102:12.1":"Nāgasamālo timiro, sudhāvaggena te dasa;","tha-ap102:12.3":"Catuddasasatā gāthā, pañcapaññāsameva ca.","tha-ap102:13.1":"Buddhavaggadasakaṃ.","tha-ap102:14.1":"Paṭhamasatakaṃ samattaṃ."},"attha":null,"tika":null,"tika2":null}
