{"suttaId":"ja232","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1573,1579],"vripara":"163"},"segments":{"ja232:0.4":"Vīṇāguṇajātakaṃ (2-9-2)","ja232:1.1":"Ekacintito yamattho,","ja232:1.2":"bālo apariṇāyako;","ja232:1.3":"Na hi khujjena vāmena,","ja232:1.4":"bhoti saṅgantumarahasi. 164.","ja232:2.1":"Purisūsabhaṃ maññamānā,","ja232:2.2":"ahaṃ khujjamakāmayiṃ;","ja232:2.3":"Soyaṃ saṃkuṭito seti,","ja232:2.4":"chinnatanti yathā viṇāti [thuṇāti (sī.)].","ja232:3.1":"Vīṇāguṇajātakaṃ dutiyaṃ. 233."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1440,"to":1440,"paras":[{"para":1440,"vripara":null,"refs":["ja232:1"],"lines":["Tattha <b>ekacintitoyamattho</b>ti amma, yaṃ tvaṃ atthaṃ cintetvā iminā khujjena saddhiṃ palātā, ayaṃ tayā ekikāya eva cintito bhavissati.","<b>Bālo apariṇāyako</b>ti ayaṃ khujjo bālo, duppaññabhāvena mahallakopi bālova, aññasmiṃ gahetvā gacchante asati gantuṃ asamatthatāya apariṇāyako.","<b>Na hi khujjena vāmena, bhoti saṅgantumarahasī</b>ti iminā hi khujjena vāmanattā vāmena bhoti tvaṃ mahākule jātā abhirūpā dassanīyā saṅgantuṃ saha gantuṃ nārahasīti."],"lineRefs":[["ja232:1"],["ja232:1"],["ja232:1"]]}],"wordLinks":[["ja232:1.1","ekacintitoyamattho",0,0],["ja232:1.1","bālo apariṇāyako",0,1],["ja232:1.3","na hi khujjena vāmena bhoti saṅgantumarahasī",0,2]]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":804,"to":807,"paras":[{"para":804,"vripara":null,"refs":["ja232:1"],"lines":["2-vīṇāthūṇajātakavaṇṇanā (232)"],"lineRefs":[["ja232:1"]]},{"para":805,"vripara":null,"refs":["ja232:1"],"lines":["<b>kariyamāna</b>nti mātāpituādikehi kariyamānaṃ.","<b>ekaṃ khujjaṃ disvā</b>ti yassa purisassa piṭṭhiyaṃ kakudhaṃ viya maṃsapiṇḍaṃ uṭṭhahitvā dissati.","taṃ khujjaṃ ekaṃ purisaṃ disvā.","<b>jeṭṭhakassā</b>ti usabhassa.","<b>kakudha</b>nti goṇānaṃ dvinnaṃ hatthaṭṭhimūlānaṃ saṅgamaṭṭhānaṃ.","manussajeṭṭhakassāpi goṇajeṭṭhakassa viya tena maṃsapiṇḍenapi kakudhena bhavitabbaṃ.","<b>purisūsabho</b>ti purisasaṅkhāto"],"lineRefs":[["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"]]},{"para":806,"vripara":null,"refs":["ja232:1"],"lines":["footnote 1.","upāhanupatāpitapādasadiso.","jā.","ṭṭha.","usabho bhavissati.","<b>sārabhaṇḍaka</b>nti maṇiādiratanasārabhaṇḍakaṃ.","<b>aññātakavesenā</b>ti apākaṭavesena.","<b>ekikāyā</b>ti iminā ekacintitoti ettha ekasaddassa atthaṃ dasseti.","<b>mahallakopi bālovā</b>ti mahallakopi samāno bāloyeva hoti.","athavā mahallakopi samāno bālo viya hotīti attho.","<b>aññasmiṃ gahetvā gacchante asatī</b>ti gahetvā gacchante aññasmiṃ jane asati.","<b>gantuṃ asamatthatāya apariṇāyako</b>ti sayameva gantuṃ asamatthatāya apariṇāyako anātho appaṭisaraṇoti attho.","<b>vāmanattā vāmenā</b>ti khujjanattā vāmena.","khujjenāti vāmenāti ca dve samānatthā.","<b>saha gantu</b>nti khujjena vāmena saddhiṃ.","<b>purisūsabhaṃ maññamānā</b>ti purisūsabhaṃ viya maññamānā.","purisūsabhanti vā maññamāno.","<b>sadoṇiko</b>ti sapokkharo.","<b>vīṇādaṇḍako</b>ti vīṇāya daṇḍako.","iminā vīṇāsaddena vīṇādaṇḍo gahetabboti dasseti.","<b>evaṃ saṃkuṭiko</b>ti milāyanavasena saṃkuṭiko hutvā setīti.","pāḷiyaṃ “<b>yathā thuṇā</b>”tipi pāṭho dissati.","tatthāpi thuṇasaddena vīṇāva gahetabboti."],"lineRefs":[["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"],["ja232:1"]]},{"para":807,"vripara":null,"refs":["ja232:1"],"lines":["ending vīṇāthūṇajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja232:1"]]}],"wordLinks":[]},"tika2":null}
