{"suttaId":"ja232","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1573,1579],"vripara":"163"},"segments":{"ja232:0.4":"Vīṇāguṇajātakaṃ (2-9-2)","ja232:1.1":"Ekacintito yamattho, bālo apariṇāyako;","ja232:1.3":"Na hi khujjena vāmena, bhoti saṅgantumarahasi.","ja232:2.1":"Purisūsabhaṃ maññamānā, ahaṃ khujjamakāmayiṃ;","ja232:2.3":"Soyaṃ saṃkuṭito seti, chinnatanti yathā viṇāti [thuṇāti (sī.)].","ja232:3.1":"Vīṇāguṇajātakaṃ dutiyaṃ."},"attha":null,"tika":null}
