{"suttaId":"an5.248","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1535,1535],"vripara":"248"},"segments":{"an5.248:0.3":"Dutiyamanoduccaritasuttaṃ","an5.248:1.1":"“Pañcime, bhikkhave, ādīnavā manoduccarite…pe… ānisaṃsā manosucarite.","an5.248:1.2":"Katame pañca?","an5.248:1.3":"Attāpi attānaṃ na upavadati;","an5.248:1.4":"anuvicca viññū pasaṃsanti;","an5.248:1.5":"kalyāṇo kittisaddo abbhuggacchati;","an5.248:1.6":"asaddhammā vuṭṭhāti;","an5.248:1.7":"saddhamme patiṭṭhāti.","an5.248:1.8":"Ime kho, bhikkhave, pañca ānisaṃsā manosucarite”ti.","an5.248:1.9":"Aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
