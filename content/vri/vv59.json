{"suttaId":"vv59","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2271,2288],"vripara":"952"},"segments":{"vv59:0.4":"Dutiyasūcivimānavatthu","vv59:1.1":"“Uccamidaṃ maṇithūṇaṃ vimānaṃ,","vv59:1.2":"samantato dvādasa yojanāni;","vv59:1.3":"Kūṭāgārā sattasatā uḷārā,","vv59:1.4":"veḷuriyathambhā rucakatthatā subhā.","vv59:2.1":"“Tatthacchasi pivasi khādasi ca,","vv59:2.2":"dibbā ca vīṇā pavadanti vagguṃ;","vv59:2.3":"Dibbā rasā kāmaguṇettha pañca,","vv59:2.4":"nāriyo ca naccanti suvaṇṇachannā.","vv59:3.1":"“Kena tetādiso vaṇṇo … pe …","vv59:3.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv59:4.1":"So devaputto attamano … pe …","vv59:4.3":"yassa kammassidaṃ phalaṃ.","vv59:5.1":"“Ahaṃ manussesu manussabhūto,","vv59:5.2":"purimajātiyā manussaloke.","vv59:6.1":"“Addasaṃ virajaṃ bhikkhuṃ,","vv59:6.2":"vippasannamanāvilaṃ;","vv59:6.3":"Tassa adāsahaṃ sūciṃ,","vv59:6.4":"pasanno sehi pāṇibhi.","vv59:7.1":"“Tena metādiso vaṇṇo … pe …","vv59:7.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv59:8.1":"Dutiyasūcivimānaṃ navamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2678,"to":2693,"paras":[{"para":2678,"vripara":"952","refs":["vv59:1"],"lines":["“Uccamidaṃ maṇithūṇaṃ vimānaṃ … pe …"],"lineRefs":[["vv59:1"]]},{"para":2679,"vripara":null,"refs":["vv59:1"],"lines":["Vaṇṇo ca te sabbadisā pabhāsatī”ti.","– pucchi;"],"lineRefs":[["vv59:1"],["vv59:1"]]},{"para":2681,"vripara":"956","refs":["vv59:4"],"lines":["“So devaputto attamano … pe … yassa kammassidaṃ phalaṃ”."],"lineRefs":[["vv59:4"]]},{"para":2683,"vripara":"957","refs":["vv59:5"],"lines":["“Ahaṃ manussesu manussabhūto, purimajātiyā manussaloke."],"lineRefs":[["vv59:5"]]},{"para":2685,"vripara":"958","refs":["vv59:6"],"lines":["“Addasaṃ virajaṃ bhikkhuṃ, vippasannamanāvilaṃ;"],"lineRefs":[["vv59:6"]]},{"para":2686,"vripara":null,"refs":["vv59:6"],"lines":["Tassa adāsahaṃ sūciṃ, pasanno sehi pāṇibhi."],"lineRefs":[["vv59:6"]]},{"para":2688,"vripara":"959","refs":["vv59:7"],"lines":["“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti."],"lineRefs":[["vv59:7"]]},{"para":2689,"vripara":null,"refs":["vv59:7"],"lines":["Taṃ sabbaṃ heṭṭhā vuttanayameva."],"lineRefs":[["vv59:7"]]},{"para":2690,"vripara":null,"refs":["vv59:7"],"lines":["Dutiyasūcivimānavaṇṇanā niṭṭhitā."],"lineRefs":[["vv59:7"]]},{"para":2691,"vripara":null,"refs":["vv59:7"],"lines":["Paṭhamanāgavimānavaṇṇanā"],"lineRefs":[["vv59:7"]]},{"para":2692,"vripara":null,"refs":["vv59:7"],"lines":["<b>Susukkakhandhaṃ abhiruyha nāgan</b>ti nāgavimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tena samayena āyasmā mahāmoggallāno heṭṭhā vuttanayeneva devacārikaṃ caranto tāvatiṃsabhavanaṃ upagato.","Tattha addasa aññataraṃ devaputtaṃ sabbasetaṃ mahantaṃ dibbanāgaṃ abhiruyha mahantena parivārena mahatā dibbānubhāvena ākāsena gacchantaṃ, sabbā disā cando viya sūriyo viya ca obhāsayamānaṃ.","Disvā yena so devaputto tenupasaṅkami.","Atha so devaputto tato oruyha āyasmantaṃ mahāmoggallānaṃ abhivādetvā añjaliṃ paggayha aṭṭhāsi.","Atha thero –"],"lineRefs":[["vv59:7"],["vv59:7"],["vv59:7"],["vv59:7"],["vv59:7"],["vv59:7"],["vv59:7"],["vv59:7"]]}],"wordLinks":[],"before":[{"para":2675,"vripara":null,"title":"Dutiyasūcivimānavaṇṇanā","lines":["Dutiyasūcivimānavaṇṇanā"]},{"para":2676,"vripara":null,"title":"Dutiyasūcivimānavaṇṇanā","lines":["<b>Uccamidaṃ maṇithūṇan</b>ti dutiyasūcivimānaṃ.","Tassa kā uppatti?","Bhagavā rājagahe viharati veḷuvane.","Tena samayena rājagahavāsī eko tunnakārako vihārapekkhako hutvā veḷuvanaṃ gato.","Tattha aññataraṃ bhikkhuṃ veḷuvane katasūciyā cīvaraṃ sibbantaṃ disvā sūcigharena saddhiṃ sūciyo adāsi.","Sesaṃ sabbaṃ vuttanayameva."]}],"after":[{"para":2694,"vripara":"961","title":"Paṭhamanāgavimānavaṇṇanā","lines":["“Susukkakhandhaṃ abhiruyha nāgaṃ, akācinaṃ dantiṃ baliṃ mahājavaṃ;"]},{"para":2695,"vripara":null,"title":"Paṭhamanāgavimānavaṇṇanā","lines":["Abhiruyha gajavaraṃ sukappitaṃ, idhāgamā vehāyasaṃ antalikkhe."]},{"para":2697,"vripara":"962","title":"Paṭhamanāgavimānavaṇṇanā","lines":["“Nāgassa dantesu duvesu nimmitā, acchodakā paduminiyo suphullā;"]},{"para":2698,"vripara":null,"title":"Paṭhamanāgavimānavaṇṇanā","lines":["Padumesu ca tūriyagaṇā pavajjare, imā ca naccanti manoharāyo."]},{"para":2700,"vripara":"963","title":"Paṭhamanāgavimānavaṇṇanā","lines":["“Deviddhipattosi mahānubhāvo, manussabhūto kimakāsi puññaṃ;"]},{"para":2701,"vripara":null,"title":"Paṭhamanāgavimānavaṇṇanā","lines":["Kenāsi evaṃ jalitānubhāvo, vaṇṇo ca te sabbadisā pabhāsatī”ti.","–"]},{"para":2702,"vripara":null,"title":"Paṭhamanāgavimānavaṇṇanā","lines":["Tassa sampattikittanamukhena katakammaṃ pucchi."]}]},"tika":null,"tika2":null}
