{"suttaId":"ja250","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1727,1741],"vripara":"200"},"segments":{"ja250:0.4":"Kapijātakaṃ (2-10-10)","ja250:1.1":"Ayaṃ isī upasamasaṃyame rato,","ja250:1.2":"sa tiṭṭhati [santiṭṭhati (sī. pī.)] sisirabhayena aṭṭito;","ja250:1.3":"Handa ayaṃ pavisatumaṃ agārakaṃ,","ja250:1.4":"vinetu sītaṃ darathañca kevalaṃ. 201.","ja250:2.1":"Nāyaṃ isī upasamasaṃyame rato,","ja250:2.2":"kapī ayaṃ dumavarasākhagocaro;","ja250:2.3":"So dūsako rosako cāpi jammo,","ja250:2.4":"sacevajemampi [sace + āvaje + imampi] dūseyyagāranti [dūsaye gharanti (sī. syā. pī.)].","ja250:3.1":"Kapijātakaṃ dasamaṃ.","ja250:3.2":"Siṅgālavaggo dasamo.","ja250:4.1":"Tassuddānaṃ –","ja250:5.1":"Atha rājā siṅgālavaro sunakho,","ja250:5.2":"tathā kosiya icchati kālaghaso;","ja250:5.3":"Atha dānavaroṭṭhapi sārathinā,","ja250:5.4":"punambavanañca sisirakapi dasāti.","ja250:6.1":"Atha vagguddānaṃ –","ja250:7.1":"Daḷhañca vaggaṃ aparena santhavaṃ,","ja250:7.2":"kalyāṇavaggāsadiso ca rūhakaṃ;","ja250:7.3":"Nataṃdaḷha bīraṇathambhakaṃ puna,","ja250:7.4":"kāsāvupāhana siṅgālakena dasāti.","ja250:8.1":"Dukanipātaṃ niṭṭhitaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1759,"to":1764,"paras":[{"para":1759,"vripara":null,"refs":["ja250:1"],"lines":["Tattha <b>upasamasaṃyame rato</b>ti rāgādikilesaupasame ca sīlasaṃyame ca rato.","<b>Sa tiṭṭhatī</b>ti so tiṭṭhati.","<b>Sisirabhayenā</b>ti vātavuṭṭhijanitassa sisirassa bhayena.","<b>Aṭṭito</b>ti pīḷito.","<b>Pavisatuma</b>nti pavisatu imaṃ.","<b>Kevala</b>nti sakalaṃ anavasesaṃ."],"lineRefs":[["ja250:1"],["ja250:1"],["ja250:1"],["ja250:1"],["ja250:1"],["ja250:1"]]},{"para":1760,"vripara":null,"refs":["ja250:1"],"lines":["Bodhisatto puttassa vacanaṃ sutvā uṭṭhāya olokento makkaṭabhāvaṃ ñatvā dutiyaṃ gāthamāha – 201."],"lineRefs":[["ja250:1"]]},{"para":1762,"vripara":"201","refs":["ja250:1"],"lines":["“Nāyaṃ isī upasamasaṃyame rato, kapī ayaṃ dumavarasākhagocaro;"],"lineRefs":[["ja250:1"]]},{"para":1763,"vripara":null,"refs":["ja250:1"],"lines":["So dūsako rosako cāpi jammo, sace vajemampi dūseyyagāra”nti."],"lineRefs":[["ja250:1"]]},{"para":1764,"vripara":null,"refs":["ja250:2"],"lines":["Tattha <b>dumavarasākhagocaro</b>ti dumavarānaṃ sākhagocaro.","<b>So dūsako rosako cāpi jammo</b>ti so evaṃ gatagataṭṭhānassa dūsanato dūsako, ghaṭṭanatāya rosako, lāmakabhāvena jammo.","<b>Sace vaje</b>ti yadi imaṃ paṇṇasālaṃ vaje paviseyya, sabbaṃ uccārapassāvakaraṇena ca aggidānena ca dūseyyāti."],"lineRefs":[["ja250:2"],["ja250:2"],["ja250:2"]]}],"wordLinks":[["ja250:1.1","upasamasaṃyame rato",0,0],["ja250:1.1","sa tiṭṭhatī",0,1],["ja250:1.1","sisirabhayenā",0,2],["ja250:1.1","aṭṭito",0,3],["ja250:1.3","pavisatumaṃ",0,4],["ja250:1.3","kevalaṃ",0,5],["ja250:2.1","dumavarasākhagocaro",4,0],["ja250:2.3","so dūsako rosako cāpi jammo",4,1],["ja250:2.3","sace vaje",4,2]],"after":[{"para":1765,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Evañca pana vatvā bodhisatto ummukaṃ gahetvā taṃ santāsetvā palāpesi.","So uppatitvā vanaṃ pakkhanto tathā pakkhantova ahosi, na puna taṃ ṭhānaṃ agamāsi.","Bodhisatto abhiññā ca samāpattiyo ca nibbattetvā tāpasakumārassa kasiṇaparikammaṃ ācikkhi, sopi abhiññā ca samāpattiyo ca uppādesi.","Te ubhopi aparihīnajjhānā brahmalokaparāyaṇā ahesuṃ."]},{"para":1766,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Satthā “na, bhikkhave, idāneva, porāṇato paṭṭhāyapesa kuhakoyevā”ti imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi.","Saccapariyosāne keci sotāpannā, keci sakadāgāmino, keci anāgāmino keci arahanto ahesuṃ.","“Tadā makkaṭo kuhakabhikkhu ahosi, putto rāhulo, pitā pana ahameva ahosi”nti."]},{"para":1767,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Kapijātakavaṇṇanā dasamā."]},{"para":1768,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Siṅgālavaggo dasamo."]},{"para":1769,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":1770,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Sabbadāṭhī ca sunakho, guttilo vigaticchā ca;"]},{"para":1771,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Mūlapariyāyaṃ bālovādaṃ, pādañjali kiṃ sukopamaṃ;"]},{"para":1772,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Sālakaṃ kapi te dasa."]},{"para":1773,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Atha vagguddānaṃ –"]},{"para":1774,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Daḷhavaggo ca santhavo, kalyāṇadhammāsadiso;"]},{"para":1775,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Rūhako daḷhavaggo ca, bīraṇathambhakāsāvo;"]},{"para":1776,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Upāhano siṅgālo ca, dasavaggā duke siyuṃ."]},{"para":1777,"vripara":null,"title":"[250] 10. Kapijātakavaṇṇanā","lines":["Dukanipātavaṇṇanā niṭṭhitā. 3."]}]},"tika":null,"tika2":null}
