{"suttaId":"ja250","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1727,1743],"vripara":"200"},"segments":{"ja250:0.4":"Kapijātakaṃ (2-10-10)","ja250:1.1":"Ayaṃ isī upasamasaṃyame rato,","ja250:1.2":"sa tiṭṭhati [santiṭṭhati (sī. pī.)] sisirabhayena aṭṭito;","ja250:1.3":"Handa ayaṃ pavisatumaṃ agārakaṃ,","ja250:1.4":"vinetu sītaṃ darathañca kevalaṃ.","ja250:2.1":"Nāyaṃ isī upasamasaṃyame rato,","ja250:2.2":"kapī ayaṃ dumavarasākhagocaro;","ja250:2.3":"So dūsako rosako cāpi jammo,","ja250:2.4":"sacevajemampi [sace + āvaje + imampi] dūseyyagāranti [dūsaye gharanti (sī. syā. pī.)].","ja250:3.1":"Kapijātakaṃ dasamaṃ.","ja250:3.2":"Siṅgālavaggo dasamo.","ja250:4.1":"Tassuddānaṃ –","ja250:5.1":"Atha rājā siṅgālavaro sunakho,","ja250:5.2":"tathā kosiya icchati kālaghaso;","ja250:5.3":"Atha dānavaroṭṭhapi sārathinā,","ja250:5.4":"punambavanañca sisirakapi dasāti.","ja250:6.1":"Atha vagguddānaṃ –","ja250:7.1":"Daḷhañca vaggaṃ aparena santhavaṃ,","ja250:7.2":"kalyāṇavaggāsadiso ca rūhakaṃ;","ja250:7.3":"Nataṃdaḷha bīraṇathambhakaṃ puna,","ja250:7.4":"kāsāvupāhana siṅgālakena dasāti.","ja250:8.1":"Dukanipātaṃ niṭṭhitaṃ."},"unsure":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1759,"to":1764,"paras":[{"para":1759,"vripara":null,"refs":["ja250:1"],"lines":["Tattha <b>upasamasaṃyame rato</b>ti rāgādikilesaupasame ca sīlasaṃyame ca rato.","<b>Sa tiṭṭhatī</b>ti so tiṭṭhati.","<b>Sisirabhayenā</b>ti vātavuṭṭhijanitassa sisirassa bhayena.","<b>Aṭṭito</b>ti pīḷito.","<b>Pavisatuman</b>ti pavisatu imaṃ.","<b>Kevalan</b>ti sakalaṃ anavasesaṃ."],"lineRefs":[["ja250:1"],["ja250:1"],["ja250:1"],["ja250:1"],["ja250:1"],["ja250:1"]]},{"para":1760,"vripara":null,"refs":["ja250:1"],"lines":["Bodhisatto puttassa vacanaṃ sutvā uṭṭhāya olokento makkaṭabhāvaṃ ñatvā dutiyaṃ gāthamāha –"],"lineRefs":[["ja250:1"]]},{"para":1762,"vripara":"201","refs":["ja250:1"],"lines":["“Nāyaṃ isī upasamasaṃyame rato, kapī ayaṃ dumavarasākhagocaro;"],"lineRefs":[["ja250:1"]]},{"para":1763,"vripara":null,"refs":["ja250:1"],"lines":["So dūsako rosako cāpi jammo, sace vajemampi dūseyyagāran”ti."],"lineRefs":[["ja250:1"]]},{"para":1764,"vripara":null,"refs":["ja250:2"],"lines":["Tattha <b>dumavarasākhagocaro</b>ti dumavarānaṃ sākhagocaro.","<b>So dūsako rosako cāpi jammo</b>ti so evaṃ gatagataṭṭhānassa dūsanato dūsako, ghaṭṭanatāya rosako, lāmakabhāvena jammo.","<b>Sace vaje</b>ti yadi imaṃ paṇṇasālaṃ vaje paviseyya, sabbaṃ uccārapassāvakaraṇena ca aggidānena ca dūseyyāti."],"lineRefs":[["ja250:2"],["ja250:2"],["ja250:2"]]}],"wordLinks":[["ja250:1.1","upasamasaṃyame rato",0,0],["ja250:1.1","sa tiṭṭhatī",0,1],["ja250:1.1","sisirabhayenā",0,2],["ja250:1.1","aṭṭito",0,3],["ja250:1.3","pavisatumaṃ",0,4],["ja250:1.3","kevalaṃ",0,5],["ja250:2.1","dumavarasākhagocaro",4,0],["ja250:2.3","so dūsako rosako cāpi jammo",4,1],["ja250:2.3","sace vaje",4,2]]},"tika":null,"tika2":null}
