{"suttaId":"thag1.116","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[670,673],"vripara":"116"},"segments":{"thag1.116:0.4":"Pārāpariyattheragāthā","thag1.116:1.1":"“Chaphassāyatane hitvā,","thag1.116:1.2":"guttadvāro susaṃvuto;","thag1.116:1.3":"Aghamūlaṃ vamitvāna,","thag1.116:1.4":"patto me āsavakkhayo”ti.","thag1.116:1.5":"… Pārāpariyo [pārāsariyo (sī.), pāraṃpariyo (ka.)] thero …."},"unsure":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2919,"to":2919,"paras":[{"para":2919,"vripara":null,"refs":["thag1.116:1"],"lines":["Tattha <b>chaphassāyatane hitvā</b>ti cakkhusamphassādīnaṃ channaṃ samphassānaṃ uppattiṭṭhānatāya “phassāyatanānī”ti laddhanāmāni cakkhādīni cha ajjhattikāyatanāni tappaṭibaddhasaṃkilesappahānavasena pahāya.","<b>Guttadvāro susaṃvuto</b>ti tato eva cakkhudvārādīnaṃ guttattā, tattha pavattanakānaṃ abhijjhādīnaṃ pāpadhammānaṃ pavesananivāraṇena satikavāṭena suṭṭu pihitattā guttadvāro susaṃvuto.","Atha vā manacchaṭṭhānaṃ channaṃ dvārānaṃ vuttanayena rakkhitattā guttadvāro, kāyādīhi suṭṭhu saññatattā susaṃvutoti evamettha attho veditabbo.","<b>Aghamūlaṃ vamitvānā</b>ti aghassa vaṭṭadukkhassa mūlabhūtaṃ avijjābhavataṇhāsaṅkhātaṃ dosaṃ, sabbaṃ vā kilesadosaṃ ariyamaggasaṅkhātavamanayogapānena uggiritvā santānato bahi katvā, bahikaraṇahetu vā.","<b>Patto me āsavakkhayo</b>ti kāmāsavādayo āsavā ettha khīyanti, tesaṃ vā khayena pattabboti āsavakkhayo, nibbānaṃ arahattañca.","So āsavakkhayo patto adhigatoti udānavasena aññaṃ byākāsi."],"lineRefs":[["thag1.116:1"],["thag1.116:1"],["thag1.116:1"],["thag1.116:1"],["thag1.116:1"],["thag1.116:1"]]}],"wordLinks":[["thag1.116:1.1","chaphassāyatane hitvā",0,0],["thag1.116:1.1","guttadvāro susaṃvuto",0,1],["thag1.116:1.3","aghamūlaṃ vamitvānā",0,3],["thag1.116:1.3","patto me āsavakkhayo",0,4]],"before":[{"para":2815,"vripara":null,"refs":[],"lines":["“Sindhuyā nadiyā tīre, sukato assamo mama;"],"lineRefs":[[]]},{"para":2816,"vripara":null,"refs":[],"lines":["Tattha vācemahaṃ sisse, itihāsaṃ salakkhaṇaṃ."],"lineRefs":[[]]},{"para":2817,"vripara":null,"refs":[],"lines":["“Dhammakāmā vinītā te, sotukāmā susāsanaṃ;"],"lineRefs":[[]]},{"para":2818,"vripara":null,"refs":[],"lines":["Chaḷaṅge pāramippattā, sindhukūle vasanti te."],"lineRefs":[[]]},{"para":2819,"vripara":null,"refs":[],"lines":["“Uppātagamane ceva, lakkhaṇesu ca kovidā;"],"lineRefs":[[]]},{"para":2820,"vripara":null,"refs":[],"lines":["Uttamatthaṃ gavesantā, vasanti vipine tadā."],"lineRefs":[[]]},{"para":2821,"vripara":null,"refs":[],"lines":["“Sumedho nāma sambuddho, loke uppajji tāvade;"],"lineRefs":[[]]},{"para":2822,"vripara":null,"refs":[],"lines":["Amhākaṃ anukampanto, upāgacchi vināyako."],"lineRefs":[[]]},{"para":2823,"vripara":null,"refs":[],"lines":["“Upāgataṃ mahāvīraṃ, sumedhaṃ lokanāyakaṃ;"],"lineRefs":[[]]},{"para":2824,"vripara":null,"refs":[],"lines":["Tiṇasanthārakaṃ katvā, lokajeṭṭhassadāsahaṃ."],"lineRefs":[[]]},{"para":2825,"vripara":null,"refs":[],"lines":["“Vipināto madhuṃ gayha, buddhaseṭṭhassadāsahaṃ;"],"lineRefs":[[]]},{"para":2826,"vripara":null,"refs":[],"lines":["Sambuddho paribhuñjitvā, idaṃ vacanamabravi."],"lineRefs":[[]]},{"para":2827,"vripara":null,"refs":[],"lines":["“Yo taṃ adāsi madhuṃ me, pasanno sehi pāṇibhi;"],"lineRefs":[[]]},{"para":2828,"vripara":null,"refs":[],"lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."],"lineRefs":[[]]},{"para":2829,"vripara":null,"refs":[],"lines":["“Iminā madhudānena, tiṇasanthārakena ca;"],"lineRefs":[[]]},{"para":2830,"vripara":null,"refs":[],"lines":["Tiṃsa kappasahassāni, devaloke ramissati."],"lineRefs":[[]]},{"para":2831,"vripara":null,"refs":[],"lines":["“Tiṃsakappasahassamhi, okkākakulasambhavo;"],"lineRefs":[[]]},{"para":2832,"vripara":null,"refs":[],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[[]]},{"para":2833,"vripara":null,"refs":[],"lines":["“Tassa dhammesu dāyādo, oraso dhammanimmito;"],"lineRefs":[[]]},{"para":2834,"vripara":null,"refs":[],"lines":["Sabbāsave pariññāya, nibbāyissatināsavo."],"lineRefs":[[]]},{"para":2835,"vripara":null,"refs":[],"lines":["“Devalokā idhāgantvā, mātukucchiṃ upāgate;"],"lineRefs":[[]]},{"para":2836,"vripara":null,"refs":[],"lines":["Madhuvassaṃ pavassittha, chādayaṃ madhunā mahiṃ."],"lineRefs":[[]]},{"para":2837,"vripara":null,"refs":[],"lines":["“Mayi nikkhantamattamhi, kucchiyā ca suduttarā;"],"lineRefs":[[]]},{"para":2838,"vripara":null,"refs":[],"lines":["Tatrāpi madhuvassaṃ me, vassate niccakālikaṃ."],"lineRefs":[[]]},{"para":2839,"vripara":null,"refs":[],"lines":["“Agārā abhinikkhamma, pabbajiṃ anagāriyaṃ;"],"lineRefs":[[]]},{"para":2840,"vripara":null,"refs":[],"lines":["Lābhī annassa pānassa, madhudānassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":2841,"vripara":null,"refs":[],"lines":["“Sabbakāmasamiddhohaṃ, bhavitvā devamānuse;"],"lineRefs":[[]]},{"para":2842,"vripara":null,"refs":[],"lines":["Teneva madhudānena, pattomhi āsavakkhayaṃ."],"lineRefs":[[]]},{"para":2843,"vripara":null,"refs":[],"lines":["“Vuṭṭhamhi deve caturaṅgule tiṇe, sampupphite dharaṇīruhe sañchanne;"],"lineRefs":[[]]},{"para":2844,"vripara":null,"refs":[],"lines":["Suññe ghare maṇḍaparukkhamūlake, vasāmi niccaṃ sukhito anāsavo."],"lineRefs":[[]]},{"para":2845,"vripara":null,"refs":[],"lines":["“Majjhe mahante hīne ca, bhave sabbe atikkamiṃ;"],"lineRefs":[[]]},{"para":2846,"vripara":null,"refs":[],"lines":["Ajja me āsavā khīṇā, natthi dāni punabbhavo."],"lineRefs":[[]]},{"para":2847,"vripara":null,"refs":[],"lines":["“Tiṃsakappasahassamhi, yaṃ dānamadadiṃ tadā;"],"lineRefs":[[]]},{"para":2848,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, madhudānassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":2849,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":2850,"vripara":null,"refs":[],"lines":["Ayameva ca therassa aññābyākaraṇagāthā ahosīti."],"lineRefs":[[]]},{"para":2851,"vripara":null,"refs":[],"lines":["Mahānāmattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2852,"vripara":null,"refs":[],"lines":["Pārāpariyattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":2853,"vripara":null,"refs":[],"lines":["<b>Chaphassāyatane hitvā</b>ti āyasmato pārāpariyattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto piyadassissa bhagavato kāle nesādayoniyaṃ nibbattitvā tassa viññutaṃ pattassa vicaraṇaṭṭhāne aññatarasmiṃ vanasaṇḍe piyadassī bhagavā taṃ anuggaṇhituṃ nirodhasamāpattiṃ samāpajjitvā nisīdi.","So ca mige pariyesanto taṃ ṭhānaṃ gato satthāraṃ disvā pasannamānaso bhagavantaṃ anto katvā kataṃ sākhāmaṇḍapaṃ padumapupphehi kūṭāgārākārena sañchādetvā uḷāraṃ pītisomanassaṃ paṭisaṃvedento sattāhaṃ namassamāno aṭṭhāsi.","Divase divase ca milātamilātāni apanetvā abhinavehi chādesi.","Satthā sattāhassa accayena nirodhato vuṭṭhahitvā bhikkhusaṅghaṃ anussari.","Tāvadeva asītisahassamattā bhikkhū satthāraṃ parivāresuṃ.","“Madhuradhammakathaṃ suṇissāmā”ti devatā sannipatiṃsu, mahā samāgamo ahosi.","Satthā anumodanaṃ karonto tassa devamanussesu bhāviniṃ sampattiṃ imasmiṃ buddhuppāde sāvakabodhiñca byākaritvā pakkāmi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde rājagahe brāhmaṇakule nibbattitvā viññutaṃ patto tiṇṇaṃ vedānaṃ pāragū hutvā parāparagottatāya <b>pārāpariyo</b>ti laddhasamañño bahū brāhmaṇe mante vācento satthu rājagahagamane buddhānubhāvaṃ disvā paṭiladdhasaddho pabbajitvā vipassanāya kammaṃ karonto nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.40.353-385)–"],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[]]},{"para":2854,"vripara":null,"refs":[],"lines":["“Piyadassī nāma bhagavā, sayambhū lokanāyako;"],"lineRefs":[[]]},{"para":2855,"vripara":null,"refs":[],"lines":["Vivekakāmo sambuddho, samādhikusalo muni."],"lineRefs":[[]]},{"para":2856,"vripara":null,"refs":[],"lines":["“Vanasaṇḍaṃ samoggayha, piyadassī mahāmuni;"],"lineRefs":[[]]},{"para":2857,"vripara":null,"refs":[],"lines":["Paṃsukūlaṃ pattharitvā, nisīdi purisuttamo."],"lineRefs":[[]]},{"para":2858,"vripara":null,"refs":[],"lines":["“Migaluddo pure āsiṃ, araññe kānane ahaṃ;"],"lineRefs":[[]]},{"para":2859,"vripara":null,"refs":[],"lines":["Pasadaṃ migamesanto, āhiṇḍāmi ahaṃ tadā."],"lineRefs":[[]]},{"para":2860,"vripara":null,"refs":[],"lines":["“Tatthaddasāsiṃ sambuddhaṃ, oghatiṇṇamanāsavaṃ;"],"lineRefs":[[]]},{"para":2861,"vripara":null,"refs":[],"lines":["Pupphitaṃ sālarājaṃva, sataraṃsiṃva uggataṃ."],"lineRefs":[[]]},{"para":2862,"vripara":null,"refs":[],"lines":["“Disvānahaṃ devadevaṃ, piyadassiṃ mahāyasaṃ;"],"lineRefs":[[]]},{"para":2863,"vripara":null,"refs":[],"lines":["Jātassaraṃ samoggayha, padumaṃ āhariṃ tadā."],"lineRefs":[[]]},{"para":2864,"vripara":null,"refs":[],"lines":["“Āharitvāna padumaṃ, satapattaṃ manoramaṃ;"],"lineRefs":[[]]},{"para":2865,"vripara":null,"refs":[],"lines":["Kūṭāgāraṃ karitvāna, chādayiṃ padumenahaṃ."],"lineRefs":[[]]},{"para":2866,"vripara":null,"refs":[],"lines":["“Anukampako kāruṇiko, piyadassī mahāmuni;"],"lineRefs":[[]]},{"para":2867,"vripara":null,"refs":[],"lines":["Sattarattindivaṃ buddho, kūṭāgāre vasī jino."],"lineRefs":[[]]},{"para":2868,"vripara":null,"refs":[],"lines":["“Purāṇaṃ chaḍḍayitvāna, navena chādayiṃ ahaṃ;"],"lineRefs":[[]]},{"para":2869,"vripara":null,"refs":[],"lines":["Añjaliṃ paggahetvāna, aṭṭhāsiṃ tāvade ahaṃ."],"lineRefs":[[]]},{"para":2870,"vripara":null,"refs":[],"lines":["“Vuṭṭhahitvā samādhimhā, piyadassī mahāmuni;"],"lineRefs":[[]]},{"para":2871,"vripara":null,"refs":[],"lines":["Disaṃ anuvilokento, nisīdi lokanāyako."],"lineRefs":[[]]},{"para":2872,"vripara":null,"refs":[],"lines":["“Tadā sudassano nāma, upaṭṭhāko mahiddhiko;"],"lineRefs":[[]]},{"para":2873,"vripara":null,"refs":[],"lines":["Cittamaññāya buddhassa, piyadassissa satthuno."],"lineRefs":[[]]},{"para":2874,"vripara":null,"refs":[],"lines":["“Asītiyā sahassehi, bhikkhūhi parivārito;"],"lineRefs":[[]]},{"para":2875,"vripara":null,"refs":[],"lines":["Vanante sukhamāsīnaṃ, upesi lokanāyakaṃ."],"lineRefs":[[]]},{"para":2876,"vripara":null,"refs":[],"lines":["“Yāvatā vanasaṇḍamhi, adhivatthā ca devatā;"],"lineRefs":[[]]},{"para":2877,"vripara":null,"refs":[],"lines":["Buddhassa cittamaññāya, sabbe sannipatuṃ tadā."],"lineRefs":[[]]},{"para":2878,"vripara":null,"refs":[],"lines":["“Samāgatesu yakkhesu, kumbhaṇḍe saharakkhase;"],"lineRefs":[[]]},{"para":2879,"vripara":null,"refs":[],"lines":["Bhikkhusaṅghe ca sampatte, gāthā pabyāharī jino."],"lineRefs":[[]]},{"para":2880,"vripara":null,"refs":[],"lines":["“Thomaṃ sattāhaṃ pūjesi, āvāsañca akāsi me;"],"lineRefs":[[]]},{"para":2881,"vripara":null,"refs":[],"lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."],"lineRefs":[[]]},{"para":2882,"vripara":null,"refs":[],"lines":["“Sududdasaṃ sunipuṇaṃ, gambhīraṃ suppakāsitaṃ;"],"lineRefs":[[]]},{"para":2883,"vripara":null,"refs":[],"lines":["Ñāṇena kittayissāmi, suṇātha mama bhāsato."],"lineRefs":[[]]},{"para":2884,"vripara":null,"refs":[],"lines":["“Catuddasāni kappāni, devarajjaṃ karissati;"],"lineRefs":[[]]},{"para":2885,"vripara":null,"refs":[],"lines":["Kūṭāgāraṃ mahantassa, padmapupphehi chāditaṃ."],"lineRefs":[[]]},{"para":2886,"vripara":null,"refs":[],"lines":["“Ākāse dhārayissati, pupphakammassidaṃ phalaṃ;"],"lineRefs":[[]]},{"para":2887,"vripara":null,"refs":[],"lines":["Catubbīse kappasate, vokiṇṇaṃ saṃsarissati."],"lineRefs":[[]]},{"para":2888,"vripara":null,"refs":[],"lines":["“Tattha pupphamayaṃ byamhaṃ, ākāse dhārayissati;"],"lineRefs":[[]]},{"para":2889,"vripara":null,"refs":[],"lines":["Yathā padumapattamhi, toyaṃ na upalimpati."],"lineRefs":[[]]},{"para":2890,"vripara":null,"refs":[],"lines":["“Tathevīmassa ñāṇamhi, kilesā nopalimpare;"],"lineRefs":[[]]},{"para":2891,"vripara":null,"refs":[],"lines":["Manasā vinivaṭṭetvā, pañca nīvaraṇe ayaṃ."],"lineRefs":[[]]},{"para":2892,"vripara":null,"refs":[],"lines":["“Cittaṃ janetvā nekkhamme, agārā pabbajissati;"],"lineRefs":[[]]},{"para":2893,"vripara":null,"refs":[],"lines":["Tato pupphamaye byamhe, dhārente nikkhamissati."],"lineRefs":[[]]},{"para":2894,"vripara":null,"refs":[],"lines":["“Rukkhamūle vasantassa, nipakassa satīmato;"],"lineRefs":[[]]},{"para":2895,"vripara":null,"refs":[],"lines":["Tattha pupphamayaṃ byamhaṃ, matthake dhārayissati."],"lineRefs":[[]]},{"para":2896,"vripara":null,"refs":[],"lines":["“Cīvaraṃ piṇḍapātañca, paccayaṃ sayanāsanaṃ;"],"lineRefs":[[]]},{"para":2897,"vripara":null,"refs":[],"lines":["Datvāna bhikkhusaṅghassa, nibbāyissatināsavo."],"lineRefs":[[]]},{"para":2898,"vripara":null,"refs":[],"lines":["“Kūṭāgārena caratā, pabbajjaṃ abhinikkhamiṃ;"],"lineRefs":[[]]},{"para":2899,"vripara":null,"refs":[],"lines":["Rukkhamūle vasantampi, kūṭāgāraṃ dharīyati."],"lineRefs":[[]]},{"para":2900,"vripara":null,"refs":[],"lines":["“Cīvare piṇḍapāte ca, cetanā me na vijjati;"],"lineRefs":[[]]},{"para":2901,"vripara":null,"refs":[],"lines":["Puññakammena saṃyutto, labhāmi pariniṭṭhitaṃ."],"lineRefs":[[]]},{"para":2902,"vripara":null,"refs":[],"lines":["“Gaṇanāto asaṅkheyyā, kappakoṭī bahū mama;"],"lineRefs":[[]]},{"para":2903,"vripara":null,"refs":[],"lines":["Rittakā te atikkantā, pamuttā lokanāyakā."],"lineRefs":[[]]},{"para":2904,"vripara":null,"refs":[],"lines":["“Aṭṭhārase kappasate, piyadassī vināyako;"],"lineRefs":[[]]},{"para":2905,"vripara":null,"refs":[],"lines":["Tamahaṃ payirupāsitvā, imaṃ yoniṃ upāgato."],"lineRefs":[[]]},{"para":2906,"vripara":null,"refs":[],"lines":["“Idha passāmi sambuddhaṃ, anomaṃ nāma cakkhumaṃ;"],"lineRefs":[[]]},{"para":2907,"vripara":null,"refs":[],"lines":["Tamahaṃ upagantvāna, pabbajiṃ anagāriyaṃ."],"lineRefs":[[]]},{"para":2908,"vripara":null,"refs":[],"lines":["“Dukkhassantakaro buddho, maggaṃ me desayī jino;"],"lineRefs":[[]]},{"para":2909,"vripara":null,"refs":[],"lines":["Tassa dhammaṃ suṇitvāna, pattomhi acalaṃ padaṃ."],"lineRefs":[[]]},{"para":2910,"vripara":null,"refs":[],"lines":["“Tosayitvāna sambuddhaṃ, gotamaṃ sakyapuṅgavaṃ;"],"lineRefs":[[]]},{"para":2911,"vripara":null,"refs":[],"lines":["Sabbāsave pariññāya, viharāmi anāsavo."],"lineRefs":[[]]},{"para":2912,"vripara":null,"refs":[],"lines":["“Aṭṭhārase kappasate, yaṃ buddhamabhipūjayiṃ;"],"lineRefs":[[]]},{"para":2913,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":2914,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":2915,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā attano paṭipattiṃ paccavekkhitvā sañjātasomanasso udānavasena –"],"lineRefs":[[]]},{"para":2917,"vripara":"116","refs":[],"lines":["“Chaphassāyatane hitvā, guttadvāro susaṃvuto;"],"lineRefs":[[]]},{"para":2918,"vripara":null,"refs":[],"lines":["Aghamūlaṃ vamitvāna, patto me āsavakkhayo”ti.","– gāthaṃ abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
