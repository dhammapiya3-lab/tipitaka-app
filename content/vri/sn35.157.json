{"suttaId":"sn35.157","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[977,977],"vripara":"157"},"segments":{"sn35.157:0.3":"Bāhiranandikkhayasuttaṃ","sn35.157:1.1":"“Anicceyeva, bhikkhave, bhikkhu rūpe aniccāti passati, sāssa hoti sammādiṭṭhi.","sn35.157:1.2":"Sammā passaṃ nibbindati.","sn35.157:1.3":"Nandikkhayā rāgakkhayo;","sn35.157:1.4":"rāgakkhayā nandikkhayo.","sn35.157:1.5":"Nandirāgakkhayā cittaṃ suvimuttanti vuccati.","sn35.157:1.6":"Anicceyeva, bhikkhave, bhikkhu sadde … gandhe … rase … phoṭṭhabbe … dhamme aniccāti passati, sāssa hoti sammādiṭṭhi.","sn35.157:1.11":"Sammā passaṃ nibbindati.","sn35.157:1.12":"Nandikkhayā rāgakkhayo;","sn35.157:1.13":"rāgakkhayā nandikkhayo.","sn35.157:1.14":"Nandirāgakkhayā cittaṃ suvimuttanti vuccatī”ti.","sn35.157:1.15":"Dutiyaṃ."},"attha":null,"tika":null}
