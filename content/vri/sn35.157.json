{"suttaId":"sn35.157","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[977,977],"vripara":"157"},"segments":{"sn35.157:0.3":"Bāhiranandikkhayasuttaṃ","sn35.157:1.1":"“Anicceyeva, bhikkhave, bhikkhu rūpe aniccāti passati, sāssa hoti sammādiṭṭhi.","sn35.157:1.2":"Sammā passaṃ nibbindati.","sn35.157:1.3":"Nandikkhayā rāgakkhayo;","sn35.157:1.4":"rāgakkhayā nandikkhayo.","sn35.157:1.5":"Nandirāgakkhayā cittaṃ suvimuttanti vuccati.","sn35.157:1.6":"Anicceyeva, bhikkhave, bhikkhu sadde…","sn35.157:1.7":"gandhe…","sn35.157:1.8":"rase…","sn35.157:1.9":"phoṭṭhabbe…","sn35.157:1.10":"dhamme aniccāti passati, sāssa hoti sammādiṭṭhi.","sn35.157:1.11":"Sammā passaṃ nibbindati.","sn35.157:1.12":"Nandikkhayā rāgakkhayo;","sn35.157:1.13":"rāgakkhayā nandikkhayo.","sn35.157:1.14":"Nandirāgakkhayā cittaṃ suvimuttanti vuccatī”ti.","sn35.157:1.15":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":280,"to":281,"paras":[{"para":280,"vripara":"156-159","refs":["sn35.157:1"],"lines":["Nandikkhayavaggassa paṭhame <b>nandikkhayā rāgakkhayo, rāgakkhayā nandikkhayo</b>ti nandiyā ca rāgassa ca atthato ekattā vuttaṃ.","<b>Suvimutta</b>nti arahattaphalavimuttivasena suṭṭhu vimuttaṃ.","Sesamettha dutiyādīsu ca uttānameva. 5-6."],"lineRefs":[["sn35.157:1"],["sn35.157:1"],["sn35.157:1"]]},{"para":281,"vripara":null,"refs":["sn35.157:1"],"lines":["Jīvakambavanasamādhisuttādivaṇṇanā 160-161."],"lineRefs":[["sn35.157:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":296,"to":298,"paras":[{"para":296,"vripara":"156-159","refs":["sn35.157:1"],"lines":["<b>Atthato</b>ti sabhāvato.","Ñāṇena ariyato ñātabbato <b>attho,</b> sabhāvoti.","Evañhi abhijjanasabhāvo nandanaṭṭhena <b>nandī,</b> rañjanaṭṭhena <b>rāgo.</b>","<b>Vimuttivasenā</b>ti vimuttiyā adhigamavasena.","<b>Etthā</b>ti imasmiṃ paṭhamasutte.","<b>Dutiyādīsū</b>ti dutiyatatiyacatutthesu.","<b>Uttānameva</b> heṭṭhā vuttanayattā."],"lineRefs":[["sn35.157:1"],["sn35.157:1"],["sn35.157:1"],["sn35.157:1"],["sn35.157:1"],["sn35.157:1"],["sn35.157:1"]]},{"para":297,"vripara":null,"refs":["sn35.157:1"],"lines":["Ajjhattanandikkhayasuttādivaṇṇanā niṭṭhitā. 5-6."],"lineRefs":[["sn35.157:1"]]},{"para":298,"vripara":null,"refs":["sn35.157:1"],"lines":["Jīvakambavanasamādhisuttādivaṇṇanā 160-161."],"lineRefs":[["sn35.157:1"]]}],"wordLinks":[]},"tika2":null}
