{"suttaId":"tha-ap388","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[11031,11046],"vripara":"31"},"segments":{"tha-ap388:0.3":"Valliphaladāyakattheraapadānaṃ","tha-ap388:1.1":"“Sabbe janā samāgamma,","tha-ap388:1.2":"agamiṃsu vanaṃ tadā;","tha-ap388:1.3":"Phalamanvesamānā te,","tha-ap388:1.4":"alabhiṃsu phalaṃ tadā. 32.","tha-ap388:2.1":"“Tatthaddasāsiṃ sambuddhaṃ,","tha-ap388:2.2":"sayambhuṃ aparājitaṃ;","tha-ap388:2.3":"Pasannacitto sumano,","tha-ap388:2.4":"valliphalamadāsahaṃ. 33.","tha-ap388:3.1":"“Ekattiṃse ito kappe,","tha-ap388:3.2":"yaṃ phalamadadiṃ tadā;","tha-ap388:3.3":"Duggatiṃ nābhijānāmi,","tha-ap388:3.4":"phaladānassidaṃ phalaṃ. 34.","tha-ap388:4.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap388:4.3":"viharāmi anāsavo. 35.","tha-ap388:5.1":"“Svāgataṃ vata me āsi…pe…","tha-ap388:5.3":"kataṃ buddhassa sāsanaṃ. 36.","tha-ap388:6.1":"“Paṭisambhidā catasso…pe…","tha-ap388:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap388:7.1":"Itthaṃ sudaṃ āyasmā valliphaladāyako thero imā gāthāyo abhāsitthāti.","tha-ap388:8.1":"Valliphaladāyakattherassāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
