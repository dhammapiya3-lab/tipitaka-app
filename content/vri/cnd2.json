{"suttaId":"cnd2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Nidd-ii","vriCode":"s0516m.mul","paras":[177,562],"vripara":"57"},"segments":{"cnd2:0.3":"56","cnd2:1.0.1":"Vatthugāthā niṭṭhitā. 1. Ajitamāṇavapucchā 57.","cnd2:1.1":"“Kenassu nivuto loko, [iccāyasmā ajito]","cnd2:1.3":"Kenassu nappakāsati;","cnd2:1.4":"Kissābhilepanaṃ brūsi,","cnd2:1.5":"kiṃsu tassa mahabbhayaṃ”. 58.","cnd2:2.1":"“Avijjāya nivuto loko, [ajitāti bhagavā]","cnd2:2.3":"Vevicchā pamādā nappakāsati;","cnd2:2.4":"Jappābhilepanaṃ brūmi,","cnd2:2.5":"dukkhamassa mahabbhayaṃ”. 59.","cnd2:3.1":"“Savanti sabbadhi sotā, [iccāyasmā ajito]","cnd2:3.3":"Sotānaṃ kiṃ nivāraṇaṃ;","cnd2:3.4":"Sotānaṃ saṃvaraṃ brūhi,","cnd2:3.5":"kena sotā pidhiyyare”. 60.","cnd2:4.1":"“Yāni sotāni lokasmiṃ, [ajitāti bhagavā]","cnd2:4.3":"Sati tesaṃ nivāraṇaṃ;","cnd2:4.4":"Sotānaṃ saṃvaraṃ brūmi,","cnd2:4.5":"paññāyete pidhiyyare”. 61.","cnd2:5.1":"“Paññā ceva sati cāpi [satī ceva (sī.)], [iccāyasmā ajito]","cnd2:5.3":"Nāmarūpañca mārisa;","cnd2:5.4":"Etaṃ me puṭṭho pabrūhi,","cnd2:5.5":"katthetaṃ uparujjhati”. 62.","cnd2:6.1":"“Yametaṃ pañhaṃ apucchi,","cnd2:6.2":"ajita taṃ vadāmi te;","cnd2:6.3":"Yattha nāmañca rūpañca,","cnd2:6.4":"asesaṃ uparujjhati;","cnd2:6.5":"Viññāṇassa nirodhena,","cnd2:6.6":"etthetaṃ uparujjhati”. 63.","cnd2:7.1":"“Ye ca saṅkhātadhammāse,","cnd2:7.2":"ye ca sekhā [sekkhā (ka.)] puthū idha;","cnd2:7.3":"Tesaṃ me nipako iriyaṃ,","cnd2:7.4":"puṭṭho pabrūhi mārisa”. 64.","cnd2:8.1":"“Kāmesu nābhigijjheyya,","cnd2:8.2":"manasānāvilo siyā;","cnd2:8.3":"Kusalo sabbadhammānaṃ,","cnd2:8.4":"sato bhikkhu paribbaje”ti.","cnd2:8.5":"Ajitamāṇavapucchā paṭhamā. 2.","cnd2:9.0":"Tissametteyyamāṇavapucchā 65.","cnd2:9.1":"“Kodha santusito loke, [iccāyasmā tissametteyyo]","cnd2:9.3":"Kassa no santi iñjitā;","cnd2:9.4":"Ko ubhantamabhiññāya,","cnd2:9.5":"majjhe mantā na lippati [na pimpati (bahūsu)];","cnd2:9.6":"Kaṃ brūsi mahāpurisoti,","cnd2:9.7":"ko idha sibbinimaccagā”ti [sibbanimaccagā (sī. syā.)]. 66.","cnd2:10.1":"“Kāmesu brahmacariyavā, [metteyyāti bhagavā]","cnd2:10.3":"Vītataṇho sadā sato;","cnd2:10.4":"Saṅkhāya nibbuto bhikkhu,","cnd2:10.5":"tassa no santi iñjitā. 67.","cnd2:11.1":"“So ubhantamabhiññāya,","cnd2:11.2":"majjhe mantā na lippati;","cnd2:11.3":"Taṃ brūmi mahāpurisoti,","cnd2:11.4":"so idha sibbinimaccagā”ti.","cnd2:11.5":"Tissametteyyamāṇavapucchā dutiyā. 3.","cnd2:12.0":"Puṇṇakamāṇavapucchā 68.","cnd2:12.1":"“Anejaṃ mūladassāviṃ, [iccāyasmā puṇṇako]","cnd2:12.3":"Atthi pañhena āgamaṃ;","cnd2:12.4":"Kiṃ nissitā isayo manujā,","cnd2:12.5":"khattiyā brāhmaṇā devatānaṃ;","cnd2:12.6":"Yaññamakappayiṃsu puthūdha loke,","cnd2:12.7":"pucchāmi taṃ bhagavā brūhi metaṃ”. 69.","cnd2:13.1":"“Ye kecime isayo manujā, [puṇṇakāti bhagavā]","cnd2:13.3":"Khattiyā brāhmaṇā devatānaṃ;","cnd2:13.4":"Yaññamakappayiṃsu puthūdha loke,","cnd2:13.5":"āsīsamānā puṇṇaka itthattaṃ;","cnd2:13.6":"Jaraṃ sitā yaññamakappayiṃsu”. 70.","cnd2:14.1":"“Ye kecime isayo manujā, [iccāyasmā puṇṇako]","cnd2:14.3":"Khattiyā brāhmaṇā devatānaṃ;","cnd2:14.4":"Yaññamakappayiṃsu puthūdha loke,","cnd2:14.5":"kaccisu te bhagavā yaññapathe appamattā;","cnd2:14.6":"Atāruṃ jātiñca jarañca mārisa,","cnd2:14.7":"pucchāmi taṃ bhagavā brūhi metaṃ”. 71.","cnd2:15.1":"“Āsīsanti thomayanti, abhijappanti juhanti; [Puṇṇakāti bhagavā]","cnd2:15.3":"Kāmābhijappanti paṭicca lābhaṃ,","cnd2:15.4":"te yājayogā bhavarāgarattā;","cnd2:15.5":"Nātariṃsu jātijaranti brūmi”. 72.","cnd2:16.1":"“Te ce nātariṃsu yājayogā, [iccāyasmā puṇṇako]","cnd2:16.3":"Yaññehi jātiñca jarañca mārisa;","cnd2:16.4":"Atha ko carahi devamanussaloke,","cnd2:16.5":"atāri jātiñca jarañca mārisa;","cnd2:16.6":"Pucchāmi taṃ bhagavā brūhi metaṃ”. 73.","cnd2:17.1":"“Saṅkhāya lokasmi paroparāni, [puṇṇakāti bhagavā]","cnd2:17.3":"Yassiñjitaṃ natthi kuhiñci loke;","cnd2:17.4":"Santo vidhūmo anīgho nirāso,","cnd2:17.5":"atāri so jātijaranti brūmī”ti.","cnd2:17.6":"Puṇṇakamāṇavapucchā tatiyā. 4.","cnd2:18.0":"Mettagūmāṇavapucchā 74.","cnd2:18.1":"“Pucchāmi taṃ bhagavā brūhi metaṃ, [iccāyasmā mettagū]","cnd2:18.3":"Maññāmi taṃ vedaguṃ bhāvitattaṃ;","cnd2:18.4":"Kuto nu dukkhā samudāgatā ime,","cnd2:18.5":"ye keci lokasmimanekarūpā”. 75.","cnd2:19.1":"“Dukkhassa ve maṃ pabhavaṃ apucchasi, [mettagūti bhagavā]","cnd2:19.3":"Taṃ te pavakkhāmi yathā pajānaṃ;","cnd2:19.4":"Upadhinidānā pabhavanti dukkhā,","cnd2:19.5":"ye keci lokasmimanekarūpā. 76.","cnd2:20.1":"“Yo ve avidvā upadhiṃ karoti,","cnd2:20.2":"punappunaṃ dukkhamupeti mando;","cnd2:20.3":"Tasmā pajānaṃ upadhiṃ na kayirā,","cnd2:20.4":"dukkhassa jātippabhavānupassī”. 77.","cnd2:21.1":"“Yaṃ taṃ apucchimha akittayī no,","cnd2:21.2":"aññaṃ taṃ pucchāma tadiṅgha brūhi;","cnd2:21.3":"‘Kathaṃ nu dhīrā vitaranti oghaṃ,","cnd2:21.4":"jātiṃ jaraṃ sokapariddavañca’;","cnd2:21.5":"Taṃ me muni sādhu viyākarohi,","cnd2:21.6":"tathā hi te vidito esa dhammo”. 78.","cnd2:22.1":"“Kittayissāmi te dhammaṃ, [mettagūti bhagavā]","cnd2:22.3":"Diṭṭhe dhamme anītihaṃ;","cnd2:22.4":"Yaṃ viditvā sato caraṃ,","cnd2:22.5":"tare loke visattikaṃ”. 79.","cnd2:23.1":"“Tañcāhaṃ abhinandāmi,","cnd2:23.2":"mahesi dhammamuttamaṃ;","cnd2:23.3":"Yaṃ viditvā sato caraṃ,","cnd2:23.4":"tare loke visattikaṃ”. 80.","cnd2:24.1":"“Yaṃ kiñci sampajānāsi, [mettagūti bhagavā]","cnd2:24.3":"Uddhaṃ adho tiriyañcāpi majjhe;","cnd2:24.4":"Etesu nandiñca nivesanañca,","cnd2:24.5":"panujja viññāṇaṃ bhave na tiṭṭhe. 81.","cnd2:25.1":"“Evaṃvihārī sato appamatto,","cnd2:25.2":"bhikkhu caraṃ hitvā mamāyitāni;","cnd2:25.3":"Jātiṃ jaraṃ sokapariddavañca,","cnd2:25.4":"idheva vidvā pajaheyya dukkhaṃ”. 82.","cnd2:26.1":"“Etābhinandāmi vaco mahesino,","cnd2:26.2":"sukittitaṃ gotamanūpadhīkaṃ;","cnd2:26.3":"Addhā hi bhagavā pahāsi dukkhaṃ,","cnd2:26.4":"tathā hi te vidito esa dhammo. 83.","cnd2:27.1":"“Te cāpi nūnappajaheyyu dukkhaṃ,","cnd2:27.2":"ye tvaṃ muni aṭṭhitaṃ ovadeyya;","cnd2:27.3":"Taṃ taṃ namassāmi samecca nāga,","cnd2:27.4":"appeva maṃ bhagavā aṭṭhitaṃ ovadeyya”. 84.","cnd2:28.1":"“Yaṃ brāhmaṇaṃ vedagumābhijaññā,","cnd2:28.2":"akiñcanaṃ kāmabhave asattaṃ;","cnd2:28.3":"Addhā hi so oghamimaṃ atāri,","cnd2:28.4":"tiṇṇo ca pāraṃ akhilo akaṅkho. 85.","cnd2:29.1":"“Vidvā ca yo vedagū naro idha,","cnd2:29.2":"bhavābhave saṅgamimaṃ visajja;","cnd2:29.3":"So vītataṇho anīgho nirāso,","cnd2:29.4":"atāri so jātijaranti brūmī”ti.","cnd2:29.5":"Mettagūmāṇavapucchā catutthī. 5.","cnd2:30.0":"Dhotakamāṇavapucchā 86.","cnd2:30.1":"“Pucchāmi taṃ bhagavā brūhi metaṃ, [iccāyasmā dhotako]","cnd2:30.3":"Vācābhikaṅkhāmi mahesi tuyhaṃ;","cnd2:30.4":"Tava sutvāna nigghosaṃ,","cnd2:30.5":"sikkhe nibbānamattano”. 87.","cnd2:31.1":"“Tenahātappaṃ karohi, [dhotakāti bhagavā]","cnd2:31.3":"Idheva nipako sato;","cnd2:31.4":"Ito sutvāna nigghosaṃ,","cnd2:31.5":"sikkhe nibbānamattano”. 88.","cnd2:32.1":"“Passāmahaṃ devamanussaloke,","cnd2:32.2":"akiñcanaṃ brāhmaṇamiriyamānaṃ;","cnd2:32.3":"Taṃ taṃ namassāmi samantacakkhu,","cnd2:32.4":"pamuñca maṃ sakka kathaṃkathāhi”. 89.","cnd2:33.1":"“Nāhaṃ sahissāmi pamocanāya,","cnd2:33.2":"kathaṃkathiṃ dhotaka kañci loke;","cnd2:33.3":"Dhammañca seṭṭhaṃ abhijānamāno [ājānamāno (sī. syā. pī.)],","cnd2:33.4":"evaṃ tuvaṃ oghamimaṃ taresi”. 90.","cnd2:34.1":"“Anusāsa brahme karuṇāyamāno,","cnd2:34.2":"vivekadhammaṃ yamahaṃ vijaññaṃ;","cnd2:34.3":"Yathāhaṃ ākāsova abyāpajjamāno,","cnd2:34.4":"idheva santo asito careyyaṃ”. 91.","cnd2:35.1":"“Kittayissāmi te santiṃ, [dhotakāti bhagavā]","cnd2:35.2":"Diṭṭhe dhamme anītihaṃ;","cnd2:35.4":"Yaṃ viditvā sato caraṃ,","cnd2:35.5":"tare loke visattikaṃ”. 92.","cnd2:36.1":"“Tañcāhaṃ abhinandāmi,","cnd2:36.2":"mahesi santimuttamaṃ;","cnd2:36.3":"Yaṃ viditvā sato caraṃ,","cnd2:36.4":"tare loke visattikaṃ”. 93.","cnd2:37.1":"“Yaṃ kiñci sampajānāsi, [dhotakāti bhagavā]","cnd2:37.3":"Uddhaṃ adho tiriyañcāpi majjhe;","cnd2:37.4":"Etaṃ viditvā saṅgoti loke,","cnd2:37.5":"bhavābhavāya mākāsi taṇha”nti.","cnd2:37.6":"Dhotakamāṇavapucchā pañcamī. 6.","cnd2:38.0":"Upasīvamāṇavapucchā 94.","cnd2:38.1":"“Eko ahaṃ sakka mahantamoghaṃ, [iccāyasmā upasīvo]","cnd2:38.3":"Anissito no visahāmi tārituṃ;","cnd2:38.4":"Ārammaṇaṃ brūhi samantacakkhu,","cnd2:38.5":"yaṃ nissito oghamimaṃ tareyyaṃ”. 95.","cnd2:39.1":"“Ākiñcaññaṃ pekkhamāno satimā, [upasīvāti bhagavā]","cnd2:39.3":"Natthīti nissāya tarassu oghaṃ;","cnd2:39.4":"Kāme pahāya virato kathāhi,","cnd2:39.5":"taṇhakkhayaṃ nattamahābhipassa”. 96.","cnd2:40.1":"“Sabbesu kāmesu yo vītarāgo, [iccāyasmā upasīvo]","cnd2:40.3":"Ākiñcaññaṃ nissito hitvā maññaṃ;","cnd2:40.4":"Saññāvimokkhe parame vimutto [dhimutto (ka.)],","cnd2:40.5":"tiṭṭhe nu so tattha anānuyāyī” [anānuvāyī (syā. ka.)]. 97.","cnd2:41.1":"“Sabbesu kāmesu yo vītarāgo, [upasīvāti bhagavā]","cnd2:41.3":"Ākiñcaññaṃ nissito hitvā maññaṃ;","cnd2:41.4":"Saññāvimokkhe parame vimutto,","cnd2:41.5":"tiṭṭheyya so tattha anānuyāyī”. 98.","cnd2:42.1":"“Tiṭṭhe ce so tattha anānuyāyī,","cnd2:42.2":"pūgampi vassānaṃ samantacakkhu;","cnd2:42.3":"Tattheva so sītisiyā vimutto,","cnd2:42.4":"cavetha viññāṇaṃ tathāvidhassa”. 99.","cnd2:43.1":"“Acci yathā vātavegena khittā, [upasīvāti bhagavā]","cnd2:43.3":"Atthaṃ paleti na upeti saṅkhaṃ;","cnd2:43.4":"Evaṃ munī nāmakāyā vimutto,","cnd2:43.5":"atthaṃ paleti na upeti saṅkhaṃ”. 100.","cnd2:44.1":"“Atthaṅgato so uda vā so natthi,","cnd2:44.2":"udāhu ve sassatiyā arogo;","cnd2:44.3":"Taṃ me munī sādhu viyākarohi,","cnd2:44.4":"tathā hi te vidito esa dhammo”. 101.","cnd2:45.1":"“Atthaṅgatassa na pamāṇamatthi, [upasīvāti bhagavā]","cnd2:45.3":"Yena naṃ vajjuṃ taṃ tassa natthi;","cnd2:45.4":"Sabbesu dhammesu samūhatesu,","cnd2:45.5":"samūhatā vādapathāpi sabbe”ti.","cnd2:45.6":"Upasīvamāṇavapucchā chaṭṭhī. 7.","cnd2:46.0":"Nandamāṇavapucchā 102.","cnd2:46.1":"“Santi loke munayo, [iccāyasmā nando]","cnd2:46.3":"Janā vadanti tayidaṃ kathaṃsu;","cnd2:46.4":"Ñāṇūpapannaṃ muni no vadanti,","cnd2:46.5":"udāhu ve jīvitenūpapannaṃ”. 103.","cnd2:47.1":"“Na diṭṭhiyā na sutiyā na ñāṇena,","cnd2:47.2":"munīdha nanda kusalā vadanti;","cnd2:47.3":"Visenikatvā anīghā nirāsā,","cnd2:47.4":"caranti ye te munayoti brūmi”. 104.","cnd2:48.1":"“Ye kecime samaṇabrāhmaṇāse, [iccāyasmā nando]","cnd2:48.3":"Diṭṭhassutenāpi vadanti suddhiṃ;","cnd2:48.4":"Sīlabbatenāpi vadanti suddhiṃ,","cnd2:48.5":"Anekarūpena vadanti suddhiṃ;","cnd2:48.6":"Kaccissu te bhagavā tattha yatā carantā,","cnd2:48.7":"Atāru jātiñca jarañca mārisa;","cnd2:48.8":"Pucchāmi taṃ bhagavā brūhi metaṃ”. 105.","cnd2:49.1":"“Ye kecime samaṇabrāhmaṇāse, [nandāti bhagavā]","cnd2:49.3":"Diṭṭhassutenāpi vadanti suddhiṃ;","cnd2:49.4":"Sīlabbatenāpi vadanti suddhiṃ,","cnd2:49.5":"anekarūpena vadanti suddhiṃ;","cnd2:49.6":"Kiñcāpi te tattha yatā caranti,","cnd2:49.7":"nātariṃsu jātijaranti brūmi”. 106.","cnd2:50.1":"“Ye kecime samaṇabrāhmaṇāse, [iccāyasmā nando]","cnd2:50.3":"Diṭṭhassutenāpi vadanti suddhiṃ;","cnd2:50.4":"Sīlabbatenāpi vadanti suddhiṃ,","cnd2:50.5":"anekarūpena vadanti suddhiṃ;","cnd2:50.6":"Te ce muni brūsi anoghatiṇṇe,","cnd2:50.7":"atha ko carahi devamanussaloke;","cnd2:50.8":"Atāri jātiñca jarañca mārisa,","cnd2:50.9":"pucchāmi taṃ bhagavā brūhi metaṃ”. 107.","cnd2:51.1":"“Nāhaṃ sabbe samaṇabrāhmaṇāse, [nandāti bhagavā]","cnd2:51.3":"Jātijarāya nivutāti brūmi;","cnd2:51.4":"Ye sīdha diṭṭhaṃ va sutaṃ mutaṃ vā,","cnd2:51.5":"sīlabbataṃ vāpi pahāya sabbaṃ;","cnd2:51.6":"Anekarūpampi pahāya sabbaṃ,","cnd2:51.7":"taṇhaṃ pariññāya anāsavāse;","cnd2:51.8":"Te ve narā oghatiṇṇāti brūmi”. 108.","cnd2:52.1":"“Etābhinandāmi vaco mahesino,","cnd2:52.2":"sukittitaṃ gotamanūpadhīkaṃ;","cnd2:52.3":"Ye sīdha diṭṭhaṃ va sutaṃ mutaṃ vā,","cnd2:52.4":"sīlabbataṃ vāpi pahāya sabbaṃ;","cnd2:52.5":"Anekarūpampi pahāya sabbaṃ,","cnd2:52.6":"taṇhaṃ pariññāya anāsavāse;","cnd2:52.7":"Ahampi te oghatiṇṇāti brūmī”ti.","cnd2:52.8":"Nandamāṇavapucchā sattamā. 8.","cnd2:53.0":"Hemakamāṇavapucchā 109.","cnd2:53.1":"“Ye me pubbe viyākaṃsu, [iccāyasmā hemako]","cnd2:53.3":"Huraṃ gotamasāsanā;","cnd2:53.4":"Iccāsi iti bhavissati,","cnd2:53.5":"sabbaṃ taṃ itihītihaṃ;","cnd2:53.6":"Sabbaṃ taṃ takkavaḍḍhanaṃ,","cnd2:53.7":"nāhaṃ tattha abhiramiṃ. 110.","cnd2:54.1":"“Tvañca me dhammamakkhāhi,","cnd2:54.2":"taṇhānigghātanaṃ muni;","cnd2:54.3":"Yaṃ viditvā sato caraṃ,","cnd2:54.4":"tare loke visattikaṃ”. 111.","cnd2:55.1":"“Idha diṭṭhasutamutaviññātesu,","cnd2:55.2":"piyarūpesu hemaka;","cnd2:55.3":"Chandarāgavinodanaṃ,","cnd2:55.4":"nibbānapadamaccutaṃ. 112.","cnd2:56.1":"“Etadaññāya ye satā,","cnd2:56.2":"diṭṭhadhammābhinibbutā;","cnd2:56.3":"Upasantā ca te sadā,","cnd2:56.4":"tiṇṇā loke visattika”nti.","cnd2:56.5":"Hemakamāṇavapucchā aṭṭhamā. 9.","cnd2:57.0":"Todeyyamāṇavapucchā 113.","cnd2:57.1":"“Yasmiṃ kāmā na vasanti, [iccāyasmā todeyyo]","cnd2:57.3":"Taṇhā yassa na vijjati;","cnd2:57.4":"Kathaṃkathā ca yo tiṇṇo,","cnd2:57.5":"vimokkho tassa kīdiso”. 114.","cnd2:58.1":"“Yasmiṃ kāmā na vasanti, [todeyyāti bhagavā]","cnd2:58.2":"Taṇhā yassa na vijjati;","cnd2:58.4":"Kathaṃkathā ca yo tiṇṇo,","cnd2:58.5":"vimokkho tassa nāparo”. 115.","cnd2:59.1":"“Nirāsaso so uda āsasāno [āsayāno (ka.)],","cnd2:59.2":"paññāṇavā so uda paññakappī;","cnd2:59.3":"Muniṃ ahaṃ sakka yathā vijaññaṃ,","cnd2:59.4":"taṃ me viyācikkha samantacakkhu”. 116.","cnd2:60.1":"“Nirāsaso so na ca āsasāno,","cnd2:60.2":"paññāṇavā so na ca paññakappī;","cnd2:60.3":"Evampi todeyya muniṃ vijāna,","cnd2:60.4":"akiñcanaṃ kāmabhave asatta”nti.","cnd2:60.5":"Todeyyamāṇavapucchā navamā. 10.","cnd2:61.0":"Kappamāṇavapucchā 117.","cnd2:61.1":"“Majjhe sarasmiṃ tiṭṭhataṃ, [iccāyasmā kappo]","cnd2:61.3":"Oghe jāte mahabbhaye;","cnd2:61.4":"Jarāmaccuparetānaṃ,","cnd2:61.5":"dīpaṃ pabrūhi mārisa;","cnd2:61.6":"Tvañca me dīpamakkhāhi,","cnd2:61.7":"yathāyidaṃ nāparaṃ siyā”. 118.","cnd2:62.1":"“Majjhe sarasmiṃ tiṭṭhataṃ, [kappāti bhagavā]","cnd2:62.3":"Oghe jāte mahabbhaye;","cnd2:62.4":"Jarāmaccuparetānaṃ,","cnd2:62.5":"dīpaṃ pabrūmi kappa te. 119.","cnd2:63.1":"“Akiñcanaṃ anādānaṃ,","cnd2:63.2":"etaṃ dīpaṃ anāparaṃ;","cnd2:63.3":"Nibbānaṃ iti naṃ brūmi,","cnd2:63.4":"jarāmaccuparikkhayaṃ. 120.","cnd2:64.1":"“Etadaññāya ye satā,","cnd2:64.2":"diṭṭhadhammābhinibbutā;","cnd2:64.3":"Na te māravasānugā,","cnd2:64.4":"na te mārassa paṭṭhagū”ti [paddhagū (sī.)].","cnd2:64.5":"Kappamāṇavapucchā dasamā. 11.","cnd2:65.0":"Jatukaṇṇimāṇavapucchā 121.","cnd2:65.1":"“Sutvānahaṃ vīramakāmakāmiṃ, [iccāyasmā jatukaṇṇi]","cnd2:65.3":"Oghātigaṃ puṭṭhumakāmamāgamaṃ;","cnd2:65.4":"Santipadaṃ brūhi sahajanetta,","cnd2:65.5":"yathātacchaṃ bhagavā brūhi metaṃ. 122.","cnd2:66.1":"“Bhagavā hi kāme abhibhuyya iriyati,","cnd2:66.2":"ādiccova pathaviṃ tejī tejasā;","cnd2:66.3":"Parittapaññassa me bhūripañña,","cnd2:66.4":"ācikkha dhammaṃ yamahaṃ vijaññaṃ;","cnd2:66.5":"Jātijarāya idha vippahānaṃ”. 123.","cnd2:67.1":"“Kāmesu vinaya gedhaṃ, [jatukaṇṇīti bhagavā]","cnd2:67.3":"Nekkhammaṃ daṭṭhu khemato;","cnd2:67.4":"Uggahitaṃ nirattaṃ vā,","cnd2:67.5":"mā te vijjittha kiñcanaṃ. 124.","cnd2:68.1":"“Yaṃ pubbe taṃ visosehi,","cnd2:68.2":"pacchā te māhu kiñcanaṃ;","cnd2:68.3":"Majjhe ce no gahessasi,","cnd2:68.4":"upasanto carissasi. 125.","cnd2:69.1":"“Sabbaso nāmarūpasmiṃ,","cnd2:69.2":"vītagedhassa brāhmaṇa;","cnd2:69.3":"Āsavāssa na vijjanti,","cnd2:69.4":"yehi maccuvasaṃ vaje”ti.","cnd2:69.5":"Jatukaṇṇimāṇavapucchā ekādasamā. 12.","cnd2:70.0":"Bhadrāvudhamāṇavapucchā 126.","cnd2:70.1":"“Okañjahaṃ taṇhacchidaṃ anejaṃ, [iccāyasmā bhadrāvudho]","cnd2:70.3":"Nandiñjahaṃ oghatiṇṇaṃ vimuttaṃ;","cnd2:70.4":"Kappañjahaṃ abhiyāce sumedhaṃ,","cnd2:70.5":"sutvāna nāgassa apanamissanti ito. 127.","cnd2:71.1":"“Nānājanā janapadehi saṅgatā,","cnd2:71.2":"Tava vīra vākyaṃ abhikaṅkhamānā;","cnd2:71.3":"Tesaṃ tuvaṃ sādhu viyākarohi,","cnd2:71.4":"tathā hi te vidito esa dhammo”. 128.","cnd2:72.1":"“Ādānataṇhaṃ vinayetha sabbaṃ, [bhadrāvudhāti bhagavā]","cnd2:72.3":"Uddhaṃ adho tiriyañcāpi majjhe;","cnd2:72.4":"Yaṃ yañhi lokasmimupādiyanti,","cnd2:72.5":"teneva māro anveti jantuṃ. 129.","cnd2:73.1":"“Tasmā pajānaṃ na upādiyetha,","cnd2:73.2":"bhikkhu sato kiñcanaṃ sabbaloke;","cnd2:73.3":"Ādānasatte iti pekkhamāno,","cnd2:73.4":"pajaṃ imaṃ maccudheyye visatta”nti.","cnd2:73.5":"Bhadrāvudhamāṇavapucchā dvādasamā. 13.","cnd2:74.0":"Udayamāṇavapucchā 130.","cnd2:74.1":"“Jhāyiṃ virajamāsīnaṃ, [iccāyasmā udayo]","cnd2:74.3":"Katakiccaṃ anāsavaṃ;","cnd2:74.4":"Pāraguṃ sabbadhammānaṃ,","cnd2:74.5":"atthi pañhena āgamaṃ;","cnd2:74.6":"Aññāvimokkhaṃ pabrūhi,","cnd2:74.7":"avijjāya pabhedanaṃ”. 131.","cnd2:75.1":"“Pahānaṃ kāmacchandānaṃ, [udayāti bhagavā]","cnd2:75.3":"Domanassāna cūbhayaṃ;","cnd2:75.4":"Thinassa ca panūdanaṃ,","cnd2:75.5":"kukkuccānaṃ nivāraṇaṃ. 132.","cnd2:76.1":"“Upekkhāsatisaṃsuddhaṃ,","cnd2:76.2":"dhammatakkapurejavaṃ;","cnd2:76.3":"Aññāvimokkhaṃ pabrūmi,","cnd2:76.4":"avijjāya pabhedanaṃ”. 133.","cnd2:77.1":"“Kiṃsu saṃyojano loko,","cnd2:77.2":"kiṃsu tassa vicāraṇaṃ;","cnd2:77.3":"Kissassa vippahānena,","cnd2:77.4":"nibbānaṃ iti vuccati”. 134.","cnd2:78.1":"“Nandisaṃyojano loko,","cnd2:78.2":"vitakkassa vicāraṇaṃ;","cnd2:78.3":"Taṇhāya vippahānena,","cnd2:78.4":"nibbānaṃ iti vuccati”. 135.","cnd2:79.1":"“Kathaṃ satassa carato,","cnd2:79.2":"viññāṇaṃ uparujjhati;","cnd2:79.3":"Bhagavantaṃ puṭṭhumāgamma,","cnd2:79.4":"taṃ suṇoma vaco tava”. 136.","cnd2:80.1":"“Ajjhattañca bahiddhā ca,","cnd2:80.2":"vedanaṃ nābhinandato;","cnd2:80.3":"Evaṃ satassa carato,","cnd2:80.4":"viññāṇaṃ uparujjhatī”ti.","cnd2:80.5":"Udayamāṇavapucchā terasamā. 14.","cnd2:81.0":"Posālamāṇavapucchā 137.","cnd2:81.1":"“Yo atītaṃ ādisati, [iccāyasmā posālo]","cnd2:81.3":"Anejo chinnasaṃsayo;","cnd2:81.4":"Pāraguṃ sabbadhammānaṃ,","cnd2:81.5":"atthi pañhena āgamaṃ. 138.","cnd2:82.1":"“Vibhūtarūpasaññissa,","cnd2:82.2":"sabbakāyappahāyino;","cnd2:82.3":"Ajjhattañca bahiddhā ca,","cnd2:82.4":"natthi kiñcīti passato;","cnd2:82.5":"Ñāṇaṃ sakkānupucchāmi,","cnd2:82.6":"kathaṃ neyyo tathāvidho”. 139.","cnd2:83.1":"“Viññāṇaṭṭhitiyo sabbā, [posālāti bhagavā]","cnd2:83.3":"Abhijānaṃ tathāgato;","cnd2:83.4":"Tiṭṭhantamenaṃ jānāti,","cnd2:83.5":"vimuttaṃ tapparāyaṇaṃ. 140.","cnd2:84.1":"“Ākiñcaññasambhavaṃ ñatvā,","cnd2:84.2":"nandī saṃyojanaṃ iti;","cnd2:84.3":"Evametaṃ abhiññāya,","cnd2:84.4":"tato tattha vipassati;","cnd2:84.5":"Etaṃ [evaṃ (syā. ka.)] ñāṇaṃ tathaṃ tassa,","cnd2:84.6":"brāhmaṇassa vusīmato”ti.","cnd2:84.7":"Posālamāṇavapucchā cuddasamā. 15.","cnd2:85.0":"Mogharājamāṇavapucchā 141.","cnd2:85.1":"“Dvāhaṃ sakkaṃ apucchissaṃ, [iccāyasmā mogharājā]","cnd2:85.3":"Na me byākāsi cakkhumā;","cnd2:85.4":"Yāvatatiyañca devīsi,","cnd2:85.5":"byākarotīti me sutaṃ. 142.","cnd2:86.1":"“Ayaṃ loko paro loko,","cnd2:86.2":"brahmaloko sadevako;","cnd2:86.3":"Diṭṭhiṃ te nābhijānāti,","cnd2:86.4":"gotamassa yasassino. 143.","cnd2:87.1":"“Evaṃ abhikkantadassāviṃ,","cnd2:87.2":"atthi pañhena āgamaṃ;","cnd2:87.3":"Kathaṃ lokaṃ avekkhantaṃ,","cnd2:87.4":"maccurājā na passati”. 144.","cnd2:88.1":"“Suññato lokaṃ avekkhassu,","cnd2:88.2":"mogharāja sadā sato;","cnd2:88.3":"Attānudiṭṭhiṃ ūhacca,","cnd2:88.4":"evaṃ maccutaro siyā;","cnd2:88.5":"Evaṃ lokaṃ avekkhantaṃ,","cnd2:88.6":"maccurājā na passatī”ti.","cnd2:88.7":"Mogharājamāṇavapucchā pannarasamā. 16.","cnd2:89.0":"Piṅgiyamāṇavapucchā 145.","cnd2:89.1":"“Jiṇṇohamasmi abalo vītavaṇṇo, [iccāyasmā piṅgiyo]","cnd2:89.3":"Nettā na suddhā savanaṃ na phāsu;","cnd2:89.4":"Māhaṃ nassaṃ momuho antarāva,","cnd2:89.5":"ācikkha dhammaṃ yamahaṃ vijaññaṃ;","cnd2:89.6":"Jātijarāya idha vippahānaṃ”. 146.","cnd2:90.1":"“Disvāna rūpesu vihaññamāne, [piṅgiyāti bhagavā]","cnd2:90.3":"Ruppanti rūpesu janā pamattā;","cnd2:90.4":"Tasmā tuvaṃ piṅgiya appamatto,","cnd2:90.5":"jahassu rūpaṃ apunabbhavāya”. 147.","cnd2:91.1":"“Disā catasso vidisā catasso,","cnd2:91.2":"uddhaṃ adho dasa disā imāyo;","cnd2:91.3":"Na tuyhaṃ adiṭṭhaṃ asutaṃ amutaṃ [asutaṃ amutaṃ vā (sī.), asutāmutaṃ vā (syā.), asutaṃ’mutaṃ vā (pī.)],","cnd2:91.4":"atho aviññātaṃ kiñcanamatthi [kañci matthi (syā.), kiñci natthi (pī.), kiñcinamatthi (ka.)] loke;","cnd2:91.5":"Ācikkha dhammaṃ yamahaṃ vijaññaṃ,","cnd2:91.6":"jātijarāya idha vippahānaṃ”. 148.","cnd2:92.1":"“Taṇhādhipanne manuje pekkhamāno, [piṅgiyāti bhagavā]","cnd2:92.3":"Santāpajāte jarasā parete;","cnd2:92.4":"Tasmā tuvaṃ piṅgiya appamatto,","cnd2:92.5":"jahassu taṇhaṃ apunabbhavāyā”ti.","cnd2:92.6":"Piṅgiyamāṇavapucchā soḷasamā. 17."},"unsure":["cnd2:35.2","cnd2:58.2"],"preface":[],"attha":null,"tika":null,"tika2":null}
