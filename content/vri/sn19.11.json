{"suttaId":"sn19.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1261,1261],"vripara":"212"},"segments":{"sn19.11:0.3":"Sasīsakasuttaṃ","sn19.11:1.1":"Evaṃ me sutaṃ –","sn19.11:1.2":"ekaṃ samayaṃ rājagahe veḷuvane.","sn19.11:1.3":"“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ purisaṃ gūthakūpe sasīsakaṃ nimuggaṃ…pe…","sn19.11:1.4":"eso, bhikkhave, satto imasmiṃyeva rājagahe pāradāriko ahosi…pe….","sn19.11:1.5":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":881,"to":882,"paras":[{"para":881,"vripara":"212","refs":["sn19.11:1"],"lines":["Pāradārikavatthusmiṃ so satto parassa rakkhitagopitaṃ sassāmikaṃ phassaṃ phusanto mīḷhasukhena kāmasukhena cittaṃ ramayitvā kammasabhāgatāya gūthaphassaṃ phusanto dukkhamanubhavituṃ tattha nibbatto.","Paṭhamaṃ. 2."],"lineRefs":[["sn19.11:1"],["sn19.11:1"]]},{"para":882,"vripara":null,"refs":["sn19.11:1"],"lines":["Gūthakhādasuttavaṇṇanā 213."],"lineRefs":[["sn19.11:1"]]}],"wordLinks":[],"before":[{"para":879,"vripara":null,"title":"Dutiyavaggo","lines":["Dutiyavaggo 1."]},{"para":880,"vripara":null,"title":"Sasīsakasuttavaṇṇanā","lines":["Sasīsakasuttavaṇṇanā 212."]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":908,"to":909,"paras":[{"para":908,"vripara":"212","refs":["sn19.11:1"],"lines":["<b>Phusanto</b>ti theyyāya phusanto. 3."],"lineRefs":[["sn19.11:1"]]},{"para":909,"vripara":null,"refs":["sn19.11:1"],"lines":["Nicchavitthisuttavaṇṇanā 214."],"lineRefs":[["sn19.11:1"]]}],"wordLinks":[],"before":[{"para":906,"vripara":null,"title":"Dutiyavaggo","lines":["Dutiyavaggo 1."]},{"para":907,"vripara":null,"title":"Sasīsakasuttavaṇṇanā","lines":["Sasīsakasuttavaṇṇanā 212."]}]},"tika2":null}
