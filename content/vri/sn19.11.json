{"suttaId":"sn19.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1261,1261],"vripara":"212"},"segments":{"sn19.11:0.3":"Sasīsakasuttaṃ","sn19.11:1.1":"Evaṃ me sutaṃ –","sn19.11:1.2":"ekaṃ samayaṃ rājagahe veḷuvane.","sn19.11:1.3":"“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ purisaṃ gūthakūpe sasīsakaṃ nimuggaṃ … pe …","sn19.11:1.4":"eso, bhikkhave, satto imasmiṃyeva rājagahe pāradāriko ahosi … pe ….","sn19.11:1.5":"Paṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":881,"to":882,"paras":[{"para":881,"vripara":"212","refs":["sn19.11:1"],"lines":["Pāradārikavatthusmiṃ so satto parassa rakkhitagopitaṃ sassāmikaṃ phassaṃ phusanto mīḷhasukhena kāmasukhena cittaṃ ramayitvā kammasabhāgatāya gūthaphassaṃ phusanto dukkhamanubhavituṃ tattha nibbatto.","Paṭhamaṃ."],"lineRefs":[["sn19.11:1"],["sn19.11:1"]]},{"para":882,"vripara":null,"refs":["sn19.11:1"],"lines":["Gūthakhādasuttavaṇṇanā"],"lineRefs":[["sn19.11:1"]]}],"wordLinks":[],"before":[{"para":878,"vripara":null,"refs":[],"lines":["Paṭhamo vaggo."],"lineRefs":[[]]},{"para":879,"vripara":null,"refs":[],"lines":["Dutiyavaggo"],"lineRefs":[[]]},{"para":880,"vripara":null,"refs":[],"lines":["Sasīsakasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":908,"to":909,"paras":[{"para":908,"vripara":"212","refs":["sn19.11:1"],"lines":["<b>Phusanto</b>ti theyyāya phusanto."],"lineRefs":[["sn19.11:1"]]},{"para":909,"vripara":null,"refs":["sn19.11:1"],"lines":["Nicchavitthisuttavaṇṇanā"],"lineRefs":[["sn19.11:1"]]}],"wordLinks":[],"before":[{"para":904,"vripara":null,"refs":[],"lines":["Kumbhaṇḍasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":905,"vripara":null,"refs":[],"lines":["Paṭhamavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":906,"vripara":null,"refs":[],"lines":["Dutiyavaggo"],"lineRefs":[[]]},{"para":907,"vripara":null,"refs":[],"