{"suttaId":"ja213","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1406,1412],"vripara":"125"},"segments":{"ja213:0.4":"Bharujātakaṃ (2-7-3)","ja213:1.1":"Isīnamantaraṃ katvā, bharurājāti [kururājāti (ka.)] me sutaṃ;","ja213:1.3":"Ucchinno saha raṭṭhehi [raṭṭhena (sī. pī.)], sarājā vibhavaṅgato.","ja213:2.1":"Tasmā hi chandāgamanaṃ, nappasaṃsanti paṇḍitā;","ja213:2.3":"Aduṭṭhacitto bhāseyya, giraṃ saccupasaṃhitanti.","ja213:3.1":"Bharujātakaṃ [kururātakaṃ (ka.)] tatiyaṃ."},"attha":null,"tika":null}
