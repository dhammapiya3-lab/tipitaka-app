{"suttaId":"tha-ap103","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5156,5175],"vripara":"1"},"segments":{"tha-ap103:0.3":"Bhikkhadāyakattheraapadānaṃ","tha-ap103:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap103:1.2":"āhutīnaṃ paṭiggahaṃ;","tha-ap103:1.3":"Pavarā [pavanā (syā.)] abhinikkhantaṃ,","tha-ap103:1.4":"vanā nibbanamāgataṃ [vānā nibbānamāgataṃ (syā.)].","tha-ap103:2.1":"“Kaṭacchubhikkhaṃ pādāsiṃ,","tha-ap103:2.2":"siddhatthassa mahesino;","tha-ap103:2.3":"Paññāya upasantassa,","tha-ap103:2.4":"mahāvīrassa tādino.","tha-ap103:3.1":"“Padenānupadāyantaṃ [padenānupadāyanto (sī. syā.)],","tha-ap103:3.2":"nibbāpente mahājanaṃ;","tha-ap103:3.3":"Uḷārā vitti me jātā,","tha-ap103:3.4":"buddhe ādiccabandhune [vitti me pāhunā tāva, buddhassādiccabandhuno (syā.)].","tha-ap103:4.1":"“Catunnavutito kappe,","tha-ap103:4.2":"yaṃ dānamadadiṃ tadā;","tha-ap103:4.3":"Duggatiṃ nābhijānāmi,","tha-ap103:4.4":"bhikkhādānassidaṃ phalaṃ.","tha-ap103:5.1":"“Sattāsītimhito kappe,","tha-ap103:5.2":"mahāreṇu sanāmakā;","tha-ap103:5.3":"Sattaratanasampannā,","tha-ap103:5.4":"sattete cakkavattino.","tha-ap103:6.1":"“Paṭisambhidā catasso,","tha-ap103:6.2":"vimokkhāpi ca aṭṭhime;","tha-ap103:6.3":"Chaḷabhiññā sacchikatā,","tha-ap103:6.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap103:7.1":"Itthaṃ sudaṃ āyasmā bhikkhadāyako thero imā gāthāyo abhāsitthāti.","tha-ap103:8.1":"Bhikkhadāyakattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2799,"to":2799,"paras":[{"para":2799,"vripara":"1","refs":["tha-ap103:1"],"lines":["So aparabhāge attano pubbakammaṃ anussaritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>suvaṇṇavaṇṇaṃ sambuddhan</b>tiādimāha.","Taṃ sabbaṃ heṭṭhā vuttanayameva.","<b>Pavarā abhinikkhantan</b>ti pakārena varitabbaṃ patthetabbanti pavaraṃ, rammabhūtato vivekabhūtato sakavihārato abhi visesena nikkhantanti attho.","<b>Vānā nibbānamāgatan</b>ti vānaṃ vuccati taṇhā, tato nikkhantattā nibbānaṃ, vānanāmaṃ taṇhaṃ padhānaṃ katvā sabbakilese pahāya nibbānaṃ pattanti attho."],"lineRefs":[["tha-ap103:1"],["tha-ap103:1"],["tha-ap103:1"],["tha-ap103:1"]]}],"wordLinks":[["tha-ap103:1.1","suvaṇṇavaṇṇaṃ sambuddhaṃ",0,0],["tha-ap103:1.3","pavarā abhinikkhantaṃ",0,2]]},"tika":null,"tika2":null}
