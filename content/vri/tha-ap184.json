{"suttaId":"tha-ap184","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7028,7046],"vripara":"6"},"segments":{"tha-ap184:0.3":"Bandhujīvakattheraapadānaṃ","tha-ap184:1.1":"“Siddhattho nāma sambuddho, sayambhū sabbhi vaṇṇito;","tha-ap184:1.3":"Samādhiṃ so samāpanno, nisīdi pabbatantare.","tha-ap184:2.1":"“Jātassare gavesanto, dakajaṃ pupphamuttamaṃ;","tha-ap184:2.3":"Bandhujīvakapupphāni, addasaṃ samanantaraṃ.","tha-ap184:3.1":"“Ubho hatthehi paggayha, upāgacchiṃ mahāmuniṃ;","tha-ap184:3.3":"Pasannacitto sumano, siddhatthassābhiropayiṃ.","tha-ap184:4.1":"“Catunnavutito kappe, yaṃ pupphamabhiropayiṃ;","tha-ap184:4.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap184:5.1":"“Ito cātuddase kappe, eko āsiṃ janādhipo;","tha-ap184:5.3":"Samuddakappo nāmena, cakkavattī mahabbalo.","tha-ap184:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap184:7.1":"Itthaṃ sudaṃ āyasmā bandhujīvako thero imā gāthāyo abhāsitthāti.","tha-ap184:8.1":"Bandhujīvakattherassāpadānaṃ dutiyaṃ."},"attha":null,"tika":null}
