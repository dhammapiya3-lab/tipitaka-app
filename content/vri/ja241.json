{"suttaId":"ja241","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1655,1661],"vripara":"182"},"segments":{"ja241:0.4":"Sabbadāṭhijātakaṃ (2-10-1)","ja241:1.1":"Siṅgālo mānathaddho ca, parivārena atthiko;","ja241:1.3":"Pāpuṇi mahatiṃ bhūmiṃ, rājāsi sabbadāṭhinaṃ.","ja241:2.1":"Evameva manussesu, yo hoti parivāravā;","ja241:2.3":"So hi tattha mahā hoti, siṅgālo viya dāṭhinanti.","ja241:3.1":"Sabbadāṭhijātakaṃ paṭhamaṃ."},"attha":null,"tika":null}
