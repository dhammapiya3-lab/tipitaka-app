{"suttaId":"sn14.22","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[788,796],"vripara":"106"},"segments":{"sn14.22:0.3":"Kusītamūlakasuttaṃ","sn14.22:1.1":"Sāvatthiyaṃ viharati…pe…","sn14.22:1.2":"“dhātusova, bhikkhave, sattā saṃsandanti samenti.","sn14.22:1.3":"Kusītā kusītehi saddhiṃ saṃsandanti samenti;","sn14.22:1.4":"muṭṭhassatino muṭṭhassatīhi saddhiṃ saṃsandanti samenti;","sn14.22:1.5":"duppaññā duppaññehi saddhiṃ saṃsandanti samenti;","sn14.22:1.6":"āraddhavīriyā āraddhavīriyehi saddhiṃ saṃsandanti samenti;","sn14.22:1.7":"upaṭṭhitassatino upaṭṭhitassatīhi saddhiṃ saṃsandanti samenti; paññavanto paññavantehi saddhiṃ saṃsandanti samentīti…pe….","sn14.22:1.8":"Dvādasamaṃ.","sn14.22:1.10":"Dutiyo vaggo.","sn14.22:2.0":"Tassuddānaṃ –","sn14.22:2.1":"Sattimā sanidānañca,","sn14.22:2.2":"giñjakāvasathena ca;","sn14.22:2.3":"Hīnādhimutti caṅkamaṃ,","sn14.22:2.4":"sagāthā assaddhasattamaṃ.","sn14.22:3.1":"Assaddhamūlakā pañca,","sn14.22:3.2":"cattāro ahirikamūlakā;","sn14.22:3.3":"Anottappamūlakā tīṇi,","sn14.22:3.4":"duve appassutena ca.","sn14.22:4.1":"Kusītaṃ ekakaṃ vuttaṃ,","sn14.22:4.2":"suttantā tīṇi pañcakā;","sn14.22:4.3":"Bāvīsati vuttā suttā,","sn14.22:4.4":"dutiyo vaggo pavuccatīti. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":556,"to":559,"paras":[{"para":556,"vripara":"102-106","refs":["sn14.22:1"],"lines":["Aṭṭhamādīni teyeva assaddhādidhamme tikavasena katvā desitāni.","Tattha aṭṭhame assaddhādimūlakā kaṇhapakkhasukkapakkhavasena pañca tikā vuttā, navame ahirikamūlakā cattāro.","Dasame anottappamūlakā tayo, ekādasame appassutamūlakā dve, dvādasame kusītamūlako eko tiko vuttoti sabbepi pañcasu suttantesu pannarasa tikā honti.","Pannarasa cete suttantātipi vadanti.","Ayaṃ tikapeyyālo nāma.","Aṭṭhamādīni."],"lineRefs":[["sn14.22:1"],["sn14.22:1"],["sn14.22:1"],["sn14.22:1"],["sn14.22:1"],["sn14.22:1"]]},{"para":557,"vripara":null,"refs":["sn14.22:1"],"lines":["Dutiyo vaggo. 3."],"lineRefs":[["sn14.22:1"]]},{"para":558,"vripara":null,"refs":["sn14.22:1"],"lines":["Kammapathavaggo 1-2."],"lineRefs":[["sn14.22:1"]]},{"para":559,"vripara":null,"refs":["sn14.22:1"],"lines":["Asamāhitasuttādivaṇṇanā 107-108."],"lineRefs":[["sn14.22:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":560,"to":564,"paras":[{"para":560,"vripara":"102-106","refs":["sn14.22:1"],"lines":["<b>Aṭṭhamādīnī</b>ti aṭṭhamaṃ navamaṃ dasamaṃ ekādasamaṃ dvādasamanti imāni pañca suttānīti eke.","Apare pana nava suttānīti icchanti.","Svāyamattho aṭṭhakathāyaṃ vuttoyeva.","Pāḷiyañca kesuci potthakesu likhīyati."],"lineRefs":[["sn14.22:1"],["sn14.22:1"],["sn14.22:1"],["sn14.22:1"]]},{"para":561,"vripara":null,"refs":["sn14.22:1"],"lines":["Assaddhamūlakasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn14.22:1"]]},{"para":562,"vripara":null,"refs":["sn14.22:1"],"lines":["Dutiyavaggavaṇṇanā niṭṭhitā. 3."],"lineRefs":[["sn14.22:1"]]},{"para":563,"vripara":null,"refs":["sn14.22:1"],"lines":["Kammapathavaggo 1-2."],"lineRefs":[["sn14.22:1"]]},{"para":564,"vripara":null,"refs":["sn14.22:1"],"lines":["Asamāhitasuttādivaṇṇanā 107-108."],"lineRefs":[["sn14.22:1"]]}],"wordLinks":[]},"tika2":null}
