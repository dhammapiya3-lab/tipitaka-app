{"suttaId":"sn1.53","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[671,676],"vripara":"53"},"segments":{"sn1.53:0.3":"Mittasuttaṃ","sn1.53:1.1":"“Kiṃsu pavasato [pathavato (pī. ka.)] mittaṃ,","sn1.53:1.2":"kiṃsu mittaṃ sake ghare;","sn1.53:1.3":"Kiṃ mittaṃ atthajātassa,","sn1.53:1.4":"kiṃ mittaṃ samparāyikan”ti.","sn1.53:2.1":"“Sattho pavasato mittaṃ,","sn1.53:2.2":"mātā mittaṃ sake ghare;","sn1.53:2.3":"Sahāyo atthajātassa,","sn1.53:2.4":"hoti mittaṃ punappunaṃ;","sn1.53:2.5":"Sayaṃkatāni puññāni,","sn1.53:2.6":"taṃ mittaṃ samparāyikan”ti."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":442,"to":442,"paras":[{"para":442,"vripara":"53","refs":["sn1.53:2"],"lines":["Tatiye <b>sattho</b>ti saddhiṃcaro, jaṅghasattho vā sakaṭasattho vā.","<b>Mittan</b>ti roge uppanne pāṭaṅkiyā vā aññena vā yānena haritvā khemantasampāpanena mittaṃ.","<b>Sake ghare</b>ti attano gehe.","Tathārūpe roge jāte puttabhariyādayo jigucchanti, mātā pana asucimpi candanaṃ viya maññati.","Tasmā sā sake ghare mittaṃ.","<b>Sahāyo atthajātassā</b>ti uppannakiccassa yo taṃ kiccaṃ vahati nittharati, so kiccesu saha ayanabhāvena sahāyo mittaṃ, surāpānādisahāyā pana na mittā.","<b>Samparāyikan</b>ti samparāyahitaṃ.","Tatiyaṃ."],"lineRefs":[["sn1.53:2"],["sn1.53:2"],["sn1.53:2"],["sn1.53:2"],["sn1.53:2"],["sn1.53:2"],["sn1.53:2"],["sn1.53:2"]]}],"wordLinks":[["sn1.53:2.1","sattho",0,0],["sn1.53:2.1","mittaṃ",0,1],["sn1.53:2.3","mittaṃ",0,1],["sn1.53:2.5","mittaṃ",0,1],["sn1.53:2.1","sake ghare",0,2],["sn1.53:2.3","sahāyo atthajātassā",0,5],["sn1.53:2.5","samparāyikaṃ",0,6]],"before":[{"para":441,"vripara":null,"title":"Mittasuttavaṇṇanā","lines":["Mittasuttavaṇṇanā"]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":534,"to":534,"paras":[{"para":534,"vripara":"53","refs":["sn1.53:2"],"lines":["Saha atthena vattatīti <b>sattho,</b> bhaṇḍamūlaṃ gahetvā vāṇijjavasena desantarādīsu vicaraṇakajanasamūho.","Tenāha <b>“saddhiṃcaro”</b>ti, sahacaraṇakoti attho.","<b>Mittan</b>ti sinehayogena mittakiccayuttaṃ.","Idhādhippetappakāraṃ dassetuṃ <b>“roge uppanne”</b>tiādi vuttaṃ.","<b>Tathārūpe</b>ti jigucchanīye, duttikicche vā.","Yathā asaṇṭhitānaṃ saṇṭhāpanavasena pavasato purisassa bhogabyasane nāthatā, evaṃ puttasinehavasena puttassa mātuyā antogehe nāthatāti vuttaṃ <b>“mātā mittaṃ sake ghare”</b>ti.","<b>Atthajātassā</b>ti upaṭṭhitapayojanassāti atthoti āha <b>“uppannakiccassā”</b>ti.","<b>Samparāyahitan</b>ti samparāye hitāvahaṃ."],"lineRefs":[["sn1.53:2"],["sn1.53:2"],["sn1.53:2"],["sn1.53:2"],["sn1.53:2"],["sn1.53:2"],["sn1.53:2"],["sn1.53:2"]]}],"wordLinks":[["sn1.53:2.1","sattho",0,0],["sn1.53:2.1","mittaṃ",0,2],["sn1.53:2.3","mittaṃ",0,2],["sn1.53:2.5","mittaṃ",0,2],["sn1.53:2.1","mātā mittaṃ sake ghare",0,5],["sn1.53:2.3","atthajātassā",0,6]],"after":[{"para":535,"vripara":null,"title":"Mittasuttavaṇṇanā","lines":["Mittasuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
