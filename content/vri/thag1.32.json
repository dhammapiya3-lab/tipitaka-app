{"suttaId":"thag1.32","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[192,195],"vripara":"32"},"segments":{"thag1.32:0.4":"Suppiyattheragāthā","thag1.32:1.1":"“Ajaraṃ jīramānena,","thag1.32:1.2":"tappamānena nibbutiṃ;","thag1.32:1.3":"Nimiyaṃ [nimmissaṃ (sī.), nirāmisaṃ (syā.), nimineyyaṃ (?)] paramaṃ santiṃ,","thag1.32:1.4":"yogakkhemaṃ anuttaran”ti.","thag1.32:1.5":"… Suppiyo thero …."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":995,"to":995,"paras":[{"para":995,"vripara":"32","refs":["thag1.32:1"],"lines":["Tattha <b>ajaran</b>ti jarārahitaṃ, nibbānaṃ sandhāyāha.","Tañhi ajātattā natthi ettha jarā, etasmiṃ vā adhigate puggalassa sā natthīti jarābhāvahetutopi ajaraṃ nāma.","<b>Jīramānenā</b>ti jīrantena, khaṇe khaṇe jaraṃ pāpuṇantena.","<b>Tappamānenā</b>ti santappamānena, rāgādīhi ekādasahi aggīhi dayhamānena.","<b>Nibbutin</b>ti yathāvuttasantāpābhāvato nibbutasabhāvaṃ nibbānaṃ.","<b>Nimiyan</b>ti parivatteyyaṃ cetāpeyyaṃ.","<b>Paramaṃ santin</b>ti anavasesakilesābhisaṅkhārapariḷāhavūpasamadhammatāya uttamaṃ santiṃ.","Catūhi yogehi ananubandhattā <b>yogakkhemaṃ</b>.","Attano uttaritarassa kassaci abhāvato <b>anuttaraṃ</b>.","Ayañhettha saṅkhepattho – khaṇe khaṇe jarāya abhibhuyyamānattā jīramānena, tathā rāgaggiādīhi santappamānena gato evaṃ aniccena dukkhena asārena sabbathāpi anupasantasabhāvena saupaddavena, tappaṭipakkhabhāvato ajaraṃ paramupasamabhūtaṃ kenaci anupaddutaṃ anuttaraṃ nibbānaṃ nimiyaṃ parivatteyyaṃ “mahā vata me lābho mahā udayo hatthagato”ti.","Yathā hi manussā yaṃ kiñci bhaṇḍaṃ parivattentā nirapekkhā gayhamānena sambahumānā honti, evamayaṃ thero pahitatto viharanto attano kāye ca jīvite ca nirapekkhataṃ, nibbānaṃ paṭipesitattañca pakāsento “nimiyaṃ paramaṃ santiṃ, yogakkhemaṃ anuttaran”ti vatvā tameva paṭipattiṃ paribrūhayanto vipassanaṃ ussukkāpetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.52.51-77)–"],"lineRefs":[["thag1.32:1"],["thag1.32:1"],["thag1.32:1"],["thag1.32:1"],["thag1.32:1"],["thag1.32:1"],["thag1.32:1"],["thag1.32:1"],["thag1.32:1"],["thag1.32:1"],["thag1.32:1"],["thag1.32:1"]]}],"wordLinks":[["thag1.32:1.1","ajaraṃ",0,0],["thag1.32:1.1","jīramānenā",0,2],["thag1.32:1.1","tappamānenā",0,3],["thag1.32:1.1","nibbutiṃ",0,4],["thag1.32:1.3","nimiyaṃ",0,5],["thag1.32:1.3","paramaṃ santiṃ",0,6],["thag1.32:1.3","yogakkhemaṃ",0,7],["thag1.32:1.3","anuttaraṃ",0,8]],"before":[{"para":993,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Suppiyattheragāthāvaṇṇanā"]},{"para":994,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["<b>Ajaraṃ jīramānenā</b>ti āyasmato suppiyattherassa gāthā.","Kā uppatti?","So kira padumuttarassa bhagavato kāle kulagehe nibbattitvā tāpasapabbajjaṃ pabbajitvā araññāyatane vasanto tattha bhagavantaṃ disvā pasannamānaso phalāphalaṃ adāsi, tathā bhikkhusaṅghassa.","So tena puññakammena devamanussesu saṃsaranto kassapassa sammāsambuddhassa kāle khattiyakule nibbattitvā anukkamena viññutaṃ patto kalyāṇamittasannissayena laddhasaṃvego sāsane pabbajitvā bahussuto ahosi.","Jātimadena sutamadena ca attānaṃ ukkaṃsento pare ca vambhento vihāsi.","So imasmiṃ buddhuppāde tassa kammassa nissandena sāvatthiyaṃ paribhūtarūpe susānagopakakule nibbatti.","<b>Suppiyo</b>tissa nāmaṃ ahosi.","Atha viññutaṃ patto attano sahāyabhūtaṃ sopākattheraṃ upasaṅkamitvā tassa santike dhammaṃ sutvā paṭiladdhasaṃvego pabbajitvā sammāpaṭipattiṃ pūretvā <b>“ajaraṃ jīramānenā”</b>ti gāthaṃ abhāsi."]}],"after":[{"para":996,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Varuṇo nāma nāmena, brāhmaṇo mantapāragū;"]},{"para":997,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Chaḍḍetvā dasa puttāni, vanamajjhogahiṃ tadā."]},{"para":998,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Assamaṃ sukataṃ katvā, suvibhattaṃ manoramaṃ;"]},{"para":999,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Paṇṇasālaṃ karitvāna, vasāmi vipine ahaṃ."]},{"para":1000,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Padumuttaro lokavidū, āhutīnaṃ paṭiggaho;"]},{"para":1001,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Mamuddharitukāmo so, āgacchi mama assamaṃ."]},{"para":1002,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Yāvatā vanasaṇḍamhi, obhāso vipulo ahu;"]},{"para":1003,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Buddhassa ānubhāvena, pajjalī vipinaṃ tadā."]},{"para":1004,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Disvāna taṃ pāṭihīraṃ, buddhaseṭṭhassa tādino;"]},{"para":1005,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Pattapuṭaṃ gahetvāna, phalena pūjayiṃ ahaṃ."]},{"para":1006,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Upagantvāna sambuddhaṃ, sahakhārimadāsahaṃ;"]},{"para":1007,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Anukampāya me buddho, idaṃ vacanamabravi."]},{"para":1008,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Khāribhāraṃ gahetvāna, pacchato ehi me tuvaṃ;"]},{"para":1009,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Paribhutte ca saṅghamhi, puññaṃ tava bhavissati."]},{"para":1010,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Puṭakaṃ taṃ gahetvāna, bhikkhusaṅghassadāsahaṃ;"]},{"para":1011,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Tattha cittaṃ pasādetvā, tusitaṃ upapajjahaṃ."]},{"para":1012,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Tattha dibbehi naccehi, gītehi vāditehi ca;"]},{"para":1013,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Puññakammena saṃyuttaṃ, anubhomi sadā sukhaṃ."]},{"para":1014,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Yaṃ yaṃ yonupapajjāmi, devattaṃ atha mānusaṃ;"]},{"para":1015,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Bhoge me ūnatā natthi, phaladānassidaṃ phalaṃ."]},{"para":1016,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Yāvatā caturo dīpā, sasamuddā sapabbatā;"]},{"para":1017,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Phalaṃ buddhassa datvāna, issaraṃ kārayāmahaṃ."]},{"para":1018,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Yāvatā ye pakkhigaṇā, ākāse uppatanti ce;"]},{"para":1019,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Tepi me vasamanventi, phaladānassidaṃ phalaṃ."]},{"para":1020,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Yāvatā vanasaṇḍamhi, yakkhā bhūtā ca rakkhasā;"]},{"para":1021,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Kumbhaṇḍā garuḷā cāpi, pāricariyaṃ upenti me."]},{"para":1022,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Kummā soṇā madhukārā, ḍaṃsā ca makasā ubho;"]},{"para":1023,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Tepi maṃ vasamanventi, phaladānassidaṃ phalaṃ."]},{"para":1024,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Supaṇṇā nāma sakuṇā, pakkhijātā mahabbalā;"]},{"para":1025,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Tepi maṃ saraṇaṃ yanti, phaladānassidaṃ phalaṃ."]},{"para":1026,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Yepi dīghāyukā nāgā, iddhimanto mahāyasā;"]},{"para":1027,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Tepi maṃ vasamanventi, phaladānassidaṃ phalaṃ."]},{"para":1028,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Sīhā byagghā ca dīpī ca, acchakokataracchakā;"]},{"para":1029,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Tepi maṃ vasamanventi, phaladānassidaṃ phalaṃ."]},{"para":1030,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Osadhī tiṇavāsī ca, ye ca ākāsavāsino;"]},{"para":1031,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Sabbe maṃ saraṇaṃ yanti, phaladānassidaṃ phalaṃ."]},{"para":1032,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Sududdasaṃ sunipuṇaṃ, gambhīraṃ suppakāsitaṃ;"]},{"para":1033,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Phassayitvā viharāmi, phaladānassidaṃ phalaṃ."]},{"para":1034,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Vimokkhe aṭṭha phusitvā, viharāmi anāsavo;"]},{"para":1035,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Ātāpī nipako cāhaṃ, phaladānassidaṃ phalaṃ."]},{"para":1036,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Ye phalaṭṭhā buddhaputtā, khīṇadosā mahāyasā;"]},{"para":1037,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Ahamaññataro tesaṃ, phaladānassidaṃ phalaṃ."]},{"para":1038,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Abhiññāpāramiṃ gantvā, sukkamūlena codito;"]},{"para":1039,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Sabbāsave pariññāya, viharāmi anāsavo."]},{"para":1040,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Tevijjā iddhipattā ca, buddhaputtā mahāyasā;"]},{"para":1041,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Dibbasotaṃ samāpannā, tesaṃ aññataro ahaṃ."]},{"para":1042,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Satasahassito kappe, yaṃ phalaṃ adadiṃ tadā;"]},{"para":1043,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, phaladānassidaṃ phalaṃ."]},{"para":1044,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."]},{"para":1045,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Arahattaṃ pana patvāpi tameva gāthaṃ aññābyākaraṇavasena abhāsi."]},{"para":1046,"vripara":null,"title":"Suppiyattheragāthāvaṇṇanā","lines":["Suppiyattheragāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
