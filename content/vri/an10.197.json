{"suttaId":"an10.197","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[1454,1455],"vripara":"197"},"segments":{"an10.197:0.3":"Anussaritabbasuttaṃ","an10.197:1.1":"“Anussaritabbañca vo, bhikkhave, dhammaṃ desessāmi nānussaritabbañca.","an10.197:1.2":"Taṃ suṇātha … pe … katamo ca, bhikkhave, nānussaritabbo dhammo?","an10.197:1.4":"Pāṇātipāto … pe … micchādiṭṭhi – ayaṃ vuccati, bhikkhave, nānussaritabbo dhammo.","an10.197:2.1":"“Katamo ca, bhikkhave, anussaritabbo dhammo?","an10.197:2.2":"Pāṇātipātā veramaṇī … pe … sammādiṭṭhi – ayaṃ vuccati, bhikkhave, anussaritabbo dhammo”ti.","an10.197:2.5":"Navamaṃ."},"attha":null,"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":765,"to":769,"paras":[{"para":765,"vripara":"167-210","refs":["an10.197:1"],"lines":["167-210. Dutiye ca paṭhamādīni uttānatthāni.","Dasame <b>pacchābhūmivāsino</b>ti paccantadesavāsino.","<b>Sevālamālikā</b>ti pātova udakaṃ orohitvā sevālañceva uppalādīni ca gahetvā attano udakasuddhikabhāvajānanatthañceva “lokassa ca udakena suddhi hotī”ti imassa atthassa jānanatthañca mālaṃ katvā pilandhanakā.","<b>Udakorohakā</b>ti pāto majjhanhe sāyanhe ca udakaorohaṇakā.","Tenāha <b>“sāyatatiyakaṃ udakorohaṇānuyogamanuyuttā”</b>ti.","Ekādasamādīni uttānatthāni.","Catutthe paṇṇāsake natthi vattabbaṃ."],"lineRefs":[["an10.197:1"],["an10.197:1"],["an10.197:1"],["an10.197:1"],["an10.197:1"],["an10.197:1"],["an10.197:1"]]},{"para":766,"vripara":null,"refs":["an10.197:1"],"lines":["Brāhmaṇapaccorohaṇīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an10.197:1"]]},{"para":767,"vripara":null,"refs":["an10.197:1"],"lines":["Catutthapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an10.197:1"]]},{"para":768,"vripara":null,"refs":["an10.197:1"],"lines":["(21)1. Karajakāyavaggo"],"lineRefs":[["an10.197:1"]]},{"para":769,"vripara":null,"refs":["an10.197:1"],"lines":["1-536. Paṭhamanirayasaggasuttādivaṇṇanā"],"lineRefs":[["an10.197:1"]]}],"wordLinks":[]},"tika2":null