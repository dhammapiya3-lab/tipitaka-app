{"suttaId":"sn45.167","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[367,367],"vripara":"167"},"segments":{"sn45.167:0.3":"Malasuttaṃ","sn45.167:1.1":"“Tīṇimāni, bhikkhave, malāni.","sn45.167:1.2":"Katamāni tīṇi?","sn45.167:1.3":"Rāgo malaṃ, doso malaṃ, moho malaṃ – imāni kho, bhikkhave, tīṇi malāni.","sn45.167:1.5":"Imesaṃ kho, bhikkhave, tiṇṇannaṃ malānaṃ abhiññāya pariññāya parikkhayāya pahānāya … pe … ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.167:1.6":"Sattamaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":114,"to":117,"paras":[{"para":114,"vripara":"162-171","refs":["sn45.167:1"],"lines":["162-171. <b>Vidhā</b>ti mānakoṭṭhāsā mānaṭhapanā vā.","<b>Seyyohamasmīti vidhā</b>ti ahamasmi seyyoti evaṃ mānakoṭṭhāso mānaṭhapanā vā.","<b>Nīghā</b>ti dukkhā.","Vacanattho panettha yassa uppajjanti, taṃ purisaṃ nīhanantīti nīghā.","Sesamettha uttānamevāti."],"lineRefs":[["sn45.167:1"],["sn45.167:1"],["sn45.167:1"],["sn45.167:1"],["sn45.167:1"]]},{"para":115,"vripara":null,"refs":["sn45.167:1"],"lines":["Esanāvaggo dasamo."],"lineRefs":[["sn45.167:1"]]},{"para":116,"vripara":null,"refs":["sn45.167:1"],"lines":["Oghavaggo"],"lineRefs":[["sn45.167:1"]]},{"para":117,"vripara":null,"refs":["sn45.167:1"],"lines":["1-2. Oghasuttādivaṇṇanā"],"lineRefs":[["sn45.167:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":114,"to":117,"paras":[{"para":114,"vripara":"162-171","refs":["sn45.167:1"],"lines":["162-171. Seyyohamasmītiādinā taṃtaṃvibhāgena dhīyanti vidhīyantīti <b>vidhā,</b> mānakoṭṭhāsā, mānaṭṭhapanā vā.","<b>Nīhanantī</b>ti vibādhenti."],"lineRefs":[["sn45.167:1"],["sn45.167:1"]]},{"para":115,"vripara":null,"refs":["sn45.167:1"],"lines":["Esanāvaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn45.167:1"]]},{"para":116,"vripara":null,"refs":["sn45.167:1"],"lines":["Oghavaggo"],"lineRefs":[["sn45.167:1"]]},{"para":117,"vripara":null,"refs":["sn45.167:1"],"lines":["1-2. Oghasuttādivaṇṇanā"],"lineRefs":[["sn45.167:1"]]}],"wordLinks":[]},"tika2":null}
