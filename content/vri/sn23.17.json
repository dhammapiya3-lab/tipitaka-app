{"suttaId":"sn23.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[935,935],"vripara":"176"},"segments":{"sn23.17:0.3":"Anattasuttaṃ","sn23.17:1.1":"Sāvatthinidānaṃ.","sn23.17:1.2":"Ekamantaṃ nisinno kho āyasmā rādho bhagavantaṃ etadavoca –","sn23.17:1.3":"“‘anattā, anattā’ti, bhante, vuccati.","sn23.17:1.4":"Katamo nu kho, bhante, anattā”ti?","sn23.17:1.5":"“Rūpaṃ kho, rādha, anattā, vedanā anattā, saññā anattā, saṅkhārā anattā, viññāṇaṃ anattā.","sn23.17:1.6":"Evaṃ passaṃ…pe…","sn23.17:1.7":"nāparaṃ itthattāyāti pajānātī”ti.","sn23.17:1.8":"Sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":410,"to":413,"paras":[{"para":410,"vripara":"170-181","refs":["sn23.17:1"],"lines":["Dutiyavaggassa paṭhame <b>māro, māro</b>ti maraṇaṃ pucchati.","Yasmā pana rūpādivinimuttaṃ maraṇaṃ nāma natthi, tenassa bhagavā <b>rūpaṃ kho, rādha, māro</b>tiādimāha.","Dutiye <b>māradhammo</b>ti maraṇadhammo.","Etenupāyena sabbattha attho veditabboti."],"lineRefs":[["sn23.17:1"],["sn23.17:1"],["sn23.17:1"],["sn23.17:1"]]},{"para":411,"vripara":null,"refs":["sn23.17:1"],"lines":["Dutiyo vaggo. 3-4."],"lineRefs":[["sn23.17:1"]]},{"para":412,"vripara":null,"refs":["sn23.17:1"],"lines":["Āyācanavaggādi 1-11."],"lineRefs":[["sn23.17:1"]]},{"para":413,"vripara":null,"refs":["sn23.17:1"],"lines":["Mārādisuttaekādasakavaṇṇanā 182-205."],"lineRefs":[["sn23.17:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":420,"to":424,"paras":[{"para":420,"vripara":"170-181","refs":["sn23.17:1"],"lines":["<b>Rūpādivinimuttaṃ</b> <b>maraṇaṃ nāma natthi</b> rūpādīnaṃyeva vibhave maraṇasamaññāti.","<b>Maraṇadhammo</b> vināsabhāvo."],"lineRefs":[["sn23.17:1"],["sn23.17:1"]]},{"para":421,"vripara":null,"refs":["sn23.17:1"],"lines":["Mārasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn23.17:1"]]},{"para":422,"vripara":null,"refs":["sn23.17:1"],"lines":["Dutiyavaggavaṇṇanā niṭṭhitā. 3-4."],"lineRefs":[["sn23.17:1"]]},{"para":423,"vripara":null,"refs":["sn23.17:1"],"lines":["Āyācanavaggādi 1-11."],"lineRefs":[["sn23.17:1"]]},{"para":424,"vripara":null,"refs":["sn23.17:1"],"lines":["Mārādisuttaekādasakavaṇṇanā 182-205."],"lineRefs":[["sn23.17:1"]]}],"wordLinks":[]},"tika2":null}
