{"suttaId":"ja503","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[8629,8713],"vripara":"159"},"segments":{"ja503:0.4":"Sattigumbajātakaṃ (7)","ja503:1.1":"Migaluddo mahārājā,","ja503:1.2":"pañcālānaṃ rathesabho;","ja503:1.3":"Nikkhanto saha senāya,","ja503:1.4":"ogaṇo vanamāgamā. 160.","ja503:2.1":"Tatthaddasā araññasmiṃ,","ja503:2.2":"takkarānaṃ kuṭiṃ kataṃ;","ja503:2.3":"Tassā [tasmā (syā. pī. ka.)] kuṭiyā nikkhamma,","ja503:2.4":"suvo luddāni bhāsati. 161.","ja503:3.1":"Sampannavāhano poso,","ja503:3.2":"yuvā sammaṭṭhakuṇḍalo [kuṇḍalī (syā. ka.)];","ja503:3.3":"Sobhati lohituṇhīso,","ja503:3.4":"divā sūriyova bhāsati. 162.","ja503:4.1":"Majjhanhike [majjhantike (sabbattha)] sampatike,","ja503:4.2":"sutto rājā sasārathi;","ja503:4.3":"Handassābharaṇaṃ sabbaṃ,","ja503:4.4":"gaṇhāma sāhasā [sahasā (sī. syā. pī.)] mayaṃ. 163.","ja503:5.1":"Nisīthepi raho dāni,","ja503:5.2":"sutto rājā sasārathi;","ja503:5.3":"Ādāya vatthaṃ maṇikuṇḍalañca,","ja503:5.4":"hantvāna sākhāhi avattharāma. 164.","ja503:6.1":"Kinnu ummattarūpova,","ja503:6.2":"sattigumba pabhāsasi;","ja503:6.3":"Durāsadā hi rājāno,","ja503:6.4":"aggi pajjalito yathā. 165.","ja503:7.1":"Atha tvaṃ patikolamba,","ja503:7.2":"matto thullāni gajjasi;","ja503:7.3":"Mātari mayhaṃ naggāya, kinnu tvaṃ vijigucchase. 166.","ja503:8.1":"Uṭṭhehi samma taramāno,","ja503:8.2":"rathaṃ yojehi sārathi;","ja503:8.3":"Sakuṇo me na ruccati,","ja503:8.4":"aññaṃ gacchāma assamaṃ. 167.","ja503:9.1":"Yutto ratho mahārāja,","ja503:9.2":"yutto ca balavāhano;","ja503:9.3":"Adhitiṭṭha mahārāja,","ja503:9.4":"aññaṃ gacchāma assamaṃ. 168.","ja503:10.1":"Ko numeva gatā [kva nu’me’pagatā (?)] sabbe,","ja503:10.2":"ye asmiṃ paricārakā;","ja503:10.3":"Esa gacchati pañcālo,","ja503:10.4":"mutto tesaṃ adassanā. 169.","ja503:11.1":"Kodaṇḍakāni gaṇhatha,","ja503:11.2":"sattiyo tomarāni ca;","ja503:11.3":"Esa gacchati pañcālo,","ja503:11.4":"mā vo muñcittha jīvataṃ [jīvitaṃ (bahūsu)]. 170.","ja503:12.1":"Athāparo paṭinandittha,","ja503:12.2":"suvo lohitatuṇḍako;","ja503:12.3":"Svāgataṃ te mahārāja,","ja503:12.4":"atho te adurāgataṃ;","ja503:12.5":"Issarosi anuppatto,","ja503:12.6":"yaṃ idhatthi pavedaya. 171.","ja503:13.1":"Tindukāni piyālāni,","ja503:13.2":"madhuke kāsumāriyo;","ja503:13.3":"Phalāni khuddakappāni,","ja503:13.4":"bhuñja rāja varaṃ varaṃ. 172.","ja503:14.1":"Idampi pānīyaṃ sītaṃ,","ja503:14.2":"ābhataṃ girigabbharā;","ja503:14.3":"Tato piva mahārāja,","ja503:14.4":"sace tvaṃ abhikaṅkhasi. 173.","ja503:15.1":"Araññaṃ uñchāya gatā,","ja503:15.2":"ye asmiṃ paricārakā;","ja503:15.3":"Sayaṃ uṭṭhāya gaṇhavho,","ja503:15.4":"hatthā me natthi dātave. 174.","ja503:16.1":"Bhaddako vatayaṃ pakkhī,","ja503:16.2":"dijo paramadhammiko;","ja503:16.3":"Atheso itaro pakkhī,","ja503:16.4":"suvo luddāni bhāsati. 175.","ja503:17.1":"“Etaṃ hanatha bandhatha,","ja503:17.2":"mā vo muñcittha jīvataṃ”;","ja503:17.3":"Iccevaṃ vilapantassa,","ja503:17.4":"sotthiṃ [sotthī (syā.)] pattosmi assamaṃ. 176.","ja503:18.1":"Bhātarosma mahārāja,","ja503:18.2":"sodariyā ekamātukā;","ja503:18.3":"Ekarukkhasmiṃ saṃvaḍḍhā,","ja503:18.4":"nānākhettagatā ubho. 177.","ja503:19.1":"Sattigumbo ca corānaṃ,","ja503:19.2":"ahañca isīnaṃ idha;","ja503:19.3":"Asataṃ so, sataṃ ahaṃ,","ja503:19.4":"tena dhammena no vinā. 178.","ja503:20.1":"Tattha vadho ca bandho ca,","ja503:20.2":"nikatī vañcanāni ca;","ja503:20.3":"Ālopā sāhasākārā,","ja503:20.4":"tāni so tattha sikkhati. 179.","ja503:21.1":"Idha saccañca dhammo ca,","ja503:21.2":"ahiṃsā saṃyamo damo;","ja503:21.3":"Āsanūdakadāyīnaṃ,","ja503:21.4":"aṅke vaddhosmi bhāradha [bhārata (sī. syā. pī.)]. 180.","ja503:22.1":"Yaṃ yañhi rāja bhajati,","ja503:22.2":"santaṃ vā yadi vā asaṃ;","ja503:22.3":"Sīlavantaṃ visīlaṃ vā,","ja503:22.4":"vasaṃ tasseva gacchati. 181.","ja503:23.1":"Yādisaṃ kurute mittaṃ,","ja503:23.2":"yādisaṃ cūpasevati;","ja503:23.3":"Sopi tādisako hoti,","ja503:23.4":"sahavāso hi [sahavāsopi (syā. ka.)] tādiso. 182.","ja503:24.1":"Sevamāno sevamānaṃ,","ja503:24.2":"samphuṭṭho samphusaṃ paraṃ;","ja503:24.3":"Saro diddho kalāpaṃva,","ja503:24.4":"alittamupalimpati;","ja503:24.5":"Upalepabhayā [upalimpabhayā (syā. ka.)] dhīro,","ja503:24.6":"neva pāpasakhā siyā. 183.","ja503:25.1":"Pūtimacchaṃ kusaggena,","ja503:25.2":"yo naro upanayhati;","ja503:25.3":"Kusāpi pūti [pūtī (sī. pī.)] vāyanti,","ja503:25.4":"evaṃ bālūpasevanā. 184.","ja503:26.1":"Tagarañca palāsena,","ja503:26.2":"yo naro upanayhati;","ja503:26.3":"Pattāpi surabhi [surabhī (sī. syā. pī.)] vāyanti,","ja503:26.4":"evaṃ dhīrūpasevanā. 185.","ja503:27.1":"Tasmā pattapuṭasseva [phalapuṭasseva (sī. pī.), palapuṭasseva (ka. aṭṭha.), palāsapuṭasseva (syā. ka.)],","ja503:27.2":"ñatvā sampākamattano;","ja503:27.3":"Asante nopaseveyya,","ja503:27.4":"sante seveyya paṇḍito;","ja503:27.5":"Asanto nirayaṃ nenti,","ja503:27.6":"santo pāpenti suggatinti.","ja503:28.1":"Sattigumbajātakaṃ sattamaṃ. 504."},"unsure":["ja503:7.3"],"preface":[],"attha":{"book":"Ja-a-iv","bookName":"Jātaka-aṭṭhakathā-4","vriCode":"s0513a4.att","from":4459,"to":4546,"paras":[{"para":4459,"vripara":null,"refs":["ja503:5"],"lines":["Tattha <b>migaluddo</b>ti luddo viya migānaṃ gavesanato “migaluddo”ti vutto.","<b>Ogaṇo</b>ti gaṇā ohīno parihīno hutvā.","<b>Takkarānaṃ kuṭiṃ kata</b>nti so rājā tattha araññe corānaṃ vasanatthāya kataṃ gāmakaṃ addasa.","<b>Tassā</b>ti tato corakuṭito.","<b>Luddāni bhāsatī</b>ti patikolambena saddhiṃ dāruṇāni vacanāni katheti.","<b>Sampannavāhano</b>ti sampannaassavāhano.","<b>Lohituṇhīso</b>ti rattena uṇhīsapaṭṭena samannāgato.","<b>Sampatike</b>ti sampati idāni, evarūpe ṭhitamajjhanhikakāleti attho.","<b>Sāhasā</b>ti sāhasena pasayhākāraṃ katvā gaṇhāmāti vadati.","<b>Nisīthepi rahodānī</b>ti nisīthepi idānipi raho.","Idaṃ vadati – yathā nisīthe aḍḍharattasamaye manussā kilantā sayanti, raho nāma hoti, idāni ṭhitamajjhanhikepi kāle tathevāti.","<b>Hantvānā</b>ti rājānaṃ māretvā vatthābharaṇānissa gahetvā atha naṃ pāde gahetvā kaḍḍhitvā ekamante sākhāhi paṭicchādemāti."],"lineRefs":[["ja503:5"],["ja503:5"],["ja503:5"],["ja503:5"],["ja503:5"],["ja503:5"],["ja503:5"],["ja503:5"],["ja503:5"],["ja503:5"],["ja503:5"],["ja503:5"]]},{"para":4460,"vripara":null,"refs":["ja503:5"],"lines":["Iti so vegena sakiṃ nikkhamati, sakiṃ patikolambassa santikaṃ gacchati.","So tassa vacanaṃ sutvā nikkhamitvā olokento rājabhāvaṃ ñatvā bhīto gāthamāha – 164."],"lineRefs":[["ja503:5"],["ja503:5"]]},{"para":4462,"vripara":"164","refs":["ja503:5"],"lines":["“Kinnu ummattarūpova, sattigumba pabhāsasi;"],"lineRefs":[["ja503:5"]]},{"para":4463,"vripara":null,"refs":["ja503:5"],"lines":["Durāsadā hi rājāno, aggi pajjalito yathā”ti."],"lineRefs":[["ja503:5"]]},{"para":4464,"vripara":null,"refs":["ja503:5"],"lines":["Atha naṃ suvo gāthāya ajjhabhāsi – 165."],"lineRefs":[["ja503:5"]]},{"para":4466,"vripara":"165","refs":["ja503:5"],"lines":["“Atha tvaṃ patikolamba, matto thullāni gajjasi;"],"lineRefs":[["ja503:5"]]},{"para":4467,"vripara":null,"refs":["ja503:5"],"lines":["Mātari mayha naggāya, kinnu tvaṃ vijigucchase”ti."],"lineRefs":[["ja503:5"]]},{"para":4468,"vripara":null,"refs":["ja503:7"],"lines":["Tattha <b>atha tva</b>nti nanu tvaṃ.","<b>Matto</b>ti corānaṃ ucchiṭṭhasuraṃ labhitvā tāya matto hutvā pubbe mahāgajjitāni gajjasi.","<b>Mātarī</b>ti corajeṭṭhakassa bhariyaṃ sandhāyāha.","Sā kira tadā sākhābhaṅgaṃ nivāsetvā carati.","<b>Vijigucchase</b>ti mama mātari naggāya kinnu tvaṃ idāni corakammaṃ jigucchasi, kātuṃ na icchasīti."],"lineRefs":[["ja503:7"],["ja503:7"],["ja503:7"],["ja503:7"],["ja503:7"]]},{"para":4469,"vripara":null,"refs":["ja503:7"],"lines":["Rājā pabujjhitvā tassa tena saddhiṃ manussabhāsāya kathentassa vacanaṃ sutvā “sappaṭibhayaṃ idaṃ ṭhāna”nti sārathiṃ uṭṭhāpento gāthamāha – 166."],"lineRefs":[["ja503:7"]]},{"para":4471,"vripara":"166","refs":["ja503:7"],"lines":["“Uṭṭhehi samma taramāno, rathaṃ yojehi sārathi;"],"lineRefs":[["ja503:7"]]},{"para":4472,"vripara":null,"refs":["ja503:7"],"lines":["Sakuṇo me na ruccati, aññaṃ gacchāma assama”nti."],"lineRefs":[["ja503:7"]]},{"para":4473,"vripara":null,"refs":["ja503:7"],"lines":["Sopi sīghaṃ uṭṭhahitvā rathaṃ yojetvā gāthamāha – 167."],"lineRefs":[["ja503:7"]]},{"para":4475,"vripara":"167","refs":["ja503:7"],"lines":["“Yutto ratho mahārāja, yutto ca balavāhano;"],"lineRefs":[["ja503:7"]]},{"para":4476,"vripara":null,"refs":["ja503:7"],"lines":["Adhitiṭṭha mahārāja, aññaṃ gacchāma assama”nti."],"lineRefs":[["ja503:7"]]},{"para":4477,"vripara":null,"refs":["ja503:9"],"lines":["Tattha <b>balavāhano</b>ti balavavāhano, mahāthāmaassasampannoti attho.","<b>Adhitiṭṭhā</b>ti abhiruha."],"lineRefs":[["ja503:9"],["ja503:9"]]},{"para":4478,"vripara":null,"refs":["ja503:9"],"lines":["Abhiruḷhamatteyeva ca tasmiṃ sindhavā vātavegena pakkhandiṃsu.","Sattigumbo rathaṃ gacchantaṃ disvā saṃvegappatto dve gāthā abhāsi – 168."],"lineRefs":[["ja503:9"],["ja503:9"]]},{"para":4480,"vripara":"168","refs":["ja503:9"],"lines":["“Ko numeva gatā sabbe, ye asmiṃ paricārakā;"],"lineRefs":[["ja503:9"]]},{"para":4481,"vripara":null,"refs":["ja503:9"],"lines":["Esa gacchati pañcālo, mutto tesaṃ adassanā. 169."],"lineRefs":[["ja503:9"]]},{"para":4483,"vripara":"169","refs":["ja503:9"],"lines":["“Kodaṇḍakāni gaṇhatha, sattiyo tomarāni ca;"],"lineRefs":[["ja503:9"]]},{"para":4484,"vripara":null,"refs":["ja503:9"],"lines":["Esa gacchati pañcālo, mā vo muñcittha jīvata”nti."],"lineRefs":[["ja503:9"]]},{"para":4485,"vripara":null,"refs":["ja503:9","ja503:11"],"lines":["Tattha <b>ko nume</b>ti kuhiṃ nu ime.","<b>Asmi</b>nti imasmiṃ assame.","<b>Paricārakā</b>ti corā.","<b>Adassanā</b>ti etesaṃ corānaṃ adassanena mutto esa gacchatīti, etesaṃ hatthato mutto hutvā esa adassanaṃ gacchatītipi attho.","<b>Kodaṇḍakānī</b>ti dhanūni.","<b>Jīvata</b>nti tumhākaṃ jīvantānaṃ mā muñcittha, āvudhahatthā dhāvitvā gaṇhatha nanti."],"lineRefs":[["ja503:9"],["ja503:9"],["ja503:9"],["ja503:9"],["ja503:11"],["ja503:11"]]},{"para":4486,"vripara":null,"refs":["ja503:11"],"lines":["Evaṃ tassa viravitvā aparāparaṃ dhāvantasseva rājā isīnaṃ assamaṃ patto.","Tasmiṃ khaṇe isayo phalāphalatthāya gatā.","Eko pupphakasuvova assamapade ṭhito hoti.","So rājānaṃ disvā paccuggamanaṃ katvā paṭisanthāramakāsi.","Tamatthaṃ pakāsento satthā catasso gāthā abhāsi – 170."],"lineRefs":[["ja503:11"],["ja503:11"],["ja503:11"],["ja503:11"],["ja503:11"]]},{"para":4488,"vripara":"170","refs":["ja503:11"],"lines":["“Athāparo paṭinandittha, suvo lohitatuṇḍako;"],"lineRefs":[["ja503:11"]]},{"para":4489,"vripara":null,"refs":["ja503:11"],"lines":["Svāgataṃ te mahārāja, atho te adurāgataṃ;"],"lineRefs":[["ja503:11"]]},{"para":4490,"vripara":null,"refs":["ja503:11"],"lines":["Issarosi anuppatto, yaṃ idhatthi pavedaya. 171."],"lineRefs":[["ja503:11"]]},{"para":4492,"vripara":"171","refs":["ja503:11"],"lines":["“Tiṇḍukāni piyālāni, madhuke kāsumāriyo;"],"lineRefs":[["ja503:11"]]},{"para":4493,"vripara":null,"refs":["ja503:11"],"lines":["Phalāni khuddakappāni, bhuñja rāja varaṃ varaṃ. 172."],"lineRefs":[["ja503:11"]]},{"para":4495,"vripara":"172","refs":["ja503:11"],"lines":["“Idampi pānīyaṃ sītaṃ, ābhataṃ girigabbharā;"],"lineRefs":[["ja503:11"]]},{"para":4496,"vripara":null,"refs":["ja503:11"],"lines":["Tato piva mahārāja, sace tvaṃ abhikaṅkhasi. 173."],"lineRefs":[["ja503:11"]]},{"para":4498,"vripara":"173","refs":["ja503:11"],"lines":["“Araññaṃ uñchāya gatā, ye asmiṃ paricārakā;"],"lineRefs":[["ja503:11"]]},{"para":4499,"vripara":null,"refs":["ja503:11"],"lines":["Sayaṃ uṭṭhāya gaṇhavho, hatthā me natthi dātave”ti."],"lineRefs":[["ja503:11"]]},{"para":4500,"vripara":null,"refs":["ja503:11","ja503:15"],"lines":["Tattha <b>paṭinanditthā</b>ti rājānaṃ disvāva tussi.","<b>Lohitatuṇḍako</b>ti rattatuṇḍo sobhaggappatto.","<b>Madhuke</b>ti madhukaphalāni.","<b>Kāsumāriyo</b>ti evaṃnāmakāni phalāni, kāraphalāni vā.","<b>Tato pivā</b>ti tato pānīyamāḷato gahetvā pānīyaṃ piva.","<b>Ye asmiṃ paricārakā</b>ti mahārāja, ye imasmiṃ assame vicaraṇakā isayo, te araññaṃ uñchāya gatā.","<b>Gaṇhavho</b>ti phalāphalāni gaṇhatha.","<b>Dātave</b>ti dātuṃ."],"lineRefs":[["ja503:11"],["ja503:11"],["ja503:11"],["ja503:11"],["ja503:11"],["ja503:15"],["ja503:15"],["ja503:15"]]},{"para":4501,"vripara":null,"refs":["ja503:15"],"lines":["Rājā tassa paṭisanthāre pasīditvā gāthādvayamāha – 174."],"lineRefs":[["ja503:15"]]},{"para":4503,"vripara":"174","refs":["ja503:15"],"lines":["“Bhaddako vatayaṃ pakkhī, dijo paramadhammiko;"],"lineRefs":[["ja503:15"]]},{"para":4504,"vripara":null,"refs":["ja503:15"],"lines":["Atheso itaro pakkhī, suvo luddāni bhāsati. 175."],"lineRefs":[["ja503:15"]]},{"para":4506,"vripara":"175","refs":["ja503:15"],"lines":["“‘Etaṃ hanatha bandhatha, mā vo muñcittha jīvataṃ’;"],"lineRefs":[["ja503:15"]]},{"para":4507,"vripara":null,"refs":["ja503:15"],"lines":["Iccevaṃ vilapantassa, sotthiṃ pattosmi assama”nti."],"lineRefs":[["ja503:15"]]},{"para":4508,"vripara":null,"refs":["ja503:15","ja503:17"],"lines":["Tattha <b>itaro</b>ti corakuṭiyaṃ suvako.","<b>Icceva</b>nti ahaṃ pana tassa evaṃ vilapantasseva imaṃ assamaṃ sotthinā patto."],"lineRefs":[["ja503:15"],["ja503:17"]]},{"para":4509,"vripara":null,"refs":["ja503:17"],"lines":["Rañño kathaṃ sutvā pupphako dve gāthā abhāsi – 176."],"lineRefs":[["ja503:17"]]},{"para":4511,"vripara":"176","refs":["ja503:17"],"lines":["“Bhātarosma mahārāja, sodariyā ekamātukā;"],"lineRefs":[["ja503:17"]]},{"para":4512,"vripara":null,"refs":["ja503:17"],"lines":["Ekarukkhasmiṃ saṃvaḍḍhā, nānākhettagatā ubho. 177."],"lineRefs":[["ja503:17"]]},{"para":4514,"vripara":"177","refs":["ja503:17"],"lines":["“Sattigumbo ca corānaṃ, ahañca isinaṃ idha;"],"lineRefs":[["ja503:17"]]},{"para":4515,"vripara":null,"refs":["ja503:17"],"lines":["Asataṃ so, sataṃ ahaṃ, tena dhammena no vinā”ti."],"lineRefs":[["ja503:17"]]},{"para":4516,"vripara":null,"refs":["ja503:17","ja503:19"],"lines":["Tattha <b>bhātarosmā</b>ti mahārāja, so ca ahañca ubho bhātaro homa.","<b>Corāna</b>nti so corānaṃ santike saṃvaḍḍho, ahaṃ isīnaṃ santike.","<b>Asataṃ so, sataṃ aha</b>nti so asādhūnaṃ dussīlānaṃ santikaṃ upagato, ahaṃ sādhūnaṃ sīlavantānaṃ.","<b>Tena dhammena no vinā</b>ti mahārāja, taṃ sattigumbaṃ corā coradhammena corakiriyāya vinesuṃ, maṃ isayo isidhammena isisīlācārena, tasmā sopi tena coradhammena no vinā hoti, ahampi isidhammena no vinā homīti."],"lineRefs":[["ja503:17"],["ja503:19"],["ja503:19"],["ja503:19"]]},{"para":4517,"vripara":null,"refs":["ja503:19"],"lines":["Idāni taṃ dhammaṃ vibhajanto gāthādvayamāha – 178."],"lineRefs":[["ja503:19"]]},{"para":4519,"vripara":"178","refs":["ja503:19"],"lines":["“Tattha vadho ca bandho ca, nikatī vañcanāni ca;"],"lineRefs":[["ja503:19"]]},{"para":4520,"vripara":null,"refs":["ja503:19"],"lines":["Ālopā sāhasākārā, tāni so tattha sikkhati. 179."],"lineRefs":[["ja503:19"]]},{"para":4522,"vripara":"179","refs":["ja503:19"],"lines":["“Idha saccañca dhammo ca, ahiṃsā saṃyamo damo;"],"lineRefs":[["ja503:19"]]},{"para":4523,"vripara":null,"refs":["ja503:19"],"lines":["Āsanūdakadāyīnaṃ, aṅke vaddhosmi bhāradhā”ti."],"lineRefs":[["ja503:19"]]},{"para":4524,"vripara":null,"refs":["ja503:19","ja503:21"],"lines":["Tattha <b>nikatī</b>ti patirūpakena vañcanā.","<b>Vañcanānī</b>ti ujukavañcanāneva.","<b>Ālopā</b>ti divā gāmaghātā.","<b>Sāhasākārā</b>ti gehaṃ pavisitvā maraṇena tajjetvā sāhasikakammakaraṇāni.","<b>Sacca</b>nti sabhāvo.","<b>Dhammo</b>ti sucaritadhammo.","<b>Ahiṃsā</b>ti mettāpubbabhāgo.","<b>Saṃyamo</b>ti sīlasaṃyamo.","<b>Damo</b>ti indriyadamanaṃ.","<b>Āsanūdakadāyīna</b>nti abbhāgatānaṃ āsanañca udakañca dānasīlānaṃ.","<b>Bhāradhā</b>ti rājānaṃ ālapati."],"lineRefs":[["ja503:19"],["ja503:19"],["ja503:19"],["ja503:19"],["ja503:21"],["ja503:21"],["ja503:21"],["ja503:21"],["ja503:21"],["ja503:21"],["ja503:21"]]},{"para":4525,"vripara":null,"refs":["ja503:21"],"lines":["Idāni rañño dhammaṃ desento imā gāthā abhāsi – 180."],"lineRefs":[["ja503:21"]]},{"para":4527,"vripara":"180","refs":["ja503:21"],"lines":["“Yaṃ yañhi rāja bhajati, santaṃ vā yadi vā asaṃ;"],"lineRefs":[["ja503:21"]]},{"para":4528,"vripara":null,"refs":["ja503:21"],"lines":["Sīlavantaṃ visīlaṃ vā, vasaṃ tasseva gacchati. 181."],"lineRefs":[["ja503:21"]]},{"para":4530,"vripara":"181","refs":["ja503:21"],"lines":["“Yādisaṃ kurute mittaṃ, yādisaṃ cūpasevati;"],"lineRefs":[["ja503:21"]]},{"para":4531,"vripara":null,"refs":["ja503:21"],"lines":["Sopi tādisako hoti, sahavāso hi tādiso. 182."],"lineRefs":[["ja503:21"]]},{"para":4533,"vripara":"182","refs":["ja503:21"],"lines":["“Sevamāno sevamānaṃ, samphuṭṭho samphusaṃ paraṃ;"],"lineRefs":[["ja503:21"]]},{"para":4534,"vripara":null,"refs":["ja503:21"],"lines":["Saro diddho kalāpaṃva, alittamupalimpati;"],"lineRefs":[["ja503:21"]]},{"para":4535,"vripara":null,"refs":["ja503:21"],"lines":["Upalepabhayā dhīro, neva pāpasakhā siyā. 183."],"lineRefs":[["ja503:21"]]},{"para":4537,"vripara":"183","refs":["ja503:21"],"lines":["“Pūtimacchaṃ kusaggena, yo naro upanayhati;"],"lineRefs":[["ja503:21"]]},{"para":4538,"vripara":null,"refs":["ja503:21"],"lines":["Kusāpi pūti vāyanti, evaṃ bālūpasevanā. 184."],"lineRefs":[["ja503:21"]]},{"para":4540,"vripara":"184","refs":["ja503:21"],"lines":["“Tagarañca palāsena, yo naro upanayhati;"],"lineRefs":[["ja503:21"]]},{"para":4541,"vripara":null,"refs":["ja503:21"],"lines":["Pattāpi surabhi vāyanti, evaṃ dhīrūpasevanā. 185."],"lineRefs":[["ja503:21"]]},{"para":4543,"vripara":"185","refs":["ja503:21"],"lines":["“Tasmā pattapuṭasseva, ñatvā sampākamattano;"],"lineRefs":[["ja503:21"]]},{"para":4544,"vripara":null,"refs":["ja503:21"],"lines":["Asante nopaseveyya, sante seveyya paṇḍito;"],"lineRefs":[["ja503:21"]]},{"para":4545,"vripara":null,"refs":["ja503:21"],"lines":["Asanto nirayaṃ nenti, santo pāpenti suggati”nti."],"lineRefs":[["ja503:21"]]},{"para":4546,"vripara":null,"refs":["ja503:21","ja503:27"],"lines":["Tattha <b>santaṃ vā yadi vā asa</b>nti sappurisaṃ vā asappurisaṃ vā.","<b>Sevamāno sevamāna</b>nti seviyamāno ācariyo sevamānaṃ antevāsikaṃ.","<b>Samphuṭṭho</b>ti antevāsinā vā phuṭṭho ācariyo.","<b>Samphusaṃ para</b>nti paraṃ ācariyaṃ samphusanto antevāsī vā.","<b>Alitta</b>nti taṃ antevāsikaṃ pāpadhammena alittaṃ so ācariyo visadiddho saro sesaṃ sarakalāpaṃ viya limpati.","<b>Evaṃ bālūpasevanā</b>ti bālūpasevī hi pūtimacchaṃ upanayhanakusaggaṃ viya hoti, pāpakammaṃ akarontopi avaṇṇaṃ akittiṃ labhati.","<b>Dhīrūpasevanā</b>ti dhīrūpasevī puggalo tagarādigandhajātipaliveṭhanapattaṃ viya hoti, paṇḍito bhavituṃ asakkontopi kalyāṇamittasevī guṇakittiṃ labhati.","<b>Pattapuṭassevā</b>ti duggandhasugandhapaliveṭhanapaṇṇasseva.","<b>Sampākamattano</b>ti kalyāṇamittasaṃsaggavasena attano paripākaṃ paribhāvanaṃ ñatvāti attho.","<b>Pāpenti suggati</b>nti santo sammādiṭṭhikā attānaṃ nissite satte saggameva pāpentīti desanaṃ yathānusandhimeva pāpesi."],"lineRefs":[["ja503:21"],["ja503:21"],["ja503:21"],["ja503:21"],["ja503:21"],["ja503:21"],["ja503:21"],["ja503:27"],["ja503:27"],["ja503:27"]]}],"wordLinks":[["ja503:5.1","nisīthepi rahodānī",0,9],["ja503:5.3","hantvānā",0,11],["ja503:7.1","atha tvaṃ",7,0],["ja503:7.1","matto",7,1],["ja503:7.3","mātarī",7,2],["ja503:7.3","vijigucchase",7,4],["ja503:9.1","balavāhano",14,0],["ja503:9.3","adhitiṭṭhā",14,1],["ja503:11.1","kodaṇḍakānī",20,4],["ja503:11.3","jīvataṃ",20,5],["ja503:15.1","ye asmiṃ paricārakā",31,5],["ja503:15.3","gaṇhavho",31,6],["ja503:15.3","dātave",31,7],["ja503:17.3","iccevaṃ",37,1],["ja503:19.1","corānaṃ",43,1],["ja503:19.3","asataṃ so sataṃ ahaṃ",43,2],["ja503:19.3","tena dhammena no vinā",43,3],["ja503:21.1","saccaṃ",49,4],["ja503:21.1","dhammo",49,5],["ja503:21.1","ahiṃsā",49,6],["ja503:21.1","saṃyamo",49,7],["ja503:21.1","damo",49,8],["ja503:21.3","āsanūdakadāyīnaṃ",49,9],["ja503:21.3","bhāradhā",49,10],["ja503:27.1","pattapuṭassevā",65,7],["ja503:27.1","sampākamattano",65,8],["ja503:27.5","pāpenti suggatiṃ",65,9]],"after":[{"para":4547,"vripara":null,"title":"[503] 7. Sattigumbajātakavaṇṇanā","lines":["Rājā tassa dhammakathāya pasīdi, isigaṇopi āgato.","Rājā isayo vanditvā “bhante, maṃ anukampamānā mama vasanaṭṭhāne vasathā”ti vatvā tesaṃ paṭiññaṃ gahetvā nagaraṃ gantvā suvānaṃ abhayaṃ adāsi.","Isayopi tattha agamaṃsu.","Rājā isigaṇaṃ uyyāne vasāpento yāvajīvaṃ upaṭṭhahitvā saggapuraṃ pūresi.","Athassa puttopi chattaṃ ussāpento isigaṇaṃ paṭijaggiyevāti tasmiṃ kulaparivaṭṭe satta rājāno isigaṇassa dānaṃ pavattayiṃsu.","Mahāsatto araññe vasantoyeva yathākammaṃ gato."]},{"para":4548,"vripara":null,"title":"[503] 7. Sattigumbajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā “evaṃ, bhikkhave, pubbepi devadatto pāpo pāpaparivāroyevā”ti vatvā jātakaṃ samodhānesi –","“tadā sattigumbo devadatto ahosi, corā devadattaparisā, rājā ānando, isigaṇā buddhaparisā, pupphakasuvo pana ahameva ahosi”nti."]},{"para":4549,"vripara":null,"title":"[503] 7. Sattigumbajātakavaṇṇanā","lines":["Sattigumbajātakavaṇṇanā sattamā. [504] 8."]},{"para":4551,"vripara":null,"title":"[504] 8. Bhallātiyajātakavaṇṇanā","lines":["Bhallātiyajātakavaṇṇanā"]},{"para":4552,"vripara":null,"title":"[504] 8. Bhallātiyajātakavaṇṇanā","lines":["<b>Bhallātiyo</b> <b>nāma ahosi rājā</b>ti idaṃ satthā jetavane viharanto mallikaṃ deviṃ ārabbha kathesi.","Tassā kira ekadivasaṃ raññā saddhiṃ sayanaṃ nissāya kalaho ahosi.","Rājā kujjhitvā naṃ na olokesi.","Sā cintesi “nanu tathāgato rañño mayi kuddhabhāvaṃ na jānātī”ti.","Satthā taṃ kāraṇaṃ ñatvā punadivase bhikkhusaṅghaparivuto sāvatthiṃ piṇḍāya pavisitvā rañño gehadvāraṃ gato.","Rājā paccuggantvā pattaṃ gahetvā satthāraṃ pāsādaṃ āropetvā paṭipāṭiyā bhikkhusaṅghaṃ nisīdāpetvā dakkhiṇodakaṃ datvā paṇītenāhārena parivisitvā bhattakiccāvasāne ekamantaṃ nisīdi.","Satthā “kiṃ nu kho, mahārāja, mallikā na paññāyatī”ti pucchitvā “attano sukhamadamattatāyā”ti vutte “nanu, mahārāja, tvaṃ pubbe kinnarayoniyaṃ nibbattitvā ekarattiṃ kinnariyā vinā hutvā satta vassasatāni paridevamāno vicarī”ti vatvā tena yācito atītaṃ āhari."]},{"para":4553,"vripara":null,"title":"[504] 8. Bhallātiyajātakavaṇṇanā","lines":["Atīte bārāṇasiyaṃ bhallātiyo nāma rājā rajjaṃ kārento “aṅgārapakkamigamaṃsaṃ khādissāmī”ti rajjaṃ amaccānaṃ niyyādetvā sannaddhapañcāvudho susikkhitakoleyyakasuṇakhagaṇaparivuto nagarā nikkhamitvā himavantaṃ pavisitvā anugaṅgaṃ gantvā upari abhiruhituṃ asakkonto ekaṃ gaṅgaṃ otiṇṇanadiṃ disvā tadanusārena gacchanto migasūkarādayo vadhitvā aṅgārapakkamaṃsaṃ khādanto uccaṭṭhānaṃ abhiruhi.","Tattha ramaṇīyā nadikā paripuṇṇakāle thanapamāṇodakā hutvā sandati, aññadā jaṇṇukapamāṇodakā hoti.","Tattha nānappakārakā macchakacchapā vicaranti.","Udakapariyante rajatapaṭṭavaṇṇavālukā ubhosu tīresu nānāpupphaphalabharitavinamitā rukkhā pupphaphalarasamattehi nānāvihaṅgamabhamaragaṇehi samparikiṇṇā vividhamigasaṅghanisevitā sītacchāyā.","Evaṃ ramaṇīyāya hemavatanadiyā tīre dve kinnarā aññamaññaṃ āliṅgitvā paricumbitvā nānappakārehi paridevantā rodanti."]},{"para":4554,"vripara":null,"title":"[504] 8. Bhallātiyajātakavaṇṇanā","lines":["Rājā tassā nadiyā tīrena gandhamādanaṃ abhiruhanto te kinnare disvā “kiṃ nu kho ete evaṃ paridevanti, pucchissāmi ne”ti cintetvā sunakhe oloketvā accharaṃ pahari.","Susikkhitakoleyyakasunakhā tāya saññāya gumbaṃ pavisitvā urena nipajjiṃsu.","So tesaṃ paṭisallīnabhāvaṃ ñatvā dhanukalāpañceva sesāvudhāni ca rukkhaṃ nissāya ṭhapetvā padasaddaṃ akaronto saṇikaṃ tesaṃ santikaṃ gantvā “kiṃkāraṇā tumhe rodathā”ti kinnare pucchi.","Tamatthaṃ pakāsento satthā tisso gāthā abhāsi – 186."]},{"para":4556,"vripara":"186","title":"[504] 8. Bhallātiyajātakavaṇṇanā","lines":["“Bhallātiyo nāma ahosi rājā, raṭṭhaṃ pahāya migavaṃ acāri so;"]},{"para":4557,"vripara":null,"title":"[504] 8. Bhallātiyajātakavaṇṇanā","lines":["Agamā girivaraṃ gandhamādanaṃ, supupphitaṃ kimpurisānuciṇṇaṃ. 187."]},{"para":4559,"vripara":"187","title":"[504] 8. Bhallātiyajātakavaṇṇanā","lines":["“Sāḷūrasaṅghañca nisedhayitvā, dhanuṃ kalāpañca so nikkhipitvā;"]},{"para":4560,"vripara":null,"title":"[504] 8. Bhallātiyajātakavaṇṇanā","lines":["Upāgami vacanaṃ vattukāmo, yatthaṭṭhitā kimpurisā ahesuṃ. 188."]},{"para":4562,"vripara":"188","title":"[504] 8. Bhallātiyajātakavaṇṇanā","lines":["“Himaccaye hemavatāya tīre, kimidhaṭṭhitā mantayavho abhiṇhaṃ;"]},{"para":4563,"vripara":null,"title":"[504] 8. Bhallātiyajātakavaṇṇanā","lines":["Pucchāmi vo mānusadehavaṇṇe, kathaṃ vo jānanti manussaloke”ti."]}]},"tika":{"book":"Ja-ṭ-iii","bookName":"Jātaka-abhinavaṭīkā-3","vriCode":"","from":656,"to":667,"paras":[{"para":656,"vripara":null,"refs":["ja503:1"],"lines":["7-sattigumbajātakavaṇṇanā (503)"],"lineRefs":[["ja503:1"]]},{"para":657,"vripara":null,"refs":["ja503:1"],"lines":["<b>maddakucchismi</b>nti evaṃ nāmake uyyāne.","taṃ hi ajātasattumhi kucchigate tassa mātarā ayaṃ mayhaṃ kucchigato gabbho rañño sattu bhavissatīti imināti gabbhapātanatthaṃ kucchi maddāpitā.","tasmā maddakucchīti saṅkhaṃ gataṃ.","migānaṃ pana abhayavāsatthāya dinnattā migadāyoti vuccati.","<b>paviṭṭhāyā</b>ti [paviddhāya. chaṭṭha.] pavaṭṭitāya.","<b>sakkhalikāyā</b>ti [sakalikāya. chaṭṭha.] silākhaṇḍena.","<b>khitte</b>ti [khate. chaṭṭha.] ghaṃsite.","<b>mañcasivikāyā</b>ti mañcameva sivikaṃ viya katā.","tāya sivikāya.","<b>araññāyatane</b>ti araññabhūte āyatane.","padeseti attho.","<b>sānupabbate</b>ti mahantassa pabbatassa sānubhūte samatala-padese.","<b>uparivāte</b>ti dakkhiṇapasse.","<b>adhovāte</b>ti uttarapasse.","tañca yebhuyyena kakkhaḷassa vātassa āgamanavasena paricchinditvā vuttaṃ.","dakkhiṇatoyeva hi kakkhaḷo vāto cirakālaṃ vāyatīti.","kāla-niyamavasena pana dakkhiṇato chamāse vāto vāyati.","tathā uttara-toti aṭṭhakathāsu vuttaṃ.","<b>pakkhanikkhamanakāle</b>ti pakkhilomānaṃ nikkhamanakāle.","<b>vātamaṇḍalikā</b>ti āvaṭṭe udakaṃ viya vāto pari-maṇḍalo viya hutvā uṭṭhahi.","sā vātamaṇḍalikāti vuccati.","<b>udapādī</b>ti vuṭṭhati.","<b>āvudhantare</b>ti sattinaṃ antare."],"lineRefs":[["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"]]},{"para":658,"vripara":null,"refs":["ja503:1"],"lines":["<b>upagumbavana</b>nti gumbassa samīpe pavattatīti upagumbaṃ.","vanaṃ.","upagumbañca taṃ vanañcāti upagumbavanaṃ.","upavanantipi pāṭho.","<b>paṭicchādetvā dinne potthake [koṭṭhake. chaṭṭha.] </b>ti rājapurisehi gumbena paṭicchādetvā ṭhapite veḷuvatthādimaye potthake.","<b>eṇimigo</b>ti iṇati javena gacchatīti eṇī.","soyeva migo eṇimigo.","<b>vivittata</b>nti parivāretvā ṭhitānaṃ manussānaṃ viraḷabhāvaṃ disvā.","<b>palāyi-to</b>ti palāto.","gatoti attho.","<b>asmimānenā</b>ti seṭṭhoha-masmiti evaṃ unnatena mānena.","<b>paṭipajjī</b>ti paṭigacchi.","anubandhīti attho.","<b>sārathinā dutiyo</b>ti [sārathidutiyo. chaṭṭha.] sārathinā saddhiṃ dutiyo hutvā.","athavā sārathinā upalakkhito dutiyo hutvāti attho.","<b>uttarattharaṇa</b>nti mañcādīnaṃ upari attharitabbavatthaṃ.","<b>sambāhanto</b>ti parimajjanto.","bāha-parimajjaneti hi dhātu.","<b>antarantarā niddāyati ceva pabujjhaticā</b>ti iminā tadā rañño kapiniddāya niddokkamanataṃ dasseti."],"lineRefs":[["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"]]},{"para":659,"vripara":null,"refs":["ja503:1"],"lines":["<b>ārakkhaṇatthāyā</b>ti araññe paviṭṭhānaṃ manussānaṃ vilumpanatthāyāti attho.","<b>bhattarandhako</b>ti bhattapāko.","randha-pāketi hi dantajacatutthakkharantadhātu.","<b>dveva ohīyiṃsū</b>ti dveyeva janā ohīyiṃsu avasesayiṃsu.","idañca purise sandhāya vuttaṃ.","tesaṃ pana bhariyā tadā tattha bahū atthiyeva.","tena vakkhati “<b>mātarā</b>ti [mātarīti. chaṭṭha.] corajeṭṭhakassa bhariyaṃ sandhāyāhā”ti ādi.","gragasaghano<b>ti [ogaṇo. chaṭṭha.] ghanato avahīnoti oghanoti samāso.","</b>takkarāna<b>nti corānaṃ.","taṃ vuccati corakammaṃ.","taṃ karontīti takkarā.","ta-saddo hi core corakamme vā vaṭṭati.","</b>rattena uṇhīsavattenā<b>ti rattavaṇṇena suvaṇṇamayaüṇhisapattena sampannāgato.","</b>sampatike<b>ti ettha sampatīti idānīti padassa atthe nipāto.","sakatthe pana kapaccayavasena sampatikoti vuccati.","tenāha “sampatiketi sampati idānī”tiādi.","</b>nisidhe<b>ti addharatte.","sā hi nisāya sidhati patiṭṭhatīti nisidhoti vuccati.","sidha-saṃsijjhaneti dantajacatutthakkharantadhātussa atthātissayayogato patiṭṭhānatthatā veditabbā.","nisate sayate asminti nisidhotipi vadanti.","</b>nisidhepi idāni raho**ti nisidhepi raho.","idānipi rahoyeva.","manussehi asaṃkiṇṇattāti attho.","tenāha “idaṃ vadatī”tiādi.","ayampanettha sambandho.","yathā nisidhe addharatte samaye manussā kilamantā sayanti.","teneva so addharattasamayo raho nāma hoti.","tatheva idāni niṭṭhitamajjantike kāleti idaṃ vadatīti sambandho."],"lineRefs":[["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"]]},{"para":660,"vripara":null,"refs":["ja503:1"],"lines":["pāḷiyaṃ <b>durāsadā</b>ti duāsadā upasaṅkamituṃ dukkarāti attho.","<b>atha tva</b>nti ettha athasaddo pucchanatthe nipāto.","tenāha “nanu tva”nti.","<b>mahāgajjitānī</b>ti iminā thulānīti padassa atthaṃ dasseti.","mātarāti anādaratthe karaṇavacanaṃ.","tenāha “mama mātari naggāyā”ti.","mama mātari naggāya nivatthāya satīti attho.","<b>manussabhāsāyā</b>ti ettha yaṃ vattabbaṃ.","taṃ heṭṭhā tattha tattha vuttanayena veditabbaṃ.","<b>adhitiṭṭhā</b>ti ettha adhi-saddassa ānubhāvena ṭhāsaddo idha abhirūhanatthoti āha “adhi-tiṭṭhāti abhiruyhā [abhiruha. chaṭṭha.] ”ti.","<b>ko nu me</b>ti ettha koti bhūmatthe.","tattha vuttanayena veditabbaṃ.","<b>paricārakā</b>ti ettha cārakāti avacārakā.","parisaddo hettha avasaddattho.","heṭṭhā cārakā corāti attho.","tenāha “paricārakāti corā”ti.","<b>adassanā</b>ti karaṇatthe nisakka-vacananti āha “etesaṃ corānaṃ adassanena mutto esa gacchatī”ti.","athavā upayogatthe karaṇavacanaṃ.","tenāha “etesa”nti ādi.","<b>kodaṇḍakānī</b>ti kucchito daṇḍo yesanti kodaṇḍakā.","dhanūti āha “kodaṇḍakānīti dhanūnī”ti.","<b>mā muyhitthā</b>ti idaṃ vacanaṃ vippallāsa-nayena vuttaṃ.","tenāha “mā muyhī”ti."],"lineRefs":[["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"]]},{"para":661,"vripara":null,"refs":["ja503:1"],"lines":["<b>paṭinanditthā</b>ti ettha vuttanayo ca veditabbo.","<b>madhuddumaphalānī</b>ti [madhukaphalāni. chaṭṭha.] madhuddumaphalāni.","yesaṃ hi bijāni udukkhale mantetvā telaṃ gaṇhanti.","<b>kāsumāriyoti evaṃnāmakānī</b>ti sādhakaṇṭakaphalāni tesaṃ tikhiṇāni kaṇṭakāni honti.","marammabhāsāya <b>mananrvaiḥ </b>iti vucccanti.","<b>kāra-phalāni vā</b>ti kāro nāma ekā rukkhajāti.","marammabhāsāya <b>kaṃpyañḥ</b> iti vuccati."],"lineRefs":[["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"]]},{"para":662,"vripara":null,"refs":["ja503:1"],"lines":["pāḷiyaṃ <b>khuddakappānī</b>ti madhusadisāni.","<b>varāvara</b>nti [varaṃ varaṃ. chaṭṭha.] varato varaṃ.","ativaranti vuttaṃ hoti.","vakkhati ca sattatinipāte soṇanandajātaka-saṃvaṇṇanāyaṃ <b>”khuddakappānī</b>ti etāni nānārukkhaphalāni khuddakamadhupaṭibhāgāni madhurāni.","<b>varāvara</b>nti ito varaṃ uttamaṃ bhuñjā”ti.","katthaci hi khādaniyepi bhuñjanavohāro dissatevāti daṭṭhabbaṃ.","<b>sotthinā patto</b>ti iminā sotthipattoti padassa sotthinā patto sotthipattoti nibbacanaṃ dasseti."],"lineRefs":[["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"]]},{"para":663,"vripara":null,"refs":["ja503:1"],"lines":["pāḷiyaṃ <b>tena dhammenā</b>ti tena sabhāvenāti attho.","tenāha “corā coradhammenā”tiādi.","<b>no vinā</b>ti vinā saddena samānattho eko nipāto.","nānā visadisāti attho.","<b>paṭirūpakenā</b>ti sadisena vañcanā.","lohakuṭādayo hi suvaṇṇādayo viya katvā vañcanāti vuttaṃ hoti.","<b>ujukavañcanānevā</b>ti tathā akatvā vañcanāneva.","<b>divā gāmaghāṭo</b>ti [gāmaghātā. chaṭṭha.] ettha divāti idaṃ sahassakāravasena viluppanataṃ vibhāvetuṃ vuttaṃ.","<b>mettāpubbabhāgo</b>ti appanā mettāya pubbabhāgo.","<b>abbhāgatāna</b>nti abhimukhaṃ āgatānaṃ.","āgantukānanti attho.","<b>santaṃ vā yadi vā asa</b>nti ettha yadisaddo nipātamatto.","yadi vā saddo vā samuccayatthe eko nipāto.","asanti santasaddassa antabhūtassa ntakārassa akārādeso hoti.","so ca paṇṇattivisaye vāti daṭṭhabbaṃ.","<b>seviyamāno</b>ti sevitabbo.","<b>sevamāna</b>nti sevantaṃ.","<b>phuṭṭho</b>ti saṃphuṭṭho sajitabbo.","paraṃ ācariyaṃ saṃphusanto antevāsī vā kattu-bhūto."],"lineRefs":[["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"]]},{"para":664,"vripara":null,"refs":["ja503:1"],"lines":["ayampanettha pāḷi yojanā.","sevamāno ācariyo sevamānaṃ antevāsikaṃ pāpadhammena upalimpati.","saṃphuṭṭho ācariyo paraṃ antevāsikaṃ upalimpati.","saṃphusanto antevāsiko paraṃ ācariyaṃ upalimpatīti.","saṃphuṭṭho saṃphuṭṭhaṃ parantipi katthaci pāḷipotthakesu pāṭho dissati.","<b>taṃ antevāsika</b>nti ettha taṃ ācariyantipi attho veditabboyeva.","paṭṭhānanayena hetaṃ vuttaṃ.","<b>so ācariyo</b>ti etthāpi so antevāsikotipi attho veditabbo.","paṭṭhānanayeneva hetaṃ vuttaṃ.","<b>duṭṭho</b>ti ettha visalimpanena duṭṭho.","na hatthakammādināti āha “visa-duṭṭho”ti.","<b>sesa</b>nti attanā sesaṃ.","<b>sarakalāpaṃ viyā</b>ti sarānaṃ adhiṭṭhānabhūtaṃ veḷukalāpaṃ viya.","athavā kalāpasaddo samūhattho.","attanā sesaṃ sarasamūhaṃ viyāti attho.","<b>limpatī</b>ti visesena limpati."],"lineRefs":[["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"]]},{"para":665,"vripara":null,"refs":["ja503:1"],"lines":["pāḷiyaṃ <b>upalittabhayā</b>ti upalimpanabhayenāti attho.","<b>kusaggenā</b>ti kusatiṇānaṃ aggabhūtena pattena.","<b>upanayhatī</b>ti bandhati.","<b>pūti vāyantī</b>ti pūtigandhaṃ vāyanti.","muñcantīti vuttaṃ hoti.","<b>pūti macchaṃ upanayhanakusaggaṃ viya hotī</b>ti pūti macchaṃ bandhanakusaggatiṇaṃ viya hoti.","<b>kusagga</b>nti ca tiṇasaddāpekkhatāya napuṃsakaniddeso.","<b>pāpakammaṃ akaronto pī</b>ti bālūpasevanapaccayā pāpakammaṃ akarontopi avaṇṇaṃ akittiṃ labhatiyevāti attho.","pāḷiyaṃ <b>taggarañcā</b>ti idaṃ upalakkhaṇa-vasena vuttaṃ.","<b>palāsenā</b>ti kiṃsukāpattena.","tenāha “tagarādigandhajātipaliveṭhanapattaṃ viya hotī”ti.","<b>paṇḍito bhavituṃ asakke-ntopī</b>ti dhīrūpasevanapaccayā bhavituṃ asakkontopi kalyāṇamittasevī guṇaṃ kittiṃ labhati.","<b>palapuṭassevā</b>ti ettha palasaddo palāsasaddena samānattho.","tenāha “gandhapaliveṭhanapaṇṇassevā”ti.","<b>paripākabhāva</b>nti ñāṇassa paripākabhāvaṃ.","paripākabhāvo ca vaddhanasabhāvo tikkhasabhāvo-yevāti."],"lineRefs":[["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"]]},{"para":666,"vripara":null,"refs":["ja503:1"],"lines":["pāḷiyaṃ <b>asanto nirayaṃ yantī</b>ti [nenti. chaṭṭha.] asanto micchādiṭṭhikā attānaṃ nissite nirayādiduggatiṃyeva pāpenti.","na sugatinti attho.","nirayanti hi upalakkhaṇavasena vuttaṃ.","teneva sakalāpi duggati gahetabbā.","<b>ya</b>ntīti ettha kāritalopo daṭṭhabbo.","<b>sugati</b>nti etthāpi esevanayo.","aṭṭhakathāyampi upalakkhaṇavaseneva saggameva pāpentīti vuttaṃ.","evasaddena pana duggati nivatteti.","<b>desanaṃ yathānusandhimeva pāpesī</b>ti “yaṃ yaṃ hi rāja bhajatīti ādinā desitaṃ desanaṃ “bhaddakovata'yaṃ pakkhī”ti ādinā anusandhiyā anurūpameva pāpeti niṭṭhaṃ gamāpesīti attho.","<b>kulaparivaṭṭe</b>ti rājakulaparivaṭṭeti."],"lineRefs":[["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"],["ja503:1"]]},{"para":667,"vripara":null,"refs":["ja503:1"],"lines":["sattigumbajātakaṃ."],"lineRefs":[["ja503:1"]]}],"wordLinks":[]},"tika2":null}
