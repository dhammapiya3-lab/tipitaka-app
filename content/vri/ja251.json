{"suttaId":"ja251","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1745,1754],"vripara":"1"},"segments":{"ja251:0.4":"Saṅkapparāgajātakaṃ (3-1-1)","ja251:1.1":"Saṅkapparāgadhotena, vitakkanisitena ca;","ja251:1.3":"Nālaṅkatena bhadrena [nevālaṅkatabhadrena (syā.)], usukārākatena ca [na usukārakatena ca (sī. syā. pī.)].","ja251:2.1":"Na kaṇṇāyatamuttena, nāpi morūpasevinā;","ja251:2.3":"Tenamhi hadaye viddho, sabbaṅgaparidāhinā.","ja251:3.1":"Āvedhañca na passāmi, yato ruhiramassave;","ja251:3.3":"Yāva ayoniso cittaṃ, sayaṃ me dukkhamābhatanti.","ja251:4.1":"Saṅkapparāgajātakaṃ paṭhamaṃ."},"attha":null,"tika":null}
