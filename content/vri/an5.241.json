{"suttaId":"an5.241","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1519,1520],"vripara":"241"},"segments":{"an5.241:0.3":"Paṭhamaduccaritasuttaṃ","an5.241:1.1":"“Pañcime, bhikkhave, ādīnavā duccarite.","an5.241:1.2":"Katame pañca?","an5.241:1.3":"Attāpi attānaṃ upavadati;","an5.241:1.4":"anuvicca viññū garahanti;","an5.241:1.5":"pāpako kittisaddo abbhuggacchati;","an5.241:1.6":"sammūḷho kālaṃ karoti;","an5.241:1.7":"kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjati.","an5.241:1.8":"Ime kho, bhikkhave, pañca ādīnavā duccarite.","an5.241:2.1":"“Pañcime, bhikkhave, ānisaṃsā sucarite.","an5.241:2.2":"Katame pañca?","an5.241:2.3":"Attāpi attānaṃ na upavadati;","an5.241:2.4":"anuvicca viññū pasaṃsanti;","an5.241:2.5":"kalyāṇo kittisaddo abbhuggacchati;","an5.241:2.6":"asammūḷho kālaṃ karoti;","an5.241:2.7":"kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati.","an5.241:2.8":"Ime kho, bhikkhave, pañca ānisaṃsā sucarite”ti.","an5.241:2.9":"Paṭhamaṃ."},"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":485,"to":486,"paras":[{"para":485,"vripara":"241","refs":["an5.241:1"],"lines":["Pañcamassa paṭhame <b>duccarite sucarite</b>ti idaṃ abhedato vuttaṃ, <b>kāyaduccarite</b>tiādi kāyadvārādīnaṃ vasena bhedato.","<b>Saddhammā</b>ti dasakusalakammapathadhammato.","<b>Asaddhamme</b>ti akusalakammapathasaṅkhāte assaddhamme."],"lineRefs":[["an5.241:1"],["an5.241:1"],["an5.241:1"]]},{"para":486,"vripara":null,"refs":["an5.241:1"],"lines":["Sivathikasuttavaṇṇanā"],"lineRefs":[["an5.241:1"]]}],"wordLinks":[]},"tika":null,"tika2":null}
