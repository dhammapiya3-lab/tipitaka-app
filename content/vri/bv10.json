{"suttaId":"bv10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[1511,1596],"vripara":"1"},"segments":{"bv10:0.2":"Padumabuddhavaṃso","bv10:1.1":"Anomadassissa aparena,","bv10:1.2":"sambuddho dvipaduttamo;","bv10:1.3":"Padumo nāma nāmena,","bv10:1.4":"asamo appaṭipuggalo.","bv10:2.1":"Tassāpi asamaṃ sīlaṃ,","bv10:2.2":"samādhipi anantako;","bv10:2.3":"Asaṅkheyyaṃ ñāṇavaraṃ,","bv10:2.4":"vimuttipi anūpamā.","bv10:3.1":"Tassāpi atulatejassa,","bv10:3.2":"dhammacakkappavattane;","bv10:3.3":"Abhisamayā tayo āsuṃ,","bv10:3.4":"mahātamapavāhanā.","bv10:4.1":"Paṭhamābhisamaye buddho,","bv10:4.2":"koṭisatamabodhayi;","bv10:4.3":"Dutiyābhisamaye dhīro,","bv10:4.4":"navutikoṭimabodhayi.","bv10:5.1":"Yadā ca padumo buddho,","bv10:5.2":"ovadī sakamatrajaṃ;","bv10:5.3":"Tadā asītikoṭīnaṃ,","bv10:5.4":"tatiyābhisamayo ahu.","bv10:6.1":"Sannipātā tayo āsuṃ,","bv10:6.2":"padumassa mahesino;","bv10:6.3":"Koṭisatasahassānaṃ,","bv10:6.4":"paṭhamo āsi samāgamo.","bv10:7.1":"Kathinatthārasamaye,","bv10:7.2":"uppanne kathinacīvare;","bv10:7.3":"Dhammasenāpatitthāya,","bv10:7.4":"bhikkhū sibbiṃsu [yāciṃsu (ka.)] cīvaraṃ.","bv10:8.1":"Tadā te vimalā bhikkhū,","bv10:8.2":"chaḷabhiññā mahiddhikā;","bv10:8.3":"Tīṇi satasahassāni,","bv10:8.4":"samiṃsu aparājitā.","bv10:9.1":"Punāparaṃ so narāsabho [naravusabho (syā. kaṃ.)],","bv10:9.2":"pavane vāsaṃ upāgami;","bv10:9.3":"Tadā samāgamo āsi,","bv10:9.4":"dvinnaṃ satasahassinaṃ.","bv10:10.1":"Ahaṃ tena samayena,","bv10:10.2":"sīho āsiṃ migādhibhū;","bv10:10.3":"Vivekamanubrūhantaṃ,","bv10:10.4":"pavane addasaṃ jinaṃ.","bv10:11.1":"Vanditvā sirasā pāde,","bv10:11.2":"katvāna taṃ padakkhiṇaṃ;","bv10:11.3":"Tikkhattuṃ abhināditvā,","bv10:11.4":"sattāhaṃ jinamupaṭṭhahaṃ.","bv10:12.1":"Sattāhaṃ varasamāpattiyā,","bv10:12.2":"vuṭṭhahitvā tathāgato;","bv10:12.3":"Manasā cintayitvāna,","bv10:12.4":"koṭibhikkhū samānayi.","bv10:13.1":"Tadāpi so mahāvīro,","bv10:13.2":"tesaṃ majjhe viyākari;","bv10:13.3":"“Aparimeyyito kappe,","bv10:13.4":"ayaṃ buddho bhavissati.","bv10:14.1":"“Padhānaṃ padahitvāna … pe …","bv10:14.3":"hessāma sammukhā imaṃ”.","bv10:15.1":"Tassāpi vacanaṃ sutvā,","bv10:15.2":"bhiyyo cittaṃ pasādayiṃ;","bv10:15.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv10:15.4":"dasapāramipūriyā.","bv10:16.1":"Campakaṃ nāma nagaraṃ,","bv10:16.2":"asamo nāma khattiyo;","bv10:16.3":"Asamā nāma janikā,","bv10:16.4":"padumassa mahesino.","bv10:17.1":"Dasavassasahassāni,","bv10:17.2":"agāraṃ ajjha so vasi;","bv10:17.3":"Nandāvasuyasuttarā,","bv10:17.4":"tayo pāsādamuttamā.","bv10:18.1":"Tettiṃsa ca sahassāni,","bv10:18.2":"nāriyo samalaṅkatā;","bv10:18.3":"Uttarā nāma sā nārī,","bv10:18.4":"rammo nāmāsi atrajo.","bv10:19.1":"Nimitte caturo disvā,","bv10:19.2":"rathayānena nikkhami;","bv10:19.3":"Anūnaaṭṭhamāsāni,","bv10:19.4":"padhānaṃ padahī jino.","bv10:20.1":"Brahmunā yācito santo,","bv10:20.2":"padumo lokanāyako;","bv10:20.3":"Vatti cakkaṃ mahāvīro,","bv10:20.4":"dhanañcuyyānamuttame.","bv10:21.1":"Sālo ca upasālo ca,","bv10:21.2":"ahesuṃ aggasāvakā;","bv10:21.3":"Varuṇo nāmupaṭṭhāko,","bv10:21.4":"padumassa mahesino.","bv10:22.1":"Rādhā ceva surādhā ca,","bv10:22.2":"ahesuṃ aggasāvikā;","bv10:22.3":"Bodhi tassa bhagavato,","bv10:22.4":"mahāsoṇoti vuccati.","bv10:23.1":"Bhiyyo ceva asamo ca,","bv10:23.2":"ahesuṃ aggupaṭṭhakā;","bv10:23.3":"Rucī ca nandarāmā ca,","bv10:23.4":"ahesuṃ aggupaṭṭhikā.","bv10:24.1":"Aṭṭhapaṇṇāsaratanaṃ,","bv10:24.2":"accuggato mahāmuni;","bv10:24.3":"Pabhā niddhāvatī tassa,","bv10:24.4":"asamā sabbaso disā.","bv10:25.1":"Candappabhā sūriyappabhā,","bv10:25.2":"ratanaggimaṇippabhā;","bv10:25.3":"Sabbāpi tā hatā honti,","bv10:25.4":"patvā jinapabhuttamaṃ.","bv10:26.1":"Vassasatasahassāni,","bv10:26.2":"āyu vijjati tāvade;","bv10:26.3":"Tāvatā tiṭṭhamāno so,","bv10:26.4":"tāresi janataṃ bahuṃ.","bv10:27.1":"Paripakkamānase satte,","bv10:27.2":"bodhayitvā asesato;","bv10:27.3":"Sesake anusāsitvā,","bv10:27.4":"nibbuto so sasāvako.","bv10:28.1":"Uragova tacaṃ jiṇṇaṃ,","bv10:28.2":"vaddhapattaṃva pādapo;","bv10:28.3":"Jahitvā sabbasaṅkhāre,","bv10:28.4":"nibbuto so yathā sikhī.","bv10:29.1":"Padumo jinavaro satthā,","bv10:29.2":"dhammārāmamhi nibbuto;","bv10:29.3":"Dhātuvitthārikaṃ āsi,","bv10:29.4":"tesu tesu padesatoti.","bv10:30.1":"Padumassa bhagavato vaṃso aṭṭhamo."},"unsure":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":2366,"to":2434,"paras":[{"para":2366,"vripara":null,"refs":["bv10:3"],"lines":["Tattha <b>asamaṃ sīlan</b>ti aññesaṃ sīlena asadisaṃ, uttamaṃ seṭṭhanti attho.","<b>Samādhipi anantako</b>ti samādhipi appameyyo, tassa anantabhāvo lokavivaraṇayamakapāṭihāriyādīsu daṭṭhabbo.","<b>Ñāṇavaran</b>ti sabbaññutaññāṇaṃ, asādhāraṇañāṇāni vā.","<b>Vimuttipī</b>ti arahattaphalavimuttipi bhagavato.","<b>Anūpamā</b>ti upamāvirahitā.","<b>Atulatejassā</b>ti atulañāṇatejassa.","“Atulañāṇatejā” tipi pāṭho.","Tassa “tayo abhisamayā”ti iminā uttarapadena sambandho daṭṭhabbo.","<b>Mahātamapavāhanā</b>ti mahāmohavināsakā, mohandhakāraviddhaṃsakāti attho."],"lineRefs":[["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"]]},{"para":2367,"vripara":null,"refs":["bv10:3"],"lines":["Athāparena samayena padumo bhagavā attano kaniṭṭhabhātaraṃ sālakumārañca upasālakumārañca ñātisamāgame saparivāre pabbājetvā tesaṃ dhammaṃ desento navuti koṭiyo dhammāmataṃ pāyesi.","Yadā pana rammattherassa dhammaṃ desesi, tadā asītikoṭīnaṃ tatiyo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv10:3"],["bv10:3"],["bv10:3"]]},{"para":2369,"vripara":"4","refs":["bv10:3"],"lines":["“Paṭhamābhisamaye buddho, koṭisatamabodhayi;"],"lineRefs":[["bv10:3"]]},{"para":2370,"vripara":null,"refs":["bv10:3"],"lines":["Dutiyābhisamaye dhīro, navutikoṭimabodhayi."],"lineRefs":[["bv10:3"]]},{"para":2372,"vripara":"5","refs":["bv10:3"],"lines":["“Yadā ca padumo buddho, ovadī sakamatrajaṃ;"],"lineRefs":[["bv10:3"]]},{"para":2373,"vripara":null,"refs":["bv10:3"],"lines":["Tadā asītikoṭīnaṃ, tatiyābhisamayo ahū”ti."],"lineRefs":[["bv10:3"]]},{"para":2374,"vripara":null,"refs":["bv10:3"],"lines":["Yadā pana subhāvitatto nāma rājā padumassa buddhassa buddhapadumavadanassa santike koṭisatasahassaparivāro ehibhikkhupabbajjāya pabbajito, tasmiṃ sannipāte bhagavā pātimokkhaṃ uddisi, so pana paṭhamo sannipāto ahosi."],"lineRefs":[["bv10:3"]]},{"para":2375,"vripara":null,"refs":["bv10:3"],"lines":["Athāparena samayena mahāpadumo munivasabho usabhasamagatī usabhavatīnagaraṃ upanissāya vassaṃ upagañchi.","Nagaravāsino manussā bhagavantaṃ dassanakāmā upasaṅkamiṃsu.","Tesaṃ bhagavā dhammaṃ desesi.","Tattha ca bahavo manussā pasannacittā pabbajiṃsu.","Tato dasabalo tehi ca aññehi ca tīhi bhikkhusatasahassehi saddhiṃ visuddhipavāraṇaṃ pavāresi.","So dutiyo sannipāto ahosi.","Ye pana tattha na pabbajiṃsu, te kathinānisaṃsaṃ sutvā pāṭipade pañcasu māsesu pañcānisaṃsadāyakaṃ kathinacīvaramadaṃsu.","Tato taṃ bhikkhū dhammasenāpatiṃ aggasāvakaṃ visālamatiṃ sālattheraṃ kathinatthāratthaṃ yācitvā kathinacīvaraṃ tassādaṃsu.","Therassa kathinacīvare kayiramāne bhikkhū sibbane sahāyakā ahesuṃ.","Padumo pana sammāsambuddho sūcicchidde suttāni āvunitvā adāsi.","Niṭṭhite pana cīvare bhagavā tīhi bhikkhusatasahassehi cārikaṃ pakkāmi."],"lineRefs":[["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"]]},{"para":2376,"vripara":null,"refs":["bv10:3"],"lines":["Athāparena samayena sīhavikkantagāmī purisasīho viya buddhasīho gosiṅgasālavanasadise paramasurabhikusumaphalabhāravinamitasākhāviṭape vimalakamalakuvalayasamalaṅkate sisiramadhuravārivāhena paripūrite ruru-camara-sīha-byaggha-aja-haya-gavaya-mahiṃsādi vividhamigagaṇavicarite surabhikusumagandhāvabaddhahadayāhi bhamaramadhukarayuvatīhi anubhūtappacārāhi samantato gumbagumbāyamāne phalarasapamuditahadayāhi kākalisadisamadhuravirutāhi kokilavadhūhi upagīyamāne paramaramaṇīye vivitte vijane yogānukūle pavane vassāvāsamupagañchi.","Tasmiṃ viharantaṃ saparivārakaṃ dasabalaṃ tathāgataṃ dhammarājaṃ buddhasiriyā virocamānaṃ disvā manussā tassa dhammaṃ sutvā pasīditvā ehibhikkhupabbajjāya pabbajiṃsu.","Tadā dvīhi bhikkhusatasahassehi parivuto pavāresi.","So tatiyo sannipāto ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"],["bv10:3"]]},{"para":2378,"vripara":"6","refs":["bv10:3"],"lines":["“Sannipātā tayo āsuṃ, padumassa mahesino;"],"lineRefs":[["bv10:3"]]},{"para":2379,"vripara":null,"refs":["bv10:3"],"lines":["Koṭisatasahassānaṃ, paṭhamo āsi samāgamo."],"lineRefs":[["bv10:3"]]},{"para":2381,"vripara":"7","refs":["bv10:3"],"lines":["“Kathinatthārasamaye, uppanne kathinacīvare;"],"lineRefs":[["bv10:3"]]},{"para":2382,"vripara":null,"refs":["bv10:3"],"lines":["Dhammasenāpatitthāya, bhikkhū sibbiṃsu cīvaraṃ."],"lineRefs":[["bv10:3"]]},{"para":2384,"vripara":"8","refs":["bv10:3"],"lines":["“Tadā te vimalā bhikkhū, chaḷabhiññā mahiddhikā;"],"lineRefs":[["bv10:3"]]},{"para":2385,"vripara":null,"refs":["bv10:3"],"lines":["Tīṇi satasahassāni, samiṃsu aparājitā."],"lineRefs":[["bv10:3"]]},{"para":2387,"vripara":"9","refs":["bv10:3"],"lines":["“Punāparaṃ so narāsabho, pavane vāsaṃ upāgami;"],"lineRefs":[["bv10:3"]]},{"para":2388,"vripara":null,"refs":["bv10:3"],"lines":["Tadā samāgamo āsi, dvinnaṃ satasahassinan”ti."],"lineRefs":[["bv10:3"]]},{"para":2389,"vripara":null,"refs":["bv10:3","bv10:9"],"lines":["Tattha <b>kathinatthārasamaye</b>ti kathinacīvarattharaṇasamaye.","<b>Dhammasenāpatitthāyā</b>ti dhammasenāpatisālattheratthaṃ.","<b>Aparājitā</b>ti na parājitā, vibhattilopo daṭṭhabbo.","<b>So</b>ti so mahāpadumo.","<b>Pavane</b>ti mahāvane.","<b>Vāsan</b>ti vassāvāsaṃ.","<b>Upāgamī</b>ti upāgato.","<b>Dvinnaṃ satasahassinan</b>ti dvinnaṃ satasahassānaṃ.","“Tadā āsi samāgamo” tipi pāṭho yadi atthi sundaro bhaveyya."],"lineRefs":[["bv10:3"],["bv10:3"],["bv10:3"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"]]},{"para":2390,"vripara":null,"refs":["bv10:9"],"lines":["Tadā tathāgate tasmiṃ vanasaṇḍe vasante amhākaṃ bodhisatto sīho hutvā sattāhaṃ nirodhasamāpattiṃ samāpajjitvā nisinnaṃ disvā pasannacitto hutvā padakkhiṇaṃ katvā sañjātapītisomanasso tikkhattuṃ sīhanādaṃ naditvā sattāhaṃ buddhārammaṇaṃ pītiṃ avijahitvā pītisukheneva gocarāya apakkamitvā jīvitapariccāgaṃ katvā payirupāsamāno aṭṭhāsi.","Atha satthā tassa sattāhassa accayena nirodhasamāpattito vuṭṭhāya narasīho sīhaṃ oloketvā –","“bhikkhusaṅghepissa cittappasādo hotūti saṅgho āgacchatū”ti cintesi.","Anekakoṭibhikkhū tāvadeva āgañchiṃsu.","Sīho saṅghepi cittaṃ pasādesi.","Atha satthā tassa cittaṃ oloketvā –","“anāgate gotamo nāma buddho bhavissatī”ti byākāsi.","Tena vuttaṃ –"],"lineRefs":[["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"]]},{"para":2392,"vripara":"10","refs":["bv10:9"],"lines":["“Ahaṃ tena samayena, sīho āsiṃ migādhibhū;"],"lineRefs":[["bv10:9"]]},{"para":2393,"vripara":null,"refs":["bv10:9"],"lines":["Pavivekamanubrūhantaṃ, pavane addasaṃ jinaṃ."],"lineRefs":[["bv10:9"]]},{"para":2395,"vripara":"11","refs":["bv10:9"],"lines":["“Vanditvā sirasā pāde, katvāna taṃ padakkhiṇaṃ;"],"lineRefs":[["bv10:9"]]},{"para":2396,"vripara":null,"refs":["bv10:9"],"lines":["Tikkhattuṃ abhināditvā, sattāhaṃ jinamupaṭṭhahaṃ."],"lineRefs":[["bv10:9"]]},{"para":2398,"vripara":"12","refs":["bv10:9"],"lines":["“Sattāhaṃ varasamāpattiyā, vuṭṭhahitvā tathāgato;"],"lineRefs":[["bv10:9"]]},{"para":2399,"vripara":null,"refs":["bv10:9"],"lines":["Manasā cintayitvāna, koṭibhikkhū samānayi."],"lineRefs":[["bv10:9"]]},{"para":2401,"vripara":"13","refs":["bv10:9"],"lines":["“Tadāpi so mahāvīro, tesaṃ majjhe viyākari;"],"lineRefs":[["bv10:9"]]},{"para":2402,"vripara":null,"refs":["bv10:9"],"lines":["Aparimeyyito kappe, ayaṃ buddho bhavissati."],"lineRefs":[["bv10:9"]]},{"para":2404,"vripara":"14","refs":["bv10:9"],"lines":["“Padhānaṃ padahitvāna … pe … hessāma sammukhā imaṃ."],"lineRefs":[["bv10:9"]]},{"para":2406,"vripara":"15","refs":["bv10:9"],"lines":["“Tassāpi vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[["bv10:9"]]},{"para":2407,"vripara":null,"refs":["bv10:9"],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā”ti."],"lineRefs":[["bv10:9"]]},{"para":2408,"vripara":null,"refs":["bv10:9"],"lines":["Tattha <b>pavivekamanubrūhantan</b>ti nirodhasamāpattiṃ samāpannanti attho.","<b>Padakkhiṇan</b>ti tikkhattuṃ padakkhiṇaṃ katvā.","<b>Abhināditvā</b>ti tikkhattuṃ sīhanādaṃ naditvā.","<b>Upaṭṭhahan</b>ti upaṭṭhahiṃ.","Ayameva vā pāṭho.","<b>Varasamāpattiyā</b>ti nirodhasamāpattito vuṭṭhahitvā.","<b>Manasā cintayitvānā</b>ti “sabbepi bhikkhū idha āgacchantū”ti manasāva cintetvā.","<b>Samānayī</b>ti samāhari."],"lineRefs":[["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"]]},{"para":2409,"vripara":null,"refs":["bv10:9"],"lines":["Tassa pana <b>padumassa bhagavato</b> campakaṃ nāma nagaraṃ ahosi.","Asamo nāma rājā pitā ahosi, mātāpi tassa asamā nāma, sālo ca upasālo ca dve aggasāvakā, varuṇo nāmupaṭṭhāko, rādhā ca surādhā ca dve aggasāvikā, mahāsoṇarukkho bodhi, aṭṭhapaṇṇāsahatthubbedhaṃ sarīraṃ, āyu vassasatasahassaṃ ahosi, rūpādīhi guṇehi anuttarā uttarā nāmassa aggamahesī, rammakumāro nāmassa atirammo tanayo ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv10:9"],["bv10:9"],["bv10:9"]]},{"para":2411,"vripara":"16","refs":["bv10:9"],"lines":["“Campakaṃ nāma nagaraṃ, asamo nāma khattiyo;"],"lineRefs":[["bv10:9"]]},{"para":2412,"vripara":null,"refs":["bv10:9"],"lines":["Asamā nāma janikā, padumassa mahesino."],"lineRefs":[["bv10:9"]]},{"para":2414,"vripara":"21","refs":["bv10:9"],"lines":["“Sālo ca upasālo ca, ahesuṃ aggasāvakā;"],"lineRefs":[["bv10:9"]]},{"para":2415,"vripara":null,"refs":["bv10:9"],"lines":["Varuṇo nāmupaṭṭhāko, padumassa mahesino."],"lineRefs":[["bv10:9"]]},{"para":2417,"vripara":"22","refs":["bv10:9"],"lines":["“Rādhā ceva surādhā ca, ahesuṃ aggasāvikā;"],"lineRefs":[["bv10:9"]]},{"para":2418,"vripara":null,"refs":["bv10:9"],"lines":["Bodhi tassa bhagavato, mahāsoṇoti vuccati."],"lineRefs":[["bv10:9"]]},{"para":2420,"vripara":"24","refs":["bv10:9"],"lines":["“Aṭṭhapaṇṇāsaratanaṃ, accuggato mahāmuni;"],"lineRefs":[["bv10:9"]]},{"para":2421,"vripara":null,"refs":["bv10:9"],"lines":["Pabhā niddhāvatī tassa, asamā sabbato disā."],"lineRefs":[["bv10:9"]]},{"para":2423,"vripara":"25","refs":["bv10:9"],"lines":["“Candappabhā sūriyappabhā, ratanaggimaṇippabhā;"],"lineRefs":[["bv10:9"]]},{"para":2424,"vripara":null,"refs":["bv10:9"],"lines":["Sabbāpi tā hatā honti, patvā jinapabhuttamaṃ."],"lineRefs":[["bv10:9"]]},{"para":2426,"vripara":"26","refs":["bv10:9"],"lines":["“Vassasatasahassāni, āyu vijjati tāvade;"],"lineRefs":[["bv10:9"]]},{"para":2427,"vripara":null,"refs":["bv10:9"],"lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[["bv10:9"]]},{"para":2429,"vripara":"27","refs":["bv10:9"],"lines":["“Paripakkamānase satte, bodhayitvā asesato;"],"lineRefs":[["bv10:9"]]},{"para":2430,"vripara":null,"refs":["bv10:9"],"lines":["Sesake anusāsitvā, nibbuto so sasāvako."],"lineRefs":[["bv10:9"]]},{"para":2432,"vripara":"28","refs":["bv10:9"],"lines":["“Uragova tacaṃ jiṇṇaṃ, vaddhapattaṃva pādapo;"],"lineRefs":[["bv10:9"]]},{"para":2433,"vripara":null,"refs":["bv10:9"],"lines":["Jahitvā sabbasaṅkhāre, nibbuto so yathā sikhī”ti."],"lineRefs":[["bv10:9"]]},{"para":2434,"vripara":null,"refs":["bv10:9","bv10:28"],"lines":["Tattha <b>ratanaggimaṇippabhā</b>ti ratanappabhā ca aggippabhā ca maṇippabhā ca.","<b>Hatā</b>ti abhibhūtā.","<b>Jinapabhuttaman</b>ti jinassa sarīrappabhaṃ uttamaṃ patvā hatāti attho.","<b>Paripakkamānase</b>ti paripakkindriye veneyyasatte.","<b>Vaddhapattan</b>ti purāṇapattaṃ.","<b>Pādapo vā</b>ti pādapo viya.","<b>Sabbasaṅkhāre</b>ti sabbepi ajjhattikabāhire saṅkhāre.","“Hitvā sabbasaṅkhāran” tipi pāṭho, soyevattho.","<b>Yathā sikhī</b>ti aggi viya nirupādāno nibbutiṃ sugato gatoti.","Sesamettha gāthāsu heṭṭhā vuttanayattā uttānamevāti."],"lineRefs":[["bv10:9"],["bv10:9"],["bv10:9"],["bv10:9"],["bv10:28"],["bv10:28"],["bv10:28"],["bv10:28"],["bv10:28"],["bv10:28"]]}],"wordLinks":[["bv10:3.1","atulatejassā",0,5],["bv10:3.3","mahātamapavāhanā",0,8],["bv10:9.1","so",17,3],["bv10:9.1","pavane",17,4],["bv10:9.1","vāsaṃ",17,5],["bv10:9.1","upāgamī",17,6],["bv10:9.3","dvinnaṃ satasahassinaṃ",17,7],["bv10:28.1","vaddhapattaṃ",48,4],["bv10:28.3","sabbasaṅkhāre",48,6],["bv10:28.3","yathā sikhī",48,8]],"before":[{"para":2351,"vripara":null,"refs":[],"lines":["Imassa pana anomadassissa bhagavato santike sāriputto ca mahāmoggallāno cāti ime dve aggasāvakā aggasāvakabhāvatthāya paṇidhānamakaṃsu.","Imesaṃ pana therānaṃ vatthu cettha kathetabbaṃ.","Mayā ganthavitthārabhayena na uddhaṭanti."],"lineRefs":[[],[],[]]},{"para":2352,"vripara":null,"refs":[],"lines":["Anomadassībuddhavaṃsavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2353,"vripara":null,"refs":[],"lines":["Niṭṭhito sattamo buddhavaṃso."],"lineRefs":[[]]},{"para":2354,"vripara":null,"refs":[],"lines":["Padumabuddhavaṃsavaṇṇanā"],"lineRefs":[[]]},{"para":2355,"vripara":null,"refs":[],"lines":["Anomadassissa pana bhagavato aparabhāge vassasatasahassāyukā manussā anukkamena parihāyitvā dasavassāyukā hutvā puna anukkamena vaḍḍhitvā asaṅkhyeyyāyukā hutvā puna parihāyamānā vassasatasahassāyukā ahesuṃ.","Tathā <b>padumo</b> nāma satthā loke uppajji.","Sopi pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā campakanagare asamassa nāma rañño kule rūpādīhi asamāya asamāya nāma aggamahesiyā kucchismiṃ paṭisandhiṃ aggahesi.","So dasannaṃ māsānaṃ accayena campakuyyāne mātukucchito nikkhami.","Jāte pana kumāre ākāsato sakalajambudīpe samuddapariyante padumavassaṃ nipati.","Tenassa nāmaggahaṇadivase nāmaṃ gaṇhantā nemittakā ca ñātakā ca “mahāpadumakumāro” tveva nāmamakaṃsu.","So dasavassasahassāni agāraṃ ajjhāvasi.","Nanduttara-vasuttara-yasuttarānāmakā tayo pāsādā ahesuṃ.","Uttarādevippamukhāni tettiṃsa itthisahassāni paccupaṭṭhitāni ahesuṃ."],"lineRefs":[[],[],[],[],[],[],[],[],[]]},{"para":2356,"vripara":null,"refs":[],"lines":["Atha mahāsatto uttarāya nāma mahādeviyā rammakumāre nāma uppanne cattāri nimittāni disvā ājaññarathena mahābhinikkhamanaṃ nikkhami.","Taṃ pabbajantaṃ ekā purisakoṭi anupabbaji.","So tehi parivuto aṭṭha māse padhānacariyaṃ caritvā visākhapuṇṇamāya dhaññavatīnagare sudhaññaseṭṭhissa dhītāya dhaññavatiyā nāma dinnaṃ madhupāyāsaṃ paribhuñjitvā mahāsālavane divāvihāraṃ vītināmetvā sāyanhasamaye titthakājīvakena dinnā aṭṭha tiṇamuṭṭhiyo gahetvā mahāsoṇabodhiṃ upasaṅkamitvā aṭṭhattiṃsahatthavitthataṃ tiṇasantharakaṃ paññapetvā pallaṅkaṃ ābhujitvā caturaṅgavīriyaṃ adhiṭṭhāya mārabalaṃ vidhamitvā tīsu yāmesu tisso vijjā sacchikatvā –","“anekajātisaṃsāraṃ … pe … taṇhānaṃ khayamajjhagā”ti (dha. pa.153-154) udānaṃ udānetvā sattasattāhaṃ bodhisamīpeyeva vītināmetvā brahmuno āyācanaṃ adhivāsetvā dhammadesanāya bhājanabhūte puggale upaparikkhanto attanā saha pabbajite koṭisaṅkhe bhikkhū disvā taṅkhaṇeyeva anilapathena gantvā dhaññavatīnagarasamīpe dhanañjayuyyāne otaritvā tehi parivuto tesaṃ majjhe dhammacakkaṃ pavattesi.","Tadā koṭisatānaṃ abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[],[]]},{"para":2358,"vripara":"1","refs":[],"lines":["“Anomadassissa aparena, sambuddho dvipaduttamo;"],"lineRefs":[[]]},{"para":2359,"vripara":null,"refs":[],"lines":["Padumo nāma nāmena, asamo appaṭipuggalo."],"lineRefs":[[]]},{"para":2361,"vripara":"2","refs":[],"lines":["“Tassāpi asamaṃ sīlaṃ, samādhipi anantako;"],"lineRefs":[[]]},{"para":2362,"vripara":null,"refs":[],"lines":["Asaṅkhyeyyaṃ ñāṇavaraṃ, vimuttipi anūpamā."],"lineRefs":[[]]},{"para":2364,"vripara":"3","refs":[],"lines":["“Tassāpi atulatejassa, dhammacakkappavattane;"],"lineRefs":[[]]},{"para":2365,"vripara":null,"refs":[],"lines":["Abhisamayā tayo āsuṃ, mahātamapavāhanā”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
