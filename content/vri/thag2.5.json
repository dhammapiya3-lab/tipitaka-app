{"suttaId":"thag2.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[738,744],"vripara":"129"},"segments":{"thag2.5:0.4":"Ajinattheragāthā","thag2.5:1.1":"“Api ce hoti tevijjo, maccuhāyī anāsavo;","thag2.5:1.3":"Appaññātoti naṃ bālā, avajānanti ajānatā.","thag2.5:2.1":"“Yo ca kho annapānassa, lābhī hotīdha puggalo;","thag2.5:2.3":"Pāpadhammopi ce hoti, so nesaṃ hoti sakkato”ti.","thag2.5:2.5":"… Ajino thero …."},"attha":null,"tika":null}
