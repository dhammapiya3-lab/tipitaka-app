{"suttaId":"vv40","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1554,1579],"vripara":"697"},"segments":{"vv40:0.4":"Pabhassaravimānavatthu","vv40:1.1":"“Pabhassaravaravaṇṇanibhe,","vv40:1.2":"surattavatthavasane [vatthanivāsane (sī. syā.)];","vv40:1.3":"Mahiddhike candanaruciragatte,","vv40:1.4":"kā tvaṃ subhe devate vandase mamaṃ.","vv40:2.1":"“Pallaṅko ca te mahaggho,","vv40:2.2":"nānāratanacittito ruciro;","vv40:2.3":"Yattha tvaṃ nisinnā virocasi,","vv40:2.4":"devarājāriva nandane vane.","vv40:3.1":"“Kiṃ tvaṃ pure sucaritamācarī bhadde,","vv40:3.2":"kissa kammassa vipākaṃ;","vv40:3.3":"Anubhosi devalokasmiṃ,","vv40:3.4":"devate pucchitācikkha;","vv40:3.5":"Kissa kammassidaṃ phalan”ti.","vv40:4.1":"“Piṇḍāya te carantassa,","vv40:4.2":"mālaṃ phāṇitañca adadaṃ bhante;","vv40:4.3":"Tassa kammassidaṃ vipākaṃ,","vv40:4.4":"anubhomi devalokasmiṃ.","vv40:5.1":"“Hoti ca me anutāpo,","vv40:5.2":"aparaddhaṃ [aparādhaṃ (syā.)] dukkhitañca [dukkaṭañca (sī.)] me bhante;","vv40:5.3":"Sāhaṃ dhammaṃ nāssosiṃ,","vv40:5.4":"sudesitaṃ dhammarājena.","vv40:6.1":"“Taṃ taṃ vadāmi bhaddante,","vv40:6.2":"‘yassa me anukampiyo koci;","vv40:6.3":"Dhammesu taṃ samādapetha’,","vv40:6.4":"sudesitaṃ dhammarājena.","vv40:7.1":"“Yesaṃ atthi saddhā buddhe,","vv40:7.2":"dhamme ca saṅgharatane;","vv40:7.3":"Te maṃ ativirocanti,","vv40:7.4":"āyunā yasasā siriyā.","vv40:8.1":"“Patāpena vaṇṇena uttaritarā,","vv40:8.2":"Aññe mahiddhikatarā mayā devā”ti;","vv40:9.1":"Pabhassaravimānaṃ dutiyaṃ."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1821,"to":1840,"paras":[{"para":1821,"vripara":"697","refs":["vv40:1"],"lines":["Tattha <b>pabhassaravaravaṇṇanibhe</b>ti nibhāti dibbatīti nibhā, vaṇṇova nibhā vaṇṇanibhā, ativiya obhāsanato pabhassarā chavidosābhāvena varā uttamā vaṇṇanibhā etissāti pabhassaravaravaṇṇanibhā.","Āmantanavasena “pabhassaravaravaṇṇanibhe”ti vuttaṃ.","<b>Surattavatthavasane</b>ti suṭṭhu rattavatthanivatthe.","<b>Candanaruciragatte</b>ti candanānulittaṃ viya ruciragatte, gosītacandanena bahalatarānulittaṃ viya surattamanuññasarīrāvayaveti attho, candanānulepena vā ruciragatte."],"lineRefs":[["vv40:1"],["vv40:1"],["vv40:1"],["vv40:1"]]},{"para":1822,"vripara":null,"refs":["vv40:1"],"lines":["Evaṃ therena puṭṭhā devatā imāhi gāthāhi byākāsi –"],"lineRefs":[["vv40:1"]]},{"para":1824,"vripara":"700","refs":["vv40:1"],"lines":["“Piṇḍāya te carantassa, mālaṃ phāṇitañca adadaṃ bhante;"],"lineRefs":[["vv40:1"]]},{"para":1825,"vripara":null,"refs":["vv40:1"],"lines":["Tassa kammassidaṃ vipākaṃ, anubhomi devalokasmiṃ."],"lineRefs":[["vv40:1"]]},{"para":1827,"vripara":"701","refs":["vv40:1"],"lines":["“Hoti ca me anutāpo, aparaddhaṃ dukkhitañca me bhante;"],"lineRefs":[["vv40:1"]]},{"para":1828,"vripara":null,"refs":["vv40:1"],"lines":["Sāhaṃ dhammaṃ nāssosiṃ, sudesitaṃ dhammarājena."],"lineRefs":[["vv40:1"]]},{"para":1830,"vripara":"702","refs":["vv40:1"],"lines":["“Taṃ taṃ vadāmi bhaddante, yassa me anukampiyo koci;"],"lineRefs":[["vv40:1"]]},{"para":1831,"vripara":null,"refs":["vv40:1"],"lines":["Dhammesu taṃ samādapetha, sudesitaṃ dhammarājena."],"lineRefs":[["vv40:1"]]},{"para":1833,"vripara":"703","refs":["vv40:1"],"lines":["“Yesaṃ atthi saddhā buddhe, dhamme ca saṅgharatane;"],"lineRefs":[["vv40:1"]]},{"para":1834,"vripara":null,"refs":["vv40:1"],"lines":["Te maṃ ativirocanti, āyunā yasasā siriyā."],"lineRefs":[["vv40:1"]]},{"para":1836,"vripara":"704","refs":["vv40:1"],"lines":["“Patāpena vaṇṇena uttaritarā, aññe mahiddhikatarā mayā devā”ti."],"lineRefs":[["vv40:1"]]},{"para":1837,"vripara":"700","refs":["vv40:4"],"lines":["Tattha <b>mālan</b>ti sumanapupphaṃ.","<b>Phāṇitan</b>ti ucchurasaṃ gahetvā kataphāṇitaṃ."],"lineRefs":[["vv40:4"],["vv40:4"]]},{"para":1838,"vripara":"701","refs":["vv40:5"],"lines":["<b>Anutāpo</b>ti vippaṭisāro.","Tassa kāraṇamāha <b>“aparaddhaṃ dukkhatañca me bhante”</b>ti.","Idāni taṃ sarūpato dasseti <b>“sāhaṃ dhammaṃ nāssosin”</b>ti, sā ahaṃ tadā tava desetukāmassa dhammaṃ na suṇiṃ.","Kīdisaṃ?","<b>Sudesitaṃ dhammarājenā</b>ti, sammāsambuddhena ādikalyāṇāditāya ekantaniyyānikatāya ca svākhātanti attho."],"lineRefs":[["vv40:5"],["vv40:5"],["vv40:5"],["vv40:5"],["vv40:5"]]},{"para":1839,"vripara":"702","refs":["vv40:6"],"lines":["<b>Tan</b>ti tasmā dhammarājena sudesitattā asavanassa ca mādisānaṃ anutāpahetubhāvato.","<b>Tan</b>ti tuvaṃ, tuyhanti attho.","<b>Yassā</b>ti yo assa.","<b>Anukampiyo</b>ti anukampitabbo.","<b>Kocī</b>ti yo koci.","<b>Dhammesū</b>ti sīlādidhammesu.","“Dhamme hī”ti vā pāṭho, sāsanadhammeti attho.","Hīti nipātamattaṃ, vacanavipallāso vā.","<b>Tan</b>ti anukampitabbapuggalaṃ.","<b>Sudesitan</b>ti suṭṭhu desitaṃ."],"lineRefs":[["vv40:6"],["vv40:6"],["vv40:6"],["vv40:6"],["vv40:6"],["vv40:6"],["vv40:6"],["vv40:6"],["vv40:6"],["vv40:6"]]},{"para":1840,"vripara":"703-704","refs":["vv40:7"],"lines":["703-4. <b>Te maṃ ativirocantī</b>ti te ratanattaye pasannā devaputtā maṃ atikkamitvā virocanti.","<b>Patāpenā</b>ti tejasā ānubhāvena.","<b>Aññe</b>ti ye aññe.","<b>Mayā</b>ti nissakke karaṇavacanaṃ.","Vaṇṇena uttaritarā mahiddhikatarā ca devā, te ratanattaye abhippasannāyevāti dasseti.","Sesaṃ vuttanayameva."],"lineRefs":[["vv40:7"],["vv40:7"],["vv40:7"],["vv40:7"],["vv40:7"],["vv40:7"]]}],"wordLinks":[["vv40:1.1","pabhassaravaravaṇṇanibhe",0,0],["vv40:1.1","surattavatthavasane",0,2],["vv40:1.3","candanaruciragatte",0,3],["vv40:4.1","mālaṃ",11,0],["vv40:4.1","phāṇitaṃ",11,1],["vv40:5.1","anutāpo",12,0],["vv40:5.3","sāhaṃ dhammaṃ nāssosiṃ",12,2],["vv40:5.3","sudesitaṃ dhammarājenā",12,4],["vv40:6.1","taṃ",13,0],["vv40:6.3","taṃ",13,0],["vv40:6.1","taṃ",13,1],["vv40:6.3","taṃ",13,1],["vv40:6.1","yassā",13,2],["vv40:6.1","anukampiyo",13,3],["vv40:6.1","kocī",13,4],["vv40:6.3","dhammesū",13,5],["vv40:6.1","taṃ",13,8],["vv40:6.3","taṃ",13,8],["vv40:6.3","sudesitaṃ",13,9],["vv40:7.3","te maṃ ativirocantī",14,0]],"before":[{"para":1806,"vripara":null,"refs":[],"lines":["Athāyasmā mahāmoggallāno saparivārāya tassā devatāya dhammaṃ desetvā manussalokaṃ āgantvā bhagavato tamatthaṃ nivedesi.","Bhagavā taṃ aṭṭhuppattiṃ katvā sampattamahājanassa dhammaṃ desesi.","Desanā sadevakassa lokassa sātthikā ahosīti."],"lineRefs":[[],[],[]]},{"para":1807,"vripara":null,"refs":[],"lines":["Mañjiṭṭhakavimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1808,"vripara":null,"refs":[],"lines":["Pabhassaravimānavaṇṇanā"],"lineRefs":[[]]},{"para":1809,"vripara":null,"refs":[],"lines":["<b>Pabhassaravaravaṇṇanibhe</b>ti pabhassaravimānaṃ.","Tassa kā uppatti?","Bhagavā rājagahe viharati.","Tena ca samayena rājagahe aññataro upāsako mahāmoggallānatthere abhippasanno hoti.","Tassekā dhītā saddhā pasannā, sāpi there garucittīkārabahulā hoti.","Athekadivasaṃ āyasmā mahāmoggallāno rājagahe piṇḍāya caranto taṃ kulaṃ upasaṅkami.","Sā theraṃ disvā somanassajātā āsanaṃ paññāpetvā there tattha nisinne sumanamālāya pūjetvā madhuraṃ guḷaphāṇitaṃ therassa patte ākiri, thero anumoditukāmo nisīdi.","Sā gharāvāsassa bahukiccatāya anokāsataṃ pavedetvā “aññasmiṃ divase dhammaṃ sossāmī”ti theraṃ vanditvā uyyojesi.","Tadaheva ca sā kālaṃ katvā tāvatiṃsesu nibbatti.","Taṃ āyasmā mahāmoggallāno upasaṅkamitvā imāhi gāthāhi pucchi –"],"lineRefs":[[],[],[],[],[],[],[],[],[],[]]},{"para":1811,"vripara":"697","refs":[],"lines":["“Pabhassaravaravaṇṇanibhe, surattavatthavasane;"],"lineRefs":[[]]},{"para":1812,"vripara":null,"refs":[],"lines":["Mahiddhike candanaruciragatte,"],"lineRefs":[[]]},{"para":1813,"vripara":null,"refs":[],"lines":["Kā tvaṃ subhe devate vandase mamaṃ."],"lineRefs":[[]]},{"para":1815,"vripara":"698","refs":[],"lines":["“Pallaṅko ca te mahaggho, nānāratanacittito ruciro;"],"lineRefs":[[]]},{"para":1816,"vripara":null,"refs":[],"lines":["Yattha tvaṃ nisinnā virocasi, devarājāriva nandane vane."],"lineRefs":[[]]},{"para":1818,"vripara":"699","refs":[],"lines":["“Kiṃ tvaṃ pure sucaritamācarī bhadde, kissa kammassa vipākaṃ;"],"lineRefs":[[]]},{"para":1819,"vripara":null,"refs":[],"lines":["Anubhosi devalokasmiṃ, devate pucchitācikkha;"],"lineRefs":[[]]},{"para":1820,"vripara":null,"refs":[],"lines":["Kissa kammassidaṃ phalan”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
