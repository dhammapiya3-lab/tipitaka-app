{"suttaId":"ja117","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[656,659],"vripara":"117"},"segments":{"ja117:0.4":"Tittirajātakaṃ","ja117:1.1":"Accuggatātilapatā [atibalatā (sī. syā. pī.), atilapakā (katthaci)], ativelaṃ pabhāsitā;","ja117:1.3":"Vācā hanati dummedhaṃ, tittiraṃvātivassitanti.","ja117:2.1":"Tittirajātakaṃ sattamaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2668,"to":2668,"paras":[{"para":2668,"vripara":null,"refs":["ja117:1"],"lines":["Tattha <b>accuggatā</b>ti atiuggatā.","<b>Atibalatā</b>ti punappunaṃ bhāsanena atibalasabhāvā.","<b>Ativelaṃ pabhāsitā</b>ti atikkantavelā pamāṇātikkamena bhāsitā.","<b>Tittiraṃ vātivassitan</b>ti yathā tittiraṃ ativassitaṃ hanati, tathā evarūpā vācā dummedhaṃ bālapuggalaṃ hanatīti."],"lineRefs":[["ja117:1"],["ja117:1"],["ja117:1"],["ja117:1"]]}],"wordLinks":[["ja117:1.1","accuggatā",0,0],["ja117:1.1","ativelaṃ pabhāsitā",0,2],["ja117:1.3","tittiraṃ vātivassitaṃ",0,3]]},"tika":null}
