{"suttaId":"ja106","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[595,598],"vripara":"106"},"segments":{"ja106:0.4":"Udañcanījātakaṃ","ja106:1.1":"Sukhaṃ vata maṃ jīvantaṃ [sukhakaṃ vata jīvaṃ (ka.)], pacamānā udañcanī;","ja106:1.3":"Corī jāyappavādena, telaṃ loṇañca yācatīti.","ja106:2.1":"Udañcanījātakaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
