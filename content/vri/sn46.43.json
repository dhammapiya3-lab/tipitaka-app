{"suttaId":"sn46.43","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[604,604],"vripara":"224"},"segments":{"sn46.43:0.3":"Mārasuttaṃ","sn46.43:1.1":"“Mārasenappamaddanaṃ vo, bhikkhave, maggaṃ desessāmi;","sn46.43:1.2":"taṃ suṇātha.","sn46.43:1.3":"Katamo ca, bhikkhave, mārasenappamaddano maggo?","sn46.43:1.4":"Yadidaṃ – satta bojjhaṅgā.","sn46.43:1.6":"Katame satta?","sn46.43:1.7":"Satisambojjhaṅgo … pe … upekkhāsambojjhaṅgo – ayaṃ kho, bhikkhave, mārasenappamaddano maggo”ti.","sn46.43:1.9":"Tatiyaṃ."},"attha":null,"tika":null}
