{"suttaId":"snp5.9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3737,3751],"vripara":"1090"},"segments":{"snp5.9:0.2":"Hemakamāṇavapucchā","snp5.9:1.1":"“Ye me pubbe viyākaṃsu,","snp5.9:1.2":"(iccāyasmā hemako)","snp5.9:1.3":"Huraṃ gotamasāsanā;","snp5.9:1.4":"Iccāsi iti bhavissati,","snp5.9:1.5":"sabbaṃ taṃ itihītihaṃ;","snp5.9:1.6":"Sabbaṃ taṃ takkavaḍḍhanaṃ,","snp5.9:1.7":"nāhaṃ tattha abhiramiṃ.","snp5.9:2.1":"“Tvañca me dhammamakkhāhi,","snp5.9:2.2":"taṇhānigghātanaṃ muni;","snp5.9:2.3":"Yaṃ viditvā sato caraṃ,","snp5.9:2.4":"tare loke visattikaṃ”.","snp5.9:3.1":"“Idha diṭṭhasutamutaviññātesu,","snp5.9:3.2":"piyarūpesu hemaka;","snp5.9:3.3":"Chandarāgavinodanaṃ,","snp5.9:3.4":"nibbānapadamaccutaṃ.","snp5.9:4.1":"“Etadaññāya ye satā,","snp5.9:4.2":"diṭṭhadhammābhinibbutā;","snp5.9:4.3":"Upasantā ca te sadā,","snp5.9:4.4":"tiṇṇā loke visattikan”ti.","snp5.9:4.5":"Hemakamāṇavapucchā aṭṭhamā niṭṭhitā."},"unsure":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2591,"to":2591,"paras":[{"para":2591,"vripara":"1091-1094","refs":["snp5.9:2"],"lines":["1091-4. <b>Ye me pubbe</b>ti hemakasuttaṃ.","Tattha <b>ye me pubbe viyākaṃsū</b>ti ye bāvariādayo pubbe mayhaṃ sakaṃ laddhiṃ viyākaṃsu.","<b>Huraṃ gotamasāsanā</b>ti gotamasāsanā pubbataraṃ.","<b>Sabbaṃ taṃ takkavaḍḍhanan</b>ti sabbaṃ taṃ kāmavitakkādivaḍḍhanaṃ.","<b>Taṇhānigghātanan</b>ti taṇhāvināsanaṃ.","Athassa bhagavā taṃ dhammaṃ ācikkhanto <b>“idhā”</b>ti gāthādvayamāha.","Tattha <b>etadaññāya ye satā</b>ti etaṃ nibbānapadamaccutaṃ “sabbe saṅkhārā aniccā”tiādinā nayena vipassantā anupubbena jānitvā ye kāyānupassanāsatiādīhi satā.","<b>Diṭṭhadhammābhinibbutā</b>ti viditadhammattā, diṭṭhadhammattā, rāgādinibbānena ca abhinibbutā.","Sesaṃ sabbattha pākaṭameva."],"lineRefs":[["snp5.9:2"],["snp5.9:2"],["snp5.9:2"],["snp5.9:2"],["snp5.9:2"],["snp5.9:2"],["snp5.9:2"],["snp5.9:2"],["snp5.9:2"]]}],"wordLinks":[["snp5.9:2.1","taṇhānigghātanaṃ",0,4]]},"tika":null,"tika2":null}
