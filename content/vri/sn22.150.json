{"suttaId":"sn22.150","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[861,861],"vripara":"150"},"segments":{"sn22.150:0.3":"Ajjhattasuttaṃ","sn22.150:1.1":"Sāvatthinidānaṃ.","sn22.150:1.2":"“Kismiṃ nu kho, bhikkhave, sati, kiṃ upādāya uppajjati ajjhattaṃ sukhadukkhan”ti?","sn22.150:1.3":"Bhagavaṃmūlakā no, bhante, dhammā … pe …","sn22.150:1.4":"“rūpe kho, bhikkhave, sati rūpaṃ upādāya uppajjati ajjhattaṃ sukhadukkhaṃ.","sn22.150:1.5":"Vedanāya sati … pe …","sn22.150:1.6":"saññāya sati …","sn22.150:1.7":"saṅkhāresu sati …","sn22.150:1.8":"viññāṇe sati viññāṇaṃ upādāya uppajjati ajjhattaṃ sukhadukkhaṃ.","sn22.150:1.9":"Taṃ kiṃ maññatha, bhikkhave,","sn22.150:1.10":"rūpaṃ niccaṃ vā aniccaṃ vā”ti?","sn22.150:1.11":"“Aniccaṃ, bhante”.","sn22.150:1.12":"“Yaṃ panāniccaṃ dukkhaṃ vā taṃ sukhaṃ vā”ti?","sn22.150:1.13":"“Dukkhaṃ, bhante”.","sn22.150:1.14":"“Yaṃ panāniccaṃ dukkhaṃ vipariṇāmadhammaṃ, api nu taṃ anupādāya uppajjeyya ajjhattaṃ sukhadukkhan”ti?","sn22.150:1.15":"“No hetaṃ, bhante”.","sn22.150:1.16":"“Vedanā … pe …","sn22.150:1.17":"saññā …","sn22.150:1.18":"saṅkhārā …","sn22.150:1.19":"viññāṇaṃ niccaṃ vā aniccaṃ vā”ti?","sn22.150:1.20":"“Aniccaṃ, bhante”.","sn22.150:1.21":"“Yaṃ panāniccaṃ, dukkhaṃ vā taṃ sukhaṃ vā”ti?","sn22.150:1.22":"“Dukkhaṃ, bhante”.","sn22.150:1.23":"“Yaṃ panāniccaṃ dukkhaṃ vipariṇāmadhammaṃ, api nu taṃ anupādāya uppajjeyya ajjhattaṃ sukhadukkhan”ti?","sn22.150:1.24":"“No hetaṃ, bhante”.","sn22.150:1.25":"“Evaṃ passaṃ … pe …","sn22.150:1.26":"nāparaṃ itthattāyāti pajānātī”ti.","sn22.150:1.27":"Paṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":395,"to":395,"paras":[{"para":395,"vripara":"150-158","refs":["sn22.150:1"],"lines":["150-158. Diṭṭhivaggassa paṭhame <b>kiṃ upādāyā</b>ti kiṃ paṭicca.","Dutiye <b>kiṃ abhinivissā</b>ti kiṃ abhinivisitvā, paccayaṃ katvāti attho.","Tatiyādīsu <b>diṭṭhī</b>tiādīni puggalajjhāsayena vuttāni.","Paṭhamādīni."],"lineRefs":[["sn22.150:1"],["sn22.150:1"],["sn22.150:1"],["sn22.150:1"]]}],"wordLinks":[["sn22.150:1.2","kiṃ upādāyā",0,0]]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":400,"to":402,"paras":[{"para":400,"vripara":"150-158","refs":["sn22.150:1"],"lines":["150-158. <b>Paccayaṃ katvā</b>ti abhinivesapaccayaṃ katvā.","Ādisaddena micchādiṭṭhisakkāyadiṭṭhiattānudiṭṭhi saññojanābhinivesa-vinibandhaajjhosānāni saṅgaṇhāti.","Tattha <b>abhinivesā</b> taṇhāmānadiṭṭhiyo.","<b>Vinibandhā</b> “kāye avītarāgo hotī”tiādinā (dī. ni.3.320; ma. ni.1.186) āgatacetasovinibandhā.","<b>Ajjhosānā</b>ti taṇhādiṭṭhijjhosānāni.","Sesāni suviññeyyāneva."],"lineRefs":[["sn22.150:1"],["sn22.150:1"],["sn22.150:1"],["sn22.150:1"],["sn22.150:1"],["sn22.150:1"]]},{"para":401,"vripara":null,"refs":["sn22.150:1"],"lines":["Ajjhattasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.150:1"]]},{"para":402,"vripara":null,"refs":["sn22.150:1"],"lines":["Ānandasuttavaṇṇanā"],"lineRefs":[["sn22.150:1"]]}],"wordLinks":[]},"tika2":null}
