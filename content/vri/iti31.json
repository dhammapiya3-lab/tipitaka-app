{"suttaId":"iti31","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"It","vriCode":"s0504m.mul","paras":[275,281],"vripara":"31"},"segments":{"iti31:0.4":"Atapanīyasuttaṃ","iti31:1.1":"Vuttañhetaṃ bhagavatā, vuttamarahatāti me sutaṃ –","iti31:2.1":"“Dveme, bhikkhave, dhammā atapanīyā.","iti31:2.2":"Katame dve?","iti31:2.3":"Idha, bhikkhave, ekacco katakalyāṇo hoti, katakusalo, katabhīruttāṇo, akatapāpo, akataluddo, akatakibbiso.","iti31:2.4":"So ‘kataṃ me kalyāṇan’ tipi na tappati,‘akataṃ me pāpan’ tipi na tappati.","iti31:2.5":"Ime kho, bhikkhave, dve dhammā atapanīyā”ti.","iti31:2.6":"Etamatthaṃ bhagavā avoca.","iti31:2.7":"Tatthetaṃ iti vuccati –","iti31:3.1":"“Kāyaduccaritaṃ hitvā, vacīduccaritāni ca;","iti31:3.3":"Manoduccaritaṃ hitvā, yañcaññaṃ dosasañhitaṃ.","iti31:4.1":"“Akatvākusalaṃ kammaṃ, katvāna kusalaṃ bahuṃ;","iti31:4.3":"Kāyassa bhedā sappañño, saggaṃ so upapajjatī”ti.","iti31:5.1":"Ayampi attho vutto bhagavatā, iti me sutanti.","iti31:5.2":"Catutthaṃ."},"attha":{"book":"It-a","bookName":"Itivuttaka-aṭṭhakathā","vriCode":"s0504a.att","from":458,"to":460,"paras":[{"para":458,"vripara":"31","refs":["iti31:1"],"lines":["Catutthe tatiye vuttavipariyāyena attho veditabbo."],"lineRefs":[["iti31:1"]]},{"para":459,"vripara":null,"refs":[],"lines":["Catutthasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":460,"vripara":null,"refs":["iti31:1"],"lines":["Paṭhamasīlasuttavaṇṇanā"],"lineRefs":[["iti31:1"]]}],"wordLinks":[]},"tika":null}
