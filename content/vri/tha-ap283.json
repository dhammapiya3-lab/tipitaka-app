{"suttaId":"tha-ap283","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8705,8718],"vripara":"1"},"segments":{"tha-ap283:0.3":"Paṇṇadāyakattheraapadānaṃ","tha-ap283:1.1":"“Paṇṇasāle nisinnomhi,","tha-ap283:1.2":"paṇṇabhojanabhojano;","tha-ap283:1.3":"Upaviṭṭhañca maṃ santaṃ,","tha-ap283:1.4":"upāgacchi mahāisi [mahāmuni (sī.)].","tha-ap283:2.1":"“Siddhattho lokapajjoto,","tha-ap283:2.2":"sabbalokatikicchako;","tha-ap283:2.3":"Tassa paṇṇaṃ mayā dinnaṃ,","tha-ap283:2.4":"nisinnaṃ [nisinnassa (syā. aṭṭha.)] paṇṇasanthare.","tha-ap283:3.1":"“Catunnavutito kappe,","tha-ap283:3.2":"yaṃ paṇṇamadadiṃ tadā;","tha-ap283:3.3":"Duggatiṃ nābhijānāmi,","tha-ap283:3.4":"paṇṇadānassidaṃ phalaṃ.","tha-ap283:4.1":"“Paṭisambhidā catasso,","tha-ap283:4.2":"vimokkhāpi ca aṭṭhime;","tha-ap283:4.3":"Chaḷabhiññā sacchikatā,","tha-ap283:4.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap283:5.1":"Itthaṃ sudaṃ āyasmā paṇṇadāyako thero imā gāthāyo abhāsitthāti.","tha-ap283:6.1":"Paṇṇadāyakattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3243,"to":3243,"paras":[{"para":3243,"vripara":"1-2","refs":["tha-ap283:1"],"lines":["1-2. Ekūnatiṃsatime vagge paṭhamāpadāne <b>paṇṇabhojanabhojano</b>ti khīrapaṇṇādibhojanassa bhuñjanatthāya paṇṇasālāya nisinno <b>amhi</b> bhavāmīti attho.","<b>Upaviṭṭhañca maṃ santan</b>ti paṇṇasālāyaṃ upaviṭṭhaṃ santaṃ vijjamānaṃ maṃ.","<b>Upāgacchi mahāisī</b>ti mahante sīlādikhandhe esanato mahāisi.","<b>Lokapajjoto</b> lokapadīpo <b>siddhattho</b> bhagavā upagacchi, mama samīpaṃ agamāsīti attho.","<b>Nisinnassa paṇṇasanthare</b>ti upagantvā paṇṇasanthare nisinnassa khādanatthāya seditaṃ <b>paṇṇaṃ</b> mayā dinnanti sambandho."],"lineRefs":[["tha-ap283:1"],["tha-ap283:1"],["tha-ap283:1"],["tha-ap283:1"],["tha-ap283:1"]]}],"wordLinks":[["tha-ap283:1.1","paṇṇabhojanabhojano",0,0],["tha-ap283:1.3","upaviṭṭhañca maṃ santaṃ",0,1],["tha-ap283:1.3","upāgacchi mahāi