{"suttaId":"sn35.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[28,28],"vripara":"11"},"segments":{"sn35.11:0.3":"Bāhiradukkhātītānāgatasuttaṃ","sn35.11:1.1":"“Rūpā, bhikkhave, dukkhā atītānāgatā;","sn35.11:1.2":"ko pana vādo paccuppannānaṃ!","sn35.11:1.3":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītesu rūpesu anapekkho hoti;","sn35.11:1.4":"anāgate rūpe nābhinandati; paccuppannānaṃ rūpānaṃ nibbidāya virāgāya nirodhāya paṭipanno hotī”ti…pe. ….","sn35.11:1.5":"Ekādasamaṃ. 12."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":15,"to":18,"paras":[{"para":15,"vripara":"7-12","refs":["sn35.11:1"],"lines":["Sattamādīni atītānāgatesu cakkhādīsu aniccalakkhaṇādīni sallakkhetvā paccuppannesu balavagāhena kilamantānaṃ vasena vuttāni.","Sesaṃ sabbattha heṭṭhā vuttanayamevāti."],"lineRefs":[["sn35.11:1"],["sn35.11:1"]]},{"para":16,"vripara":null,"refs":["sn35.11:1"],"lines":["Aniccavaggo paṭhamo. 2."],"lineRefs":[["sn35.11:1"]]},{"para":17,"vripara":null,"refs":["sn35.11:1"],"lines":["Yamakavaggo 1-4."],"lineRefs":[["sn35.11:1"]]},{"para":18,"vripara":null,"refs":["sn35.11:1"],"lines":["Paṭhamapubbesambodhasuttādivaṇṇanā 13-16."],"lineRefs":[["sn35.11:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":18,"to":22,"paras":[{"para":18,"vripara":"7-12","refs":["sn35.11:1"],"lines":["<b>Sallakkhetvā</b>ti atītānāgatānaṃ avijjamānattā gāhassa daḷhatāya sallakkhetvā.","<b>Paccuppannesu</b> vijjamānattā balavatā taṇhādigāhena vipassanāvīthiṃ paṭipādetuṃ <b>kilamantānaṃ</b> vineyyānaṃ <b>vasena</b>."],"lineRefs":[["sn35.11:1"],["sn35.11:1"]]},{"para":19,"vripara":null,"refs":["sn35.11:1"],"lines":["Ajjhattāniccātītānāgatasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.11:1"]]},{"para":20,"vripara":null,"refs":["sn35.11:1"],"lines":["Aniccavaggavaṇṇanā niṭṭhitā. 2."],"lineRefs":[["sn35.11:1"]]},{"para