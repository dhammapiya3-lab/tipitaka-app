{"suttaId":"sn23.19","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[939,939],"vripara":"178"},"segments":{"sn23.19:0.3":"Khayadhammasuttaṃ","sn23.19:1.1":"Sāvatthinidānaṃ.","sn23.19:1.2":"Ekamantaṃ nisinno kho āyasmā rādho bhagavantaṃ etadavoca –","sn23.19:1.3":"“‘khayadhammo, khayadhammo’ti, bhante, vuccati.","sn23.19:1.4":"Katamo nu kho, bhante, khayadhammo”ti?","sn23.19:1.5":"“Rūpaṃ kho, rādha, khayadhammo, vedanā khayadhammo, saññā khayadhammo, saṅkhārā khayadhammo, viññāṇaṃ khayadhammo.","sn23.19:1.6":"Evaṃ passaṃ … pe …","sn23.19:1.7":"nāparaṃ itthattāyāti pajānātī”ti.","sn23.19:1.8":"Navamaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":410,"to":413,"paras":[{"para":410,"vripara":"170-181","refs":["sn23.19:1"],"lines":["170-181. Dutiyavaggassa paṭhame <b>māro, māro</b>ti maraṇaṃ pucchati.","Yasmā pana rūpādivinimuttaṃ maraṇaṃ nāma natthi, tenassa bhagavā <b>rūpaṃ kho, rādha, māro</b>tiādimāha.","Dutiye <b>māradhammo</b>ti maraṇadhammo.","Etenupāyena sabbattha attho veditabboti."],"lineRefs":[["sn23.19:1"],["sn23.19:1"],["sn23.19:1"],["sn23.19:1"]]},{"para":411,"vripara":null,"refs":["sn23.19:1"],"lines":["Dutiyo vaggo."],"lineRefs":[["sn23.19:1"]]},{"para":412,"vripara":null,"refs":["sn23.19:1"],"lines":["3-4. Āyācanavaggādi"],"lineRefs":[["sn23.19:1"]]},{"para":413,"vripara":null,"refs":["sn23.19:1"],"lines":["1-11. Mārādisuttaekādasakavaṇṇanā"],"lineRefs":[["sn23.19:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":420,"to":424,"paras":[{"para":420,"vripara":"170-181","refs":["sn23.19:1"],"lines":["170-181. <b>Rūpādivinimuttaṃ maraṇaṃ nāma natthi</b> rūpādīnaṃyeva vibhave maraṇasamaññāti.","<b>Maraṇadhammo</b> vināsabhāvo."],"lineRefs":[["sn23.19:1"],["sn23.19:1"]]},{"para":421,"vripara":null,"refs":["sn23.19:1"],"lines":["Mārasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn23.19:1"]]},{"para":422,"vripara":null,"refs":["sn23.19:1"],"lines":["Dutiyavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn23.19:1"]]},{"para":423,"vripara":null,"refs":["sn23.19:1"],"lines":["3-4. Āyācanavaggādi"],"lineRefs":[["sn23.19:1"]]},{"para":424,"vripara":null,"refs":["sn23.19:1"],"lines":["1-11. Mārādisuttaekādasakavaṇṇanā"],"lineRefs":[["sn23.19:1"]]}],"wordLinks":[]},"tika2":null}
