{"suttaId":"tha-ap270","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8503,8515],"vripara":"30"},"segments":{"tha-ap270:0.3":"Saḷalapupphiyattheraapadānaṃ","tha-ap270:1.1":"“Candabhāgānadītīre, ahosiṃ kinnaro tadā;","tha-ap270:1.3":"Vipassiṃ addasaṃ buddhaṃ, raṃsijālasamākulaṃ.","tha-ap270:2.1":"“Pasannacitto sumano, paramāya ca pītiyā;","tha-ap270:2.3":"Paggayha saḷalaṃ pupphaṃ, vipassiṃ okiriṃ ahaṃ.","tha-ap270:3.1":"“Ekanavutito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap270:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap270:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap270:5.1":"Itthaṃ sudaṃ āyasmā saḷalapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap270:6.1":"Saḷalapupphiyattherassāpadānaṃ aṭṭhamaṃ."},"attha":null,"tika":null,"tika2":null}
