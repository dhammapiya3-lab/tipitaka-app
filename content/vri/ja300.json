{"suttaId":"ja300","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2308,2325],"vripara":"148"},"segments":{"ja300:0.4":"Vakajātakaṃ (3-5-10)","ja300:1.1":"Parapāṇarodhā [parapāṇaghāte (syā.), parapāṇarocaṃ (ka.)] jīvanto, maṃsalohitabhojano;","ja300:1.3":"Vako vataṃ samādāya, upapajji uposathaṃ.","ja300:2.1":"Tassa sakko vataññāya, ajarūpenupāgami;","ja300:2.3":"Vītatapo ajjhappatto, bhañji lohitapo tapaṃ.","ja300:3.1":"Evameva idhekacce, samādānamhi dubbalā;","ja300:3.3":"Lahuṃ karonti attānaṃ, vakova ajakāraṇāti.","ja300:4.1":"Vakajātakaṃ dasamaṃ.","ja300:4.2":"Kumbhavaggo pañcamo.","ja300:5.1":"Tassuddānaṃ –","ja300:6.1":"Varakumbha supattasirivhayano, sucisammata bindusaro cusabho;","ja300:6.3":"Saritaṃpati caṇḍi jarākapinā, atha makkaṭiyā vakakena dasāti.","ja300:7.1":"Atha vagguddānaṃ –","ja300:8.1":"Saṅkappo padumo ceva, udapānena tatiyaṃ;","ja300:8.3":"Abbhantaraṃ ghaṭabhedaṃ, tikanipātamhilaṅkatanti.","ja300:9.1":"Tikanipātaṃ niṭṭhitaṃ."},"attha":null,"tika":null}
