{"suttaId":"thi-ap39","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[10568,10615],"vripara":"204"},"segments":{"thi-ap39:0.3":"Ambapālitherīapadānaṃ","thi-ap39:1.1":"“Yo raṃsiphusitāveḷo,","thi-ap39:1.2":"phusso nāma mahāmuni;","thi-ap39:1.3":"Tassāhaṃ bhaginī āsiṃ,","thi-ap39:1.4":"ajāyiṃ khattiye kule. 205.","thi-ap39:2.1":"“Tassa dhammaṃ suṇitvāhaṃ,","thi-ap39:2.2":"vippasannena cetasā;","thi-ap39:2.3":"Mahādānaṃ daditvāna,","thi-ap39:2.4":"patthayiṃ rūpasampadaṃ. 206.","thi-ap39:3.1":"“Ekatiṃse ito kappe,","thi-ap39:3.2":"sikhī lokagganāyako;","thi-ap39:3.3":"Uppanno lokapajjoto,","thi-ap39:3.4":"tilokasaraṇo jino. 207.","thi-ap39:4.1":"“Tadāruṇapure ramme,","thi-ap39:4.2":"brāhmaññakulasambhavā;","thi-ap39:4.3":"Vimuttacittaṃ kupitā,","thi-ap39:4.4":"bhikkhuniṃ abhisāpayiṃ. 208.","thi-ap39:5.1":"“Vesikāva anācārā,","thi-ap39:5.2":"jinasāsanadūsikā;","thi-ap39:5.3":"Evaṃ akkosayitvāna,","thi-ap39:5.4":"tena pāpena kammunā. 209.","thi-ap39:6.1":"“Dāruṇaṃ nirayaṃ gantvā,","thi-ap39:6.2":"mahādukkhasamappitā;","thi-ap39:6.3":"Tato cutā manussesu,","thi-ap39:6.4":"upapannā tapassinī. 210.","thi-ap39:7.1":"“Dasajātisahassāni,","thi-ap39:7.2":"gaṇikattamakārayiṃ;","thi-ap39:7.3":"Tamhā pāpā na muccissaṃ,","thi-ap39:7.4":"bhutvā duṭṭhavisaṃ yathā. 211.","thi-ap39:8.1":"“Brahmacariyamasevissaṃ [brahmavesamasevissaṃ (syā.), brahmaceramasevissaṃ (pī.)],","thi-ap39:8.2":"kassape jinasāsane;","thi-ap39:8.3":"Tena kammavipākena,","thi-ap39:8.4":"ajāyiṃ tidase pure. 212.","thi-ap39:9.1":"“Pacchime bhave sampatte,","thi-ap39:9.2":"ahosiṃ opapātikā;","thi-ap39:9.3":"Ambasākhantare jātā,","thi-ap39:9.4":"ambapālīti tenahaṃ. 213.","thi-ap39:10.1":"“Parivutā pāṇakoṭīhi,","thi-ap39:10.2":"pabbajiṃ jinasāsane;","thi-ap39:10.3":"Pattāhaṃ acalaṃ ṭhānaṃ,","thi-ap39:10.4":"dhītā buddhassa orasā. 214.","thi-ap39:11.1":"“Iddhīsu ca vasī homi,","thi-ap39:11.2":"sotadhātuvisuddhiyā;","thi-ap39:11.3":"Cetopariyañāṇassa,","thi-ap39:11.4":"vasī homi mahāmune. 215.","thi-ap39:12.1":"“Pubbenivāsaṃ jānāmi,","thi-ap39:12.2":"dibbacakkhu visodhitaṃ;","thi-ap39:12.3":"Sabbāsavaparikkhīṇā,","thi-ap39:12.4":"natthi dāni punabbhavo. 216.","thi-ap39:13.1":"“Atthadhammaniruttīsu,","thi-ap39:13.2":"paṭibhāne tatheva ca;","thi-ap39:13.3":"Ñāṇaṃ me vimalaṃ suddhaṃ,","thi-ap39:13.4":"buddhaseṭṭhassa vāhasā. 217.","thi-ap39:14.1":"“Kilesā jhāpitā mayhaṃ…pe…","thi-ap39:14.3":"viharāmi anāsavā. 218.","thi-ap39:15.1":"“Svāgataṃ vata me āsi…pe…","thi-ap39:15.3":"kataṃ buddhassa sāsanaṃ. 219.","thi-ap39:16.1":"“Paṭisambhidā catasso…pe…","thi-ap39:16.3":"kataṃ buddhassa sāsanaṃ”.","thi-ap39:17.1":"Itthaṃ sudaṃ ambapāli bhikkhunī imā gāthāyo Abhāsitthāti.","thi-ap39:18.1":"Ambapālitheriyāpadānaṃ navamaṃ. 10."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
