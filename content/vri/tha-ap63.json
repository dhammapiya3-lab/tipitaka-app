{"suttaId":"tha-ap63","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4247,4266],"vripara":"1"},"segments":{"tha-ap63:0.3":"Sakacintaniyattheraapadānaṃ","tha-ap63:1.1":"“Pavanaṃ kānanaṃ disvā,","tha-ap63:1.2":"appasaddamannāvilaṃ;","tha-ap63:1.3":"Isīnaṃ anuciṇṇaṃva,","tha-ap63:1.4":"āhutīnaṃ paṭiggahaṃ.","tha-ap63:2.1":"“Thūpaṃ katvāna pulinaṃ [veḷunā (aṭṭha.), veḷinaṃ (syā.)],","tha-ap63:2.2":"nānāpupphaṃ samokiriṃ;","tha-ap63:2.3":"Sammukhā viya sambuddhaṃ,","tha-ap63:2.4":"nimmitaṃ abhivandahaṃ.","tha-ap63:3.1":"“Sattaratanasampanno,","tha-ap63:3.2":"rājā raṭṭhamhi issaro;","tha-ap63:3.3":"Sakakammābhiraddhohaṃ,","tha-ap63:3.4":"pupphapūjāyidaṃ [thūpapūjāyidaṃ (sī.)] phalaṃ.","tha-ap63:4.1":"“Ekanavutito kappe,","tha-ap63:4.2":"yaṃ pupphamabhiropayiṃ;","tha-ap63:4.3":"Duggatiṃ nābhijānāmi,","tha-ap63:4.4":"pupphapūjāyidaṃ [thūpapūjāyidaṃ (sī.)] phalaṃ.","tha-ap63:5.1":"“Asītikappenantayaso,","tha-ap63:5.2":"cakkavattī ahosahaṃ;","tha-ap63:5.3":"Sattaratanasampanno,","tha-ap63:5.4":"catudīpamhi issaro.","tha-ap63:6.1":"“Paṭisambhidā catasso,","tha-ap63:6.2":"vimokkhāpi ca aṭṭhime;","tha-ap63:6.3":"Chaḷabhiññā sacchikatā,","tha-ap63:6.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap63:7.1":"Itthaṃ sudaṃ āyasmā sakacintaniyo thero imā gāthāyo abhāsitthāti.","tha-ap63:8.1":"Sakacintaniyattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2608,"to":2609,"paras":[{"para":2608,"vripara":"1","refs":["tha-ap63:1"],"lines":["So attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>pavanaṃ kānanaṃ disvā</b>tiādimāha.","Tattha <b>pavanan</b>ti pakārena vanaṃ patthaṭaṃ vitthiṇṇaṃ gahanabhūtanti pavanaṃ.","<b>Kānanaṃ</b> avakucchitaṃ ānanaṃ avahanaṃ satataṃ sīhabyagghayakkharakkhasamaddahatthiassasupaṇṇauragehi vihaṅgagaṇasaddakukkuṭakokilehi vā bahalanti kānanaṃ, taṃ kānanasaṅkhātaṃ pavanaṃ manussasaddavirahitattā <b>appasaddaṃ</b> nissaddanti attho.","<b>Anāvilan</b>ti na āvilaṃ upaddavarahitanti attho.","<b>Isīnaṃ anuciṇṇan</b>ti buddhapaccekabuddhaarahantakhīṇāsavasaṅkhātānaṃ isīnaṃ anuciṇṇaṃ nisevitanti attho.","<b>Āhutīnaṃ paṭiggahan</b>ti āhunaṃ vuccati pūjāsakkāraṃ paṭiggahaṃ gehasadisanti attho."],"lineRefs":[["tha-ap63:1"],["tha-ap63:1"],["tha-ap63:1"],["tha-ap63:1"],["tha-ap63:1"],["tha-ap63:1"]]},{"para":2609,"vripara":"2","refs":["tha-ap63:1","tha-ap63:2"],"lines":["<b>Thūpaṃ katvāna veḷunā</b>ti veḷupesikāhi cetiyaṃ katvāti attho.","<b>Nānāpupphaṃ samokirin</b>ti campakādīhi anekehi pupphehi samokiriṃ pūjesinti attho.","<b>Sammukhā viya sambuddhan</b>ti sajīvamānassa sambuddhassa sammukhā iva <b>nimmitaṃ</b> uppāditaṃ cetiyaṃ ahaṃ <b>abhi</b> visesena <b>vandiṃ</b> paṇāmamakāsinti attho.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap63:1"],["tha-ap63:2"],["tha-ap63:2"],["tha-ap63:2"]]}],"wordLinks":[["tha-ap63:1.1","pavanaṃ kānanaṃ disvā",0,0],["tha-ap63:1.1","pavanaṃ",0,1],["tha-ap63:1.1","appasaddaṃ",0,2],["tha-ap63:1.1","kānanaṃ",0,2],["tha-ap63:1.3","isīnaṃ anuciṇṇaṃ",0,4],["tha-ap63:1.3","āhutīnaṃ paṭiggahaṃ",0,5],["tha-ap63:2.1","nānāpupphaṃ samokiriṃ",1,1],["tha-ap63:2.3","abhi",1,2],["tha-ap63:2.3","nimmitaṃ",1,2],["tha-ap63:2.3","sammukhā viya sambuddhaṃ",1,2]]},"tika":null,"tika2":null}
