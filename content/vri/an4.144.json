{"suttaId":"an4.144","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1200,1200],"vripara":"144"},"segments":{"an4.144:0.3":"Obhāsasuttaṃ","an4.144:1.1":"“Cattārome, bhikkhave, obhāsā.","an4.144:1.2":"Katame cattāro?","an4.144:1.3":"Candobhāso, sūriyobhāso, aggobhāso, paññobhāso –","an4.144:1.4":"ime kho, bhikkhave, cattāro obhāsā.","an4.144:1.5":"Etadaggaṃ, bhikkhave, imesaṃ catunnaṃ obhāsānaṃ yadidaṃ paññobhāso”ti.","an4.144:1.6":"Catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1450,"to":1451,"paras":[{"para":1450,"vripara":"142-145","refs":["an4.144:1"],"lines":["Dutiyādīsupi pabhāsanavasena candova <b>candappabhā</b>.","Ālokanavasena candova <b>candāloko</b>.","Obhāsanavasena candova <b>candobhāso</b>.","Pajjotanavasena candova <b>candapajjoto</b>ti.","Evaṃ sabbapadesupi attho veditabbo. 6."],"lineRefs":[["an4.144:1"],["an4.144:1"],["an4.144:1"],["an4.144:1"],["an4.144:1"]]},{"para":1451,"vripara":null,"refs":["an4.144:1"],"lines":["Paṭhamakālasuttavaṇṇanā 146."],"lineRefs":[["an4.144:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1637,"to":1639,"paras":[{"para":1637,"vripara":"141-146","refs":["an4.144:1"],"lines":["Pañcamassa paṭhamādīni uttānatthāneva."],"lineRefs":[["an4.144:1"]]},{"para":1638,"vripara":null,"refs":["an4.144:1"],"lines":["Ābhāsuttādivaṇṇanā niṭṭhitā. 7-10."],"lineRefs":[["an4.144:1"]]},{"para":1639,"vripara":null,"refs":["an4.144:1"],"lines":["Dutiyakālasuttādivaṇṇanā 147-150."],"lineRefs":[["an4.144:1"]]}],"wordLinks":[]},"tika2":null}
