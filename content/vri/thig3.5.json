{"suttaId":"thig3.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[233,243],"vripara":"51"},"segments":{"thig3.5:0.3":"Ubbiritherīgāthā","thig3.5:1.1":"“Amma jīvāti vanamhi kandasi, attānaṃ adhigaccha ubbiri;","thig3.5:1.3":"Cullāsītisahassāni [cūḷāsītisahassāni (sī.)], sabbā jīvasanāmikā;","thig3.5:1.5":"Etamhāḷāhane daḍḍhā, tāsaṃ kamanusocasi.","thig3.5:2.1":"“Abbahī [abbutī (syā.), abbuḷhaṃ (ka.)] vata me sallaṃ, duddasaṃ hadayassitaṃ [hadayanissitaṃ (sī. syā.)];","thig3.5:2.3":"Yaṃ me sokaparetāya, dhītusokaṃ byapānudi.","thig3.5:3.1":"“Sājja abbūḷhasallāhaṃ, nicchātā parinibbutā;","thig3.5:3.3":"Buddhaṃ dhammañca saṅghañca, upemi saraṇaṃ munin”ti.","thig3.5:4.1":"… Ubbirī therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":730,"to":783,"paras":[{"para":730,"vripara":null,"refs":["thig3.5:1"],"words":["amma  jīvā","vanamhi kandasī","attānaṃ adhigaccha ubbirī","cullāsītisahassānī","sabbā jīvasanāmikā","etamhāḷāhane daḍḍhā","tāsaṃ kamanusocasī"],"lines":["Tattha, <b>amma, jīvā</b>ti mātupacāranāmena dhītuyā ālapanaṃ, idañcassā vippalapanākāradassanaṃ.","<b>Vanamhi kandasī</b>ti vanamajjhe paridevasi.","<b>Attānaṃ adhigaccha ubbirī</b>ti ubbiri tava attānameva tāva bujjhassu yāthāvato jānāhi.","<b>Cullāsītisahassānī</b>ti caturāsītisahassāni.","<b>Sabbā jīvasanāmikā</b>ti tā sabbāpi jīvanti, yā samānanāmikā.","<b>Etamhāḷāhane daḍḍhā</b>ti etamhi susāne jhāpitā.","<b>Tāsaṃ kamanusocasī</b>ti tāsu jīvantīnāmāsu caturāsītisahassamattāsu kaṃ sandhāya tvaṃ anusocasi anusokaṃ āpajjasīti evaṃ satthārā dhamme desite desanānusārena ñāṇaṃ pesetvā vipassanaṃ ārabhitvā satthu desanāvilāsena attano ca hetusampattiyā yathāṭhātāva vipassanaṃ ussukkāpetvā maggapaṭipāṭiyā aggaphale arahatte patiṭṭhāsi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.2.37-60)–"],"lineRefs":[["thig3.5:1"],["thig3.5:1"],["thig3.5:1"],["thig3.5:1"],["thig3.5:1"],["thig3.5:1"],["thig3.5:1"],["thig3.5:1"]]},{"para":731,"vripara":null,"refs":[],"words":[],"lines":["“Nagare haṃsavatiyā, ahosiṃ bālikā tadā;"],"lineRefs":[[]]},{"para":732,"vripara":null,"refs":[],"words":[],"lines":["Mātā ca me pitā ceva, kammantaṃ agamaṃsu te."],"lineRefs":[[]]},{"para":733,"vripara":null,"refs":[],"words":[],"lines":["“Majjhanhikamhi sūriye, addasaṃ samaṇaṃ ahaṃ;"],"lineRefs":[[]]},{"para":734,"vripara":null,"refs":[],"words":[],"lines":["Vīthiyā anugacchantaṃ, āsanaṃ paññapesahaṃ."],"lineRefs":[[]]},{"para":735,"vripara":null,"refs":[],"words":[],"lines":["“Gonakāvikatikāhi, paññapetvā mamāsanaṃ;"],"lineRefs":[[]]},{"para":736,"vripara":null,"refs":[],"words":[],"lines":["Pasannacittā sumanā, idaṃ vacanamabraviṃ."],"lineRefs":[[]]},{"para":737,"vripara":null,"refs":[],"words":[],"lines":["“Santattā kuthitā bhūmi, sūro majjhanhike ṭhito;"],"lineRefs":[[]]},{"para":738,"vripara":null,"refs":[],"words":[],"lines":["Mālutā ca na vāyanti, kālo cevettha mehiti."],"lineRefs":[[]]},{"para":739,"vripara":null,"refs":[],"words":[],"lines":["“Paññattamāsanamidaṃ, tavatthāya mahāmuni;"],"lineRefs":[[]]},{"para":740,"vripara":null,"refs":[],"words":[],"lines":["Anukampaṃ upādāya, nisīda mama āsane."],"lineRefs":[[]]},{"para":741,"vripara":null,"refs":[],"words":[],"lines":["“Nisīdi tattha samaṇo, sudanto suddhamānaso;"],"lineRefs":[[]]},{"para":742,"vripara":null,"refs":[],"words":[],"lines":["Tassa pattaṃ gahetvāna, yathārandhaṃ adāsahaṃ."],"lineRefs":[[]]},{"para":743,"vripara":null,"refs":[],"words":[],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":744,"vripara":null,"refs":[],"words":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":745,"vripara":null,"refs":[],"words":[],"lines":["“Tattha me sukataṃ byamhaṃ, āsanena sunimmitaṃ;"],"lineRefs":[[]]},{"para":746,"vripara":null,"refs":[],"words":[],"lines":["Saṭṭhiyojanamubbedhaṃ, tiṃsayojanavitthataṃ."],"lineRefs":[[]]},{"para":747,"vripara":null,"refs":[],"words":[],"lines":["“Soṇṇamayā maṇimayā, athopi phalikāmayā;"],"lineRefs":[[]]},{"para":748,"vripara":null,"refs":[],"words":[],"lines":["Lohitaṅgamayā ceva, pallaṅkā vividhā mama."],"lineRefs":[[]]},{"para":749,"vripara":null,"refs":[],"words":[],"lines":["“Tūlikāvikatikāhi, kaṭṭissacittakāhi ca;"],"lineRefs":[[]]},{"para":750,"vripara":null,"refs":[],"words":[],"lines":["Uddhaekantalomī ca, pallaṅkā me susaṇṭhitā."],"lineRefs":[[]]},{"para":751,"vripara":null,"refs":[],"words":[],"lines":["“Yadā icchāmi gamanaṃ, hāsakhiḍḍasamappitā;"],"lineRefs":[[]]},{"para":752,"vripara":null,"refs":[],"words":[],"lines":["Saha pallaṅkaseṭṭhena, gacchāmi mama patthitaṃ."],"lineRefs":[[]]},{"para":753,"vripara":null,"refs":[],"words":[],"lines":["“Asītidevarājūnaṃ, mahesittamakārayiṃ;"],"lineRefs":[[]]},{"para":754,"vripara":null,"refs":[],"words":[],"lines":["Sattaticakkavattīnaṃ, mahesittamakārayiṃ."],"lineRefs":[[]]},{"para":755,"vripara":null,"refs":[],"words":[],"lines":["“Bhavābhave saṃsarantī, mahābhogaṃ labhāmahaṃ;"],"lineRefs":[[]]},{"para":756,"vripara":null,"refs":[],"words":[],"lines":["Bhoge me ūnatā natthi, ekāsanassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":757,"vripara":null,"refs":[],"words":[],"lines":["“Duve bhave saṃsarāmi, devatte atha mānuse;"],"lineRefs":[[]]},{"para":758,"vripara":null,"refs":[],"words":[],"lines":["Aññe bhave na jānāmi, ekāsanassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":759,"vripara":null,"refs":[],"words":[],"lines":["“Duve kule pajāyāmi, khattiye cāpi brāhmaṇe;"],"lineRefs":[[]]},{"para":760,"vripara":null,"refs":[],"words":[],"lines":["Uccākulīnā sabbattha, ekāsanassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":761,"vripara":null,"refs":[],"words":[],"lines":["“Domanassaṃ na jānāmi, cittasantāpanaṃ mama;"],"lineRefs":[[]]},{"para":762,"vripara":null,"refs":[],"words":[],"lines":["Vevaṇṇiyaṃ na jānāmi, ekāsanassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":763,"vripara":null,"refs":[],"words":[],"lines":["“Dhātiyo maṃ upaṭṭhanti, khujjā celāpikā bahū;"],"lineRefs":[[]]},{"para":764,"vripara":null,"refs":[],"words":[],"lines":["Aṅkena aṅkaṃ gacchāmi, ekāsanassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":765,"vripara":null,"refs":[],"words":[],"lines":["“Aññā nhāpenti bhojenti, aññā ramenti maṃ sadā;"],"lineRefs":[[]]},{"para":766,"vripara":null,"refs":[],"words":[],"lines":["Aññā gandhaṃ vilimpanti, ekāsanassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":767,"vripara":null,"refs":[],"words":[],"lines":["“Maṇḍape rukkhamūle vā, suññāgāre vasantiyā;"],"lineRefs":[[]]},{"para":768,"vripara":null,"refs":[],"words":[],"lines":["Mama saṅkappamaññāya, pallaṅko upatiṭṭhati."],"lineRefs":[[]]},{"para":769,"vripara":null,"refs":[],"words":[],"lines":["“Ayaṃ pacchimako mayhaṃ, carimo vattate bhavo;"],"lineRefs":[[]]},{"para":770,"vripara":null,"refs":[],"words":[],"lines":["Ajjāpi rajjaṃ chaḍḍetvā, pabbajiṃ anagāriyaṃ."],"lineRefs":[[]]},{"para":771,"vripara":null,"refs":[],"words":[],"lines":["“Satasahassito kappe, yaṃ dānamadadiṃ tadā;"],"lineRefs":[[]]},{"para":772,"vripara":null,"refs":[],"words":[],"lines":["Duggatiṃ nābhijānāmi, ekāsanassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":773,"vripara":null,"refs":[],"words":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":774,"vripara":null,"refs":[],"words":[],"lines":["Arahatte pana patiṭṭhāya attanā adhigatavisesaṃ pakāsentī –"],"lineRefs":[[]]},{"para":776,"vripara":"52","refs":[],"words":[],"lines":["“Abbahī tava me sallaṃ, duddasaṃ hadayassitaṃ;"],"lineRefs":[[]]},{"para":777,"vripara":null,"refs":[],"words":[],"lines":["Yaṃ me sokaparetāya, dhītusokaṃ byapānudi."],"lineRefs":[[]]},{"para":779,"vripara":"53","refs":[],"words":[],"lines":["“Sājja abbūḷhasallāhaṃ, nicchātā parinibbutā;"],"lineRefs":[[]]},{"para":780,"vripara":null,"refs":[],"words":[],"lines":["Buddhaṃ dhammañca saṅghañca, upemi saraṇaṃ munin”ti.","–"],"lineRefs":[[],[]]},{"para":781,"vripara":null,"refs":[],"words":[],"lines":["Imā dve gāthā abhāsi."],"lineRefs":[[]]},{"para":782,"vripara":null,"refs":[],"words":[],"lines":["Tattha <b>abbahī vata me sallaṃ, duddasaṃ hadayassitan</b>ti anupacitakusalasambhārehi yāthāvato duddasaṃ mama cittasannissitaṃ pīḷājananato dunnīharaṇato anto tudanato ca “sallan”ti laddhanāmaṃ sokaṃ taṇhañca <b>abbahī</b> vata nīhari vata.","<b>Yaṃ me sokaparetāyā</b>ti yasmā sokena abhibhūtāya mayhaṃ dhītusokaṃ <b>byapānudi</b> anavasesato nīhari, tasmā abbahī vata me sallanti yojanā."],"lineRefs":[[],[]]},{"para":783,"vripara":null,"refs":["thig3.5:3"],"words":["sājja abbūḷhasallāhaṃ","dhammañca","muniṃ","saraṇaṃ","saṅghañca","upemi"],"lines":["<b>Sājja abbūḷhasallāhan</b>ti sā ahaṃ ajja sabbaso uddhaṭataṇhāsallā tato eva nicchātā parinibbutā.","<b>Munin</b>ti sabbaññubuddhaṃ tadupadesitamaggaphalanibbānapabhedaṃ navavidhalokuttara <b>dhammañca,</b> tattha patiṭṭhitaṃ aṭṭhaariyapuggalasamūhasaṅkhātaṃ <b>saṅghañca,</b> anuttarehi tehi yojanato sakalavaṭṭadukkhavināsanato ca <b>saraṇaṃ</b> tāṇaṃ leṇaṃ parāyaṇanti, <b>upemi</b> upagacchāmi bujjhāmi sevāmi cāti attho."],"lineRefs":[["thig3.5:3"],["thig3.5:3"]]}]},"tika":null}
