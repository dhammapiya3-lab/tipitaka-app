{"suttaId":"sn13.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[643,644],"vripara":"78"},"segments":{"sn13.5:0.3":"Pathavīsuttaṃ","sn13.5:1.1":"Sāvatthiyaṃ viharati…pe…","sn13.5:1.2":"“seyyathāpi, bhikkhave, puriso mahāpathaviyā satta kolaṭṭhimattiyo guḷikā upanikkhipeyya.","sn13.5:1.3":"Taṃ kiṃ maññatha, bhikkhave,","sn13.5:1.4":"katamaṃ nu kho bahutaraṃ, yā vā satta kolaṭṭhimattiyo guḷikā upanikkhittā ayaṃ [yā (syā. ka.)] vā mahāpathavī”ti?","sn13.5:2.1":"“Etadeva, bhante, bahutaraṃ, yadidaṃ mahāpathavī;","sn13.5:2.2":"appamattikā satta kolaṭṭhimattiyo guḷikā upanikkhittā.","sn13.5:2.3":"Neva satimaṃ kalaṃ upenti na sahassimaṃ kalaṃ upenti na satasahassimaṃ kalaṃ upenti mahāpathaviṃ upanidhāya satta kolaṭṭhimattiyo guḷikā upanikkhittā”ti.","sn13.5:2.4":"“Evameva kho, bhikkhave…pe…","sn13.5:2.5":"dhammacakkhupaṭilābho”ti.","sn13.5:2.6":"Pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":484,"to":484,"paras":[{"para":484,"vripara":"78-84","refs":["sn13.5:1"],"lines":["Pañcame <b>mahāpathaviyā</b>ti cakkavāḷabbhantarāya mahāpathaviyā uddharitvā.","<b>Kolaṭṭhimattiyo</b>ti padaraṭṭhipamāṇā.","<b>Guḷikā</b>ti mattikaguḷikā.","<b>Upanikkhipeyyā</b>ti ekasmiṃ ṭhāne ṭhapeyya.","Chaṭṭhādīsu vuttanayeneva attho veditabbo.","Pariyosāne pana <b>aññatitthiyasamaṇabrāhmaṇaparibbājakānaṃ adhigamo</b>ti bāhirakānaṃ sabbopi guṇādhigamo paṭhamamaggena adhigataguṇānaṃ satabhāgampi sahassabhāgampi satasahassabhāgampi na upagacchatīti.","Pañcamādīni."],"lineRefs":[["sn13.5:1"],["sn13.5:1"],["sn13.5:1"],["sn13.5:1"],["sn13.5:1"],["sn13.5:1"],["sn13.5:1"]]}],"wordLinks":[["sn13.5:1.1","mahāpathaviyā",0,0],["sn13.5:1.1","kolaṭṭhimattiyo",0,1],["sn13.5:1.3","kolaṭṭhimattiyo",0,1],["sn13.5:1.1","guḷikā",0,2],["sn13.5:1.3","guḷikā",0,2],["sn13.5:1.1","upanikkhipeyyā",0,3]]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":475,"to":483,"paras":[{"para":475,"vripara":"78-84","refs":["sn13.5:1"],"lines":["<b>Cakkavāḷabbhantarāyā</b>ti cakkavāḷapabbatassa antogadhāya."],"lineRefs":[["sn13.5:1"]]},{"para":476,"vripara":null,"refs":["sn13.5:1"],"lines":["<b>Chaṭṭhādīsu vuttanayenevā</b>ti idha chaṭṭhasuttādīsu paṭhamasuttādīsu vuttanayenevāti attho veditabbo visesābhāvato."],"lineRefs":[["sn13.5:1"]]},{"para":477,"vripara":null,"refs":["sn13.5:1"],"lines":["<b>Pariyosāne</b>ti imassa abhisamayasaṃyuttassa osānaṭṭhāne.","<b>Aññatitthiyasamaṇabrāhmaṇaparibbājakāna</b>nti aññatitthiyānaṃ.","<b>Guṇādhigamo</b>ti jhānābhiññāsahito guṇādhigamo.","<b>Satabhāgampi…pe… na upagacchati</b> saccapaṭivedhassa mahānubhāvattā.","Tenāha bhagavā paccakkhasabbadhammo “evaṃ mahādhigamo, bhikkhave, diṭṭhisampanno puggalo evaṃ mahābhiñño”ti."],"lineRefs":[["sn13.5:1"],["sn13.5:1"],["sn13.5:1"],["sn13.5:1"],["sn13.5:1"]]},{"para":478,"vripara":null,"refs":["sn13.5:1"],"lines":["Pathavīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn13.5:1"]]},{"para":479,"vripara":null,"refs":["sn13.5:1"],"lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"],"lineRefs":[["sn13.5:1"]]},{"para":480,"vripara":null,"refs":["sn13.5:1"],"lines":["Abhisamayasaṃyuttavaṇṇanāya līnatthappakāsanā samattā. 3."],"lineRefs":[["sn13.5:1"]]},{"para":481,"vripara":null,"refs":["sn13.5:1"],"lines":["Dhātusaṃyuttaṃ 1."],"lineRefs":[["sn13.5:1"]]},{"para":482,"vripara":null,"refs":["sn13.5:1"],"lines":["Nānattavaggo 1."],"lineRefs":[["sn13.5:1"]]},{"para":483,"vripara":null,"refs":["sn13.5:1"],"lines":["Dhātunānattasuttavaṇṇanā 85."],"lineRefs":[["sn13.5:1"]]}],"wordLinks":[]},"tika2":null}
