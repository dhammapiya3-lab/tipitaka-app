{"suttaId":"tha-ap351","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10421,10432],"vripara":"59"},"segments":{"tha-ap351:0.3":"Tindukaphaladāyakattheraapadānaṃ","tha-ap351:1.1":"“Kaṇikāraṃva jotantaṃ,","tha-ap351:1.2":"nisinnaṃ pabbatantare;","tha-ap351:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap351:1.4":"oghatiṇṇamanāsavaṃ.","tha-ap351:2.1":"“Tindukaṃ saphalaṃ disvā,","tha-ap351:2.2":"bhinditvāna sakosakaṃ [sakoṭakaṃ (sī.), sakoṭikaṃ (syā.)];","tha-ap351:2.3":"Pasannacitto sumano,","tha-ap351:2.4":"sayambhussa madāsahaṃ [vessabhussa adāsahaṃ (sī.)].","tha-ap351:3.1":"“Ekanavutito kappe,","tha-ap351:3.2":"yaṃ phalamadadiṃ tadā;","tha-ap351:3.3":"Duggatiṃ nābhijānāmi,","tha-ap351:3.4":"phaladānassidaṃ phalaṃ.","tha-ap351:4.1":"“Paṭisambhidā catasso … pe …","tha-ap351:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap351:5.1":"Itthaṃ sudaṃ āyasmā tindukaphaladāyako thero imā gāthāyo abhāsitthāti.","tha-ap351:6.1":"Tindukaphaladāyakattherassāpadānaṃ navamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
