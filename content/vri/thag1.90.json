{"suttaId":"thag1.90","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[518,526],"vripara":"90"},"segments":{"thag1.90:0.4":"Sāmidattattheragāthā","thag1.90:1.1":"“Pañcakkhandhā pariññātā, tiṭṭhanti chinnamūlakā;","thag1.90:1.3":"Vikkhīṇo jātisaṃsāro, natthi dāni punabbhavo”ti.","thag1.90:1.5":"… Sāmidatto thero ….","thag1.90:1.6":"Vaggo navamo niṭṭhito.","thag1.90:2.0":"Tassuddānaṃ –","thag1.90:2.1":"Thero samitigutto ca, kassapo sīhasavhayo;","thag1.90:2.3":"Nīto sunāgo nāgito, paviṭṭho ajjuno isi;","thag1.90:2.5":"Devasabho ca yo thero, sāmidatto mahabbaloti."},"attha":null,"tika":null}
