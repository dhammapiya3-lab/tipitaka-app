{"suttaId":"sn1.69","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[774,778],"vripara":"69"},"segments":{"sn1.69:0.3":"Icchāsuttaṃ","sn1.69:1.1":"“Kenassu bajjhatī loko, kissa vinayāya muccati;","sn1.69:1.3":"Kissassu vippahānena, sabbaṃ chindati bandhanan”ti.","sn1.69:2.1":"“Icchāya bajjhatī loko, icchāvinayāya muccati;","sn1.69:2.3":"Icchāya vippahānena, sabbaṃ chindati bandhanan”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":470,"to":471,"paras":[{"para":470,"vripara":"69","refs":["sn1.69:1"],"lines":["Navame sabbaṃ uttānameva.","Navamaṃ."],"lineRefs":[["sn1.69:1"],["sn1.69:1"]]},{"para":471,"vripara":null,"refs":["sn1.69:1"],"lines":["Lokasuttavaṇṇanā"],"lineRefs":[["sn1.69:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":584,"to":584,"paras":[{"para":584,"vripara":"69","refs":["sn1.69:1"],"lines":["Navame <b>vinayāyā</b>ti vinayena.","Karaṇatthe hi idaṃ sampadānavacanaṃ.","<b>Kissassū</b>ti kissa, <b>su</b> -kāro nipātamattaṃ.","<b>Sabbaṃ chindati bandhanan</b>ti sabbaṃ dasavidhampi saṃyojanaṃ samucchindati.","Na hi taṃ kiñci kilesabandhanaṃ atthi, yaṃ asamucchinnaṃ hutvā ṭhitaṃ assā taṇhāya samucchinnāya.","Svāyamattho suviññeyyoti āha <b>“sabbaṃ uttānamevā”</b>ti."],"lineRefs":[["sn1.69:1"],["sn1.69:1"],["sn1.69:1"],["sn1.69:1"],["sn1.69:1"],["sn1.69:1"]]}],"wordLinks":[["sn1.69:1.1","vinayāyā",0,0],["sn1.69:1.1","su",0,2],["sn1.69:1.3","kissassū",0,2],["sn1.69:1.3","su",0,2],["sn1.69:1.3","sabbaṃ chindati bandhanaṃ",0,3]]},"tika2":null}
