{"suttaId":"tha-ap269","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8489,8501],"vripara":"26"},"segments":{"tha-ap269:0.3":"Javahaṃsakattheraapadānaṃ","tha-ap269:1.1":"“Candabhāgānadītīre, āsiṃ vanacaro tadā;","tha-ap269:1.3":"Siddhatthaṃ addasaṃ buddhaṃ, gacchantaṃ anilañjase.","tha-ap269:2.1":"“Añjaliṃ paggahetvāna, ullokento mahāmuniṃ;","tha-ap269:2.3":"Sakaṃ cittaṃ pasādetvā, avandiṃ nāyakaṃ ahaṃ.","tha-ap269:3.1":"“Catunnavutito kappe, yamavandiṃ narāsabhaṃ;","tha-ap269:3.3":"Duggatiṃ nābhijānāmi, vandanāya idaṃ phalaṃ.","tha-ap269:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap269:5.1":"Itthaṃ sudaṃ āyasmā javahaṃsako thero imā gāthāyo abhāsitthāti.","tha-ap269:6.1":"Javahaṃsakattherassāpadānaṃ sattamaṃ."},"attha":null,"tika":null,"tika2":null}
