{"suttaId":"tha-ap477","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1693,1707],"vripara":"51"},"segments":{"tha-ap477:0.3":"Kummāsadāyakattheraapadānaṃ","tha-ap477:1.1":"“Esanāya carantassa,","tha-ap477:1.2":"vipassissa mahesino;","tha-ap477:1.3":"Rittakaṃ pattaṃ disvāna,","tha-ap477:1.4":"kummāsaṃ pūrayiṃ ahaṃ. 52.","tha-ap477:2.1":"“Ekanavutito kappe,","tha-ap477:2.2":"yaṃ bhikkhaṃ adadiṃ tadā;","tha-ap477:2.3":"Duggatiṃ nābhijānāmi,","tha-ap477:2.4":"kummāsassa idaṃ phalaṃ. 53.","tha-ap477:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap477:3.3":"viharāmi anāsavo. 54.","tha-ap477:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap477:4.3":"kataṃ buddhassa sāsanaṃ. 55.","tha-ap477:5.1":"“Paṭisambhidā catasso…pe…","tha-ap477:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap477:6.1":"Itthaṃ sudaṃ āyasmā kummāsadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap477:7.1":"Kummāsadāyakattherassāpadānaṃ pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
