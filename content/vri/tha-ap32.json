{"suttaId":"tha-ap32","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[3092,3116],"vripara":"184"},"segments":{"tha-ap32:0.3":"Khomadāyakattheraapadānaṃ","tha-ap32:1.1":"“Nagare bandhumatiyā,","tha-ap32:1.2":"ahosiṃ vāṇijo tadā;","tha-ap32:1.3":"Teneva dāraṃ posemi,","tha-ap32:1.4":"ropemi bījasampadaṃ.","tha-ap32:2.1":"“Rathiyaṃ paṭipannassa,","tha-ap32:2.2":"vipassissa mahesino;","tha-ap32:2.3":"Ekaṃ khomaṃ mayā dinnaṃ,","tha-ap32:2.4":"kusalatthāya satthuno.","tha-ap32:3.1":"“Ekanavutito kappe,","tha-ap32:3.2":"yaṃ khomamadadiṃ tadā;","tha-ap32:3.3":"Duggatiṃ nābhijānāmi,","tha-ap32:3.4":"khomadānassidaṃ phalaṃ.","tha-ap32:4.1":"“Sattarase [sattavīse (sī. syā.)] ito kappe,","tha-ap32:4.2":"eko sindhavasandhano;","tha-ap32:4.3":"Sattaratanasampanno,","tha-ap32:4.4":"catudīpamhi issaro.","tha-ap32:5.1":"“Paṭisambhidā catasso,","tha-ap32:5.2":"vimokkhāpi ca aṭṭhime;","tha-ap32:5.3":"Chaḷabhiññā sacchikatā,","tha-ap32:5.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap32:6.1":"Itthaṃ sudaṃ āyasmā khomadāyako thero imā gāthāyo abhāsitthāti.","tha-ap32:7.1":"Khomadāyakattherassāpadānaṃ dasamaṃ.","tha-ap32:8.1":"Tassuddānaṃ –","tha-ap32:9.1":"Susūti upavāno ca,","tha-ap32:9.2":"saraṇo sīlagāhako;","tha-ap32:9.3":"Annasaṃsāvako khomadāyī ca,","tha-ap32:10.2":"daseva tatiye gaṇe; Añjalī khomadāyī ca, daseva tatiye gaṇe;","tha-ap32:10.3":"Pañcālīsītisataṃ vuttā,","tha-ap32:10.4":"gāthāyo sabbapiṇḍitā.","tha-ap32:11.1":"Subhūtivaggo tatiyo.","tha-ap32:12.1":"Catutthabhāṇavāraṃ."},"unsure":["tha-ap32:9.3"],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2389,"to":2389,"paras":[{"para":2389,"vripara":"184","refs":["tha-ap32:1"],"lines":["So attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ dassento <b>nagare bandhumatiyā</b>tiādimāha.","Tattha bandhu vuccati ñātako, te bandhū yasmiṃ nagare aññamaññaṃ saṅghaṭitā vasanti, taṃ nagaraṃ “bandhumatī”ti vuccati.","<b>Ropemi bījasampadan</b>ti dānasīlādipuññabījasampattiṃ ropemi paṭṭhapemīti attho."],"lineRefs":[["tha-ap32:1"],["tha-ap32:1"],["tha-ap32:1"]]}],"wordLinks":[["tha-ap32:1.1","nagare bandhumatiyā",0,0],["tha-ap32:1.3","ropemi bījasampadaṃ",0,2]]},"tika":null,"tika2":null}
