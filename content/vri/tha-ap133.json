{"suttaId":"tha-ap133","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6022,6050],"vripara":"1"},"segments":{"tha-ap133:0.3":"Sobhitattheraapadānaṃ","tha-ap133:1.1":"“Padumuttaro nāma jino,","tha-ap133:1.2":"lokajeṭṭho narāsabho;","tha-ap133:1.3":"Mahato janakāyassa,","tha-ap133:1.4":"deseti amataṃ padaṃ.","tha-ap133:2.1":"“Tassāhaṃ vacanaṃ sutvā,","tha-ap133:2.2":"vācāsabhimudīritaṃ [vācāsabhimudīrayiṃ (?)];","tha-ap133:2.3":"Añjaliṃ paggahetvāna,","tha-ap133:2.4":"ekaggo āsahaṃ tadā.","tha-ap133:3.1":"“Yathā samuddo udadhīnamaggo,","tha-ap133:3.2":"nerū nagānaṃ pavaro siluccayo;","tha-ap133:3.3":"Tatheva ye cittavasena vattare,","tha-ap133:3.4":"na buddhañāṇassa kalaṃ upenti te.","tha-ap133:4.1":"“Dhammavidhiṃ [dhamme vidhiṃ (sī.)] ṭhapetvāna,","tha-ap133:4.2":"buddho kāruṇiko isi;","tha-ap133:4.3":"Bhikkhusaṅghe nisīditvā,","tha-ap133:4.4":"imā gāthā abhāsatha.","tha-ap133:5.1":"“‘Yo so ñāṇaṃ pakittesi,","tha-ap133:5.2":"buddhamhi lokanāyake;","tha-ap133:5.3":"Kappānaṃ satasahassaṃ,","tha-ap133:5.4":"duggatiṃ na gamissati.","tha-ap133:6.1":"“‘Kilese jhāpayitvāna,","tha-ap133:6.2":"ekaggo susamāhito;","tha-ap133:6.3":"Sobhito nāma nāmena,","tha-ap133:6.4":"hessati satthu sāvako’.","tha-ap133:7.1":"“Paññāse kappasahasse,","tha-ap133:7.2":"sattevāsuṃ yasuggatā [samuggatā (syā.)];","tha-ap133:7.3":"Sattaratanasampannā,","tha-ap133:7.4":"cakkavattī mahabbalā.","tha-ap133:8.1":"“Kilesā jhāpitā mayhaṃ,","tha-ap133:8.2":"bhavā sabbe samūhatā;","tha-ap133:8.3":"Tisso vijjā anuppattā,","tha-ap133:8.4":"kataṃ buddhassa sāsanaṃ.","tha-ap133:9.1":"“Paṭisambhidā catasso,","tha-ap133:9.2":"vimokkhāpi ca aṭṭhime;","tha-ap133:9.3":"Chaḷabhiññā sacchikatā,","tha-ap133:9.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap133:10.1":"Itthaṃ sudaṃ āyasmā sobhito thero imā gāthāyo abhāsitthāti.","tha-ap133:11.1":"Sobhitattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2940,"to":2940,"paras":[{"para":2940,"vripara":"1","refs":["tha-ap133:1"],"lines":["So aparabhāge attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>padumuttaro nāma jino</b>tiādimāha.","Taṃ sabbaṃ heṭṭhā vuttanayattā suviññeyyamevāti."],"lineRefs":[["tha-ap133:1"],["tha-ap133:1"]]}],"wordLinks":[["tha-ap133:1.1","padumuttaro nāma jino",0,0]],"before":[{"para":2935,"vripara":null,"refs":[],"lines":["Padumapūjakattheraapadānavaṇṇanā samattā."],"lineRefs":[[]]},{"para":2936,"vripara":null,"refs":[],"lines":["Terasamavaggavaṇṇanā samattā."],"lineRefs":[[]]},{"para":2937,"vripara":null,"refs":[],"lines":["Sobhitavaggo"],"lineRefs":[[]]},{"para":2938,"vripara":null,"refs":[],"lines":["Sobhitattheraapadānavaṇṇanā"],"lineRefs":[[]]},{"para":2939,"vripara":null,"refs":[],"lines":["<b>Padumuttaro nāma jino</b>tiādikaṃ āyasmato sobhitattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto padumuttarassa bhagavato kāle ekasmiṃ kulagehe nibbatto viññutaṃ patto gharāvāsaṃ saṇṭhapetvā ekadivasaṃ satthārā dhamme desiyamāne somanassena pasannamānaso nānappakārehi thomesi.","So teneva somanassena kālaṃ katvā devesu nibbatto tattha dibbasukhaṃ anubhavitvā manussesu ca manussasukhaṃ anubhavitvā imasmiṃ buddhuppāde sāvatthiyaṃ kulagehe nibbatto sattavassikova pabbajitvā nacirasseva chaḷabhiñño arahā ahosi."],"lineRefs":[[],[],[]]}]},"tika":null,"tika2":null}
