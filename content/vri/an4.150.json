{"suttaId":"an4.150","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1213,1218],"vripara":"150"},"segments":{"an4.150:0.3":"Sārasuttaṃ","an4.150:1.1":"“Cattārome, bhikkhave, sārā.","an4.150:1.2":"Katame cattāro?","an4.150:1.3":"Sīlasāro, samādhisāro, paññāsāro, vimuttisāro –","an4.150:1.4":"ime kho, bhikkhave, cattāro sārā”ti.","an4.150:1.5":"Dasamaṃ.","an4.150:1.6":"Ābhāvaggo pañcamo.","an4.150:2.0":"Tassuddānaṃ –","an4.150:2.1":"Ābhā pabhā ca ālokā,","an4.150:2.2":"obhāsā ceva pajjotā;","an4.150:2.3":"Dve kālā caritā dve ca,","an4.150:2.4":"honti sārena te dasāti.","an4.150:2.5":"Tatiyapaṇṇāsakaṃ samattaṃ."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1456,"to":1458,"paras":[{"para":1456,"vripara":"149-150","refs":["an4.150:1"],"lines":["149-150. Navame <b>saṇhā vācā</b>ti mudukavācā.","<b>Mantabhāsā</b>ti mantasaṅkhātāya paññāya paricchinditvā kathitakathā.","Dasame <b>sīlasāro</b>ti sārasampāpakaṃ sīlaṃ.","Sesesupi eseva nayo."],"lineRefs":[["an4.150:1"],["an4.150:1"],["an4.150:1"],["an4.150:1"]]},{"para":1457,"vripara":null,"refs":["an4.150:1"],"lines":["Ābhāvaggo pañcamo."],"lineRefs":[["an4.150:1"]]},{"para":1458,"vripara":null,"refs":["an4.150:1"],"lines":["Tatiyapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an4.150:1"]]}],"wordLinks":[],"after":[{"para":1459,"vripara":"4","title":"Sucaritasuttādivaṇṇanā","lines":["Catutthapaṇṇāsakaṃ"]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1640,"to":1643,"paras":[{"para":1640,"vripara":"147-150","refs":["an4.150:1"],"lines":["147-150. Sattame paramatthato avijjamānasabhāvassa kālassa bhāvanādiyogo na sambhavatīti āha <b>“kālāti tasmiṃ tasmiṃ kāle dhammassavanādivasena pavattānaṃ kusaladhammānaṃ etaṃ adhivacanan”</b>ti.","Kālasahacaritā hi kusalā dhammā idha kāla-saddena gahitā aparassa asambhavato.","Aṭṭhamādīni uttānatthāneva."],"lineRefs":[["an4.150:1"],["an4.150:1"],["an4.150:1"]]},{"para":1641,"vripara":null,"refs":["an4.150:1"],"lines":["Dutiyakālasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an4.150:1"]]},{"para":1642,"vripara":null,"refs":["an4.150:1"],"lines":["Ābhāvaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an4.150:1"]]},{"para":1643,"vripara":null,"refs":["an4.150:1"],"lines":["Tatiyapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an4.150:1"]]}],"wordLinks":[],"after":[{"para":1644,"vripara":"4","title":"Dutiyakālasuttādivaṇṇanā","lines":["Catutthapaṇṇāsakaṃ"]}]},"tika2":null}
