{"suttaId":"tha-ap529","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3599,3616],"vripara":"42"},"segments":{"tha-ap529:0.3":"Girinelapūjakattheraapadānaṃ","tha-ap529:1.1":"“Migaluddo pure āsiṃ,","tha-ap529:1.2":"vipine vicaraṃ ahaṃ;","tha-ap529:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap529:1.4":"sabbadhammāna pāraguṃ.","tha-ap529:2.1":"“Tasmiṃ mahākāruṇike,","tha-ap529:2.2":"sabbasattahite rate;","tha-ap529:2.3":"Pasannacitto sumano,","tha-ap529:2.4":"nelapupphamapūjayiṃ.","tha-ap529:3.1":"“Ekatiṃse ito kappe,","tha-ap529:3.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap529:3.3":"Duggatiṃ nābhijānāmi,","tha-ap529:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap529:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap529:4.3":"viharāmi anāsavo.","tha-ap529:5.1":"“Svāgataṃ vata me āsi … pe …","tha-ap529:5.3":"kataṃ buddhassa sāsanaṃ.","tha-ap529:6.1":"“Paṭisambhidā catasso … pe …","tha-ap529:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap529:7.1":"Itthaṃ sudaṃ āyasmā girinelapūjako thero imā gāthāyo Abhāsitthāti.","tha-ap529:8.1":"Girinelapūjakattherassāpadānaṃ sattamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
