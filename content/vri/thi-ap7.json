{"suttaId":"thi-ap7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[6719,6750],"vripara":"60"},"segments":{"thi-ap7:0.3":"Kaṭacchubhikkhādāyikātherīapadānaṃ","thi-ap7:1.1":"“Piṇḍacāraṃ carantassa,","thi-ap7:1.2":"tissanāmassa satthuno;","thi-ap7:1.3":"Kaṭacchubhikkhaṃ paggayha,","thi-ap7:1.4":"buddhaseṭṭhassa dāsahaṃ. 61.","thi-ap7:2.1":"“Paṭiggahetvā sambuddho,","thi-ap7:2.2":"tisso lokagganāyako;","thi-ap7:2.3":"Vīthiyā saṇṭhito satthā,","thi-ap7:2.4":"akā me anumodanaṃ. 62.","thi-ap7:3.1":"“‘Kaṭacchubhikkhaṃ datvāna,","thi-ap7:3.2":"tāvatiṃsaṃ gamissasi;","thi-ap7:3.3":"Chattiṃsadevarājūnaṃ,","thi-ap7:3.4":"mahesittaṃ karissasi. 63.","thi-ap7:4.1":"“‘Paññāsaṃ cakkavattīnaṃ,","thi-ap7:4.2":"mahesittaṃ karissasi;","thi-ap7:4.3":"Manasā patthitaṃ sabbaṃ,","thi-ap7:4.4":"paṭilacchasi sabbadā. 64.","thi-ap7:5.1":"“‘Sampattiṃ anubhotvāna,","thi-ap7:5.2":"pabbajissasikiñcanā;","thi-ap7:5.3":"Sabbāsave pariññāya,","thi-ap7:5.4":"nibbāyissasināsavā’. 65.","thi-ap7:6.1":"“Idaṃ vatvāna sambuddho,","thi-ap7:6.2":"tisso lokagganāyako;","thi-ap7:6.3":"Nabhaṃ abbhuggamī vīro,","thi-ap7:6.4":"haṃsarājāva ambare. 66.","thi-ap7:7.1":"“Sudinnaṃ me dānavaraṃ [sudinnameva me dānaṃ (syā.)],","thi-ap7:7.2":"suyiṭṭhā yāgasampadā;","thi-ap7:7.3":"Kaṭacchubhikkhaṃ datvāna,","thi-ap7:7.4":"pattāhaṃ acalaṃ padaṃ. 67.","thi-ap7:8.1":"“Dvenavute ito kappe,","thi-ap7:8.2":"yaṃ dānamadadiṃ tadā;","thi-ap7:8.3":"Duggatiṃ nābhijānāmi,","thi-ap7:8.4":"bhikkhādānassidaṃ phalaṃ. 68.","thi-ap7:9.1":"“Kilesā jhāpitā mayhaṃ…pe…","thi-ap7:9.3":"viharāmi anāsavā. 69.","thi-ap7:10.1":"“Svāgataṃ vata me āsi…pe…","thi-ap7:10.3":"kataṃ buddhassa sāsanaṃ. 70.","thi-ap7:11.1":"“Paṭisambhidā catasso…pe…","thi-ap7:11.3":"kataṃ buddhassa sāsanaṃ”.","thi-ap7:12.1":"Itthaṃ sudaṃ kaṭacchubhikkhādāyikā bhikkhunī imā gāthāyo abhāsitthāti.","thi-ap7:13.1":"Kaṭacchubhikkhādāyikātheriyāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
