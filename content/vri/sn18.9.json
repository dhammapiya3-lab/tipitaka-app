{"suttaId":"sn18.9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1195,1195],"vripara":"196"},"segments":{"sn18.9:0.3":"Dhātusuttaṃ","sn18.9:1.1":"Sāvatthiyaṃ viharati … pe …","sn18.9:1.2":"“taṃ kiṃ maññasi, rāhula,","sn18.9:1.3":"pathavīdhātu niccā vā aniccā vā”ti?","sn18.9:1.4":"“Aniccā, bhante”… pe …","sn18.9:1.5":"“āpodhātu … pe …","sn18.9:1.6":"tejodhātu …","sn18.9:1.7":"vāyodhātu …","sn18.9:1.8":"ākāsadhātu …","sn18.9:1.9":"viññāṇadhātu niccā vā aniccā vā”ti?","sn18.9:1.10":"“Aniccā, bhante”… pe …","sn18.9:1.11":"“evaṃ passaṃ, rāhula, sutavā ariyasāvako pathavīdhātuyāpi nibbindati … pe … āpodhātuyāpi nibbindati … tejodhātuyāpi nibbindati … vāyodhātuyāpi nibbindati … ākāsadhātuyāpi nibbindati … viññāṇadhātuyāpi nibbindati … pe …","sn18.9:1.12":"pajānātī”ti.","sn18.9:1.13":"Navamaṃ."},"unsure":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":837,"to":838,"paras":[{"para":837,"vripara":"196","refs":["sn18.9:1"],"lines":["Navame viññāṇadhātuvasena nāmaṃ, sesāhi rūpanti nāmarūpaṃ kathitaṃ.","Navamaṃ."],"lineRefs":[["sn18.9:1"],["sn18.9:1"]]},{"para":838,"vripara":null,"refs":["sn18.9:1"],"lines":["Khandhasuttavaṇṇanā"],"lineRefs":[["sn18.9:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":859,"to":861,"paras":[{"para":859,"vripara":"196","refs":["sn18.9:1"],"lines":["Ākāsadhātu rūpaparicchedatāya rūpapariyāpannanti adhippāyena <b>“sesāhi rūpan”</b>ti vuttaṃ.","<b>Nāmarūpan</b>ti tebhūmakaṃ nāmaṃ rūpañca kathitaṃ."],"lineRefs":[["sn18.9:1"],["sn18.9:1"]]},{"para":860,"vripara":null,"refs":["sn18.9:1"],"lines":["Dhātusuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn18.9:1"]]},{"para":861,"vripara":null,"refs":["sn18.9:1"],"lines":["Khandhasuttavaṇṇanā"],"lineRefs":[["sn18.9:1"]]}],"wordLinks":[]},"tika2":null}
