{"suttaId":"sn45.163","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[359,359],"vripara":"163"},"segments":{"sn45.163:0.3":"Āsavasuttaṃ","sn45.163:1.1":"“Tayome, bhikkhave, āsavā.","sn45.163:1.2":"Katame tayo?","sn45.163:1.3":"Kāmāsavo, bhavāsavo, avijjāsavo –","sn45.163:1.4":"ime kho, bhikkhave, tayo āsavā.","sn45.163:1.5":"Imesaṃ kho, bhikkhave, tiṇṇannaṃ āsavānaṃ abhiññāya pariññāya parikkhayāya pahānāya … pe … ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.163:1.6":"Tatiyaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":114,"to":117,"paras":[{"para":114,"vripara":"162-171","refs":["sn45.163:1"],"lines":["162-171. <b>Vidhā</b>ti mānakoṭṭhāsā mānaṭhapanā vā.","<b>Seyyohamasmīti vidhā</b>ti ahamasmi seyyoti evaṃ mānakoṭṭhāso mānaṭhapanā vā.","<b>Nīghā</b>ti dukkhā.","Vacanattho panettha yassa uppajjanti, taṃ purisaṃ nīhanantīti nīghā.","Sesamettha uttānamevāti."],"lineRefs":[["sn45.163:1"],["sn45.163:1"],["sn45.163:1"],["sn45.163:1"],["sn45.163:1"]]},{"para":115,"vripara":null,"refs":["sn45.163:1"],"lines":["Esanāvaggo dasamo."],"lineRefs":[["sn45.163:1"]]},{"para":116,"vripara":null,"refs":["sn45.163:1"],"lines":["Oghavaggo"],"lineRefs":[["sn45.163:1"]]},{"para":117,"vripara":null,"refs":["sn45.163:1"],"lines":["1-2. Oghasuttādivaṇṇanā"],"lineRefs":[["sn45.163:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":114,"to":117,"paras":[{"para":114,"vripara":"162-171","refs":["sn45.163:1"],"lines":["162-171. Seyyohamasmītiādinā taṃtaṃvibhāgena dhīyanti vidhīyantīti <b>vidhā,</b> mānakoṭṭhāsā, mānaṭṭhapanā vā.","<b>Nīhanantī</b>ti vibādhenti."],"lineRefs":[["sn45.163:1"],["sn45.163:1"]]},{"para":115,"vripara":null,"refs":["sn45.163:1"],"lines":["Esanāvaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn45.163:1"]]},{"para":116,"vripara":null,"refs":["sn45.163:1"],"lines":["Oghavaggo"],"lineRefs":[["sn45.163:1"]]},{"para":117,"vripara":null,"refs":["sn45.163:1"],"lines":["1-2. Oghasuttādivaṇṇanā"],"lineRefs":[["sn45.163:1"]]}],"wordLinks":[]},"tika2":null}
