{"suttaId":"thag1.85","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[493,496],"vripara":"85"},"segments":{"thag1.85:0.4":"Sunāgattheragāthā","thag1.85:1.1":"“Cittanimittassa kovido, pavivekarasaṃ vijāniya;","thag1.85:1.3":"Jhāyaṃ nipako patissato, adhigaccheyya sukhaṃ nirāmisan”ti.","thag1.85:1.5":"… Sunāgo thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2211,"to":2211,"paras":[{"para":2211,"vripara":null,"refs":["thag1.85:1"],"lines":["Tattha <b>cittanimittassa kovido</b>ti bhāvanācittassa nimittaggahaṇe kusalo,“imasmiṃ samaye cittaṃ paggahetabbaṃ, imasmiṃ sampahaṃsitabbaṃ, imasmiṃ ajjhupekkhitabban”ti evaṃ paggahaṇādiyogyassa cittanimittassa gahaṇe cheko.","<b>Pavivekarasaṃ vijāniyā</b>ti kāyavivekasaṃvaḍḍhitassa cittavivekassa rasaṃ sañjānitvā, vivekasukhaṃ anubhavitvāti attho.","“Pavivekarasaṃ pitvā”ti (dha. pa.205) hi vuttaṃ.","<b>Jhāyan</b>ti paṭhamaṃ ārammaṇūpanijjhānena pacchā lakkhaṇūpanijjhānena ca jhāyanto.","<b>Nipako</b>ti kammaṭṭhānapariharaṇe kusalo.","<b>Patissato</b>ti upaṭṭhitassati.","<b>Adhigaccheyya sukhaṃ nirāmisan</b>ti evaṃ samathanimittādikosallena labbhe cittavivekasukhe patiṭṭhāya sato sampajāno hutvā vipassanājhāneneva jhāyanto kāmāmisavaṭṭāmisehi asammissatāya nirāmisaṃ nibbānasukhaṃ phalasukhañca adhigaccheyya samupagaccheyyāti attho."],"lineRefs":[["thag1.85:1"],["thag1.85:1"],["thag1.85:1"],["thag1.85:1"],["thag1.85:1"],["thag1.85:1"],["thag1.85:1"]]}],"wordLinks":[["thag1.85:1.1","cittanimittassa kovido",0,0],["thag1.85:1.1","pavivekarasaṃ vijāniyā",0,1],["thag1.85:1.3","jhāyaṃ",0,3],["thag1.85:1.3","nipako",0,4],["thag1.85:1.3","patissato",0,5],["thag1.85:1.3","adhigaccheyya sukhaṃ nirāmisaṃ",0,6]],"before":[{"para":2173,"vripara":null,"refs":[],"lines":["Evaṃ pana satthārā gāthāya kathitāya thero saṃvegajāto vipassanaṃ paṭṭhapetvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.14.26-33)–"],"lineRefs":[[],[]]},{"para":2174,"vripara":null,"refs":[],"lines":["“Sunando nāma nāmena, brāhmaṇo mantapāragū;"],"lineRefs":[[]]},{"para":2175,"vripara":null,"refs":[],"lines":["Ajjhāyako yācayogo, vājapeyyaṃ ayājayi."],"lineRefs":[[]]},{"para":2176,"vripara":null,"refs":[],"lines":["“Padumuttaro lokavidū, aggo kāruṇiko isi;"],"lineRefs":[[]]},{"para":2177,"vripara":null,"refs":[],"lines":["Janataṃ anukampanto, ambare caṅkamī tadā."],"lineRefs":[[]]},{"para":2178,"vripara":null,"refs":[],"lines":["“Caṅkamitvāna sambuddho, sabbaññū lokanāyako;"],"lineRefs":[[]]},{"para":2179,"vripara":null,"refs":[],"lines":["Mettāya aphari satte, appamāṇe nirūpadhi."],"lineRefs":[[]]},{"para":2180,"vripara":null,"refs":[],"lines":["“Vaṇṭe chetvāna pupphāni, brāhmaṇo mantapāragū;"],"lineRefs":[[]]},{"para":2181,"vripara":null,"refs":[],"lines":["Sabbe sisse samānetvā, ākāse ukkhipāpayi."],"lineRefs":[[]]},{"para":2182,"vripara":null,"refs":[],"lines":["“Yāvatā nagaraṃ āsi, pupphānaṃ chadanaṃ tadā;"],"lineRefs":[[]]},{"para":2183,"vripara":null,"refs":[],"lines":["Buddhassa ānubhāvena, sattāhaṃ na vigacchatha."],"lineRefs":[[]]},{"para":2184,"vripara":null,"refs":[],"lines":["“Teneva sukkamūlena, anubhotvāna sampadā;"],"lineRefs":[[]]},{"para":2185,"vripara":null,"refs":[],"lines":["Sabbāsave pariññāya, tiṇṇo loke visattikaṃ."],"lineRefs":[[]]},{"para":2186,"vripara":null,"refs":[],"lines":["“Ekārase kappasate, pañcatiṃsāsu khattiyā;"],"lineRefs":[[]]},{"para":2187,"vripara":null,"refs":[],"lines":["Ambaraṃsasanāmā te, cakkavattī mahabbalā."],"lineRefs":[[]]},{"para":2188,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":2189,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā thero aññaṃ byākaronto tameva gāthaṃ paccudāhāsi."],"lineRefs":[[]]},{"para":2190,"vripara":null,"refs":[],"lines":["Nītattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2191,"vripara":null,"refs":[],"lines":["Sunāgattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":2192,"vripara":null,"refs":[],"lines":["<b>Cittanimittassa kovido</b>ti āyasmato sunāgattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinanto ito ekattiṃse kappe sikhissa bhagavato kāle brāhmaṇakule nibbattitvā vayappatto tiṇṇaṃ vedānaṃ pāragū hutvā araññāyatane assame vasanto tīṇi brāhmaṇasahassāni mante vācesi.","Athekadivasaṃ tassa satthāraṃ disvā lakkhaṇāni upadhāretvā lakkhaṇamante parivattentassa,“īdisehi lakkhaṇehi samannāgato anantajino anantañāṇo buddho bhavissatī”ti buddhañāṇaṃ ārabbha uḷāro pasādo uppajji.","So tena cittappasādena devaloke nibbatto aparāparaṃ devamanussesu saṃsaranto imasmiṃ buddhuppāde nālakagāme aññatarassa brāhmaṇassa putto hutvā nibbatti, <b>sunāgo</b>tissa nāmaṃ ahosi.","So dhammasenāpatissa gihisahāyo therassa santikaṃ gantvā dhammaṃ sutvā dassanabhūmiyaṃ patiṭṭhito pabbajitvā vipassanaṃ paṭṭhapetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.14.34-40)–"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":2193,"vripara":null,"refs":[],"lines":["“Himavantassāvidūre, vasabho nāma pabbato;"],"lineRefs":[[]]},{"para":2194,"vripara":null,"refs":[],"lines":["Tasmiṃ pabbatapādamhi, assamo āsi māpito."],"lineRefs":[[]]},{"para":2195,"vripara":null,"refs":[],"lines":["“Tīṇi sissasahassāni, vācesiṃ brāhmaṇo tadā;"],"lineRefs":[[]]},{"para":2196,"vripara":null,"refs":[],"lines":["Saṃharitvāna te sisse, ekamantaṃ upāvisiṃ."],"lineRefs":[[]]},{"para":2197,"vripara":null,"refs":[],"lines":["“Ekamantaṃ nisīditvā, brāhmaṇo mantapāragū;"],"lineRefs":[[]]},{"para":2198,"vripara":null,"refs":[],"lines":["Buddhavedaṃ gavesanto, ñāṇe cittaṃ pasādayiṃ."],"lineRefs":[[]]},{"para":2199,"vripara":null,"refs":[],"lines":["“Tattha cittaṃ pasādetvā, nisīdiṃ paṇṇasanthare;"],"lineRefs":[[]]},{"para":2200,"vripara":null,"refs":[],"lines":["Pallaṅkaṃ ābhujitvāna, tattha kālaṅkato ahaṃ."],"lineRefs":[[]]},{"para":2201,"vripara":null,"refs":[],"lines":["“Ekatiṃse ito kappe, yaṃ saññamalabhiṃ tadā;"],"lineRefs":[[]]},{"para":2202,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, ñāṇasaññāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":2203,"vripara":null,"refs":[],"lines":["“Sattavīsati kappamhi, rājā siridharo ahu;"],"lineRefs":[[]]},{"para":2204,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":2205,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":2206,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā bhikkhūnaṃ dhammadesanāpadesena aññaṃ byākaronto –"],"lineRefs":[[]]},{"para":2208,"vripara":"85","refs":[],"lines":["“Cittanimittassa kovido, pavivekarasaṃ vijāniya;"],"lineRefs":[[]]},{"para":2209,"vripara":null,"refs":[],"lines":["Jhāyaṃ nipako patissato, adhigaccheyya sukhaṃ nirāmisan”ti.","–"],"lineRefs":[[],[]]},{"para":2210,"vripara":null,"refs":[],"lines":["Gāthaṃ abhāsi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
