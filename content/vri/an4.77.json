{"suttaId":"an4.77","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[844,844],"vripara":"77"},"segments":{"an4.77:0.3":"Acinteyyasuttaṃ","an4.77:1.1":"“Cattārimāni, bhikkhave, acinteyyāni, na cintetabbāni; yāni cintento ummādassa vighātassa bhāgī assa.","an4.77:1.2":"Katamāni cattāri?","an4.77:1.3":"Buddhānaṃ, bhikkhave, buddhavisayo acinteyyo, na cintetabbo;","an4.77:1.4":"yaṃ cintento ummādassa vighātassa bhāgī assa.","an4.77:1.5":"Jhāyissa, bhikkhave, jhānavisayo acinteyyo, na cintetabbo;","an4.77:1.6":"yaṃ cintento ummādassa vighātassa bhāgī assa.","an4.77:1.7":"Kammavipāko, bhikkhave, acinteyyo, na cintetabbo;","an4.77:1.8":"yaṃ cintento ummādassa vighātassa bhāgī assa.","an4.77:1.9":"Lokacintā, bhikkhave, acinteyyā, na cintetabbā;","an4.77:1.10":"yaṃ cintento ummādassa vighātassa bhāgī assa.","an4.77:1.11":"Imāni kho, bhikkhave, cattāri acinteyyāni, na cintetabbāni; yāni cintento ummādassa vighātassa bhāgī assā”ti.","an4.77:1.12":"Sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1321,"to":1321,"paras":[{"para":1321,"vripara":"77","refs":["an4.77:1"],"lines":["Sattame <b>acinteyyānī</b>ti cintetuṃ ayuttāni.","<b>Na cintetabbānī</b>ti acinteyyattāyeva na cintetabbāni.","<b>Yāni cintento</b>ti yāni kāraṇāni cintento.","<b>Ummādassā</b>ti ummattakabhāvassa.","<b>Vighātassā</b>ti dukkhassa.","<b>Buddhavisayo</b>ti buddhānaṃ visayo, sabbaññutaññāṇādīnaṃ buddhaguṇānaṃ pavatti ca ānubhāvo ca.","<b>Jhānavisayo</b>ti abhiññājhānavisayo.","<b>Kammavipāko</b>ti diṭṭhadhammavedanīyādīnaṃ kammānaṃ vipāko.","<b>Lokacintā</b>ti “kena nu kho candimasūriyā katā, kena mahāpathavī, kena mahāsamuddo, kena sattā uppāditā, kena pabbatā, kena ambatālanāḷikerādayo”ti evarūpā lokacintā. 8."],"lineRefs":[["an4.77:1"],["an4.77:1"],["an4.77:1"],["an4.77:1"],["an4.77:1"],["an4.77:1"],["an4.77:1"],["an4.77:1"],["an4.77:1"]]}],"wordLinks":[["an4.77:1.1","acinteyyānī",0,0],["an4.77:1.9","acinteyyānī",0,0],["an4.77:1.11","acinteyyānī",0,0],["an4.77:1.1","na cintetabbānī",0,1],["an4.77:1.11","na cintetabbānī",0,1],["an4.77:1.1","yāni cintento",0,2],["an4.77:1.11","yāni cintento",0,2],["an4.77:1.1","ummādassā",0,3],["an4.77:1.4","ummādassā",0,3],["an4.77:1.6","ummādassā",0,3],["an4.77:1.8","ummādassā",0,3],["an4.77:1.10","ummādassā",0,3],["an4.77:1.11","ummādassā",0,3],["an4.77:1.1","vighātassā",0,4],["an4.77:1.4","vighātassā",0,4],["an4.77:1.6","vighātassā",0,4],["an4.77:1.8","vighātassā",0,4],["an4.77:1.10","vighātassā",0,4],["an4.77:1.11","vighātassā",0,4],["an4.77:1.3","buddhavisayo",0,5],["an4.77:1.5","jhānavisayo",0,6],["an4.77:1.7","kammavipāko",0,7],["an4.77:1.9","lokacintā",0,8]],"before":[{"para":1320,"vripara":null,"title":"Acinteyyasuttavaṇṇanā","lines":["Acinteyyasuttavaṇṇanā 77."]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1501,"to":1501,"paras":[{"para":1501,"vripara":"77","refs":["an4.77:1"],"lines":["Sattame <b>lokacintā</b>ti lokasannivesappaṭisaṃyuttā vīmaṃsā.","Tenāha <b>“kena nu kho candimasūriyā”</b>tiādi.","<b>Nāḷikerādayo</b>ti <b>ādi</b>-saddena avuttānaṃ osadhitiṇavanappatiādīnaṃ saṅgaho.","<b>Evarūpā lokacintā</b>ti edisā vuttasadisā aññāpi sā lokacintā."],"lineRefs":[["an4.77:1"],["an4.77:1"],["an4.77:1"],["an4.77:1"]]}],"wordLinks":[["an4.77:1.9","lokacintā",0,0]],"before":[{"para":1500,"vripara":null,"title":"Acinteyyasuttavaṇṇanā","lines":["Acinteyyasuttavaṇṇanā 77."]}],"after":[{"para":1502,"vripara":null,"title":"Acinteyyasuttavaṇṇanā","lines":["Acinteyyasuttavaṇṇanā niṭṭhitā. 8."]}]},"tika2":null}
