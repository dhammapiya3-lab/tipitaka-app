{"suttaId":"thig5.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[348,363],"vripara":"82"},"segments":{"thig5.4:0.3":"Sundarīnandātherīgāthā","thig5.4:1.1":"“Āturaṃ asuciṃ pūtiṃ,","thig5.4:1.2":"passa nande samussayaṃ;","thig5.4:1.3":"Asubhāya cittaṃ bhāvehi,","thig5.4:1.4":"ekaggaṃ susamāhitaṃ.","thig5.4:2.1":"“Yathā idaṃ tathā etaṃ,","thig5.4:2.2":"yathā etaṃ tathā idaṃ;","thig5.4:2.3":"Duggandhaṃ pūtikaṃ vāti,","thig5.4:2.4":"bālānaṃ abhinanditaṃ.","thig5.4:3.1":"“Evametaṃ avekkhantī,","thig5.4:3.2":"rattindivamatanditā;","thig5.4:3.3":"Tato sakāya paññāya,","thig5.4:3.4":"abhinibbijjha [abhinibbijja (sī. syā.)] dakkhisaṃ.","thig5.4:4.1":"“Tassā me appamattāya,","thig5.4:4.2":"vicinantiyā yoniso;","thig5.4:4.3":"Yathābhūtaṃ ayaṃ kāyo,","thig5.4:4.4":"diṭṭho santarabāhiro.","thig5.4:5.1":"“Atha nibbindahaṃ kāye,","thig5.4:5.2":"ajjhattañca virajjahaṃ;","thig5.4:5.3":"Appamattā visaṃyuttā,","thig5.4:5.4":"upasantāmhi nibbutā”ti.","thig5.4:6.1":"… Sundarīnandā therī …."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1308,"to":1309,"paras":[{"para":1308,"vripara":null,"refs":["thig5.4:5"],"lines":["Tenāha <b>“tassā me appamattāyā”</b>tiādi.","Tassattho – tassā me satiavippavāsena <b>appamattāya yoniso</b> upāyena aniccādivasena vipassanāpaññāya <b>vicinantiyā</b> vīmaṃsantiyā, <b>ayaṃ</b> khandhapañcakasaṅkhāto <b>kāyo</b> sasantānaparasantānavibhāgato <b>santarabāhiro</b> yathābhūtaṃ diṭṭho."],"lineRefs":[["thig5.4:5"],["thig5.4:5"]]},{"para":1309,"vripara":null,"refs":["thig5.4:5"],"lines":["<b>Atha</b> tathā dassanato pacchā <b>nibbindahaṃ kāye</b> vipassanāpaññāsahitāya maggapaññāya attabhāve nibbindiṃ, visesatova ajjhattasantāne <b>virajji</b> virāgaṃ āpajjiṃ, ahaṃ yathābhūtāya appamādapaṭipattiyā matthakappattiyā <b>appamattā</b> sabbaso saṃyojanānaṃ samucchinnattā <b>visaṃyuttā</b> upasantā ca nibbutā ca amhīti."],"lineRefs":[["thig5.4:5"]]}],"wordLinks":[["thig5.4:5.1","kāyo",0,1],["thig5.4:5.1","atha",1,0],["thig5.4:5.1","nibbindahaṃ kāye",1,0],["thig5.4:5.1","virajji",1,0],["thig5.4:5.3","appamattā",1,0],["thig5.4:5.3","visaṃyuttā",1,0]],"before":[{"para":1179,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Sundarīnandātherīgāthāvaṇṇanā"]},{"para":1180,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["<b>Āturaṃ asucin</b>tiādikā sundarīnandāya theriyā gāthā.","Ayampi kira padumuttarassa bhagavato kāle haṃsavatīnagare kulagehe nibbattitvā viññutaṃ patvā, satthu santike dhammaṃ suṇantī satthāraṃ ekaṃ bhikkhuniṃ jhāyinīnaṃ aggaṭṭhāne ṭhapentaṃ disvā adhikārakammaṃ katvā taṃ ṭhānantaraṃ patthetvā kusalaṃ upacinantī kappasatasahassaṃ devamanussesu saṃsarantī imasmiṃ buddhuppāde sakyarājakule nibbatti.","<b>Nandā</b>tissā nāmaṃ akaṃsu.","Aparabhāge rūpasampattiyā sundarīnandā, janapadakalyāṇīti ca paññāyittha.","Sā amhākaṃ bhagavati sabbaññutaṃ patvā anupubbena kapilavatthuṃ gantvā nandakumārañca rāhulakumārañca pabbājetvā gate suddhodanamahārāje ca parinibbute mahāpajāpatigotamiyā rāhulamātāya ca pabbajitāya cintesi –","“mayhaṃ jeṭṭhabhātā cakkavattirajjaṃ pahāya pabbajitvā loke aggapuggalo buddho jāto, puttopissa rāhulakumāro pabbaji, bhattāpi me nandarājā, mātāpi mahāpajāpatigotamī, bhaginīpi rāhulamātā pabbajitā, idānāhaṃ gehe kiṃ karissāmi, pabbajissāmī”ti bhikkhunupassayaṃ gantvā ñātisinehena pabbaji, no saddhāya.","Tasmā pabbajitvāpi rūpaṃ nissāya uppannamadā.","“Satthā rūpaṃ vivaṇṇeti garahati, anekapariyāyena rūpe ādīnavaṃ dassetī”ti buddhupaṭṭhānaṃ na gacchatītiādi sabbaṃ heṭṭhā abhirūpanandāya vatthusmiṃ vuttanayeneva veditabbaṃ.","Ayaṃ pana viseso – satthārā nimmitaṃ itthirūpaṃ anukkamena jarābhibhūtaṃ disvā aniccato dukkhato anattato manasikarontiyā theriyā kammaṭṭhānābhimukhaṃ cittaṃ ahosi.","Taṃ disvā satthā tassā sappāyavasena dhammaṃ desento –"]},{"para":1182,"vripara":"82","title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Āturaṃ asuciṃ pūtiṃ, passa nande samussayaṃ;"]},{"para":1183,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ."]},{"para":1185,"vripara":"83","title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Yathā idaṃ tathā etaṃ, yathā etaṃ tathā idaṃ;"]},{"para":1186,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Duggandhaṃ pūtikaṃ vāti, bālānaṃ abhinanditaṃ."]},{"para":1188,"vripara":"84","title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Evametaṃ avekkhantī, rattindivamatanditā;"]},{"para":1189,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tato sakāya paññāya, abhinibbijjha dakkhisan”ti.","–"]},{"para":1190,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Imā tisso gāthā abhāsi."]},{"para":1191,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Sā desanānusārena ñāṇaṃ pesetvā sotāpattiphale patiṭṭhahi.","Tassā uparimaggatthāya kammaṭṭhānaṃ ācikkhanto “nande, imasmiṃ sarīre appamattakopi sāro natthi, maṃsalohitalepano jarādīnaṃ vāsabhūto, aṭṭhipuñjamatto evāyan”ti dassetuṃ –"]},{"para":1192,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Aṭṭhinaṃ nagaraṃ kataṃ, maṃsalohitalepanaṃ;"]},{"para":1193,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Yattha jarā ca maccu ca, māno makkho ca ohito”ti.(dha. pa.150)–"]},{"para":1194,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["<b>Dhammapade</b> imaṃ gāthamāha."]},{"para":1195,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Sā desanāvasāne arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.3.166-219)–"]},{"para":1196,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Padumuttaro nāma jino, sabbadhammāna pāragū;"]},{"para":1197,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Ito satasahassamhi, kappe uppajji nāyako."]},{"para":1198,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Ovādako viññāpako, tārako sabbapāṇinaṃ;"]},{"para":1199,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Desanākusalo buddho, tāresi janataṃ bahuṃ."]},{"para":1200,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Anukampako kāruṇiko, hitesī sabbapāṇinaṃ;"]},{"para":1201,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Sampatte titthiye sabbe, pañcasīle patiṭṭhapi."]},{"para":1202,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Evaṃ nirākulaṃ āsi, suññataṃ titthiyehi ca;"]},{"para":1203,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Vicittaṃ arahantehi, vasībhūtehi tādibhi."]},{"para":1204,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Ratanānaṭṭhapaññāsaṃ, uggatova mahāmuni;"]},{"para":1205,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Kañcanagghiyasaṅkāso, bāttiṃsavaralakkhaṇo."]},{"para":1206,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Vassasatasahassāni, āyu vijjati tāvade;"]},{"para":1207,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."]},{"para":1208,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tadāhaṃ haṃsavatiyaṃ, jātā seṭṭhikule ahuṃ;"]},{"para":1209,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Nānāratanapajjote, mahāsukhasamappitā."]},{"para":1210,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Upetvā taṃ mahāvīraṃ, assosiṃ dhammadesanaṃ;"]},{"para":1211,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Amataṃ paramassādaṃ, paramatthanivedakaṃ."]},{"para":1212,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tadā nimantayitvāna, sasaṅghaṃ lokanāyakaṃ;"]},{"para":1213,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Datvā tassa mahādānaṃ, pasannā sehi pāṇibhi."]},{"para":1214,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Jhāyinīnaṃ bhikkhunīnaṃ, aggaṭṭhānamapatthayiṃ;"]},{"para":1215,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Nipacca sirasā dhīraṃ, sasaṅghaṃ lokanāyakaṃ."]},{"para":1216,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tadā adantadamako, tilokasaraṇo pabhū;"]},{"para":1217,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Byākāsi narasārathi, lacchase taṃ supatthitaṃ."]},{"para":1218,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Satasahassito kappe, okkākakulasambhavo;"]},{"para":1219,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Gotamo nāma gottena, satthā loke bhavissati."]},{"para":1220,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tassa dhammesu dāyādā, orasā dhammanimmitā;"]},{"para":1221,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Nandāti nāma nāmena, hessati satthu sāvikā."]},{"para":1222,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Taṃ sutvā muditā hutvā, yāvajīvaṃ tadā jinaṃ;"]},{"para":1223,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Mettacittā paricariṃ, paccayehi vināyakaṃ."]},{"para":1224,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"]},{"para":1225,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."]},{"para":1226,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tato cutā yāmamagaṃ, tatohaṃ tusitaṃ gatā;"]},{"para":1227,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tato ca nimmānaratiṃ, vasavattipuraṃ tato."]},{"para":1228,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Yattha yatthūpapajjāmi, tassa kammassa vāhasā;"]},{"para":1229,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tattha tattheva rājūnaṃ, mahesittamakārayiṃ."]},{"para":1230,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tato cutā manussatte, rājānaṃ cakkavattinaṃ;"]},{"para":1231,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Maṇḍalīnañca rājūnaṃ, mahesittamakārayiṃ."]},{"para":1232,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Sampattiṃ anubhotvāna, devesu manujesu ca;"]},{"para":1233,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Sabbattha sukhitā hutvā, nekakappesu saṃsariṃ."]},{"para":1234,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Pacchime bhave sampatte, suramme kapilavhaye;"]},{"para":1235,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Rañño suddhodanassāhaṃ, dhītā āsiṃ aninditā."]},{"para":1236,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Siriyā rūpiniṃ disvā, nanditaṃ āsi taṃ kulaṃ;"]},{"para":1237,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tena nandāti me nāmaṃ, sundaraṃ pavaraṃ ahu."]},{"para":1238,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Yuvatīnañca sabbāsaṃ, kalyāṇīti ca vissutā;"]},{"para":1239,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tasmimpi nagare ramme, ṭhapetvā taṃ yasodharaṃ."]},{"para":1240,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Jeṭṭho bhātā tilokaggo, pacchimo arahā tathā;"]},{"para":1241,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Ekākinī gahaṭṭhāhaṃ, mātarā paricoditā."]},{"para":1242,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Sākiyamhi kule jātā, putte buddhānujā tuvaṃ;"]},{"para":1243,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Nandenapi vinā bhūtā, agāre kinnu acchasi."]},{"para":1244,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Jarāvasānaṃ yobbaññaṃ, rūpaṃ asucisammataṃ;"]},{"para":1245,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Rogantamapicārogyaṃ, jīvitaṃ maraṇantikaṃ."]},{"para":1246,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Idampi te subhaṃ rūpaṃ, sasīkantaṃ manoharaṃ;"]},{"para":1247,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Bhūsanānaṃ alaṅkāraṃ, sirisaṅghāṭasaṃnibhaṃ."]},{"para":1248,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Puñjitaṃ lokasāraṃva, nayanānaṃ rasāyanaṃ;"]},{"para":1249,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Puññānaṃ kittijananaṃ, ukkākakulanandanaṃ."]},{"para":1250,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Na cireneva kālena, jarā samadhisessati;"]},{"para":1251,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Vihāya gehaṃ kāruññe, cara dhammamanindite."]},{"para":1252,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Sutvāhaṃ mātu vacanaṃ, pabbajiṃ anagāriyaṃ;"]},{"para":1253,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Dehena natu cittena, rūpayobbanalāḷitā."]},{"para":1254,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Mahatā ca payattena, jhānajjhena paraṃ mama;"]},{"para":1255,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Kātuñca vadate mātā, na cāhaṃ tattha ussukā."]},{"para":1256,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tato mahākāruṇiko, disvā maṃ kāmalālasaṃ;"]},{"para":1257,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Nibbandanatthaṃ rūpasmiṃ, mama cakkhupathe jino."]},{"para":1258,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Sakena ānubhāvena, itthiṃ māpesi sobhiniṃ;"]},{"para":1259,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Dassanīyaṃ suruciraṃ, mamatopi surūpiniṃ."]},{"para":1260,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tamahaṃ vimhitā disvā, ativimhitadehiniṃ;"]},{"para":1261,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Cintayiṃ saphalaṃ meti, nettalābhañca mānusaṃ."]},{"para":1262,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tamahaṃ ehi subhage, yenattho taṃ vadehi me;"]},{"para":1263,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Kulaṃ te nāmagottañca, vada me yadi te piyaṃ."]},{"para":1264,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Na vañcakālo subhage, ucchaṅge maṃ nivāsaya;"]},{"para":1265,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Sīdantīva mamaṅgāni, pasuppayamuhuttakaṃ."]},{"para":1266,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tato sīsaṃ mamaṅge sā, katvā sayi sulocanā;"]},{"para":1267,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tassā nalāṭe patitā, luddhā paramadāruṇā."]},{"para":1268,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Saha tassā nipātena, piḷakā upapajjatha;"]},{"para":1269,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Pagghariṃsu pabhinnā ca, kuṇapā pubbalohitā."]},{"para":1270,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Pabhinnaṃ vadanañcāpi, kuṇapaṃ pūtigandhanaṃ;"]},{"para":1271,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Uddhumātaṃ vinilañca, pubbañcāpi sarīrakaṃ."]},{"para":1272,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Sā paveditasabbaṅgī, nissasantī muhuṃ muhuṃ;"]},{"para":1273,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Vedayantī sakaṃ dukkhaṃ, karuṇaṃ paridevayi."]},{"para":1274,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Dukkhena dukkhitā homi, phusayanti ca vedanā;"]},{"para":1275,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Mahādukkhe nimuggamhi, saraṇaṃ hohi me sakhī."]},{"para":1276,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Kuhiṃ vadanasotaṃ te, kuhiṃ te tuṅganāsikā;"]},{"para":1277,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tambabimbavaroṭṭhante, vadanaṃ te kuhiṃ gataṃ."]},{"para":1278,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Kuhiṃ sasīnibhaṃ vaṇṇaṃ, kambugīvā kuhiṃ gatā;"]},{"para":1279,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Doḷā lolāva te kaṇṇā, vevaṇṇaṃ samupāgatā."]},{"para":1280,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Makuḷakhārakākārā, kalikāva payodharā;"]},{"para":1281,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Pabhinnā pūtikuṇapā, duṭṭhagandhittamāgatā."]},{"para":1282,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Vedimajjhāva sussoṇī, sūnāva nītakibbisā;"]},{"para":1283,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Jātā amajjhabharitā, aho rūpamasassataṃ."]},{"para":1284,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Sabbaṃ sarīrasañjātaṃ, pūtigandhaṃ bhayānakaṃ;"]},{"para":1285,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Susānamiva bībhacchaṃ, ramante yattha bālisā."]},{"para":1286,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tadā mahākāruṇiko, bhātā me lokanāyako;"]},{"para":1287,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Disvā saṃviggacittaṃ maṃ, imā gāthā abhāsatha."]},{"para":1288,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Āturaṃ kuṇapaṃ pūtiṃ, passa nande samussayaṃ;"]},{"para":1289,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ."]},{"para":1290,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Yathā idaṃ tathā etaṃ, yathā etaṃ tathā idaṃ;"]},{"para":1291,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Duggandhaṃ pūtikaṃ vāti, bālānaṃ abhinanditaṃ."]},{"para":1292,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Evametaṃ avekkhantī, rattindivamatanditā;"]},{"para":1293,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tato sakāya paññāya, abhinibbijjha dakkhisaṃ."]},{"para":1294,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tatohaṃ atisaṃviggā, sutvā gāthā subhāsitā;"]},{"para":1295,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tatraṭṭhitāvahaṃ santī, arahattamapāpuṇiṃ."]},{"para":1296,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Yattha yattha nisinnāhaṃ, sadā jhānaparāyaṇā;"]},{"para":1297,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Jino tasmiṃ guṇe tuṭṭho, etadagge ṭhapesi maṃ."]},{"para":1298,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."]},{"para":1299,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Arahattaṃ pana patvā attano paṭipattiṃ paccavekkhitvā udānavasena <b>“āturaṃ asucin”</b>tiādinā satthārā desitāhi tīhi gāthāhi saddhiṃ –"]},{"para":1301,"vripara":"85","title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Tassā me appamattāya, vicinantiyā yoniso;"]},{"para":1302,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Yathābhūtaṃ ayaṃ kāyo, diṭṭho santarabāhiro."]},{"para":1304,"vripara":"86","title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["“Atha nibbindahaṃ kāye, ajjhattañca virajjahaṃ;"]},{"para":1305,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Appamattā visaṃyuttā, upasantāmhi nibbutā”ti.","–"]},{"para":1306,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Imā dve gāthā abhāsi."]},{"para":1307,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Tattha <b>evametaṃ avekkhantī … pe … dakkhisan</b>ti etaṃ āturādisabhāvaṃ kāyaṃ evaṃ “yathā idaṃ tathā etan”tiādinā vuttappakārena <b>rattindivaṃ</b> sabbakālaṃ atanditā hutvā parato ghosahetukaṃ sutamayañāṇaṃ muñcitvā, <b>tato</b> taṃnimittaṃ attani sambhūtattā <b>sakāya</b> bhāvanāmayāya <b>paññāya</b> yāthāvato ghanavinibbhogakaraṇena abhinibbijjha, kathaṃ nu kho <b>dakkhisaṃ</b> passissanti ābhogapurecārikena pubbabhāgañāṇacakkhunā <b>avekkhantī</b> vicinantīti attho."]}],"after":[{"para":1310,"vripara":null,"title":"Sundarīnandātherīgāthāvaṇṇanā","lines":["Sundarīnandātherīgāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
