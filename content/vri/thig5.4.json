{"suttaId":"thig5.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[348,363],"vripara":"82"},"segments":{"thig5.4:0.3":"Sundarīnandātherīgāthā","thig5.4:1.1":"“Āturaṃ asuciṃ pūtiṃ, passa nande samussayaṃ;","thig5.4:1.3":"Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ.","thig5.4:2.1":"“Yathā idaṃ tathā etaṃ, yathā etaṃ tathā idaṃ;","thig5.4:2.3":"Duggandhaṃ pūtikaṃ vāti, bālānaṃ abhinanditaṃ.","thig5.4:3.1":"“Evametaṃ avekkhantī, rattindivamatanditā;","thig5.4:3.3":"Tato sakāya paññāya, abhinibbijjha [abhinibbijja (sī. syā.)] dakkhisaṃ.","thig5.4:4.1":"“Tassā me appamattāya, vicinantiyā yoniso;","thig5.4:4.3":"Yathābhūtaṃ ayaṃ kāyo, diṭṭho santarabāhiro.","thig5.4:5.1":"“Atha nibbindahaṃ kāye, ajjhattañca virajjahaṃ;","thig5.4:5.3":"Appamattā visaṃyuttā, upasantāmhi nibbutā”ti.","thig5.4:6.1":"… Sundarīnandā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1308,"to":1309,"paras":[{"para":1308,"vripara":null,"refs":["thig5.4:5"],"lines":["Tenāha <b>“tassā me appamattāyā”</b>tiādi.","Tassattho – tassā me satiavippavāsena <b>appamattāya yoniso</b> upāyena aniccādivasena vipassanāpaññāya <b>vicinantiyā</b> vīmaṃsantiyā, <b>ayaṃ</b> khandhapañcakasaṅkhāto <b>kāyo</b> sasantānaparasantānavibhāgato <b>santarabāhiro</b> yathābhūtaṃ diṭṭho."],"lineRefs":[["thig5.4:5"],["thig5.4:5"]]},{"para":1309,"vripara":null,"refs":["thig5.4:5"],"lines":["<b>Atha</b> tathā dassanato pacchā <b>nibbindahaṃ kāye</b> vipassanāpaññāsahitāya maggapaññāya attabhāve nibbindiṃ, visesatova ajjhattasantāne <b>virajji</b> virāgaṃ āpajjiṃ, ahaṃ yathābhūtāya appamādapaṭipattiyā matthakappattiyā <b>appamattā</b> sabbaso saṃyojanānaṃ samucchinnattā <b>visaṃyuttā</b> upasantā ca nibbutā ca amhīti."],"lineRefs":[["thig5.4:5"]]}],"wordLinks":[["thig5.4:5.1","kāyo",0,1],["thig5.4:5.1","atha",1,0],["thig5.4:5.1","nibbindahaṃ kāye",1,0],["thig5.4:5.1","virajji",1,0],["thig5.4:5.3","appamattā",1,0],["thig5.4:5.3","visaṃyuttā",1,0]],"before":[{"para":1178,"vripara":null,"refs":[],"lines":["Sīhātherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1179,"vripara":null,"refs":[],"lines":["Sundarīnandātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":1180,"vripara":null,"refs":[],"lines":["<b>Āturaṃ asucin</b>tiādikā sundarīnandāya theriyā gāthā.","Ayampi kira padumuttarassa bhagavato kāle haṃsavatīnagare kulagehe nibbattitvā viññutaṃ patvā, satthu santike dhammaṃ suṇantī satthāraṃ ekaṃ bhikkhuniṃ jhāyinīnaṃ aggaṭṭhāne ṭhapentaṃ disvā adhikārakammaṃ katvā taṃ ṭhānantaraṃ patthetvā kusalaṃ upacinantī kappasatasahassaṃ devamanussesu saṃsarantī imasmiṃ buddhuppāde sakyarājakule nibbatti.","<b>Nandā</b>tissā nāmaṃ akaṃsu.","Aparabhāge rūpasampattiyā sundarīnandā, janapadakalyāṇīti ca paññāyittha.","Sā amhākaṃ bhagavati sabbaññutaṃ patvā anupubbena kapilavatthuṃ gantvā nandakumārañca rāhulakumārañca pabbājetvā gate suddhodanamahārāje ca parinibbute mahāpajāpatigotamiyā rāhulamātāya ca pabbajitāya cintesi –","“mayhaṃ jeṭṭhabhātā cakkavattirajjaṃ pahāya pabbajitvā loke aggapuggalo buddho jāto, puttopissa rāhulakumāro pabbaji, bhattāpi me nandarājā, mātāpi mahāpajāpatigotamī, bhaginīpi rāhulamātā pabbajitā, idānāhaṃ gehe kiṃ karissāmi, pabbajissāmī”ti bhikkhunupassayaṃ gantvā ñātisinehena pabbaji, no saddhāya.","Tasmā pabbajitvāpi rūpaṃ nissāya uppannamadā.","“Satthā rūpaṃ vivaṇṇeti garahati, anekapariyāyena rūpe ādīnavaṃ dassetī”ti buddhupaṭṭhānaṃ na gacchatītiādi sabbaṃ heṭṭhā abhirūpanandāya vatthusmiṃ vuttanayeneva veditabbaṃ.","Ayaṃ pana viseso – satthārā nimmitaṃ itthirūpaṃ anukkamena jarābhibhūtaṃ disvā aniccato dukkhato anattato manasikarontiyā theriyā kammaṭṭhānābhimukhaṃ cittaṃ ahosi.","Taṃ disvā satthā tassā sappāyavasena dhammaṃ desento –"],"lineRefs":[[],[],[],[],[],[],[],[],[],[]]},{"para":1182,"vripara":"82","refs":[],"lines":["“Āturaṃ asuciṃ pūtiṃ, passa nande samussayaṃ;"],"lineRefs":[[]]},{"para":1183,"vripara":null,"refs":[],"lines":["Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ."],"lineRefs":[[]]},{"para":1185,"vripara":"83","refs":[],"lines":["“Yathā idaṃ tathā etaṃ, yathā etaṃ tathā idaṃ;"],"lineRefs":[[]]},{"para":1186,"vripara":null,"refs":[],"lines":["Duggandhaṃ pūtikaṃ vāti, bālānaṃ abhinanditaṃ."],"lineRefs":[[]]},{"para":1188,"vripara":"84","refs":[],"lines":["“Evametaṃ avekkhantī, rattindivamatanditā;"],"lineRefs":[[]]},{"para":1189,"vripara":null,"refs":[],"lines":["Tato sakāya paññāya, abhinibbijjha dakkhisan”ti.","–"],"lineRefs":[[],[]]},{"para":1190,"vripara":null,"refs":[],"lines":["Imā tisso gāthā abhāsi."],"lineRefs":[[]]},{"para":1191,"vripara":null,"refs":[],"lines":["Sā desanānusārena ñāṇaṃ pesetvā sotāpattiphale patiṭṭhahi.","Tassā uparimaggatthāya kammaṭṭhānaṃ ācikkhanto “nande, imasmiṃ sarīre appamattakopi sāro natthi, maṃsalohitalepano jarādīnaṃ vāsabhūto, aṭṭhipuñjamatto evāyan”ti dassetuṃ –"],"lineRefs":[[],[]]},{"para":1192,"vripara":null,"refs":[],"lines":["“Aṭṭhinaṃ nagaraṃ kataṃ, maṃsalohitalepanaṃ;"],"lineRefs":[[]]},{"para":1193,"vripara":null,"refs":[],"lines":["Yattha jarā ca maccu ca, māno makkho ca ohito”ti.(dha. pa.150)–"],"lineRefs":[[]]},{"para":1194,"vripara":null,"refs":[],"lines":["<b>Dhammapade</b> imaṃ gāthamāha."],"lineRefs":[[]]},{"para":1195,"vripara":null,"refs":[],"lines":["Sā desanāvasāne arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.3.166-219)–"],"lineRefs":[[],[]]},{"para":1196,"vripara":null,"refs":[],"lines":["“Padumuttaro nāma jino, sabbadhammāna pāragū;"],"lineRefs":[[]]},{"para":1197,"vripara":null,"refs":[],"lines":["Ito satasahassamhi, kappe uppajji nāyako."],"lineRefs":[[]]},{"para":1198,"vripara":null,"refs":[],"lines":["“Ovādako viññāpako, tārako sabbapāṇinaṃ;"],"lineRefs":[[]]},{"para":1199,"vripara":null,"refs":[],"lines":["Desanākusalo buddho, tāresi janataṃ bahuṃ."],"lineRefs":[[]]},{"para":1200,"vripara":null,"refs":[],"lines":["“Anukampako kāruṇiko, hitesī sabbapāṇinaṃ;"],"lineRefs":[[]]},{"para":1201,"vripara":null,"refs":[],"lines":["Sampatte titthiye sabbe, pañcasīle patiṭṭhapi."],"lineRefs":[[]]},{"para":1202,"vripara":null,"refs":[],"lines":["“Evaṃ nirākulaṃ āsi, suññataṃ titthiyehi ca;"],"lineRefs":[[]]},{"para":1203,"vripara":null,"refs":[],"lines":["Vicittaṃ arahantehi, vasībhūtehi tādibhi."],"lineRefs":[[]]},{"para":1204,"vripara":null,"refs":[],"lines":["“Ratanānaṭṭhapaññāsaṃ, uggatova mahāmuni;"],"lineRefs":[[]]},{"para":1205,"vripara":null,"refs":[],"lines":["Kañcanagghiyasaṅkāso, bāttiṃsavaralakkhaṇo."],"lineRefs":[[]]},{"para":1206,"vripara":null,"refs":[],"lines":["“Vassasatasahassāni, āyu vijjati tāvade;"],"lineRefs":[[]]},{"para":1207,"vripara":null,"refs":[],"lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[[]]},{"para":1208,"vripara":null,"refs":[],"lines":["“Tadāhaṃ haṃsavatiyaṃ, jātā seṭṭhikule ahuṃ;"],"lineRefs":[[]]},{"para":1209,"vripara":null,"refs":[],"lines":["Nānāratanapajjote, mahāsukhasamappitā."],"lineRefs":[[]]},{"para":1210,"vripara":null,"refs":[],"lines":["“Upetvā taṃ mahāvīraṃ, assosiṃ dhammadesanaṃ;"],"lineRefs":[[]]},{"para":1211,"vripara":null,"refs":[],"lines":["Amataṃ paramassādaṃ, paramatthanivedakaṃ."],"lineRefs":[[]]},{"para":1212,"vripara":null,"refs":[],"lines":["“Tadā nimantayitvāna, sasaṅghaṃ lokanāyakaṃ;"],"lineRefs":[[]]},{"para":1213,"vripara":null,"refs":[],"lines":["Datvā tassa mahādānaṃ, pasannā sehi pāṇibhi."],"lineRefs":[[]]},{"para":1214,"vripara":null,"refs":[],"lines":["“Jhāyinīnaṃ bhikkhunīnaṃ, aggaṭṭhānamapatthayiṃ;"],"lineRefs":[[]]},{"para":1215,"vripara":null,"refs":[],"lines":["Nipacca sirasā dhīraṃ, sasaṅghaṃ lokanāyakaṃ."],"lineRefs":[[]]},{"para":1216,"vripara":null,"refs":[],"lines":["“Tadā adantadamako, tilokasaraṇo pabhū;"],"lineRefs":[[]]},{"para":1217,"vripara":null,"refs":[],"lines":["Byākāsi narasārathi, lacchase taṃ supatthitaṃ."],"lineRefs":[[]]},{"para":1218,"vripara":null,"refs":[],"lines":["“Satasahassito kappe, okkākakulasambhavo;"],"lineRefs":[[]]},{"para":1219,"vripara":null,"refs":[],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[[]]},{"para":1220,"vripara":null,"refs":[],"lines":["“Tassa dhammesu dāyādā, orasā dhammanimmitā;"],"lineRefs":[[]]},{"para":1221,"vripara":null,"refs":[],"lines":["Nandāti nāma nāmena, hessati satthu sāvikā."],"lineRefs":[[]]},{"para":1222,"vripara":null,"refs":[],"lines":["“Taṃ sutvā muditā hutvā, yāvajīvaṃ tadā jinaṃ;"],"lineRefs":[[]]},{"para":1223,"vripara":null,"refs":[],"lines":["Mettacittā paricariṃ, paccayehi vināyakaṃ."],"lineRefs":[[]]},{"para":1224,"vripara":null,"refs":[],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":1225,"vripara":null,"refs":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":1226,"vripara":null,"refs":[],"lines":["“Tato cutā yāmamagaṃ, tatohaṃ tusitaṃ gatā;"],"lineRefs":[[]]},{"para":1227,"vripara":null,"refs":[],"lines":["Tato ca nimmānaratiṃ, vasavattipuraṃ tato."],"lineRefs":[[]]},{"para":1228,"vripara":null,"refs":[],"lines":["“Yattha yatthūpapajjāmi, tassa kammassa vāhasā;"],"lineRefs":[[]]},{"para":1229,"vripara":null,"refs":[],"lines":["Tattha tattheva rājūnaṃ, mahesittamakārayiṃ."],"lineRefs":[[]]},{"para":1230,"vripara":null,"refs":[],"lines":["“Tato cutā manussatte, rājānaṃ cakkavattinaṃ;"],"lineRefs":[[]]},{"para":1231,"vripara":null,"refs":[],"lines":["Maṇḍalīnañca rājūnaṃ, mahesittamakārayiṃ."],"lineRefs":[[]]},{"para":1232,"vripara":null,"refs":[],"lines":["“Sampattiṃ anubhotvāna, devesu manujesu ca;"],"lineRefs":[[]]},{"para":1233,"vripara":null,"refs":[],"lines":["Sabbattha sukhitā hutvā, nekakappesu saṃsariṃ."],"lineRefs":[[]]},{"para":1234,"vripara":null,"refs":[],"lines":["“Pacchime bhave sampatte, suramme kapilavhaye;"],"lineRefs":[[]]},{"para":1235,"vripara":null,"refs":[],"lines":["Rañño suddhodanassāhaṃ, dhītā āsiṃ aninditā."],"lineRefs":[[]]},{"para":1236,"vripara":null,"refs":[],"lines":["“Siriyā rūpiniṃ disvā, nanditaṃ āsi taṃ kulaṃ;"],"lineRefs":[[]]},{"para":1237,"vripara":null,"refs":[],"lines":["Tena nandāti me nāmaṃ, sundaraṃ pavaraṃ ahu."],"lineRefs":[[]]},{"para":1238,"vripara":null,"refs":[],"lines":["“Yuvatīnañca sabbāsaṃ, kalyāṇīti ca vissutā;"],"lineRefs":[[]]},{"para":1239,"vripara":null,"refs":[],"lines":["Tasmimpi nagare ramme, ṭhapetvā taṃ yasodharaṃ."],"lineRefs":[[]]},{"para":1240,"vripara":null,"refs":[],"lines":["“Jeṭṭho bhātā tilokaggo, pacchimo arahā tathā;"],"lineRefs":[[]]},{"para":1241,"vripara":null,"refs":[],"lines":["Ekākinī gahaṭṭhāhaṃ, mātarā paricoditā."],"lineRefs":[[]]},{"para":1242,"vripara":null,"refs":[],"lines":["“Sākiyamhi kule jātā, putte buddhānujā tuvaṃ;"],"lineRefs":[[]]},{"para":1243,"vripara":null,"refs":[],"lines":["Nandenapi vinā bhūtā, agāre kinnu acchasi."],"lineRefs":[[]]},{"para":1244,"vripara":null,"refs":[],"lines":["“Jarāvasānaṃ yobbaññaṃ, rūpaṃ asucisammataṃ;"],"lineRefs":[[]]},{"para":1245,"vripara":null,"refs":[],"lines":["Rogantamapicārogyaṃ, jīvitaṃ maraṇantikaṃ."],"lineRefs":[[]]},{"para":1246,"vripara":null,"refs":[],"lines":["“Idampi te subhaṃ rūpaṃ, sasīkantaṃ manoharaṃ;"],"lineRefs":[[]]},{"para":1247,"vripara":null,"refs":[],"lines":["Bhūsanānaṃ alaṅkāraṃ, sirisaṅghāṭasaṃnibhaṃ."],"lineRefs":[[]]},{"para":1248,"vripara":null,"refs":[],"lines":["“Puñjitaṃ lokasāraṃva, nayanānaṃ rasāyanaṃ;"],"lineRefs":[[]]},{"para":1249,"vripara":null,"refs":[],"lines":["Puññānaṃ kittijananaṃ, ukkākakulanandanaṃ."],"lineRefs":[[]]},{"para":1250,"vripara":null,"refs":[],"lines":["“Na cireneva kālena, jarā samadhisessati;"],"lineRefs":[[]]},{"para":1251,"vripara":null,"refs":[],"lines":["Vihāya gehaṃ kāruññe, cara dhammamanindite."],"lineRefs":[[]]},{"para":1252,"vripara":null,"refs":[],"lines":["“Sutvāhaṃ mātu vacanaṃ, pabbajiṃ anagāriyaṃ;"],"lineRefs":[[]]},{"para":1253,"vripara":null,"refs":[],"lines":["Dehena natu cittena, rūpayobbanalāḷitā."],"lineRefs":[[]]},{"para":1254,"vripara":null,"refs":[],"lines":["“Mahatā ca payattena, jhānajjhena paraṃ mama;"],"lineRefs":[[]]},{"para":1255,"vripara":null,"refs":[],"lines":["Kātuñca vadate mātā, na cāhaṃ tattha ussukā."],"lineRefs":[[]]},{"para":1256,"vripara":null,"refs":[],"lines":["“Tato mahākāruṇiko, disvā maṃ kāmalālasaṃ;"],"lineRefs":[[]]},{"para":1257,"vripara":null,"refs":[],"lines":["Nibbandanatthaṃ rūpasmiṃ, mama cakkhupathe jino."],"lineRefs":[[]]},{"para":1258,"vripara":null,"refs":[],"lines":["“Sakena ānubhāvena, itthiṃ māpesi sobhiniṃ;"],"lineRefs":[[]]},{"para":1259,"vripara":null,"refs":[],"lines":["Dassanīyaṃ suruciraṃ, mamatopi surūpiniṃ."],"lineRefs":[[]]},{"para":1260,"vripara":null,"refs":[],"lines":["“Tamahaṃ vimhitā disvā, ativimhitadehiniṃ;"],"lineRefs":[[]]},{"para":1261,"vripara":null,"refs":[],"lines":["Cintayiṃ saphalaṃ meti, nettalābhañca mānusaṃ."],"lineRefs":[[]]},{"para":1262,"vripara":null,"refs":[],"lines":["“Tamahaṃ ehi subhage, yenattho taṃ vadehi me;"],"lineRefs":[[]]},{"para":1263,"vripara":null,"refs":[],"lines":["Kulaṃ te nāmagottañca, vada me yadi te piyaṃ."],"lineRefs":[[]]},{"para":1264,"vripara":null,"refs":[],"lines":["“Na vañcakālo subhage, ucchaṅge maṃ nivāsaya;"],"lineRefs":[[]]},{"para":1265,"vripara":null,"refs":[],"lines":["Sīdantīva mamaṅgāni, pasuppayamuhuttakaṃ."],"lineRefs":[[]]},{"para":1266,"vripara":null,"refs":[],"lines":["“Tato sīsaṃ mamaṅge sā, katvā sayi sulocanā;"],"lineRefs":[[]]},{"para":1267,"vripara":null,"refs":[],"lines":["Tassā nalāṭe patitā, luddhā paramadāruṇā."],"lineRefs":[[]]},{"para":1268,"vripara":null,"refs":[],"lines":["“Saha tassā nipātena, piḷakā upapajjatha;"],"lineRefs":[[]]},{"para":1269,"vripara":null,"refs":[],"lines":["Pagghariṃsu pabhinnā ca, kuṇapā pubbalohitā."],"lineRefs":[[]]},{"para":1270,"vripara":null,"refs":[],"lines":["“Pabhinnaṃ vadanañcāpi, kuṇapaṃ pūtigandhanaṃ;"],"lineRefs":[[]]},{"para":1271,"vripara":null,"refs":[],"lines":["Uddhumātaṃ vinilañca, pubbañcāpi sarīrakaṃ."],"lineRefs":[[]]},{"para":1272,"vripara":null,"refs":[],"lines":["“Sā paveditasabbaṅgī, nissasantī muhuṃ muhuṃ;"],"lineRefs":[[]]},{"para":1273,"vripara":null,"refs":[],"lines":["Vedayantī sakaṃ dukkhaṃ, karuṇaṃ paridevayi."],"lineRefs":[[]]},{"para":1274,"vripara":null,"refs":[],"lines":["“Dukkhena dukkhitā homi, phusayanti ca vedanā;"],"lineRefs":[[]]},{"para":1275,"vripara":null,"refs":[],"lines":["Mahādukkhe nimuggamhi, saraṇaṃ hohi me sakhī."],"lineRefs":[[]]},{"para":1276,"vripara":null,"refs":[],"lines":["“Kuhiṃ vadanasotaṃ te, kuhiṃ te tuṅganāsikā;"],"lineRefs":[[]]},{"para":1277,"vripara":null,"refs":[],"lines":["Tambabimbavaroṭṭhante, vadanaṃ te kuhiṃ gataṃ."],"lineRefs":[[]]},{"para":1278,"vripara":null,"refs":[],"lines":["“Kuhiṃ sasīnibhaṃ vaṇṇaṃ, kambugīvā kuhiṃ gatā;"],"lineRefs":[[]]},{"para":1279,"vripara":null,"refs":[],"lines":["Doḷā lolāva te kaṇṇā, vevaṇṇaṃ samupāgatā."],"lineRefs":[[]]},{"para":1280,"vripara":null,"refs":[],"lines":["“Makuḷakhārakākārā, kalikāva payodharā;"],"lineRefs":[[]]},{"para":1281,"vripara":null,"refs":[],"lines":["Pabhinnā pūtikuṇapā, duṭṭhagandhittamāgatā."],"lineRefs":[[]]},{"para":1282,"vripara":null,"refs":[],"lines":["“Vedimajjhāva sussoṇī, sūnāva nītakibbisā;"],"lineRefs":[[]]},{"para":1283,"vripara":null,"refs":[],"lines":["Jātā amajjhabharitā, aho rūpamasassataṃ."],"lineRefs":[[]]},{"para":1284,"vripara":null,"refs":[],"lines":["“Sabbaṃ sarīrasañjātaṃ, pūtigandhaṃ bhayānakaṃ;"],"lineRefs":[[]]},{"para":1285,"vripara":null,"refs":[],"lines":["Susānamiva bībhacchaṃ, ramante yattha bālisā."],"lineRefs":[[]]},{"para":1286,"vripara":null,"refs":[],"lines":["“Tadā mahākāruṇiko, bhātā me lokanāyako;"],"lineRefs":[[]]},{"para":1287,"vripara":null,"refs":[],"lines":["Disvā saṃviggacittaṃ maṃ, imā gāthā abhāsatha."],"lineRefs":[[]]},{"para":1288,"vripara":null,"refs":[],"lines":["“Āturaṃ kuṇapaṃ pūtiṃ, passa nande samussayaṃ;"],"lineRefs":[[]]},{"para":1289,"vripara":null,"refs":[],"lines":["Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ."],"lineRefs":[[]]},{"para":1290,"vripara":null,"refs":[],"lines":["“Yathā idaṃ tathā etaṃ, yathā etaṃ tathā idaṃ;"],"lineRefs":[[]]},{"para":1291,"vripara":null,"refs":[],"lines":["Duggandhaṃ pūtikaṃ vāti, bālānaṃ abhinanditaṃ."],"lineRefs":[[]]},{"para":1292,"vripara":null,"refs":[],"lines":["“Evametaṃ avekkhantī, rattindivamatanditā;"],"lineRefs":[[]]},{"para":1293,"vripara":null,"refs":[],"lines":["Tato sakāya paññāya, abhinibbijjha dakkhisaṃ."],"lineRefs":[[]]},{"para":1294,"vripara":null,"refs":[],"lines":["“Tatohaṃ atisaṃviggā, sutvā gāthā subhāsitā;"],"lineRefs":[[]]},{"para":1295,"vripara":null,"refs":[],"lines":["Tatraṭṭhitāvahaṃ santī, arahattamapāpuṇiṃ."],"lineRefs":[[]]},{"para":1296,"vripara":null,"refs":[],"lines":["“Yattha yattha nisinnāhaṃ, sadā jhānaparāyaṇā;"],"lineRefs":[[]]},{"para":1297,"vripara":null,"refs":[],"lines":["Jino tasmiṃ guṇe tuṭṭho, etadagge ṭhapesi maṃ."],"lineRefs":[[]]},{"para":1298,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":1299,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā attano paṭipattiṃ paccavekkhitvā udānavasena <b>“āturaṃ asucin”</b>tiādinā satthārā desitāhi tīhi gāthāhi saddhiṃ –"],"lineRefs":[[]]},{"para":1301,"vripara":"85","refs":[],"lines":["“Tassā me appamattāya, vicinantiyā yoniso;"],"lineRefs":[[]]},{"para":1302,"vripara":null,"refs":[],"lines":["Yathābhūtaṃ ayaṃ kāyo, diṭṭho santarabāhiro."],"lineRefs":[[]]},{"para":1304,"vripara":"86","refs":[],"lines":["“Atha nibbindahaṃ kāye, ajjhattañca virajjahaṃ;"],"lineRefs":[[]]},{"para":1305,"vripara":null,"refs":[],"lines":["Appamattā visaṃyuttā, upasantāmhi nibbutā”ti.","–"],"lineRefs":[[],[]]},{"para":1306,"vripara":null,"refs":[],"lines":["Imā dve gāthā abhāsi."],"lineRefs":[[]]},{"para":1307,"vripara":null,"refs":[],"lines":["Tattha <b>evametaṃ avekkhantī … pe … dakkhisan</b>ti etaṃ āturādisabhāvaṃ kāyaṃ evaṃ “yathā idaṃ tathā etan”tiādinā vuttappakārena <b>rattindivaṃ</b> sabbakālaṃ atanditā hutvā parato ghosahetukaṃ sutamayañāṇaṃ muñcitvā, <b>tato</b> taṃnimittaṃ attani sambhūtattā <b>sakāya</b> bhāvanāmayāya <b>paññāya</b> yāthāvato ghanavinibbhogakaraṇena abhinibbijjha, kathaṃ nu kho <b>dakkhisaṃ</b> passissanti ābhogapurecārikena pubbabhāgañāṇacakkhunā <b>avekkhantī</b> vicinantīti attho."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
