{"suttaId":"tha-ap176","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6896,6905],"vripara":"18"},"segments":{"tha-ap176:0.3":"Udapānadāyakattheraapadānaṃ","tha-ap176:1.1":"“Vipassino bhagavato, udapāno kato mayā;","tha-ap176:1.3":"Piṇḍapātañca datvāna [gahetvāna (syā.)], niyyādesimahaṃ tadā.","tha-ap176:2.1":"“Ekanavutito kappe, yaṃ kammamakariṃ tadā;","tha-ap176:2.3":"Duggatiṃ nābhijānāmi, udapānassidaṃ phalaṃ.","tha-ap176:3.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap176:4.1":"Itthaṃ sudaṃ āyasmā udapānadāyako thero imā gāthāyo abhāsitthāti.","tha-ap176:5.1":"Udapānadāyakattherassāpadānaṃ catutthaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3135,"to":3135,"paras":[{"para":3135,"vripara":"18","refs":["tha-ap176:1"],"lines":["So aparabhāge attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>vipassino bhagavato</b>tiādimāha.","Tattha <b>udapāno kato mayā</b>ti udakaṃ pivanti etthāti udapāno, kūpapokkharaṇītaḷākānametaṃ adhivacanaṃ.","So udapāno kūpo vipassissa bhagavato atthāya kato khanitoti attho.","Sesaṃ uttānatthamevāti."],"lineRefs":[["tha-ap176:1"],["tha-ap176:1"],["tha-ap176:1"],["tha-ap176:1"]]}],"wordLinks":[["tha-ap176:1.1","vipassino bhagavato",0,0],["tha-ap176:1.1","udapāno kato mayā",0,1]]},"tika":null}
