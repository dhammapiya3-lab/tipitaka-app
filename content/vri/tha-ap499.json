{"suttaId":"tha-ap499","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[2683,2700],"vripara":"51"},"segments":{"tha-ap499:0.3":"Udakadāyakattheraapadānaṃ","tha-ap499:1.1":"“Padumuttarabuddhassa,","tha-ap499:1.2":"bhikkhusaṅghe anuttare;","tha-ap499:1.3":"Pasannacitto sumano,","tha-ap499:1.4":"pānīghaṭamapūrayiṃ. 52.","tha-ap499:2.1":"“Pabbatagge dumagge vā,","tha-ap499:2.2":"ākāse vātha bhūmiyaṃ;","tha-ap499:2.3":"Yadā pānīyamicchāmi,","tha-ap499:2.4":"khippaṃ nibbattate mama. 53.","tha-ap499:3.1":"“Satasahassito kappe,","tha-ap499:3.2":"yaṃ dānamadadiṃ tadā;","tha-ap499:3.3":"Duggatiṃ nābhijānāmi,","tha-ap499:3.4":"dakadānassidaṃ phalaṃ. 54.","tha-ap499:4.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap499:4.3":"viharāmi anāsavo. 55.","tha-ap499:5.1":"“Svāgataṃ vata me āsi…pe…","tha-ap499:5.3":"kataṃ buddhassa sāsanaṃ. 56.","tha-ap499:6.1":"“Paṭisambhidā catasso…pe…","tha-ap499:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap499:7.1":"Itthaṃ sudaṃ āyasmā udakadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap499:8.1":"Udakadāyakattherassāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
