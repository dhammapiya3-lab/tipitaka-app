{"suttaId":"sn35.20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[58,59],"vripara":"20"},"segments":{"sn35.20:0.3":"Dutiyābhinandasuttaṃ","sn35.20:1.1":"“Yo, bhikkhave, rūpe abhinandati, dukkhaṃ so abhinandati.","sn35.20:1.2":"Yo dukkhaṃ abhinandati, aparimutto so dukkhasmāti vadāmi.","sn35.20:1.3":"Yo sadde … pe …","sn35.20:1.4":"gandhe …","sn35.20:1.5":"rase …","sn35.20:1.6":"phoṭṭhabbe …","sn35.20:1.7":"dhamme abhinandati, dukkhaṃ so abhinandati.","sn35.20:1.8":"Yo dukkhaṃ abhinandati, aparimutto so dukkhasmā”ti vadāmi.","sn35.20:2.1":"“Yo ca kho, bhikkhave, rūpe nābhinandati, dukkhaṃ so nābhinandati.","sn35.20:2.2":"Yo dukkhaṃ nābhinandati, parimutto so dukkhasmāti vadāmi.","sn35.20:2.3":"Yo sadde … pe …","sn35.20:2.4":"gandhe …","sn35.20:2.5":"rase …","sn35.20:2.6":"phoṭṭhabbe …","sn35.20:2.7":"dhamme nābhinandati, dukkhaṃ so nābhinandati.","sn35.20:2.8":"Yo dukkhaṃ nābhinandati, parimutto so dukkhasmā”ti vadāmi.","sn35.20:2.9":"Aṭṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":23,"to":26,"paras":[{"para":23,"vripara":"19-22","refs":["sn35.20:1"],"lines":["19-22. Sattamādīsu catūsu vaṭṭavivaṭṭameva kathitaṃ.","Anupubbakathā pana nesaṃ heṭṭhā vuttanayeneva veditabbāti."],"lineRefs":[["sn35.20:1"],["sn35.20:1"]]},{"para":24,"vripara":null,"refs":["sn35.20:1"],"lines":["Yamakavaggo dutiyo."],"lineRefs":[["sn35.20:1"]]},{"para":25,"vripara":null,"refs":["sn35.20:1"],"lines":["Sabbavaggo"],"lineRefs":[["sn35.20:1"]]},{"para":26,"vripara":null,"refs":["sn35.20:1"],"lines":["Sabbasuttavaṇṇanā"],"lineRefs":[["sn35.20:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":29,"to":33,"paras":[{"para":29,"vripara":"19-22","refs":["sn35.20:1"],"lines":["19-22. <b>Vaṭṭavivaṭṭameva kathitaṃ</b> abhinandanānaṃ uppādanirodhānañca vasena desanāya pavattattā.","<b>Anupubbakathā</b>ti ādito 