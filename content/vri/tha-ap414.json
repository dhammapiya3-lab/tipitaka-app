{"suttaId":"tha-ap414","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[14146,14284],"vripara":"32"},"segments":{"tha-ap414:0.3":"Ekachattiyattheraapadānaṃ","tha-ap414:1.1":"“Candabhāgānadītīre,","tha-ap414:1.2":"assamo sukato mama;","tha-ap414:1.3":"Susuddhapulinākiṇṇo,","tha-ap414:1.4":"pannasālā sumāpitā. 33.","tha-ap414:2.1":"“Uttānakūlā nadikā,","tha-ap414:2.2":"supatitthā manoramā;","tha-ap414:2.3":"Macchakacchapasampannā [… sañchannā (ka.)],","tha-ap414:2.4":"susumāranisevitā. 34.","tha-ap414:3.1":"“Acchā dīpī ca mayūrā,","tha-ap414:3.2":"karavīkā ca sāḷikā;","tha-ap414:3.3":"Kūjanti sabbadā ete,","tha-ap414:3.4":"sobhayantā mamassamaṃ. 35.","tha-ap414:4.1":"“Kokilā mañjubhāṇī ca,","tha-ap414:4.2":"haṃsā ca madhurassarā;","tha-ap414:4.3":"Abhikūjanti te tattha,","tha-ap414:4.4":"sobhayantā mamassamaṃ. 36.","tha-ap414:5.1":"“Sīhā byagghā varāhā ca,","tha-ap414:5.2":"accha [vaka (sī. pī.), bakā (syā.), vakā (ka.)] kokataracchakā;","tha-ap414:5.3":"Giriduggamhi nādenti,","tha-ap414:5.4":"sobhayantā mamassamaṃ. 37.","tha-ap414:6.1":"“Eṇīmigā ca sarabhā,","tha-ap414:6.2":"bheraṇḍā sūkarā bahū;","tha-ap414:6.3":"Giriduggamhi nādenti,","tha-ap414:6.4":"sobhayantā mamassamaṃ. 38.","tha-ap414:7.1":"“Uddālakā campakā ca,","tha-ap414:7.2":"pāṭalī sinduvārakā;","tha-ap414:7.3":"Atimuttā asokā ca,","tha-ap414:7.4":"sobhayanti mamassamaṃ [pupphanti mama assame (sī. pī.)]. 39.","tha-ap414:8.1":"“Aṅkolā yūthikā ceva,","tha-ap414:8.2":"sattalī bimbijālikā;","tha-ap414:8.3":"Kaṇikārā ca pupphanti,","tha-ap414:8.4":"sobhayantā mamassamaṃ [kaṇikākaṇikārā ca, pupphanti mama assame (sī. syā. pī.)]. 40.","tha-ap414:9.1":"“Nāgā sālā ca saḷalā,","tha-ap414:9.2":"puṇḍarīkettha pupphitā;","tha-ap414:9.3":"Dibbagandhaṃ sampavantā,","tha-ap414:9.4":"sobhayanti mamassamaṃ. 41.","tha-ap414:10.1":"“Ajjunā asanā cettha,","tha-ap414:10.2":"mahānāmā ca pupphitā;","tha-ap414:10.3":"Sālā ca kaṅgupupphā ca,","tha-ap414:10.4":"sobhayanti mamassamaṃ. 42.","tha-ap414:11.1":"“Ambā jambū ca tilakā,","tha-ap414:11.2":"nimbā ca sālakalyāṇī;","tha-ap414:11.3":"Dibbagandhaṃ sampavantā,","tha-ap414:11.4":"sobhayanti mamassamaṃ. 43.","tha-ap414:12.1":"“Asokā ca kapiṭṭhā ca,","tha-ap414:12.2":"girimālettha [bhaginimālettha (sī. pī.), bhaginimālā ca (syā.)] pupphitā;","tha-ap414:12.3":"Dibbagandhaṃ sampavantā,","tha-ap414:12.4":"sobhayanti mamassamaṃ. 44.","tha-ap414:13.1":"“Kadambā kadalī ceva,","tha-ap414:13.2":"isimuggā ca ropitā;","tha-ap414:13.3":"Dhuvaṃ phalāni dhārenti,","tha-ap414:13.4":"sobhayantā mamassamaṃ. 45.","tha-ap414:14.1":"“Harītakā āmalakā,","tha-ap414:14.2":"ambajambuvibhītakā;","tha-ap414:14.3":"Kolā bhallātakā billā,","tha-ap414:14.4":"phalino mama assame. 46.","tha-ap414:15.1":"“Avidūre pokkharaṇī,","tha-ap414:15.2":"supatitthā manoramā;","tha-ap414:15.3":"Mandālakehi sañchannā,","tha-ap414:15.4":"padumuppalakehi ca. 47.","tha-ap414:16.1":"“Gabbhaṃ gaṇhanti padumā,","tha-ap414:16.2":"aññe pupphanti kesarī;","tha-ap414:16.3":"Opattakaṇṇikā ceva,","tha-ap414:16.4":"pupphanti mama assame. 48.","tha-ap414:17.1":"“Pāṭhīnā pāvusā macchā,","tha-ap414:17.2":"balajā muñjarohitā;","tha-ap414:17.3":"Acchodakamhi vicaraṃ,","tha-ap414:17.4":"sobhayanti mamassamaṃ. 49.","tha-ap414:18.1":"“Nayitā ambagandhī ca,","tha-ap414:18.2":"anukūle ca ketakā;","tha-ap414:18.3":"Dibbagandhaṃ sampavantā,","tha-ap414:18.4":"sobhayanti mamassamaṃ. 50.","tha-ap414:19.1":"“Madhu bhisamhā savati,","tha-ap414:19.2":"khīrasappi muḷālibhi;","tha-ap414:19.3":"Dibbagandhaṃ sampavantā,","tha-ap414:19.4":"sobhayanti mamassamaṃ. 51.","tha-ap414:20.1":"“Pulinā sobhanā tattha,","tha-ap414:20.2":"ākiṇṇā jalasevitā;","tha-ap414:20.3":"Opupphā pupphitā senti,","tha-ap414:20.4":"sobhayantā mamassamaṃ. 52.","tha-ap414:21.1":"“Jaṭābhārena bharitā,","tha-ap414:21.2":"ajinuttaravāsanā;","tha-ap414:21.3":"Vākacīradharā sabbe,","tha-ap414:21.4":"sobhayanti mamassamaṃ. 53.","tha-ap414:22.1":"“Yugamattamapekkhantā,","tha-ap414:22.2":"nipakā santavuttino;","tha-ap414:22.3":"Kāmabhoge anapekkhā,","tha-ap414:22.4":"vasanti mama assame. 54.","tha-ap414:23.1":"“Parūḷhakacchanakhalomā,","tha-ap414:23.2":"paṅkadantā rajassirā;","tha-ap414:23.3":"Rajojalladharā sabbe,","tha-ap414:23.4":"vasanti mama assame. 55.","tha-ap414:24.1":"“Abhiññāpāramippattā,","tha-ap414:24.2":"antalikkhacarā ca te;","tha-ap414:24.3":"Uggacchantā nabhaṃ ete,","tha-ap414:24.4":"sobhayanti mamassamaṃ. 56.","tha-ap414:25.1":"“Tehi sissehi parivuto,","tha-ap414:25.2":"vasāmi vipine tadā;","tha-ap414:25.3":"Rattindivaṃ na jānāmi,","tha-ap414:25.4":"sadā jhānasamappito. 57.","tha-ap414:26.1":"“Bhagavā tamhi samaye,","tha-ap414:26.2":"atthadassī mahāmuni;","tha-ap414:26.3":"Tamandhakāraṃ nāsento,","tha-ap414:26.4":"uppajji lokanāyako. 58.","tha-ap414:27.1":"“Atha aññataro sisso,","tha-ap414:27.2":"āgacchi mama santikaṃ;","tha-ap414:27.3":"Mante ajjhetukāmo so,","tha-ap414:27.4":"chaḷaṅgaṃ nāma lakkhaṇaṃ. 59.","tha-ap414:28.1":"“Buddho loke samuppanno,","tha-ap414:28.2":"atthadassī mahāmuni;","tha-ap414:28.3":"Catusaccaṃ pakāsento,","tha-ap414:28.4":"deseti amataṃ padaṃ. 60.","tha-ap414:29.1":"“Tuṭṭhahaṭṭho pamudito,","tha-ap414:29.2":"dhammantaragatāsayo;","tha-ap414:29.3":"Assamā abhinikkhamma,","tha-ap414:29.4":"idaṃ vacanamabraviṃ. 61.","tha-ap414:30.1":"“‘Buddho loke samuppanno,","tha-ap414:30.2":"dvattiṃsavaralakkhaṇo;","tha-ap414:30.3":"Etha sabbe gamissāma,","tha-ap414:30.4":"sammāsambuddhasantikaṃ’. 62.","tha-ap414:31.1":"“Ovādapaṭikarā te,","tha-ap414:31.2":"sadhamme pāramiṃ gatā;","tha-ap414:31.3":"Sādhūti sampaṭicchiṃsu,","tha-ap414:31.4":"uttamatthagavesakā. 63.","tha-ap414:32.1":"“Jaṭābhārabharitā te [jaṭābhārena bharitā (ka.)],","tha-ap414:32.2":"ajinuttaravāsanā;","tha-ap414:32.3":"Uttamatthaṃ gavesantā,","tha-ap414:32.4":"nikkhamiṃsu vanā tadā. 64.","tha-ap414:33.1":"“Bhagavā tamhi samaye,","tha-ap414:33.2":"atthadassī mahāyaso;","tha-ap414:33.3":"Catusaccaṃ pakāsento,","tha-ap414:33.4":"deseti amataṃ padaṃ. 65.","tha-ap414:34.1":"“Setacchattaṃ gahetvāna,","tha-ap414:34.2":"buddhaseṭṭhassa dhārayiṃ;","tha-ap414:34.3":"Ekāhaṃ dhārayitvāna,","tha-ap414:34.4":"buddhaseṭṭhaṃ avandahaṃ. 66.","tha-ap414:35.1":"“Atthadassī tu bhagavā,","tha-ap414:35.2":"lokajeṭṭho narāsabho;","tha-ap414:35.3":"Bhikkhusaṅghe nisīditvā,","tha-ap414:35.4":"imā gāthā abhāsatha. 67.","tha-ap414:36.1":"“‘Yo me chattaṃ adhāresi,","tha-ap414:36.2":"pasanno sehi pāṇibhi;","tha-ap414:36.3":"Tamahaṃ kittayissāmi,","tha-ap414:36.4":"suṇātha mama bhāsato. 68.","tha-ap414:37.1":"“‘Imassa jāyamānassa,","tha-ap414:37.2":"devatte atha mānuse;","tha-ap414:37.3":"Dhāressati sadā chattaṃ,","tha-ap414:37.4":"chattadānassidaṃ phalaṃ. 69.","tha-ap414:38.1":"“‘Sattasattatikappāni,","tha-ap414:38.2":"devaloke ramissati;","tha-ap414:38.3":"Sahassakkhattuṃ rājā ca,","tha-ap414:38.4":"cakkavattī bhavissati. 70.","tha-ap414:39.1":"“‘Sattasattatikkhattuñca,","tha-ap414:39.2":"devarajjaṃ karissati;","tha-ap414:39.3":"Padesarajjaṃ vipulaṃ,","tha-ap414:39.4":"gaṇanāto asaṅkhiyaṃ. 71.","tha-ap414:40.1":"“‘Aṭṭhārase kappasate,","tha-ap414:40.2":"gotamo sakyapuṅgavo;","tha-ap414:40.3":"Tamandhakāraṃ nāsento,","tha-ap414:40.4":"uppajjissati cakkhumā. 72.","tha-ap414:41.1":"“‘Tassa dhammesu dāyādo,","tha-ap414:41.2":"oraso dhammanimmito;","tha-ap414:41.3":"Sabbāsave pariññāya,","tha-ap414:41.4":"viharissatināsavo’. 73.","tha-ap414:42.1":"“Yato ahaṃ kammamakaṃ,","tha-ap414:42.2":"chattaṃ buddhassa dhārayaṃ;","tha-ap414:42.3":"Etthantare na jānāmi,","tha-ap414:42.4":"setacchattaṃ adhāritaṃ. 74.","tha-ap414:43.1":"“Idaṃ pacchimakaṃ mayhaṃ,","tha-ap414:43.2":"carimo vattate bhavo;","tha-ap414:43.3":"Chattadhāraṇamajjāpi,","tha-ap414:43.4":"vattate niccakālikaṃ. 75.","tha-ap414:44.1":"“Aho me sukataṃ kammaṃ,","tha-ap414:44.2":"atthadassissa tādino;","tha-ap414:44.3":"Sabbāsavā parikkhīṇā,","tha-ap414:44.4":"natthi dāni punabbhavo. 76.","tha-ap414:45.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap414:45.3":"viharāmi anāsavo. 77.","tha-ap414:46.1":"“Svāgataṃ vata me āsi…pe…","tha-ap414:46.3":"kataṃ buddhassa sāsanaṃ. 78.","tha-ap414:47.1":"“Paṭisambhidā catasso…pe…","tha-ap414:47.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap414:48.1":"Itthaṃ sudaṃ āyasmā ekachattiyo thero imā gāthāyo abhāsitthāti;","tha-ap414:49.1":"Ekachattiyattherassāpadānaṃ dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
