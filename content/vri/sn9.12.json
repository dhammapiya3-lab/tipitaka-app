{"suttaId":"sn9.12","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[2969,2973],"vripara":"232"},"segments":{"sn9.12:0.3":"Majjhanhikasuttaṃ","sn9.12:1.1":"Ekaṃ samayaṃ aññataro bhikkhu kosalesu viharati aññatarasmiṃ vanasaṇḍe.","sn9.12:1.2":"Atha kho tasmiṃ vanasaṇḍe adhivatthā devatā yena so bhikkhu tenupasaṅkami; upasaṅkamitvā tassa bhikkhuno santike imaṃ gāthaṃ abhāsi –","sn9.12:2.1":"“Ṭhite majjhanhike kāle,","sn9.12:2.2":"sannisīvesu [sannisinnesu (syā. kaṃ. pī.)] pakkhisu;","sn9.12:2.3":"Saṇateva brahāraññaṃ,","sn9.12:2.4":"taṃ bhayaṃ paṭibhāti maṃ.","sn9.12:3.1":"“Ṭhite majjhanhike kāle,","sn9.12:3.2":"sannisīvesu pakkhisu;","sn9.12:3.3":"Saṇateva brahāraññaṃ,","sn9.12:3.4":"sā rati paṭibhāti ma”nti. 13."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1256,"to":1257,"paras":[{"para":1256,"vripara":"232","refs":["sn9.12:1"],"lines":["Dvādasame yaṃ vattabbaṃ, taṃ devatāsaṃyutte nandanavagge vuttameva.","Dvādasamaṃ. 13."],"lineRefs":[["sn9.12:1"],["sn9.12:1"]]},{"para":1257,"vripara":null,"refs":["sn9.12:1"],"lines":["Pākatindriyasuttavaṇṇanā 233."],"lineRefs":[["sn9.12:1"]]}],"wordLinks":[],"before":[{"para":1255,"vripara":null,"title":"Majjhanhikasuttavaṇṇanā","lines":["Majjhanhikasuttavaṇṇanā 232."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1470,"to":1472,"paras":[{"para":1470,"vripara":"232","refs":["sn9.12:1"],"lines":["<b>Nandanavagge</b>ti nandanavaggavaṇṇanāyaṃ tattha idhāpi gāthāya visesābhāvato.","Yadi evaṃ kasmā tattha saṅgītaṃ idha gahitanti?","Devatāpaṭisaṃyuttataṃ upādāya devatāsaṃyutte saṅgahitampi aṭṭhuppattiyā paṭisaṃyuttattā idha gahitaṃ."],"lineRefs":[["sn9.12:1"],["sn9.12:1"],["sn9.12:1"]]},{"para":1471,"vripara":null,"refs":["sn9.12:1"],"lines":["Majjhanhikasuttavaṇṇanā niṭṭhitā. 13."],"lineRefs":[["sn9.12:1"]]},{"para":1472,"vripara":null,"refs":["sn9.12:1"],"lines":["Pākatindri