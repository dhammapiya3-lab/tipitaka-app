{"suttaId":"sn38.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1563,1569],"vripara":"329"},"segments":{"sn38.16:0.3":"Dukkarapañhāsuttaṃ","sn38.16:1.1":"“Kiṃ nu kho, āvuso sāriputta, imasmiṃ dhammavinaye dukkaran”ti?","sn38.16:1.2":"“Pabbajjā kho, āvuso, imasmiṃ dhammavinaye dukkarā”ti.","sn38.16:1.3":"“Pabbajitena panāvuso, kiṃ dukkaran”ti?","sn38.16:1.4":"“Pabbajitena kho, āvuso, abhirati dukkarā”ti.","sn38.16:1.5":"“Abhiratena panāvuso, kiṃ dukkaran”ti?","sn38.16:1.6":"“Abhiratena kho, āvuso, dhammānudhammappaṭipatti dukkarā”ti.","sn38.16:1.7":"“Kīvaciraṃ panāvuso, dhammānudhammappaṭipanno bhikkhu arahaṃ assā”ti?","sn38.16:1.8":"“Naciraṃ, āvuso”ti.","sn38.16:1.9":"Soḷasamaṃ.","sn38.16:1.10":"Jambukhādakasaṃyuttaṃ samattaṃ.","sn38.16:2.0":"Tassuddānaṃ –","sn38.16:2.1":"Nibbānaṃ arahattañca, dhammavādī kimatthiyaṃ;","sn38.16:2.3":"Assāso paramassāso, vedanā āsavāvijjā;","sn38.16:2.5":"Taṇhā oghā upādānaṃ, bhavo dukkhañca sakkāyo.","sn38.16:2.7":"Imasmiṃ dhammavinaye dukkaranti."},"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":673,"to":673,"paras":[{"para":673,"vripara":"329","refs":["sn38.16:1"],"lines":["<b>Abhiratī</b>ti pabbajjāya anukkaṇṭhanatā.","<b>Naciraṃ āvuso</b>ti āvuso dhammānudhammappaṭipanno bhikkhu “pāto anusiṭṭho sāyaṃ visesamadhigamissati, sāyaṃ anusiṭṭho pāto visesamadhigamissatī”ti (ma. ni.2.345) vuttattā ghaṭento vāyamanto nacirassaṃ lahuyeva arahaṃ assa, arahatte patiṭṭhaheyyāti dasseti.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn38.16:1"],["sn38.16:1"],["sn38.16:1"]]}],"wordLinks":[["sn38.16:1.4","abhiratī",0,0],["sn38.16:1.5","abhiratī",0,0],["sn38.16:1.6","abhiratī",0,0],["sn38.16:1.8","naciraṃ āvuso",0,1]]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":582,"to":582,"paras":[{"para":582,"vripara":"329","refs":["sn38.16:1"],"lines":["<b>Pabbajjāyā</b>ti pabbajitapaṭipattiyaṃ.","<b>Dhammānudhammappaṭipanno bhikkhū</b>ti dhammānudhammaṃ paṭipajjamāno bhikkhu.","<b>Pātan</b>ti pāto.","<b>Nacirassan</b>ti khippameva.","Tenāha <b>“lahuyevā”</b>ti."],"lineRefs":[["sn38.16:1"],["sn38.16:1"],["sn38.16:1"],["sn38.16:1"],["sn38.16:1"]]}],"wordLinks":[["sn38.16:1.7","dhammānudhammappaṭipanno bhikkhū",0,1]]},"tika2":null}
