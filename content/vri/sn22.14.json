{"suttaId":"sn22.14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[116,116],"vripara":"14"},"segments":{"sn22.14:0.3":"Anattasuttaṃ","sn22.14:1.1":"Sāvatthinidānaṃ.","sn22.14:1.2":"“Rūpaṃ, bhikkhave, anattā, vedanā anattā, saññā anattā, saṅkhārā anattā, viññāṇaṃ anattā.","sn22.14:1.3":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako rūpasmimpi nibbindati, vedanāyapi nibbindati, saññāyapi nibbindati, saṅkhāresupi nibbindati, viññāṇasmimpi nibbindati.","sn22.14:1.4":"Nibbindaṃ virajjati; virāgā vimuccati. Vimuttasmiṃ vimuttamiti ñāṇaṃ hoti.","sn22.14:1.5":"‘Khīṇā jāti, vusitaṃ brahmacariyaṃ, kataṃ karaṇīyaṃ, nāparaṃ itthattāyā’ti pajānātī”ti.","sn22.14:1.6":"Tatiyaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":70,"to":73,"paras":[{"para":70,"vripara":"12-21","refs":["sn22.14:1"],"lines":["12-21. Aniccavagge pariyosānasuttaṃ pucchāvasikaṃ, sesāni tathā tathā bujjhanakānañca vasena desitānīti.","Paṭhamādīni."],"lineRefs":[["sn22.14:1"],["sn22.14:1"]]},{"para":71,"vripara":null,"refs":["sn22.14:1"],"lines":["Aniccavaggo dutiyo."],"lineRefs":[["sn22.14:1"]]},{"para":72,"vripara":null,"refs":["sn22.14:1"],"lines":["Bhāravaggo"],"lineRefs":[["sn22.14:1"]]},{"para":73,"vripara":null,"refs":["sn22.14:1"],"lines":["Bhārasuttavaṇṇanā"],"lineRefs":[["sn22.14:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":66,"to":70,"paras":[{"para":66,"vripara":"12-21","refs":["sn22.14:1"],"lines":["12-21. <b>Pucchāvasikaṃ</b> ānandattherassa pucchāvasena desitattā."],"lineRefs":[["sn22.14:1"]]},{"para":67,"vripara":null,"refs":["sn22.14:1"],"lines":["Aniccādisuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.14:1"]]},{"para":68,"vripara":null,"refs":["sn22.14:1"],"lines":["Aniccavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.14:1"]]},{"para":69,"vripara":null,"refs":["sn22.14:1"],"lines":["Bhāravaggo"],"lineRefs":[["sn22.14:1"]]},{"p