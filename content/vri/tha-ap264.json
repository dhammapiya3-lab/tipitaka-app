{"suttaId":"tha-ap264","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8419,8431],"vripara":"6"},"segments":{"tha-ap264:0.3":"Telamakkhiyattheraapadānaṃ","tha-ap264:1.1":"“Siddhatthamhi bhagavati,","tha-ap264:1.2":"nibbutamhi narāsabhe;","tha-ap264:1.3":"Bodhiyā vedikāyāhaṃ,","tha-ap264:1.4":"telaṃ makkhesi tāvade.","tha-ap264:2.1":"“Catunnavutito kappe,","tha-ap264:2.2":"yaṃ telaṃ makkhayiṃ tadā;","tha-ap264:2.3":"Duggatiṃ nābhijānāmi,","tha-ap264:2.4":"makkhanāya idaṃ phalaṃ.","tha-ap264:3.1":"“Catuvīse ito kappe,","tha-ap264:3.2":"succhavi nāma khattiyo;","tha-ap264:3.3":"Sattaratanasampanno,","tha-ap264:3.4":"cakkavattī mahabbalo.","tha-ap264:4.1":"“Paṭisambhidā catasso … pe …","tha-ap264:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap264:5.1":"Itthaṃ sudaṃ āyasmā telamakkhiyo thero imā gāthāyo abhāsitthāti.","tha-ap264:6.1":"Telamakkhiyattherassāpadānaṃ dutiyaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
