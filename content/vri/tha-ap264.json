{"suttaId":"tha-ap264","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8419,8431],"vripara":"6"},"segments":{"tha-ap264:0.3":"Telamakkhiyattheraapadānaṃ","tha-ap264:1.1":"“Siddhatthamhi bhagavati, nibbutamhi narāsabhe;","tha-ap264:1.3":"Bodhiyā vedikāyāhaṃ, telaṃ makkhesi tāvade.","tha-ap264:2.1":"“Catunnavutito kappe, yaṃ telaṃ makkhayiṃ tadā;","tha-ap264:2.3":"Duggatiṃ nābhijānāmi, makkhanāya idaṃ phalaṃ.","tha-ap264:3.1":"“Catuvīse ito kappe, succhavi nāma khattiyo;","tha-ap264:3.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap264:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap264:5.1":"Itthaṃ sudaṃ āyasmā telamakkhiyo thero imā gāthāyo abhāsitthāti.","tha-ap264:6.1":"Telamakkhiyattherassāpadānaṃ dutiyaṃ."},"attha":null,"tika":null,"tika2":null}
