{"suttaId":"sn22.108","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[730,730],"vripara":"108"},"segments":{"sn22.108:0.3":"Dutiyasamaṇasuttaṃ","sn22.108:1.1":"Sāvatthinidānaṃ.","sn22.108:1.2":"“Pañcime, bhikkhave, upādānakkhandhā.","sn22.108:1.3":"Katame pañca?","sn22.108:1.4":"Seyyathidaṃ – rūpupādānakkhandho, vedanupādānakkhandho, saññupādānakkhandho, saṅkhārupādānakkhandho, viññāṇupādānakkhandho.","sn22.108:1.5":"Ye hi keci, bhikkhave, samaṇā vā brāhmaṇā vā imesaṃ pañcannaṃ upādānakkhandhānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti … pe … pajānanti, sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti.","sn22.108:1.7":"Chaṭṭhaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":367,"to":370,"paras":[{"para":367,"vripara":"107-112","refs":["sn22.108:1"],"lines":["107-112. Pañcamādīsu catūsu cattāri saccāni kathitāni.","Navamadasamesu kilesappahānanti.","Pañcamādīni."],"lineRefs":[["sn22.108:1"],["sn22.108:1"],["sn22.108:1"]]},{"para":368,"vripara":null,"refs":[],"lines":["Antavaggo ekādasamo."],"lineRefs":[[]]},{"para":369,"vripara":null,"refs":[],"lines":["Dhammakathikavaggo"],"lineRefs":[[]]},{"para":370,"vripara":null,"refs":["sn22.108:1"],"lines":["1-2. Avijjāsuttādivaṇṇanā"],"lineRefs":[["sn22.108:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":359,"to":364,"paras":[{"para":359,"vripara":"107-112","refs":["sn22.108:1"],"lines":["107-112. <b>Cattāri saccāni kathitāni</b> assādādīnaṃ samudayādīnañca desitattā."],"lineRefs":[["sn22.108:1"]]},{"para":360,"vripara":null,"refs":[],"lines":["<b>Kilesappahānaṃ kathitaṃ</b> rāgappahānassa jotitattā."],"lineRefs":[[]]},{"para":361,"vripara":null,"refs":[],"lines":["Samaṇasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":362,"vripara":null,"refs":[],"lines":["Antavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":363,"vr