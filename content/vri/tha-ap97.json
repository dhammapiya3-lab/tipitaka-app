{"suttaId":"tha-ap97","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5020,5041],"vripara":"24"},"segments":{"tha-ap97:0.3":"Gandhamāliyattheraapadānaṃ","tha-ap97:1.1":"“Siddhatthassa bhagavato,","tha-ap97:1.2":"gandhathūpaṃ akāsahaṃ;","tha-ap97:1.3":"Sumanehi paṭicchannaṃ,","tha-ap97:1.4":"buddhānucchavikaṃ kataṃ.","tha-ap97:2.1":"“Kañcanagghiyasaṅkāsaṃ,","tha-ap97:2.2":"buddhaṃ lokagganāyakaṃ;","tha-ap97:2.3":"Indīvaraṃva jalitaṃ,","tha-ap97:2.4":"ādittaṃva hutāsanaṃ.","tha-ap97:3.1":"“Byagghūsabhaṃva pavaraṃ,","tha-ap97:3.2":"abhijātaṃva kesariṃ;","tha-ap97:3.3":"Nisinnaṃ samaṇānaggaṃ,","tha-ap97:3.4":"bhikkhusaṅghapurakkhataṃ.","tha-ap97:4.1":"“Vanditvā satthuno pāde,","tha-ap97:4.2":"pakkāmiṃ uttarāmukho;","tha-ap97:4.3":"Catunnavutito kappe,","tha-ap97:4.4":"gandhamālaṃ yato adaṃ.","tha-ap97:5.1":"“Buddhe katassa kārassa,","tha-ap97:5.2":"phalenāhaṃ visesato;","tha-ap97:5.3":"Duggatiṃ nābhijānāmi,","tha-ap97:5.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap97:6.1":"“Cattārīsamhi ekūne,","tha-ap97:6.2":"kappe āsiṃsu soḷasa;","tha-ap97:6.3":"Devagandhasanāmā te,","tha-ap97:6.4":"rājāno cakkavattino.","tha-ap97:7.1":"“Paṭisambhidā catasso … pe …","tha-ap97:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap97:8.1":"Itthaṃ sudaṃ āyasmā gandhamāliyo thero imā gāthāyo abhāsitthāti.","tha-ap97:9.1":"Gandhamāliyattherassāpadānaṃ pañcamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2774,"to":2774,"paras":[{"para":2774,"vripara":"24","refs":["tha-ap97:1"],"lines":["So aparabhāge attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>siddhatthassa bhagavato</b>tiādimāha.","Taṃ sabbaṃ uttānatthamevāti."],"lineRefs":[["tha-ap97:1"],["tha-ap97:1"]]}],"wordLinks":[["tha-ap97:1.1","siddhatthassa bhagavato",0,0]],"before":[{"para":2771,"vripara":null,"refs":[],"lines":["Sūcidāyakattheraapadānavaṇṇanā samattā."],"lineRefs":[[]]},{"para":2772,"vripara":null,"refs":[],"lines":["Gandhamāliyattheraapadānavaṇṇanā"],"lineRefs":[[]]},{"para":2773,"vripara":null,"refs":[],"lines":["<b>Siddhatthassa bhagavato</b>tiādikaṃ āyasmato gandhamāliyattherassa apadāna.","Ayampi purimabuddhesu katādhikāro siddhatthassa bhagavato kāle kulagehe nibbatto mahaddhano mahābhogo ahosi.","So satthari pasīditvā candanāgarukappūrakassaturādīni anekāni sugandhāni vaḍḍhetvā satthu gandhathūpaṃ kāresi.","Tassupari sumanapupphehi chādesi, buddhañca aṭṭhaṅganamakkāraṃ akāsi.","So tena puññakammena devamanussesu sampattiyo anubhavitvā imasmiṃ buddhuppāde vibhavasampanne ekasmiṃ kulagehe nibbatto vuddhimanvāya satthari pasīditvā pabbajito nacirasseva arahā ahosi."],"lineRefs":[[],[],[],[],[]]}]},"tika":null,"tika2":null}
