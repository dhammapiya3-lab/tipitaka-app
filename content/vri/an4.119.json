{"suttaId":"an4.119","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1082,1082],"vripara":"119"},"segments":{"an4.119:0.3":"Paṭhamabhayasuttaṃ","an4.119:1.1":"“Cattārimāni, bhikkhave, bhayāni.","an4.119:1.2":"Katamāni cattāri?","an4.119:1.3":"Jātibhayaṃ, jarābhayaṃ, byādhibhayaṃ, maraṇabhayaṃ – imāni kho, bhikkhave, cattāri bhayānī”ti.","an4.119:1.5":"Navamaṃ."},"attha":null,"tika":null}
