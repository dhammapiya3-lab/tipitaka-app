{"suttaId":"snp5.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3769,3784],"vripara":"1098"},"segments":{"snp5.11:0.2":"Kappamāṇavapucchā","snp5.11:1.1":"“Majjhe sarasmiṃ tiṭṭhataṃ,(iccāyasmā kappo)","snp5.11:1.3":"Oghe jāte mahabbhaye;","snp5.11:1.4":"Jarāmaccuparetānaṃ, dīpaṃ pabrūhi mārisa;","snp5.11:1.6":"Tvañca me dīpamakkhāhi, yathāyidaṃ nāparaṃ siyā”.","snp5.11:2.1":"“Majjhe sarasmiṃ tiṭṭhataṃ,(kappāti bhagavā)","snp5.11:2.3":"Oghe jāte mahabbhaye;","snp5.11:2.4":"Jarāmaccuparetānaṃ, dīpaṃ pabrūmi kappa te.","snp5.11:3.1":"“Akiñcanaṃ anādānaṃ, etaṃ dīpaṃ anāparaṃ;","snp5.11:3.3":"Nibbānaṃ iti [nibbānamīti (sī.)] naṃ brūmi, jarāmaccuparikkhayaṃ.","snp5.11:4.1":"“Etadaññāya ye satā, diṭṭhadhammābhinibbutā;","snp5.11:4.3":"Na te māravasānugā, na te mārassa paddhagū”ti [paṭṭhagūti (syā. ka.)].","snp5.11:4.5":"Kappamāṇavapucchā dasamā niṭṭhitā."},"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2602,"to":2603,"paras":[{"para":2602,"vripara":"1099","refs":["snp5.11:2"],"lines":["<b>Majjhe sarasmin</b>ti kappasuttaṃ.","Tattha <b>majjhe sarasmin</b>ti purimapacchimakoṭipaññāṇābhāvato majjhabhūte saṃsāreti vuttaṃ hoti.","<b>Tiṭṭhatan</b>ti tiṭṭhamānānaṃ.","<b>Yathāyidaṃ nāparaṃ siyā</b>ti yathā idaṃ dukkhaṃ puna na bhaveyya."],"lineRefs":[["snp5.11:2"],["snp5.11:2"],["snp5.11:2"],["snp5.11:2"]]},{"para":2603,"vripara":"1101-1102","refs":["snp5.11:2","snp5.11:4"],"lines":["1101-2. Athassa bhagavā tamatthaṃ byākaronto tisso gāthāyo abhāsi.","Tattha <b>akiñcanan</b>ti kiñcanapaṭipakkhaṃ.","<b>Anādānan</b>ti ādānapaṭipakkhaṃ, kiñcanādānavūpasamanti vuttaṃ hoti.","<b>Anāparan</b>ti aparapaṭibhāgadīpavirahitaṃ, seṭṭhanti vuttaṃ hoti.","<b>Na te mārassa paddhagū</b>ti te mārassa paddhacarā paricārakā sissā na honti.","Sesaṃ sabbattha pākaṭameva."],"lineRefs":[["snp5.11:2"],["snp5.11:2"],["snp5.11:2"],["snp5.11:2"],["snp5.11:4"],["snp5.11:4"]]}],"wordLinks":[["snp5.11:2.1","majjhe sarasmiṃ",0,0],["snp5.11:2.1","majjhe sarasmiṃ",0,1],["snp5.11:2.1","tiṭṭhataṃ",0,2],["snp5.11:4.3","na te mārassa paddhagū",1,4]]},"tika":null,"tika2":null}
