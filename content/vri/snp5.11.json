{"suttaId":"snp5.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3769,3784],"vripara":"1098"},"segments":{"snp5.11:0.2":"Kappamāṇavapucchā","snp5.11:1.1":"“Majjhe sarasmiṃ tiṭṭhataṃ,","snp5.11:1.2":"(iccāyasmā kappo)","snp5.11:1.3":"Oghe jāte mahabbhaye;","snp5.11:1.4":"Jarāmaccuparetānaṃ,","snp5.11:1.5":"dīpaṃ pabrūhi mārisa;","snp5.11:1.6":"Tvañca me dīpamakkhāhi,","snp5.11:1.7":"yathāyidaṃ nāparaṃ siyā”. 1099.","snp5.11:2.1":"“Majjhe sarasmiṃ tiṭṭhataṃ,","snp5.11:2.2":"(kappāti bhagavā)","snp5.11:2.3":"Oghe jāte mahabbhaye;","snp5.11:2.4":"Jarāmaccuparetānaṃ,","snp5.11:2.5":"dīpaṃ pabrūmi kappa te. 1100.","snp5.11:3.1":"“Akiñcanaṃ anādānaṃ,","snp5.11:3.2":"etaṃ dīpaṃ anāparaṃ;","snp5.11:3.3":"Nibbānaṃ iti [nibbānamīti (sī.)] naṃ brūmi,","snp5.11:3.4":"jarāmaccuparikkhayaṃ. 1101.","snp5.11:4.1":"“Etadaññāya ye satā,","snp5.11:4.2":"diṭṭhadhammābhinibbutā;","snp5.11:4.3":"Na te māravasānugā,","snp5.11:4.4":"na te mārassa paddhagū”ti [paṭṭhagūti (syā. ka.)].","snp5.11:4.5":"Kappamāṇavapucchā dasamā niṭṭhitā. 11."},"unsure":[],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2602,"to":2603,"paras":[{"para":2602,"vripara":"1099","refs":["snp5.11:2"],"lines":["<b>Majjhe</b> <b>sarasmi</b>nti kappasuttaṃ.","Tattha <b>majjhe sarasmi</b>nti purimapacchimakoṭipaññāṇābhāvato majjhabhūte saṃsāreti vuttaṃ hoti.","<b>Tiṭṭhata</b>nti tiṭṭhamānānaṃ.","<b>Yathāyidaṃ nāparaṃ siyā</b>ti yathā idaṃ dukkhaṃ puna na bhaveyya. 1101-2."],"lineRefs":[["snp5.11:2"],["snp5.11:2"],["snp5.11:2"],["snp5.11:2"]]},{"para":2603,"vripara":"1101-1102","refs":["snp5.11:2","snp5.11:4"],"lines":["Athassa bhagavā tamatthaṃ byākaronto tisso gāthāyo abhāsi.","Tattha <b>akiñcana</b>nti kiñcanapaṭipakkhaṃ.","<b>Anādāna</b>nti ādānapaṭipakkhaṃ, kiñcanādānavūpasamanti vuttaṃ hoti.","<b>Anāpara</b>nti aparapaṭibhāgadīpavirahitaṃ, seṭṭhanti vuttaṃ hoti.","<b>Na te mārassa paddhagū</b>ti te mārassa paddhaca