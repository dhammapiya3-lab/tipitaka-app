{"suttaId":"tha-ap155","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6497,6515],"vripara":"15"},"segments":{"tha-ap155:0.3":"Vīthisammajjakattheraapadānaṃ","tha-ap155:1.1":"“Udentaṃ sataraṃsiṃva,","tha-ap155:1.2":"pītaraṃsiṃva [sitaraṃsiṃva (sī. syā.)] bhāṇumaṃ;","tha-ap155:1.3":"Pannarase yathā candaṃ,","tha-ap155:1.4":"niyyantaṃ lokanāyakaṃ.","tha-ap155:2.1":"“Aṭṭhasaṭṭhisahassāni,","tha-ap155:2.2":"sabbe khīṇāsavā ahuṃ;","tha-ap155:2.3":"Parivāriṃsu sambuddhaṃ,","tha-ap155:2.4":"dvipadindaṃ narāsabhaṃ.","tha-ap155:3.1":"“Sammajjitvāna taṃ vīthiṃ,","tha-ap155:3.2":"niyyante lokanāyake;","tha-ap155:3.3":"Ussāpesiṃ dhajaṃ tattha,","tha-ap155:3.4":"vippasannena cetasā.","tha-ap155:4.1":"“Ekanavutito kappe,","tha-ap155:4.2":"yaṃ dhajaṃ abhiropayiṃ;","tha-ap155:4.3":"Duggatiṃ nābhijānāmi,","tha-ap155:4.4":"dhajadānassidaṃ phalaṃ.","tha-ap155:5.1":"“Ito catutthake kappe,","tha-ap155:5.2":"rājāhosiṃ mahabbalo;","tha-ap155:5.3":"Sabbākārena sampanno,","tha-ap155:5.4":"sudhajo iti vissuto.","tha-ap155:6.1":"“Paṭisambhidā catasso … pe …","tha-ap155:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap155:7.1":"Itthaṃ sudaṃ āyasmā vīthisammajjako thero imā gāthāyo abhāsitthāti.","tha-ap155:8.1":"Vīthisammajjakattherassāpadānaṃ tatiyaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3042,"to":3042,"paras":[{"para":3042,"vripara":"15","refs":["tha-ap155:1"],"lines":["So teneva puññena devamanussesu saṃsaranto ubhayasampattiyo anubhavitvā imasmiṃ buddhuppāde ekasmiṃ kule nibbatto viññutaṃ patvā satthu dhammadesanaṃ sutvā paṭiladdhasaddho bahumānahadayo pabbajitvā laddhūpasampado nacirasseva arahā hutvā attano pubbakammaṃ anussaranto paccakkhato jānitvā pubbacaritāpadānaṃ pakāsento <b>udentaṃ sataraṃsiṃ vā</b>tiādimāha.","Tattha udentaṃ uggacchantaṃ sataraṃsiṃ satapabhaṃ.","<b>Sataraṃsī</b>ti desanāsīsamattaṃ, anekasatasahassapabhaṃ sūriyaṃ ivāti attho.","<b>Pītaraṃsiṃva bhāṇuman</b>ti pītaraṃsiṃ saṃkucitapabhaṃ bhāṇumaṃ pabhāvantaṃ candamaṇḍalaṃ iva sambuddhaṃ disvāti attho.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap155:1"],["tha-ap155:1"],["tha-ap155:1"],["tha-ap155:1"],["tha-ap155:1"]]}],"wordLinks":[["tha-ap155:1.1","udentaṃ sataraṃsiṃ vā",0,0],["tha-ap155:1.1","sataraṃsī",0,2],["tha-ap155:1.1","pītaraṃsiṃva bhāṇumaṃ",0,3]],"before":[{"para":3039,"vripara":null,"refs":[],"lines":["Tambapupphiyattheraapadānavaṇṇanā samattā."],"lineRefs":[[]]},{"para":3040,"vripara":null,"refs":[],"lines":["Vīthisammajjakattheraapadānavaṇṇanā"],"lineRefs":[[]]},{"para":3041,"vripara":null,"refs":[],"lines":["<b>Udentaṃ sataraṃsiṃ vā</b>tiādikaṃ āyasmato vīthisammajjakattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro anekesu jātisatesu katapuññasañcayo sikhissa bhagavato kāle kulagehe nibbatto gharāvāsaṃ vasanto nagaravāsīhi saddhiṃ vīthiṃ sajjetvā nīyamānaṃ bhagavantaṃ disvā pasannamānaso vīthiṃ samaṃ katvā dhajaṃ tattha ussāpesi."],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
