{"suttaId":"ja83","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[467,471],"vripara":"83"},"segments":{"ja83:0.4":"Kālakaṇṇijātakaṃ","ja83:1.1":"Mitto have sattapadena hoti,","ja83:1.2":"sahāyo pana dvādasakena hoti;","ja83:1.3":"Māsaḍḍhamāsena ca ñāti hoti,","ja83:1.4":"tatuttariṃ attasamopi hoti;","ja83:1.5":"Sohaṃ kathaṃ attasukhassa hetu,","ja83:1.6":"cirasanthutaṃ [cirasandhavaṃ (ka.), cirasatthunaṃ (pī.)] kāḷakaṇṇiṃ jaheyyanti.","ja83:2.1":"Kālakaṇṇijātakaṃ tatiyaṃ. 84."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2230,"to":2230,"paras":[{"para":2230,"vripara":null,"refs":["ja83:1"],"lines":["Tattha <b>have</b>ti nipātamattaṃ.","Mettāyatīti <b>mitto,</b> mettaṃ paccupaṭṭhāpeti, sinehaṃ karotīti attho.","So panesa <b>sattapadena hoti,</b> ekato sattapadavītihāragamanamattena hotīti attho.","<b>Sahāyo pana dvādasakena hotī</b>ti sabbakiccāni ekato karaṇavasena sabbiriyāpathesu saha gacchatīti sahāyo.","So panesa dvādasakena hoti, dvādasāhaṃ ekato nivāsena hotīti attho.","<b>Māsaḍḍhamāsena cā</b>ti māsena vā aḍḍhamāsena vā.","<b>Ñāti hotī</b>ti ñātisamo hoti.","<b>Tatuttari</b>nti tato uttariṃ ekato vāsena <b>attasamopi hoti</b>yeva.","<b>Jaheyya</b>nti “evarūpaṃ sahāyaṃ kathaṃ jaheyya”nti mittassa guṇaṃ kathesi.","Tato paṭṭhāya puna koci tassa antare vattā nāma nāhosīti."],"lineRefs":[["ja83:1"],["ja83:1"],["ja83:1"],["ja83:1"],["ja83:1"],["ja83:1"],["ja83:1"],["ja83:1"],["ja83:1"],["ja83:1"]]}],"wordLinks":[["ja83:1.1","have",0,0],["ja83:1.1","mitto",0,1],["ja83:1.1","sattapadena hoti",0,2],["ja83:1.1","sahāyo pana dvādasakena hotī",0,3],["ja83:1.3","māsaḍḍhamāsena cā",0,5],["ja83:1.3","ñāti hotī",0,6],["ja83:1.3","attasamopi hoti",0,7],["ja83:1.3","tatuttariṃ",0,7],["ja83:1.5","jaheyyaṃ",0,8]]},"tika":null,"tika2":null}
