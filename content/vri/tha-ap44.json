{"suttaId":"tha-ap44","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[3559,3646],"vripara":"25"},"segments":{"tha-ap44:0.3":"Soṇakoḷivisattheraapadānaṃ","tha-ap44:1.1":"“Anomadassissa munino,","tha-ap44:1.2":"lokajeṭṭhassa tādino;","tha-ap44:1.3":"Sudhāya lepanaṃ katvā,","tha-ap44:1.4":"caṅkamaṃ kārayiṃ ahaṃ. 26.","tha-ap44:2.1":"“Nānāvaṇehi pupphehi,","tha-ap44:2.2":"caṅkamaṃ santhariṃ ahaṃ;","tha-ap44:2.3":"Ākāse vitānaṃ katvā,","tha-ap44:2.4":"bhojayiṃ buddhamuttamaṃ. 27.","tha-ap44:3.1":"“Añjaliṃ paggahetvāna,","tha-ap44:3.2":"abhivādetvāna subbataṃ [pupphakaṃ (ka.)];","tha-ap44:3.3":"Dīghasālaṃ bhagavato,","tha-ap44:3.4":"niyyādesimahaṃ tadā. 28.","tha-ap44:4.1":"“Mama saṅkappamaññāya,","tha-ap44:4.2":"satthā loke anuttaro;","tha-ap44:4.3":"Paṭiggahesi bhagavā,","tha-ap44:4.4":"anukampāya cakkhumā. 29.","tha-ap44:5.1":"“Paṭiggahetvāna sambuddho,","tha-ap44:5.2":"dakkhiṇeyyo sadevake;","tha-ap44:5.3":"Bhikkhusaṅghe nisīditvā,","tha-ap44:5.4":"imā gāthā abhāsatha. 30.","tha-ap44:6.1":"“‘Yo so haṭṭhena cittena,","tha-ap44:6.2":"dīghasālaṃ adāsi [akāsi (sī.)] me;","tha-ap44:6.3":"Tamahaṃ kittayissāmi,","tha-ap44:6.4":"suṇātha mama bhāsato. 31.","tha-ap44:7.1":"“‘Imassa maccukālamhi,","tha-ap44:7.2":"puññakammasamaṅgino;","tha-ap44:7.3":"Sahassayuttassaratho,","tha-ap44:7.4":"upaṭṭhissati tāvade. 32.","tha-ap44:8.1":"“‘Tena yānenayaṃ poso,","tha-ap44:8.2":"devalokaṃ gamissati;","tha-ap44:8.3":"Anumodissare devā,","tha-ap44:8.4":"sampatte kusalabbhave [kusale bhave (sī. syā.)]. 33.","tha-ap44:9.1":"“‘Mahārahaṃ byamhaṃ seṭṭhaṃ,","tha-ap44:9.2":"ratanamattikalepanaṃ;","tha-ap44:9.3":"Kūṭāgāravarūpetaṃ,","tha-ap44:9.4":"byamhaṃ ajjhāvasissati. 34.","tha-ap44:10.1":"“‘Tiṃsakappasahassāni,","tha-ap44:10.2":"devaloke ramissati;","tha-ap44:10.3":"Pañcavīsati kappāni,","tha-ap44:10.4":"devarājā bhavissati. 35.","tha-ap44:11.1":"“‘Sattasattatikkhattuñca,","tha-ap44:11.2":"cakkavattī bhavissati;","tha-ap44:11.3":"Yasodharasanāmā [yasedharā samānā (sī.)] te,","tha-ap44:11.4":"sabbepi ekanāmakā. 36.","tha-ap44:12.1":"“‘Dve sampattī anubhotvā,","tha-ap44:12.2":"vaḍḍhetvā [cinitvā (syā.)] puññasañcayaṃ;","tha-ap44:12.3":"Aṭṭhavīsatikappamhi,","tha-ap44:12.4":"cakkavattī bhavissati. 37.","tha-ap44:13.1":"“‘Tatrāpi byamhaṃ pavaraṃ,","tha-ap44:13.2":"vissakammena māpitaṃ;","tha-ap44:13.3":"Dasasaddāvivittaṃ taṃ,","tha-ap44:13.4":"puramajjhāvasissati. 38.","tha-ap44:14.1":"“‘Aparimeyye ito kappe,","tha-ap44:14.2":"bhūmipālo mahiddhiko;","tha-ap44:14.3":"Okkāko nāma nāmena,","tha-ap44:14.4":"rājā raṭṭhe bhavissati. 39.","tha-ap44:15.1":"“‘Soḷasitthisahassānaṃ,","tha-ap44:15.2":"sabbāsaṃ pavarā ca sā [pavarāva yā (syā.), pavarā piyā (?)];","tha-ap44:15.3":"Abhijātā khattiyānī,","tha-ap44:15.4":"nava putte janessati. 40.","tha-ap44:16.1":"“‘Nava putte janetvāna,","tha-ap44:16.2":"khattiyānī marissati;","tha-ap44:16.3":"Taruṇī ca piyā kaññā,","tha-ap44:16.4":"mahesittaṃ karissati. 41.","tha-ap44:17.1":"“‘Okkākaṃ tosayitvāna,","tha-ap44:17.2":"varaṃ kaññā labhissati;","tha-ap44:17.3":"Varaṃ laddhāna sā kaññā,","tha-ap44:17.4":"putte pabbājayissati. 42.","tha-ap44:18.1":"“‘Pabbājitā ca te sabbe,","tha-ap44:18.2":"gamissanti naguttamaṃ;","tha-ap44:18.3":"Jātibhedabhayā sabbe,","tha-ap44:18.4":"bhaginīhi vasissare [saṃvasissare (sī.)]. 43.","tha-ap44:19.1":"“‘Ekā ca kaññā byādhīhi,","tha-ap44:19.2":"bhavissati parikkhatā [purakkhatā (syā. ka.)];","tha-ap44:19.3":"Mā no jāti pabhijjīti,","tha-ap44:19.4":"nikhaṇissanti khattiyā. 44.","tha-ap44:20.1":"“‘Khattiyo nīharitvāna,","tha-ap44:20.2":"tāya saddhiṃ vasissati;","tha-ap44:20.3":"Bhavissati tadā bhedo,","tha-ap44:20.4":"okkākakulasambhavo. 45.","tha-ap44:21.1":"“‘Tesaṃ pajā bhavissanti,","tha-ap44:21.2":"koḷiyā nāma jātiyā;","tha-ap44:21.3":"Tattha mānusakaṃ bhogaṃ,","tha-ap44:21.4":"anubhossatinappakaṃ. 46.","tha-ap44:22.1":"“‘Tamhā kāyā cavitvāna,","tha-ap44:22.2":"devalokaṃ gamissati;","tha-ap44:22.3":"Tatrāpi pavaraṃ byamhaṃ,","tha-ap44:22.4":"labhissati manoramaṃ. 47.","tha-ap44:23.1":"“‘Devalokā cavitvāna,","tha-ap44:23.2":"sukkamūlena codito;","tha-ap44:23.3":"Āgantvāna manussattaṃ,","tha-ap44:23.4":"soṇo nāma bhavissati. 48.","tha-ap44:24.1":"“‘Āraddhavīriyo pahitatto,","tha-ap44:24.2":"padahaṃ satthu sāsane;","tha-ap44:24.3":"Sabbāsave pariññāya,","tha-ap44:24.4":"nibbāyissatināsavo. 49.","tha-ap44:25.1":"“‘Anantadassī bhagavā,","tha-ap44:25.2":"gotamo sakyapuṅgavo;","tha-ap44:25.3":"Visesaññū mahāvīro,","tha-ap44:25.4":"aggaṭṭhāne ṭhapessati’. 50.","tha-ap44:26.1":"“Vuṭṭhamhi deve caturaṅgulamhi,","tha-ap44:26.2":"tiṇe anileritaaṅgaṇamhi;","tha-ap44:26.3":"Ṭhatvāna yogassa payuttatādino,","tha-ap44:26.4":"tatottariṃ pāramatā na vijjati. 51.","tha-ap44:27.1":"“Uttame damathe danto,","tha-ap44:27.2":"cittaṃ me supaṇīhitaṃ;","tha-ap44:27.3":"Bhāro me ohito sabbo,","tha-ap44:27.4":"nibbutomhi anāsavo. 52.","tha-ap44:28.1":"“Aṅgīraso mahānāgo,","tha-ap44:28.2":"abhijātova kesarī;","tha-ap44:28.3":"Bhikkhusaṅghe nisīditvā,","tha-ap44:28.4":"etadagge ṭhapesi maṃ. 53.","tha-ap44:29.1":"“Paṭisambhidā catasso…pe…","tha-ap44:29.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap44:30.1":"Itthaṃ sudaṃ āyasmā soṇo koḷiviso [koḷiyavesso (sī. syā.), koṭikaṇṇo (ka.)] thero imā gāthāyo abhāsitthāti.","tha-ap44:31.1":"Soṇakoḷivisattherassāpadānaṃ dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2496,"to":2498,"paras":[{"para":2496,"vripara":"25","refs":["tha-ap44:1"],"lines":["So arahā hutvā attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>anomadassissa munino</b>tiādimāha.","Tattha <b>anomadassissā</b>ti anomaṃ alāmakaṃ sundaraṃ dassanaṃ dvattiṃsamahāpurisalakkhaṇapaṭimaṇḍitattā byāmappabhāmaṇḍalopasobhitattā ārohapariṇāhena samannāgatattā ca dassanīyaṃ sarīraṃ yassa bhagavato so anomadassī, tassa anomadassissa muninoti attho.","<b>Tādino</b>ti iṭṭhāniṭṭhesu akampiyasabhāvassa.","<b>Sudhāya lepanaṃ katvā</b>ti sudhāya avalittaṃ katvā dīpadhūpapupphadhajapaṭākādīhi ca alaṅkataṃ caṅkamaṃ <b>kārayiṃ</b> akāsinti attho.","Sesagāthānaṃ attho pāḷiyā anusārena suviññeyyova. 35."],"lineRefs":[["tha-ap44:1"],["tha-ap44:1"],["tha-ap44:1"],["tha-ap44:1"],["tha-ap44:1"]]},{"para":2497,"vripara":"35","refs":["tha-ap44:1"],"lines":["Parivārasampattidhanasampattisaṅkhātaṃ yasaṃ dhāretīti yasodharo, sabbe ete sattasattaticakkavattirājāno yasodharanāmena ekanāmakāti sambandho. 52."],"lineRefs":[["tha-ap44:1"]]},{"para":2498,"vripara":"52","refs":["tha-ap44:28"],"lines":["<b>Aṅgīraso</b>ti aṅgato sarīrato niggatā rasmi yassa so aṅgīraso, chandadosamohabhayāgatīhi vā pāpācāravasena vā caturāpāyaṃ na gacchatīti nāgo, mahanto pūjito ca so nāgo ceti <b>mahānāgo</b>.","Sesaṃ uttānatthamevāti."],"lineRefs":[["tha-ap44:28"],["tha-ap44:28"]]}],"wordLinks":[["tha-ap44:1.1","anomadassissa munino",0,0],["tha-ap44:1.1","anomadassissā",0,1],["tha-ap44:1.1","tādino",0,2],["tha-ap44:1.3","kārayiṃ",0,3],["tha-ap44:1.3","sudhāya lepanaṃ katvā",0,3],["tha-ap44:28.1","aṅgīraso",2,0],["tha-ap44:28.1","mahānāgo",2,0]],"before":[{"para":2494,"vripara":null,"title":"Soṇakoḷivisattheraapadānavaṇṇanā","lines":["Soṇakoḷivisattheraapadānavaṇṇanā"]},{"para":2495,"vripara":null,"title":"Soṇakoḷivisattheraapadānavaṇṇanā","lines":["<b>Anomadassissa</b> <b>munino</b>tiādikaṃ āyasmato koḷivisattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto anomadassissa bhagavato kāle ekasmiṃ kulagehe nibbatto vayappatto puttadārehi vaḍḍhito vibhavasampanno bhagavato caṅkamanatthāya sobhanaṃ caṅkamaṃ kāretvā sudhāparikammaṃ kāretvā ādāsatalamiva samaṃ vijjotamānaṃ katvā dīpadhūpapupphādīhi sajjetvā bhagavato niyyādetvā buddhappamukhaṃ bhikkhusaṅghaṃ paṇītenāhārena pūjesi.","So evaṃ yāvajīvaṃ puññāni katvā tato cavitvā devaloke nibbatto.","Tattha pāḷiyā vuttanayena dibbasampattiṃ anubhavitvā antarā okkākakulappasutoti taṃ sabbaṃ pāḷiyā vuttānusārena veditabbaṃ.","Pacchimabhave pana koliyarājavaṃse jāto vayappatto koṭiagghanakassa kaṇṇapiḷandhanassa dhāritattā <b>koṭikaṇṇo</b>ti, <b>kuṭikaṇṇo</b>ti ca pākaṭo ahosi.","So bhagavati pasanno dhammaṃ sutvā paṭiladdhasaddho pabbajitvā vipassanaṃ vaḍḍhetvā nacirasseva arahattaṃ pāpuṇi. 25."]}],"after":[{"para":2499,"vripara":null,"title":"Soṇakoḷivisattheraapadānavaṇṇanā","lines":["Koḷivisattheraapadānavaṇṇanā samattā. 3."]}]},"tika":null,"tika2":null}
