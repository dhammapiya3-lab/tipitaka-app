{"suttaId":"thag3.13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1273,1282],"vripara":"255"},"segments":{"thag3.13:0.4":"Abhibhūtattheragāthā","thag3.13:1.1":"“Suṇātha ñātayo sabbe, yāvantettha samāgatā;","thag3.13:1.3":"Dhammaṃ vo desayissāmi, dukkhā jāti punappunaṃ.","thag3.13:2.1":"[saṃ. ni.1.185]“Ārambhatha [ārabhatha (sī. syā.), ārabbhatha (ka.)] nikkamatha, yuñjatha buddhasāsane;","thag3.13:2.3":"Dhunātha maccuno senaṃ, naḷāgāraṃva kuñjaro.","thag3.13:3.1":"“Yo imasmiṃ dhammavinaye, <b>appamatto</b> vihassati [vihessati (syā. pī.)];","thag3.13:3.3":"Pahāya jātisaṃsāraṃ, dukkhassantaṃ karissatī”ti.","thag3.13:3.5":"… Abhibhūto thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":5357,"to":5357,"paras":[{"para":5357,"vripara":null,"refs":["thag3.13:3"],"lines":["Evaṃ pana buddhasāsane ussāhaṃ karontassa ekaṃsiko jātidukkhassa samatikkamoti dassento <b>“yo imasmin”</b>tiādinā tatiyaṃ gāthamāha.","Taṃ suviññeyyameva."],"lineRefs":[["thag3.13:3"],["thag3.13:3"]]}],"wordLinks":[["thag3.13:3.1","yo imasmiṃ",0,0]]},"tika":null}
