{"suttaId":"sn40.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1665,1675],"vripara":"342"},"segments":{"sn40.11:0.3":"Candanasuttaṃ","sn40.11:1.1":"Atha kho candano [nandano (sī.)] devaputto … pe ….","sn40.11:2.1":"Atha kho suyāmo devaputto … pe ….","sn40.11:3.1":"Atha kho santusito devaputto … pe ….","sn40.11:4.1":"Atha kho sunimmito devaputto … pe ….","sn40.11:5.1":"Atha kho vasavatti devaputto … pe ….","sn40.11:6.1":"(Yathā sakkasuttaṃ tathā ime pañca peyyālā vitthāretabbā).","sn40.11:6.2":"Ekādasamaṃ.","sn40.11:6.3":"Moggallānasaṃyuttaṃ samattaṃ. Tassuddānaṃ – Savitakkāvitakkañca, sukhena ca upekkhako; Ākāsañceva viññāṇaṃ, ākiñcaṃ nevasaññinā; Animitto ca sakko ca, candanekādasena cāti."},"unsure":["sn40.11:6.3"],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":684,"to":687,"paras":[{"para":684,"vripara":"341-342","refs":["sn40.11:1"],"lines":["341-342. <b>Aveccappasādenā</b>ti acalappasādena.","<b>Dasahi ṭhānehī</b>ti dasahi kāraṇehi.","<b>Adhigaṇhantī</b>ti abhibhavanti, atikkamitvā tiṭṭhanti.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn40.11:1"],["sn40.11:1"],["sn40.11:1"],["sn40.11:1"]]},{"para":685,"vripara":null,"refs":["sn40.11:1"],"lines":["Moggallānasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn40.11:1"]]},{"para":686,"vripara":null,"refs":["sn40.11:1"],"lines":["Cittasaṃyuttaṃ"],"lineRefs":[["sn40.11:1"]]},{"para":687,"vripara":null,"refs":["sn40.11:1"],"lines":["Saṃyojanasuttavaṇṇanā"],"lineRefs":[["sn40.11:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":596,"to":600,"paras":[{"para":596,"vripara":"341-342","refs":["sn40.11:1"],"lines":["341-342. <b>Aveccappasādenā</b>ti vatthuttayaṃ yāthāvato ñatvā uppannapasādena, maggenāgatapasādenāti attho.","So pana kenaci asaṃhāriyo asampavedhīti āha <b>“acalappasādenā”</b>ti.","<b>Abhibhavanti</b> attano puññānubhāvena."],"lineRefs":[["sn40.11:1"],["sn40.11:1"],["sn40.11:1"]]},{"para":597,"vripara":null,"refs":["sn40.11:1"],"lines":["Sakkasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn40.11:1"]]},{"para":598,"vripara":null,"refs":["sn40.11:1"],"lines":["Moggallānasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn40.11:1"]]},{"para":599,"vripara":null,"refs":["sn40.11:1"],"lines":["Cittasaṃyuttaṃ"],"lineRefs":[["sn40.11:1"]]},{"para":600,"vripara":null,"refs":["sn40.11:1"],"lines":["Saṃyojanasuttavaṇṇanā"],"lineRefs":[["sn40.11:1"]]}],"wordLinks":[]},"tika2":null}
