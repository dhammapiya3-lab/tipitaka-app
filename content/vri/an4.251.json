{"suttaId":"an4.251","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1848,1848],"vripara":"251"},"segments":{"an4.251:0.3":"Dutiyavohārasuttaṃ","an4.251:1.1":"“Cattārome, bhikkhave, ariyavohārā.","an4.251:1.2":"Katame cattāro?","an4.251:1.3":"Adiṭṭhe adiṭṭhavāditā, asute asutavāditā, amute amutavāditā, aviññāte aviññātavāditā – ime kho, bhikkhave, cattāro ariyavohārā”ti.","an4.251:1.5":"Navamaṃ."},"attha":null,"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1910,"to":1915,"paras":[{"para":1910,"vripara":"250-253","refs":["an4.251:1"],"lines":["250-253. Aṭṭhame <b>anariyānan</b>ti asādhūnaṃ nihīnānaṃ.","<b>Vohārā</b>ti saṃvohārā abhilāpā vā,“diṭṭhaṃ mayā”ti evaṃvāditā.","Ettha ca taṃtaṃsamuṭṭhāpakacetanāvasena attho veditabbo.","Navamādīsu natthi vattabbaṃ."],"lineRefs":[["an4.251:1"],["an4.251:1"],["an4.251:1"],["an4.251:1"]]},{"para":1911,"vripara":null,"refs":[],"lines":["Paṭhamavohārasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1912,"vripara":null,"refs":[],"lines":["Āpattibhayavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1913,"vripara":null,"refs":[],"lines":["Pañcamapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[[]]},{"para":1914,"vripara":null,"refs":[],"lines":["(26)6. Abhiññāvaggo"],"lineRefs":[[]]},{"para":1915,"vripara":null,"refs":["an4.251:1"],"lines":["1-3. Abhiññāsuttādivaṇṇanā"],"lineRefs":[["an4.251:1"]]}],"wordLinks":[]},"tika2":null}
