{"suttaId":"an4.251","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1848,1848],"vripara":"251"},"segments":{"an4.251:0.3":"Dutiyavohārasuttaṃ","an4.251:1.1":"“Cattārome, bhikkhave, ariyavohārā.","an4.251:1.2":"Katame cattāro?","an4.251:1.3":"Adiṭṭhe adiṭṭhavāditā, asute asutavāditā, amute amutavāditā, aviññāte aviññātavāditā –","an4.251:1.4":"ime kho, bhikkhave, cattāro ariyavohārā”ti.","an4.251:1.5":"Navamaṃ. 10."},"unsure":[],"preface":[],"attha":null,"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1910,"to":1915,"paras":[{"para":1910,"vripara":"250-253","refs":["an4.251:1"],"lines":["Aṭṭhame <b>anariyāna</b>nti asādhūnaṃ nihīnānaṃ.","<b>Vohārā</b>ti saṃvohārā abhilāpā vā, “diṭṭhaṃ mayā”ti evaṃvāditā.","Ettha ca taṃtaṃsamuṭṭhāpakacetanāvasena attho veditabbo.","Navamādīsu natthi vattabbaṃ."],"lineRefs":[["an4.251:1"],["an4.251:1"],["an4.251:1"],["an4.251:1"]]},{"para":1911,"vripara":null,"refs":["an4.251:1"],"lines":["Paṭhamavohārasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["an4.251:1"]]},{"para":1912,"vripara":null,"refs":["an4.251:1"],"lines":["Āpattibhayavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an4.251:1"]]},{"para":1913,"vripara":null,"refs":["an4.251:1"],"lines":["Pañcamapaṇṇāsakaṃ niṭṭhitaṃ. (26) 6."],"lineRefs":[["an4.251:1"]]},{"para":1914,"vripara":null,"refs":["an4.251:1"],"lines":["Abhiññāvaggo 1-3."],"lineRefs":[["an4.251:1"]]},{"para":1915,"vripara":null,"refs":["an4.251:1"],"lines":["Abhiññāsuttādivaṇṇanā 254-256."],"lineRefs":[["an4.251:1"]]}],"wordLinks":[]},"tika2":null}
