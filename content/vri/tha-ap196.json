{"suttaId":"tha-ap196","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7278,7296],"vripara":"17"},"segments":{"tha-ap196:0.3":"Asokapūjakattheraapadānaṃ","tha-ap196:1.1":"“Tivarāyaṃ [tipurāyaṃ (syā.)] pure ramme,","tha-ap196:1.2":"rājuyyānaṃ ahu tadā;","tha-ap196:1.3":"Uyyānapālo tatthāsiṃ,","tha-ap196:1.4":"rañño baddhacaro ahaṃ. 18.","tha-ap196:2.1":"“Padumo nāma nāmena,","tha-ap196:2.2":"sayambhū sappabho ahu;","tha-ap196:2.3":"Nisinnaṃ [nisinno (ka.)] puṇḍarīkamhi,","tha-ap196:2.4":"chāyā na jahi taṃ muniṃ. 19.","tha-ap196:3.1":"“Asokaṃ pupphitaṃ disvā,","tha-ap196:3.2":"piṇḍibhāraṃ sudassanaṃ;","tha-ap196:3.3":"Buddhassa abhiropesiṃ,","tha-ap196:3.4":"jalajuttamanāmino. 20.","tha-ap196:4.1":"“Catunnavutito kappe,","tha-ap196:4.2":"yaṃ pupphamabhiropayiṃ;","tha-ap196:4.3":"Duggatiṃ nābhijānāmi,","tha-ap196:4.4":"buddhapūjāyidaṃ phalaṃ. 21.","tha-ap196:5.1":"“Sattatiṃsamhito kappe,","tha-ap196:5.2":"soḷasa araṇañjahā [aruṇañjahā (sī.)];","tha-ap196:5.3":"Sattaratanasampannā,","tha-ap196:5.4":"cakkavattī mahabbalā. 22.","tha-ap196:6.1":"“Paṭisambhidā catasso…pe…","tha-ap196:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap196:7.1":"Itthaṃ sudaṃ āyasmā asokapūjako thero imā gāthāyo abhāsitthāti.","tha-ap196:8.1":"Asokapūjakattherassāpadānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3174,"to":3175,"paras":[{"para":3174,"vripara":"17","refs":["tha-ap196:1"],"lines":["Catutthattherassāpadāne <b>rañño baddhacaro aha</b>nti rañño paricārako kammakārako ahosinti attho. 19."],"lineRefs":[["tha-ap196:1"]]},{"para":3175,"vripara":"19","refs":["tha-ap196:3"],"lines":["<b>Jalajuttamanāmino</b>ti jale udake jātaṃ jalajaṃ, kiṃ taṃ padumaṃ, padumena samānanāmattā padumuttarassa bhagavatoti attho.","Uttamapadumanāmassa bhagavatoti vā attho.","Catutthaṃ."],"lineRefs":[["tha-ap196:3"],["tha-ap196:3"],["tha-ap196:3"]]}],"wordLinks":[["tha-ap196:1.3","rañño bad