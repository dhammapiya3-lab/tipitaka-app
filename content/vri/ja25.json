{"suttaId":"ja25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[140,143],"vripara":"25"},"segments":{"ja25:0.4":"Titthajātakaṃ","ja25:1.1":"Aññamaññehi titthehi, assaṃ pāyehi sārathi;","ja25:1.3":"Accāsanassa puriso, pāyāsassapi tappatīti.","ja25:2.1":"Titthajātakaṃ pañcamaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1331,"to":1331,"paras":[{"para":1331,"vripara":null,"refs":["ja25:1"],"lines":["Tattha <b>aññamaññehī</b>ti aññehi aññehi.","<b>Pāyehī</b>ti desanāsīsametaṃ, nhāpehi ca pāyehi cāti attho.","<b>Accāsanassā</b>ti karaṇatthe sāmivacanaṃ, atiasanena atibhuttenāti attho.","<b>Pāyāsassapi tappatī</b>ti sappiādīhi abhisaṅkhatena madhurapāyāsena tappati titto hoti, dhāto suhito na puna bhuñjitukāmataṃ āpajjati.","Tasmā ayampi asso imasmiṃ titthe nibaddhaṃ nhānena pariyattiṃ āpanno bhavissati, aññattha naṃ nhāpethāti."],"lineRefs":[["ja25:1"],["ja25:1"],["ja25:1"],["ja25:1"],["ja25:1"]]}],"wordLinks":[["ja25:1.1","aññamaññehī",0,0],["ja25:1.1","pāyehī",0,1],["ja25:1.3","accāsanassā",0,2],["ja25:1.3","pāyāsassapi tappatī",0,3]]},"tika":null}
