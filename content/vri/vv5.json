{"suttaId":"vv5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[105,141],"vripara":"31"},"segments":{"vv5:0.4":"Kuñjaravimānavatthu","vv5:1.1":"“Kuñjaro te varāroho,","vv5:1.2":"nānāratanakappano;","vv5:1.3":"Ruciro thāmavā javasampanno,","vv5:1.4":"ākāsamhi samīhati. 32.","vv5:2.1":"“Padumi padma [paduma… (sī. syā.) evamuparipi] pattakkhi,","vv5:2.2":"padmuppalajutindharo;","vv5:2.3":"Padmacuṇṇābhikiṇṇaṅgo,","vv5:2.4":"soṇṇapokkharamāladhā [… mālavā (sī. syā.)]. 33.","vv5:3.1":"“Padumānusaṭaṃ maggaṃ,","vv5:3.2":"padmapattavibhūsitaṃ.","vv5:3.3":"Ṭhitaṃ vaggumanugghātī,","vv5:3.4":"mitaṃ gacchati vāraṇo. 34.","vv5:4.1":"“Tassa pakkamamānassa,","vv5:4.2":"soṇṇakaṃsā ratissarā;","vv5:4.3":"Tesaṃ suyyati nigghoso, turiye pañcaṅgike yathā. 35.","vv5:5.1":"“Tassa nāgassa khandhamhi,","vv5:5.2":"sucivatthā alaṅkatā;","vv5:5.3":"Mahantaṃ accharāsaṅghaṃ,","vv5:5.4":"vaṇṇena atirocasi. 36.","vv5:6.1":"“Dānassa te idaṃ phalaṃ,","vv5:6.2":"atho sīlassa vā pana;","vv5:6.3":"Atho añjalikammassa,","vv5:6.4":"taṃ me akkhāhi pucchitā”ti; 37.","vv5:7.1":"Sā devatā attamanā,","vv5:7.2":"moggallānena pucchitā;","vv5:7.3":"Pañhaṃ puṭṭhā viyākāsi,","vv5:7.4":"yassa kammassidaṃ phalaṃ. 38.","vv5:8.1":"“Disvāna guṇasampannaṃ,","vv5:8.2":"jhāyiṃ jhānarataṃ sataṃ;","vv5:8.3":"Adāsiṃ pupphābhikiṇṇaṃ,","vv5:8.4":"āsanaṃ dussasanthataṃ. 39.","vv5:9.1":"“Upaḍḍhaṃ padmamālāhaṃ,","vv5:9.2":"āsanassa samantato;","vv5:9.3":"Abbhokirissaṃ pattehi,","vv5:9.4":"pasannā sehi pāṇibhi. 40.","vv5:10.1":"“Tassa kammakusalassa [kammassa kusalassa (sī. pī.)],","vv5:10.2":"idaṃ me īdisaṃ phalaṃ;","vv5:10.3":"Sakkāro garukāro ca,","vv5:10.4":"devānaṃ apacitā ahaṃ. 41.","vv5:11.1":"“Yo ve sammāvimuttānaṃ,","vv5:11.2":"santānaṃ brahmacārinaṃ;","vv5:11.3":"Pasanno āsanaṃ dajjā,","vv5:11.4":"evaṃ nande yathā ahaṃ. 42.","vv5:12.1":"“Tasmā hi attakāmena [atthakāmena (ka.)],","vv5:12.2":"mahattamabhikaṅkhatā;","vv5:12.3":"Āsanaṃ dātabbaṃ hoti,","vv5:12.4":"sarīrantimadhārina”nti.","vv5:13.1":"Kuñjaravimānaṃ pañcamaṃ. 6."},"unsure":["vv5:4.3"],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":244,"to":248,"paras":[{"para":244,"vripara":"38","refs":["vv5:8"],"lines":["Tattha <b>guṇasampanna</b>nti sabbehi sāvakaguṇehi samannāgataṃ, tehi vā paripuṇṇaṃ.","Etena sāvakapāramiñāṇassa matthakappattiṃ dasseti.","<b>Jhāyi</b>nti ārammaṇūpanijjhānaṃ lakkhaṇūpanijjhānanti duvidhenāpi jhānena jhāyanasīlaṃ, tena vā jhāpetabbaṃ sabbasaṃkilesapakkhaṃ jhāpetvā ṭhitaṃ.","Tato eva jhāne ratanti <b>jhānarataṃ.</b>","<b>Sata</b>nti samānaṃ, santaṃ vā, sappurisanti attho.","<b>Pupphābhikiṇṇa</b>nti pupphehi abhikiṇṇaṃ, kamaladalehi abhippakiṇṇanti attho.","<b>Dussasanthata</b>nti vatthena upari atthataṃ. 39."],"lineRefs":[["vv5:8"],["vv5:8"],["vv5:8"],["vv5:8"],["vv5:8"],["vv5:8"],["vv5:8"]]},{"para":245,"vripara":"39","refs":["vv5:9"],"lines":["<b>Upaḍḍhaṃ padmamālāha</b>nti upaḍḍhaṃ padumapupphaṃ ahaṃ.","<b>Āsanassa samantato</b>ti therena nisinnassa āsanassa samantā bhūmiyaṃ.","<b>Abbhokirissa</b>nti abhiokiriṃ abhippakiriṃ.","Kathaṃ?","<b>Pattehī</b>ti, tassa upaḍḍhapadumassa visuṃ visuṃ katehi pattehi pupphavassābhivassanakaniyāmena okirinti attho. 40."],"lineRefs":[["vv5:9"],["vv5:9"],["vv5:9"],["vv5:9"],["vv5:9"]]},{"para":246,"vripara":"40","refs":["vv5:10"],"lines":["<b>Idaṃ me īdisaṃ phala</b>nti iminā “kuñjaro te varāroho”tiādinā therena gahitaṃ aggahitañca āyuyasasukharūpādibhedaṃ attano dibbasampattiṃ ekato dassetvā punapi therena aggahitameva attano ānubhāvasampattiṃ dassetuṃ <b>“sakkāro garukāro”</b>tiādimāha.","Tena “na kevalaṃ bhante tumhehi yathāvuttameva idha mayhaṃ puññaphalaṃ, apica kho idaṃ dibbaṃ ādhipateyyampī”ti dasseti.","Tattha <b>sakkāro</b>ti ādarakiriyā, devehi attano sakkātabbatāti attho.","Tathā <b>garukāro</b>ti garukātabbatā.","<b>Devāna</b>nti devehi.","<b>Apacitā</b>ti pūjitā. 41."],"lineRefs":[["vv5:10"],["vv5:10"],["vv5:10"],["vv5:10"],["vv5:10"],["vv5:10"]]},{"para":247,"vripara":"41","refs":["vv5:11"],"lines":["<b>Sammāvimuttāna</b>nti suṭṭhu vimuttānaṃ sabbasaṃkilesappahāyīnaṃ.","<b>Santāna</b>nti santakāyavacīmanokammānaṃ sādhūnaṃ.","Maggabrahmacariyassa ca sāsanabrahmacariyassa ca ciṇṇattā <b>brahmacārinaṃ.</b>","<b>Pasanno āsanaṃ dajjā</b>ti kammaphalasaddhāya ratanattayasaddhāya ca pasannamānaso hutvā yadi āsanamattampi dadeyya.","<b>Evaṃ nande yathā aha</b>nti yathā ahaṃ tena āsanadānena etarahi nandāmi modāmi, evameva aññopi nandeyya modeyya. 42."],"lineRefs":[["vv5:11"],["vv5:11"],["vv5:11"],["vv5:11"],["vv5:11"]]},{"para":248,"vripara":"42","refs":["vv5:12"],"lines":["<b>Tasmā</b>ti tena kāraṇena.","<b>Hi</b>-saddo nipātamattaṃ.","<b>Attakāmenā</b>ti attano hitakāmena.","Yo hi attano hitāvahaṃ kammaṃ karoti, na ahitāvahaṃ, so attakāmo.","<b>Mahatta</b>nti vipākamahattaṃ.","<b>Sarīrantimadhārina</b>nti antimaṃ dehaṃ dhārentānaṃ, khīṇāsavānanti attho.","Ayañhettha attho – yasmā arahataṃ āsanadānena ahaṃ evaṃ dibbasampattiyā modāmi, tasmā aññenāpi attano abhivuddhiṃ patthayamānena antimasamussaye ṭhitānaṃ āsanaṃ dātabbaṃ, natthi tādisaṃ puññanti dasseti.","Tesaṃ vuttasadisamevāti."],"lineRefs":[["vv5:12"],["vv5:12"],["vv5:12"],["vv5:12"],["vv5:12"],["vv5:12"],["vv5:12"],["vv5:12"]]}],"wordLinks":[["vv5:8.1","guṇasampannaṃ",0,0],["vv5:8.1","jhāyiṃ",0,2],["vv5:8.1","jhānarataṃ",0,3],["vv5:8.1","sataṃ",0,4],["vv5:8.3","pupphābhikiṇṇaṃ",0,5],["vv5:8.3","dussasanthataṃ",0,6],["vv5:9.1","upaḍḍhaṃ padmamālāhaṃ",1,0],["vv5:9.1","āsanassa samantato",1,1],["vv5:9.3","abbhokirissaṃ",1,2],["vv5:9.3","pattehī",1,4],["vv5:10.1","idaṃ me īdisaṃ phalaṃ",2,0],["vv5:10.3","sakkāro garukāro",2,0],["vv5:10.3","sakkāro",2,2],["vv5:10.3","garukāro",2,3],["vv5:10.3","devānaṃ",2,4],["vv5:10.3","apacitā",2,5],["vv5:11.1","sammāvimuttānaṃ",3,0],["vv5:11.1","santānaṃ",3,1],["vv5:11.1","brahmacārinaṃ",3,2],["vv5:11.3","pasanno āsanaṃ dajjā",3,3],["vv5:11.3","evaṃ nande yathā ahaṃ",3,4],["vv5:12.1","tasmā",4,0],["vv5:12.1","hi",4,1],["vv5:12.1","attakāmenā",4,2],["vv5:12.1","mahattaṃ",4,4],["vv5:12.3","sarīrantimadhārinaṃ",4,5]],"after":[{"para":249,"vripara":null,"title":"Kuñjaravimānavaṇṇanā","lines":["Kuñjaravimānavaṇṇanā niṭṭhitā. 6."]}]},"tika":null,"tika2":null}
