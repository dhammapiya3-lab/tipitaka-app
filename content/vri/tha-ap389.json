{"suttaId":"tha-ap389","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[11049,11064],"vripara":"37"},"segments":{"tha-ap389:0.3":"Kadaliphaladāyakattheraapadānaṃ","tha-ap389:1.1":"“Kaṇikāraṃva jalitaṃ,","tha-ap389:1.2":"puṇṇamāyeva [puṇṇamāseva (sī. ka.)] candimaṃ;","tha-ap389:1.3":"Jalantaṃ dīparukkhaṃva,","tha-ap389:1.4":"addasaṃ lokanāyakaṃ.","tha-ap389:2.1":"“Kadaliphalaṃ paggayha,","tha-ap389:2.2":"adāsiṃ satthuno ahaṃ;","tha-ap389:2.3":"Pasannacitto sumano,","tha-ap389:2.4":"vanditvāna apakkamiṃ.","tha-ap389:3.1":"“Ekattiṃse ito kappe,","tha-ap389:3.2":"yaṃ phalamadadiṃ tadā;","tha-ap389:3.3":"Duggatiṃ nābhijānāmi,","tha-ap389:3.4":"phaladānassidaṃ phalaṃ.","tha-ap389:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap389:4.3":"viharāmi anāsavo.","tha-ap389:5.1":"“Svāgataṃ vata me āsi … pe …","tha-ap389:5.3":"kataṃ buddhassa sāsanaṃ.","tha-ap389:6.1":"“Paṭisambhidā catasso … pe …","tha-ap389:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap389:7.1":"Itthaṃ sudaṃ āyasmā kadaliphaladāyako thero imā gāthāyo abhāsitthāti.","tha-ap389:8.1":"Kadaliphaladāyakattherassāpadānaṃ sattamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
