{"suttaId":"ja170","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1020,1030],"vripara":"39"},"segments":{"ja170:0.4":"Kakaṇṭakajātakaṃ (2-2-10)","ja170:1.1":"Nāyaṃ pure uṇṇamati [unnamati (syā.)], toraṇagge kakaṇṭako;","ja170:1.3":"Mahosadha vijānāhi, kena thaddho kakaṇṭako.","ja170:2.1":"Aladdhapubbaṃ laddhāna, aḍḍhamāsaṃ kakaṇṭako;","ja170:2.3":"Atimaññati rājānaṃ, vedehaṃ mithilaggahanti.","ja170:3.1":"Kakaṇṭakajātakaṃ dasamaṃ.","ja170:3.2":"Santhavavaggo dutiyo.","ja170:4.1":"Tassuddānaṃ –","ja170:5.1":"Atha indasamāna sapaṇṇakuṭi, susimuttama gijjha jalābujako;","ja170:5.3":"Upasāḷaka bhikkhu salāpavaro, atha mettavaro dasapuṇṇamatīti."},"attha":null,"tika":null}
