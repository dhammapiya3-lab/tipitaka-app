{"suttaId":"snp5.13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3805,3819],"vripara":"1107"},"segments":{"snp5.13:0.2":"Bhadrāvudhamāṇavapucchā","snp5.13:1.1":"“Okañjahaṃ taṇhacchidaṃ anejaṃ,","snp5.13:1.2":"(iccāyasmā bhadrāvudho)","snp5.13:1.3":"Nandiñjahaṃ oghatiṇṇaṃ vimuttaṃ;","snp5.13:1.4":"Kappañjahaṃ abhiyāce sumedhaṃ,","snp5.13:1.5":"sutvāna nāgassa apanamissanti ito.","snp5.13:2.1":"“Nānājanā janapadehi saṅgatā,","snp5.13:2.2":"tava vīra vākyaṃ abhikaṅkhamānā;","snp5.13:2.3":"Tesaṃ tuvaṃ sādhu viyākarohi,","snp5.13:2.4":"tathā hi te vidito esa dhammo”.","snp5.13:3.1":"“Ādānataṇhaṃ vinayetha sabbaṃ,","snp5.13:3.2":"(bhadrāvudhāti bhagavā)","snp5.13:3.3":"Uddhaṃ adho tiriyañcāpi majjhe;","snp5.13:3.4":"Yaṃ yañhi lokasmimupādiyanti,","snp5.13:3.5":"teneva māro anveti jantuṃ.","snp5.13:4.1":"“Tasmā pajānaṃ na upādiyetha,","snp5.13:4.2":"bhikkhu sato kiñcanaṃ sabbaloke;","snp5.13:4.3":"Ādānasatte iti pekkhamāno,","snp5.13:4.4":"pajaṃ imaṃ maccudheyye visattan”ti.","snp5.13:4.5":"Bhadrāvudhamāṇavapucchā dvādasamā niṭṭhitā."},"unsure":[],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2614,"to":2614,"paras":[{"para":2614,"vripara":"1108-1109","refs":["snp5.13:2"],"lines":["1108-9. <b>Okañjahan</b>ti bhadrāvudhasuttaṃ.","Tattha <b>okañjahan</b>ti ālayaṃ jahaṃ.","<b>Taṇhacchidan</b>ti chataṇhākāyacchidaṃ.","<b>Anejan</b>ti lokadhammesu nikkampaṃ.","<b>Nandiñjahan</b>ti anāgatarūpādipatthanājahaṃ.","Ekā eva hi taṇhā thutivasena idha nānappakārato vuttā.","<b>Kappañjahan</b>ti duvidhakappajahaṃ.","<b>Abhiyāce</b>ti ativiya yācāmi.","<b>Sutvāna nāgassa apanamissanti ito</b>ti nāgassa tava bhagavā vacanaṃ sutvā ito pāsāṇakacetiyato bahū janā pakkamissantīti adhippāyo.","<b>Janapadehi saṅgatā</b>ti aṅgādīhi janapadehi idha samāgatā.","<b>Viyākarohī</b>ti dhammaṃ desehi."],"lineRefs":[["snp5.13:2"],["snp5.13:2"],["snp5.13:2"],["snp5.13:2"],["snp5.13:2"],["snp5.13:2"]