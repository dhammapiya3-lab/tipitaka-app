{"suttaId":"snp5.13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3805,3819],"vripara":"1107"},"segments":{"snp5.13:0.2":"Bhadrāvudhamāṇavapucchā","snp5.13:1.1":"“Okañjahaṃ taṇhacchidaṃ anejaṃ,","snp5.13:1.2":"(iccāyasmā bhadrāvudho)","snp5.13:1.3":"Nandiñjahaṃ oghatiṇṇaṃ vimuttaṃ;","snp5.13:1.4":"Kappañjahaṃ abhiyāce sumedhaṃ,","snp5.13:1.5":"sutvāna nāgassa apanamissanti ito. 1108.","snp5.13:2.1":"“Nānājanā janapadehi saṅgatā,","snp5.13:2.2":"tava vīra vākyaṃ abhikaṅkhamānā;","snp5.13:2.3":"Tesaṃ tuvaṃ sādhu viyākarohi,","snp5.13:2.4":"tathā hi te vidito esa dhammo”. 1109.","snp5.13:3.1":"“Ādānataṇhaṃ vinayetha sabbaṃ,","snp5.13:3.2":"(bhadrāvudhāti bhagavā)","snp5.13:3.3":"Uddhaṃ adho tiriyañcāpi majjhe;","snp5.13:3.4":"Yaṃ yañhi lokasmimupādiyanti,","snp5.13:3.5":"teneva māro anveti jantuṃ. 1110.","snp5.13:4.1":"“Tasmā pajānaṃ na upādiyetha,","snp5.13:4.2":"bhikkhu sato kiñcanaṃ sabbaloke;","snp5.13:4.3":"Ādānasatte iti pekkhamāno,","snp5.13:4.4":"pajaṃ imaṃ maccudheyye visatta”nti.","snp5.13:4.5":"Bhadrāvudhamāṇavapucchā dvādasamā niṭṭhitā. 13."},"unsure":[],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2614,"to":2614,"paras":[{"para":2614,"vripara":"1108-1109","refs":["snp5.13:2"],"lines":["<b>Okañjaha</b>nti bhadrāvudhasuttaṃ.","Tattha <b>okañjaha</b>nti ālayaṃ jahaṃ.","<b>Taṇhacchida</b>nti chataṇhākāyacchidaṃ.","<b>Aneja</b>nti lokadhammesu nikkampaṃ.","<b>Nandiñjaha</b>nti anāgatarūpādipatthanājahaṃ.","Ekā eva hi taṇhā thutivasena idha nānappakārato vuttā.","<b>Kappañjaha</b>nti duvidhakappajahaṃ.","<b>Abhiyāce</b>ti ativiya yācāmi.","<b>Sutvāna nāgassa apanamissanti ito</b>ti nāgassa tava bhagavā vacanaṃ sutvā ito pāsāṇakacetiyato bahū janā pakkamissantīti adhippāyo.","<b>Janapadehi saṅgatā</b>ti aṅgādīhi janapadehi idha samāgatā.","<b>Viyākarohī</b>ti dhammaṃ desehi. 1110."],"lineRefs":[["snp5.13:2"],["snp5.13:2"],["snp5.13:2"],["snp5.13:2"],["snp5.