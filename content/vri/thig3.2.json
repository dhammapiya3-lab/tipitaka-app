{"suttaId":"thig3.2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[199,209],"vripara":"42"},"segments":{"thig3.2:0.3":"Uttamātherīgāthā","thig3.2:1.1":"“Catukkhattuṃ pañcakkhattuṃ,","thig3.2:1.2":"vihārā upanikkhamiṃ;","thig3.2:1.3":"Aladdhā cetaso santiṃ,","thig3.2:1.4":"citte avasavattinī.","thig3.2:2.1":"“Sā bhikkhuniṃ upagacchiṃ,","thig3.2:2.2":"yā me saddhāyikā ahu;","thig3.2:2.3":"Sā me dhammamadesesi,","thig3.2:2.4":"khandhāyatanadhātuyo.","thig3.2:3.1":"“Tassā dhammaṃ suṇitvāna,","thig3.2:3.2":"yathā maṃ anusāsi sā;","thig3.2:3.3":"Sattāhaṃ ekapallaṅkena,","thig3.2:3.4":"nisīdiṃ pītisukhasamappitā [nisīdiṃ sukhasamappitā (sī.)];","thig3.2:3.5":"Aṭṭhamiyā pāde pasāresiṃ,","thig3.2:3.6":"tamokhandhaṃ padāliyā”ti.","thig3.2:4.1":"… Uttamā therī …."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":664,"to":664,"paras":[{"para":664,"vripara":null,"refs":["thig3.2:3"],"lines":["<b>Tassā dhammaṃ suṇitvānā</b>ti tassā paṭisambhidāppattāya theriyā santike khandhādivibhāgapubbaṅgamaṃ ariyamaggaṃ pāpetvā desitasaṇhasukhumavipassanādhammaṃ sutvā.","<b>Yathā maṃ anusāsi sā</b>ti sā therī yathā maṃ anusāsi ovadi, tathā paṭipajjantī paṭipattiṃ matthakaṃ pāpetvāpi sattāhaṃ ekapallaṅkena nisīdiṃ.","Kathaṃ?","<b>Pītisukhasamappitā</b>ti jhānamayena pītisukhena samaṅgībhūtā.","<b>Aṭṭhamiyā pāde pasāresiṃ, tamokhandhaṃ padāliyā</b>ti anavasesaṃ mohakkhandhaṃ aggamaggena padāletvā aṭṭhame divase pallaṅkaṃ bhindantī pāde pasāresiṃ.","Idameva cassā aññābyākaraṇaṃ ahosi."],"lineRefs":[["thig3.2:3"],["thig3.2:3"],["thig3.2:3"],["thig3.2:3"],["thig3.2:3"],["thig3.2:3"]]}],"wordLinks":[["thig3.2:3.1","tassā dhammaṃ suṇitvānā",0,0],["thig3.2:3.1","yathā maṃ anusāsi sā",0,1],["thig3.2:3.3","pītisukhasamappitā",0,3],["thig3.2:3.5","aṭṭhamiyā pāde pasāresiṃ tamokhandhaṃ padāliyā",0,4]],"after":[{"para":665,"vripara":null,"title":"Uttamātherīgāthāvaṇṇanā","lines":["Uttamātherīgāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
