{"suttaId":"an11.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-xi","vriCode":"s0404m4.mul","paras":[6,16],"vripara":"1"},"segments":{"an11.1:0.3":"Kimatthiyasuttaṃ","an11.1:1.1":"Evaṃ me sutaṃ –","an11.1:1.2":"ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme.","an11.1:1.3":"Atha kho āyasmā ānando yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho āyasmā ānando bhagavantaṃ etadavoca –","an11.1:1.4":"“kimatthiyāni, bhante, kusalāni sīlāni kimānisaṃsānī”ti?","an11.1:1.5":"“Avippaṭisāratthāni kho, ānanda, kusalāni sīlāni avippaṭisārānisaṃsānī”ti.","an11.1:2.1":"“Avippaṭisāro pana, bhante, kimatthiyo kimānisaṃso”?","an11.1:2.2":"“Avippaṭisāro kho, ānanda, pāmojjattho pāmojjānisaṃso”.","an11.1:3.1":"“Pāmojjaṃ pana, bhante, kimatthiyaṃ kimānisaṃsaṃ”?","an11.1:3.2":"“Pāmojjaṃ kho, ānanda, pītatthaṃ pītānisaṃsaṃ”.","an11.1:4.1":"“Pīti pana, bhante, kimatthiyā kimānisaṃsā”?","an11.1:4.2":"“Pīti kho, ānanda, passaddhatthā passaddhānisaṃsā”.","an11.1:5.1":"“Passaddhi pana, bhante, kimatthiyā kimānisaṃsā”?","an11.1:5.2":"“Passaddhi kho, ānanda, sukhatthā sukhānisaṃsā”.","an11.1:6.1":"“Sukhaṃ pana, bhante, kimatthiyaṃ kimānisaṃsaṃ”?","an11.1:6.2":"“Sukhaṃ kho, ānanda, samādhatthaṃ samādhānisaṃsaṃ”.","an11.1:7.1":"“Samādhi pana, bhante, kimatthiyo kimānisaṃso”?","an11.1:7.2":"“Samādhi kho, ānanda, yathābhūtañāṇadassanattho yathābhūtañāṇadassanānisaṃso”.","an11.1:8.1":"“Yathābhūtañāṇadassanaṃ pana, bhante, kimatthiyaṃ kimānisaṃsaṃ”?","an11.1:8.2":"“Yathābhūtañāṇadassanaṃ kho, ānanda, nibbidatthaṃ nibbidānisaṃsaṃ”.","an11.1:9.1":"“Nibbidā, pana, bhante, kimatthiyā kimānisaṃsā”?","an11.1:9.2":"“Nibbidā kho, ānanda, virāgatthā virāgānisaṃsā”.","an11.1:10.1":"“Virāgo pana, bhante, kimatthiyo kimānisaṃso”?","an11.1:10.2":"“Virāgo kho, ānanda, vimuttiñāṇadassanattho vimuttiñāṇadassanānisaṃso.","an11.1:11.1":"“Iti kho, ānanda, kusalāni sīlāni avippaṭisāratthāni avippaṭisārānisaṃsāni,","an11.1:11.2":"avippaṭisāro pāmojjattho pāmojjānisaṃso,","an11.1:11.3":"pāmojjaṃ pītatthaṃ pītānisaṃsaṃ,","an11.1:11.4":"pīti passaddhatthā passaddhānisaṃsā,","an11.1:11.5":"passaddhi sukhatthā sukhānisaṃsā,","an11.1:11.6":"sukhaṃ samādhatthaṃ samādhānisaṃsaṃ,","an11.1:11.7":"samādhi yathābhūtañāṇadassanattho yathābhūtañāṇadassanānisaṃso,","an11.1:11.8":"yathābhūtañāṇadassanaṃ nibbidatthaṃ nibbidānisaṃsaṃ,","an11.1:11.9":"nibbidā virāgatthā virāgānisaṃsā,","an11.1:11.10":"virāgo vimuttiñāṇadassanattho vimuttiñāṇadassanānisaṃso.","an11.1:11.11":"Iti kho, ānanda, kusalāni sīlāni anupubbena aggāya parentī”ti.","an11.1:11.12":"Paṭhamaṃ. 2."},"unsure":[],"preface":["Namo tassa bhagavato arahato sammāsambuddhassa."],"attha":{"book":"Mp-xi","bookName":"Ekādasakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":709,"to":710,"paras":[{"para":709,"vripara":"1-6","refs":["an11.1:1"],"lines":["Ekādasakanipātassa paṭhamādīni heṭṭhā vuttanayāneva.","Kevalañcettha ādito pañcasu nibbidāvirāgaṃ dvidhā bhinditvā ekādasaṅgāni katāni.","Chaṭṭhe sikkhāpaccakkhānaṃ adhikaṃ. 7-8."],"lineRefs":[["an11.1:1"],["an11.1:1"],["an11.1:1"]]},{"para":710,"vripara":null,"refs":["an11.1:1"],"lines":["Paṭhamasaññāsuttādivaṇṇanā 7-8."],"lineRefs":[["an11.1:1"]]}],"wordLinks":[],"before":[{"para":273,"vripara":null,"title":null,"lines":["sammāsambuddhassa."]},{"para":274,"vripara":null,"title":null,"lines":["Aṅguttaranikāye Ekādasakanipāta-aṭṭhakathā 1."]},{"para":707,"vripara":null,"title":"Nissayavaggo","lines":["Nissayavaggo 1-6."]},{"para":708,"vripara":null,"title":"Kimatthiyasuttādivaṇṇanā","lines":["Kimatthiyasuttādivaṇṇanā 1-6."]}]},"tika":{"book":"Mp-t-xi","bookName":"Ekādasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":779,"to":783,"paras":[{"para":779,"vripara":"1-10","refs":["an11.1:1"],"lines":["Ekādasakanipātassa paṭhamādīni uttānatthāneva.","Dasame <b>janitasmi</b>nti kammakilesehi nibbatte, jane etasminti vā <b>janetasmiṃ,</b> manussesūti attho.","Tenāha <b>“ye gottapaṭisārino”</b>ti.","Janitasmiṃ-saddo eva vā i-kārassa e-kāraṃ katvā “janetasmi”nti vutto.","<b>Janitasmi</b>nti ca janasminti attho veditabbo.","Janitasminti sāmaññaggahaṇepi yattha catuvaṇṇasamaññā, tattheva manussaloke.","<b>Khattiyo seṭṭho</b>ti ayaṃ lokasamaññāpi manussalokeyeva, na devakāye brahmakāye vāti dassetuṃ <b>“ye gottapaṭisārino”</b>ti vuttaṃ.","<b>Paṭisarantī</b>ti “ahaṃ gotamo, ahaṃ kassapo”ti paṭi paṭi attano gottaṃ anussaranti paṭijānanti vāti attho."],"lineRefs":[["an11.1:1"],["an11.1:1"],["an11.1:1"],["an11.1:1"],["an11.1:1"],["an11.1:1"],["an11.1:1"],["an11.1:1"]]},{"para":780,"vripara":null,"refs":["an11.1:1"],"lines":["Kimatthiyasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an11.1:1"]]},{"para":781,"vripara":null,"refs":["an11.1:1"],"lines":["Nissayavaggavaṇṇanā niṭṭhitā. 2."],"lineRefs":[["an11.1:1"]]},{"para":782,"vripara":null,"refs":["an11.1:1"],"lines":["Anussativaggo 1-4."],"lineRefs":[["an11.1:1"]]},{"para":783,"vripara":null,"refs":["an11.1:1"],"lines":["Paṭhamamahānāmasuttādivaṇṇanā 11-14."],"lineRefs":[["an11.1:1"]]}],"wordLinks":[],"before":[{"para":276,"vripara":null,"title":null,"lines":["rahato sammāsambuddhassa."]},{"para":277,"vripara":null,"title":null,"lines":["Aṅguttaranikāye Ekādasakanipāta-ṭīkā 1."]},{"para":777,"vripara":null,"title":"Nissayavaggo","lines":["Nissayavaggo 1-10."]},{"para":778,"vripara":null,"title":"Kimatthiyasuttādivaṇṇanā","lines":["Kimatthiyasuttādivaṇṇanā 1-10."]}]},"tika2":null}
