{"suttaId":"ne30","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Nett","vriCode":"s0519m.mul","paras":[729,731],"vripara":"73"},"segments":{"ne30:0.4":"Paññattihārasampāto","ne30:1.1":"Tattha katamo paññattihārasampāto?","ne30:2.1":"“Tasmā rakkhitacittassa, sammāsaṅkappagocaro”ti gāthā.","ne30:2.2":"“Tasmā rakkhitacittassā”ti padaṭṭhānapaññatti satiyā.","ne30:2.3":"“Sammāsaṅkappagocaro”ti bhāvanāpaññatti samathassa.","ne30:2.4":"“Sammādiṭṭhipurekkhāro, ñatvāna udayabbayan”ti dassanabhūmiyā nikkhepapaññatti.","ne30:2.5":"“Thinamiddhābhibhū bhikkhū”ti samudayassa anavasesappahānapaññatti,“sabbā duggatiyo jahe”ti bhāvanāpaññatti maggassa.","ne30:2.6":"Niyutto paññattihārasampāto."},"attha":{"book":"Nett-a","bookName":"Nettippakaraṇa-aṭṭhakathā","vriCode":"s0519a.att","from":700,"to":700,"paras":[{"para":700,"vripara":"73","refs":["ne30:2"],"words":["rakkhitacittassāti padaṭṭhānapaññatti satiyā"],"lines":["Adhiṭṭhahitvā rakkhantiyā satiyā rakkhiyamānaṃ cittaṃ tassā adhiṭṭhānaṃ viya hotīti katvā vuttaṃ –","<b>“rakkhitacittassāti padaṭṭhānapaññatti satiyā”</b>ti.","Sesaṃ imasmiṃ paññattihārasampāte ito paresu otaraṇasodhanahārasampātesupi apubbaṃ natthi.","Heṭṭhā vuttanayameva."],"lineRefs":[["ne30:2"],["ne30:2"],["ne30:2"],["ne30:2"]]}]},"tika":null}
