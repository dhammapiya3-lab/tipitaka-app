{"suttaId":"vv74","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2703,2723],"vripara":"1108"},"segments":{"vv74:0.4":"(Uttara) pāyāsivimānavatthu","vv74:1.1":"“Yā devarājassa sabhā sudhammā,","vv74:1.2":"yatthacchati devasaṅgho samaggo;","vv74:1.3":"Tathūpamaṃ tuyhamidaṃ vimānaṃ,","vv74:1.4":"obhāsayaṃ tiṭṭhati antalikkhe.","vv74:2.1":"“Deviddhipattosi mahānubhāvo,","vv74:2.2":"manussabhūto kimakāsi puññaṃ;","vv74:2.3":"Kenāsi evaṃ jalitānubhāvo,","vv74:2.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv74:3.1":"So devaputto attamano … pe …","vv74:3.3":"yassa kammassidaṃ phalaṃ.","vv74:4.1":"“Ahaṃ manussesu manussabhūto,","vv74:4.2":"rañño pāyāsissa ahosiṃ māṇavo;","vv74:4.3":"Laddhā dhanaṃ saṃvibhāgaṃ akāsiṃ,","vv74:4.4":"piyā ca me sīlavanto ahesuṃ;","vv74:4.5":"Annañca pānañca pasannacitto,","vv74:4.6":"sakkacca dānaṃ vipulaṃ adāsiṃ.","vv74:5.1":"“Tena metādiso vaṇṇo … pe.","vv74:5.3":"… vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv74:6.1":"(Uttara) pāyāsivimānaṃ [uttaravimānaṃ (sī. syā. aṭṭha.)] dasamaṃ.","vv74:7.1":"Pāyāsivaggo chaṭṭho niṭṭhito.","vv74:8.1":"Tassuddānaṃ –","vv74:9.1":"Dve agārino phaladāyī,","vv74:9.2":"dve upassayadāyī bhikkhāya dāyī;","vv74:9.3":"Yavapālako ceva dve,","vv74:9.4":"kuṇḍalino pāyāsīti [pāṭhabhedo natthi];","vv74:10.1":"Purisānaṃ dutiyo vaggo pavuccatīti."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3254,"to":3255,"paras":[{"para":3254,"vripara":"1108","refs":["vv74:1"],"lines":["Tattha <b>devarājassā</b>ti sakkassa.","<b>Sabhā sudhammā</b>ti evaṃnāmakaṃ santhāgāraṃ.","<b>Yatthā</b>ti yassaṃ sabhāyaṃ.","<b>Acchatī</b>ti nisīdati.","<b>Devasaṅgho</b>ti tāvatiṃsadevakāyo.","<b>Samaggo</b>ti sahito sannipatito."],"lineRefs":[["vv74:1"],["vv74:1"],["vv74:1"],["vv74:1"],["vv74:1"],["vv74:1"]]},{"para":3255,"vripara":"1111","refs":["vv74:4"],"lines":["<b>Pāyāsissa ahosiṃ māṇavo</b>ti pāyāsirājaññassa kiccākiccakaro daharatāya māṇavo, nāmena pana uttaro nāma ahosiṃ.","<b>Saṃvibhāgaṃ akāsin</b>ti ahameva abhuñjitvā yathāladdhaṃ dhanaṃ dānamukhe pariccajanavasena saṃvibhajanaṃ akāsiṃ.","Annañca pānañca pariccajantoti vacanaseso.","Atha vā dānaṃ vipulaṃ adāsiṃ.","Kathaṃ?","<b>Sakkaccaṃ</b>.","Kīdisaṃ?","<b>Annañca pānañcā</b>ti yojetabbaṃ."],"lineRefs":[["vv74:4"],["vv74:4"],["vv74:4"],["vv74:4"],["vv74:4"],["vv74:4"],["vv74:4"],["vv74:4"]]}],"wordLinks":[["vv74:1.1","devarājassā",0,0],["vv74:1.1","sabhā sudhammā",0,1],["vv74:1.1","yatthā",0,2],["vv74:1.1","acchatī",0,3],["vv74:1.1","devasaṅgho",0,4],["vv74:1.1","samaggo",0,5],["vv74:4.1","pāyāsissa ahosiṃ māṇavo",1,0],["vv74:4.3","saṃvibhāgaṃ akāsiṃ",1,1],["vv74:4.5","sakkaccaṃ",1,5],["vv74:4.5","annañca pānañcā",1,7]],"before":[{"para":3239,"vripara":"1108","refs":[],"lines":["“Yā devarājassa sabhā sudhammā, yatthacchati devasaṅgho samaggo;"],"lineRefs":[[]]},{"para":3240,"vripara":null,"refs":[],"lines":["Tathūpamaṃ tuyhamidaṃ vimānaṃ, obhāsayaṃ tiṭṭhati antalikkhe."],"lineRefs":[[]]},{"para":3242,"vripara":"1109","refs":[],"lines":["“Deviddhipattosi mahānubhāvo … pe …"],"lineRefs":[[]]},{"para":3243,"vripara":null,"refs":[],"lines":["Vaṇṇo ca te sabbadisā pabhāsatī”ti.","– gāthāhi paṭipucchi;"],"lineRefs":[[],[]]},{"para":3245,"vripara":"1110","refs":[],"lines":["“So devaputto attamano … pe … yassa kammassidaṃ phalaṃ”."],"lineRefs":[[]]},{"para":3247,"vripara":"1111","refs":[],"lines":["“Ahaṃ manussesu manussabhūto, rañño pāyāsissa ahosiṃ māṇavo;"],"lineRefs":[[]]},{"para":3248,"vripara":null,"refs":[],"lines":["Laddhā dhanaṃ saṃvibhāgaṃ akāsiṃ, piyā ca me sīlavanto ahesuṃ;"],"lineRefs":[[]]},{"para":3249,"vripara":null,"refs":[],"lines":["Annañca pānañca pasannacitto, sakkacca dānaṃ vipulaṃ adāsiṃ."],"lineRefs":[[]]},{"para":3251,"vripara":"1112","refs":[],"lines":["“Tena metādiso vaṇṇo … pe …"],"lineRefs":[[]]},{"para":3252,"vripara":null,"refs":[],"lines":["Vaṇṇo ca me sabbadisā pabhāsatī”ti.","–"],"lineRefs":[[],[]]},{"para":3253,"vripara":null,"r