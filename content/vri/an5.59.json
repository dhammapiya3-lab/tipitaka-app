{"suttaId":"an5.59","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[522,522],"vripara":"59"},"segments":{"an5.59:0.3":"Paṭhamavuḍḍhapabbajitasuttaṃ","an5.59:1.1":"“Pañcahi, bhikkhave, dhammehi samannāgato dullabho vuḍḍhapabbajito.","an5.59:1.2":"Katamehi pañcahi?","an5.59:1.3":"Dullabho, bhikkhave, vuḍḍhapabbajito nipuṇo, dullabho ākappasampanno, dullabho bahussuto, dullabho dhammakathiko, dullabho vinayadharo.","an5.59:1.4":"Imehi kho, bhikkhave, pañcahi dhammehi samannāgato dullabho vuḍḍhapabbajito”ti.","an5.59:1.5":"Navamaṃ."},"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":150,"to":150,"paras":[{"para":150,"vripara":"59-60","refs":["an5.59:1"],"words":["nipuṇo","ākappasampanno"],"lines":["59-60. Navame <b>nipuṇo</b>ti saṇho sukhumakāraṇaññū.","<b>Ākappasampanno</b>ti samaṇākappena sampanno.","Dasame <b>padakkhiṇaggāhī</b>ti dinnovādaṃ padakkhiṇato gaṇhanto.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["an5.59:1"],["an5.59:1"],["an5.59:1"],["an5.59:1"]]}]},"tika":null}
