{"suttaId":"tha-ap42","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[3458,3481],"vripara":"108"},"segments":{"tha-ap42:0.3":"Kapparukkhiyattheraapadānaṃ","tha-ap42:1.1":"“Siddhatthassa bhagavato,","tha-ap42:1.2":"thūpaseṭṭhassa sammukhā;","tha-ap42:1.3":"Vicittadusse lagetvā [laggetvā (sī. syā.)],","tha-ap42:1.4":"kapparukkhaṃ ṭhapesahaṃ.","tha-ap42:2.1":"“Yaṃ yaṃ yonupapajjāmi,","tha-ap42:2.2":"devattaṃ atha mānusaṃ;","tha-ap42:2.3":"Sobhayanto mama dvāraṃ,","tha-ap42:2.4":"kapparukkho patiṭṭhati.","tha-ap42:3.1":"“Ahañca parisā ceva,","tha-ap42:3.2":"ye keci mama vassitā [nissitā (sī.)];","tha-ap42:3.3":"Tamhā dussaṃ gahetvāna,","tha-ap42:3.4":"nivāsema mayaṃ sadā [tadā (syā.)].","tha-ap42:4.1":"“Catunnavutito kappe,","tha-ap42:4.2":"yaṃ rukkhaṃ ṭhapayiṃ ahaṃ;","tha-ap42:4.3":"Duggatiṃ nābhijānāmi,","tha-ap42:4.4":"kapparukkhassidaṃ phalaṃ.","tha-ap42:5.1":"“Ito ca sattame kappe,","tha-ap42:5.2":"suceḷā aṭṭha khattiyā;","tha-ap42:5.3":"Sattaratanasampannā,","tha-ap42:5.4":"cakkavattī mahabbalā.","tha-ap42:6.1":"“Paṭisambhidā catasso … pe …","tha-ap42:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap42:7.1":"Itthaṃ sudaṃ āyasmā kapparukkhiyo thero imā gāthāyo abhāsitthāti.","tha-ap42:8.1":"Kapparukkhiyattherassāpadānaṃ dasamaṃ.","tha-ap42:9.1":"Kuṇḍadhānavaggo catuttho.","tha-ap42:10.1":"Tassuddānaṃ –","tha-ap42:11.1":"Kuṇḍasāgatakaccānā,","tha-ap42:11.2":"udāyī mogharājako;","tha-ap42:11.3":"Adhimutto lasuṇado,","tha-ap42:11.4":"āyāgī dhammacakkiko;","tha-ap42:11.5":"Kapparukkhī ca dasamo,","tha-ap42:11.6":"gāthā dvayadasasataṃ [gāthāyo dvādasasataṃ (sī.)]."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2485,"to":2485,"paras":[{"para":2485,"vripara":"108","refs":["tha-ap42:1"],"lines":["So evaṃ pattaarahattaphalo attano pubbakammaṃ saritvā somanassavasena pubbacaritāpadānaṃ pakāsento <b>siddhatthassa bhagavato</b>tiādimāha.","<b>Thūpaseṭṭhassa sammukhā</b>ti seṭṭhassa uttamassa dhātunihitathūpassa cetiyassa sammukhaṭṭhāne <b>vicittadusse</b> anekavaṇṇehi visamena visadisena cittena manohare cinapaṭṭasomārapaṭṭādike dusse.","<b>Lagetvā</b> olaggetvā kapparukkhaṃ <b>ṭhapesiṃ</b> ahaṃ patiṭṭhapesinti attho.","Sesaṃ uttānatthamevāti."],"lineRefs":[["tha-ap42:1"],["tha-ap42:1"],["tha-ap42:1"],["tha-ap42:1"]]}],"wordLinks":[["tha-ap42:1.1","siddhatthassa bhagavato",0,0],["tha-ap42:1.1","thūpaseṭṭhassa sammukhā",0,1],["tha-ap42:1.3","vicittadusse",0,1],["tha-ap42:1.3","lagetvā",0,2]],"before":[{"para":2483,"vripara":null,"title":"Kapparukkhiyattheraapadānavaṇṇanā","lines":["Kapparukkhiyattheraapadānavaṇṇanā"]},{"para":2484,"vripara":null,"title":"Kapparukkhiyattheraapadānavaṇṇanā","lines":["<b>Siddhatthassa bhagavato</b>tiādikaṃ āyasmato kapparukkhiyattherassa apadānaṃ (theragā. aṭṭha.2.576).","Ayampi purimabuddhesu katādhikāro tesu tesu bhavesu nibbānādhigamūpāyabhūtāni puññāni upacinanto siddhatthassa bhagavato kāle vibhavasampanne ekasmiṃ kule nibbatto mahaddhano mahābhogo satthari pasanno sattahi ratanehi vicittaṃ suvaṇṇamayaṃ kapparukkhaṃ kāretvā siddhatthassa bhagavato cetiyassa sammukhe ṭhapetvā pūjesi.","So evarūpaṃ puññaṃ katvā yāvatāyukaṃ ṭhatvā tato cuto sugatīsuyeva saṃsaranto kamena imasmiṃ buddhuppāde ekasmiṃ kulagehe nibbatto viññutaṃ patto gharāvāsaṃ saṇṭhapetvā ratanattaye pasanno dhammaṃ sutvā paṭiladdhasaddho satthu ārādhetvā pabbajito nacirasseva arahattaṃ patvā pubbe katakusalanāmena <b>kapparukkhiyatthero</b>ti pākaṭo ahosi."]}],"after":[{"para":2486,"vripara":null,"title":"Kapparukkhiyattheraapadānavaṇṇanā","lines":["Kapparukkhiyattheraapadānavaṇṇanā samattā."]},{"para":2487,"vripara":null,"title":"Kapparukkhiyattheraapadānavaṇṇanā","lines":["Catutthavaggavaṇṇanā samattā."]}]},"tika":null,"tika2":null}
