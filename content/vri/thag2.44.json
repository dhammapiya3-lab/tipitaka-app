{"suttaId":"thag2.44","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1083,1089],"vripara":"207"},"segments":{"thag2.44:0.4":"Mogharājattheragāthā","thag2.44:1.1":"“Chavipāpaka cittabhaddaka, mogharāja satataṃ samāhito;","thag2.44:1.3":"Hemantikasītakālarattiyo [hemantikakālarattiyo (ka.)], bhikkhu tvaṃsi kathaṃ karissasi”.","thag2.44:2.1":"“Sampannasassā magadhā, kevalā iti me sutaṃ;","thag2.44:2.3":"Palālacchannako seyyaṃ, yathaññe sukhajīvino”ti.","thag2.44:2.5":"… Mogharājā thero …."},"attha":null,"tika":null}
