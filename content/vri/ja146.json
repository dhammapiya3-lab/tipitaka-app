{"suttaId":"ja146","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[816,819],"vripara":"146"},"segments":{"ja146:0.4":"Samuddakākajātakaṃ","ja146:1.1":"Api nu hanukā santā, mukhañca parisussati;","ja146:1.3":"Oramāma na pārema, pūrateva mahodadhīti.","ja146:2.1":"Samuddakākajātakaṃ chaṭṭhaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":3048,"to":3048,"paras":[{"para":3048,"vripara":null,"refs":["ja146:1"],"lines":["Tattha <b>api nu hanukā santā</b>ti api no hanukā santā, api amhākaṃ hanukā kilantā.","<b>Oramāma na pāremā</b>ti mayaṃ attano balena mahāsamuddaudakaṃ ākaḍḍhāma osārema, tucchaṃ pana naṃ kātuṃ na sakkoma.","Ayañhi <b>pūrateva mahodadhī</b>ti."],"lineRefs":[["ja146:1"],["ja146:1"],["ja146:1"]]}],"wordLinks":[["ja146:1.1","api nu hanukā santā",0,0],["ja146:1.3","oramāma na pāremā",0,1],["ja146:1.3","pūrateva mahodadhī",0,2]]},"tika":null}
