{"suttaId":"thag4.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1411,1423],"vripara":"291"},"segments":{"thag4.7:0.4":"Sambhūtattheragāthā","thag4.7:1.1":"“Yo dandhakāle tarati, taraṇīye ca dandhaye;","thag4.7:1.3":"Ayoni [ayoniso (syā.)] saṃvidhānena, bālo dukkhaṃ nigacchati.","thag4.7:2.1":"“Tassatthā parihāyanti, kāḷapakkheva candimā;","thag4.7:2.3":"Āyasakyañca [āyasasyañca (sī.)] pappoti, mittehi ca virujjhati.","thag4.7:3.1":"“Yo dandhakāle dandheti, taraṇīye ca tāraye;","thag4.7:3.3":"Yoniso saṃvidhānena, sukhaṃ pappoti paṇḍito.","thag4.7:4.1":"“Tassatthā paripūrenti, sukkapakkheva candimā;","thag4.7:4.3":"Yaso kittiñca pappoti, mittehi na virujjhatī”ti.","thag4.7:4.5":"… Sambhūto thero …."},"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":221,"to":221,"paras":[{"para":221,"vripara":null,"refs":["thag4.7:4"],"lines":["<b>Tassatthā parihāyantī</b>ti tassa tathārūpassa puggalassa diṭṭhadhammikādibhedā atthā <b>kāḷapakkhe candimā</b> viya, <b>parihāyanti</b> divase divase parikkhayaṃ pariyādānaṃ gacchanti.","“Asuko puggalo assaddho appasanno kusīto hīnavīriyo”tiādinā.","<b>Āyasakyaṃ</b> viññūhi garahitabbataṃ <b>pappoti</b> pāpuṇāti.","<b>Mittehi ca virujjhatī</b>ti “evaṃ paṭipajja, mā evaṃ paṭipajjā”ti ovādadāyakehi kalyāṇamittehi “avacanīyā mayan”ti ovādassa anādāneneva viruddho nāma hoti."],"lineRefs":[["thag4.7:4"],["thag4.7:4"],["thag4.7:4"],["thag4.7:4"]]}],"wordLinks":[["thag4.7:4.3","pappoti",0,2]]},"tika":null}
