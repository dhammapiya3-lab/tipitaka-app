{"suttaId":"thag4.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1411,1423],"vripara":"291"},"segments":{"thag4.7:0.4":"Sambhūtattheragāthā","thag4.7:1.1":"“Yo dandhakāle tarati, taraṇīye ca dandhaye;","thag4.7:1.3":"Ayoni [ayoniso (syā.)] saṃvidhānena, bālo dukkhaṃ nigacchati.","thag4.7:2.1":"“Tassatthā parihāyanti, kāḷapakkheva candimā;","thag4.7:2.3":"Āyasakyañca [āyasasyañca (sī.)] pappoti, mittehi ca virujjhati.","thag4.7:3.1":"“Yo dandhakāle dandheti, taraṇīye ca tāraye;","thag4.7:3.3":"Yoniso saṃvidhānena, sukhaṃ pappoti paṇḍito.","thag4.7:4.1":"“Tassatthā paripūrenti, sukkapakkheva candimā;","thag4.7:4.3":"Yaso kittiñca pappoti, mittehi na virujjhatī”ti.","thag4.7:4.5":"… Sambhūto thero …."},"attha":null,"tika":null}
