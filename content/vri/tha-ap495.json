{"suttaId":"tha-ap495","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[2571,2600],"vripara":"15"},"segments":{"tha-ap495:0.3":"Koraṇḍapupphiyattheraapadānaṃ","tha-ap495:1.1":"“Vanakammiko pure āsiṃ, pitumātumatenahaṃ [pitupetāmahenahaṃ (sī. syā. pī.)];","tha-ap495:1.3":"Pasumārena jīvāmi, kusalaṃ me na vijjati.","tha-ap495:2.1":"“Mama āsayasāmantā, tisso lokagganāyako;","tha-ap495:2.3":"Padāni tīṇi dassesi, anukampāya cakkhumā.","tha-ap495:3.1":"“Akkante ca pade disvā, tissanāmassa satthuno;","tha-ap495:3.3":"Haṭṭho haṭṭhena cittena, pade cittaṃ pasādayiṃ.","tha-ap495:4.1":"“Koraṇḍaṃ pupphitaṃ disvā, pādapaṃ dharaṇīruhaṃ;","tha-ap495:4.3":"Sakosakaṃ gahetvāna, padaseṭṭhamapūjayiṃ [padaseṭṭhe apūjayiṃ (sī. pī.)].","tha-ap495:5.1":"“Tena kammena sukatena, cetanāpaṇidhīhi ca;","tha-ap495:5.3":"Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ.","tha-ap495:6.1":"“Yaṃ yaṃ yonupapajjāmi, devattaṃ atha mānusaṃ;","tha-ap495:6.3":"Koraṇḍakachavi homi, suppabhāso [sapabhāso (sī. syā. pī. ka.)] bhavāmahaṃ.","tha-ap495:7.1":"“Dvenavute ito kappe, yaṃ kammamakariṃ tadā;","tha-ap495:7.3":"Duggatiṃ nābhijānāmi, padapūjāyidaṃ phalaṃ.","tha-ap495:8.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap495:9.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap495:10.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap495:11.1":"Itthaṃ sudaṃ āyasmā koraṇḍapupphiyo thero imā gāthāyo Abhāsitthāti.","tha-ap495:12.1":"Koraṇḍapupphiyattherassāpadānaṃ tatiyaṃ."},"attha":null,"tika":null,"tika2":null}
