{"suttaId":"sn48.26","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1229,1229],"vripara":"496"},"segments":{"sn48.26:0.3":"Sotāpannasuttaṃ","sn48.26:1.1":"“Chayimāni, bhikkhave, indriyāni.","sn48.26:1.2":"Katamāni cha?","sn48.26:1.3":"Cakkhundriyaṃ…pe… manindriyaṃ.","sn48.26:1.4":"Yato kho, bhikkhave, ariyasāvako imesaṃ channaṃ indriyānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ pajānāti –","sn48.26:1.5":"ayaṃ vuccati, bhikkhave, ariyasāvako sotāpanno avinipātadhammo niyato sambodhiparāyaṇo”ti.","sn48.26:1.6":"Chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":576,"to":579,"paras":[{"para":576,"vripara":"495-500","refs":["sn48.26:1"],"lines":["Pañcame cakkhu ca taṃ cakkhudvāre nibbattānaṃ dhammānaṃ ādhipateyyasaṅkhātena indaṭṭhena indriyañcāti <b>cakkhundriyaṃ.</b>","<b>Sotindriyā</b>dīsupi eseva nayo.","Sesaṃ sabbattha uttānameva.","Imasmiṃ vagge paṭhamasuttañceva chaṭṭhādīni ca pañcāti cha suttāni catusaccavasena kathitānīti."],"lineRefs":[["sn48.26:1"],["sn48.26:1"],["sn48.26:1"],["sn48.26:1"]]},{"para":577,"vripara":null,"refs":["sn48.26:1"],"lines":["Chaḷindriyavaggo tatiyo. 4."],"lineRefs":[["sn48.26:1"]]},{"para":578,"vripara":null,"refs":["sn48.26:1"],"lines":["Sukhindriyavaggo 1-5."],"lineRefs":[["sn48.26:1"]]},{"para":579,"vripara":null,"refs":["sn48.26:1"],"lines":["Suddhikasuttādivaṇṇanā 501-505."],"lineRefs":[["sn48.26:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":498,"to":501,"paras":[{"para":498,"vripara":"495-500","refs":["sn48.26:1"],"lines":["Yathā cakkhussa sahajātatadindriyanissitadhammesu adhipateyyaṃ anuvattanīyattā, evaṃ taṃdvārikadhammesupi adhipateyyaṃ tehi anuvattanīyattāti vuttaṃ –","<b>“adhipateyyasaṅkhātena indaṭṭhenā”</b>ti.","Esa nayo sesindriyādīsupi.","<b>Catusaccavasena kathitāni</b> sabhāvādivibhāvanassa kathitattā."],"lineRefs":[["sn48.26:1"],["sn48.26:1"],["sn48.26:1"],["sn48.26:1"]]},{"para":499,"vripara":null,"refs":["sn48.26:1"],"lines":["Chaḷindriyavaggavaṇṇanā niṭṭhitā. 4."],"lineRefs":[["sn48.26:1"]]},{"para":500,"vripara":null,"refs":["sn48.26:1"],"lines":["Sukhindriyavaggo 1-5."],"lineRefs":[["sn48.26:1"]]},{"para":501,"vripara":null,"refs":["sn48.26:1"],"lines":["Suddhikasuttādivaṇṇanā 501-505."],"lineRefs":[["sn48.26:1"]]}],"wordLinks":[]},"tika2":null}
