{"suttaId":"an10.182","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[1407,1408],"vripara":"182"},"segments":{"an10.182:0.3":"Dhammasuttaṃ","an10.182:1.1":"“Dhammañca vo, bhikkhave, desessāmi adhammañca.","an10.182:1.2":"Taṃ suṇātha … pe … katamo ca, bhikkhave, adhammo?","an10.182:1.4":"Pāṇātipāto … pe … micchādiṭṭhi – ayaṃ vuccati, bhikkhave, adhammo.","an10.182:2.1":"“Katamo ca, bhikkhave, dhammo?","an10.182:2.2":"Pāṇātipātā veramaṇī … pe … sammādiṭṭhi – ayaṃ vuccati, bhikkhave, dhammo”ti.","an10.182:2.5":"Pañcamaṃ."},"attha":null,"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":765,"to":769,"paras":[{"para":765,"vripara":"167-210","refs":["an10.182:1"],"lines":["167-210. Dutiye ca paṭhamādīni uttānatthāni.","Dasame <b>pacchābhūmivāsino</b>ti paccantadesavāsino.","<b>Sevālamālikā</b>ti pātova udakaṃ orohitvā sevālañceva uppalādīni ca gahetvā attano udakasuddhikabhāvajānanatthañceva “lokassa ca udakena suddhi hotī”ti imassa atthassa jānanatthañca mālaṃ katvā pilandhanakā.","<b>Udakorohakā</b>ti pāto majjhanhe sāyanhe ca udakaorohaṇakā.","Tenāha <b>“sāyatatiyakaṃ udakorohaṇānuyogamanuyuttā”</b>ti.","Ekādasamādīni uttānatthāni.","Catutthe paṇṇāsake natthi vattabbaṃ."],"lineRefs":[["an10.182:1"],["an10.182:1"],["an10.182:1"],["an10.182:1"],["an10.182:1"],["an10.182:1"],["an10.182:1"]]},{"para":766,"vripara":null,"refs":[],"lines":["Brāhmaṇapaccorohaṇīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":767,"vripara":null,"refs":[],"lines":["Catutthapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[[]]},{"para":768,"vripara":null,"refs":[],"lines":["(21)1. Karajakāyavaggo"],"lineRefs":[[]]},{"para":769,"vripara":null,"refs":["an10.182:1"],"lines":["1-536. Paṭhamanirayasaggasuttādivaṇṇanā"],"lineRefs":[["an10.182:1"]]}],"wordLinks":[]}}
