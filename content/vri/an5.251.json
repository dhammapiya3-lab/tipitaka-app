{"suttaId":"an5.251","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1554,1554],"vripara":"251"},"segments":{"an5.251:0.3":"Upasampādetabbasuttaṃ","an5.251:1.1":"“Pañcahi, bhikkhave, dhammehi samannāgatena bhikkhunā upasampādetabbaṃ.","an5.251:1.2":"Katamehi pañcahi?","an5.251:1.3":"Idha, bhikkhave, bhikkhu asekhena sīlakkhandhena samannāgato hoti;","an5.251:1.4":"asekhena samādhikkhandhena samannāgato hoti;","an5.251:1.5":"asekhena paññākkhandhena samannāgato hoti;","an5.251:1.6":"asekhena vimuttikkhandhena samannāgato hoti;","an5.251:1.7":"asekhena vimuttiñāṇadassanakkhandhena samannāgato hoti.","an5.251:1.8":"Imehi kho, bhikkhave, pañcahi dhammehi samannāgatena bhikkhunā upasampādetabba”nti.","an5.251:1.9":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":494,"to":494,"paras":[{"para":494,"vripara":"251-253","refs":["an5.251:1"],"lines":["Chaṭṭhassa paṭhame <b>upasampādetabba</b>nti upajjhāyena hutvā upasampādetabbaṃ.","Dutiye <b>nissayo dātabbo</b>ti ācariyena hutvā nissayo dātabbo.","Tatiye <b>sāmaṇero upaṭṭhāpetabbo</b>ti upajjhāyena hutvā sāmaṇero gahetabbo.","Iti imāni tīṇipi suttāni paṭhamabodhiyaṃ khīṇāsavavasena vuttāni.","Catutthādīni anupadavaṇṇanāto uttānatthāneva. 1."],"lineRefs":[["an5.251:1"],["an5.251:1"],["an5.251:1"],["an5.251:1"],["an5.251:1"]]}],"wordLinks":[["an5.251:1.1","upasampādetabbaṃ",0,0],["an5.251:1.8","upasampādetabbaṃ",0,0]],"before":[{"para":492,"vripara":null,"title":"6. Upasampadāvaggo","lines":["Upasampadāvaggo 1-3."]},{"para":493,"vripara":null,"title":"Upasampādetabbasuttādivaṇṇanā","lines":["Upasampādetabbasuttādivaṇṇanā 251-253."]}]},"tika":null,"tika2":null}
