{"suttaId":"tha-ap225","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7829,7851],"vripara":"12"},"segments":{"tha-ap225:0.3":"Dverataniyattheraapadānaṃ","tha-ap225:1.1":"“Migaluddo pure āsiṃ,","tha-ap225:1.2":"araññe kānane ahaṃ;","tha-ap225:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap225:1.4":"āhutīnaṃ paṭiggahaṃ. 13.","tha-ap225:2.1":"“Maṃsapesi mayā dinnā,","tha-ap225:2.2":"vipassissa mahesino;","tha-ap225:2.3":"Sadevakasmiṃ lokasmiṃ,","tha-ap225:2.4":"issaraṃ kārayāmahaṃ. 14.","tha-ap225:3.1":"“Iminā maṃsadānena,","tha-ap225:3.2":"ratanaṃ nibbattate mama;","tha-ap225:3.3":"Duveme ratanā loke,","tha-ap225:3.4":"diṭṭhadhammassa pattiyā. 15.","tha-ap225:4.1":"“Tehaṃ sabbe anubhomi,","tha-ap225:4.2":"maṃsadānassa sattiyā;","tha-ap225:4.3":"Gattañca mudukaṃ mayhaṃ,","tha-ap225:4.4":"paññā nipuṇavedanī. 16.","tha-ap225:5.1":"“Ekanavutito kappe,","tha-ap225:5.2":"yaṃ maṃsamadadiṃ tadā;","tha-ap225:5.3":"Duggatiṃ nābhijānāmi,","tha-ap225:5.4":"maṃsadānassidaṃ phalaṃ. 17.","tha-ap225:6.1":"“Ito catutthake kappe,","tha-ap225:6.2":"eko āsiṃ janādhipo;","tha-ap225:6.3":"Mahārohitanāmo so,","tha-ap225:6.4":"cakkavattī mahabbalo. 18.","tha-ap225:7.1":"“Paṭisambhidā catasso…pe…","tha-ap225:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap225:8.1":"Itthaṃ sudaṃ āyasmā dverataniyo [dvirataniyo (sī.)] thero imā gāthāyo abhāsitthāti.","tha-ap225:9.1":"Dverataniyattherassāpadānaṃ tatiyaṃ.","tha-ap225:9.2":"Dasamaṃ bhāṇavāraṃ. 4."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
