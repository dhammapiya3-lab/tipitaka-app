{"suttaId":"sn26.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1170,1170],"vripara":"314"},"segments":{"sn26.3:0.3":"Viññāṇasuttaṃ","sn26.3:1.1":"Sāvatthinidānaṃ.","sn26.3:1.2":"“Yo kho, bhikkhave, cakkhuviññāṇassa uppādo ṭhiti … pe … jarāmaraṇassa pātubhāvo … pe … yo manoviññāṇassa uppādo ṭhiti … pe … jarāmaraṇassa pātubhāvo.","sn26.3:1.6":"Yo ca kho, bhikkhave, cakkhuviññāṇassa nirodho … pe … jarāmaraṇassa atthaṅgamo … pe … yo manoviññāṇassa nirodho … pe … jarāmaraṇassa atthaṅgamo”ti.","sn26.3:1.10":"Tatiyaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":452,"to":454,"paras":[{"para":452,"vripara":"312-321","refs":["sn26.3:1"],"lines":["312-321. Uppādasaṃyutte sabbaṃ pākaṭameva."],"lineRefs":[["sn26.3:1"]]},{"para":453,"vripara":null,"refs":[],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":454,"vripara":null,"refs":["sn26.3:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.3:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":476,"to":478,"paras":[{"para":476,"vripara":"312-321","refs":["sn26.3:1"],"lines":["312-321. <b>Sabbaṃ pākaṭameva</b> apubbassa abhāvato."],"lineRefs":[["sn26.3:1"]]},{"para":477,"vripara":null,"refs":[],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":478,"vripara":null,"refs":["sn26.3:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.3:1"]]}],"wordLinks":[]},"tika2":null}
