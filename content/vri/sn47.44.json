{"suttaId":"sn47.44","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1087,1087],"vripara":"410"},"segments":{"sn47.44:0.3":"Satisuttaṃ","sn47.44:1.1":"“Sato, bhikkhave, bhikkhu vihareyya.","sn47.44:1.2":"Ayaṃ vo amhākaṃ anusāsanī.","sn47.44:1.3":"Kathañca, bhikkhave, bhikkhu sato hoti?","sn47.44:1.4":"Idha, bhikkhave, bhikkhu kāye kāyānupassī viharati ātāpī sampajāno satimā, vineyya loke abhijjhādomanassaṃ;","sn47.44:1.5":"vedanāsu … pe … citte … pe … dhammesu dhammānupassī viharati ātāpī sampajāno satimā, vineyya loke abhijjhādomanassaṃ.","sn47.44:1.8":"Evaṃ kho, bhikkhave, bhikkhu sato hoti.","sn47.44:1.9":"Sato, bhikkhave, bhikkhu vihareyya.","sn47.44:1.10":"Ayaṃ vo amhākaṃ anusāsanī”ti.","sn47.44:1.11":"Catutthaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":517,"to":518,"paras":[{"para":517,"vripara":"410","refs":["sn47.44:1"],"lines":["Catutthaṃ suddhikaṃ katvā samudaye kathite bujjhanakānaṃ ajjhāsayena vuttaṃ."],"lineRefs":[["sn47.44:1"]]},{"para":518,"vripara":null,"refs":["sn47.44:1"],"lines":["Pātimokkhasaṃvarasuttavaṇṇanā"],"lineRefs":[["sn47.44:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":443,"to":444,"paras":[{"para":443,"vripara":"410","refs":["sn47.44:1"],"lines":["<b>Suddhikaṃ katvā</b> visuṃ visuṃ katvā.","Tathā ca vuttaṃ pāḷiyaṃ “kāye vā bhikkhū”ti."],"lineRefs":[["sn47.44:1"],["sn47.44:1"]]},{"para":444,"vripara":null,"refs":["sn47.44:1"],"lines":["Pātimokkhasaṃvarasuttavaṇṇanā"],"lineRefs":[["sn47.44:1"]]}],"wordLinks":[]}}
