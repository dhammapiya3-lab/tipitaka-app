{"suttaId":"ja289","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2181,2191],"vripara":"115"},"segments":{"ja289:0.4":"Nānāchandajātakaṃ (3-4-9)","ja289:1.1":"Nānāchandā mahārāja, ekāgāre vasāmase;","ja289:1.3":"Ahaṃ gāmavaraṃ icche, brāhmaṇī ca gavaṃ sataṃ.","ja289:2.1":"Putto ca ājaññarathaṃ, kaññā ca maṇikuṇḍalaṃ;","ja289:2.3":"Yā cesā puṇṇikā jammī, udukkhalaṃbhikaṅkhati.","ja289:3.1":"Brāhmaṇassa gāmavaraṃ, brāhmaṇiyā gavaṃ sataṃ;","ja289:3.3":"Puttassa ājaññarathaṃ, kaññāya maṇikuṇḍalaṃ;","ja289:3.5":"Yañcetaṃ puṇṇikaṃ jammiṃ, paṭipādethudukkhalanti.","ja289:4.1":"Nānāchandajātakaṃ navamaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":2760,"to":2766,"paras":[{"para":2760,"vripara":null,"refs":["ja289:2"],"lines":["Tattha <b>icche</b>ti icchāmi.","<b>Gavaṃ satan</b>ti dhenūnaṃ gunnaṃ sataṃ.","<b>Kaññā</b>ti suṇisā.","<b>Yā cesā</b>ti yā esā amhākaṃ ghare puṇṇikā nāma dāsī, sā jammī lāmikā suppamusalehi saddhiṃ udukkhalaṃ abhikaṅkhati icchatīti."],"lineRefs":[["ja289:2"],["ja289:2"],["ja289:2"],["ja289:2"]]},{"para":2761,"vripara":null,"refs":[],"lines":["Rājā “sabbesaṃ icchiticchitaṃ dethā”ti āṇāpento –"],"lineRefs":[[]]},{"para":2763,"vripara":"117","refs":[],"lines":["“Brāhmaṇassa gāmavaraṃ, brāhmaṇiyā gavaṃ sataṃ;"],"lineRefs":[[]]},{"para":2764,"vripara":null,"refs":[],"lines":["Puttassa ājaññarathaṃ, kaññāya maṇikuṇḍalaṃ;"],"lineRefs":[[]]},{"para":2765,"vripara":null,"refs":[],"lines":["Yañcetaṃ puṇṇikaṃ jammiṃ, paṭipādethudukkhalan”ti.","– gāthamāha;"],"lineRefs":[[],[]]},{"para":2766,"vripara":null,"refs":["ja289:3"],"lines":["Tattha <b>yañcetan</b>ti yañca etaṃ puṇṇikanti vadati, taṃ jammiṃ udukkhalaṃ paṭipādetha sampaṭicchāpethāti."],"lineRefs":[["ja289:3"]]}],"wordLinks":[["ja289:2.1","kaññā",0,2],["ja289:2.3","yā cesā",0,3],["ja289:3.5","yañcetaṃ",5,0]]},"tika":null,"tika2":null}
