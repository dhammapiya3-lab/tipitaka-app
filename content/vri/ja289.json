{"suttaId":"ja289","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2181,2191],"vripara":"115"},"segments":{"ja289:0.4":"Nānāchandajātakaṃ (3-4-9)","ja289:1.1":"Nānāchandā mahārāja, ekāgāre vasāmase;","ja289:1.3":"Ahaṃ gāmavaraṃ icche, brāhmaṇī ca gavaṃ sataṃ.","ja289:2.1":"Putto ca ājaññarathaṃ, kaññā ca maṇikuṇḍalaṃ;","ja289:2.3":"Yā cesā puṇṇikā jammī, udukkhalaṃbhikaṅkhati.","ja289:3.1":"Brāhmaṇassa gāmavaraṃ, brāhmaṇiyā gavaṃ sataṃ;","ja289:3.3":"Puttassa ājaññarathaṃ, kaññāya maṇikuṇḍalaṃ;","ja289:3.5":"Yañcetaṃ puṇṇikaṃ jammiṃ, paṭipādethudukkhalanti.","ja289:4.1":"Nānāchandajātakaṃ navamaṃ."},"attha":null,"tika":null}
