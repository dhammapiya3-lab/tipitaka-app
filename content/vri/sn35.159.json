{"suttaId":"sn35.159","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[981,981],"vripara":"159"},"segments":{"sn35.159:0.3":"Bāhiraaniccanandikkhayasuttaṃ","sn35.159:1.1":"“Rūpe, bhikkhave, yoniso manasi karotha; rūpāniccatañca yathābhūtaṃ samanupassatha.","sn35.159:1.2":"Rūpe, bhikkhave, bhikkhu yoniso manasikaronto, rūpāniccatañca yathābhūtaṃ samanupassanto rūpesupi nibbindati.","sn35.159:1.3":"Nandikkhayā rāgakkhayo;","sn35.159:1.4":"rāgakkhayā nandikkhayo.","sn35.159:1.5":"Nandirāgakkhayā cittaṃ suvimuttanti vuccati.","sn35.159:1.6":"Sadde …","sn35.159:1.7":"gandhe …","sn35.159:1.8":"rase …","sn35.159:1.9":"phoṭṭhabbe …","sn35.159:1.10":"dhamme, bhikkhave, yoniso manasi karotha; dhammāniccatañca yathābhūtaṃ samanupassatha.","sn35.159:1.11":"Dhamme, bhikkhave, bhikkhu yoniso manasikaronto, dhammāniccatañca yathābhūtaṃ samanupassanto dhammesupi nibbindati.","sn35.159:1.12":"Nandikkhayā rāgakkhayo;","sn35.159:1.13":"rāgakkhayā nandikkhayo.","sn35.159:1.14":"Nandirāgakkhayā cittaṃ suvimuttanti vuccatī”ti.","sn35.159:1.15":"Catutthaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":280,"to":281,"paras":[{"para":280,"vripara":"156-159","refs":["sn35.159:1"],"lines":["156-159. Nandikkhayavaggassa paṭhame <b>nandikkhayā rāgakkhayo, rāgakkhayā nandikkhayo</b>ti nandiyā ca rāgassa ca atthato ekattā vuttaṃ.","<b>Suvimuttan</b>ti arahattaphalavimuttivasena suṭṭhu vimuttaṃ.","Sesamettha dutiyādīsu ca uttānameva."],"lineRefs":[["sn35.159:1"],["sn35.159:1"],["sn35.159:1"]]},{"para":281,"vripara":null,"refs":["sn35.159:1"],"lines":["5-6. Jīvakambavanasamādhisuttādivaṇṇanā"],"lineRefs":[["sn35.159:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":296,"to":298,"paras":[{"para":296,"vripara":"156-159","refs":["sn35.159:1"],"lines":["156-159. <b>Atthato</b>ti sabhāvato.","Ñāṇena ariyato ñātabbato <b>attho,</b> sabhāvoti.","Evañhi abhijjanasabhāvo nandanaṭṭhena <b>nandī,</b> rañjanaṭṭhena <b>rāgo.</b>","<b>Vimuttivasenā</b>ti vimuttiyā adhigamavasena.","<b>Etthā</b>ti imasmiṃ paṭhamasutte.","<b>Dutiyādīsū</b>ti dutiyatatiyacatutthesu.","<b>Uttānameva</b> heṭṭhā vuttanayattā."],"lineRefs":[["sn35.159:1"],["sn35.159:1"],["sn35.159:1"],["sn35.159:1"],["sn35.159:1"],["sn35.159:1"],["sn35.159:1"]]},{"para":297,"vripara":null,"refs":["sn35.159:1"],"lines":["Ajjhattanandikkhayasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.159:1"]]},{"para":298,"vripara":null,"refs":["sn35.159:1"],"lines":["5-6. Jīvakambavanasamādhisuttādivaṇṇanā"],"lineRefs":[["sn35.159:1"]]}],"wordLinks":[]},"tika2":null}
