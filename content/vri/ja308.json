{"suttaId":"ja308","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2428,2440],"vripara":"29"},"segments":{"ja308:0.4":"Sakuṇajātakaṃ (4-1-8)","ja308:1.1":"Akaramhasa te kiccaṃ, yaṃ balaṃ ahuvamhase;","ja308:1.3":"Migarāja namo tyatthu, api kiñci labhāmase.","ja308:2.1":"Mama lohitabhakkhassa, niccaṃ luddāni kubbato;","ja308:2.3":"Dantantaragato santo, taṃ bahuṃ yampi jīvasi.","ja308:3.1":"Akataññumakattāraṃ, katassa appaṭikārakaṃ;","ja308:3.3":"Yasmiṃ kataññutā natthi, niratthā tassa sevanā.","ja308:4.1":"Yassa sammukhaciṇṇena, mittadhammo na labbhati;","ja308:4.3":"Anusūya [anusuyya (sī. pī.)] manakkosaṃ, saṇikaṃ tamhā apakkameti.","ja308:5.1":"Sakuṇajātakaṃ aṭṭhamaṃ."},"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":195,"to":207,"paras":[{"para":195,"vripara":null,"refs":["ja308:1"],"lines":["Tattha <b>akaramhasa te kiccan</b>ti bho, sīha, mayampi tava ekaṃ kiccaṃ akarimha.","<b>Yaṃ balaṃ ahuvamhase</b>ti yaṃ amhākaṃ balaṃ ahosi, tena balena tato kiñci ahāpetvā akarimhayeva."],"lineRefs":[["ja308:1"],["ja308:1"]]},{"para":196,"vripara":null,"refs":[],"lines":["Taṃ sutvā sīho dutiyaṃ gāthamāha –"],"lineRefs":[[]]},{"para":198,"vripara":"30","refs":[],"lines":["“Mama lohitabhakkhassa, niccaṃ luddāni kubbato;"],"lineRefs":[[]]},{"para":199,"vripara":null,"refs":[],"lines":["Dantantaragato santo, taṃ bahuṃ yampi jīvasī”ti."],"lineRefs":[[]]},{"para":200,"vripara":null,"refs":[],"lines":["Taṃ sutvā sakuṇo itarā dve gāthā abhāsi –"],"lineRefs":[[]]},{"para":202,"vripara":"31","refs":[],"lines":["“Akataññumakattāraṃ, katassa appaṭikārakaṃ;"],"lineRefs":[[]]},{"para":203,"vripara":null,"refs":[],"lines":["Yasmiṃ kataññutā natthi, niratthā tassa sevanā."],"lineRefs":[[]]},{"para":205,"vripara":"32","refs":[],"lines":["“Yassa sammukhaciṇṇena, mittadhammo na labbhati;"],"lineRefs":[[]]},{"para":206,"vripara":null,"refs":[],"lines":["Anusūyamanakkosaṃ, saṇikaṃ tamhā apakkamen”ti."],"lineRefs":[[]]},{"para":207,"vripara":null,"refs":["ja308:4"],"lines":["Tattha <b>akataññun</b>ti kataguṇaṃ ajānantaṃ.","<b>Akattāran</b>ti yaṃkiñci akarontaṃ.","<b>Sammukhaciṇṇenā</b>ti sammukhe katena guṇena.","<b>Anusūyamanakkosan</b>ti taṃ puggalaṃ na usūyanto na akkosanto saṇikaṃ tamhā pāpapuggalā apagaccheyyāti.","Evaṃ vatvā so sakuṇo pakkāmi."],"lineRefs":[["ja308:4"],["ja308:4"],["ja308:4"],["ja308:4"],["ja308:4"]]}],"wordLinks":[["ja308:1.1","akaramhasa te kiccaṃ",0,0],["ja308:1.1","yaṃ balaṃ ahuvamhase",0,1],["ja308:4.1","sammukhaciṇṇenā",9,2],["ja308:4.3","anusūyamanakkosaṃ",9,3]]},"tika":null}
