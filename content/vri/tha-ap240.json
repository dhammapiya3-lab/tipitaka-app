{"suttaId":"tha-ap240","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8074,8083],"vripara":"30"},"segments":{"tha-ap240:0.3":"Ambayāgadāyakattheraapadānaṃ","tha-ap240:1.1":"“Sake sippe apatthaddho,","tha-ap240:1.2":"agamaṃ kānanaṃ ahaṃ;","tha-ap240:1.3":"Sambuddhaṃ yantaṃ disvāna,","tha-ap240:1.4":"ambayāgaṃ adāsahaṃ. 31.","tha-ap240:2.1":"“Ekanavutito kappe,","tha-ap240:2.2":"yaṃ dānamadadiṃ tadā;","tha-ap240:2.3":"Duggatiṃ nābhijānāmi,","tha-ap240:2.4":"ambayāgassidaṃ phalaṃ. 32.","tha-ap240:3.1":"“Paṭisambhidā catasso…pe…","tha-ap240:3.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap240:4.1":"Itthaṃ sudaṃ āyasmā ambayāgadāyako thero imā gāthāyo abhāsitthāti.","tha-ap240:5.1":"Ambayāgadāyakattherassāpadānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3192,"to":3192,"paras":[{"para":3192,"vripara":"30","refs":["tha-ap240:1"],"lines":["Aṭṭhamāpadāne <b>sake sippe apatthaddho</b>ti attano takkabyākaraṇādisippasmiṃ apatthaddho patiṭṭhito cheko ahaṃ kānanaṃ <b>agamaṃ</b> gato <b>sambuddhaṃ yantaṃ disvānā</b>ti vanantare gacchantaṃ vipassiṃ sambuddhaṃ passitvā.","<b>Ambayāgaṃ adāsaha</b>nti ahaṃ ambadānaṃ adāsinti attho. 33."],"lineRefs":[["tha-ap240:1"],["tha-ap240:1"]]}],"wordLinks":[["tha-ap240:1.1","agamaṃ",0,0],["tha-ap240:1.1","sake sippe apatthaddho",0,0],["tha-ap240:1.3","sambuddhaṃ yantaṃ disvānā",0,0],["tha-ap240:1.3","ambayāgaṃ adāsahaṃ",0,1]]},"tika":null,"tika2":null}
