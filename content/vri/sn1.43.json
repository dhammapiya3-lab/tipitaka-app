{"suttaId":"sn1.43","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[555,561],"vripara":"43"},"segments":{"sn1.43:0.3":"Annasuttaṃ","sn1.43:1.1":"“Annamevābhinandanti,","sn1.43:1.2":"ubhaye devamānusā;","sn1.43:1.3":"Atha ko nāma so yakkho,","sn1.43:1.4":"yaṃ annaṃ nābhinandatī”ti.","sn1.43:2.1":"“Ye naṃ dadanti saddhāya,","sn1.43:2.2":"vippasannena cetasā;","sn1.43:2.3":"Tameva annaṃ bhajati,","sn1.43:2.4":"asmiṃ loke paramhi ca.","sn1.43:3.1":"“Tasmā vineyya maccheraṃ,","sn1.43:3.2":"dajjā dānaṃ malābhibhū;","sn1.43:3.3":"Puññāni paralokasmiṃ,","sn1.43:3.4":"patiṭṭhā honti pāṇina”nti. 4."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":403,"to":403,"paras":[{"para":403,"vripara":"43","refs":["sn1.43:2","sn1.43:3"],"lines":["Tatiye <b>abhinandantī</b>ti patthenti.","<b>Bhajatī</b>ti upagacchati, cittagahapatisīvalittherādike viya pacchato anubandhati.","<b>Tasmā</b>ti yasmā idhaloke paraloke ca annadāyakameva anugacchati, tasmā.","Sesaṃ uttānamevāti.","Tatiyaṃ. 4."],"lineRefs":[["sn1.43:2"],["sn1.43:2"],["sn1.43:3"],["sn1.43:3"],["sn1.43:3"]]}],"wordLinks":[["sn1.43:2.3","bhajatī",0,1],["sn1.43:3.1","tasmā",0,2]],"before":[{"para":402,"vripara":null,"title":"Annasuttavaṇṇanā","lines":["Annasuttavaṇṇanā 43."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":488,"to":488,"paras":[{"para":488,"vripara":"43","refs":["sn1.43:1","sn1.43:2","sn1.43:3"],"lines":["<b>Patthentī</b>ti pihenti.","Yatthassa upagamanaṃ loke pākaṭataraṃ ahosi, te udāharaṇavasena dassento <b>“cittagahapatisīvalittherādike viyā”</b>ti āha.","<b>Anna</b>nti annasaññito catubbidhopi paccayo.","Sabbepi dāyake ekajjhaṃ gahetvā sāmaññato ekavasena <b>“dāyakamevā”</b>ti vuttaṃ, yathā cāha <b>“ko nāma so yakkho, yaṃ annaṃ nābhinandatī”</b>ti?","Tattha <b>yakkho</b>ti satto.","Sāmaññajotanā ca nāma yasmā puthuatthavisayā, tasmā <b>“ye naṃ dadanti saddhāya, vippasannena cetasā.</b>","<b>Tameva annaṃ bhajatī”</b>ti vuttaṃ.","Tattha <b>ma</b>-kāro padasandhikaro, te evāti attho.","<b>Dāyakaṃ</b> apariccajanameva <b>anugacchati</b> cakkaṃ viya kubbaraṃ."],"lineRefs":[["sn1.43:1"],["sn1.43:1"],["sn1.43:1"],["sn1.43:1"],["sn1.43:1"],["sn1.43:2"],["sn1.43:2"],["sn1.43:3"],["sn1.43:3"]]}],"wordLinks":[["sn1.43:1.1","annaṃ",0,2],["sn1.43:1.3","annaṃ",0,2],["sn1.43:1.3","ko nāma so yakkho yaṃ annaṃ nābhinandatī",0,3],["sn1.43:1.3","yakkho",0,4],["sn1.43:2.1","ye naṃ dadanti saddhāya vippasannena cetasā",0,5],["sn1.43:2.3","tameva annaṃ bhajatī",0,6],["sn1.43:3.1","ma",0,7]],"before":[{"para":487,"vripara":null,"title":"Annasuttavaṇṇanā","lines":["Annasuttavaṇṇanā 43."]}],"after":[{"para":489,"vripara":null,"title":"Annasuttavaṇṇanā","lines":["Annasuttavaṇṇanā niṭṭhitā. 4."]}]},"tika2":null}
