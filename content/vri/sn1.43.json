{"suttaId":"sn1.43","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[555,561],"vripara":"43"},"segments":{"sn1.43:0.3":"Annasuttaṃ","sn1.43:1.1":"“Annamevābhinandanti,","sn1.43:1.2":"ubhaye devamānusā;","sn1.43:1.3":"Atha ko nāma so yakkho,","sn1.43:1.4":"yaṃ annaṃ nābhinandatī”ti.","sn1.43:2.1":"“Ye naṃ dadanti saddhāya,","sn1.43:2.2":"vippasannena cetasā;","sn1.43:2.3":"Tameva annaṃ bhajati,","sn1.43:2.4":"asmiṃ loke paramhi ca.","sn1.43:3.1":"“Tasmā vineyya maccheraṃ,","sn1.43:3.2":"dajjā dānaṃ malābhibhū;","sn1.43:3.3":"Puññāni paralokasmiṃ,","sn1.43:3.4":"patiṭṭhā honti pāṇinan”ti."},"unsure":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":403,"to":403,"paras":[{"para":403,"vripara":"43","refs":["sn1.43:2","sn1.43:3"],"lines":["Tatiye <b>abhinandantī</b>ti patthenti.","<b>Bhajatī</b>ti upagacchati, cittagahapatisīvalittherādike viya pacchato anubandhati.","<b>Tasmā</b>ti yasmā idhaloke paraloke ca annadāyakameva anugacchati, tasmā.","Sesaṃ uttānamevāti.","Tatiyaṃ."],"lineRefs":[["sn1.43:2"],["sn1.43:2"],["sn1.43:3"],["sn1.43:3"],["sn1.43:3"]]}],"wordLinks":[["sn1.43:2.3","bhajatī",0,1],["sn1.43:3.1","tasmā",0,2]],"before":[{"para":398,"vripara":null,"refs":[],"lines":["“Sabbadānaṃ dhammadānaṃ jināti,"],"lineRefs":[[]]},{"para":399,"vripara":null,"refs":[],"lines":["Sabbarasaṃ dhammaraso jināti;"],"lineRefs":[[]]},{"para":400,"vripara":null,"refs":[],"lines":["Sabbaratiṃ dhammarati jināti,"],"lineRefs":[[]]},{"para":401,"vripara":null,"refs":[],"lines":["Taṇhakkhayo sabbadukkhaṃ jinātī”ti.(dha. pa.354);","Dutiyaṃ;"],"lineRefs":[[],[]]},{"para":402,"vripara":null,"refs":[],"lines":["Annasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":488,"to":488,"paras":[{"para":488,"vripara":"43","refs":["sn1.43:1","sn1.43:2","sn1.43:3"],"lines":["<b>Patthentī</b>ti pihenti.","Yatthassa upagamanaṃ loke pākaṭataraṃ ahosi, te udāharaṇavasena dassento <b>“cittagahapatisīvalittherādike viyā”</b>ti āha.","<b>Annan</b>ti annasaññito catubbidhopi paccayo.","Sabbepi dāyake ekajjhaṃ gahetvā sāmaññato ekavasena <b>“dāyakamevā”</b>ti vuttaṃ, yathā cāha <b>“ko nāma so yakkho, yaṃ annaṃ nābhinandatī”</b>ti?","Tattha <b>yakkho</b>ti satto.","Sāmaññajotanā ca nāma yasmā puthuatthavisayā, tasmā <b>“ye naṃ dadanti saddhāya, vippasannena cetasā.</b>","<b>Tameva annaṃ bhajatī”</b>ti vuttaṃ.","Tattha <b>ma</b> -kāro padasandhikaro, te evāti attho.","<b>Dāyakaṃ</b> apariccajanameva <b>anugacchati</b> cakkaṃ viya kubbaraṃ."],"lineRefs":[["sn1.43:1"],["sn1.43:1"],["sn1.43:1"],["sn1.43:1"],["sn1.43:1"],["sn1.43:2"],["sn1.43:2"],["sn1.43:3"],["sn1.43:3"]]}],"wordLinks":[["sn1.43:1.1","annaṃ",0,2],["sn1.43:1.3","annaṃ",0,2],["sn1.43:1.3","ko nāma so yakkho yaṃ annaṃ nābhinandatī",0,3],["sn1.43:1.3","yakkho",0,4],["sn1.43:2.1","ye naṃ dadanti saddhāya vippasannena cetasā",0,5],["sn1.43:2.3","tameva annaṃ bhajatī",0,6],["sn1.43:3.1","ma",0,7]],"before":[{"para":484,"vripara":null,"refs":[],"lines":["<b>“Sabbesaṃyeva balādīnaṃ dāyako hotī”</b>ti saṅkhepato vuttaṃ atthaṃ vitthārato dassetuṃ <b>“dve tayo gāme”</b>tiādi vuttaṃ.","Nisajjādivasena patissayitabbato <b>patissayo,</b> vihāro.","<b>Pakkhittaṃ viya hoti</b> parissamassa vinoditattā.","<b>Bahi vicarantassā</b>ti patissayaṃ alabhitvā bahi vivaṭaṅgaṇe vicarantassa.","<b>Jhāyatī</b>ti jhāyantaṃ hoti, kilamatīti attho.","Sītuṇhādivirodhipaccayavasena sasantāne <b>visabhāgasantati,</b> tabbipariyāyato <b>sabhāgasantati</b> veditabbā.","Sukhaṃ nāma dukkhapaccayaparihārato sukhapaccayuppannato ca hoti, tadubhayaṃ patissayavasena labhatīti dassento <b>“bahi vicarantassa pāde”</b>tiādimāha.","<b>Dhammapītisukhan</b>ti dhammapaccavekkhaṇena uppannapītisukhaṃ.","<b>Upasamasukhan</b>ti kilesānaṃ vūpasamena pavattasukhaṃ.","Nivātaṃ pihitavātapānaṃ patissayaṃ pavisitvā dvāraṃ pidhāya ṭhitassa andhakāro hotīti vuttaṃ <b>“kūpe otiṇṇo viya hotī”</b>ti.","Tenāha <b>“mañcapīṭhādīni na paññāyantī”</b>ti.","Tayidaṃ bahisamāpannaparissamadosena, na ca patissayadosena.","Tenāha <b>“muhuttan”</b>tiādi."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":485,"vripara":null,"refs":[],"lines":["Na marati etenāti <b>amaraṇaṃ,</b> nibbānādhigamādayo.","Tassa dānaṃ dhammūpadeso, taṃ deti.","Tenāha <b>“yo dhammaṃ anusāsatī”</b>ti.","Tayidaṃ dhammānusāsanaṃ kathaṃ hotīti āha <b>“aṭṭhakathan”</b>tiādi.","<b>Aṭṭhakathaṃ kathetī</b>ti avivaṭapāṭhassa pāḷiyā atthasaṃvaṇṇanaṃ karotīti attho.","Anadhītino pana <b>pāḷiṃ vāceti</b>.","Tattha tattha gataṭṭhāne <b>pucchitapañhaṃ vissajjeti,</b> ayaṃ tāva ganthadhuro, paṭipattivāsadhure pana <b>kammaṭṭhānaṃ ācikkhati,</b> ubhayesampi <b>dhammassavanaṃ karoti.</b>","<b>Sabbadānan</b>ti yathāvuttaāmisadānaṃ abhayadānaṃ.","<b>Dhammadānan</b>ti dhammadesanā.","<b>Dhammaratī</b>ti samathavipassanādhamme abhirati.","<b>Dhammaraso</b>ti saddhammasannissayaṃ pītipāmojjaṃ."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[]]},{"para":486,"vripara":null,"refs":[],"lines":["Kiṃdadasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":487,"vripara":null,"refs":[],"lines":["Annasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
