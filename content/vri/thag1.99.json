{"suttaId":"thag1.99","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[572,576],"vripara":"99"},"segments":{"thag1.99:0.4":"Uttiyattheragāthā","thag1.99:1.1":"“Saddaṃ sutvā sati muṭṭhā, piyaṃ nimittaṃ manasikaroto;","thag1.99:1.3":"Sārattacitto vedeti, tañca ajjhosa tiṭṭhati;","thag1.99:1.5":"Tassa vaḍḍhanti āsavā, saṃsāraṃ upagāmino”ti.","thag1.99:1.7":"… Uttiyo thero …."},"attha":null,"tika":null}
