{"suttaId":"vv24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[747,792],"vripara":"229"},"segments":{"vv24:0.4":"Uposathāvimānavatthu","vv24:1.1":"“Abhikkantena vaṇṇena,","vv24:1.2":"yā tvaṃ tiṭṭhasi devate;","vv24:1.3":"Obhāsentī disā sabbā,","vv24:1.4":"osadhī viya tārakā. 230.","vv24:2.1":"“Kena tetādiso vaṇṇo…pe…","vv24:2.3":"Vaṇṇo ca te sabbadisā pabhāsatī”ti. 232.","vv24:3.1":"Sā devatā attamanā…pe…","vv24:3.3":"yassa kammassidaṃ phalaṃ. 233.","vv24:4.1":"“Uposathāti maṃ aññaṃsu,","vv24:4.2":"sāketāyaṃ upāsikā;","vv24:4.3":"Saddhā sīlena sampannā,","vv24:4.4":"saṃvibhāgaratā sadā. 234.","vv24:5.1":"“Acchādanañca bhattañca,","vv24:5.2":"senāsanaṃ padīpiyaṃ;","vv24:5.3":"Adāsiṃ ujubhūtesu,","vv24:5.4":"vippasannena cetasā. 235.","vv24:6.1":"“Cātuddasiṃ pañcadasiṃ,","vv24:6.2":"yā ca pakkhassa aṭṭhamī;","vv24:6.3":"Pāṭihāriyapakkhañca,","vv24:6.4":"aṭṭhaṅgasusamāgataṃ. 236.","vv24:7.1":"“Uposathaṃ upavasissaṃ,","vv24:7.2":"sadā sīlesu saṃvutā;","vv24:7.3":"Saññamā saṃvibhāgā ca,","vv24:7.4":"vimānaṃ āvasāmahaṃ. 237.","vv24:8.1":"“Pāṇātipātā viratā,","vv24:8.2":"musāvādā ca saññatā;","vv24:8.3":"Theyyā ca aticārā ca,","vv24:8.4":"majjapānā ca ārakā. 238.","vv24:9.1":"“Pañcasikkhāpade ratā,","vv24:9.2":"ariyasaccāna kovidā;","vv24:9.3":"Upāsikā cakkhumato,","vv24:9.4":"gotamassa yasassino. 239.","vv24:10.1":"“Tena metādiso vaṇṇo…pe…","vv24:10.3":"Vaṇṇo ca me sabbadisā pabhāsatī”ti. 241.","vv24:11.1":"“Abhikkhaṇaṃ nandanaṃ sutvā,","vv24:11.2":"chando me udapajjatha [upapajjatha (bahūsu)];","vv24:11.3":"Tattha cittaṃ paṇidhāya,","vv24:11.4":"upapannamhi nandanaṃ. 242.","vv24:12.1":"“Nākāsiṃ satthu vacanaṃ,","vv24:12.2":"buddhassādiccabandhuno;","vv24:12.3":"Hīne cittaṃ paṇidhāya,","vv24:12.4":"sāmhi pacchānutāpinī”ti. 243.","vv24:13.1":"“Kīva ciraṃ vimānamhi,","vv24:13.2":"idha vacchasuposathe [vassasuposathe (sī.)];","vv24:13.3":"Devate pucchitācikkha,","vv24:13.4":"yadi jānāsi āyuno”ti. 244.","vv24:14.1":"“Saṭṭhivassasahassāni [saṭṭhi satasahassāni (?)],","vv24:14.2":"tisso ca vassakoṭiyo;","vv24:14.3":"Idha ṭhatvā mahāmuni,","vv24:14.4":"ito cutā gamissāmi;","vv24:14.5":"Manussānaṃ sahabyata”nti. 245.","vv24:15.1":"“Mā tvaṃ uposathe bhāyi,","vv24:15.2":"sambuddhenāsi byākatā;","vv24:15.3":"Sotāpannā visesayi,","vv24:15.4":"pahīnā tava duggatī”ti.","vv24:16.1":"Uposathāvimānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1064,"to":1085,"paras":[{"para":1064,"vripara":"233","refs":["vv24:4"],"lines":["Tattha <b>uposathāti maṃ aññaṃsū</b>ti “uposathā”ti iminā nāmena maṃ manussā jāniṃsu.","<b>Sāketāya</b>nti sāketanagare. 241."],"lineRefs":[["vv24:4"],["vv24:4"]]},{"para":1065,"vripara":"241","refs":["vv24:11"],"lines":["<b>Abhikkhaṇa</b>nti abhiṇhaṃ.","<b>Nandanaṃ sutvā</b>ti “tāvatiṃsabhavane nandanavanaṃ nāma edisañca edisañcā”ti tattha nānāvidhaṃ dibbasampattiṃ sutvā.","<b>Chando</b>ti tannibbattakapuññakammassa kāraṇabhūto kusalacchando, tatrūpapattiyā patthanābhūto taṇhāchando vā.","<b>Udapajjathā</b>ti uppajjittha.","<b>Tatthā</b>ti tāvatiṃsabhavane, nandanāpadesenapi hi taṃ devalokaṃ vadati.","<b>Upapannāmhī</b>ti uppannā nibbattā amhi. 242."],"lineRefs":[["vv24:11"],["vv24:11"],["vv24:11"],["vv24:11"],["vv24:11"],["vv24:11"]]},{"para":1066,"vripara":"242","refs":["vv24:12"],"lines":["<b>Nākāsiṃ</b> <b>satthu vacana</b>nti “nāhaṃ, bhikkhave, appamattakampi bhavaṃ vaṇṇemī”tiādinā (a. ni. 1.320-321) satthārā vuttavacanaṃ na kariṃ, bhavesu chandarāgaṃ na pajahinti attho.","Ādicco gotamagotto, bhagavāpi gotamagottoti sagottatāya vuttaṃ <b>“buddhassādiccabandhuno”</b>ti.","Atha vā ādiccassa bandhu ādiccabandhu, bhagavā.","Taṃ paṭicca tassa ariyāya jātiyā jātattā ādicco vā bandhu etassa orasaputtabhāvatoti ādiccabandhu, bhagavā.","Tathā hi vuttaṃ –"],"lineRefs":[["vv24:12"],["vv24:12"],["vv24:12"],["vv24:12"],["vv24:12"]]},{"para":1067,"vripara":null,"refs":["vv24:12"],"lines":["“Yo andhakāre tamasī pabhaṅkaro, verocano maṇḍalī uggatejo;"],"lineRefs":[["vv24:12"]]},{"para":1068,"vripara":null,"refs":["vv24:12"],"lines":["Mā rāhu gilī caramantalikkhe, pajaṃ mamaṃ rāhu pamuñca sūriya”nti. (saṃ. ni. 1.91);"],"lineRefs":[["vv24:12"]]},{"para":1069,"vripara":null,"refs":["vv24:12"],"lines":["<b>Hīne</b>ti lāmake.","Attano bhavābhiratiṃ sandhāya vadati.","<b>Sāmhī</b>ti sā amhi."],"lineRefs":[["vv24:12"],["vv24:12"],["vv24:12"]]},{"para":1070,"vripara":null,"refs":["vv24:12"],"lines":["Evaṃ tāya devatāya bhavābhiratinimitte uppannavippaṭisāre pavedite thero bhavassa paricchinnāyubhāvavibhāvanamukhena āyatiṃ manussattabhāve ṭhatvā vaṭṭadukkhassa samatikkamo kātuṃ sukaro, sabbaso khīṇāsavabhāvo nāma mahānisaṃsoti ca samassāsetuṃ – 243."],"lineRefs":[["vv24:12"]]},{"para":1072,"vripara":"243","refs":["vv24:12"],"lines":["“Kīva ciraṃ vimānamhi, idha vacchasuposathe;"],"lineRefs":[["vv24:12"]]},{"para":1073,"vripara":null,"refs":["vv24:12"],"lines":["Devate pucchitācikkha, yadi jānāsi āyuno”ti. –"],"lineRefs":[["vv24:12"]]},{"para":1074,"vripara":null,"refs":["vv24:12"],"lines":["Gāthamāha.","Puna sā – 244."],"lineRefs":[["vv24:12"],["vv24:12"]]},{"para":1076,"vripara":"244","refs":["vv24:12"],"lines":["“Saṭṭhi vassasahassāni, tisso ca vassakoṭiyo;"],"lineRefs":[["vv24:12"]]},{"para":1077,"vripara":null,"refs":["vv24:12"],"lines":["Idha ṭhatvā mahāmuni, ito cutā gamissāmi;"],"lineRefs":[["vv24:12"]]},{"para":1078,"vripara":null,"refs":["vv24:12"],"lines":["Manussānaṃ sahabyata”nti. –","āha;"],"lineRefs":[["vv24:12"],["vv24:12"]]},{"para":1079,"vripara":null,"refs":["vv24:12"],"lines":["Puna thero – 245."],"lineRefs":[["vv24:12"]]},{"para":1081,"vripara":"245","refs":["vv24:12"],"lines":["“Mā tvaṃ uposathe bhāyi, sambuddhenāsi byākatā;"],"lineRefs":[["vv24:12"]]},{"para":1082,"vripara":null,"refs":["vv24:12"],"lines":["Sotāpannā visesayi, pahīnā tava duggatī”ti. –"],"lineRefs":[["vv24:12"]]},{"para":1083,"vripara":null,"refs":["vv24:12"],"lines":["Imāya gāthāya samuttejesi. 243-4."],"lineRefs":[["vv24:12"]]},{"para":1084,"vripara":"243-244","refs":["vv24:13"],"lines":["Tattha <b>kīva cira</b>nti kittakaṃ addhānaṃ.","<b>Idhā</b>ti imasmiṃ devaloke, idha vā vimānasmiṃ.","<b>Āyu no</b>ti āyu, <b>no</b>ti nipātamattaṃ.","Āyuno vā cirācirabhāvaṃ, atha vā yadi jānāsi āyunoti attho.","<b>Mahāmunī</b>ti theraṃ ālapati. 245."],"lineRefs":[["vv24:13"],["vv24:13"],["vv24:13"],["vv24:13"],["vv24:13"]]},{"para":1085,"vripara":"245","refs":["vv24:15"],"lines":["<b>Mā tvaṃ uposathe bhāyī</b>ti bhadde uposathe tvaṃ mā bhāyi.","Kasmā?","Yasmā <b>sambuddhenāsi byākatā</b>.","Kinti?","<b>Sotāpannā visesayī</b>ti.","Maggaphalasaññitaṃ visesaṃ yātā adhigatā, tasmā <b>pahīnā tava</b> sabbāpi <b>duggatī</b>ti imampi visesaṃ yātāti visesayi.","Sesaṃ vuttanayameva."],"lineRefs":[["vv24:15"],["vv24:15"],["vv24:15"],["vv24:15"],["vv24:15"],["vv24:15"],["vv24:15"]]}],"wordLinks":[["vv24:4.1","uposathāti maṃ aññaṃsū",0,0],["vv24:4.1","sāketāyaṃ",0,1],["vv24:11.1","abhikkhaṇaṃ",1,0],["vv24:11.1","nandanaṃ sutvā",1,1],["vv24:11.1","chando",1,2],["vv24:11.1","udapajjathā",1,3],["vv24:11.3","tatthā",1,4],["vv24:12.1","nākāsiṃ satthu vacanaṃ",2,0],["vv24:12.1","buddhassādiccabandhuno",2,1],["vv24:12.3","hīne",5,0],["vv24:12.3","sāmhī",5,2],["vv24:13.1","kīva ciraṃ",17,0],["vv24:13.1","idhā",17,1],["vv24:13.3","no",17,2],["vv24:13.3","āyu no",17,2],["vv24:15.1","mā tvaṃ uposathe bhāyī",18,0],["vv24:15.1","sambuddhenāsi byākatā",18,2],["vv24:15.3","sotāpannā visesayī",18,4],["vv24:15.3","duggatī",18,5],["vv24:15.3","pahīnā tava",18,5]],"after":[{"para":1086,"vripara":null,"title":"Uposathāvimānavaṇṇanā","lines":["Uposathāvimānavaṇṇanā niṭṭhitā. 8-9."]}]},"tika":null,"tika2":null}
