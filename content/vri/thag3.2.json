{"suttaId":"thag3.2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1152,1161],"vripara":"222"},"segments":{"thag3.2:0.4":"Paccayattheragāthā","thag3.2:1.1":"“Pañcāhāhaṃ pabbajito, sekho appattamānaso,","thag3.2:1.3":"Vihāraṃ me paviṭṭhassa, cetaso paṇidhī ahu.","thag3.2:2.1":"“Nāsissaṃ na pivissāmi, vihārato na nikkhame;","thag3.2:2.3":"Napi passaṃ nipātessaṃ, taṇhāsalle anūhate.","thag3.2:3.1":"“Tassa mevaṃ viharato, passa vīriyaparakkamaṃ;","thag3.2:3.3":"Tisso vijjā anuppattā, kataṃ buddhassa sāsanan”ti.","thag3.2:3.5":"… Paccayo thero …."},"attha":null,"tika":null}
