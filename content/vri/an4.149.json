{"suttaId":"an4.149","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1211,1211],"vripara":"149"},"segments":{"an4.149:0.3":"Sucaritasuttaṃ","an4.149:1.1":"“Cattārimāni, bhikkhave, vacīsucaritāni.","an4.149:1.2":"Katamāni cattāri?","an4.149:1.3":"Saccavācā, apisuṇā vācā, saṇhā vācā, mantabhāsā –","an4.149:1.4":"imāni kho, bhikkhave, cattāri vacīsucaritānī”ti.","an4.149:1.5":"Navamaṃ. 10."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1456,"to":1456,"paras":[{"para":1456,"vripara":"149-150","refs":["an4.149:1"],"lines":["Navame <b>saṇhā vācā</b>ti mudukavācā.","<b>Mantabhāsā</b>ti mantasaṅkhātāya paññāya paricchinditvā kathitakathā.","Dasame <b>sīlasāro</b>ti sārasampāpakaṃ sīlaṃ.","Sesesupi eseva nayo."],"lineRefs":[["an4.149:1"],["an4.149:1"],["an4.149:1"],["an4.149:1"]]}],"wordLinks":[["an4.149:1.3","saṇhā vācā",0,0],["an4.149:1.3","mantabhāsā",0,1]],"before":[{"para":1455,"vripara":null,"title":"Sucaritasuttādivaṇṇanā","lines":["Sucaritasuttādivaṇṇanā 149-150."]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1640,"to":1643,"paras":[{"para":1640,"vripara":"147-150","refs":["an4.149:1"],"lines":["Sattame paramatthato avijjamānasabhāvassa kālassa bhāvanādiyogo na sambhavatīti āha <b>“kālāti tasmiṃ tasmiṃ kāle dhammassavanādivasena pavattānaṃ kusaladhammānaṃ etaṃ adhivacana”</b>nti.","Kālasahacaritā hi kusalā dhammā idha kāla-saddena gahitā aparassa asambhavato.","Aṭṭhamādīni uttānatthāneva."],"lineRefs":[["an4.149:1"],["an4.149:1"],["an4.149:1"]]},{"para":1641,"vripara":null,"refs":["an4.149:1"],"lines":["Dutiyakālasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an4.149:1"]]},{"para":1642,"vripara":null,"refs":["an4.149:1"],"lines":["Ābhāvaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an4.149:1"]]},{"para":1643,"vripara":null,"refs":["an4.149:1"],"lines":["Tatiyapaṇṇāsakaṃ niṭṭhitaṃ. 4."],"lineRefs":[["an4.149:1"]]}],"wo