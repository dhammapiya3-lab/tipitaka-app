{"suttaId":"sn22.32","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[167,173],"vripara":"32"},"segments":{"sn22.32:0.3":"Pabhaṅgusuttaṃ","sn22.32:1.1":"Sāvatthinidānaṃ.","sn22.32:1.2":"“Pabhaṅguñca, bhikkhave, desessāmi appabhaṅguñca.","sn22.32:1.3":"Taṃ suṇātha.","sn22.32:1.4":"Kiñca, bhikkhave, pabhaṅgu, kiṃ appabhaṅgu?","sn22.32:1.5":"Rūpaṃ, bhikkhave, pabhaṅgu.","sn22.32:1.6":"Yo tassa nirodho vūpasamo atthaṅgamo, idaṃ appabhaṅgu.","sn22.32:1.7":"Vedanā pabhaṅgu.","sn22.32:1.8":"Yo tassā nirodho vūpasamo atthaṅgamo, idaṃ appabhaṅgu.","sn22.32:1.9":"Saññā pabhaṅgu …","sn22.32:1.10":"saṅkhārā pabhaṅgu.","sn22.32:1.11":"Yo tesaṃ nirodho vūpasamo atthaṅgamo, idaṃ appabhaṅgu.","sn22.32:1.12":"Viññāṇaṃ pabhaṅgu.","sn22.32:1.13":"Yo tassa nirodho vūpasamo atthaṅgamo, idaṃ appabhaṅgū”ti.","sn22.32:1.14":"Ekādasamaṃ.","sn22.32:1.15":"Bhāravaggo tatiyo.","sn22.32:2.0":"Tassuddānaṃ –","sn22.32:2.1":"Bhāraṃ pariññaṃ abhijānaṃ,","sn22.32:2.2":"chandarāgaṃ catutthakaṃ;","sn22.32:2.3":"Assādā ca tayo vuttā,","sn22.32:2.4":"abhinandanamaṭṭhamaṃ;","sn22.32:2.5":"Uppādaṃ aghamūlañca,","sn22.32:2.6":"ekādasamo pabhaṅgūti."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":85,"to":85,"paras":[{"para":85,"vripara":"32","refs":["sn22.32:1"],"lines":["Ekādasame <b>pabhaṅgun</b>ti pabhijjanasabhāvaṃ.","Evamidha aniccalakkhaṇameva kathitanti.","Ekādasamaṃ."],"lineRefs":[["sn22.32:1"],["sn22.32:1"],["sn22.32:1"]]}],"wordLinks":[["sn22.32:1.2","pabhaṅguṃ",0,0],["sn22.32:1.4","pabhaṅguṃ",0,0],["sn22.32:1.5","pabhaṅguṃ",0,0],["sn22.32:1.6","pabhaṅguṃ",0,0],["sn22.32:1.7","pabhaṅguṃ",0,0],["sn22.32:1.8","pabhaṅguṃ",0,0],["sn22.32:1.9","pabhaṅguṃ",0,0],["sn22.32:1.11","pabhaṅguṃ",0,0],["sn22.32:1.12","pabhaṅguṃ",0,0]],"before":[{"para":84,"vripara":null,"refs":[],"lines":["Pabhaṅgusuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t