{"suttaId":"tha-ap362","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10582,10598],"vripara":"37"},"segments":{"tha-ap362:0.3":"Piṇḍapātikattheraapadānaṃ","tha-ap362:1.1":"“Tisso nāmāsi sambuddho,","tha-ap362:1.2":"vihāsi vipine tadā;","tha-ap362:1.3":"Tusitā hi idhāgantvā,","tha-ap362:1.4":"piṇḍapātaṃ adāsahaṃ. 38.","tha-ap362:2.1":"“Sambuddhamabhivādetvā,","tha-ap362:2.2":"tissaṃ nāma mahāyasaṃ;","tha-ap362:2.3":"Sakaṃ cittaṃ pasādetvā,","tha-ap362:2.4":"tusitaṃ agamāsahaṃ. 39.","tha-ap362:3.1":"“Dvenavute ito kappe,","tha-ap362:3.2":"yaṃ dānamadadiṃ tadā;","tha-ap362:3.3":"Duggatiṃ nābhijānāmi,","tha-ap362:3.4":"piṇḍapātassidaṃ phalaṃ. 40.","tha-ap362:4.1":"“Paṭisambhidā catasso…pe…","tha-ap362:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap362:5.1":"Itthaṃ sudaṃ āyasmā piṇḍapātiko thero imā gāthāyo abhāsitthāti.","tha-ap362:6.1":"Piṇḍapātikattherassāpadānaṃ dasamaṃ.","tha-ap362:7.1":"Saddasaññakavaggo chattiṃsatimo.","tha-ap362:8.1":"Tassuddānaṃ –","tha-ap362:9.1":"Saddasaññī yavasiko,","tha-ap362:9.2":"kiṃsukoraṇḍapupphiyo;","tha-ap362:9.3":"Ālambano ambayāgu,","tha-ap362:9.4":"supuṭī mañcadāyako;","tha-ap362:9.5":"Saraṇaṃ piṇḍapāto ca,","tha-ap362:9.6":"gāthā tālīsameva ca. 37."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
