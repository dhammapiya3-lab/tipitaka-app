{"suttaId":"sn4.15","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1794,1799],"vripara":"151"},"segments":{"sn4.15:0.3":"Mānasasuttaṃ","sn4.15:1.1":"Evaṃ me sutaṃ –","sn4.15:1.2":"ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme.","sn4.15:1.3":"Atha kho māro pāpimā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ gāthāya ajjhabhāsi –","sn4.15:2.1":"“Antalikkhacaro pāso,","sn4.15:2.2":"yvāyaṃ carati mānaso;","sn4.15:2.3":"Tena taṃ bādhayissāmi,","sn4.15:2.4":"na me samaṇa mokkhasī”ti.","sn4.15:3.1":"“Rūpā saddā rasā gandhā,","sn4.15:3.2":"phoṭṭhabbā ca manoramā;","sn4.15:3.3":"Ettha me vigato chando,","sn4.15:3.4":"nihato tvamasi antakā”ti.","sn4.15:4.1":"Atha kho māro pāpimā “jānāti maṃ bhagavā, jānāti maṃ sugato”ti dukkhī dummano tatthevantaradhāyīti. 6."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":813,"to":813,"paras":[{"para":813,"vripara":"151","refs":["sn4.15:2"],"lines":["Pañcame ākāse carantepi bandhatīti <b>antalikkhacaro.</b>","<b>Pāso</b>ti rāgapāso.","<b>Mānaso</b>ti manasampayutto.","Pañcamaṃ. 6."],"lineRefs":[["sn4.15:2"],["sn4.15:2"],["sn4.15:2"],["sn4.15:2"]]}],"wordLinks":[["sn4.15:2.1","antalikkhacaro",0,0],["sn4.15:2.1","pāso",0,1],["sn4.15:2.1","mānaso",0,2]],"before":[{"para":812,"vripara":null,"title":"Mānasasuttavaṇṇanā","lines":["Mānasasuttavaṇṇanā 151."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":977,"to":977,"paras":[{"para":977,"vripara":"151","refs":["sn4.15:2"],"lines":["<b>Ākāse carante</b>ti pañcābhiññe sandhāya vadati.","Antalikkhe carantepi kiccasādhanato <b>antalikkhacaro</b>.","Manasi jātoti <b>mānaso</b>.","Taṃ pana manasantānasampayuttatāyāti āha <b>“manasampayutto”</b>ti."],"lineRefs":[["sn4.15:2"],["sn4.15:2"],["sn4.15:2"],["sn4.15:2"]]}],"wordLinks":[["sn4.15:2.1","antalikkhacaro",0,1],["sn4.15:2.1","mānaso",0,2]],"before":[{"para":976,"vripara":null,"title":"Mānasasuttavaṇṇanā","lines":["Mānasasuttavaṇṇanā 151."]}],"after":[{"para":978,"vripara":null,"title":"Mānasasuttavaṇṇanā","lines":["Mānasasuttavaṇṇanā niṭṭhitā. 6."]}]},"tika2":null}
