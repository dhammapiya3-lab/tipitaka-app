{"suttaId":"tha-ap385","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10983,10998],"vripara":"15"},"segments":{"tha-ap385:0.3":"Udumbaraphaladāyakattheraapadānaṃ","tha-ap385:1.1":"“Vinatānadiyā tīre,","tha-ap385:1.2":"vihāsi purisuttamo;","tha-ap385:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap385:1.4":"ekaggaṃ susamāhitaṃ.","tha-ap385:2.1":"“Tasmiṃ pasannamānaso,","tha-ap385:2.2":"kilesamaladhovane;","tha-ap385:2.3":"Udumbaraphalaṃ gayha,","tha-ap385:2.4":"buddhaseṭṭhassadāsahaṃ.","tha-ap385:3.1":"“Ekanavutito kappe,","tha-ap385:3.2":"yaṃ phalamadadiṃ tadā;","tha-ap385:3.3":"Duggatiṃ nābhijānāmi,","tha-ap385:3.4":"phaladānassidaṃ phalaṃ.","tha-ap385:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap385:4.3":"viharāmi anāsavo.","tha-ap385:5.1":"“Svāgataṃ vata me āsi … pe …","tha-ap385:5.3":"kataṃ buddhassa sāsanaṃ.","tha-ap385:6.1":"“Paṭisambhidā catasso … pe …","tha-ap385:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap385:7.1":"Itthaṃ sudaṃ āyasmā udumbaraphaladāyako thero imā gāthāyo abhāsitthāti.","tha-ap385:8.1":"Udumbaraphaladāyakattherassāpadānaṃ tatiyaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
