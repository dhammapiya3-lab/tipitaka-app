{"suttaId":"sn4.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1753,1757],"vripara":"147"},"segments":{"sn4.11:0.3":"Pāsāṇasuttaṃ","sn4.11:1.1":"Ekaṃ samayaṃ bhagavā rājagahe viharati gijjhakūṭe pabbate.","sn4.11:1.2":"Tena kho pana samayena bhagavā rattandhakāratimisāyaṃ abbhokāse nisinno hoti, devo ca ekamekaṃ phusāyati.","sn4.11:1.3":"Atha kho māro pāpimā bhagavato bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavato avidūre mahante pāsāṇe padālesi.","sn4.11:2.1":"Atha kho bhagavā “māro ayaṃ pāpimā” iti viditvā māraṃ pāpimantaṃ gāthāya ajjhabhāsi –","sn4.11:3.1":"“Sacepi kevalaṃ sabbaṃ,","sn4.11:3.2":"gijjhakūṭaṃ calessasi [gaḷeyyasi (syā. kaṃ.), caleyyāsi (ka.)];","sn4.11:3.3":"Neva sammāvimuttānaṃ,","sn4.11:3.4":"buddhānaṃ atthi iñjita”nti.","sn4.11:4.1":"Atha kho māro pāpimā “jānāti maṃ bhagavā, jānāti maṃ sugato”ti dukkhī dummano tatthevantaradhāyīti. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":805,"to":805,"paras":[{"para":805,"vripara":"147","refs":["sn4.11:1","sn4.11:3"],"lines":["Dutiyavaggassa paṭhame <b>nisinno</b>ti pubbe vuttanayeneva padhānaṃ pariggaṇhanto nisinno.","Māropissa sukhanisinnabhāvaṃ ñatvā ghaṭṭayissāmīti upasaṅkamanto.","<b>Padālesī</b>ti pabbatapiṭṭhe ṭhatvā pavijjhi.","Pāsāṇā nirantarā aññamaññaṃ abhihanantā patanti.","<b>Kevala</b>nti sakalaṃ.","<b>Sabba</b>nti tasseva vevacanaṃ.","Paṭhamaṃ. 2."],"lineRefs":[["sn4.11:1"],["sn4.11:1"],["sn4.11:1"],["sn4.11:1"],["sn4.11:3"],["sn4.11:3"],["sn4.11:3"]]}],"wordLinks":[["sn4.11:1.2","nisinno",0,0],["sn4.11:1.3","padālesī",0,2],["sn4.11:3.1","kevalaṃ",0,4],["sn4.11:3.1","sabbaṃ",0,5]],"before":[{"para":803,"vripara":null,"title":"Dutiyavaggo","lines":["Dutiyavaggo 1."]},{"para":804,"vripara":null,"title":"Pāsāṇasuttavaṇṇanā","lines":["Pāsāṇasuttavaṇṇanā 147."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":965,"to":967,"paras":[{"para":965,"vripara":"147","refs":["sn4.11:1"],"lines":["<b>Pavijjhī</b>ti pabbataṃ sabbato pavattento tato tato nissajji.","<b>Sakala</b>nti sabbabhāgavantaṃ, nissesanti attho."],"lineRefs":[["sn4.11:1"],["sn4.11:1"]]},{"para":966,"vripara":null,"refs":["sn4.11:1"],"lines":["Pāsāṇasuttavaṇṇanā niṭṭhitā. 2."],"lineRefs":[["sn4.11:1"]]},{"para":967,"vripara":null,"refs":["sn4.11:1"],"lines":["Kiṃnusīhasuttavaṇṇanā 148."],"lineRefs":[["sn4.11:1"]]}],"wordLinks":[],"before":[{"para":963,"vripara":null,"title":"Dutiyavaggo","lines":["Dutiyavaggo 1."]},{"para":964,"vripara":null,"title":"Pāsāṇasuttavaṇṇanā","lines":["Pāsāṇasuttavaṇṇanā 147."]}]},"tika2":null}
