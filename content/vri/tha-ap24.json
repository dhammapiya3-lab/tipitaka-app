{"suttaId":"tha-ap24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[2670,2835],"vripara":"52"},"segments":{"tha-ap24:0.3":"Upavānattheraapadānaṃ","tha-ap24:1.1":"“Padumuttaro nāma jino,","tha-ap24:1.2":"sabbadhammāna pāragū;","tha-ap24:1.3":"Jalitvā aggikkhandhova,","tha-ap24:1.4":"sambuddho parinibbuto. 53.","tha-ap24:2.1":"“Mahājanā samāgamma,","tha-ap24:2.2":"pūjayitvā tathāgataṃ;","tha-ap24:2.3":"Citaṃ katvāna sukataṃ,","tha-ap24:2.4":"sarīraṃ abhiropayuṃ. 54.","tha-ap24:3.1":"“Sarīrakiccaṃ katvāna,","tha-ap24:3.2":"dhātuṃ tattha samānayuṃ;","tha-ap24:3.3":"Sadevamānusā sabbe,","tha-ap24:3.4":"buddhathūpaṃ akaṃsu te. 55.","tha-ap24:4.1":"“Paṭhamā kañcanamayā,","tha-ap24:4.2":"dutiyāsi maṇīmayā;","tha-ap24:4.3":"Tatiyā rūpiyamayā,","tha-ap24:4.4":"catutthī phalikāmayā. 56.","tha-ap24:5.1":"“Tathā [tattha (syā. ka.)] pañcamiyā bhūmi [nemi (sī.)],","tha-ap24:5.2":"lohitaṅgamayā ahu;","tha-ap24:5.3":"Chaṭṭhā masāragallassa,","tha-ap24:5.4":"sabbaratanamayūpari. 57.","tha-ap24:6.1":"“Jaṅghā maṇimayā āsi,","tha-ap24:6.2":"vedikā ratanamayā;","tha-ap24:6.3":"Sabbasoṇṇamayo thūpo,","tha-ap24:6.4":"uddhaṃ yojanamuggato. 58.","tha-ap24:7.1":"“Devā tattha samāgantvā,","tha-ap24:7.2":"ekato mantayuṃ tadā;","tha-ap24:7.3":"Mayampi thūpaṃ kassāma,","tha-ap24:7.4":"lokanāthassa tādino. 59.","tha-ap24:8.1":"“Dhātu āveṇikā natthi,","tha-ap24:8.2":"sarīraṃ ekapiṇḍitaṃ;","tha-ap24:8.3":"Imamhi buddhathūpamhi,","tha-ap24:8.4":"kassāma kañcukaṃ mayaṃ. 60.","tha-ap24:9.1":"“Devā sattahi ratnehi [sattaratanehi (sī.)],","tha-ap24:9.2":"aññaṃ vaḍḍhesu yojanaṃ;","tha-ap24:9.3":"Thūpo dviyojanubbedho,","tha-ap24:9.4":"timiraṃ byapahanti so. 61.","tha-ap24:10.1":"“Nāgā tattha samāgantvā,","tha-ap24:10.2":"ekato mantayuṃ tadā;","tha-ap24:10.3":"Manussā ceva devā ca,","tha-ap24:10.4":"buddhathūpaṃ akaṃsu te. 62.","tha-ap24:11.1":"“Mā no pamattā assumha [assumhā (sī. syā.), āsimhā (?)],","tha-ap24:11.2":"appamattā sadevakā;","tha-ap24:11.3":"Mayampi thūpaṃ kassāma,","tha-ap24:11.4":"lokanāthassa tādino. 63.","tha-ap24:12.1":"“Indanīlaṃ mahānīlaṃ,","tha-ap24:12.2":"atho jotirasaṃ maṇiṃ;","tha-ap24:12.3":"Ekato sannipātetvā,","tha-ap24:12.4":"buddhathūpaṃ achādayuṃ. 64.","tha-ap24:13.1":"“Sabbaṃ maṇimayaṃ āsi,","tha-ap24:13.2":"tāvatā buddhacetiyaṃ;","tha-ap24:13.3":"Tiyojanasamubbiddhaṃ [tīṇi yojanamubbiddhaṃ (sī. ka.)],","tha-ap24:13.4":"ālokakaraṇaṃ tadā. 65.","tha-ap24:14.1":"“Garuḷā ca samāgantvā,","tha-ap24:14.2":"ekato mantayuṃ tadā;","tha-ap24:14.3":"Manussā devā nāgā ca,","tha-ap24:14.4":"buddhathūpaṃ akaṃsu te. 66.","tha-ap24:15.1":"“‘Mā no pamattā assumha,","tha-ap24:15.2":"appamattā sadevakā;","tha-ap24:15.3":"Mayampi thūpaṃ kassāma,","tha-ap24:15.4":"lokanāthassa tādino’. 67.","tha-ap24:16.1":"“Sabbaṃ maṇimayaṃ thūpaṃ,","tha-ap24:16.2":"akaruṃ te ca kañcukaṃ [sabbamaṇimayaṃ thūpe, akaruttarakañcukaṃ (sī.)];","tha-ap24:16.3":"Yojanaṃ tepi vaḍḍhesuṃ,","tha-ap24:16.4":"āyataṃ buddhacetiyaṃ. 68.","tha-ap24:17.1":"“Catuyojanamubbiddho,","tha-ap24:17.2":"buddhathūpo virocati;","tha-ap24:17.3":"Obhāseti disā sabbā,","tha-ap24:17.4":"sataraṃsīva uggato. 69.","tha-ap24:18.1":"“Kumbhaṇḍā ca samāgantvā,","tha-ap24:18.2":"ekato mantayuṃ tadā;","tha-ap24:18.3":"Manussā ceva devā ca,","tha-ap24:18.4":"nāgā ca garuḷā tathā.","tha-ap24:18.5":"Paccekaṃ buddhaseṭṭhassa,","tha-ap24:18.6":"akaṃsu thūpamuttamaṃ. 70.","tha-ap24:19.1":"“‘Mā no pamattā assumha,","tha-ap24:19.2":"appamattā sadevakā;","tha-ap24:19.3":"Mayampi thūpaṃ kassāma,","tha-ap24:19.4":"lokanāthassa tādino;","tha-ap24:19.5":"Ratanehi chādessāma,","tha-ap24:19.6":"āyataṃ buddhacetiyaṃ’. 71.","tha-ap24:20.1":"“Yojanaṃ tepi vaḍḍhesuṃ,","tha-ap24:20.2":"āyataṃ buddhacetiyaṃ;","tha-ap24:20.3":"Pañcayojanamubbiddho,","tha-ap24:20.4":"thūpo obhāsate tadā. 72.","tha-ap24:21.1":"“Yakkhā tattha samāgantvā,","tha-ap24:21.2":"ekato mantayuṃ tadā;","tha-ap24:21.3":"Manussā devā nāgā ca,","tha-ap24:21.4":"garuḷā kumbhaaṇḍakā. 73.","tha-ap24:22.1":"“Paccekaṃ buddhaseṭṭhassa,","tha-ap24:22.2":"akaṃsu thūpamuttamaṃ;","tha-ap24:22.3":"‘Mā no pamattā assumha,","tha-ap24:22.4":"appamattā sadevakā. 74.","tha-ap24:23.1":"“‘Mayampi thūpaṃ kassāma,","tha-ap24:23.2":"lokanāthassa tādino;","tha-ap24:23.3":"Phalikāhi chādessāma,","tha-ap24:23.4":"āyataṃ buddhacetiyaṃ’. 75.","tha-ap24:24.1":"“Yojanaṃ tepi vaḍḍhesuṃ,","tha-ap24:24.2":"āyataṃ buddhacetiyaṃ;","tha-ap24:24.3":"Cha yojanāni ubbiddho,","tha-ap24:24.4":"thūpo obhāsate tadā. 76.","tha-ap24:25.1":"“Gandhabbā ca samāgantvā,","tha-ap24:25.2":"ekato mantayuṃ tadā;","tha-ap24:25.3":"‘Manujā devatā nāgā,","tha-ap24:25.4":"garuḷā kumbhayakkhakā. 77.","tha-ap24:26.1":"“‘Sabbekaṃsu buddhathūpaṃ,","tha-ap24:26.2":"mayamettha akārakā;","tha-ap24:26.3":"Mayampi thūpaṃ kassāma,","tha-ap24:26.4":"lokanāthassa tādino’. 78.","tha-ap24:27.1":"“Vediyo satta katvāna,","tha-ap24:27.2":"chattamāropayiṃsu te;","tha-ap24:27.3":"Sabbasoṇṇamayaṃ thūpaṃ,","tha-ap24:27.4":"gandhabbā kārayuṃ tadā. 79.","tha-ap24:28.1":"“Sattayojanamubbiddho,","tha-ap24:28.2":"thūpo obhāsate tadā;","tha-ap24:28.3":"Rattindivā na ñāyanti,","tha-ap24:28.4":"āloko hoti [ālokā honti (syā. ka.)] sabbadā. 80.","tha-ap24:29.1":"“Abhibhonti na tassābhā,","tha-ap24:29.2":"candasūrā satārakā;","tha-ap24:29.3":"Samantā yojanasate,","tha-ap24:29.4":"padīpopi na pajjali. 81.","tha-ap24:30.1":"“Tena kālena ye keci,","tha-ap24:30.2":"thūpaṃ pūjenti mānusā;","tha-ap24:30.3":"Na te thūpamāruhanti,","tha-ap24:30.4":"ambare ukkhipanti te. 82.","tha-ap24:31.1":"“Devehi ṭhapito yakkho,","tha-ap24:31.2":"abhisammatanāmako;","tha-ap24:31.3":"Dhajaṃ vā pupphadāmaṃ vā,","tha-ap24:31.4":"abhiropeti uttari. 83.","tha-ap24:32.1":"“Na te passanti taṃ yakkhaṃ,","tha-ap24:32.2":"dāmaṃ passanti gacchato;","tha-ap24:32.3":"Evaṃ passitvā gacchantā,","tha-ap24:32.4":"sabbe gacchanti suggatiṃ. 84.","tha-ap24:33.1":"“Viruddhā [visaddhā (sī.)] ye pāvacane,","tha-ap24:33.2":"pasannā ye ca sāsane;","tha-ap24:33.3":"Pāṭiheraṃ daṭṭhukāmā,","tha-ap24:33.4":"thūpaṃ pūjenti mānusā. 85.","tha-ap24:34.1":"“Nagare haṃsavatiyā,","tha-ap24:34.2":"ahosiṃ bhatako [varako (syā. ka.)] tadā;","tha-ap24:34.3":"Āmoditaṃ janaṃ disvā,","tha-ap24:34.4":"evaṃ cintesahaṃ tadā. 86.","tha-ap24:35.1":"“‘Uḷāro bhagavā heso,","tha-ap24:35.2":"yassa dhātudharedisaṃ;","tha-ap24:35.3":"Imā ca janatā tuṭṭhā,","tha-ap24:35.4":"kāraṃ kubbaṃ na tappare [kubbantanappakaṃ (sī.)]. 87.","tha-ap24:36.1":"“‘Ahampi kāraṃ kassāmi,","tha-ap24:36.2":"lokanāthassa tādino;","tha-ap24:36.3":"Tassa dhammesu dāyādo,","tha-ap24:36.4":"bhavissāmi anāgate’. 88.","tha-ap24:37.1":"“Sudhotaṃ rajakenāhaṃ,","tha-ap24:37.2":"uttareyyapaṭaṃ mama;","tha-ap24:37.3":"Veḷagge ālagetvāna,","tha-ap24:37.4":"dhajaṃ ukkhipimambare. 89.","tha-ap24:38.1":"“Abhisammatako gayha,","tha-ap24:38.2":"ambarehāsi me dhajaṃ;","tha-ap24:38.3":"Vāteritaṃ dhajaṃ disvā,","tha-ap24:38.4":"bhiyyo hāsaṃ janesahaṃ. 90.","tha-ap24:39.1":"“Tattha cittaṃ pasādetvā,","tha-ap24:39.2":"samaṇaṃ upasaṅkamiṃ;","tha-ap24:39.3":"Taṃ bhikkhuṃ abhivādetvā,","tha-ap24:39.4":"vipākaṃ pucchahaṃ dhaje. 91.","tha-ap24:40.1":"“So me kathesi ānanda,","tha-ap24:40.2":"pītisañjananaṃ mama;","tha-ap24:40.3":"‘Tassa dhajassa vipākaṃ,","tha-ap24:40.4":"anubhossasi sabbadā. 92.","tha-ap24:41.1":"“‘Hatthī assā rathā pattī,","tha-ap24:41.2":"senā ca caturaṅginī;","tha-ap24:41.3":"Parivāressanti taṃ niccaṃ,","tha-ap24:41.4":"dhajadānassidaṃ phalaṃ. 93.","tha-ap24:42.1":"“‘Saṭṭhitūriyasahassāni,","tha-ap24:42.2":"bheriyo samalaṅkatā;","tha-ap24:42.3":"Parivāressanti taṃ niccaṃ,","tha-ap24:42.4":"dhajadānassidaṃ phalaṃ. 94.","tha-ap24:43.1":"“‘Chaḷāsītisahassāni,","tha-ap24:43.2":"nāriyo samalaṅkatā;","tha-ap24:43.3":"Vicittavatthābharaṇā,","tha-ap24:43.4":"āmuttamaṇikuṇḍalā. 95.","tha-ap24:44.1":"“‘Aḷārapamhā hasulā,","tha-ap24:44.2":"susaññā tanumajjhimā;","tha-ap24:44.3":"Parivāressanti taṃ niccaṃ,","tha-ap24:44.4":"dhajadānassidaṃ phalaṃ. 96.","tha-ap24:45.1":"“‘Tiṃsakappasahassāni,","tha-ap24:45.2":"devaloke ramissasi;","tha-ap24:45.3":"Asītikkhattuṃ devindo,","tha-ap24:45.4":"devarajjaṃ karissasi. 97.","tha-ap24:46.1":"“‘Sahassakkhattuṃ rājā ca,","tha-ap24:46.2":"cakkavattī bhavissasi;","tha-ap24:46.3":"Padesarajjaṃ vipulaṃ,","tha-ap24:46.4":"gaṇanāto asaṅkhiyaṃ. 98.","tha-ap24:47.1":"“‘Kappasatasahassamhi,","tha-ap24:47.2":"okkākakulasambhavo;","tha-ap24:47.3":"Gotamo nāma gottena,","tha-ap24:47.4":"satthā loke bhavissati. 99.","tha-ap24:48.1":"“‘Devalokā cavitvāna,","tha-ap24:48.2":"sukkamūlena codito;","tha-ap24:48.3":"Puññakammena saṃyutto,","tha-ap24:48.4":"brahmabandhu bhavissasi. 100.","tha-ap24:49.1":"“‘Asītikoṭiṃ chaḍḍetvā,","tha-ap24:49.2":"dāse kammakare bahū;","tha-ap24:49.3":"Gotamassa bhagavato,","tha-ap24:49.4":"sāsane pabbajissasi. 101.","tha-ap24:50.1":"“‘Ārādhayitvā sambuddhaṃ,","tha-ap24:50.2":"gotamaṃ sakyapuṅgavaṃ;","tha-ap24:50.3":"Upavānoti nāmena,","tha-ap24:50.4":"hessasi satthu sāvako’. 102.","tha-ap24:51.1":"“Satasahasse kataṃ kammaṃ,","tha-ap24:51.2":"phalaṃ dassesi me idha;","tha-ap24:51.3":"Sumutto saravegova","tha-ap24:51.4":"kilese jhāpayī mama. 103.","tha-ap24:52.1":"“Cakkavattissa santassa,","tha-ap24:52.2":"catudīpissarassa me;","tha-ap24:52.3":"Tiyojanāni samantā,","tha-ap24:52.4":"ussīsanti dhajā sadā. 104.","tha-ap24:53.1":"“Satasahassito kappe,","tha-ap24:53.2":"yaṃ kammamakariṃ tadā;","tha-ap24:53.3":"Duggatiṃ nābhijānāmi,","tha-ap24:53.4":"dhajadānassidaṃ phalaṃ. 105.","tha-ap24:54.1":"“Paṭisambhidā catasso,","tha-ap24:54.2":"vimokkhāpi ca aṭṭhime;","tha-ap24:54.3":"Chaḷabhiññā sacchikatā,","tha-ap24:54.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap24:55.1":"Itthaṃ sudaṃ āyasmā upavāno thero imā gāthāyo abhāsitthāti.","tha-ap24:56.1":"Upavānattherassāpadānaṃ dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2346,"to":2348,"paras":[{"para":2346,"vripara":"52","refs":["tha-ap24:1"],"lines":["Evaṃ so pattaarahattaphalo adhigataetadaggaṭṭhāno attano pubbakammaṃ saritvā somanassavasena pubbacaritāpadānaṃ pakāsento <b>padumuttaro nāma jino</b>tiādimāha.","Tattha sabbesaṃ lokiyalokuttaradhammānaṃ <b>pāragū</b> pariyosānaṃ nibbānaṃ gato patto <b>padumuttaro nāma jino</b> jitapañcamāro bhagavā aggikkhandho iva chabbaṇṇā buddharaṃsiyo <b>jalitvā</b> sabbalokaṃ dhammapajjotena obhāsetvā <b>sambuddho</b> suṭṭhu buddho avijjāniddūpagatāya pajāya savāsanāya kilesaniddāya paṭibuddho vikasitanettapaṅkajo <b>parinibbuto</b> khandhaparinibbānena nibbuto adassanaṃ gatoti sambandho. 57."],"lineRefs":[["tha-ap24:1"],["tha-ap24:1"]]},{"para":2347,"vripara":"57","refs":["tha-ap24:6"],"lines":["<b>Jaṅghā</b>ti cetiyakaraṇakāle upacinitabbānaṃ iṭṭhakānaṃ ṭhapanatthāya, nibandhiyamānasopānapanti. 88."],"lineRefs":[["tha-ap24:6"]]},{"para":2348,"vripara":"88","refs":["tha-ap24:37"],"lines":["<b>Sudhotaṃ</b> <b>rajakenāha</b>nti vatthadhovakena purisena suṭṭhu dhovitaṃ suvisuddhakataṃ, <b>uttareyyapaṭaṃ mama</b> uttarasāṭakaṃ ahaṃ veḷagge laggitvā dhajaṃ katvā ukkhipiṃ, <b>ambare</b> ākāse ussāpesinti attho.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap24:37"],["tha-ap24:37"]]}],"wordLinks":[["tha-ap24:1.1","padumuttaro nāma jino",0,0],["tha-ap24:1.1","padumuttaro nāma jino",0,1],["tha-ap24:1.1","pāragū",0,1],["tha-ap24:1.3","jalitvā",0,1],["tha-ap24:1.3","parinibbuto",0,1],["tha-ap24:1.3","sambuddho",0,1],["tha-ap24:6.1","jaṅghā",1,0],["tha-ap24:37.1","sudhotaṃ rajakenāhaṃ",2,0],["tha-ap24:37.1","uttareyyapaṭaṃ mama",2,0],["tha-ap24:37.3","ambare",2,0]],"before":[{"para":2344,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["Upavānattheraapadānavaṇṇanā"]},{"para":2345,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["<b>Padumuttaro</b> <b>nāma jino</b>tiādikaṃ āyasmato upavānattherassa apadānaṃ.","Ayampāyasmā purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto padumuttarassa bhagavato kāle daliddakule nibbattitvā viññutaṃ patto bhagavati parinibbute tassa dhātuṃ gahetvā manussadevanāgagaruḷakumbhaṇḍayakkhagandhabbehi sattaratanamaye sattayojanike thūpe kate tattha sudhotaṃ attano uttarasāṭakaṃ veḷagge laggetvā ābandhitvā dhajaṃ katvā pūjaṃ akāsi.","Taṃ gahetvā abhisammatako nāma yakkhasenāpati devehi cetiyapūjārakkhaṇatthaṃ ṭhapito adissamānakāyo taṃ ākāse dhārento cetiyaṃ tikkhattuṃ padakkhiṇaṃ akāsi.","So taṃ disvā bhiyyosomattāya pasannamānaso hutvā tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇakule nibbattitvā <b>upavāno</b>ti laddhanāmo vayappatto jetavanapaṭiggahaṇe buddhānubhāvaṃ disvā paṭiladdhasaddho pabbajitvā vipassanāya kammaṃ karonto arahattaṃ patvā chaḷabhiñño ahosi.","Yadā bhagavato aphāsu ahosi, tadā thero uṇhodakaṃ tathārūpaṃ pānakañca bhesajjaṃ bhagavato upanāmesi.","Tenassa satthuno rogo vūpasami.","Tassa bhagavā anumodanaṃ akāsi. 52."]}],"after":[{"para":2349,"vripara":null,"title":"Upavānattheraapadānavaṇṇanā","lines":["Upavānattheraapadānavaṇṇanā samattā. 3."]}]},"tika":null,"tika2":null}
