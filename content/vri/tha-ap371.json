{"suttaId":"tha-ap371","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10709,10720],"vripara":"31"},"segments":{"tha-ap371:0.3":"Timirapupphiyattheraapadānaṃ","tha-ap371:1.1":"“Candabhāgānadītīre,","tha-ap371:1.2":"anusotaṃ vajāmahaṃ;","tha-ap371:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap371:1.4":"sālarājaṃva phullitaṃ. 32.","tha-ap371:2.1":"“Pasannacitto sumano,","tha-ap371:2.2":"paccekamunimuttamaṃ;","tha-ap371:2.3":"Gahetvā timiraṃ pupphaṃ,","tha-ap371:2.4":"matthake okiriṃ ahaṃ. 33.","tha-ap371:3.1":"“Ekanavutito kappe,","tha-ap371:3.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap371:3.3":"Duggatiṃ nābhijānāmi,","tha-ap371:3.4":"buddhapūjāyidaṃ phalaṃ. 34.","tha-ap371:4.1":"“Paṭisambhidā catasso…pe…","tha-ap371:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap371:5.1":"Itthaṃ sudaṃ āyasmā timirapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap371:6.1":"Timirapupphiyattherassāpadānaṃ navamaṃ. 10."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
