{"suttaId":"ja41","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[231,234],"vripara":"41"},"segments":{"ja41:0.4":"Losakajātakaṃ","ja41:1.1":"Yo atthakāmassa hitānukampino,","ja41:1.2":"ovajjamāno na karoti sāsanaṃ;","ja41:1.3":"Ajiyā pādamolamba [pādamolumba (sī. syā. pī.)],","ja41:1.4":"mittako viya socatīti.","ja41:2.1":"Losakajātakaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1596,"to":1596,"paras":[{"para":1596,"vripara":null,"refs":["ja41:1"],"lines":["Tattha <b>atthakāmassā</b>ti vuḍḍhiṃ icchantassa.","<b>Hitānukampino</b>ti hitena anukampamānassa.","<b>Ovajjamāno</b>ti mudukena hitacittena ovadiyamāno.","<b>Na karoti sāsanan</b>ti anusiṭṭhaṃ na karoti, dubbaco anovādako hoti.","<b>Mittako viya socatī</b>ti yathāyaṃ mittavindako ajikāya pādaṃ gahetvā socati kilamati, evaṃ niccakālaṃ socatīti imāya gāthāya bodhisatto dhammaṃ desesi."],"lineRefs":[["ja41:1"],["ja41:1"],["ja41:1"],["ja41:1"],["ja41:1"]]}],"wordLinks":[["ja41:1.1","atthakāmassā",0,0],["ja41:1.1","hitānukampino",0,1],["ja41:1.1","ovajjamāno",0,2],["ja41:1.1","na karoti sāsanaṃ",0,3],["ja41:1.3","mittako viya socatī",0,4]],"before":[{"para":1594,"vripara":"41","refs":[],"lines":["“Yo atthakāmassa hitānukampino, ovajjamāno na karoti sāsanaṃ;"],"lineRefs":[[]]},{"para":1595,"vripara":null,"refs":[],"lines":["Ajiyā pādamolamba, mittako viya socatī”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
