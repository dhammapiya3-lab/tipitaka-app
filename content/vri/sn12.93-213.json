{"suttaId":"sn12.93-213","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[607,628],"vripara":null},"segments":{"sn12.93-103:0.3":"2-12. Sikkhāsuttādipeyyālaekādasakaṃ","sn12.93-103:1.1":"(2)“Jarāmaraṇaṃ, bhikkhave, ajānatā apassatā yathābhūtaṃ jarāmaraṇe yathābhūtaṃ ñāṇāya sikkhā karaṇīyā.","sn12.93-103:2.1":"(Peyyālo. Catusaccikaṃ kātabbaṃ).","sn12.104-114:1.1":"(3) Jarāmaraṇaṃ, bhikkhave, ajānatā … pe …","sn12.104-114:1.2":"yogo karaṇīyo … pe ….","sn12.115-125:1.1":"(4) Jarāmaraṇaṃ, bhikkhave, ajānatā … pe …","sn12.115-125:1.2":"chando karaṇīyo … pe ….","sn12.126-136:1.1":"(5) Jarāmaraṇaṃ, bhikkhave, ajānatā … pe …","sn12.126-136:1.2":"ussoḷhī karaṇīyā … pe ….","sn12.137-147:1.1":"(6) Jarāmaraṇaṃ, bhikkhave, ajānatā … pe …","sn12.137-147:1.2":"appaṭivānī karaṇīyā … pe ….","sn12.148-158:1.1":"(7) Jarāmaraṇaṃ, bhikkhave, ajānatā … pe …","sn12.148-158:1.2":"ātappaṃ karaṇīyaṃ … pe ….","sn12.159-169:1.1":"(8) Jarāmaraṇaṃ, bhikkhave, ajānatā … pe …","sn12.159-169:1.2":"vīriyaṃ karaṇīyaṃ … pe ….","sn12.170-180:1.1":"(9) Jarāmaraṇaṃ, bhikkhave, ajānatā … pe …","sn12.170-180:1.2":"sātaccaṃ karaṇīyaṃ … pe ….","sn12.181-191:1.1":"(10) Jarāmaraṇaṃ, bhikkhave, ajānatā … pe …","sn12.181-191:1.2":"sati karaṇīyā … pe ….","sn12.192-202:1.1":"(11) Jarāmaraṇaṃ, bhikkhave, ajānatā … pe …","sn12.192-202:1.2":"sampajaññaṃ karaṇīyaṃ … pe ….","sn12.203-213:1.1":"(12) Jarāmaraṇaṃ, bhikkhave, ajānatā … pe …","sn12.203-213:1.2":"appamādo karaṇīyo … pe ….","sn12.203-213:1.3":"Antarapeyyālo navamo.","sn12.203-213:2.0":"Tassuddānaṃ –","sn12.203-213:2.1":"Satthā sikkhā ca yogo ca,","sn12.203-213:2.2":"chando ussoḷhipañcamī;","sn12.203-213:2.3":"Appaṭivāni ātappaṃ,","sn12.203-213:2.4":"vīriyaṃ sātaccamuccati;","sn12.203-213:2.5":"Sati ca sampajaññañca,","sn12.203-213:2.6":"appamādena dvādasāti.","sn12.203-213:2.7":"Suttantā antarapeyyālā niṭṭhitā.","sn12.203-213:3.1":"Pare te dvādasa honti,","sn12.203-213:3.2":"suttā dvattiṃsa satāni;","sn12.203-213:3.3":"Catusaccena te vuttā,","sn12.203-213:3.4":"peyyālaantaramhi yeti [peyyālā antaramhi yeti (sī. syā. kaṃ.)].","sn12.203-213:3.5":"Antarapeyyālesu uddānaṃ samattaṃ.","sn12.203-213:3.6":"Nidānasaṃyuttaṃ samattaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
