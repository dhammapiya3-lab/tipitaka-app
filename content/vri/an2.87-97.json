{"suttaId":"an2.87-97","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-ii","vriCode":"s0402m1.mul","paras":[180,191],"vripara":"88"},"segments":{"an2.87:0.2":"(9) 4. Dhammavaggo","an2.87:1.1":"“Dveme, bhikkhave, dhammā.","an2.87:1.2":"Katame dve?","an2.87:1.3":"Cetovimutti ca paññāvimutti ca.","an2.87:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.88:1.1":"“Dveme, bhikkhave, dhammā.","an2.88:1.2":"Katame dve?","an2.88:1.3":"Paggāho ca avikkhepo ca.","an2.88:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.89:1.1":"“Dveme, bhikkhave, dhammā.","an2.89:1.2":"Katame dve?","an2.89:1.3":"Nāmañca rūpañca.","an2.89:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.90:1.1":"“Dveme, bhikkhave, dhammā.","an2.90:1.2":"Katame dve?","an2.90:1.3":"Vijjā ca vimutti ca.","an2.90:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.91:1.1":"“Dveme, bhikkhave, dhammā.","an2.91:1.2":"Katame dve?","an2.91:1.3":"Bhavadiṭṭhi ca vibhavadiṭṭhi ca.","an2.91:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.92:1.1":"“Dveme, bhikkhave, dhammā.","an2.92:1.2":"Katame dve?","an2.92:1.3":"Ahirikañca anottappañca.","an2.92:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.93:1.1":"“Dveme, bhikkhave, dhammā.","an2.93:1.2":"Katame dve?","an2.93:1.3":"Hirī ca ottappañca.","an2.93:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.94:1.1":"“Dveme, bhikkhave, dhammā.","an2.94:1.2":"Katame dve?","an2.94:1.3":"Dovacassatā ca pāpamittatā ca.","an2.94:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.95:1.1":"“Dveme, bhikkhave, dhammā.","an2.95:1.2":"Katame dve?","an2.95:1.3":"Sovacassatā ca kalyāṇamittatā ca.","an2.95:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.96:1.1":"“Dveme, bhikkhave, dhammā.","an2.96:1.2":"Katame dve?","an2.96:1.3":"Dhātukusalatā ca manasikārakusalatā ca.","an2.96:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.97:1.1":"“Dveme, bhikkhave, dhammā.","an2.97:1.2":"Katame dve?","an2.97:1.3":"Āpattikusalatā ca āpattivuṭṭhānakusalatā ca.","an2.97:1.4":"Ime kho, bhikkhave, dve dhammā”ti.","an2.97:1.5":"Dhammavaggo catuttho."},"unsure":[],"preface":[],"attha":{"book":"Mp-ii","bookName":"Dukanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":226,"to":233,"paras":[{"para":226,"vripara":"88","refs":["an2.87"],"lines":["Catutthassa paṭhame <b>cetovimuttī</b>ti phalasamādhi.","<b>Paññāvimuttī</b>ti phalapaññā."],"lineRefs":[["an2.87"],["an2.87"]]},{"para":227,"vripara":"89","refs":["an2.88"],"lines":["Dutiye <b>paggāho</b>ti vīriyaṃ.","<b>Avikkhepo</b>ti cittekaggatā."],"lineRefs":[["an2.88"],["an2.88"]]},{"para":228,"vripara":"90","refs":["an2.89"],"lines":["Tatiye <b>nāman</b>ti cattāro arūpakkhandhā.","<b>Rūpan</b>ti rūpakkhandho.","Iti imasmiṃ sutte dhammakoṭṭhāsaparicchedañāṇaṃ nāma kathitaṃ."],"lineRefs":[["an2.89"],["an2.89"],["an2.89"]]},{"para":229,"vripara":"91","refs":["an2.90"],"lines":["Catutthe <b>vijjā</b>ti phalañāṇaṃ.","<b>Vimuttī</b>ti taṃsampayuttā sesadhammā."],"lineRefs":[["an2.90"],["an2.90"]]},{"para":230,"vripara":"92","refs":["an2.91"],"lines":["Pañcame <b>bhavadiṭṭhī</b>ti sassatadiṭṭhi.","<b>Vibhavadiṭṭhī</b>ti ucchedadiṭṭhi.","Chaṭṭhasattamāni uttānatthāneva."],"lineRefs":[["an2.91"],["an2.91"],["an2.91"]]},{"para":231,"vripara":"95","refs":["an2.94"],"lines":["Aṭṭhame <b>dovacassatā</b>ti dubbacabhāvo.","<b>Pāpamittatā</b>ti pāpamittasevanabhāvo.","Navamaṃ vuttavipariyāyena veditabbaṃ."],"lineRefs":[["an2.94"],["an2.94"],["an2.94"]]},{"para":232,"vripara":"97","refs":["an2.96"],"lines":["Dasame <b>dhātukusalatā</b>ti aṭṭhārasa dhātuyo dhātūti jānanaṃ.","<b>Manasikārakusalatā</b>ti tāsaṃyeva dhātūnaṃ aniccādivasena lakkhaṇattayaṃ āropetvā jānanaṃ."],"lineRefs":[["an2.96"],["an2.96"]]},{"para":233,"vripara":"98","refs":["an2.97"],"lines":["Ekādasame <b>āpattikusalatā</b>ti pañcannañca sattannañca āpattikkhandhānaṃ jānanaṃ.","<b>Āpattivuṭṭhānakusalatā</b>ti desanāya vā kammavācāya vā āpattīhi vuṭṭhānajānananti."],"lineRefs":[["an2.97"],["an2.97"]]}],"wordLinks":[["an2.87:1.3","cetovimuttī",0,0],["an2.87:1.3","paññāvimuttī",0,1],["an2.88:1.3","paggāho",1,0],["an2.88:1.3","avikkhepo",1,1],["an2.89:1.3","nāmaṃ",2,0],["an2.89:1.3","rūpaṃ",2,1],["an2.90:1.3","vijjā",3,0],["an2.90:1.3","vimuttī",3,1],["an2.91:1.3","bhavadiṭṭhī",4,0],["an2.91:1.3","vibhavadiṭṭhī",4,1],["an2.94:1.3","dovacassatā",5,0],["an2.94:1.3","pāpamittatā",5,1],["an2.96:1.3","dhātukusalatā",6,0],["an2.96:1.3","manasikārakusalatā",6,1],["an2.97:1.3","āpattikusalatā",7,0],["an2.97:1.3","āpattivuṭṭhānakusalatā",7,1]],"before":[{"para":225,"vripara":null,"title":"4. Dhammavaggavaṇṇanā","lines":["(9)4. Dhammavaggavaṇṇanā"]}],"after":[{"para":234,"vripara":null,"title":"4. Dhammavaggavaṇṇanā","lines":["Dhammavaggo catuttho."]}]},"tika":{"book":"Mp-t-ii","bookName":"Dukanipāta-ṭīkā","vriCode":"s0402t.tik","from":207,"to":215,"paras":[{"para":207,"vripara":"89","refs":["an2.88"],"lines":["Dutiye sampayuttadhamme pariggaṇhātīti <b>paggāho</b>.","Na vikkhipatīti <b>avikkhepo</b>."],"lineRefs":[["an2.88"],["an2.88"]]},{"para":208,"vripara":"90","refs":["an2.89"],"lines":["Tatiye namanaṭṭhena <b>nāmaṃ</b>.","Ruppanaṭṭhena <b>rūpaṃ</b>.","Sammasanacārassa adhippetattā <b>“cattāro arūpakkhandhā”</b> tveva vuttaṃ.","Tenāha <b>“dhamma-koṭṭhāsaparicchedañāṇaṃ nāma kathitan”</b>ti."],"lineRefs":[["an2.89"],["an2.89"],["an2.89"],["an2.89"]]},{"para":209,"vripara":"91","refs":["an2.90"],"lines":["Catutthe vijānanaṭṭhena <b>vijjā</b>.","Vimuccanaṭṭhena <b>vimutti</b>."],"lineRefs":[["an2.90"],["an2.90"]]},{"para":210,"vripara":"92","refs":["an2.91"],"lines":["Pañcame bhavo nāma sassataṃ sadā bhāvato, sassatavasena uppajjanadiṭṭhi <b>bhavadiṭṭhi</b>.","Vibhavo nāma ucchedo vināsanaṭṭhena, vibhavavasena uppajjanadiṭṭhi <b>vibhavadiṭṭhi.</b>","<b>Uttānatthāneva</b> heṭṭhā vuttanayattā."],"lineRefs":[["an2.91"],["an2.91"],["an2.91"]]},{"para":211,"vripara":"95","refs":["an2.91","an2.94"],"lines":["Aṭṭhame dukkhaṃ vaco etasmiṃ vippaṭikūlagāhimhi vipaccanīkasāte anādare puggaleti dubbaco, tassa kammaṃ dovacassaṃ, tassa dubbacassa puggalassa anādariyavasena pavattā cetanā.","Tassa bhāvo <b>dovacassatā.</b>","<b>Tassa bhāvo</b>ti ca tassa yathāvuttassa dovacassassa atthibhāvo, atthato dovacassameva.","Vitthārato panesā “tattha katamā dovacassatā?","Sahadhammike vuccamāne dovacassāyan”ti <b>abhidhamme</b> āgatā.","Sā atthato saṅkhārakkhandho hoti.","Catunnaṃ vā khandhānaṃ etenākārena pavattānaṃ etaṃ adhivacananti vadanti."],"lineRefs":[["an2.91"],["an2.94"],["an2.94"],["an2.94"],["an2.94"],["an2.94"],["an2.94"]]},{"para":212,"vripara":null,"refs":["an2.94"],"lines":["Pāpayogato pāpā assaddhādayo puggalā etassa mittāti pāpamitto, tassa bhāvo <b>pāpamittatā</b>.","Vitthārato panesā “tattha katamā pāpamittatā?","Ye te puggalā assaddhā dussīlā appassutā maccharino duppaññā.","Yā tesaṃ sevanā nisevanā saṃsevanā bhajanā sambhajanā bhatti sambhatti taṃsampavaṅkatā”ti (dha. sa.1333) evaṃ āgatā.","Sāpi atthato dovacassatā viya daṭṭhabbā.","Yāya hi cetanāya puggalo pāpasampavaṅko nāma hoti, sā cetanā cattāropi vā arūpino khandhā tadākārappavattā <b>pāpamittatā</b>."],"lineRefs":[["an2.94"],["an2.94"],["an2.94"],["an2.94"],["an2.94"],["an2.94"]]},{"para":213,"vripara":"96","refs":["an2.95"],"lines":["Navame sukhaṃ vaco etasmiṃ padakkhiṇagāhimhi anulomasāte sādare puggaleti <b>subbaco</b>tiādinā, kalyāṇā saddhādayo puggalā etassa mittāti <b>kalyāṇamitto</b>tiādinā vuttavipariyāyena attho veditabbo."],"lineRefs":[["an2.95"]]},{"para":214,"vripara":"97","refs":["an2.95","an2.96"],"lines":["Dasame pathavīdhātuādayo sukhadhātukāmadhātuādayo ca etāsveva antogadhāti etāsu kosalle dassite tāsupi kosallaṃ dassitameva hotīti <b>“aṭṭhārasa dhātuyo”</b>ti vuttaṃ.","<b>Dhātūti jānanan</b>ti iminā aṭṭhārasannaṃ dhātūnaṃ sabhāvaparicchedikā savanadhāraṇasammasanappaṭivedhapaññā vuttā.","Tattha dhātūnaṃ savanadhāraṇapaññā sutamayā, itarā bhāvanāmayā.","Tatthāpi sammasanapaññā lokiyā.","Vipassanā hi sā, itarā lokuttarā.","Lakkhaṇādivasena aniccādivasena ca manasikaraṇaṃ manasikāro, tattha kosallaṃ <b>manasikārakusalatā</b>.","Aṭṭhārasannaṃyeva dhātūnaṃ sammasanappaṭivedhapaccavekkhaṇapaññā manasikārakusalatā, sā ādimajjhapariyosānavasena tidhā bhinnā.","Tathā hi sammasanapaññā tassā ādi, paṭivedhapaññā majjhe, paccavekkhaṇapaññā pariyosānaṃ."],"lineRefs":[["an2.95"],["an2.95"],["an2.95"],["an2.95"],["an2.95"],["an2.96"],["an2.96"],["an2.96"]]},{"para":215,"vripara":"98","refs":["an2.96","an2.97"],"lines":["Ekādasame āpattiyova āpattikkhandhā.","Tā pana antarāpattīnaṃ aggahaṇena pañca, tāsaṃ gahaṇena satta hontīti āha <b>“pañcannañca sattannañca āpattikkhandhānan”</b>ti.","<b>Jānanan</b>ti “imā āpattiyo, ettakā āpattiyo, evañca tāsaṃ āpajjanaṃ hotī”ti jānanaṃ.","Evaṃ tippakārena jānanapaññā hi āpattikusalatā nāma.","Āpattito vuṭṭhāpanappayogatāya kammabhūtā vācā kammavācā, tathābhūtā anussāvanavācā.","“Imāya kammavācāya ito āpattito vuṭṭhānaṃ hoti, hontañca paṭhame, tatiye vā anussāvane yya-kāraṃ patte,‘saṃvarissāmī’ti vā pade pariyosite hotī”ti evaṃ taṃ taṃ āpattīhi vuṭṭhānaparicchedajānanapaññā <b>āpattivuṭṭhānakusalatā.</b>","<b>Vuṭṭhānan</b>ti ca yathāpannāya āpattiyā yathā tathā anantarāyatāpādanaṃ.","Evaṃ vuṭṭhānaggahaṇeneva desanāyapi saṅgaho siddho hoti."],"lineRefs":[["an2.96"],["an2.96"],["an2.96"],["an2.96"],["an2.96"],["an2.97"],["an2.97"],["an2.97"]]}],"wordLinks":[["an2.88:1.3","paggāho",0,0],["an2.88:1.3","avikkhepo",0,1],["an2.89:1.3","nāmaṃ",1,0],["an2.89:1.3","rūpaṃ",1,1],["an2.90:1.3","vijjā",2,0],["an2.90:1.3","vimutti",2,1],["an2.91:1.3","bhavadiṭṭhi",3,0],["an2.91:1.3","vibhavadiṭṭhi",3,1],["an2.94:1.3","dovacassatā",4,1],["an2.94:1.3","pāpamittatā",5,0],["an2.94:1.3","pāpamittatā",5,5],["an2.95:1.3","kalyāṇamitto",6,0],["an2.96:1.3","manasikārakusalatā",7,5],["an2.97:1.3","āpattivuṭṭhānakusalatā",8,5],["an2.97:1.3","vuṭṭhānaṃ",8,6]],"before":[{"para":205,"vripara":null,"title":"4. Dhammavaggavaṇṇanā","lines":["(9)4. Dhammavaggavaṇṇanā"]},{"para":206,"vripara":"88","title":"4. Dhammavaggavaṇṇanā","lines":["Catutthassa paṭhame <b>phalasamādhī</b>ti catūsupi ariyaphalesu samādhi.","Tathā <b>phalapaññā</b> veditabbā."]}],"after":[{"para":216,"vripara":null,"title":"4. Dhammavaggavaṇṇanā","lines":["Dhammavaggavaṇṇanā niṭṭhitā."]}]},"tika2":null}
