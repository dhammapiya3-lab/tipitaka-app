{"suttaId":"tha-ap322","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9408,9425],"vripara":"54"},"segments":{"tha-ap322:0.3":"Kumudamāliyattheraapadānaṃ","tha-ap322:1.1":"“Usabhaṃ pavaraṃ vīraṃ, mahesiṃ vijitāvinaṃ;","tha-ap322:1.3":"Vipassinaṃ mahāvīraṃ, abhijātaṃva kesariṃ.","tha-ap322:2.1":"“Rathiyaṃ paṭipajjantaṃ, āhutīnaṃ paṭiggahaṃ;","tha-ap322:2.3":"Gahetvā kumudaṃ mālaṃ, buddhaseṭṭhaṃ samokiriṃ.","tha-ap322:3.1":"“Ekanavutito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap322:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap322:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap322:5.1":"Itthaṃ sudaṃ āyasmā kumudamāliyo thero imā gāthāyo abhāsitthāti.","tha-ap322:6.1":"Kumudamāliyattherassāpadānaṃ dasamaṃ.","tha-ap322:7.1":"Ārakkhadāyakavaggo bāttiṃsatimo [battiṃsatimo (sī. syā.)].","tha-ap322:8.1":"Tassuddānaṃ –","tha-ap322:9.1":"Ārakkhado bhojanado, gatasaññī padumiyo;","tha-ap322:9.3":"Pupphāsanī santhaviko, saddasaññī tiraṃsiyo;","tha-ap322:9.5":"Kandaliko kumudī ca, sattapaññāsa gāthakāti."},"attha":null,"tika":null}
