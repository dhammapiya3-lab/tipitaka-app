{"suttaId":"sn2.24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1183,1211],"vripara":"105"},"segments":{"sn2.24:0.3":"Ghaṭīkārasuttaṃ","sn2.24:1.1":"Ekamantaṃ ṭhito kho ghaṭīkāro devaputto bhagavato santike imaṃ gāthaṃ abhāsi –","sn2.24:2.1":"“Avihaṃ upapannāse, vimuttā satta bhikkhavo;","sn2.24:2.3":"Rāgadosaparikkhīṇā, tiṇṇā loke visattikan”ti.","sn2.24:3.1":"“Ke ca te ataruṃ paṅkaṃ, maccudheyyaṃ suduttaraṃ;","sn2.24:3.3":"Ke hitvā mānusaṃ dehaṃ, dibbayogaṃ upaccagun”ti.","sn2.24:4.1":"“Upako palagaṇḍo [phalagaṇḍo (ka.)] ca, pukkusāti ca te tayo;","sn2.24:4.3":"Bhaddiyo khaṇḍadevo ca, bāhuraggi ca saṅgiyo [bāhudantī ca piṅgiyo (sī. syā.)];","sn2.24:4.5":"Te hitvā mānusaṃ dehaṃ, dibbayogaṃ upaccagun”ti.","sn2.24:5.1":"“Kusalī bhāsasī tesaṃ, mārapāsappahāyinaṃ;","sn2.24:5.3":"Kassa te dhammamaññāya, acchiduṃ bhavabandhanan”ti.","sn2.24:6.1":"“Na aññatra bhagavatā, nāññatra tava sāsanā;","sn2.24:6.3":"Yassa te dhammamaññāya, acchiduṃ bhavabandhanaṃ.","sn2.24:7.1":"“Yattha nāmañca rūpañca, asesaṃ uparujjhati;","sn2.24:7.3":"Taṃ te dhammaṃ idhaññāya, acchiduṃ bhavabandhanan”ti.","sn2.24:8.1":"“Gambhīraṃ bhāsasī vācaṃ, dubbijānaṃ sudubbudhaṃ;","sn2.24:8.3":"Kassa tvaṃ dhammamaññāya, vācaṃ bhāsasi īdisan”ti.","sn2.24:9.1":"“Kumbhakāro pure āsiṃ, vekaḷiṅge ghaṭīkaro;","sn2.24:9.3":"Mātāpettibharo āsiṃ, kassapassa upāsako.","sn2.24:10.1":"“Virato methunā dhammā, brahmacārī nirāmiso;","sn2.24:10.3":"Ahuvā te sagāmeyyo, ahuvā te pure sakhā.","sn2.24:11.1":"“Sohamete pajānāmi, vimutte satta bhikkhavo;","sn2.24:11.3":"Rāgadosaparikkhīṇe, tiṇṇe loke visattikan”ti.","sn2.24:12.1":"“Evametaṃ tadā āsi, yathā bhāsasi bhaggava;","sn2.24:12.3":"Kumbhakāro pure āsi, vekaḷiṅge ghaṭīkaro.","sn2.24:13.1":"“Mātāpettibharo āsi, kassapassa upāsako;","sn2.24:13.3":"Virato methunā dhammā, brahmacārī nirāmiso;","sn2.24:13.5":"Ahuvā me sagāmeyyo, ahuvā me pure sakhā”ti.","sn2.24:14.1":"“Evametaṃ purāṇānaṃ, sahāyānaṃ ahu saṅgamo;","sn2.24:14.3":"Ubhinnaṃ bhāvitattānaṃ, sarīrantimadhārinan”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":561,"to":562,"paras":[{"para":561,"vripara":"105","refs":["sn2.24:1"],"lines":["Catutthaṃ vuttatthameva.","Catutthaṃ."],"lineRefs":[["sn2.24:1"],["sn2.24:1"]]},{"para":562,"vripara":null,"refs":["sn2.24:1"],"lines":["Jantusuttavaṇṇanā"],"lineRefs":[["sn2.24:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":724,"to":726,"paras":[{"para":724,"vripara":"105","refs":["sn2.24:1"],"lines":["<b>Catutthaṃ</b> heṭṭhā devatāsaṃyuttavaṇṇanāyaṃ <b>vuttatthameva</b>."],"lineRefs":[["sn2.24:1"]]},{"para":725,"vripara":null,"refs":["sn2.24:1"],"lines":["Ghaṭīkārasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn2.24:1"]]},{"para":726,"vripara":null,"refs":["sn2.24:1"],"lines":["Jantusuttavaṇṇanā"],"lineRefs":[["sn2.24:1"]]}],"wordLinks":[],"before":[{"para":722,"vripara":null,"refs":[],"lines":["Serīsuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":723,"vripara":null,"refs":[],"lines":["Ghaṭīkārasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
