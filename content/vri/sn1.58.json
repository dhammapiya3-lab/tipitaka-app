{"suttaId":"sn1.58","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[702,707],"vripara":"58"},"segments":{"sn1.58:0.3":"Uppathasuttaṃ","sn1.58:1.1":"“Kiṃsu uppatho akkhāto, kiṃsu rattindivakkhayo;","sn1.58:1.3":"Kiṃ malaṃ brahmacariyassa, kiṃ sinānamanodakan”ti.","sn1.58:2.1":"“Rāgo uppatho akkhāto, vayo rattindivakkhayo;","sn1.58:2.3":"Itthī malaṃ brahmacariyassa, etthāyaṃ sajjate pajā;","sn1.58:2.5":"Tapo ca brahmacariyañca, taṃ sinānamanodaka” ntntti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":450,"to":450,"paras":[{"para":450,"vripara":"58","refs":["sn1.58:1","sn1.58:2"],"lines":["Aṭṭhame <b>rāgo uppatho</b>ti sugatiñca nibbānañca gacchantassa amaggo.","<b>Rattindivakkhayo</b>ti rattidivehi, rattidivesu vā khīyati.","<b>Itthī malan</b>ti sesaṃ bāhiramalaṃ bhasmakhārādīhi dhovitvā sakkā sodhetuṃ, mātugāmamalena duṭṭho pana na sakkā suddho nāma kātunti itthī “malan”ti vuttā.","<b>Etthā</b>ti ettha itthiyaṃ pajā sajjati.","<b>Tapo</b>ti indriyasaṃvaradhutaṅgaguṇavīriyadukkarakārikānaṃ nāmaṃ, idha pana ṭhapetvā dukkarakārikaṃ sabbāpi kilesasantāpikā paṭipadā vaṭṭati.","<b>Brahmacariyan</b>ti methunavirati.","Aṭṭhamaṃ."],"lineRefs":[["sn1.58:2"],["sn1.58:2"],["sn1.58:2"],["sn1.58:2"],["sn1.58:2"],["sn1.58:2"],["sn1.58:2"]]}],"wordLinks":[["sn1.58:2.1","rāgo uppatho",0,0],["sn1.58:2.1","rattindivakkhayo",0,1],["sn1.58:2.3","itthī malaṃ",0,2],["sn1.58:2.3","etthā",0,3],["sn1.58:2.5","tapo",0,4],["sn1.58:2.3","brahmacariyaṃ",0,5],["sn1.58:2.5","brahmacariyaṃ",0,5]]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":549,"to":549,"paras":[{"para":549,"vripara":"58","refs":["sn1.58:1","sn1.58:2"],"lines":["<b>Amaggo</b>ti na maggo anupāyo.","<b>Rattindivakkhayo</b>ti tattha vayakkhaṇassa pākaṭabhāvato.","Vuttakkhaṇopi hi sayaṃ khīyateva.","<b>Sesaṃ bāhiramalaṃ</b> vatthasarīrādibhūtaṃ.","Tathā hi <b>“bhasmakhārādīhi dhovitvā sakkā sodhetun”</b>ti vuttaṃ.","<b>Duṭṭho</b>ti dūsito sattasantāno <b>na sakkā suddho nāma kātuṃ</b> abbhantaramalīnabhāvāpādanato.","<b>Itthiyan</b>ti brahmacariyassa antarāyakarāyapi.","<b>Pajā</b>ti sattakāyo <b>sajjati</b> saṅgaṃ karoti yāthāvato ādīnavaṃ apassanto.","Indriyasaṃvarādi kilesānaṃ tāpanato <b>tapo,</b> tenāha <b>“sabbāpī”</b>tiādi."],"lineRefs":[["sn1.58:1"],["sn1.58:1"],["sn1.58:1"],["sn1.58:1"],["sn1.58:1"],["sn1.58:1"],["sn1.58:1"],["sn1.58:2"],["sn1.58:2"]]}],"wordLinks":[["sn1.58:1.1","rattindivakkhayo",0,1],["sn1.58:2.3","pajā",0,7],["sn1.58:2.3","sajjati",0,7],["sn1.58:2.5","tapo",0,8]]}}
