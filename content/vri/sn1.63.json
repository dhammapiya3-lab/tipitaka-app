{"suttaId":"sn1.63","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[738,742],"vripara":"63"},"segments":{"sn1.63:0.3":"Taṇhāsuttaṃ","sn1.63:1.1":"“Kenassu nīyati loko, kenassu parikassati;","sn1.63:1.3":"Kissassu ekadhammassa, sabbeva vasamanvagū”ti.","sn1.63:2.1":"“Taṇhāya nīyati loko, taṇhāya parikassati;","sn1.63:2.3":"Taṇhāya ekadhammassa, sabbeva vasamanvagū”ti."},"attha":null,"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":566,"to":566,"paras":[{"para":566,"vripara":"63","refs":["sn1.63:1","sn1.63:2"],"words":["sabbeva vasamanvagū"],"lines":["Tatiye <b>“sabbeva vasamanvagū”</b>ti ye taṇhāya vasaṃ gacchanti, tesaṃ eva anavasesapariyādānanti imamatthaṃ <b>“eseva nayo”</b>ti iminā atidissati."],"lineRefs":[["sn1.63:1"]]}]}}
