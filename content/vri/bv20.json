{"suttaId":"bv20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[2391,2464],"vripara":"1"},"segments":{"bv20:0.2":"Phussabuddhavaṃso","bv20:1.1":"Tattheva maṇḍakappamhi,","bv20:1.2":"ahu satthā anuttaro;","bv20:1.3":"Anupamo asamasamo,","bv20:1.4":"phusso lokagganāyako.","bv20:2.1":"Sopi sabbaṃ tamaṃ hantvā,","bv20:2.2":"vijaṭetvā mahājaṭaṃ;","bv20:2.3":"Sadevakaṃ tappayanto,","bv20:2.4":"abhivassi amatambunā.","bv20:3.1":"Dhammacakkaṃ pavattente,","bv20:3.2":"phusse nakkhattamaṅgale;","bv20:3.3":"Koṭisatasahassānaṃ,","bv20:3.4":"paṭhamābhisamayo ahu.","bv20:4.1":"Navutisatasahassānaṃ,","bv20:4.2":"dutiyābhisamayo ahu;","bv20:4.3":"Asītisatasahassānaṃ,","bv20:4.4":"tatiyābhisamayo ahu.","bv20:5.1":"Sannipātā tayo āsuṃ,","bv20:5.2":"phussassāpi mahesino;","bv20:5.3":"Khīṇāsavānaṃ vimalānaṃ,","bv20:5.4":"santacittāna tādinaṃ.","bv20:6.1":"Saṭṭhisatasahassānaṃ,","bv20:6.2":"paṭhamo āsi samāgamo;","bv20:6.3":"Paññāsasatasahassānaṃ,","bv20:6.4":"dutiyo āsi samāgamo.","bv20:7.1":"Cattārīsasatasahassānaṃ,","bv20:7.2":"tatiyo āsi samāgamo;","bv20:7.3":"Anupādā vimuttānaṃ,","bv20:7.4":"vocchinnapaṭisandhinaṃ.","bv20:8.1":"Ahaṃ tena samayena,","bv20:8.2":"vijitāvī nāma khattiyo;","bv20:8.3":"Chaḍḍayitvā mahārajjaṃ,","bv20:8.4":"pabbajiṃ tassa santike.","bv20:9.1":"Sopi maṃ buddho byākāsi,","bv20:9.2":"phusso lokagganāyako;","bv20:9.3":"“Dvenavute ito kappe,","bv20:9.4":"ayaṃ buddho bhavissati.","bv20:10.1":"“Padhānaṃ padahitvāna … pe …","bv20:10.3":"hessāma sammukhā imaṃ”.","bv20:11.1":"Tassāpi vacanaṃ sutvā,","bv20:11.2":"bhiyyo cittaṃ pasādayiṃ;","bv20:11.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv20:11.4":"dasapāramipūriyā.","bv20:12.1":"Suttantaṃ vinayañcāpi,","bv20:12.2":"navaṅgaṃ satthusāsanaṃ;","bv20:12.3":"Sabbaṃ pariyāpuṇitvā,","bv20:12.4":"sobhayiṃ jinasāsanaṃ.","bv20:13.1":"Tatthappamatto viharanto,","bv20:13.2":"brahmaṃ bhāvetva bhāvanaṃ;","bv20:13.3":"Abhiññāsu pāramiṃ gantvā,","bv20:13.4":"brahmalokamagañchahaṃ.","bv20:14.1":"Kāsikaṃ nāma nagaraṃ,","bv20:14.2":"jayaseno nāma khattiyo;","bv20:14.3":"Sirimā nāma janikā,","bv20:14.4":"phussassāpi mahesino.","bv20:15.1":"Navavassasahassāni,","bv20:15.2":"agāraṃ ajjha so vasi;","bv20:15.3":"Garuḷapakkha haṃsa suvaṇṇabhārā,","bv20:15.4":"tayo pāsādamuttamā.","bv20:16.1":"Tiṃsaitthisahassāni,","bv20:16.2":"nāriyo samalaṅkatā;","bv20:16.3":"Kisāgotamī nāma nārī,","bv20:16.4":"anūpamo nāma atrajo.","bv20:17.1":"Nimitte caturo disvā,","bv20:17.2":"hatthiyānena nikkhami;","bv20:17.3":"Chamāsaṃ padhānacāraṃ,","bv20:17.4":"acarī purisuttamo.","bv20:18.1":"Brahmunā yācito santo,","bv20:18.2":"phusso lokagganāyako;","bv20:18.3":"Vatti cakkaṃ mahāvīro,","bv20:18.4":"migadāye naruttamo.","bv20:19.1":"Surakkhito dhammaseno,","bv20:19.2":"ahesuṃ aggasāvakā;","bv20:19.3":"Sabhiyo nāmupaṭṭhāko,","bv20:19.4":"phussassāpi mahesino.","bv20:20.1":"Cālā ca upacālā ca,","bv20:20.2":"ahesuṃ aggasāvikā;","bv20:20.3":"Bodhi tassa bhagavato,","bv20:20.4":"āmaṇḍoti pavuccati.","bv20:21.1":"Dhanañcayo visākho ca,","bv20:21.2":"ahesuṃ aggupaṭṭhakā;","bv20:21.3":"Padumā ceva nāgā ca,","bv20:21.4":"ahesuṃ aggupaṭṭhikā.","bv20:22.1":"Aṭṭhapaṇṇāsaratanaṃ,","bv20:22.2":"sopi accuggato muni;","bv20:22.3":"Sobhate sataraṃsīva,","bv20:22.4":"uḷurājāva pūrito.","bv20:23.1":"Navutivassasahassāni,","bv20:23.2":"āyu vijjati tāvade;","bv20:23.3":"Tāvatā tiṭṭhamāno so,","bv20:23.4":"tāresi janataṃ bahuṃ.","bv20:24.1":"Ovaditvā bahū satte,","bv20:24.2":"santāretvā bahū jane;","bv20:24.3":"Sopi satthā atulayaso,","bv20:24.4":"nibbuto so sasāvako.","bv20:25.1":"Phusso jinavaro satthā,","bv20:25.2":"senārāmamhi nibbuto;","bv20:25.3":"Dhātuvitthārikaṃ āsi,","bv20:25.4":"tesu tesu padesatoti.","bv20:26.1":"Phussassa bhagavato vaṃso aṭṭhārasamo."},"unsure":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":3279,"to":3279,"paras":[{"para":3279,"vripara":null,"refs":["bv20:24"],"lines":["Tattha <b>āmaṇḍo</b>ti āmalakarukkho.","<b>Ovaditvā</b>ti ovādaṃ datvā, anusāsitvāti attho.","<b>Sopi satthā atulayaso</b>ti sopi satthā amitayasoti attho.","“So jahitvā amitayaso” tipi pāṭho, tassa so sabbameva vuttappakāraṃ visesaṃ hitvāti attho."],"lineRefs":[["bv20:24"],["bv20:24"],["bv20:24"],["bv20:24"]]}],"wordLinks":[["bv20:24.1","ovaditvā",0,1],["bv20:24.3","sopi satthā atulayaso",0,2]],"before":[{"para":3220,"vripara":null,"refs":[],"lines":["Tisso kira bhagavā sunandavatīnagare sunandārāme parinibbāyi.","Sesamettha gāthāsu pākaṭamevāti."],"lineRefs":[[],[]]},{"para":3221,"vripara":null,"refs":[],"lines":["Tissabuddhavaṃsavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3222,"vripara":null,"refs":[],"lines":["Niṭṭhito sattarasamo buddhavaṃso."],"lineRefs":[[]]},{"para":3223,"vripara":null,"refs":[],"lines":["Phussabuddhavaṃsavaṇṇanā"],"lineRefs":[[]]},{"para":3224,"vripara":null,"refs":[],"lines":["Tassa tissassa bhagavato aparabhāge anukkamena parihāyitvā puna vaḍḍhitvā aparimitāyukā hutvā anupubbena hāyitvā navutivassasahassāyukesu jātesu tasmiṃyeva kappe <b>phusso</b> nāma satthā loke uppajji.","Sopi bhagavā pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā kāsikanagare jayasenarañño aggamahesiyā sirimāya nāma deviyā kucchismiṃ paṭisandhiṃ gahetvā dasannaṃ māsānaṃ accayena sirimuyyāne mātukucchito nikkhami.","So navavassasahassāni agāraṃ ajjhāvasi.","Tassa kira garuḷapakkha-haṃsa-suvaṇṇabhārāti tayo pāsādā ahesuṃ.","Kisāgotamippamukhāni tiṃsa itthisahassāni paccupaṭṭhitāni ahesuṃ."],"lineRefs":[[],[],[],[],[]]},{"para":3225,"vripara":null,"refs":[],"lines":["So cattāri nimittāni disvā kisāgotamiyā anupame nāma putte uppanne alaṅkatagajavarakkhandhagato mahābhinikkhamanaṃ nikkhamitvā pabbaji.","Taṃ pabbajitaṃ janakoṭi anupabbaji.","So tehi parivuto cha māse padhānacariyaṃ caritvā tato gaṇaṃ pahāya sattāhaṃ ekacariyaṃ anubrūhayamāno vasitvā visākhapuṇṇamāya aññatare nagare aññatarassa seṭṭhino dhītāya sirivaḍḍhāya nāma dinnaṃ madhupāyāsaṃ paribhuñjitvā siṃsapāvane divāvihāraṃ vītināmetvā sāyanhasamaye sirivaḍḍhena nāma upāsakena dinnā aṭṭha tiṇamuṭṭhiyo gahetvā āmalakabodhiṃ upasaṅkamitvā samāraṃ mārabalaṃ vidhamitvā sabbaññutaññāṇaṃ patvā –","“anekajātisaṃsāraṃ … pe … taṇhānaṃ khayamajjhagā”ti udānaṃ udānetvā sattasattāhaṃ bodhisamīpeyeva vītināmetvā attanā saddhiṃ pabbajitānaṃ bhikkhūnaṃ koṭīnaṃ dhammapaṭivedhasamatthataṃ disvā ākāsena gantvā saṅkassanagare isipatane migadāye otaritvā tesaṃ majjhe dhammacakkaṃ pavattesi.","Tadā koṭisatasahassānaṃ paṭhamo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[],[]]},{"para":3227,"vripara":"1","refs":[],"lines":["“Tattheva maṇḍakappamhi, ahu satthā anuttaro;"],"lineRefs":[[]]},{"para":3228,"vripara":null,"refs":[],"lines":["Anūpamo asamasamo, phusso lokagganāyako."],"lineRefs":[[]]},{"para":3230,"vripara":"2","refs":[],"lines":["“Sopi sabbaṃ tamaṃ hantvā, vijaṭetvā mahājaṭaṃ;"],"lineRefs":[[]]},{"para":3231,"vripara":null,"refs":[],"lines":["Sadevakaṃ tappayanto, abhivassi amatambunā."],"lineRefs":[[]]},{"para":3233,"vripara":"3","refs":[],"lines":["“Dhammacakkaṃ pavattente, phusse nakkhattamaṅgale;"],"lineRefs":[[]]},{"para":3234,"vripara":null,"refs":[],"lines":["Koṭisatasahassānaṃ, paṭhamābhisamayo ahū”ti."],"lineRefs":[[]]},{"para":3235,"vripara":null,"refs":[],"lines":["Tattha <b>tattheva maṇḍakappamhī</b>ti yasmiṃ kappe dve buddhā uppajjanti, so “maṇḍakappo”ti heṭṭhā vutto.","<b>Vijaṭetvā</b>ti paṭivissajjetvā.","<b>Mahājaṭan</b>ti ettha jaṭāti taṇhāyetaṃ adhivacanaṃ.","Sā hi rūpādīsu ārammaṇesu heṭṭhupariyavasena punappunaṃ uppajjanato saṃsibbanato suttagumbajālapūvasaṅkhātā jaṭā viyāti jaṭāti vuttaṃ, taṃ mahājaṭaṃ.","<b>Sadevakan</b>ti sadevakaṃ lokaṃ.","<b>Abhivassī</b>ti pāvassi.","<b>Amatambunā</b>ti amatasaṅkhātena dhammakathāsalilena tappayanto pāvassīti attho."],"lineRefs":[[],[],[],[],[],[],[]]},{"para":3236,"vripara":null,"refs":[],"lines":["Yadā pana bārāṇasīnagare sirivaḍḍho nāma rājā mahantaṃ bhogakkhandhaṃ pahāya tāpasapabbajjaṃ pabbaji.","Tena saha pabbajitānaṃ tāpasānaṃ navutisatasahassāni ahesuṃ.","Tesaṃ bhagavā dhammaṃ desesi.","Tadā navutiyā satasahassānaṃ dutiyābhisamayo ahosi.","Yadā pana attano puttassa anupamakumārassa dhammaṃ desesi, tadā asītiyā satasahassānaṃ tatiyo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[],[]]},{"para":3238,"vripara":"4","refs":[],"lines":["“Navutisatasahassānaṃ, dutiyābhisamayo ahu;"],"lineRefs":[[]]},{"para":3239,"vripara":null,"refs":[],"lines":["Asītisatasahassānaṃ, tatiyābhisamayo ahū”ti."],"lineRefs":[[]]},{"para":3240,"vripara":null,"refs":[],"lines":["Tato aparena samayena kaṇṇakujjanagare surakkhito rājaputto ca purohitaputto dhammasenakumāro ca phusse sammāsambuddhe attano nagaraṃ sampatte saṭṭhiyā purisasatasahassehi saddhiṃ paccuggantvā vanditvā nimantetvā sattāhaṃ mahādānaṃ datvā dasabalassa dhammakathaṃ sutvā bhagavati pasīditvā te saparivārā pabbajitvā arahattaṃ pāpuṇiṃsu.","Tesaṃ saṭṭhiyā bhikkhusatasahassānaṃ majjhe bhagavā pātimokkhaṃ uddisi, so paṭhamo sannipāto ahosi.","Puna kāsinagare jayasenarañño saṭṭhimattānaṃ ñātīnaṃ samāgame buddhavaṃsaṃ desesi, taṃ sutvā paññāsasatasahassāni ehibhikkhupabbajjāya pabbajitvā arahattaṃ pāpuṇiṃsu.","Tesaṃ majjhagato bhagavā pātimokkhaṃ uddisi, so dutiyo sannipāto ahosi.","Puna mahāmaṅgalasamāgame maṅgalakathaṃ sutvā cattālīsapurisasatasahassāni pabbajitvā arahattaṃ pāpuṇiṃsu.","Tesaṃ majjhagato sugato pātimokkhaṃ uddisi, so tatiyo sannipāto ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":3242,"vripara":"5","refs":[],"lines":["“Sannipātā tayo āsuṃ, phussassapi mahesino;"],"lineRefs":[[]]},{"para":3243,"vripara":null,"refs":[],"lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ."],"lineRefs":[[]]},{"para":3245,"vripara":"6","refs":[],"lines":["“Saṭṭhisatasahassānaṃ, paṭhamo āsi samāgamo;"],"lineRefs":[[]]},{"para":3246,"vripara":null,"refs":[],"lines":["Paññāsasatasahassānaṃ, dutiyo āsi samāgamo."],"lineRefs":[[]]},{"para":3248,"vripara":"7","refs":[],"lines":["“Cattālīsasatasahassānaṃ, tatiyo āsi samāgamo;"],"lineRefs":[[]]},{"para":3249,"vripara":null,"refs":[],"lines":["Anupādā vimuttānaṃ, vocchinnapaṭisandhinan”ti."],"lineRefs":[[]]},{"para":3250,"vripara":null,"refs":[],"lines":["Tadā amhākaṃ bodhisatto arindamanagare vijitāvī nāma khattiyo hutvā tassa dhammaṃ sutvā bhagavati pasīditvā tassa mahādānaṃ datvā mahārajjaṃ pahāya bhagavato santike pabbajitvā tīṇi piṭakāni uggahetvā tepiṭakadharo mahājanassa dhammakathaṃ kathesi, sīlapāramiñca pūresi.","Sopi naṃ “buddho bhavissatī”ti byākāsi.","Tena vuttaṃ –"],"lineRefs":[[],[],[]]},{"para":3252,"vripara":"8","refs":[],"lines":["“Ahaṃ tena samayena, vijitāvī nāma khattiyo;"],"lineRefs":[[]]},{"para":3253,"vripara":null,"refs":[],"lines":["Chaḍḍayitvā mahārajjaṃ, pabbajiṃ tassa santike."],"lineRefs":[[]]},{"para":3255,"vripara":"9","refs":[],"lines":["“Sopi maṃ buddho byākāsi, phusso lokagganāyako;"],"lineRefs":[[]]},{"para":3256,"vripara":null,"refs":[],"lines":["Dvenavute ito kappe, ayaṃ buddho bhavissati."],"lineRefs":[[]]},{"para":3258,"vripara":"10","refs":[],"lines":["“Padhānaṃ padahitvāna … pe … dasapāramipūriyā."],"lineRefs":[[]]},{"para":3260,"vripara":"12","refs":[],"lines":["“Suttantaṃ vinayañcāpi, navaṅgaṃ satthusāsanaṃ;"],"lineRefs":[[]]},{"para":3261,"vripara":null,"refs":[],"lines":["Sabbaṃ pariyāpuṇitvā, sobhayiṃ jinasāsanaṃ."],"lineRefs":[[]]},{"para":3263,"vripara":"13","refs":[],"lines":["“Tatthappamatto viharanto, brahmaṃ bhāvetva bhāvanaṃ;"],"lineRefs":[[]]},{"para":3264,"vripara":null,"refs":[],"lines":["Abhiññāpāramiṃ gantvā, brahmalokamagañchahan”ti."],"lineRefs":[[]]},{"para":3265,"vripara":null,"refs":[],"lines":["Tassa pana bhagavato kāsikaṃ nāma nagaraṃ ahosi.","Jayaseno nāma rājā pitā, sirimā nāma mātā, surakkhito ca dhammaseno ca dve aggasāvakā, sabhiyo nāmupaṭṭhāko, cālā ca upacālā ca dve aggasāvikā, āmalakarukkho bodhi, sarīraṃ aṭṭhapaṇṇāsahatthubbedhaṃ ahosi, āyu navutivassasahassāni, kisāgotamī nāma aggamahesī, anupamo nāmassa putto, hatthiyānena nikkhami.","Tena vuttaṃ –"],"lineRefs":[[],[],[]]},{"para":3267,"vripara":"14","refs":[],"lines":["“Kāsikaṃ nāma nagaraṃ, jayaseno nāma khattiyo;"],"lineRefs":[[]]},{"para":3268,"vripara":null,"refs":[],"lines":["Sirimā nāma janikā, phussassāpi mahesino … pe.","…;"],"lineRefs":[[],[]]},{"para":3269,"vripara":null,"refs":[],"lines":["Bodhi tassa bhagavato, āmaṇḍoti pavuccati … pe …."],"lineRefs":[[]]},{"para":3271,"vripara":"22","refs":[],"lines":["“Aṭṭhapaṇṇāsaratanaṃ, sopi accuggato muni;"],"lineRefs":[[]]},{"para":3272,"vripara":null,"refs":[],"lines":["Sobhate sataraṃsīva, uḷurājāva pūrito."],"lineRefs":[[]]},{"para":3274,"vripara":"23","refs":[],"lines":["“Navutivassasahassāni, āyu vijjati tāvade;"],"lineRefs":[[]]},{"para":3275,"vripara":null,"refs":[],"lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[[]]},{"para":3277,"vripara":"24","refs":[],"lines":["“Ovaditvā bahū satte, santāretvā bahū jane;"],"lineRefs":[[]]},{"para":3278,"vripara":null,"refs":[],"lines":["Sopi satthā atulayaso, nibbuto so sasāvako”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
