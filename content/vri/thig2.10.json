{"suttaId":"thig2.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[176,184],"vripara":"37"},"segments":{"thig2.10:0.3":"Sāmātherīgāthā","thig2.10:1.1":"“Catukkhattuṃ pañcakkhattuṃ, vihārā upanikkhamiṃ;","thig2.10:1.3":"Aladdhā cetaso santiṃ, citte avasavattinī;","thig2.10:1.5":"Tassā me aṭṭhamī ratti, yato taṇhā samūhatā.","thig2.10:2.1":"“Bahūhi dukkhadhammehi, appamādaratāya me;","thig2.10:2.3":"Taṇhakkhayo anuppatto, kataṃ buddhassa sāsanan”ti.","thig2.10:3.1":"… Sāmā therī ….","thig2.10:4.1":"Dukanipāto niṭṭhito."},"attha":null,"tika":null}
