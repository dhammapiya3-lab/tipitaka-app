{"suttaId":"an6.90","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[768,768],"vripara":"90"},"segments":{"an6.90:0.3":"Pahīnasuttaṃ","an6.90:1.1":"“Chayime, bhikkhave, dhammā diṭṭhisampannassa puggalassa pahīnā.","an6.90:1.2":"Katame cha?","an6.90:1.3":"Sakkāyadiṭṭhi, vicikicchā, sīlabbataparāmāso, apāyagamanīyo rāgo, apāyagamanīyo doso, apāyagamanīyo moho.","an6.90:1.4":"Ime kho, bhikkhave, cha dhammā diṭṭhisampannassa puggalassa pahīnā”ti.","an6.90:1.5":"Chaṭṭhaṃ."},"unsure":[],"preface":[],"attha":null,"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":780,"to":784,"paras":[{"para":780,"vripara":"86-95","refs":["an6.90:1"],"lines":["86-95. Dutiye <b>acchandiko</b>ti kattukamyatākusalacchandarahito.","Uttarakurukā manussā acchandikaṭṭhānaṃ paviṭṭhā.","<b>Duppañño</b>ti bhavaṅgapaññāya parihīno.","Bhavaṅgapaññāya pana paripuṇṇāyapi yassa bhavaṅgaṃ lokuttarassa paccayo na hoti, sopi duppañño eva nāma.","<b>Abhabbo niyāmaṃ okkamituṃ kusalesu dhammesu sammattan</b>ti kusalesu dhammesu sammattaniyāmasaṅkhātaṃ ariyamaggaṃ okkamituṃ adhigantuṃ abhabbo.","<b>Na kammāvaraṇatāyā</b>tiādīsu abhabbavipariyāyena attho veditabbo.","Catutthādīni uttānatthāni."],"lineRefs":[["an6.90:1"],["an6.90:1"],["an6.90:1"],["an6.90:1"],["an6.90:1"],["an6.90:1"],["an6.90:1"]]},{"para":781,"vripara":null,"refs":["an6.90:1"],"lines":["Āvaraṇasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an6.90:1"]]},{"para":782,"vripara":null,"refs":["an6.90:1"],"lines":["Sītivaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an6.90:1"]]},{"para":783,"vripara":null,"refs":["an6.90:1"],"lines":["Ānisaṃsavaggo"],"lineRefs":[["an6.90:1"]]},{"para":784,"vripara":null,"refs":["an6.90:1"],"lines":["1-11. Pātubhāvasuttādivaṇṇanā"],"lineRefs":[["an6.90:1"]]}],"wordLinks":[]},"tika2":null}
