{"suttaId":"ja294","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2242,2251],"vripara":"130"},"segments":{"ja294:0.4":"Jambukhādakajātakaṃ (3-5-4)","ja294:1.1":"Koyaṃ bindussaro vaggu, saravantāna [pavadantāna (sī. pī.)] muttamo;","ja294:1.3":"Accuto jambusākhāya, moracchāpova kūjati.","ja294:2.1":"Kulaputtova jānāti [kulaputto pajānāti (syā. ka.)], kulaputtaṃ [kulaputte (sī. pī.)] pasaṃsituṃ;","ja294:2.3":"Byagghacchāpasarīvaṇṇa, bhuñja samma dadāmi te.","ja294:3.1":"Cirassaṃ vata passāmi, musāvādī samāgate;","ja294:3.3":"Vantādaṃ kuṇapādañca, aññamaññaṃ pasaṃsaketi.","ja294:4.1":"Jambukhādakajātakaṃ catutthaṃ."},"attha":null,"tika":null}
