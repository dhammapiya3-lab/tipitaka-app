{"suttaId":"ja294","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2242,2251],"vripara":"130"},"segments":{"ja294:0.4":"Jambukhādakajātakaṃ (3-5-4)","ja294:1.1":"Koyaṃ bindussaro vaggu, saravantāna [pavadantāna (sī. pī.)] muttamo;","ja294:1.3":"Accuto jambusākhāya, moracchāpova kūjati.","ja294:2.1":"Kulaputtova jānāti [kulaputto pajānāti (syā. ka.)], kulaputtaṃ [kulaputte (sī. pī.)] pasaṃsituṃ;","ja294:2.3":"Byagghacchāpasarīvaṇṇa, bhuñja samma dadāmi te.","ja294:3.1":"Cirassaṃ vata passāmi, musāvādī samāgate;","ja294:3.3":"Vantādaṃ kuṇapādañca, aññamaññaṃ pasaṃsaketi.","ja294:4.1":"Jambukhādakajātakaṃ catutthaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":2854,"to":2864,"paras":[{"para":2854,"vripara":null,"refs":["ja294:1"],"lines":["Tattha <b>bindussaro</b>ti bindunā avisārena piṇḍitena sarena samannāgato.","<b>Vaggū</b>ti madhurasaddo.","<b>Accuto</b>ti na cuto sannisinno.","<b>Moracchāpova kūjatī</b>ti taruṇamorova manāpena saddena “ko nāmeso kūjatī”ti vadati."],"lineRefs":[["ja294:1"],["ja294:1"],["ja294:1"],["ja294:1"]]},{"para":2855,"vripara":null,"refs":[],"lines":["Atha naṃ kāko paṭipasaṃsanto dutiyaṃ gāthamāha –"],"lineRefs":[[]]},{"para":2857,"vripara":"131","refs":[],"lines":["“Kulaputtova jānāti, kulaputtaṃ pasaṃsituṃ;"],"lineRefs":[[]]},{"para":2858,"vripara":null,"refs":[],"lines":["Byagghacchāpasarīvaṇṇa, bhuñja samma dadāmi te”ti."],"lineRefs":[[]]},{"para":2859,"vripara":null,"refs":["ja294:2"],"lines":["Tattha <b>byagghacchāpasarīvaṇṇā</b>ti tvaṃ amhākaṃ byagghapotakasamānavaṇṇova khāyasi, tena taṃ vadāmi ambho byagghacchāpasarīvaṇṇa.","<b>Bhuñja, samma, dadāmi te</b>ti vayassa yāvadatthaṃ jambupakkāni khāda, ahaṃ te dadāmīti."],"lineRefs":[["ja294:2"],["ja294:2"]]},{"para":2860,"vripara":null,"refs":[],"lines":["Evañca pana vatvā jambusākhaṃ cāletvā phalāni pātesi.","Atha tasmiṃ jamburukkhe adhivatthā devatā te ubhopi abhūtaguṇakathaṃ kathetvā jambūni khādante disvā tatiyaṃ gāthamāha –"],"lineRefs":[[],[]]},{"para":2862,"vripara":"132","refs":[],"lines":["“Cirassaṃ vata passāmi, musāvādī samāgate;"],"lineRefs":[[]]},{"para":2863,"vripara":null,"refs":[],"lines":["Vantādaṃ kuṇapādañca, aññamaññaṃ pasaṃsake”ti."],"lineRefs":[[]]},{"para":2864,"vripara":null,"refs":["ja294:3"],"lines":["Tattha <b>vantādan</b>ti paresaṃ vantabhattakhādakaṃ kākaṃ.","<b>Kuṇapādañcā</b>ti kuṇapakhādakaṃ siṅgālañca."],"lineRefs":[["ja294:3"],["ja294:3"]]}],"wordLinks":[["ja294:1.1","bindussaro",0,0],["ja294:1.1","vaggū",0,1],["ja294:1.3","accuto",0,2],["ja294:1.3","moracchāpova kūjatī",0,3],["ja294:2.3","byagghacchāpasarīvaṇṇā",4,0],["ja294:2.3","bhuñja samma dadāmi te",4,1],["ja294:3.3","vantādaṃ",8,0],["ja294:3.3","kuṇapādañcā",8,1]]},"tika":null}
