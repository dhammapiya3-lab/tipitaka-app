{"suttaId":"sn2.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[907,912],"vripara":"84"},"segments":{"sn2.3:0.3":"Māghasuttaṃ","sn2.3:1.1":"Sāvatthinidānaṃ.","sn2.3:1.2":"Atha kho māgho devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ jetavanaṃ obhāsetvā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi.","sn2.3:1.3":"Ekamantaṃ ṭhito kho māgho devaputto bhagavantaṃ gāthāya ajjhabhāsi –","sn2.3:2.1":"“Kiṃsu chetvā sukhaṃ seti,","sn2.3:2.2":"kiṃsu chetvā na socati;","sn2.3:2.3":"Kissassu ekadhammassa,","sn2.3:2.4":"vadhaṃ rocesi gotamā”ti.","sn2.3:3.1":"“Kodhaṃ chetvā sukhaṃ seti,","sn2.3:3.2":"kodhaṃ chetvā na socati;","sn2.3:3.3":"Kodhassa visamūlassa,","sn2.3:3.4":"madhuraggassa vatrabhū;","sn2.3:3.5":"Vadhaṃ ariyā pasaṃsanti,","sn2.3:3.6":"tañhi chetvā na socatī”ti."},"unsure":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":513,"to":513,"paras":[{"para":513,"vripara":"84","refs":["sn2.3:1","sn2.3:3"],"lines":["Tatiye <b>māgho</b>ti sakkassetaṃ nāmaṃ.","Sveva vattena aññe abhibhavitvā devissariyaṃ pattoti <b>vatrabhū,</b> vatranāmakaṃ vā asuraṃ abhibhavatīti vatrabhū.","Tatiyaṃ."],"lineRefs":[["sn2.3:1"],["sn2.3:3"],["sn2.3:3"]]}],"wordLinks":[["sn2.3:1.2","māgho",0,0],["sn2.3:1.3","māgho",0,0],["sn2.3:3.3","vatrabhū",0,1]],"before":[{"para":512,"vripara":null,"refs":[],"lines":["3-4. Māghasuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":642,"to":644,"paras":[{"para":642,"vripara":"84","refs":["sn2.3:1"],"lines":["<b>Magho</b>ti sakkassetaṃ nāmaṃ purimajātianugataṃ.","<b>Svevā</b>ti sakko eva.","<b>Vatenā</b>ti mātāpituupaṭṭhānādicārittadhammena.","<b>Aññe</b>ti upadhivepakkapāpadhamme abhibhavitvā.","<b>Asuran</b>ti indasattubhūtaṃ asuraṃ."],"lineRefs":[["sn2.3:1"],["sn2.3:1"],["sn2.3:1"],["sn2.3:1"],["sn2.3:1"]]},{"para":643,"vripara":null,"refs":["sn2.3:1"],"lines":["Maghasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn2.3:1"]]},{"para":644,"vripara":null,"refs":["sn2.3:1"],"lines":["Māgadhasuttavaṇṇanā"],"lineRefs":[["sn2.3:1"]]}],"wordLinks":[],"before":[{"para":640,"vripara":null,"refs":[],"lines":["Dutiyakassapasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":641,"vripara":null,"refs":[],"lines":["Maghasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
