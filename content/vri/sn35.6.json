{"suttaId":"sn35.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[18,18],"vripara":"6"},"segments":{"sn35.6:0.3":"Bāhirānattasuttaṃ","sn35.6:1.1":"“Rūpā, bhikkhave, anattā.","sn35.6:1.2":"Yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.6:1.3":"Saddā …","sn35.6:1.4":"gandhā …","sn35.6:1.5":"rasā …","sn35.6:1.6":"phoṭṭhabbā …","sn35.6:1.7":"dhammā anattā.","sn35.6:1.8":"Yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.6:1.9":"Evaṃ passaṃ … pe …","sn35.6:1.10":"nāparaṃ itthattāyāti pajānātī”ti.","sn35.6:1.11":"Chaṭṭhaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":13,"to":14,"paras":[{"para":13,"vripara":"4-6","refs":["sn35.6:1"],"lines":["4-6. Catutthe <b>rūpagandharasaphoṭṭhabbā</b> catusamuṭṭhānā, <b>saddo</b> dvisamuṭṭhāno, <b>dhammā</b>ti tebhūmakadhammārammaṇaṃ.","Idampi bāhiresu chasu āyatanesu tilakkhaṇaṃ dassetvā kathite bujjhanakānaṃ vasena vuttaṃ.","Pañcame chaṭṭhe ca dutiyatatiyesu vuttasadisova nayo."],"lineRefs":[["sn35.6:1"],["sn35.6:1"],["sn35.6:1"]]},{"para":14,"vripara":null,"refs":["sn35.6:1"],"lines":["7-12. Ajjhattāniccātītānāgatasuttādivaṇṇanā"],"lineRefs":[["sn35.6:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":15,"to":17,"paras":[{"para":15,"vripara":"4-6","refs":["sn35.6:1"],"lines":["4-6. <b>Vuttasadisovā</b>ti “dve lakkhaṇānī”tiādinā vuttasadiso eva.","<b>Nayo</b>ti atidesanayo."],"lineRefs":[["sn35.6:1"],["sn35.6:1"]]},{"para":16,"vripara":null,"refs":["sn35.6:1"],"lines":["Bāhirāniccasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.6:1"]]},{"para":17,"vripara":null,"refs":["sn35.6:1"],"lines":["7-12. Ajjhattāniccātītānāgatasuttādivaṇṇanā"],"lineRefs":[["sn35.6:1"]]}],"wordLinks":[]},"tika2":null}
