{"suttaId":"tha-ap239","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8063,8072],"vripara":"27"},"segments":{"tha-ap239:0.3":"Piyālapupphiyattheraapadānaṃ","tha-ap239:1.1":"“Migaluddo pure āsiṃ,","tha-ap239:1.2":"araññe kānane ahaṃ;","tha-ap239:1.3":"Piyālaṃ pupphitaṃ disvā,","tha-ap239:1.4":"gatamagge khipiṃ ahaṃ.","tha-ap239:2.1":"“Ekanavutito kappe,","tha-ap239:2.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap239:2.3":"Duggatiṃ nābhijānāmi,","tha-ap239:2.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap239:3.1":"“Paṭisambhidā catasso … pe …","tha-ap239:3.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap239:4.1":"Itthaṃ sudaṃ āyasmā piyālapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap239:5.1":"Piyālapupphiyattherassāpadānaṃ sattamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3191,"to":3191,"paras":[{"para":3191,"vripara":"27","refs":["tha-ap239:1"],"lines":["Sattamāpadāne <b>piyālaṃ pupphitaṃ disvā</b>ti supupphitaṃ piyālarukkhaṃ disvā.","<b>Gatamagge khipiṃ ahan</b>ti ahaṃ <b>migaluddo</b> nesādo hutvā piyālapupphaṃ ocinitvā buddhassa gatamagge khipiṃ pūjesinti attho."],"lineRefs":[["tha-ap239:1"],["tha-ap239:1"]]}],"wordLinks":[["tha-ap239:1.3","piyālaṃ pupphitaṃ disvā",0,0],["tha-ap239:1.1","migaluddo",0,1],["tha-ap239:1.3","gatamagge khipiṃ ahaṃ",0,1]]},"tika":null,"tika2":null}
