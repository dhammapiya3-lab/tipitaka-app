{"suttaId":"tha-ap77","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4558,4570],"vripara":"18"},"segments":{"tha-ap77:0.3":"Ekasaññakattheraapadānaṃ","tha-ap77:1.1":"“Khaṇḍo nāmāsi nāmena, vipassissaggasāvako;","tha-ap77:1.3":"Ekā bhikkhā mayā dinnā, lokāhutipaṭiggahe.","tha-ap77:2.1":"“Tena cittappasādena, dvipadinda narāsabha;","tha-ap77:2.3":"Duggatiṃ nābhijānāmi, ekabhikkhāyidaṃ phalaṃ.","tha-ap77:3.1":"“Cattālīsamhito kappe, varuṇo nāma khattiyo;","tha-ap77:3.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap77:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap77:5.1":"Itthaṃ sudaṃ āyasmā ekasaññako thero imā gāthāyo abhāsitthāti.","tha-ap77:6.1":"Ekasaññakattherassāpadānaṃ pañcamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2680,"to":2680,"paras":[{"para":2680,"vripara":"18","refs":["tha-ap77:1"],"lines":["So aparabhāge attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>khaṇḍo nāmāsi nāmenā</b>tiādimāha.","Tattha tassa aggasāvakattherassa kilesānaṃ khaṇḍitattā <b>khaṇḍo</b>ti nāmaṃ.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["tha-ap77:1"],["tha-ap77:1"],["tha-ap77:1"]]}],"wordLinks":[["tha-ap77:1.1","khaṇḍo nāmāsi nāmenā",0,0],["tha-ap77:1.1","khaṇḍo",0,1]]},"tika":null,"tika2":null}
