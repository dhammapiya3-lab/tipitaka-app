{"suttaId":"sn35.67","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[226,226],"vripara":"67"},"segments":{"sn35.67:0.3":"Samiddhidukkhapañhāsuttaṃ","sn35.67:1.1":"“‘Dukkhaṃ, dukkhan’ti, bhante, vuccati.","sn35.67:1.2":"Kittāvatā nu kho, bhante, dukkhaṃ vā assa dukkhapaññatti vā”ti … pe ….","sn35.67:1.3":"Pañcamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":81,"to":82,"paras":[{"para":81,"vripara":"65-67","refs":["sn35.67:1"],"lines":["65-67. Tatiye <b>samiddhī</b>ti attabhāvassa samiddhatāya evaṃ laddhanāmo.","Tassa kira therassa attabhāvo abhirūpo ahosi pāsādiko, ukkhittamālāpuṭo viya alaṅkatamālāgabbho viya ca sabbākārapāripūriyā samiddho.","Tasmā samiddhitveva saṅkhaṃ gato.","<b>Māro</b>ti maraṇaṃ pucchati.","<b>Mārapaññattī</b>ti māroti paññatti nāmaṃ nāmadheyyaṃ.","<b>Atthi tattha māro vā mārapaññatti vā</b>ti tattha maraṇaṃ vā maraṇanti idaṃ nāmaṃ vā atthīti dasseti.","Catutthaṃ uttānameva, tathā pañcamaṃ."],"lineRefs":[["sn35.67:1"],["sn35.67:1"],["sn35.67:1"],["sn35.67:1"],["sn35.67:1"],["sn35.67:1"],["sn35.67:1"]]},{"para":82,"vripara":null,"refs":["sn35.67:1"],"lines":["Samiddhilokapañhāsuttavaṇṇanā"],"lineRefs":[["sn35.67:1"]]}],"wordLinks":[]},"tika":null,"tika2":null}
