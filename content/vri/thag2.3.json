{"suttaId":"thag2.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[722,728],"vripara":"125"},"segments":{"thag2.3:0.4":"Valliyattheragāthā","thag2.3:1.1":"“Makkaṭo pañcadvārāyaṃ, kuṭikāyaṃ pasakkiya;","thag2.3:1.3":"Dvārena anupariyeti, ghaṭṭayanto muhuṃ muhuṃ.","thag2.3:2.1":"“Tiṭṭha makkaṭa mā dhāvi, na hi te taṃ yathā pure;","thag2.3:2.3":"Niggahītosi paññāya, neva dūraṃ gamissatī”ti.","thag2.3:2.5":"… Valliyo thero …."},"attha":null,"tika":null}
