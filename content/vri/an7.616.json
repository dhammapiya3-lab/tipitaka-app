{"suttaId":"an7.616","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[784,784],"vripara":"623"},"segments":{"an7.616:0.3":"Rāgapeyyālaṃ","an7.616:1.1":"“Rāgassa, bhikkhave, abhiññāya satta dhammā bhāvetabbā.","an7.616:1.2":"Katame satta?","an7.616:1.3":"Satisambojjhaṅgo … pe … upekkhāsambojjhaṅgo – rāgassa, bhikkhave, abhiññāya ime satta dhammā bhāvetabbā”ti."},"unsure":["an7.616:1.3"],"preface":[],"attha":null,"tika":null,"tika2":null}
