{"suttaId":"sn1.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[135,138],"vripara":"18"},"segments":{"sn1.18:0.3":"Hirīsuttaṃ","sn1.18:1.1":"“Hirīnisedho puriso,","sn1.18:1.2":"koci lokasmiṃ vijjati.","sn1.18:1.3":"Yo nindaṃ apabodhati [apabodheti (syā. kaṃ. ka.)],","sn1.18:1.4":"asso bhadro kasāmivā”ti.","sn1.18:2.1":"“Hirīnisedhā tanuyā,","sn1.18:2.2":"ye caranti sadā satā;","sn1.18:2.3":"Antaṃ dukkhassa pappuyya,","sn1.18:2.4":"caranti visame sama”nti. 9."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":200,"to":200,"paras":[{"para":200,"vripara":"18","refs":["sn1.18:1","sn1.18:2"],"lines":["Aṭṭhame <b>hirīnisedho</b>ti hiriyā akusale dhamme nisedhetīti hirīnisedho.","<b>Koci lokasmiṃ</b> <b>vijjatī</b>ti koci evarūpo vijjatīti pucchati.","<b>Yo nindaṃ apabodhatī</b>ti yo garahaṃ apaharanto bujjhati.","<b>Asso bhadro kasāmivā</b>ti yathā bhadro assājānīyo kasaṃ apaharanto bujjhati, patodacchāyaṃ disvā saṃvijjhanto viya kasāya attani nipātaṃ na deti, evameva yo bhikkhu bhūtassa dasaakkosavatthuno attani nipātaṃ adadanto nindaṃ apabodhati apaharanto bujjhati, evarūpo koci khīṇāsavo vijjatīti pucchati.","Abhūtakkosena pana parimutto nāma natthi.","<b>Tanuyā</b>ti tanukā, hiriyā akusale dhamme nisedhetvā carantā khīṇāsavā nāma appakāti attho.","<b>Sadā satā</b>ti niccakālaṃ sativepullena samannāgatā.","<b>Antaṃ dukkhassa pappuyyā</b>ti vaṭṭadukkhassa koṭiṃ antabhūtaṃ nibbānaṃ pāpuṇitvā.","Sesaṃ vuttanayamevāti."],"lineRefs":[["sn1.18:1"],["sn1.18:1"],["sn1.18:1"],["sn1.18:1"],["sn1.18:1"],["sn1.18:2"],["sn1.18:2"],["sn1.18:2"],["sn1.18:2"]]}],"wordLinks":[["sn1.18:1.1","hirīnisedho",0,0],["sn1.18:1.1","koci lokasmiṃ vijjatī",0,1],["sn1.18:1.3","yo nindaṃ apabodhatī",0,2],["sn1.18:1.3","asso bhadro kasāmivā",0,3],["sn1.18:2.1","tanuyā",0,5],["sn1.18:2.1","sadā satā",0,6],["sn1.18:2.3","antaṃ dukkhassa pappuyyā",0,7]],"before":[{"para":199,"vripara":null,"title":"Hirīsuttavaṇṇanā","lines":["Hirīsuttavaṇṇanā 18."]}],"after":[{"para":201,"vripara":null,"title":"Hirīsuttavaṇṇanā","lines":["Hirīsuttavaṇṇanā niṭṭhitā. 9."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":314,"to":314,"paras":[{"para":314,"vripara":null,"refs":["sn1.18:2"],"lines":["<b>Tanuyā</b>ti vā katipayā.","Tenāha <b>“appakā”</b>ti.","<b>Sadā satā</b>ti hirinisedhabhāve kāraṇavacanaṃ.","<b>Pappuyyā</b>ti patvā adhigantvā.","Vānato nikkhantattā <b>nibbānaṃ,</b> asaṅkhatadhātu."],"lineRefs":[["sn1.18:2"],["sn1.18:2"],["sn1.18:2"],["sn1.18:2"],["sn1.18:2"]]}],"wordLinks":[["sn1.18:2.1","tanuyā",0,0],["sn1.18:2.1","sadā satā",0,2],["sn1.18:2.3","pappuyyā",0,3]],"before":[{"para":310,"vripara":null,"title":"Hirīsuttavaṇṇanā","lines":["Hirīsuttavaṇṇanā 18."]},{"para":311,"vripara":"18","title":"Hirīsuttavaṇṇanā","lines":["<b>Nisedhetī</b>ti nivāreti pavattituṃ na deti.","<b>Pucchati</b> devatā.","<b>Apaharanto</b>ti apanento, yathā sabbena sabbaṃ akkosavatthu na hoti, evaṃ pariharantoti attho.","<b>Bujjhati</b> sārathividhaṃ.","<b>Attani nipātaṃ na deti,</b> ājānīyo hi yuttaṃ pajānāti.","Abhūtena <b>abhūtakkosena parimutto nāma natthi</b> bālānañca janānaṃ parāpavāde yuttapayuttabhāvato.","Tenāha bhagavā –"]},{"para":312,"vripara":null,"title":"Hirīsuttavaṇṇanā","lines":["“Nindanti tuṇhimāsīnaṃ, nindanti bahubhāṇinaṃ;"]},{"para":313,"vripara":null,"title":"Hirīsuttavaṇṇanā","lines":["Mitabhāṇimpi nindanti, natthi loke anindito”ti. (dha. pa. 227);"]}],"after":[{"para":315,"vripara":null,"title":"Hirīsuttavaṇṇanā","lines":["Hirīsuttavaṇṇanā niṭṭhitā. 9."]}]},"tika2":null}
