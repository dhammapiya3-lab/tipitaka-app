{"suttaId":"an3.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[80,81],"vripara":"17"},"segments":{"an3.17:0.3":"Attabyābādhasuttaṃ","an3.17:1.1":"“Tayome, bhikkhave, dhammā attabyābādhāyapi saṃvattanti, parabyābādhāyapi saṃvattanti, ubhayabyābādhāyapi saṃvattanti.","an3.17:1.2":"Katame tayo?","an3.17:1.3":"Kāyaduccaritaṃ, vacīduccaritaṃ, manoduccaritaṃ.","an3.17:1.4":"Ime kho, bhikkhave, tayo dhammā attabyābādhāyapi saṃvattanti, parabyābādhāyapi saṃvattanti, ubhayabyābādhāyapi saṃvattanti.","an3.17:2.1":"“Tayome, bhikkhave, dhammā nevattabyābādhāyapi saṃvattanti, na parabyābādhāyapi saṃvattanti, na ubhayabyābādhāyapi saṃvattanti.","an3.17:2.2":"Katame tayo?","an3.17:2.3":"Kāyasucaritaṃ, vacīsucaritaṃ, manosucaritaṃ.","an3.17:2.4":"Ime kho, bhikkhave, tayo dhammā nevattabyābādhāyapi saṃvattanti, na parabyābādhāyapi saṃvattanti, na ubhayabyābādhāyapi saṃvattantī”ti.","an3.17:2.5":"Sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":395,"to":395,"paras":[{"para":395,"vripara":"17","refs":["an3.17:1","an3.17:2"],"lines":["Sattame <b>attabyābādhāyā</b>ti attadukkhāya.","<b>Parabyābādhāyā</b>ti paradukkhāya.","<b>Kāyasucarita</b>ntiādīni pubbabhāge dasakusalakammapathavasena āgatāni, upari pana yāva arahattā avāritāneva. 8."],"lineRefs":[["an3.17:1"],["an3.17:1"],["an3.17:2"]]}],"wordLinks":[["an3.17:1.1","attabyābādhāyā",0,0],["an3.17:1.4","attabyābādhāyā",0,0],["an3.17:1.1","parabyābādhāyā",0,1],["an3.17:1.4","parabyābādhāyā",0,1],["an3.17:2.3","kāyasucaritaṃ",0,2]],"before":[{"para":394,"vripara":null,"title":"Attabyābādhasuttavaṇṇanā","lines":["Attabyābādhasuttavaṇṇanā 17."]}]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":392,"to":394,"paras":[{"para":392,"vripara":"17","refs":["an3.17:1"],"lines":["Sattame byābādhanaṃ dukkhāpananti āha <b>“attabyābādhāyāti attadukkhāyā”</b>ti.","Maggaphalacittuppādāpi kāyasucaritādisaṅgaho evāti āha <b>“avāritānevā”</b>ti."],"lineRefs":[["an3.17:1"],["an3.17:1"]]},{"para":393,"vripara":null,"refs":["an3.17:1"],"lines":["Attabyābādhasuttavaṇṇanā niṭṭhitā. 8."],"lineRefs":[["an3.17:1"]]},{"para":394,"vripara":null,"refs":["an3.17:1"],"lines":["Devalokasuttavaṇṇanā 18."],"lineRefs":[["an3.17:1"]]}],"wordLinks":[],"before":[{"para":391,"vripara":null,"title":"Attabyābādhasuttavaṇṇanā","lines":["Attabyābādhasuttavaṇṇanā 17."]}]},"tika2":null}
