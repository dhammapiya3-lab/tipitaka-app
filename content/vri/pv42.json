{"suttaId":"pv42","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[2440,2479],"vripara":"753"},"segments":{"pv42:0.3":"Rājaputtapetavatthu","pv42:1.1":"Pubbe katānaṃ kammānaṃ,","pv42:1.2":"vipāko mathaye manaṃ;","pv42:1.3":"Rūpe sadde rase gandhe,","pv42:1.4":"phoṭṭhabbe ca manorame.","pv42:2.1":"Naccaṃ gītaṃ ratiṃ khiḍḍaṃ,","pv42:2.2":"anubhutvā anappakaṃ;","pv42:2.3":"Uyyāne paricaritvā,","pv42:2.4":"pavisanto giribbajaṃ.","pv42:3.1":"Isiṃ sunetta [sunita (ka.)] maddakkhi,","pv42:3.2":"attadantaṃ samāhitaṃ;","pv42:3.3":"Appicchaṃ hirisampannaṃ,","pv42:3.4":"uñche pattagate rataṃ.","pv42:4.1":"Hatthikkhandhato oruyha,","pv42:4.2":"laddhā bhanteti cābravi;","pv42:4.3":"Tassa pattaṃ gahetvāna,","pv42:4.4":"uccaṃ paggayha khattiyo.","pv42:5.1":"Thaṇḍile pattaṃ bhinditvā,","pv42:5.2":"hasamāno apakkami;","pv42:5.3":"“Rañño kitavassāhaṃ putto,","pv42:5.4":"kiṃ maṃ bhikkhu karissasi”.","pv42:6.1":"Tassa kammassa pharusassa,","pv42:6.2":"vipāko kaṭuko ahu;","pv42:6.3":"Yaṃ rājaputto vedesi,","pv42:6.4":"nirayamhi samappito.","pv42:7.1":"Chaḷeva caturāsīti,","pv42:7.2":"vassāni navutāni ca;","pv42:7.3":"Bhusaṃ dukkhaṃ nigacchittho,","pv42:7.4":"niraye katakibbiso.","pv42:8.1":"Uttānopi ca paccittha,","pv42:8.2":"nikujjo vāmadakkhiṇo;","pv42:8.3":"Uddhaṃpādo ṭhito ceva,","pv42:8.4":"ciraṃ bālo apaccatha.","pv42:9.1":"Bahūni vassasahassāni,","pv42:9.2":"pūgāni nahutāni ca;","pv42:9.3":"Bhusaṃ dukkhaṃ nigacchittho,","pv42:9.4":"niraye katakibbiso.","pv42:10.1":"Etādisaṃ kho kaṭukaṃ,","pv42:10.2":"appaduṭṭhappadosinaṃ;","pv42:10.3":"Paccanti pāpakammantā,","pv42:10.4":"isimāsajja subbataṃ.","pv42:11.1":"So tattha bahuvassāni,","pv42:11.2":"vedayitvā bahuṃ dukhaṃ;","pv42:11.3":"Khuppipāsahato nāma [khuppipāsāhato nāma (sī. pī)],","pv42:11.4":"peto āsi tato cuto.","pv42:12.1":"Etamādīnavaṃ ñatvā [disvā (sī.)],","pv42:12.2":"issaramadasambhavaṃ;","pv42:12.3":"Pahāya issaramadaṃ,","pv42:12.4":"nivātamanuvattaye.","pv42:13.1":"Diṭṭheva dhamme pāsaṃso,","pv42:13.2":"yo buddhesu sagāravo;","pv42:13.3":"Kāyassa bhedā sappañño,","pv42:13.4":"saggaṃ so upapajjatīti.","pv42:14.1":"Rājaputtapetavatthu sattamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":2967,"to":2981,"paras":[{"para":2967,"vripara":"753","refs":["pv42:1"],"lines":["Tattha <b>pubbe katānaṃ kammānaṃ, vipāko mathaye manan</b>ti purimāsu jātīsu katānaṃ akusalakammānaṃ phalaṃ uḷāraṃ hutvā uppajjamānaṃ andhabālānaṃ cittaṃ mathayeyya abhibhaveyya, paresaṃ anatthakaraṇamukhena attano atthaṃ uppādeyyāti adhippāyo."],"lineRefs":[["pv42:1"]]},{"para":2968,"vripara":null,"refs":["pv42:1"],"lines":["Idāni taṃ cittamathanaṃ visayena saddhiṃ dassetuṃ <b>“rūpe sadde”</b>tiādi vuttaṃ.","Tattha <b>rūpe</b>ti rūpahetu, yathicchitassa manāpiyassa rūpārammaṇassa paṭilābhanimittanti attho.","<b>Sadde</b>tiādīsupi eseva nayo."],"lineRefs":[["pv42:1"],["pv42:1"],["pv42:1"]]},{"para":2969,"vripara":"754","refs":["pv42:2"],"lines":["Evaṃ sādhāraṇato vuttamatthaṃ asādhāraṇato niyametvā dassento <b>“naccaṃ gītan”</b>tiādimāha.","Tattha <b>ratin</b>ti kāmaratiṃ.","<b>Khiḍḍan</b>ti sahāyakādīhi keḷiṃ.","<b>Giribbajan</b>ti rājagahaṃ."],"lineRefs":[["pv42:2"],["pv42:2"],["pv42:2"],["pv42:2"]]},{"para":2970,"vripara":"755","refs":["pv42:3"],"lines":["<b>Isin</b>ti asekkhānaṃ sīlakkhandhādīnaṃ esanaṭṭhena isiṃ.","<b>Sunettan</b>ti evaṃnāmakaṃ paccekabuddhaṃ.","<b>Attadantan</b>ti uttamena damathena damitacittaṃ.","<b>Samāhitan</b>ti arahattaphalasamādhinā samāhitaṃ.","<b>Uñche pattagate ratan</b>ti uñchena bhikkhācārena laddhe pattagate pattapariyāpanne āhāre rataṃ santuṭṭhaṃ."],"lineRefs":[["pv42:3"],["pv42:3"],["pv42:3"],["pv42:3"],["pv42:3"]]},{"para":2971,"vripara":"756","refs":["pv42:4"],"lines":["<b>Laddhā, bhanteti cābravī</b>ti “api, bhante, bhikkhā laddhā”ti vissāsajananatthaṃ kathesi.","<b>Uccaṃ paggayhā</b>ti uccataraṃ katvā pattaṃ ukkhipitvā."],"lineRefs":[["pv42:4"],["pv42:4"]]},{"para":2972,"vripara":"757","refs":["pv42:5"],"lines":["<b>Thaṇḍile pattaṃ bhinditvā</b>ti kharakaṭhine bhūmippadese khipanto pattaṃ bhinditvā.","<b>Apakkamī</b>ti thokaṃ apasakki.","Apasakkanto ca “akāraṇeneva andhabālo mahantaṃ anatthaṃ attano akāsī”ti karuṇāyanavasena olokentaṃ paccekabuddhaṃ rājaputto āha <b>“rañño kitavassāhaṃ putto, kiṃ maṃ bhikkhu karissasī”</b>ti."],"lineRefs":[["pv42:5"],["pv42:5"],["pv42:5"]]},{"para":2973,"vripara":"758","refs":["pv42:6"],"lines":["<b>Pharusassā</b>ti dāruṇassa.","<b>Kaṭuko</b>ti aniṭṭho.","<b>Yan</b>ti yaṃ vipākaṃ.","<b>Samappito</b>ti allīno."],"lineRefs":[["pv42:6"],["pv42:6"],["pv42:6"],["pv42:6"]]},{"para":2974,"vripara":"759","refs":["pv42:6"],"lines":["<b>Chaḷeva caturāsīti, vassāni nahutāni cā</b>ti uttāno nipanno caturāsītivassasahassāni, nikujjo, vāmapassena, dakkhiṇapassena, uddhaṃpādo, olambiko, yathāṭhito cāti evaṃ cha caturāsītisahassāni vassāni honti.","Tenāha –"],"lineRefs":[["pv42:6"],["pv42:6"]]},{"para":2976,"vripara":"760","refs":["pv42:6"],"lines":["“Uttānopi ca paccittha, nikujjo vāmadakkhiṇo;"],"lineRefs":[["pv42:6"]]},{"para":2977,"vripara":null,"refs":["pv42:6"],"lines":["Uddhaṃpādo ṭhito ceva, ciraṃ bālo apaccathā”ti."],"lineRefs":[["pv42:6"]]},{"para":2978,"vripara":null,"refs":["pv42:6"],"lines":["Tāni pana vassāni yasmā anekāni nahutāni honti, tasmā vuttaṃ <b>“nahutānī”</b>ti.","<b>Bhusaṃ dukkhaṃ nigacchittho</b>ti ativiya dukkhaṃ pāpuṇi."],"lineRefs":[["pv42:6"],["pv42:6"]]},{"para":2979,"vripara":"761","refs":["pv42:9"],"lines":["<b>Pūgānī</b>ti vassasamūhe, idha purimagāthāya ca accantasaṃyoge upayogavacanaṃ daṭṭhabbaṃ."],"lineRefs":[["pv42:9"]]},{"para":2980,"vripara":"762","refs":["pv42:10"],"lines":["<b>Etādisan</b>ti evarūpaṃ.","<b>Kaṭukan</b>ti atidukkhaṃ, bhāvanapaṃsakaniddesoyaṃ “ekamantaṃ nisīdī”tiādīsu viya.","Appaduṭṭhappadosinaṃ isiṃ subbataṃ āsajja āsādetvā pāpakammantā puggalā evarūpaṃ kaṭukaṃ ativiya dukkhaṃ paccantīti yojanā."],"lineRefs":[["pv42:10"],["pv42:10"],["pv42:10"]]},{"para":2981,"vripara":"763","refs":["pv42:11"],"lines":["<b>So</b>ti so rājaputtapeto.","<b>Tatthā</b>ti niraye.","<b>Vedayitvā</b>ti anubhavitvā.","<b>Nāmā</b>ti byattapākaṭabhāvena.","<b>Tato cuto</b>ti nirayato cuto.","Sesaṃ vuttanayameva."],"lineRefs":[["pv42:11"],["pv42:11"],["pv42:11"],["pv42:11"],["pv42:11"],["pv42:11"]]}],"wordLinks":[["pv42:1.1","pubbe katānaṃ kammānaṃ vipāko mathaye manaṃ",0,0],["pv42:1.3","rūpe sadde",1,0],["pv42:1.3","rūpe",1,1],["pv42:1.3","sadde",1,2],["pv42:2.1","naccaṃ gītaṃ",2,0],["pv42:2.1","ratiṃ",2,1],["pv42:2.1","khiḍḍaṃ",2,2],["pv42:2.3","giribbajaṃ",2,3],["pv42:3.1","isiṃ",3,0],["pv42:3.1","sunettaṃ",3,1],["pv42:3.1","attadantaṃ",3,2],["pv42:3.1","samāhitaṃ",3,3],["pv42:3.3","uñche pattagate rataṃ",3,4],["pv42:4.1","laddhā bhanteti cābravī",4,0],["pv42:4.3","uccaṃ paggayhā",4,1],["pv42:5.1","thaṇḍile pattaṃ bhinditvā",5,0],["pv42:5.1","apakkamī",5,1],["pv42:5.3","rañño kitavassāhaṃ putto kiṃ maṃ bhikkhu karissasī",5,2],["pv42:6.1","pharusassā",6,0],["pv42:6.1","kaṭuko",6,1],["pv42:6.3","yaṃ",6,2],["pv42:6.3","samappito",6,3],["pv42:9.1","pūgānī",11,0],["pv42:10.1","etādisaṃ",12,0],["pv42:10.1","kaṭukaṃ",12,1],["pv42:11.1","so",13,0],["pv42:11.1","tatthā",13,1],["pv42:11.1","vedayitvā",13,2],["pv42:11.3","nāmā",13,3],["pv42:11.3","tato cuto",13,4]],"before":[{"para":2925,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Rājaputtapetavatthuvaṇṇanā"]},{"para":2926,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["<b>Pubbe katānaṃ kammānan</b>ti idaṃ satthā jetavane viharanto rājaputtapetaṃ ārabbha kathesi.","Tattha yo so atīte kitavassa nāma rañño putto atīte paccekabuddhe aparajjhitvā bahūni vassasahassāni niraye paccitvā tasseva kammassa vipākāvasesena petesu uppanno.","So idha “rājaputtapeto”ti adhippeto.","Tassa vatthu heṭṭhā sāṇavāsipetavatthumhi vitthārato āgatameva, tasmā tattha vuttanayeneva gahetabbaṃ.","Satthā hi tadā therena attano ñātipetānaṃ pavattiyā kathitāya “na kevalaṃ tava ñātakāyeva, atha kho tvampi ito anantarātīte attabhāve peto hutvā mahādukkhaṃ anubhavī”ti vatvā tena yācito –"]},{"para":2928,"vripara":"753","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Pubbe katānaṃ kammānaṃ, vipāko mathaye manaṃ;"]},{"para":2929,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Rūpe sadde rase gandhe, phoṭṭhabbe ca manorame."]},{"para":2931,"vripara":"754","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Iccaṃ gītaṃ ratiṃ khiḍḍaṃ, anubhutvā anappakaṃ;"]},{"para":2932,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Uyyāne paricaritvā, pavisanto giribbajaṃ."]},{"para":2934,"vripara":"755","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Isiṃ sunettamaddakkhi, attadantaṃ samāhitaṃ;"]},{"para":2935,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Appicchaṃ hirisampannaṃ, uñche pattagate rataṃ."]},{"para":2937,"vripara":"756","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Hatthikkhandhato oruyha, laddhā bhanteti cābravi;"]},{"para":2938,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Tassa pattaṃ gahetvāna, uccaṃ paggayha khattiyo."]},{"para":2940,"vripara":"757","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Thaṇḍile pattaṃ bhinditvā, hasamāno apakkami;"]},{"para":2941,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Rañño kitavassāhaṃ putto, kiṃ maṃ bhikkhu karissasi."]},{"para":2943,"vripara":"758","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Tassa kammassa pharusassa, vipāko kaṭuko ahu;"]},{"para":2944,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Yaṃ rājaputto vedesi, nirayamhi samappito."]},{"para":2946,"vripara":"759","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Chaḷeva caturāsīti, vassāni nahutāni ca;"]},{"para":2947,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Bhusaṃ dukkhaṃ nigacchittho, niraye katakibbiso."]},{"para":2949,"vripara":"760","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Uttānopi ca paccittha, nikujjo vāmadakkhiṇo;"]},{"para":2950,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Uddhaṃpādo ṭhito ceva, ciraṃ bālo apaccatha."]},{"para":2952,"vripara":"761","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Bahūni vassasahassāni, pūgāni nahutāni ca;"]},{"para":2953,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Bhusaṃ dukkhaṃ nigacchittho, niraye katakibbiso."]},{"para":2955,"vripara":"762","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Etādisaṃ kho kaṭukaṃ, appaduṭṭhappadosinaṃ;"]},{"para":2956,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Paccanti pāpakammantā, isimāsajja subbataṃ."]},{"para":2958,"vripara":"763","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“So tattha bahuvassāni, vedayitvā bahuṃ dukhaṃ;"]},{"para":2959,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Khuppipāsahato nāma, peto āsi tato cuto."]},{"para":2961,"vripara":"764","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Etamādīnavaṃ ñatvā, issaramadasambhavaṃ;"]},{"para":2962,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Pahāya issaramadaṃ, nivātamanuvattaye."]},{"para":2964,"vripara":"765","title":"Rājaputtapetavatthuvaṇṇanā","lines":["“Diṭṭheva dhamme pāsaṃso, yo buddhesu sagāravo;"]},{"para":2965,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Kāyassa bhedā sappañño, saggaṃ so upapajjatī”ti.","–"]},{"para":2966,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Idaṃ petavatthuṃ kathesi."]}],"after":[{"para":2982,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Evaṃ bhagavā rājaputtapetakathāya tattha sannipatitaṃ mahājanaṃ saṃvejetvā upari saccāni pakāsesi.","Saccapariyosāne bahū sotāpattiphalādīni sampāpuṇiṃsūti."]},{"para":2983,"vripara":null,"title":"Rājaputtapetavatthuvaṇṇanā","lines":["Rājaputtapetavatthuvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
