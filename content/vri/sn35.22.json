{"suttaId":"sn35.22","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[64,70],"vripara":"22"},"segments":{"sn35.22:0.3":"Dutiyadukkhuppādasuttaṃ","sn35.22:1.1":"“Yo, bhikkhave, rūpānaṃ uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo.","sn35.22:1.2":"Yo saddānaṃ … pe …","sn35.22:1.3":"yo gandhānaṃ …","sn35.22:1.4":"yo rasānaṃ …","sn35.22:1.5":"yo phoṭṭhabbānaṃ …","sn35.22:1.6":"yo dhammānaṃ uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo.","sn35.22:2.1":"“Yo ca kho, bhikkhave, rūpānaṃ nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo.","sn35.22:2.2":"Yo saddānaṃ … pe …","sn35.22:2.3":"yo gandhānaṃ …","sn35.22:2.4":"yo rasānaṃ …","sn35.22:2.5":"yo phoṭṭhabbānaṃ …","sn35.22:2.6":"yo dhammānaṃ nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo”ti.","sn35.22:2.7":"Dasamaṃ.","sn35.22:2.8":"Yamakavaggo dutiyo.","sn35.22:3.0":"Tassuddānaṃ –","sn35.22:3.1":"Sambodhena duve vuttā,","sn35.22:3.2":"assādena apare duve;","sn35.22:3.3":"No cetena duve vuttā,","sn35.22:3.4":"abhinandena apare duve;","sn35.22:3.5":"Uppādena duve vuttā,","sn35.22:3.6":"vaggo tena pavuccatīti."},"unsure":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":23,"to":26,"paras":[{"para":23,"vripara":"19-22","refs":["sn35.22:1"],"lines":["19-22. Sattamādīsu catūsu vaṭṭavivaṭṭameva kathitaṃ.","Anupubbakathā pana nesaṃ heṭṭhā vuttanayeneva veditabbāti."],"lineRefs":[["sn35.22:1"],["sn35.22:1"]]},{"para":24,"vripara":null,"refs":["sn35.22:1"],"lines":["Yamakavaggo dutiyo."],"lineRefs":[["sn35.22:1"]]},{"para":25,"vripara":null,"refs":["sn35.22:1"],"lines":["Sabbavaggo"],"lineRefs":[["sn35.22:1"]]},{"para":26,"vripara":null,"refs":["sn35.22:1"],"lines":["Sabbasuttavaṇṇanā"],"lineRefs":[["sn35.22:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":29,"to":33,"paras":[{"para":29,"vripara":"19-22","refs":["sn35.22:1"],"lines":["19-22. <b>Vaṭṭavivaṭṭameva kathitaṃ</b> abhinandanānaṃ uppādanirodhānañca vasena desanāya pavattattā.","<b>Anupubbakathā</b>ti ādito paṭṭhāya padatthavaṇṇanā.","<b>Nesan</b>ti suttānaṃ."],"lineRefs":[["sn35.22:1"],["sn35.22:1"],["sn35.22:1"]]},{"para":30,"vripara":null,"refs":["sn35.22:1"],"lines":["Paṭhamābhinandasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.22:1"]]},{"para":31,"vripara":null,"refs":["sn35.22:1"],"lines":["Yamakavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.22:1"]]},{"para":32,"vripara":null,"refs":["sn35.22:1"],"lines":["Sabbavaggo"],"lineRefs":[["sn35.22:1"]]},{"para":33,"vripara":null,"refs":["sn35.22:1"],"lines":["Sabbasuttavaṇṇanā"],"lineRefs":[["sn35.22:1"]]}],"wordLinks":[]},"tika2":null}
