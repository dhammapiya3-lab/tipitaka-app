{"suttaId":"ja246","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1695,1701],"vripara":"192"},"segments":{"ja246:0.4":"Bālovādajātakaṃ (2-10-6)","ja246:1.1":"Hantvā chetvā [jhatvā (sī. pī.), ghatvā (syā.)] vadhitvā ca,","ja246:1.2":"deti dānaṃ asaññato;","ja246:1.3":"Edisaṃ bhattaṃ bhuñjamāno,","ja246:1.4":"sa pāpamupalimpati [sa pāpena upalippati (sī. pī.)]. 193.","ja246:2.1":"Puttadārampi ce hantvā,","ja246:2.2":"deti dānaṃ asaññato;","ja246:2.3":"Bhuñjamānopi sappañño,","ja246:2.4":"na pāpamupalimpatīti.","ja246:3.1":"Bālovādajātakaṃ chaṭṭhaṃ. 247."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1699,"to":1704,"paras":[{"para":1699,"vripara":null,"refs":["ja246:1"],"lines":["Tattha <b>hantvā</b>ti paharitvā.","<b>Chetvā</b>ti kilametvā.","<b>Vadhitvā</b>ti māretvā.","<b>Deti dānaṃ asaññato</b>ti asaññato dussīlo evaṃ katvā dānaṃ deti.","<b>Edisaṃ bhattaṃ bhuñjamāno, sa pāpena upalippatī</b>ti edisaṃ uddissakatabhattaṃ bhuñjamāno so samaṇopi pāpena upalippati saṃyujjatiyevāti."],"lineRefs":[["ja246:1"],["ja246:1"],["ja246:1"],["ja246:1"],["ja246:1"]]},{"para":1700,"vripara":null,"refs":["ja246:1"],"lines":["Taṃ sutvā bodhisatto dutiyaṃ gāthamāha – 193."],"lineRefs":[["ja246:1"]]},{"para":1702,"vripara":"193","refs":["ja246:1"],"lines":["“Puttadārampi ce hantvā, deti dānaṃ asaññato;"],"lineRefs":[["ja246:1"]]},{"para":1703,"vripara":null,"refs":["ja246:1"],"lines":["Bhuñjamānopi sappañño, na pāpena upalippatī”ti."],"lineRefs":[["ja246:1"]]},{"para":1704,"vripara":null,"refs":["ja246:2"],"lines":["Tattha <b>bhuñjamānopi sappañño</b>ti tiṭṭhatu aññaṃ maṃsaṃ, puttadāraṃ vadhitvāpi dussīlena dinnaṃ sappañño khantimettādiguṇasampanno taṃ bhuñjamānopi pāpena na upalippatīti.","Evamassa bodhisatto dhammaṃ kathetvā uṭṭhāyāsanā pakkāmi."],"lineRefs":[["ja246:2"],["ja246:2"]]}],"wordLinks":[["ja246:1.1","hantvā",0,0],["ja246:1.1","chetvā",0,1],["ja246:1.1","vadhitvā",0,2],["ja246:1.1","deti dānaṃ asaññato",0,3],["ja246:2.3","bhuñjamānopi sappañño",4,0]]},"tika":null,"tika2":null}
