{"suttaId":"tha-ap378","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10854,10866],"vripara":"33"},"segments":{"tha-ap378:0.3":"Gandhamuṭṭhiyattheraapadānaṃ","tha-ap378:1.1":"[idha gāthāddhaṃ ūnaṃ viya dissati]“Citake karīyamāne,","tha-ap378:1.2":"nānāgandhe samāhate;","tha-ap378:1.3":"Pasannacitto sumano,","tha-ap378:1.4":"gandhamuṭṭhimapūjayiṃ.","tha-ap378:2.1":"“Satasahassito kappe,","tha-ap378:2.2":"citakaṃ yaṃ apūjayiṃ;","tha-ap378:2.3":"Duggatiṃ nābhijānāmi,","tha-ap378:2.4":"citapūjāyidaṃ phalaṃ.","tha-ap378:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap378:3.3":"viharāmi anāsavo.","tha-ap378:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap378:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap378:5.1":"“Paṭisambhidā catasso … pe …","tha-ap378:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap378:6.1":"Itthaṃ sudaṃ āyasmā gandhamuṭṭhiyo thero imā gāthāyo abhāsitthāti.","tha-ap378:7.1":"Gandhamuṭṭhiyattherassāpadānaṃ chaṭṭhaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
