{"suttaId":"tha-ap49","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[3760,3775],"vripara":"88"},"segments":{"tha-ap49:0.3":"Sayanadāyakattheraapadānaṃ","tha-ap49:1.1":"“Siddhatthassa bhagavato,","tha-ap49:1.2":"mettacittassa tādino;","tha-ap49:1.3":"Sayanaggaṃ mayā dinnaṃ,","tha-ap49:1.4":"dussabhaṇḍehi [dussabhaṇḍena (syā.)] atthataṃ.","tha-ap49:2.1":"“Paṭiggahesi bhagavā,","tha-ap49:2.2":"kappiyaṃ sayanāsanaṃ;","tha-ap49:2.3":"Uṭṭhāya sayanā [āsanā (sī.)] tamhā,","tha-ap49:2.4":"vehāsaṃ uggamī jino.","tha-ap49:3.1":"“Catunnavutito kappe,","tha-ap49:3.2":"yaṃ sayanamadāsahaṃ;","tha-ap49:3.3":"Duggatiṃ nābhijānāmi,","tha-ap49:3.4":"sayanassa idaṃ phalaṃ.","tha-ap49:4.1":"“Ekapaññāsito kappe,","tha-ap49:4.2":"varako [varuṇo (sī. syā.)] devasavhayo;","tha-ap49:4.3":"Sattaratanasampanno,","tha-ap49:4.4":"cakkavattī mahabbalo.","tha-ap49:5.1":"“Paṭisambhidā catasso … pe …","tha-ap49:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap49:6.1":"Itthaṃ sudaṃ āyasmā sayanadāyako thero imā gāthāyo abhāsitthāti.","tha-ap49:7.1":"Sayanadāyakattherassāpadānaṃ sattamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2521,"to":2521,"paras":[{"para":2521,"vripara":"88","refs":["tha-ap49:1"],"lines":["So ekadivasaṃ attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>siddhatthassa bhagavato</b>tiādimāha.","Taṃ sabbaṃ pāḷinayānusārena suviññeyyamevāti."],"lineRefs":[["tha-ap49:1"],["tha-ap49:1"]]}],"wordLinks":[["tha-ap49:1.1","siddhatthassa bhagavato",0,0]],"before":[{"para":2519,"vripara":null,"title":"Sayanadāyakattheraapadānavaṇṇanā","lines":["Sayanadāyakattheraapadānavaṇṇanā"]},{"para":2520,"vripara":null,"title":"Sayanadāyakattheraapadānavaṇṇanā","lines":["<b>Siddhatthassa bhagavato</b>tiādikaṃ āyasmato sayanadāyakattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto siddhatthassa bhagavato kāle aññatarasmiṃ kule nibbatto viññutaṃ patto satthari pasīditvā hatthidaṇḍasuvaṇṇādīhi sayanatthāya mañcaṃ kāretvā anagghehi vicittattharaṇehi attharitvā bhagavantaṃ pūjesi.","So bhagavā tassānukampāya paṭiggahetvā anubhavi.","So tena puññakammena dibbamanussasampattiyo anubhavitvā imasmiṃ buddhuppāde ekasmiṃ kulagehe nibbatto viññutaṃ patvā satthu sāsane pasanno pabbajitvā vipassanaṃ ārabhitvā nacirasseva arahā ahosi.","Pubbe katapuññanāmena <b>sayanadāyakatthero</b>ti pākaṭo."]}],"after":[{"para":2522,"vripara":null,"title":"Sayanadāyakattheraapadānavaṇṇanā","lines":["Sayanadāyakattheraapadānavaṇṇanā samattā."]}]},"tika":null,"tika2":null}
