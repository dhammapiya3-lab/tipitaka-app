{"suttaId":"an8.32","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-viii","vriCode":"s0404m1.mul","paras":[386,390],"vripara":"32"},"segments":{"an8.32:0.3":"Dutiyadānasuttaṃ","an8.32:1.1":"[kathā.480]“Saddhā hiriyaṃ kusalañca dānaṃ,","an8.32:1.2":"Dhammā ete sappurisānuyātā;","an8.32:1.3":"Etañhi maggaṃ diviyaṃ vadanti,","an8.32:1.4":"Etena hi gacchati devalokan”ti.","an8.32:1.5":"dutiyaṃ;"},"attha":{"book":"Mp-viii","bookName":"Aṭṭhakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":140,"to":140,"paras":[{"para":140,"vripara":"32","refs":["an8.32:1"],"lines":["Dutiye <b>saddhā</b>ti yāya saddhāya dānaṃ deti, sā saddhā.","<b>Hiriyan</b>ti yāya hiriyā dānaṃ deti, sāva adhippetā.","<b>Kusalañca dānan</b>ti anavajjañca dānaṃ.","<b>Diviyan</b>ti divaṅgamaṃ."],"lineRefs":[["an8.32:1"],["an8.32:1"],["an8.32:1"],["an8.32:1"]]}],"wordLinks":[["an8.32:1.1","saddhā",0,0],["an8.32:1.1","hiriyaṃ",0,1],["an8.32:1.1","kusalañca dānaṃ",0,2],["an8.32:1.3","diviyaṃ",0,3]]},"tika":null}
