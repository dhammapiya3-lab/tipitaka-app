{"suttaId":"an4.66","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[761,767],"vripara":"66"},"segments":{"an4.66:0.3":"Sarāgasuttaṃ","an4.66:1.1":"“Cattārome, bhikkhave, puggalā santo saṃvijjamānā lokasmiṃ.","an4.66:1.2":"Katame cattāro?","an4.66:1.3":"Sarāgo, sadoso, samoho, samāno –","an4.66:1.4":"ime kho, bhikkhave, cattāro puggalā santo saṃvijjamānā lokasmin”ti.","an4.66:2.1":"“Sārattā rajanīyesu,","an4.66:2.2":"piyarūpābhinandino;","an4.66:2.3":"Mohena āvutā [adhamā (sī. syā. kaṃ. pī.)] sattā,","an4.66:2.4":"baddhā [bandhā (ka.)] vaḍḍhenti bandhanaṃ.","an4.66:3.1":"“Rāgajaṃ dosajañcāpi,","an4.66:3.2":"mohajaṃ cāpaviddasū;","an4.66:3.3":"Karontākusalaṃ kammaṃ [dhammaṃ (ka.)],","an4.66:3.4":"savighātaṃ dukhudrayaṃ.","an4.66:4.1":"“Avijjānivutā posā,","an4.66:4.2":"andhabhūtā acakkhukā;","an4.66:4.3":"Yathā dhammā tathā santā,","an4.66:4.4":"na tassevanti [nassevanti (sī.)] maññare”ti.","an4.66:4.5":"chaṭṭhaṃ;"},"unsure":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1298,"to":1298,"paras":[{"para":1298,"vripara":"66","refs":["an4.66:3","an4.66:4"],"lines":["Chaṭṭhe <b>mohajaṃ cāpaviddasū</b>ti mohajaṃ cāpi aviddasū apaṇḍitā.","<b>Savighātan</b>ti sadukkhaṃ.","<b>Dukhudrayan</b>ti āyatiñca dukkhavaḍḍhidāyakaṃ.","<b>Acakkhukā</b>ti paññācakkhurahitā.","<b>Yathā dhammā tathā santā</b>ti yathā rāgādayo dhammā ṭhitā, tathā sabhāvāva hutvā.","<b>Na tassevanti maññare</b>ti mayaṃ evaṃsantā evaṃsabhāvāti tassa na maññare, na maññantīti attho.","Imasmiṃ suttepi gāthāsupi vaṭṭameva kathitaṃ."],"lineRefs":[["an4.66:3"],["an4.66:3"],["an4.66:3"],["an4.66:4"],["an4.66:4"],["an4.66:4"],["an4.66:4"]]}],"wordLinks":[["an4.66:3.1","mohajaṃ cāpaviddasū",0,0],["an4.66:3.3","savighātaṃ",0,1],["an4.66:3.3","dukhudrayaṃ",0,2],["an4.66:4.1","acakkhukā",0,3],["an4.66:4.3","yathā dhammā tathā santā",0,4],["an4.66:4.3","na tassevanti maññare",0,5]],"before":[{"para":1297,"vripara":null,"refs":[],"lines":["Sarāgasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
