{"suttaId":"an3.108","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1042,1042],"vripara":"109"},"segments":{"an3.108:0.3":"Atittisuttaṃ","an3.108:1.1":"“Tiṇṇaṃ, bhikkhave, paṭisevanāya natthi titti.","an3.108:1.2":"Katamesaṃ tiṇṇaṃ?","an3.108:1.3":"Soppassa, bhikkhave, paṭisevanāya natthi titti.","an3.108:1.4":"Surāmerayapānassa, bhikkhave, paṭisevanāya natthi titti.","an3.108:1.5":"Methunadhammasamāpattiyā, bhikkhave, paṭisevanāya natthi titti.","an3.108:1.6":"Imesaṃ, bhikkhave, tiṇṇaṃ paṭisevanāya natthi tittī”ti.","an3.108:1.7":"Chaṭṭhaṃ."},"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":892,"to":892,"paras":[{"para":892,"vripara":"109","refs":["an3.108:1"],"lines":["Chaṭṭhe <b>soppassā</b>ti niddāya.","<b>Paṭisevanāya natthi tittī</b>ti yathā yathā paṭisevati, tathā tathā ruccatiyevāti titti nāma natthi.","Sesapadadvayepi eseva nayo.","Sace hi mahāsamudde udakaṃ surā bhaveyya, surāsoṇḍo ca maccho hutvā nibbatteyya, tassa tattha carantassapi sayantassapi titti nāma na bhaveyya.","Imasmiṃ sutte vaṭṭameva kathitaṃ."],"lineRefs":[["an3.108:1"],["an3.108:1"],["an3.108:1"],["an3.108:1"],["an3.108:1"]]}],"wordLinks":[["an3.108:1.3","soppassā",0,0],["an3.108:1.1","paṭisevanāya natthi tittī",0,1],["an3.108:1.3","paṭisevanāya natthi tittī",0,1],["an3.108:1.4","paṭisevanāya natthi tittī",0,1],["an3.108:1.5","paṭisevanāya natthi tittī",0,1],["an3.108:1.6","paṭisevanāya natthi tittī",0,1]]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":912,"to":914,"paras":[{"para":912,"vripara":"107-112","refs":["an3.108:1"],"lines":["107-112. Catutthe <b>sāmaññan</b>ti ariyamaggo, tena araṇīyato upagantabbato <b>sāmaññatthaṃ,</b> ariyaphalanti āha <b>“sāmaññatthanti catubbidhaṃ ariyaphalan”</b>ti.","<b>Brahmaññatthan</b>ti etthāpi eseva nayo.","Tenāha <b>“itaraṃ tasseva vevacanan”</b>ti.","Ariyamaggasaṅkhātaṃ sāmaññameva vā araṇīyato <b>sāmaññatthan</b>ti āha <b>“sāmaññatthena vā cattāro maggā”</b>ti.","Pañcamādīni uttānatthāneva."],"lineRefs":[["an3.108:1"],["an3.108:1"],["an3.108:1"],["an3.108:1"],["an3.108:1"]]},{"para":913,"vripara":null,"refs":[],"lines":["Samaṇabrāhmaṇasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":914,"vripara":null,"refs":["an3.108:1"],"lines":["Dutiyanidānasuttavaṇṇanā"],"lineRefs":[["an3.108:1"]]}],"wordLinks":[]}}
