{"suttaId":"ja152","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[864,869],"vripara":"4"},"segments":{"ja152:0.4":"Asamekkhitakammantaṃ, turitābhinipātinaṃ.","ja152:1.3":"Sāni kammāni tappenti, uṇhaṃvajjhohitaṃ mukhe.","ja152:2.1":"Sīho ca sīhanādena, daddaraṃ abhinādayi;","ja152:2.3":"Sutvā sīhassa nigghosaṃ, siṅgālo [sigālo (sī. syā. pī.)] daddare vasaṃ;","ja152:2.5":"Bhīto santāsamāpādi, hadayañcassa apphalīti.","ja152:3.1":"Siṅgālajātakaṃ [sigālajātakaṃ (sī. syā. pī.)] dutiyaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":43,"to":43,"paras":[{"para":43,"vripara":null,"refs":["ja152:2"],"lines":["Tattha <b>sīho</b>ti cattāro sīhā – tiṇasīho, paṇḍusīho, kāḷasīho, surattahatthapādo kesarasīhoti.","Tesu kesarasīho idha adhippeto.","<b>Daddaraṃ abhinādayī</b>ti tena asanipātasaddasadisena bheravatarena sīhanādena taṃ rajatapabbataṃ abhinādayi ekaninnādaṃ akāsi.","<b>Daddare vasan</b>ti phalikamissake rajatapabbate vasanto.","<b>Bhīto santāsamāpādī</b>ti maraṇabhayena bhīto cittutrāsaṃ āpādi.","<b>Hadayañcassa apphalī</b>ti tena cassa bhayena hadayaṃ phalīti."],"lineRefs":[["ja152:2"],["ja152:2"],["ja152:2"],["ja152:2"],["ja152:2"],["ja152:2"]]}],"wordLinks":[["ja152:2.1","sīho",0,0],["ja152:2.3","sīho",0,0],["ja152:2.1","daddaraṃ abhinādayī",0,2],["ja152:2.3","daddare vasaṃ",0,3],["ja152:2.5","bhīto santāsamāpādī",0,4],["ja152:2.5","hadayañcassa apphalī",0,5]]},"tika":null,"tika2":null}
