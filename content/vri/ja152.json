{"suttaId":"ja152","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[864,869],"vripara":"4"},"segments":{"ja152:0.4":"Asamekkhitakammantaṃ, turitābhinipātinaṃ.","ja152:1.3":"Sāni kammāni tappenti, uṇhaṃvajjhohitaṃ mukhe.","ja152:2.1":"Sīho ca sīhanādena, daddaraṃ abhinādayi;","ja152:2.3":"Sutvā sīhassa nigghosaṃ, siṅgālo [sigālo (sī. syā. pī.)] daddare vasaṃ;","ja152:2.5":"Bhīto santāsamāpādi, hadayañcassa apphalīti.","ja152:3.1":"Siṅgālajātakaṃ [sigālajātakaṃ (sī. syā. pī.)] dutiyaṃ."},"attha":null,"tika":null}
