{"suttaId":"sn35.166","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[997,997],"vripara":"166"},"segments":{"sn35.166:0.3":"Sakkāyadiṭṭhipahānasuttaṃ","sn35.166:1.1":"Atha kho aññataro bhikkhu … pe … etadavoca –","sn35.166:1.3":"“kathaṃ nu kho, bhante, jānato kathaṃ passato sakkāyadiṭṭhi pahīyatī”ti?","sn35.166:1.4":"“Cakkhuṃ kho, bhikkhu, dukkhato jānato passato sakkāyadiṭṭhi pahīyati.","sn35.166:1.5":"Rūpe dukkhato jānato passato sakkāyadiṭṭhi pahīyati.","sn35.166:1.6":"Cakkhuviññāṇaṃ dukkhato jānato passato sakkāyadiṭṭhi pahīyati.","sn35.166:1.7":"Cakkhusamphassaṃ dukkhato jānato passato sakkāyadiṭṭhi pahīyati … pe … yampidaṃ manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi dukkhato jānato passato sakkāyadiṭṭhi pahīyati.","sn35.166:1.9":"Evaṃ kho, bhikkhu, jānato evaṃ passato sakkāyadiṭṭhi pahīyatī”ti.","sn35.166:1.10":"Ekādasamaṃ."},"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":286,"to":289,"paras":[{"para":286,"vripara":"165-167","refs":["sn35.166:1"],"lines":["165-167. Dasamādīni tīṇi pāṭiyekkena puggalajjhāsayavasena vuttāni.","Tesaṃ attho vuttanayeneva veditabboti."],"lineRefs":[["sn35.166:1"],["sn35.166:1"]]},{"para":287,"vripara":null,"refs":["sn35.166:1"],"lines":["Nandikkhayavaggo solasamo."],"lineRefs":[["sn35.166:1"]]},{"para":288,"vripara":null,"refs":["sn35.166:1"],"lines":["Saṭṭhipeyyālavaggo"],"lineRefs":[["sn35.166:1"]]},{"para":289,"vripara":null,"refs":["sn35.166:1"],"lines":["1-60. Ajjhattaaniccachandasuttādivaṇṇanā"],"lineRefs":[["sn35.166:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":305,"to":309,"paras":[{"para":305,"vripara":"165-167","refs":["sn35.166:1"],"lines":["165-167. <b>Pāṭiyekkan</b>ti visuṃ visuṃ.","<b>Vuttanayenevā</b>ti heṭṭhā vuttanayeneva apubbassa vattabbassa abhāvā."],"lineRefs":[["sn35.166:1"],["sn35.166:1"]]},{"para":306,"vripara":null,"refs":["sn35.166:1"],"lines":["Micchādiṭṭhipahānasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.166:1"]]},{"para":307,"vripara":null,"refs":["sn35.166:1"],"lines":["Nandikkhayavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.166:1"]]},{"para":308,"vripara":null,"refs":["sn35.166:1"],"lines":["Saṭṭhipeyyālavaggo"],"lineRefs":[["sn35.166:1"]]},{"para":309,"vripara":null,"refs":["sn35.166:1"],"lines":["1-60. Ajjhattaaniccachandasuttādivaṇṇanā"],"lineRefs":[["sn35.166:1"]]}],"wordLinks":[]},"tika2":null}
