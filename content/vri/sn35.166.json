{"suttaId":"sn35.166","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[997,997],"vripara":"166"},"segments":{"sn35.166:0.3":"Sakkāyadiṭṭhipahānasuttaṃ","sn35.166:1.1":"Atha kho aññataro bhikkhu…pe…","sn35.166:1.2":"etadavoca –","sn35.166:1.3":"“kathaṃ nu kho, bhante, jānato kathaṃ passato sakkāyadiṭṭhi pahīyatī”ti?","sn35.166:1.4":"“Cakkhuṃ kho, bhikkhu, dukkhato jānato passato sakkāyadiṭṭhi pahīyati.","sn35.166:1.5":"Rūpe dukkhato jānato passato sakkāyadiṭṭhi pahīyati.","sn35.166:1.6":"Cakkhuviññāṇaṃ dukkhato jānato passato sakkāyadiṭṭhi pahīyati.","sn35.166:1.7":"Cakkhusamphassaṃ dukkhato jānato passato sakkāyadiṭṭhi pahīyati…pe…","sn35.166:1.8":"yampidaṃ manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi dukkhato jānato passato sakkāyadiṭṭhi pahīyati.","sn35.166:1.9":"Evaṃ kho, bhikkhu, jānato evaṃ passato sakkāyadiṭṭhi pahīyatī”ti.","sn35.166:1.10":"Ekādasamaṃ. 12."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":286,"to":289,"paras":[{"para":286,"vripara":"165-167","refs":["sn35.166:1"],"lines":["Dasamādīni tīṇi pāṭiyekkena puggalajjhāsayavasena vuttāni.","Tesaṃ attho vuttanayeneva veditabboti."],"lineRefs":[["sn35.166:1"],["sn35.166:1"]]},{"para":287,"vripara":null,"refs":["sn35.166:1"],"lines":["Nandikkhayavaggo solasamo. 17."],"lineRefs":[["sn35.166:1"]]},{"para":288,"vripara":null,"refs":["sn35.166:1"],"lines":["Saṭṭhipeyyālavaggo 1-60."],"lineRefs":[["sn35.166:1"]]},{"para":289,"vripara":null,"refs":["sn35.166:1"],"lines":["Ajjhattaaniccachandasuttādivaṇṇanā 168-227."],"lineRefs":[["sn35.166:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":305,"to":309,"paras":[{"para":305,"vripara":"165-167","refs":["sn35.166:1"],"lines":["<b>Pāṭiyekka</b>nti visuṃ visuṃ.","<b>Vuttanayenevā</b>ti heṭṭhā vuttanayeneva apubbassa vattabbassa abhāvā."],"lineRefs":[["sn35.166:1"],["sn35.166:1"]]},{"para":306,"vripara":null,"refs":["sn35.166:1"],"lines":["Micchādiṭṭhipahānasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.166:1"]]},{"para":307,"vripara":null,"refs":["sn35.166:1"],"lines":["Nandikkhayavaggavaṇṇanā niṭṭhitā. 17."],"lineRefs":[["sn35.166:1"]]},{"para":308,"vripara":null,"refs":["sn35.166:1"],"lines":["Saṭṭhipeyyālavaggo 1-60."],"lineRefs":[["sn35.166:1"]]},{"para":309,"vripara":null,"refs":["sn35.166:1"],"lines":["Ajjhattaaniccachandasuttādivaṇṇanā 168-227."],"lineRefs":[["sn35.166:1"]]}],"wordLinks":[]},"tika2":null}
