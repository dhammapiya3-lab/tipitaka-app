{"suttaId":"tha-ap302","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9021,9047],"vripara":"43"},"segments":{"tha-ap302:0.3":"Anusaṃsāvakattheraapadānaṃ","tha-ap302:1.1":"“Piṇḍāya caramānāhaṃ, vipassimaddasaṃ jinaṃ;","tha-ap302:1.3":"Uḷuṅgabhikkhaṃ pādāsiṃ, dvipadindassa tādino.","tha-ap302:2.1":"“Pasannacitto sumano, abhivādesahaṃ tadā;","tha-ap302:2.3":"Anusaṃsāvayiṃ buddhaṃ, uttamatthassa pattiyā.","tha-ap302:3.1":"“Ekanavutito kappe, anusaṃsāvayiṃ ahaṃ;","tha-ap302:3.3":"Duggatiṃ nābhijānāmi, anusaṃsāvanā phalaṃ.","tha-ap302:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap302:5.1":"Itthaṃ sudaṃ āyasmā anusaṃsāvako thero imā gāthāyo abhāsitthāti.","tha-ap302:6.1":"Anusaṃsāvakattherassāpadānaṃ dasamaṃ.","tha-ap302:6.2":"Citakapūjakavaggo tiṃsatimo.","tha-ap302:7.1":"Tassuddānaṃ –","tha-ap302:8.1":"Citakaṃ pārichatto ca, saddagosīsasantharaṃ;","tha-ap302:8.3":"Pādo padesaṃ saraṇaṃ, ambo saṃsāvakopi ca;","tha-ap302:8.5":"Aṭṭhatālīsa gāthāyo, gaṇitāyo vibhāvibhi.","tha-ap302:9.1":"Atha vagguddānaṃ –","tha-ap302:10.1":"Kaṇikāro hatthidado, ālambaṇudakāsanaṃ;","tha-ap302:10.3":"Tuvaraṃ thomako ceva, ukkhepaṃ sīsupadhānaṃ.","tha-ap302:11.1":"Paṇṇado citapūjī ca, gāthāyo ceva sabbaso;","tha-ap302:11.3":"Cattāri ca satānīha, ekapaññāsameva ca.","tha-ap302:12.1":"Pañcavīsasatā sabbā, dvāsattati taduttari;","tha-ap302:12.3":"Tisataṃ apadānānaṃ, gaṇitā atthadassibhi.","tha-ap302:13.1":"Kaṇikāravaggadasakaṃ.","tha-ap302:14.1":"Tatiyasatakaṃ samattaṃ."},"attha":null,"tika":null,"tika2":null}
