{"suttaId":"sn47.41","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1075,1075],"vripara":"407"},"segments":{"sn47.41:0.3":"Amatasuttaṃ","sn47.41:1.1":"Sāvatthinidānaṃ.","sn47.41:1.2":"“Catūsu, bhikkhave, satipaṭṭhānesu suppatiṭṭhitacittā viharatha.","sn47.41:1.3":"Mā vo amataṃ panassa.","sn47.41:1.4":"Katamesu catūsu?","sn47.41:1.5":"Idha, bhikkhave, bhikkhu kāye kāyānupassī viharati ātāpī sampajāno satimā, vineyya loke abhijjhādomanassaṃ;","sn47.41:1.6":"vedanāsu…pe…","sn47.41:1.7":"citte…pe…","sn47.41:1.8":"dhammesu dhammānupassī viharati ātāpī sampajāno satimā, vineyya loke abhijjhādomanassaṃ.","sn47.41:1.9":"Imesu, bhikkhave, catūsu satipaṭṭhānesu suppatiṭṭhitacittā viharatha.","sn47.41:1.10":"Mā vo amataṃ panassā”ti.","sn47.41:1.11":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":null,"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":437,"to":440,"paras":[{"para":437,"vripara":"397-407","refs":["sn47.41:1"],"lines":["<b>Yā</b> <b>vedanā sammasitvā</b>ti yā tebhūmakavedanā sammasitvā.","<b>Tāvassā</b>ti tā tebhūmakavedanā eva assa bhikkhuno.","Sadisavasena cetaṃ vuttaṃ, aniccādisammasanavasena <b>viditā</b> pubbabhāge sammasanakāle <b>upaṭṭhahanti.</b>","<b>Pariggahitesū</b>ti parijānanavasena paricchijja gahitesu.","<b>“Vedanā</b> taṇhāpapañcassa, <b>vitakko</b> mānapapañcassa, <b>saññā</b> diṭṭhipapañcassa mūlavasena sammasanaṃ vuttā”ti vadanti.","“Vedanāvitakkasaññā taṇhāmānadiṭṭhipapañcānaṃ mūladassanavasenā”ti apare."],"lineRefs":[["sn47.41:1"],["sn47.41:1"],["sn47.41:1"],["sn47.41:1"],["sn47.41:1"],["sn47.41:1"]]},{"para":438,"vripara":null,"refs":["sn47.41:1"],"lines":["Ananussutavaggavaṇṇanā niṭṭhitā. 5."],"lineRefs":[["sn47.41:1"]]},{"para":439,"vripara":null,"refs":["sn47.41:1"],"lines":["Amatavaggo 2."],"lineRefs":[["sn47.41:1"]]},{"para":440,"vripara":null,"refs":["sn47.41:1"],"lines":["Samudayasuttavaṇṇanā 408."],"lineRefs":[["sn47.41:1"]]}],"wordLinks":[]},"tika2":null}
