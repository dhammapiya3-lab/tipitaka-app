{"suttaId":"tha-ap444","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[843,863],"vripara":"8"},"segments":{"tha-ap444:0.3":"Koladāyakattheraapadānaṃ","tha-ap444:1.1":"“Ajinena nivatthohaṃ,","tha-ap444:1.2":"vākacīradharo tadā;","tha-ap444:1.3":"Khāriyā pūrayitvāna,","tha-ap444:1.4":"kolaṃhāsiṃ mamassamaṃ [khāribhāraṃ haritvāna, kolamāharimassamaṃ (sī. pī.)].","tha-ap444:2.1":"“Tamhi kāle sikhī buddho,","tha-ap444:2.2":"eko adutiyo ahu;","tha-ap444:2.3":"Mamassamaṃ upāgacchi,","tha-ap444:2.4":"jānanto sabbakālikaṃ.","tha-ap444:3.1":"“Sakaṃ cittaṃ pasādetvā,","tha-ap444:3.2":"vanditvāna ca subbataṃ;","tha-ap444:3.3":"Ubho hatthehi paggayha,","tha-ap444:3.4":"kolaṃ buddhassadāsahaṃ.","tha-ap444:4.1":"“Ekatiṃse ito kappe,","tha-ap444:4.2":"yaṃ phalamadadiṃ tadā;","tha-ap444:4.3":"Duggatiṃ nābhijānāmi,","tha-ap444:4.4":"koladānassidaṃ phalaṃ.","tha-ap444:5.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap444:5.3":"viharāmi anāsavo.","tha-ap444:6.1":"“Svāgataṃ vata me āsi … pe …","tha-ap444:6.3":"kataṃ buddhassa sāsanaṃ.","tha-ap444:7.1":"“Paṭisambhidā catasso … pe …","tha-ap444:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap444:8.1":"Itthaṃ sudaṃ āyasmā koladāyako thero imā gāthāyo Abhāsitthāti.","tha-ap444:9.1":"Koladāyakattherassāpadānaṃ dutiyaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
