{"suttaId":"vv72","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2665,2682],"vripara":"1094"},"segments":{"vv72:0.4":"Paṭhamakuṇḍalīvimānavatthu","vv72:1.1":"“Alaṅkato malyadharo suvattho,","vv72:1.2":"sukuṇḍalī kappitakesamassu;","vv72:1.3":"Āmuttahatthābharaṇo yasassī,","vv72:1.4":"dibbe vimānamhi yathāpi candimā. 1095.","vv72:2.1":"“Dibbā ca vīṇā pavadanti vagguṃ,","vv72:2.2":"aṭṭhaṭṭhakā sikkhitā sādhurūpā;","vv72:2.3":"Dibbā ca kaññā tidasacarā uḷārā,","vv72:2.4":"naccanti gāyanti pamodayanti. 1096.","vv72:3.1":"“Deviddhipattosi mahānubhāvo,","vv72:3.2":"manussabhūto kimakāsi puññaṃ;","vv72:3.3":"Kenāsi evaṃ jalitānubhāvo,","vv72:3.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti. 1097.","vv72:4.1":"So devaputto attamano…pe…","vv72:4.3":"yassa kammassidaṃ phalaṃ. 1098.","vv72:5.1":"“Ahaṃ manussesu manussabhūto,","vv72:5.2":"disvāna samaṇe sīlavante;","vv72:5.3":"Sampannavijjācaraṇe yasassī,","vv72:5.4":"bahussute taṇhakkhayūpapanne;","vv72:5.5":"Annañca pānañca pasannacitto,","vv72:5.6":"sakkacca dānaṃ vipulaṃ adāsiṃ. 1099.","vv72:6.1":"“Tena metādiso vaṇṇo…pe…","vv72:6.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv72:7.1":"Paṭhamakuṇḍalīvimānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3209,"to":3210,"paras":[{"para":3209,"vripara":"1094","refs":["vv72:1"],"lines":["Tattha <b>sukuṇḍalī</b>ti sundarehi kuṇḍalehi alaṅkatakaṇṇo.","“Sakuṇḍalī”tipi pāṭho, sadisaṃ kuṇḍalaṃ sakuṇḍalaṃ, taṃ assa atthīti sakuṇḍalī, yuttakuṇḍalī aññamaññañca tuyhañca anucchavikakuṇḍalīti attho.","<b>Kappitakesamassū</b>ti sammākappitakesamassu.","<b>Āmuttahatthābharaṇo</b>ti paṭimukkaaṅguliyādihatthābharaṇo. 1098."],"lineRefs":[["vv72:1"],["vv72:1"],["vv72:1"],["vv72:1"]]},{"para":3210,"vripara":"1098","refs":["vv72:5"],"lines":["<b>Taṇhakkhayūpapanne</b>ti taṇhakkhayaṃ arahattaṃ, nibbānameva vā upagate, adhigatavanteti attho.","Sesaṃ vuttanayameva."],"lineRefs":[["vv72:5"],["vv72:5"]]}],"wordLinks":[["vv72:1.1","sukuṇḍalī",0,0],["vv72:1.1","kappitakesamassū",0,2],["vv72:1.3","āmuttahatthābharaṇo",0,3],["vv72:5.3","taṇhakkhayūpapanne",1,0]],"after":[{"para":3211,"vripara":null,"title":"Paṭhamakuṇḍalīvimānavaṇṇanā","lines":["Paṭhamakuṇḍalīvimānavaṇṇanā niṭṭhitā. 9."]}]},"tika":null,"tika2":null}
