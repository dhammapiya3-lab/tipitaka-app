{"suttaId":"tha-ap461","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1261,1275],"vripara":"58"},"segments":{"tha-ap461:0.3":"Paṭṭipupphiyattheraapadānaṃ","tha-ap461:1.1":"“Nīharante sarīramhi,","tha-ap461:1.2":"vajjamānāsu bherisu;","tha-ap461:1.3":"Pasannacitto sumano,","tha-ap461:1.4":"paṭṭipupphamapūjayiṃ [satti… (syā. pī.)]. 59.","tha-ap461:2.1":"“Satasahassito kappe,","tha-ap461:2.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap461:2.3":"Duggatiṃ nābhijānāmi,","tha-ap461:2.4":"dehapūjāyidaṃ phalaṃ. 60.","tha-ap461:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap461:3.3":"viharāmi anāsavo. 61.","tha-ap461:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap461:4.3":"kataṃ buddhassa sāsanaṃ. 62.","tha-ap461:5.1":"“Paṭisambhidā catasso…pe…","tha-ap461:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap461:6.1":"Itthaṃ sudaṃ āyasmā paṭṭipupphiyo [sattipaṇṇiyo (syā. pī.)] thero imā gāthāyo Abhāsitthāti.","tha-ap461:7.1":"Paṭṭipupphiyattherassāpadānaṃ navamaṃ. 10."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
