{"suttaId":"an4.254","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1860,1864],"vripara":"254"},"segments":{"an4.254:0.3":"Abhiññāsuttaṃ","an4.254:1.1":"“Cattārome, bhikkhave, dhammā.","an4.254:1.2":"Katame cattāro?","an4.254:1.3":"Atthi, bhikkhave, dhammā abhiññā pariññeyyā;","an4.254:1.4":"atthi, bhikkhave, dhammā abhiññā pahātabbā;","an4.254:1.5":"atthi, bhikkhave, dhammā abhiññā bhāvetabbā;","an4.254:1.6":"atthi, bhikkhave, dhammā abhiññā sacchikātabbā.","an4.254:2.1":"“Katame ca, bhikkhave, dhammā abhiññā pariññeyyā?","an4.254:2.2":"Pañcupādānakkhandhā [pañcupādānakkhandhātissa vacanīyaṃ (ka.)]– ime vuccanti, bhikkhave, dhammā abhiññā pariññeyyā.","an4.254:3.1":"“Katame ca, bhikkhave, dhammā abhiññā pahātabbā?","an4.254:3.2":"Avijjā ca bhavataṇhā ca – ime vuccanti, bhikkhave, dhammā abhiññā pahātabbā.","an4.254:4.1":"“Katame ca, bhikkhave, dhammā abhiññā bhāvetabbā?","an4.254:4.2":"Samatho ca vipassanā ca – ime vuccanti, bhikkhave, dhammā abhiññā bhāvetabbā.","an4.254:5.1":"“Katame ca, bhikkhave, dhammā abhiññā sacchikātabbā?","an4.254:5.2":"Vijjā ca vimutti ca – ime vuccanti, bhikkhave, dhammā abhiññā sacchikātabbā.","an4.254:5.4":"Ime kho, bhikkhave, cattāro dhammā”ti.","an4.254:5.5":"Paṭhamaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1711,"to":1711,"paras":[{"para":1711,"vripara":"254-256","refs":["an4.254:4","an4.254:5"],"words":["samatho ca vipassanā cā","vijjā ca vimutti cā"],"lines":["254-256. Chaṭṭhassa paṭhame <b>abhiññāyā</b>ti jānitvā.","<b>Samatho ca vipassanā cā</b>ti cittekaggatā ca saṅkhārapariggahavipassanāñāṇañca.","<b>Vijjā ca vimutti cā</b>ti maggañāṇavijjā ca sesā sampayuttakadhammā ca.","Dutiye <b>anariyapariyesanā</b>ti anariyānaṃ esanā gavesanā.","<b>Jarādhamman</b>ti jarāsabhāvaṃ.","Sesesupi eseva nayo.","Tatiyaṃ uttānameva."],"lineRefs":[["an4.254:4"],["an4.254:4"],["an4.254:5"],["an4.254:5"],["an4.254:5"],["an4.254:5"],["an4.254:5"]]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1916,"to":1916,"paras":[{"para":1916,"vripara":"254-256","refs":["an4.254:4"],"words":["samatho","vipassanā"],"lines":["254-256. Chaṭṭhassa paṭhame paccanīkasamanato <b>samatho,</b> samādhīti āha <b>“cittekaggatā”</b>ti.","Aniccādinā vividhenākārena dassanato <b>vipassanā,</b> saṅkhārapariggāhakañāṇaṃ.","Tenāha <b>“saṅkhārapariggahavipassanāñāṇan”</b>ti."],"lineRefs":[["an4.254:4"],["an4.254:4"],["an4.254:4"]]}]}}
