{"suttaId":"thag1.83","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[483,486],"vripara":"83"},"segments":{"thag1.83:0.4":"Sīhattheragāthā","thag1.83:1.1":"“Sīhappamatto vihara, rattindivamatandito;","thag1.83:1.3":"Bhāvehi kusalaṃ dhammaṃ, jaha sīghaṃ samussayan”ti.","thag1.83:1.5":"… Sīho thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2165,"to":2165,"paras":[{"para":2165,"vripara":null,"refs":["thag1.83:1"],"lines":["Yā pana bhagavatā ovādavasena vuttā “sīhappamatto”ti gāthā, tattha <b>sīhā</b>ti tassa therassa ālapanaṃ.","<b>Appamatto viharā</b>ti satiyā avippavāsena pamādavirahito sabbiriyāpathesu satisampajaññayutto hutvā viharāhi.","Idāni taṃ appamādavihāraṃ saha phalena saṅkhepato dassetuṃ <b>“rattindivan”</b>tiādi vuttaṃ.","Tassattho – rattibhāgaṃ divasabhāgañca “caṅkamena nisajjāya āvaraṇīyehi dhammehi cittaṃ parisodhetī”ti (saṃ. ni.4.239; a. ni.3.16; vibha.519) vuttanayena catusammappadhānavasena atandito akusīto āraddhavīriyo kusalaṃ samathavipassanādhammañca lokuttaradhammañca bhāvehi uppādehi vaḍḍhehi ca, evaṃ bhāvetvā ca <b>jaha sīghaṃ samussayan</b>ti tava samussayaṃ attabhāvaṃ paṭhamaṃ tāva tappaṭibaddhachandarāgappahānena sīghaṃ nacirasseva pajaha, evaṃbhūto ca pacchā carimakacittanirodhena anavasesato ca pajahissatīti.","Arahattaṃ pana patvā thero aññaṃ byākaronto tameva gāthaṃ paccudāhāsīti."],"lineRefs":[["thag1.83:1"],["thag1.83:1"],["thag1.83:1"],["thag1.83:1"],["thag1.83:1"]]}],"wordLinks":[["thag1.83:1.1","sīhā",0,0],["thag1.83:1.5","sīhā",0,0],["thag1.83:1.1","appamatto viharā",0,1],["thag1.83:1.1","rattindivaṃ",0,2],["thag1.83:1.3","jaha sīghaṃ samussayaṃ",0,3]],"before":[{"para":2123,"vripara":null,"refs":[],"lines":["“Ajjhāyako mantadharo, tiṇṇaṃ vedāna pāragū;"],"lineRefs":[[]]},{"para":2124,"vripara":null,"refs":[],"lines":["Abbhokāse ṭhito santo, addasaṃ lokanāyakaṃ."],"lineRefs":[[]]},{"para":2125,"vripara":null,"refs":[],"lines":["“Sīhaṃ yathā vanacaraṃ, byaggharājaṃva nittasaṃ;"],"lineRefs":[[]]},{"para":2126,"vripara":null,"refs":[],"lines":["Tidhāpabhinnamātaṅgaṃ, kuñjaraṃva mahesinaṃ."],"lineRefs":[[]]},{"para":2127,"vripara":null,"refs":[],"lines":["“Sereyakaṃ gahetvāna, ākāse ukkhipiṃ ahaṃ;"],"lineRefs":[[]]},{"para":2128,"vripara":null,"refs":[],"lines":["Buddhassa ānubhāvena, parivārenti sabbaso."],"lineRefs":[[]]},{"para":2129,"vripara":null,"refs":[],"lines":["“Adhiṭṭhahi mahāvīro, sabbaññū lokanāyako;"],"lineRefs":[[]]},{"para":2130,"vripara":null,"refs":[],"lines":["Samantā pupphacchadanā, okiriṃsu narāsabhaṃ."],"lineRefs":[[]]},{"para":2131,"vripara":null,"refs":[],"lines":["“Tato sā pupphakañcukā, antovaṇṭā bahimukhā;"],"lineRefs":[[]]},{"para":2132,"vripara":null,"refs":[],"lines":["Sattāhaṃ chadanaṃ katvā, tato antaradhāyatha."],"lineRefs":[[]]},{"para":2133,"vripara":null,"refs":[],"lines":["“Tañca acchariyaṃ disvā, abbhutaṃ lomahaṃsanaṃ;"],"lineRefs":[[]]},{"para":2134,"vripara":null,"refs":[],"lines":["Buddhe cittaṃ pasādesiṃ, sugate lokanāyake."],"lineRefs":[[]]},{"para":2135,"vripara":null,"refs":[],"lines":["“Tena cittappasādena, sukkamūlena codito;"],"lineRefs":[[]]},{"para":2136,"vripara":null,"refs":[],"lines":["Kappānaṃ satasahassaṃ, duggatiṃ nupapajjahaṃ."],"lineRefs":[[]]},{"para":2137,"vripara":null,"refs":[],"lines":["“Pannarasasahassamhi, kappānaṃ pañcavīsati;"],"lineRefs":[[]]},{"para":2138,"vripara":null,"refs":[],"lines":["Vītamalāsanāmā ca, cakkavattī mahabbalā."],"lineRefs":[[]]},{"para":2139,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":2140,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā “idameva mātu vacanaṃ arahattappattiyā aṅkusaṃ jātan”ti tameva gāthaṃ paccudāhāsi."],"lineRefs":[[]]},{"para":2141,"vripara":null,"refs":[],"lines":["Kassapattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2142,"vripara":null,"refs":[],"lines":["Sīhattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":2143,"vripara":null,"refs":[],"lines":["<b>Sīhappamatto viharā</b>ti āyasmato sīhattherassa gāthā.","Kā uppatti?","So kira purimabuddhesu katādhikāro ito aṭṭhārasakappasatamatthake atthadassissa bhagavato kāle candabhāgāya nadiyā tīre kinnarayoniyaṃ nibbattitvā pupphabhakkho pupphanivasano hutvā viharanto ākāsena gacchantaṃ atthadassiṃ bhagavantaṃ disvā pasannacitto pūjetukāmo añjaliṃ paggayha aṭṭhāsi.","Bhagavā tassa ajjhāsayaṃ ñatvā ākāsato oruyha aññatarasmiṃ rukkhamūle pallaṅkena nisīdi.","Kinnaro candanasāraṃ ghaṃsitvā candanagandhena pupphehi ca pūjaṃ katvā vanditvā padakkhiṇaṃ katvā pakkāmi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde mallarājakule nibbatti, tassa <b>sīho</b>ti nāmaṃ ahosi.","So bhagavantaṃ disvā pasannamānaso vanditvā ekamantaṃ nisīdi.","Satthā tassa ajjhāsayaṃ oloketvā dhammaṃ kathesi.","So dhammaṃ sutvā paṭiladdhasaddho pabbajitvā kammaṭṭhānaṃ gahetvā araññe viharati.","Tassa cittaṃ nānārammaṇe vidhāvati, ekaggaṃ na hoti, sakatthaṃ nipphādetuṃ na sakkoti.","Satthā taṃ disvā ākāse ṭhatvā –"],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[]]},{"para":2145,"vripara":"83","refs":[],"lines":["“Sīhappamatto vihara, rattindivamatandito;"],"lineRefs":[[]]},{"para":2146,"vripara":null,"refs":[],"lines":["Bhāvehi kusalaṃ dhammaṃ, jaha sīghaṃ samussayan”ti.","–"],"lineRefs":[[],[]]},{"para":2147,"vripara":null,"refs":[],"lines":["Gāthāya ovadi.","So gāthāvasāne vipassanaṃ vaḍḍhetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.14.17-25)–"],"lineRefs":[[],[],[]]},{"para":2148,"vripara":null,"refs":[],"lines":["“Candabhāgānadītīre, ahosiṃ kinnaro tadā;"],"lineRefs":[[]]},{"para":2149,"vripara":null,"refs":[],"lines":["Pupphabhakkho cahaṃ āsiṃ, pupphanivasano tathā."],"lineRefs":[[]]},{"para":2150,"vripara":null,"refs":[],"lines":["“Atthadassī tu bhagavā, lokajeṭṭho narāsabho;"],"lineRefs":[[]]},{"para":2151,"vripara":null,"refs":[],"lines":["Vipinaggena niyyāsi, haṃsarājāva ambare."],"lineRefs":[[]]},{"para":2152,"vripara":null,"refs":[],"lines":["“Namo te purisājañña, cittaṃ te suvisodhitaṃ;"],"lineRefs":[[]]},{"para":2153,"vripara":null,"refs":[],"lines":["Pasannamukhavaṇṇosi, vippasannamukhindriyo."],"lineRefs":[[]]},{"para":2154,"vripara":null,"refs":[],"lines":["“Orohitvāna ākāsā, bhūripañño sumedhaso;"],"lineRefs":[[]]},{"para":2155,"vripara":null,"refs":[],"lines":["Saṅghāṭiṃ pattharitvāna, pallaṅkena upāvisi."],"lineRefs":[[]]},{"para":2156,"vripara":null,"refs":[],"lines":["“Vilīnaṃ candanādāya, agamāsiṃ jinantikaṃ;"],"lineRefs":[[]]},{"para":2157,"vripara":null,"refs":[],"lines":["Pasannacitto sumano, buddhassa abhiropayiṃ."],"lineRefs":[[]]},{"para":2158,"vripara":null,"refs":[],"lines":["“Abhivādetvāna sambuddhaṃ, lokajeṭṭhaṃ narāsabhaṃ;"],"lineRefs":[[]]},{"para":2159,"vripara":null,"refs":[],"lines":["Pāmojjaṃ janayitvāna, pakkāmiṃ uttarāmukho."],"lineRefs":[[]]},{"para":2160,"vripara":null,"refs":[],"lines":["“Aṭṭhārase kappasate, candanaṃ yaṃ apūjayiṃ;"],"lineRefs":[[]]},{"para":2161,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":2162,"vripara":null,"refs":[],"lines":["“Catuddase kappasate, ito āsiṃsu te tayo;"],"lineRefs":[[]]},{"para":2163,"vripara":null,"refs":[],"lines":["Rohaṇī nāma nāmena, cakkavattī mahabbalā."],"lineRefs":[[]]},{"para":2164,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
