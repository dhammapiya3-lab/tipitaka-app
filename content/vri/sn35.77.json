{"suttaId":"sn35.77","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[329,329],"vripara":"77"},"segments":{"sn35.77:0.3":"Rādhadukkhasuttaṃ","sn35.77:1.1":"“Yaṃ kho, rādha, dukkhaṃ tatra te chando pahātabbo.","sn35.77:1.2":"Kiñca, rādha, dukkhaṃ?","sn35.77:1.3":"Cakkhu kho, rādha, dukkhaṃ. Tatra te chando pahātabbo.","sn35.77:1.4":"Rūpā…","sn35.77:1.5":"cakkhuviññāṇaṃ…","sn35.77:1.6":"cakkhusamphasso…","sn35.77:1.7":"yampidaṃ cakkhusamphassa…pe… adukkhamasukhaṃ vā tampi dukkhaṃ. Tatra te chando pahātabbo…pe…","sn35.77:1.8":"mano dukkho…","sn35.77:1.9":"dhammā…","sn35.77:1.10":"manoviññāṇaṃ…","sn35.77:1.11":"manosamphasso…","sn35.77:1.12":"yampidaṃ manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi dukkhaṃ. Tatra te chando pahātabbo.","sn35.77:1.13":"Yaṃ kho, rādha, dukkhaṃ tatra te chando pahātabbo”ti.","sn35.77:1.14":"Catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":97,"to":98,"paras":[{"para":97,"vripara":"74-78","refs":["sn35.77:1"],"lines":["Gilānavaggassa paṭhame <b>amukasmi</b>nti asukasmiṃ.","Ayameva vā pāṭho.","<b>Appaññāto</b>ti aññāto apākaṭo.","Navopi hi koci paññāto hoti rāhulatthero viya sumanasāmaṇero viya ca, ayaṃ pana navo ceva apaññāto ca.","Sesamettha vuttanayamevāti.","Tathā ito paresu catūsu. 6."],"lineRefs":[["sn35.77:1"],["sn35.77:1"],["sn35.77:1"],["sn35.77:1"],["sn35.77:1"],["sn35.77:1"]]},{"para":98,"vripara":null,"refs":["sn35.77:1"],"lines":["Paṭhamaavijjāpahānasuttavaṇṇanā 79."],"lineRefs":[["sn35.77:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":107,"to":109,"paras":[{"para":107,"vripara":"74-78","refs":["sn35.77:1"],"lines":["<b>Appaññāto</b>ti nāmagottato ceva sīlādiguṇehi ca appaññāto avissuto.","Theramajjhimabhāvaṃ appattatāya <b>navo</b>."],"lineRefs":[["sn35.77:1"],["sn35.77:1"]]},{"para":108,"vripa