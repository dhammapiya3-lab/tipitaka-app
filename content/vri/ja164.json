{"suttaId":"ja164","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[972,978],"vripara":"27"},"segments":{"ja164:0.4":"Gijjhajātakaṃ (2-2-4)","ja164:1.1":"Yaṃ nu gijjho yojanasataṃ, kuṇapāni avekkhati;","ja164:1.3":"Kasmā jālañca pāsañca, āsajjāpi na bujjhasi.","ja164:2.1":"Yadā parābhavo hoti, poso jīvitasaṅkhaye;","ja164:2.3":"Atha jālañca pāsañca, āsajjāpi na bujjhatīti.","ja164:3.1":"Gijjhajātakaṃ catutthaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":265,"to":270,"paras":[{"para":265,"vripara":null,"refs":["ja164:1"],"lines":["Tattha <b>yan</b>ti nipātamattaṃ, <b>nū</b>ti nāmatthe nipāto.","Gijjho nāma yojanasataṃ atikkamitvā ṭhitāni kuṇapāni avekkhati, passatīti attho.","<b>Āsajjāpī</b>ti āsādetvāpi, sampāpuṇitvāpīti attho.","“Tvaṃ attano atthāya oḍḍitaṃ jālañca pāsañca patvāpi kasmā na bujjhasī”ti pucchi."],"lineRefs":[["ja164:1"],["ja164:1"],["ja164:1"],["ja164:1"]]},{"para":266,"vripara":null,"refs":[],"lines":["Gijjho tassa vacanaṃ sutvā dutiyaṃ gāthamāha –"],"lineRefs":[[]]},{"para":268,"vripara":"28","refs":[],"lines":["“Yadā parābhavo hoti, poso jīvitasaṅkhaye;"],"lineRefs":[[]]},{"para":269,"vripara":null,"refs":[],"lines":["Atha jālañca pāsañca, āsajjāpi na bujjhatī”ti."],"lineRefs":[[]]},{"para":270,"vripara":null,"refs":["ja164:2"],"lines":["Tattha <b>parābhavo</b>ti vināso.","<b>Poso</b>ti satto."],"lineRefs":[["ja164:2"],["ja164:2"]]}],"wordLinks":[["ja164:1.1","nū",0,0],["ja164:1.1","yaṃ",0,0],["ja164:1.3","āsajjāpī",0,2],["ja164:2.1","parābhavo",4,0],["ja164:2.1","poso",4,1]]},"tika":null}
