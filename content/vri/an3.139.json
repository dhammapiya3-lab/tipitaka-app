{"suttaId":"an3.139","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1202,1202],"vripara":"140"},"segments":{"an3.139:0.3":"Vuddhisuttaṃ","an3.139:1.1":"“Tisso imā, bhikkhave, vuddhiyo.","an3.139:1.2":"Katamā tisso?","an3.139:1.3":"Saddhāvuddhi, sīlavuddhi, paññāvuddhi – imā kho, bhikkhave, tisso vuddhiyo”ti.","an3.139:1.5":"Sattamaṃ."},"attha":null,"tika":null}
