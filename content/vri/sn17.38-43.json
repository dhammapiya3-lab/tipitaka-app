{"suttaId":"sn17.38-43","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1168,1173],"vripara":"187"},"segments":{"sn17.38-43:0.3":"8-13. Pitusuttādichakkaṃ","sn17.38-43:1.1":"Sāvatthiyaṃ viharati…pe…","sn17.38-43:1.2":"“dāruṇo, bhikkhave, lābhasakkārasiloko kaṭuko pharuso antarāyiko anuttarassa yogakkhemassa adhigamāya.","sn17.38-43:1.3":"Idhāhaṃ, bhikkhave, ekaccaṃ puggalaṃ evaṃ cetasā ceto paricca pajānāmi –","sn17.38-43:1.4":"‘na cāyamāyasmā pitupi hetu…pe… bhātupi hetu…","sn17.38-43:1.7":"bhaginiyāpi hetu…","sn17.38-43:1.8":"puttassapi hetu…","sn17.38-43:1.9":"dhītuyāpi hetu…","sn17.38-43:1.10":"pajāpatiyāpi hetu sampajānamusā bhāseyyā’ti.","sn17.38-43:1.11":"Tamenaṃ passāmi aparena samayena lābhasakkārasilokena abhibhūtaṃ pariyādiṇṇacittaṃ sampajānamusā bhāsantaṃ.","sn17.38-43:1.12":"Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko kaṭuko pharuso antarāyiko anuttarassa yogakkhemassa adhigamāya.","sn17.38-43:1.13":"Tasmātiha, bhikkhave, evaṃ sikkhitabbaṃ –","sn17.38-43:1.14":"‘uppannaṃ lābhasakkārasilokaṃ pajahissāma, na ca no uppanno lābhasakkārasiloko cittaṃ pariyādāya ṭhassatī’ti.","sn17.38-43:1.15":"Evañhi vo, bhikkhave, sikkhitabba”nti.","sn17.38-43:1.16":"Terasamaṃ.","sn17.38-43:1.17":"Catuttho vaggo.","sn17.38-43:2.0":"Tassuddānaṃ –","sn17.38-43:2.1":"Bhindi mūlaṃ duve dhammā,","sn17.38-43:2.2":"pakkantaṃ ratha mātari;","sn17.38-43:2.3":"Pitā bhātā ca bhaginī,","sn17.38-43:2.4":"putto dhītā pajāpatīti.","sn17.38-43:2.5":"Lābhasakkārasaṃyuttaṃ samattaṃ. 7."},"unsure":["sn17.38-43:1.4"],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":829,"to":833,"paras":[{"para":829,"vripara":"186-187","refs":["sn17.38-43:1"],"lines":["Sattame <b>mātupi hetū</b>ti “sace musā bhaṇasi, mātaraṃ te vissajjessāma.","No ce bhaṇasi, na vissajjessāmā”ti evaṃ corehi aṭaviyaṃ pucchamāno tassā corahatthagatāya mātuyāpi hetu sampajānamusā na bhāseyyāti attho.","Ito paresupi eseva nayoti.","Sattamādīni."],"lineRefs":[["sn17.38-43:1"],["sn17.38-43:1"],["sn17.38-43:1"],["sn17.38-43:1"]]},{"para":830,"vripara":null,"refs":["sn17.38-43:1"],"lines":["Lābhasakkārasaṃyuttavaṇṇanā niṭṭhitā. 7."],"lineRefs":[["sn17.38-43:1"]]},{"para":831,"vripara":null,"refs":["sn17.38-43:1"],"lines":["Rāhulasaṃyuttaṃ 1."],"lineRefs":[["sn17.38-43:1"]]},{"para":832,"vripara":null,"refs":["sn17.38-43:1"],"lines":["Paṭhamavaggo 1-8."],"lineRefs":[["sn17.38-43:1"]]},{"para":833,"vripara":null,"refs":["sn17.38-43:1"],"lines":["Cakkhusuttādivaṇṇanā 188-195."],"lineRefs":[["sn17.38-43:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":847,"to":853,"paras":[{"para":847,"vripara":"186-187","refs":["sn17.38-43:1"],"lines":["<b>Mātupi hetū</b>ti attano mātuyā uppannaanatthāvahassa pahānahetupi.","<b>Ito paresū</b>ti “pitupi hetū”ti evamādīsu."],"lineRefs":[["sn17.38-43:1"],["sn17.38-43:1"]]},{"para":848,"vripara":null,"refs":["sn17.38-43:1"],"lines":["Mātusuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn17.38-43:1"]]},{"para":849,"vripara":null,"refs":["sn17.38-43:1"],"lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"],"lineRefs":[["sn17.38-43:1"]]},{"para":850,"vripara":null,"refs":["sn17.38-43:1"],"lines":["Lābhasakkārasaṃyuttavaṇṇanāya līnatthappakāsanā samattā. 7."],"lineRefs":[["sn17.38-43:1"]]},{"para":851,"vripara":null,"refs":["sn17.38-43:1"],"lines":["Rāhulasaṃyuttaṃ 1."],"lineRefs":[["sn17.38-43:1"]]},{"para":852,"vripara":null,"refs":["sn17.38-43:1"],"lines":["Paṭhamavaggo 1-8."],"lineRefs":[["sn17.38-43:1"]]},{"para":853,"vripara":null,"refs":["sn17.38-43:1"],"lines":["Cakkhusuttādivaṇṇanā 188-195."],"lineRefs":[["sn17.38-43:1"]]}],"wordLinks":[]},"tika2":null}
