{"suttaId":"snp5.15","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3845,3859],"vripara":"1118"},"segments":{"snp5.15:0.2":"Posālamāṇavapucchā","snp5.15:1.1":"“Yo atītaṃ ādisati,","snp5.15:1.2":"(iccāyasmā posālo)","snp5.15:1.3":"anejo chinnasaṃsayo;","snp5.15:1.4":"Pāraguṃ sabbadhammānaṃ,","snp5.15:1.5":"atthi pañhena āgamaṃ. 1119.","snp5.15:2.1":"“Vibhūtarūpasaññissa,","snp5.15:2.2":"sabbakāyappahāyino;","snp5.15:2.3":"Ajjhattañca bahiddhā ca,","snp5.15:2.4":"natthi kiñcīti passato;","snp5.15:2.5":"Ñāṇaṃ sakkānupucchāmi,","snp5.15:2.6":"kathaṃ neyyo tathāvidho”. 1120.","snp5.15:3.1":"“Viññāṇaṭṭhitiyo sabbā,","snp5.15:3.2":"(posālāti bhagavā)","snp5.15:3.3":"abhijānaṃ tathāgato;","snp5.15:3.4":"Tiṭṭhantamenaṃ jānāti,","snp5.15:3.5":"vimuttaṃ tapparāyaṇaṃ. 1121.","snp5.15:4.1":"“Ākiñcaññasambhavaṃ ñatvā,","snp5.15:4.2":"nandī saṃyojanaṃ iti;","snp5.15:4.3":"Evametaṃ abhiññāya,","snp5.15:4.4":"tato tattha vipassati;","snp5.15:4.5":"Etaṃ [evaṃ (syā. ka.)] ñāṇaṃ tathaṃ tassa,","snp5.15:4.6":"brāhmaṇassa vusīmato”ti.","snp5.15:4.7":"Posālamāṇavapucchā cuddasamā niṭṭhitā. 15."},"unsure":[],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2629,"to":2629,"paras":[{"para":2629,"vripara":"1119-1120","refs":["snp5.15:2"],"lines":["<b>Yo</b> <b>atīta</b>nti posālasuttaṃ.","Tattha <b>yo atītaṃ ādisatī</b>ti yo bhagavā attano ca paresañca “ekampi jāti”ntiādibhedaṃ atītaṃ ādisati.","<b>Vibhūtarūpasaññissā</b>ti samatikkantarūpasaññissa.","<b>Sabbakāyappahāyino</b>ti tadaṅgavikkhambhanavasena sabbarūpakāyappahāyino, pahīnarūpabhavapaṭisandhikassāti adhippāyo.","<b>Natthi kiñcīti passato</b>ti viññāṇābhāvavipassanena “natthi kiñcī”ti passato, ākiñcaññāyatanalābhinoti vuttaṃ hoti.","<b>Ñāṇaṃ sakkānupucchāmī</b>ti sakkāti bhagavantaṃ ālapanto āha.","Tassa puggalassa ñāṇaṃ pucchāmi, kīdisaṃ pucchitabbanti.","<b>Kathaṃ neyyo</b>ti kathaṃ so netabbo, kathamassa uttariñāṇaṃ uppādetabbanti. 1121."],"lineRefs":[["snp5.15:2"],["snp5.15:2"],["snp5.15:2"],["snp5.15:2"],["snp5.15:2"],["snp5.15:2"],["snp5.15:2"],["snp5.15:2"]]}],"wordLinks":[["snp5.15:2.1","vibhūtarūpasaññissā",0,2],["snp5.15:2.1","sabbakāyappahāyino",0,3],["snp5.15:2.3","natthi kiñcīti passato",0,4],["snp5.15:2.5","ñāṇaṃ sakkānupucchāmī",0,5],["snp5.15:2.5","kathaṃ neyyo",0,7]]},"tika":null,"tika2":null}
