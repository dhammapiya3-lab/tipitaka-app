{"suttaId":"tha-ap200","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7361,7376],"vripara":"42"},"segments":{"tha-ap200:0.3":"Muṭṭhipūjakattheraapadānaṃ","tha-ap200:1.1":"“Sumedho nāma bhagavā, lokajeṭṭho narāsabho;","tha-ap200:1.3":"Pacchime anukampāya, padhānaṃ padahī jino.","tha-ap200:2.1":"“Tassa caṅkamamānassa, dvipadindassa tādino;","tha-ap200:2.3":"Girinelassa pupphānaṃ, muṭṭhiṃ buddhassa ropayiṃ.","tha-ap200:3.1":"“Tena cittappasādena, sukkamūlena codito;","tha-ap200:3.3":"Tiṃsakappasahassāni, duggatiṃ nupapajjahaṃ.","tha-ap200:4.1":"“Tevīsatikappasate, sunelo nāma khattiyo;","tha-ap200:4.3":"Sattaratanasampanno, eko āsiṃ mahabbalo.","tha-ap200:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap200:6.1":"Itthaṃ sudaṃ āyasmā muṭṭhipūjako thero imā gāthāyo abhāsitthāti.","tha-ap200:7.1":"Muṭṭhipūjakattherassāpadānaṃ aṭṭhamaṃ."},"attha":null,"tika":null,"tika2":null}
