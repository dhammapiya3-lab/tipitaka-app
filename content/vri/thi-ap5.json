{"suttaId":"thi-ap5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[6649,6675],"vripara":"37"},"segments":{"thi-ap5:0.3":"Naḷamālikātherīapadānaṃ","thi-ap5:1.1":"“Candabhāgānadītīre,","thi-ap5:1.2":"ahosiṃ kinnarī tadā;","thi-ap5:1.3":"Addasaṃ virajaṃ buddhaṃ,","thi-ap5:1.4":"sayambhuṃ aparājitaṃ. 38.","thi-ap5:2.1":"“Pasannacittā sumanā,","thi-ap5:2.2":"vedajātā katañjalī;","thi-ap5:2.3":"Naḷamālaṃ gahetvāna,","thi-ap5:2.4":"sayambhuṃ abhipūjayiṃ. 39.","thi-ap5:3.1":"“Tena kammena sukatena,","thi-ap5:3.2":"cetanāpaṇidhīhi ca;","thi-ap5:3.3":"Jahitvā kinnarīdehaṃ,","thi-ap5:3.4":"agacchiṃ tidasaṃ gatiṃ. 40.","thi-ap5:4.1":"“Chattiṃsadevarājūnaṃ,","thi-ap5:4.2":"mahesittamakārayiṃ;","thi-ap5:4.3":"Dasannaṃ cakkavattīnaṃ,","thi-ap5:4.4":"mahesittamakārayiṃ;","thi-ap5:4.5":"Saṃvejetvāna me cittaṃ [vedayitvāna kusalaṃ (syā.), saṃvedayitvā kusalaṃ (pī.)],","thi-ap5:4.6":"pabbajiṃ anagāriyaṃ. 41.","thi-ap5:5.1":"“Kilesā jhāpitā mayhaṃ,","thi-ap5:5.2":"bhavā sabbe samūhatā [bhavā saṃghātitā mama (ka.)];","thi-ap5:5.3":"Sabbāsavaparikkhīṇā,","thi-ap5:5.4":"natthi dāni punabbhavo. 42.","thi-ap5:6.1":"“Catunnavutito kappe,","thi-ap5:6.2":"yaṃ pupphamabhipūjayiṃ;","thi-ap5:6.3":"Duggatiṃ nābhijānāmi,","thi-ap5:6.4":"pupphapūjāyidaṃ phalaṃ. 43.","thi-ap5:7.1":"“Kilesā jhāpitā mayhaṃ…pe…","thi-ap5:7.3":"viharāmi anāsavā. 44.","thi-ap5:8.1":"“Svāgataṃ vata me āsi…pe…","thi-ap5:8.3":"kataṃ buddhassa sāsanaṃ. 45.","thi-ap5:9.1":"“Paṭisambhidā catasso…pe…","thi-ap5:9.3":"kataṃ buddhassa sāsanaṃ”.","thi-ap5:10.1":"Itthaṃ sudaṃ naḷamālikā therī imā gāthāyo abhāsitthāti.","thi-ap5:11.1":"Naḷamālikātheriyāpadānaṃ pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
