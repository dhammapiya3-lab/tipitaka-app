{"suttaId":"tha-ap511","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3144,3161],"vripara":"85"},"segments":{"tha-ap511:0.3":"Tālaphaladāyakattheraapadānaṃ","tha-ap511:1.1":"“Sataraṃsī nāma bhagavā,","tha-ap511:1.2":"sayambhū aparājito;","tha-ap511:1.3":"Vivekā vuṭṭhahitvāna,","tha-ap511:1.4":"gocarāyābhinikkhami.","tha-ap511:2.1":"“Phalahattho ahaṃ disvā,","tha-ap511:2.2":"upagacchiṃ narāsabhaṃ;","tha-ap511:2.3":"Pasannacitto sumano,","tha-ap511:2.4":"tālaphalaṃ adāsahaṃ.","tha-ap511:3.1":"“Catunnavutito kappe,","tha-ap511:3.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap511:3.3":"Duggatiṃ nābhijānāmi,","tha-ap511:3.4":"phaladānassidaṃ phalaṃ.","tha-ap511:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap511:4.3":"viharāmi anāsavo.","tha-ap511:5.1":"“Svāgataṃ vata me āsi … pe …","tha-ap511:5.3":"kataṃ buddhassa sāsanaṃ.","tha-ap511:6.1":"“Paṭisambhidā catasso … pe …","tha-ap511:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap511:7.1":"Itthaṃ sudaṃ āyasmā tālaphaladāyako thero imā gāthāyo Abhāsitthāti.","tha-ap511:8.1":"Tālaphaladāyakattherassāpadānaṃ navamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
