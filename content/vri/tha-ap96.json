{"suttaId":"tha-ap96","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5003,5018],"vripara":"19"},"segments":{"tha-ap96:0.3":"Sūcidāyakattheraapadānaṃ","tha-ap96:1.1":"“Kammārohaṃ pure āsiṃ,","tha-ap96:1.2":"bandhumāyaṃ puruttame;","tha-ap96:1.3":"Sūcidānaṃ mayā dinnaṃ,","tha-ap96:1.4":"vipassissa mahesino.","tha-ap96:2.1":"“Vajiraggasamaṃ ñāṇaṃ,","tha-ap96:2.2":"hoti kammena tādisaṃ;","tha-ap96:2.3":"Virāgomhi vimuttomhi [vibhavomhi vibhattomhi (ka.)],","tha-ap96:2.4":"pattomhi āsavakkhayaṃ.","tha-ap96:3.1":"“Atīte ca bhave sabbe,","tha-ap96:3.2":"vattamāne canāgate [atītā ca bhavā sabbe, vattamānā ca’ nāgatā (syā. ka.)];","tha-ap96:3.3":"Ñāṇena viciniṃ sabbaṃ,","tha-ap96:3.4":"sūcidānassidaṃ phalaṃ.","tha-ap96:4.1":"“Ekanavutito kappe,","tha-ap96:4.2":"sattāsuṃ vajiravhayā;","tha-ap96:4.3":"Sattaratanasampannā,","tha-ap96:4.4":"cakkavattī mahabbalā.","tha-ap96:5.1":"“Paṭisambhidā catasso … pe …","tha-ap96:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap96:6.1":"Itthaṃ sudaṃ āyasmā sūcidāyako thero imā gāthāyo abhāsitthāti.","tha-ap96:7.1":"Sūcidāyakattherassāpadānaṃ catutthaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2770,"to":2770,"paras":[{"para":2770,"vripara":"19","refs":["tha-ap96:1"],"lines":["So arahā samāno attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>kammārohaṃ pure āsin</b>tiādimāha.","Tattha <b>kammāro</b>ti ayokammalohakammādinā kammena jīvati ruhati vuddhiṃ virūḷhiṃ āpajjatīti kammāro, pubbe puññakaraṇakāle kammāro <b>āsiṃ</b> ahosinti attho.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["tha-ap96:1"],["tha-ap96:1"],["tha-ap96:1"]]}],"wordLinks":[["tha-ap96:1.1","kammārohaṃ pure āsiṃ",0,0],["tha-ap96:1.1","kammāro",0,1],["tha-ap96:1.1","āsiṃ",0,1]]},"tika":null,"tika2":null}
