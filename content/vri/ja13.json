{"suttaId":"ja13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[74,78],"vripara":"13"},"segments":{"ja13:0.4":"Kaṇḍijātakaṃ","ja13:1.1":"Dhiratthu kaṇḍinaṃ sallaṃ, purisaṃ gāḷhavedhinaṃ;","ja13:1.3":"Dhiratthu taṃ janapadaṃ, yatthitthī pariṇāyikā;","ja13:1.5":"Te cāpi dhikkitā [dhikkatā (?)] sattā, ye itthīnaṃ vasaṃgatāti.","ja13:2.1":"Kaṇḍijātakaṃ tatiyaṃ."},"attha":null,"tika":null}
