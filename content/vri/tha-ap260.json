{"suttaId":"tha-ap260","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8347,8362],"vripara":"28"},"segments":{"tha-ap260:0.3":"Paṇṇadāyakattheraapadānaṃ","tha-ap260:1.1":"“Pabbate himavantamhi,","tha-ap260:1.2":"vākacīradharo ahaṃ;","tha-ap260:1.3":"Aloṇapaṇṇabhakkhomhi,","tha-ap260:1.4":"niyamesu ca saṃvuto. 29.","tha-ap260:2.1":"“Pātarāse anuppatte,","tha-ap260:2.2":"siddhattho upagacchi maṃ;","tha-ap260:2.3":"Tāhaṃ buddhassa pādāsiṃ,","tha-ap260:2.4":"pasanno sehi pāṇibhi. 30.","tha-ap260:3.1":"“Catunnavutito kappe,","tha-ap260:3.2":"yaṃ paṇṇamadadiṃ tadā;","tha-ap260:3.3":"Duggatiṃ nābhijānāmi,","tha-ap260:3.4":"paṇṇadānassidaṃ phalaṃ. 31.","tha-ap260:4.1":"“Sattavīsatikappamhi,","tha-ap260:4.2":"rājā āsiṃ sadatthiyo [yadatthiyo (sī. syā.)];","tha-ap260:4.3":"Sattaratanasampanno,","tha-ap260:4.4":"cakkavattī mahabbalo. 32.","tha-ap260:5.1":"“Paṭisambhidā catasso…pe…","tha-ap260:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap260:6.1":"Itthaṃ sudaṃ āyasmā paṇṇadāyako thero imā gāthāyo abhāsitthāti.","tha-ap260:7.1":"Paṇṇadāyakattherassāpadānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3216,"to":3216,"paras":[{"para":3216,"vripara":"28-29","refs":["tha-ap260:1"],"lines":["Aṭṭhamāpadāne <b>aloṇapaṇṇabhakkhomhī</b>ti khīrapaṇṇādīni uñchācariyāya āharitvā loṇavirahitāni paṇṇāni pacitvā bhakkhāmi, aloṇapaṇṇabhakkho amhi bhavāmīti attho.","<b>Niyamesu ca saṃvuto</b>ti niyamasaññitesu pāṇātipātāveramaṇiādīsu niccapañcasīlesu saṃvuto pihitoti attho.","<b>Pātarāse anuppatte</b>ti purebhattakāle anuppatte.","<b>Siddhattho upagacchi ma</b>nti mama samīpaṃ siddhattho bhagavā upagañchi sampāpuṇi.","<b>Tāhaṃ buddhassa pādāsi</b>nti ahaṃ taṃ aloṇapaṇṇaṃ tassa buddhassa adāsinti attho."],"lineRefs":[["tha-ap260:1"],["tha-ap260:1"],["tha-ap260:1"],["tha-ap260:1"],["tha-ap260:1"]]}],"wordLinks":[["tha-ap260:1.3","aloṇapaṇṇabhakkhomhī",0,0],["tha-ap260:1.3","