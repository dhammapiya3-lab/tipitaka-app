{"suttaId":"an3.115","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1073,1075],"vripara":"116"},"segments":{"an3.115:0.3":"Appameyyasuttaṃ","an3.115:1.1":"“Tayome, bhikkhave, puggalā santo saṃvijjamānā lokasmiṃ.","an3.115:1.2":"Katame tayo?","an3.115:1.3":"Suppameyyo, duppameyyo, appameyyo.","an3.115:1.4":"Katamo ca, bhikkhave, puggalo suppameyyo?","an3.115:1.5":"Idha, bhikkhave, ekacco puggalo uddhato hoti unnaḷo capalo mukharo vikiṇṇavāco muṭṭhassati asampajāno asamāhito vibbhantacitto pākatindriyo.","an3.115:1.6":"Ayaṃ vuccati, bhikkhave, puggalo suppameyyo.","an3.115:2.1":"“Katamo ca, bhikkhave, puggalo duppameyyo?","an3.115:2.2":"Idha, bhikkhave, ekacco puggalo anuddhato hoti anunnaḷo acapalo amukharo avikiṇṇavāco upaṭṭhitassati sampajāno samāhito ekaggacitto saṃvutindriyo.","an3.115:2.3":"Ayaṃ vuccati, bhikkhave, puggalo duppameyyo.","an3.115:3.1":"“Katamo ca, bhikkhave, puggalo appameyyo?","an3.115:3.2":"Idha, bhikkhave, bhikkhu arahaṃ hoti khīṇāsavo.","an3.115:3.3":"Ayaṃ vuccati, bhikkhave, puggalo appameyyo.","an3.115:3.4":"Ime kho, bhikkhave, tayo puggalā santo saṃvijjamānā lokasmin”ti.","an3.115:3.5":"Tatiyaṃ."},"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":908,"to":908,"paras":[{"para":908,"vripara":"116","refs":["an3.115:1"],"lines":["Tatiye sukhena metabboti <b>suppameyyo</b>.","Dukkhena metabboti <b>duppameyyo</b>.","Pametuṃ na sakkotīti <b>appameyyo.</b>","<b>Unnaḷo</b>ti uggatanaḷo, tucchamānaṃ ukkhipitvā ṭhitoti attho.","<b>Capalo</b>ti pattamaṇḍanādinā cāpallena samannāgato.","<b>Mukharo</b>ti mukhakharo.","<b>Vikiṇṇavāco</b>ti asaññatavacano.","<b>Asamāhito</b>ti cittekaggatārahito.","<b>Vibbhantacitto</b>ti bhantacitto bhantagāvibhantamigasappaṭibhāgo.","<b>Pākatindriyo</b>ti vivaṭindriyo.","Sesamettha uttānamevāti."],"lineRefs":[["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"]]}],"wordLinks":[["an3.115:1.3","suppameyyo",0,0],["an3.115:1.4","suppameyyo",0,0],["an3.115:1.6","suppameyyo",0,0],["an3.115:1.3","duppameyyo",0,1],["an3.115:1.3","appameyyo",0,2],["an3.115:1.5","unnaḷo",0,3],["an3.115:1.5","capalo",0,4],["an3.115:1.5","mukharo",0,5],["an3.115:1.5","vikiṇṇavāco",0,6],["an3.115:1.5","asamāhito",0,7],["an3.115:1.5","vibbhantacitto",0,8],["an3.115:1.5","pākatindriyo",0,9]]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":927,"to":928,"paras":[{"para":927,"vripara":"116","refs":["an3.115:1"],"lines":["Tatiye <b>sukhena metabbo</b>ti yathā parittassa udakassa sukhena pamāṇaṃ gayhati, evameva “uddhato”tiādinā yathāvuttehi aguṇaṅgehi samannāgatassa sukhena pamāṇaṃ gayhatīti, sukhena metabbo.","<b>Dukkhena metabbo</b>ti yathā mahāsamuddassa dukkhena pamāṇaṃ gayhati, evameva “anuddhato”tiādinā dassitehi guṇaṅgehi samannāgatassa dukkhena pamāṇaṃ gayhati,“anāgāmī nu kho khīṇāsavo nu kho”ti vattabbataṃ gacchati, tenesa dukkhena metabbo.","<b>Pametuṃ na sakkotī</b>ti yathā ākāsassa na sakkā pamāṇaṃ gahetuṃ, evaṃ khīṇāsavassa, tenesa pametuṃ na sakkāti <b>appameyyo</b>."],"lineRefs":[["an3.115:1"],["an3.115:1"],["an3.115:1"]]},{"para":928,"vripara":null,"refs":["an3.115:1"],"lines":["Sārābhāvena tucchattā naḷo viya naḷo, mānoti āha <b>“unnaḷoti uggatanaḷo”</b>ti, uṭṭhitatucchamānoti vuttaṃ hoti.","Tenāha <b>“tucchamānaṃ ukkhipitvā ṭhitoti attho”</b>ti.","Mano hi seyyassa seyyoti sadisoti ca pavattiyā visesato tuccho.","<b>Cāpallenā</b>ti capalabhāvena, taṇhāloluppenāti attho.","<b>Mukharo</b>ti mukhena pharuso, pharusavācoti attho.","<b>Vikiṇṇavāco</b>ti visaṭavacano samphappalāpitāya apariyantavacano.","Tenāha <b>“asaññatavacano”</b>ti, divasampi niratthakavacanaṃ palāpīti vuttaṃ hoti.","<b>Cittekaggatārahito</b>ti upacārappanāsamādhirahito caṇḍasote baddhanāvā viya anavaṭṭhitakiriyo.","<b>Bhantacitto</b>ti anavaṭṭhitacitto paṇṇāruḷhavālamigasadiso.","<b>Vivaṭindriyo</b>ti saṃvarābhāvena gihikāle viya asaṃvutacakkhādiindriyo."],"lineRefs":[["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"],["an3.115:1"]]}],"wordLinks":[["an3.115:1.3","appameyyo",0,2],["an3.115:1.5","mukharo",1,4],["an3.115:1.5","vikiṇṇavāco",1,5],["an3.115:1.5","bhantacitto",1,8]]}}
