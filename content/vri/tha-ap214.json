{"suttaId":"tha-ap214","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7620,7635],"vripara":"6"},"segments":{"tha-ap214:0.3":"Pānadhidāyakattheraapadānaṃ","tha-ap214:1.1":"“Āraññikassa isino,","tha-ap214:1.2":"cirarattatapassino [jhāyino, mettacittatapassino (syā.)];","tha-ap214:1.3":"Buddhassa [dhammassa (syā. ka.)] bhāvitattassa,","tha-ap214:1.4":"adāsiṃ pānadhiṃ ahaṃ. 7.","tha-ap214:2.1":"“Tena kammena dvipadinda,","tha-ap214:2.2":"lokajeṭṭha narāsabha;","tha-ap214:2.3":"Dibbayānaṃ [sabbaṃ yānaṃ (sī.)] anubhomi,","tha-ap214:2.4":"pubbakammassidaṃ phalaṃ. 8.","tha-ap214:3.1":"“Catunnavute ito kappe,","tha-ap214:3.2":"yaṃ kammamakariṃ tadā;","tha-ap214:3.3":"Duggatiṃ nābhijānāmi,","tha-ap214:3.4":"pānadhissa idaṃ phalaṃ. 9.","tha-ap214:4.1":"“Sattasattatito kappe,","tha-ap214:4.2":"aṭṭha āsiṃsu khattiyā;","tha-ap214:4.3":"Suyānā nāma nāmena,","tha-ap214:4.4":"cakkavattī mahabbalā. 10.","tha-ap214:5.1":"“Paṭisambhidā catasso…pe…","tha-ap214:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap214:6.1":"Itthaṃ sudaṃ āyasmā pānadhidāyako thero imā gāthāyo abhāsitthāti.","tha-ap214:7.1":"Pānadhidāyakattherassāpadānaṃ dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
