{"suttaId":"thag2.42","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1067,1073],"vripara":"203"},"segments":{"thag2.42:0.4":"Dhammapālattheragāthā","thag2.42:1.1":"“Yo have daharo bhikkhu, yuñjati buddhasāsane;","thag2.42:1.3":"Jāgaro sa hi suttesu [patisuttesu (sī. ka.)], amoghaṃ tassa jīvitaṃ.","thag2.42:2.1":"“Tasmā saddhañca sīlañca, pasādaṃ dhammadassanaṃ;","thag2.42:2.3":"Anuyuñjetha medhāvī, saraṃ buddhāna sāsanan”ti.","thag2.42:2.5":"… Dhammapālo thero …."},"attha":null,"tika":null}
