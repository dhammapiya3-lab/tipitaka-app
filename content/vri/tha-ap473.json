{"suttaId":"tha-ap473","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1536,1559],"vripara":"1"},"segments":{"tha-ap473:0.3":"Naḷamāliyattheraapadānaṃ","tha-ap473:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap473:1.2":"āhutīnaṃ paṭiggahaṃ;","tha-ap473:1.3":"Vipinaggena gacchantaṃ,","tha-ap473:1.4":"addasaṃ lokanāyakaṃ.","tha-ap473:2.1":"“Naḷamālaṃ gahetvāna,","tha-ap473:2.2":"nikkhamanto ca tāvade;","tha-ap473:2.3":"Tatthaddasāsiṃ sambuddhaṃ,","tha-ap473:2.4":"oghatiṇṇamanāsavaṃ.","tha-ap473:3.1":"“Pasannacitto sumano,","tha-ap473:3.2":"naḷamālamapūjayiṃ;","tha-ap473:3.3":"Dakkhiṇeyyaṃ mahāvīraṃ,","tha-ap473:3.4":"sabbalokānukampakaṃ.","tha-ap473:4.1":"“Ekatiṃse ito kappe,","tha-ap473:4.2":"yaṃ mālamabhiropayiṃ [pupphamabhiropayiṃ (sī. syā. pī.)];","tha-ap473:4.3":"Duggatiṃ nābhijānāmi,","tha-ap473:4.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap473:5.1":"“Kilesā jhāpitā mayhaṃ,","tha-ap473:5.2":"bhavā sabbe samūhatā;","tha-ap473:5.3":"Nāgova bandhanaṃ chetvā,","tha-ap473:5.4":"viharāmi anāsavo.","tha-ap473:6.1":"“Svāgataṃ vata me āsi,","tha-ap473:6.2":"mama buddhassa santike;","tha-ap473:6.3":"Tisso vijjā anuppattā,","tha-ap473:6.4":"kataṃ buddhassa sāsanaṃ.","tha-ap473:7.1":"“Paṭisambhidā catasso,","tha-ap473:7.2":"vimokkhāpi ca aṭṭhime;","tha-ap473:7.3":"Chaḷabhiññā sacchikatā,","tha-ap473:7.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap473:8.1":"Itthaṃ sudaṃ āyasmā naḷamāliyo thero imā gāthāyo Abhāsitthāti.","tha-ap473:9.1":"Naḷamāliyattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
