{"suttaId":"an4.213","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1706,1707],"vripara":"213"},"segments":{"an4.213:0.3":"Akataññutāsuttaṃ","an4.213:1.1":"“Catūhi, bhikkhave, dhammehi samannāgato yathābhataṃ nikkhitto evaṃ niraye.","an4.213:1.2":"Katamehi catūhi?","an4.213:1.3":"Kāyaduccaritena, vacīduccaritena, manoduccaritena, akataññutā akataveditā [akataññutāakataveditāya (sī.)] –","an4.213:1.4":"imehi kho, bhikkhave, catūhi dhammehi samannāgato yathābhataṃ nikkhitto evaṃ niraye.","an4.213:2.1":"“Catūhi, bhikkhave, dhammehi samannāgato yathābhataṃ nikkhitto evaṃ sagge.","an4.213:2.2":"Katamehi catūhi?","an4.213:2.3":"Kāyasucaritena, vacīsucaritena, manosucaritena, kataññutākataveditā [kataññutākataveditāya (sī.)] –","an4.213:2.4":"imehi kho, bhikkhave, catūhi dhammehi samannāgato yathābhataṃ nikkhitto evaṃ sagge”ti.","an4.213:2.5":"Tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1667,"to":1667,"paras":[{"para":1667,"vripara":"213","refs":["an4.213:1"],"lines":["Tatiye <b>akataññutā akataveditā</b>ti akataññutāya akataveditāya.","Ubhayampetaṃ atthato ekameva.","Sukkapakkhepi eseva nayo. 4-7."],"lineRefs":[["an4.213:1"],["an4.213:1"],["an4.213:1"]]}],"wordLinks":[["an4.213:1.3","akataññutā akataveditā",0,0]]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1868,"to":1869,"paras":[{"para":1868,"vripara":"211-220","refs":["an4.213:1"],"lines":["Dutiyo parisāvaggo uttānatthoyeva. (23) 3."],"lineRefs":[["an4.213:1"]]},{"para":1869,"vripara":null,"refs":["an4.213:1"],"lines":["Duccaritavaggavaṇṇanā 221-231."],"lineRefs":[["an4.213:1"]]}],"wordLinks":[]},"tika2":null}
