{"suttaId":"an4.148","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1209,1209],"vripara":"148"},"segments":{"an4.148:0.3":"Duccaritasuttaṃ","an4.148:1.1":"“Cattārimāni, bhikkhave, vacīduccaritāni.","an4.148:1.2":"Katamāni cattāri?","an4.148:1.3":"Musāvādo, pisuṇā vācā, pharusā vācā, samphappalāpo – imāni kho, bhikkhave, cattāri vacīduccaritānī”ti.","an4.148:1.5":"Aṭṭhamaṃ."},"attha":null,"tika":null}
