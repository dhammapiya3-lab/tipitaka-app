{"suttaId":"sn2.22","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1147,1159],"vripara":"103"},"segments":{"sn2.22:0.3":"Khemasuttaṃ","sn2.22:1.1":"Ekamantaṃ ṭhito kho khemo devaputto bhagavato santike imā gāthāyo abhāsi –","sn2.22:2.1":"“Caranti bālā dummedhā, amitteneva attanā;","sn2.22:2.3":"Karontā pāpakaṃ kammaṃ, yaṃ hoti kaṭukapphalaṃ.","sn2.22:3.1":"“Na taṃ kammaṃ kataṃ sādhu, yaṃ katvā anutappati;","sn2.22:3.3":"Yassa assumukho rodaṃ, vipākaṃ paṭisevati.","sn2.22:4.1":"“Tañca kammaṃ kataṃ sādhu, yaṃ katvā nānutappati;","sn2.22:4.3":"Yassa patīto sumano, vipākaṃ paṭisevati.","sn2.22:5.1":"“Paṭikacceva [paṭigacceva (sī.)] taṃ kayirā, yaṃ jaññā hitamattano;","sn2.22:5.3":"Na sākaṭikacintāya, mantā dhīro parakkame.","sn2.22:6.1":"“Yathā sākaṭiko maṭṭhaṃ [panthaṃ (sī.), pasatthaṃ (syā. kaṃ.)], samaṃ hitvā mahāpathaṃ;","sn2.22:6.3":"Visamaṃ maggamāruyha, akkhacchinnova jhāyati.","sn2.22:7.1":"“Evaṃ dhammā apakkamma, adhammamanuvattiya;","sn2.22:7.3":"Mando maccumukhaṃ patto, akkhacchinnova jhāyatī”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":556,"to":556,"paras":[{"para":556,"vripara":"103","refs":["sn2.22:5","sn2.22:6"],"lines":["Dutiye <b>paṭikaccevā</b>ti paṭhamaṃyeva.","<b>Akkhacchinnovajhāyatī</b>ti akkhacchinno avajhāyati, balavacintanaṃ cinteti.","Dutiyagāthāya <b>akkhacchinnovā</b>ti akkhacchinno viya.","Dutiyaṃ."],"lineRefs":[["sn2.22:5"],["sn2.22:6"],["sn2.22:6"],["sn2.22:6"]]}],"wordLinks":[["sn2.22:5.1","paṭikaccevā",0,0],["sn2.22:6.3","akkhacchinnovajhāyatī",0,1],["sn2.22:6.3","akkhacchinnovā",0,2]]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":715,"to":717,"paras":[{"para":715,"vripara":"103","refs":["sn2.22:1"],"lines":["<b>Paṭhamaṃyevā</b>ti jarāmaraṇādibhāvato pageva.","<b>Balavacintanaṃ cintetī</b>ti yathā sākaṭiko ajānitvā visame magge sakaṭaṃ pājento akkhe chinne patikātuṃ avisahanto dukkhī dummano balavacintanaṃ cinteti, mahantaṃ cittasantāpaṃ pāpuṇāti, evaṃ adhammavādī maccumukhaṃ patto balavacittasantāpaṃ pāpuṇāti, tasmā dhammacariyāya nappamajjitabbanti."],"lineRefs":[["sn2.22:1"],["sn2.22:1"]]},{"para":716,"vripara":null,"refs":["sn2.22:1"],"lines":["Khemasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn2.22:1"]]},{"para":717,"vripara":null,"refs":["sn2.22:1"],"lines":["Serīsuttavaṇṇanā"],"lineRefs":[["sn2.22:1"]]}],"wordLinks":[]},"tika2":null}
