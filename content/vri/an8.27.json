{"suttaId":"an8.27","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-viii","vriCode":"s0404m1.mul","paras":[308,308],"vripara":"27"},"segments":{"an8.27:0.3":"Paṭhamabalasuttaṃ","an8.27:1.1":"“Aṭṭhimāni, bhikkhave, balāni.","an8.27:1.2":"Katamāni aṭṭha?","an8.27:1.3":"Ruṇṇabalā, bhikkhave, dārakā, kodhabalā mātugāmā, āvudhabalā corā, issariyabalā rājāno, ujjhattibalā bālā, nijjhattibalā paṇḍitā, paṭisaṅkhānabalā bahussutā, khantibalā samaṇabrāhmaṇā –","an8.27:1.4":"imāni kho, bhikkhave, aṭṭha balānī”ti.","an8.27:1.5":"Sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Mp-viii","bookName":"Aṭṭhakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":116,"to":116,"paras":[{"para":116,"vripara":"27","refs":["an8.27:1"],"lines":["Sattame <b>ujjhattibalā</b>ti ujjhānabalā.","Bālānañhi “yaṃ asuko idañcidañca āha, maṃ so āha, na añña”nti evaṃ ujjhānameva balaṃ.","<b>Nijjhattibalā</b>ti “na idaṃ evaṃ, evaṃ nāmeta”nti atthānatthanijjhāpanaṃyeva balaṃ.","<b>Paṭisaṅkhānabalā</b>ti paccavekkhaṇabalā.","<b>Khantibalā</b>ti adhivāsanabalā. 8."],"lineRefs":[["an8.27:1"],["an8.27:1"],["an8.27:1"],["an8.27:1"],["an8.27:1"]]}],"wordLinks":[["an8.27:1.3","ujjhattibalā",0,0],["an8.27:1.3","nijjhattibalā",0,2],["an8.27:1.3","paṭisaṅkhānabalā",0,3],["an8.27:1.3","khantibalā",0,4]]},"tika":{"book":"Mp-t-viii","bookName":"Aṭṭhakanipāta-ṭīkā","vriCode":"s0404t.tik","from":128,"to":130,"paras":[{"para":128,"vripara":"21-27","refs":["an8.27:1"],"lines":["Tatiyassa paṭhamadutiyesu natthi vattabbaṃ.","Tatiye “hatthago”ti vattabbe <b>“hatthako”</b>ti vuttaṃ.","So hi rājapurisānaṃ hatthato yakkhassa hatthaṃ, yakkhassa hatthato bhagavato hatthaṃ, bhagavato hatthato puna rājapurisānaṃ hatthaṃ gatattā nāmato <b>hatthako āḷavako</b>ti jāto.","Tenāha <b>“āḷavakayakkhassa hatthato hatthehi sampaṭicchitattā hatthakoti laddhanāmo rājakumāro”</b>ti.","Catutthādīni uttānatthāneva."],"lineRefs":[["an8.27:1"],["an8.27:1"],["an8.27:1"],["an8.27:1"],["an8.27:1"]]},{"para":129,"vripara":null,"refs":["an8.27:1"],"lines":["Paṭhamauggasuttādivaṇṇanā niṭṭhitā. 8."],"lineRefs":[["an8.27:1"]]},{"para":130,"vripara":null,"refs":["an8.27:1"],"lines":["Dutiyabalasuttavaṇṇanā 28."],"lineRefs":[["an8.27:1"]]}],"wordLinks":[]},"tika2":null}
