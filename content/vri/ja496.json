{"suttaId":"ja496","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[8058,8122],"vripara":"270"},"segments":{"ja496:0.4":"Bhikkhāparamparajātakaṃ (13)","ja496:1.1":"Sukhumālarūpaṃ disvā [disvāna (ka. sī. aṭṭha.)],","ja496:1.2":"raṭṭhā vivanamāgataṃ;","ja496:1.3":"Kūṭāgāravarūpetaṃ,","ja496:1.4":"mahāsayanamupāsitaṃ [mupocitaṃ (bahūsu)]. 271.","ja496:2.1":"Tassa te pemakenāhaṃ,","ja496:2.2":"adāsiṃ vaḍḍhamodanaṃ [baddhamodanaṃ (sī. pī.)];","ja496:2.3":"Sālīnaṃ vicitaṃ bhattaṃ,","ja496:2.4":"suciṃ maṃsūpasecanaṃ. 272.","ja496:3.1":"Taṃ tvaṃ bhattaṃ paṭiggayha,","ja496:3.2":"brāhmaṇassa adāsayi [adāpayi (sī. syā. pī.)];","ja496:3.3":"Attānaṃ [attanā (pī. aṭṭha. pāṭhantaraṃ)] anasitvāna,","ja496:3.4":"koyaṃ dhammo namatthu te. 273.","ja496:4.1":"Ācariyo brāhmaṇo mayhaṃ,","ja496:4.2":"kiccākiccesu byāvaṭo [vāvaṭo (ka.)];","ja496:4.3":"Garu ca āmantanīyo [āmantaṇīyo (sī. pī.)] ca,","ja496:4.4":"dātumarahāmi bhojanaṃ. 274.","ja496:5.1":"Brāhmaṇaṃ dāni pucchāmi,","ja496:5.2":"gotamaṃ rājapūjitaṃ;","ja496:5.3":"Rājā te bhattaṃ pādāsi,","ja496:5.4":"suciṃ maṃsūpasecanaṃ. 275.","ja496:6.1":"Taṃ tvaṃ bhattaṃ paṭiggayha,","ja496:6.2":"isissa bhojanaṃ adā;","ja496:6.3":"Akhettaññūsi dānassa,","ja496:6.4":"koyaṃ dhammo namatthu te. 276.","ja496:7.1":"Bharāmi putta [putte (sī. pī.)] dāre ca,","ja496:7.2":"gharesu gadhito [gathito (sī. pī.)] ahaṃ;","ja496:7.3":"Bhuñje mānusake kāme,","ja496:7.4":"anusāsāmi rājino. 277.","ja496:8.1":"Āraññikassa [āraññakassa (sī. pī.)] isino,","ja496:8.2":"cirarattaṃ tapassino;","ja496:8.3":"Vuḍḍhassa bhāvitattassa,","ja496:8.4":"dātumarahāmi bhojanaṃ. 278.","ja496:9.1":"Isiñca dāni pucchāmi,","ja496:9.2":"kisaṃ dhamanisanthataṃ;","ja496:9.3":"Parūḷhakacchanakhalomaṃ,","ja496:9.4":"paṅkadantaṃ rajassiraṃ. 279.","ja496:10.1":"Eko araññe viharasi [vihāsi (ka.)],","ja496:10.2":"nāvakaṅkhasi jīvitaṃ;","ja496:10.3":"Bhikkhu kena tayā seyyo,","ja496:10.4":"yassa tvaṃ bhojanaṃ adā. 280.","ja496:11.1":"Khaṇantālukalambāni [khaṇamālukalambāni (syā. ka.)],","ja496:11.2":"bilālitakkalāni ca [biḷālitakkaḷāni ca (sī. pī.)];","ja496:11.3":"Dhunaṃ sāmākanīvāraṃ,","ja496:11.4":"saṅghāriyaṃ pasāriyaṃ [saṃhāriyaṃ pahāriyaṃ (syā.), saṃsāriyaṃ pasāriyaṃ (ka.)]. 281.","ja496:12.1":"Sākaṃ bhisaṃ madhuṃ maṃsaṃ,","ja496:12.2":"badarāmalakāni ca;","ja496:12.3":"Tāni āharitvā [āhatva (sī. syā.)] bhuñjāmi,","ja496:12.4":"atthi me so pariggaho. 282.","ja496:13.1":"Pacanto apacantassa,","ja496:13.2":"amamassa sakiñcano [akiñcano (ka.)];","ja496:13.3":"Anādānassa sādāno,","ja496:13.4":"dātumarahāmi bhojanaṃ. 283.","ja496:14.1":"Bhikkhuñca dāni pucchāmi,","ja496:14.2":"tuṇhīmāsīna subbataṃ;","ja496:14.3":"Isi te bhattaṃ pādāsi,","ja496:14.4":"suciṃ maṃsūpasecanaṃ. 284.","ja496:15.1":"Taṃ tvaṃ bhattaṃ paṭiggayha,","ja496:15.2":"tuṇhī bhuñjasi ekako;","ja496:15.3":"Nāññaṃ kañci [kiñci (ka.)] nimantesi,","ja496:15.4":"koyaṃ dhammo namatthu te. 285.","ja496:16.1":"Na pacāmi na pācemi,","ja496:16.2":"na chindāmi na chedaye;","ja496:16.3":"Taṃ maṃ akiñcanaṃ ñatvā,","ja496:16.4":"sabbapāpehi ārataṃ. 286.","ja496:17.1":"Vāmena bhikkhamādāya,","ja496:17.2":"dakkhiṇena kamaṇḍaluṃ;","ja496:17.3":"Isi me bhattaṃ pādāsi,","ja496:17.4":"suciṃ maṃsūpasecanaṃ. 287.","ja496:18.1":"Ete hi dātumarahanti,","ja496:18.2":"samamā sapariggahā;","ja496:18.3":"Paccanīkamahaṃ maññe,","ja496:18.4":"yo dātāraṃ nimantaye. 288.","ja496:19.1":"Atthāya vata me ajja,","ja496:19.2":"idhāgacchi rathesabho;","ja496:19.3":"Sohaṃ ajja pajānāmi [ito pubbe na jānāmi (sī. pī.)],","ja496:19.4":"yattha dinnaṃ mahapphalaṃ. 289.","ja496:20.1":"Raṭṭhesu giddhā rājāno,","ja496:20.2":"kiccākiccesu brāhmaṇā;","ja496:20.3":"Isī mūlaphale giddhā,","ja496:20.4":"vippamuttā ca bhikkhavoti.","ja496:21.1":"Bhikkhāparamparajātakaṃ terasamaṃ.","ja496:23.1":"Tassuddānaṃ –","ja496:24.1":"Suva kinnara mukka kharājinaso,","ja496:24.2":"bhisajāta mahesi kapotavaro;","ja496:24.3":"Atha mora satacchaka vāṇijako,","ja496:24.4":"atha rāja sabrāhmaṇa bhikkhaparanti. Pakiṇṇakanipātaṃ niṭṭhitaṃ. 15."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iv","bookName":"Jātaka-aṭṭhakathā-4","vriCode":"s0513a4.att","from":3779,"to":3787,"paras":[{"para":3779,"vripara":null,"refs":["ja496:18"],"lines":["<b>Tuṇhīmāsīna</b>nti kiñci avatvā nisinnaṃ.","<b>Akiñcana</b>nti rāgakiñcanādīhi rahitaṃ.","<b>Ārata</b>nti virataṃ sabbapāpāni pahāya ṭhitaṃ.","<b>Kamaṇḍalu</b>nti kuṇḍikaṃ.","<b>Ete hī</b>ti ete rājādayo tayo janāti hatthaṃ pasāretvā te niddisanto evamāha.","<b>Dātumarahantī</b>ti mādisassa dātuṃ arahanti.","<b>Paccanīka</b>nti paccanīkapaṭipadaṃ.","Dāyakassa hi nimantanaṃ ekavīsatiyā anesanāsu aññatarāya piṇḍapātapariyesanāya jīvikakappanasaṅkhātā micchājīvapaṭipatti nāma hoti."],"lineRefs":[["ja496:18"],["ja496:18"],["ja496:18"],["ja496:18"],["ja496:18"],["ja496:18"],["ja496:18"],["ja496:18"]]},{"para":3780,"vripara":null,"refs":["ja496:18"],"lines":["Tassa vacanaṃ sutvā kuṭumbiko attamano dve osānagāthā abhāsi – 288."],"lineRefs":[["ja496:18"]]},{"para":3782,"vripara":"288","refs":["ja496:18"],"lines":["“Atthāya vata me ajja, idhāgacchi rathesabho;"],"lineRefs":[["ja496:18"]]},{"para":3783,"vripara":null,"refs":["ja496:18"],"lines":["Sohaṃ ajja pajānāmi, yattha dinnaṃ mahapphalaṃ. 289."],"lineRefs":[["ja496:18"]]},{"para":3785,"vripara":"289","refs":["ja496:18"],"lines":["“Raṭṭhesu giddhā rājāno, kiccākiccesu brāhmaṇā;"],"lineRefs":[["ja496:18"]]},{"para":3786,"vripara":null,"refs":["ja496:18"],"lines":["Isī mūlaphale giddhā, vippamuttā ca bhikkhavo”ti."],"lineRefs":[["ja496:18"]]},{"para":3787,"vripara":null,"refs":["ja496:18","ja496:20"],"lines":["Tattha <b>rathesabho</b>ti rājānaṃ sandhāyāha.","<b>Kiccākiccesū</b>ti rañño kiccakaraṇīyesu.","<b>Bhikkhavo</b>ti paccekabuddhā bhikkhavo pana sabbabhavehi vippamuttā."],"lineRefs":[["ja496:18"],["ja496:20"],["ja496:20"]]}],"wordLinks":[["ja496:18.1","ete hī",0,4],["ja496:18.1","dātumarahantī",0,5],["ja496:18.3","paccanīkaṃ",0,6],["ja496:20.1","kiccākiccesū",6,1],["ja496:20.3","bhikkhavo",6,2]],"after":[{"para":3788,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Paccekabuddho tassa dhammaṃ desetvā sakaṭṭhānameva gato, tathā tāpaso.","Rājā pana katipāhaṃ tassa santike vasitvā bārāṇasimeva gato."]},{"para":3789,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā “na, bhikkhave, idāneva piṇḍapāto yathānucchavikaṃ gacchati, pubbepi gatoyevā”ti vatvā jātakaṃ samodhānesi –","“tadā kuṭumbiko dhammaratanassa sakkārakārako kuṭumbiko ahosi, rājā ānando, purohito sāriputto, himavantatāpaso pana ahameva ahosi”nti."]},{"para":3790,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Bhikkhāparamparajātakavaṇṇanā terasamā."]},{"para":3791,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Jātakuddānaṃ –"]},{"para":3792,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Kedāraṃ candakinnarī, ukkusuddālabhisakaṃ;"]},{"para":3793,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Suruci pañcuposathaṃ, mahāmorañca tacchakaṃ."]},{"para":3794,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Mahāvāṇija sādhinaṃ, dasabrāhmaṇajātakaṃ;"]},{"para":3795,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Bhikkhāparamparāpi ca, terasāni pakiṇṇake."]},{"para":3796,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Pakiṇṇakanipātavaṇṇanā niṭṭhitā. 15."]}]},"tika":{"book":"Ja-ṭ-iii","bookName":"Jātaka-abhinavaṭīkā-3","vriCode":"","from":569,"to":577,"paras":[{"para":569,"vripara":null,"refs":["ja496:1"],"lines":["13-bhikkhāparamparajātakavaṇṇanā (496)"],"lineRefs":[["ja496:1"]]},{"para":570,"vripara":null,"refs":["ja496:1"],"lines":["<b>pasanno</b>ti idaṃ saddhāsampannoti padasseva atthadīpakaṃ.","<b>theropi “ayaṃ sakkāro dhammaratanassa kato.","na mayhaṃ anucchaviko.","agga-sāvakassa dhammasenāpatissa anucchaviko”ti cintetvā piṇḍapātañca vatthāni ca vihāraṃ haritvā sāriputtattherassa adāsī</b>ti ettha kasmā pana sāriputtattherassa adāsi.","yadi hi sabbaseṭṭhassa dātuṃ icchati.","evaṃ sati sammāsambuddhasseva dātabbo.","udāhu sace attanā seṭṭhatarānaṃ dātuṃ icchati.","mahāmoggalānattherādīnampi dātabboti.","vuccate.","yasmā hi ānandatthero sāriputtattherena ativiya vissāsiko sampiyo ca manāpo ca ahosi.","tasmā attanā seṭṭhataresupi vijjamānesu sāriputtattherasseva adāsi.","vuttañcetaṃ - samantapāsādikāya nāma vinayaṭṭhakathāya “āyasmato sāriputtassa dātukāmo hotī”ti."],"lineRefs":[["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"]]},{"para":571,"vripara":null,"refs":["ja496:1"],"lines":["āyasmā kira ānando bhagavantaṃ ṭhapetvā añño evarūpo guṇavisiṭṭho puggalo natthīti guṇabahumānena āyasmantaṃ sāriputtattheraṃ atimamāyati.","so sadāpi manāpacīvaraṃ labhitvā rajitvā kappabinduṃ datvā therasseva deti.","purebhatte paṇītaṃ yāgukhajjakaṃ vā piṇḍapātaṃ vā labhitvāpi therasseva deti.","pacchābhatte madhuphāṇitādīni labhitvāpi therasseva deti.","upaṭṭhākakulehi dārake nikkhamitvā pabbājetvā therassa santike upajjhaṃ gāhāpetvā sayaṃ anussāvanakammaṃ karoti.","āyasmāpi sāriputto pitukattabbaṃ kiccaṃ nāma jeṭṭhaputtassa bhāro.","taṃ mayā bhagavato kattabbakiccaṃ ānando karoti.","ahaṃ ānandaṃ nissāya appossukko viharituṃ labhāmīti āyasmantaṃ ānandaṃ ativiya mamāyati.","sopi manāpacīvaraṃ labhitvā ānandattherasseva detīti sabbaṃ purimasadisameva.","evaṃ guṇabahumānena mamāyanto.","tadā uppannampi taṃ cīvaraṃ āyasmato sāriputtassa dātukāmo hotīti veditabbo.","<b>anucchaviko na hotī</b>ti anulomiko na hoti.","manāpo na hotīti attho."],"lineRefs":[["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"]]},{"para":572,"vripara":null,"refs":["ja496:1"],"lines":["<b>suñño viyā</b>ti guṇavirahitattā suñño viya hoti.","<b>sukhumā-lasarīra</b>nti siniddhasarīraṃ.","sukhume alanti sukhumālanti vacanattho.","<b>rājānaṃ gahetvā</b>ti [rājānaṃ gahetvā. chaṭṭha.] so rājānaṃ bhattapātiṃ gahetvā.","<b>brāhmaṇo taṃ gahetvā tāpasassa adāsī</b>ti brāhmaṇo tāpasassa santikaṃ gantvā vāmahatthena bhattapātiṃ gahetvā dakkhiṇahatthena kamaṇḍaluṃ gahetvā dakkhiṇodakaṃ datvā adāsīti sambandho veditabbo.","<b>kamaṇḍalu</b>nti ka-vuccati udakaṃ.","taṃ maṇḍaṃ pasannaṃ katvā lāti gaṇhātīti kamaṇḍalu.","kuṇḍikaṃ.","<b>kiñci [kañci. chaṭṭha.] anāpucchitvā</b>ti kiñci puggalaṃ bhatte na anāpucchitvā.","<b>vivana</b>nti viruḷhaṃ vanaṃ vivanaṃ.","tena sadisaṃ vivananti vacanattho veditabbo.","tenāha “vivananti nirudakāraññasadisaṃ imaṃ paccantaṃ āgata”nti.","<b>kūṭāgāravarenā</b>ti idaṃ rājanivesanaṃ sandhāya vuttaṃ.","<b>upocita</b>nti [upāsitaṃ. chaṭṭha.] upaücitaṃ.","nisinnanti attho.","upaïti kammappavacaniyena yogato mahāsayananti ettha bhūmatthe upayogavacanaṃ daṭṭhabbaṃ.","mahāsayane nisinnanti vuttaṃ hoti.","supaññattaṃ sirisayananti etthāpi esevanayo.","<b>vaḍḍhamodana</b>nti ettha vaḍḍha-uddharaṇeti dhātvatthavasena atthaṃ dassetuṃ “uddhamodana”nti [uttamodanaṃ. chaṭṭha.] vuttaṃ.","uddharitaṃ odananti attho.","<b>apagatakhaṇḍakāḷakehī</b>ti apagatakhaṇḍakehi ceva apagata-kāḷakehi ca.","<b>vicittataṇḍulehī</b>ti apagatakhaṇḍakāḷakattā manāpattā ca vicitrehi taṇḍulehi.","<b>adāsayī</b>ti ettha adāsīti vattabbe yakārā-gamavasena adāsayīti vuttaṃ.","<b>attāna</b>nti ettha karaṇatthe upayogavacananti āha “attānanti attanā”ti asa-bhakkhaṇeti vuttattā.","<b>anasi-tvānā</b>ti abhuñjitvānāti vuttaṃ."],"lineRefs":[["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"]]},{"para":573,"vripara":null,"refs":["ja496:1"],"lines":["<b>byāvaṭo</b>ti ettha punappunaṃ avanaṃ niyuñjananti byāvaṭo.","apubbo ava-niyuñjaneti dhātuto ṭapaccayavasena ādimhi ca vakārāgamavasena rūpasiddhi daṭṭhabbā.","athavā āvaṭanaṃ byāvaṭo.","āpubbo vaṭa-gatimhīti muddhajapathamakkharanta- dhātuto apaccayavasena ādimhi ca vakārāgamavasena rūpasiddhi daṭṭhabbā.","tena niyutto byāvaṭo ussukoti āha “byāvaṭoti ussuko”-ti.","<b>āmantetabbayuttako</b>ti tesu tesu kiccesu āmantituṃ yuttakoti attho.","<b>khettaññū</b>ti ettha dānassa ānubhāvoyeva khettaṃ nāma taṃ jānāti sīlenāti khettaññū.","na khettaññū akhettaññū.","akhettaññūti aluttasamāsavasena attho veditabboti āha “akhettaññūsīti nāhaṃ dānassa khettaṃ.","mayi dinnaṃ mahapphalaṃ na hotīti evaṃ attānaṃ dānassa akhettaṃ jānāsi maññetī”ti.","evaṃ dānassa khettaṃ jānāsīti ahaṃ maññāmīti sambandho."],"lineRefs":[["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"]]},{"para":574,"vripara":null,"refs":["ja496:1"],"lines":["pāḷiyaṃ <b>gharesu gadhito</b>ti gharesu ahaṃ giddho hutvā.","<b>bhuñje mānusake kāme</b>ti mānusake kāme bhuñjitvā.","rājino anusāsā-mīti attho.","<b>evaṃ attano aguṇaṃ- -kathetvā</b>ti evaṃ bharāmi puttadāre cāti ādinā attano aguṇaṃ kathayitvā.","attano aguṇaṃ gahetvā-tīpi pāṭho.","<b>sīlādiguṇapariyesakassā</b>ti iminā sīlādiguṇe esatīti isīti vacanatthaṃ dasseti.","<b>paṇḍitaguṇavuḍḍhassā</b>ti [paṇḍitassa guṇavuḍḍhassa. chaṭṭha.] paṇḍita-bhāvena guṇato vuḍḍhassa.","pāḷiyaṃ <b>bhāvitattassā</b>ti bhāvitacittassa.","<b>dhamanisanthata</b>nti pariyādinnamaṃsalohitattā sirājāleneva santharitaṃ.","<b>parūḷhakaccha</b>nti virūḷhalomakacchaṃ.","<b>ālūni cevā</b>ti ālūva nāmakā.","ekā latā jātiyo.","yā <b>pinḥ</b>ti vuccanti.","<b>kalambānicā</b>ti evaṃ nāmakā ekāyeva latā jātiyo.","yā<b> kancvanḥ</b>iti vuccanti.","<b>bilāli-kandatakkalakandānī</b>ti ettha bilāli nāma masālu.","yo <b>myeku</b>iti vuccati.","tassa kandāni bilālikandāni nāma.","takkalaṃ nāma piṇḍālu.","yo <b>satveḥ</b>iti vuccati.","tassa kandāni takkalakandāni nāma.","<b>tuṇhīmāsīna</b>nti ettha tuṇhi asinanti padacchedo.","makāro āgamasandhijo.","āsinanti ca āpubbo sīda-gatyāvasāneti dhātvatthavasena atthaṃ dassetuṃ “tuṇhīmāsīnanti kiñci avatvā nisinna”nti.","<b>kuṇḍika</b>nti ghaṭaṃ.","taṃ hi kaṃ udeti patiṭṭhāpeti etthāti kuṇḍikanti vuccati.","niggahitāgamavasena pana rūpasiddhi veditabbā."],"lineRefs":[["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"]]},{"para":575,"vripara":null,"refs":["ja496:1"],"lines":["<b>kiccakaraṇīyesū</b>ti avassaṃ kattabbakiccaṃ.","itaraṃ karaṇīyaṃ.","paṭhamaṃ vā kattabbaṃ kiccaṃ.","pacchā kattabbaṃ karaṇīyaṃ khuddakaṃ vā kiccaṃ.","mahantaṃ karaṇīyanti."],"lineRefs":[["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"],["ja496:1"]]},{"para":576,"vripara":null,"refs":["ja496:1"],"lines":["bhikkhāparamparajātakaṃ."],"lineRefs":[["ja496:1"]]},{"para":577,"vripara":null,"refs":["ja496:1"],"lines":["iti asammohavilāsiniyā nāma jātakaṭṭhakathāya saṃvaṇṇanāya pakiṇṇakanipātavaṇṇanā niṭṭhitā."],"lineRefs":[["ja496:1"]]}],"wordLinks":[]},"tika2":null}
