{"suttaId":"ja496","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[8058,8122],"vripara":"270"},"segments":{"ja496:0.4":"Bhikkhāparamparajātakaṃ (13)","ja496:1.1":"Sukhumālarūpaṃ disvā [disvāna (ka. sī. aṭṭha.)],","ja496:1.2":"raṭṭhā vivanamāgataṃ;","ja496:1.3":"Kūṭāgāravarūpetaṃ,","ja496:1.4":"mahāsayanamupāsitaṃ [mupocitaṃ (bahūsu)].","ja496:2.1":"Tassa te pemakenāhaṃ,","ja496:2.2":"adāsiṃ vaḍḍhamodanaṃ [baddhamodanaṃ (sī. pī.)];","ja496:2.3":"Sālīnaṃ vicitaṃ bhattaṃ,","ja496:2.4":"suciṃ maṃsūpasecanaṃ.","ja496:3.1":"Taṃ tvaṃ bhattaṃ paṭiggayha,","ja496:3.2":"brāhmaṇassa adāsayi [adāpayi (sī. syā. pī.)];","ja496:3.3":"Attānaṃ [attanā (pī. aṭṭha. pāṭhantaraṃ)] anasitvāna,","ja496:3.4":"koyaṃ dhammo namatthu te.","ja496:4.1":"Ācariyo brāhmaṇo mayhaṃ,","ja496:4.2":"kiccākiccesu byāvaṭo [vāvaṭo (ka.)];","ja496:4.3":"Garu ca āmantanīyo [āmantaṇīyo (sī. pī.)] ca,","ja496:4.4":"dātumarahāmi bhojanaṃ.","ja496:5.1":"Brāhmaṇaṃ dāni pucchāmi,","ja496:5.2":"gotamaṃ rājapūjitaṃ;","ja496:5.3":"Rājā te bhattaṃ pādāsi,","ja496:5.4":"suciṃ maṃsūpasecanaṃ.","ja496:6.1":"Taṃ tvaṃ bhattaṃ paṭiggayha,","ja496:6.2":"isissa bhojanaṃ adā;","ja496:6.3":"Akhettaññūsi dānassa,","ja496:6.4":"koyaṃ dhammo namatthu te.","ja496:7.1":"Bharāmi putta [putte (sī. pī.)] dāre ca,","ja496:7.2":"gharesu gadhito [gathito (sī. pī.)] ahaṃ;","ja496:7.3":"Bhuñje mānusake kāme,","ja496:7.4":"anusāsāmi rājino.","ja496:8.1":"Āraññikassa [āraññakassa (sī. pī.)] isino,","ja496:8.2":"cirarattaṃ tapassino;","ja496:8.3":"Vuḍḍhassa bhāvitattassa,","ja496:8.4":"dātumarahāmi bhojanaṃ.","ja496:9.1":"Isiñca dāni pucchāmi,","ja496:9.2":"kisaṃ dhamanisanthataṃ;","ja496:9.3":"Parūḷhakacchanakhalomaṃ,","ja496:9.4":"paṅkadantaṃ rajassiraṃ.","ja496:10.1":"Eko araññe viharasi [vihāsi (ka.)],","ja496:10.2":"nāvakaṅkhasi jīvitaṃ;","ja496:10.3":"Bhikkhu kena tayā seyyo,","ja496:10.4":"yassa tvaṃ bhojanaṃ adā.","ja496:11.1":"Khaṇantālukalambāni [khaṇamālukalambāni (syā. ka.)],","ja496:11.2":"bilālitakkalāni ca [biḷālitakkaḷāni ca (sī. pī.)];","ja496:11.3":"Dhunaṃ sāmākanīvāraṃ,","ja496:11.4":"saṅghāriyaṃ pasāriyaṃ [saṃhāriyaṃ pahāriyaṃ (syā.), saṃsāriyaṃ pasāriyaṃ (ka.)].","ja496:12.1":"Sākaṃ bhisaṃ madhuṃ maṃsaṃ,","ja496:12.2":"badarāmalakāni ca;","ja496:12.3":"Tāni āharitvā [āhatva (sī. syā.)] bhuñjāmi,","ja496:12.4":"atthi me so pariggaho.","ja496:13.1":"Pacanto apacantassa,","ja496:13.2":"amamassa sakiñcano [akiñcano (ka.)];","ja496:13.3":"Anādānassa sādāno,","ja496:13.4":"dātumarahāmi bhojanaṃ.","ja496:14.1":"Bhikkhuñca dāni pucchāmi,","ja496:14.2":"tuṇhīmāsīna subbataṃ;","ja496:14.3":"Isi te bhattaṃ pādāsi,","ja496:14.4":"suciṃ maṃsūpasecanaṃ.","ja496:15.1":"Taṃ tvaṃ bhattaṃ paṭiggayha,","ja496:15.2":"tuṇhī bhuñjasi ekako;","ja496:15.3":"Nāññaṃ kañci [kiñci (ka.)] nimantesi,","ja496:15.4":"koyaṃ dhammo namatthu te.","ja496:16.1":"Na pacāmi na pācemi,","ja496:16.2":"na chindāmi na chedaye;","ja496:16.3":"Taṃ maṃ akiñcanaṃ ñatvā,","ja496:16.4":"sabbapāpehi ārataṃ.","ja496:17.1":"Vāmena bhikkhamādāya,","ja496:17.2":"dakkhiṇena kamaṇḍaluṃ;","ja496:17.3":"Isi me bhattaṃ pādāsi,","ja496:17.4":"suciṃ maṃsūpasecanaṃ.","ja496:18.1":"Ete hi dātumarahanti,","ja496:18.2":"samamā sapariggahā;","ja496:18.3":"Paccanīkamahaṃ maññe,","ja496:18.4":"yo dātāraṃ nimantaye.","ja496:19.1":"Atthāya vata me ajja,","ja496:19.2":"idhāgacchi rathesabho;","ja496:19.3":"Sohaṃ ajja pajānāmi [ito pubbe na jānāmi (sī. pī.)],","ja496:19.4":"yattha dinnaṃ mahapphalaṃ.","ja496:20.1":"Raṭṭhesu giddhā rājāno,","ja496:20.2":"kiccākiccesu brāhmaṇā;","ja496:20.3":"Isī mūlaphale giddhā,","ja496:20.4":"vippamuttā ca bhikkhavoti.","ja496:21.1":"Bhikkhāparamparajātakaṃ terasamaṃ.","ja496:23.1":"Tassuddānaṃ –","ja496:24.1":"Suva kinnara mukka kharājinaso,","ja496:24.2":"bhisajāta mahesi kapotavaro;","ja496:24.3":"Atha mora satacchaka vāṇijako,","ja496:24.4":"atha rāja sabrāhmaṇa bhikkhaparanti. Pakiṇṇakanipātaṃ niṭṭhitaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iv","bookName":"Jātaka-aṭṭhakathā-4","vriCode":"s0513a4.att","from":3779,"to":3787,"paras":[{"para":3779,"vripara":null,"refs":["ja496:18"],"lines":["<b>Tuṇhīmāsīnan</b>ti kiñci avatvā nisinnaṃ.","<b>Akiñcanan</b>ti rāgakiñcanādīhi rahitaṃ.","<b>Āratan</b>ti virataṃ sabbapāpāni pahāya ṭhitaṃ.","<b>Kamaṇḍalun</b>ti kuṇḍikaṃ.","<b>Ete hī</b>ti ete rājādayo tayo janāti hatthaṃ pasāretvā te niddisanto evamāha.","<b>Dātumarahantī</b>ti mādisassa dātuṃ arahanti.","<b>Paccanīkan</b>ti paccanīkapaṭipadaṃ.","Dāyakassa hi nimantanaṃ ekavīsatiyā anesanāsu aññatarāya piṇḍapātapariyesanāya jīvikakappanasaṅkhātā micchājīvapaṭipatti nāma hoti."],"lineRefs":[["ja496:18"],["ja496:18"],["ja496:18"],["ja496:18"],["ja496:18"],["ja496:18"],["ja496:18"],["ja496:18"]]},{"para":3780,"vripara":null,"refs":["ja496:18"],"lines":["Tassa vacanaṃ sutvā kuṭumbiko attamano dve osānagāthā abhāsi –"],"lineRefs":[["ja496:18"]]},{"para":3782,"vripara":"288","refs":["ja496:18"],"lines":["“Atthāya vata me ajja, idhāgacchi rathesabho;"],"lineRefs":[["ja496:18"]]},{"para":3783,"vripara":null,"refs":["ja496:18"],"lines":["Sohaṃ ajja pajānāmi, yattha dinnaṃ mahapphalaṃ."],"lineRefs":[["ja496:18"]]},{"para":3785,"vripara":"289","refs":["ja496:18"],"lines":["“Raṭṭhesu giddhā rājāno, kiccākiccesu brāhmaṇā;"],"lineRefs":[["ja496:18"]]},{"para":3786,"vripara":null,"refs":["ja496:18"],"lines":["Isī mūlaphale giddhā, vippamuttā ca bhikkhavo”ti."],"lineRefs":[["ja496:18"]]},{"para":3787,"vripara":null,"refs":["ja496:18","ja496:20"],"lines":["Tattha <b>rathesabho</b>ti rājānaṃ sandhāyāha.","<b>Kiccākiccesū</b>ti rañño kiccakaraṇīyesu.","<b>Bhikkhavo</b>ti paccekabuddhā bhikkhavo pana sabbabhavehi vippamuttā."],"lineRefs":[["ja496:18"],["ja496:20"],["ja496:20"]]}],"wordLinks":[["ja496:18.1","ete hī",0,4],["ja496:18.1","dātumarahantī",0,5],["ja496:18.3","paccanīkaṃ",0,6],["ja496:20.1","kiccākiccesū",6,1],["ja496:20.3","bhikkhavo",6,2]],"after":[{"para":3788,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Paccekabuddho tassa dhammaṃ desetvā sakaṭṭhānameva gato, tathā tāpaso.","Rājā pana katipāhaṃ tassa santike vasitvā bārāṇasimeva gato."]},{"para":3789,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā “na, bhikkhave, idāneva piṇḍapāto yathānucchavikaṃ gacchati, pubbepi gatoyevā”ti vatvā jātakaṃ samodhānesi –","“tadā kuṭumbiko dhammaratanassa sakkārakārako kuṭumbiko ahosi, rājā ānando, purohito sāriputto, himavantatāpaso pana ahameva ahosin”ti."]},{"para":3790,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Bhikkhāparamparajātakavaṇṇanā terasamā."]},{"para":3791,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Jātakuddānaṃ –"]},{"para":3792,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Kedāraṃ candakinnarī, ukkusuddālabhisakaṃ;"]},{"para":3793,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Suruci pañcuposathaṃ, mahāmorañca tacchakaṃ."]},{"para":3794,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Mahāvāṇija sādhinaṃ, dasabrāhmaṇajātakaṃ;"]},{"para":3795,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Bhikkhāparamparāpi ca, terasāni pakiṇṇake."]},{"para":3796,"vripara":null,"title":"[496] 13. Bhikkhāparamparajātakavaṇṇanā","lines":["Pakiṇṇakanipātavaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
