{"suttaId":"ja104","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[584,588],"vripara":"104"},"segments":{"ja104:0.4":"Mittavindakajātakaṃ","ja104:1.1":"Catubbhi aṭṭhajjhagamā, aṭṭhāhipi ca soḷasa;","ja104:1.3":"Soḷasāhi ca bāttiṃsa [battiṃsa (sī. syā. pī.)], atricchaṃ cakkamāsado;","ja104:1.5":"Icchāhatassa posassa, cakkaṃ bhamati matthaketi.","ja104:2.1":"Mittavindakajātakaṃ catutthaṃ."},"attha":null,"tika":null}
