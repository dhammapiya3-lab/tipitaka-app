{"suttaId":"tha-ap246","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8159,8168],"vripara":"14"},"segments":{"tha-ap246:0.3":"Viravapupphiyattheraapadānaṃ","tha-ap246:1.1":"“Khīṇāsavasahassehi,","tha-ap246:1.2":"niyyāti lokanāyako;","tha-ap246:1.3":"Viravapupphamādāya [viravipupphaṃ paggayha (sī.)],","tha-ap246:1.4":"buddhassa abhiropayiṃ. 15.","tha-ap246:2.1":"“Ekanavutito kappe,","tha-ap246:2.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap246:2.3":"Duggatiṃ nābhijānāmi,","tha-ap246:2.4":"buddhapūjāyidaṃ phalaṃ. 16.","tha-ap246:3.1":"“Paṭisambhidā catasso…pe…","tha-ap246:3.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap246:4.1":"Itthaṃ sudaṃ āyasmā viravapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap246:5.1":"Viravapupphiyattherassāpadānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3201,"to":3201,"paras":[{"para":3201,"vripara":"14","refs":["tha-ap246:1"],"lines":["Catutthāpadāne <b>viravapupphamādāyā</b>ti vividhaṃ ravati saddaṃ karotīti viravaṃ, saddakaraṇavelāyaṃ vikasanato “virava”nti laddhanāmaṃ pupphasamūhaṃ ādāya gahetvā siddhatthassa <b>buddhassa abhiropayiṃ</b> pūjesinti attho. 17."],"lineRefs":[["tha-ap246:1"]]}],"wordLinks":[["tha-ap246:1.3","buddhassa abhiropayiṃ",0,0],["tha-ap246:1.3","viravapupphamādāyā",0,0]]},"tika":null,"tika2":null}
