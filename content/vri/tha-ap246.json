{"suttaId":"tha-ap246","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8159,8168],"vripara":"14"},"segments":{"tha-ap246:0.3":"Viravapupphiyattheraapadānaṃ","tha-ap246:1.1":"“Khīṇāsavasahassehi, niyyāti lokanāyako;","tha-ap246:1.3":"Viravapupphamādāya [viravipupphaṃ paggayha (sī.)], buddhassa abhiropayiṃ.","tha-ap246:2.1":"“Ekanavutito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap246:2.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap246:3.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap246:4.1":"Itthaṃ sudaṃ āyasmā viravapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap246:5.1":"Viravapupphiyattherassāpadānaṃ catutthaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3201,"to":3201,"paras":[{"para":3201,"vripara":"14","refs":["tha-ap246:1"],"words":["buddhassa abhiropayiṃ","viravapupphamādāyā"],"lines":["Catutthāpadāne <b>viravapupphamādāyā</b>ti vividhaṃ ravati saddaṃ karotīti viravaṃ, saddakaraṇavelāyaṃ vikasanato “viravan”ti laddhanāmaṃ pupphasamūhaṃ ādāya gahetvā siddhatthassa <b>buddhassa abhiropayiṃ</b> pūjesinti attho."],"lineRefs":[["tha-ap246:1"]]}]},"tika":null}
