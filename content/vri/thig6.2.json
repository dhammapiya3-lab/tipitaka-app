{"suttaId":"thig6.2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[529,547],"vripara":"133"},"segments":{"thig6.2:0.3":"Vāseṭṭhītherīgāthā","thig6.2:1.1":"“Puttasokenahaṃ aṭṭā,","thig6.2:1.2":"khittacittā visaññinī;","thig6.2:1.3":"Naggā pakiṇṇakesī ca,","thig6.2:1.4":"tena tena vicārihaṃ.","thig6.2:2.1":"“Vīthi [vasiṃ (sī.)] saṅkārakūṭesu,","thig6.2:2.2":"susāne rathiyāsu ca;","thig6.2:2.3":"Acariṃ tīṇi vassāni,","thig6.2:2.4":"khuppipāsāsamappitā.","thig6.2:3.1":"“Athaddasāsiṃ sugataṃ,","thig6.2:3.2":"nagaraṃ mithilaṃ pati [gataṃ (ka.)];","thig6.2:3.3":"Adantānaṃ dametāraṃ,","thig6.2:3.4":"sambuddhamakutobhayaṃ.","thig6.2:4.1":"“Sacittaṃ paṭiladdhāna,","thig6.2:4.2":"vanditvāna upāvisiṃ;","thig6.2:4.3":"So me dhammamadesesi,","thig6.2:4.4":"anukampāya gotamo.","thig6.2:5.1":"“Tassa dhammaṃ suṇitvāna,","thig6.2:5.2":"pabbajiṃ anagāriyaṃ;","thig6.2:5.3":"Yuñjantī satthuvacane,","thig6.2:5.4":"sacchākāsiṃ padaṃ sivaṃ.","thig6.2:6.1":"“Sabbe sokā samucchinnā,","thig6.2:6.2":"pahīnā etadantikā;","thig6.2:6.3":"Pariññātā hi me vatthū,","thig6.2:6.4":"yato sokāna sambhavo”ti.","thig6.2:7.1":"… Vāseṭṭhī therī …."},"unsure":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1890,"to":1890,"paras":[{"para":1890,"vripara":null,"refs":["thig6.2:6"],"lines":["<b>Etadantikā</b>ti etaṃ idāni mayā adhigataṃ arahattaṃ anto pariyosānaṃ etesanti etadantikā, sokā.","Na dāni tesaṃ sambhavo atthīti attho.","<b>Yato sokāna sambhavo</b>ti yato antonijjhānalakkhaṇānaṃ sokānaṃ sambhavo, tesaṃ sokānaṃ pañcupādānakkhandhasaṅkhātā vatthū adhiṭṭhānāni ñātatīraṇapahānapariññāhi pariññātā.","Tasmā sokā etadantikāti yojanā."],"lineRefs":[["thig6.2:6"],["thig6.2:6"],["thig6.2:6"],["thig6.2:6"]]}],"wordLinks":[["thig6.2:6.1","etadantikā",0,0],["thig6.2:6.3","yato sokāna sambhavo",0,2]],"before":[{"para":1868,"vripara":"133","refs":[],"lines":["“Puttasokenahaṃ aṭṭā, khittacittā visaññinī;"],"lineRefs":[[]]},{"para":1869,"vripara":null,"refs":[],"lines":["Naggā pakiṇṇakesī ca, tena tena vicārihaṃ."],"lineRefs":[[]]},{"para":1871,"vripara":"134","refs":[],"lines":["“Vīthisaṅkārakūṭesu, susāne rathiyāsu ca;"],"lineRefs":[[]]},{"para":1872,"vripara":null,"refs":[],"lines":["Acariṃ tīṇi vassāni, khuppipāsā samappitā."],"lineRefs":[[]]},{"para":1874,"vripara":"135","refs":[],"lines":["“Athaddasāsiṃ sugataṃ, nagaraṃ mithilaṃ pati;"],"lineRefs":[[]]},{"para":1875,"vripara":null,"refs":[],"lines":["Adantānaṃ dametāraṃ, sambuddhamakutobhayaṃ."],"lineRefs":[[]]},{"para":1877,"vripara":"136","refs":[],"lines":["“Sacittaṃ paṭiladdhāna, vanditvāna upāvisiṃ;"],"lineRefs":[[]]},{"para":1878,"vripara":null,"refs":[],"lines":["So me dhammamadesesi, anukampāya gotamo."],"lineRefs":[[]]},{"para":1880,"vripara":"137","refs":[],"lines":["“Tassa dhammaṃ suṇitvāna, pabbajiṃ anagāriyaṃ;"],"lineRefs":[[]]},{"para":1881,"vripara":null,"refs":[],"lines":["Yuñjantī satthuvacane, sacchākāsiṃ padaṃ sivaṃ."],"lineRefs":[[]]},{"para":1883,"vripara":"138","refs":[],"lines":["“Sabbe sokā samucchinnā, pahīnā etadantikā;"],"lineRefs":[[]]},{"para":1884,"vripara":null,"refs":[],"lines":["Pariññātā hi me vatthū, yato sokāna sambhavo”ti.","–"],"lineRefs":[[],[]]},{"para":1885,"vripara":null,"refs":[],"lines":["Imā gāthā abhāsi."],"lineRefs":[[]]},{"para":1886,"vripara":null,"refs":[],"lines":["Tattha <b>aṭṭā</b>ti aṭṭitā.","Ayameva vā pāṭho, aṭṭitā pīḷitāti attho.","<b>Khittacittā</b>ti sokummādena khittahadayā.","Tato eva pakatisaññāya vigamena <b>visaññinī</b>.","Hirottappābhāvato apagatavatthatāya <b>naggā</b>.","Vidhutakesatāya <b>pakiṇṇakesī.</b>","<b>Tena tenā</b>ti gāmena gāmaṃ nagarena nagaraṃ vīthiyā vīthiṃ vicariṃ ahaṃ."],"lineRefs":[[],[],[],[],[],[],[]]},{"para":1887,"vripara":null,"refs":[],"lines":["<b>Athā</b>ti pacchā ummādasaṃvattaniyassa kammassa parikkhaye.","<b>Sugatan</b>ti sobhanagamanattā sundaraṃ ṭhānaṃ gatattā sammā gadattā sammā ca gatattā sugataṃ bhagavantaṃ.","<b>Mithilaṃ patī</b>ti mithilābhimukhaṃ, mithilānagarābhimukhaṃ gacchantanti attho."],"lineRefs":[[],[],[]]},{"para":1888,"vripara":null,"refs":[],"lines":["<b>Sacittaṃ paṭiladdhānā</b>ti buddhānubhāvena ummādaṃ pahāya attano pakaticittaṃ paṭilabhitvā."],"lineRefs":[[]]},{"para":1889,"vripara":null,"refs":[],"lines":["<b>Yuñjantī satthuvacane</b>ti satthu sammāsambuddhassa sāsane yogaṃ karontī bhāvanaṃ anuyuñjantī.","<b>Sacchākāsiṃ padaṃ sivan</b>ti sivaṃ khemaṃ catūhi yogehi anupaddutaṃ nibbānaṃ padaṃ sacchiakāsiṃ."],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
