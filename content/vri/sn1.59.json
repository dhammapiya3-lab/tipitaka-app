{"suttaId":"sn1.59","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[709,713],"vripara":"59"},"segments":{"sn1.59:0.3":"Dutiyasuttaṃ","sn1.59:1.1":"“Kiṃsu dutiyā [dutiyaṃ (syā. kaṃ. pī.)] purisassa hoti,","sn1.59:1.2":"kiṃsu cenaṃ pasāsati;","sn1.59:1.3":"Kissa cābhirato macco,","sn1.59:1.4":"sabbadukkhā pamuccatī”ti.","sn1.59:2.1":"“Saddhā dutiyā purisassa hoti,","sn1.59:2.2":"paññā cenaṃ pasāsati;","sn1.59:2.3":"Nibbānābhirato macco,","sn1.59:2.4":"sabbadukkhā pamuccatī”ti. 10."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":452,"to":452,"paras":[{"para":452,"vripara":"59","refs":["sn1.59:1","sn1.59:2"],"lines":["Navame <b>kissa cābhirato</b>ti kismiṃ abhirato.","<b>Dutiyā</b>ti sugatiñceva nibbānañca gacchantassa dutiyikā.","<b>Paññā cenaṃ pasāsatī</b>ti paññā etaṃ purisaṃ “idaṃ karohi, idaṃ mākarī”ti anusāsati.","Navamaṃ. 10."],"lineRefs":[["sn1.59:1"],["sn1.59:1"],["sn1.59:2"],["sn1.59:2"]]}],"wordLinks":[["sn1.59:1.3","kissa cābhirato",0,0],["sn1.59:1.1","dutiyā",0,1],["sn1.59:2.1","paññā cenaṃ pasāsatī",0,2]],"before":[{"para":451,"vripara":null,"title":"Dutiyasuttavaṇṇanā","lines":["Dutiyasuttavaṇṇanā 59."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":552,"to":552,"paras":[{"para":552,"vripara":"59","refs":["sn1.59:1"],"lines":["<b>Kissā</b>ti bhummatthe sāmivacananti āha <b>“kismiṃ abhirato”</b>ti.","Saddhā nāma anavajjasabhāvā, tasmā lokiyalokuttarahitasukhāvahāti āha <b>“sugatiñceva nibbānañca gacchantassa dutiyikā”</b>ti.","<b>Anusāsati</b> hitacariyāya pariṇāyikabhāvato."],"lineRefs":[["sn1.59:1"],["sn1.59:1"],["sn1.59:1"]]}],"wordLinks":[["sn1.59:1.3","kissā",0,0]],"before":[{"para":551,"vripara":null,"title":"Dutiyasuttavaṇṇanā","lines":["Dutiyasuttavaṇṇanā 59."]}],"after":[{"para":553,"vripara":null,"title":"Dutiyasuttavaṇṇanā","lines":["Dutiyasuttavaṇṇanā niṭṭhitā. 10."]}]},"tika2":null}
