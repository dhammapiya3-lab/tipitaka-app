{"suttaId":"an6.31","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[225,226],"vripara":"31"},"segments":{"an6.31:0.3":"Sekhasuttaṃ","an6.31:1.1":"“Chayime, bhikkhave, dhammā sekhassa bhikkhuno parihānāya saṃvattanti.","an6.31:1.2":"Katame cha?","an6.31:1.3":"Kammārāmatā, bhassārāmatā, niddārāmatā, saṅgaṇikārāmatā, indriyesu aguttadvāratā, bhojane amattaññutā – ime kho, bhikkhave, cha dhammā sekhassa bhikkhuno parihānāya saṃvattanti.","an6.31:2.1":"“Chayime, bhikkhave, dhammā sekhassa bhikkhuno aparihānāya saṃvattanti.","an6.31:2.2":"Katame cha?","an6.31:2.3":"Na kammārāmatā, na bhassārāmatā, na niddārāmatā, na saṅgaṇikārāmatā, indriyesu guttadvāratā, bhojane mattaññutā – ime kho, bhikkhave, cha dhammā sekhassa bhikkhuno aparihānāya saṃvattantī”ti.","an6.31:2.5":"Paṭhamaṃ."},"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":588,"to":588,"paras":[{"para":588,"vripara":"31","refs":["an6.31:1"],"lines":["Catutthassa paṭhame <b>sekhassā</b>ti sattavidhassa sekhassa.","Puthujjane pana vattabbameva natthi.","<b>Parihānāyā</b>ti uparūpariguṇaparihānāya."],"lineRefs":[["an6.31:1"],["an6.31:1"],["an6.31:1"]]}],"wordLinks":[["an6.31:1.1","sekhassā",0,0],["an6.31:1.3","sekhassā",0,0],["an6.31:1.1","parihānāyā",0,2],["an6.31:1.3","parihānāyā",0,2]],"before":[{"para":585,"vripara":null,"refs":[],"lines":["Anuttariyavaggo tatiyo."],"lineRefs":[[]]},{"para":586,"vripara":null,"refs":[],"lines":["Devatāvaggo"],"lineRefs":[[]]},{"para":587,"vripara":null,"refs":[],"lines":["Sekhasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":586,"to":588,"paras":[{"para":586,"vripara":"31-34","refs":["an6.31:1"],"lines":["31-34. Catutthassa paṭhame sekhānaṃ paṭiladdhaguṇassa parihāni nāma natthīti āha <b>“uparūpariguṇaparihānāyā”</b>ti, uparūpariladdhabbānaṃ maggaphalānaṃ parihānāya anuppādāyāti attho.","Tatiyādīni uttānatthāneva."],"lineRefs":[["an6.31:1"],["an6.31:1"]]},{"para":587,"vripara":null,"refs":["an6.31:1"],"lines":["Sekhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an6.31:1"]]},{"para":588,"vripara":null,"refs":["an6.31:1"],"lines":["Vijjābhāgiyasuttavaṇṇanā"],"lineRefs":[["an6.31:1"]]}],"wordLinks":[],"before":[{"para":582,"vripara":null,"refs":[],"lines":["Anuttariyasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":583,"vripara":null,"refs":[],"lines":["Anuttariyavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":584,"vripara":null,"refs":[],"lines":["Devatāvaggo"],"lineRefs":[[]]},{"para":585,"vripara":null,"refs":[],"lines":["1-4. Sekhasuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
