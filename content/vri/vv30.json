{"suttaId":"vv30","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[915,949],"vripara":"296"},"segments":{"vv30:0.4":"Ucchudāyikāvimānavatthu","vv30:1.1":"“Obhāsayitvā pathaviṃ [paṭhaviṃ (sī. syā.)] sadevakaṃ,","vv30:1.2":"atirocasi candimasūriyā viya;","vv30:1.3":"Siriyā ca vaṇṇena yasena tejasā,","vv30:1.4":"brahmāva deve tidase sahindake [saindake (sī.)].","vv30:2.1":"“Pucchāmi taṃ uppalamāladhārinī,","vv30:2.2":"āveḷinī kañcanasannibhattace;","vv30:2.3":"Alaṅkate uttamavatthadhārinī,","vv30:2.4":"kā tvaṃ subhe devate vandase mamaṃ.","vv30:3.1":"“Kiṃ tvaṃ pure kammamakāsi attanā,","vv30:3.2":"manussabhūtā purimāya jātiyā;","vv30:3.3":"Dānaṃ suciṇṇaṃ atha sīlasaṃyamaṃ [saññamaṃ (sī.)],","vv30:3.4":"kenūpapannā sugatiṃ yasassinī;","vv30:3.5":"Devate pucchitācikkha,","vv30:3.6":"kissa kammassidaṃ phalan”ti.","vv30:4.1":"“Idāni bhante imameva gāmaṃ [gāme (syā. ka.)],","vv30:4.2":"piṇḍāya amhākaṃ gharaṃ upāgami;","vv30:4.3":"Tato te ucchussa adāsi khaṇḍikaṃ,","vv30:4.4":"pasannacittā atulāya pītiyā.","vv30:5.1":"“Sassu ca pacchā anuyuñjate mamaṃ,","vv30:5.2":"kahaṃ [kahaṃ me (pī.)] nu ucchuṃ vadhuke avākiri [avākari (syā. ka.)];","vv30:5.3":"Na chaḍḍitaṃ no pana khāditaṃ mayā,","vv30:5.4":"santassa bhikkhussa sayaṃ adāsahaṃ.","vv30:6.1":"“Tuyhaṃnvidaṃ [tuyhaṃ nu idaṃ (syā.)] issariyaṃ atho mama,","vv30:6.2":"itissā sassu paribhāsate mamaṃ;","vv30:6.3":"Pīṭhaṃ gahetvā pahāraṃ adāsi me,","vv30:6.4":"tato cutā kālakatāmhi devatā.","vv30:7.1":"“Tadeva kammaṃ kusalaṃ kataṃ mayā,","vv30:7.2":"sukhañca kammaṃ anubhomi attanā;","vv30:7.3":"Devehi saddhiṃ paricārayāmahaṃ,","vv30:7.4":"modāmahaṃ kāmaguṇehi pañcahi.","vv30:8.1":"“Tadeva kammaṃ kusalaṃ kataṃ mayā,","vv30:8.2":"sukhañca kammaṃ anubhomi attanā;","vv30:8.3":"Devindaguttā tidasehi rakkhitā,","vv30:8.4":"samappitā kāmaguṇehi pañcahi.","vv30:9.1":"“Etādisaṃ puññaphalaṃ anappakaṃ,","vv30:9.2":"mahāvipākā mama ucchudakkhiṇā;","vv30:9.3":"Devehi saddhiṃ paricārayāmahaṃ,","vv30:9.4":"modāmahaṃ kāmaguṇehi pañcahi.","vv30:10.1":"“Etādisaṃ puññaphalaṃ anappakaṃ,","vv30:10.2":"mahājutikā mama ucchudakkhiṇā;","vv30:10.3":"Devindaguttā tidasehi rakkhitā,","vv30:10.4":"sahassanettoriva nandane vane.","vv30:11.1":"“Tuvañca bhante anukampakaṃ viduṃ,","vv30:11.2":"upecca vandiṃ kusalañca pucchisaṃ;","vv30:11.3":"Tato te ucchussa adāsi khaṇḍikaṃ,","vv30:11.4":"pasannacitā atulāya pītiyā”ti.","vv30:12.1":"Ucchudāyikāvimānaṃ dutiyaṃ."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1202,"to":1233,"paras":[{"para":1202,"vripara":"296-297","refs":["vv30:1"],"lines":["296-7. Tattha <b>obhāsayitvā pathaviṃ sadevakan</b>ti candimasūriyarasmisammissehi sinerupassaviniggatehi pabhāvisarehi vijjotayamānatāya devena ākāsena sahāti sadevakaṃ upagatabhūmibhāgabhūtaṃ imaṃ pathaviṃ vijjotetvā, ekobhāsaṃ ekapajjotaṃ katvāti attho.","Obhāsayitvā pathaviṃ candimasūriyā viyāti yojanā.","<b>Atirocasī</b>ti atikkamitvā rocasi.","Taṃ pana atirocanaṃ kena kiṃ viya kena vāti āha <b>“siriyā”</b>tiādi.","Tattha <b>siriyā</b>ti sobhaggādisobhāvisesena.","<b>Tejasā</b>ti attano ānubhāvena.","<b>Āveḷinī</b>ti ratanamayapupphāveḷavatī."],"lineRefs":[["vv30:1"],["vv30:1"],["vv30:1"],["vv30:1"],["vv30:1"],["vv30:1"],["vv30:1"]]},{"para":1203,"vripara":null,"refs":["vv30:1"],"lines":["Evaṃ therena pucchitā devatā imāhi gāthāhi vissajjesi –"],"lineRefs":[["vv30:1"]]},{"para":1205,"vripara":"299","refs":["vv30:1"],"lines":["“Idāni bhante imameva gāmaṃ, piṇḍāya amhākaṃ gharaṃ upāgami;"],"lineRefs":[["vv30:1"]]},{"para":1206,"vripara":null,"refs":["vv30:1"],"lines":["Tato te ucchussa adāsi khaṇḍikaṃ, pasannacittā atulāya pītiyā."],"lineRefs":[["vv30:1"]]},{"para":1208,"vripara":"300","refs":["vv30:1"],"lines":["“Sassu ca pacchā anuyuñjate mamaṃ, kahaṃ nu ucchuṃ vadhuke avākiri;"],"lineRefs":[["vv30:1"]]},{"para":1209,"vripara":null,"refs":["vv30:1"],"lines":["Na chaḍḍitaṃ no pana khāditaṃ mayā, santassa bhikkhussa sayaṃ adāsahaṃ."],"lineRefs":[["vv30:1"]]},{"para":1211,"vripara":"301","refs":["vv30:1"],"lines":["“Tuyhaṃ nvidaṃ issariyaṃ atho mama, itissā sassu paribhāsate mamaṃ;"],"lineRefs":[["vv30:1"]]},{"para":1212,"vripara":null,"refs":["vv30:1"],"lines":["Pīṭhaṃ gahetvā pahāraṃ adāsi me, tato cutā kālakatāmhi devatā."],"lineRefs":[["vv30:1"]]},{"para":1214,"vripara":"302","refs":["vv30:1"],"lines":["“Tadeva kammaṃ kusalaṃ kataṃ mayā, sukhañca kammaṃ anubhomi attanā;"],"lineRefs":[["vv30:1"]]},{"para":1215,"vripara":null,"refs":["vv30:1"],"lines":["Devehi saddhiṃ paricārayāmahaṃ, modāmahaṃ kāmaguṇehi pañcahi."],"lineRefs":[["vv30:1"]]},{"para":1217,"vripara":"303","refs":["vv30:1"],"lines":["“Tadeva kammaṃ kusalaṃ kataṃ mayā, sukhañca kammaṃ anubhomi attanā;"],"lineRefs":[["vv30:1"]]},{"para":1218,"vripara":null,"refs":["vv30:1"],"lines":["Devindaguttā tidasehi rakkhitā, samappitā kāmaguṇehi pañcahi."],"lineRefs":[["vv30:1"]]},{"para":1220,"vripara":"304","refs":["vv30:1"],"lines":["“Etādisaṃ puññaphalaṃ anappakaṃ, mahāvipākā mama ucchudakkhiṇā;"],"lineRefs":[["vv30:1"]]},{"para":1221,"vripara":null,"refs":["vv30:1"],"lines":["Devehi saddhiṃ paricārayāmahaṃ, modāmahaṃ kāmaguṇehi pañcahi."],"lineRefs":[["vv30:1"]]},{"para":1223,"vripara":"305","refs":["vv30:1"],"lines":["“Etādisaṃ puññaphalaṃ anappakaṃ, mahājutikā mama ucchudakkhiṇā;"],"lineRefs":[["vv30:1"]]},{"para":1224,"vripara":null,"refs":["vv30:1"],"lines":["Devindaguttā tidasehi rakkhitā, sahassanettoriva nandane vane."],"lineRefs":[["vv30:1"]]},{"para":1226,"vripara":"306","refs":["vv30:1"],"lines":["“Tuvañca bhante anukampakaṃ viduṃ, upecca vandiṃ kusalañca pucchisaṃ;"],"lineRefs":[["vv30:1"]]},{"para":1227,"vripara":null,"refs":["vv30:1"],"lines":["Tato te ucchussa adāsi khaṇḍikaṃ, pasannacittā atulāya pītiyā”ti."],"lineRefs":[["vv30:1"]]},{"para":1228,"vripara":"299","refs":["vv30:4"],"lines":["Tattha <b>idānī</b>ti anantarātītadivasattā āha, adhunāti attho.","<b>Imameva gāman</b>ti imasmiṃyeva gāme, rājagahaṃ sandhāya vadati.","Vuttañhi “gāmopi nigamopi nagarampi ‘gāmo’ icceva vuccatī”ti.","Bhummatthe cetaṃ upayogavacanaṃ.","<b>Upāgamī</b>ti upagato ahosi.","<b>Atulāyā</b>ti anupamāya, appamāṇāya vā."],"lineRefs":[["vv30:4"],["vv30:4"],["vv30:4"],["vv30:4"],["vv30:4"],["vv30:4"]]},{"para":1229,"vripara":"300","refs":["vv30:5"],"lines":["<b>Avākirī</b>ti apanesi chaḍḍesi, vināsesi vā.","<b>Santassā</b>ti sādhurūpassa santakilesassa parissamamappattassa vā."],"lineRefs":[["vv30:5"],["vv30:5"]]},{"para":1230,"vripara":"301","refs":["vv30:6"],"lines":["<b>Tuyhaṃ nū</b>ti <b>nu</b> -saddo anattamanatāsūcane nipāto, so “mamā”ti etthāpi ānetvā yojetabbo “mama nū”ti.","<b>Idaṃ issariyan</b>ti gehe ādhipaccaṃ sandhāyāha.","<b>Tato cutā</b>ti tato manussalokato cutā.","Yasmā ṭhitaṭṭhānato apagatāpi “cutā”ti vuccati, tasmā cutiṃ visesetuṃ <b>“kālakatā”</b>ti vuttaṃ.","Kālakatāpi ca na yattha katthaci nibbattā, apica kho devattaṃ upagatāti dassentī āha <b>“amhi devatā”</b>ti."],"lineRefs":[["vv30:6"],["vv30:6"],["vv30:6"],["vv30:6"],["vv30:6"]]},{"para":1231,"vripara":"302","refs":["vv30:7"],"lines":["<b>Tadeva kammaṃ kusalaṃ kataṃ mayā</b>ti tadeva ucchukhaṇḍadānamattaṃ kusalaṃ kammaṃ kataṃ mayā, aññaṃ na jānāmīti attho.","<b>Sukhañca kamman</b>ti sukhañca kammaphalaṃ.","Kammaphalañhi idha “kamman”ti vuttaṃ uttarapadalopena, kāraṇopacārena vā “kusalānaṃ, bhikkhave, dhammānaṃ samādānahetu evamidaṃ puññaṃ pavaḍḍhati (dī. ni.3.80).","Anubhomi sakaṃ puññan”ti (vi. va.133) ca ādīsu viya.","Kammanti vā karaṇatthe upayogavacanaṃ, kammenāti attho.","Kamme vā bhavaṃ kammaṃ yathā kammanti.","Atha vā kāmetabbatāya kammaṃ.","Tañhi sukharajanīyabhāvato kāmūpasaṃhitaṃ kāmetabbanti kamanīyaṃ.","<b>Attanā</b>ti attanā eva, sayaṃvasitāya seribhāvena sayamevāti attho.","<b>Paricārayāmahaṃ attānan</b>ti purimagāthāya “attanā”ti vuttaṃ padaṃ vibhattivipariṇāmena “attānan”ti yojetabbaṃ."],"lineRefs":[["vv30:7"],["vv30:7"],["vv30:7"],["vv30:7"],["vv30:7"],["vv30:7"],["vv30:7"],["vv30:7"],["vv30:7"],["vv30:7"]]},{"para":1232,"vripara":"303-305","refs":["vv30:8"],"lines":["303-5. <b>Devindaguttā</b>ti devindena sakkena guttā, devindo viya vā guttā mahāparivāratāya.","<b>Samappitā</b>ti suṭṭhu appitā samannāgatā.","<b>Mahāvipākā</b>ti vipulaphalā.","<b>Mahājutikā</b>ti mahātejā, mahānubhāvāti attho."],"lineRefs":[["vv30:8"],["vv30:8"],["vv30:8"],["vv30:8"]]},{"para":1233,"vripara":"306","refs":["vv30:11"],"lines":["<b>Tuvan</b>ti taṃ.","<b>Anukampakan</b>ti kāruṇikaṃ.","<b>Vidun</b>ti sappaññaṃ, sāvakapāramiyā matthakaṃ pattanti attho.","<b>Upeccā</b>ti upagantvā.","<b>Vandin</b>ti pañcapatiṭṭhitena abhivādayiṃ.","<b>Kusalañca</b> ārogya <b>pucchisaṃ</b> apucchiṃ, <b>atulāya pītiyā</b> idañca kusalaṃ anussarāmīti adhippāyo.","Sesaṃ heṭṭhā vuttanayameva."],"lineRefs":[["vv30:11"],["vv30:11"],["vv30:11"],["vv30:11"],["vv30:11"],["vv30:11"],["vv30:11"]]}],"wordLinks":[["vv30:1.1","obhāsayitvā pathaviṃ sadevakaṃ",0,0],["vv30:1.1","atirocasī",0,2],["vv30:1.3","siriyā",0,3],["vv30:1.3","siriyā",0,4],["vv30:1.3","tejasā",0,5],["vv30:4.1","idānī",18,0],["vv30:4.1","imameva gāmaṃ",18,1],["vv30:4.1","upāgamī",18,4],["vv30:4.3","atulāyā",18,5],["vv30:5.1","avākirī",19,0],["vv30:5.3","santassā",19,1],["vv30:6.1","tuyhaṃ nū",20,0],["vv30:6.1","idaṃ issariyaṃ",20,1],["vv30:6.3","tato cutā",20,2],["vv30:6.3","kālakatā",20,3],["vv30:7.1","tadeva kammaṃ kusalaṃ kataṃ mayā",21,0],["vv30:7.1","sukhañca kammaṃ",21,1],["vv30:7.1","attanā",21,8],["vv30:8.3","devindaguttā",22,0],["vv30:8.3","samappitā",22,1],["vv30:11.1","tuvaṃ",23,0],["vv30:11.1","anukampakaṃ",23,1],["vv30:11.1","viduṃ",23,2],["vv30:11.1","upeccā",23,3],["vv30:11.1","vandiṃ",23,4],["vv30:11.1","kusalañca",23,5],["vv30:11.1","pucchisaṃ",23,5],["vv30:11.3","atulāya pītiyā",23,5]],"before":[{"para":1188,"vripara":null,"refs":[],"lines":["Uḷāravimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1189,"vripara":null,"refs":[],"lines":["Ucchudāyikāvimānavaṇṇanā"],"lineRefs":[[]]},{"para":1190,"vripara":null,"refs":[],"lines":["<b>Obhāsayitvā pathaviṃ sadevakan</b>ti ucchudāyikāvimānaṃ.","Tassa kā uppatti?","Bhagavā rājagahe viharatītiādi sabbaṃ anantaravimāne vuttasadisaṃ.","Ayaṃ pana viseso – idha ucchu dinnā, sassuyā ca pīṭhakena pahaṭā, taṅkhaṇaññeva matā tāvatiṃsesu uppannā, tassaṃyeva rattiyaṃ therassa upaṭṭhānaṃ āgatā, kevalakappaṃ gijjhakūṭaṃ cando viya sūriyo viya ca obhāsentī theraṃ vanditvā pañjalikā namassamānā ekamantaṃ aṭṭhāsi.","Atha naṃ thero –"],"lineRefs":[[],[],[],[],[]]},{"para":1192,"vripara":"296","refs":[],"lines":["“Obhāsayitvā pathaviṃ sadevakaṃ, atirocasi candimasūriyā viya;"],"lineRefs":[[]]},{"para":1193,"vripara":null,"refs":[],"lines":["Siriyā ca vaṇṇena yasena tejasā, brahmāva deve tidase sahindake."],"lineRefs":[[]]},{"para":1195,"vripara":"297","refs":[],"lines":["“Pucchāmi taṃ uppalamāladhārinī, āveḷinī kañcanasannibhattace;"],"lineRefs":[[]]},{"para":1196,"vripara":null,"refs":[],"lines":["Alaṅkate uttamavatthadhārinī, kā tvaṃ subhe devate vandase mamaṃ."],"lineRefs":[[]]},{"para":1198,"vripara":"298","refs":[],"lines":["“Kiṃ tvaṃ pure kammamakāsi attanā, manussabhūtā purimāya jātiyā;"],"lineRefs":[[]]},{"para":1199,"vripara":null,"refs":[],"lines":["Dānaṃ suciṇṇaṃ atha sīlasaṃyamaṃ, kenūpapannā sugatiṃ yasassinī;"],"lineRefs":[[]]},{"para":1200,"vripara":null,"refs":[],"lines":["Devate pucchitācikkha, kissa kammassidaṃ phalan”ti.","–"],"lineRefs":[[],[]]},{"para":1201,"vripara":null,"refs":[],"lines":["Imāhi gāthāhi pucchi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
