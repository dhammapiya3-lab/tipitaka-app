{"suttaId":"an6.92","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[772,772],"vripara":"92"},"segments":{"an6.92:0.3":"Paṭhamaabhabbaṭṭhānasuttaṃ","an6.92:1.1":"“Chayimāni, bhikkhave, abhabbaṭṭhānāni.","an6.92:1.2":"Katamāni cha?","an6.92:1.3":"Abhabbo diṭṭhisampanno puggalo satthari agāravo viharituṃ appatisso, abhabbo diṭṭhisampanno puggalo dhamme agāravo viharituṃ appatisso, abhabbo diṭṭhisampanno puggalo saṅghe agāravo viharituṃ appatisso, abhabbo diṭṭhisampanno puggalo sikkhāya agāravo viharituṃ appatisso, abhabbo diṭṭhisampanno puggalo anāgamanīyaṃ vatthuṃ paccāgantuṃ, abhabbo diṭṭhisampanno puggalo aṭṭhamaṃ bhavaṃ nibbattetuṃ.","an6.92:1.4":"Imāni kho, bhikkhave, cha abhabbaṭṭhānānī”ti.","an6.92:1.5":"Aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":761,"to":761,"paras":[{"para":761,"vripara":"92-95","refs":["an6.92:1"],"lines":["Aṭṭhame <b>anāgamanīyaṃ vatthu</b>nti anupagantabbaṃ kāraṇaṃ, pañcannaṃ verānaṃ dvāsaṭṭhiyā ca diṭṭhigatānametaṃ adhivacanaṃ.","<b>Aṭṭhamaṃ bhava</b>nti kāmāvacare aṭṭhamaṃ paṭisandhiṃ.","Navame <b>kotūhalamaṅgalenā</b>ti diṭṭhasutamutamaṅgalena.","Dasame <b>sayaṃkata</b>ntiādīni attadiṭṭhivasena vuttāni.","<b>Adhiccasamuppanna</b>nti ahetunibbattaṃ.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["an6.92:1"],["an6.92:1"],["an6.92:1"],["an6.92:1"],["an6.92:1"],["an6.92:1"]]}],"wordLinks":[["an6.92:1.3","anāgamanīyaṃ vatthuṃ",0,0],["an6.92:1.3","aṭṭhamaṃ bhavaṃ",0,1]]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":780,"to":784,"paras":[{"para":780,"vripara":"86-95","refs":["an6.92:1"],"lines":["Dutiye <b>acchandiko</b>ti kattukamyatākusalacchandarahito.","Uttarakurukā manussā acchandikaṭṭhānaṃ paviṭṭhā.","<b>Duppañño</b>ti bhavaṅgapaññāya parihīno.","Bhavaṅgapaññāya pana paripuṇṇāyapi yassa bhavaṅgaṃ lokuttarassa paccayo na hoti, sopi duppañño eva nāma.","<b>Abhabbo niyāmaṃ okkamituṃ kusalesu dhammesu sammatta</b>nti kusalesu dhammesu sammattaniyāmasaṅkhātaṃ ariyamaggaṃ okkamituṃ adhigantuṃ abhabbo.","<b>Na kammāvaraṇatāyā</b>tiādīsu abhabbavipariyāyena attho veditabbo.","Catutthādīni uttānatthāni."],"lineRefs":[["an6.92:1"],["an6.92:1"],["an6.92:1"],["an6.92:1"],["an6.92:1"],["an6.92:1"],["an6.92:1"]]},{"para":781,"vripara":null,"refs":["an6.92:1"],"lines":["Āvaraṇasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an6.92:1"]]},{"para":782,"vripara":null,"refs":["an6.92:1"],"lines":["Sītivaggavaṇṇanā niṭṭhitā. 10."],"lineRefs":[["an6.92:1"]]},{"para":783,"vripara":null,"refs":["an6.92:1"],"lines":["Ānisaṃsavaggo 1-11."],"lineRefs":[["an6.92:1"]]},{"para":784,"vripara":null,"refs":["an6.92:1"],"lines":["Pātubhāvasuttādivaṇṇanā 96-106."],"lineRefs":[["an6.92:1"]]}],"wordLinks":[]},"tika2":null}
