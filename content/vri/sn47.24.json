{"suttaId":"sn47.24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1006,1006],"vripara":"390"},"segments":{"sn47.24:0.3":"Suddhasuttaṃ","sn47.24:1.1":"Sāvatthinidānaṃ.","sn47.24:1.2":"“Cattārome, bhikkhave, satipaṭṭhānā.","sn47.24:1.3":"Katame cattāro?","sn47.24:1.4":"Idha, bhikkhave, bhikkhu kāye kāyānupassī viharati ātāpī sampajāno satimā, vineyya loke abhijjhādomanassaṃ;","sn47.24:1.5":"vedanāsu … pe … citte … pe … dhammesu dhammānupassī viharati ātāpī sampajāno satimā, vineyya loke abhijjhādomanassaṃ.","sn47.24:1.8":"Ime kho, bhikkhave, cattāro satipaṭṭhānā”ti.","sn47.24:1.9":"Catutthaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":502,"to":503,"paras":[{"para":502,"vripara":"389-391","refs":["sn47.24:1"],"lines":["389-391. Tatiye <b>parihānaṃ hotī</b>ti puggalavasena parihānaṃ hoti.","Yo hi buddhesu dharantesupi cattāro satipaṭṭhāne na bhāveti, tassa saddhammo antarahito nāma hoti devadattādīnaṃ viya.","Iti imasmiṃ sutte tassa puggalasseva dhammantaradhānaṃ kathitaṃ.","Catutthapañcamesu sabbaṃ uttānameva."],"lineRefs":[["sn47.24:1"],["sn47.24:1"],["sn47.24:1"],["sn47.24:1"]]},{"para":503,"vripara":null,"refs":["sn47.24:1"],"lines":["Padesasuttavaṇṇanā"],"lineRefs":[["sn47.24:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":428,"to":429,"paras":[{"para":428,"vripara":"389-391","refs":["sn47.24:1"],"lines":["389-391. <b>Puggalavasena parihānaṃ hoti</b> na dhammavasena.","Yo na bhāveti, tasseva parihāyati.","Tenāha <b>“yo hī”</b>tiādi."],"lineRefs":[["sn47.24:1"],["sn47.24:1"],["sn47.24:1"]]},{"para":429,"vripara":null,"refs":["sn47.24:1"],"lines":["Padesasuttavaṇṇanā"],"lineRefs":[["sn47.24:1"]]}],"wordLinks":[]},"tika2":null}
