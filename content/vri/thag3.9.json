{"suttaId":"thag3.9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1229,1238],"vripara":"243"},"segments":{"thag3.9:0.4":"Yasojattheragāthā","thag3.9:1.1":"“Kālapabbaṅgasaṅkāso, kiso dhamanisanthato;","thag3.9:1.3":"Mattaññū annapānamhi, adīnamanaso naro”.","thag3.9:2.1":"“Phuṭṭho ḍaṃsehi makasehi, araññasmiṃ brahāvane;","thag3.9:2.3":"Nāgo saṅgāmasīseva, sato tatrādhivāsaye.","thag3.9:3.1":"“Yathā brahmā tathā eko, yathā devo tathā duve;","thag3.9:3.3":"Yathā gāmo tathā tayo, kolāhalaṃ tatuttarin”ti.","thag3.9:3.5":"… Yasojo thero …."},"attha":null,"tika":null}
