{"suttaId":"an5.307","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1615,1615],"vripara":"307"},"segments":{"an5.307:0.3":"306","an5.307:1.1":"“Rāgassa, bhikkhave, abhiññāya pañca dhammā bhāvetabbā.","an5.307:1.2":"Katame pañca?","an5.307:1.3":"Saddhābalaṃ, vīriyabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ –","an5.307:1.4":"rāgassa, bhikkhave, abhiññāya ime pañca dhammā bhāvetabbā”ti."},"unsure":[],"attha":null,"tika":null,"tika2":null}
