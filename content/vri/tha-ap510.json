{"suttaId":"tha-ap510","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3128,3142],"vripara":"80"},"segments":{"tha-ap510:0.3":"Amodaphaliyattheraapadānaṃ","tha-ap510:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ, āhutīnaṃ paṭiggahaṃ;","tha-ap510:1.3":"Rathiyaṃ paṭipajjantaṃ, amodamadadiṃ phalaṃ.","tha-ap510:2.1":"“Ekanavutito kappe, yaṃ phalaṃ adadiṃ tadā;","tha-ap510:2.3":"Duggatiṃ nābhijānāmi, phaladānassidaṃ phalaṃ.","tha-ap510:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap510:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap510:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap510:6.1":"Itthaṃ sudaṃ āyasmā amodaphaliyo thero imā gāthāyo Abhāsitthāti.","tha-ap510:7.1":"Amodaphaliyattherassāpadānaṃ aṭṭhamaṃ."},"attha":null,"tika":null}
