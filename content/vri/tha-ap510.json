{"suttaId":"tha-ap510","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3128,3142],"vripara":"80"},"segments":{"tha-ap510:0.3":"Amodaphaliyattheraapadānaṃ","tha-ap510:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap510:1.2":"āhutīnaṃ paṭiggahaṃ;","tha-ap510:1.3":"Rathiyaṃ paṭipajjantaṃ, amodamadadiṃ phalaṃ. 81.","tha-ap510:2.1":"“Ekanavutito kappe,","tha-ap510:2.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap510:2.3":"Duggatiṃ nābhijānāmi,","tha-ap510:2.4":"phaladānassidaṃ phalaṃ. 82.","tha-ap510:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap510:3.3":"viharāmi anāsavo. 83.","tha-ap510:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap510:4.3":"kataṃ buddhassa sāsanaṃ. 84.","tha-ap510:5.1":"“Paṭisambhidā catasso…pe…","tha-ap510:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap510:6.1":"Itthaṃ sudaṃ āyasmā amodaphaliyo thero imā gāthāyo Abhāsitthāti.","tha-ap510:7.1":"Amodaphaliyattherassāpadānaṃ aṭṭhamaṃ. 9."},"unsure":["tha-ap510:1.3"],"preface":[],"attha":null,"tika":null,"tika2":null}
