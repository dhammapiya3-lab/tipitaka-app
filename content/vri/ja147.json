{"suttaId":"ja147","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[821,824],"vripara":"147"},"segments":{"ja147:0.4":"Puppharattajātakaṃ","ja147:1.1":"Nayidaṃ dukkhaṃ aduṃ dukkhaṃ,","ja147:1.2":"yaṃ maṃ tudati vāyaso;","ja147:1.3":"Yaṃ sāmā puppharattena,","ja147:1.4":"kattikaṃ nānubhossatīti.","ja147:2.1":"Puppharattajātakaṃ sattamaṃ. 148."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":3060,"to":3060,"paras":[{"para":3060,"vripara":null,"refs":["ja147:1"],"lines":["Tattha <b>nayidaṃ dukkhaṃ aduṃ dukkhaṃ, yaṃ maṃ tudati vāyaso</b>ti yañca idaṃ sūle lagganapaccayaṃ kāyikacetasikadukkhaṃ, yañca lohamayehi viya tuṇḍehi vāyaso tudati, idaṃ sabbampi mayhaṃ na dukkhaṃ, aduṃ dukkhaṃ etaṃyeva pana me dukkhanti attho.","Kataraṃ?","<b>Yaṃ sāmā puppharattena, kattikaṃ nānubhossatī</b>ti, yaṃ sā piyaṅgusāmā mama bhariyā ekaṃ kusumbharattaṃ nivāsetvā ekaṃ pārupitvā evaṃ ghanapuppharattena vatthayugena acchannā mama kaṇṭhe gahetvā kattikarattivāraṃ nānubhavissati, idaṃ mayhaṃ dukkhaṃ, etadeva hi maṃ bādhatīti?","So evaṃ mātugāmaṃ ārabbha vippalapantoyeva kālaṃ katvā niraye nibbatti."],"lineRefs":[["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"]]}],"wordLinks":[["ja147:1.1","nayidaṃ dukkhaṃ aduṃ dukkhaṃ yaṃ maṃ tudati vāyaso",0,0],["ja147:1.3","yaṃ sāmā puppharattena kattikaṃ nānubhossatī",0,2]]},"tika":{"book":"Ja-ṭ-i","bookName":"Jātaka-abhinavaṭīkā-1","vriCode":"","from":1442,"to":1444,"paras":[{"para":1442,"vripara":null,"refs":["ja147:1"],"lines":["7-puppharattajātakavaṇṇanā (147)"],"lineRefs":[["ja147:1"]]},{"para":1443,"vripara":null,"refs":["ja147:1"],"lines":["<b>kattikāratticārachaṇo [kattikarattivārachaṇo.(ṭṭha)] </b>ti kattikāya niyuttāya rattiyā avacāraüssavo.","<b>jāpetvā [obhañjāpetvā (ṭṭha)] </b>ti kuṭilaṃ kuṭilaṃ katvā.","<b>sataphalakaṃ sahassaphalaka [satavalikaṃsahassavalikaṃ (ṭṭha)] </b>nti satapaṭalaṃ sahassapaṭalaṃ kārāpetvā.","<b>kusumbhavattha</b> [kusumbharattaṃ.(ṭṭha)] nti kusumbhapupphavasena rattaṃ vatthaṃ.","kusati avhāyatīti kusumbhaṃ.","kusa-avhāyaneti dhātu.","ta-paccayo.","a-kārassa u-kārādeso.","niggahitāgamo ca daṭṭhabbo.","<b>daliddāna</b>nti duggatānaṃ.","<b>purisassa icchāya sati kiṃ nāma natthī</b>ti purisassa icchāya satiyā alabhitabbaṃ kiṃ nāma vatthu natthi.","atthi yevāti attho.","<b>vati</b>nti badarasākhādīhi ṭhapitaṃ pākāraṃ.","<b>tāya nāmamhī</b>ti ādīsu nāmasaddo socanatthe nipāto.","ghanapuppharattavatthanivatthāya kaṇṭhe āsattabāhuyugaḷāya tāya itthiyā saddhiṃ kattikāratticārato parihīno amhi parisocāmīti attho.","<b>sāmā</b>ti tassā bhariyāya piyasāmavaṇṇasadisatāya vuttanti."],"lineRefs":[["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"],["ja147:1"]]},{"para":1444,"vripara":null,"refs":["ja147:1"],"lines":["puppharattajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja147:1"]]}],"wordLinks":[]},"tika2":null}
