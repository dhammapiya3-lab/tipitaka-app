{"suttaId":"tha-ap243","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8113,8123],"vripara":"1"},"segments":{"tha-ap243:0.3":"Tuvaradāyakattheraapadānaṃ","tha-ap243:1.1":"“Migaluddo pure āsiṃ,","tha-ap243:1.2":"araññe kānane ahaṃ;","tha-ap243:1.3":"Bharitvā tuvaramādāya [bharitvā turavamādāya (ka.), bhajjitaṃ tuvaramādāya (?) ettha tuvaranti muggakalāyasadisaṃ tuvaraṭṭhinti tadaṭṭhakathā; tuvaro dhaññabhedeti sakkatābhidhāne],","tha-ap243:1.4":"saṅghassa adadiṃ ahaṃ.","tha-ap243:2.1":"“Ekanavutito kappe,","tha-ap243:2.2":"yaṃ dānamadadiṃ tadā;","tha-ap243:2.3":"Duggatiṃ nābhijānāmi,","tha-ap243:2.4":"tuvarassa idaṃ phalaṃ.","tha-ap243:3.1":"“Paṭisambhidā catasso,","tha-ap243:3.2":"vimokkhāpi ca aṭṭhime;","tha-ap243:3.3":"Chaḷabhiññā sacchikatā,","tha-ap243:3.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap243:4.1":"Itthaṃ sudaṃ āyasmā tuvaradāyako thero imā gāthāyo abhāsitthāti.","tha-ap243:5.1":"Tuvaradāyakattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3198,"to":3198,"paras":[{"para":3198,"vripara":"1","refs":["tha-ap243:1"],"lines":["Pañcavīsatime vagge paṭhamāpadāne <b>bharitvā tuvaramādāyā</b>ti tuvaraaṭṭhiṃ muggakalayasadisaṃ tuvaraṭṭhiṃ bhajjitvā pupphetvā bhājanena ādāya <b>saṅghassa</b> vanamajjhogāhakassa <b>adadiṃ</b> adāsinti attho."],"lineRefs":[["tha-ap243:1"]]}],"wordLinks":[["tha-ap243:1.3","adadiṃ",0,0],["tha-ap243:1.3","bharitvā tuvaramādāyā",0,0],["tha-ap243:1.3","saṅghassa",0,0]],"before":[{"para":3196,"vripara":null,"title":"Tuvaradāyakavaggo","lines":["Tuvaradāyakavaggo"]},{"para":3197,"vripara":null,"title":"Tuvaradāyakattheraapadānādivaṇṇanā","lines":["1-10. Tuvaradāyakattheraapadānādivaṇṇanā"]}]},"tika":null,"tika2":null}
