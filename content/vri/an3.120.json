{"suttaId":"an3.120","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1102,1104],"vripara":"121"},"segments":{"an3.120:0.3":"Paṭhamasoceyyasuttaṃ","an3.120:1.1":"“Tīṇimāni, bhikkhave, soceyyāni.","an3.120:1.2":"Katamāni tīṇi?","an3.120:1.3":"Kāyasoceyyaṃ, vacīsoceyyaṃ, manosoceyyaṃ.","an3.120:1.4":"Katamañca, bhikkhave, kāyasoceyyaṃ?","an3.120:1.5":"Idha, bhikkhave, ekacco pāṇātipātā paṭivirato hoti, adinnādānā paṭivirato hoti, kāmesumicchācārā paṭivirato hoti.","an3.120:1.6":"Idaṃ vuccati, bhikkhave, kāyasoceyyaṃ.","an3.120:2.1":"“Katamañca, bhikkhave, vacīsoceyyaṃ?","an3.120:2.2":"Idha, bhikkhave, ekacco musāvādā paṭivirato hoti, pisuṇāya vācāya paṭivirato hoti, pharusāya vācāya paṭivirato hoti, samphappalāpā paṭivirato hoti.","an3.120:2.3":"Idaṃ vuccati bhikkhave, vacīsoceyyaṃ.","an3.120:3.1":"“Katamañca, bhikkhave, manosoceyyaṃ?","an3.120:3.2":"Idha, bhikkhave, ekacco anabhijjhālu hoti abyāpannacitto sammādiṭṭhiko.","an3.120:3.3":"Idaṃ vuccati, bhikkhave, manosoceyyaṃ.","an3.120:3.4":"Imāni kho, bhikkhave, tīṇi soceyyānī”ti.","an3.120:3.5":"Aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":916,"to":916,"paras":[{"para":916,"vripara":"121","refs":["an3.120:1"],"lines":["Aṭṭhame <b>soceyyānī</b>ti sucibhāvā.","<b>Kāyasoceyyan</b>ti kāyadvāre sucibhāvo.","Sesadvayepi eseva nayo.","Imesu pana paṭipāṭiyā catūsu suttesu agārikapaṭipadā kathitā.","Sotāpannasakadāgāmīnampi vaṭṭati."],"lineRefs":[["an3.120:1"],["an3.120:1"],["an3.120:1"],["an3.120:1"],["an3.120:1"]]}],"wordLinks":[["an3.120:1.1","soceyyānī",0,0],["an3.120:1.3","kāyasoceyyaṃ",0,1],["an3.120:1.4","kāyasoceyyaṃ",0,1],["an3.120:1.6","kāyasoceyyaṃ",0,1]],"before":[{"para":915,"vripara":null,"refs":[],"lines":["Paṭhamasoceyyasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":941,"to":943,"paras":[{"para":941,"vripara":"121","refs":["an3.120:1"],"lines":["Aṭṭhame <b>sucibhāvo</b>ti kilesāsucivigamena suddhabhāvo asaṃkiliṭṭhabhāvo, atthato kāyasucaritādīni."],"lineRefs":[["an3.120:1"]]},{"para":942,"vripara":null,"refs":["an3.120:1"],"lines":["Paṭhamasoceyyasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["an3.120:1"]]},{"para":943,"vripara":null,"refs":["an3.120:1"],"lines":["Dutiyasoceyyasuttavaṇṇanā"],"lineRefs":[["an3.120:1"]]}],"wordLinks":[]},"tika2":null}
