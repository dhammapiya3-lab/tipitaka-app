{"suttaId":"tha-ap293","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8876,8892],"vripara":"1"},"segments":{"tha-ap293:0.3":"Citakapūjakattheraapadānaṃ","tha-ap293:1.1":"“Ajito nāma nāmena,","tha-ap293:1.2":"ahosiṃ brāhmaṇo tadā;","tha-ap293:1.3":"Āhutiṃ yiṭṭhukāmohaṃ,","tha-ap293:1.4":"nānāpupphaṃ samānayiṃ.","tha-ap293:2.1":"“Jalantaṃ citakaṃ disvā,","tha-ap293:2.2":"sikhino lokabandhuno;","tha-ap293:2.3":"Tañca pupphaṃ samānetvā,","tha-ap293:2.4":"citake okiriṃ ahaṃ.","tha-ap293:3.1":"“Ekattiṃse ito kappe,","tha-ap293:3.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap293:3.3":"Duggatiṃ nābhijānāmi,","tha-ap293:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap293:4.1":"“Sattavīse [sattatiṃse (ka.)] ito kappe,","tha-ap293:4.2":"sattāsuṃ manujādhipā;","tha-ap293:4.3":"Supajjalitanāmā te,","tha-ap293:4.4":"cakkavattī mahabbalā.","tha-ap293:5.1":"“Paṭisambhidā catasso,","tha-ap293:5.2":"vimokkhāpi ca aṭṭhime;","tha-ap293:5.3":"Chaḷabhiññā sacchikatā,","tha-ap293:5.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap293:6.1":"Itthaṃ sudaṃ āyasmā citakapūjako thero imā gāthāyo abhāsitthāti.","tha-ap293:7.1":"Citakapūjakattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3250,"to":3250,"paras":[{"para":3250,"vripara":"1-2","refs":["tha-ap293:1"],"lines":["1-2. Tiṃsatime vagge paṭhamāpadāne <b>āhutiṃ yiṭṭhukāmohan</b>ti pūjāsakkāraṃ kāretukāmo ahaṃ.","<b>Nānāpupphaṃ samānayin</b>ti nānā anekavidhaṃ campakasalalādipupphaṃ saṃ suṭṭhu ānayiṃ, rāsiṃ akāsinti attho.","<b>Sikhino lokabandhuno</b>ti sakalalokattayabandhussa ñātakassa sikhissa bhagavato parinibbutassa citakaṃ āḷāhanacitakaṃ dārurāsiṃ jalantaṃ ādittaṃ disvā tañca mayā rāsīkataṃ pupphaṃ <b>okiriṃ</b> pūjesinti attho."],"lineRefs":[["tha-ap293:1"],["tha-ap293:1"],["tha-ap293:1"]]}],"wordLinks":[["tha-ap293:1.3","āhutiṃ yiṭṭhukāmohaṃ",0,0],["tha-ap293:1.3","nānāpupphaṃ samānayiṃ",0,1]],"before":[{"para":3246,"vripara":null,"refs":[],"lines":["Catutthāpadānādīni dasamāvasānāni suviññeyyānevāti."],"lineRefs":[[]]},{"para":3247,"vripara":null,"refs":[],"lines":["Ekūnatiṃsatimavaggavaṇṇanā samattā."],"lineRefs":[[]]},{"para":3248,"vripara":null,"refs":[],"lines":["Citakapūjakavaggo"],"lineRefs":[[]]},{"para":3249,"vripara":null,"refs":[],"lines":["1-10. Citakapūjakattheraapadānādivaṇṇanā"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
