{"suttaId":"ja115","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[646,649],"vripara":"115"},"segments":{"ja115:0.4":"Anusāsikajātakaṃ","ja115:1.1":"Yāyañña [yāyaññe (ka.)] manusāsati, sayaṃ loluppacārinī;","ja115:1.3":"Sāyaṃ vipakkhikā seti, hatā cakkena sāsikāti [sālikāti (sī. syā. pī.)].","ja115:2.1":"Anusāsikajātakaṃ pañcamaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2647,"to":2647,"paras":[{"para":2647,"vripara":null,"refs":["ja115:1"],"lines":["Tattha <b>yāyaññe manusāsatī</b>ti yakāro padasandhikaro, yā aññe anusāsatīti attho.","<b>Sayaṃ loluppacārinī</b>ti attanā loluppacārinī samānā.","<b>Sāyaṃ vipakkhikā setī</b>ti sā esā vihatapakkhā hutvā mahāmagge sayati.","<b>Hatā cakkena sāsikā</b>ti yānacakkena hatā sāsikā sakuṇikāti."],"lineRefs":[["ja115:1"],["ja115:1"],["ja115:1"],["ja115:1"]]}],"wordLinks":[["ja115:1.1","sayaṃ loluppacārinī",0,1],["ja115:1.3","sāyaṃ vipakkhikā setī",0,2],["ja115:1.3","hatā cakkena sāsikā",0,3]]},"tika":null}
