{"suttaId":"an3.49","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[385,386],"vripara":"50"},"segments":{"an3.49:0.3":"Ātappakaraṇīyasuttaṃ","an3.49:1.1":"“Tīhi, bhikkhave, ṭhānehi ātappaṃ karaṇīyaṃ.","an3.49:1.2":"Katamehi tīhi?","an3.49:1.3":"Anuppannānaṃ pāpakānaṃ akusalānaṃ dhammānaṃ anuppādāya ātappaṃ karaṇīyaṃ, anuppannānaṃ kusalānaṃ dhammānaṃ uppādāya ātappaṃ karaṇīyaṃ, uppannānaṃ sārīrikānaṃ vedanānaṃ dukkhānaṃ tibbānaṃ kharānaṃ kaṭukānaṃ asātānaṃ amanāpānaṃ pāṇaharānaṃ adhivāsanāya ātappaṃ karaṇīyaṃ.","an3.49:1.4":"Imehi tīhi, bhikkhave, ṭhānehi ātappaṃ karaṇīyaṃ.","an3.49:2.1":"“Yato kho, bhikkhave, bhikkhu anuppannānaṃ pāpakānaṃ akusalānaṃ dhammānaṃ anuppādāya ātappaṃ karoti, anuppannānaṃ kusalānaṃ dhammānaṃ uppādāya ātappaṃ karoti, uppannānaṃ sārīrikānaṃ vedanānaṃ dukkhānaṃ tibbānaṃ kharānaṃ kaṭukānaṃ asātānaṃ amanāpānaṃ pāṇaharānaṃ adhivāsanāya ātappaṃ karoti.","an3.49:2.2":"Ayaṃ vuccati, bhikkhave, bhikkhu ātāpī nipako sato sammā dukkhassa antakiriyāyā”ti.","an3.49:2.3":"Dasamaṃ. 11."},"unsure":[],"preface":[],"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":578,"to":579,"paras":[{"para":578,"vripara":"50","refs":["an3.49:1"],"lines":["Dasame <b>ātappaṃ karaṇīya</b>nti vīriyaṃ kātuṃ yuttaṃ.","<b>Anuppādāyā</b>ti anuppādatthāya, anuppādaṃ sādhessāmīti iminā kāraṇena kattabbanti attho.","Paratopi eseva nayo.","<b>Sārīrikāna</b>nti sarīrasambhavānaṃ.","<b>Dukkhāna</b>nti dukkhamānaṃ.","<b>Tibbāna</b>nti bahalānaṃ, tāpanavasena vā tibbānaṃ.","<b>Kharāna</b>nti pharusānaṃ.","<b>Kaṭukāna</b>nti tikhiṇānaṃ.","<b>Asātāna</b>nti amadhurānaṃ.","<b>Amanāpāna</b>nti manaṃ vaḍḍhetuṃ asamatthānaṃ.","<b>Pāṇaharāna</b>nti jīvitaharānaṃ.","<b>Adhivāsanāyā</b>ti adhivāsanatthāya sahanatthāya khamanatthāya."],"lineRefs":[["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"]]},{"para":579,"vripara":null,"refs":["an3.49:2"],"lines":["Ettake ṭhāne satthā āṇāpetvā āṇattiṃ pavattetvā idāni samādapento <b>yato kho, bhikkhave</b>tiādimāha.","Tattha <b>yato</b>ti yadā.","<b>Ātāpī</b>ti vīriyavā.","<b>Nipako</b>ti sappañño.","<b>Sato</b>ti satiyā samannāgato.","<b>Dukkhassa antakiriyāyā</b>ti vaṭṭadukkhassa paricchedaparivaṭumakiriyāya.","Ime ca pana ātāpādayo tayopi lokiyalokuttaramissakā kathitā. 11."],"lineRefs":[["an3.49:2"],["an3.49:2"],["an3.49:2"],["an3.49:2"],["an3.49:2"],["an3.49:2"],["an3.49:2"]]}],"wordLinks":[["an3.49:1.1","ātappaṃ karaṇīyaṃ",0,0],["an3.49:1.3","ātappaṃ karaṇīyaṃ",0,0],["an3.49:1.4","ātappaṃ karaṇīyaṃ",0,0],["an3.49:1.3","anuppādāyā",0,1],["an3.49:1.3","sārīrikānaṃ",0,3],["an3.49:1.3","dukkhānaṃ",0,4],["an3.49:1.3","tibbānaṃ",0,5],["an3.49:1.3","kharānaṃ",0,6],["an3.49:1.3","kaṭukānaṃ",0,7],["an3.49:1.3","asātānaṃ",0,8],["an3.49:1.3","amanāpānaṃ",0,9],["an3.49:1.3","pāṇaharānaṃ",0,10],["an3.49:1.3","adhivāsanāyā",0,11],["an3.49:2.1","yato kho bhikkhave",1,0],["an3.49:2.1","yato",1,1],["an3.49:2.2","ātāpī",1,2],["an3.49:2.2","nipako",1,3],["an3.49:2.2","sato",1,4],["an3.49:2.2","dukkhassa antakiriyāyā",1,5]],"before":[{"para":577,"vripara":null,"title":"Ātappakaraṇīyasuttavaṇṇanā","lines":["Ātappakaraṇīyasuttavaṇṇanā 50."]}]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":581,"to":581,"paras":[{"para":581,"vripara":"50","refs":["an3.49:1"],"lines":["Dasame <b>sarīrasambhavāna</b>nti sarīre sambhūtānaṃ.","<b>Dukkhāna</b>nti aniṭṭhānaṃ.","<b>Bahalāna</b>nti nirantarappavattiyā aviraḷānaṃ.","<b>Tāpanavasenā</b>ti dukkhāpanavasena.","<b>Tibbāna</b>nti kurūrānaṃ.","Tāsaṃ yathāvuttānaṃ adhivāsanāya pahātabbadukkhavedanānaṃ pajahanaṃ nāma khamanamevāti āha <b>“khamanatthāyā”</b>ti.","<b>Āṇāpetvā</b>ti “ātappaṃ karaṇīya”nti buddhāṇaṃ vidhāya.","<b>Lokiyalokuttaramissakā kathitā</b> sasambhārānaṃ maggadhammānaṃ kathitattā."],"lineRefs":[["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"],["an3.49:1"]]}],"wordLinks":[["an3.49:1.3","dukkhānaṃ",0,1],["an3.49:1.3","tibbānaṃ",0,4]],"before":[{"para":580,"vripara":null,"title":"Ātappakaraṇīyasuttavaṇṇanā","lines":["Ātappakaraṇīyasuttavaṇṇanā 50."]}],"after":[{"para":582,"vripara":null,"title":"Ātappakaraṇīyasuttavaṇṇanā","lines":["Ātappakaraṇīyasuttavaṇṇanā niṭṭhitā. 11."]}]},"tika2":null}
