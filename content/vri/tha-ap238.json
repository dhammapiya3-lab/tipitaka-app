{"suttaId":"tha-ap238","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8049,8061],"vripara":"23"},"segments":{"tha-ap238:0.3":"Vaṇṇakārattheraapadānaṃ","tha-ap238:1.1":"“Nagare aruṇavatiyā,","tha-ap238:1.2":"vaṇṇakāro ahaṃ tadā;","tha-ap238:1.3":"Cetiye dussabhaṇḍāni,","tha-ap238:1.4":"nānāvaṇṇaṃ rajesahaṃ [rajiṃ ahaṃ (ka.), rajemahaṃ (syā.)].","tha-ap238:2.1":"“Ekattiṃse ito kappe,","tha-ap238:2.2":"yaṃ vaṇṇaṃ rajayiṃ tadā;","tha-ap238:2.3":"Duggatiṃ nābhijānāmi,","tha-ap238:2.4":"vaṇṇadānassidaṃ phalaṃ.","tha-ap238:3.1":"“Ito tevīsatikappe,","tha-ap238:3.2":"vaṇṇasama [candupama (sī.), candasama (syā.)] sanāmako;","tha-ap238:3.3":"Sattaratanasampanno,","tha-ap238:3.4":"cakkavattī mahabbalo.","tha-ap238:4.1":"“Paṭisambhidā catasso … pe …","tha-ap238:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap238:5.1":"Itthaṃ sudaṃ āyasmā vaṇṇakāro thero imā gāthāyo abhāsitthāti.","tha-ap238:6.1":"Vaṇṇakārattherassāpadānaṃ chaṭṭhaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3190,"to":3190,"paras":[{"para":3190,"vripara":"23","refs":["tha-ap238:1"],"lines":["Chaṭṭhāpadāne <b>vaṇṇakāro ahaṃ tadā</b>ti nīlapītarattādivaṇṇavasena vatthāni karoti rañjetīti vaṇṇakāro.","Vattharajako hutvā cetiye vatthehi acchādanasamaye nānāvaṇṇehi dussāni rañjesinti attho."],"lineRefs":[["tha-ap238:1"],["tha-ap238:1"]]}],"wordLinks":[["tha-ap238:1.1","vaṇṇakāro ahaṃ tadā",0,0]],"before":[{"para":3189,"vripara":null,"refs":[],"lines":["Pañcamāpadānaṃ uttānatthameva."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
