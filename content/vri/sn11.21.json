{"suttaId":"sn11.21","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[3459,3464],"vripara":"267"},"segments":{"sn11.21:0.3":"Chetvāsuttaṃ","sn11.21:1.1":"Sāvatthiyaṃ jetavane.","sn11.21:1.2":"Atha kho sakko devānamindo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi.","sn11.21:1.3":"Ekamantaṃ ṭhito kho sakko devānamindo bhagavantaṃ gāthāya ajjhabhāsi –","sn11.21:2.1":"“Kiṃsu chetvā sukhaṃ seti, kiṃsu chetvā na socati;","sn11.21:2.3":"Kissassu ekadhammassa, vadhaṃ rocesi gotamā”ti.","sn11.21:3.1":"“Kodhaṃ chetvā sukhaṃ seti, kodhaṃ chetvā na socati;","sn11.21:3.3":"Kodhassa visamūlassa, madhuraggassa vāsava;","sn11.21:3.5":"Vadhaṃ ariyā pasaṃsanti, tañhi chetvā na socatī”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1465,"to":1466,"paras":[{"para":1465,"vripara":"267","refs":["sn11.21:1"],"lines":["Tatiyavaggassa paṭhamaṃ vuttatthameva.","Paṭhamaṃ."],"lineRefs":[["sn11.21:1"],["sn11.21:1"]]},{"para":1466,"vripara":null,"refs":["sn11.21:1"],"lines":["Dubbaṇṇiyasuttavaṇṇanā"],"lineRefs":[["sn11.21:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1686,"to":1688,"paras":[{"para":1686,"vripara":"267","refs":["sn11.21:1"],"lines":["<b>Vuttatthameva</b> heṭṭhā devaputtasaṃyuttavaṇṇanāyaṃ."],"lineRefs":[["sn11.21:1"]]},{"para":1687,"vripara":null,"refs":[],"lines":["Chetvāsuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1688,"vripara":null,"refs":["sn11.21:1"],"lines":["Dubbaṇṇiyasuttavaṇṇanā"],"lineRefs":[["sn11.21:1"]]}],"wordLinks":[]},"tika2":null}
