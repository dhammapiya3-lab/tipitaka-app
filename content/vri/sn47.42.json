{"suttaId":"sn47.42","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1077,1077],"vripara":"408"},"segments":{"sn47.42:0.3":"Samudayasuttaṃ","sn47.42:1.1":"“Catunnaṃ, bhikkhave, satipaṭṭhānānaṃ samudayañca atthaṅgamañca desessāmi.","sn47.42:1.2":"Taṃ suṇātha.","sn47.42:1.3":"Ko ca, bhikkhave, kāyassa samudayo?","sn47.42:1.4":"Āhārasamudayā kāyassa samudayo;","sn47.42:1.5":"āhāranirodhā kāyassa atthaṅgamo.","sn47.42:1.6":"Phassasamudayā vedanānaṃ samudayo;","sn47.42:1.7":"phassanirodhā vedanānaṃ atthaṅgamo.","sn47.42:1.8":"Nāmarūpasamudayā cittassa samudayo;","sn47.42:1.9":"nāmarūpanirodhā cittassa atthaṅgamo.","sn47.42:1.10":"Manasikārasamudayā dhammānaṃ samudayo;","sn47.42:1.11":"manasikāranirodhā dhammānaṃ atthaṅgamo”ti.","sn47.42:1.12":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":515,"to":515,"paras":[{"para":515,"vripara":"408","refs":["sn47.42:1"],"lines":["Pañcamavaggassa dutiye <b>āhārasamudayā kāyassa samudayo</b>ti āhārasamudayena kāyasamudayo.","Eseva nayo sesesu.","<b>Manasikārasamudayā</b>ti ettha pana yonisomanasikārasamudayā bojjhaṅgadhammānaṃ samudayo, ayonisomanasikārasamudayā nīvaraṇadhammānaṃ.","Iti imasmiṃ sutte sārammaṇasatipaṭṭhānā kathitā. 4."],"lineRefs":[["sn47.42:1"],["sn47.42:1"],["sn47.42:1"],["sn47.42:1"]]}],"wordLinks":[["sn47.42:1.4","āhārasamudayā kāyassa samudayo",0,0],["sn47.42:1.10","manasikārasamudayā",0,2]]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":441,"to":442,"paras":[{"para":441,"vripara":"408","refs":["sn47.42:1"],"lines":["<b>Sārammaṇasatipaṭṭhānā</b>ti ārammaṇalakkhitā satipaṭṭhānā kathitā, na satilakkhaṇā. 4."],"lineRefs":[["sn47.42:1"]]},{"para":442,"vripara":null,"refs":["sn47.42:1"],"lines":["Satisuttavaṇṇanā 410."],"lineRefs":[["sn47.42:1"]]}],"wordLinks":[]},"tika2":null}
