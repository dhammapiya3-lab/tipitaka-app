{"suttaId":"vv20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[605,638],"vripara":"185"},"segments":{"vv20:0.4":"Ācāmadāyikāvimānavatthu","vv20:1.1":"“Piṇḍāya te carantassa, tuṇhībhūtassa tiṭṭhato;","vv20:1.3":"Daliddā kapaṇā nārī, parāgāraṃ apassitā [avassitā (sī.)].","vv20:2.1":"“Yā te adāsi ācāmaṃ, pasannā sehi pāṇibhi;","vv20:2.3":"Sā hitvā mānusaṃ dehaṃ, kaṃ nu sā disataṃ gatā”ti.","vv20:3.1":"“Piṇḍāya me carantassa, tuṇhībhūtassa tiṭṭhato;","vv20:3.3":"Daliddā kapaṇā nārī, parāgāraṃ apassitā.","vv20:4.1":"“Yā me adāsi ācāmaṃ, pasannā sehi pāṇibhi;","vv20:4.3":"Sā hitvā mānusaṃ dehaṃ, vippamuttā ito cutā.","vv20:5.1":"“Nimmānaratino nāma, santi devā mahiddhikā;","vv20:5.3":"Tattha sā sukhitā nārī, modatācāmadāyikā”ti.","vv20:6.1":"“Aho dānaṃ varākiyā, kassape suppatiṭṭhitaṃ;","vv20:6.3":"Parābhatena dānena, ijjhittha vata dakkhiṇā.","vv20:7.1":"“Yā mahesittaṃ kāreyya, cakkavattissa rājino;","vv20:7.3":"Nārī sabbaṅgakalyāṇī, bhattu cānomadassikā;","vv20:7.5":"Etassācāmadānassa, kalaṃ nāgghati soḷasiṃ.","vv20:8.1":"“Sataṃ nikkhā sataṃ assā, sataṃ assatarīrathā;","vv20:8.3":"Sataṃ kaññāsahassāni, āmuttamaṇikuṇḍalā;","vv20:8.5":"Etassācāmadānassa, kalaṃ nāgghanti soḷasiṃ.","vv20:9.1":"“Sataṃ hemavatā nāgā, īsādantā urūḷhavā;","vv20:9.3":"Suvaṇṇakacchā mātaṅgā, hemakappanavāsasā [hemakappanivāsasā (syā. ka.)];","vv20:9.5":"Etassācāmadānassa, kalaṃ nāgghati soḷasiṃ.","vv20:10.1":"“Catunnamapi dīpānaṃ, issaraṃ yodha kāraye;","vv20:10.3":"Etassācāmadānassa, kalaṃ nāgghati soḷasin”ti.","vv20:11.1":"Ācāmadāyikāvimānaṃ tatiyaṃ."},"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":884,"to":921,"paras":[{"para":884,"vripara":"185","refs":["vv20:1"],"words":["piṇḍāyā","tuṇhībhūtassa tiṭṭhato","daliddā","kapaṇā","parāgāraṃ apassitā"],"lines":["Tattha <b>piṇḍāyā</b>ti piṇḍapātatthāya.","<b>Tuṇhībhūtassa tiṭṭhato</b>ti idaṃ piṇḍāya caraṇākāradassanaṃ, uddissa tiṭṭhatoti attho.","<b>Daliddā</b>ti duggatā.","<b>Kapaṇā</b>ti varākī.","“Daliddā”ti iminā tassā bhogapārijuññaṃ dasseti,“kapaṇā”ti iminā ñātipārijuññaṃ.","<b>Parāgāraṃ apassitā</b>ti paragehaṃ nissitā, paresaṃ ghare bahipiṭṭhichadanaṃ nissāya vasantī."],"lineRefs":[["vv20:1"],["vv20:1"],["vv20:1"],["vv20:1"],["vv20:1"],["vv20:1"]]},{"para":885,"vripara":"186","refs":["vv20:2"],"words":["kaṃ nu sā disataṃ gatā"],"lines":["<b>Kaṃ nu sā disataṃ gatā</b>ti chasu kāmadevalokesu uppajjanavasena kaṃ nāma disaṃ gatā.","Iti sakko “therena tathā katānuggahā uḷārāya dibbasampattiyā bhāginī, na ca dissatī”ti heṭṭhā dvīsu devalokesu apassanto saṃsayāpanno pucchati."],"lineRefs":[["vv20:2"],["vv20:2"]]},{"para":886,"vripara":null,"refs":[],"words":[],"lines":["Athassa thero –"],"lineRefs":[[]]},{"para":888,"vripara":"187","refs":[],"words":[],"lines":["“Piṇḍāya me carantassa, tuṇhībhūtassa tiṭṭhato;"],"lineRefs":[[]]},{"para":889,"vripara":null,"refs":[],"words":[],"lines":["Daliddā kapaṇā nārī, parāgāraṃ apassitā."],"lineRefs":[[]]},{"para":891,"vripara":"188","refs":[],"words":[],"lines":["“Yā me adāsi ācāmaṃ, pasannā sehi pāṇibhi;"],"lineRefs":[[]]},{"para":892,"vripara":null,"refs":[],"words":[],"lines":["Sā hitvā mānusaṃ dehaṃ, vippamuttā ito cutā."],"lineRefs":[[]]},{"para":894,"vripara":"189","refs":[],"words":[],"lines":["“Nimmānaratino nāma, santi devā mahiddhikā;"],"lineRefs":[[]]},{"para":895,"vripara":null,"refs":[],"words":[],"lines":["Tattha sā sukhitā nārī, modatācāmadāyikā”ti.","–"],"lineRefs":[[],[]]},{"para":896,"vripara":null,"refs":[],"words":[],"lines":["Pucchitaniyāmeneva paṭivacanaṃ dento tassā nibbattaṭṭhānaṃ kathesi."],"lineRefs":[[]]},{"para":897,"vripara":"188","refs":["vv20:4"],"words":["vippamuttā"],"lines":["Tattha <b>vippamuttā</b>ti tato manussadobhaggiyato paramakāruññavuttito vippamuttā apagatā."],"lineRefs":[["vv20:4"]]},{"para":898,"vripara":"189","refs":["vv20:5"],"words":["modatācāmadāyikā"],"lines":["<b>Modatācāmadāyikā</b>ti ācāmamattadāyikā, sāpi nāma pañcame kāmasagge dibbasampattiyā modati, passa tāva khettasampattiphalanti dasseti."],"lineRefs":[["vv20:5"]]},{"para":899,"vripara":null,"refs":[],"words":[],"lines":["Puna sakko tassā dānassa mahapphalataṃ mahānisaṃsatañca sutvā taṃ thomento –"],"lineRefs":[[]]},{"para":901,"vripara":"190","refs":[],"words":[],"lines":["“Aho dānaṃ varākiyā, kassape suppatiṭṭhitaṃ;"],"lineRefs":[[]]},{"para":902,"vripara":null,"refs":[],"words":[],"lines":["Parābhatena dānena, ijjhittha vata dakkhiṇā."],"lineRefs":[[]]},{"para":904,"vripara":"191","refs":[],"words":[],"lines":["“Yā mahesittaṃ kāreyya, cakkavattissa rājino;"],"lineRefs":[[]]},{"para":905,"vripara":null,"refs":[],"words":[],"lines":["Nārī sabbaṅgakalyāṇī, bhattu cānomadassikā;"],"lineRefs":[[]]},{"para":906,"vripara":null,"refs":[],"words":[],"lines":["Etassācāmadānassa, kalaṃ nāgghati soḷasiṃ."],"lineRefs":[[]]},{"para":908,"vripara":"192","refs":[],"words":[],"lines":["“Sutaṃ nikkhā sataṃ assā, sataṃ assatarīrathā;"],"lineRefs":[[]]},{"para":909,"vripara":null,"refs":[],"words":[],"lines":["Sataṃ kaññāsahassāni, āmuttamaṇikuṇḍalā;"],"lineRefs":[[]]},{"para":910,"vripara":null,"refs":[],"words":[],"lines":["Etassācāmadānassa, kalaṃ nāgghanti soḷasiṃ."],"lineRefs":[[]]},{"para":912,"vripara":"193","refs":[],"words":[],"lines":["“Sataṃ hemavatā nāgā, īsādantā urūḷhavā;"],"lineRefs":[[]]},{"para":913,"vripara":null,"refs":[],"words":[],"lines":["Suvaṇṇakacchā mitaṅgā, hemakappanavāsasā;"],"lineRefs":[[]]},{"para":914,"vripara":null,"refs":[],"words":[],"lines":["Etassācāmadānassa, kalaṃ nāgacchanti soḷasiṃ."],"lineRefs":[[]]},{"para":916,"vripara":"194","refs":[],"words":[],"lines":["“Catunnamapi dīpānaṃ, issaraṃ yodha kāraye;"],"lineRefs":[[]]},{"para":917,"vripara":null,"refs":[],"words":[],"lines":["Etassācāmadānassa, kalaṃ nāgghati soḷasin”ti.","– āha;"],"lineRefs":[[],[]]},{"para":918,"vripara":"190","refs":["vv20:6"],"words":["aho","varākiyā","parābhatenā","dānenā","ijjhittha vata dakkhiṇā"],"lines":["Tattha <b>aho</b>ti acchariyatthe nipāto.","<b>Varākiyā</b>ti kapaṇiyā.","<b>Parābhatenā</b>ti parato ānītena, paresaṃ gharato ucchācariyāya laddhenāti attho.","<b>Dānenā</b>ti dātabbena ācāmamattena deyyadhammena.","<b>Ijjhittha vata dakkhiṇā</b>ti dakkhiṇā dānaṃ aho nipphajjittha, aho mahapphalā mahājutikā mahāvipphārā ahuvatthāti attho."],"lineRefs":[["vv20:6"],["vv20:6"],["vv20:6"],["vv20:6"],["vv20:6"]]},{"para":919,"vripara":"191","refs":["vv20:7"],"words":["yā mahesittaṃ kāreyyā","sabbaṅgakalyāṇī","bhattu cānomadassikā","etassācāmadānassa  kalaṃ nāgghati soḷasiṃ"],"lines":["Idāni “itthiratanādīnipi tassa dānassa satabhāgampi sahassabhāgampi na upentī”ti dassetuṃ <b>“yā mahesittaṃ kāreyyā”</b>tiādi vuttaṃ.","Tattha <b>sabbaṅgakalyāṇī</b>ti “nātidīghā nātirassā nātikisā nātithūlā nātikāḷī nāccodātā atikkantā mānusavaṇṇaṃ appattā dibbavaṇṇan”ti evaṃ vuttehi sabbehi aṅgehi kāraṇehi, sabbehi vā aṅgapaccaṅgehi kalyāṇī sobhanā sundarā.","<b>Bhattu cānomadassikā</b>ti sāmikassa alāmakadassanā sātisayaṃ dassanīyā pāsādikā.","<b>Etassācāmadānassa, kalaṃ nāgghati soḷasin</b>ti etassa etāya dinnassa ācāmadānassa phalaṃ soḷasabhāgaṃ katvā tato ekaṃ bhāgaṃ puna soḷasabhāgaṃ katvā gahitabhāgasaṅkhātaṃ soḷasiṃ kalaṃ cakkavattirañño itthiratanabhāvopi nāgghati nānubhoti na pāpuṇāti.","“Suvaṇṇassa pañcadasadharaṇaṃ nikkhan”ti vadanti,“satadharaṇan”ti apare."],"lineRefs":[["vv20:7"],["vv20:7"],["vv20:7"],["vv20:7"],["vv20:7"]]},{"para":920,"vripara":"193","refs":["vv20:9"],"words":["hemavatā","īsādantā","urūḷhavā","suvaṇṇakacchā","hemakappanavāsasā"],"lines":["<b>Hemavatā</b>ti himavati jātā, hemavatajātikā vā.","Te hi mahantā thāmajavasampannā ca honti.","<b>Īsādantā</b>ti rathīsāsadisadantā, thokaṃyeva avanatadantāti attho.","Tena visālakadāṭhībhāvaṃ nivāreti.","<b>Urūḷhavā</b>ti thāmajavaparakkamehi brūhanto, mahantaṃ yuddhakiccaṃ vahituṃ samatthāti attho.","<b>Suvaṇṇakacchā</b>ti hemamayagīveyyakapaṭimukkā.","Kacchasīsena hi sabbaṃ hatthiyoggaṃ vadati.","<b>Hemakappanavāsasā</b>ti suvaṇṇakhacitagajattharaṇakaṅkanādihatthālaṅkārasampannā."],"lineRefs":[["vv20:9"],["vv20:9"],["vv20:9"],["vv20:9"],["vv20:9"],["vv20:9"],["vv20:9"],["vv20:9"]]},{"para":921,"vripara":"194","refs":["vv20:10"],"words":["catunnamapi dīpānaṃ issaraṃ"],"lines":["<b>Catunnamapi dīpānaṃ issaran</b>ti dvisahassaparittadīpaparivārānaṃ jambudīpādīnaṃ catunnaṃ mahādīpānaṃ issariyaṃ.","Tena sattaratanasamujjalaṃ sakalaṃ cakkavattisiriṃ vadati.","Yaṃ panettha, taṃ heṭṭhā vuttanayameva."],"lineRefs":[["vv20:10"],["vv20:10"],["vv20:10"]]}]},"tika":null}
