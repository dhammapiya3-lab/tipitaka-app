{"suttaId":"sn35.213-215","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1048,1048],"vripara":"213-215"},"segments":{"sn35.213-215:0.3":"46-48. Bāhirātītādiyadaniccasuttaṃ","sn35.213-215:1.1":"213-215. “Rūpā, bhikkhave, aniccā atītā anāgatā paccuppannā.","sn35.213-215:1.2":"Yadaniccaṃ, taṃ dukkhaṃ.","sn35.213-215:1.3":"Yaṃ dukkhaṃ, tadanattā.","sn35.213-215:1.4":"Yadanattā, taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.213-215:1.5":"Saddā …","sn35.213-215:1.6":"gandhā …","sn35.213-215:1.7":"rasā …","sn35.213-215:1.8":"phoṭṭhabbā …","sn35.213-215:1.9":"dhammā aniccā atītā anāgatā paccuppannā.","sn35.213-215:1.10":"Yadaniccaṃ taṃ dukkhaṃ.","sn35.213-215:1.11":"Yaṃ dukkhaṃ tadanattā.","sn35.213-215:1.12":"Yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.213-215:1.13":"Evaṃ passaṃ … pe …","sn35.213-215:1.14":"nāparaṃ itthattāyāti pajānātī”ti."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
