{"suttaId":"ja186","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1163,1170],"vripara":"71"},"segments":{"ja186:0.4":"Dadhivāhanajātakaṃ (2-4-6)","ja186:1.1":"Vaṇṇagandharasūpeto, amboyaṃ ahuvā pure;","ja186:1.3":"Tameva pūjaṃ labhamāno, kenambo kaṭukapphalo.","ja186:2.1":"Pucimandaparivāro, ambo te dadhivāhana;","ja186:2.3":"Mūlaṃ mūlena saṃsaṭṭhaṃ, sākhā sākhā [sākhaṃ (syā. ka.)] nisevare [nivīsare (ka.)];","ja186:2.5":"Asātasannivāsena, tenambo kaṭukapphaloti.","ja186:3.1":"Dadhivāhanajātakaṃ chaṭṭhaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":629,"to":629,"paras":[{"para":629,"vripara":null,"refs":["ja186:2"],"lines":["Tattha <b>pucimandaparivāro</b>ti nimbarukkhaparivāro.","<b>Sākhā sākhā nisevare</b>ti pucimandassa sākhāyo ambarukkhassa sākhāyo nisevanti.","<b>Asātasannivāsenā</b>ti amadhurehi pucimandehi saddhiṃ sannivāsena.","<b>Tenā</b>ti tena kāraṇena ayaṃ ambo kaṭukapphalo asātaphalo tittakaphalo jātoti."],"lineRefs":[["ja186:2"],["ja186:2"],["ja186:2"],["ja186:2"]]}],"wordLinks":[["ja186:2.1","pucimandaparivāro",0,0],["ja186:2.3","sākhā sākhā nisevare",0,1],["ja186:2.5","asātasannivāsenā",0,2],["ja186:2.5","tenā",0,3]]},"tika":null}
