{"suttaId":"ja186","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1163,1170],"vripara":"71"},"segments":{"ja186:0.4":"Dadhivāhanajātakaṃ (2-4-6)","ja186:1.1":"Vaṇṇagandharasūpeto, amboyaṃ ahuvā pure;","ja186:1.3":"Tameva pūjaṃ labhamāno, kenambo kaṭukapphalo.","ja186:2.1":"Pucimandaparivāro, ambo te dadhivāhana;","ja186:2.3":"Mūlaṃ mūlena saṃsaṭṭhaṃ, sākhā sākhā [sākhaṃ (syā. ka.)] nisevare [nivīsare (ka.)];","ja186:2.5":"Asātasannivāsena, tenambo kaṭukapphaloti.","ja186:3.1":"Dadhivāhanajātakaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
