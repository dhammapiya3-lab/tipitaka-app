{"suttaId":"bv23","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[2668,2757],"vripara":"1"},"segments":{"bv23:0.2":"Vessabhūbuddhavaṃso","bv23:1.1":"Tattheva maṇḍakappamhi,","bv23:1.2":"asamo appaṭipuggalo;","bv23:1.3":"Vessabhū nāma nāmena,","bv23:1.4":"loke uppajji nāyako [so jino (syā. kaṃ. ka.)]. 2.","bv23:2.1":"Ādittaṃ vata rāgaggi,","bv23:2.2":"taṇhānaṃ vijitaṃ tadā;","bv23:2.3":"Nāgova bandhanaṃ chetvā,","bv23:2.4":"patto sambodhimuttamaṃ. 3.","bv23:3.1":"Dhammacakkaṃ pavattente,","bv23:3.2":"vessabhūlokanāyake;","bv23:3.3":"Asītikoṭisahassānaṃ,","bv23:3.4":"paṭhamābhisamayo ahu. 4.","bv23:4.1":"Pakkante cārikaṃ raṭṭhe,","bv23:4.2":"lokajeṭṭhe narāsabhe;","bv23:4.3":"Sattatikoṭisahassānaṃ,","bv23:4.4":"dutiyābhisamayo ahu. 5.","bv23:5.1":"Mahādiṭṭhiṃ vinodento,","bv23:5.2":"pāṭiheraṃ karoti so;","bv23:5.3":"Samāgatā naramarū,","bv23:5.4":"dasasahassī sadevake. 6.","bv23:6.1":"Mahāacchariyaṃ disvā,","bv23:6.2":"abbhutaṃ lomahaṃsanaṃ;","bv23:6.3":"Devā ceva manussā ca,","bv23:6.4":"bujjhare saṭṭhikoṭiyo. 7.","bv23:7.1":"Sannipātā tayo āsuṃ,","bv23:7.2":"vessabhussa mahesino;","bv23:7.3":"Khīṇāsavānaṃ vimalānaṃ,","bv23:7.4":"santacittāna tādinaṃ. 8.","bv23:8.1":"Asītibhikkhusahassānaṃ,","bv23:8.2":"paṭhamo āsi samāgamo;","bv23:8.3":"Sattatibhikkhusahassānaṃ,","bv23:8.4":"dutiyo āsi samāgamo. 9.","bv23:9.1":"Saṭṭhibhikkhusahassānaṃ,","bv23:9.2":"tatiyo āsi samāgamo;","bv23:9.3":"Jarādibhayabhītānaṃ,","bv23:9.4":"orasānaṃ mahesino. 10.","bv23:10.1":"Ahaṃ tena samayena,","bv23:10.2":"sudassano nāma khattiyo;","bv23:10.3":"Nimantetvā mahāvīraṃ,","bv23:10.4":"dānaṃ datvā mahārahaṃ;","bv23:10.5":"Annapānena vatthena,","bv23:10.6":"sasaṅghaṃ jina pūjayiṃ. 11.","bv23:11.1":"Tassa buddhassa asamassa,","bv23:11.2":"cakkaṃ vattitamuttamaṃ;","bv23:11.3":"Sutvāna paṇitaṃ dhammaṃ,","bv23:11.4":"pabbajjamabhirocayiṃ. 12.","bv23:12.1":"Mahādānaṃ pavattetvā,","bv23:12.2":"rattindivamatandito;","bv23:12.3":"Pabbajjaṃ guṇasampannaṃ,","bv23:12.4":"pabbajiṃ jinasantike. 13.","bv23:13.1":"Ācāraguṇasampanno,","bv23:13.2":"vattasīlasamāhito;","bv23:13.3":"Sabbaññutaṃ gavesanto,","bv23:13.4":"ramāmi jinasāsane. 14.","bv23:14.1":"Saddhāpītiṃ upagantvā,","bv23:14.2":"buddhaṃ vandāmi sattharaṃ;","bv23:14.3":"Pīti uppajjati mayhaṃ,","bv23:14.4":"bodhiyāyeva kāraṇā. 15.","bv23:15.1":"Anivattamānasaṃ ñatvā,","bv23:15.2":"sambuddho etadabravi;","bv23:15.3":"“Ekatiṃse ito kappe,","bv23:15.4":"ayaṃ buddho bhavissati. 16.","bv23:16.1":"“Ahu kapilavhayā rammā…pe…","bv23:16.3":"hessāma sammukhā imaṃ”. 17.","bv23:17.1":"Tassāhaṃ vacanaṃ sutvā,","bv23:17.2":"bhiyyo cittaṃ pasādayiṃ;","bv23:17.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv23:17.4":"dasapāramipūriyā. 18.","bv23:18.1":"Anomaṃ nāma nagaraṃ,","bv23:18.2":"suppatīto nāma khattiyo;","bv23:18.3":"Mātā yasavatī nāma,","bv23:18.4":"vessabhussa mahesino. 19.","bv23:19.1":"Cha ca vassasahassāni,","bv23:19.2":"agāraṃ ajjha so vasi;","bv23:19.3":"Ruci suruci rativaḍḍhano,","bv23:19.4":"tayo pāsādamuttamā. 20.","bv23:20.1":"Anūnatiṃsasahassāni,","bv23:20.2":"nāriyo samalaṅkatā;","bv23:20.3":"Sucittā nāma sā nārī,","bv23:20.4":"suppabuddho nāma atrajo. 21.","bv23:21.1":"Nimitte caturo disvā,","bv23:21.2":"sivikāyābhinikkhami;","bv23:21.3":"Chamāsaṃ padhānacāraṃ,","bv23:21.4":"acarī purisuttamo. 22.","bv23:22.1":"Brahmunā yācito santo,","bv23:22.2":"vessabhūlokanāyako;","bv23:22.3":"Vatti cakkaṃ mahāvīro,","bv23:22.4":"aruṇārāme naruttamo. 23.","bv23:23.1":"Soṇo ca uttaro ceva,","bv23:23.2":"ahesuṃ aggasāvakā;","bv23:23.3":"Upasanto nāmupaṭṭhāko,","bv23:23.4":"vessabhussa mahesino. 24.","bv23:24.1":"Rāmā [dāmā (sī.)] ceva samālā ca,","bv23:24.2":"ahesuṃ aggasāvikā;","bv23:24.3":"Bodhi tassa bhagavato,","bv23:24.4":"mahāsāloti vuccati. 25.","bv23:25.1":"Sotthiko ceva rambho ca,","bv23:25.2":"ahesuṃ aggupaṭṭhakā;","bv23:25.3":"Gotamī sirimā ceva,","bv23:25.4":"ahesuṃ aggupaṭṭhikā. 26.","bv23:26.1":"Saṭṭhiratanamubbedho,","bv23:26.2":"hemayūpasamūpamo;","bv23:26.3":"Kāyā niccharati rasmi,","bv23:26.4":"rattiṃva pabbate sikhī. 27.","bv23:27.1":"Saṭṭhivassasahassāni,","bv23:27.2":"āyu tassa mahesino;","bv23:27.3":"Tāvatā tiṭṭhamāno so,","bv23:27.4":"tāresi janataṃ bahuṃ. 28.","bv23:28.1":"Dhammaṃ vitthārikaṃ katvā,","bv23:28.2":"vibhajitvā mahājanaṃ;","bv23:28.3":"Dhammanāvaṃ ṭhapetvāna,","bv23:28.4":"nibbuto so sasāvako. 29.","bv23:29.1":"Dassaneyyaṃ sabbajanaṃ,","bv23:29.2":"vihāraṃ iriyāpathaṃ;","bv23:29.3":"Sabbaṃ tamantarahitaṃ,","bv23:29.4":"nanu rittā sabbasaṅkhārā. 30.","bv23:30.1":"Vessabhū jinavaro satthā,","bv23:30.2":"khemārāmamhi nibbuto;","bv23:30.3":"Dhātuvitthārikaṃ āsi,","bv23:30.4":"tesu tesu padesatoti.","bv23:31.1":"Vessabhussa bhagavato vaṃso ekavīsatimo. 24."},"unsure":[],"preface":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":3511,"to":3574,"paras":[{"para":3511,"vripara":null,"refs":["bv23:6"],"lines":["Tattha <b>āditta</b>nti sakalamidaṃ lokattayaṃ sampadittaṃ.","<b>Rāgaggī</b>ti rāgena.","<b>Taṇhānaṃ vijita</b>nti taṇhānaṃ vijitaṃ raṭṭhaṃ vasavattiṭṭhānanti evaṃ ñatvāti attho.","<b>Nāgova bandhanaṃ chetvā</b>ti hatthī viya pūtilatābandhanaṃ chinditvā sambodhiṃ patto adhigato.","<b>Dasasahassī</b>ti dasasahassiyaṃ.","<b>Sadevake</b>ti sadevake loke.","<b>Bujjhare</b>ti bujjhiṃsu."],"lineRefs":[["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"]]},{"para":3512,"vripara":null,"refs":["bv23:6"],"lines":["Soṇuttarānaṃ pana dvinnaṃ aggasāvakānaṃ samāgame pabbajitānaṃ asītiyā arahantasahassānaṃ majjhe māghapuṇṇamāyaṃ pātimokkhaṃ uddisi, so paṭhamo sannipāto ahosi.","Yadā pana vessabhunā sabbalokābhibhunā saha pabbajitā sattattiṃsasahassasaṅkhā bhikkhū gaṇato ohīnasamaye pakkantā, te vessabhussa sammāsambuddhassa dhammacakkappavattiṃ sutvā soreyyaṃ nāma nagaraṃ āgantvā bhagavantaṃ addasaṃsu.","Tesaṃ bhagavā dhammaṃ desetvā sabbeva te ehibhikkhupabbajjāya pabbājetvā caturaṅgasamannāgatāya parisāya pātimokkhaṃ uddisi, so dutiyo sannipāto ahosi."],"lineRefs":[["bv23:6"],["bv23:6"],["bv23:6"]]},{"para":3513,"vripara":null,"refs":["bv23:6"],"lines":["Yadā pana nārivāhananagare upasanto nāma rājaputto rajjaṃ kāresi, tassānukampāya bhagavā tattha agamāsi, sopi bhagavato āgamanaṃ sutvā saparivāro bhagavato paccuggamanaṃ katvā nimantetvā mahādānaṃ datvā tassa dhammaṃ sutvā pasannahadayo pabbaji.","Taṃ saṭṭhisahassasaṅkhā purisā anupabbajiṃsu.","Te tena saddhiṃ arahattaṃ pāpuṇiṃsu.","So tehi parivuto vessabhū bhagavā pātimokkhaṃ uddisi, so tatiyo sannipāto ahosi.","Tena vuttaṃ – 7."],"lineRefs":[["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"]]},{"para":3515,"vripara":"7","refs":["bv23:6"],"lines":["“Sannipātā tayo āsuṃ, vessabhussa mahesino;"],"lineRefs":[["bv23:6"]]},{"para":3516,"vripara":null,"refs":["bv23:6"],"lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ. 8."],"lineRefs":[["bv23:6"]]},{"para":3518,"vripara":"8","refs":["bv23:6"],"lines":["“Asītibhikkhusahassānaṃ, paṭhamo āsi samāgamo;"],"lineRefs":[["bv23:6"]]},{"para":3519,"vripara":null,"refs":["bv23:6"],"lines":["Sattatibhikkhusahassānaṃ, dutiyo āsi samāgamo. 9."],"lineRefs":[["bv23:6"]]},{"para":3521,"vripara":"9","refs":["bv23:6"],"lines":["“Saṭṭhibhikkhusahassānaṃ, tatiyo āsi samāgamo;"],"lineRefs":[["bv23:6"]]},{"para":3522,"vripara":null,"refs":["bv23:6"],"lines":["Jarādibhayatītānaṃ, orasānaṃ mahesino”ti."],"lineRefs":[["bv23:6"]]},{"para":3523,"vripara":null,"refs":["bv23:6"],"lines":["Tadā amhākaṃ bodhisatto sarabhavatīnagare paramapiyadassano sudassano nāma rājā hutvā vessabhumhi lokanāyake sarabhanagaramupagate tassa dhammaṃ sutvā pasannahadayo dasanakhasamodhānasamujjalaṃ jalajāmalāvikalakamalamakulasadisamañjaliṃ sirasi katvā buddhappamukhassa saṅghassa sacīvaraṃ mahādānaṃ datvā tattheva bhagavato nivāsatthāya gandhakuṭiṃ katvā taṃ parikkhipitvā vihārasahassaṃ kāretvā sabbañca vibhavajātaṃ bhagavato sāsane pariccajitvā tassa santike pabbajitvā ācāraguṇasampanno terasadhutaguṇesu nirato bodhisambhārapariyesanāya rato buddhasāsanābhirato vihāsi.","Sopi taṃ bhagavā byākāsi –","“anāgate ito ekattiṃsakappe ayaṃ gotamo nāma buddho bhavissatī”ti.","Tena vuttaṃ – 10."],"lineRefs":[["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"]]},{"para":3525,"vripara":"10","refs":["bv23:6"],"lines":["“Ahaṃ tena samayena, sudassano nāma khattiyo;"],"lineRefs":[["bv23:6"]]},{"para":3526,"vripara":null,"refs":["bv23:6"],"lines":["Nimantetvā mahāvīraṃ, dānaṃ datvā mahārahaṃ;"],"lineRefs":[["bv23:6"]]},{"para":3527,"vripara":null,"refs":["bv23:6"],"lines":["Annapānena vatthena, sasaṅghaṃ jinapūjayiṃ. 11."],"lineRefs":[["bv23:6"]]},{"para":3529,"vripara":"11","refs":["bv23:6"],"lines":["“Tassa buddhassa asamassa, cakkaṃ vattitamuttamaṃ;"],"lineRefs":[["bv23:6"]]},{"para":3530,"vripara":null,"refs":["bv23:6"],"lines":["Sutvāna paṇitaṃ dhammaṃ, pabbajjamabhirocayiṃ. 12."],"lineRefs":[["bv23:6"]]},{"para":3532,"vripara":"12","refs":["bv23:6"],"lines":["“Mahādānaṃ pavattetvā, rattindivamatandito;"],"lineRefs":[["bv23:6"]]},{"para":3533,"vripara":null,"refs":["bv23:6"],"lines":["Pabbajjaṃ guṇasampannaṃ, pabbajiṃ jinasantike. 13."],"lineRefs":[["bv23:6"]]},{"para":3535,"vripara":"13","refs":["bv23:6"],"lines":["“Ācāraguṇasampanno, vattasīlasamāhito;"],"lineRefs":[["bv23:6"]]},{"para":3536,"vripara":null,"refs":["bv23:6"],"lines":["Sabbaññutaṃ gavesanto, ramāmi jinasāsane. 14."],"lineRefs":[["bv23:6"]]},{"para":3538,"vripara":"14","refs":["bv23:6"],"lines":["“Saddhāpītiṃ upagantvā, buddhaṃ vandāmi sattharaṃ;"],"lineRefs":[["bv23:6"]]},{"para":3539,"vripara":null,"refs":["bv23:6"],"lines":["Pīti uppajjati mayhaṃ, bodhiyāyeva kāraṇā. 15."],"lineRefs":[["bv23:6"]]},{"para":3541,"vripara":"15","refs":["bv23:6"],"lines":["“Anivattamānasaṃ ñatvā, sambuddho etadabravi;"],"lineRefs":[["bv23:6"]]},{"para":3542,"vripara":null,"refs":["bv23:6"],"lines":["Ekattiṃse ito kappe, ayaṃ buddho bhavissati. 16."],"lineRefs":[["bv23:6"]]},{"para":3544,"vripara":"16","refs":["bv23:6"],"lines":["“Ahu kapilavhayā rammā…pe… hessāma sammukhaṃ imaṃ. 17."],"lineRefs":[["bv23:6"]]},{"para":3546,"vripara":"17","refs":["bv23:6"],"lines":["“Tassāhaṃ vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[["bv23:6"]]},{"para":3547,"vripara":null,"refs":["bv23:6"],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā”ti."],"lineRefs":[["bv23:6"]]},{"para":3548,"vripara":null,"refs":["bv23:6"],"lines":["Tattha <b>cakkaṃ vattita</b>nti dhammacakkaṃ pavattitaṃ.","<b>Paṇītaṃ dhamma</b>nti uttarimanussadhammaṃ.","<b>Pabbajjaṃ guṇasampanna</b>nti ñatvā pabbajinti attho.","<b>Vattasīlasamāhito</b>ti vattesu ca sīlesu ca samāhito.","Tesaṃ tesaṃ pūraṇe samāhitoti attho.","<b>Ramāmī</b>ti abhiramiṃ.","<b>Saddhāpīti</b>nti saddhañca pītiñca upagantvā.","<b>Vandāmī</b>ti abhivandiṃ, atītatthe vattamānavacanaṃ daṭṭhabbaṃ.","<b>Satthara</b>nti satthāraṃ.","<b>Anivattamānasa</b>nti anosakkiyamānamānasaṃ."],"lineRefs":[["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"]]},{"para":3549,"vripara":null,"refs":["bv23:6"],"lines":["Tassa pana bhagavato anomaṃ nāma nagaraṃ ahosi.","Suppatīto nāmassa pitā khattiyo, yasavatī nāma mātā, soṇo ca uttaro ca dve aggasāvakā, upasanto nāmupaṭṭhāko, rāmā ca samālā ca dve aggasāvikā, sālarukkho bodhi, sarīraṃ saṭṭhihatthubbedhaṃ ahosi.","Saṭṭhivassasahassāni āyu, sucittā nāmassa bhariyā, suppabuddho nāmassa putto, suvaṇṇasivikāya nikkhami.","Tena vuttaṃ – 18."],"lineRefs":[["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"]]},{"para":3551,"vripara":"18","refs":["bv23:6"],"lines":["“Anomaṃ nāma nagaraṃ, suppatīto nāma khattiyo;"],"lineRefs":[["bv23:6"]]},{"para":3552,"vripara":null,"refs":["bv23:6"],"lines":["Mātā yasavatī nāma, vessabhussa mahesino. 23."],"lineRefs":[["bv23:6"]]},{"para":3554,"vripara":"23","refs":["bv23:6"],"lines":["“Soṇo ca uttaro ceva, ahesuṃ aggasāvakā;"],"lineRefs":[["bv23:6"]]},{"para":3555,"vripara":null,"refs":["bv23:6"],"lines":["Upasanto nāmupaṭṭhāko, vessabhussa mahesino. 24."],"lineRefs":[["bv23:6"]]},{"para":3557,"vripara":"24","refs":["bv23:6"],"lines":["“Rāmā ceva samālā ca, ahesuṃ aggasāvikā;"],"lineRefs":[["bv23:6"]]},{"para":3558,"vripara":null,"refs":["bv23:6"],"lines":["Bodhi tassa bhagavato, mahāsāloti vuccati. 25."],"lineRefs":[["bv23:6"]]},{"para":3560,"vripara":"25","refs":["bv23:6"],"lines":["“Sotthiko ceva rammo ca, ahesuṃ aggupaṭṭhakā;"],"lineRefs":[["bv23:6"]]},{"para":3561,"vripara":null,"refs":["bv23:6"],"lines":["Gotamī sirimā ceva, ahesuṃ aggupaṭṭhikā. 26."],"lineRefs":[["bv23:6"]]},{"para":3563,"vripara":"26","refs":["bv23:6"],"lines":["“Saṭṭhiratanamubbedho, hemayūpasamūpamo;"],"lineRefs":[["bv23:6"]]},{"para":3564,"vripara":null,"refs":["bv23:6"],"lines":["Kāyā niccharatī rasmi, rattiṃva pabbate sikhī. 27."],"lineRefs":[["bv23:6"]]},{"para":3566,"vripara":"27","refs":["bv23:6"],"lines":["“Saṭṭhivassasahassāni, āyu tassa mahesino;"],"lineRefs":[["bv23:6"]]},{"para":3567,"vripara":null,"refs":["bv23:6"],"lines":["Tāvatā tiṭṭhamāno so, tāresi, janataṃ bahuṃ. 28."],"lineRefs":[["bv23:6"]]},{"para":3569,"vripara":"28","refs":["bv23:6"],"lines":["“Dhammaṃ vitthārikaṃ katvā, vibhajitvā mahājanaṃ;"],"lineRefs":[["bv23:6"]]},{"para":3570,"vripara":null,"refs":["bv23:6"],"lines":["Dhammanāvaṃ ṭhapetvāna, nibbuto so sasāvako. 29."],"lineRefs":[["bv23:6"]]},{"para":3572,"vripara":"29","refs":["bv23:6"],"lines":["“Dassaneyyaṃ sabbajanaṃ, vihāraṃ iriyāpathaṃ;"],"lineRefs":[["bv23:6"]]},{"para":3573,"vripara":null,"refs":["bv23:6"],"lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā”ti."],"lineRefs":[["bv23:6"]]},{"para":3574,"vripara":null,"refs":["bv23:6","bv23:29"],"lines":["Tattha <b>hemayūpasamūpamo</b>ti suvaṇṇatthambhasadisoti attho.","<b>Niccharatī</b>ti ito cito ca sandhāvati.","<b>Rasmī</b>ti pabhārasmi.","<b>Rattiṃva pabbate sikhī</b>ti rattiyaṃ pabbatamatthake aggi viya.","Raṃsivijjotā tassa kāyeti attho.","<b>Vibhajitvā</b>ti vibhāgaṃ katvā, ugghaṭitādivasena sotāpannādivasena cāti attho.","<b>Dhammanāva</b>nti aṭṭhaṅgamaggasaṅkhātaṃ dhammanāvaṃ, caturoghanittharaṇatthāya ṭhapetvāti attho.","<b>Dassaneyya</b>nti dassanīyo.","<b>Sabbajana</b>nti sabbo jano, sasāvakasaṅgho sammāsambuddhoti attho.","<b>Vihāra</b>nti vihāro, sabbattha paccatte upayogavacanaṃ daṭṭhabbaṃ."],"lineRefs":[["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:6"],["bv23:29"],["bv23:29"],["bv23:29"]]}],"wordLinks":[["bv23:6.3","bujjhare",0,6],["bv23:29.1","dassaneyyaṃ",44,7],["bv23:29.1","sabbajanaṃ",44,8],["bv23:29.1","vihāraṃ",44,9]],"before":[{"para":3489,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Vessabhūbuddhavaṃsavaṇṇanā"]},{"para":3490,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Sikhissa pana sammāsambuddhassa aparabhāge antarahite tassa sāsane sattativassasahassāyukā manussā anukkamena parihāyitvā dasavassāyukā ahesuṃ.","Puna vaḍḍhitvā aparimitāyukā hutvā anukkamena parihāyitvā saṭṭhivassasahassāyukā ahesuṃ.","Tadā vijitamanobhū sabbalokābhibhū sayambhū <b>vessabhū</b> nāma satthā loke udapādi.","So pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā anomanagare suppatītassa suppatītassa nāma rañño aggamahesiyā sīlavatiyā yasavatiyā nāma kucchismiṃ paṭisandhiṃ aggahesi.","So dasannaṃ māsānaṃ accayena anupamuyyāne mātukucchito nikkhami.","Jāyamānova janaṃ tosento vasabhanādaṃ nadi.","Tasmā vasabhanādahetuttā tassa nāmaggahaṇadivase “vessabhū”ti nāmamakaṃsu.","So chabbassasahassāni agāraṃ ajjhāvasi.","Ruci-suruci-rativaḍḍhananāmakā tayo pāsādā tassa ahesuṃ.","Sucittādevippamukhāni tiṃsa itthisahassāni paccupaṭṭhitāni ahesuṃ."]},{"para":3491,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["So cattāri nimittāni disvā sucittāya nāma deviyā suppabuddhe nāma kumāre uppanne suvaṇṇasivikāya uyyānadassanatthāya gantvā devadattāni kāsāyāni gahetvā pabbaji.","Taṃ sattattiṃsasahassāni anupabbajiṃsu.","Atha so tehi parivuto cha māse padhānacariyaṃ caritvā visākhapuṇṇamāya sucittanigame sandissamānasarīrāya sirivaḍḍhanāya nāma dinnaṃ madhupāyāsaṃ paribhuñjitvā sālavane divāvihāraṃ vītināmetvā sāyanhasamaye narindanāgarājena dinnā aṭṭha tiṇamuṭṭhiyo gahetvā sālabodhiṃ padakkhiṇato upāgami.","Tassāpi sālassa tadeva pāṭaliyā pamāṇameva pamāṇaṃ ahosi.","Tatheva pupphaphalasirivibhavo veditabbo.","So sālamūlamupagantvā cattālīsahatthavitthataṃ tiṇasantharaṃ santharitvā pallaṅkaṃ ābhujitvā vigatanīvaraṇaṃ sabbakāmamadāvaraṇaṃ anāvaraṇañāṇaṃ paṭilabhitvā –","“anekajātisaṃsāraṃ…pe… taṇhānaṃ khayamajjhagā”ti udānaṃ udānetvā sattasattāhaṃ tattheva vītināmetvā attano kaniṭṭhabhātikassa soṇakumārassa uttarakumārassa ca upanissayasampattiṃ disvā devapathena gantvā anomanagarasamīpe aruṇuyyāne otaritvā uyyānapālena kumāre pakkosāpetvā tesaṃ saparivārānaṃ majjhe dhammacakkaṃ pavattesi.","Tadā asītiyā koṭisahassānaṃ paṭhamo abhisamayo ahosi."]},{"para":3492,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Puna janapadacārikaṃ caranto bhagavā tattha tattha dhammaṃ desento sattatiyā koṭisahassānaṃ dhammābhisamayo ahosi, so dutiyo abhisamayo ahosi.","Anomanagareyeva diṭṭhijālaṃ bhindanto titthiyamānaddhajaṃ pātento mānamadaṃ viddhaṃsento dhammaddhajaṃ samussayanto navutiyojanavitthatāya manussaparisāya parimāṇarahitāya devaparisāya yamakapāṭihāriyaṃ katvā devamanusse pasādetvā saṭṭhikoṭiyo dhammāmatena tappesi, so tatiyo abhisamayo ahosi.","Tena vuttaṃ – 1."]},{"para":3494,"vripara":"1","title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["“Tattheva maṇḍakappamhi, asamo appaṭipuggalo;"]},{"para":3495,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Vessabhū nāma nāmena, loke uppajji nāyako. 2."]},{"para":3497,"vripara":"2","title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["“Ādittaṃ vata rāgaggi, taṇhānaṃ vijitaṃ tadā;"]},{"para":3498,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Nāgova bandhanaṃ chetvā, patto sambodhimuttamaṃ. 3."]},{"para":3500,"vripara":"3","title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["“Dhammacakkaṃ pavattente, vessabhūlokanāyake;"]},{"para":3501,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Asītikoṭisahassānaṃ, paṭhamābhisamayo ahu. 4."]},{"para":3503,"vripara":"4","title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["“Pakkante cārikaṃ raṭṭhe, lokajeṭṭhe narāsabhe;"]},{"para":3504,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Sattatikoṭisahassānaṃ, dutiyābhisamayo ahu. 5."]},{"para":3506,"vripara":"5","title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["“Mahādiṭṭhiṃ vinodento, pāṭiheraṃ karoti so;"]},{"para":3507,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Samāgatā naramarū, dasasahassī sadevake. 6."]},{"para":3509,"vripara":"6","title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["“Mahāacchariyaṃ disvā, abbhutaṃ lomahaṃsanaṃ;"]},{"para":3510,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Devā ceva manussā ca, bujjhare saṭṭhikoṭiyo”ti."]}],"after":[{"para":3575,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Vessabhū kira bhagavā usabhavatīnagare kheme migadāye parinibbāyi.","Dhātuyo panassa vippakiriṃsu."]},{"para":3576,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["“Usabhavatipure puruttame, jinavasabho bhagavā hi vessabhū;"]},{"para":3577,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Upavanavihare manorame, nirupadhisesamupāgato kirā”ti."]},{"para":3578,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Sesaṃ sabbattha gāthāsu pākaṭamevāti."]},{"para":3579,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Vessabhūbuddhavaṃsavaṇṇanā niṭṭhitā."]},{"para":3580,"vripara":null,"title":"Vessabhūbuddhavaṃsavaṇṇanā","lines":["Niṭṭhito ekavīsatimo buddhavaṃso. 24."]}]},"tika":null,"tika2":null}
