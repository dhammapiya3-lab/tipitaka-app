{"suttaId":"thag1.87","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[503,506],"vripara":"87"},"segments":{"thag1.87:0.4":"Paviṭṭhattheragāthā","thag1.87:1.1":"“Khandhā diṭṭhā yathābhūtaṃ, bhavā sabbe padālitā;","thag1.87:1.3":"Vikkhīṇo jātisaṃsāro, natthi dāni punabbhavo”ti.","thag1.87:1.5":"… Paviṭṭho thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2254,"to":2254,"paras":[{"para":2254,"vripara":null,"refs":["thag1.87:1"],"lines":["Tattha <b>khandhā</b>ti pañcupādānakkhandhā, te hi vipassanupalakkhaṇato sāmaññalakkhaṇato ca ñātapariññādīhi parijānanavasena vipassitabbā.","<b>Diṭṭhā yathābhūtan</b>ti vipassanāpaññāsahitāya maggapaññāya “idaṃ dukkhan”tiādinā aviparītato diṭṭhā.","<b>Bhavā sabbe padālitā</b>ti kāmabhavādayo sabbe kammabhavā upapattibhavā ca maggañāṇasatthena bhinnā viddhaṃsitā.","Kilesapadālaneneva hi kammopapattibhavā padālitā nāma honti.","Tenāha <b>“vikkhīṇo jātisaṃsāro, natthi dāni punabbhavo”</b>ti.","Tassattho heṭṭhā vuttoyeva."],"lineRefs":[["thag1.87:1"],["thag1.87:1"],["thag1.87:1"],["thag1.87:1"],["thag1.87:1"],["thag1.87:1"]]}],"wordLinks":[["thag1.87:1.1","khandhā",0,0],["thag1.87:1.1","diṭṭhā yathābhūtaṃ",0,1],["thag1.87:1.1","bhavā sabbe padālitā",0,2],["thag1.87:1.3","vikkhīṇo jātisaṃsāro natthi dāni punabbhavo",0,4]]},"tika":null}
