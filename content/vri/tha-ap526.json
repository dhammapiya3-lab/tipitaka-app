{"suttaId":"tha-ap526","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3541,3561],"vripara":"24"},"segments":{"tha-ap526:0.3":"Abbhañjanadāyakattheraapadānaṃ","tha-ap526:1.1":"“Nagare bandhumatiyā,","tha-ap526:1.2":"rājuyyāne vasāmahaṃ;","tha-ap526:1.3":"Cammavāsī tadā āsiṃ,","tha-ap526:1.4":"kamaṇḍaludharo ahaṃ.","tha-ap526:2.1":"“Addasaṃ vimalaṃ buddhaṃ,","tha-ap526:2.2":"sayambhuṃ aparājitaṃ;","tha-ap526:2.3":"Padhānaṃ pahitattaṃ taṃ,","tha-ap526:2.4":"jhāyiṃ jhānarataṃ vasiṃ [isiṃ (syā.)].","tha-ap526:3.1":"“Sabbakāmasamiddhiñca,","tha-ap526:3.2":"oghatiṇṇamanāsavaṃ;","tha-ap526:3.3":"Disvā pasanno sumano,","tha-ap526:3.4":"abbhañjanamadāsahaṃ.","tha-ap526:4.1":"“Ekanavutito kappe,","tha-ap526:4.2":"yaṃ dānamadadiṃ tadā;","tha-ap526:4.3":"Duggatiṃ nābhijānāmi,","tha-ap526:4.4":"abbhañjanassidaṃ phalaṃ.","tha-ap526:5.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap526:5.3":"viharāmi anāsavo.","tha-ap526:6.1":"“Svāgataṃ vata me āsi … pe …","tha-ap526:6.3":"kataṃ buddhassa sāsanaṃ.","tha-ap526:7.1":"“Paṭisambhidā catasso … pe …","tha-ap526:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap526:8.1":"Itthaṃ sudaṃ āyasmā abbhañjanadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap526:9.1":"Abbhañjanadāyakattherassāpadānaṃ catutthaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
