{"suttaId":"ja28","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[155,159],"vripara":"28"},"segments":{"ja28:0.4":"Nandivisālajātakaṃ","ja28:1.1":"Manuññameva bhāseyya, nāmanuññaṃ kudācanaṃ;","ja28:1.3":"Manuññaṃ bhāsamānassa, garuṃ bhāraṃ udaddhari;","ja28:1.5":"Dhanañca naṃ alābhesi, tena cattamano ahūti.","ja28:2.1":"Nandivisālajātakaṃ aṭṭhamaṃ."},"attha":null,"tika":null}
