{"suttaId":"an8.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-viii","vriCode":"s0404m1.mul","paras":[223,223],"vripara":"17"},"segments":{"an8.17:0.3":"Paṭhamabandhanasuttaṃ","an8.17:1.1":"“Aṭṭhahi, bhikkhave, ākārehi itthī purisaṃ bandhati.","an8.17:1.2":"Katamehi aṭṭhahi?","an8.17:1.3":"Ruṇṇena, bhikkhave, itthī purisaṃ bandhati;","an8.17:1.4":"hasitena, bhikkhave, itthī purisaṃ bandhati;","an8.17:1.5":"bhaṇitena, bhikkhave, itthī purisaṃ bandhati;","an8.17:1.6":"ākappena, bhikkhave, itthī purisaṃ bandhati;","an8.17:1.7":"vanabhaṅgena, bhikkhave, itthī purisaṃ bandhati;","an8.17:1.8":"gandhena, bhikkhave, itthī purisaṃ bandhati;","an8.17:1.9":"rasena, bhikkhave, itthī purisaṃ bandhati;","an8.17:1.10":"phassena, bhikkhave, itthī purisaṃ bandhati.","an8.17:1.11":"Imehi kho, bhikkhave, aṭṭhahākārehi itthī purisaṃ bandhati.","an8.17:1.12":"Te, bhikkhave, sattā subaddhā [subandhā (sī. syā. ka.)], ye [yeva (syā. pī. ka.)] phassena baddhā”ti [bandhāti (sī. syā. ka.)].","an8.17:1.13":"Sattamaṃ."},"attha":{"book":"Mp-viii","bookName":"Aṭṭhakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":87,"to":87,"paras":[{"para":87,"vripara":"17-18","refs":["an8.17:1"],"words":["ruṇṇenā","ākappenā","vanabhaṅgenā"],"lines":["17-18. Sattame <b>ruṇṇenā</b>ti ruditena.","<b>Ākappenā</b>ti nivāsanapārupanādinā vidhānena.","<b>Vanabhaṅgenā</b>ti vanato bhañjitvā āhaṭena pupphaphalādipaṇṇākārena.","Aṭṭhamepi eseva nayo."],"lineRefs":[["an8.17:1"],["an8.17:1"],["an8.17:1"],["an8.17:1"]]}]},"tika":null}
