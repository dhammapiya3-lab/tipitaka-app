{"suttaId":"ja143","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[801,804],"vripara":"143"},"segments":{"ja143:0.4":"Virocajātakaṃ","ja143:1.1":"Lasī ca te nipphalitā, matthako ca padālito [vidālito (sī. pī.)];","ja143:1.3":"Sabbā te phāsukā bhaggā, ajja kho tvaṃ virocasīti.","ja143:2.1":"Virocajātakaṃ tatiyaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":3012,"to":3012,"paras":[{"para":3012,"vripara":null,"refs":["ja143:1"],"lines":["Tattha <b>lasī</b>ti matthaluṅgaṃ.","<b>Nipphalitā</b>ti nikkhantā.","Evaṃ bodhisatto imaṃ gāthaṃ vatvā yāvatāyukaṃ ṭhatvā yathākammaṃ gato."],"lineRefs":[["ja143:1"],["ja143:1"],["ja143:1"]]}],"wordLinks":[["ja143:1.1","lasī",0,0],["ja143:1.1","nipphalitā",0,1]]},"tika":null}
