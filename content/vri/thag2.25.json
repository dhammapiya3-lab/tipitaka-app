{"suttaId":"thag2.25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[913,919],"vripara":"169"},"segments":{"thag2.25:0.4":"Vītasokattheragāthā","thag2.25:1.1":"“Kese me olikhissanti, kappako upasaṅkami;","thag2.25:1.3":"Tato ādāsamādāya, sarīraṃ paccavekkhisaṃ.","thag2.25:2.1":"“Tuccho kāyo adissittha, andhakāro tamo byagā;","thag2.25:2.3":"Sabbe coḷā samucchinnā, natthi dāni punabbhavo”ti.","thag2.25:2.5":"… Vītasoko thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":3962,"to":3962,"paras":[{"para":3962,"vripara":null,"refs":["thag2.25:2"],"lines":["Tattha <b>kese me olikhissanti, kappako upasaṅkamī</b>ti gihikāle massukammasamaye “mama kese olikhissaṃ kappemī”ti kesādīnaṃ chedanādivasena kappanato kappako nhāpito maṃ upagacchi.","<b>Tato</b>ti kappakato.","<b>Sarīraṃ paccavekkhisan</b>ti sabbakāyike ādāse palitavalitamukhanimittādidassanamukhena “abhibhūto vata jarāya me kāyo”ti jarābhibhūtaṃ attano sarīraṃ paccavekkhiṃ.","Evaṃ paccavekkhato ca <b>tuccho kāyo adissittha</b> niccadhuvasukhasabhāvādīhi ritto hutvā me kāyo adissatha paññāyi.","Kasmā?","<b>Andhakāre tamo byagā</b> yena ayonisomanasikārasaṅkhātena tamasā attano kāye andhagatā vijjamānampi asubhādisabhāvaṃ apassantā avijjamānaṃ subhādiākāraṃ gaṇhanti, tasmiṃ andhakāre andhakaraṇaṭṭhāne kāye yonisomanasikārasaṅkhātena ñāṇālokena avijjātamo vigato, tato eva <b>sabbe coḷā samucchinnā</b> corā viya kusalabhaṇḍacchedanato, sādhūhi alātabbato asaṅgahetabbato saṅkārakūṭādīsu chaḍḍitapilotikakhaṇḍaṃ viya issarajanena ariyajanena jigucchitabbatāya coḷā viyāti vā “coḷā”ti laddhanāmā kilesā samucchinnā.","Aggamaggena samugghāṭitattā eva ca nesaṃ <b>natthi dāni punabbhavo</b> āyatiṃ punabbhavābhinibbatti natthīti."],"lineRefs":[["thag2.25:2"],["thag2.25:2"],["thag2.25:2"],["thag2.25:2"],["thag2.25:2"],["thag2.25:2"],["thag2.25:2"]]}],"wordLinks":[["thag2.25:2.1","tuccho kāyo adissittha",0,3],["thag2.25:2.3","sabbe coḷā samucchinnā",0,5],["thag2.25:2.3","natthi dāni punabbhavo",0,6]],"before":[{"para":3860,"vripara":null,"refs":[],"lines":["Taṃ sutvā veṇudattatthero tassa kammaṭṭhānaṃ adāsi.","Sopi kammaṭṭhānaṃ anuyuñjanto nacirasseva vipassanaṃ ussukkāpetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.49.75-105)–"],"lineRefs":[[],[],[]]},{"para":3861,"vripara":null,"refs":[],"lines":["“Pañca kāmaguṇe hitvā, piyarūpe manorame;"],"lineRefs":[[]]},{"para":3862,"vripara":null,"refs":[],"lines":["Asīti koṭiyo hitvā, pabbajiṃ anagāriyaṃ."],"lineRefs":[[]]},{"para":3863,"vripara":null,"refs":[],"lines":["“Pabbajitvāna kāyena, pāpakammaṃ vivajjayiṃ;"],"lineRefs":[[]]},{"para":3864,"vripara":null,"refs":[],"lines":["Vacīduccaritaṃ hitvā, nadīkūle vasāmahaṃ."],"lineRefs":[[]]},{"para":3865,"vripara":null,"refs":[],"lines":["“Ekakaṃ maṃ viharantaṃ, buddhaseṭṭho upāgami;"],"lineRefs":[[]]},{"para":3866,"vripara":null,"refs":[],"lines":["Nāhaṃ jānāmi buddhoti, akāsiṃ paṭisanthāraṃ."],"lineRefs":[[]]},{"para":3867,"vripara":null,"refs":[],"lines":["“Karitvā paṭisanthāraṃ, nāmagottamapucchahaṃ;"],"lineRefs":[[]]},{"para":3868,"vripara":null,"refs":[],"lines":["Devatānusi gandhabbo, adu sakko purindado."],"lineRefs":[[]]},{"para":3869,"vripara":null,"refs":[],"lines":["“Ko vā tvaṃ kassa vā putto, mahābrahmā idhāgato;"],"lineRefs":[[]]},{"para":3870,"vripara":null,"refs":[],"lines":["Virocesi disā sabbā, udayaṃ sūriyo yathā."],"lineRefs":[[]]},{"para":3871,"vripara":null,"refs":[],"lines":["“Sahassārāni cakkāni, pāde dissanti mārisa;"],"lineRefs":[[]]},{"para":3872,"vripara":null,"refs":[],"lines":["Ko vā tvaṃ kassa vā putto, kathaṃ jānemu taṃ mayaṃ."],"lineRefs":[[]]},{"para":3873,"vripara":null,"refs":[],"lines":["“Nāmagottaṃ pavedehi, saṃsayaṃ apanehi me;"],"lineRefs":[[]]},{"para":3874,"vripara":null,"refs":[],"lines":["Namhi devā na gandhabbo, namhi sakko purindado."],"lineRefs":[[]]},{"para":3875,"vripara":null,"refs":[],"lines":["“Brahmabhāvo ca me natthi, etesaṃ uttamo ahaṃ;"],"lineRefs":[[]]},{"para":3876,"vripara":null,"refs":[],"lines":["Atīto visayaṃ tesaṃ, dālayiṃ kāmabandhanaṃ."],"lineRefs":[[]]},{"para":3877,"vripara":null,"refs":[],"lines":["“Sabbe kilese jhāpetvā, patto sambodhimuttamaṃ;"],"lineRefs":[[]]},{"para":3878,"vripara":null,"refs":[],"lines":["Tassa vācaṃ suṇitvāhaṃ, idaṃ vacanamabraviṃ."],"lineRefs":[[]]},{"para":3879,"vripara":null,"refs":[],"lines":["“Yadi buddhosi sabbaññū, nisīda tvaṃ mahāmune;"],"lineRefs":[[]]},{"para":3880,"vripara":null,"refs":[],"lines":["Tamahaṃ pūjayissāmi, dukkhassantakaro tuvaṃ."],"lineRefs":[[]]},{"para":3881,"vripara":null,"refs":[],"lines":["“Pattharitvājinacammaṃ, adāsi satthuno ahaṃ;"],"lineRefs":[[]]},{"para":3882,"vripara":null,"refs":[],"lines":["Nisīdi tattha bhagavā, sīhova girigabbhare."],"lineRefs":[[]]},{"para":3883,"vripara":null,"refs":[],"lines":["“Khippaṃ pabbatamāruyha, ambassa phalamaggahiṃ;"],"lineRefs":[[]]},{"para":3884,"vripara":null,"refs":[],"lines":["Sālakalyāṇikaṃ pupphaṃ, candanañca mahārahaṃ."],"lineRefs":[[]]},{"para":3885,"vripara":null,"refs":[],"lines":["“Khippaṃ paggayha taṃ sabbaṃ, upetvā lokanāyakaṃ;"],"lineRefs":[[]]},{"para":3886,"vripara":null,"refs":[],"lines":["Phalaṃ buddhassa datvāna, sālapupphamapūjayiṃ."],"lineRefs":[[]]},{"para":3887,"vripara":null,"refs":[],"lines":["“Candanaṃ anulimpitvā, avandiṃ satthuno ahaṃ;"],"lineRefs":[[]]},{"para":3888,"vripara":null,"refs":[],"lines":["Pasannacitto sumano, vipulāya ca pītiyā."],"lineRefs":[[]]},{"para":3889,"vripara":null,"refs":[],"lines":["“Ajinamhi nisīditvā, sumedho lokanāyako;"],"lineRefs":[[]]},{"para":3890,"vripara":null,"refs":[],"lines":["Mama kammaṃ pakittesi, hāsayanto mamaṃ tadā."],"lineRefs":[[]]},{"para":3891,"vripara":null,"refs":[],"lines":["“Iminā phaladānena, gandhamālehi cūbhayaṃ;"],"lineRefs":[[]]},{"para":3892,"vripara":null,"refs":[],"lines":["Pañcavīse kappasate, devaloke ramissati."],"lineRefs":[[]]},{"para":3893,"vripara":null,"refs":[],"lines":["“Anūnamanasaṅkappo, vasavattī bhavissati;"],"lineRefs":[[]]},{"para":3894,"vripara":null,"refs":[],"lines":["Chabbīsatikappasate, manussattaṃ gamissati."],"lineRefs":[[]]},{"para":3895,"vripara":null,"refs":[],"lines":["“Bhavissati cakkavattī, cāturanto mahiddhiko;"],"lineRefs":[[]]},{"para":3896,"vripara":null,"refs":[],"lines":["Vebhāraṃ nāma nagaraṃ, vissakammena māpitaṃ."],"lineRefs":[[]]},{"para":3897,"vripara":null,"refs":[],"lines":["“Hessati sabbasovaṇṇaṃ, nānāratanabhūsitaṃ;"],"lineRefs":[[]]},{"para":3898,"vripara":null,"refs":[],"lines":["Eteneva upāyena, saṃsarissati so bhave."],"lineRefs":[[]]},{"para":3899,"vripara":null,"refs":[],"lines":["“Sabbattha pūjito hutvā, devatte atha mānuse;"],"lineRefs":[[]]},{"para":3900,"vripara":null,"refs":[],"lines":["Pacchime bhave sampatte, brahmabandhu bhavissati."],"lineRefs":[[]]},{"para":3901,"vripara":null,"refs":[],"lines":["“Agārā abhinikkhamma, anagārī bhavissati;"],"lineRefs":[[]]},{"para":3902,"vripara":null,"refs":[],"lines":["Abhiññāpāragū hutvā, nibbāyissatināsavo."],"lineRefs":[[]]},{"para":3903,"vripara":null,"refs":[],"lines":["“Idaṃ vatvāna sambuddho, sumedho lokanāyako;"],"lineRefs":[[]]},{"para":3904,"vripara":null,"refs":[],"lines":["Mama nijjhāyamānassa, pakkāmi anilañjase."],"lineRefs":[[]]},{"para":3905,"vripara":null,"refs":[],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":3906,"vripara":null,"refs":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":3907,"vripara":null,"refs":[],"lines":["“Tusitato cavitvāna, nibbattiṃ mātukucchiyaṃ;"],"lineRefs":[[]]},{"para":3908,"vripara":null,"refs":[],"lines":["Bhoge me ūnatā natthi, yamhi gabbhe vasāmahaṃ."],"lineRefs":[[]]},{"para":3909,"vripara":null,"refs":[],"lines":["“Mātukucchigate mayi, annapānañca bhojanaṃ;"],"lineRefs":[[]]},{"para":3910,"vripara":null,"refs":[],"lines":["Mātuyā mama chandena, nibbattati yadicchakaṃ."],"lineRefs":[[]]},{"para":3911,"vripara":null,"refs":[],"lines":["“Jātiyā pañcavassena, pabbajiṃ anagāriyaṃ;"],"lineRefs":[[]]},{"para":3912,"vripara":null,"refs":[],"lines":["Oropitamhi kesamhi, arahattamapāpuṇiṃ."],"lineRefs":[[]]},{"para":3913,"vripara":null,"refs":[],"lines":["“Pubbakammaṃ gavesanto, orena nāddasaṃ ahaṃ;"],"lineRefs":[[]]},{"para":3914,"vripara":null,"refs":[],"lines":["Tiṃsakappasahassamhi, mama kammamanussariṃ."],"lineRefs":[[]]},{"para":3915,"vripara":null,"refs":[],"lines":["“Namo te purisājañña, namo te purisuttama;"],"lineRefs":[[]]},{"para":3916,"vripara":null,"refs":[],"lines":["Tava sāsanamāgamma, pattomhi acalaṃ padaṃ."],"lineRefs":[[]]},{"para":3917,"vripara":null,"refs":[],"lines":["“Tiṃsakappasahassamhi, yaṃ buddhamabhipūjayiṃ;"],"lineRefs":[[]]},{"para":3918,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":3919,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":3920,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā aññaṃ byākaronto thero imāyeva gāthā abhāsīti."],"lineRefs":[[]]},{"para":3921,"vripara":null,"refs":[],"lines":["Valliyattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3922,"vripara":null,"refs":[],"lines":["Vītasokattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":3923,"vripara":null,"refs":[],"lines":["<b>Kese me olikhissantī</b>tiādikā āyasmato vītasokattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto siddhatthassa bhagavato kāle brāhmaṇakule nibbattitvā brāhmaṇānaṃ vijjāsippesu nipphattiṃ gato kāme pahāya isipabbajjaṃ pabbajitvā mahatā isigaṇena parivuto araññe vasanto buddhuppādaṃ sutvā haṭṭhatuṭṭho “udumbarapupphasadisā dullabhadassanā buddhā bhagavanto, idāneva upagantabbā”ti mahatiyā parisāya saddhiṃ satthāraṃ daṭṭhuṃ gacchanto diyaḍḍhayojane sese byādhiko hutvā buddhagatāya saññāya kālaṅkato devesu uppajjitvā aparāparaṃ devamanussesu saṃsaranto imasmiṃ buddhuppāde aṭṭhārasavassādhikānaṃ dvinnaṃ vassasatānaṃ matthake dhammāsokarañño kaniṭṭhabhātā hutvā nibbatti, tassa <b>vītasoko</b>ti nāma ahosi.","So vayappatto khattiyakumārehi sikkhitabbavijjāsippesu nipphattiṃ gato giridattattheraṃ nissāya gihibhūto suttantapiṭake abhidhammapiṭake ca visārado hutvā ekadivasaṃ massukammasamaye kappakassa hatthato ādāsaṃ gahetvā kāyaṃ olokento valitapalitādīni disvā sañjātasaṃvego vipassanāya cittaṃ otāretvā bhāvanaṃ ussukkāpetvā tasmiṃyeva āsane sotāpanno hutvā giridattattherassa santike pabbajitvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.49.9-26)–"],"lineRefs":[[],[],[],[],[]]},{"para":3924,"vripara":null,"refs":[],"lines":["“Ajjhāyako mantadharo, tiṇṇaṃ vedāna pāragū;"],"lineRefs":[[]]},{"para":3925,"vripara":null,"refs":[],"lines":["Lakkhaṇe itihāse ca, sanighaṇḍusakeṭubhe."],"lineRefs":[[]]},{"para":3926,"vripara":null,"refs":[],"lines":["“Nadīsotapaṭibhāgā, sissā āyanti me tadā;"],"lineRefs":[[]]},{"para":3927,"vripara":null,"refs":[],"lines":["Tesāhaṃ mante vācemi, rattindivamatandito."],"lineRefs":[[]]},{"para":3928,"vripara":null,"refs":[],"lines":["“Siddhattho nāma sambuddho, loke uppajji tāvade;"],"lineRefs":[[]]},{"para":3929,"vripara":null,"refs":[],"lines":["Tamandhakāraṃ nāsetvā, ñāṇālokaṃ pavattayi."],"lineRefs":[[]]},{"para":3930,"vripara":null,"refs":[],"lines":["“Mama aññataro sisso, sissānaṃ so kathesi me;"],"lineRefs":[[]]},{"para":3931,"vripara":null,"refs":[],"lines":["Sutvāna te etamatthaṃ, ārocesuṃ mamaṃ tadā."],"lineRefs":[[]]},{"para":3932,"vripara":null,"refs":[],"lines":["“Buddho loke samuppanno, sabbaññū lokanāyako;"],"lineRefs":[[]]},{"para":3933,"vripara":null,"refs":[],"lines":["Tassānuvattati jano, lābho amhaṃ na vijjati."],"lineRefs":[[]]},{"para":3934,"vripara":null,"refs":[],"lines":["“Adhiccuppattikā buddhā, cakkhumanto mahāyasā;"],"lineRefs":[[]]},{"para":3935,"vripara":null,"refs":[],"lines":["Yaṃnūnāhaṃ buddhaseṭṭhaṃ, passeyyaṃ lokanāyakaṃ."],"lineRefs":[[]]},{"para":3936,"vripara":null,"refs":[],"lines":["“Ajinaṃ me gahetvāna, vākacīraṃ kamaṇḍaluṃ;"],"lineRefs":[[]]},{"para":3937,"vripara":null,"refs":[],"lines":["Assamā abhinikkhamma, sisse āmantayiṃ ahaṃ."],"lineRefs":[[]]},{"para":3938,"vripara":null,"refs":[],"lines":["“Odumbarikapupphaṃva, candamhi sasakaṃ yathā;"],"lineRefs":[[]]},{"para":3939,"vripara":null,"refs":[],"lines":["Vāyasānaṃ yathā khīraṃ, dullabho lokanāyako."],"lineRefs":[[]]},{"para":3940,"vripara":null,"refs":[],"lines":["“Buddho lokamhi uppanno, manussattampi dullabhaṃ;"],"lineRefs":[[]]},{"para":3941,"vripara":null,"refs":[],"lines":["Ubhosu vijjamānesu, savanañca sudullabhaṃ."],"lineRefs":[[]]},{"para":3942,"vripara":null,"refs":[],"lines":["“Buddho loke samuppanno, cakkhuṃ lacchāma no bhavaṃ;"],"lineRefs":[[]]},{"para":3943,"vripara":null,"refs":[],"lines":["Etha sabbe gamissāma, sammāsambuddhasantikaṃ."],"lineRefs":[[]]},{"para":3944,"vripara":null,"refs":[],"lines":["“Kamaṇḍaludharā sabbe, kharājinanivāsino;"],"lineRefs":[[]]},{"para":3945,"vripara":null,"refs":[],"lines":["Te jaṭābhārabharitā, nikkhamuṃ vipinā tadā."],"lineRefs":[[]]},{"para":3946,"vripara":null,"refs":[],"lines":["“Yugamattaṃ pekkhamānā, uttamatthaṃ gavesino;"],"lineRefs":[[]]},{"para":3947,"vripara":null,"refs":[],"lines":["Āsattidosarahitā, asambhītāva kesarī."],"lineRefs":[[]]},{"para":3948,"vripara":null,"refs":[],"lines":["“Appakiccā aloluppā, nipakā santavuttino;"],"lineRefs":[[]]},{"para":3949,"vripara":null,"refs":[],"lines":["Uñchāya caramānā te, buddhaseṭṭhamupāgamuṃ."],"lineRefs":[[]]},{"para":3950,"vripara":null,"refs":[],"lines":["“Diyaḍḍhayojane sese, byādhi me upapajjatha;"],"lineRefs":[[]]},{"para":3951,"vripara":null,"refs":[],"lines":["Buddhaseṭṭhaṃ saritvāna, tattha kālaṅkato ahaṃ."],"lineRefs":[[]]},{"para":3952,"vripara":null,"refs":[],"lines":["“Catunnavutito kappe, yaṃ saññamalabhiṃ tadā;"],"lineRefs":[[]]},{"para":3953,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhasaññāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":3954,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":3955,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā aññaṃ byākaronto –"],"lineRefs":[[]]},{"para":3957,"vripara":"169","refs":[],"lines":["“Kese me olikhissanti, kappako upasaṅkami;"],"lineRefs":[[]]},{"para":3958,"vripara":null,"refs":[],"lines":["Tato ādāsamādāya, sarīraṃ paccavekkhisaṃ."],"lineRefs":[[]]},{"para":3960,"vripara":"170","refs":[],"lines":["“Tuccho kāyo adissittha, andhakāre tamo byagā;"],"lineRefs":[[]]},{"para":3961,"vripara":null,"refs":[],"lines":["Sabbe coḷā samucchinnā, natthi dāni punabbhavo”ti.","– gāthādvayaṃ abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
