{"suttaId":"thag2.25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[913,919],"vripara":"169"},"segments":{"thag2.25:0.4":"Vītasokattheragāthā","thag2.25:1.1":"“Kese me olikhissanti, kappako upasaṅkami;","thag2.25:1.3":"Tato ādāsamādāya, sarīraṃ paccavekkhisaṃ.","thag2.25:2.1":"“Tuccho kāyo adissittha, andhakāro tamo byagā;","thag2.25:2.3":"Sabbe coḷā samucchinnā, natthi dāni punabbhavo”ti.","thag2.25:2.5":"… Vītasoko thero …."},"attha":null,"tika":null}
