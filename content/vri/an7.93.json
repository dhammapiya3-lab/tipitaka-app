{"suttaId":"an7.93","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[750,750],"vripara":"93"},"segments":{"an7.93:0.3":"Asaddhammasuttaṃ","an7.93:1.1":"“Sattime, bhikkhave, asaddhammā.","an7.93:1.2":"Katame satta?","an7.93:1.3":"Assaddho hoti, ahiriko hoti, anottappī hoti, appassuto hoti, kusīto hoti, muṭṭhassati hoti, duppañño hoti.","an7.93:1.4":"Ime kho, bhikkhave, satta asaddhammā”ti.","an7.93:1.5":"Navamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
