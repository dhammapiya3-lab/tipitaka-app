{"suttaId":"an5.91","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[716,716],"vripara":"91"},"segments":{"an5.91:0.3":"Paṭhamasampadāsuttaṃ","an5.91:1.1":"“Pañcimā, bhikkhave, sampadā.","an5.91:1.2":"Katamā pañca?","an5.91:1.3":"Saddhāsampadā, sīlasampadā, sutasampadā, cāgasampadā, paññāsampadā –","an5.91:1.4":"imā kho, bhikkhave, pañca sampadā”ti.","an5.91:1.5":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":214,"to":215,"paras":[{"para":214,"vripara":"91-92","refs":["an5.91:1"],"lines":["Pañcamassa paṭhame pañca sampadā missikā kathitā.","Dutiye purimā catasso missikā, pañcamī lokikāva. 3."],"lineRefs":[["an5.91:1"],["an5.91:1"]]},{"para":215,"vripara":null,"refs":["an5.91:1"],"lines":["Byākaraṇasuttavaṇṇanā 93."],"lineRefs":[["an5.91:1"]]}],"wordLinks":[],"before":[{"para":212,"vripara":null,"title":"5. Kakudhavaggo","lines":["Kakudhavaggo 1-2."]},{"para":213,"vripara":null,"title":"Sampadāsuttadvayavaṇṇanā","lines":["Sampadāsuttadvayavaṇṇanā 91-92."]}]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":220,"to":220,"paras":[{"para":220,"vripara":"91-100","refs":["an5.91:1"],"lines":["Pañcamassa paṭhame dutiye ca natthi vattabbaṃ.","Tatiye ājānanato <b>aññā,</b> uparimaggapaññā heṭṭhimamaggena ñātapariññāya eva jānanato.","Tassā pana phalabhāvato maggaphalapaññā taṃsahagatā sammāsaṅkappādayo ca idha “aññā”ti vuttā.","Aññāya byākaraṇāni <b>aññābyākaraṇāni</b>.","Tenevāha <b>“aññābyākaraṇānīti arahattabyākaraṇānī”</b>ti.","<b>Adhigatamānenā</b>ti appatte pattasaññī, anadhigate adhigatasaññī hutvā adhigataṃ mayāti mānena.","Catutthādīni uttānatthāneva."],"lineRefs":[["an5.91:1"],["an5.91:1"],["an5.91:1"],["an5.91:1"],["an5.91:1"],["an5.91:1"],["an5.91:1"]]}],"wordLinks":[["an5.91:1.3","aññā",0,1]]},"tika2":null}
