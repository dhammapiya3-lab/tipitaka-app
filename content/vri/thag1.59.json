{"suttaId":"thag1.59","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[344,347],"vripara":"59"},"segments":{"thag1.59:0.4":"Kosalavihārittheragāthā","thag1.59:1.1":"“Saddhāyāhaṃ pabbajito, araññe me kuṭikā katā;","thag1.59:1.3":"Appamatto ca ātāpī, sampajāno patissato”ti [paṭissatoti (ka.)].","thag1.59:1.5":"… Kosalavihāritthero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":1520,"to":1520,"paras":[{"para":1520,"vripara":"59","refs":["thag1.59:1"],"lines":["Tattha <b>saddhāyā</b>ti bhagavato vesāliṃ upagamane ānubhāvaṃ disvā,“ekantaniyyānikaṃ idaṃ sāsanaṃ, tasmā addhā imāya paṭipattiyā jarāmaraṇato muccissāmī”ti uppannasaddhāvasena <b>pabbajito</b> pabbajjaṃ upagato.","<b>Araññe me kuṭikā katā</b>ti tassā pabbajjāya anurūpavasena araññe vasato me kuṭikā katā, pabbajjānurūpaṃ āraññako hutvā vūpakaṭṭho viharāmīti dasseti.","Tenāha <b>“appamatto ca ātāpī, sampajāno patissato”</b>ti.","Araññavāsaladdhena kāyavivekena jāgariyaṃ anuyuñjanto tattha satiyā avippavāsena <b>appamatto,</b> āraddhavīriyatāya <b>ātāpī,</b> pubbabhāgiyasatisampajaññapāripūriyā vipassanaṃ vaḍḍhetvā arahattādhigamena paññāsativepullappattiyā accantameva <b>sampajāno patissato</b> viharāmīti attho.","Appamattabhāvādikittane cassa idameva aññābyākaraṇaṃ ahosi kosalaraṭṭhe ciranivāsibhāvena pana <b>kosalavihārī</b>ti samaññā jātāti."],"lineRefs":[["thag1.59:1"],["thag1.59:1"],["thag1.59:1"],["thag1.59:1"],["thag1.59:1"]]}],"wordLinks":[["thag1.59:1.1","pabbajito",0,0],["thag1.59:1.1","saddhāyā",0,0],["thag1.59:1.1","araññe me kuṭikā katā",0,1],["thag1.59:1.3","appamatto ca ātāpī sampajāno patissato",0,2],["thag1.59:1.3","appamatto",0,3],["thag1.59:1.3","sampajāno patissato",0,3],["thag1.59:1.3","ātāpī",0,3],["thag1.59:1.5","kosalavihārī",0,4]],"before":[{"para":1499,"vripara":null,"refs":[],"lines":["Ramaṇīyakuṭikattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1500,"vripara":null,"refs":[],"lines":["Kosalavihārittheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":1501,"vripara":null,"refs":[],"lines":["<b>Saddhāyāhaṃ pabbajito</b>ti āyasmato kosalavihārittherassa gāthā.","Kā uppatti?","Ayampi kira padumuttarassa bhagavato kāle kusalabījaṃ ropetvā taṃ taṃ puññaṃ akāsi.","Sesaṃ añjanavaniyattheravatthusadisameva.","Ayaṃ pana viseso – ayaṃ kira vuttanayena pabbajitvā katapubbakicco kosalaraṭṭhe aññatarasmiṃ gāme ekaṃ upāsakakulaṃ nissāya araññe viharati, taṃ so upāsako rukkhamūle vasantaṃ disvā kuṭikaṃ kāretvā adāsi.","Thero kuṭikāyaṃ viharanto āvāsasappāyena samādhānaṃ labhitvā vipassanaṃ ussukkāpetvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.11.53-61)–"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":1502,"vripara":null,"refs":[],"lines":["“Himavantassāvidūre, vasāmi paṇṇasanthare;"],"lineRefs":[[]]},{"para":1503,"vripara":null,"refs":[],"lines":["Ghāsesu gedhamāpanno, seyyasīlo cahaṃ tadā."],"lineRefs":[[]]},{"para":1504,"vripara":null,"refs":[],"lines":["“Khaṇantālukalambāni, biḷālitakkalāni ca;"],"lineRefs":[[]]},{"para":1505,"vripara":null,"refs":[],"lines":["Kolaṃ bhallātakaṃ billaṃ, āhatvā paṭiyāditaṃ."],"lineRefs":[[]]},{"para":1506,"vripara":null,"refs":[],"lines":["“Padumuttaro lokavidū, āhutīnaṃ paṭiggaho;"],"lineRefs":[[]]},{"para":1507,"vripara":null,"refs":[],"lines":["Mama saṅkappamaññāya, āgacchi mama santikaṃ."],"lineRefs":[[]]},{"para":1508,"vripara":null,"refs":[],"lines":["“Upāgataṃ mahānāgaṃ, devadevaṃ narāsabhaṃ;"],"lineRefs":[[]]},{"para":1509,"vripara":null,"refs":[],"lines":["Biḷāliṃ paggahetvāna, pattamhi okiriṃ ahaṃ."],"lineRefs":[[]]},{"para":1510,"vripara":null,"refs":[],"lines":["“Paribhuñji mahāvīro, tosayanto mamaṃ tadā;"],"lineRefs":[[]]},{"para":1511,"vripara":null,"refs":[],"lines":["Paribhuñjitvāna sabbaññū, imaṃ gāthaṃ abhāsatha."],"lineRefs":[[]]},{"para":1512,"vripara":null,"refs":[],"lines":["“Sakaṃ cittaṃ pasādetvā, biḷāliṃ me adā tuvaṃ;"],"lineRefs":[[]]},{"para":1513,"vripara":null,"refs":[],"lines":["Kappānaṃ satasahassaṃ, duggatiṃ nupapajjasi."],"lineRefs":[[]]},{"para":1514,"vripara":null,"refs":[],"lines":["“Carimaṃ vattate mayhaṃ, bhavā sabbe samūhatā;"],"lineRefs":[[]]},{"para":1515,"vripara":null,"refs":[],"lines":["Dhāremi antimaṃ dehaṃ, sammāsambuddhasāsane."],"lineRefs":[[]]},{"para":1516,"vripara":null,"refs":[],"lines":["“Catupaññāsito kappe, sumekhaliya savhayo;"],"lineRefs":[[]]},{"para":1517,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":1518,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":1519,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā vimuttisukhappaṭisaṃvedanena uppannapītivegena udānento <b>“saddhāyāhaṃ pabbajito”</b>ti gāthaṃ abhāsi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
