{"suttaId":"vv70","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2636,2649],"vripara":"1081"},"segments":{"vv70:0.4":"Bhikkhādāyakavimānavatthu","vv70:1.1":"“Uccamidaṃ maṇithūṇaṃ vimānaṃ,","vv70:1.2":"samantato dvādasa yojanāni;","vv70:1.3":"Kūṭāgārā sattasatā uḷārā,","vv70:1.4":"veḷuriyathambhā rucakatthatā subhā. 1082.","vv70:2.1":"“Deviddhipattosi mahānubhāvo,","vv70:2.2":"manussabhūto kimakāsi puññaṃ;","vv70:2.3":"Kenāsi evaṃ jalitānubhāvo,","vv70:2.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti. 1083.","vv70:3.1":"So devaputto attamano…pe…","vv70:3.3":"yassa kammassidaṃ phalaṃ. 1084.","vv70:4.1":"“Ahaṃ manussesu manussabhūto,","vv70:4.2":"disvāna bhikkhuṃ tasitaṃ kilantaṃ;","vv70:4.3":"Ekāhaṃ bhikkhaṃ paṭipādayissaṃ,","vv70:4.4":"samaṅgi bhattena tadā akāsiṃ. 1085.","vv70:5.1":"“Tena metādiso vaṇṇo…pe…","vv70:5.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv70:6.1":"Bhikkhādāyakavimānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3169,"to":3169,"paras":[{"para":3169,"vripara":"1084","refs":["vv70:4"],"lines":["Tattha <b>ekāhaṃ bhikkha</b>nti ekaṃ ahaṃ bhikkhāmattaṃ, ekaṃ bhattavaḍḍhitakanti attho.","<b>Paṭipādayissa</b>nti paṭipādesiṃ adāsiṃ.","<b>Samaṅgi bhattenā</b>ti bhattena samaṅgībhūtaṃ, laddhabhikkhanti attho.","Evaṃ mahāthero tena devaputtena attano sucaritakamme pakāsite saparivārassa tassa dhammaṃ desetvā manussalokamāgato, taṃ pavattiṃ sammāsambuddhassa kathesi.","Satthā taṃ aṭṭhuppattiṃ katvā sampattamahājanassa dhammaṃ desesi.","Sā desanā mahājanassa sātthikā ahosīti."],"lineRefs":[["vv70:4"],["vv70:4"],["vv70:4"],["vv70:4"],["vv70:4"],["vv70:4"]]}],"wordLinks":[["vv70:4.3","ekāhaṃ bhikkhaṃ",0,0],["vv70:4.3","paṭipādayissaṃ",0,1],["vv70:4.3","samaṅgi bhattenā",0,2]],"after":[{"para":3170,"vripara":null,"title":"Bhikkhādāyakavimānavaṇṇanā","lines":["Bhikkhādāyakavimānavaṇṇanā niṭṭhitā. 7."]}]},"tika":null,"tika2":null}
