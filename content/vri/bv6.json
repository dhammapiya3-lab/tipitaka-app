{"suttaId":"bv6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[1140,1240],"vripara":"1"},"segments":{"bv6:0.2":"Sumanabuddhavaṃso","bv6:1.1":"Maṅgalassa aparena,","bv6:1.2":"sumano nāma nāyako;","bv6:1.3":"Sabbadhammehi asamo,","bv6:1.4":"sabbasattānamuttamo. 2.","bv6:2.1":"Tadā amatabheriṃ so,","bv6:2.2":"āhanī mekhale pure;","bv6:2.3":"Dhammasaṅkhasamāyuttaṃ,","bv6:2.4":"navaṅgaṃ jinasāsanaṃ. 3.","bv6:3.1":"Nijjinitvā kilese so,","bv6:3.2":"patvā sambodhimuttamaṃ;","bv6:3.3":"Māpesi nagaraṃ satthā,","bv6:3.4":"saddhammapuravaruttamaṃ. 4.","bv6:4.1":"Nirantaraṃ akuṭilaṃ,","bv6:4.2":"ujuṃ vipulavitthataṃ;","bv6:4.3":"Māpesi so mahāvīthiṃ,","bv6:4.4":"satipaṭṭhānavaruttamaṃ. 5.","bv6:5.1":"Phale cattāri sāmaññe,","bv6:5.2":"catasso paṭisambhidā;","bv6:5.3":"Chaḷabhiññāṭṭhasamāpattī,","bv6:5.4":"pasāresi tattha vīthiyaṃ. 6.","bv6:6.1":"Ye appamattā akhilā,","bv6:6.2":"hirivīriyehupāgatā;","bv6:6.3":"Te te ime guṇavare,","bv6:6.4":"ādiyanti yathā sukhaṃ. 7.","bv6:7.1":"Evametena yogena,","bv6:7.2":"uddharanto mahājanaṃ;","bv6:7.3":"Bodhesi paṭhamaṃ satthā,","bv6:7.4":"koṭisatasahassiyo. 8.","bv6:8.1":"Yamhi kāle mahāvīro,","bv6:8.2":"ovadī titthiye gaṇe;","bv6:8.3":"Koṭisahassābhisamiṃsu [koṭisatasahassāni (syā. kaṃ.), koṭisatasahassānaṃ (ka.)],","bv6:8.4":"dutiye dhammadesane. 9.","bv6:9.1":"Yadā devā manussā ca,","bv6:9.2":"samaggā ekamānasā;","bv6:9.3":"Nirodhapañhaṃ pucchiṃsu,","bv6:9.4":"saṃsayañcāpi mānasaṃ. 10.","bv6:10.1":"Tadāpi dhammadesane,","bv6:10.2":"nirodhaparidīpane;","bv6:10.3":"Navutikoṭisahassānaṃ,","bv6:10.4":"tatiyābhisamayo ahu. 11.","bv6:11.1":"Sannipātā tayo āsuṃ,","bv6:11.2":"sumanassa mahesino;","bv6:11.3":"Khīṇāsavānaṃ vimalānaṃ,","bv6:11.4":"santacittāna tādinaṃ. 12.","bv6:12.1":"Vassaṃvutthassa bhagavato,","bv6:12.2":"abhighuṭṭhe pavāraṇe;","bv6:12.3":"Koṭisatasahassehi,","bv6:12.4":"pavāresi tathāgato. 13.","bv6:13.1":"Tatoparaṃ sannipāte,","bv6:13.2":"vimale kañcanapabbate;","bv6:13.3":"Navutikoṭisahassānaṃ,","bv6:13.4":"dutiyo āsi samāgamo. 14.","bv6:14.1":"Yadā sakko devarājā,","bv6:14.2":"buddhadassanupāgami;","bv6:14.3":"Asītikoṭisahassānaṃ,","bv6:14.4":"tatiyo āsi samāgamo. 15.","bv6:15.1":"Ahaṃ tena samayena,","bv6:15.2":"nāgarājā mahiddhiko;","bv6:15.3":"Atulo nāma nāmena,","bv6:15.4":"ussannakusalasañcayo. 16.","bv6:16.1":"Tadāhaṃ nāgabhāvanā,","bv6:16.2":"nikkhamitvā sañātibhi;","bv6:16.3":"Nāgānaṃ dibbaturiyehi,","bv6:16.4":"sasaṅghaṃ jinamupaṭṭhahiṃ. 17.","bv6:17.1":"Koṭisatasahassānaṃ,","bv6:17.2":"annapānena tappayiṃ;","bv6:17.3":"Paccekadussayugaṃ datvā,","bv6:17.4":"saraṇaṃ tamupāgamiṃ. 18.","bv6:18.1":"Sopi maṃ buddho byākāsi,","bv6:18.2":"sumano lokanāyako;","bv6:18.3":"“Aparimeyyito kappe,","bv6:18.4":"ayaṃ buddho bhavissati. 19.","bv6:19.1":"“Padhānaṃ padahitvāna…pe…","bv6:19.3":"hessāma sammukhā imaṃ”. 20.","bv6:20.1":"Tassāpi vacanaṃ sutvā,","bv6:20.2":"bhiyyo cittaṃ pasādayiṃ;","bv6:20.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv6:20.4":"dasapāramipūriyā. 21.","bv6:21.1":"Nagaraṃ mekhalaṃ nāma [mekhalaṃ nāma nagaraṃ (sī. syā.)],","bv6:21.2":"sudatto nāma khattiyo;","bv6:21.3":"Sirimā nāma janikā,","bv6:21.4":"sumanassa mahesino. 22.","bv6:22.1":"Navavassasahassāni,","bv6:22.2":"agāraṃ ajjha so vasi;","bv6:22.3":"Cando sucando vaṭaṃso ca,","bv6:22.4":"tayo pāsādamuttamā. 23.","bv6:23.1":"Tesaṭṭhisatasahassāni,","bv6:23.2":"nāriyo samalaṅkatā;","bv6:23.3":"Vaṭaṃsikā nāma nārī,","bv6:23.4":"anūpamo nāma atrajo. 24.","bv6:24.1":"Nimitte caturo disvā,","bv6:24.2":"hatthiyānena nikkhami;","bv6:24.3":"Anūnadasamāsāni,","bv6:24.4":"padhānaṃ padahī jino. 25.","bv6:25.1":"Brahmunā yācito santo,","bv6:25.2":"sumano lokanāyako;","bv6:25.3":"Vatti cakkaṃ mahāvīro,","bv6:25.4":"mekhale puramuttame. 26.","bv6:26.1":"Saraṇo bhāvitatto ca,","bv6:26.2":"ahesuṃ aggasāvakā;","bv6:26.3":"Udeno nāmupaṭṭhāko,","bv6:26.4":"sumanassa mahesino. 27.","bv6:27.1":"Soṇā ca upasoṇā ca,","bv6:27.2":"ahesuṃ aggasāvikā;","bv6:27.3":"Sopi buddho amitayaso,","bv6:27.4":"nāgamūle abujjhatha. 28.","bv6:28.1":"Varuṇo ceva saraṇo ca,","bv6:28.2":"ahesuṃ aggupaṭṭhakā;","bv6:28.3":"Cālā ca upacālā ca,","bv6:28.4":"ahesuṃ aggupaṭṭhikā. 29.","bv6:29.1":"Uccattanena [uccatarena (ka.)] so buddho,","bv6:29.2":"navutihatthamuggato;","bv6:29.3":"Kañcanagghiyasaṅkāso,","bv6:29.4":"dasasahassī virocati. 30.","bv6:30.1":"Navutivassasahassāni,","bv6:30.2":"āyu vijjati tāvade;","bv6:30.3":"Tāvatā tiṭṭhamāno so,","bv6:30.4":"tāresi janataṃ bahuṃ. 31.","bv6:31.1":"Tāraṇīye tārayitvā,","bv6:31.2":"bodhanīye ca bodhayi;","bv6:31.3":"Parinibbāyi sambuddho,","bv6:31.4":"uḷurājāva atthami. 32.","bv6:32.1":"Te ca khīṇāsavā bhikkhū,","bv6:32.2":"so ca buddho asādiso;","bv6:32.3":"Atulappabhaṃ dassayitvā,","bv6:32.4":"nibbutā ye mahāyasā. 33.","bv6:33.1":"Tañca ñāṇaṃ atuliyaṃ,","bv6:33.2":"tāni ca atulāni ratanāni;","bv6:33.3":"Sabbaṃ tamantarahitaṃ,","bv6:33.4":"nanu rittā sabbasaṅkhārā. 34.","bv6:34.1":"Sumano yasadharo buddho,","bv6:34.2":"aṅgārāmamhi nibbuto;","bv6:34.3":"Tattheva tassa jinathūpo,","bv6:34.4":"catuyojanamuggatoti.","bv6:35.1":"Sumanassa bhagavato vaṃso catuttho. 7."},"unsure":[],"preface":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":1963,"to":2016,"paras":[{"para":1963,"vripara":null,"refs":["bv6:1"],"lines":["Tattha <b>maṅgalassa aparenā</b>ti maṅgalassa bhagavato aparabhāge.","<b>Sabbadhammehi asamo</b>ti sabbehipi sīlasamādhipaññādhammehi asamo asadiso."],"lineRefs":[["bv6:1"],["bv6:1"]]},{"para":1964,"vripara":null,"refs":["bv6:1"],"lines":["<b>Sumano</b> kira bhagavā bodhisamīpeyeva sattasattāhāni vītināmetvā dhammadesanatthaṃ brahmāyācanaṃ sampaṭicchitvā –","“kassa nu kho ahaṃ paṭhamaṃ dhammaṃ deseyya”nti (dī. ni. 2.72; ma. ni. 1.284; 2.341; mahāva. 10) upadhārento attanā saha pabbajitānaṃ tiṃsakoṭiyo ca attano kaniṭṭhabhātikaṃ vemātikaṃ saraṇakumārañca purohitaputtaṃ bhāvitattamāṇavakañca upanissayasampanne disvā –","“etesaṃ paṭhamaṃ dhammaṃ deseyya”nti cintetvā haṃsarājā viya gaganapathena mekhaluyyāne otaritvā uyyānapālaṃ pesetvā attano kaniṭṭhabhātikaṃ saraṇakumārañca purohitaputtaṃ bhāvitattakumārañca pakkosāpetvā tesaṃ parivārabhūtā sattatiṃsakoṭiyo attanā saha pabbajitā tiṃsakoṭiyo ca aññe ca bahū devamanussakoṭiyo cāti evaṃ koṭisatasahassaṃ <b>dhammacakkappavattanena</b> dhammāmataṃ pāyesi.","Tena vuttaṃ – 2."],"lineRefs":[["bv6:1"],["bv6:1"],["bv6:1"],["bv6:1"]]},{"para":1966,"vripara":"2","refs":["bv6:1"],"lines":["“Tadā amatabheriṃ so, āhanī mekhale pure;"],"lineRefs":[["bv6:1"]]},{"para":1967,"vripara":null,"refs":["bv6:1"],"lines":["Dhammasaṅkhasamāyuttaṃ, navaṅgaṃ jinasāsana”nti."],"lineRefs":[["bv6:1"]]},{"para":1968,"vripara":null,"refs":["bv6:2"],"lines":["Tattha <b>amatabheri</b>nti amatādhigamāya nibbānādhigamāya bheriṃ.","<b>Āhanī</b>ti vādayi, dhammaṃ desesīti attho.","Sāyaṃ amatabherī nāma amatapariyosānaṃ navaṅgaṃ buddhavacanaṃ.","Tenevāha –","<b>“dhammasaṅkhasamāyuttaṃ, navaṅgaṃ jinasāsana”</b>nti.","Tattha <b>dhammasaṅkhasamāyutta</b>nti catusaccadhammakathāsaṅkhavarasamāyuttaṃ."],"lineRefs":[["bv6:2"],["bv6:2"],["bv6:2"],["bv6:2"],["bv6:2"],["bv6:2"]]},{"para":1969,"vripara":null,"refs":["bv6:2"],"lines":["Sumano pana lokanāyako abhisambodhiṃ pāpuṇitvā paṭiññānurūpaṃ paṭipadaṃ paṭipajjamāno mahājanassa bhavabandhanamokkhatthāya kusalaratanassa kilesacorehi viluppamānassa parittānatthaṃ sīlavipulapākāraṃ samādhiparikhāparivāritaṃ vipassanāñāṇadvāraṃ satisampajaññadaḷhakavāṭaṃ samāpattimaṇḍapādipaṭimaṇḍitaṃ bodhipakkhiyajanasamākulaṃ amatavaranagaraṃ māpesi.","Tena vuttaṃ – 3."],"lineRefs":[["bv6:2"],["bv6:2"]]},{"para":1971,"vripara":"3","refs":["bv6:2"],"lines":["“Nijjinitvā kilese so, patvā sambodhimuttamaṃ;"],"lineRefs":[["bv6:2"]]},{"para":1972,"vripara":null,"refs":["bv6:2"],"lines":["Māpesi nagaraṃ satthā, saddhammapuravaruttama”nti."],"lineRefs":[["bv6:2"]]},{"para":1973,"vripara":null,"refs":["bv6:3"],"lines":["Tattha <b>nijjinitvā</b>ti vijinitvā abhibhuyya, kilesābhisaṅkhāradevaputtamāre viddhaṃsetvāti attho.","<b>So</b>ti so sumano bhagavā.","“Vijinitvā kilese hī”tipi pāṭho.","Tattha <b>hi</b>-kāro padapūraṇamatte nipāto.","<b>Patvā</b>ti adhigantvā.","“Patto”tipi pāṭho.","<b>Nagara</b>nti nibbānanagaraṃ.","<b>Saddhammapuravaruttama</b>nti saddhammasaṅkhātaṃ puravaresu uttamaṃ seṭṭhaṃ padhānabhūtaṃ.","Atha vā saddhammamayesu puresu pavaresu uttamaṃ saddhammapuravaruttamaṃ.","Purimasmiṃ atthavikappe “nagara”nti tasseva vevacananti daṭṭhabbaṃ.","Paṭividdhadhammasabhāvānaṃ sekkhāsekkhānaṃ ariyapuggalānaṃ patiṭṭhānaṃ gocaranivāsaṭṭhena nibbānaṃ “nagara”nti vuccati.","Tasmiṃ pana saddhammavaranagare so satthā avicchinnaṃ akuṭilaṃ ujuṃ puthulañca vitthatañca satipaṭṭhānamayaṃ mahāvīthiṃ māpesi.","Tena vuttaṃ – 4."],"lineRefs":[["bv6:3"],["bv6:3"],["bv6:3"],["bv6:3"],["bv6:3"],["bv6:3"],["bv6:3"],["bv6:3"],["bv6:3"],["bv6:3"],["bv6:3"],["bv6:3"],["bv6:3"]]},{"para":1975,"vripara":"4","refs":["bv6:3"],"lines":["“Nirantaraṃ akuṭilaṃ, ujuṃ vipulavitthataṃ;"],"lineRefs":[["bv6:3"]]},{"para":1976,"vripara":null,"refs":["bv6:3"],"lines":["Māpesi so mahāvīthiṃ, satipaṭṭhānavaruttama”nti."],"lineRefs":[["bv6:3"]]},{"para":1977,"vripara":null,"refs":["bv6:4"],"lines":["Tattha <b>nirantara</b>nti kusalajavanasañcaraṇānantarabhāvato nirantaraṃ.","<b>Akuṭila</b>nti kuṭilabhāvakaradosavirahitato akuṭilaṃ.","<b>Uju</b>nti akuṭilattāva ujuṃ.","Purimapadasseva atthadīpakamidaṃ vacanaṃ.","<b>Vipulavitthata</b>nti āyāmato ca vitthārato ca puthulavitthataṃ, puthulavitthatabhāvo lokiyalokuttarasatipaṭṭhānavasena daṭṭhabbo.","<b>Mahāvīthi</b>nti mahāmaggaṃ.","<b>Satipaṭṭhānavaruttama</b>nti satipaṭṭhānañca taṃ varesu uttamañcāti satipaṭṭhānavaruttamaṃ.","Atha vā varaṃ satipaṭṭhānamayaṃ uttamavīthinti attho."],"lineRefs":[["bv6:4"],["bv6:4"],["bv6:4"],["bv6:4"],["bv6:4"],["bv6:4"],["bv6:4"],["bv6:4"]]},{"para":1978,"vripara":null,"refs":["bv6:4"],"lines":["Idāni tassa nibbānamahānagarassa tassaṃ satipaṭṭhānavīthiyaṃ cattāri sāmaññaphalāni catasso paṭisambhidā cha abhiññā aṭṭha samāpattiyoti imāni mahaggharatanāni ubhosu passesu dhammāpaṇe pasāresi.","Tena vuttaṃ – 5."],"lineRefs":[["bv6:4"],["bv6:4"]]},{"para":1980,"vripara":"5","refs":["bv6:4"],"lines":["“Phale cattāri sāmaññe, catasso paṭisambhidā;"],"lineRefs":[["bv6:4"]]},{"para":1981,"vripara":null,"refs":["bv6:4"],"lines":["Chaḷabhiññāṭṭhasamāpattī, pasāresi tattha vīthiya”nti."],"lineRefs":[["bv6:4"]]},{"para":1982,"vripara":null,"refs":["bv6:4"],"lines":["Idāni bhagavā imāni ratanabhaṇḍāni ye pana appamattā satimanto paṇḍitā hiriottappavīriyādīhi samannāgatā, te ādīyantīti tesaṃ ratanānaṃ haraṇūpāyaṃ dassento – 6."],"lineRefs":[["bv6:4"]]},{"para":1984,"vripara":"6","refs":["bv6:4"],"lines":["“Ye appamattā akhilā, hirivīriyehupāgatā;"],"lineRefs":[["bv6:4"]]},{"para":1985,"vripara":null,"refs":["bv6:4"],"lines":["Te te ime guṇavare, ādiyanti yathāsukha”nti. –","āha;"],"lineRefs":[["bv6:4"],["bv6:4"]]},{"para":1986,"vripara":null,"refs":["bv6:6"],"lines":["Tattha <b>ye</b>ti aniyamuddeso.","<b>Appamattā</b>ti pamādassa paṭipakkhabhūtena satiyā avippavāsalakkhaṇena appamādena samannāgatā.","<b>Akhilā</b>ti pañcacetokhilarahitā.","<b>Hirivīriyehupāgatā</b>ti kāyaduccaritādīhi hirīyatīti hirī, lajjāyetaṃ adhivacanaṃ.","Vīrassa bhāvo vīriyaṃ, taṃ ussāhalakkhaṇaṃ.","Tehi hirivīriyehi upāgatā samannāgatā bhabbapuggalā.","<b>Te</b>ti idaṃ pubbe aniyamuddesassa niyamuddeso.","Puna <b>te</b>ti vuttappakāre guṇaratanavisese te kulaputtā ādiyanti paṭilabhanti adhigacchantīti attho.","Sabbaṃ pana sumano bhagavā kataviditamano dhammabheriṃ āhanitvā dhammanagaraṃ māpetvā iminā nayena paṭhamameva satasahassakoṭiyo bodhesi.","Tena vuttaṃ – 7."],"lineRefs":[["bv6:6"],["bv6:6"],["bv6:6"],["bv6:6"],["bv6:6"],["bv6:6"],["bv6:6"],["bv6:6"],["bv6:6"],["bv6:6"]]},{"para":1988,"vripara":"7","refs":["bv6:6"],"lines":["“Evametena yogena, uddharanto mahājanaṃ;"],"lineRefs":[["bv6:6"]]},{"para":1989,"vripara":null,"refs":["bv6:6"],"lines":["Bodhesi paṭhamaṃ satthā, koṭisatasahassiyo”ti."],"lineRefs":[["bv6:6"]]},{"para":1990,"vripara":null,"refs":["bv6:7"],"lines":["Tattha <b>uddharanto</b>ti saṃsārasāgarato ariyamagganāvāya samuddharanto.","<b>Koṭisatasahassiyo</b>ti satasahassakoṭiyoti attho.","Vipariyāyena niddiṭṭhaṃ."],"lineRefs":[["bv6:7"],["bv6:7"],["bv6:7"]]},{"para":1991,"vripara":null,"refs":["bv6:7"],"lines":["Yadā pana sumano lokanāyako sunandavatīnagare ambarukkhamūle titthiyamadamānamaddanaṃ yamakapāṭihāriyaṃ katvā sattānaṃ koṭisahassaṃ dhammāmataṃ pāyesi.","Ayaṃ dutiyo abhisamayo ahosi.","Tena vuttaṃ – 8."],"lineRefs":[["bv6:7"],["bv6:7"],["bv6:7"]]},{"para":1993,"vripara":"8","refs":["bv6:7"],"lines":["“Yamhi kāle mahāvīro, ovadī titthiye gaṇe;"],"lineRefs":[["bv6:7"]]},{"para":1994,"vripara":null,"refs":["bv6:7"],"lines":["Koṭisahassā bhisamiṃsu, dutiye dhammadesane”ti."],"lineRefs":[["bv6:7"]]},{"para":1995,"vripara":null,"refs":["bv6:8"],"lines":["Tattha <b>titthiye gaṇe</b>ti titthiyabhūte gaṇe, titthiyānaṃ gaṇe vā “titthiye abhimaddanto, buddho dhammamadesayī”ti paṭhanti keci."],"lineRefs":[["bv6:8"]]},{"para":1996,"vripara":null,"refs":["bv6:8"],"lines":["Yadā pana dasasu cakkavāḷasahassesu devatā imasmiṃ cakkavāḷe sannipatitvā manussā ca nirodhakathaṃ samuṭṭhāpesuṃ –","“kathaṃ nirodhaṃ samāpajjanti, kathaṃ nirodhasamāpannā honti, kathaṃ nirodhā vuṭṭhahantī”ti?","Evaṃ samāpajjanaadhiṭṭhānavuṭṭhānādīsu vinicchayaṃ kātuṃ asakkontā saha manussehi chasu kāmāvacaradevalokesu devā ca navasu brahmalokesu brahmāno ca dveḷhakajātā dvidhā ahesuṃ.","Tato narasundarena arindamena nāma raññā saddhiṃ sāyanhasamaye sumanadasabalaṃ sabbalokanāthaṃ upasaṅkamiṃsu;","upasaṅkamitvā arindamo rājā bhagavantaṃ nirodhapañhaṃ pucchi.","Tato bhagavatā nirodhapañhe vissajjite navutipāṇakoṭisahassānaṃ dhammābhisamayo ahosi.","Ayaṃ tatiyo abhisamayo ahosi.","Tena vuttaṃ – 9."],"lineRefs":[["bv6:8"],["bv6:8"],["bv6:8"],["bv6:8"],["bv6:8"],["bv6:8"],["bv6:8"],["bv6:8"]]},{"para":1998,"vripara":"9","refs":["bv6:8"],"lines":["“Yadā devā manussā ca, samaggā ekamānasā;"],"lineRefs":[["bv6:8"]]},{"para":1999,"vripara":null,"refs":["bv6:8"],"lines":["Nirodhapañhaṃ pucchiṃsu, saṃsayaṃ cāpi mānasaṃ. 10."],"lineRefs":[["bv6:8"]]},{"para":2001,"vripara":"10","refs":["bv6:8"],"lines":["“Tadāpi dhammadesane, nirodhaparidīpane;"],"lineRefs":[["bv6:8"]]},{"para":2002,"vripara":null,"refs":["bv6:8"],"lines":["Navutikoṭisahassānaṃ, tatiyābhisamayo ahū”ti."],"lineRefs":[["bv6:8"]]},{"para":2003,"vripara":null,"refs":["bv6:8"],"lines":["Tassa pana sumanassa bhagavato tayo sāvakasannipātā ahesuṃ.","Tattha paṭhamasannipāte mekhalanagaraṃ upanissāya vassaṃ vasitvā paṭhamapavāraṇāya arahantānaṃ koṭisahassena ehibhikkhupabbajjāya pabbajitena saddhiṃ bhagavā pavāresi, ayaṃ paṭhamo sannipāto ahosi.","Athāparena samayena saṅkassanagarassāvidūre arindamarājakusalabalanibbatte yojanappamāṇe kanakapabbate nisinno saradasamayarucirakaranikaro divasakaro viya yugandharapabbate munivaradivasakaro arindamarājānaṃ parivāretvā āgatānaṃ purisānaṃ navutikoṭisahassāni dametvā sabbe ehibhikkhupabbajjāya pabbājetvā tasmiṃyeva divase arahattaṃ pattehi bhikkhūhi parivuto caturaṅgasamannāgate sannipāte pātimokkhaṃ uddisi.","Ayaṃ dutiyo sannipāto ahosi.","Yadā pana sakko devarājā sugatadassanatthāya upasaṅkami, tadā sumano bhagavā asītiyā arahantakoṭisahassehi parivuto pātimokkhaṃ uddisi, ayaṃ tatiyo sannipāto ahosi.","Tena vuttaṃ – 11."],"lineRefs":[["bv6:8"],["bv6:8"],["bv6:8"],["bv6:8"],["bv6:8"],["bv6:8"]]},{"para":2005,"vripara":"11","refs":["bv6:8"],"lines":["“Sannipātā tayo āsuṃ, sumanassa mahesino;"],"lineRefs":[["bv6:8"]]},{"para":2006,"vripara":null,"refs":["bv6:8"],"lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ. 12."],"lineRefs":[["bv6:8"]]},{"para":2008,"vripara":"12","refs":["bv6:8"],"lines":["“Vassaṃvuṭṭhassa bhagavato, abhighuṭṭhe pavāraṇe;"],"lineRefs":[["bv6:8"]]},{"para":2009,"vripara":null,"refs":["bv6:8"],"lines":["Koṭisatasahassehi, pavāresi tathāgato. 13."],"lineRefs":[["bv6:8"]]},{"para":2011,"vripara":"13","refs":["bv6:8"],"lines":["“Tato paraṃ sannipāte, vimale kañcanapabbate;"],"lineRefs":[["bv6:8"]]},{"para":2012,"vripara":null,"refs":["bv6:8"],"lines":["Navutikoṭisahassānaṃ, dutiyo āsi samāgamo. 14."],"lineRefs":[["bv6:8"]]},{"para":2014,"vripara":"14","refs":["bv6:8"],"lines":["“Yadā sakko devarājā, buddhadassanupāgami;"],"lineRefs":[["bv6:8"]]},{"para":2015,"vripara":null,"refs":["bv6:8"],"lines":["Asītikoṭisahassānaṃ, tatiyo āsi samāgamo”ti."],"lineRefs":[["bv6:8"]]},{"para":2016,"vripara":null,"refs":["bv6:8","bv6:14"],"lines":["Tattha <b>abhighuṭṭhe pavāraṇe</b>ti liṅgavipallāso daṭṭhabbo, abhighuṭṭhāya pavāraṇāyāti attho.","<b>Tatopara</b>nti tato aparabhāge.","<b>Kañcanapabbate</b>ti kanakamaye pabbate.","<b>Buddhadassanupāgamī</b>ti buddhadassanatthamupāgami.","Tadā kira amhākaṃ bodhisatto atulo nāma nāgarājā ahosi mahiddhiko mahānubhāvo.","So “loke buddho uppanno”ti sutvā ñātigaṇaparivuto sakabhavanā nikkhamitvā koṭisatasahassabhikkhuparivārassa sumanassa bhagavato dibbehi turiyehi upahāraṃ kāretvā mahādānaṃ pavattetvā paccekadussayugāni datvā saraṇesu patiṭṭhāsi.","Sopi naṃ satthā “anāgate buddho bhavissatī”ti byākāsi.","Tena vuttaṃ – 15."],"lineRefs":[["bv6:8"],["bv6:8"],["bv6:8"],["bv6:14"],["bv6:14"],["bv6:14"],["bv6:14"],["bv6:14"]]}],"wordLinks":[["bv6:1.1","maṅgalassa aparenā",0,0],["bv6:1.3","sabbadhammehi asamo",0,1],["bv6:1.1","sumano",1,0],["bv6:2.1","amatabheriṃ",4,0],["bv6:2.1","āhanī",4,1],["bv6:2.3","dhammasaṅkhasamāyuttaṃ navaṅgaṃ jinasāsanaṃ",4,4],["bv6:2.3","dhammasaṅkhasamāyuttaṃ",4,5],["bv6:3.1","nijjinitvā",8,0],["bv6:3.1","so",8,1],["bv6:3.1","hi",8,3],["bv6:3.1","patvā",8,4],["bv6:3.3","nagaraṃ",8,6],["bv6:3.3","saddhammapuravaruttamaṃ",8,7],["bv6:4.1","nirantaraṃ",11,0],["bv6:4.1","akuṭilaṃ",11,1],["bv6:4.1","ujuṃ",11,2],["bv6:4.1","vipulavitthataṃ",11,4],["bv6:4.3","mahāvīthiṃ",11,5],["bv6:4.3","satipaṭṭhānavaruttamaṃ",11,6],["bv6:6.1","ye",18,0],["bv6:6.1","appamattā",18,1],["bv6:6.1","akhilā",18,2],["bv6:6.1","hirivīriyehupāgatā",18,3],["bv6:6.3","te",18,6],["bv6:6.3","te",18,7],["bv6:7.1","uddharanto",21,0],["bv6:7.3","koṭisatasahassiyo",21,1],["bv6:8.1","titthiye gaṇe",25,0],["bv6:14.1","buddhadassanupāgamī",40,3]],"before":[{"para":1956,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Sumanabuddhavaṃsavaṇṇanā"]},{"para":1957,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Evaṃ ekappahāreneva dasasahassilokadhātuṃ ekandhakāraṃ katvā tasmiṃ bhagavati parinibbute tassa aparabhāge navutivassasahassāyukesu manussesu anukkamena parihāyitvā dasavassesu jātesu puna vaḍḍhitvā anukkamena asaṅkhyeyyāyukā hutvā puna parihāyitvā navutivassasahassāyukesu jātesu <b>sumano</b> nāma bodhisatto pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā mekhalanagare sudattassa nāma rañño kule sirimāya nāma deviyā kucchismiṃ paṭisandhiṃ aggahesi.","Pāṭihāriyāni pubbe vuttanayāneva."]},{"para":1958,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["So anukkamena vuddhippatto sirivaḍḍhanasomavaḍḍhanaiddhivaḍḍhananāmadheyyesu tīsu pāsādesu tesaṭṭhiyā nāṭakitthisatasahassehi paricāriyamāno surayuvatīhi paricāriyamāno devakumāro viya navavassasahassāni dibbasukhasadisaṃ visayasukhamanubhavamāno vaṭaṃsikāya nāma deviyā anupamaṃ nāma nirupamaṃ puttaṃ janetvā cattāri nimittāni disvā hatthiyānena nikkhamitvā pabbaji.","Taṃ pana pabbajantaṃ tiṃsakoṭiyo anupabbajiṃsu."]},{"para":1959,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["So tehi parivuto dasamāse padhānacariyaṃ caritvā visākhapuṇṇamāya anomanigame anomaseṭṭhino dhītāya anupamāya nāma dinnaṃ pakkhittadibbojaṃ pāyāsaṃ paribhuñjitvā sālavane divāvihāraṃ vītināmetvā anupamājīvakena dinnā aṭṭha tiṇamuṭṭhiyo gahetvā nāgabodhiṃ upagantvā taṃ padakkhiṇaṃ katvā aṭṭhahi tiṇamuṭṭhīhi tiṃsahatthavitthataṃ tiṇasantharaṃ katvā tattha pallaṅkaṃ ābhujitvā nisīdi.","Tato mārabalaṃ vidhamitvā sabbaññutaññāṇaṃ paṭivijjhitvā –","“anekajātisaṃsāraṃ…pe… taṇhānaṃ khayamajjhagā”ti (dha. pa. 153-154) udānaṃ udānesi.","Tena vuttaṃ – 1."]},{"para":1961,"vripara":"1","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Maṅgalassa aparena, sumano nāma nāyako;"]},{"para":1962,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Sabbadhammehi asamo, sabbasattānamuttamo”ti."]}],"after":[{"para":2018,"vripara":"15","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Ahaṃ tena samayena, nāgarājā mahiddhiko;"]},{"para":2019,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Atulo nāma nāmena, ussannakusalasañcayo. 16."]},{"para":2021,"vripara":"16","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Tadāhaṃ nāgabhavanā, nikkhamitvā sañātibhi;"]},{"para":2022,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Nāgānaṃ dibbaturiyehi, sasaṅghaṃ jinamupaṭṭhahiṃ. 17."]},{"para":2024,"vripara":"17","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Koṭisatasahassānaṃ, annapānena tappayiṃ;"]},{"para":2025,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Paccekadussayugaṃ datvā, saraṇaṃ tamupāgamiṃ. 18."]},{"para":2027,"vripara":"18","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Sopi maṃ buddho byākāsi, sumano lokanāyako;"]},{"para":2028,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Aparimeyyito kappe, ayaṃ buddho bhavissati. 19."]},{"para":2030,"vripara":"19","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Padhānaṃ padahitvāna…pe… hessāma sammukhā imaṃ”."]},{"para":2031,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Yathā koṇḍaññabuddhavaṃse, evaṃ aṭṭha gāthā vitthāretabbāti. 20."]},{"para":2033,"vripara":"20","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Tassāpi vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"]},{"para":2034,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā”ti."]},{"para":2035,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Tassa pana <b>sumanassa</b> bhagavato mekhalaṃ nāma nagaraṃ ahosi, sudatto nāma rājā pitā, sirimā nāma devī mātā, saraṇo ca bhāvitatto ca dve aggasāvakā, udeno nāmupaṭṭhāko, soṇā ca upasoṇā ca dve aggasāvikā, nāgarukkho bodhi, navutihatthubbedhaṃ sarīraṃ, navutiyeva vassasahassāni āyuppamāṇaṃ ahosi, vaṭaṃsikā nāmassa mahesī devī, anūpamo nāma putto ahosi, hatthiyānena nikkhami.","Upaṭṭhāko aṅgarājā.","Aṅgārāme vasīti.","Tena vuttaṃ – 21."]},{"para":2037,"vripara":"21","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Nagaraṃ mekhalaṃ nāma, sudatto nāma khattiyo;"]},{"para":2038,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Sirimā nāma janikā, sumanassa mahesino. 22."]},{"para":2040,"vripara":"22","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Navavassasahassāni, agāraṃ ajjha so vasi;"]},{"para":2041,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Cando sucando vaṭaṃso ca, tayo pāsādamuttamā. 23."]},{"para":2043,"vripara":"23","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Tesaṭṭhisatasahassāni, nāriyo samalaṅkatā;"]},{"para":2044,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Vaṭaṃsikā nāma nārī, anūpamo nāma atrajo. 24."]},{"para":2046,"vripara":"24","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Nimitte caturo disvā, hatthiyānena nikkhami;"]},{"para":2047,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Anūnadasamāsāni, padhānaṃ padahī jino. 25."]},{"para":2049,"vripara":"25","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Brahmunā yācito santo, sumano lokanāyako;"]},{"para":2050,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Vatti cakkaṃ mahāvīro, mekhale puramuttame. 26."]},{"para":2052,"vripara":"26","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Saraṇo bhāvitatto ca, ahesuṃ aggasāvakā;"]},{"para":2053,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Udeno nāmupaṭṭhāko, sumanassa mahesino. 27."]},{"para":2055,"vripara":"27","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Soṇā ca upasoṇā ca, ahesuṃ aggasāvikā;"]},{"para":2056,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Sopi buddho amitayaso, nāgamūle abujjhatha. 28."]},{"para":2058,"vripara":"28","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Varuṇo ceva saraṇo ca, ahesuṃ aggupaṭṭhakā;"]},{"para":2059,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Cālā ca upacālā ca, ahesuṃ aggupaṭṭhikā. 29."]},{"para":2061,"vripara":"29","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Uccattanena so buddho, navutihatthamuggato;"]},{"para":2062,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Kañcanagghiyasaṅkāso, dasasahassī virocati. 30."]},{"para":2064,"vripara":"30","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Navutivassasahassāni, āyu vijjati tāvade;"]},{"para":2065,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ. 31."]},{"para":2067,"vripara":"31","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Tāraṇīye tārayitvā, bodhanīye ca bodhayi;"]},{"para":2068,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Parinibbāyi sambuddho, uḷurājāva atthami. 32."]},{"para":2070,"vripara":"32","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Te ca khīṇāsavā bhikkhū, so ca buddho asādiso;"]},{"para":2071,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Atulappabhaṃ dassayitvā, nibbutā te mahāyasā. 33."]},{"para":2073,"vripara":"33","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Tañca ñāṇaṃ atuliyaṃ, tāni ca atulāni ratanāni;"]},{"para":2074,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā. 34."]},{"para":2076,"vripara":"34","title":"Sumanabuddhavaṃsavaṇṇanā","lines":["“Sumano yasadharo buddho, aṅgārāmamhi nibbuto;"]},{"para":2077,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Tattheva tassa jinathūpo, catuyojanamuggato”ti."]},{"para":2078,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Tattha <b>kañcanagghiyasaṅkāso</b>ti vividharatanavicittakañcanamayagghikasadisarūpasobho.","<b>Dasasahassī virocatī</b>ti tassa pabhāya dasasahassīpi lokadhātu virocatīti attho.","<b>Tāraṇīye</b>ti tārayitabbe, tārayituṃ vutte sabbe buddhaveneyyeti attho.","<b>Uḷurājāvā</b>ti cando viya.","<b>Atthamī</b>ti atthaṅgato.","Keci “atthaṃ gato”ti paṭhanti.","<b>Asādiso</b>ti asadiso.","<b>Mahāyasā</b>ti mahākittisaddā mahāparivārā ca.","<b>Tañca ñāṇa</b>nti taṃ sabbaññutaññāṇañca.","<b>Atuliya</b>nti atulyaṃ asadisaṃ.","Sesaṃ sabbattha uttānamevāti."]},{"para":2079,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Sumanabuddhavaṃsavaṇṇanā niṭṭhitā."]},{"para":2080,"vripara":null,"title":"Sumanabuddhavaṃsavaṇṇanā","lines":["Niṭṭhito catuttho buddhavaṃso. 7."]}]},"tika":null,"tika2":null}
