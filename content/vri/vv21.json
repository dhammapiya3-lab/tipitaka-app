{"suttaId":"vv21","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[640,673],"vripara":"195"},"segments":{"vv21:0.4":"Caṇḍālivimānavatthu","vv21:1.1":"“Caṇḍāli vanda pādāni,","vv21:1.2":"gotamassa yasassino;","vv21:1.3":"Tameva [taveva (sī.)] anukampāya,","vv21:1.4":"aṭṭhāsi isisattamo [isisuttamo (sī.)].","vv21:2.1":"“Abhippasādehi manaṃ,","vv21:2.2":"arahantamhi tādini [tādine (syā. ka.)];","vv21:2.3":"Khippaṃ pañjalikā vanda,","vv21:2.4":"parittaṃ tava jīvitan”ti.","vv21:3.1":"Coditā bhāvitattena,","vv21:3.2":"sarīrantimadhārinā;","vv21:3.3":"Caṇḍālī vandi pādāni,","vv21:3.4":"gotamassa yasassino.","vv21:4.1":"Tamenaṃ avadhī gāvī,","vv21:4.2":"caṇḍāliṃ pañjaliṃ ṭhitaṃ;","vv21:4.3":"Namassamānaṃ sambuddhaṃ,","vv21:4.4":"andhakāre pabhaṅkaranti.","vv21:5.1":"“Khīṇāsavaṃ vigatarajaṃ anejaṃ,","vv21:5.2":"ekaṃ araññamhi raho nisinnaṃ;","vv21:5.3":"Deviddhipattā upasaṅkamitvā,","vv21:5.4":"vandāmi taṃ vīra mahānubhāvan”ti.","vv21:6.1":"“Suvaṇṇavaṇṇā jalitā mahāyasā,","vv21:6.2":"vimānamoruyha anekacittā;","vv21:6.3":"Parivāritā accharāsaṅgaṇena [accharānaṃ gaṇena (sī.)],","vv21:6.4":"kā tvaṃ subhe devate vandase maman”ti.","vv21:7.1":"“Ahaṃ bhaddante caṇḍālī,","vv21:7.2":"tayā vīrena [therena (ka.)] pesitā;","vv21:7.3":"Vandiṃ arahato pāde,","vv21:7.4":"gotamassa yasassino.","vv21:8.1":"“Sāhaṃ vanditvā [vanditva (sī.)] pādāni,","vv21:8.2":"cutā caṇḍālayoniyā;","vv21:8.3":"Vimānaṃ sabbato bhaddaṃ,","vv21:8.4":"upapannamhi nandane.","vv21:9.1":"“Accharānaṃ satasahassaṃ,","vv21:9.2":"purakkhatvāna [purakkhitvā maṃ (syā. ka.)] tiṭṭhati;","vv21:9.3":"Tāsāhaṃ pavarā seṭṭhā,","vv21:9.4":"vaṇṇena yasasāyunā.","vv21:10.1":"“Pahūtakatakalyāṇā,","vv21:10.2":"sampajānā paṭissatā [patissatā (sī. syā.)];","vv21:10.3":"Muniṃ kāruṇikaṃ loke,","vv21:10.4":"taṃ bhante vanditumāgatā”ti.","vv21:11.1":"Idaṃ vatvāna caṇḍālī,","vv21:11.2":"kataññū katavedinī;","vv21:11.3":"Vanditvā arahato pāde,","vv21:11.4":"tatthevantaradhāyathāti [tatthevantaradhāyatīti (syā. ka.)].","vv21:12.1":"Caṇḍālivimānaṃ catutthaṃ."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":932,"to":970,"paras":[{"para":932,"vripara":"195","refs":["vv21:1"],"lines":["Tattha <b>caṇḍālī</b>ti jātiāgatena nāmena taṃ ālapati.","<b>Vandā</b>ti abhivādaya.","<b>Pādānī</b>ti sadevakassa lokassa saraṇāni caraṇāni.","<b>Tameva anukampāyā</b>ti tameva anuggaṇhanatthaṃ, apāyūpapattito nisedhetvā sagge nibbattāpanatthanti adhippāyo.","<b>Aṭṭhāsī</b>ti nagarampi apavisitvā ṭhito.","<b>Isisattamo</b>ti lokiyasekkhāsekkhapaccekabuddhaisīhi uttamo ukkaṭṭhatamo, atha vā buddhaisīnaṃ vipassiādīnaṃ sattamoti isisattamo."],"lineRefs":[["vv21:1"],["vv21:1"],["vv21:1"],["vv21:1"],["vv21:1"],["vv21:1"]]},{"para":933,"vripara":"196","refs":["vv21:2"],"lines":["<b>Abhippasādehi manan</b>ti “sammāsambuddho bhagavā”ti tava cittaṃ pasādehi.","<b>Arahantamhi tādinī</b>ti ārakattā kilesānaṃ, tesaṃyeva arīnaṃ hatattā, saṃsāracakkassa arānaṃ hatattā, paccayānaṃ arahattā, pāpakaraṇe rahābhāvā ca arahante, iṭṭhādīsu tādibhāvappattiyā tādimhi.","<b>Khippaṃ pañjalikā vandā</b>ti sīghaṃyeva paggahitaañjalikā hutvā vandassu.","Kasmāti ce?","<b>Parittaṃ tava jīvitan</b>ti, idāneva bhijjanasabhāvattā parittaṃ atiittaraṃ."],"lineRefs":[["vv21:2"],["vv21:2"],["vv21:2"],["vv21:2"],["vv21:2"]]},{"para":934,"vripara":null,"refs":["vv21:2"],"lines":["Iti thero gāthādvayena bhagavato guṇe pakittento attano ānubhāve ṭhatvā tassā ca khīṇāyukatāvibhāvanena saṃvejento satthu vandanāya niyojesi.","Sā ca taṃ sutvā saṃvegajātā satthari pasannamānasāva hutvā pañcapatiṭṭhitena vanditvā añjaliṃ katvā namassamānā buddhagatāya pītiyā ekaggacittā hutvā aṭṭhāsi.","Bhagavā “alamettakametissā saggūpapattiyā”ti nagaraṃ pāvisi saddhiṃ bhikkhusaṅghena.","Atha naṃ ekā bhantā gāvī taruṇavacchā tato eva abhidhāvantī siṅgena paharitvā jīvitā voropesi.","Taṃ sabbaṃ dassetuṃ saṅgītikārā –"],"lineRefs":[["vv21:2"],["vv21:2"],["vv21:2"],["vv21:2"],["vv21:2"]]},{"para":936,"vripara":"197","refs":["vv21:2"],"lines":["“Coditā bhāvitattena, sarīrantimadhārinā;"],"lineRefs":[["vv21:2"]]},{"para":937,"vripara":null,"refs":["vv21:2"],"lines":["Caṇḍālī vandi pādāni, gotamassa yasassino."],"lineRefs":[["vv21:2"]]},{"para":939,"vripara":"198","refs":["vv21:2"],"lines":["“Tamenaṃ avadhī gāvī, caṇḍāliṃ pañjaliṃ ṭhitaṃ;"],"lineRefs":[["vv21:2"]]},{"para":940,"vripara":null,"refs":["vv21:2"],"lines":["Namassamānaṃ sambuddhaṃ, andhakāre pabhaṅkaran”ti.","– gāthādvayamāhaṃsu;"],"lineRefs":[["vv21:2"],["vv21:2"]]},{"para":941,"vripara":"198","refs":["vv21:2","vv21:4"],"lines":["Tattha <b>pañjaliṃ ṭhitaṃ namassamānaṃ sambuddhan</b>ti gatepi bhagavati buddhārammaṇāya pītiyā samāhitā hutvā sammukhā viya añjaliṃ paggayha namassamānaṃ ṭhitaṃ.","<b>Andhakāre</b>ti avijjandhakārena sakalena kilesandhakārena ca andhakāre loke.","<b>Pabhaṅkaran</b>ti ñāṇobhāsakaraṃ."],"lineRefs":[["vv21:2"],["vv21:4"],["vv21:4"]]},{"para":942,"vripara":null,"refs":["vv21:4"],"lines":["Sā ca tato cutā tāvatiṃsesu nibbatti, accharānaṃ satasahassaṃ cassā parivāro ahosi.","Tadaheva ca sā saha vimānena āgantvā vimānato otaritvā āyasmantaṃ mahāmoggallānaṃ upasaṅkamitvā vandi.","Tamatthaṃ dassetuṃ –"],"lineRefs":[["vv21:4"],["vv21:4"],["vv21:4"]]},{"para":944,"vripara":"199","refs":["vv21:4"],"lines":["“Khīṇāsavaṃ vigatarajaṃ anejaṃ, ekaṃ araññamhi raho nisinnaṃ;"],"lineRefs":[["vv21:4"]]},{"para":945,"vripara":null,"refs":["vv21:4"],"lines":["Deviddhipattā upasaṅkamitvā, vandāmi taṃ vīra mahānubhāvan”ti.","–"],"lineRefs":[["vv21:4"],["vv21:4"]]},{"para":946,"vripara":null,"refs":["vv21:4"],"lines":["Devatā āha.","Taṃ thero pucchi –"],"lineRefs":[["vv21:4"],["vv21:4"]]},{"para":948,"vripara":"200","refs":["vv21:4"],"lines":["“Suvaṇṇavaṇṇā jalitā mahāyasā, vimānamoruyha anekacittā;"],"lineRefs":[["vv21:4"]]},{"para":949,"vripara":null,"refs":["vv21:4"],"lines":["Parivāritā accharāsaṅgaṇena, kā tvaṃ subhe devate vandase maman”ti."],"lineRefs":[["vv21:4"]]},{"para":950,"vripara":"200","refs":["vv21:6"],"lines":["Tattha <b>jalitā</b>ti attano sarīrappabhāya vatthābharaṇādīnaṃ obhāsena ca jalantī jotentī.","<b>Mahāyasā</b>ti mahāparivārā.","<b>Vimānamoruyhā</b>ti vimānato oruyha.","<b>Anekacittā</b>ti anekavidhacittatāyuttā.","<b>Subhe</b>ti subhaguṇe.","<b>Maman</b>ti maṃ."],"lineRefs":[["vv21:6"],["vv21:6"],["vv21:6"],["vv21:6"],["vv21:6"],["vv21:6"]]},{"para":951,"vripara":null,"refs":["vv21:6"],"lines":["Evaṃ therena pucchitā puna sā –"],"lineRefs":[["vv21:6"]]},{"para":953,"vripara":"201","refs":["vv21:6"],"lines":["“Ahaṃ bhaddante caṇḍālī, tayā vīrena pesitā;"],"lineRefs":[["vv21:6"]]},{"para":954,"vripara":null,"refs":["vv21:6"],"lines":["Vandiṃ arahato pāde, gotamassa yasassino."],"lineRefs":[["vv21:6"]]},{"para":956,"vripara":"202","refs":["vv21:6"],"lines":["“Sāhaṃ vanditvā pādāni, cutā caṇḍālayoniyā;"],"lineRefs":[["vv21:6"]]},{"para":957,"vripara":null,"refs":["vv21:6"],"lines":["Vimānaṃ sabbato bhaddaṃ, upapannamhi nandane."],"lineRefs":[["vv21:6"]]},{"para":959,"vripara":"203","refs":["vv21:6"],"lines":["“Accharānaṃ satasahassaṃ, purakkhatvāna tiṭṭhati;"],"lineRefs":[["vv21:6"]]},{"para":960,"vripara":null,"refs":["vv21:6"],"lines":["Tāsāhaṃ pavarā seṭṭhā, vaṇṇena yasasāyunā."],"lineRefs":[["vv21:6"]]},{"para":962,"vripara":"204","refs":["vv21:6"],"lines":["“Pahūtakatakalyāṇā, sampajānā paṭissatā;"],"lineRefs":[["vv21:6"]]},{"para":963,"vripara":null,"refs":["vv21:6"],"lines":["Muniṃ kāruṇikaṃ loke, taṃ bhante vanditumāgatā”ti.","–"],"lineRefs":[["vv21:6"],["vv21:6"]]},{"para":964,"vripara":null,"refs":["vv21:6"],"lines":["Catasso gāthāyo āha."],"lineRefs":[["vv21:6"]]},{"para":965,"vripara":"201-204","refs":["vv21:7"],"lines":["201-4. Tattha <b>pesitā</b>ti “caṇḍāli, vanda pādānī”tiādinā vandanāya uyyojitā.","Yadipi taṃ vandanāmayaṃ puññaṃ pavattikkhaṇavasena parittaṃ, khettamahantatāya pana phalamahantatāya ca ativiya mahantamevāti āha <b>“pahūtakatakalyāṇā”</b>ti.","Tathā buddhārammaṇāya pītiyā pavattikkhaṇe paññāya satiyā ca visadabhāvaṃ sandhāyāha <b>“sampajānā paṭissatā”</b>ti.","Puna –"],"lineRefs":[["vv21:7"],["vv21:7"],["vv21:7"],["vv21:7"]]},{"para":967,"vripara":"205","refs":["vv21:7"],"lines":["“Idaṃ vatvāna caṇḍālī, kataññū katavedinī;"],"lineRefs":[["vv21:7"]]},{"para":968,"vripara":null,"refs":["vv21:7"],"lines":["Vanditvā arahato pāde, tatthevantaradhāyathā”ti.","–"],"lineRefs":[["vv21:7"],["vv21:7"]]},{"para":969,"vripara":null,"refs":["vv21:7"],"lines":["Gāthā saṅgītikārehi ṭhapitā."],"lineRefs":[["vv21:7"]]},{"para":970,"vripara":"205","refs":["vv21:11"],"lines":["Tattha <b>caṇḍālī</b>ti caṇḍālībhūtapubbāti katvā vuttaṃ, devaloke ca idamāciṇṇaṃ, yaṃ manussaloke niruḷhasamaññāya vohāro.","Sesaṃ vuttanayameva."],"lineRefs":[["vv21:11"],["vv21:11"]]}],"wordLinks":[["vv21:1.1","caṇḍālī",0,0],["vv21:1.1","vandā",0,1],["vv21:1.1","pādānī",0,2],["vv21:1.3","tameva anukampāyā",0,3],["vv21:1.3","aṭṭhāsī",0,4],["vv21:1.3","isisattamo",0,5],["vv21:2.1","abhippasādehi manaṃ",1,0],["vv21:2.1","arahantamhi tādinī",1,1],["vv21:2.3","khippaṃ pañjalikā vandā",1,2],["vv21:2.3","parittaṃ tava jīvitaṃ",1,4],["vv21:4.3","andhakāre",7,1],["vv21:4.3","pabhaṅkaraṃ",7,2],["vv21:6.1","jalitā",14,0],["vv21:6.1","mahāyasā",14,1],["vv21:6.1","vimānamoruyhā",14,2],["vv21:6.1","anekacittā",14,3],["vv21:6.3","subhe",14,4],["vv21:6.3","mamaṃ",14,5],["vv21:7.1","pesitā",25,0],["vv21:11.1","caṇḍālī",29,0]],"before":[{"para":922,"vripara":null,"refs":[],"lines":["Idha sakkena devarājena attanā ca vuttaṃ sabbaṃ āyasmā mahākassapatthero bhagavato ārocesi.","Bhagavā taṃ aṭṭhuppattiṃ katvā sampattaparisāya vitthārena dhammaṃ desesi.","Sā desanā mahājanassa sātthikā ahosīti."],"lineRefs":[[],[],[]]},{"para":923,"vripara":null,"refs":[],"lines":["Ācāmadāyikāvimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":924,"vripara":null,"refs":[],"lines":["Caṇḍālivimānavaṇṇanā"],"lineRefs":[[]]},{"para":925,"vripara":null,"refs":[],"lines":["<b>Caṇḍāli vanda pādānī</b>ti caṇḍālivimānaṃ.","Tassa kā uppatti?","Bhagavā rājagahe viharanto paccūsavelāyaṃ buddhāciṇṇaṃ mahākaruṇāsamāpattiṃ samāpajjitvā uṭṭhāya lokaṃ olokento addasa tasmiṃyeva nagare caṇḍālāvasathe vasantiṃ ekaṃ mahallikaṃ caṇḍāliṃ khīṇāyukaṃ, nirayasaṃvattanikañcassā kammaṃ upaṭṭhitaṃ.","So mahākaruṇāya samussāhitamānaso “saggasaṃvattanikaṃ kammaṃ kāretvā tenassā nirayūpapattiṃ nisedhetvā sagge patiṭṭhāpessāmī”ti cintetvā mahatā bhikkhusaṅghena saddhiṃ rājagahaṃ piṇḍāya pavisati.","Tena ca samayena sā caṇḍālī daṇḍaṃ olubbha nagarato nikkhamantī bhagavantaṃ āgacchantaṃ disvā abhimukhī hutvā aṭṭhāsi.","Bhagavāpi tassā gamanaṃ nivārento viya purato aṭṭhāsi.","Athāyasmā mahāmoggallāno satthu cittaṃ ñatvā tassā ca āyuparikkhayaṃ bhagavato vandanāya taṃ niyojento –"],"lineRefs":[[],[],[],[],[],[],[]]},{"para":927,"vripara":"195","refs":[],"lines":["“Caṇḍāli vanda pādāni, gotamassa yasassino;"],"lineRefs":[[]]},{"para":928,"vripara":null,"refs":[],"lines":["Tameva anukampāya, aṭṭhāsi isisattamo."],"lineRefs":[[]]},{"para":930,"vripara":"196","refs":[],"lines":["“Abhippasādehi manaṃ, arahantamhi tādini;"],"lineRefs":[[]]},{"para":931,"vripara":null,"refs":[],"lines":["Khippaṃ pañjalikā vanda, parittaṃ tava jīvitan”ti.","– gāthādvayamāha;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
