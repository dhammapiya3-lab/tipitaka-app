{"suttaId":"tha-ap198","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7315,7336],"vripara":"28"},"segments":{"tha-ap198:0.3":"Kisalayapūjakattheraapadānaṃ","tha-ap198:1.1":"“Nagare dvāravatiyā,","tha-ap198:1.2":"mālāvaccho mamaṃ ahu;","tha-ap198:1.3":"Udapāno ca tattheva,","tha-ap198:1.4":"pādapānaṃ virohano.","tha-ap198:2.1":"“Sabalena upatthaddho,","tha-ap198:2.2":"siddhattho aparājito;","tha-ap198:2.3":"Mamānukampamāno so,","tha-ap198:2.4":"gacchate anilañjase.","tha-ap198:3.1":"“Aññaṃ kiñci na passāmi,","tha-ap198:3.2":"pūjāyoggaṃ mahesino;","tha-ap198:3.3":"Asokaṃ pallavaṃ disvā,","tha-ap198:3.4":"ākāse ukkhipiṃ ahaṃ.","tha-ap198:4.1":"“Buddhassa te kisalayā,","tha-ap198:4.2":"gacchato yanti pacchato;","tha-ap198:4.3":"Tāhaṃ disvāna saṃvijiṃ [sohaṃ disvāna taṃ iddhiṃ (sī. syā.)],","tha-ap198:4.4":"aho buddhassuḷāratā.","tha-ap198:5.1":"“Catunnavutito kappe,","tha-ap198:5.2":"pallavaṃ abhiropayiṃ;","tha-ap198:5.3":"Duggatiṃ nābhijānāmi,","tha-ap198:5.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap198:6.1":"“Sattatiṃse [sattavīse (sī. syā.)] ito kappe,","tha-ap198:6.2":"eko ekissaro ahu;","tha-ap198:6.3":"Sattaratanasampanno,","tha-ap198:6.4":"cakkavattī mahabbalo.","tha-ap198:7.1":"“Paṭisambhidā catasso … pe …","tha-ap198:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap198:8.1":"Itthaṃ sudaṃ āyasmā kisalayapūjako thero imā gāthāyo abhāsitthāti.","tha-ap198:9.1":"Kisalayapūjakattherassāpadānaṃ chaṭṭhaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3177,"to":3178,"paras":[{"para":3177,"vripara":"28","refs":["tha-ap198:1"],"lines":["Chaṭṭhe <b>nagare dvāravatiyā</b>ti mahādvāravātapānakavāṭaphalakāhi vatipākāraṭṭālagopurakaddamodakaparikhāhi ca sampannaṃ nagaranti dvāravatīnagaraṃ, dvāraṃ vatiñca padhānaṃ katvā nagarassa upalakkhitattā “dvāravatī nagaran”ti voharantīti <b>nagare dvāravatiyā</b>ti vuttaṃ.","Mālāvaccho pupphārāmo mama ahosīti attho."],"lineRefs":[["tha-ap198:1"],["tha-ap198:1"]]},{"para":3178,"vripara":"31","refs":["tha-ap198:4"],"lines":["<b>Te kisalayā</b>ti te asokapallavā.","Chaṭṭhaṃ."],"lineRefs":[["tha-ap198:4"],["tha-ap198:4"]]}],"wordLinks":[["tha-ap198:1.1","nagare dvāravatiyā",0,0],["tha-ap198:4.1","te kisalayā",1,0]]},"tika":null,"tika2":null}
