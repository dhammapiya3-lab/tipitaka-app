{"suttaId":"tha-ap445","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[865,885],"vripara":"15"},"segments":{"tha-ap445:0.3":"Billiyattheraapadānaṃ","tha-ap445:1.1":"“Candabhāgānadītīre,","tha-ap445:1.2":"assamo sukato mama;","tha-ap445:1.3":"Billarukkhehi [beluvarukkhehi (syā.)] ākiṇṇo,","tha-ap445:1.4":"nānādumanisevito. 16.","tha-ap445:2.1":"“Sugandhaṃ beluvaṃ disvā,","tha-ap445:2.2":"buddhaseṭṭhamanussariṃ;","tha-ap445:2.3":"Khāribhāraṃ pūrayitvā,","tha-ap445:2.4":"tuṭṭho saṃviggamānaso. 17.","tha-ap445:3.1":"“Kakusandhaṃ upāgamma,","tha-ap445:3.2":"billapakkamadāsahaṃ;","tha-ap445:3.3":"Puññakkhettassa vīrassa,","tha-ap445:3.4":"vippasannena cetasā. 18.","tha-ap445:4.1":"“Imasmiṃyeva kappasmiṃ,","tha-ap445:4.2":"yaṃ phalamadadiṃ tadā;","tha-ap445:4.3":"Duggatiṃ nābhijānāmi,","tha-ap445:4.4":"phaladānassidaṃ phalaṃ. 19.","tha-ap445:5.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap445:5.3":"viharāmi anāsavo. 20.","tha-ap445:6.1":"“Svāgataṃ vata me āsi…pe…","tha-ap445:6.3":"kataṃ buddhassa sāsanaṃ. 21.","tha-ap445:7.1":"“Paṭisambhidā catasso…pe…","tha-ap445:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap445:8.1":"Itthaṃ sudaṃ āyasmā billiyo thero imā gāthāyo Abhāsitthāti.","tha-ap445:9.1":"Billiyattherassāpadānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
