{"suttaId":"sn17.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1074,1075],"vripara":"157"},"segments":{"sn17.1:0.3":"Dāruṇasuttaṃ","sn17.1:1.1":"Evaṃ me sutaṃ –","sn17.1:1.2":"ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme.","sn17.1:1.3":"Tatra kho bhagavā bhikkhū āmantesi –","sn17.1:1.4":"“bhikkhavo”ti.","sn17.1:1.5":"“Bhadante”ti te bhikkhū bhagavato paccassosuṃ.","sn17.1:1.6":"Bhagavā etadavoca –","sn17.1:2.1":"“Dāruṇo, bhikkhave, lābhasakkārasiloko kaṭuko pharuso antarāyiko anuttarassa yogakkhemassa adhigamāya.","sn17.1:2.2":"Tasmātiha, bhikkhave, evaṃ sikkhitabbaṃ –","sn17.1:2.3":"‘uppannaṃ lābhasakkārasilokaṃ pajahissāma, na ca no uppanno lābhasakkārasiloko cittaṃ pariyādāya ṭhassatī’ti.","sn17.1:2.4":"Evañhi vo, bhikkhave, sikkhitabban”ti.","sn17.1:2.5":"Paṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":783,"to":783,"paras":[{"para":783,"vripara":"157","refs":["sn17.1:2"],"lines":["Lābhasakkārasaṃyuttassa paṭhame <b>dāruṇo</b>ti thaddho.","<b>Lābhasakkārasiloko</b>ti ettha <b>lābho</b> nāma catupaccayalābho.","<b>Sakkāro</b>ti tesaṃyeva sukatānaṃ susaṅkhatānaṃ lābho.","<b>Siloko</b>ti vaṇṇaghoso.","<b>Kaṭuko</b>ti tikhiṇo.","<b>Pharuso</b>ti kharo.","<b>Antarāyiko</b>ti antarāyakaro.","Paṭhamaṃ."],"lineRefs":[["sn17.1:2"],["sn17.1:2"],["sn17.1:2"],["sn17.1:2"],["sn17.1:2"],["sn17.1:2"],["sn17.1:2"],["sn17.1:2"]]}],"wordLinks":[["sn17.1:2.1","dāruṇo",0,0],["sn17.1:2.1","lābhasakkārasiloko",0,1],["sn17.1:2.1","lābho",0,1],["sn17.1:2.3","lābhasakkārasiloko",0,1],["sn17.1:2.3","lābho",0,1],["sn17.1:2.1","sakkāro",0,2],["sn17.1:2.3","sakkāro",0,2],["sn17.1:2.1","siloko",0,3],["sn17.1:2.3","siloko",0,3],["sn17.1:2.1","kaṭuko",0,4],["sn17.1:2.1","pharuso",0,5],["sn17.1:2.1","antarāyiko",0,6]],"before":[{"para":779,"vripara":null,"refs":[],"lines":["Kassapasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":780,"vripara":null,"refs":[],"lines":["Lābhasakkārasaṃyuttaṃ"],"lineRefs":[[]]},{"para":781,"vripara":null,"refs":[],"lines":["Paṭhamavaggo"],"lineRefs":[[]]},{"para":782,"vripara":null,"refs":[],"lines":["Dāruṇasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":781,"to":781,"paras":[{"para":781,"vripara":"157","refs":["sn17.1:2"],"lines":["<b>Thaddho</b>ti kakkhaḷo aniṭṭhassa padānato.","<b>Catupaccayalābho</b>ti catunnaṃ paccayānaṃ paṭilābho.","<b>Sakkāro</b>ti tehiyeva paccayehi susaṅkhatehi pūjanā, so pana atthato sampattiyevāti āha <b>“tesaṃyeva … pe … lābho”</b>ti.","<b>Vaṇṇaghoso</b>ti guṇakittanā.","Antarāyassa anativattanato <b>antarāyiko</b> anatthāvahattā."],"lineRefs":[["sn17.1:2"],["sn17.1:2"],["sn17.1:2"],["sn17.1:2"],["sn17.1:2"]]}],"wordLinks":[["sn17.1:2.1","sakkāro",0,2],["sn17.1:2.3","sakkāro",0,2],["sn17.1:2.1","antarāyiko",0,4]],"before":[{"para":773,"vripara":null,"refs":[],"lines":["<b>Etesū</b>ti evaṃ mahantesu sakalaṃ lokaṃ ajjhottharituṃ samatthesu catūsu mahābhūtesu.","<b>Tasmā</b>ti yasmā aññena kenaci atimahantenapi saddhammo na antaradhāyati, samayantarena pana vattabbameva natthi, tasmā.","<b>Evamāhā</b>ti idāni vuccamānākāraṃ vadati."],"lineRefs":[[],[],[]]},{"para":774,"vripara":null,"refs":[],"lines":["Ādānaṃ ādi, ādi eva <b>ādikan</b>ti āha <b>“ādikenāti ādānenā”</b>ti.","<b>Heṭṭhāgamanīyā</b>ti adhobhāgagamanīyā, apāyadukkhassa saṃsāradukkhassa ca nibbattakāti attho.","<b>Gāravarahitā</b>ti garukārarahitā.","Patissayanaṃ nīcabhāvena patibaddhavuttitā, patisso patissayoti atthato ekaṃ, so etesaṃ natthīti āha <b>“appatissāti appatissayā anīcavuttikā”</b>ti.","Sesaṃ suviññeyyameva."],"lineRefs":[[],[],[],[],[]]},{"para":775,"vripara":null,"refs":[],"lines":["Saddhammappatirūpakasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":776,"vripara":null,"refs":[],"lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"],"lineRefs":[[]]},{"para":777,"vripara":null,"refs":[],"lines":["Kassapasaṃyuttavaṇṇanāya līnatthappakāsanā samattā."],"lineRefs":[[]]},{"para":778,"vripara":null,"refs":[],"lines":["Lābhasakkārasaṃyuttaṃ"],"lineRefs":[[]]},{"para":779,"vripara":null,"refs":[],"lines":["Paṭhamavaggo"],"lineRefs":[[]]},{"para":780,"vripara":null,"refs":[],"lines":["Dāruṇasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
