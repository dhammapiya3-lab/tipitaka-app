{"suttaId":"sn17.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1090,1091],"vripara":"163"},"segments":{"sn17.7:0.3":"Diddhasuttaṃ","sn17.7:1.1":"Sāvatthiyaṃ viharati … pe …“dāruṇo, bhikkhave, lābhasakkārasiloko … pe … adhigamāya.","sn17.7:1.3":"Kaṃ, bhikkhave, diddhagatena visallena sallena [diṭṭhigatena visallena (ka. sī.), diṭṭhigatena sallena (syā. kaṃ.), diṭṭhigatena visallena sallena (ka.), diṭṭhagatena visallena sallena (pī.)] vijjhatu, sekhaṃ [vijjhatu, taṃ sekhaṃ (sī.), vijjhati, taṃ sekhaṃ (pī. ka.)] appattamānasaṃ lābhasakkārasiloko anupāpuṇātu”[anupāpuṇāti (pī. ka.)].","sn17.7:2.1":"“Sallanti kho, bhikkhave, lābhasakkārasilokassetaṃ adhivacanaṃ.","sn17.7:2.2":"Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko … pe … evañhi vo, bhikkhave, sikkhitabban”ti.","sn17.7:2.4":"Sattamaṃ."},"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":793,"to":793,"paras":[{"para":793,"vripara":"163","refs":["sn17.7:1"],"lines":["Sattame <b>diddhagatenā</b>ti gatadiddhena.","<b>Visallenā</b>ti visamakkhitena.","<b>Sallenā</b>ti sattiyā.","Sattamaṃ."],"lineRefs":[["sn17.7:1"],["sn17.7:1"],["sn17.7:1"],["sn17.7:1"]]}],"wordLinks":[["sn17.7:1.3","diddhagatenā",0,0],["sn17.7:1.3","visallenā",0,1],["sn17.7:1.3","sallenā",0,2]],"before":[{"para":792,"vripara":null,"refs":[],"lines":["Diddhasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":796,"to":798,"paras":[{"para":796,"vripara":"163","refs":["sn17.7:1"],"lines":["Acchavisayuttāti vā diddhe gatena <b>gatadiddhena</b>.","Tenāha <b>“visamakkhitenā”</b>ti."],"lineRefs":[["sn17.7:1"],["sn17.7:1"]]},{"para":797,"vripara":null,"refs":["sn17.7:1"],"lines":["Diddhasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn17.7:1"]]},{"para":798,"vripara":null,"refs":["sn17.7:1"],"lines":["Siṅgālasuttavaṇṇanā"],"lineRefs":[["sn17.7:1"]]}],"wordLinks":[]},"tika2":null}
