{"suttaId":"ja330","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2750,2766],"vripara":"117"},"segments":{"ja330:0.4":"Sīlavīmaṃsajātakaṃ (4-3-10)","ja330:1.1":"Sīlaṃ kireva kalyāṇaṃ,","ja330:1.2":"sīlaṃ loke anuttaraṃ;","ja330:1.3":"Passa ghoraviso nāgo,","ja330:1.4":"sīlavāti na haññati. 118.","ja330:2.1":"Yāvadevassahū kiñci,","ja330:2.2":"tāvadeva akhādisuṃ;","ja330:2.3":"Saṅgamma kulalā loke,","ja330:2.4":"na hiṃsanti akiñcanaṃ. 119.","ja330:3.1":"Sukhaṃ nirāsā supati,","ja330:3.2":"āsā phalavatī sukhā;","ja330:3.3":"Āsaṃ nirāsaṃ katvāna,","ja330:3.4":"sukhaṃ supati piṅgalā. 120.","ja330:4.1":"Na samādhiparo atthi,","ja330:4.2":"asmiṃ loke paramhi ca;","ja330:4.3":"Na paraṃ nāpi attānaṃ,","ja330:4.4":"vihiṃsati samāhitoti.","ja330:5.1":"Sīlavīmaṃsajātakaṃ dasamaṃ.","ja330:5.2":"Kuṭidūsakavaggo tatiyo.","ja330:6.1":"Tassuddānaṃ –","ja330:7.1":"Samanussa -saduddubha-yācanako,","ja330:7.2":"atha meṇḍavaruttama-godhavaro;","ja330:7.3":"Atha kāyasakepuka bhotīvaro,","ja330:7.4":"atha rādhasusīlavarena dasāti. 4."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":794,"to":799,"paras":[{"para":794,"vripara":null,"refs":["ja330:3"],"lines":["Tattha <b>phalavatī</b>ti yassā āsāya phalaṃ laddhaṃ hoti, sā tassa phalassa sukhatāya sukhā nāma.","<b>Nirāsaṃ katvānā</b>ti anāsaṃ katvā chinditvā pajahitvāti attho.","<b>Piṅgalā</b>ti esā piṅgaladāsī idāni sukhaṃ supatīti."],"lineRefs":[["ja330:3"],["ja330:3"],["ja330:3"]]},{"para":795,"vripara":null,"refs":["ja330:3"],"lines":["So punadivase tato gāmā araññaṃ pavisanto araññe ekaṃ tāpasaṃ jhānaṃ appetvā nisinnaṃ disvā “idhaloke ca paraloke ca jhānasukhato uttaritaraṃ sukhaṃ nāma natthī”ti cintetvā catutthaṃ gāthamāha – 120."],"lineRefs":[["ja330:3"]]},{"para":797,"vripara":"120","refs":["ja330:3"],"lines":["“Na samādhiparo atthi, asmiṃ loke paramhi ca;"],"lineRefs":[["ja330:3"]]},{"para":798,"vripara":null,"refs":["ja330:3"],"lines":["Na paraṃ nāpi attānaṃ, vihiṃsati samāhito”ti."],"lineRefs":[["ja330:3"]]},{"para":799,"vripara":null,"refs":["ja330:4"],"lines":["Tattha <b>na samādhiparo</b>ti samādhito paro añño sukhadhammo nāma natthīti."],"lineRefs":[["ja330:4"]]}],"wordLinks":[["ja330:3.1","phalavatī",0,0],["ja330:3.3","nirāsaṃ katvānā",0,1],["ja330:3.3","piṅgalā",0,2],["ja330:4.1","na samādhiparo",4,0]],"after":[{"para":800,"vripara":null,"title":"[330] 10. Sīlavīmaṃsajātakavaṇṇanā","lines":["So araññaṃ pavisitvā isipabbajjaṃ pabbajitvā jhānābhiññā uppādetvā brahmalokaparāyaṇo ahosi."]},{"para":801,"vripara":null,"title":"[330] 10. Sīlavīmaṃsajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā purohito ahameva ahosi”nti."]},{"para":802,"vripara":null,"title":"[330] 10. Sīlavīmaṃsajātakavaṇṇanā","lines":["Sīlavīmaṃsajātakavaṇṇanā dasamā."]},{"para":803,"vripara":null,"title":"[330] 10. Sīlavīmaṃsajātakavaṇṇanā","lines":["Kuṭidūsakavaggo tatiyo. 4."]}]},"tika":null,"tika2":null}
