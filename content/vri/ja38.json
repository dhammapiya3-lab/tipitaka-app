{"suttaId":"ja38","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[211,214],"vripara":"38"},"segments":{"ja38:0.4":"Bakajātakaṃ","ja38:1.1":"Nāccantaṃ nikatippañño,","ja38:1.2":"nikatyā sukhamedhati;","ja38:1.3":"Ārādheti nikatippañño [ārādhe nikatippañño (pī.)],","ja38:1.4":"bako kakkaṭakāmivāti.","ja38:2.1":"Bakajātakaṃ aṭṭhamaṃ. 39."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1526,"to":1526,"paras":[{"para":1526,"vripara":null,"refs":["ja38:1"],"lines":["Tattha <b>nāccantaṃ nikatippañño, nikatyā sukhamedhatī</b>ti nikati vuccati vañcanā, nikatippañño vañcanapañño puggalo tāya nikatyā nikatiyā vañcanāya na accantaṃ sukhamedhati, niccakāle sukhasmiṃyeva patiṭṭhātuṃ na sakkoti, ekaṃsena pana vināsaṃ pāpuṇātiyevāti attho.","<b>Ārādhetī</b>ti paṭilabhati.","<b>Nikatippañño</b>ti kerāṭikabhāvaṃ sikkhitapañño pāpapuggalo attanā katassa pāpassa phalaṃ ārādheti paṭilabhati vindatīti attho.","Kathaṃ?","<b>Bako kakkaṭakāmiva,</b> yathā bako kakkaṭakā gīvacchedaṃ pāpuṇāti, evaṃ pāpapuggalo attanā katapāpato diṭṭhadhamme vā samparāye vā bhayaṃ ārādheti paṭilabhatīti imamatthaṃ pakāsento mahāsatto vanaṃ unnādento dhammaṃ desesi."],"lineRefs":[["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"]]}],"wordLinks":[["ja38:1.1","nāccantaṃ nikatippañño nikatyā sukhamedhatī",0,0],["ja38:1.3","ārādhetī",0,1],["ja38:1.1","nikatippañño",0,2],["ja38:1.3","nikatippañño",0,2],["ja38:1.3","bako kakkaṭakāmiva",0,4]]},"tika":{"book":"Ja-ṭ-i","bookName":"Jātaka-abhinavaṭīkā-1","vriCode":"","from":865,"to":867,"paras":[{"para":865,"vripara":null,"refs":["ja38:1"],"lines":["8-bakajātakavaṇṇanā (38)"],"lineRefs":[["ja38:1"]]},{"para":866,"vripara":null,"refs":["ja38:1"],"lines":["<b>vaḍḍhetī</b>ti karaṇavasena vaḍḍheti.","punappunaṃ cīvarakammaṃ katvā vaḍḍhetīti attho.","<b>piṭṭhodakenā</b>ti odanodakena.","<b>ahate sāṭake</b>ti abhinavasāṭake.","<b>antaraṃ ajānantā</b>ti yathā bhūtaṃ kāraṇaṃ ajānantā.","<b>attano pakati</b>nti attano jiṇṇasabhāvaṃ dasseti.","<b>yathā jetavane</b>ti yathā so bhikkhu jetavane nisinno lokaṃ vañceti.","evaṃ aññatarasmiṃ gāmakepi eko tādiso cīvaravaḍḍhako lokaṃ vañceti.","<b>sambhattā</b>ti sahabhuttā.","<b>nidāghasamaye</b>ti gimhakāle nidahatīti nidāgho.","nipubbo daha-bhasmikaraṇeti dhātu.","halopo dīgho ca.","<b>bako</b>ti sukkakāko.","so hi vakati maṇḍūkādayo gaṇhātīti bakoti vuccatīti.","kuka-vaka-ādāneti dhātu.","<b>cintento</b>ti taṃ taṃ upāyaṃ cintento viya hutvā nisīdi.","atha vā cittadukkhavasena viya nijjhāyanto.","<b>tumhāka</b>nti tadatthe sampadānavacanaṃ.","atha vā sāmiatthe chaṭṭhīvacanaṃ.","tumhākaṃ kāraṇā cintetvā nisinno amhīti attho.","kiṃ amhākaṃ cintesīti ādīsupi esevanayo.","<b>mayhaṃ na saddahathā</b>ti sace pana mayhaṃ vacanaṃ na saddahatha.","idañca sarassa atthibhāvaṃ vāti etena samānatthapadaṃ.","<b>kāḷamaccha</b>nti ettha kāḷamaccho nāma kuliso nāma macchaviseso.","so pana macchaviseso.","vaṇṇena kāḷavaṇṇo bahuthāmo usabhagāvutānipi thale sañcarituṃ samattho.","<b>suggahaṇa</b>nti amhākaṃ pana aḷehi daḷhaggahaṇaṃ.","suṭṭhugahaṇaṃ hotīti attho.","<b>mātulā</b>ti mātuyā bhātika.","idha pana piyavacanamattameva hoti.","ayaṃ saro etto hoti.","tvaṃ pana ito kiṃ nesīti ettha ca <b>etto</b>ti etasmiṃ ṭhāne.","<b>ito</b>ti imaṃ ṭhānaṃ.","<b>marantā ubhopi marissāmā</b>ti marantā ubhopi mayaṃ marissāma.","<b>yadi eva</b>nti evaṃ attano jīvitaṃ dātuṃ yadi icchasi.","otaritvā maṃ sarasmiṃ vissajjehīti.","<b>kappento viyā</b>ti chindanto viya.","<b>kappetvā</b>ti chinditvā.","<b>sādhukāraṃ dadamānā</b>ti paresaṃ vañcetvā vadhakānaṃ saṃvegaṃ labhituṃ somanassākārappatto viya hutvā sādhukāraṃ dadamānā.","na bakassa maraṇe pamodavasenāti daṭṭhabbaṃ.","<b>sukhamedhatī</b>ti ettha sukhanti bhummatthe paccattavacanaṃ.","<b>edhatī</b>ti patiṭṭhāti.","edhasaddo hi patiṭṭhānaṭṭhe vattati.","tenāha -- “niccakāle sukhasmiṃyeva patiṭṭhātuṃ na sakkotī”ti.","<b>ārādhetī</b>ti ettha kiñcāpi rādha-pītiyanti dhātvattho vutto.","atthātisayayogavasena pana idha paṭilābhattho hoti.","<b>kakkaṭakāmivā</b>ti ettha mādese akāro dīghaṃ āpajjati.","nāyaṃ nīcakulāmivāti ādīsu viya.","tenāhu saddakovidā “mādese akāro dīgha”nti."],"lineRefs":[["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"],["ja38:1"]]},{"para":867,"vripara":null,"refs":["ja38:1"],"lines":["bakajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja38:1"]]}],"wordLinks":[]},"tika2":null}
