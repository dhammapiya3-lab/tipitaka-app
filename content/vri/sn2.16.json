{"suttaId":"sn2.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1066,1070],"vripara":"97"},"segments":{"sn2.16:0.3":"Vāsudattasuttaṃ","sn2.16:1.1":"Ekamantaṃ ṭhito kho vāsudatto devaputto bhagavato santike imaṃ gāthaṃ abhāsi –","sn2.16:2.1":"“Sattiyā viya omaṭṭho, ḍayhamānova [ḍayhamāneva (sabbattha)] matthake;","sn2.16:2.3":"Kāmarāgappahānāya, sato bhikkhu paribbaje”ti.","sn2.16:3.1":"“Sattiyā viya omaṭṭho, ḍayhamānova matthake;","sn2.16:3.3":"Sakkāyadiṭṭhippahānāya, sato bhikkhu paribbaje”ti."},"attha":null,"tika":null}
