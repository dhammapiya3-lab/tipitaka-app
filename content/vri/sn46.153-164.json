{"suttaId":"sn46.153-164","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[855,859],"vripara":null},"segments":{"sn46.153-164:0.3":"Punabalādisuttaṃ","sn46.153-164:1.2":"Soḷasamo.","sn46.153-164:2.0":"Uddānaṃ –","sn46.153-164:2.1":"Balaṃ bījañca nāgo ca, rukkho kumbhena sūkiyā;","sn46.153-164:2.3":"Ākāsena ca dve meghā, nāvā āgantukā nadīti.","sn46.153-164:3.1":"(Bojjhaṅgasaṃyuttassa balakaraṇīyavaggo rāgavasena vitthāretabbo)."},"attha":null,"tika":null}
