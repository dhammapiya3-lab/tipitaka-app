{"suttaId":"ja270","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1961,1974],"vripara":"58"},"segments":{"ja270:0.4":"Ulūkajātakaṃ (3-2-10)","ja270:1.1":"Sabbehi kira ñātīhi,","ja270:1.2":"kosiyo issaro kato;","ja270:1.3":"Sace ñātīhi anuññāto [ñātīhanuññāto (sī. pī.)],","ja270:1.4":"bhaṇeyyāhaṃ ekavācikaṃ. 59.","ja270:2.1":"Bhaṇa samma anuññāto,","ja270:2.2":"atthaṃ dhammañca kevalaṃ;","ja270:2.3":"Santi hi daharā pakkhī,","ja270:2.4":"paññavanto jutindharā. 60.","ja270:3.1":"Na me ruccati bhaddaṃ vo [bhadante (ka.)],","ja270:3.2":"ulūkassābhisecanaṃ;","ja270:3.3":"Akkuddhassa mukhaṃ passa,","ja270:3.4":"kathaṃ kuddho karissatīti.","ja270:4.1":"Ulūkajātakaṃ dasamaṃ.","ja270:4.2":"Padumavaggo dutiyo.","ja270:5.1":"Tassuddānaṃ –","ja270:6.1":"Padumuttama nāgasirivhayano,","ja270:6.2":"sa-mahaṇṇava yūpa khurappavaro;","ja270:6.3":"Atha bhaddalī kuñjara rukkha puna,","ja270:6.4":"kharavāca ulūkavarena dasāti. 3."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":2295,"to":2295,"paras":[{"para":2295,"vripara":null,"refs":["ja270:2"],"lines":["Tattha <b>bhaṇa, samma, anuññāto</b>ti, samma, vāyasa tvaṃ amhehi sabbehi anuññāto, yaṃ te bhaṇitabbaṃ, taṃ bhaṇa.","<b> Atthaṃ dhammañca kevala</b>nti bhaṇanto ca kāraṇañceva paveṇiāgatañca vacanaṃ amuñcitvā bhaṇa.","<b>Paññavanto jutindharā</b>ti paññāsampannā ceva ñāṇobhāsadharā ca daharāpi pakkhino atthiyeva."],"lineRefs":[["ja270:2"],["ja270:2"],["ja270:2"]]}],"wordLinks":[["ja270:2.1","bhaṇa samma anuññāto",0,0],["ja270:2.1","atthaṃ dhammañca kevalaṃ",0,1],["ja270:2.3","paññavanto jutindharā",0,2]],"after":[{"para":2296,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["So evaṃ anuññāto tatiyaṃ gāthamāha – 60."]},{"para":2298,"vripara":"60","title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["“Na me ruccati bhaddaṃ vo, ulūkassābhisecanaṃ;"]},{"para":2299,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["Akkuddhassa mukhaṃ passa, kathaṃ kuddho karissatī”ti."]},{"para":2300,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["Tassattho – bhaddaṃ tumhākaṃ hotu, yaṃ panetaṃ tikkhattuṃ sāvanavācāya ulūkassa abhisecanaṃ karīyati, etaṃ mayhaṃ na ruccati.","Etassa hi idāni tuṭṭhacittassa akkuddhassa mukhaṃ passatha, kuddho panāyaṃ kathaṃ karissatīti na jānāmi, sabbathāpi etaṃ mayhaṃ na ruccatīti."]},{"para":2301,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["So evaṃ vatvā “mayhaṃ na ruccati, mayhaṃ na ruccatī”ti viravanto ākāse uppati, ulūkopi naṃ uṭṭhāya anubandhi.","Tato paṭṭhāya te aññamaññaṃ veraṃ bandhiṃsu.","Sakuṇā suvaṇṇahaṃsaṃ rājānaṃ katvā pakkamiṃsu."]},{"para":2302,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne bahū sotāpannādayo ahesuṃ.","“Tadā rajje abhisittahaṃsapoto ahameva ahosi”nti."]},{"para":2303,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["Ulūkajātakavaṇṇanā dasamā."]},{"para":2304,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["Padumavaggo dutiyo."]},{"para":2305,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":2306,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["Padumaṃ mudupāṇī ca, palobhanaṃ panādakaṃ;"]},{"para":2307,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["Khurappaṃ sindhavañceva, kakkaṭā, rāmadūsakaṃ;"]},{"para":2308,"vripara":null,"title":"[270] 10. Ulūkajātakavaṇṇanā","lines":["Sujātaṃ ulūkaṃ dasa. 3."]}]},"tika":null,"tika2":null}
