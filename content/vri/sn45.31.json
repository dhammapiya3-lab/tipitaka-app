{"suttaId":"sn45.31","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[131,131],"vripara":"31"},"segments":{"sn45.31:0.3":"Paṭhamapaṭipattisuttaṃ","sn45.31:1.1":"Sāvatthinidānaṃ.","sn45.31:1.2":"“Micchāpaṭipattiñca vo, bhikkhave, desessāmi, sammāpaṭipattiñca.","sn45.31:1.3":"Taṃ suṇātha.","sn45.31:1.4":"Katamā ca, bhikkhave, micchāpaṭipatti?","sn45.31:1.5":"Seyyathidaṃ – micchādiṭṭhi … pe … micchāsamādhi.","sn45.31:1.6":"Ayaṃ vuccati, bhikkhave, micchāpaṭipatti.","sn45.31:1.7":"Katamā ca, bhikkhave, sammāpaṭipatti?","sn45.31:1.8":"Seyyathidaṃ – sammādiṭṭhi … pe … sammāsamādhi.","sn45.31:1.9":"Ayaṃ vuccati, bhikkhave, sammāpaṭipattī”ti.","sn45.31:1.10":"Paṭhamaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":70,"to":70,"paras":[{"para":70,"vripara":"31-40","refs":["sn45.31:1"],"words":["micchāpaṭipattiṃ"],"lines":["31-40. Catutthe <b>micchāpaṭipattin</b>ti ayāthāvapaṭipattiṃ.","<b>Micchāpaṭipannan</b>ti ayāthāvapaṭipannaṃ.","Iti ekaṃ suttaṃ dhammavasena kathitaṃ, ekaṃ puggalavasena.","<b>Apārā pāran</b>ti vaṭṭato nibbānaṃ.","<b>Pāragāmino</b>ti ettha yepi pāraṅgatā, yepi gacchanti, yepi gamissanti, sabbe pāragāminotveva veditabbā."],"lineRefs":[["sn45.31:1"],["sn45.31:1"],["sn45.31:1"],["sn45.31:1"],["sn45.31:1"]]}]},"tika":null}
