{"suttaId":"sn28.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1232,1232],"vripara":"337"},"segments":{"sn28.6:0.3":"Viññāṇañcāyatanasuttaṃ","sn28.6:1.1":"Sāvatthinidānaṃ.","sn28.6:1.2":"Addasā kho āyasmā ānando…pe…","sn28.6:1.3":"“idhāhaṃ, āvuso, sabbaso ākāsānañcāyatanaṃ samatikkamma anantaṃ viññāṇanti viññāṇañcāyatanaṃ upasampajja viharāmi…pe…","sn28.6:1.4":"vuṭṭhitoti vā”ti.","sn28.6:1.5":"Chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":459,"to":460,"paras":[{"para":459,"vripara":"332-340","refs":["sn28.6:1"],"lines":["Sāriputtasaṃyuttassa paṭhame <b>na evaṃ hotī</b>ti ahaṅkāramamaṅkārānaṃ pahīnattā evaṃ na hoti.","Dutiyādīsupi eseva nayo.","Paṭhamādīni. 10."],"lineRefs":[["sn28.6:1"],["sn28.6:1"],["sn28.6:1"]]},{"para":460,"vripara":null,"refs":["sn28.6:1"],"lines":["Sucimukhīsuttavaṇṇanā 341."],"lineRefs":[["sn28.6:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":483,"to":485,"paras":[{"para":483,"vripara":"332-340","refs":["sn28.6:1"],"lines":["<b>Na</b> <b>evaṃ hotī</b>ti ettha “ahaṃ samāpajjāmī”ti vā, “ahaṃ samāpanno”ti vā mā hotu tadā tādisābhogābhāvato.","“Ahaṃ vuṭṭhito”ti pana kasmā na hotīti?","Sabbathāpi na hotveva ahaṅkārassa sabbaso pahīnattā."],"lineRefs":[["sn28.6:1"],["sn28.6:1"],["sn28.6:1"]]},{"para":484,"vripara":null,"refs":["sn28.6:1"],"lines":["Vivekajasuttādivaṇṇanā niṭṭhitā. 10."],"lineRefs":[["sn28.6:1"]]},{"para":485,"vripara":null,"refs":["sn28.6:1"],"lines":["Sūcimukhīsuttavaṇṇanā 341."],"lineRefs":[["sn28.6:1"]]}],"wordLinks":[]},"tika2":null}
