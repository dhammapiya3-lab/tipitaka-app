{"suttaId":"ja349","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[3029,3041],"vripara":"193"},"segments":{"ja349:0.4":"Sandhibhedajātakaṃ (4-5-9)","ja349:1.1":"Neva itthīsu sāmaññaṃ, nāpi bhakkhesu sārathi;","ja349:1.3":"Athassa sandhibhedassa, passa yāva sucintitaṃ.","ja349:2.1":"Asi tikkhova maṃsamhi, pesuññaṃ parivattati;","ja349:2.3":"Yatthūsabhañca sīhañca, bhakkhayanti migādhamā.","ja349:3.1":"Imaṃ so sayanaṃ seti, yamimaṃ [yayimaṃ (sī. pī.), yimaṃ (ka.)] passasi sārathi;","ja349:3.3":"Yo vācaṃ sandhibhedassa, pisuṇassa nibodhati.","ja349:4.1":"Te janā sukhamedhanti, narā saggagatāriva;","ja349:4.3":"Ye vācaṃ sandhibhedassa, nāvabodhanti sārathīti.","ja349:5.1":"Sandhibhedajātakaṃ navamaṃ."},"attha":null,"tika":null}
