{"suttaId":"sn56.96-101","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[2808,2813],"vripara":"1166-1171"},"segments":{"sn56.96-101:0.3":"6-11. Chedanādisuttaṃ","sn56.96-101:1.1":"1166-1171. … Pe … evameva kho, bhikkhave, appakā te sattā ye chedanavadhabandhanaviparāmosaālopasahasākārā [sāhasākārā (ka.)] paṭiviratā; atha kho eteva bahutarā sattā ye chedanavadhabandhanaviparāmosaālopasahasākārā appaṭiviratā.","sn56.96-101:1.2":"Taṃ kissa hetu?","sn56.96-101:1.3":"Adiṭṭhattā bhikkhave, catunnaṃ ariyasaccānaṃ.","sn56.96-101:1.4":"Katamesaṃ catunnaṃ?","sn56.96-101:1.5":"Dukkhassa ariyasaccassa … pe … dukkhanirodhagāminiyā paṭipadāya ariyasaccassa”.","sn56.96-101:2.1":"“Tasmātiha, bhikkhave,‘idaṃ dukkhan’ti yogo karaṇīyo … pe …‘ayaṃ dukkhanirodhagāminī paṭipadā’ti yogo karaṇīyo”ti.","sn56.96-101:2.2":"Ekādasamaṃ.","sn56.96-101:2.3":"Catutthaāmakadhaññapeyyālavaggo dasamo.","sn56.96-101:3.0":"Tassuddānaṃ –","sn56.96-101:3.1":"Khettaṃ kāyaṃ dūteyyañca, tulākūṭaṃ ukkoṭanaṃ;","sn56.96-101:3.3":"Chedanaṃ vadhabandhanaṃ, viparālopaṃ sāhasanti."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":985,"to":986,"paras":[{"para":985,"vripara":"1166-1171","refs":["sn56.96-101:1"],"lines":["1166-71. <b>Chedanā</b> dīsu <b>chedanan</b>ti hatthacchedanādi.","<b>Vadho</b>ti maraṇaṃ.","<b>Bandho</b>ti rajjubandhanādīhi bandhanaṃ.","<b>Viparāmoso</b>ti himaviparāmoso, gumbaviparāmosoti duvidho.","Yaṃ himapātasamaye himena paṭicchannā hutvā maggapaṭipannaṃ janaṃ musanti, ayaṃ himaviparāmoso.","Yaṃ gumbādipaṭicchannā musanti, ayaṃ gumbaviparāmoso."],"lineRefs":[["sn56.96-101:1"],["sn56.96-101:1"],["sn56.96-101:1"],["sn56.96-101:1"],["sn56.96-101:1"],["sn56.96-101:1"]]},{"para":986,"vripara":null,"refs":["sn56.96-101:1"],"lines":["<b>Ālopo</b> vuccati gāmanigamādīnaṃ vilopakaraṇaṃ.","<b>Sahasākāro</b>ti sāhasakiriyā, gehaṃ pavisitvā, manussānaṃ ure satthaṃ ṭhapetvā, icchitabhaṇḍaggahaṇaṃ.","Evametasmā chedanavadhabandhanaviparāmosaālopasahasākārā paṭiviratā.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn56.96-101:1"],["sn56.96-101:1"],["sn56.96-101:1"],["sn56.96-101:1"]]}],"wordLinks":[["sn56.96-101:1.1","chedanaṃ",0,0],["sn56.96-101:1.1","chedanā",0,0],["sn56.96-101:1.1","vadho",0,1],["sn56.96-101:1.1","bandho",0,2],["sn56.96-101:1.1","viparāmoso",0,3],["sn56.96-101:1.1","ālopo",1,0],["sn56.96-101:1.1","sahasākāro",1,1]]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":841,"to":841,"paras":[{"para":841,"vripara":"1166-1171","refs":["sn56.96-101:1"],"lines":["1166-71. <b>Vadho</b>ti muṭṭhippahārakasātāḷanādīhi hiṃsanaṃ, viheṭhananti attho.","Viheṭhanatthopi hi vadha-saddo dissati “atthānaṃ vadhitvā vadhitvā rodeyyā”tiādīsu.","Aṭṭhakathāyaṃ pana “māraṇan”ti vuttaṃ, taṃ pana pothanaṃ sandhāyāti sakkā viññātuṃ māraṇasaddassa vihiṃsanepi dissanato.","Sesaṃ suviññeyyameva."],"lineRefs":[["sn56.96-101:1"],["sn56.96-101:1"],["sn56.96-101:1"],["sn56.96-101:1"]]}],"wordLinks":[["sn56.96-101:1.1","vadho",0,0]]}}
