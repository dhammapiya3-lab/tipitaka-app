{"suttaId":"tha-ap551","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[5735,5797],"vripara":"251"},"segments":{"tha-ap551:0.3":"Vanavacchattheraapadānaṃ","tha-ap551:1.1":"“Imamhi bhaddake kappe,","tha-ap551:1.2":"brahmabandhu mahāyaso;","tha-ap551:1.3":"Kassapo nāma gottena,","tha-ap551:1.4":"uppajji vadataṃ varo. 252.","tha-ap551:2.1":"“Tadāhaṃ pabbajitvāna,","tha-ap551:2.2":"tassa buddhassa sāsane;","tha-ap551:2.3":"Yāvajīvaṃ caritvāna,","tha-ap551:2.4":"brahmacāraṃ tato cuto. 253.","tha-ap551:3.1":"“Tena kammena sukatena,","tha-ap551:3.2":"cetanāpaṇidhīhi ca;","tha-ap551:3.3":"Jahitvā mānusaṃ dehaṃ,","tha-ap551:3.4":"tāvatiṃsamagacchahaṃ. 254.","tha-ap551:4.1":"“Tato cuto araññamhi,","tha-ap551:4.2":"kapoto āsahaṃ tahiṃ;","tha-ap551:4.3":"Vasate guṇasampanno,","tha-ap551:4.4":"bhikkhu jhānarato sadā. 255.","tha-ap551:5.1":"“Mettacitto kāruṇiko,","tha-ap551:5.2":"sadā pamuditānano;","tha-ap551:5.3":"Upekkhako mahāvīro,","tha-ap551:5.4":"appamaññāsu kovido. 256.","tha-ap551:6.1":"“Vinīvaraṇasaṅkappe,","tha-ap551:6.2":"sabbasattahitāsaye;","tha-ap551:6.3":"Visaṭṭho nacirenāsiṃ,","tha-ap551:6.4":"tasmiṃ sugatasāvake. 257.","tha-ap551:7.1":"“Upecca pādamūlamhi,","tha-ap551:7.2":"nisinnassa tadāssame;","tha-ap551:7.3":"Kadāci sāmisaṃ deti,","tha-ap551:7.4":"dhammaṃ desesi cekadā. 258.","tha-ap551:8.1":"“Tadā vipulapemena,","tha-ap551:8.2":"upāsitvā jinatrajaṃ;","tha-ap551:8.3":"Tato cuto gato saggaṃ,","tha-ap551:8.4":"pavāso sagharaṃ yathā. 259.","tha-ap551:9.1":"“Saggā cuto manussesu,","tha-ap551:9.2":"nibbatto puññakammunā;","tha-ap551:9.3":"Agāraṃ chaḍḍayitvāna,","tha-ap551:9.4":"pabbajiṃ bahuso ahaṃ. 260.","tha-ap551:10.1":"“Samaṇo tāpaso vippo,","tha-ap551:10.2":"paribbajo tathevahaṃ;","tha-ap551:10.3":"Hutvā vasiṃ araññamhi,","tha-ap551:10.4":"anekasataso ahaṃ. 261.","tha-ap551:11.1":"“Pacchime ca bhave dāni,","tha-ap551:11.2":"ramme kapilavatthave;","tha-ap551:11.3":"Vacchagotto dijo tassa,","tha-ap551:11.4":"jāyāya ahamokkamiṃ. 262.","tha-ap551:12.1":"“Mātu me dohaḷo āsi,","tha-ap551:12.2":"tirokucchigatassa me;","tha-ap551:12.3":"Jāyamānasamīpamhi,","tha-ap551:12.4":"vanavāsāya nicchayo. 263.","tha-ap551:13.1":"“Tato me ajanī mātā,","tha-ap551:13.2":"ramaṇīye vanantare;","tha-ap551:13.3":"Gabbhato nikkhamantaṃ maṃ,","tha-ap551:13.4":"kāsāyena paṭiggahuṃ. 264.","tha-ap551:14.1":"“Tato kumāro siddhattho,","tha-ap551:14.2":"jāto sakyakuladdhajo;","tha-ap551:14.3":"Tassa mitto piyo āsiṃ,","tha-ap551:14.4":"saṃvisaṭṭho sumāniyo. 265.","tha-ap551:15.1":"“Sattasārebhinikkhante,","tha-ap551:15.2":"ohāya vipulaṃ yasaṃ;","tha-ap551:15.3":"Ahampi pabbajitvāna,","tha-ap551:15.4":"himavantamupāgamiṃ. 266.","tha-ap551:16.1":"“Vanālayaṃ bhāvanīyaṃ,","tha-ap551:16.2":"kassapaṃ dhutavādikaṃ;","tha-ap551:16.3":"Disvā sutvā jinuppādaṃ,","tha-ap551:16.4":"upesiṃ narasārathiṃ. 267.","tha-ap551:17.1":"“So me dhammamadesesi,","tha-ap551:17.2":"sabbatthaṃ sampakāsayaṃ;","tha-ap551:17.3":"Tatohaṃ pabbajitvāna,","tha-ap551:17.4":"vanameva punāgamaṃ [punāgamiṃ (sī. pī.), punokkamaṃ (syā.)]. 268.","tha-ap551:18.1":"“Tatthāppamatto viharaṃ,","tha-ap551:18.2":"chaḷabhiññā aphassayiṃ [apassayiṃ (syā. ka.)];","tha-ap551:18.3":"Aho suladdhalābhomhi,","tha-ap551:18.4":"sumittenānukampito. 269.","tha-ap551:19.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap551:19.3":"viharāmi anāsavo. 270.","tha-ap551:20.1":"“Svāgataṃ vata me āsi…pe…","tha-ap551:20.3":"kataṃ buddhassa sāsanaṃ. 271.","tha-ap551:21.1":"“Paṭisambhidā catasso…pe…","tha-ap551:21.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap551:22.1":"Itthaṃ sudaṃ āyasmā vanavaccho thero imā gāthāyo Abhāsitthāti.","tha-ap551:23.1":"Vanavacchattherassāpadānaṃ navamaṃ. 10."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3727,"to":3727,"paras":[{"para":3727,"vripara":"251","refs":["tha-ap551:1"],"lines":["So arahattaṃ patvā attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>imamhi bhaddake kappe</b>tiādimāha.","Tattha <b>brahmabandhu mahāyaso</b>ti ettha brāhmaṇānaṃ bandhu ñātakoti brāhmaṇabandhūti vattabbe gāthābandhasukhatthaṃ “brahmabandhū”ti vuttanti veditabbaṃ.","Lokattayabyāpakayasattā mahāyaso.","Sesaṃ sabbaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap551:1"],["tha-ap551:1"],["tha-ap551:1"],["tha-ap551:1"]]}],"wordLinks":[["tha-ap551:1.1","imamhi bhaddake kappe",0,0],["tha-ap551:1.1","brahmabandhu mahāyaso",0,1]],"before":[{"para":3725,"vripara":null,"title":"Vanavacchattheraapadānavaṇṇanā","lines":["Vanavacchattheraapadānavaṇṇanā"]},{"para":3726,"vripara":null,"title":"Vanavacchattheraapadānavaṇṇanā","lines":["Navamāpadāne <b>imamhi bhaddake kappe</b>tiādikaṃ āyasmato vanavacchattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto kassapassa bhagavato kāle kulagehe nibbatto viññutaṃ patvā satthu dhammadesanaṃ sutvā saddhājāto pabbajitvā parisuddhaṃ brahmacariyaṃ caritvā tato cuto devaloke nibbatto, tato cuto araññāyatane bhikkhūnaṃ samīpe kapotayoniyaṃ nibbatto.","Tesu mettacitto dhammaṃ sutvā tato cuto devamanussesu saṃsaranto imasmiṃ buddhuppāde kapilavatthusmiṃ brāhmaṇakule nibbatti.","Tassa mātukucchigatakāleyeva mātu dohaḷo udapādi vane vasituṃ vane vijāyituṃ.","Tato icchānurūpavasena vane vasantiyā gabbhavuṭṭhānaṃ ahosi.","Gabbhato nikkhantañca naṃ kāsāvakhaṇḍena paṭiggahesuṃ.","Tadā bodhisattassa uppannakālo, rājā taṃ kumāraṃ āharāpetvā saheva posesi.","Atha bodhisatto mahābhinikkhamanaṃ nikkhamitvā pabbajitvā chabbasāni dukkarakārikaṃ katvā buddhe jāte so mahākassapassa santikaṃ gantvā tassovāde pasanno tassa santikā buddhuppādabhāvaṃ sutvā satthu santikaṃ gantvā dhammaṃ sutvā pabbajitvā nacirasseva chaḷabhiñño arahā ahosi. 251."]}],"after":[{"para":3728,"vripara":null,"title":"Vanavacchattheraapadānavaṇṇanā","lines":["Vanavacchattheraapadānavaṇṇanā samattā. 10."]}]},"tika":null,"tika2":null}
