{"suttaId":"tha-ap204","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7443,7458],"vripara":"5"},"segments":{"tha-ap204:0.3":"Minelapupphiyattheraapadānaṃ","tha-ap204:1.1":"“Suvaṇṇavaṇṇo bhagavā,","tha-ap204:1.2":"sataraṃsī patāpavā;","tha-ap204:1.3":"Caṅkamanaṃ samārūḷho,","tha-ap204:1.4":"mettacitto sikhīsabho.","tha-ap204:2.1":"“Pasannacitto sumano,","tha-ap204:2.2":"vanditvā [thometvā (syā.)] ñāṇamuttamaṃ;","tha-ap204:2.3":"Minelapupphaṃ paggayha,","tha-ap204:2.4":"buddhassa abhiropayiṃ.","tha-ap204:3.1":"“Ekattiṃse ito kappe,","tha-ap204:3.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap204:3.3":"Duggatiṃ nābhijānāmi,","tha-ap204:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap204:4.1":"“Ekūnatiṃsakappamhi,","tha-ap204:4.2":"sumeghaghananāmako;","tha-ap204:4.3":"Sattaratanasampanno,","tha-ap204:4.4":"cakkavattī mahabbalo.","tha-ap204:5.1":"“Paṭisambhidā catasso … pe …","tha-ap204:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap204:6.1":"Itthaṃ sudaṃ āyasmā minelapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap204:7.1":"Minelapupphiyattherassāpadānaṃ dutiyaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
