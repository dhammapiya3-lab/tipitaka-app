{"suttaId":"sn12.72-81","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[573,589],"vripara":"72"},"segments":{"sn12.72-81:0.3":"2-11. Jātisuttādidasakaṃ","sn12.72-81:1.1":"Sāvatthiyaṃ viharati…pe…","sn12.72-81:1.2":"jātiṃ nappajānanti…pe…. (3)","sn12.72-81:2.1":"Bhavaṃ nappajānanti…pe…. (4)","sn12.72-81:3.1":"Upādānaṃ nappajānanti…pe…. (5)","sn12.72-81:4.1":"Taṇhaṃ nappajānanti…pe…. (6)","sn12.72-81:5.1":"Vedanaṃ nappajānanti…pe…. (7)","sn12.72-81:6.1":"Phassaṃ nappajānanti…pe…. (8)","sn12.72-81:7.1":"Saḷāyatanaṃ nappajānanti…pe…. (9)","sn12.72-81:8.1":"Nāmarūpaṃ nappajānanti…pe…. (10)","sn12.72-81:9.1":"Viññāṇaṃ nappajānanti…pe…. (11)","sn12.72-81:10.1":"“Saṅkhāre nappajānanti, saṅkhārasamudayaṃ nappajānanti, saṅkhāranirodhaṃ nappajānanti, saṅkhāranirodhagāminiṃ paṭipadaṃ nappajānanti…pe… saṅkhāre pajānanti…pe…","sn12.72-81:10.3":"sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti.","sn12.72-81:10.4":"Ekādasamaṃ.","sn12.72-81:10.5":"Samaṇabrāhmaṇavaggo aṭṭhamo.","sn12.72-81:11.0":"Tassuddānaṃ –","sn12.72-81:11.1":"Paccayekādasa vuttā,","sn12.72-81:11.2":"catusaccavibhajjanā;","sn12.72-81:11.3":"Samaṇabrāhmaṇavaggo,","sn12.72-81:11.4":"nidāne bhavati aṭṭhamo.","sn12.72-81:12.0":"Vagguddānaṃ –","sn12.72-81:12.1":"Buddho āhāro dasabalo,","sn12.72-81:12.2":"kaḷāro gahapatipañcamo;","sn12.72-81:12.3":"Dukkhavaggo mahāvaggo,","sn12.72-81:12.4":"aṭṭhamo samaṇabrāhmaṇoti. 9."},"unsure":["sn12.72-81:10.1"],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":469,"to":472,"paras":[{"para":469,"vripara":"71-72","refs":["sn12.72-81:1"],"lines":["Samaṇabrāhmaṇavagge jarāmaraṇādīsu ekekapadavasena ekekaṃ katvā ekādasa suttāni vuttāni, tāni uttānatthānevāti."],"lineRefs":[["sn12.72-81:1"]]},{"para":470,"vripara":null,"refs":["sn12.72-81:1"],"lines":["Samaṇabrāhmaṇavaggo aṭṭhamo. 9."],"lineRefs":[["sn12.72-81:1"]]},{"para":471,"vripara":null,"refs":["sn12.72-81:1"],"lines":["Antarapeyyālaṃ 1."],"lineRefs":[["sn12.72-81:1"]]},{"para":472,"vripara":null,"refs":["sn12.72-81:1"],"lines":["Satthusuttādivaṇṇanā 73."],"lineRefs":[["sn12.72-81:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":455,"to":459,"paras":[{"para":455,"vripara":"71-72","refs":["sn12.72-81:1"],"lines":["<b>Ekekaṃ</b> suttaṃ <b>katvā ekādasa suttāni vuttāni</b> avijjāya vasena desanāya anāgatattā, tathānāgamanañcassā catusaccavasena ekekassa padassa uddhaṭattā.","Kāmañca “āsavasamudayā avijjāsamudayo”ti attheva aññattha suttapadaṃ, idha pana veneyyajjhāsayavasena tathā na vuttanti daṭṭhabbaṃ."],"lineRefs":[["sn12.72-81:1"],["sn12.72-81:1"]]},{"para":456,"vripara":null,"refs":["sn12.72-81:1"],"lines":["Jarāmaraṇasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn12.72-81:1"]]},{"para":457,"vripara":null,"refs":["sn12.72-81:1"],"lines":["Samaṇabrāhmaṇavaggavaṇṇanā niṭṭhitā. 9."],"lineRefs":[["sn12.72-81:1"]]},{"para":458,"vripara":null,"refs":["sn12.72-81:1"],"lines":["Antarapeyyālavaggo 1."],"lineRefs":[["sn12.72-81:1"]]},{"para":459,"vripara":null,"refs":["sn12.72-81:1"],"lines":["Satthusuttādivaṇṇanā 73."],"lineRefs":[["sn12.72-81:1"]]}],"wordLinks":[]},"tika2":null}
