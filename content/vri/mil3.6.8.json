{"suttaId":"mil3.6.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Mil","vriCode":"s0518m.nrf","paras":[517,519],"vripara":"8"},"segments":{"mil3.6.8:0.3":"Paññāpatiṭṭhānapañho","mil3.6.8:1.1":"Rājā āha","mil3.6.8:1.2":"“bhante nāgasena, paññā kuhiṃ paṭivasatī”ti?","mil3.6.8:1.3":"“Na katthaci mahārājā”ti.","mil3.6.8:1.4":"“Tena hi, bhante nāgasena, natthi paññā”ti.","mil3.6.8:1.5":"“Vāto, mahārāja, kuhiṃ paṭivasatī”ti?","mil3.6.8:1.6":"“Na katthaci bhante”ti.","mil3.6.8:1.7":"“Tena hi, mahārāja, natthi vāto”ti.","mil3.6.8:2.1":"“Kallosi, bhante nāgasenā”ti.","mil3.6.8:3.1":"Paññāpatiṭṭhānapañho aṭṭhamo."},"unsure":[],"attha":null,"tika":null,"tika2":null}
