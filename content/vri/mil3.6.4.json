{"suttaId":"mil3.6.4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Mil","vriCode":"s0518m.nrf","paras":[501,503],"vripara":"4"},"segments":{"mil3.6.4:0.3":"Bhagavato brahmacāripañho","mil3.6.4:1.1":"Rājā āha","mil3.6.4:1.2":"“bhante nāgasena, buddho brahmacārī”ti?","mil3.6.4:1.3":"“Āma, mahārāja, bhagavā brahmacārī”ti.","mil3.6.4:1.4":"“Tena hi, bhante nāgasena, buddho brahmuno sisso”ti?","mil3.6.4:1.5":"“Atthi pana te, mahārāja, hatthipāmokkho”ti?","mil3.6.4:1.6":"“Atthi, bhante”ti.","mil3.6.4:1.7":"“Kiṃnu kho, mahārāja, so hatthī kadāci karahaci koñcanādaṃ nadatīti?","mil3.6.4:1.8":"“Āma, bhante, nadatī”ti","mil3.6.4:1.9":"“tena hi, mahārāja, so hatthī koñcasakuṇassa sisso”ti?","mil3.6.4:1.10":"“Na hi, bhante”ti.","mil3.6.4:1.11":"“Kiṃ pana, mahārāja, brahmā sabuddhiko abuddhiko”ti?","mil3.6.4:1.12":"“Sabuddhiko, bhante”ti.","mil3.6.4:1.13":"“Tena hi, mahārāja, brahmā bhagavato sisso”ti.","mil3.6.4:2.1":"“Kallosi, bhante nāgasenā”ti.","mil3.6.4:3.1":"Bhagavato brahmacāripañho catuttho. 5."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
