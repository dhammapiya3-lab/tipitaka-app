{"suttaId":"sn22.31","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[165,165],"vripara":"31"},"segments":{"sn22.31:0.3":"Aghamūlasuttaṃ","sn22.31:1.1":"Sāvatthinidānaṃ.","sn22.31:1.2":"“Aghañca, bhikkhave, desessāmi aghamūlañca.","sn22.31:1.3":"Taṃ suṇātha.","sn22.31:1.4":"Katamañca bhikkhave aghaṃ?","sn22.31:1.5":"Rūpaṃ, bhikkhave, aghaṃ, vedanā aghaṃ, saññā aghaṃ, saṅkhārā aghaṃ, viññāṇaṃ aghaṃ.","sn22.31:1.6":"Idaṃ vuccati, bhikkhave, aghaṃ.","sn22.31:1.7":"Katamañca, bhikkhave, aghamūlaṃ?","sn22.31:1.8":"Yāyaṃ taṇhā ponobhavikā nandīrāgasahagatā [nandirāgasahagatā (sabbattha)] tatratatrābhinandinī;","sn22.31:1.9":"seyyathidaṃ – kāmataṇhā, bhavataṇhā, vibhavataṇhā.","sn22.31:1.10":"Idaṃ vuccati, bhikkhave, aghamūlan”ti.","sn22.31:1.11":"Dasamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":83,"to":83,"paras":[{"para":83,"vripara":"31","refs":["sn22.31:1"],"lines":["Dasame <b>aghan</b>ti dukkhaṃ.","Evamettha dukkhalakkhaṇameva kathitaṃ.","Dasamaṃ."],"lineRefs":[["sn22.31:1"],["sn22.31:1"],["sn22.31:1"]]}],"wordLinks":[["sn22.31:1.2","aghaṃ",0,0],["sn22.31:1.4","aghaṃ",0,0],["sn22.31:1.5","aghaṃ",0,0],["sn22.31:1.6","aghaṃ",0,0],["sn22.31:1.7","aghaṃ",0,0],["sn22.31:1.10","aghaṃ",0,0]]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":84,"to":84,"paras":[{"para":84,"vripara":"31","refs":["sn22.31:1"],"lines":["Aghaṃ vuccati pāpaṃ, aghanimittatāya <b>aghaṃ</b> dukkhaṃ.","Idañhi dukkhaṃ nāma visesato pāpahetukaṃ kammaphalasaññitaṃ.","Tathā vaṭṭadukkhaṃ avijjātaṇhāmūlakattā.","Aghassa nimittatāya aghaṃ dukkhaṃ.","Vaṭṭānusārī mahājano hi dukkhābhibhūto tassa patikāraṃ maññamāno taṃ taṃ karotīti."],"lineRefs":[["sn22.31:1"],["sn22.31:1"],["sn22.31:1"],["sn22.31:1"],["sn22.31:1"]]}],"wordLinks":[["sn22.31:1.2","aghaṃ",0,0],["sn22.31:1.4","aghaṃ",0,0],["sn22.31:1.5","aghaṃ",0,0],["sn22.31:1.6","aghaṃ",0,0],["sn22.31:1.7","aghaṃ",0,0],["sn22.31:1.10","aghaṃ",0,0]],"after":[{"para":85,"vripara":null,"title":"Aghamūlasuttavaṇṇanā","lines":["Aghamūlasuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
