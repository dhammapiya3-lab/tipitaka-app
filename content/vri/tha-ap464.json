{"suttaId":"tha-ap464","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1319,1333],"vripara":"6"},"segments":{"tha-ap464:0.3":"Citakapūjakattheraapadānaṃ","tha-ap464:1.1":"“Jhāyamānassa bhagavato, sikhino lokabandhuno;","tha-ap464:1.3":"Aṭṭha campakapupphāni, citakaṃ abhiropayiṃ.","tha-ap464:2.1":"“Ekatiṃse ito kappe, yaṃ pupphamabhiropayiṃ;","tha-ap464:2.3":"Duggatiṃ nābhijānāmi, citapūjāyidaṃ phalaṃ.","tha-ap464:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap464:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap464:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap464:6.1":"Itthaṃ sudaṃ āyasmā citakapūjako thero imā gāthāyo Abhāsitthāti.","tha-ap464:7.1":"Citakapūjakattherassāpadānaṃ dutiyaṃ."},"attha":null,"tika":null,"tika2":null}
