{"suttaId":"tha-ap464","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1319,1333],"vripara":"6"},"segments":{"tha-ap464:0.3":"Citakapūjakattheraapadānaṃ","tha-ap464:1.1":"“Jhāyamānassa bhagavato,","tha-ap464:1.2":"sikhino lokabandhuno;","tha-ap464:1.3":"Aṭṭha campakapupphāni,","tha-ap464:1.4":"citakaṃ abhiropayiṃ. 7.","tha-ap464:2.1":"“Ekatiṃse ito kappe,","tha-ap464:2.2":"yaṃ pupphamabhiropayiṃ;","tha-ap464:2.3":"Duggatiṃ nābhijānāmi,","tha-ap464:2.4":"citapūjāyidaṃ phalaṃ. 8.","tha-ap464:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap464:3.3":"viharāmi anāsavo. 9.","tha-ap464:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap464:4.3":"kataṃ buddhassa sāsanaṃ. 10.","tha-ap464:5.1":"“Paṭisambhidā catasso…pe…","tha-ap464:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap464:6.1":"Itthaṃ sudaṃ āyasmā citakapūjako thero imā gāthāyo Abhāsitthāti.","tha-ap464:7.1":"Citakapūjakattherassāpadānaṃ dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
