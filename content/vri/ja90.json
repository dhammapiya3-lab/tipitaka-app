{"suttaId":"ja90","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[503,510],"vripara":"90"},"segments":{"ja90:0.4":"Akataññujātakaṃ","ja90:1.1":"Yo pubbe katakalyāṇo,","ja90:1.2":"katattho nāvabujjhati;","ja90:1.3":"Pacchā kicce samuppanne,","ja90:1.4":"kattāraṃ nādhigacchatīti.","ja90:2.1":"Akataññujātakaṃ dasamaṃ.","ja90:2.2":"Apāyimhavaggo navamo.","ja90:3.1":"Tassuddānaṃ –","ja90:4.1":"Apāyimha ca dūbhakaṃ sattapadaṃ,","ja90:4.2":"chaḷadvara ca āyatinā ca puna;","ja90:4.3":"Ahisīlava maṅgali pāpikassā,","ja90:4.4":"sataṃnikkha katatthavarena dasāti. 10."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":2313,"to":2313,"paras":[{"para":2313,"vripara":null,"refs":["ja90:1"],"lines":["Tatrāyaṃ piṇḍattho – khattiyādīsu <b>yo</b> koci puriso <b>pubbe</b> paṭhamataraṃ aññena <b>katakalyāṇo</b> katūpakāro <b>katattho</b> nipphāditakicco hutvā taṃ parena attani kataṃ kalyāṇañceva atthañca na jānāti, so <b>pacchā</b> attano <b>kicce samuppanne</b> tassa kiccassa <b>kattāraṃ nādhigacchati</b> na labhatīti."],"lineRefs":[["ja90:1"]]}],"wordLinks":[["ja90:1.1","katakalyāṇo",0,0],["ja90:1.1","katattho",0,0],["ja90:1.1","pubbe",0,0],["ja90:1.1","yo",0,0],["ja90:1.3","kattāraṃ nādhigacchati",0,0],["ja90:1.3","kicce samuppanne",0,0],["ja90:1.3","pacchā",0,0]],"after":[{"para":2314,"vripara":null,"title":"[90] 10. Akataññujātakavaṇṇanā","lines":["Evaṃ bodhisatto imāya gāthāya dhammaṃ desetvā dānādīni puññāni katvā yathākammaṃ gato."]},{"para":2315,"vripara":null,"title":"[90] 10. Akataññujātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā paccantavāsī idānīpi paccantavāsīyeva, bārāṇasiseṭṭhi pana ahameva ahosi”nti."]},{"para":2316,"vripara":null,"title":"[90] 10. Akataññujātakavaṇṇanā","lines":["Akataññujātakavaṇṇanā dasamā."]},{"para":2317,"vripara":null,"title":"[90] 10. Akataññujātakavaṇṇanā","lines":["Apāyimhavaggo navamo."]},