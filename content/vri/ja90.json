{"suttaId":"ja90","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[503,510],"vripara":"90"},"segments":{"ja90:0.4":"Akataññujātakaṃ","ja90:1.1":"Yo pubbe katakalyāṇo, katattho nāvabujjhati;","ja90:1.3":"Pacchā kicce samuppanne, kattāraṃ nādhigacchatīti.","ja90:2.1":"Akataññujātakaṃ dasamaṃ.","ja90:2.2":"Apāyimhavaggo navamo.","ja90:3.1":"Tassuddānaṃ –","ja90:4.1":"Apāyimha ca dūbhakaṃ sattapadaṃ, chaḷadvara ca āyatinā ca puna;","ja90:4.3":"Ahisīlava maṅgali pāpikassā, sataṃnikkha katatthavarena dasāti."},"attha":null,"tika":null}
