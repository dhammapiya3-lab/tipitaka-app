{"suttaId":"an9.69","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-ix","vriCode":"s0404m2.mul","paras":[459,460],"vripara":"69"},"segments":{"an9.69:0.3":"Macchariyasuttaṃ","an9.69:1.1":"“Pañcimāni, bhikkhave, macchariyāni.","an9.69:1.2":"Katamāni pañca?","an9.69:1.3":"Āvāsamacchariyaṃ, kulamacchariyaṃ, lābhamacchariyaṃ, vaṇṇamacchariyaṃ, dhammamacchariyaṃ –","an9.69:1.4":"imāni kho, bhikkhave, pañca macchariyāni.","an9.69:2.1":"“Imesaṃ kho, bhikkhave, pañcannaṃ macchariyānaṃ pahānāya … pe … ime cattāro satipaṭṭhānā bhāvetabbā”ti.","an9.69:2.2":"Sattamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
