{"suttaId":"tha-ap276","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8600,8615],"vripara":"14"},"segments":{"tha-ap276:0.3":"Abbhañjanadāyakattheraapadānaṃ","tha-ap276:1.1":"“Koṇḍaññassa bhagavato, vītarāgassa tādino;","tha-ap276:1.3":"Ākāsasamacittassa [akakkasacittassātha (aṭṭha.)], nippapañcassa jhāyino.","tha-ap276:2.1":"“Sabbamohātivattassa, sabbalokahitesino;","tha-ap276:2.3":"Abbhañjanaṃ mayā dinnaṃ, dvipadindassa tādino.","tha-ap276:3.1":"“Aparimeyye ito kappe, abbhañjanamadaṃ tadā [ambhañjanamadāsahaṃ (syā.)];","tha-ap276:3.3":"Duggatiṃ nābhijānāmi, abbhañjanassidaṃ phalaṃ.","tha-ap276:4.1":"“Ito pannarase kappe, cirappo nāma khattiyo;","tha-ap276:4.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap276:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap276:6.1":"Itthaṃ sudaṃ āyasmā abbhañjanadāyako thero imā gāthāyo abhāsitthāti.","tha-ap276:7.1":"Abbhañjanadāyakattherassāpadānaṃ catutthaṃ."},"attha":null,"tika":null,"tika2":null}
