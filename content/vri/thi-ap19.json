{"suttaId":"thi-ap19","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[8090,8340],"vripara":"384"},"segments":{"thi-ap19:0.3":"Uppalavaṇṇātherīapadānaṃ","thi-ap19:1.1":"“Bhikkhunī uppalavaṇṇā,","thi-ap19:1.2":"iddhiyā pāramiṃ gatā;","thi-ap19:1.3":"Vanditvā satthuno pāde,","thi-ap19:1.4":"idaṃ vacanamabravi. 385.","thi-ap19:2.1":"“‘Nitthiṇṇā jātisaṃsāraṃ [jātisaṃsārā (pī.)],","thi-ap19:2.2":"pattāhaṃ acalaṃ padaṃ;","thi-ap19:2.3":"Sabbadukkhaṃ mayā khīṇaṃ,","thi-ap19:2.4":"ārocemi mahāmuni. 386.","thi-ap19:3.1":"“‘Yāvatā parisā atthi,","thi-ap19:3.2":"pasannā jinasāsane;","thi-ap19:3.3":"Yassā ca meparādhotthi,","thi-ap19:3.4":"khamantu jinasammukhā. 387.","thi-ap19:4.1":"“‘Saṃsāre saṃsarantiyā [saṃsarantā me (syā.)],","thi-ap19:4.2":"khalitaṃ me sace bhave;","thi-ap19:4.3":"Ārocemi mahāvīra,","thi-ap19:4.4":"aparādhaṃ khamassu taṃ [me (syā.)]. 388.","thi-ap19:5.1":"“‘Iddhiñcāpi nidassehi,","thi-ap19:5.2":"mama sāsanakārike;","thi-ap19:5.3":"Catasso parisā ajja,","thi-ap19:5.4":"kaṅkhaṃ chindāhi yāvatā. 389.","thi-ap19:6.1":"“‘Dhītā tuyhaṃ mahāvīra,","thi-ap19:6.2":"paññavanta jutindhara;","thi-ap19:6.3":"Bahuñca dukkaraṃ kammaṃ,","thi-ap19:6.4":"kataṃ me atidukkaraṃ. 390.","thi-ap19:7.1":"“‘Uppalasseva me vaṇṇo,","thi-ap19:7.2":"nāmenuppalanāmikā;","thi-ap19:7.3":"Sāvikā te mahāvīra,","thi-ap19:7.4":"pāde vandāmi cakkhuma. 391.","thi-ap19:8.1":"“‘Rāhulo ca ahañceva,","thi-ap19:8.2":"nekajātisate bahū;","thi-ap19:8.3":"Ekasmiṃ sambhave jātā,","thi-ap19:8.4":"samānachandamānasā. 392.","thi-ap19:9.1":"“‘Nibbatti ekato hoti,","thi-ap19:9.2":"jātiyāpi ca ekato [jātīsu bahuso mama (sī.)];","thi-ap19:9.3":"Pacchime bhave sampatte,","thi-ap19:9.4":"ubhopi nānāsambhavā. 393.","thi-ap19:10.1":"“‘Putto ca rāhulo nāma,","thi-ap19:10.2":"dhītā uppalasavhayā;","thi-ap19:10.3":"Passa vīra mamaṃ iddhiṃ,","thi-ap19:10.4":"balaṃ dassemi satthuno. 394.","thi-ap19:11.1":"“‘Mahāsamudde caturo,","thi-ap19:11.2":"pakkhipi hatthapātiyaṃ;","thi-ap19:11.3":"Telaṃ hatthagatañceva,","thi-ap19:11.4":"khiḍḍo [vejjo (sī. pī.)] komārako yathā. 395.","thi-ap19:12.1":"“‘Ubbattayitvā pathaviṃ,","thi-ap19:12.2":"pakkhipi hatthapātiyaṃ;","thi-ap19:12.3":"Cittaṃ muñjaṃ yathā nāma,","thi-ap19:12.4":"luñci komārako yuvā. 396.","thi-ap19:13.1":"“‘Cakkavāḷasamaṃ pāṇiṃ,","thi-ap19:13.2":"chādayitvāna matthake;","thi-ap19:13.3":"Vassāpetvāna phusitaṃ,","thi-ap19:13.4":"nānāvaṇṇaṃ punappunaṃ. 397.","thi-ap19:14.1":"“‘Bhūmiṃ udukkhalaṃ katvā,","thi-ap19:14.2":"dhaññaṃ katvāna sakkharaṃ;","thi-ap19:14.3":"Sineruṃ musalaṃ katvā,","thi-ap19:14.4":"maddi komārikā yathā. 398.","thi-ap19:15.1":"“‘Dhītāhaṃ buddhaseṭṭhassa,","thi-ap19:15.2":"nāmenuppalasavhayā;","thi-ap19:15.3":"Abhiññāsu vasībhūtā,","thi-ap19:15.4":"tava sāsanakārikā. 399.","thi-ap19:16.1":"“‘Nānāvikubbanaṃ katvā,","thi-ap19:16.2":"dassetvā lokanāyakaṃ;","thi-ap19:16.3":"Nāmagottañca sāvetvā [pakāsetvā (syā.)],","thi-ap19:16.4":"pāde vandāmi cakkhuma. 400.","thi-ap19:17.1":"“‘Iddhīsu ca vasī homi,","thi-ap19:17.2":"dibbāya sotadhātuyā;","thi-ap19:17.3":"Cetopariyañāṇassa,","thi-ap19:17.4":"vasī homi mahāmune. 401.","thi-ap19:18.1":"“‘Pubbenivāsaṃ jānāmi,","thi-ap19:18.2":"dibbacakkhu visodhitaṃ;","thi-ap19:18.3":"Sabbāsavaparikkhīṇā,","thi-ap19:18.4":"natthi dāni punabbhavo. 402.","thi-ap19:19.1":"“‘Atthadhammaniruttīsu,","thi-ap19:19.2":"paṭibhāne tatheva ca;","thi-ap19:19.3":"Ñāṇaṃ me vimalaṃ [vipulaṃ (syā.)] suddhaṃ,","thi-ap19:19.4":"sabhāvena mahesino. 403.","thi-ap19:20.1":"“‘Purimānaṃ jinaggānaṃ,","thi-ap19:20.2":"saṅgamaṃ te nidassitaṃ [sammukhā ca parammukhā (sī.)];","thi-ap19:20.3":"Adhikāraṃ bahuṃ mayhaṃ,","thi-ap19:20.4":"tuyhatthāya mahāmuni. 404.","thi-ap19:21.1":"“‘Yaṃ mayā pūritaṃ kammaṃ,","thi-ap19:21.2":"kusalaṃ sara me muni;","thi-ap19:21.3":"Tavatthāya mahāvīra,","thi-ap19:21.4":"puññaṃ upacitaṃ mayā. 405.","thi-ap19:22.1":"“‘Abhabbaṭṭhāne vajjetvā,","thi-ap19:22.2":"vārayantī [parivajjanti (sī.), paripācento (syā.)] anācaraṃ;","thi-ap19:22.3":"Tavatthāya mahāvīra,","thi-ap19:22.4":"cattaṃ me jīvituttamaṃ. 406.","thi-ap19:23.1":"“‘Dasakoṭisahassāni,","thi-ap19:23.2":"adāsiṃ mama jīvitaṃ;","thi-ap19:23.3":"Pariccattā ca me homi,","thi-ap19:23.4":"tavatthāya mahāmuni. 407.","thi-ap19:24.1":"“‘Tadātivimhitā sabbā,","thi-ap19:24.2":"sirasāva katañjalī;","thi-ap19:24.3":"Avocayye kathaṃ āsi,","thi-ap19:24.4":"atuliddhiparakkamā’. 408.","thi-ap19:25.1":"“Satasahassito kappe,","thi-ap19:25.2":"nāgakaññā ahaṃ tadā;","thi-ap19:25.3":"Vimalā nāma nāmena,","thi-ap19:25.4":"kaññānaṃ sādhusammatā. 409.","thi-ap19:26.1":"“Mahorago mahānāgo,","thi-ap19:26.2":"pasanno jinasāsane;","thi-ap19:26.3":"Padumuttaraṃ mahātejaṃ,","thi-ap19:26.4":"nimantesi sasāvakaṃ. 410.","thi-ap19:27.1":"“Ratanamayaṃ maṇḍapaṃ,","thi-ap19:27.2":"pallaṅkaṃ ratanāmayaṃ;","thi-ap19:27.3":"Ratanaṃ vālukākiṇṇaṃ,","thi-ap19:27.4":"upabhogaṃ ratanāmayaṃ. 411.","thi-ap19:28.1":"“Maggañca paṭiyādesi,","thi-ap19:28.2":"ratanaddhajabhūsitaṃ;","thi-ap19:28.3":"Paccuggantvāna sambuddhaṃ,","thi-ap19:28.4":"vajjanto tūriyehi so. 412.","thi-ap19:29.1":"“Parisāhi ca catūhi [parisāhi catūhi so (sī.), parisāhi catasso hi (pī.)],","thi-ap19:29.2":"parivuto [sahito (sī.), pharate (syā.), pareto (pī.)] lokanāyako;","thi-ap19:29.3":"Mahoragassa bhavane,","thi-ap19:29.4":"nisīdi paramāsane. 413.","thi-ap19:30.1":"“Annaṃ pānaṃ khādanīyaṃ,","thi-ap19:30.2":"bhojanañca mahārahaṃ;","thi-ap19:30.3":"Varaṃ varañca pādāsi,","thi-ap19:30.4":"nāgarājā mahāyasaṃ. 414.","thi-ap19:31.1":"“Bhuñjitvāna sambuddho,","thi-ap19:31.2":"pattaṃ dhovitvā yoniso;","thi-ap19:31.3":"Anumodanīyaṃkāsi,","thi-ap19:31.4":"nāgakaññā mahiddhikā. 415.","thi-ap19:32.1":"“Sabbaññuṃ phullitaṃ disvā,","thi-ap19:32.2":"nāgakaññā mahāyasaṃ;","thi-ap19:32.3":"Pasannaṃ satthuno cittaṃ,","thi-ap19:32.4":"sunibandhañca mānasaṃ. 416.","thi-ap19:33.1":"“Mamañca cittamaññāya,","thi-ap19:33.2":"jalajuttamanāmako;","thi-ap19:33.3":"Tasmiṃ khaṇe mahāvīro,","thi-ap19:33.4":"bhikkhuniṃ dassayiddhiyā. 417.","thi-ap19:34.1":"“Iddhī anekā dassesi,","thi-ap19:34.2":"bhikkhunī sā visāradā;","thi-ap19:34.3":"Pamoditā vedajātā,","thi-ap19:34.4":"satthāraṃ idamabravi [etadabraviṃ (syā. pī.)]. 418.","thi-ap19:35.1":"“‘Addasāhaṃ imaṃ iddhiṃ,","thi-ap19:35.2":"sumanaṃ itarāyapi;","thi-ap19:35.3":"Kathaṃ ahosi sā vīra,","thi-ap19:35.4":"iddhiyā suvisāradā’. 419.","thi-ap19:36.1":"“‘Orasā mukhato jātā,","thi-ap19:36.2":"dhītā mama mahiddhikā;","thi-ap19:36.3":"Mamānusāsanikarā,","thi-ap19:36.4":"iddhiyā suvisāradā’. 420.","thi-ap19:37.1":"“Buddhassa vacanaṃ sutvā,","thi-ap19:37.2":"evaṃ patthesahaṃ tadā [tuṭṭhā evaṃ avocahaṃ (syā.), evamahosahaṃ tadā (ka.)];","thi-ap19:37.3":"Ahampi tādisā homi,","thi-ap19:37.4":"iddhiyā suvisāradā. 421.","thi-ap19:38.1":"“Pamoditāhaṃ sumanā,","thi-ap19:38.2":"patthe uttamamānasā [pattauttamamānasā (sī. syā. pī.)];","thi-ap19:38.3":"Anāgatamhi addhāne,","thi-ap19:38.4":"īdisā homi nāyaka. 422.","thi-ap19:39.1":"“Maṇimayamhi pallaṅke,","thi-ap19:39.2":"maṇḍapamhi pabhassare;","thi-ap19:39.3":"Annapānena tappetvā,","thi-ap19:39.4":"sasaṅghaṃ lokanāyakaṃ. 423.","thi-ap19:40.1":"“Nāgānaṃ pavaraṃ pupphaṃ,","thi-ap19:40.2":"aruṇaṃ nāma uppalaṃ;","thi-ap19:40.3":"Vaṇṇaṃ me īdisaṃ hotu,","thi-ap19:40.4":"pūjesiṃ lokanāyakaṃ. 424.","thi-ap19:41.1":"“Tena kammena sukatena,","thi-ap19:41.2":"cetanāpaṇidhīhi ca;","thi-ap19:41.3":"Jahitvā mānusaṃ dehaṃ,","thi-ap19:41.4":"tāvatiṃsamagacchahaṃ. 425.","thi-ap19:42.1":"“Tato cutāhaṃ manuje,","thi-ap19:42.2":"upapannā sayambhuno;","thi-ap19:42.3":"Uppalehi paṭicchannaṃ,","thi-ap19:42.4":"piṇḍapātamadāsahaṃ. 426.","thi-ap19:43.1":"“Ekanavutito kappe,","thi-ap19:43.2":"vipassī nāma nāyako;","thi-ap19:43.3":"Uppajji cārudassano,","thi-ap19:43.4":"sabbadhammesu cakkhumā. 427.","thi-ap19:44.1":"“Seṭṭhidhītā tadā hutvā,","thi-ap19:44.2":"bārāṇasipuruttame;","thi-ap19:44.3":"Nimantetvāna sambuddhaṃ,","thi-ap19:44.4":"sasaṅghaṃ lokanāyakaṃ. 428.","thi-ap19:45.1":"“Mahādānaṃ daditvāna,","thi-ap19:45.2":"uppalehi vināyakaṃ;","thi-ap19:45.3":"Pūjayitvā cetasāva [ca teheva (syā. pī.)],","thi-ap19:45.4":"vaṇṇasobhaṃ apatthayiṃ. 429.","thi-ap19:46.1":"“Imamhi bhaddake kappe,","thi-ap19:46.2":"brahmabandhu mahāyaso;","thi-ap19:46.3":"Kassapo nāma gottena,","thi-ap19:46.4":"uppajji vadataṃ varo. 430.","thi-ap19:47.1":"“Upaṭṭhāko mahesissa,","thi-ap19:47.2":"tadā āsi narissaro;","thi-ap19:47.3":"Kāsirājā kikī nāma,","thi-ap19:47.4":"bārāṇasipuruttame. 431.","thi-ap19:48.1":"“Tassāsiṃ dutiyā dhītā,","thi-ap19:48.2":"samaṇaguttasavhayā;","thi-ap19:48.3":"Dhammaṃ sutvā jinaggassa,","thi-ap19:48.4":"pabbajjaṃ samarocayiṃ. 432.","thi-ap19:49.1":"“Anujāni na no tāto,","thi-ap19:49.2":"agāreva tadā mayaṃ;","thi-ap19:49.3":"Vīsavassasahassāni,","thi-ap19:49.4":"vicarimha atanditā. 433.","thi-ap19:50.1":"“Komāribrahmacariyaṃ,","thi-ap19:50.2":"rājakaññā sukhedhitā;","thi-ap19:50.3":"Buddhopaṭṭhānaniratā,","thi-ap19:50.4":"muditā sattadhītaro. 434.","thi-ap19:51.1":"“Samaṇī samaṇaguttā ca,","thi-ap19:51.2":"bhikkhunī bhikkhudāyikā [bhikkhudāsikā (sī. syā.)];","thi-ap19:51.3":"Dhammā ceva sudhammā ca,","thi-ap19:51.4":"sattamī saṅghadāyikā [saṃghadāsikā (sī. syā.)]. 435.","thi-ap19:52.1":"“Ahaṃ khemā ca sappaññā,","thi-ap19:52.2":"paṭācārā ca kuṇḍalā;","thi-ap19:52.3":"Kisāgotamī dhammadinnā,","thi-ap19:52.4":"visākhā hoti sattamī. 436.","thi-ap19:53.1":"“Tehi kammehi sukatehi,","thi-ap19:53.2":"cetanāpaṇidhīhi ca;","thi-ap19:53.3":"Jahitvā mānusaṃ dehaṃ,","thi-ap19:53.4":"tāvatiṃsamagacchahaṃ. 437.","thi-ap19:54.1":"“Tato cutā manussesu,","thi-ap19:54.2":"upapannā mahākule;","thi-ap19:54.3":"Pītaṃ maṭṭhaṃ varaṃ dussaṃ,","thi-ap19:54.4":"adaṃ arahato ahaṃ. 438.","thi-ap19:55.1":"“Tato cutāriṭṭhapure,","thi-ap19:55.2":"jātā vippakule ahaṃ;","thi-ap19:55.3":"Dhītā tiriṭivacchassa,","thi-ap19:55.4":"ummādantī manoharā. 439.","thi-ap19:56.1":"“Tato cutā janapade,","thi-ap19:56.2":"kule aññatare ahaṃ;","thi-ap19:56.3":"Pasūtā nātiphītamhi,","thi-ap19:56.4":"sāliṃ gopemahaṃ tadā. 440.","thi-ap19:57.1":"“Disvā paccekasambuddhaṃ,","thi-ap19:57.2":"pañcalājāsatānihaṃ;","thi-ap19:57.3":"Datvā padumacchannāni,","thi-ap19:57.4":"pañca puttasatānihaṃ. 441.","thi-ap19:58.1":"“Patthayiṃ tepi patthesuṃ,","thi-ap19:58.2":"madhuṃ datvā sayambhuno;","thi-ap19:58.3":"Tato cutā araññehaṃ,","thi-ap19:58.4":"ajāyiṃ padumodare. 442.","thi-ap19:59.1":"“Kāsirañño mahesīhaṃ,","thi-ap19:59.2":"hutvā sakkatapūjitā;","thi-ap19:59.3":"Ajaniṃ rājaputtānaṃ,","thi-ap19:59.4":"anūnaṃ satapañcakaṃ. 443.","thi-ap19:60.1":"“Yadā te yobbanappattā,","thi-ap19:60.2":"kīḷantā jalakīḷitaṃ;","thi-ap19:60.3":"Disvā opattapadumaṃ,","thi-ap19:60.4":"āsuṃ paccekanāyakā. 444.","thi-ap19:61.1":"“Sāhaṃ tehi vinābhūtā,","thi-ap19:61.2":"sutavīrehi sokinī [sutavarehi sokinī (sī. syā.)];","thi-ap19:61.3":"Cutā isigilipasse,","thi-ap19:61.4":"gāmakamhi ajāyihaṃ. 445.","thi-ap19:62.1":"“Yadā buddhā sutamatī,","thi-ap19:62.2":"sutānaṃ bhattunopi ca [kasataṃ tadā (sī.), attanopi ca (syā.)];","thi-ap19:62.3":"Yāguṃ ādāya gacchantī,","thi-ap19:62.4":"aṭṭha paccekanāyake. 446.","thi-ap19:63.1":"“Bhikkhāya gāmaṃ gacchante,","thi-ap19:63.2":"disvā putte anussariṃ;","thi-ap19:63.3":"Khīradhārā viniggacchi,","thi-ap19:63.4":"tadā me puttapemasā. 447.","thi-ap19:64.1":"“Tato tesaṃ adaṃ yāguṃ,","thi-ap19:64.2":"pasannā sehi pāṇibhi;","thi-ap19:64.3":"Tato cutāhaṃ tidasaṃ,","thi-ap19:64.4":"nandanaṃ upapajjahaṃ. 448.","thi-ap19:65.1":"“Anubhotvā sukhaṃ dukkhaṃ,","thi-ap19:65.2":"saṃsaritvā bhavābhave;","thi-ap19:65.3":"Tavatthāya mahāvīra,","thi-ap19:65.4":"pariccattañca jīvitaṃ. 449.","thi-ap19:66.1":"“Evaṃ bahuvidhaṃ dukkhaṃ,","thi-ap19:66.2":"sampattī ca bahubbidhā;","thi-ap19:66.3":"Pacchime bhave sampatte,","thi-ap19:66.4":"jātā sāvatthiyaṃ pure. 450.","thi-ap19:67.1":"“Mahādhanaseṭṭhikule,","thi-ap19:67.2":"sukhite sajjite tathā;","thi-ap19:67.3":"Nānāratanapajjote,","thi-ap19:67.4":"sabbakāmasamiddhine. 451.","thi-ap19:68.1":"“Sakkatā pūjitā ceva,","thi-ap19:68.2":"mānitāpacitā tathā;","thi-ap19:68.3":"Rūpasīrimanuppattā [rūpasobhaggasampannā (sī.)], kulesu atisakkatā [abhisammatā (sī.)]. 452.","thi-ap19:69.1":"“Atīva patthitā cāsiṃ,","thi-ap19:69.2":"rūpabhogasirīhi ca;","thi-ap19:69.3":"Patthitā seṭṭhiputtehi,","thi-ap19:69.4":"anekehi satehipi. 453.","thi-ap19:70.1":"“Agāraṃ pajahitvāna,","thi-ap19:70.2":"pabbajiṃ anagāriyaṃ;","thi-ap19:70.3":"Aḍḍhamāse asampatte,","thi-ap19:70.4":"catusaccamapāpuṇiṃ. 454.","thi-ap19:71.1":"“Iddhiyā abhinimmitvā,","thi-ap19:71.2":"caturassaṃ rathaṃ ahaṃ;","thi-ap19:71.3":"Buddhassa pāde vandissaṃ,","thi-ap19:71.4":"lokanāthassa tādino. 455.","thi-ap19:72.1":"“‘Supupphitaggaṃ upagamma pādapaṃ [bhikkhunī (sī. pī. ka.) therīgā. 230],","thi-ap19:72.2":"ekā tuvaṃ tiṭṭhasi sālamūle;","thi-ap19:72.3":"Na cāpi te dutiyo atthi koci [na catthi te dutiyā vaṇṇadhātu (sī. pī. ka.)],","thi-ap19:72.4":"bāle na tvaṃ bhāyasi dhuttakānaṃ’. 456.","thi-ap19:73.1":"“‘Sataṃ sahassānipi dhuttakānaṃ [sahassānampi dhuttakānaṃ (pī.) therīgā. 231],","thi-ap19:73.2":"samāgatā edisakā bhaveyyuṃ;","thi-ap19:73.3":"Lomaṃ na iñje na sampavedhe,","thi-ap19:73.4":"kiṃ me tuvaṃ māra karissaseko [na māra bhāyāmi tavekikāpi (sī. ka.) … tamekikāsiṃ (pī.)]. 457.","thi-ap19:74.1":"“‘Esā antaradhāyāmi,","thi-ap19:74.2":"kucchiṃ vā pavisāmi te;","thi-ap19:74.3":"Bhamukantarikāyampi,","thi-ap19:74.4":"tiṭṭhantiṃ maṃ na dakkhasi. 458.","thi-ap19:75.1":"“‘Cittasmiṃ vasībhūtāmhi,","thi-ap19:75.2":"iddhipādā subhāvitā;","thi-ap19:75.3":"Sabbabandhanamuttāmhi,","thi-ap19:75.4":"na taṃ bhāyāmi āvuso. 459.","thi-ap19:76.1":"“‘Sattisūlūpamā kāmā,","thi-ap19:76.2":"khandhāsaṃ adhikuṭṭanā;","thi-ap19:76.3":"Yaṃ tvaṃ kāmaratiṃ brūsi,","thi-ap19:76.4":"aratī dāni sā mama. 460.","thi-ap19:77.1":"“‘Sabbattha vihatā nandī,","thi-ap19:77.2":"tamokhandho padālito;","thi-ap19:77.3":"Evaṃ jānāhi pāpima,","thi-ap19:77.4":"nihato tvamasi antaka’. 461.","thi-ap19:78.1":"“Jino tamhi guṇe tuṭṭho,","thi-ap19:78.2":"etadagge ṭhapesi maṃ;","thi-ap19:78.3":"Aggā iddhimatīnanti,","thi-ap19:78.4":"parisāsu vināyako. 462.","thi-ap19:79.1":"“Pariciṇṇo mayā satthā,","thi-ap19:79.2":"kataṃ buddhassa sāsanaṃ;","thi-ap19:79.3":"Ohito garuko bhāro,","thi-ap19:79.4":"bhavanetti samūhatā. 463.","thi-ap19:80.1":"“Yassatthāya pabbajitā,","thi-ap19:80.2":"agārasmānagāriyaṃ;","thi-ap19:80.3":"So me attho anuppatto,","thi-ap19:80.4":"sabbasaṃyojanakkhayo. 464.","thi-ap19:81.1":"“Cīvaraṃ piṇḍapātañca,","thi-ap19:81.2":"paccayaṃ sayanāsanaṃ;","thi-ap19:81.3":"Khaṇena upanāmenti,","thi-ap19:81.4":"sahassāni samantato. 465.","thi-ap19:82.1":"“Kilesā jhāpitā mayhaṃ…pe…","thi-ap19:82.3":"viharāmi anāsavā; 466.","thi-ap19:83.1":"“Svāgataṃ vata me āsi…pe…","thi-ap19:83.3":"kataṃ buddhassa sāsanaṃ. 467.","thi-ap19:84.1":"“Paṭisambhidā catasso…pe…","thi-ap19:84.3":"kataṃ buddhassa sāsanaṃ”.","thi-ap19:85.1":"Itthaṃ sudaṃ uppalavaṇṇā bhikkhunī imā gāthāyo abhāsitthāti.","thi-ap19:86.1":"Uppalavaṇṇātheriyāpadānaṃ navamaṃ. 10."},"unsure":["thi-ap19:68.3"],"preface":[],"attha":null,"tika":null,"tika2":null}
