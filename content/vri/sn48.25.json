{"suttaId":"sn48.25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1227,1227],"vripara":"495"},"segments":{"sn48.25:0.3":"Suddhakasuttaṃ","sn48.25:1.1":"“Chayimāni, bhikkhave, indriyāni.","sn48.25:1.2":"Katamāni cha?","sn48.25:1.3":"Cakkhundriyaṃ, sotindriyaṃ, ghānindriyaṃ, jivhindriyaṃ, kāyindriyaṃ, manindriyaṃ –","sn48.25:1.4":"imāni kho, bhikkhave, cha indriyānī”ti.","sn48.25:1.5":"Pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":576,"to":576,"paras":[{"para":576,"vripara":"495-500","refs":["sn48.25:1"],"lines":["Pañcame cakkhu ca taṃ cakkhudvāre nibbattānaṃ dhammānaṃ ādhipateyyasaṅkhātena indaṭṭhena indriyañcāti <b>cakkhundriyaṃ.</b>","<b>Sotindriyā</b>dīsupi eseva nayo.","Sesaṃ sabbattha uttānameva.","Imasmiṃ vagge paṭhamasuttañceva chaṭṭhādīni ca pañcāti cha suttāni catusaccavasena kathitānīti."],"lineRefs":[["sn48.25:1"],["sn48.25:1"],["sn48.25:1"],["sn48.25:1"]]}],"wordLinks":[["sn48.25:1.3","cakkhundriyaṃ",0,0],["sn48.25:1.3","sotindriyā",0,1]],"before":[{"para":575,"vripara":null,"title":"Suddhakasuttādivaṇṇanā","lines":["Suddhakasuttādivaṇṇanā 495-500."]}]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":498,"to":501,"paras":[{"para":498,"vripara":"495-500","refs":["sn48.25:1"],"lines":["Yathā cakkhussa sahajātatadindriyanissitadhammesu adhipateyyaṃ anuvattanīyattā, evaṃ taṃdvārikadhammesupi adhipateyyaṃ tehi anuvattanīyattāti vuttaṃ –","<b>“adhipateyyasaṅkhātena indaṭṭhenā”</b>ti.","Esa nayo sesindriyādīsupi.","<b>Catusaccavasena kathitāni</b> sabhāvādivibhāvanassa kathitattā."],"lineRefs":[["sn48.25:1"],["sn48.25:1"],["sn48.25:1"],["sn48.25:1"]]},{"para":499,"vripara":null,"refs":["sn48.25:1"],"lines":["Chaḷindriyavaggavaṇṇanā niṭṭhitā. 4."],"lineRefs":[["sn48.25:1"]]},{"para":500,"vripara":null,"refs":["sn48.25:1"],"lines":["Sukhindriyavaggo 1-5."],"lineRefs":[["sn48.25:1"]]},{"para":501,"vripara":null,"refs":["sn48.25:1"],"lines":["Suddhikasuttādivaṇṇanā 501-505."],"lineRefs":[["sn48.25:1"]]}],"wordLinks":[],"before":[{"para":497,"vripara":null,"title":"Suddhakasuttādivaṇṇanā","lines":["Suddhakasuttādivaṇṇanā 495-500."]}]},"tika2":null}
