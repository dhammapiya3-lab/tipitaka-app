{"suttaId":"an6.112","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[826,826],"vripara":"112"},"segments":{"an6.112:0.3":"Assādasuttaṃ","an6.112:1.1":"“Tayome, bhikkhave, dhammā.","an6.112:1.2":"Katame tayo?","an6.112:1.3":"Assādadiṭṭhi, attānudiṭṭhi, micchādiṭṭhi.","an6.112:1.4":"Ime kho, bhikkhave, tayo dhammā.","an6.112:1.5":"Imesaṃ kho, bhikkhave, tiṇṇaṃ dhammānaṃ pahānāya tayo dhammā bhāvetabbā.","an6.112:1.6":"Katame tayo?","an6.112:1.7":"Assādadiṭṭhiyā pahānāya aniccasaññā bhāvetabbā, attānudiṭṭhiyā pahānāya anattasaññā bhāvetabbā, micchādiṭṭhiyā pahānāya sammādiṭṭhi bhāvetabbā.","an6.112:1.8":"Imesaṃ kho, bhikkhave, tiṇṇaṃ dhammānaṃ pahānāya ime tayo dhammā bhāvetabbā”ti.","an6.112:1.9":"Chaṭṭhaṃ."},"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":778,"to":778,"paras":[{"para":778,"vripara":"112","refs":["an6.112:1"],"lines":["Chaṭṭhe <b>assādadiṭṭhī</b>ti sassatadiṭṭhi.","<b>Attānudiṭṭhī</b>ti attānaṃ anugatā vīsativatthukā sakkāyadiṭṭhi.","<b>Micchādiṭṭhī</b>ti dvāsaṭṭhividhāpi diṭṭhi.","<b>Sammādiṭṭhī</b>ti maggasammādiṭṭhi, natthi dinnantiādikā vā micchādiṭṭhi, kammassakatañāṇaṃ sammādiṭṭhi."],"lineRefs":[["an6.112:1"],["an6.112:1"],["an6.112:1"],["an6.112:1"]]}],"wordLinks":[["an6.112:1.3","assādadiṭṭhī",0,0],["an6.112:1.7","assādadiṭṭhī",0,0],["an6.112:1.3","attānudiṭṭhī",0,1],["an6.112:1.7","attānudiṭṭhī",0,1],["an6.112:1.3","micchādiṭṭhī",0,2],["an6.112:1.7","micchādiṭṭhī",0,2],["an6.112:1.7","sammādiṭṭhī",0,3]],"before":[{"para":777,"vripara":null,"refs":[],"lines":["Assādasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":788,"to":788,"paras":[{"para":788,"vripara":"107-116","refs":["an6.112:1"],"lines":["107-116. Ekādasamavaggo uttānatthoyeva."],"lineRefs":[["an6.112:1"]]}],"wordLinks":[]},"tika2":null}
