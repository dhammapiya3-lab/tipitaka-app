{"suttaId":"thag2.21","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[881,887],"vripara":"161"},"segments":{"thag2.21:0.4":"Uttarattheragāthā","thag2.21:1.1":"“Khandhā mayā pariññātā, taṇhā me susamūhatā;","thag2.21:1.3":"Bhāvitā mama bojjhaṅgā, patto me āsavakkhayo.","thag2.21:2.1":"“Sohaṃ khandhe pariññāya, abbahitvāna [abbuhitvāna (ka.)] jāliniṃ;","thag2.21:2.3":"Bhāvayitvāna bojjhaṅge, nibbāyissaṃ anāsavo”ti.","thag2.21:2.5":"… Uttaro thero …."},"attha":null,"tika":null}
