{"suttaId":"an6.78","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[729,729],"vripara":"78"},"segments":{"an6.78:0.3":"Sukhasomanassasuttaṃ","an6.78:1.1":"“Chahi, bhikkhave, dhammehi samannāgato bhikkhu diṭṭheva dhamme sukhasomanassabahulo viharati, yoni cassa āraddhā hoti āsavānaṃ khayāya.","an6.78:1.2":"Katamehi chahi?","an6.78:1.3":"Idha, bhikkhave, bhikkhu dhammārāmo hoti, bhāvanārāmo hoti, pahānārāmo hoti, pavivekārāmo hoti, abyāpajjhārāmo hoti, nippapañcārāmo hoti.","an6.78:1.4":"Imehi kho, bhikkhave, chahi dhammehi samannāgato bhikkhu diṭṭheva dhamme sukhasomanassabahulo viharati, yoni cassa āraddhā hoti āsavānaṃ khayāyā”ti.","an6.78:1.5":"Catutthaṃ."},"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":745,"to":745,"paras":[{"para":745,"vripara":"78","refs":["an6.78:1"],"lines":["Catutthe <b>yoni cassa āraddhā hotī</b>ti kāraṇañcassa paripuṇṇaṃ paggahitaṃ hoti.","<b>Dhammārāmo</b>ti dhamme ratiṃ vindati.","Bhāvanāya ramati, bhāvento vā ramatīti <b>bhāvanārāmo</b>.","Pahāne ramati, pajahanto vā ramatīti <b>pahānārāmo</b>.","Tividhe paviveke ramatīti <b>pavivekārāmo</b>.","Abyāpajjhe niddukkhabhāve ramatīti <b>abyāpajjhārāmo</b>.","Nippapañcasaṅkhāte nibbāne ramatīti <b>nippapañcārāmo</b>."],"lineRefs":[["an6.78:1"],["an6.78:1"],["an6.78:1"],["an6.78:1"],["an6.78:1"],["an6.78:1"],["an6.78:1"]]}],"wordLinks":[["an6.78:1.1","yoni cassa āraddhā hotī",0,0],["an6.78:1.4","yoni cassa āraddhā hotī",0,0],["an6.78:1.3","dhammārāmo",0,1],["an6.78:1.3","bhāvanārāmo",0,2],["an6.78:1.3","pahānārāmo",0,3],["an6.78:1.3","pavivekārāmo",0,4],["an6.78:1.3","abyāpajjhārāmo",0,5],["an6.78:1.3","nippapañcārāmo",0,6]]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":763,"to":763,"paras":[{"para":763,"vripara":"78","refs":["an6.78:1"],"lines":["Catutthe yathāvuttadhammādīsu tassa kilesanimittaṃ dukkhaṃ anavassananti “sukhasomanassabahulo viharatī”ti vuttaṃ.","Kāyikasukhañceva cetasikasomanassañca bahulaṃ assāti <b>sukhasomanassabahulo</b>.","Yavati tena phalaṃ missitaṃ viya hotīti <b>yoni,</b> ekantikaṃ kāraṇaṃ.","<b>Assā</b>ti yathāvuttassa bhikkhuno.","<b>Paripuṇṇan</b>ti avikalaṃ anavasesaṃ."],"lineRefs":[["an6.78:1"],["an6.78:1"],["an6.78:1"],["an6.78:1"],["an6.78:1"]]}],"wordLinks":[["an6.78:1.1","sukhasomanassabahulo",0,1],["an6.78:1.4","sukhasomanassabahulo",0,1],["an6.78:1.1","yoni",0,2],["an6.78:1.4","yoni",0,2],["an6.78:1.1","assā",0,3],["an6.78:1.4","assā",0,3]]}}
