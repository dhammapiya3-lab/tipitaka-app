{"suttaId":"tha-ap249","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8192,8204],"vripara":"23"},"segments":{"tha-ap249:0.3":"Dhātupūjakattheraapadānaṃ","tha-ap249:1.1":"“Nibbute lokanāthamhi, siddhatthamhi naruttame;","tha-ap249:1.3":"Ekā dhātu mayā laddhā, dvipadindassa tādino.","tha-ap249:2.1":"“Tāhaṃ dhātuṃ gahetvāna, buddhassādiccabandhuno;","tha-ap249:2.3":"Pañcavasse paricariṃ, tiṭṭhantaṃva naruttamaṃ.","tha-ap249:3.1":"“Catunnavutito kappe, yaṃ dhātuṃ pūjayiṃ tadā;","tha-ap249:3.3":"Duggatiṃ nābhijānāmi, dhātupaṭṭhahane phalaṃ.","tha-ap249:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap249:5.1":"Itthaṃ sudaṃ āyasmā dhātupūjako thero imā gāthāyo abhāsitthāti.","tha-ap249:6.1":"Dhātupūjakattherassāpadānaṃ sattamaṃ."},"attha":null,"tika":null,"tika2":null}
