{"suttaId":"tha-ap249","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8192,8204],"vripara":"23"},"segments":{"tha-ap249:0.3":"Dhātupūjakattheraapadānaṃ","tha-ap249:1.1":"“Nibbute lokanāthamhi,","tha-ap249:1.2":"siddhatthamhi naruttame;","tha-ap249:1.3":"Ekā dhātu mayā laddhā,","tha-ap249:1.4":"dvipadindassa tādino.","tha-ap249:2.1":"“Tāhaṃ dhātuṃ gahetvāna,","tha-ap249:2.2":"buddhassādiccabandhuno;","tha-ap249:2.3":"Pañcavasse paricariṃ,","tha-ap249:2.4":"tiṭṭhantaṃva naruttamaṃ.","tha-ap249:3.1":"“Catunnavutito kappe,","tha-ap249:3.2":"yaṃ dhātuṃ pūjayiṃ tadā;","tha-ap249:3.3":"Duggatiṃ nābhijānāmi,","tha-ap249:3.4":"dhātupaṭṭhahane phalaṃ.","tha-ap249:4.1":"“Paṭisambhidā catasso … pe …","tha-ap249:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap249:5.1":"Itthaṃ sudaṃ āyasmā dhātupūjako thero imā gāthāyo abhāsitthāti.","tha-ap249:6.1":"Dhātupūjakattherassāpadānaṃ sattamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
