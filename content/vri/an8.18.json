{"suttaId":"an8.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-viii","vriCode":"s0404m1.mul","paras":[225,225],"vripara":"18"},"segments":{"an8.18:0.3":"Dutiyabandhanasuttaṃ","an8.18:1.1":"“Aṭṭhahi, bhikkhave, ākārehi puriso itthiṃ bandhati.","an8.18:1.2":"Katamehi aṭṭhahi?","an8.18:1.3":"Ruṇṇena, bhikkhave, puriso itthiṃ bandhati;","an8.18:1.4":"hasitena, bhikkhave, puriso itthiṃ bandhati;","an8.18:1.5":"bhaṇitena, bhikkhave, puriso itthiṃ bandhati;","an8.18:1.6":"ākappena, bhikkhave, puriso itthiṃ bandhati;","an8.18:1.7":"vanabhaṅgena, bhikkhave, puriso itthiṃ bandhati;","an8.18:1.8":"gandhena, bhikkhave, puriso itthiṃ bandhati;","an8.18:1.9":"rasena, bhikkhave, puriso itthiṃ bandhati;","an8.18:1.10":"phassena, bhikkhave, puriso itthiṃ bandhati.","an8.18:1.11":"Imehi kho, bhikkhave, aṭṭhahākārehi puriso itthiṃ bandhati.","an8.18:1.12":"Te, bhikkhave, sattā subaddhā, ye phassena baddhā”ti.","an8.18:1.13":"Aṭṭhamaṃ."},"attha":null,"tika":null}
