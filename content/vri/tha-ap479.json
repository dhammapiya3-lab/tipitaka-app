{"suttaId":"tha-ap479","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1725,1739],"vripara":"61"},"segments":{"tha-ap479:0.3":"Giripunnāgiyattheraapadānaṃ","tha-ap479:1.1":"“Sobhito nāma sambuddho, cittakūṭe vasī tadā;","tha-ap479:1.3":"Gahetvā giripunnāgaṃ, sayambhuṃ abhipūjayiṃ.","tha-ap479:2.1":"“Catunnavutito kappe, yaṃ buddhamabhipūjayiṃ;","tha-ap479:2.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap479:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap479:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap479:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap479:6.1":"Itthaṃ sudaṃ āyasmā giripunnāgiyo thero imā gāthāyo Abhāsitthāti.","tha-ap479:7.1":"Giripunnāgiyattherassāpadānaṃ sattamaṃ."},"attha":null,"tika":null,"tika2":null}
