{"suttaId":"tha-ap479","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1725,1739],"vripara":"61"},"segments":{"tha-ap479:0.3":"Giripunnāgiyattheraapadānaṃ","tha-ap479:1.1":"“Sobhito nāma sambuddho,","tha-ap479:1.2":"cittakūṭe vasī tadā;","tha-ap479:1.3":"Gahetvā giripunnāgaṃ,","tha-ap479:1.4":"sayambhuṃ abhipūjayiṃ. 62.","tha-ap479:2.1":"“Catunnavutito kappe,","tha-ap479:2.2":"yaṃ buddhamabhipūjayiṃ;","tha-ap479:2.3":"Duggatiṃ nābhijānāmi,","tha-ap479:2.4":"buddhapūjāyidaṃ phalaṃ. 63.","tha-ap479:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap479:3.3":"viharāmi anāsavo. 64.","tha-ap479:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap479:4.3":"kataṃ buddhassa sāsanaṃ. 65.","tha-ap479:5.1":"“Paṭisambhidā catasso…pe…","tha-ap479:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap479:6.1":"Itthaṃ sudaṃ āyasmā giripunnāgiyo thero imā gāthāyo Abhāsitthāti.","tha-ap479:7.1":"Giripunnāgiyattherassāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
