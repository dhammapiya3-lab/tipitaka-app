{"suttaId":"tha-ap561","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[6285,6299],"vripara":"117"},"segments":{"tha-ap561:0.3":"Sivakattheraapadānaṃ","tha-ap561:1.1":"“Esanāya carantassa, vipassissa mahesino;","tha-ap561:1.3":"Rittakaṃ pattaṃ disvāna, kummāsaṃ pūrayiṃ ahaṃ.","tha-ap561:2.1":"“Ekanavutito kappe, yaṃ bhikkhamadadiṃ tadā;","tha-ap561:2.3":"Duggatiṃ nābhijānāmi, kummāsassa idaṃ phalaṃ.","tha-ap561:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap561:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap561:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap561:6.1":"Itthaṃ sudaṃ āyasmā sivakatthero imā gāthāyo Abhāsitthāti.","tha-ap561:7.1":"Sivakattherassāpadānaṃ navamaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3833,"to":3833,"paras":[{"para":3833,"vripara":"117","refs":["tha-ap561:1"],"words":["esanāya carantassā"],"lines":["Arahattaṃ patvā somanassajāto attano pubbacaritāpadānaṃ pakāsento <b>esanāya carantassā</b>tiādimāha.","Taṃ sabbaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap561:1"],["tha-ap561:1"]]}]},"tika":null}
