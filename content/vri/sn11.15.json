{"suttaId":"sn11.15","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[3381,3385],"vripara":"261"},"segments":{"sn11.15:0.3":"Rāmaṇeyyakasuttaṃ","sn11.15:1.1":"Sāvatthiyaṃ jetavane.","sn11.15:1.2":"Atha kho sakko devānamindo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. Ekamantaṃ ṭhito kho sakko devānamindo bhagavantaṃ etadavoca –","sn11.15:1.3":"“kiṃ nu kho, bhante, bhūmirāmaṇeyyakan”ti?","sn11.15:2.1":"“Ārāmacetyā vanacetyā,","sn11.15:2.2":"pokkharañño sunimmitā;","sn11.15:2.3":"Manussarāmaṇeyyassa,","sn11.15:2.4":"kalaṃ nāgghanti soḷasiṃ.","sn11.15:3.1":"“Gāme vā yadi vāraññe,","sn11.15:3.2":"ninne vā yadi vā thale;","sn11.15:3.3":"Yattha arahanto viharanti,","sn11.15:3.4":"taṃ bhūmirāmaṇeyyakan”ti."},"unsure":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1449,"to":1449,"paras":[{"para":1449,"vripara":"261","refs":["sn11.15:2","sn11.15:3"],"lines":["Pañcame <b>ārāmacetyā</b>ti ārāmacetiyāni.","<b>Vanacetyā</b>ti vanacetiyāni.","Ubhayatthāpi cittīkataṭṭhena cetyaṃ veditabbaṃ.","<b>Manussarāmaṇeyyassā</b>ti manussaramaṇīyabhāvassa.","Idāni manussaramaṇīyakavasena bhūmiramaṇīyakaṃ dassento <b>gāme vā</b>tiādimāha.","Pañcamaṃ."],"lineRefs":[["sn11.15:2"],["sn11.15:2"],["sn11.15:2"],["sn11.15:2"],["sn11.15:3"],["sn11.15:3"]]}],"wordLinks":[["sn11.15:2.1","ārāmacetyā",0,0],["sn11.15:2.1","vanacetyā",0,1],["sn11.15:2.3","manussarāmaṇeyyassā",0,3],["sn11.15:3.1","gāme vā",0,4]],"before":[{"para":1448,"vripara":null,"refs":[],"lines":["Rāmaṇeyyakasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1661,"to":1661,"paras":[{"para":1661,"vripara":"261","refs":["sn11.15:2"],"lines":["Āramanti ettha sattāti <b>ārāmā,</b> manoramā upavanādayo.","Te eva cetenti ettha saddhāya attano pītisomanassaṃ sandhahantīti <b>cetiyā</b>ti ca vuccanti.","<b>Manussaramaṇīyabhāvassā</b>ti manussānaṃ āramaṇīyabhāvassa.","Tassa pana sīlādiguṇavasena acinteyyāparimeyyānubhāvatāpi hotīti bhagavā <b>“nāgghanti soḷasin”</b>ti avoca.","Acetanāya bhūmiyā ramaṇīyatā nāma guṇavisiṭṭhānaṃ ariyānaṃ sevanavasena veditabbāti vuttaṃ <b>“idāni … pe … gāme vātiādimāhā”</b>ti."],"lineRefs":[["sn11.15:2"],["sn11.15:2"],["sn11.15:2"],["sn11.15:2"],["sn11.15:2"]]}],"wordLinks":[["sn11.15:2.1","ārāmā",0,0],["sn11.15:2.3","nāgghanti soḷasiṃ",0,3]],"before":[{"para":1658,"vripara":null,"refs":[],"lines":["<b>Maggenāgatā</b>ti maggādhigamanena āgatā uppannā.","<b>Ariyakantasīlan</b>ti ariyānaṃ kantaṃ manāpaṃ manoramaṃ sīladhammaṃ.","Ariyānaṃ adhicittaadhipaññāsikkhā viya adhisīlasikkhāpi sabbā ativiya kantā evāti āha <b>“kiñcāpī”</b>tiādi.","<b>Imasmiṃ panatthe</b>ti imasmiṃ sotāpannassa bhavasaṅkhāte atthe niddhāretvā vuccamāne.","<b>Pañcasīla</b> mpi yasmā diṭṭhi viya bhavantarepi <b>appahīnaṃ</b>."],"lineRefs":[[],[],[],[],[]]},{"para":1659,"vripara":null,"refs":[],"lines":["Daliddasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1660,"vripara":null,"refs":[],"lines":["Rāmaṇeyyakasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
