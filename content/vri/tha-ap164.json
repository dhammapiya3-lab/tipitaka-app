{"suttaId":"tha-ap164","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6669,6687],"vripara":"7"},"segments":{"tha-ap164:0.3":"Kaṇaverapupphiyattheraapadānaṃ","tha-ap164:1.1":"“Siddhattho nāma bhagavā, lokajeṭṭho narāsabho;","tha-ap164:1.3":"Purakkhato sāvakehi, nagaraṃ paṭipajjatha.","tha-ap164:2.1":"“Rañño antepure āsiṃ, gopako abhisammato;","tha-ap164:2.3":"Pāsāde upaviṭṭhohaṃ, addasaṃ lokanāyakaṃ.","tha-ap164:3.1":"“Kaṇaveraṃ [karavīraṃ (sakkatānulomaṃ), kaṇavīraṃ (pākata)] gahetvāna, bhikkhusaṅghe samokiriṃ;","tha-ap164:3.3":"Buddhassa visuṃ katvāna, tato bhiyyo samokiriṃ.","tha-ap164:4.1":"“Catunnavutito kappe, yaṃ pupphamabhipūjayiṃ [ropayiṃ (syā.)];","tha-ap164:4.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap164:5.1":"“Sattāsītimhito kappe, caturāsuṃ mahiddhikā;","tha-ap164:5.3":"Sattaratanasampannā, cakkavattī mahabbalā.","tha-ap164:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap164:7.1":"Itthaṃ sudaṃ āyasmā kaṇaverapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap164:8.1":"Kaṇaverapupphiyattherassāpadānaṃ dutiyaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3083,"to":3083,"paras":[{"para":3083,"vripara":"7","refs":["tha-ap164:1"],"lines":["So pattaaggaphalo pubbe katakusalaṃ saritvā sañjātasomanasso pubbacaritāpadānaṃ pakāsento <b>siddhattho nāma bhagavā</b>tiādimāha.","Taṃ sabbaṃ heṭṭhā vuttattā uttānatthamevāti."],"lineRefs":[["tha-ap164:1"],["tha-ap164:1"]]}],"wordLinks":[["tha-ap164:1.1","siddhattho nāma bhagavā",0,0]]},"tika":null,"tika2":null}
