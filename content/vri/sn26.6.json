{"suttaId":"sn26.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1177,1177],"vripara":"317"},"segments":{"sn26.6:0.3":"Saññāsuttaṃ","sn26.6:1.1":"Sāvatthinidānaṃ.","sn26.6:1.2":"“Yo kho, bhikkhave, rūpasaññāya uppādo ṭhiti … pe … jarāmaraṇassa pātubhāvo … pe … yo dhammasaññāya uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo.","sn26.6:1.5":"Yo ca kho, bhikkhave, rūpasaññāya nirodho … pe … jarāmaraṇassa atthaṅgamo … pe … yo dhammasaññāya nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo”ti.","sn26.6:1.8":"Chaṭṭhaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":452,"to":454,"paras":[{"para":452,"vripara":"312-321","refs":["sn26.6:1"],"lines":["312-321. Uppādasaṃyutte sabbaṃ pākaṭameva."],"lineRefs":[["sn26.6:1"]]},{"para":453,"vripara":null,"refs":[],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":454,"vripara":null,"refs":["sn26.6:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.6:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":476,"to":478,"paras":[{"para":476,"vripara":"312-321","refs":["sn26.6:1"],"lines":["312-321. <b>Sabbaṃ pākaṭameva</b> apubbassa abhāvato."],"lineRefs":[["sn26.6:1"]]},{"para":477,"vripara":null,"refs":[],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":478,"vripara":null,"refs":["sn26.6:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.6:1"]]}],"wordLinks":[]}}
