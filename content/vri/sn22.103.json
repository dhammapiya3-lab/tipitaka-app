{"suttaId":"sn22.103","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[717,720],"vripara":"103"},"segments":{"sn22.103:0.3":"Antasuttaṃ","sn22.103:1.1":"Sāvatthinidānaṃ.","sn22.103:1.2":"“Cattārome, bhikkhave, antā.","sn22.103:1.3":"Katame cattāro?","sn22.103:1.4":"Sakkāyanto, sakkāyasamudayanto, sakkāyanirodhanto, sakkāyanirodhagāminippaṭipadanto.","sn22.103:1.5":"Katamo ca, bhikkhave, sakkāyanto?","sn22.103:1.6":"Pañcupādānakkhandhātissa vacanīyaṃ.","sn22.103:1.7":"Katame pañca?","sn22.103:1.8":"Seyyathidaṃ – rūpupādānakkhandho, vedanupādānakkhandho, saññupādānakkhandho, saṅkhārupādānakkhandho, viññāṇupādānakkhandho –","sn22.103:1.9":"ayaṃ vuccati, bhikkhave, sakkāyanto”.","sn22.103:2.1":"“Katamo ca, bhikkhave, sakkāyasamudayanto?","sn22.103:2.2":"Yāyaṃ taṇhā ponobhavikā nandirāgasahagatā tatratatrābhinandinī, seyyathidaṃ –","sn22.103:2.3":"kāmataṇhā, bhavataṇhā, vibhavataṇhā.","sn22.103:2.4":"Ayaṃ vuccati, bhikkhave, sakkāyasamudayanto.","sn22.103:3.1":"“Katamo ca, bhikkhave, sakkāyanirodhanto?","sn22.103:3.2":"Yo tassāyeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo –","sn22.103:3.3":"ayaṃ vuccati, bhikkhave, sakkāyanirodhanto.","sn22.103:4.1":"“Katamo ca, bhikkhave, sakkāyanirodhagāminippaṭipadanto?","sn22.103:4.2":"Ayameva ariyo aṭṭhaṅgiko maggo.","sn22.103:4.3":"Seyyathidaṃ – sammādiṭṭhi, sammāsaṅkappo, sammāvācā, sammākammanto, sammāājīvo, sammāvāyāmo, sammāsati, sammāsamādhi.","sn22.103:4.4":"Ayaṃ vuccati, bhikkhave, sakkāyanirodhagāminippaṭipadanto.","sn22.103:4.5":"Ime kho, bhikkhave, cattāro antā”ti.","sn22.103:4.6":"Paṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":361,"to":361,"paras":[{"para":361,"vripara":"103","refs":["sn22.103:1"],"lines":["Antavaggassa paṭhame <b>antā</b>ti koṭṭhāsā.","Idaṃ suttaṃ catusaccavasena pañcakkhandhe yojetvā <b>anto</b>ti vacanena bujjhanakānaṃ ajjhāsayavasena vuttaṃ.","Paṭhamaṃ."],"lineRefs":[["sn22.103:1"],["sn22.103:1"],["sn22.103:1"]]}],"wordLinks":[["sn22.103:1.2","antā",0,0],["sn22.103:1.4","antā",0,0],["sn22.103:1.5","antā",0,0],["sn22.103:1.8","antā",0,0],["sn22.103:1.2","anto",0,1],["sn22.103:1.4","anto",0,1],["sn22.103:1.5","anto",0,1],["sn22.103:1.8","anto",0,1]],"before":[{"para":357,"vripara":null,"refs":[],"lines":["Pupphavaggo dasamo."],"lineRefs":[[]]},{"para":358,"vripara":null,"refs":[],"lines":["Majjhimapaṇṇāsako samatto."],"lineRefs":[[]]},{"para":359,"vripara":null,"refs":[],"lines":["Antavaggo"],"lineRefs":[[]]},{"para":360,"vripara":null,"refs":[],"lines":["Antasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":349,"to":349,"paras":[{"para":349,"vripara":"103","refs":["sn22.103:1"],"lines":["Aññamaññaṃ asaṃsaṭṭhabhāvena eti gacchatīti <b>anto,</b> bhāgoti āha <b>“antāti koṭṭhāsā”</b>ti.","“Sakkāyanirodhanto”ti nirodhapaccayassa gahitattā vuttaṃ <b>“catusaccavasena pañcakkhandhe yojetvā”</b>ti.","<b>Antoti … pe … ajjhāsayavasena vuttaṃ</b> yathānulomadesanattā suttantadesanāya."],"lineRefs":[["sn22.103:1"],["sn22.103:1"],["sn22.103:1"]]}],"wordLinks":[["sn22.103:1.2","anto",0,0],["sn22.103:1.4","anto",0,0],["sn22.103:1.5","anto",0,0],["sn22.103:1.8","anto",0,0]],"before":[{"para":342,"vripara":null,"refs":[],"lines":["<b>Lāyanan</b>ti lāyanaṃ viya nayanaṃ viya nicchoṭanaṃ viya ca <b>aniccasaññāñāṇaṃ.</b>","<b>Iminā atthenā</b>ti iminā yathāvuttena pāḷiyā atthena, <b>upamā saṃsandetabbā</b>ti ettha pabbajalāyako viya yogāvacaro.","Lāyanādinā tassa tattha katakiccatāya parituṭṭhi viya imassa kilese sabbaso chinditvā phalasamāpattisukhena kālassa vītināmanā."],"lineRefs":[[],[],[]]},{"para":343,"vripara":null,"refs":[],"lines":["<b>Kūṭaṃ gacchantī</b>ti pārimantena kūṭaṃ gacchanti.","<b>Kūṭaṃ pavisanabhāvenā</b>ti kūṭacchiddaṃ aggena pavisanavasena.","<b>Samosaritvā</b>ti chidde anupavisanavasena ca āhacca avaṭṭhānena ca samosaritvā ṭhitā.","<b>Kūṭaṃ viya aniccasaññā</b> aniccānupassanāvasena avaṭṭhānassa mūlabhāvato.","<b>Gopānasiyo viya catubhūmakakusalā dhammā</b> aniccasaññāmūlakattā.","<b>Kūṭaṃ aggaṃ</b> sabbagopānasīnaṃ tathāadhiṭṭhānassa padhānakāraṇattā.","<b>Aniccasaññā aggā</b>ti etthāpi eseva nayo.","<b>Aniccasaññā lokiyā</b>ti idaṃ aniccasaññānupassanaṃ sandhāya vuttaṃ.","Aniccānupassanāmukhena adhigataariyamagge uppannasaññā aniccasaññāti vattabbataṃ labhatīti “aniccasaññā, bhikkhave, bhāvitā bahulīkatā sabbaṃ kāmarāgaṃ pariyādiyatī”tiādi vuttaṃ.","Tathā hi <b>dhammasaṅgahe</b> (dha. sa.357,360)“yasmiṃ samaye lokuttaraṃ saññaṃ bhāvetī”tiādinā saññāpi uddhaṭā.","<b>Sabbāsu upamāsū</b>ti mūlasantānaupamādīsu pañcasu upamāsu.","<b>Purimāhī</b>ti kassakapabbajalāyanaambapiṇḍiupamāhi <b>aniccasaññāya kiccaṃ</b> vuttaṃ mūlasantānakapadālanapabbajalāyanavaṇṭacchedanapadesena aniccasaññāya paṭipakkhapacchedanassa dassitattā.","<b>Pacchimāhi balaṃ</b> dassitaṃ paṭipakkhātibhāvassa jotitattā."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":344,"vripara":null,"refs":[],"lines":["Aniccasaññāsuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":345,"vripara":null,"refs":[],"lines":["Pupphavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":346,"vripara":null,"refs":[],"lines":["Majjhimapaṇṇāsako samatto."],"lineRefs":[[]]},{"para":347,"vripara":null,"refs":[],"lines":["Antavaggo"],"lineRefs":[[]]},{"para":348,"vripara":null,"refs":[],"lines":["Antasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
