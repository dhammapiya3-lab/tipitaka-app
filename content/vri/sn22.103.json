{"suttaId":"sn22.103","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[717,720],"vripara":"103"},"segments":{"sn22.103:0.3":"Antasuttaṃ","sn22.103:1.1":"Sāvatthinidānaṃ.","sn22.103:1.2":"“Cattārome, bhikkhave, antā.","sn22.103:1.3":"Katame cattāro?","sn22.103:1.4":"Sakkāyanto, sakkāyasamudayanto, sakkāyanirodhanto, sakkāyanirodhagāminippaṭipadanto.","sn22.103:1.5":"Katamo ca, bhikkhave, sakkāyanto?","sn22.103:1.6":"Pañcupādānakkhandhātissa vacanīyaṃ.","sn22.103:1.7":"Katame pañca?","sn22.103:1.8":"Seyyathidaṃ – rūpupādānakkhandho, vedanupādānakkhandho, saññupādānakkhandho, saṅkhārupādānakkhandho, viññāṇupādānakkhandho –","sn22.103:1.9":"ayaṃ vuccati, bhikkhave, sakkāyanto”.","sn22.103:2.1":"“Katamo ca, bhikkhave, sakkāyasamudayanto?","sn22.103:2.2":"Yāyaṃ taṇhā ponobhavikā nandirāgasahagatā tatratatrābhinandinī, seyyathidaṃ –","sn22.103:2.3":"kāmataṇhā, bhavataṇhā, vibhavataṇhā.","sn22.103:2.4":"Ayaṃ vuccati, bhikkhave, sakkāyasamudayanto.","sn22.103:3.1":"“Katamo ca, bhikkhave, sakkāyanirodhanto?","sn22.103:3.2":"Yo tassāyeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo –","sn22.103:3.3":"ayaṃ vuccati, bhikkhave, sakkāyanirodhanto.","sn22.103:4.1":"“Katamo ca, bhikkhave, sakkāyanirodhagāminippaṭipadanto?","sn22.103:4.2":"Ayameva ariyo aṭṭhaṅgiko maggo.","sn22.103:4.3":"Seyyathidaṃ – sammādiṭṭhi, sammāsaṅkappo, sammāvācā, sammākammanto, sammāājīvo, sammāvāyāmo, sammāsati, sammāsamādhi.","sn22.103:4.4":"Ayaṃ vuccati, bhikkhave, sakkāyanirodhagāminippaṭipadanto.","sn22.103:4.5":"Ime kho, bhikkhave, cattāro antā”ti.","sn22.103:4.6":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":361,"to":361,"paras":[{"para":361,"vripara":"103","refs":["sn22.103:1"],"lines":["Antavaggassa paṭhame <b>antā</b>ti koṭṭhāsā.","Idaṃ suttaṃ catusaccavasena pañcakkhandhe yojetvā <b>anto</b>ti vacanena bujjhanakānaṃ ajjhāsayavasena vuttaṃ.","Paṭhamaṃ. 2-3."],"lineRefs":[["sn22.103:1"],["sn22.103:1"],["sn22.103:1"]]}],"wordLinks":[["sn22.103:1.2","antā",0,0],["sn22.103:1.4","antā",0,0],["sn22.103:1.5","antā",0,0],["sn22.103:1.8","antā",0,0],["sn22.103:1.2","anto",0,1],["sn22.103:1.4","anto",0,1],["sn22.103:1.5","anto",0,1],["sn22.103:1.8","anto",0,1]],"before":[{"para":359,"vripara":null,"title":"Antavaggo","lines":["Antavaggo 1."]},{"para":360,"vripara":null,"title":"Antasuttavaṇṇanā","lines":["Antasuttavaṇṇanā 103."]}]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":349,"to":349,"paras":[{"para":349,"vripara":"103","refs":["sn22.103:1"],"lines":["Aññamaññaṃ asaṃsaṭṭhabhāvena eti gacchatīti <b>anto,</b> bhāgoti āha <b>“antāti koṭṭhāsā”</b>ti.","“Sakkāyanirodhanto”ti nirodhapaccayassa gahitattā vuttaṃ <b>“catusaccavasena pañcakkhandhe yojetvā”</b>ti.","<b>Antoti…pe… ajjhāsayavasena vuttaṃ</b> yathānulomadesanattā suttantadesanāya."],"lineRefs":[["sn22.103:1"],["sn22.103:1"],["sn22.103:1"]]}],"wordLinks":[["sn22.103:1.2","anto",0,0],["sn22.103:1.4","anto",0,0],["sn22.103:1.5","anto",0,0],["sn22.103:1.8","anto",0,0]],"before":[{"para":347,"vripara":null,"title":"Antavaggo","lines":["Antavaggo 1."]},{"para":348,"vripara":null,"title":"Antasuttavaṇṇanā","lines":["Antasuttavaṇṇanā 103."]}],"after":[{"para":350,"vripara":null,"title":"Antasuttavaṇṇanā","lines":["Antasuttavaṇṇanā niṭṭhitā. 2-3."]}]},"tika2":null}
