{"suttaId":"thag1.117","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[675,678],"vripara":"117"},"segments":{"thag1.117:0.4":"Yasattheragāthā","thag1.117:1.1":"“Suvilitto suvasano, sabbābharaṇabhūsito;","thag1.117:1.3":"Tisso vijjā ajjhagamiṃ, kataṃ buddhassa sāsanan”ti.","thag1.117:1.5":"… Yaso thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2979,"to":2979,"paras":[{"para":2979,"vripara":null,"refs":["thag1.117:1"],"lines":["Tattha <b>suvilitto</b>ti sundarena kuṅkumacandanānulepanena vilittagatto.","<b>Suvasano</b>ti suṭṭhu mahagghakāsikavatthavasano.","<b>Sabbābharaṇabhūsito</b>ti sīsūpagādīhi sabbehi ābharaṇehi alaṅkato.","<b>Ajjhagamin</b>ti adhigacchiṃ.","Sesaṃ vuttanayameva."],"lineRefs":[["thag1.117:1"],["thag1.117:1"],["thag1.117:1"],["thag1.117:1"],["thag1.117:1"]]}],"wordLinks":[["thag1.117:1.1","suvilitto",0,0],["thag1.117:1.1","suvasano",0,1],["thag1.117:1.1","sabbābharaṇabhūsito",0,2],["thag1.117:1.3","ajjhagamiṃ",0,3]]},"tika":null}
