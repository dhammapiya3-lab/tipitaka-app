{"suttaId":"sn24.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1050,1050],"vripara":"221"},"segments":{"sn24.16:0.3":"Nahotitathāgatosuttaṃ","sn24.16:1.1":"Sāvatthinidānaṃ.","sn24.16:1.2":"“Kismiṃ nu kho, bhikkhave, sati, kiṃ upādāya, kiṃ abhinivissa evaṃ diṭṭhi uppajjati –","sn24.16:1.3":"‘na hoti tathāgato paraṃ maraṇā’”ti?","sn24.16:1.4":"Bhagavaṃmūlakā no, bhante, dhammā … pe … niyato sambodhiparāyano”ti.","sn24.16:1.6":"Soḷasamaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":441,"to":442,"paras":[{"para":441,"vripara":"216-223","refs":["sn24.16:1"],"lines":["216-223. <b>Antavā loko</b>ti ekato vaḍḍhitanimittaṃ lokoti gāhena vā takkena vā uppannadiṭṭhi.","<b>Anantavā</b>ti sabbato vaḍḍhitaṃ appamāṇanimittaṃ lokoti gāhena vā takkena vā uppannadiṭṭhi.","<b>Taṃ jīvaṃ taṃ sarīran</b>ti jīvañca sarīrañca ekamevāti uppannadiṭṭhi.","Sesaṃ sabbattha uttānamevāti.","Imāni tāva sotāpattimaggavasena aṭṭhārasa veyyākaraṇāni ekaṃ gamanaṃ."],"lineRefs":[["sn24.16:1"],["sn24.16:1"],["sn24.16:1"],["sn24.16:1"],["sn24.16:1"]]},{"para":442,"vripara":null,"refs":["sn24.16:1"],"lines":["Dutiyagamanādivaggavaṇṇanā"],"lineRefs":[["sn24.16:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":461,"to":463,"paras":[{"para":461,"vripara":"216-223","refs":["sn24.16:1"],"lines":["216-223. <b>Ekato vaḍḍhitanimittan</b>ti ekapassena vaḍḍhitaṃ kasiṇanimittaṃ.","<b>Gāhenā</b>ti lābhī jhānacakkhunā passitvā gahaṇena.","<b>Takkenā</b>ti na lābhī takkamattena.","<b>Uppannadiṭṭhī</b>ti “loko”ti uppannadiṭṭhi.","<b>Sabbato vaḍḍhitan</b>ti samantato appamāṇakasiṇanimittaṃ.","<b>Ekamevā</b>ti “ekameva vatthū”ti uppannadiṭṭhi.","<b>Aṭṭhārasa veyyākaraṇānī</b>ti veyyākaraṇalakkhaṇappattāni aṭṭhārasa suttāni.","<b>Ekaṃ gamanan</b>ti ekaṃ veyyākaraṇagamanaṃ."],"lineRefs":[["sn24.16:1"],["sn24.16:1"],["sn24.16:1"],["sn24.16:1"],["sn24.16:1"],["sn24.16:1"],["sn24.16:1"],["sn24.16:1"]]},{"para":462,"vripara":null,"refs":[],"lines":["Antavāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":463,"vripara":null,"refs":["sn24.16:1"],"lines":["Dutiyagamanādivaggavaṇṇanā"],"lineRefs":[["sn24.16:1"]]}],"wordLinks":[]},"tika2":null}
