{"suttaId":"tha-ap379","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10869,10881],"vripara":"38"},"segments":{"tha-ap379:0.3":"Citakapūjakattheraapadānaṃ","tha-ap379:1.1":"“Parinibbute bhagavati,","tha-ap379:1.2":"jalajuttamanāmake;","tha-ap379:1.3":"Āropitamhi citake,","tha-ap379:1.4":"sālapupphamapūjayiṃ.","tha-ap379:2.1":"“Satasahassito kappe,","tha-ap379:2.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap379:2.3":"Duggatiṃ nābhijānāmi,","tha-ap379:2.4":"citapūjāyidaṃ phalaṃ.","tha-ap379:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap379:3.3":"viharāmi anāsavo.","tha-ap379:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap379:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap379:5.1":"“Paṭisambhidā catasso … pe …","tha-ap379:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap379:6.1":"Itthaṃ sudaṃ āyasmā citakapūjako thero imā gāthāyo abhāsitthāti.","tha-ap379:7.1":"Citakapūjakattherassāpadānaṃ sattamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
