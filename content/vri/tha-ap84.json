{"suttaId":"tha-ap84","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4777,4795],"vripara":"10"},"segments":{"tha-ap84:0.3":"Gatasaññakattheraapadānaṃ","tha-ap84:1.1":"“Jātiyā sattavassohaṃ,","tha-ap84:1.2":"pabbajiṃ anagāriyaṃ;","tha-ap84:1.3":"Avandiṃ satthuno pāde,","tha-ap84:1.4":"vippasannena cetasā.","tha-ap84:2.1":"“Sattanaṅgalakīpupphe,","tha-ap84:2.2":"ākāse ukkhipiṃ ahaṃ;","tha-ap84:2.3":"Tissaṃ buddhaṃ samuddissa,","tha-ap84:2.4":"anantaguṇasāgaraṃ.","tha-ap84:3.1":"“Sugatānugataṃ maggaṃ,","tha-ap84:3.2":"pūjetvā haṭṭhamānaso;","tha-ap84:3.3":"Añjaliñca [añjalissa (ka.)] tadākāsiṃ,","tha-ap84:3.4":"pasanno sehi pāṇibhi.","tha-ap84:4.1":"“Dvenavute ito kappe,","tha-ap84:4.2":"yaṃ kammamakariṃ tadā;","tha-ap84:4.3":"Duggatiṃ nābhijānāmi,","tha-ap84:4.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap84:5.1":"“Ito aṭṭhamake kappe,","tha-ap84:5.2":"tayo aggisikhā ahu;","tha-ap84:5.3":"Sattaratanasampannā,","tha-ap84:5.4":"cakkavattī mahabbalā.","tha-ap84:6.1":"“Paṭisambhidā catasso … pe …","tha-ap84:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap84:7.1":"Itthaṃ sudaṃ āyasmā gatasaññako thero imā gāthāyo abhāsitthāti.","tha-ap84:8.1":"Gatasaññakattherassāpadānaṃ dutiyaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2715,"to":2716,"paras":[{"para":2715,"vripara":"10","refs":["tha-ap84:1"],"lines":["So aparabhāge attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>jātiyā sattavassohan</b>tiādimāha.","Tattha <b>jātiyā sattavasso</b>ti mātugabbhato nikkhantakālato paṭṭhāya paripuṇṇasattavassikoti attho.","<b>Pabbajiṃ anagāriyan</b>ti agārassa hitaṃ āgāriyaṃ kasivāṇijjādikammaṃ natthi āgāriyanti anagāriyaṃ, buddhasāsane pabbajiṃ ahanti attho."],"lineRefs":[["tha-ap84:1"],["tha-ap84:1"],["tha-ap84:1"]]},{"para":2716,"vripara":"12","refs":["tha-ap84:3"],"lines":["<b>Sugatānugataṃ maggan</b>ti buddhena gataṃ maggaṃ.","Atha vā sugatena desitaṃ dhammānudhammapaṭipattipūraṇavasena <b>haṭṭhamānaso</b> tuṭṭhacitto pūjetvāti sambandho.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["tha-ap84:3"],["tha-ap84:3"],["tha-ap84:3"]]}],"wordLinks":[["tha-ap84:1.1","jātiyā sattavassohaṃ",0,0],["tha-ap84:1.1","jātiyā sattavasso",0,1],["tha-ap84:1.1","pabbajiṃ anagāriyaṃ",0,2],["tha-ap84:3.1","sugatānugataṃ maggaṃ",1,0],["tha-ap84:3.1","haṭṭhamānaso",1,1]]},"tika":null,"tika2":null}
