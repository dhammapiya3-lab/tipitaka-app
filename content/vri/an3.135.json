{"suttaId":"an3.135","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1192,1192],"vripara":"136"},"segments":{"an3.135:0.3":"Mittasuttaṃ","an3.135:1.1":"“Tīhi, bhikkhave, aṅgehi samannāgato mitto sevitabbo.","an3.135:1.2":"Katamehi tīhi?()[(idha bhikkhave bhikkhu)(pī. ka.)]","an3.135:1.3":"Duddadaṃ dadāti, dukkaraṃ karoti, dukkhamaṃ khamati –","an3.135:1.4":"imehi kho, bhikkhave, tīhi aṅgehi samannāgato mitto sevitabbo”ti.","an3.135:1.5":"Tatiyaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
