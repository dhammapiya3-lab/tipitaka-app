{"suttaId":"sn2.28","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1247,1251],"vripara":"109"},"segments":{"sn2.28:0.3":"Nandivisālasuttaṃ","sn2.28:1.1":"Ekamantaṃ ṭhito kho nandivisālo devaputto bhagavantaṃ gāthāya ajjhabhāsi –","sn2.28:2.1":"“Catucakkaṃ navadvāraṃ, puṇṇaṃ lobhena saṃyutaṃ;","sn2.28:2.3":"Paṅkajātaṃ mahāvīra, kathaṃ yātrā bhavissatī”ti.","sn2.28:3.1":"“Chetvā naddhiṃ varattañca, icchālobhañca pāpakaṃ;","sn2.28:3.3":"Samūlaṃ taṇhamabbuyha, evaṃ yātrā bhavissatī”ti."},"attha":null,"tika":null}
