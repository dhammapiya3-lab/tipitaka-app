{"suttaId":"an5.293","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1606,1606],"vripara":"293"},"segments":{"an5.293:0.3":"Ājīvakasuttaṃ","an5.293:1.1":"“Pañcahi, bhikkhave, dhammehi samannāgato ājīvako yathābhataṃ nikkhitto evaṃ niraye.","an5.293:1.2":"Katamehi pañcahi?","an5.293:1.3":"Pāṇātipātī hoti, adinnādāyī hoti, abrahmacārī hoti, musāvādī hoti, surāmerayamajjapamādaṭṭhāyī hoti.","an5.293:1.4":"Imehi kho, bhikkhave, pañcahi dhammehi samannāgato ājīvako yathābhataṃ nikkhitto evaṃ niraye”ti.","an5.293:1.5":"Aṭṭhamaṃ. 9-17."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":498,"to":498,"paras":[{"para":498,"vripara":"293-302","refs":["an5.293:1"],"lines":["<b>Ājīvako</b>ti naggaparibbājako.","<b>Nigaṇṭho</b>ti purimabhāgappaṭicchanno.","<b>Muṇḍasāvako</b>ti nigaṇṭhasāvako.","<b>Jaṭilako</b>ti tāpaso.","<b>Paribbājako</b>ti channaparibbājako.","<b>Māgaṇḍikā</b>dayopi titthiyā eva.","Etesaṃ pana sīlesu paripūrakāritāya abhāvena sukkapakkho na gahito.","Sesamettha uttānamevāti."],"lineRefs":[["an5.293:1"],["an5.293:1"],["an5.293:1"],["an5.293:1"],["an5.293:1"],["an5.293:1"],["an5.293:1"],["an5.293:1"]]}],"wordLinks":[["an5.293:1.1","ājīvako",0,0],["an5.293:1.4","ājīvako",0,0]],"after":[{"para":499,"vripara":null,"title":"Sammutipeyyālādivaṇṇanā","lines":["Manorathapūraṇiyā aṅguttaranikāya-aṭṭhakathāya"]},{"para":500,"vripara":null,"title":"Sammutipeyyālādivaṇṇanā","lines":["Pañcakanipātassa saṃvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
