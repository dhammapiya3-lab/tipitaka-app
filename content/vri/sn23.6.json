{"suttaId":"sn23.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[908,908],"vripara":"165"},"segments":{"sn23.6:0.3":"Dutiyasamaṇasuttaṃ","sn23.6:1.1":"Sāvatthinidānaṃ.","sn23.6:1.2":"Ekamantaṃ nisinnaṃ kho āyasmantaṃ rādhaṃ bhagavā etadavoca –","sn23.6:1.3":"“pañcime, rādha, upādānakkhandhā.","sn23.6:1.4":"Katame pañca?","sn23.6:1.5":"Rūpupādānakkhandho … pe … viññāṇupādānakkhandho.","sn23.6:1.6":"Ye hi keci, rādha, samaṇā vā brāhmaṇā vā imesaṃ pañcannaṃ upādānakkhandhānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti … pe … sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti.","sn23.6:1.8":"Chaṭṭhaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":406,"to":409,"paras":[{"para":406,"vripara":"161-169","refs":["sn23.6:1"],"lines":["161-169. Dutiye <b>satto satto</b>ti laggapucchā.","<b>Tatra satto tatra visatto</b>ti tatra laggo tatra vilaggo.","<b>Paṃsvāgārakehī</b>ti paṃsugharakehi.","<b>Keḷāyantī</b>ti kīḷanti.","<b>Dhanāyantī</b>ti dhanaṃ viya maññanti.","<b>Mamāyantī</b>ti “mama idaṃ, mama idan”ti mamattaṃ karonti, aññassa phusitumpi na denti.","<b>Vikīḷaniyaṃ karontī</b>ti “niṭṭhitā kīḷā”ti te bhindamānā kīḷāvigamaṃ karonti.","Tatiye <b>bhavanettī</b>ti bhavarajju.","Catutthaṃ uttānameva.","Pañcamādīsu catūsu cattāri saccāni kathitāni, dvīsu kilesappahānanti.","Dutiyādīni."],"lineRefs":[["sn23.6:1"],["sn23.6:1"],["sn23.6:1"],["sn23.6:1"],["sn23.6:1"],["sn23.6:1"],["sn23.6:1"],["sn23.6:1"],["sn23.6:1"],["sn23.6:1"],["sn23.6:1"]]},{"para":407,"vripara":null,"refs":[],"lines":["Paṭhamo vaggo."],"lineRefs":[[]]},{"para":408,"vripara":null,"refs":[],"lines":["Dutiyavaggo"],"lineRefs":[[]]},{"para":409,"vripara":null,"refs":["sn23.6:1"],"lines":["1-12. Mārasuttādivaṇṇanā"],"lineRefs":[["sn23.6:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":415,"to":419,"paras":[{"para":415,"vripara":"161-169","refs":["sn23.6:1"],"lines":["161-169. <b>Laggapucchā</b>ti lagganassa bajjhanassa pucchā.","Yadi rūpādīsu sattattā satto, khīṇāsavā kathaṃ sattāti?","Sattabhūtapubbāti katvā.","<b>Kīḷāvigaman</b>ti kīḷāya apanayanaṃ oramaṇaṃ.","Yantarajju viya bhavapabandhassa nayanato <b>bhavarajjū</b>ti taṇhā vuttā."],"lineRefs":[["sn23.6:1"],["sn23.6:1"],["sn23.6:1"],["sn23.6:1"],["sn23.6:1"]]},{"para":416,"vripara":null,"refs":[],"lines":["Sattasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":417,"vripara":null,"refs":[],"lines":["Paṭhamavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":418,"vripara":null,"refs":[],"lines":["Dutiyavaggo"],"lineRefs":[[]]},{"para":419,"vripara":null,"refs":["sn23.6:1"],"lines":["1-12. Mārasuttādivaṇṇanā"],"lineRefs":[["sn23.6:1"]]}],"wordLinks":[]}}
