{"suttaId":"thag1.50","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[293,301],"vripara":"50"},"segments":{"thag1.50:0.4":"Vimalattheragāthā","thag1.50:1.1":"“Dharaṇī ca siñcati vāti, māluto vijjutā carati nabhe;","thag1.50:1.3":"Upasamanti vitakkā, cittaṃ susamāhitaṃ mamā”ti.","thag1.50:1.5":"… Vimalo thero ….","thag1.50:1.6":"Vaggo pañcamo niṭṭhito.","thag1.50:2.0":"Tassuddānaṃ –","thag1.50:2.1":"Sirīvaḍḍho revato thero, sumaṅgalo sānusavhayo;","thag1.50:2.3":"Ramaṇīyavihārī ca, samiddhiujjayasañjayā;","thag1.50:2.5":"Rāmaṇeyyo ca so thero, vimalo ca raṇañjahoti."},"attha":null,"tika":null}
