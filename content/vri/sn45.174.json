{"suttaId":"sn45.174","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[388,388],"vripara":"175"},"segments":{"sn45.174:0.3":"Ganthasuttaṃ","sn45.174:1.1":"“Cattārome, bhikkhave, ganthā.","sn45.174:1.2":"Katame cattāro?","sn45.174:1.3":"Abhijjhā kāyagantho, byāpādo kāyagantho, sīlabbataparāmāso kāyagantho, idaṃsaccābhiniveso kāyagantho – ime kho, bhikkhave, cattāro ganthā.","sn45.174:1.5":"Imesaṃ kho, bhikkhave, catunnaṃ ganthānaṃ abhiññāya pariññāya parikkhayāya pahānāya … pe … ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.174:1.6":"Catutthaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":120,"to":121,"paras":[{"para":120,"vripara":"174-175","refs":["sn45.174:1"],"lines":["174-175. <b>Kāmupādānan</b>ti kāmaggahaṇaṃ.","<b>Diṭṭhupādānā</b> dīsupi eseva nayo.","<b>Ganthā</b>ti ganthanā ghaṭanā.","<b>Kāyagantho</b>ti nāmakāyassa gantho ganthanaghaṭanakileso.","<b>Idaṃsaccābhiniveso</b>ti antaggāhikadiṭṭhivasena uppanno “idameva saccan”ti evaṃ abhiniveso."],"lineRefs":[["sn45.174:1"],["sn45.174:1"],["sn45.174:1"],["sn45.174:1"],["sn45.174:1"]]},{"para":121,"vripara":null,"refs":["sn45.174:1"],"lines":["5-10. Anusayasuttādivaṇṇanā"],"lineRefs":[["sn45.174:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":120,"to":122,"paras":[{"para":120,"vripara":"174-175","refs":["sn45.174:1"],"lines":["174-175. Kāmanavasena upādiyanato <b>kāmupādānaṃ</b>.","Tenāha <b>“kāmaggahaṇan”</b>ti.","<b>Nāmakāyassā</b>ti vedanādīnaṃ catunnaṃ arūpakkhandhānaṃ.","<b>Ghaṭanapabandhanakileso</b>ti hetunā phalassa kammavaṭṭassa vipākavaṭṭena dukkhappabandhasaññitassa ghaṭanassa sambajjhanassa nibbattakakileso.","<b>Antaggāhikadiṭṭhi</b> sassatucchedagāho."],"lineRefs":[["sn45.174:1"],["sn45.174:1"],["sn45.174:1"],["sn45.174:1"],["sn45.174:1"]]},{"para":121,"vripara":null,"refs":[],"lines":["Upādānasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":122,"vripara":null,"refs":["sn45.174:1"],"lines":["5-10. Anusayasuttādivaṇṇanā"],"lineRefs":[["sn45.174:1"]]}],"wordLinks":[]}}
