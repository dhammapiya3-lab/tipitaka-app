{"suttaId":"sn35.109","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[676,676],"vripara":"109"},"segments":{"sn35.109:0.3":"Saṃyojaniyasuttaṃ","sn35.109:1.1":"“Saṃyojaniye ca, bhikkhave, dhamme desessāmi saṃyojanañca.","sn35.109:1.2":"Taṃ suṇātha.","sn35.109:1.3":"Katame ca, bhikkhave, saṃyojaniyā dhammā, katamañca saṃyojanaṃ?","sn35.109:1.4":"Cakkhuṃ, bhikkhave, saṃyojaniyo dhammo.","sn35.109:1.5":"Yo tattha chandarāgo, taṃ tattha saṃyojanaṃ…pe…","sn35.109:1.6":"jivhā saṃyojaniyo dhammo…pe…","sn35.109:1.7":"mano saṃyojaniyo dhammo.","sn35.109:1.8":"Yo tattha chandarāgo, taṃ tattha saṃyojanaṃ.","sn35.109:1.9":"Ime vuccanti, bhikkhave, saṃyojaniyā dhammā, idaṃ saṃyojana”nti.","sn35.109:1.10":"Chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":190,"to":193,"paras":[{"para":190,"vripara":"105-113","refs":["sn35.109:1"],"lines":["Dutiye vedanāsukhadukkhaṃ kathitaṃ, taṃ pana vipākasukhadukkhaṃ vaṭṭati.","Tatiye <b>dukkhassā</b>ti vaṭṭadukkhassa.","Catutthe <b>lokassā</b>ti saṅkhāralokassa.","Pañcamādīsu yaṃ vattabbaṃ siyā, taṃ khandhiyavagge vuttanayameva."],"lineRefs":[["sn35.109:1"],["sn35.109:1"],["sn35.109:1"],["sn35.109:1"]]},{"para":191,"vripara":null,"refs":["sn35.109:1"],"lines":["Yogakkhemivaggo ekādasamo. 12."],"lineRefs":[["sn35.109:1"]]},{"para":192,"vripara":null,"refs":["sn35.109:1"],"lines":["Lokakāmaguṇavaggo 1-2."],"lineRefs":[["sn35.109:1"]]},{"para":193,"vripara":null,"refs":["sn35.109:1"],"lines":["Paṭhamamārapāsasuttādivaṇṇanā 114-115."],"lineRefs":[["sn35.109:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":196,"to":200,"paras":[{"para":196,"vripara":"105-113","refs":["sn35.109:1"],"lines":["<b>Vedanāsukhadukkha</b>nti vedanāsaṅkhātaṃ sukhañca dukkhañca kathitaṃ.","“Ajjhattaṃ sukhaṃ dukkha”nti vuttattā vimuttisukhassa ca saḷāyatanadukkhassa ca kathitattā vivaṭṭasukhaṃ cettha kathitamevāti sakkā viññātuṃ.","Kāmaṃ khandhiyavagge khandhavasena desanā āgatā, na āyatanavasena.","Ettha pana vattabbaṃ atthajātaṃ khandhiyavagge vuttanayamevāti."],"lineRefs":[["sn35.109:1"],["sn35.109:1"],["sn35.109:1"],["sn35.109:1"]]},{"para":197,"vripara":null,"refs":["sn35.109:1"],"lines":["Upādāyasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.109:1"]]},{"para":198,"vripara":null,"refs":["sn35.109:1"],"lines":["Yogakkhemivaggavaṇṇanā niṭṭhitā. 12."],"lineRefs":[["sn35.109:1"]]},{"para":199,"vripara":null,"refs":["sn35.109:1"],"lines":["Lokakāmaguṇavaggo 1-2."],"lineRefs":[["sn35.109:1"]]},{"para":200,"vripara":null,"refs":["sn35.109:1"],"lines":["Paṭhamamārapāsasuttādivaṇṇanā 114-115."],"lineRefs":[["sn35.109:1"]]}],"wordLinks":[]},"tika2":null}
