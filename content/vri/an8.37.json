{"suttaId":"an8.37","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-viii","vriCode":"s0404m1.mul","paras":[427,433],"vripara":"37"},"segments":{"an8.37:0.3":"Sappurisadānasuttaṃ","an8.37:1.1":"“Aṭṭhimāni, bhikkhave, sappurisadānāni.","an8.37:1.2":"Katamāni aṭṭha?","an8.37:1.3":"Suciṃ deti, paṇītaṃ deti, kālena deti, kappiyaṃ deti, viceyya deti, abhiṇhaṃ deti, dadaṃ cittaṃ pasādeti, datvā attamano hoti.","an8.37:1.4":"Imāni kho, bhikkhave, aṭṭha sappurisadānānī”ti.","an8.37:2.1":"“Suciṃ paṇītaṃ kālena,","an8.37:2.2":"kappiyaṃ pānabhojanaṃ;","an8.37:2.3":"Abhiṇhaṃ dadāti dānaṃ,","an8.37:2.4":"sukhettesu [sukhette (sī. pī.)] brahmacārisu.","an8.37:3.1":"“Neva [na ca (sī. pī.)] vippaṭisārissa,","an8.37:3.2":"cajitvā āmisaṃ bahuṃ;","an8.37:3.3":"Evaṃ dinnāni dānāni,","an8.37:3.4":"vaṇṇayanti vipassino.","an8.37:4.1":"“Evaṃ yajitvā medhāvī,","an8.37:4.2":"saddho muttena cetasā;","an8.37:4.3":"Abyābajjhaṃ [abyāpajjhaṃ (ka.) a. ni.4.40;6.37] sukhaṃ lokaṃ,","an8.37:4.4":"paṇḍito upapajjatī”ti.","an8.37:4.5":"sattamaṃ;"},"unsure":[],"preface":[],"attha":{"book":"Mp-viii","bookName":"Aṭṭhakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":151,"to":151,"paras":[{"para":151,"vripara":"37","refs":["an8.37:1"],"lines":["Sattame <b>sucin</b>ti parisuddhaṃ vaṇṇasampannaṃ deti.","<b>Paṇītan</b>ti rasūpapannaṃ.","<b>Kālenā</b>ti yuttapattakālena.","<b>Kappiyan</b>ti yaṃ kappiyaṃ, taṃ deti.","<b>Viceyya detī</b>ti “imassa dinnaṃ mahapphalaṃ bhavissati, imassa na mahapphalan”ti evaṃ paṭiggāhakapariyesanavasena dānaṃ vā paṇidhāyavasena dānaṃ vā vicinitvā deti."],"lineRefs":[["an8.37:1"],["an8.37:1"],["an8.37:1"],["an8.37:1"],["an8.37:1"]]}],"wordLinks":[["an8.37:1.3","suciṃ",0,0],["an8.37:1.3","paṇītaṃ",0,1],["an8.37:1.3","kālenā",0,2],["an8.37:1.3","kappiyaṃ",0,3],["an8.37:1.3","viceyya detī",0,4]],"before":[{"para":150,"vripara":null,"title":"Sappurisadānasuttavaṇṇanā","lines":["Sappurisadānasuttavaṇṇanā"]}]},"tika":{"book":"Mp-t-viii","bookName":"Aṭṭhakanipāta-ṭīkā","vriCode":"s0404t.tik","from":158,"to":158,"paras":[{"para":158,"vripara":"37-38","refs":["an8.37:1"],"lines":["37-38. Sattame <b>viceyya detī</b>ti ettha dve vicinanāni dakkhiṇeyyavicinanaṃ, dakkhiṇāvicinanañca.","Tesu vipannasīle ito bahiddhā pañcanavuti pāsaṇḍabhede ca dakkhiṇeyye pahāya sīlādiguṇasampannānaṃ sāsane pabbajitānaṃ dānaṃ <b>dakkhiṇeyyavicinanaṃ</b> nāma.","Lāmakalāmake paccaye apanetvā paṇītapaṇīte vicinitvā tesaṃ dānaṃ <b>dakkhiṇāvicinanaṃ</b> nāma.","Tenāha <b>“imassa dinnaṃ mahapphalaṃ bhavissatī”</b>tiādi.","Aṭṭhame natthi vattabbaṃ."],"lineRefs":[["an8.37:1"],["an8.37:1"],["an8.37:1"],["an8.37:1"],["an8.37:1"]]}],"wordLinks":[["an8.37:1.3","viceyya detī",0,0]],"before":[{"para":157,"vripara":null,"title":"Sappurisadānasuttādivaṇṇanā","lines":["7-8. Sappurisadānasuttādivaṇṇanā"]}]},"tika2":null}
