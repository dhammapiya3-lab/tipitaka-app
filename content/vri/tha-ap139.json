{"suttaId":"tha-ap139","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6174,6198],"vripara":"47"},"segments":{"tha-ap139:0.3":"Atthasandassakattheraapadānaṃ","tha-ap139:1.1":"“Visālamāḷe āsīno,","tha-ap139:1.2":"addasaṃ lokanāyakaṃ;","tha-ap139:1.3":"Khīṇāsavaṃ balappattaṃ,","tha-ap139:1.4":"bhikkhusaṅghapurakkhataṃ.","tha-ap139:2.1":"“Satasahassā tevijjā,","tha-ap139:2.2":"chaḷabhiññā mahiddhikā;","tha-ap139:2.3":"Parivārenti sambuddhaṃ,","tha-ap139:2.4":"ko disvā nappasīdati.","tha-ap139:3.1":"“Ñāṇe upanidhā yassa,","tha-ap139:3.2":"na vijjati sadevake;","tha-ap139:3.3":"Anantañāṇaṃ sambuddhaṃ,","tha-ap139:3.4":"ko disvā nappasīdati.","tha-ap139:4.1":"“Dhammakāyañca dīpentaṃ,","tha-ap139:4.2":"kevalaṃ ratanākaraṃ;","tha-ap139:4.3":"Vikappetuṃ [vikopetuṃ (sī. syā.)] na sakkonti,","tha-ap139:4.4":"ko disvā nappasīdati.","tha-ap139:5.1":"“Imāhi tīhi gāthāhi,","tha-ap139:5.2":"nāradovhayavacchalo [saragacchiyo (sī.), puragacchiyo (syā.)];","tha-ap139:5.3":"Padumuttaraṃ thavitvāna,","tha-ap139:5.4":"sambuddhaṃ aparājitaṃ.","tha-ap139:6.1":"“Tena cittappasādena,","tha-ap139:6.2":"buddhasanthavanena ca;","tha-ap139:6.3":"Kappānaṃ satasahassaṃ,","tha-ap139:6.4":"duggatiṃ, nupapajjahaṃ.","tha-ap139:7.1":"“Ito tiṃsakappasate,","tha-ap139:7.2":"sumitto nāma khattiyo;","tha-ap139:7.3":"Sattaratanasampanno,","tha-ap139:7.4":"cakkavattī mahabbalo.","tha-ap139:8.1":"“Paṭisambhidā catasso … pe …","tha-ap139:8.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap139:9.1":"Itthaṃ sudaṃ āyasmā atthasandassako thero imā gāthāyo abhāsitthāti.","tha-ap139:10.1":"Atthasandassakattherassāpadānaṃ sattamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2966,"to":2966,"paras":[{"para":2966,"vripara":"47","refs":["tha-ap139:1"],"lines":["So attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>visālamāḷe āsīno</b>tiādimāha.","Tattha <b>visālamāḷe</b>ti visālaṃ patthaṭaṃ vitthiṇṇaṃ mahantaṃ māḷaṃ visālamāḷaṃ, tasmiṃ visālamāḷe <b>āsīno</b> nisinno ahaṃ lokanāyakaṃ addasanti sambandho.","Tesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap139:1"],["tha-ap139:1"],["tha-ap139:1"]]}],"wordLinks":[["tha-ap139:1.1","visālamāḷe āsīno",0,0],["tha-ap139:1.1","visālamāḷe",0,1],["tha-ap139:1.1","āsīno",0,1]]},"tika":null,"tika2":null}
