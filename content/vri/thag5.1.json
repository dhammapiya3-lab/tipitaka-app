{"suttaId":"thag5.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1506,1521],"vripara":"315"},"segments":{"thag5.1:0.4":"Rājadattattheragāthā","thag5.1:1.1":"“Bhikkhu sivathikaṃ [sīvathikaṃ (sī. syā. pī.)] gantvā,","thag5.1:1.2":"addasa itthimujjhitaṃ;","thag5.1:1.3":"Apaviddhaṃ susānasmiṃ,","thag5.1:1.4":"khajjantiṃ kimihī phuṭaṃ.","thag5.1:2.1":"“Yañhi eke jigucchanti,","thag5.1:2.2":"mataṃ disvāna pāpakaṃ;","thag5.1:2.3":"Kāmarāgo pāturahu,","thag5.1:2.4":"andhova savatī [vasatī (sī.)] ahuṃ.","thag5.1:3.1":"“Oraṃ odanapākamhā,","thag5.1:3.2":"tamhā ṭhānā apakkamiṃ;","thag5.1:3.3":"Satimā sampajānohaṃ,","thag5.1:3.4":"ekamantaṃ upāvisiṃ.","thag5.1:4.1":"“Tato me manasīkāro,","thag5.1:4.2":"yoniso udapajjatha;","thag5.1:4.3":"Ādīnavo pāturahu,","thag5.1:4.4":"nibbidā samatiṭṭhatha.","thag5.1:5.1":"“Tato cittaṃ vimucci me,","thag5.1:5.2":"passa dhammasudhammataṃ;","thag5.1:5.3":"Tisso vijjā anuppattā,","thag5.1:5.4":"kataṃ buddhassa sāsanan”ti.","thag5.1:5.5":"… Rājadatto thero …."},"unsure":[],"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":407,"to":479,"paras":[{"para":407,"vripara":"315","refs":["thag5.1:1"],"lines":["“Bhikkhu sivathikaṃ gantvā, addasa itthimujjhitaṃ;"],"lineRefs":[["thag5.1:1"]]},{"para":408,"vripara":null,"refs":["thag5.1:1"],"lines":["Apaviddhaṃ susānasmiṃ, khajjantiṃ kimihī phuṭaṃ."],"lineRefs":[["thag5.1:1"]]},{"para":410,"vripara":"316","refs":["thag5.1:2"],"lines":["“Yañhi eke jigucchanti, mataṃ disvāna pāpakaṃ;"],"lineRefs":[["thag5.1:2"]]},{"para":411,"vripara":null,"refs":["thag5.1:2"],"lines":["Kāmarāgo pāturahu, andhova savatī ahuṃ."],"lineRefs":[["thag5.1:2"]]},{"para":413,"vripara":"317","refs":["thag5.1:3"],"lines":["“Oraṃ odanapākamhā, tamhā ṭhānā apakkamiṃ;"],"lineRefs":[["thag5.1:3"]]},{"para":414,"vripara":null,"refs":["thag5.1:3"],"lines":["Satimā sampajānohaṃ, ekamantaṃ upāvisiṃ."],"lineRefs":[["thag5.1:3"]]},{"para":416,"vripara":"318","refs":["thag5.1:4"],"lines":["“Tato me manasīkāro, yoniso udapajjatha;"],"lineRefs":[["thag5.1:4"]]},{"para":417,"vripara":null,"refs":["thag5.1:4"],"lines":["Ādīnavo pāturahu, nibbidā samatiṭṭhatha."],"lineRefs":[["thag5.1:4"]]},{"para":419,"vripara":"319","refs":["thag5.1:5"],"lines":["“Tato cittaṃ vimucci me, passa dhammasudhammataṃ;"],"lineRefs":[["thag5.1:5"]]},{"para":420,"vripara":null,"refs":["thag5.1:5"],"lines":["Tisso vijjā anuppattā, kataṃ buddhassa sāsanan”ti.","–"],"lineRefs":[["thag5.1:5"],["thag5.1:5"]]},{"para":421,"vripara":null,"refs":["thag5.1:5"],"lines":["Imā pañca gāthā abhāsi."],"lineRefs":[["thag5.1:5"]]},{"para":422,"vripara":null,"refs":["thag5.1:5"],"lines":["Tattha <b>bhikkhu sivathikaṃ gantvā</b>ti saṃsāre bhayassa ikkhanato bhikkhu, asubhakammaṭṭhānatthaṃ āmakasusānaṃ upagantvā.","“Bhikkhū”ti cetaṃ attānaṃ sandhāya thero sayaṃ vadati.","<b>Itthin</b>ti thīyati ettha sukkasoṇitaṃ sattasantānabhāvena saṃhaññatīti thī, mātugāmo.","Evañca sabhāvaniruttivasena “itthī” tipi vuccati.","Vañjhādīsu pana taṃsadisatāya taṃsabhāvānativattanato ca tabbohāro.","“Itthī”ti itthikaḷevaraṃ vadati.","<b>Ujjhitan</b>ti pariccattaṃ ujjhaniyattā eva <b>apaviddhaṃ</b> anapekkhabhāvena khittaṃ.","<b>Khajjantiṃ kimihī phuṭan</b>ti kimīhi pūritaṃ hutvā khajjamānaṃ."],"lineRefs":[["thag5.1:5"],["thag5.1:5"],["thag5.1:5"],["thag5.1:5"],["thag5.1:5"],["thag5.1:5"],["thag5.1:5"],["thag5.1:5"]]},{"para":423,"vripara":null,"refs":["thag5.1:5"],"lines":["<b>Yañhi</b> eke jigucchanti, mataṃ disvāna pāpakan ti yaṃ apagatāyuusmāviññāṇatāya mataṃ kaḷevaraṃ pāpakaṃ nihīnaṃ lāmakaṃ eke cokkhajātikā jigucchanti, oloketumpi na icchanti.","<b>Kāmarāgo pāturahū</b>ti tasmiṃ kuṇape ayonisomanasikārassa balavatāya kāmarāgo mayhaṃ pāturahosi uppajji.","<b>Andhova savatī ahun</b>ti tasmiṃ kaḷevare navahi dvārehi asuciṃ savati sandante asucibhāvassa adassanena andho viya ahosiṃ.","Tenāha –"],"lineRefs":[["thag5.1:5"],["thag5.1:5"],["thag5.1:5"],["thag5.1:5"]]},{"para":424,"vripara":null,"refs":["thag5.1:5"],"lines":["“Ratto atthaṃ na jānāti, ratto dhammaṃ na passati;"],"lineRefs":[["thag5.1:5"]]},{"para":425,"vripara":null,"refs":["thag5.1:5"],"lines":["Andhatamaṃ tadā hoti, yaṃ rāgo sahate naran”ti ca."],"lineRefs":[["thag5.1:5"]]},{"para":426,"vripara":null,"refs":["thag5.1:5"],"lines":["“Kāmacchando kho, brāhmaṇa, andhakaraṇo acakkhukaraṇo”ti ca ādi.","Keci panettha takārāgamaṃ katvā “kilesapariyuṭṭhānena avasavatti kilesassa vā vasavattī”ti atthaṃ vadanti.","Apare “andhova asati ahun”ti pāḷiṃ vatvā “kāmarāgena andho eva hutvā satirahito ahosin”ti atthaṃ vadanti.","Tadubhayaṃ pana pāḷiyaṃ natthi."],"lineRefs":[["thag5.1:5"],["thag5.1:5"],["thag5.1:5"],["thag5.1:5"]]},{"para":427,"vripara":null,"refs":["thag5.1:5"],"lines":["<b>Oraṃ odanapākamhā</b>ti odanapākato oraṃ, yāvatā kālena suparidhotatintataṇḍulanāḷiyā odanaṃ pacati, tato orameva kālaṃ, tatopi lahukālena rāgaṃ vinodento, <b>tamhā ṭhānā apakkamiṃ</b> yasmiṃ ṭhāne ṭhitassa me rāgo uppajji, tamhā ṭhānā apakkamiṃ apasakkiṃ.","Apakkantova <b>satimā sampajānohaṃ</b> samaṇasaññaṃ upaṭṭhapetvā satipaṭṭhānamanasikāravasena satimā, sammadeva dhammasabhāvajānanena sampajāno ca hutvā ekamantaṃ upāvisiṃ, pallaṅkaṃ ābhujitvā nisīdiṃ.","Nisinnassa ca <b>tato me manasīkāro, yoniso udapajjathā</b>tiādi sabbaṃ heṭṭhā vuttanayamevāti."],"lineRefs":[["thag5.1:5"],["thag5.1:5"],["thag5.1:5"]]},{"para":428,"vripara":null,"refs":["thag5.1:5"],"lines":["Rājadattattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[["thag5.1:5"]]},{"para":429,"vripara":null,"refs":["thag5.1:5"],"lines":["Subhūtattheragāthāvaṇṇanā"],"lineRefs":[["thag5.1:5"]]},{"para":430,"vripara":null,"refs":["thag5.1:5"],"lines":["<b>Ayoge</b>tiādikā āyasmato subhūtattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto kassapassa bhagavato kāle bārāṇasiyaṃ gahapatimahāsālakule nibbattitvā viññutaṃ patto ekadivasaṃ satthu santike dhammaṃ sutvā pasannamānaso saraṇesu ca sīlesu ca patiṭṭhāya māse māse aṭṭhakkhattuṃ catujjātiyagandhena satthu gandhakuṭiṃ opuñjāpesi.","So tena puññakammena nibbattanibbattaṭṭhāne sugandhasarīro hutvā, imasmiṃ buddhuppāde magadharaṭṭhe gahapatikule nibbattitvā <b>subhūto</b>ti laddhanāmo vayappatto, nissaraṇajjhāsayatāya gharāvāsaṃ pahāya titthiyesu pabbajitvā tattha sāraṃ alabhanto, satthu santike upatissakolitaselādike bahū samaṇabrāhmaṇe pabbajitvā sāmaññasukhaṃ anubhavante disvā sāsane paṭiladdhasaddho pabbajitvā ācariyupajjhāye ārādhetvā kammaṭṭhānaṃ gahetvā vivekavāsaṃ vasanto vipassanaṃ vaḍḍhetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.55.272-308)–"],"lineRefs":[["thag5.1:5"],["thag5.1:5"],["thag5.1:5"],["thag5.1:5"],["thag5.1:5"]]},{"para":431,"vripara":null,"refs":["thag5.1:5"],"lines":["“Imamhi bhaddake kappe, brahmabandhu mahāyaso;"],"lineRefs":[["thag5.1:5"]]},{"para":432,"vripara":null,"refs":["thag5.1:5"],"lines":["Kassapo nāma gottena, uppajji vadataṃ varo."],"lineRefs":[["thag5.1:5"]]},{"para":433,"vripara":null,"refs":["thag5.1:5"],"lines":["“Anubyañjanasampanno, bāttiṃsavaralakkhaṇo;"],"lineRefs":[["thag5.1:5"]]},{"para":434,"vripara":null,"refs":["thag5.1:5"],"lines":["Byāmappabhāparivuto, raṃsijālasamotthaṭo."],"lineRefs":[["thag5.1:5"]]},{"para":435,"vripara":null,"refs":["thag5.1:5"],"lines":["“Assāsetā yathā cando, sūriyova pabhaṅkaro;"],"lineRefs":[["thag5.1:5"]]},{"para":436,"vripara":null,"refs":["thag5.1:5"],"lines":["Nibbāpetā yathā megho, sāgarova guṇākaro."],"lineRefs":[["thag5.1:5"]]},{"para":437,"vripara":null,"refs":["thag5.1:5"],"lines":["“Dharaṇīriva sīlena, himavāva samādhinā;"],"lineRefs":[["thag5.1:5"]]},{"para":438,"vripara":null,"refs":["thag5.1:5"],"lines":["Ākāso viya paññāya, asaṅgo anilo yathā."],"lineRefs":[["thag5.1:5"]]},{"para":439,"vripara":null,"refs":["thag5.1:5"],"lines":["“Tadāhaṃ bārāṇasiyaṃ, upapanno mahākule;"],"lineRefs":[["thag5.1:5"]]},{"para":440,"vripara":null,"refs":["thag5.1:5"],"lines":["Pahūtadhanadhaññasmiṃ, nānāratanasañcaye."],"lineRefs":[["thag5.1:5"]]},{"para":441,"vripara":null,"refs":["thag5.1:5"],"lines":["“Mahatā parivārena, nisinnaṃ lokanāyakaṃ;"],"lineRefs":[["thag5.1:5"]]},{"para":442,"vripara":null,"refs":["thag5.1:5"],"lines":["Upecca dhammamassosiṃ, amataṃva manoharaṃ."],"lineRefs":[["thag5.1:5"]]},{"para":443,"vripara":null,"refs":["thag5.1:5"],"lines":["“Dvattiṃsalakkhaṇadharo, sanakkhattova candimā;"],"lineRefs":[["thag5.1:5"]]},{"para":444,"vripara":null,"refs":["thag5.1:5"],"lines":["Anubyañjanasampanno, sālarājāva phullito."],"lineRefs":[["thag5.1:5"]]},{"para":445,"vripara":null,"refs":["thag5.1:5"],"lines":["“Raṃsijālaparikkhitto, dittova kanakācalo;"],"lineRefs":[["thag5.1:5"]]},{"para":446,"vripara":null,"refs":["thag5.1:5"],"lines":["Byāmappabhāparivuto, sataraṃsī divākaro."],"lineRefs":[["thag5.1:5"]]},{"para":447,"vripara":null,"refs":["thag5.1:5"],"lines":["“Soṇṇānano jinavaro, samaṇīva siluccayo;"],"lineRefs":[["thag5.1:5"]]},{"para":448,"vripara":null,"refs":["thag5.1:5"],"lines":["Karuṇāpuṇṇahadayo, guṇena viya sāgaro."],"lineRefs":[["thag5.1:5"]]},{"para":449,"vripara":null,"refs":["thag5.1:5"],"lines":["“Lokavissutakitti ca, sinerūva naguttamo;"],"lineRefs":[["thag5.1:5"]]},{"para":450,"vripara":null,"refs":["thag5.1:5"],"lines":["Yasasā vitthato vīro, ākāsasadiso muni."],"lineRefs":[["thag5.1:5"]]},{"para":451,"vripara":null,"refs":["thag5.1:5"],"lines":["“Asaṅgacitto sabbattha, anilo viya nāyako;"],"lineRefs":[["thag5.1:5"]]},{"para":452,"vripara":null,"refs":["thag5.1:5"],"lines":["Patiṭṭhā sabbabhūtānaṃ, mahīva munisattamo."],"lineRefs":[["thag5.1:5"]]},{"para":453,"vripara":null,"refs":["thag5.1:5"],"lines":["“Anupalitto lokena, toyena padumaṃ yathā;"],"lineRefs":[["thag5.1:5"]]},{"para":454,"vripara":null,"refs":["thag5.1:5"],"lines":["Kuvādagacchadahano, aggikkhandhova sobhati."],"lineRefs":[["thag5.1:5"]]},{"para":455,"vripara":null,"refs":["thag5.1:5"],"lines":["“Agado viya sabbattha, kilesavisanāsako;"],"lineRefs":[["thag5.1:5"]]},{"para":456,"vripara":null,"refs":["thag5.1:5"],"lines":["Gandhamādanaselova, guṇagandhavibhūsito."],"lineRefs":[["thag5.1:5"]]},{"para":457,"vripara":null,"refs":["thag5.1:5"],"lines":["“Guṇānaṃ ākaro vīro, ratanānaṃva sāgaro;"],"lineRefs":[["thag5.1:5"]]},{"para":458,"vripara":null,"refs":["thag5.1:5"],"lines":["Sindhūva vanarājīnaṃ, kilesamalahārako."],"lineRefs":[["thag5.1:5"]]},{"para":459,"vripara":null,"refs":["thag5.1:5"],"lines":["“Vijayīva mahāyodho, mārasenāvamaddano;"],"lineRefs":[["thag5.1:5"]]},{"para":460,"vripara":null,"refs":["thag5.1:5"],"lines":["Cakkavattīva so rājā, bojjhaṅgaratanissaro."],"lineRefs":[["thag5.1:5"]]},{"para":461,"vripara":null,"refs":["thag5.1:5"],"lines":["“Mahābhisakkasaṅkāso, dosabyādhitikicchako;"],"lineRefs":[["thag5.1:5"]]},{"para":462,"vripara":null,"refs":["thag5.1:5"],"lines":["Sallakatto yathā vejjo, diṭṭhigaṇḍaviphālako."],"lineRefs":[["thag5.1:5"]]},{"para":463,"vripara":null,"refs":["thag5.1:5"],"lines":["“So tadā lokapajjoto, sanarāmarasakkato;"],"lineRefs":[["thag5.1:5"]]},{"para":464,"vripara":null,"refs":["thag5.1:5"],"lines":["Parisāsu narādicco, dhammaṃ desayate jino."],"lineRefs":[["thag5.1:5"]]},{"para":465,"vripara":null,"refs":["thag5.1:5"],"lines":["“Dānaṃ datvā mahābhogo, sīlena sugatūpago;"],"lineRefs":[["thag5.1:5"]]},{"para":466,"vripara":null,"refs":["thag5.1:5"],"lines":["Bhāvanāya ca nibbāti, iccevamanusāsatha."],"lineRefs":[["thag5.1:5"]]},{"para":467,"vripara":null,"refs":["thag5.1:5"],"lines":["“Desanaṃ taṃ mahassādaṃ, ādimajjhantasobhanaṃ;"],"lineRefs":[["thag5.1:5"]]},{"para":468,"vripara":null,"refs":["thag5.1:5"],"lines":["Suṇanti parisā sabbā, amataṃva mahārasaṃ."],"lineRefs":[["thag5.1:5"]]},{"para":469,"vripara":null,"refs":["thag5.1:5"],"lines":["“Sutvā sumadhuraṃ dhammaṃ, pasanno jinasāsane;"],"lineRefs":[["thag5.1:5"]]},{"para":470,"vripara":null,"refs":["thag5.1:5"],"lines":["Sugataṃ saraṇaṃ gantvā, yāvajīvaṃ namassahaṃ."],"lineRefs":[["thag5.1:5"]]},{"para":471,"vripara":null,"refs":["thag5.1:5"],"lines":["“Munino gandhakuṭiyā, opuñjesiṃ tadā mahiṃ;"],"lineRefs":[["thag5.1:5"]]},{"para":472,"vripara":null,"refs":["thag5.1:5"],"lines":["Catujjātena gandhena, māse aṭṭha dinesvahaṃ."],"lineRefs":[["thag5.1:5"]]},{"para":473,"vripara":null,"refs":["thag5.1:5"],"lines":["“Paṇidhāya sugandhattaṃ, sarīravissagandhino;"],"lineRefs":[["thag5.1:5"]]},{"para":474,"vripara":null,"refs":["thag5.1:5"],"lines":["Tadā jino viyākāsi, sugandhatanulābhitaṃ."],"lineRefs":[["thag5.1:5"]]},{"para":475,"vripara":null,"refs":["thag5.1:5"],"lines":["“Yo yaṃ gandhakuṭibhūmiṃ, gandhenopuñjate sakiṃ;"],"lineRefs":[["thag5.1:5"]]},{"para":476,"vripara":null,"refs":["thag5.1:5"],"lines":["Tena kammavipākena, upapanno tahiṃ tahiṃ."],"lineRefs":[["thag5.1:5"]]},{"para":477,"vripara":null,"refs":["thag5.1:5"],"lines":["“Sugandhadeho sabbattha, bhavissati ayaṃ naro;"],"lineRefs":[["thag5.1:5"]]},{"para":478,"vripara":null,"refs":["thag5.1:5"],"lines":["Guṇagandhayutto hutvā, nibbāyissatināsavo."],"lineRefs":[["thag5.1:5"]]},{"para":479,"vripara":null,"refs":["thag5.1:5"],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[["thag5.1:5"]]}],"wordLinks":[]},"tika":null,"tika2":null}
