{"suttaId":"an7.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[78,78],"vripara":"11"},"segments":{"an7.11:0.3":"Paṭhamaanusayasuttaṃ","an7.11:1.1":"“Sattime, bhikkhave, anusayā.","an7.11:1.2":"Katame satta?","an7.11:1.3":"Kāmarāgānusayo, paṭighānusayo, diṭṭhānusayo, vicikicchānusayo, mānānusayo, bhavarāgānusayo, avijjānusayo.","an7.11:1.4":"Ime kho, bhikkhave, satta anusayā”ti.","an7.11:1.5":"Paṭhamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
