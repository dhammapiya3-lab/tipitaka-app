{"suttaId":"an4.256","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1869,1869],"vripara":"256"},"segments":{"an4.256:0.3":"Saṅgahavatthusuttaṃ","an4.256:1.1":"“Cattārimāni, bhikkhave, saṅgahavatthūni.","an4.256:1.2":"Katamāni cattāri?","an4.256:1.3":"Dānaṃ, peyyavajjaṃ [piyavācā (ka.) a. ni.4.32 passitabbaṃ], atthacariyā, samānattatā –","an4.256:1.4":"imāni kho, bhikkhave, cattāri saṅgahavatthūnī”ti."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1711,"to":1712,"paras":[{"para":1711,"vripara":"254-256","refs":["an4.256:1"],"lines":["254-256. Chaṭṭhassa paṭhame <b>abhiññāyā</b>ti jānitvā.","<b>Samatho ca vipassanā cā</b>ti cittekaggatā ca saṅkhārapariggahavipassanāñāṇañca.","<b>Vijjā ca vimutti cā</b>ti maggañāṇavijjā ca sesā sampayuttakadhammā ca.","Dutiye <b>anariyapariyesanā</b>ti anariyānaṃ esanā gavesanā.","<b>Jarādhamman</b>ti jarāsabhāvaṃ.","Sesesupi eseva nayo.","Tatiyaṃ uttānameva."],"lineRefs":[["an4.256:1"],["an4.256:1"],["an4.256:1"],["an4.256:1"],["an4.256:1"],["an4.256:1"],["an4.256:1"]]},{"para":1712,"vripara":null,"refs":["an4.256:1"],"lines":["Mālukyaputtasuttavaṇṇanā"],"lineRefs":[["an4.256:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1916,"to":1919,"paras":[{"para":1916,"vripara":"254-256","refs":["an4.256:1"],"lines":["254-256. Chaṭṭhassa paṭhame paccanīkasamanato <b>samatho,</b> samādhīti āha <b>“cittekaggatā”</b>ti.","Aniccādinā vividhenākārena dassanato <b>vipassanā,</b> saṅkhārapariggāhakañāṇaṃ.","Tenāha <b>“saṅkhārapariggahavipassanāñāṇan”</b>ti."],"lineRefs":[["an4.256:1"],["an4.256:1"],["an4.256:1"]]},{"para":1917,"vripara":null,"refs":["an4.256:1"],"lines":["Dutiye anariyehi pariyesitabbattā anariyānaṃ pariyesanāti <b>anariyapariyesanā</b>.","Sayaṃ lāmakatāya anariyānaṃ pariyesanāti vā <b>anariyapariyesanā.</b>","<b>Jarāsabhāvan</b>ti jīraṇapakatikaṃ.","Tatiyaṃ uttānameva."],"lineRefs":[["an4.256:1"],["an4.256:1"],["an4.256:1"],["an4.256:1"]]},{"para":1918,"vripara":null,"refs":["an4.256:1"],"lines":["Abhiññāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an4.256:1"]]},{"para":1919,"vripara":null,"refs":["an4.256:1"],"lines":["4-10. Mālukyaputtasuttādivaṇṇanā"],"lineRefs":[["an4.256:1"]]}],"wordLinks":[]},"tika2":null}
