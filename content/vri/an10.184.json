{"suttaId":"an10.184","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[1413,1414],"vripara":"184"},"segments":{"an10.184:0.3":"Vajjasuttaṃ","an10.184:1.1":"“Sāvajjañca vo, bhikkhave, dhammaṃ desessāmi anavajjañca.","an10.184:1.2":"Taṃ suṇātha … pe … katamo ca, bhikkhave, sāvajjo dhammo?","an10.184:1.4":"Pāṇātipāto … pe … micchādiṭṭhi – ayaṃ vuccati, bhikkhave, sāvajjo dhammo.","an10.184:2.1":"“Katamo ca, bhikkhave, anavajjo dhammo?","an10.184:2.2":"Pāṇātipātā veramaṇī … pe … sammādiṭṭhi – ayaṃ vuccati, bhikkhave, anavajjo dhammo”ti.","an10.184:2.5":"Sattamaṃ."},"attha":null,"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":765,"to":769,"paras":[{"para":765,"vripara":"167-210","refs":["an10.184:1"],"lines":["167-210. Dutiye ca paṭhamādīni uttānatthāni.","Dasame <b>pacchābhūmivāsino</b>ti paccantadesavāsino.","<b>Sevālamālikā</b>ti pātova udakaṃ orohitvā sevālañceva uppalādīni ca gahetvā attano udakasuddhikabhāvajānanatthañceva “lokassa ca udakena suddhi hotī”ti imassa atthassa jānanatthañca mālaṃ katvā pilandhanakā.","<b>Udakorohakā</b>ti pāto majjhanhe sāyanhe ca udakaorohaṇakā.","Tenāha <b>“sāyatatiyakaṃ udakorohaṇānuyogamanuyuttā”</b>ti.","Ekādasamādīni uttānatthāni.","Catutthe paṇṇāsake natthi vattabbaṃ."],"lineRefs":[["an10.184:1"],["an10.184:1"],["an10.184:1"],["an10.184:1"],["an10.184:1"],["an10.184:1"],["an10.184:1"]]},{"para":766,"vripara":null,"refs":[],"lines":["Brāhmaṇapaccorohaṇīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":767,"vripara":null,"refs":[],"lines":["Catutthapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[[]]},{"para":768,"vripara":null,"refs":[],"lines":["(21)1. Karajakāyavaggo"],"lineRefs":[[]]},{"para":769,"vripara":null,"refs":["an10.184:1"],"lines":["1-536. Paṭhamanirayasaggasuttādivaṇṇanā"],"lineRefs":[["an10.184:1"]]}],"wordLinks":[]}}
