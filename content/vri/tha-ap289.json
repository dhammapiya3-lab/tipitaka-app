{"suttaId":"tha-ap289","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8805,8814],"vripara":"30"},"segments":{"tha-ap289:0.3":"Apadāniyattheraapadānaṃ","tha-ap289:1.1":"“Apadānaṃ sugatānaṃ, kittayiṃhaṃ mahesinaṃ;","tha-ap289:1.3":"Pāde ca sirasā vandiṃ, pasanno sehi pāṇibhi.","tha-ap289:2.1":"“Dvenavute ito kappe, apadānaṃ pakittayiṃ;","tha-ap289:2.3":"Duggatiṃ nābhijānāmi, kittanāya idaṃ phalaṃ.","tha-ap289:3.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap289:4.1":"Itthaṃ sudaṃ āyasmā apadāniyo thero imā gāthāyo abhāsitthāti.","tha-ap289:5.1":"Apadāniyattherassāpadānaṃ sattamaṃ."},"attha":null,"tika":null,"tika2":null}
