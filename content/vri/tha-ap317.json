{"suttaId":"tha-ap317","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9296,9314],"vripara":"20"},"segments":{"tha-ap317:0.3":"Pupphāsanadāyakattheraapadānaṃ","tha-ap317:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ,","tha-ap317:1.2":"pītaraṃsiṃva [sataraṃsiṃva (sī. syā.)] bhāṇumaṃ;","tha-ap317:1.3":"Avidūrena gacchantaṃ,","tha-ap317:1.4":"siddhatthaṃ aparājitaṃ. 21.","tha-ap317:2.1":"“Tassa paccuggamitvāna,","tha-ap317:2.2":"pavesetvāna assamaṃ;","tha-ap317:2.3":"Pupphāsanaṃ mayā dinnaṃ,","tha-ap317:2.4":"vippasannena cetasā. 22.","tha-ap317:3.1":"“Añjaliṃ paggahetvāna,","tha-ap317:3.2":"vedajāto tadā ahaṃ;","tha-ap317:3.3":"Buddhe cittaṃ pasādetvā,","tha-ap317:3.4":"taṃ kammaṃ pariṇāmayiṃ. 23.","tha-ap317:4.1":"“Yaṃ me atthi kataṃ puññaṃ,","tha-ap317:4.2":"sayambhumhaparājite;","tha-ap317:4.3":"Sabbena tena kusalena,","tha-ap317:4.4":"vimalo homi sāsane. 24.","tha-ap317:5.1":"“Catunnavutito kappe,","tha-ap317:5.2":"pupphāsanamadaṃ tadā;","tha-ap317:5.3":"Duggatiṃ nābhijānāmi,","tha-ap317:5.4":"pupphāsanassidaṃ phalaṃ. 25.","tha-ap317:6.1":"“Paṭisambhidā catasso…pe…","tha-ap317:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap317:7.1":"Itthaṃ sudaṃ āyasmā pupphāsanadāyako thero imā gāthāyo abhāsitthāti.","tha-ap317:8.1":"Pupphāsanadāyakattherassāpadānaṃ pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
