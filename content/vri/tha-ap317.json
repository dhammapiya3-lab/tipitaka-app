{"suttaId":"tha-ap317","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9296,9314],"vripara":"20"},"segments":{"tha-ap317:0.3":"Pupphāsanadāyakattheraapadānaṃ","tha-ap317:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ, pītaraṃsiṃva [sataraṃsiṃva (sī. syā.)] bhāṇumaṃ;","tha-ap317:1.3":"Avidūrena gacchantaṃ, siddhatthaṃ aparājitaṃ.","tha-ap317:2.1":"“Tassa paccuggamitvāna, pavesetvāna assamaṃ;","tha-ap317:2.3":"Pupphāsanaṃ mayā dinnaṃ, vippasannena cetasā.","tha-ap317:3.1":"“Añjaliṃ paggahetvāna, vedajāto tadā ahaṃ;","tha-ap317:3.3":"Buddhe cittaṃ pasādetvā, taṃ kammaṃ pariṇāmayiṃ.","tha-ap317:4.1":"“Yaṃ me atthi kataṃ puññaṃ, sayambhumhaparājite;","tha-ap317:4.3":"Sabbena tena kusalena, vimalo homi sāsane.","tha-ap317:5.1":"“Catunnavutito kappe, pupphāsanamadaṃ tadā;","tha-ap317:5.3":"Duggatiṃ nābhijānāmi, pupphāsanassidaṃ phalaṃ.","tha-ap317:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap317:7.1":"Itthaṃ sudaṃ āyasmā pupphāsanadāyako thero imā gāthāyo abhāsitthāti.","tha-ap317:8.1":"Pupphāsanadāyakattherassāpadānaṃ pañcamaṃ."},"attha":null,"tika":null}
