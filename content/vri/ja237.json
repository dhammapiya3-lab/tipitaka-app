{"suttaId":"ja237","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1614,1620],"vripara":"173"},"segments":{"ja237:0.4":"Sāketajātakaṃ (2-9-7)","ja237:1.1":"Ko nu kho bhagavā hetu, ekacce idha puggale;","ja237:1.3":"Atīva hadayaṃ nibbāti, cittañcāpi pasīdati.","ja237:2.1":"Pubbeva sannivāsena, paccuppannahitena vā;","ja237:2.3":"Evaṃ taṃ jāyate pemaṃ, uppalaṃva yathodaketi.","ja237:3.1":"Sāketajātakaṃ sattamaṃ."},"attha":null,"tika":null}
