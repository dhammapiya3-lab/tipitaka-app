{"suttaId":"an4.112","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1045,1046],"vripara":"112"},"segments":{"an4.112:0.3":"Javasuttaṃ","an4.112:1.1":"“Catūhi, bhikkhave, aṅgehi samannāgato rañño bhadro assājānīyo rājāraho hoti rājabhoggo, rañño aṅganteva saṅkhaṃ gacchati.","an4.112:1.2":"Katamehi catūhi?","an4.112:1.3":"Ajjavena, javena, khantiyā, soraccena – imehi kho, bhikkhave, catūhi aṅgehi samannāgato rañño bhadro assājānīyo rājāraho hoti, rājabhoggo, rañño aṅganteva saṅkhaṃ gacchati.","an4.112:2.1":"“Evamevaṃ kho, bhikkhave, catūhi dhammehi samannāgato bhikkhu āhuneyyo hoti … pe … anuttaraṃ puññakkhettaṃ lokassa.","an4.112:2.2":"Katamehi catūhi?","an4.112:2.3":"Ajjavena, javena, khantiyā, soraccena – imehi kho, bhikkhave, catūhi dhammehi samannāgato bhikkhu āhuneyyo hoti … pe … anuttaraṃ puññakkhettaṃ lokassā”ti.","an4.112:2.5":"Dutiyaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1389,"to":1389,"paras":[{"para":1389,"vripara":"112","refs":["an4.112:1"],"lines":["Dutiye <b>ajjavenā</b>ti ujukabhāvena.","<b>Javenā</b>ti padavegena.","<b>Khantiyā</b>ti adhivāsanakkhantiyā.","<b>Soraccenā</b>ti sucibhāvasīlena.","Puggalaguṇaṅgesu <b>javenā</b>ti ñāṇajavena.","Sesamettha uttānatthameva."],"lineRefs":[["an4.112:1"],["an4.112:1"],["an4.112:1"],["an4.112:1"],["an4.112:1"],["an4.112:1"]]}],"wordLinks":[["an4.112:1.3","ajjavenā",0,0],["an4.112:1.3","javenā",0,1],["an4.112:1.3","khantiyā",0,2],["an4.112:1.3","soraccenā",0,3],["an4.112:1.3","javenā",0,4]]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1578,"to":1580,"paras":[{"para":1578,"vripara":"111-117","refs":["an4.112:1"],"lines":["111-117. Dutiyassa paṭhame <b>assadamme</b>ti dammanayogge asse.","<b>Sāretī</b>ti sikkhāpeti pavatteti.","Sesamettha uttānameva.","Dutiyādīni uttānatthāneva."],"lineRefs":[["an4.112:1"],["an4.112:1"],["an4.112:1"],["an4.112:1"]]},{"para":1579,"vripara":null,"refs":[],"lines":["Kesisuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1580,"vripara":null,"refs":["an4.112:1"],"lines":["8-10. Saṃvejanīyasuttādivaṇṇanā"],"lineRefs":[["an4.112:1"]]}],"wordLinks":[]}}
