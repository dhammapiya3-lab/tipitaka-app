{"suttaId":"tha-ap456","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1147,1161],"vripara":"22"},"segments":{"tha-ap456:0.3":"Tiṇukkadhāriyattheraapadānaṃ","tha-ap456:1.1":"“Padumuttarabuddhassa,","tha-ap456:1.2":"bodhiyā pādaputtame;","tha-ap456:1.3":"Pasannacitto sumano,","tha-ap456:1.4":"tayo ukke adhārayiṃ. 23.","tha-ap456:2.1":"“Satasahassito kappe,","tha-ap456:2.2":"sohaṃ ukkamadhārayiṃ;","tha-ap456:2.3":"Duggatiṃ nābhijānāmi,","tha-ap456:2.4":"ukkadānassidaṃ phalaṃ. 24.","tha-ap456:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap456:3.3":"viharāmi anāsavo. 25.","tha-ap456:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap456:4.3":"kataṃ buddhassa sāsanaṃ. 26.","tha-ap456:5.1":"“Paṭisambhidā catasso…pe…","tha-ap456:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap456:6.1":"Itthaṃ sudaṃ āyasmā tiṇukkadhāriyo thero imā gāthāyo Abhāsitthāti.","tha-ap456:7.1":"Tiṇukkadhāriyattherassāpadānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
