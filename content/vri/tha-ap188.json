{"suttaId":"tha-ap188","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7108,7120],"vripara":"30"},"segments":{"tha-ap188:0.3":"Bodhiupaṭṭhākattheraapadānaṃ","tha-ap188:1.1":"“Nagare rammavatiyā,","tha-ap188:1.2":"āsiṃ murajavādako;","tha-ap188:1.3":"Niccupaṭṭhānayuttomhi,","tha-ap188:1.4":"gatohaṃ bodhimuttamaṃ. 31.","tha-ap188:2.1":"“Sāyaṃ pātaṃ upaṭṭhitvā,","tha-ap188:2.2":"sukkamūlena codito;","tha-ap188:2.3":"Aṭṭhārasakappasate,","tha-ap188:2.4":"duggatiṃ nupapajjahaṃ. 32.","tha-ap188:3.1":"“Pannarase kappasate,","tha-ap188:3.2":"ito āsiṃ janādhipo;","tha-ap188:3.3":"Murajo [damatho (syā.)] nāma nāmena,","tha-ap188:3.4":"cakkavattī mahabbalo. 33.","tha-ap188:4.1":"“Paṭisambhidā catasso…pe…","tha-ap188:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap188:5.1":"Itthaṃ sudaṃ āyasmā bodhiupaṭṭhāko thero imā gāthāyo abhāsitthāti.","tha-ap188:6.1":"Bodhiupaṭṭhākattherassāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
