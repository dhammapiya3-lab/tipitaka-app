{"suttaId":"tha-ap325","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9470,9481],"vripara":"13"},"segments":{"tha-ap325:0.3":"Hāsajanakattheraapadānaṃ","tha-ap325:1.1":"“Dumagge paṃsukūlakaṃ [paṃsukūlikaṃ (syā. ka.)],","tha-ap325:1.2":"laggaṃ disvāna satthuno;","tha-ap325:1.3":"Añjaliṃ paggahetvāna,","tha-ap325:1.4":"bhiyyo uccāritaṃ mayā. 14.","tha-ap325:2.1":"“Dūrato pana disvāna [patidisvāna (sī. syā.)],","tha-ap325:2.2":"hāso me udapajjatha;","tha-ap325:2.3":"Añjaliṃ paggahetvāna,","tha-ap325:2.4":"bhiyyo cittaṃ pasādayiṃ. 15.","tha-ap325:3.1":"“Ekanavutito kappe,","tha-ap325:3.2":"yaṃ saññamalabhiṃ tadā;","tha-ap325:3.3":"Duggatiṃ nābhijānāmi,","tha-ap325:3.4":"buddhasaññāyidaṃ phalaṃ. 16.","tha-ap325:4.1":"“Paṭisambhidā catasso…pe…","tha-ap325:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap325:5.1":"Itthaṃ sudaṃ āyasmā hāsajanako thero imā gāthāyo abhāsitthāti.","tha-ap325:6.1":"Hāsajanakattherassāpadānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
