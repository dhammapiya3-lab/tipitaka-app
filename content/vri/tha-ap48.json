{"suttaId":"tha-ap48","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[3743,3758],"vripara":"83"},"segments":{"tha-ap48:0.3":"Padumacchadaniyattheraapadānaṃ","tha-ap48:1.1":"“Nibbute lokanāthamhi, vipassimhaggapuggale;","tha-ap48:1.3":"Suphullapadumaṃ gayha, citamāropayiṃ ahaṃ.","tha-ap48:2.1":"“Āropite ca citake, vehāsaṃ nabhamuggami;","tha-ap48:2.3":"Ākāse chadanaṃ [ākāsacchadanaṃ (sī.)] katvā, citakamhi adhārayi.","tha-ap48:3.1":"“Ekanavutito kappe, yaṃ pupphamabhiropayiṃ;","tha-ap48:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap48:4.1":"“Sattatālīsito kappe, padumissaranāmako;","tha-ap48:4.3":"Cāturanto vijitāvī, cakkavattī mahabbalo.","tha-ap48:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap48:6.1":"Itthaṃ sudaṃ āyasmā padumacchadaniyo thero imā gāthāyo abhāsitthāti;","tha-ap48:7.1":"Padumacchadaniyattherassāpadānaṃ chaṭṭhaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2517,"to":2517,"paras":[{"para":2517,"vripara":"83","refs":["tha-ap48:1"],"words":["nibbute lokanāthamhī","nibbute","āropayiṃ"],"lines":["Attano pubbakammaṃ saritvā somanassavasena pubbacaritāpadānaṃ pakāsento <b>nibbute lokanāthamhī</b>tiādimāha.","Tattha <b>nibbute</b>ti khandhaparinibbānena parinibbute satthari, vipassissa sammāsambuddhassa sarīre citamāniyamāne citake āropite suphullaṃ padumakalāpaṃ ahaṃ gahetvā citakaṃ <b>āropayiṃ</b> pūjesinti attho.","Sesagāthāsu heṭṭhā vuttanayattā uttānatthamevāti."],"lineRefs":[["tha-ap48:1"],["tha-ap48:1"],["tha-ap48:1"]]}]},"tika":null}
