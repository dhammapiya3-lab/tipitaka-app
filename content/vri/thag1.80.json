{"suttaId":"thag1.80","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[462,471],"vripara":"80"},"segments":{"thag1.80:0.4":"Uggattheragāthā","thag1.80:1.1":"“Yaṃ mayā pakataṃ kammaṃ,","thag1.80:1.2":"appaṃ vā yadi vā bahuṃ;","thag1.80:1.3":"Sabbametaṃ parikkhīṇaṃ,","thag1.80:1.4":"natthi dāni punabbhavo”ti.","thag1.80:1.5":"… Uggo thero ….","thag1.80:1.6":"Vaggo aṭṭhamo niṭṭhito.","thag1.80:2.0":"Tassuddānaṃ –","thag1.80:2.1":"Vacchapālo ca yo thero,","thag1.80:2.2":"ātumo māṇavo isi;","thag1.80:2.3":"Suyāmano susārado,","thag1.80:2.4":"thero yo ca piyañjaho;","thag1.80:2.5":"Ārohaputto meṇḍasiro,","thag1.80:2.6":"rakkhito uggasavhayoti."},"unsure":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2088,"to":2088,"paras":[{"para":2088,"vripara":null,"refs":["thag1.80:1"],"lines":["Tattha <b>yaṃ mayā pakataṃ kamman</b>ti yaṃ kammaṃ tīhi kammadvārehi, chahi uppattidvārehi, aṭṭhahi asaṃvaradvārehi, aṭṭhahi ca saṃvaradvārehi pāpādivasena dānādivasena cāti anekehi pakārehi anādimati saṃsāre yaṃ mayā kataṃ upacitaṃ abhinibbattitaṃ vipākakammaṃ.","<b>Appaṃ vā yadi vā bahun</b>ti tañca vatthucetanāpayogakilesādīnaṃ dubbalabhāvena appaṃ vā, tesaṃ balavabhāvena abhiṇhapavattiyā ca bahuṃ vā.","<b>Sabbametaṃ parikkhīṇan</b>ti sabbameva cetaṃ kammaṃ kammakkhayakarassa aggamaggassa adhigatattā parikkhayaṃ gataṃ, kilesavaṭṭappahānena hi kammavaṭṭaṃ pahīnameva hoti vipākavaṭṭassa anuppādanato.","Tenāha <b>“natthi dāni punabbhavo”</b>ti.","Āyatiṃ punabbhavābhinibbatti mayhaṃ natthīti attho.","“Sabbampetan” tipi pāṭho, sabbampi etanti padavibhāgo."],"lineRefs":[["thag1.80:1"],["thag1.80:1"],["thag1.80:1"],["thag1.80:1"],["thag1.80:1"],["thag1.80:1"]]}],"wordLinks":[["thag1.80:1.1","yaṃ mayā pakataṃ kammaṃ",0,0],["thag1.80:1.1","appaṃ vā yadi vā bahuṃ",0,1],["thag1.80:1.3","sabbametaṃ parikkhīṇaṃ",0,2],["thag1.80:1.3","natthi dāni punabbhavo",0,3]],"before":[{"para":2068,"vripara":null,"refs":[],"lines":["Rakkhitattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2069,"vripara":null,"refs":[],"lines":["Uggattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":2070,"vripara":null,"refs":[],"lines":["<b>Yaṃ mayā pakataṃ kamman</b>ti āyasmato uggattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni karonto ito ekatiṃse kappe sikhissa bhagavato kāle kulagehe nibbattitvā viññutaṃ patto ekadivasaṃ sikhiṃ bhagavantaṃ passitvā pasannamānaso ketakapupphehi pūjaṃ akāsi.","So tena puññakammena devaloke nibbattitvā aparāparaṃ sugatīsuyeva saṃsaranto imasmiṃ buddhuppāde kosalaraṭṭhe ugganigame seṭṭhiputto hutvā nibbatti, <b>uggo</b> tvevassa nāmaṃ ahosi.","So viññutaṃ patto bhagavati tasmiṃ nigame bhaddārāme viharante vihāraṃ gantvā satthu santike dhammaṃ sutvā paṭiladdhasaddho pabbajitvā vipassanāya kammaṃ karonto nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.14.10-16)–"],"lineRefs":[[],[],[],[],[],[]]},{"para":2071,"vripara":null,"refs":[],"lines":["“Vinatānadiyā tīre, pilakkhu phalito ahu;"],"lineRefs":[[]]},{"para":2072,"vripara":null,"refs":[],"lines":["Tāhaṃ rukkhaṃ gavesanto, addasaṃ lokanāyakaṃ."],"lineRefs":[[]]},{"para":2073,"vripara":null,"refs":[],"lines":["“Ketakaṃ pupphitaṃ disvā, vaṇṭe chetvānahaṃ tadā;"],"lineRefs":[[]]},{"para":2074,"vripara":null,"refs":[],"lines":["Buddhassa abhiropesiṃ, sikhino lokabandhuno."],"lineRefs":[[]]},{"para":2075,"vripara":null,"refs":[],"lines":["“Yena ñāṇena pattosi, accutaṃ amataṃ padaṃ;"],"lineRefs":[[]]},{"para":2076,"vripara":null,"refs":[],"lines":["Taṃ ñāṇaṃ abhipūjemi, buddhaseṭṭha mahāmuni."],"lineRefs":[[]]},{"para":2077,"vripara":null,"refs":[],"lines":["“Ñāṇamhi pūjaṃ katvāna, pilakkhumaddasaṃ ahaṃ;"],"lineRefs":[[]]},{"para":2078,"vripara":null,"refs":[],"lines":["Paṭiladdhomhi taṃ paññaṃ, ñāṇapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":2079,"vripara":null,"refs":[],"lines":["“Ekatiṃse ito kappe, yaṃ pupphamabhiropayiṃ;"],"lineRefs":[[]]},{"para":2080,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, ñāṇapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":2081,"vripara":null,"refs":[],"lines":["“Ito terasakappamhi, dvādasāsuṃ phaluggatā;"],"lineRefs":[[]]},{"para":2082,"vripara":null,"refs":[],"lines":["Sattaratanasampannā, cakkavattī mahabbalā."],"lineRefs":[[]]},{"para":2083,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":2084,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā attano vaṭṭūpacchedadīpanena aññaṃ byākaronto –"],"lineRefs":[[]]},{"para":2086,"vripara":"80","refs":[],"lines":["“Yaṃ mayā pakataṃ kammaṃ, appaṃ vā yadi vā bahuṃ;"],"lineRefs":[[]]},{"para":2087,"vripara":null,"refs":[],"lines":["Sabbametaṃ parikkhīṇaṃ, natthi dāni punabbhavo”ti.","– gāthaṃ abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
