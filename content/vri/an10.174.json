{"suttaId":"an10.174","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[1317,1326],"vripara":"174"},"segments":{"an10.174:0.3":"Kammanidānasuttaṃ","an10.174:1.1":"“Pāṇātipātampāhaṃ, bhikkhave, tividhaṃ vadāmi –","an10.174:1.2":"lobhahetukampi, dosahetukampi, mohahetukampi.","an10.174:2.1":"“Adinnādānampāhaṃ, bhikkhave, tividhaṃ vadāmi –","an10.174:2.2":"lobhahetukampi, dosahetukampi, mohahetukampi.","an10.174:3.1":"“Kāmesumicchācārampāhaṃ, bhikkhave, tividhaṃ vadāmi –","an10.174:3.2":"lobhahetukampi, dosahetukampi, mohahetukampi.","an10.174:4.1":"“Musāvādampāhaṃ, bhikkhave, tividhaṃ vadāmi –","an10.174:4.2":"lobhahetukampi, dosahetukampi, mohahetukampi.","an10.174:5.1":"“Pisuṇavācampāhaṃ, bhikkhave, tividhaṃ vadāmi –","an10.174:5.2":"lobhahetukampi, dosahetukampi, mohahetukampi.","an10.174:6.1":"“Pharusavācampāhaṃ, bhikkhave, tividhaṃ vadāmi –","an10.174:6.2":"lobhahetukampi, dosahetukampi, mohahetukampi.","an10.174:7.1":"“Samphappalāpampāhaṃ, bhikkhave, tividhaṃ vadāmi –","an10.174:7.2":"lobhahetukampi, dosahetukampi, mohahetukampi.","an10.174:8.1":"“Abhijjhampāhaṃ, bhikkhave, tividhaṃ vadāmi –","an10.174:8.2":"lobhahetukampi, dosahetukampi, mohahetukampi.","an10.174:9.1":"“Byāpādampāhaṃ, bhikkhave, tividhaṃ vadāmi –","an10.174:9.2":"lobhahetukampi, dosahetukampi, mohahetukampi.","an10.174:10.1":"“Micchādiṭṭhimpāhaṃ, bhikkhave, tividhaṃ vadāmi –","an10.174:10.2":"lobhahetukampi, dosahetukampi, mohahetukampi.","an10.174:10.3":"Iti kho, bhikkhave, lobho kammanidānasambhavo, doso kammanidānasambhavo, moho kammanidānasambhavo.","an10.174:10.4":"Lobhakkhayā kammanidānasaṅkhayo, dosakkhayā kammanidānasaṅkhayo, mohakkhayā kammanidānasaṅkhayo”ti.","an10.174:10.5":"Aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Mp-x","bookName":"Dasakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":680,"to":680,"paras":[{"para":680,"vripara":"174","refs":["an10.174:1"],"lines":["Aṭṭhame <b>lobhahetukampī</b>ti pāṇātipātassa lobho upanissayakoṭiyā hetu hoti dosamohasampayuttopi.","Iminā upāyena sabbattha attho veditabbo. 9."],"lineRefs":[["an10.174:1"],["an10.174:1"]]}],"wordLinks":[["an10.174:1.1","lobhahetukampī",0,0]]},"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":765,"to":769,"paras":[{"para":765,"vripara":"167-210","refs":["an10.174:1"],"lines":["Dutiye ca paṭhamādīni uttānatthāni.","Dasame <b>pacchābhūmivāsino</b>ti paccantadesavāsino.","<b>Sevālamālikā</b>ti pātova udakaṃ orohitvā sevālañceva uppalādīni ca gahetvā attano udakasuddhikabhāvajānanatthañceva “lokassa ca udakena suddhi hotī”ti imassa atthassa jānanatthañca mālaṃ katvā pilandhanakā.","<b>Udakorohakā</b>ti pāto majjhanhe sāyanhe ca udakaorohaṇakā.","Tenāha <b>“sāyatatiyakaṃ udakorohaṇānuyogamanuyuttā”</b>ti.","Ekādasamādīni uttānatthāni.","Catutthe paṇṇāsake natthi vattabbaṃ."],"lineRefs":[["an10.174:1"],["an10.174:1"],["an10.174:1"],["an10.174:1"],["an10.174:1"],["an10.174:1"],["an10.174:1"]]},{"para":766,"vripara":null,"refs":["an10.174:1"],"lines":["Brāhmaṇapaccorohaṇīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an10.174:1"]]},{"para":767,"vripara":null,"refs":["an10.174:1"],"lines":["Catutthapaṇṇāsakaṃ niṭṭhitaṃ. (21) 1."],"lineRefs":[["an10.174:1"]]},{"para":768,"vripara":null,"refs":["an10.174:1"],"lines":["Karajakāyavaggo 1-536."],"lineRefs":[["an10.174:1"]]},{"para":769,"vripara":null,"refs":["an10.174:1"],"lines":["Paṭhamanirayasaggasuttādivaṇṇanā 211-746."],"lineRefs":[["an10.174:1"]]}],"wordLinks":[]},"tika2":null}
