{"suttaId":"thig5.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[399,414],"vripara":"97"},"segments":{"thig5.7:0.3":"Sakulātherīgāthā","thig5.7:1.1":"“Agārasmiṃ vasantīhaṃ,","thig5.7:1.2":"dhammaṃ sutvāna bhikkhuno;","thig5.7:1.3":"Addasaṃ virajaṃ dhammaṃ,","thig5.7:1.4":"nibbānaṃ padamaccutaṃ. 98.","thig5.7:2.1":"“Sāhaṃ puttaṃ dhītarañca,","thig5.7:2.2":"dhanadhaññañca chaḍḍiya;","thig5.7:2.3":"Kese chedāpayitvāna,","thig5.7:2.4":"pabbajiṃ anagāriyaṃ. 99.","thig5.7:3.1":"“Sikkhamānā ahaṃ santī,","thig5.7:3.2":"bhāventī maggamañjasaṃ;","thig5.7:3.3":"Pahāsiṃ rāgadosañca,","thig5.7:3.4":"tadekaṭṭhe ca āsave. 100.","thig5.7:4.1":"“Bhikkhunī upasampajja,","thig5.7:4.2":"pubbajātimanussariṃ;","thig5.7:4.3":"Dibbacakkhu visodhitaṃ [visodhitaṃ dibbacakkhu (sī.)],","thig5.7:4.4":"vimalaṃ sādhubhāvitaṃ. 101.","thig5.7:5.1":"“Saṅkhāre parato disvā,","thig5.7:5.2":"hetujāte palokite [palokine (ka.)];","thig5.7:5.3":"Pahāsiṃ āsave sabbe,","thig5.7:5.4":"sītibhūtāmhi nibbutā”ti. …","thig5.7:6.1":"Sakulā therī…. 8."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1443,"to":1445,"paras":[{"para":1443,"vripara":null,"refs":["thig5.7:5"],"lines":["<b>Sikkhamānā ahaṃ santī</b>ti ahaṃ sikkhamānāva samānā pabbajitvā vasse aparipuṇṇe eva.","<b>Bhāventī maggamañjasa</b>nti majjhimapaṭipattibhāvato añjasaṃ uparimaggaṃ uppādentī.","<b>Tadekaṭṭhe ca āsave</b>ti rāgadosehi sahajekaṭṭhe pahānekaṭṭhe ca tatiyamaggavajjhe āsave <b>pahāsiṃ</b> samucchindiṃ."],"lineRefs":[["thig5.7:5"],["thig5.7:5"],["thig5.7:5"]]},{"para":1444,"vripara":null,"refs":["thig5.7:5"],"lines":["<b>Bhikkhunī</b> <b>upasampajjā</b>ti vasse paripuṇṇe upasampajjitvā bhikkhunī hutvā.","<b>Vimala</b>nti avijjādīhi upakkilesehi vimuttatāya vigatamalaṃ, <b>sādhu</b> sakkacca sammadeva <b>bhāvitaṃ,</b> sādhūhi vā buddhādīhi <b>bhāvitaṃ</b> uppāditaṃ dibbacakkhu visodhitanti sambandho."],"lineRefs":[["thig5.7:5"],["thig5.7:5"]]},{"para":1445,"vripara":null,"refs":["thig5.7:5"],"lines":["<b>Saṅkhāre</b>ti tebhūmakasaṅkhāre.","<b>Parato</b>ti anattato.","<b>Hetujāte</b>ti paccayuppanne.","<b>Palokite</b>ti palujjanasabhāve pabhaṅgune paññācakkhunā disvā.","<b>Pahāsiṃ āsave sabbe</b>ti aggamaggena avasiṭṭhe sabbepi āsave pajahiṃ, khepesinti attho.","Sesaṃ vuttanayameva."],"lineRefs":[["thig5.7:5"],["thig5.7:5"],["thig5.7:5"],["thig5.7:5"],["thig5.7:5"],["thig5.7:5"]]}],"wordLinks":[["thig5.7:5.3","pahāsiṃ",0,2],["thig5.7:5.1","saṅkhāre",2,0],["thig5.7:5.1","parato",2,1],["thig5.7:5.1","hetujāte",2,2],["thig5.7:5.1","palokite",2,3],["thig5.7:5.3","pahāsiṃ āsave sabbe",2,4]],"before":[{"para":1357,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Sakulātherīgāthāvaṇṇanā"]},{"para":1358,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["<b>Agārasmiṃ</b> <b>vasantī</b>tiādikā sakulāya theriyā gāthā.","Ayaṃ kira padumuttarassa bhagavato kāle haṃsavatīnagare ānandassa rañño dhītā hutvā nibbattā, satthu vemātikabhaginī <b>nandā</b>ti nāmena.","Sā viññutaṃ patvā ekadivasaṃ satthu santike dhammaṃ suṇantī satthārā ekaṃ bhikkhuniṃ dibbacakkhukānaṃ aggaṭṭhāne ṭhapentaṃ disvā ussāhajātā adhikārakammaṃ katvā sayampi taṃ ṭhānantaraṃ patthentī paṇidhānamakāsi.","Sā tattha yāvajīvaṃ bahuṃ uḷāraṃ kusalakammaṃ katvā devaloke nibbattitvā aparāparaṃ sugatīsuyeva saṃsarantī kassapassa bhagavato kāle brāhmaṇakule nibbattitvā paribbājakapabbajjaṃ pabbajitvā ekacārinī vicarantī ekadivasaṃ telabhikkhāya āhiṇḍitvā telaṃ labhitvā tena telena satthu cetiye sabbarattiṃ dīpapūjaṃ akāsi.","Sā tato cutā tāvatiṃse nibbattitvā suvisuddhadibbacakkhukā hutvā ekaṃ buddhantaraṃ devesuyeva saṃsaritvā imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇakule nibbatti.","<b>Sakulā</b>tissā nāmaṃ ahosi.","Sā viññutaṃ pattā satthu jetavanapaṭiggahaṇe paṭiladdhasaddhā upāsikā hutvā aparabhāge aññatarassa khīṇāsavattherassa santike dhammaṃ sutvā sañjātasaṃvegā pabbajitvā vipassanaṃ paṭṭhapetvā ghaṭentī vāyamantī na cirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.3.131-165) –"]},{"para":1359,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Padumuttaro nāma jino, sabbadhammāna pāragū;"]},{"para":1360,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Ito satasahassamhi, kappe uppajji nāyako."]},{"para":1361,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Hitāya sabbasattānaṃ, sukhāya vadataṃ varo;"]},{"para":1362,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Atthāya purisājañño, paṭipanno sadevake."]},{"para":1363,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Yasaggapatto sirimā, kittivaṇṇagato jino;"]},{"para":1364,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Pūjito sabbalokassa, disā sabbāsu vissuto."]},{"para":1365,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Uttiṇṇavicikiccho so, vītivattakathaṃkatho;"]},{"para":1366,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Sampuṇṇamanasaṅkappo, patto sambodhimuttamaṃ."]},{"para":1367,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Anuppannassa maggassa, uppādetā naruttamo;"]},{"para":1368,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Anakkhātañca akkhāsi, asañjātañca sañjanī."]},{"para":1369,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Maggaññū ca maggavidū, maggakkhāyī narāsabho;"]},{"para":1370,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Maggassa kusalo satthā, sārathīnaṃ varuttamo."]},{"para":1371,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Mahākāruṇiko satthā, dhammaṃ deseti nāyako;"]},{"para":1372,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Nimugge kāmapaṅkamhi, samuddharati pāṇine."]},{"para":1373,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Tadāhaṃ haṃsavatiyaṃ, jātā khattiyanandanā;"]},{"para":1374,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Surūpā sadhanā cāpi, dayitā ca sirīmatī."]},{"para":1375,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Ānandassa mahārañño, dhītā paramasobhanā;"]},{"para":1376,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Vemātā bhaginī cāpi, padumuttaranāmino."]},{"para":1377,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Rājakaññāhi sahitā, sabbābharaṇabhūsitā;"]},{"para":1378,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Upāgamma mahāvīraṃ, assosiṃ dhammadesanaṃ."]},{"para":1379,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Tadā hi so lokagaru, bhikkhuniṃ dibbacakkhukaṃ;"]},{"para":1380,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Kittayaṃ parisāmajjhe, aggaṭṭhāne ṭhapesi taṃ."]},{"para":1381,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Suṇitvā tamahaṃ haṭṭhā, dānaṃ datvāna satthuno;"]},{"para":1382,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Pūjitvāna ca sambuddhaṃ, dibbacakkhuṃ apatthayiṃ."]},{"para":1383,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Tato avoca maṃ satthā, nande lacchasi patthitaṃ;"]},{"para":1384,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Padīpadhammadānānaṃ, phalametaṃ sunicchitaṃ."]},{"para":1385,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Satasahassito kappe, okkākakulasambhavo;"]},{"para":1386,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Gotamo nāma gottena, satthā loke bhavissati."]},{"para":1387,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Tassa dhammesu dāyādā, orasā dhammanimmitā;"]},{"para":1388,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Sakulā nāma nāmena, hessati satthu sāvikā."]},{"para":1389,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"]},{"para":1390,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."]},{"para":1391,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Imamhi bhaddake kappe, brahmabandhu mahāyaso;"]},{"para":1392,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Kassapo nāma gottena, uppajji vadataṃ varo."]},{"para":1393,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Paribbājakinī āsiṃ, tadāhaṃ ekacārinī;"]},{"para":1394,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Bhikkhāya vicaritvāna, alabhiṃ telamattakaṃ."]},{"para":1395,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Tena dīpaṃ padīpetvā, upaṭṭhiṃ sabbasaṃvariṃ;"]},{"para":1396,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Cetiyaṃ dvipadaggassa, vippasannena cetasā."]},{"para":1397,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"]},{"para":1398,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."]},{"para":1399,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Yattha yatthūpapajjāmi, tassa kammassa vāhasā;"]},{"para":1400,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Pajjalanti mahādīpā, tattha tattha gatāya me."]},{"para":1401,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Tirokuṭṭaṃ tiroselaṃ, samatiggayha pabbataṃ;"]},{"para":1402,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Passāmahaṃ yadicchāmi, dīpadānassidaṃ phalaṃ."]},{"para":1403,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Visuddhanayanā homi, yasasā ca jalāmahaṃ;"]},{"para":1404,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Saddhāpaññāvatī ceva, dīpadānassidaṃ phalaṃ."]},{"para":1405,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Pacchime ca bhave dāni, jātā vippakule ahaṃ;"]},{"para":1406,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Pahūtadhanadhaññamhi, mudite rājapūjite."]},{"para":1407,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Ahaṃ sabbaṅgasampannā, sabbābharaṇabhūsitā;"]},{"para":1408,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Purappavese sugataṃ, vātapāne ṭhitā ahaṃ."]},{"para":1409,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Disvā jalantaṃ yasasā, devamanussasakkataṃ;"]},{"para":1410,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Anubyañjanasampannaṃ, lakkhaṇehi vibhūsitaṃ."]},{"para":1411,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Udaggacittā sumanā, pabbajjaṃ samarocayiṃ;"]},{"para":1412,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Na cireneva kālena, arahattamapāpuṇiṃ."]},{"para":1413,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Iddhīsu ca vasī homi, dibbāya sotadhātuyā;"]},{"para":1414,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Paracittāni jānāmi, satthusāsanakārikā."]},{"para":1415,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"]},{"para":1416,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Khepetvā āsave sabbe, visuddhāsiṃ sunimmalā."]},{"para":1417,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Pariciṇṇo mayā satthā, kataṃ buddhassa sāsanaṃ;"]},{"para":1418,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Ohito garuko bhāro, bhavanettisamūhatā."]},{"para":1419,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Yassatthāya pabbajitā, agārasmānagāriyaṃ;"]},{"para":1420,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["So me attho anuppatto, sabbasaṃyojanakkhayo."]},{"para":1421,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Tato mahākāruṇiko, etadagge ṭhapesi maṃ;"]},{"para":1422,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Dibbacakkhukānaṃ aggā, sakulāti naruttamo."]},{"para":1423,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti."]},{"para":1424,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Arahattaṃ pana patvā katādhikāratāya dibbacakkhuñāṇe ciṇṇavasī ahosi.","Tena naṃ satthā dibbacakkhukānaṃ bhikkhunīnaṃ aggaṭṭhāne ṭhapesi.","Sā attano paṭipattiṃ paccavekkhitvā pītisomanassajātā udānavasena – 97."]},{"para":1426,"vripara":"97","title":"Sakulātherīgāthāvaṇṇanā","lines":["“Agārasmiṃ vasantīhaṃ, dhammaṃ sutvāna bhikkhuno;"]},{"para":1427,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Addasaṃ virajaṃ dhammaṃ, nibbānaṃ padamaccutaṃ. 98."]},{"para":1429,"vripara":"98","title":"Sakulātherīgāthāvaṇṇanā","lines":["“Sāhaṃ puttaṃ dhītarañca, dhanadhaññañca chaḍḍiya;"]},{"para":1430,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Kese chedāpayitvāna, pabbajiṃ anagāriyaṃ. 99."]},{"para":1432,"vripara":"99","title":"Sakulātherīgāthāvaṇṇanā","lines":["“Sikkhamānā ahaṃ santī, bhāventī maggamañjasaṃ;"]},{"para":1433,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Pahāsiṃ rāgadosañca, tadekaṭṭhe ca āsave. 100."]},{"para":1435,"vripara":"100","title":"Sakulātherīgāthāvaṇṇanā","lines":["“Bhikkhunī upasampajja, pubbajātimanussariṃ;"]},{"para":1436,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Dibbacakkhu visodhitaṃ, vimalaṃ sādhubhāvitaṃ. 101."]},{"para":1438,"vripara":"101","title":"Sakulātherīgāthāvaṇṇanā","lines":["“Saṅkhāre parato disvā, hetujāte palokite;"]},{"para":1439,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Pahāsiṃ āsave sabbe, sītibhūtāmhi nibbutā”ti. –"]},{"para":1440,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Imā gāthā abhāsi."]},{"para":1441,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Tattha <b>agārasmiṃ vasantīhaṃ, dhammaṃ sutvāna bhikkhuno</b>ti ahaṃ pubbe agāramajjhe vasamānā aññatarassa bhinnakilesassa bhikkhuno santike catusaccagabbhaṃ dhammakathaṃ sutvā.","<b>Addasaṃ virajaṃ dhammaṃ, nibbānaṃ padamaccuta</b>nti rāgarajādīnaṃ abhāvena virajaṃ, vānato nikkhantattā nibbānaṃ, cavanābhāvato adhigatānaṃ accutihetutāya ca nibbānaṃ accutaṃ, padanti ca laddhanāmaṃ asaṅkhatadhammaṃ, sahassanayapaṭimaṇḍitena dassanasaṅkhātena dhammacakkhunā addasaṃ passiṃ."]},{"para":1442,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["<b>Sāha</b>nti sā ahaṃ vuttappakārena sotāpannā homi."]}],"after":[{"para":1446,"vripara":null,"title":"Sakulātherīgāthāvaṇṇanā","lines":["Sakulātherīgāthāvaṇṇanā niṭṭhitā. 8."]}]},"tika":null,"tika2":null}
