{"suttaId":"thig5.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[399,414],"vripara":"97"},"segments":{"thig5.7:0.3":"Sakulātherīgāthā","thig5.7:1.1":"“Agārasmiṃ vasantīhaṃ,","thig5.7:1.2":"dhammaṃ sutvāna bhikkhuno;","thig5.7:1.3":"Addasaṃ virajaṃ dhammaṃ,","thig5.7:1.4":"nibbānaṃ padamaccutaṃ.","thig5.7:2.1":"“Sāhaṃ puttaṃ dhītarañca,","thig5.7:2.2":"dhanadhaññañca chaḍḍiya;","thig5.7:2.3":"Kese chedāpayitvāna,","thig5.7:2.4":"pabbajiṃ anagāriyaṃ.","thig5.7:3.1":"“Sikkhamānā ahaṃ santī,","thig5.7:3.2":"bhāventī maggamañjasaṃ;","thig5.7:3.3":"Pahāsiṃ rāgadosañca,","thig5.7:3.4":"tadekaṭṭhe ca āsave.","thig5.7:4.1":"“Bhikkhunī upasampajja,","thig5.7:4.2":"pubbajātimanussariṃ;","thig5.7:4.3":"Dibbacakkhu visodhitaṃ [visodhitaṃ dibbacakkhu (sī.)],","thig5.7:4.4":"vimalaṃ sādhubhāvitaṃ.","thig5.7:5.1":"“Saṅkhāre parato disvā,","thig5.7:5.2":"hetujāte palokite [palokine (ka.)];","thig5.7:5.3":"Pahāsiṃ āsave sabbe,","thig5.7:5.4":"sītibhūtāmhi nibbutā”ti.","thig5.7:6.1":"… Sakulā therī …."},"unsure":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1443,"to":1445,"paras":[{"para":1443,"vripara":null,"refs":["thig5.7:5"],"lines":["<b>Sikkhamānā ahaṃ santī</b>ti ahaṃ sikkhamānāva samānā pabbajitvā vasse aparipuṇṇe eva.","<b>Bhāventī maggamañjasan</b>ti majjhimapaṭipattibhāvato añjasaṃ uparimaggaṃ uppādentī.","<b>Tadekaṭṭhe ca āsave</b>ti rāgadosehi sahajekaṭṭhe pahānekaṭṭhe ca tatiyamaggavajjhe āsave <b>pahāsiṃ</b> samucchindiṃ."],"lineRefs":[["thig5.7:5"],["thig5.7:5"],["thig5.7:5"]]},{"para":1444,"vripara":null,"refs":["thig5.7:5"],"lines":["<b>Bhikkhunī upasampajjā</b>ti vasse paripuṇṇe upasampajjitvā bhikkhunī hutvā.","<b>Vimalan</b>ti avijjādīhi upakkilesehi vimuttatāya vigatamalaṃ, <b>sādhu</b> sakkacca sammadeva <b>bhāvitaṃ,</b> sādhūhi vā buddhādīhi <b>bhāvitaṃ</b> uppāditaṃ dibbacakkhu visodhitanti sambandho."],"lineRefs":[["thig5.7:5"],["thig5.7:5"]]},{"para":1445,"vripara":null,"refs":["thig5.7:5"],"lines":["<b>Saṅkhāre</b>ti tebhūmakasaṅkhāre.","<b>Parato</b>ti anattato.","<b>Hetujāte</b>ti paccayuppanne.","<b>Palokite</b>ti palujjanasabhāve pabhaṅgune paññācakkhunā disvā.","<b>Pahāsiṃ āsave sabbe</b>ti aggamaggena avasiṭṭhe sabbepi āsave pajahiṃ, khepesinti attho.","Sesaṃ vuttanayameva."],"lineRefs":[["thig5.7:5"],["thig5.7:5"],["thig5.7:5"],["thig5.7:5"],["thig5.7:5"],["thig5.7:5"]]}],"wordLinks":[["thig5.7:5.3","pahāsiṃ",0,2],["thig5.7:5.1","saṅkhāre",2,0],["thig5.7:5.1","parato",2,1],["thig5.7:5.1","hetujāte",2,2],["thig5.7:5.1","palokite",2,3],["thig5.7:5.3","pahāsiṃ āsave sabbe",2,4]],"before":[{"para":1356,"vripara":null,"refs":[],"lines":["Mittākāḷītherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1357,"vripara":null,"refs":[],"lines":["Sakulātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":1358,"vripara":null,"refs":[],"lines":["<b>Agārasmiṃ vasantī</b>tiādikā sakulāya theriyā gāthā.","Ayaṃ kira padumuttarassa bhagavato kāle haṃsavatīnagare ānandassa rañño dhītā hutvā nibbattā, satthu vemātikabhaginī <b>nandā</b>ti nāmena.","Sā viññutaṃ patvā ekadivasaṃ satthu santike dhammaṃ suṇantī satthārā ekaṃ bhikkhuniṃ dibbacakkhukānaṃ aggaṭṭhāne ṭhapentaṃ disvā ussāhajātā adhikārakammaṃ katvā sayampi taṃ ṭhānantaraṃ patthentī paṇidhānamakāsi.","Sā tattha yāvajīvaṃ bahuṃ uḷāraṃ kusalakammaṃ katvā devaloke nibbattitvā aparāparaṃ sugatīsuyeva saṃsarantī kassapassa bhagavato kāle brāhmaṇakule nibbattitvā paribbājakapabbajjaṃ pabbajitvā ekacārinī vicarantī ekadivasaṃ telabhikkhāya āhiṇḍitvā telaṃ labhitvā tena telena satthu cetiye sabbarattiṃ dīpapūjaṃ akāsi.","Sā tato cutā tāvatiṃse nibbattitvā suvisuddhadibbacakkhukā hutvā ekaṃ buddhantaraṃ devesuyeva saṃsaritvā imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇakule nibbatti.","<b>Sakulā</b>tissā nāmaṃ ahosi.","Sā viññutaṃ pattā satthu jetavanapaṭiggahaṇe paṭiladdhasaddhā upāsikā hutvā aparabhāge aññatarassa khīṇāsavattherassa santike dhammaṃ sutvā sañjātasaṃvegā pabbajitvā vipassanaṃ paṭṭhapetvā ghaṭentī vāyamantī na cirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.3.131-165)–"],"lineRefs":[[],[],[],[],[],[],[],[]]},{"para":1359,"vripara":null,"refs":[],"lines":["“Padumuttaro nāma jino, sabbadhammāna pāragū;"],"lineRefs":[[]]},{"para":1360,"vripara":null,"refs":[],"lines":["Ito satasahassamhi, kappe uppajji nāyako."],"lineRefs":[[]]},{"para":1361,"vripara":null,"refs":[],"lines":["“Hitāya sabbasattānaṃ, sukhāya vadataṃ varo;"],"lineRefs":[[]]},{"para":1362,"vripara":null,"refs":[],"lines":["Atthāya purisājañño, paṭipanno sadevake."],"lineRefs":[[]]},{"para":1363,"vripara":null,"refs":[],"lines":["“Yasaggapatto sirimā, kittivaṇṇagato jino;"],"lineRefs":[[]]},{"para":1364,"vripara":null,"refs":[],"lines":["Pūjito sabbalokassa, disā sabbāsu vissuto."],"lineRefs":[[]]},{"para":1365,"vripara":null,"refs":[],"lines":["“Uttiṇṇavicikiccho so, vītivattakathaṃkatho;"],"lineRefs":[[]]},{"para":1366,"vripara":null,"refs":[],"lines":["Sampuṇṇamanasaṅkappo, patto sambodhimuttamaṃ."],"lineRefs":[[]]},{"para":1367,"vripara":null,"refs":[],"lines":["“Anuppannassa maggassa, uppādetā naruttamo;"],"lineRefs":[[]]},{"para":1368,"vripara":null,"refs":[],"lines":["Anakkhātañca akkhāsi, asañjātañca sañjanī."],"lineRefs":[[]]},{"para":1369,"vripara":null,"refs":[],"lines":["“Maggaññū ca maggavidū, maggakkhāyī narāsabho;"],"lineRefs":[[]]},{"para":1370,"vripara":null,"refs":[],"lines":["Maggassa kusalo satthā, sārathīnaṃ varuttamo."],"lineRefs":[[]]},{"para":1371,"vripara":null,"refs":[],"lines":["“Mahākāruṇiko satthā, dhammaṃ deseti nāyako;"],"lineRefs":[[]]},{"para":1372,"vripara":null,"refs":[],"lines":["Nimugge kāmapaṅkamhi, samuddharati pāṇine."],"lineRefs":[[]]},{"para":1373,"vripara":null,"refs":[],"lines":["“Tadāhaṃ haṃsavatiyaṃ, jātā khattiyanandanā;"],"lineRefs":[[]]},{"para":1374,"vripara":null,"refs":[],"lines":["Surūpā sadhanā cāpi, dayitā ca sirīmatī."],"lineRefs":[[]]},{"para":1375,"vripara":null,"refs":[],"lines":["“Ānandassa mahārañño, dhītā paramasobhanā;"],"lineRefs":[[]]},{"para":1376,"vripara":null,"refs":[],"lines":["Vemātā bhaginī cāpi, padumuttaranāmino."],"lineRefs":[[]]},{"para":1377,"vripara":null,"refs":[],"lines":["“Rājakaññāhi sahitā, sabbābharaṇabhūsitā;"],"lineRefs":[[]]},{"para":1378,"vripara":null,"refs":[],"lines":["Upāgamma mahāvīraṃ, assosiṃ dhammadesanaṃ."],"lineRefs":[[]]},{"para":1379,"vripara":null,"refs":[],"lines":["“Tadā hi so lokagaru, bhikkhuniṃ dibbacakkhukaṃ;"],"lineRefs":[[]]},{"para":1380,"vripara":null,"refs":[],"lines":["Kittayaṃ parisāmajjhe, aggaṭṭhāne ṭhapesi taṃ."],"lineRefs":[[]]},{"para":1381,"vripara":null,"refs":[],"lines":["“Suṇitvā tamahaṃ haṭṭhā, dānaṃ datvāna satthuno;"],"lineRefs":[[]]},{"para":1382,"vripara":null,"refs":[],"lines":["Pūjitvāna ca sambuddhaṃ, dibbacakkhuṃ apatthayiṃ."],"lineRefs":[[]]},{"para":1383,"vripara":null,"refs":[],"lines":["“Tato avoca maṃ satthā, nande lacchasi patthitaṃ;"],"lineRefs":[[]]},{"para":1384,"vripara":null,"refs":[],"lines":["Padīpadhammadānānaṃ, phalametaṃ sunicchitaṃ."],"lineRefs":[[]]},{"para":1385,"vripara":null,"refs":[],"lines":["“Satasahassito kappe, okkākakulasambhavo;"],"lineRefs":[[]]},{"para":1386,"vripara":null,"refs":[],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[[]]},{"para":1387,"vripara":null,"refs":[],"lines":["“Tassa dhammesu dāyādā, orasā dhammanimmitā;"],"lineRefs":[[]]},{"para":1388,"vripara":null,"refs":[],"lines":["Sakulā nāma nāmena, hessati satthu sāvikā."],"lineRefs":[[]]},{"para":1389,"vripara":null,"refs":[],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":1390,"vripara":null,"refs":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":1391,"vripara":null,"refs":[],"lines":["“Imamhi bhaddake kappe, brahmabandhu mahāyaso;"],"lineRefs":[[]]},{"para":1392,"vripara":null,"refs":[],"lines":["Kassapo nāma gottena, uppajji vadataṃ varo."],"lineRefs":[[]]},{"para":1393,"vripara":null,"refs":[],"lines":["“Paribbājakinī āsiṃ, tadāhaṃ ekacārinī;"],"lineRefs":[[]]},{"para":1394,"vripara":null,"refs":[],"lines":["Bhikkhāya vicaritvāna, alabhiṃ telamattakaṃ."],"lineRefs":[[]]},{"para":1395,"vripara":null,"refs":[],"lines":["“Tena dīpaṃ padīpetvā, upaṭṭhiṃ sabbasaṃvariṃ;"],"lineRefs":[[]]},{"para":1396,"vripara":null,"refs":[],"lines":["Cetiyaṃ dvipadaggassa, vippasannena cetasā."],"lineRefs":[[]]},{"para":1397,"vripara":null,"refs":[],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":1398,"vripara":null,"refs":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":1399,"vripara":null,"refs":[],"lines":["“Yattha yatthūpapajjāmi, tassa kammassa vāhasā;"],"lineRefs":[[]]},{"para":1400,"vripara":null,"refs":[],"lines":["Pajjalanti mahādīpā, tattha tattha gatāya me."],"lineRefs":[[]]},{"para":1401,"vripara":null,"refs":[],"lines":["“Tirokuṭṭaṃ tiroselaṃ, samatiggayha pabbataṃ;"],"lineRefs":[[]]},{"para":1402,"vripara":null,"refs":[],"lines":["Passāmahaṃ yadicchāmi, dīpadānassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":1403,"vripara":null,"refs":[],"lines":["“Visuddhanayanā homi, yasasā ca jalāmahaṃ;"],"lineRefs":[[]]},{"para":1404,"vripara":null,"refs":[],"lines":["Saddhāpaññāvatī ceva, dīpadānassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":1405,"vripara":null,"refs":[],"lines":["“Pacchime ca bhave dāni, jātā vippakule ahaṃ;"],"lineRefs":[[]]},{"para":1406,"vripara":null,"refs":[],"lines":["Pahūtadhanadhaññamhi, mudite rājapūjite."],"lineRefs":[[]]},{"para":1407,"vripara":null,"refs":[],"lines":["“Ahaṃ sabbaṅgasampannā, sabbābharaṇabhūsitā;"],"lineRefs":[[]]},{"para":1408,"vripara":null,"refs":[],"lines":["Purappavese sugataṃ, vātapāne ṭhitā ahaṃ."],"lineRefs":[[]]},{"para":1409,"vripara":null,"refs":[],"lines":["“Disvā jalantaṃ yasasā, devamanussasakkataṃ;"],"lineRefs":[[]]},{"para":1410,"vripara":null,"refs":[],"lines":["Anubyañjanasampannaṃ, lakkhaṇehi vibhūsitaṃ."],"lineRefs":[[]]},{"para":1411,"vripara":null,"refs":[],"lines":["“Udaggacittā sumanā, pabbajjaṃ samarocayiṃ;"],"lineRefs":[[]]},{"para":1412,"vripara":null,"refs":[],"lines":["Na cireneva kālena, arahattamapāpuṇiṃ."],"lineRefs":[[]]},{"para":1413,"vripara":null,"refs":[],"lines":["“Iddhīsu ca vasī homi, dibbāya sotadhātuyā;"],"lineRefs":[[]]},{"para":1414,"vripara":null,"refs":[],"lines":["Paracittāni jānāmi, satthusāsanakārikā."],"lineRefs":[[]]},{"para":1415,"vripara":null,"refs":[],"lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"],"lineRefs":[[]]},{"para":1416,"vripara":null,"refs":[],"lines":["Khepetvā āsave sabbe, visuddhāsiṃ sunimmalā."],"lineRefs":[[]]},{"para":1417,"vripara":null,"refs":[],"lines":["“Pariciṇṇo mayā satthā, kataṃ buddhassa sāsanaṃ;"],"lineRefs":[[]]},{"para":1418,"vripara":null,"refs":[],"lines":["Ohito garuko bhāro, bhavanettisamūhatā."],"lineRefs":[[]]},{"para":1419,"vripara":null,"refs":[],"lines":["“Yassatthāya pabbajitā, agārasmānagāriyaṃ;"],"lineRefs":[[]]},{"para":1420,"vripara":null,"refs":[],"lines":["So me attho anuppatto, sabbasaṃyojanakkhayo."],"lineRefs":[[]]},{"para":1421,"vripara":null,"refs":[],"lines":["“Tato mahākāruṇiko, etadagge ṭhapesi maṃ;"],"lineRefs":[[]]},{"para":1422,"vripara":null,"refs":[],"lines":["Dibbacakkhukānaṃ aggā, sakulāti naruttamo."],"lineRefs":[[]]},{"para":1423,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":1424,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā katādhikāratāya dibbacakkhuñāṇe ciṇṇavasī ahosi.","Tena naṃ satthā dibbacakkhukānaṃ bhikkhunīnaṃ aggaṭṭhāne ṭhapesi.","Sā attano paṭipattiṃ paccavekkhitvā pītisomanassajātā udānavasena –"],"lineRefs":[[],[],[]]},{"para":1426,"vripara":"97","refs":[],"lines":["“Agārasmiṃ vasantīhaṃ, dhammaṃ sutvāna bhikkhuno;"],"lineRefs":[[]]},{"para":1427,"vripara":null,"refs":[],"lines":["Addasaṃ virajaṃ dhammaṃ, nibbānaṃ padamaccutaṃ."],"lineRefs":[[]]},{"para":1429,"vripara":"98","refs":[],"lines":["“Sāhaṃ puttaṃ dhītarañca, dhanadhaññañca chaḍḍiya;"],"lineRefs":[[]]},{"para":1430,"vripara":null,"refs":[],"lines":["Kese chedāpayitvāna, pabbajiṃ anagāriyaṃ."],"lineRefs":[[]]},{"para":1432,"vripara":"99","refs":[],"lines":["“Sikkhamānā ahaṃ santī, bhāventī maggamañjasaṃ;"],"lineRefs":[[]]},{"para":1433,"vripara":null,"refs":[],"lines":["Pahāsiṃ rāgadosañca, tadekaṭṭhe ca āsave."],"lineRefs":[[]]},{"para":1435,"vripara":"100","refs":[],"lines":["“Bhikkhunī upasampajja, pubbajātimanussariṃ;"],"lineRefs":[[]]},{"para":1436,"vripara":null,"refs":[],"lines":["Dibbacakkhu visodhitaṃ, vimalaṃ sādhubhāvitaṃ."],"lineRefs":[[]]},{"para":1438,"vripara":"101","refs":[],"lines":["“Saṅkhāre parato disvā, hetujāte palokite;"],"lineRefs":[[]]},{"para":1439,"vripara":null,"refs":[],"lines":["Pahāsiṃ āsave sabbe, sītibhūtāmhi nibbutā”ti.","–"],"lineRefs":[[],[]]},{"para":1440,"vripara":null,"refs":[],"lines":["Imā gāthā abhāsi."],"lineRefs":[[]]},{"para":1441,"vripara":null,"refs":[],"lines":["Tattha <b>agārasmiṃ vasantīhaṃ, dhammaṃ sutvāna bhikkhuno</b>ti ahaṃ pubbe agāramajjhe vasamānā aññatarassa bhinnakilesassa bhikkhuno santike catusaccagabbhaṃ dhammakathaṃ sutvā.","<b>Addasaṃ virajaṃ dhammaṃ, nibbānaṃ padamaccutan</b>ti rāgarajādīnaṃ abhāvena virajaṃ, vānato nikkhantattā nibbānaṃ, cavanābhāvato adhigatānaṃ accutihetutāya ca nibbānaṃ accutaṃ, padanti ca laddhanāmaṃ asaṅkhatadhammaṃ, sahassanayapaṭimaṇḍitena dassanasaṅkhātena dhammacakkhunā addasaṃ passiṃ."],"lineRefs":[[],[]]},{"para":1442,"vripara":null,"refs":[],"lines":["<b>Sāhan</b>ti sā ahaṃ vuttappakārena sotāpannā homi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
