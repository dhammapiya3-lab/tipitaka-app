{"suttaId":"thig5.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[399,414],"vripara":"97"},"segments":{"thig5.7:0.3":"Sakulātherīgāthā","thig5.7:1.1":"“Agārasmiṃ vasantīhaṃ, dhammaṃ sutvāna bhikkhuno;","thig5.7:1.3":"Addasaṃ virajaṃ dhammaṃ, nibbānaṃ padamaccutaṃ.","thig5.7:2.1":"“Sāhaṃ puttaṃ dhītarañca, dhanadhaññañca chaḍḍiya;","thig5.7:2.3":"Kese chedāpayitvāna, pabbajiṃ anagāriyaṃ.","thig5.7:3.1":"“Sikkhamānā ahaṃ santī, bhāventī maggamañjasaṃ;","thig5.7:3.3":"Pahāsiṃ rāgadosañca, tadekaṭṭhe ca āsave.","thig5.7:4.1":"“Bhikkhunī upasampajja, pubbajātimanussariṃ;","thig5.7:4.3":"Dibbacakkhu visodhitaṃ [visodhitaṃ dibbacakkhu (sī.)], vimalaṃ sādhubhāvitaṃ.","thig5.7:5.1":"“Saṅkhāre parato disvā, hetujāte palokite [palokine (ka.)];","thig5.7:5.3":"Pahāsiṃ āsave sabbe, sītibhūtāmhi nibbutā”ti.","thig5.7:6.1":"… Sakulā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1443,"to":1445,"paras":[{"para":1443,"vripara":null,"refs":["thig5.7:5"],"lines":["<b>Sikkhamānā ahaṃ santī</b>ti ahaṃ sikkhamānāva samānā pabbajitvā vasse aparipuṇṇe eva.","<b>Bhāventī maggamañjasan</b>ti majjhimapaṭipattibhāvato añjasaṃ uparimaggaṃ uppādentī.","<b>Tadekaṭṭhe ca āsave</b>ti rāgadosehi sahajekaṭṭhe pahānekaṭṭhe ca tatiyamaggavajjhe āsave <b>pahāsiṃ</b> samucchindiṃ."],"lineRefs":[["thig5.7:5"],["thig5.7:5"],["thig5.7:5"]]},{"para":1444,"vripara":null,"refs":[],"lines":["<b>Bhikkhunī upasampajjā</b>ti vasse paripuṇṇe upasampajjitvā bhikkhunī hutvā.","<b>Vimalan</b>ti avijjādīhi upakkilesehi vimuttatāya vigatamalaṃ, <b>sādhu</b> sakkacca sammadeva <b>bhāvitaṃ,</b> sādhūhi vā buddhādīhi <b>bhāvitaṃ</b> uppāditaṃ dibbacakkhu visodhitanti sambandho."],"lineRefs":[[],[]]},{"para":1445,"vripara":null,"refs":["thig5.7:5"],"lines":["<b>Saṅkhāre</b>ti tebhūmakasaṅkhāre.","<b>Parato</b>ti anattato.","<b>Hetujāte</b>ti paccayuppanne.","<b>Palokite</b>ti palujjanasabhāve pabhaṅgune paññācakkhunā disvā.","<b>Pahāsiṃ āsave sabbe</b>ti aggamaggena avasiṭṭhe sabbepi āsave pajahiṃ, khepesinti attho.","Sesaṃ vuttanayameva."],"lineRefs":[["thig5.7:5"],["thig5.7:5"],["thig5.7:5"],["thig5.7:5"],["thig5.7:5"],["thig5.7:5"]]}],"wordLinks":[["thig5.7:5.3","pahāsiṃ",0,2],["thig5.7:5.1","saṅkhāre",2,0],["thig5.7:5.1","parato",2,1],["thig5.7:5.1","hetujāte",2,2],["thig5.7:5.1","palokite",2,3],["thig5.7:5.3","pahāsiṃ āsave sabbe",2,4]]},"tika":null,"tika2":null}
