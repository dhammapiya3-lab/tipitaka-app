{"suttaId":"sn10.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[3134,3136],"vripara":"244"},"segments":{"sn10.10:0.3":"Dutiyasukkāsuttaṃ","sn10.10:1.1":"Ekaṃ samayaṃ bhagavā rājagahe viharati veḷuvane kalandakanivāpe.","sn10.10:1.2":"Tena kho pana samayena aññataro upāsako sukkāya bhikkhuniyā bhojanaṃ adāsi.","sn10.10:1.3":"Atha kho sukkāya bhikkhuniyā abhippasanno yakkho rājagahe rathikāya rathikaṃ siṅghāṭakena siṅghāṭakaṃ upasaṅkamitvā tāyaṃ velāyaṃ imaṃ gāthaṃ abhāsi –","sn10.10:2.1":"“Puññaṃ vata pasavi bahuṃ,","sn10.10:2.2":"sappañño vatāyaṃ upāsako;","sn10.10:2.3":"Yo sukkāya adāsi bhojanaṃ,","sn10.10:2.4":"sabbaganthehi vippamuttiyā”ti [vippamuttāyāti (syā. kaṃ.)]."},"unsure":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1332,"to":1332,"paras":[{"para":1332,"vripara":"244","refs":["sn10.10:2"],"lines":["Dasame <b>puññaṃ vata pasavi bahun</b>ti bahuṃ vata puññaṃ pasavatīti.","Dasamaṃ."],"lineRefs":[["sn10.10:2"],["sn10.10:2"]]}],"wordLinks":[["sn10.10:2.1","puññaṃ vata pasavi bahuṃ",0,0]],"before":[{"para":1331,"vripara":null,"refs":[],"lines":["10-11. Dutiyasukkāsuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1548,"to":1550,"paras":[{"para":1548,"vripara":"244","refs":["sn10.10:1"],"lines":["<b>Bahuṃ vata puññaṃ pasavati</b> sabbaganthavimuttiyā sīlasamannāgatena aggadakkhiṇeyyāya sukkāya theriyā bhojanassa dinnattā."],"lineRefs":[["sn10.10:1"]]},{"para":1549,"vripara":null,"refs":["sn10.10:1"],"lines":["Dutiyasukkāsuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn10.10:1"]]},{"para":1550,"vripara":null,"refs":["sn10.10:1"],"lines":["Cīrāsuttavaṇṇanā"],"lineRefs":[["sn10.10:1"]]}],"wordLinks":[],"before":[{"para":1546,"vripara":null,"refs":[],"lines":["Paṭhamasukkāsuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1547,"vripara":null,"refs":[],"lines":["Dutiyasukkāsuttavaṇṇanā"],"lineRefs":[[]]}]}