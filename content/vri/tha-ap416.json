{"suttaId":"tha-ap416","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[14369,14402],"vripara":"106"},"segments":{"tha-ap416:0.3":"Madhumaṃsadāyakattheraapadānaṃ","tha-ap416:1.1":"“Nagare bandhumatiyā,","tha-ap416:1.2":"sūkariko ahosahaṃ;","tha-ap416:1.3":"Ukkoṭaṃ randhayitvāna [ukkoṭakaṃ randhayitvā (sī. syā.)], madhumaṃsamhi [madhusappimhi (pī.), madhuṃ maṃsamhi (ka.)] okiriṃ.","tha-ap416:2.1":"“Sannipātaṃ ahaṃ gantvā,","tha-ap416:2.2":"ekaṃ pattaṃ gahesahaṃ;","tha-ap416:2.3":"Pūrayitvāna taṃ pattaṃ,","tha-ap416:2.4":"bhikkhusaṅghassadāsahaṃ.","tha-ap416:3.1":"“Yottha therataro bhikkhu,","tha-ap416:3.2":"niyyādesi mamaṃ tadā;","tha-ap416:3.3":"Iminā pattapūrena,","tha-ap416:3.4":"labhassu vipulaṃ sukhaṃ.","tha-ap416:4.1":"“Duve sampattiyo bhutvā,","tha-ap416:4.2":"sukkamūlena codito;","tha-ap416:4.3":"Pacchime vattamānamhi,","tha-ap416:4.4":"kilese jhāpayissati.","tha-ap416:5.1":"“Tattha cittaṃ pasādetvā,","tha-ap416:5.2":"tāvatiṃsamagacchahaṃ;","tha-ap416:5.3":"Tattha bhutvā pivitvā ca,","tha-ap416:5.4":"labhāmi vipulaṃ sukhaṃ.","tha-ap416:6.1":"“Maṇḍape rukkhamūle vā,","tha-ap416:6.2":"pubbakammaṃ anussariṃ;","tha-ap416:6.3":"Annapānābhivasso me,","tha-ap416:6.4":"abhivassati tāvade.","tha-ap416:7.1":"“Idaṃ pacchimakaṃ mayhaṃ,","tha-ap416:7.2":"carimo vattate bhavo;","tha-ap416:7.3":"Idhāpi annapānaṃ me,","tha-ap416:7.4":"vassate sabbakālikaṃ.","tha-ap416:8.1":"“Teneva madhudānena [maṃsadānena (sī. pī.)],","tha-ap416:8.2":"sandhāvitvā bhave ahaṃ;","tha-ap416:8.3":"Sabbāsave pariññāya,","tha-ap416:8.4":"viharāmi anāsavo.","tha-ap416:9.1":"“Ekanavutito kappe,","tha-ap416:9.2":"yaṃ dānamadadiṃ tadā;","tha-ap416:9.3":"Duggatiṃ nābhijānāmi,","tha-ap416:9.4":"madhudānassidaṃ phalaṃ.","tha-ap416:10.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap416:10.3":"viharāmi anāsavo.","tha-ap416:11.1":"“Svāgataṃ vata me āsi … pe …","tha-ap416:11.3":"kataṃ buddhassa sāsanaṃ.","tha-ap416:12.1":"“Paṭisambhidā catasso … pe …","tha-ap416:12.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap416:13.1":"Itthaṃ sudaṃ āyasmā madhumaṃsadāyako thero imā gāthāyo abhāsitthāti.","tha-ap416:14.1":"Madhumaṃsadāyakattherassāpadānaṃ catutthaṃ."},"unsure":["tha-ap416:1.3"],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3333,"to":3333,"paras":[{"para":3333,"vripara":"106","refs":["tha-ap416:1"],"lines":["Catutthāpadāne <b>nagare bandhumatiyā</b>tiādikaṃ āyasmato madhumaṃsadāyakattherassa apadānaṃ.","Tattha <b>sūkariko</b>ti sūkaramaṃsaṃ vikkiṇitvā jīvikaṃ kappento.","<b>Ukkoṭakaṃ randhayitvā</b>ti pihakapapphāsamaṃsaṃ pacitvā madhumaṃsamhi <b>okiriṃ</b> pakkhipiṃ.","Tena maṃsena pattaṃ pūretvā bhikkhusaṅghassa datvā tena puññakammena imasmiṃ buddhuppāde arahattaṃ pāpuṇinti attho."],"lineRefs":[["tha-ap416:1"],["tha-ap416:1"],["tha-ap416:1"],["tha-ap416:1"]]}],"wordLinks":[["tha-ap416:1.1","nagare bandhumatiyā",0,0],["tha-ap416:1.1","sūkariko",0,1],["tha-ap416:1.3","okiriṃ",0,2]],"before":[{"para":3330,"vripara":null,"title":"Bhaddālivaggo","lines":["Bhaddālivaggo"]},{"para":3331,"vripara":null,"title":"Bhaddālittheraapadānādivaṇṇanā","lines":["1-10. Bhaddālittheraapadānādivaṇṇanā"]},{"para":3332,"vripara":null,"title":"Bhaddālittheraapadānādivaṇṇanā","lines":["Bācattālīsamavagge paṭhamāpadānañca dutiyāpadānañca tatiyāpadānañca nayānusārena suviññeyyameva."]}],"after":[{"para":3334,"vripara":null,"title":"Bhaddālittheraapadānādivaṇṇanā","lines":["Nāgapallavattherassa pañcamāpadānampi ekadīpiyattherassa chaṭṭhāpadānampi ucchaṅgapupphiyattherassa sattamāpadānampi yāgudāyakattherassa aṭṭhamāpadānampi patthodanadāyakattherassa navamāpadānampi mañcadāyakattherassa dasamāpadānampi sabbaṃ suviññeyyamevāti."]},{"para":3335,"vripara":null,"title":"Bhaddālittheraapadānādivaṇṇanā","lines":["Bācattālīsamavaggavaṇṇanā samattā."]}]},"tika":null,"tika2":null}
