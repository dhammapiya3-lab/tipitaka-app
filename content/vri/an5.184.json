{"suttaId":"an5.184","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1263,1263],"vripara":"184"},"segments":{"an5.184:0.3":"Sosānikasuttaṃ","an5.184:1.1":"“Pañcime, bhikkhave, sosānikā.","an5.184:1.2":"Katame pañca?","an5.184:1.3":"Mandattā momūhattā sosāniko hoti … pe … idamatthitaṃyeva nissāya sosāniko hoti.","an5.184:1.4":"Ime kho, bhikkhave, pañca sosānikā”ti.","an5.184:1.5":"Catutthaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
