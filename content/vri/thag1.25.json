{"suttaId":"thag1.25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[151,154],"vripara":"25"},"segments":{"thag1.25:0.4":"Nandiyattheragāthā","thag1.25:1.1":"“Obhāsajātaṃ phalagaṃ, cittaṃ yassa abhiṇhaso;","thag1.25:1.3":"Tādisaṃ bhikkhumāsajja, kaṇha dukkhaṃ nigacchasī”ti.","thag1.25:1.5":"… Nandiyo thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":894,"to":894,"paras":[{"para":894,"vripara":"25","refs":["thag1.25:1"],"lines":["Tattha <b>obhāsajātan</b>ti ñāṇobhāsena jātobhāsaṃ aggamaggañāṇassa adhigatattā.","Tena anavasesato kilesandhakārassa vihataviddhaṃsitabhāvato ativiya pabhassaranti attho.","<b>Phalagan</b>ti phalaṃ gataṃ upagataṃ, aggaphalañāṇasahitanti adhippāyo.","<b>Cittan</b>ti khīṇāsavassa cittaṃ sāmaññena vadati.","Tenāha <b>“abhiṇhaso”</b>ti.","Tañhi nirodhaninnatāya khīṇāsavānaṃ niccakappaṃ arahattaphalasamāpattisamāpajjanato “phalena sahitan”ti vattabbataṃ arahati.","<b>Tādisan</b>ti tathārūpaṃ, arahantanti attho.","<b>Āsajjā</b>ti visodhetvā paribhuyya.","<b>Kaṇhā</b>ti māraṃ ālapati, so hi kaṇhakammattā kaṇhābhijātitāya ca “kaṇho”ti vuccati.","<b>Dukkhaṃ nigacchasī</b>ti idha kucchianuppavesādinā niratthakaṃ kāyaparissamaṃ dukkhaṃ, samparāye ca appatikāraṃ apāyadukkhaṃ upagamissasi pāpuṇissasi.","Taṃ sutvā māro “jānāti maṃ samaṇo”ti tatthevantaradhāyīti."],"lineRefs":[["thag1.25:1"],["thag1.25:1"],["thag1.25:1"],["thag1.25:1"],["thag1.25:1"],["thag1.25:1"],["thag1.25:1"],["thag1.25:1"],["thag1.25:1"],["thag1.25:1"],["thag1.25:1"]]}],"wordLinks":[["thag1.25:1.1","obhāsajātaṃ",0,0],["thag1.25:1.1","phalagaṃ",0,2],["thag1.25:1.1","cittaṃ",0,3],["thag1.25:1.1","abhiṇhaso",0,4],["thag1.25:1.3","tādisaṃ",0,6],["thag1.25:1.3","āsajjā",0,7],["thag1.25:1.3","kaṇhā",0,8],["thag1.25:1.3","dukkhaṃ nigacchasī",0,9]]},"tika":null}
