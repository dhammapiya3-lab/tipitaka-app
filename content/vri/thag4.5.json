{"suttaId":"thag4.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1383,1395],"vripara":"283"},"segments":{"thag4.5:0.4":"Jambukattheragāthā","thag4.5:1.1":"“Pañcapaññāsavassāni, rajojallamadhārayiṃ;","thag4.5:1.3":"Bhuñjanto māsikaṃ bhattaṃ, kesamassuṃ alocayiṃ.","thag4.5:2.1":"“Ekapādena aṭṭhāsiṃ, āsanaṃ parivajjayiṃ;","thag4.5:2.3":"Sukkhagūthāni ca khādiṃ, uddesañca na sādiyiṃ.","thag4.5:3.1":"“Etādisaṃ karitvāna, bahuṃ duggatigāminaṃ;","thag4.5:3.3":"Vuyhamāno mahoghena, buddhaṃ saraṇamāgamaṃ.","thag4.5:4.1":"“Saraṇagamanaṃ passa, passa dhammasudhammataṃ;","thag4.5:4.3":"Tisso vijjā anuppattā, kataṃ buddhassa sāsanan”ti.","thag4.5:4.5":"… Jambuko thero …."},"attha":null,"tika":null}
