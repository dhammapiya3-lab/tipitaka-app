{"suttaId":"thig5.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[296,312],"vripara":"67"},"segments":{"thig5.1:0.3":"Aññatarātherīgāthā","thig5.1:1.1":"“Paṇṇavīsativassāni, yato pabbajitā ahaṃ;","thig5.1:1.3":"Nāccharāsaṅghātamattampi, cittassūpasamajjhagaṃ.","thig5.1:2.1":"“Aladdhā cetaso santiṃ, kāmarāgenavassutā;","thig5.1:2.3":"Bāhā paggayha kandantī, vihāraṃ pāvisiṃ ahaṃ.","thig5.1:3.1":"“Sā bhikkhuniṃ upāgacchiṃ, yā me saddhāyikā ahu;","thig5.1:3.3":"Sā me dhammamadesesi, khandhāyatanadhātuyo.","thig5.1:4.1":"“Tassā dhammaṃ suṇitvāna, ekamante upāvisiṃ;","thig5.1:4.3":"Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ.","thig5.1:5.1":"“Cetopariccañāṇañca [cetopariyañāṇañca (ka.)], sotadhātu visodhitā;","thig5.1:5.3":"Iddhīpi me sacchikatā, patto me āsavakkhayo;","thig5.1:5.5":"Chaḷabhiññā [cha mebhiññā (syā. ka.)] sacchikatā, kataṃ buddhassa sāsanan”ti.","thig5.1:6.1":"… Aññatarā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1130,"to":1130,"paras":[{"para":1130,"vripara":null,"refs":["thig5.1:5"],"words":["cetopariccañāṇañcā"],"lines":["<b>Cetopariccañāṇañcā</b>ti cetopariyañāṇañca visodhitanti sambandho, adhigatanti attho.","Sesaṃ vuttanayameva."],"lineRefs":[["thig5.1:5"],["thig5.1:5"]]}]},"tika":null}
