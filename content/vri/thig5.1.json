{"suttaId":"thig5.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[296,312],"vripara":"67"},"segments":{"thig5.1:0.3":"Aññatarātherīgāthā","thig5.1:1.1":"“Paṇṇavīsativassāni, yato pabbajitā ahaṃ;","thig5.1:1.3":"Nāccharāsaṅghātamattampi, cittassūpasamajjhagaṃ.","thig5.1:2.1":"“Aladdhā cetaso santiṃ, kāmarāgenavassutā;","thig5.1:2.3":"Bāhā paggayha kandantī, vihāraṃ pāvisiṃ ahaṃ.","thig5.1:3.1":"“Sā bhikkhuniṃ upāgacchiṃ, yā me saddhāyikā ahu;","thig5.1:3.3":"Sā me dhammamadesesi, khandhāyatanadhātuyo.","thig5.1:4.1":"“Tassā dhammaṃ suṇitvāna, ekamante upāvisiṃ;","thig5.1:4.3":"Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ.","thig5.1:5.1":"“Cetopariccañāṇañca [cetopariyañāṇañca (ka.)], sotadhātu visodhitā;","thig5.1:5.3":"Iddhīpi me sacchikatā, patto me āsavakkhayo;","thig5.1:5.5":"Chaḷabhiññā [cha mebhiññā (syā. ka.)] sacchikatā, kataṃ buddhassa sāsanan”ti.","thig5.1:6.1":"… Aññatarā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1130,"to":1130,"paras":[{"para":1130,"vripara":null,"refs":["thig5.1:5"],"lines":["<b>Cetopariccañāṇañcā</b>ti cetopariyañāṇañca visodhitanti sambandho, adhigatanti attho.","Sesaṃ vuttanayameva."],"lineRefs":[["thig5.1:5"],["thig5.1:5"]]}],"wordLinks":[["thig5.1:5.1","cetopariccañāṇañcā",0,0]],"before":[{"para":1105,"vripara":null,"refs":[],"lines":["Bhaddākāpilānītherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1106,"vripara":null,"refs":[],"lines":["Catukkanipātavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1107,"vripara":null,"refs":[],"lines":["Pañcakanipāto"],"lineRefs":[[]]},{"para":1108,"vripara":null,"refs":[],"lines":["Aññatarātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":1109,"vripara":null,"refs":[],"lines":["Pañcakanipāte <b>paṇṇavīsati vassānī</b>tiādikā aññatarāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī imasmiṃ buddhuppāde devadahanagare mahāpajāpatigotamiyā dhātī hutvā vaḍḍhesi.","Nāmagottato pana apaññātā ahosi.","Sā mahāpajāpatigotamiyā pabbajitakāle sayampi pabbajitvā pañcavīsati saṃvaccharāni kāmarāgena upaddutā accharāsaṅghātamattampi kālaṃ cittekaggataṃ alabhantī bāhā paggayha kandamānā dhammadinnātheriyā santike dhammaṃ sutvā kāmehi vinivattitamānasā kammaṭṭhānaṃ gahetvā bhāvanamanuyañjantī na cirasseva chaḷabhiññā hutvā attano paṭipattiṃ paccavekkhitvā udānavasena –"],"lineRefs":[[],[],[],[]]},{"para":1111,"vripara":"67","refs":[],"lines":["“Paṇṇavīsati vassāni, yato pabbajitā ahaṃ;"],"lineRefs":[[]]},{"para":1112,"vripara":null,"refs":[],"lines":["Nāccharāsaṅghātamattampi, cittassūpasamajjhagaṃ."],"lineRefs":[[]]},{"para":1114,"vripara":"68","refs":[],"lines":["“Aladdhā cetaso santiṃ, kāmarāgenavassutā;"],"lineRefs":[[]]},{"para":1115,"vripara":null,"refs":[],"lines":["Bāhā paggayha kandantī, vihāraṃ pāvisiṃ ahaṃ."],"lineRefs":[[]]},{"para":1117,"vripara":"69","refs":[],"lines":["“Sā bhikkhuniṃ upāgacchiṃ, yā me saddhāyikā ahu;"],"lineRefs":[[]]},{"para":1118,"vripara":null,"refs":[],"lines":["Sā me dhammamadesesi, khandhāyatanadhātuyo."],"lineRefs":[[]]},{"para":1120,"vripara":"70","refs":[],"lines":["“Tassā dhammaṃ suṇitvāna, ekamante upāvisiṃ;"],"lineRefs":[[]]},{"para":1121,"vripara":null,"refs":[],"lines":["Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ."],"lineRefs":[[]]},{"para":1123,"vripara":"71","refs":[],"lines":["“Cetopariccañāṇañca, sotadhātu visodhitā;"],"lineRefs":[[]]},{"para":1124,"vripara":null,"refs":[],"lines":["Iddhīpi me sacchikatā, patto me āsavakkhayo;"],"lineRefs":[[]]},{"para":1125,"vripara":null,"refs":[],"lines":["Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanan”ti.","–"],"lineRefs":[[],[]]},{"para":1126,"vripara":null,"refs":[],"lines":["Imā gāthā abhāsi."],"lineRefs":[[]]},{"para":1127,"vripara":null,"refs":[],"lines":["Tattha <b>nāccharāsaṅghātamattampī</b>ti accharāghaṭitamattampi khaṇaṃ aṅguliphoṭanamattampi kālanti attho.","<b>Cittassūpasamajjhagan</b>ti cittassa upasamaṃ cittekaggaṃ na ajjhaganti yojanā, na paṭilabhinti attho."],"lineRefs":[[],[]]},{"para":1128,"vripara":null,"refs":[],"lines":["<b>Kāmarāgenavassutā</b>ti kāmaguṇasaṅkhātesu vatthukāmesu daḷhatarābhinivesitāya bahalena chandarāgena tintacittā."],"lineRefs":[[]]},{"para":1129,"vripara":null,"refs":[],"lines":["<b>Bhikkhunin</b>ti dhammadinnattheriṃ sandhāya vadati."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
