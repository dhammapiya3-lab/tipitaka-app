{"suttaId":"thig5.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[296,312],"vripara":"67"},"segments":{"thig5.1:0.3":"Aññatarātherīgāthā","thig5.1:1.1":"“Paṇṇavīsativassāni,","thig5.1:1.2":"yato pabbajitā ahaṃ;","thig5.1:1.3":"Nāccharāsaṅghātamattampi,","thig5.1:1.4":"cittassūpasamajjhagaṃ.","thig5.1:2.1":"“Aladdhā cetaso santiṃ,","thig5.1:2.2":"kāmarāgenavassutā;","thig5.1:2.3":"Bāhā paggayha kandantī,","thig5.1:2.4":"vihāraṃ pāvisiṃ ahaṃ.","thig5.1:3.1":"“Sā bhikkhuniṃ upāgacchiṃ,","thig5.1:3.2":"yā me saddhāyikā ahu;","thig5.1:3.3":"Sā me dhammamadesesi,","thig5.1:3.4":"khandhāyatanadhātuyo.","thig5.1:4.1":"“Tassā dhammaṃ suṇitvāna,","thig5.1:4.2":"ekamante upāvisiṃ;","thig5.1:4.3":"Pubbenivāsaṃ jānāmi,","thig5.1:4.4":"dibbacakkhu visodhitaṃ.","thig5.1:5.1":"“Cetopariccañāṇañca [cetopariyañāṇañca (ka.)],","thig5.1:5.2":"sotadhātu visodhitā;","thig5.1:5.3":"Iddhīpi me sacchikatā,","thig5.1:5.4":"patto me āsavakkhayo;","thig5.1:5.5":"Chaḷabhiññā [cha mebhiññā (syā. ka.)] sacchikatā,","thig5.1:5.6":"kataṃ buddhassa sāsanan”ti.","thig5.1:6.1":"… Aññatarā therī …."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1130,"to":1130,"paras":[{"para":1130,"vripara":null,"refs":["thig5.1:5"],"lines":["<b>Cetopariccañāṇañcā</b>ti cetopariyañāṇañca visodhitanti sambandho, adhigatanti attho.","Sesaṃ vuttanayameva."],"lineRefs":[["thig5.1:5"],["thig5.1:5"]]}],"wordLinks":[["thig5.1:5.1","cetopariccañāṇañcā",0,0]],"before":[{"para":1107,"vripara":null,"title":"Pañcakanipāto","lines":["Pañcakanipāto"]},{"para":1108,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Aññatarātherīgāthāvaṇṇanā"]},{"para":1109,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Pañcakanipāte <b>paṇṇavīsati vassānī</b>tiādikā aññatarāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī imasmiṃ buddhuppāde devadahanagare mahāpajāpatigotamiyā dhātī hutvā vaḍḍhesi.","Nāmagottato pana apaññātā ahosi.","Sā mahāpajāpatigotamiyā pabbajitakāle sayampi pabbajitvā pañcavīsati saṃvaccharāni kāmarāgena upaddutā accharāsaṅghātamattampi kālaṃ cittekaggataṃ alabhantī bāhā paggayha kandamānā dhammadinnātheriyā santike dhammaṃ sutvā kāmehi vinivattitamānasā kammaṭṭhānaṃ gahetvā bhāvanamanuyañjantī na cirasseva chaḷabhiññā hutvā attano paṭipattiṃ paccavekkhitvā udānavasena –"]},{"para":1111,"vripara":"67","title":"Aññatarātherīgāthāvaṇṇanā","lines":["“Paṇṇavīsati vassāni, yato pabbajitā ahaṃ;"]},{"para":1112,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Nāccharāsaṅghātamattampi, cittassūpasamajjhagaṃ."]},{"para":1114,"vripara":"68","title":"Aññatarātherīgāthāvaṇṇanā","lines":["“Aladdhā cetaso santiṃ, kāmarāgenavassutā;"]},{"para":1115,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Bāhā paggayha kandantī, vihāraṃ pāvisiṃ ahaṃ."]},{"para":1117,"vripara":"69","title":"Aññatarātherīgāthāvaṇṇanā","lines":["“Sā bhikkhuniṃ upāgacchiṃ, yā me saddhāyikā ahu;"]},{"para":1118,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Sā me dhammamadesesi, khandhāyatanadhātuyo."]},{"para":1120,"vripara":"70","title":"Aññatarātherīgāthāvaṇṇanā","lines":["“Tassā dhammaṃ suṇitvāna, ekamante upāvisiṃ;"]},{"para":1121,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ."]},{"para":1123,"vripara":"71","title":"Aññatarātherīgāthāvaṇṇanā","lines":["“Cetopariccañāṇañca, sotadhātu visodhitā;"]},{"para":1124,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Iddhīpi me sacchikatā, patto me āsavakkhayo;"]},{"para":1125,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanan”ti.","–"]},{"para":1126,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Imā gāthā abhāsi."]},{"para":1127,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Tattha <b>nāccharāsaṅghātamattampī</b>ti accharāghaṭitamattampi khaṇaṃ aṅguliphoṭanamattampi kālanti attho.","<b>Cittassūpasamajjhagan</b>ti cittassa upasamaṃ cittekaggaṃ na ajjhaganti yojanā, na paṭilabhinti attho."]},{"para":1128,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["<b>Kāmarāgenavassutā</b>ti kāmaguṇasaṅkhātesu vatthukāmesu daḷhatarābhinivesitāya bahalena chandarāgena tintacittā."]},{"para":1129,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["<b>Bhikkhunin</b>ti dhammadinnattheriṃ sandhāya vadati."]}],"after":[{"para":1131,"vripara":null,"title":"Aññatarātherīgāthāvaṇṇanā","lines":["Aññatarātherīgāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
