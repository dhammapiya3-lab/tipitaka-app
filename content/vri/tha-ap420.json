{"suttaId":"tha-ap420","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[14498,14558],"vripara":"149"},"segments":{"tha-ap420:0.3":"Yāgudāyakattheraapadānaṃ","tha-ap420:1.1":"“Atithiṃ [atītaṃ (ka.)] me gahetvāna,","tha-ap420:1.2":"agacchiṃ gāmakaṃ tadā;","tha-ap420:1.3":"Sampuṇṇanadikaṃ disvā,","tha-ap420:1.4":"saṅghārāmaṃ upāgamiṃ.","tha-ap420:2.1":"“Āraññakā dhutadharā,","tha-ap420:2.2":"jhāyino lūkhacīvarā;","tha-ap420:2.3":"Vivekābhiratā dhīrā,","tha-ap420:2.4":"saṅghārāme vasanti te.","tha-ap420:3.1":"“Gati tesaṃ upacchinnā,","tha-ap420:3.2":"suvimuttāna tādinaṃ;","tha-ap420:3.3":"Piṇḍāya te na gacchanti,","tha-ap420:3.4":"oruddhanaditāya hi [oruddhanadikāyatiṃ (syā.)].","tha-ap420:4.1":"“Pasannacitto sumano,","tha-ap420:4.2":"vedajāto katañjalī;","tha-ap420:4.3":"Taṇḍulaṃ me gahetvāna,","tha-ap420:4.4":"yāgudānaṃ adāsahaṃ.","tha-ap420:5.1":"“Pañcannaṃ yāguṃ datvāna,","tha-ap420:5.2":"pasanno sehi pāṇibhi;","tha-ap420:5.3":"Sakakammābhiraddhohaṃ,","tha-ap420:5.4":"tāvatiṃsamagacchahaṃ.","tha-ap420:6.1":"“Maṇimayañca me byamhaṃ,","tha-ap420:6.2":"nibbatti tidase gaṇe;","tha-ap420:6.3":"Nārīgaṇehi sahito,","tha-ap420:6.4":"modāmi byamhamuttame.","tha-ap420:7.1":"“Tettiṃsakkhattuṃ devindo,","tha-ap420:7.2":"devarajjamakārayiṃ;","tha-ap420:7.3":"Tiṃsakkhattuṃ cakkavattī,","tha-ap420:7.4":"mahārajjamakārayiṃ.","tha-ap420:8.1":"“Padesarajjaṃ vipulaṃ,","tha-ap420:8.2":"gaṇanāto asaṅkhiyaṃ;","tha-ap420:8.3":"Devaloke manusse vā,","tha-ap420:8.4":"anubhotvā sayaṃ [yasaṃ (syā.)] ahaṃ.","tha-ap420:9.1":"“Pacchime bhave sampatte,","tha-ap420:9.2":"pabbajiṃ anagāriyaṃ;","tha-ap420:9.3":"Saha oropite kese,","tha-ap420:9.4":"sabbaṃ sampaṭivijjhahaṃ.","tha-ap420:10.1":"“Khayato vayato cāpi,","tha-ap420:10.2":"sammasanto kaḷevaraṃ;","tha-ap420:10.3":"Pure sikkhāpadādānā,","tha-ap420:10.4":"arahattamapāpuṇiṃ.","tha-ap420:11.1":"“Sudinnaṃ me dānavaraṃ,","tha-ap420:11.2":"vāṇijjaṃ sampayojitaṃ;","tha-ap420:11.3":"Teneva yāgudānena,","tha-ap420:11.4":"pattomhi acalaṃ padaṃ.","tha-ap420:12.1":"“Sokaṃ pariddavaṃ byādhiṃ,","tha-ap420:12.2":"darathaṃ cittatāpanaṃ;","tha-ap420:12.3":"Nābhijānāmi uppannaṃ,","tha-ap420:12.4":"yāgudānassidaṃ phalaṃ.","tha-ap420:13.1":"“Yāguṃ saṅghassa datvāna,","tha-ap420:13.2":"puññakkhette anuttare;","tha-ap420:13.3":"Pañcānisaṃse anubhomi,","tha-ap420:13.4":"aho yāgusuyiṭṭhatā.","tha-ap420:14.1":"“Abyādhitā rūpavatā,","tha-ap420:14.2":"khippaṃ dhammanisantitā [nibujjhitā (syā.)];","tha-ap420:14.3":"Lābhitā annapānassa,","tha-ap420:14.4":"āyu pañcamakaṃ mama.","tha-ap420:15.1":"“Yo koci vedaṃ janayaṃ,","tha-ap420:15.2":"saṅghe yāguṃ dadeyya so;","tha-ap420:15.3":"Imāni pañca ṭhānāni,","tha-ap420:15.4":"paṭigaṇheyya paṇḍito.","tha-ap420:16.1":"“Karaṇīyaṃ kataṃ sabbaṃ,","tha-ap420:16.2":"bhavā ugghāṭitā mayā;","tha-ap420:16.3":"Sabbāsavā parikkhīṇā,","tha-ap420:16.4":"natthi dāni punabbhavo.","tha-ap420:17.1":"“So ahaṃ vicarissāmi,","tha-ap420:17.2":"gāmā gāmaṃ purā puraṃ;","tha-ap420:17.3":"Namassamāno sambuddhaṃ,","tha-ap420:17.4":"dhammassa ca sudhammataṃ.","tha-ap420:18.1":"“Tiṃsakappasahassamhi,","tha-ap420:18.2":"yaṃ dānamadadiṃ tadā;","tha-ap420:18.3":"Duggatiṃ nābhijānāmi,","tha-ap420:18.4":"yāgudānassidaṃ phalaṃ.","tha-ap420:19.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap420:19.3":"viharāmi anāsavo.","tha-ap420:20.1":"“Svāgataṃ vata me āsi … pe …","tha-ap420:20.3":"kataṃ buddhassa sāsanaṃ.","tha-ap420:21.1":"“Paṭisambhidā catasso … pe …","tha-ap420:21.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap420:22.1":"Itthaṃ sudaṃ āyasmā yāgudāyako thero imā gāthāyo abhāsitthāti.","tha-ap420:23.1":"Yāgudāyakattherassāpadānaṃ aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":1489,"to":1569,"paras":[{"para":1489,"vripara":"149","refs":["tha-ap420:1"],"lines":["Asokā ca “adhimuttā asokā ca, bhaginīmālā ca pupphitā;"],"lineRefs":[["tha-ap420:1"]]},{"para":1490,"vripara":null,"refs":["tha-ap420:1"],"lines":["Aṅkolā bimbijālā ca, pupphitā mama assame”."],"lineRefs":[["tha-ap420:1"]]},{"para":1491,"vripara":null,"refs":["tha-ap420:1"],"lines":["Tattha pupphitā <b>adhimuttaka</b> rukkhā ca pupphitā <b>asoka</b> rukkhā ca pupphitā <b>bhaginīmālā ca</b> pupphitā <b>aṅkolā</b> ca pupphitā <b>bimbijālā</b> ca ete rukkhā mama assame phullitā sobhayantīti sambandho."],"lineRefs":[["tha-ap420:1"]]},{"para":1493,"vripara":"150","refs":["tha-ap420:2"],"lines":["“Ketakā kandali ceva, godhukā tiṇasūlikā;"],"lineRefs":[["tha-ap420:2"]]},{"para":1494,"vripara":null,"refs":["tha-ap420:2"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap420:2"]]},{"para":1495,"vripara":null,"refs":["tha-ap420:2"],"lines":["Tattha <b>ketakā</b>ti sugandhaketakagacchā ca.","<b>Kandali</b> rukkhā ca <b>godhuka</b> rukkhā ca <b>tiṇasūlika</b> gacchā ca ete sabbe rukkhajātikā dibbagandhaṃ pavāyamānā mama assamaṃ sakalaṃ sobhayantīti attho."],"lineRefs":[["tha-ap420:2"],["tha-ap420:2"]]},{"para":1497,"vripara":"151","refs":["tha-ap420:3"],"lines":["“Kaṇikārā kaṇṇikā ca, asanā ajjunā bahū;"],"lineRefs":[["tha-ap420:3"]]},{"para":1498,"vripara":null,"refs":["tha-ap420:3"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap420:3"]]},{"para":1499,"vripara":null,"refs":["tha-ap420:3"],"lines":["Ete kaṇikārādayo rukkhā mama assamaṃ sakalaṃ sobhayantā dibbagandhaṃ sampavāyantīti sambandho."],"lineRefs":[["tha-ap420:3"]]},{"para":1501,"vripara":"152","refs":["tha-ap420:4"],"lines":["“Punnāgā giripunnāgā, koviḷārā ca pupphitā;"],"lineRefs":[["tha-ap420:4"]]},{"para":1502,"vripara":null,"refs":["tha-ap420:4"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap420:4"]]},{"para":1503,"vripara":null,"refs":["tha-ap420:4"],"lines":["Punnāgādayo rukkhā dibbagandhaṃ pavāyamānā mama assamaṃ sobhayantīti attho."],"lineRefs":[["tha-ap420:4"]]},{"para":1505,"vripara":"153","refs":["tha-ap420:5"],"lines":["“Uddālakā ca kuṭajā, kadambā vakulā bahū;"],"lineRefs":[["tha-ap420:5"]]},{"para":1506,"vripara":null,"refs":["tha-ap420:5"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap420:5"]]},{"para":1507,"vripara":null,"refs":["tha-ap420:5"],"lines":["Uddālakādayo rukkhā dibbagandhaṃ vāyamānā mama assamaṃ sobhayantīti sambandho."],"lineRefs":[["tha-ap420:5"]]},{"para":1509,"vripara":"154","refs":["tha-ap420:6"],"lines":["“Āḷakā isimuggā ca, kadalimātuluṅgiyo;"],"lineRefs":[["tha-ap420:6"]]},{"para":1510,"vripara":null,"refs":["tha-ap420:6"],"lines":["Gandhodakena saṃvaḍḍhā, phalāni dhārayanti te”."],"lineRefs":[["tha-ap420:6"]]},{"para":1511,"vripara":null,"refs":["tha-ap420:6"],"lines":["Tattha ete āḷakādayo gacchā candanādisugandhagandhodakena vaḍḍhitvā suvaṇṇaphalāni dhārentā mama assamaṃ sobhayantīti attho."],"lineRefs":[["tha-ap420:6"]]},{"para":1513,"vripara":"155","refs":["tha-ap420:7"],"lines":["“Aññe pupphanti padumā, aññe jāyanti kesarī;"],"lineRefs":[["tha-ap420:7"]]},{"para":1514,"vripara":null,"refs":["tha-ap420:7"],"lines":["Aññe opupphā padumā, pupphitā taḷāke tadā”."],"lineRefs":[["tha-ap420:7"]]},{"para":1515,"vripara":null,"refs":["tha-ap420:7"],"lines":["Tattha <b>aññe pupphanti padumā</b>ti mama assamassa avidūre taḷāke aññe ekacce padumā pupphanti, ekacce <b>kesarī</b> padumā <b>jāyanti</b> nibbattanti, ekacce padumā <b>opupphā</b> vigalitapattakesarāti attho."],"lineRefs":[["tha-ap420:7"]]},{"para":1517,"vripara":"156","refs":["tha-ap420:8"],"lines":["“Gabbhaṃ gaṇhanti padumā, niddhāvanti muḷāliyo;"],"lineRefs":[["tha-ap420:8"]]},{"para":1518,"vripara":null,"refs":["tha-ap420:8"],"lines":["Siṅghāṭipattamākiṇṇā, sobhanti taḷāke tadā”."],"lineRefs":[["tha-ap420:8"]]},{"para":1519,"vripara":null,"refs":["tha-ap420:8"],"lines":["Tattha <b>gabbhaṃ gaṇhanti padumā</b>ti tadā tāpasena hutvā mama vasanasamaye ekacce padumā taḷākabbhantare makuḷapupphādayo gaṇhanti.","<b>Muḷāliyo</b> padumamūlā <b>niddhāvanti</b> ito kaddamabbhantarato hatthidāṭhā viya gacchantīti attho.","Pattapupphamākiṇṇā gahanībhūtā siṅghāṭiyo sobhayantīti attho."],"lineRefs":[["tha-ap420:8"],["tha-ap420:8"],["tha-ap420:8"]]},{"para":1521,"vripara":"157","refs":["tha-ap420:9"],"lines":["“Nayitā ambagandhī ca, uttalī bandhujīvakā;"],"lineRefs":[["tha-ap420:9"]]},{"para":1522,"vripara":null,"refs":["tha-ap420:9"],"lines":["Dibbagandhā sampavanti, pupphitā taḷāke tadā”."],"lineRefs":[["tha-ap420:9"]]},{"para":1523,"vripara":null,"refs":["tha-ap420:9"],"lines":["<b>Tadā</b> mama vasanasamaye taḷākassa samīpe <b>nayitā</b> ca gacchā <b>ambagandhī ca</b> gacchā <b>uttalī</b> nāma gacchā ca <b>bandhujīvakā</b> ca ete sabbe gacchā <b>pupphitā</b> pupphadhāritā sugandhavāhakā taḷākaṃ sobhayantīti attho."],"lineRefs":[["tha-ap420:9"]]},{"para":1525,"vripara":"158","refs":["tha-ap420:10"],"lines":["“Pāṭhīnā pāvusā macchā, balajā muñjarohitā;"],"lineRefs":[["tha-ap420:10"]]},{"para":1526,"vripara":null,"refs":["tha-ap420:10"],"lines":["Saṃgulā maggurā ceva, vasanti taḷāke tadā”."],"lineRefs":[["tha-ap420:10"]]},{"para":1527,"vripara":null,"refs":["tha-ap420:10"],"lines":["<b>Tadā</b> mama vasanasamaye nibbhītā pāṭhīnādayo macchā <b>taḷāke</b> vasantīti sambandho."],"lineRefs":[["tha-ap420:10"]]},{"para":1529,"vripara":"159","refs":["tha-ap420:11"],"lines":["“Kumbhīlā susumārā ca, tantigāhā ca rakkhasā;"],"lineRefs":[["tha-ap420:11"]]},{"para":1530,"vripara":null,"refs":["tha-ap420:11"],"lines":["Oguhā ajagarā ca, vasanti taḷāke tadā”."],"lineRefs":[["tha-ap420:11"]]},{"para":1531,"vripara":null,"refs":["tha-ap420:11"],"lines":["<b>Tadā</b> mama vasanasamaye mama assamasamīpe <b>taḷāke</b> ete kumbhīlādayo macchā nibbhītā nirūpaddavā vasantīti sambandho."],"lineRefs":[["tha-ap420:11"]]},{"para":1533,"vripara":"160","refs":["tha-ap420:12"],"lines":["“Pārevatā ravihaṃsā, cakkavākā nadīcarā;"],"lineRefs":[["tha-ap420:12"]]},{"para":1534,"vripara":null,"refs":["tha-ap420:12"],"lines":["Kokilā sukasāḷikā, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap420:12"]]},{"para":1535,"vripara":null,"refs":["tha-ap420:12"],"lines":["Tattha mama assamasamīpe saraṃ nissāya <b>pārevatā</b> pakkhī ca <b>ravihaṃsā</b> pakkhī ca <b>nadīcarā cakkavāka</b> pakkhī ca <b>kokilā</b> pakkhī ca <b>suka</b> pakkhī ca <b>sāḷikā</b> pakkhī ca taṃ saraṃ upanissāya jīvantīti sambandho."],"lineRefs":[["tha-ap420:12"]]},{"para":1537,"vripara":"161","refs":["tha-ap420:13"],"lines":["“Kukutthakā kuḷīrakā, vane pokkharasātakā;"],"lineRefs":[["tha-ap420:13"]]},{"para":1538,"vripara":null,"refs":["tha-ap420:13"],"lines":["Dindibhā suvapotā ca, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap420:13"]]},{"para":1539,"vripara":null,"refs":["tha-ap420:13"],"lines":["Tattha <b>kukutthakā</b>ti evaṃnāmikā pakkhī ca.","<b>Kuḷīrakā</b>ti evaṃnāmikā pakkhī ca.","Vane <b>pokkharasātakā</b> pakkhī ca <b>dindibhā</b> pakkhī ca <b>suvapotā</b> pakkhī ca ete sabbe pakkhino taṃ mama assamasamīpe saraṃ nissāya jīvantīti sambandho."],"lineRefs":[["tha-ap420:13"],["tha-ap420:13"],["tha-ap420:13"]]},{"para":1541,"vripara":"162","refs":["tha-ap420:14"],"lines":["“Haṃsā koñcā mayūrā ca, kokilā tambacūḷakā;"],"lineRefs":[["tha-ap420:14"]]},{"para":1542,"vripara":null,"refs":["tha-ap420:14"],"lines":["Pammakā jīvaṃjīvā ca, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap420:14"]]},{"para":1543,"vripara":null,"refs":["tha-ap420:14"],"lines":["Sabbe ete haṃsādayo pakkhino taṃ saraṃ upanissāya jīvanti jīvikaṃ pālentīti attho."],"lineRefs":[["tha-ap420:14"]]},{"para":1545,"vripara":"163","refs":["tha-ap420:15"],"lines":["“Kosikā poṭṭhasīsā ca, kurarā senakā bahū;"],"lineRefs":[["tha-ap420:15"]]},{"para":1546,"vripara":null,"refs":["tha-ap420:15"],"lines":["Mahākāḷā ca sakuṇā, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap420:15"]]},{"para":1547,"vripara":null,"refs":["tha-ap420:15"],"lines":["Tattha <b>kosikā</b> ca pakkhī <b>poṭṭhasīsā</b> ca pakkhī <b>kurarā</b> ca pakkhī <b>senakā</b> ca pakkhī <b>mahākāḷā</b> ca pakkhī thale <b>bahū</b> pakkhino taṃ saraṃ tassa sarassa samīpe <b>jīvanti</b> jīvikaṃ kappentīti attho."],"lineRefs":[["tha-ap420:15"]]},{"para":1549,"vripara":"164","refs":["tha-ap420:16"],"lines":["“Pasadā ca varāhā ca, camarā gaṇḍakā bahū;"],"lineRefs":[["tha-ap420:16"]]},{"para":1550,"vripara":null,"refs":["tha-ap420:16"],"lines":["Rohiccā sukapotā ca, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap420:16"]]},{"para":1551,"vripara":null,"refs":["tha-ap420:16"],"lines":["Tattha pasadādayo ete migā <b>taṃ saraṃ</b> tasmiṃ sarasamīpe, bhummatthe upayogavacanaṃ, jīvitaṃ paripālentā viharantīti attho."],"lineRefs":[["tha-ap420:16"]]},{"para":1553,"vripara":"165","refs":["tha-ap420:17"],"lines":["“Sīhabyagghā ca dīpī ca, acchakokataracchakā;"],"lineRefs":[["tha-ap420:17"]]},{"para":1554,"vripara":null,"refs":["tha-ap420:17"],"lines":["Tidhā pabhinnamātaṅgā, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap420:17"]]},{"para":1555,"vripara":null,"refs":["tha-ap420:17"],"lines":["Ete sīhādayo catuppadā sarasamīpe upaddavarahitā jīvantīti sambandho."],"lineRefs":[["tha-ap420:17"]]},{"para":1557,"vripara":"166","refs":["tha-ap420:18"],"lines":["“Kinnarā vānarā ceva, athopi vanakammikā;"],"lineRefs":[["tha-ap420:18"]]},{"para":1558,"vripara":null,"refs":["tha-ap420:18"],"lines":["Cetā ca luddakā ceva, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap420:18"]]},{"para":1559,"vripara":null,"refs":["tha-ap420:18"],"lines":["Ettha ete evaṃnāmikā kinnarādayo sattā tasmiṃ sarasamīpe vasantīti attho."],"lineRefs":[["tha-ap420:18"]]},{"para":1561,"vripara":"167","refs":["tha-ap420:19"],"lines":["“Tindukāni piyālāni, madhukekā sumāriyo;"],"lineRefs":[["tha-ap420:19"]]},{"para":1562,"vripara":null,"refs":["tha-ap420:19"],"lines":["Dhuvaṃ phalāni dhārenti, avidūre mamassamaṃ”."],"lineRefs":[["tha-ap420:19"]]},{"para":1563,"vripara":null,"refs":["tha-ap420:19"],"lines":["Tattha ete tindukādayo rukkhā dhuvaṃ hemantagimhavassānasaṅkhāte kālattaye mama assamato avidūre ṭhāne madhuraphalāni dhārentīti sambandho."],"lineRefs":[["tha-ap420:19"]]},{"para":1565,"vripara":"168","refs":["tha-ap420:20"],"lines":["“Kosambā saḷalā nimbā, sāduphalasamāyutā;"],"lineRefs":[["tha-ap420:20"]]},{"para":1566,"vripara":null,"refs":["tha-ap420:20"],"lines":["Dhuvaṃ phalāni dhārenti, avidūre mamassamaṃ”."],"lineRefs":[["tha-ap420:20"]]},{"para":1567,"vripara":null,"refs":["tha-ap420:20"],"lines":["Tattha ete kosambādayo rukkhā sāraphalā madhuraphalā uttamaphalā <b>samāyutā saṃ</b> suṭṭhu āyutā samaṅgībhūtā niccaṃ phaladhārino mama assamasamīpe sobhantīti attho."],"lineRefs":[["tha-ap420:20"]]},{"para":1569,"vripara":"169","refs":["tha-ap420:21"],"lines":["“Harītakā āmalakā, ambajambuvibhītakā;"],"lineRefs":[["tha-ap420:21"]]}],"wordLinks":[]},"tika":null,"tika2":null}
