{"suttaId":"tha-ap284","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8720,8738],"vripara":"5"},"segments":{"tha-ap284:0.3":"Phaladāyakattheraapadānaṃ","tha-ap284:1.1":"“Sinerusamasantoso,","tha-ap284:1.2":"dharaṇīsama [dharaṇīdhara (sī. syā.)] sādiso;","tha-ap284:1.3":"Vuṭṭhahitvā samādhimhā,","tha-ap284:1.4":"bhikkhāya mamupaṭṭhito.","tha-ap284:2.1":"“Harītakaṃ [harītakiṃ (syā.)] āmalakaṃ,","tha-ap284:2.2":"ambajambuvibhītakaṃ;","tha-ap284:2.3":"Kolaṃ bhallātakaṃ billaṃ,","tha-ap284:2.4":"phārusakaphalāni ca.","tha-ap284:3.1":"“Siddhatthassa mahesissa,","tha-ap284:3.2":"sabbalokānukampino;","tha-ap284:3.3":"Tañca sabbaṃ mayā dinnaṃ,","tha-ap284:3.4":"vippasannena cetasā.","tha-ap284:4.1":"“Catunnavutito kappe,","tha-ap284:4.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap284:4.3":"Duggatiṃ nābhijānāmi,","tha-ap284:4.4":"phaladānassidaṃ phalaṃ.","tha-ap284:5.1":"“Sattapaññāsito kappe,","tha-ap284:5.2":"ekajjho nāma khattiyo;","tha-ap284:5.3":"Sattaratanasampanno,","tha-ap284:5.4":"cakkavattī mahabbalo.","tha-ap284:6.1":"“Paṭisambhidā catasso … pe …","tha-ap284:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap284:7.1":"Itthaṃ sudaṃ āyasmā phaladāyako thero imā gāthāyo abhāsitthāti.","tha-ap284:8.1":"Phaladāyakattherassāpadānaṃ dutiyaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3244,"to":3244,"paras":[{"para":3244,"vripara":"5-7","refs":["tha-ap284:1"],"lines":["5-7. Dutiyāpadāne sinerusamasantoso dharaṇīsamasādiso siddhattho bhagavāti sambandho.","<b>Vuṭṭhahitvā samādhimhā</b>ti nirodhasamāpattito vuṭṭhahitvā visuṃ hutvāti attho.","<b>Bhikkhāya mamupaṭṭhito</b>ti bhikkhācāravelāya “ajja mama yo koci kiñci dānaṃ dadāti, tassa mahapphalan”ti cintetvā nisinnassa mama santikaṃ samīpaṃ upaṭṭhito samīpamāgatoti attho.","<b>Harītakaṃ … pe … phārusakaphalāni cā</b>ti evaṃ sabbaṃ taṃ phalaṃ sabbalokānukampino tassa <b>siddhatthassa mahesissa</b> mayā vippasannena cetasā dinnanti attho."],"lineRefs":[["tha-ap284:1"],["tha-ap284:1"],["tha-ap284:1"],["tha-ap284:1"]]}],"wordLinks":[["tha-ap284:1.3","vuṭṭhahitvā samādhimhā",0,1],["tha-ap284:1.3","bhikkhāya mamupaṭṭhito",0,2]]},"tika":null,"tika2":null}
