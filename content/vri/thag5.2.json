{"suttaId":"thag5.2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1523,1538],"vripara":"320"},"segments":{"thag5.2:0.4":"Subhūtattheragāthā","thag5.2:1.1":"“Ayoge yuñjamattānaṃ,","thag5.2:1.2":"puriso kiccamicchako [kiccamicchato (sī.), kiccamicchayaṃ (katthaci)];","thag5.2:1.3":"Caraṃ ce nādhigaccheyya,","thag5.2:1.4":"‘taṃ me dubbhagalakkhaṇaṃ’.","thag5.2:2.1":"“Abbūḷhaṃ aghagataṃ vijitaṃ,","thag5.2:2.2":"ekañce ossajeyya kalīva siyā;","thag5.2:2.3":"Sabbānipi ce ossajeyya andhova siyā,","thag5.2:2.4":"samavisamassa adassanato.","thag5.2:3.1":"“Yañhi kayirā tañhi vade,","thag5.2:3.2":"yaṃ na kayirā na taṃ vade;","thag5.2:3.3":"Akarontaṃ bhāsamānaṃ,","thag5.2:3.4":"parijānanti paṇḍitā.","thag5.2:4.1":"[dha. pa.51 dhammapadepi]“Yathāpi ruciraṃ pupphaṃ,","thag5.2:4.2":"vaṇṇavantaṃ agandhakaṃ;","thag5.2:4.3":"Evaṃ subhāsitā vācā,","thag5.2:4.4":"aphalā hoti akubbato.","thag5.2:5.1":"[dha. pa.52]“Yathāpi ruciraṃ pupphaṃ,","thag5.2:5.2":"vaṇṇavantaṃ sugandhakaṃ [sagandhakaṃ (sī. syā. pī.)];","thag5.2:5.3":"Evaṃ subhāsitā vācā,","thag5.2:5.4":"saphalā hoti kubbato”ti [sakubbato (sī. pī.), sukubbato (syā.)].","thag5.2:5.5":"… Subhūto thero …."},"unsure":[],"preface":[],"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":519,"to":520,"paras":[{"para":519,"vripara":null,"refs":["thag5.2:5"],"lines":["<b>Yathā</b>ti opammasampaṭipādanatthe nipāto.","<b>Ruciran</b>ti sobhanaṃ.","<b>Vaṇṇavantan</b>ti vaṇṇasaṇṭhānasampannaṃ.","<b>Agandhakan</b>ti gandharahitaṃ pālibhaddakagirikaṇṇikajayasumanādibhedaṃ.","<b>Evaṃ subhāsitā vācā</b>ti subhāsitā vācā nāma tepiṭakaṃ buddhavacanaṃ vaṇṇasaṇṭhānasampannapupphasadisaṃ.","Yathā hi agandhakaṃ pupphaṃ dhārentassa sarīre gandho na pharati, evaṃ etampi yo sakkaccasavanādīhi ca samācarati, tassa sakkaccaṃ asamācarantassa yaṃ tattha kattabbaṃ, taṃ akubbato sutagandhaṃ paṭipattigandhañca na āvahati aphalā hoti.","Tena vuttaṃ “evaṃ subhāsitā vācā, aphalā hoti akubbato”ti."],"lineRefs":[["thag5.2:5"],["thag5.2:5"],["thag5.2:5"],["thag5.2:5"],["thag5.2:5"],["thag5.2:5"],["thag5.2:5"]]},{"para":520,"vripara":null,"refs":["thag5.2:5"],"lines":["<b>Sugandhakan</b>ti sumanacampakanīluppalapupphādibhedaṃ.","<b>Evan</b>ti yathā taṃ pupphaṃ dhārentassa sarīre gandho pharati, evaṃ tepiṭakabuddhavacanasaṅkhātā subhāsitā vācāpi yo sakkaccasavanādīhi tattha kattabbaṃ karoti, assa puggalassa saphalā hoti, sutagandhapaṭipattigandhānaṃ āvahanato mahapphalā hoti mahānisaṃsā.","Tasmā yathovādaṃ paṭipajjeyya, yathākārī tathāvādī ca bhaveyyāti.","Sesaṃ vuttanayameva."],"lineRefs":[["thag5.2:5"],["thag5.2:5"],["thag5.2:5"],["thag5.2:5"]]}],"wordLinks":[["thag5.2:5.1","yathā",0,0],["thag5.2:5.1","ruciraṃ",0,1],["thag5.2:5.1","vaṇṇavantaṃ",0,2],["thag5.2:5.3","evaṃ subhāsitā vācā",0,4],["thag5.2:5.1","sugandhakaṃ",1,0],["thag5.2:5.3","evaṃ",1,1]],"after":[{"para":521,"vripara":null,"title":"Subhūtattheragāthāvaṇṇanā","lines":["Subhūtattheragāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
