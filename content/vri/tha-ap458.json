{"suttaId":"tha-ap458","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1179,1194],"vripara":"32"},"segments":{"tha-ap458:0.3":"Vanakoraṇḍiyattheraapadānaṃ","tha-ap458:1.1":"“Siddhatthassa bhagavato,","tha-ap458:1.2":"lokajeṭṭhassa tādino;","tha-ap458:1.3":"Vanakoraṇḍamādāya,","tha-ap458:1.4":"buddhassa abhiropayiṃ. 33.","tha-ap458:2.1":"“Catunnavutito kappe,","tha-ap458:2.2":"yaṃ pupphamabhiropayiṃ;","tha-ap458:2.3":"Duggatiṃ nābhijānāmi,","tha-ap458:2.4":"buddhapūjāyidaṃ phalaṃ. 34.","tha-ap458:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap458:3.3":"viharāmi anāsavo. 35.","tha-ap458:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap458:4.3":"kataṃ buddhassa sāsanaṃ. 36.","tha-ap458:5.1":"“Paṭisambhidā catasso…pe…","tha-ap458:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap458:6.1":"Itthaṃ sudaṃ āyasmā vanakoraṇḍiyo thero imā gāthāyo Abhāsitthāti.","tha-ap458:7.1":"Vanakoraṇḍiyattherassāpadānaṃ chaṭṭhaṃ.","tha-ap458:7.2":"Vīsatimaṃ bhāṇavāraṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
