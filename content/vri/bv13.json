{"suttaId":"bv13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[1793,1884],"vripara":"1"},"segments":{"bv13:0.2":"Sumedhabuddhavaṃso","bv13:1.1":"Padumuttarassa aparena,","bv13:1.2":"sumedho nāma nāyako;","bv13:1.3":"Durāsado uggatejo,","bv13:1.4":"sabbalokuttamo muni.","bv13:2.1":"Pasannanetto sumukho,","bv13:2.2":"brahā uju patāpavā;","bv13:2.3":"Hitesī sabbasattānaṃ,","bv13:2.4":"bahū mocesi bandhanā.","bv13:3.1":"Yadā buddho pāpuṇitvā,","bv13:3.2":"kevalaṃ bodhimuttamaṃ;","bv13:3.3":"Sudassanamhi nagare,","bv13:3.4":"dhammacakkaṃ pavattayi.","bv13:4.1":"Tassāpi abhisamayā tīṇi,","bv13:4.2":"ahesuṃ dhammadesane;","bv13:4.3":"Koṭisatasahassānaṃ,","bv13:4.4":"paṭhamābhisamayo ahu.","bv13:5.1":"Punāparaṃ kumbhakaṇṇaṃ,","bv13:5.2":"yakkhaṃ so damayī jino;","bv13:5.3":"Navutikoṭisahassānaṃ,","bv13:5.4":"dutiyābhisamayo ahu.","bv13:6.1":"Punāparaṃ amitayaso,","bv13:6.2":"catusaccaṃ pakāsayi;","bv13:6.3":"Asītikoṭisahassānaṃ,","bv13:6.4":"tatiyābhisamayo ahu.","bv13:7.1":"Sannipātā tayo āsuṃ,","bv13:7.2":"sumedhassa mahesino;","bv13:7.3":"Khīṇāsavānaṃ vimalānaṃ,","bv13:7.4":"santacittāna tādinaṃ.","bv13:8.1":"Sudassanaṃ nāma nagaraṃ,","bv13:8.2":"upagañchi jino yadā;","bv13:8.3":"Tadā khīṇāsavā bhikkhū,","bv13:8.4":"samiṃsu satakoṭiyo.","bv13:9.1":"Punāparaṃ devakūṭe,","bv13:9.2":"bhikkhūnaṃ kathinatthate;","bv13:9.3":"Tadā navutikoṭīnaṃ,","bv13:9.4":"dutiyo āsi samāgamo.","bv13:10.1":"Punāparaṃ dasabalo,","bv13:10.2":"yadā carati cārikaṃ;","bv13:10.3":"Tadā asītikoṭīnaṃ,","bv13:10.4":"tatiyo āsi samāgamo.","bv13:11.1":"Ahaṃ tena samayena,","bv13:11.2":"uttaro nāma māṇavo;","bv13:11.3":"Asītikoṭiyo mayhaṃ,","bv13:11.4":"ghare sannicitaṃ dhanaṃ.","bv13:12.1":"Kevalaṃ sabbaṃ datvāna,","bv13:12.2":"sasaṅghe lokanāyake;","bv13:12.3":"Saraṇaṃ tassupagañchiṃ,","bv13:12.4":"pabbajjañcābhirocayiṃ.","bv13:13.1":"Sopi maṃ buddho byākāsi,","bv13:13.2":"karonto anumodanaṃ;","bv13:13.3":"“Tiṃsakappasahassamhi,","bv13:13.4":"ayaṃ buddho bhavissati.","bv13:14.1":"“Padhānaṃ padahitvāna … pe …","bv13:14.3":"hessāma sammukhā imaṃ”.","bv13:15.1":"Tassāpi vacanaṃ sutvā,","bv13:15.2":"bhiyyo cittaṃ pasādayiṃ;","bv13:15.3":"Uttariṃ vatamadhiṭṭhāsiṃ,","bv13:15.4":"dasapāramipūriyā.","bv13:16.1":"Suttantaṃ vinayañcāpi,","bv13:16.2":"navaṅgaṃ satthusāsanaṃ;","bv13:16.3":"Sabbaṃ pariyāpuṇitvāna,","bv13:16.4":"sobhayiṃ jinasāsanaṃ.","bv13:17.1":"Tatthappamatto viharanto,","bv13:17.2":"nisajjaṭṭhānacaṅkame;","bv13:17.3":"Abhiññāsu pāramiṃ gantvā,","bv13:17.4":"brahmalokamagañchahaṃ.","bv13:18.1":"Sudassanaṃ nāma nagaraṃ,","bv13:18.2":"sudatto nāma khattiyo;","bv13:18.3":"Sudattā nāma janikā,","bv13:18.4":"sumedhassa mahesino.","bv13:19.1":"Navavassasahassāni,","bv13:19.2":"agāraṃ ajjha so vasi;","bv13:19.3":"Sucandakañcanasirivaḍḍhā,","bv13:19.4":"tayo pāsādamuttamā.","bv13:20.1":"Tisoḷasasahassāni,","bv13:20.2":"nāriyo samalaṅkatā;","bv13:20.3":"Sumanā nāma sā nārī,","bv13:20.4":"punabbasu nāma atrajo.","bv13:21.1":"Nimitte caturo disvā,","bv13:21.2":"hatthiyānena nikkhami;","bv13:21.3":"Anūnakaṃ aḍḍhamāsaṃ,","bv13:21.4":"padhānaṃ padahī jino.","bv13:22.1":"Brahmunā yācito santo,","bv13:22.2":"sumedho lokanāyako;","bv13:22.3":"Vatti cakkaṃ mahāvīro,","bv13:22.4":"sudassanuyyānamuttame.","bv13:23.1":"Saraṇo sabbakāmo ca,","bv13:23.2":"ahesuṃ aggasāvakā;","bv13:23.3":"Sāgaro nāmupaṭṭhāko,","bv13:23.4":"sumedhassa mahesino.","bv13:24.1":"Rāmā ceva surāmā ca,","bv13:24.2":"ahesuṃ aggasāvikā;","bv13:24.3":"Bodhi tassa bhagavato,","bv13:24.4":"mahānīpoti vuccati.","bv13:25.1":"Uruvelā yasavā ca,","bv13:25.2":"ahesuṃ aggupaṭṭhakā;","bv13:25.3":"Yasodharā sirimā ca [yasā nāma sirimā ca (syā. kaṃ.)],","bv13:25.4":"ahesuṃ aggupaṭṭhikā.","bv13:26.1":"Aṭṭhāsītiratanāni,","bv13:26.2":"accuggato mahāmuni;","bv13:26.3":"Obhāseti disā sabbā,","bv13:26.4":"cando tāragaṇe yathā.","bv13:27.1":"Cakkavattimaṇī nāma,","bv13:27.2":"yathā tapati yojanaṃ;","bv13:27.3":"Tatheva tassa ratanaṃ,","bv13:27.4":"samantā pharati yojanaṃ.","bv13:28.1":"Navutivassasahassāni,","bv13:28.2":"āyu vijjati tāvade;","bv13:28.3":"Tāvatā tiṭṭhamāno so,","bv13:28.4":"tāresi janataṃ bahuṃ.","bv13:29.1":"Tevijjachaḷabhiññehi,","bv13:29.2":"balappattehi tādihi;","bv13:29.3":"Samākulamidaṃ āsi,","bv13:29.4":"arahantehi sādhuhi.","bv13:30.1":"Tepi sabbe amitayasā,","bv13:30.2":"vippamuttā nirūpadhī;","bv13:30.3":"Ñāṇālokaṃ dassayitvā,","bv13:30.4":"nibbutā te mahāyasā.","bv13:31.1":"Sumedho jinavaro buddho,","bv13:31.2":"medhārāmamhi nibbuto;","bv13:31.3":"Dhātuvitthārikaṃ āsi,","bv13:31.4":"tesu tesu padesatoti.","bv13:32.1":"Sumedhassa bhagavato vaṃso ekādasamo."},"unsure":[],"preface":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":2662,"to":2734,"paras":[{"para":2662,"vripara":null,"refs":["bv13:4"],"lines":["Tattha <b>uggatejo</b>ti uggatatejo.","<b>Pasannanetto</b>ti suṭṭhu pasannanayano, dhovitvā majjitvā ṭhapitamaṇiguḷikā viya pasannāni nettāni honti.","Tasmā so “pasannanetto”ti vutto.","Mudusiniddhanīlavimalasukhumapakhumācitasuppasannanayanoti attho.","“Suppasannapañcanayano” tipi vattuṃ vaṭṭati.","<b>Sumukho</b>ti paripuṇṇasaradasamayacandasadisavadano.","<b>Brahā</b>ti aṭṭhāsītihatthappamāṇasarīrattā brahā mahanto, aññehi asādhāraṇasarīrappamāṇoti attho.","<b>Ujū</b>ti brahmujugatto ujumeva uggatasarīro devanagare samussitasuvaṇṇatoraṇasadisavarasarīroti attho.","<b>Patāpavā</b>ti vijjotamānasarīro.","<b>Hitesī</b>ti hitagavesī.","<b>Abhisamayā tīṇī</b>ti abhisamayā tayo, liṅgavipallāso katoti."],"lineRefs":[["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"]]},{"para":2663,"vripara":null,"refs":["bv13:4"],"lines":["Yadā pana bhagavā kumbhakaṇṇasadisānubhāvaṃ kumbhakaṇṇaṃ nāma manussabhakkhaṃ yakkhaṃ mahāaṭavimukhe sandissamānaghorasarīraṃ vattaniaṭavisañcāraṃ pacchinditvā pavattamānaṃ paccūsasamaye mahākaruṇāsamāpattiṃ samāpajjitvā tato vuṭṭhāya lokaṃ olokento disvā ekakova asahāyo tassa yakkhassa bhavanaṃ gantvā anto pavisitvā paññatte sirisayane nisīdi.","Atha kho so yakkho makkhaṃ asahamāno daṇḍāhato ghoraviso āsiviso viya saṃkuddho dasabalaṃ bhiṃsāpetukāmo attano attabhāvaṃ ghorataraṃ katvā pabbatasadisaṃ sīsaṃ katvā sūriyamaṇḍalasadisāni akkhīni nimminitvā naṅgalasīsasadisātidīghavipulatikhiṇadāṭhāyo katvā olambanīlavipulavisamodaro tālakkhandhasadisabāhucipiṭakavirūpavaṅkanāso pabbatabilasadisavipularattamukho thūlapiṅgalakharapharusakeso atibhayānakadassano hutvā āgantvā sumedhassa bhagavato purato ṭhatvā padhūpāyanto pajjalanto pāsāṇapabbataggijāla-salila-kaddama-chārikāyudhaṅgāra-vālukappakārā <b>navavidhā vassavuṭṭhiyo</b> vassetvāpi bhagavato lomaggamattampi cāletuṃ asakkonto “bhagavantaṃ pañhaṃ pucchitvā māressāmī”ti āḷavako viya pañhaṃ pucchi.","Ayaṃ bhagavā pañhābyākaraṇena taṃ yakkhaṃ vinayamupanesi.","Tato dutiyadivase kirassa raṭṭhavāsino manussā sakaṭabharitena bhattena saha rājakumāraṃ āharitvā yakkhassa adaṃsu.","Atha yakkho rājakumāraṃ buddhassa adāsi.","Aṭavidvāre ṭhitamanussā bhagavantaṃ upasaṅkamiṃsu.","Tadā tasmiṃ samāgame dasabalo yakkhassa manonukūlaṃ dhammaṃ desento.","Navutikoṭisahassānaṃ pāṇīnaṃ dhammacakkhuṃ uppādesi, so dutiyo dhammābhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"]]},{"para":2665,"vripara":"5","refs":["bv13:4"],"lines":["“Punāparaṃ kumbhakaṇṇaṃ, yakkhaṃ so damayī jino;"],"lineRefs":[["bv13:4"]]},{"para":2666,"vripara":null,"refs":["bv13:4"],"lines":["Navutikoṭisahassānaṃ, dutiyābhisamayo ahū”ti."],"lineRefs":[["bv13:4"]]},{"para":2667,"vripara":null,"refs":["bv13:4"],"lines":["Yadā pana upakārinagare sirinandanuyyāne cattāri saccāni pakāsayi, tadā asītikoṭisatasahassānaṃ tatiyo dhammābhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[["bv13:4"],["bv13:4"]]},{"para":2669,"vripara":"6","refs":["bv13:4"],"lines":["“Punāparaṃ amitayaso, catusaccaṃ pakāsayi;"],"lineRefs":[["bv13:4"]]},{"para":2670,"vripara":null,"refs":["bv13:4"],"lines":["Asītikoṭisahassānaṃ, tatiyābhisamayo ahū”ti."],"lineRefs":[["bv13:4"]]},{"para":2671,"vripara":null,"refs":["bv13:4"],"lines":["Sumedhassāpi bhagavato tayo sāvakasannipātā ahesuṃ.","Paṭhamasannipāte sudassananagare koṭisatakhīṇāsavā ahesuṃ.","Puna devakūṭe pabbate kathinatthate dutiye navutikoṭiyo.","Puna tatiye bhagavati cārikaṃ caramāne asītikoṭiyo ahesuṃ.","Tena vuttaṃ –"],"lineRefs":[["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"]]},{"para":2673,"vripara":"7","refs":["bv13:4"],"lines":["“Sannipātā tayo āsuṃ, sumedhassa mahesino;"],"lineRefs":[["bv13:4"]]},{"para":2674,"vripara":null,"refs":["bv13:4"],"lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ."],"lineRefs":[["bv13:4"]]},{"para":2676,"vripara":"8","refs":["bv13:4"],"lines":["“Sudassanaṃ nāma nagaraṃ, upagañchi jino yadā;"],"lineRefs":[["bv13:4"]]},{"para":2677,"vripara":null,"refs":["bv13:4"],"lines":["Tadā khīṇāsavā bhikkhū, samiṃsu satakoṭiyo."],"lineRefs":[["bv13:4"]]},{"para":2679,"vripara":"9","refs":["bv13:4"],"lines":["“Punāparaṃ devakūṭe, bhikkhūnaṃ kathinatthate;"],"lineRefs":[["bv13:4"]]},{"para":2680,"vripara":null,"refs":["bv13:4"],"lines":["Tadā navutikoṭīnaṃ, dutiyo āsi samāgamo."],"lineRefs":[["bv13:4"]]},{"para":2682,"vripara":"10","refs":["bv13:4"],"lines":["“Punāparaṃ dasabalo, yadā carati cārikaṃ;"],"lineRefs":[["bv13:4"]]},{"para":2683,"vripara":null,"refs":["bv13:4"],"lines":["Tadā asītikoṭīnaṃ, tatiyo āsi samāgamo”ti."],"lineRefs":[["bv13:4"]]},{"para":2684,"vripara":null,"refs":["bv13:4"],"lines":["Tadā amhākaṃ bodhisatto uttaro nāma sabbajanuttaro māṇavo hutvā nidahitvā ṭhapitaṃyeva asītikoṭidhanaṃ vissajjetvā buddhappamukhassa saṅghassa mahādānaṃ datvā tadā dasabalassa dhammaṃ sutvā saraṇesu patiṭṭhāya nikkhamitvā pabbaji.","Sopi naṃ satthā bhojanānumodanaṃ karonto –","“anāgate gotamo nāma buddho bhavissatī”ti byākāsi.","Tena vuttaṃ –"],"lineRefs":[["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"]]},{"para":2686,"vripara":"11","refs":["bv13:4"],"lines":["“Ahaṃ tena samayena, uttaro nāma māṇavo;"],"lineRefs":[["bv13:4"]]},{"para":2687,"vripara":null,"refs":["bv13:4"],"lines":["Asītikoṭiyo mayhaṃ, ghare sannicitaṃ dhanaṃ."],"lineRefs":[["bv13:4"]]},{"para":2689,"vripara":"12","refs":["bv13:4"],"lines":["“Kevalaṃ sabbaṃ datvāna, sasaṅghe lokanāyake;"],"lineRefs":[["bv13:4"]]},{"para":2690,"vripara":null,"refs":["bv13:4"],"lines":["Saraṇaṃ tassūpagañchiṃ, pabbajjañcābhirocayiṃ."],"lineRefs":[["bv13:4"]]},{"para":2692,"vripara":"13","refs":["bv13:4"],"lines":["“Sopi maṃ buddho byākāsi, karonto anumodanaṃ;"],"lineRefs":[["bv13:4"]]},{"para":2693,"vripara":null,"refs":["bv13:4"],"lines":["Tiṃsakappasahassamhi, ayaṃ buddho bhavissati."],"lineRefs":[["bv13:4"]]},{"para":2695,"vripara":"14","refs":["bv13:4"],"lines":["“Padhānaṃ padahitvāna … pe … hessāma sammukhā imaṃ”."],"lineRefs":[["bv13:4"]]},{"para":2696,"vripara":null,"refs":["bv13:4"],"lines":["Byākaraṇagāthā vitthāretabbā."],"lineRefs":[["bv13:4"]]},{"para":2698,"vripara":"15","refs":["bv13:4"],"lines":["“Tassāpi vacanaṃ sutvā, bhiyyo cittaṃ pasādayiṃ;"],"lineRefs":[["bv13:4"]]},{"para":2699,"vripara":null,"refs":["bv13:4"],"lines":["Uttariṃ vatamadhiṭṭhāsiṃ, dasapāramipūriyā."],"lineRefs":[["bv13:4"]]},{"para":2701,"vripara":"16","refs":["bv13:4"],"lines":["“Suttantaṃ vinayaṃ cāpi, navaṅgaṃ satthusāsanaṃ;"],"lineRefs":[["bv13:4"]]},{"para":2702,"vripara":null,"refs":["bv13:4"],"lines":["Sabbaṃ pariyāpuṇitvāna, sobhayiṃ jinasāsanaṃ."],"lineRefs":[["bv13:4"]]},{"para":2704,"vripara":"17","refs":["bv13:4"],"lines":["“Tatthappamatto viharanto, nisajjaṭṭhānacaṅkame;"],"lineRefs":[["bv13:4"]]},{"para":2705,"vripara":null,"refs":["bv13:4"],"lines":["Abhiññāpāramiṃ gantvā, brahmalokamagañchahan”ti."],"lineRefs":[["bv13:4"]]},{"para":2706,"vripara":null,"refs":["bv13:4"],"lines":["Tattha <b>sannicitan</b>ti nidahitaṃ nidhānavasena.","<b>Kevalan</b>ti sakalanti attho.","<b>Sabban</b>ti asesato datvā.","<b>Sasaṅghe</b>ti sasaṅghassa.","<b>Tassūpagañchin</b>ti taṃ upagañchiṃ, upayogatthe sāmivacanaṃ.","<b>Abhirocayin</b>ti pabbajiṃ.","<b>Tiṃsakappasahassamhī</b>ti tiṃsakappasahassesu atikkantesūti attho."],"lineRefs":[["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"]]},{"para":2707,"vripara":null,"refs":["bv13:4"],"lines":["Tassa pana sumedhassa bhagavato sudassanaṃ nāma nagaraṃ ahosi, sudatto nāma rājā pitā, mātā sudattā nāma, saraṇo ca sabbakāmo ca dve aggasāvakā, sāgaro nāmupaṭṭhāko, rāmā ca surāmā ca dve aggasāvikā, mahānīparukkho bodhi, sarīraṃ aṭṭhāsītihatthubbedhaṃ ahosi, āyu navutivassasahassāni, navavassasahassāni agāraṃ ajjhāvasi, sumanā nāmassa aggamahesī, punabbasumitto nāma putto, hatthiyānena nikkhami.","Sesaṃ gāthāsu dissati.","Tena vuttaṃ –"],"lineRefs":[["bv13:4"],["bv13:4"],["bv13:4"]]},{"para":2709,"vripara":"18","refs":["bv13:4"],"lines":["“Sudassanaṃ nāma nagaraṃ, sudatto nāma khattiyo;"],"lineRefs":[["bv13:4"]]},{"para":2710,"vripara":null,"refs":["bv13:4"],"lines":["Sudattā nāma janikā, sumedhassa mahesino."],"lineRefs":[["bv13:4"]]},{"para":2712,"vripara":"23","refs":["bv13:4"],"lines":["“Saraṇo sabbakāmo ca, ahesuṃ aggasāvakā;"],"lineRefs":[["bv13:4"]]},{"para":2713,"vripara":null,"refs":["bv13:4"],"lines":["Sāgaro nāmupaṭṭhāko, sumedhassa mahesino."],"lineRefs":[["bv13:4"]]},{"para":2715,"vripara":"24","refs":["bv13:4"],"lines":["“Rāmā ceva surāmā ca, ahesuṃ aggasāvikā;"],"lineRefs":[["bv13:4"]]},{"para":2716,"vripara":null,"refs":["bv13:4"],"lines":["Bodhi tassa bhagavato, mahānīpoti vuccati."],"lineRefs":[["bv13:4"]]},{"para":2718,"vripara":"26","refs":["bv13:4"],"lines":["“Aṭṭhāsītiratanāni, accuggato mahāmuni;"],"lineRefs":[["bv13:4"]]},{"para":2719,"vripara":null,"refs":["bv13:4"],"lines":["Obhāseti disā sabbā, cando tāragaṇe yathā."],"lineRefs":[["bv13:4"]]},{"para":2721,"vripara":"27","refs":["bv13:4"],"lines":["“Cakkavattimaṇī nāma, yathā tapati yojanaṃ;"],"lineRefs":[["bv13:4"]]},{"para":2722,"vripara":null,"refs":["bv13:4"],"lines":["Tatheva tassa ratanaṃ, samantā pharati yojanaṃ."],"lineRefs":[["bv13:4"]]},{"para":2724,"vripara":"28","refs":["bv13:4"],"lines":["“Navutivassasahassāni, āyu vijjati tāvade;"],"lineRefs":[["bv13:4"]]},{"para":2725,"vripara":null,"refs":["bv13:4"],"lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[["bv13:4"]]},{"para":2727,"vripara":"29","refs":["bv13:4"],"lines":["“Tevijjachaḷabhiññehi, balappattehi tādihi;"],"lineRefs":[["bv13:4"]]},{"para":2728,"vripara":null,"refs":["bv13:4"],"lines":["Samākulamidaṃ āsi, arahantehi sādhuhi."],"lineRefs":[["bv13:4"]]},{"para":2730,"vripara":"30","refs":["bv13:4"],"lines":["“Tepi sabbe amitayasā, vippamuttā nirūpadhī;"],"lineRefs":[["bv13:4"]]},{"para":2731,"vripara":null,"refs":["bv13:4"],"lines":["Ñāṇālokaṃ dassayitvā, nibbutā te mahāyasā”ti."],"lineRefs":[["bv13:4"]]},{"para":2732,"vripara":null,"refs":["bv13:4"],"lines":["Tattha <b>cando tāragaṇe yathā</b>ti yathā nāma gagane paripuṇṇacando tārāgaṇe obhāseti pakāseti, evameva sabbāpi disā obhāsetīti attho.","Keci “cando pannaraso yathā”ti paṭhanti, so uttānatthova."],"lineRefs":[["bv13:4"],["bv13:4"]]},{"para":2733,"vripara":null,"refs":["bv13:4"],"lines":["<b>Cakkavattimaṇī nāmā</b>ti yathā nāma cakkavattirañño maṇiratanaṃ catuhatthāyāmaṃ sakaṭanābhisamapariṇāhaṃ caturāsītimaṇisahassaparivāraṃ tārāgaṇaparivutassa saradasamayaparipuṇṇarajanikarassa sirisamudayasobhaṃ avhayantamiva vepullapabbatato paramaramaṇīyadassanaṃ maṇiratanamāgacchati, tassevaṃ āgacchantassa samantato yojanappamāṇaṃ okāsaṃ ābhā pharati, evameva tassa sumedhassāpi bhagavato sarīrato ābhāratanaṃ samantato yojanaṃ pharatīti attho."],"lineRefs":[["bv13:4"]]},{"para":2734,"vripara":null,"refs":["bv13:4","bv13:30"],"lines":["<b>Tevijjachaḷabhiññehī</b>ti tevijjehi chaḷabhiññehi cāti attho.","<b>Balappattehī</b>ti iddhibalappattehi.","<b>Tādihī</b>ti tādibhāvappattehi.","<b>Samākulan</b>ti saṅkiṇṇaṃ ekakāsāvapajjotaṃ.","<b>Idan</b>ti sāsanaṃ sandhāyāha, mahītalaṃ vā.","<b>Amitayasā</b>ti amitaparivārā, atulakittighoso vā.","<b>Nirūpadhī</b>ti caturūpadhivirahitā.","Sesamettha gāthāsu sabbattha pākaṭamevāti."],"lineRefs":[["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:4"],["bv13:30"],["bv13:30"],["bv13:30"]]}],"wordLinks":[["bv13:4.1","abhisamayā tīṇī",0,10],["bv13:30.1","amitayasā",51,5],["bv13:30.1","nirūpadhī",51,6]],"before":[{"para":2647,"vripara":null,"title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["Sumedhabuddhavaṃsavaṇṇanā"]},{"para":2648,"vripara":null,"title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["Padumuttare pana sammāsambuddhe parinibbute sāsanepissa antarahite sattatikappasahassāni buddhā nuppajjiṃsu, buddhasuññāni ahesuṃ.","Ito paṭṭhāya tiṃsakappasahassānaṃ matthake ekasmiṃ kappe <b>sumedho sujāto</b> cāti dve sammāsambuddhā nibbattiṃsu.","Tattha adhigatamedho <b>sumedho</b> nāma bodhisatto pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā sudassananagare sudattassa nāma rañño aggamahesiyā sudattāya nāma deviyā kucchismiṃ paṭisandhiṃ gahetvā dasannaṃ māsānaṃ accayena sudassanuyyāne taruṇadivasakaro viya saliladharavivaragato mātukucchito nikkhami.","So navavassasahassāni agāraṃ ajjhāvasi.","Tassa kira sucandana-kañcana-sirivaḍḍhananāmakā tayo pāsādā ahesuṃ.","Sumanamahādevippamukhāni aṭṭhacattālīsaitthisahassāni paccupaṭṭhitāni ahesuṃ."]},{"para":2649,"vripara":null,"title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["So cattāri nimittāni disvā sumanadeviyā punabbasumitte nāma putte jāte hatthiyānena mahābhinikkhamanaṃ nikkhamitvā pabbaji.","Manussānañca koṭisatamanupabbaji.","So tehi parivuto aḍḍhamāsaṃ padhānacariyaṃ caritvā visākhapuṇṇamāya nakulanigame nakulaseṭṭhidhītāya dinnaṃ madhupāyāsaṃ paribhuñjitvā sālavane divāvihāraṃ vītināmetvā sirivaḍḍhājīvakena dinnā aṭṭha tiṇamuṭṭhiyo gahetvā nīpabodhimūle vīsatihatthavitthataṃ tiṇasantharaṃ santharitvā samāraṃ mārabalaṃ vidhamitvā abhisambodhiṃ pāpuṇitvā “anekajātisaṃsāraṃ … pe … taṇhānaṃ khayamajjhagā”ti udānaṃ udānetvā sattasattāhaṃ bodhisamīpeyeva vītināmetvā aṭṭhame sattāhe brahmuno dhammadesanāyācanaṃ sampaṭicchitvā bhabbapuggale olokento attano kaniṭṭhabhātikaṃ saraṇakumārañca sabbakāmikumārañca attanā saddhiṃ pabbajitānaṃ bhikkhūnañca koṭisataṃ catusaccadhammapaṭivedhasamatthe disvā ākāsena gantvā sudassananagarasamīpe sudassanuyyāne otaritvā uyyānapālena attano bhātike pakkosāpetvā tesaṃ parivārānaṃ majjhe <b>dhammacakkaṃ</b> pavattesi.","Tadā koṭisatasahassānaṃ dhammābhisamayo ahosi, ayaṃ paṭhamo abhisamayo.","Tena vuttaṃ –"]},{"para":2651,"vripara":"1","title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["“Padumuttarassa aparena, sumedho nāma nāyako;"]},{"para":2652,"vripara":null,"title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["Durāsado uggatejo, sabbalokuttamo muni."]},{"para":2654,"vripara":"2","title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["“Pasannanetto sumukho, brahā uju patāpavā;"]},{"para":2655,"vripara":null,"title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["Hitesī sabbasattānaṃ, bahū mocesi bandhanā."]},{"para":2657,"vripara":"3","title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["“Yadā buddho pāpuṇitvā, kevalaṃ bodhimuttamaṃ;"]},{"para":2658,"vripara":null,"title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["Sudassanamhi nagare, dhammacakkaṃ pavattayi."]},{"para":2660,"vripara":"4","title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["“Tassābhisamayā tīṇi, ahesuṃ dhammadesane;"]},{"para":2661,"vripara":null,"title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["Koṭisatasahassānaṃ, paṭhamābhisamayo ahū”ti."]}],"after":[{"para":2735,"vripara":null,"title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["Sumedhabuddhavaṃsavaṇṇanā niṭṭhitā."]},{"para":2736,"vripara":null,"title":"Sumedhabuddhavaṃsavaṇṇanā","lines":["Niṭṭhito ekādasamo buddhavaṃso."]}]},"tika":null,"tika2":null}
