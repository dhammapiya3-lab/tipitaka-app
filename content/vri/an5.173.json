{"suttaId":"an5.173","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1164,1165],"vripara":"173"},"segments":{"an5.173:0.3":"Nirayasuttaṃ","an5.173:1.1":"“Pañcahi, bhikkhave, dhammehi samannāgato upāsako yathābhataṃ nikkhitto evaṃ niraye.","an5.173:1.2":"Katamehi pañcahi?","an5.173:1.3":"Pāṇātipātī hoti … pe … surāmerayamajjapamādaṭṭhāyī hoti.","an5.173:1.4":"Imehi kho, bhikkhave, pañcahi dhammehi samannāgato upāsako yathābhataṃ nikkhitto evaṃ niraye.","an5.173:2.1":"“Pañcahi, bhikkhave, dhammehi samannāgato upāsako yathābhataṃ nikkhitto evaṃ sagge.","an5.173:2.2":"Katamehi pañcahi?","an5.173:2.3":"Pāṇātipātā paṭivirato hoti … pe … surāmerayamajjapamādaṭṭhānā paṭivirato hoti.","an5.173:2.4":"Imehi kho, bhikkhave, pañcahi dhammehi samannāgato upāsako yathābhataṃ nikkhitto evaṃ sagge”ti.","an5.173:2.5":"Tatiyaṃ."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":355,"to":356,"paras":[{"para":355,"vripara":"171-173","refs":["an5.173:1"],"lines":["171-173. Tatiyassa paṭhamadutiyatatiyesu agāriyappaṭipatti kathitā.","Sotāpannasakadāgāminopi hontu, vaṭṭantiyeva."],"lineRefs":[["an5.173:1"],["an5.173:1"]]},{"para":356,"vripara":null,"refs":["an5.173:1"],"lines":["Verasuttavaṇṇanā"],"lineRefs":[["an5.173:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":311,"to":313,"paras":[{"para":311,"vripara":"171-176","refs":["an5.173:1"],"lines":["171-176. Tatiyassa paṭhamadutiyatatiyacatutthe natthi vattabbaṃ.","Pañcame <b>upāsakapacchimako</b>ti upāsakanihīno.","“Iminā diṭṭhādinā idaṃ nāma maṅgalaṃ bhavissatī”ti evaṃ bālajanaparikappitakotūhalasaṅkhātena diṭṭhasutamutamaṅgalena samannāgato <b>kotūhalamaṅgaliko</b>.","Tenāha <b>“iminā idaṃ bhavissatī”</b>tiādi.","<b>Maṅgalaṃ paccetī</b>ti diṭṭhamaṅgalādibhedaṃ maṅgalameva patthiyāyati.","<b>No kamman</b>ti kammassakataṃ no patthiyāyati.","<b>Imamhā sāsanā</b>ti ito sabbaññubuddhasāsanato.","<b>Bahiddhā</b>ti bāhirakasamaye.","<b>Dakkhiṇeyyaṃ pariyesatī</b>ti “duppaṭipannā dakkhiṇeyyā”ti saññī gavesati.","Ettha dakkhiṇapariyesanapubbakāre ekaṃ katvā pañca dhammā veditabbā.","Chaṭṭhaṃ uttānameva."],"lineRefs":[["an5.173:1"],["an5.173:1"],["an5.173:1"],["an5.173:1"],["an5.173:1"],["an5.173:1"],["an5.173:1"],["an5.173:1"],["an5.173:1"],["an5.173:1"],["an5.173:1"]]},{"para":312,"vripara":null,"refs":["an5.173:1"],"lines":["Sārajjasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an5.173:1"]]},{"para":313,"vripara":null,"refs":["an5.173:1"],"lines":["7-8. Vaṇijjāsuttādivaṇṇanā"],"lineRefs":[["an5.173:1"]]}],"wordLinks":[]},"tika2":null}
