{"suttaId":"sn7.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[2422,2431],"vripara":"192"},"segments":{"sn7.6:0.3":"Jaṭāsuttaṃ","sn7.6:1.1":"Sāvatthinidānaṃ.","sn7.6:1.2":"Atha kho jaṭābhāradvājo brāhmaṇo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavatā saddhiṃ sammodi.","sn7.6:1.3":"Sammodanīyaṃ kathaṃ sāraṇīyaṃ vītisāretvā ekamantaṃ nisīdi.","sn7.6:1.4":"Ekamantaṃ nisinno kho jaṭābhāradvājo brāhmaṇo bhagavantaṃ gāthāya ajjhabhāsi –","sn7.6:2.1":"“Antojaṭā bahijaṭā,","sn7.6:2.2":"jaṭāya jaṭitā pajā;","sn7.6:2.3":"Taṃ taṃ gotama pucchāmi,","sn7.6:2.4":"ko imaṃ vijaṭaye jaṭa”nti.","sn7.6:3.1":"“Sīle patiṭṭhāya naro sapañño,","sn7.6:3.2":"cittaṃ paññañca bhāvayaṃ;","sn7.6:3.3":"Ātāpī nipako bhikkhu,","sn7.6:3.4":"so imaṃ vijaṭaye jaṭaṃ.","sn7.6:4.1":"“Yesaṃ rāgo ca doso ca,","sn7.6:4.2":"avijjā ca virājitā;","sn7.6:4.3":"Khīṇāsavā arahanto,","sn7.6:4.4":"tesaṃ vijaṭitā jaṭā.","sn7.6:5.1":"“Yattha nāmañca rūpañca,","sn7.6:5.2":"asesaṃ uparujjhati;","sn7.6:5.3":"Paṭighaṃ rūpasaññā ca,","sn7.6:5.4":"etthesā chijjate jaṭā”ti.","sn7.6:6.1":"Evaṃ vutte, jaṭābhāradvājo bhagavantaṃ etadavoca –","sn7.6:6.2":"“abhikkantaṃ, bho gotama…pe…","sn7.6:6.3":"aññataro ca panāyasmā bhāradvājo arahataṃ ahosī”ti. 7."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1032,"to":1032,"paras":[{"para":1032,"vripara":"192","refs":["sn7.6:1"],"lines":["Chaṭṭhe <b>jaṭābhāradvājo</b>ti bhāradvājovesa, jaṭāpañhassa pana pucchitattā saṅgītikārehi evaṃ vutto.","Sesaṃ devatāsaṃyutte kathitameva.","Chaṭṭhaṃ. 7."],"lineRefs":[["sn7.6:1"],["sn7.6:1"],["sn7.6:1"]]}],"wordLinks":[["sn7.6:1.2","jaṭābhāradvājo",0,0],["sn7.6:1.4","jaṭābhāradvājo",0,0]],"before":[{"para":1031,"vripara":null,"title":"Jaṭāsuttavaṇṇanā","lines":["Jaṭāsuttavaṇṇanā 192."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1219,"to":1221,"paras":[{"para":1219,"vripara":"192","refs":["sn7.6:1"],"lines":["<b>Jaṭāpañhassā</b>ti “antojaṭā bahijaṭā”ti evaṃ jaṭāpariyāyassa pañhassa."],"lineRefs":[["sn7.6:1"]]},{"para":1220,"vripara":null,"refs":["sn7.6:1"],"lines":["Jaṭāsuttavaṇṇanā niṭṭhitā. 7."],"lineRefs":[["sn7.6:1"]]},{"para":1221,"vripara":null,"refs":["sn7.6:1"],"lines":["Suddhikasuttavaṇṇanā 193."],"lineRefs":[["sn7.6:1"]]}],"wordLinks":[]},"tika2":null}
