{"suttaId":"tha-ap273","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8554,8567],"vripara":"1"},"segments":{"tha-ap273:0.3":"Suvaṇṇabibbohaniyattheraapadānaṃ","tha-ap273:1.1":"“Ekāsanaṃ ahamadaṃ, pasanno sehi pāṇibhi;","tha-ap273:1.3":"Bibbohanañca [bimbohanañca (sī. pī.)] pādāsiṃ, uttamatthassa pattiyā.","tha-ap273:2.1":"“Ekanavutito kappe, bibbohanamadāsahaṃ;","tha-ap273:2.3":"Duggatiṃ nābhijānāmi, bibbohanassidaṃ phalaṃ.","tha-ap273:3.1":"“Ito tesaṭṭhime kappe, asamo nāma khattiyo;","tha-ap273:3.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap273:4.1":"“Paṭisambhidā catasso, vimokkhāpi ca aṭṭhime;","tha-ap273:4.3":"Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanaṃ”.","tha-ap273:5.1":"Itthaṃ sudaṃ āyasmā suvaṇṇabibbohaniyo thero imā gāthāyo abhāsitthāti.","tha-ap273:6.1":"Suvaṇṇabibbohaniyattherassāpadānaṃ paṭhamaṃ."},"attha":null,"tika":null}
