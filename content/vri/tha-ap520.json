{"suttaId":"tha-ap520","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3337,3357],"vripara":"44"},"segments":{"tha-ap520:0.3":"Ghosasaññakattheraapadānaṃ","tha-ap520:1.1":"“Migaluddo pure āsiṃ,","tha-ap520:1.2":"araññe vipine ahaṃ;","tha-ap520:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap520:1.4":"devasaṅghapurakkhataṃ.","tha-ap520:2.1":"“Catusaccaṃ pakāsentaṃ,","tha-ap520:2.2":"desentaṃ amataṃ padaṃ;","tha-ap520:2.3":"Assosiṃ madhuraṃ dhammaṃ,","tha-ap520:2.4":"sikhino lokabandhuno.","tha-ap520:3.1":"“Ghose cittaṃ pasādesiṃ,","tha-ap520:3.2":"asamappaṭipuggale;","tha-ap520:3.3":"Tattha cittaṃ pasādetvā,","tha-ap520:3.4":"uttariṃ [atariṃ (sī. pī.)] duttaraṃ bhavaṃ.","tha-ap520:4.1":"“Ekatiṃse ito kappe,","tha-ap520:4.2":"yaṃ saññamalabhiṃ tadā;","tha-ap520:4.3":"Duggatiṃ nābhijānāmi,","tha-ap520:4.4":"ghosasaññāyidaṃ phalaṃ.","tha-ap520:5.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap520:5.3":"viharāmi anāsavo.","tha-ap520:6.1":"“Svāgataṃ vata me āsi … pe …","tha-ap520:6.3":"kataṃ buddhassa sāsanaṃ.","tha-ap520:7.1":"“Paṭisambhidā catasso … pe …","tha-ap520:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap520:8.1":"Itthaṃ sudaṃ āyasmā ghosasaññako thero imā gāthāyo Abhāsitthāti.","tha-ap520:9.1":"Ghosasaññakattherassāpadānaṃ aṭṭhamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
