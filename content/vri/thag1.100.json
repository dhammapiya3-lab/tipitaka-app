{"suttaId":"thag1.100","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[578,587],"vripara":"100"},"segments":{"thag1.100:0.4":"(Dutiya)-devasabhattheragāthā","thag1.100:1.1":"“Sammappadhānasampanno,","thag1.100:1.2":"satipaṭṭhānagocaro;","thag1.100:1.3":"Vimuttikusumasañchanno,","thag1.100:1.4":"parinibbissatyanāsavo”ti.","thag1.100:1.5":"… Devasabho thero ….","thag1.100:1.6":"Vaggo dasamo niṭṭhito.","thag1.100:2.0":"Tassuddānaṃ –","thag1.100:2.1":"Paripuṇṇako ca vijayo,","thag1.100:2.2":"erako mettajī muni;","thag1.100:2.3":"Cakkhupālo khaṇḍasumano,","thag1.100:2.4":"tisso ca abhayo tathā;","thag1.100:2.5":"Uttiyo ca mahāpañño,","thag1.100:2.6":"thero devasabhopi cāti."},"unsure":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2495,"to":2495,"paras":[{"para":2495,"vripara":null,"refs":["thag1.100:1"],"lines":["Tattha <b>sammappadhānasampanno</b>ti sampannacatubbidhasammappadhāno, tehi kattabbakiccaṃ sampādetvā ṭhitoti attho.","<b>Satipaṭṭhānagocaro</b>ti kāyānupassanādayo satipaṭṭhānā gocaro pavattiṭṭhānaṃ etassāti satipaṭṭhānagocaro, catūsu satipaṭṭhānesu patiṭṭhitacittoti attho.","Guṇasobhena paramasugandhā vimuttiyeva kusumāni, tehi sabbaso sammadeva sañchanno vibhūsito alaṅkatoti <b>vimuttikusumasañchanno.</b>","<b>Parinibbissatyanāsavo</b>ti evaṃ sammā paṭipajjanto bhikkhu nacirasseva anāsavo hutvā parinibbissati saupādisesāya anupādisesāya ca nibbānadhātuyāti attho.","Idameva ca therassa aññābyākaraṇaṃ ahosi."],"lineRefs":[["thag1.100:1"],["thag1.100:1"],["thag1.100:1"],["thag1.100:1"],["thag1.100:1"]]}],"wordLinks":[["thag1.100:1.1","sammappadhānasampanno",0,0],["thag1.100:1.1","satipaṭṭhānagocaro",0,1],["thag1.100:1.3","vimuttikusumasañchanno",0,2],["thag1.100:1.3","parinibbissatyanāsavo",0,3]],"before":[{"para":2474,"vripara":null,"refs":[],"lines":["“Khandhānañca paṭipāṭi, dhātuāyatanāna ca;"],"lineRefs":[[]]},{"para":2475,"vripara":null,"refs":[],"lines":["Abbocchinnaṃ vattamānā, saṃsāroti pavuccatī”ti.","–"],"lineRefs":[[],[]]},{"para":2476,"vripara":null,"refs":[],"lines":["Evaṃ vuttasaṃsāravaṭṭakāraṇaṃ hutvā upagamentīti saṃsāraupagāmino,“saṃsārūpagāmino”ti vā pāṭho.","Sesaṃ anantaragāthāya vuttanayameva."],"lineRefs":[[],[]]},{"para":2477,"vripara":null,"refs":[],"lines":["Uttiyattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2478,"vripara":null,"refs":[],"lines":["(Dutiya) devasabhattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":2479,"vripara":null,"refs":[],"lines":["<b>Sammappadhānasampanno</b>ti āyasmato devasabhattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinanto sikhissa bhagavato kāle kulagehe nibbattitvā viññutaṃ patto ekadivasaṃ sikhiṃ bhagavantaṃ disvā pasannamānaso bandhujīvakapupphehi pūjaṃ akāsi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde kapilavatthusmiṃ sakyarājakule nibbatti, tassa <b>devasabho</b>ti nāmaṃ ahosi.","So vayappatto cumbaṭakalahavūpasamanatthaṃ satthari āgate buddhānubhāvaṃ disvā pasannamānaso saraṇesu patiṭṭhito puna nigrodhārāme satthari viharante satthāraṃ upasaṅkamitvā paṭiladdhasaddho pabbajitvā katapubbakicco vipassanāya kammaṃ karonto nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.16.1-6)–"],"lineRefs":[[],[],[],[],[],[]]},{"para":2480,"vripara":null,"refs":[],"lines":["“Candaṃva vimalaṃ suddhaṃ, vippasannamanāvilaṃ;"],"lineRefs":[[]]},{"para":2481,"vripara":null,"refs":[],"lines":["Nandībhavaparikkhīṇaṃ, tiṇṇaṃ loke visattikaṃ."],"lineRefs":[[]]},{"para":2482,"vripara":null,"refs":[],"lines":["“Nibbāpayantaṃ janataṃ, tiṇṇaṃ tārayataṃ varaṃ;"],"lineRefs":[[]]},{"para":2483,"vripara":null,"refs":[],"lines":["Muniṃ vanamhi jhāyantaṃ, ekaggaṃ susamāhitaṃ."],"lineRefs":[[]]},{"para":2484,"vripara":null,"refs":[],"lines":["“Bandhujīvakapupphāni, lagetvā suttakenahaṃ;"],"lineRefs":[[]]},{"para":2485,"vripara":null,"refs":[],"lines":["Buddhassa abhiropayiṃ, sikhino lokabandhuno."],"lineRefs":[[]]},{"para":2486,"vripara":null,"refs":[],"lines":["“Ekatiṃse ito kappe, yaṃ kammamakariṃ tadā;"],"lineRefs":[[]]},{"para":2487,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":2488,"vripara":null,"refs":[],"lines":["“Ito sattamake kappe, manujindo mahāyaso;"],"lineRefs":[[]]},{"para":2489,"vripara":null,"refs":[],"lines":["Samantacakkhunāmāsi, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":2490,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":2491,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā attanā adhigataṃ vimuttisukhaṃ nissāya uppannapītisomanasso udānavasena –"],"lineRefs":[[]]},{"para":2493,"vripara":"100","refs":[],"lines":["“Sammappadhānasampanno, satipaṭṭhānagocaro;"],"lineRefs":[[]]},{"para":2494,"vripara":null,"refs":[],"lines":["Vimuttikusumasañchanno, parinibbissatyanāsavo”ti.","– gāthaṃ abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
