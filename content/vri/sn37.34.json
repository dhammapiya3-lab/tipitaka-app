{"suttaId":"sn37.34","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1518,1528],"vripara":"313"},"segments":{"sn37.34:0.3":"Vaḍḍhīsuttaṃ","sn37.34:1.1":"“Pañcahi, bhikkhave, vaḍḍhīhi vaḍḍhamānā ariyasāvikā ariyāya vaḍḍhiyā vaḍḍhati sārādāyinī ca hoti varādāyinī ca kāyassa.","sn37.34:1.2":"Katamehi pañcahi?","sn37.34:1.3":"Saddhāya vaḍḍhati, sīlena vaḍḍhati, sutena vaḍḍhati, cāgena vaḍḍhati, paññāya vaḍḍhati –","sn37.34:1.4":"imehi kho, bhikkhave, pañcahi vaḍḍhīhi vaḍḍhamānā ariyasāvikā ariyāya vaḍḍhiyā vaḍḍhati, sārādāyinī ca hoti, varādāyinī ca kāyassā”ti.","sn37.34:2.1":"“Saddhāya sīlena ca yādha vaḍḍhati,","sn37.34:2.2":"Paññāya cāgena sutena cūbhayaṃ;","sn37.34:2.3":"Sā tādisī sīlavatī upāsikā,","sn37.34:2.4":"Ādīyati sāramidheva attano”ti.","sn37.34:2.5":"dasamaṃ;","sn37.34:2.6":"Balavaggo tatiyo.","sn37.34:3.0":"Tassuddānaṃ –","sn37.34:3.1":"Visāradā pasayha abhibhuyya,","sn37.34:3.2":"ekaṃ aṅgena pañcamaṃ;","sn37.34:3.3":"Nāsenti hetu ṭhānañca,","sn37.34:3.4":"visārado vaḍḍhinā dasāti.","sn37.34:3.5":"Mātugāmasaṃyuttaṃ samattaṃ."},"unsure":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":661,"to":664,"paras":[{"para":661,"vripara":"305-313","refs":["sn37.34:1"],"lines":["305-313. <b>Pasayhā</b>ti abhibhavitvā.","<b>Abhibhuyya vattatī</b>ti abhibhavati ajjhottharati.","<b>Neva rūpabalaṃ tāyatī</b>ti neva rūpabalaṃ tāyituṃ rakkhituṃ sakkoti.","<b>Nāsenteva naṃ, kule na vāsentī</b>ti “dussīlā saṃbhinnācārā atikkantamariyādā”ti gīvāyaṃ gahetvā nīharanti, na tasmiṃ kule vāsenti.","<b>Vāsenteva naṃ kule, na nāsentī</b>ti “kiṃ rūpena bhogādīhi vā, parisuddhasīlā esā ācārasampannā”ti ñatvā ñātakā tasmiṃ kule vāsentiyeva, na nāsenti.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["sn37.34:1"],["sn37.34:1"],["sn37.34:1"],["sn37.34:1"],["sn37.34:1"],["sn37.34:1"]]},{"para":662,"vripara":null,"refs":["sn37.34:1"],"lines":["Mātugāmasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn37.34:1"]]},{"para":663,"vripara":null,"refs":["sn37.34:1"],"lines":["Jambukhādakasaṃyuttaṃ"],"lineRefs":[["sn37.34:1"]]},{"para":664,"vripara":null,"refs":["sn37.34:1"],"lines":["Nibbānapañhāsuttavaṇṇanā"],"lineRefs":[["sn37.34:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":569,"to":573,"paras":[{"para":569,"vripara":"305-313","refs":["sn37.34:1"],"lines":["305-313. <b>Abhibhavitvā</b> sabbaṃ antojanaṃ sāmikañca.","<b>Nāsentī</b>ti nāsanaṃ adassanaṃ nenti nīharantīti attho."],"lineRefs":[["sn37.34:1"],["sn37.34:1"]]},{"para":570,"vripara":null,"refs":["sn37.34:1"],"lines":["Pasayhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn37.34:1"]]},{"para":571,"vripara":null,"refs":["sn37.34:1"],"lines":["Mātugāmasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn37.34:1"]]},{"para":572,"vripara":null,"refs":["sn37.34:1"],"lines":["Jambukhādakasaṃyuttaṃ"],"lineRefs":[["sn37.34:1"]]},{"para":573,"vripara":null,"refs":["sn37.34:1"],"lines":["Nibbānapañhasuttavaṇṇanā"],"lineRefs":[["sn37.34:1"]]}],"wordLinks":[]},"tika2":null}
