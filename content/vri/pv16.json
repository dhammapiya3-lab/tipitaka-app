{"suttaId":"pv16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[558,614],"vripara":"168"},"segments":{"pv16:0.3":"Nandāpetivatthu","pv16:1.1":"“Kāḷī dubbaṇṇarūpāsi,","pv16:1.2":"pharusā bhīrudassanā;","pv16:1.3":"Piṅgalāsi kaḷārāsi,","pv16:1.4":"na taṃ maññāmi mānusi”nti. 169.","pv16:2.1":"“Ahaṃ nandā nandisena,","pv16:2.2":"bhariyā te pure ahuṃ;","pv16:2.3":"Pāpakammaṃ karitvāna,","pv16:2.4":"petalokaṃ ito gatā”ti. 170.","pv16:3.1":"“Kiṃ nu kāyena vācāya,","pv16:3.2":"manasā dukkaṭaṃ kataṃ;","pv16:3.3":"Kissa kammavipākena,","pv16:3.4":"petalokaṃ ito gatā”ti. 171.","pv16:4.1":"“Caṇḍī ca pharusā cāsiṃ [caṇḍī pharusavācā ca (sī.)],","pv16:4.2":"tayi cāpi agāravā;","pv16:4.3":"Tāhaṃ duruttaṃ vatvāna,","pv16:4.4":"petalokaṃ ito gatā”ti. 172.","pv16:5.1":"“Handuttarīyaṃ dadāmi te,","pv16:5.2":"imaṃ [idaṃ (sī. aṭṭha.)] dussaṃ nivāsaya;","pv16:5.3":"Imaṃ dussaṃ nivāsetvā,","pv16:5.4":"ehi nessāmi taṃ gharaṃ. 173.","pv16:6.1":"“Vatthañca annapānañca,","pv16:6.2":"lacchasi tvaṃ gharaṃ gatā;","pv16:6.3":"Putte ca te passissasi,","pv16:6.4":"suṇisāyo ca dakkhasī”ti. 174.","pv16:7.1":"“Hatthena hatthe te dinnaṃ,","pv16:7.2":"na mayhaṃ upakappati;","pv16:7.3":"Bhikkhū ca sīlasampanne,","pv16:7.4":"vītarāge bahussute. 175.","pv16:8.1":"“Tappehi annapānena,","pv16:8.2":"mama dakkhiṇamādisa;","pv16:8.3":"Tadāhaṃ sukhitā hessaṃ,","pv16:8.4":"sabbakāmasamiddhinī”ti. 176.","pv16:9.1":"Sādhūti so paṭissutvā,","pv16:9.2":"dānaṃ vipulamākiri;","pv16:9.3":"Annaṃ pānaṃ khādanīyaṃ,","pv16:9.4":"vatthasenāsanāni ca;","pv16:9.5":"Chattaṃ gandhañca mālañca,","pv16:9.6":"vividhā ca upāhanā. 177.","pv16:10.1":"Bhikkhū ca sīlasampanne,","pv16:10.2":"vītarāge bahussute;","pv16:10.3":"Tappetvā annapānena,","pv16:10.4":"tassā dakkhiṇamādisī. 178.","pv16:11.1":"Samanantarānuddiṭṭhe,","pv16:11.2":"vipāko udapajjatha;","pv16:11.3":"Bhojanacchādanapānīyaṃ,","pv16:11.4":"dakkhiṇāya idaṃ phalaṃ. 179.","pv16:12.1":"Tato suddhā sucivasanā,","pv16:12.2":"kāsikuttamadhārinī;","pv16:12.3":"Vicittavatthābharaṇā,","pv16:12.4":"sāmikaṃ upasaṅkami. 180.","pv16:13.1":"“Abhikkantena vaṇṇena,","pv16:13.2":"yā tvaṃ tiṭṭhasi devate;","pv16:13.3":"Obhāsentī disā sabbā,","pv16:13.4":"osadhī viya tārakā. 181.","pv16:14.1":"“Kena tetādiso vaṇṇo,","pv16:14.2":"kena te idha mijjhati;","pv16:14.3":"Uppajjanti ca te bhogā,","pv16:14.4":"ye keci manaso piyā. 182.","pv16:15.1":"“Pucchāmi taṃ devi mahānubhāve,","pv16:15.2":"manussabhūtā kimakāsi puññaṃ;","pv16:15.3":"Kenāsi evaṃ jalitānubhāvā,","pv16:15.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti. 183.","pv16:16.1":"“Ahaṃ nandā nandisena,","pv16:16.2":"bhariyā te pure ahuṃ;","pv16:16.3":"Pāpakammaṃ karitvāna,","pv16:16.4":"petalokaṃ ito gatā. 184.","pv16:17.1":"“Tava dinnena dānena,","pv16:17.2":"modāmi akutobhayā;","pv16:17.3":"Ciraṃ jīva gahapati,","pv16:17.4":"saha sabbehi ñātibhi;","pv16:17.5":"Asokaṃ virajaṃ khemaṃ,","pv16:17.6":"āvāsaṃ vasavattinaṃ. 185.","pv16:18.1":"“Idha dhammaṃ caritvāna,","pv16:18.2":"dānaṃ datvā gahapati;","pv16:18.3":"Vineyya maccheramalaṃ samūlaṃ,","pv16:18.4":"anindito saggamupehi ṭhāna”nti.","pv16:19.1":"Nandāpetivatthu catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":814,"to":874,"paras":[{"para":814,"vripara":null,"refs":["pv16:1"],"lines":["Gāthāya ajjhabhāsi.","Tattha <b>kāḷī</b>ti kāḷavaṇṇā, jhāmaṅgārasadiso hissā vaṇṇo ahosi.","<b>Pharusā</b>ti kharagattā.","<b>Bhīrudassanā</b>ti bhayānakadassanā sappaṭibhayākārā.","“Bhārudassanā”ti vā pāṭho, bhāriyadassanā, dubbaṇṇatādinā duddasikāti attho.","<b>Piṅgalā</b>ti piṅgalalocanā.","<b>Kaḷārā</b>ti kaḷāradantā.","<b>Na taṃ maññāmi mānusi</b>nti ahaṃ taṃ mānusinti na maññāmi, petimeva ca taṃ maññāmīti adhippāyo.","Taṃ sutvā petī attānaṃ pakāsentī – 169."],"lineRefs":[["pv16:1"],["pv16:1"],["pv16:1"],["pv16:1"],["pv16:1"],["pv16:1"],["pv16:1"],["pv16:1"],["pv16:1"]]},{"para":816,"vripara":"169","refs":["pv16:1"],"lines":["“Ahaṃ nandā nandisena, bhariyā te pure ahuṃ;"],"lineRefs":[["pv16:1"]]},{"para":817,"vripara":null,"refs":["pv16:1"],"lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gatā”ti. –"],"lineRefs":[["pv16:1"]]},{"para":818,"vripara":null,"refs":["pv16:1","pv16:2"],"lines":["Gāthamāha.","Tattha <b>ahaṃ nandā nandisenā</b>ti sāmi nandisena ahaṃ nandā nāma.","<b>Bhariyā te pure ahu</b>nti purimajātiyaṃ tuyhaṃ bhariyā ahosiṃ.","Ito paraṃ – 170."],"lineRefs":[["pv16:1"],["pv16:2"],["pv16:2"],["pv16:2"]]},{"para":820,"vripara":"170","refs":["pv16:2"],"lines":["“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;"],"lineRefs":[["pv16:2"]]},{"para":821,"vripara":null,"refs":["pv16:2"],"lines":["Kissa kammavipākena, petalokaṃ ito gatā”ti. –"],"lineRefs":[["pv16:2"]]},{"para":822,"vripara":null,"refs":["pv16:2"],"lines":["Tassa upāsakassa pucchā.","Athassa sā – 171."],"lineRefs":[["pv16:2"],["pv16:2"]]},{"para":824,"vripara":"171","refs":["pv16:2"],"lines":["“Caṇḍī ca pharusā cāsiṃ, tayi cāpi agāravā;"],"lineRefs":[["pv16:2"]]},{"para":825,"vripara":null,"refs":["pv16:2"],"lines":["Tāhaṃ duruttaṃ vatvāna, petalokaṃ ito gatā”ti. –"],"lineRefs":[["pv16:2"]]},{"para":826,"vripara":null,"refs":["pv16:2"],"lines":["Vissajjesi.","Puna so – 172."],"lineRefs":[["pv16:2"],["pv16:2"]]},{"para":828,"vripara":"172","refs":["pv16:2"],"lines":["“Handuttarīyaṃ dadāmi te, imaṃ dussaṃ nivāsaya;"],"lineRefs":[["pv16:2"]]},{"para":829,"vripara":null,"refs":["pv16:2"],"lines":["Imaṃ dussaṃ nivāsetvā, ehi nessāmi taṃ gharaṃ. 173."],"lineRefs":[["pv16:2"]]},{"para":831,"vripara":"173","refs":["pv16:2"],"lines":["“Vatthañca annapānañca, lacchasi tvaṃ gharaṃ gatā;"],"lineRefs":[["pv16:2"]]},{"para":832,"vripara":null,"refs":["pv16:2"],"lines":["Putte ca te passissasi, suṇisāyo ca dakkhasī”ti. –","athassa sā – 174."],"lineRefs":[["pv16:2"],["pv16:2"]]},{"para":834,"vripara":"174","refs":["pv16:2"],"lines":["“Hatthena hatthe te dinnaṃ, na mayhaṃ upakappati;"],"lineRefs":[["pv16:2"]]},{"para":835,"vripara":null,"refs":["pv16:2"],"lines":["Bhikkhū ca sīlasampanne, vītarāge bahussute. 175."],"lineRefs":[["pv16:2"]]},{"para":837,"vripara":"175","refs":["pv16:2"],"lines":["“Tappehi annapānena, mama dakkhiṇamādisa;"],"lineRefs":[["pv16:2"]]},{"para":838,"vripara":null,"refs":["pv16:2"],"lines":["Tadāhaṃ sukhitā hessaṃ, sabbakāmasamiddhinī”ti. –"],"lineRefs":[["pv16:2"]]},{"para":839,"vripara":null,"refs":["pv16:2"],"lines":["Dve gāthā abhāsi.","Tato – 176."],"lineRefs":[["pv16:2"],["pv16:2"]]},{"para":841,"vripara":"176","refs":["pv16:2"],"lines":["“Sādhūti so paṭissutvā, dānaṃ vipulamākiri;"],"lineRefs":[["pv16:2"]]},{"para":842,"vripara":null,"refs":["pv16:2"],"lines":["Annaṃ pānaṃ khādanīyaṃ, vatthasenāsanāni ca;"],"lineRefs":[["pv16:2"]]},{"para":843,"vripara":null,"refs":["pv16:2"],"lines":["Chattaṃ gandhañca mālañca, vividhā ca upāhanā. 177."],"lineRefs":[["pv16:2"]]},{"para":845,"vripara":"177","refs":["pv16:2"],"lines":["“Bhikkhū ca sīlasampanne, vītarāge bahussute;"],"lineRefs":[["pv16:2"]]},{"para":846,"vripara":null,"refs":["pv16:2"],"lines":["Tappetvā annapānena, tassā dakkhiṇamādisī. 178."],"lineRefs":[["pv16:2"]]},{"para":848,"vripara":"178","refs":["pv16:2"],"lines":["“Samanantarānuddiṭṭhe, vipāko udapajjatha;"],"lineRefs":[["pv16:2"]]},{"para":849,"vripara":null,"refs":["pv16:2"],"lines":["Bhojanacchādanapānīyaṃ, dakkhiṇāya idaṃ phalaṃ. 179."],"lineRefs":[["pv16:2"]]},{"para":851,"vripara":"179","refs":["pv16:2"],"lines":["“Tato suddhā sucivasanā, kāsikuttamadhārinī;"],"lineRefs":[["pv16:2"]]},{"para":852,"vripara":null,"refs":["pv16:2"],"lines":["Vicittavatthābharaṇā, sāmikaṃ upasaṅkamī”ti. –"],"lineRefs":[["pv16:2"]]},{"para":853,"vripara":null,"refs":["pv16:2"],"lines":["Catasso gāthā saṅgītikārehi vuttā.","Tato paraṃ – 180."],"lineRefs":[["pv16:2"],["pv16:2"]]},{"para":855,"vripara":"180","refs":["pv16:2"],"lines":["“Abhikkantena vaṇṇena, yā tvaṃ tiṭṭhasi devate;"],"lineRefs":[["pv16:2"]]},{"para":856,"vripara":null,"refs":["pv16:2"],"lines":["Obhāsentī disā sabbā, osadhī viya tārakā. 181."],"lineRefs":[["pv16:2"]]},{"para":858,"vripara":"181","refs":["pv16:2"],"lines":["“Kena tetādiso vaṇṇo, kena te idha mijjhati;"],"lineRefs":[["pv16:2"]]},{"para":859,"vripara":null,"refs":["pv16:2"],"lines":["Uppajjanti ca te bhogā, ye keci manaso piyā. 182."],"lineRefs":[["pv16:2"]]},{"para":861,"vripara":"182","refs":["pv16:2"],"lines":["“Pucchāmi taṃ devi mahānubhāve, manussabhūtā kimakāsi puññaṃ;"],"lineRefs":[["pv16:2"]]},{"para":862,"vripara":null,"refs":["pv16:2"],"lines":["Kenāsi evaṃ jalitānubhāvā, vaṇṇo ca te sabbadisā pabhāsatī”ti. 183."],"lineRefs":[["pv16:2"]]},{"para":864,"vripara":"183","refs":["pv16:2"],"lines":["“Ahaṃ nandā nandisena, bhariyā te pure ahuṃ;"],"lineRefs":[["pv16:2"]]},{"para":865,"vripara":null,"refs":["pv16:2"],"lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gatā. 184."],"lineRefs":[["pv16:2"]]},{"para":867,"vripara":"184","refs":["pv16:2"],"lines":["“Tava dinnena dānena, modāmi akutobhayā;"],"lineRefs":[["pv16:2"]]},{"para":868,"vripara":null,"refs":["pv16:2"],"lines":["Ciraṃ jīva gahapati, saha sabbehi ñātibhi;"],"lineRefs":[["pv16:2"]]},{"para":869,"vripara":null,"refs":["pv16:2"],"lines":["Asokaṃ virajaṃ khemaṃ, āvāsaṃ vasavattinaṃ. 185."],"lineRefs":[["pv16:2"]]},{"para":871,"vripara":"185","refs":["pv16:2"],"lines":["“Idha dhammaṃ caritvāna, dānaṃ datvā gahapati;"],"lineRefs":[["pv16:2"]]},{"para":872,"vripara":null,"refs":["pv16:2"],"lines":["Vineyya maccheramalaṃ samūlaṃ, anindito saggamupehi ṭhāna”nti. –"],"lineRefs":[["pv16:2"]]},{"para":873,"vripara":null,"refs":["pv16:2"],"lines":["Upāsakassa ca petiyā ca vacanapaṭivacanagāthā. 176."],"lineRefs":[["pv16:2"]]},{"para":874,"vripara":"176","refs":["pv16:9"],"lines":["Tattha <b>dānaṃ vipulamākirī</b>ti ukkhiṇeyyakhette deyyadhammabījaṃ vippakiranto viya mahādānaṃ pavattesi.","Sesaṃ anantaravatthusadisameva."],"lineRefs":[["pv16:9"],["pv16:9"]]}],"wordLinks":[["pv16:1.1","kāḷī",0,1],["pv16:1.1","pharusā",0,2],["pv16:1.1","bhīrudassanā",0,3],["pv16:1.3","piṅgalā",0,5],["pv16:1.3","kaḷārā",0,6],["pv16:1.3","na taṃ maññāmi mānusiṃ",0,7],["pv16:2.1","ahaṃ nandā nandisenā",3,1],["pv16:2.1","bhariyā te pure ahuṃ",3,2],["pv16:9.1","dānaṃ vipulamākirī",43,0]],"before":[{"para":809,"vripara":null,"title":"Nandāpetivatthuvaṇṇanā","lines":["Nandāpetivatthuvaṇṇanā"]},{"para":810,"vripara":null,"title":"Nandāpetivatthuvaṇṇanā","lines":["<b>Kāḷī dubbaṇṇarūpāsī</b>ti idaṃ satthari jetavane viharante nandaṃ nāma petiṃ ārabbha vuttaṃ.","Sāvatthiyā kira avidūre aññatarasmiṃ gāmake nandiseno nāma upāsako ahosi saddho pasanno.","Bhariyā panassa nandā nāma assaddhā appasannā maccharinī caṇḍī pharusavacanā sāmike agāravā aggatissā sassuṃ corivādena akkosati paribhāsati.","Sā aparena samayena kālaṃ katvā petayoniyaṃ nibbattitvā tasseva gāmassa avidūre vicarantī ekadivasaṃ nandisenassa upāsakassa gāmato nikkhamantassa avidūre attānaṃ dassesi.","So taṃ disvā – 168."]},{"para":812,"vripara":"168","title":"Nandāpetivatthuvaṇṇanā","lines":["“Kāḷī dubbaṇṇarūpāsi, pharusā bhīrudassanā;"]},{"para":813,"vripara":null,"title":"Nandāpetivatthuvaṇṇanā","lines":["Piṅgalāsi kaḷārāsi, na taṃ maññāmi mānusi”nti. –"]}],"after":[{"para":875,"vripara":null,"title":"Nandāpetivatthuvaṇṇanā","lines":["Evaṃ sā attano dibbasampattiṃ tassā ca kāraṇaṃ nandisenassa vibhāvetvā attano vasanaṭṭhānameva gatā.","Upāsako taṃ pavattiṃ bhikkhūnaṃ ārocesi, bhikkhū bhagavato ārocesuṃ.","Bhagavā tamatthaṃ aṭṭhuppattiṃ katvā sampattaparisāya dhammaṃ desesi.","Sā desanā mahājanassa sātthikā ahosīti."]},{"para":876,"vripara":null,"title":"Nandāpetivatthuvaṇṇanā","lines":["Nandāpetivatthuvaṇṇanā niṭṭhitā. 5."]}]},"tika":null,"tika2":null}
