{"suttaId":"tha-ap549","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[5565,5654],"vripara":"195"},"segments":{"tha-ap549:0.3":"Abhayattheraapadānaṃ","tha-ap549:1.1":"“Padumuttaro nāma jino,","tha-ap549:1.2":"sabbadhammesu cakkhumā;","tha-ap549:1.3":"Ito satasahassamhi,","tha-ap549:1.4":"kappe uppajji nāyako. 196.","tha-ap549:2.1":"“Saraṇagamane kiñci,","tha-ap549:2.2":"nivesesi tathāgato;","tha-ap549:2.3":"Kiñci sīle nivesesi,","tha-ap549:2.4":"dasakammapathuttame. 197.","tha-ap549:3.1":"“Deti kassaci so vīro,","tha-ap549:3.2":"sāmaññaphalamuttamaṃ;","tha-ap549:3.3":"Samāpattī tathā aṭṭha,","tha-ap549:3.4":"tisso vijjā pavacchati. 198.","tha-ap549:4.1":"“Chaḷabhiññāsu yojesi,","tha-ap549:4.2":"kiñci sattaṃ naruttamo;","tha-ap549:4.3":"Deti kassaci nātho so,","tha-ap549:4.4":"catasso paṭisambhidā. 199.","tha-ap549:5.1":"“Bodhaneyyaṃ pajaṃ disvā,","tha-ap549:5.2":"asaṅkheyyampi yojanaṃ [asaṅkheyyepi yojane sī. syā. pī.)];","tha-ap549:5.3":"Khaṇena upagantvāna,","tha-ap549:5.4":"vineti narasārathi. 200.","tha-ap549:6.1":"“Tadāhaṃ haṃsavatiyaṃ,","tha-ap549:6.2":"ahosiṃ brāhmaṇatrajo;","tha-ap549:6.3":"Pāragū sabbavedānaṃ,","tha-ap549:6.4":"veyyākaraṇasammato. 201.","tha-ap549:7.1":"“Niruttiyā ca kusalo,","tha-ap549:7.2":"nighaṇḍumhi visārado;","tha-ap549:7.3":"Padako keṭubhavidū,","tha-ap549:7.4":"chandovicitikovido. 202.","tha-ap549:8.1":"“Jaṅghāvihāraṃ vicaraṃ,","tha-ap549:8.2":"haṃsārāmamupeccahaṃ;","tha-ap549:8.3":"Addasaṃ varadaṃ [vadataṃ (sī. pī.), pavaraṃ (syā.)] seṭṭhaṃ,","tha-ap549:8.4":"mahājanapurakkhataṃ. 203.","tha-ap549:9.1":"“Desentaṃ virajaṃ dhammaṃ,","tha-ap549:9.2":"paccanīkamatī ahaṃ;","tha-ap549:9.3":"Upetvā tassa kalyāṇaṃ,","tha-ap549:9.4":"sutvāna vimalaṃ ahaṃ [vākyāni, sutvāna vimalānahaṃ (sī. syā. pī.)]. 204.","tha-ap549:10.1":"“Byāhataṃ punaruttaṃ vā,","tha-ap549:10.2":"apatthaṃ vā niratthakaṃ;","tha-ap549:10.3":"Nāddasaṃ tassa munino,","tha-ap549:10.4":"tato pabbajito ahaṃ. 205.","tha-ap549:11.1":"“Nacireneva kālena,","tha-ap549:11.2":"sabbasattavisārado;","tha-ap549:11.3":"Nipuṇo buddhavacane,","tha-ap549:11.4":"ahosiṃ guṇisammato. 206.","tha-ap549:12.1":"“Tadā catasso gāthāyo,","tha-ap549:12.2":"ganthayitvā subyañjanā;","tha-ap549:12.3":"Santhavitvā tilokaggaṃ,","tha-ap549:12.4":"desayissaṃ dine dine. 207.","tha-ap549:13.1":"“Virattosi mahāvīro,","tha-ap549:13.2":"saṃsāre sabhaye vasaṃ;","tha-ap549:13.3":"Karuṇāya na nibbāyi,","tha-ap549:13.4":"tato kāruṇiko muni. 208.","tha-ap549:14.1":"“Puthujjano vayo santo,","tha-ap549:14.2":"na kilesavaso ahu;","tha-ap549:14.3":"Sampajāno satiyutto,","tha-ap549:14.4":"tasmā eso acintiyo. 209.","tha-ap549:15.1":"“Dubbalāni kilesāni,","tha-ap549:15.2":"yassāsayagatāni me;","tha-ap549:15.3":"Ñāṇaggiparidaḍḍhāni,","tha-ap549:15.4":"na khīyiṃsu tamabbhutaṃ. 210.","tha-ap549:16.1":"“Yo sabbalokassa garu,","tha-ap549:16.2":"loko [loke (syā. ka.)] yassa tathā garu;","tha-ap549:16.3":"Tathāpi lokācariyo,","tha-ap549:16.4":"loko tassānuvattako. 211.","tha-ap549:17.1":"“Evamādīhi sambuddhaṃ,","tha-ap549:17.2":"kittayaṃ dhammadesanaṃ;","tha-ap549:17.3":"Yāvajīvaṃ karitvāna,","tha-ap549:17.4":"gato saggaṃ tato cuto. 212.","tha-ap549:18.1":"“Satasahassito kappe,","tha-ap549:18.2":"yaṃ buddhamabhikittayiṃ;","tha-ap549:18.3":"Duggatiṃ nābhijānāmi,","tha-ap549:18.4":"kittanāya idaṃ phalaṃ. 213.","tha-ap549:19.1":"“Devaloke mahārajjaṃ,","tha-ap549:19.2":"pādesiṃ kañcanagghiyaṃ [dibbānubhojahaṃ tadā (syā.), rajjaṃ pādesi kaṃcayaṃ (sī.)];","tha-ap549:19.3":"Cakkavattī mahārajjaṃ,","tha-ap549:19.4":"bahusonubhaviṃ ahaṃ. 214.","tha-ap549:20.1":"“Duve bhave pajāyāmi,","tha-ap549:20.2":"devatte atha mānuse;","tha-ap549:20.3":"Aññaṃ gatiṃ na jānāmi,","tha-ap549:20.4":"kittanāya idaṃ phalaṃ. 215.","tha-ap549:21.1":"“Duve kule pajāyāmi,","tha-ap549:21.2":"khattiye atha brāhmaṇe;","tha-ap549:21.3":"Nīce kule na jāyāmi,","tha-ap549:21.4":"kittanāya idaṃ phalaṃ. 216.","tha-ap549:22.1":"“Pacchime ca bhave dāni,","tha-ap549:22.2":"giribbajapuruttame;","tha-ap549:22.3":"Raññohaṃ bimbisārassa,","tha-ap549:22.4":"putto nāmena cābhayo. 217.","tha-ap549:23.1":"“Pāpamittavasaṃ gantvā,","tha-ap549:23.2":"nigaṇṭhena vimohito;","tha-ap549:23.3":"Pesito nāṭaputtena,","tha-ap549:23.4":"buddhaseṭṭhamupeccahaṃ. 218.","tha-ap549:24.1":"“Pucchitvā nipuṇaṃ pañhaṃ,","tha-ap549:24.2":"sutvā byākaraṇuttamaṃ;","tha-ap549:24.3":"Pabbajitvāna naciraṃ,","tha-ap549:24.4":"arahattamapāpuṇiṃ. 219.","tha-ap549:25.1":"“Kittayitvā jinavaraṃ,","tha-ap549:25.2":"kittito homi sabbadā;","tha-ap549:25.3":"Sugandhadehavadano,","tha-ap549:25.4":"āsiṃ sukhasamappito. 220.","tha-ap549:26.1":"“Tikkhahāsalahupañño,","tha-ap549:26.2":"mahāpañño tathevahaṃ;","tha-ap549:26.3":"Vicittapaṭibhāno ca,","tha-ap549:26.4":"tassa kammassa vāhasā. 221.","tha-ap549:27.1":"“Abhitthavitvā padumuttarāhaṃ,","tha-ap549:27.2":"pasannacitto asamaṃ sayambhuṃ;","tha-ap549:27.3":"Na gacchi kappāni apāyabhūmiṃ,","tha-ap549:27.4":"sataṃ sahassāni balena tassa. 222.","tha-ap549:28.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap549:28.3":"viharāmi anāsavo. 223.","tha-ap549:29.1":"“Svāgataṃ vata me āsi…pe…","tha-ap549:29.3":"kataṃ buddhassa sāsanaṃ. 224.","tha-ap549:30.1":"“Paṭisambhidā catasso…pe…","tha-ap549:30.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap549:31.1":"Itthaṃ sudaṃ āyasmā abhayo thero imā gāthāyo Abhāsitthāti.","tha-ap549:32.1":"Abhayattherassāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3713,"to":3713,"paras":[{"para":3713,"vripara":"195","refs":["tha-ap549:1"],"lines":["So arahattaṃ patvā attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>padumuttaro nāma jino</b>tiādimāha.","Taṃ sabbaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap549:1"],["tha-ap549:1"]]}],"wordLinks":[["tha-ap549:1.1","padumuttaro nāma jino",0,0]],"before":[{"para":3711,"vripara":null,"title":"Abhayattheraapadānavaṇṇanā","lines":["Abhayattheraapadānavaṇṇanā"]},{"para":3712,"vripara":null,"title":"Abhayattheraapadānavaṇṇanā","lines":["Sattamāpadāne <b>padumuttaro nāma jino</b>tiādikaṃ āyasmato abhayattherassa apadānaṃ.","Ayampi purimajinavaresu katādhikāro tattha tattha bhave vipaṭṭūpanissayāni puññāni upacinanto padumuttarassa bhagavato kāle haṃsavatīnagare brāhmaṇakule nibbatto.","So vuddhimanvāya vedaṅgapārago sakaparasamayakusalo ekadivasaṃ satthu dhammadesanaṃ sutvā pasannamānaso bhagavantaṃ gāthāhi thomesi.","So tattha yāvatāyukaṃ ṭhatvā puññāni katvā tato cuto devaloke nibbatto aparāparaṃ sugatīsuyevaṃ saṃsaranto imasmiṃ buddhuppāde rājagahe bimbisārarañño putto hutvā nibbatti, <b>abhayo</b>tvevassa nāmaṃ kariṃsu.","So vayappatto nigaṇṭhehi saddhiṃ vissāsiko hutvā caranto ekadivasaṃ nigaṇṭhena nāṭaputtena satthu vādāropanatthāya pesito nipuṇapañhaṃ pucchitvā nipuṇabyākaraṇaṃ sutvā pasanno satthu santike pabbajitvā kammaṭṭhānānurūpaṃ ñāṇaṃ pesetvā nacirasseva arahattaṃ pāpuṇi. 195."]}],"after":[{"para":3714,"vripara":null,"title":"Abhayattheraapadānavaṇṇanā","lines":["Abhayattheraapadānavaṇṇanā samattā. 8."]}]},"tika":null,"tika2":null}
