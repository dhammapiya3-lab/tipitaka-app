{"suttaId":"sn45.34","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[137,149],"vripara":"34"},"segments":{"sn45.34:0.3":"Pāraṅgamasuttaṃ","sn45.34:1.1":"Sāvatthinidānaṃ.","sn45.34:1.2":"“Aṭṭhime, bhikkhave, dhammā bhāvitā bahulīkatā apārā pāraṃ gamanāya saṃvattanti.","sn45.34:1.3":"Katame aṭṭha?","sn45.34:1.4":"Seyyathidaṃ – sammādiṭṭhi…pe… sammāsamādhi.","sn45.34:1.5":"Ime kho, bhikkhave, aṭṭha dhammā bhāvitā bahulīkatā apārā pāraṃ gamanāya saṃvattantī”ti.","sn45.34:2.1":"Idamavoca bhagavā.","sn45.34:2.2":"Idaṃ vatvāna sugato athāparaṃ etadavoca satthā –","sn45.34:3.1":"“Appakā te manussesu,","sn45.34:3.2":"ye janā pāragāmino;","sn45.34:3.3":"Athāyaṃ itarā pajā,","sn45.34:3.4":"tīramevānudhāvati.","sn45.34:4.1":"“Ye ca kho sammadakkhāte,","sn45.34:4.2":"dhamme dhammānuvattino;","sn45.34:4.3":"Te janā pāramessanti,","sn45.34:4.4":"maccudheyyaṃ suduttaraṃ.","sn45.34:5.1":"“Kaṇhaṃ dhammaṃ vippahāya,","sn45.34:5.2":"sukkaṃ bhāvetha paṇḍito;","sn45.34:5.3":"Okā anokamāgamma,","sn45.34:5.4":"viveke yattha dūramaṃ.","sn45.34:6.1":"“Tatrābhiratimiccheyya,","sn45.34:6.2":"hitvā kāme akiñcano;","sn45.34:6.3":"Pariyodapeyya attānaṃ,","sn45.34:6.4":"cittaklesehi paṇḍito.","sn45.34:7.1":"“Yesaṃ sambodhiyaṅgesu,","sn45.34:7.2":"sammā cittaṃ subhāvitaṃ;","sn45.34:7.3":"Ādānapaṭinissagge,","sn45.34:7.4":"anupādāya ye ratā;","sn45.34:7.5":"Khīṇāsavā jutimanto,","sn45.34:7.6":"te loke parinibbutā”ti.","sn45.34:7.7":"catutthaṃ; 5."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":70,"to":74,"paras":[{"para":70,"vripara":"31-40","refs":["sn45.34:1"],"lines":["Catutthe <b>micchāpaṭipatti</b>nti ayāthāvapaṭipattiṃ.","<b>Micchāpaṭipanna</b>nti ayāthāvapaṭipannaṃ.","Iti ekaṃ suttaṃ dhammavasena kathitaṃ, ekaṃ puggalavasena.","<b>Apārā pāra</b>nti vaṭṭato nibbānaṃ.","<b>Pāragāmino</b>ti ettha yepi pāraṅgatā, yepi gacchanti, yepi gamissanti, sabbe pāragāminotveva veditabbā."],"lineRefs":[["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"]]},{"para":71,"vripara":null,"refs":["sn45.34:1"],"lines":["<b>Tīramevānudhāvatī</b>ti vaṭṭameva anudhāvati, vaṭṭe vicarati.","<b>Kaṇha</b>nti akusaladhammaṃ.","<b>Sukka</b>nti kusaladhammaṃ.","<b>Okā anoka</b>nti vaṭṭato nibbānaṃ.","<b>Āgammā</b>ti ārabbha sandhāya paṭicca.","<b>Pariyodapeyyā</b>ti parisuddhaṃ kareyya.","<b>Cittaklesehī</b>ti cittaṃ kilissāpentehi nīvaraṇehi.","<b>Sambodhiyaṅgesū</b>ti sattasu bojjhaṅgesu."],"lineRefs":[["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"]]},{"para":72,"vripara":null,"refs":["sn45.34:1"],"lines":["<b>Sāmaññattha</b>nti nibbānaṃ.","Tañhi sāmaññena upagantabbato sāmaññatthoti vuccati.","<b>Brahmañña</b>nti seṭṭhabhāvaṃ.","<b>Brahmaññattha</b>nti nibbānaṃ brahmaññena upagantabbato.","Yattha yattha pana heṭṭhā ca imesu ca tīsu suttesu “rāgakkhayo”ti āgataṃ, tattha tattha arahattampi vaṭṭatiyevāti vadanti."],"lineRefs":[["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"]]},{"para":73,"vripara":null,"refs":["sn45.34:1"],"lines":["Paṭipattivaggo catuttho. 5."],"lineRefs":[["sn45.34:1"]]},{"para":74,"vripara":null,"refs":["sn45.34:1"],"lines":["Aññatitthiyapeyyālavaggavaṇṇanā 41-48."],"lineRefs":[["sn45.34:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":70,"to":74,"paras":[{"para":70,"vripara":"31-40","refs":["sn45.34:1"],"lines":["<b>Ayāthāvapaṭipatti,</b> na yathāpaṭipatti, hetumhipi phalepi ayāthāvavatthusādhanato.","<b>Ekaṃ suttaṃ dhammavasena kathitaṃ</b> paṭipattivasena.","<b>Ekaṃ suttaṃ puggalavasena kathitaṃ</b> paṭipannakavasena.","Saṃsāramahoghassa paratīrabhāvato yo naṃ adhigacchati, taṃ pāreti gametīti pāraṃ, nibbānaṃ, tabbidhuratāya natthi ettha pāranti apāraṃ, saṃsāroti vuttaṃ –","<b>“apārāpāranti vaṭṭato nibbāna”</b>nti.","<b>Pāraṅgatā</b>ti asekkhe sandhāya.","<b>Yepi gacchantī</b>ti sekkhe.","<b>Yepi gamissantī</b>ti kalyāṇaputhujjane.","<b>Pāragāmino</b>ti ettha kita-saddo tikālavācīti evaṃ vuttaṃ."],"lineRefs":[["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"]]},{"para":71,"vripara":null,"refs":["sn45.34:1"],"lines":["<b>Tīra</b>nti orimatīramāha.","Tena vuttaṃ <b>“vaṭṭameva anudhāvatī”</b>ti.","Ekantakāḷakattā cittassa apabhassarabhāvakaraṇato kaṇhābhijātihetuto ca vuttaṃ <b>“kaṇhanti akusaladhamma”</b>nti.","Vodānabhāvato cittassa pabhassarabhāvakaraṇato sukkābhijātihetuto ca vuttaṃ –","<b>“sukkanti kusaladhamma”</b>nti.","Kilesamāra-abhisaṅkhāramāra-maccumārānaṃ pavattiṭṭhānatāya okaṃ vuccati vaṭṭaṃ, tabbidhuratāya anokanti nibbānanti āha –","<b>“okā anokanti vaṭṭato nibbāna”</b>nti."],"lineRefs":[["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"]]},{"para":72,"vripara":null,"refs":["sn45.34:1"],"lines":["Paramatthato samaṇā vuccanti ariyā, samaṇānaṃ bhāvo sāmaññaṃ, ariyamaggo, tena araṇīyato upagantabbato sāmaññattho nibbānanti āha –","<b>“sāmaññatthanti nibbānaṃ, taṃ hī”</b>tiādi.","<b>Brahmaññattha</b>nti etthāpi iminā nayena attho veditabbo.","<b>Brahmaññena</b> ariyamaggena.","<b>Rāgakkhayo</b>ti ettha <b>iti</b>-saddo ādisaddattho.","Tena “dosakkhayo mohakkhayo”ti padadvayaṃ saṅgaṇhāti.","<b>Vaṭṭatiyevāti vadanti</b> “rāgakkhayo”ti.","Pariyāyena hi arahattassa vattabbattāti."],"lineRefs":[["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"],["sn45.34:1"]]},{"para":73,"vripara":null,"refs":["sn45.34:1"],"lines":["Paṭipattivaggavaṇṇanā niṭṭhitā. 5."],"lineRefs":[["sn45.34:1"]]},{"para":74,"vripara":null,"refs":["sn45.34:1"],"lines":["Aññatitthiyapeyyālavaggavaṇṇanā 41-48."],"lineRefs":[["sn45.34:1"]]}],"wordLinks":[]},"tika2":null}
