{"suttaId":"sn45.34","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[137,149],"vripara":"34"},"segments":{"sn45.34:0.3":"Pāraṅgamasuttaṃ","sn45.34:1.1":"Sāvatthinidānaṃ.","sn45.34:1.2":"“Aṭṭhime, bhikkhave, dhammā bhāvitā bahulīkatā apārā pāraṃ gamanāya saṃvattanti.","sn45.34:1.3":"Katame aṭṭha?","sn45.34:1.4":"Seyyathidaṃ – sammādiṭṭhi … pe … sammāsamādhi.","sn45.34:1.5":"Ime kho, bhikkhave, aṭṭha dhammā bhāvitā bahulīkatā apārā pāraṃ gamanāya saṃvattantī”ti.","sn45.34:2.1":"Idamavoca bhagavā.","sn45.34:2.2":"Idaṃ vatvāna sugato athāparaṃ etadavoca satthā –","sn45.34:3.1":"“Appakā te manussesu, ye janā pāragāmino;","sn45.34:3.3":"Athāyaṃ itarā pajā, tīramevānudhāvati.","sn45.34:4.1":"“Ye ca kho sammadakkhāte, dhamme dhammānuvattino;","sn45.34:4.3":"Te janā pāramessanti, maccudheyyaṃ suduttaraṃ.","sn45.34:5.1":"“Kaṇhaṃ dhammaṃ vippahāya, sukkaṃ bhāvetha paṇḍito;","sn45.34:5.3":"Okā anokamāgamma, viveke yattha dūramaṃ.","sn45.34:6.1":"“Tatrābhiratimiccheyya, hitvā kāme akiñcano;","sn45.34:6.3":"Pariyodapeyya attānaṃ, cittaklesehi paṇḍito.","sn45.34:7.1":"“Yesaṃ sambodhiyaṅgesu, sammā cittaṃ subhāvitaṃ;","sn45.34:7.3":"Ādānapaṭinissagge, anupādāya ye ratā;","sn45.34:7.5":"Khīṇāsavā jutimanto, te loke parinibbutā”ti.","sn45.34:7.7":"catutthaṃ;"},"attha":null,"tika":null}
