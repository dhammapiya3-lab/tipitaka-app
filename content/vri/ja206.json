{"suttaId":"ja206","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1345,1351],"vripara":"111"},"segments":{"ja206:0.4":"Kuruṅgamigajātakaṃ (2-6-6)","ja206:1.1":"Iṅgha vaddhamayaṃ [vaddhamayaṃ (sī. syā. pī.)] pāsaṃ, chinda dantehi kacchapa;","ja206:1.3":"Ahaṃ tathā karissāmi, yathā nehiti luddako.","ja206:2.1":"Kacchapo pāvisī vāriṃ, kuruṅgo pāvisī vanaṃ;","ja206:2.3":"Satapatto dumaggamhā, dūre putte apānayīti.","ja206:3.1":"Kuruṅgamigajātakaṃ chaṭṭhaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":971,"to":971,"paras":[{"para":971,"vripara":null,"refs":["ja206:2"],"lines":["Tattha <b>apānayī</b>ti ānayi, gahetvā agamāsīti attho;"],"lineRefs":[["ja206:2"]]}],"wordLinks":[["ja206:2.3","apānayī",0,0]]},"tika":null}
