{"suttaId":"tha-ap449","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[950,973],"vripara":"42"},"segments":{"tha-ap449:0.3":"Sīhāsanikattheraapadānaṃ","tha-ap449:1.1":"“Padumuttarassa bhagavato,","tha-ap449:1.2":"sabbabhūtahitesino;","tha-ap449:1.3":"Pasannacitto sumano,","tha-ap449:1.4":"sīhāsanamadāsahaṃ.","tha-ap449:2.1":"“Devaloke manusse vā,","tha-ap449:2.2":"yattha yattha vasāmahaṃ;","tha-ap449:2.3":"Labhāmi vipulaṃ byamhaṃ,","tha-ap449:2.4":"sīhāsanassidaṃ phalaṃ.","tha-ap449:3.1":"“Soṇṇamayā rūpimayā,","tha-ap449:3.2":"lohitaṅgamayā [lohitaṅkamayā (sī. syā. pī.)] bahū;","tha-ap449:3.3":"Maṇimayā ca pallaṅkā,","tha-ap449:3.4":"nibbattanti mamaṃ sadā.","tha-ap449:4.1":"“Bodhiyā āsanaṃ katvā,","tha-ap449:4.2":"jalajuttamanāmino;","tha-ap449:4.3":"Ucce kule pajāyāmi,","tha-ap449:4.4":"aho dhammasudhammatā.","tha-ap449:5.1":"“Satasahassito kappe,","tha-ap449:5.2":"sīhāsanamakāsahaṃ;","tha-ap449:5.3":"Duggatiṃ nābhijānāmi,","tha-ap449:5.4":"sīhāsanassidaṃ phalaṃ.","tha-ap449:6.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap449:6.3":"viharāmi anāsavo.","tha-ap449:7.1":"“Svāgataṃ vata me āsi … pe …","tha-ap449:7.3":"kataṃ buddhassa sāsanaṃ.","tha-ap449:8.1":"“Paṭisambhidā catasso … pe …","tha-ap449:8.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap449:9.1":"Itthaṃ sudaṃ āyasmā sīhāsaniko thero imā gāthāyo Abhāsitthāti.","tha-ap449:10.1":"Sīhāsanikattherassāpadānaṃ sattamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
