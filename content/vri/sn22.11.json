{"suttaId":"sn22.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[104,110],"vripara":"11"},"segments":{"sn22.11:0.3":"Kālattayaanattasuttaṃ","sn22.11:1.1":"Sāvatthinidānaṃ.","sn22.11:1.2":"“Rūpaṃ, bhikkhave, anattā atītānāgataṃ;","sn22.11:1.3":"ko pana vādo paccuppannassa!","sn22.11:1.4":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītasmiṃ rūpasmiṃ anapekkho hoti;","sn22.11:1.5":"anāgataṃ rūpaṃ nābhinandati;","sn22.11:1.6":"paccuppannassa rūpassa nibbidāya virāgāya nirodhāya paṭipanno hoti.","sn22.11:1.7":"Vedanā anattā …","sn22.11:1.8":"saññā anattā …","sn22.11:1.9":"saṅkhārā anattā …","sn22.11:1.10":"viññāṇaṃ anattā atītānāgataṃ;","sn22.11:1.11":"ko pana vādo paccuppannassa!","sn22.11:1.12":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītasmiṃ viññāṇasmiṃ anapekkho hoti;","sn22.11:1.13":"anāgataṃ viññāṇaṃ nābhinandati;","sn22.11:1.14":"paccuppannassa viññāṇassa nibbidāya virāgāya nirodhāya paṭipanno hotī”ti.","sn22.11:1.15":"Ekādasamaṃ.","sn22.11:1.16":"Nakulapituvaggo paṭhamo.","sn22.11:2.0":"Tassuddānaṃ –","sn22.11:2.1":"Nakulapitā devadahā,","sn22.11:2.2":"dvepi hāliddikāni ca;","sn22.11:2.3":"Samādhipaṭisallāṇā,","sn22.11:2.4":"upādāparitassanā duve;","sn22.11:2.5":"Atītānāgatapaccuppannā,","sn22.11:2.6":"vaggo tena pavuccati."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":66,"to":69,"paras":[{"para":66,"vripara":"10-11","refs":["sn22.11:1"],"lines":["10-11. Dasamekādasamāni <b>dukkhaṃ anattā</b>ti padehi visesetvā tathārūpeneva puggalajjhāsayena kathitānīti.","Dasamekādasamāni."],"lineRefs":[["sn22.11:1"],["sn22.11:1"]]},{"para":67,"vripara":null,"refs":["sn22.11:1"],"lines":["Nakulapituvaggo paṭhamo."],"lineRefs":[["sn22.11:1"]]},{"para":68,"vripara":null,"refs":["sn22.11:1"],"lines":["Aniccavaggo"],"lineRefs":[["sn22.11:1"]]},{"para":69,"vripara":null,"refs":["sn22.11:1"],"lines":["1-10. Aniccasuttādivaṇṇanā"],"lineRefs":[["sn22.11:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":61,"to":65,"paras":[{"para":61,"vripara":"10-11","refs":["sn22.11:1"],"lines":["10-11. <b>Tathārūpenevā</b>ti yathārūpeneva puggalajjhāsayena navamaṃ suttaṃ kathitaṃ, tathārūpenevāti.","Te kira bhikkhū atītānāgataṃ “dukkhan”ti sallakkhetvā, tathā “anattā”ti sallakkhetvā paccuppanne kilamiṃsu.","“Atha nesan”tiādi sabbaṃ heṭṭhā vuttanayena vattabbaṃ."],"lineRefs":[["sn22.11:1"],["sn22.11:1"],["sn22.11:1"]]},{"para":62,"vripara":null,"refs":["sn22.11:1"],"lines":["Kālattayadukkhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.11:1"]]},{"para":63,"vripara":null,"refs":["sn22.11:1"],"lines":["Nakulapituvaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.11:1"]]},{"para":64,"vripara":null,"refs":["sn22.11:1"],"lines":["Aniccavaggo"],"lineRefs":[["sn22.11:1"]]},{"para":65,"vripara":null,"refs":["sn22.11:1"],"lines":["1-10. Aniccādisuttavaṇṇanā"],"lineRefs":[["sn22.11:1"]]}],"wordLinks":[]},"tika2":null}
