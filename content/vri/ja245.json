{"suttaId":"ja245","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1687,1693],"vripara":"190"},"segments":{"ja245:0.4":"Mūlapariyāyajātakaṃ (2-10-5)","ja245:1.1":"Kālo ghasati bhūtāni, sabbāneva sahattanā;","ja245:1.3":"Yo ca kālaghaso bhūto, sa bhūtapacaniṃ paci.","ja245:2.1":"Bahūni narasīsāni, lomasāni brahāni ca;","ja245:2.3":"Gīvāsu paṭimukkāni, kocidevettha kaṇṇavāti.","ja245:3.1":"Mūlapariyāyajātakaṃ pañcamaṃ."},"attha":null,"tika":null}
