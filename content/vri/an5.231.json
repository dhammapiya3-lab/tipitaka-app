{"suttaId":"an5.231","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1485,1486],"vripara":"231"},"segments":{"an5.231:0.3":"Āvāsikasuttaṃ","an5.231:1.1":"“Pañcahi, bhikkhave, dhammehi samannāgato āvāsiko bhikkhu abhāvanīyo hoti.","an5.231:1.2":"Katamehi pañcahi?","an5.231:1.3":"Na ākappasampanno hoti na vattasampanno;","an5.231:1.4":"na bahussuto hoti na sutadharo;","an5.231:1.5":"na paṭisallekhitā [sallekhitā (ka. sī.)] hoti na paṭisallānārāmo;","an5.231:1.6":"na kalyāṇavāco hoti na kalyāṇavākkaraṇo;","an5.231:1.7":"duppañño hoti jaḷo eḷamūgo.","an5.231:1.8":"Imehi kho, bhikkhave, pañcahi dhammehi samannāgato āvāsiko bhikkhu abhāvanīyo hoti.","an5.231:2.1":"“Pañcahi, bhikkhave, dhammehi samannāgato āvāsiko bhikkhu bhāvanīyo hoti.","an5.231:2.2":"Katamehi pañcahi?","an5.231:2.3":"Ākappasampanno hoti vattasampanno;","an5.231:2.4":"bahussuto hoti sutadharo;","an5.231:2.5":"paṭisallekhitā hoti paṭisallānārāmo;","an5.231:2.6":"kalyāṇavāco hoti kalyāṇavākkaraṇo;","an5.231:2.7":"paññavā hoti ajaḷo aneḷamūgo.","an5.231:2.8":"Imehi kho, bhikkhave, pañcahi dhammehi samannāgato āvāsiko bhikkhu bhāvanīyo hotī”ti.","an5.231:2.9":"Paṭhamaṃ."},"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":473,"to":473,"paras":[{"para":473,"vripara":"231","refs":["an5.231:1"],"lines":["Catutthassa paṭhame <b>na ākappasampanno</b>ti samaṇākappena sampanno.","<b>Abhāvanīyo hotī</b>ti vaḍḍhanīyo na hoti.","Dutiyaṃ uttānameva."],"lineRefs":[["an5.231:1"],["an5.231:1"],["an5.231:1"]]}],"wordLinks":[["an5.231:1.3","na ākappasampanno",0,0],["an5.231:1.1","abhāvanīyo hotī",0,1],["an5.231:1.8","abhāvanīyo hotī",0,1]],"before":[{"para":470,"vripara":null,"refs":[],"lines":["Dīghacārikavaggo tatiyo."],"lineRefs":[[]]},{"para":471,"vripara":null,"refs":[],"lines":["(24)4. Āvāsikavaggo"],"lineRefs":[[]]},{"para":472,"vripara":null,"refs":[],"lines":["Āvāsikasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-v","bo