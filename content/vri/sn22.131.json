{"suttaId":"sn22.131","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[803,804],"vripara":"131"},"segments":{"sn22.131:0.3":"Samudayasuttaṃ","sn22.131:1.1":"Bārāṇasiyaṃ viharanti isipatane migadāye…pe…","sn22.131:1.2":"“‘avijjā, avijjā’ti, āvuso sāriputta, vuccati.","sn22.131:1.3":"Katamā nu kho, āvuso, avijjā,","sn22.131:1.4":"kittāvatā ca avijjāgato hotī”ti?","sn22.131:2.1":"“Idhāvuso, assutavā puthujjano rūpassa samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānāti.","sn22.131:2.2":"Vedanāya…pe…","sn22.131:2.3":"saññāya…","sn22.131:2.4":"saṅkhārānaṃ…","sn22.131:2.5":"viññāṇassa samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānāti.","sn22.131:2.6":"Ayaṃ vuccatāvuso, avijjā;","sn22.131:2.7":"ettāvatā ca avijjāgato hotī”ti.","sn22.131:2.8":"Chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":387,"to":390,"paras":[{"para":387,"vripara":"126-135","refs":["sn22.131:1"],"lines":["Avijjāvaggo uttānatthova.","Imasmiñhi vagge sabbasuttesu catusaccameva kathitaṃ."],"lineRefs":[["sn22.131:1"],["sn22.131:1"]]},{"para":388,"vripara":null,"refs":["sn22.131:1"],"lines":["Avijjāvaggo terasamo. 14."],"lineRefs":[["sn22.131:1"]]},{"para":389,"vripara":null,"refs":["sn22.131:1"],"lines":["Kukkuḷavaggo 1-13."],"lineRefs":[["sn22.131:1"]]},{"para":390,"vripara":null,"refs":["sn22.131:1"],"lines":["Kukkuḷasuttādivaṇṇanā 136-149."],"lineRefs":[["sn22.131:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":390,"to":394,"paras":[{"para":390,"vripara":"126-135","refs":["sn22.131:1"],"lines":["<b>Imasmi</b>nti avijjāvagge.","<b>Catusaccameva kathitaṃ, tasmā</b> heṭṭhā vuttanayattā uttānamevāti adhippāyo."],"lineRefs":[["sn22.131:1"],["sn22.131:1"]]},{"para":391,"vripara":null,"refs":["sn22.131:1"],"lines":["Samudayadhammasuttādivaṇṇanā niṭṭhitā.