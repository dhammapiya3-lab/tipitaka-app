{"suttaId":"sn4.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1723,1728],"vripara":"144"},"segments":{"sn4.8:0.3":"Nandatisuttaṃ","sn4.8:1.1":"Evaṃ me sutaṃ –","sn4.8:1.2":"ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme.","sn4.8:1.3":"Atha kho māro pāpimā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavato santike imaṃ gāthaṃ abhāsi –","sn4.8:2.1":"“Nandati puttehi puttimā,","sn4.8:2.2":"gomā gobhi tatheva nandati;","sn4.8:2.3":"Upadhīhi narassa nandanā,","sn4.8:2.4":"na hi so nandati yo nirūpadhī”ti.","sn4.8:3.1":"“Socati puttehi puttimā,","sn4.8:3.2":"gomā gobhi tatheva socati;","sn4.8:3.3":"Upadhīhi narassa socanā,","sn4.8:3.4":"na hi so socati yo nirūpadhī”ti.","sn4.8:4.1":"Atha kho māro pāpimā “jānāti maṃ bhagavā, jānāti maṃ sugato”ti dukkhī dummano tatthevantaradhāyīti. 9."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":796,"to":797,"paras":[{"para":796,"vripara":"144","refs":["sn4.8:1"],"lines":["Aṭṭhamaṃ devatāsaṃyutte vuttatthameva.","Aṭṭhamaṃ. 9."],"lineRefs":[["sn4.8:1"],["sn4.8:1"]]},{"para":797,"vripara":null,"refs":["sn4.8:1"],"lines":["Paṭhamaāyusuttavaṇṇanā 145."],"lineRefs":[["sn4.8:1"]]}],"wordLinks":[],"before":[{"para":795,"vripara":null,"title":"Nandatisuttavaṇṇanā","lines":["Nandatisuttavaṇṇanā 144."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":953,"to":955,"paras":[{"para":953,"vripara":"144","refs":["sn4.8:1"],"lines":["Aṭṭhamaṃ uttānatthameva."],"lineRefs":[["sn4.8:1"]]},{"para":954,"vripara":null,"refs":["sn4.8:1"],"lines":["Nandatisuttavaṇṇanā niṭṭhitā. 9."],"lineRefs":[["sn4.8:1"]]},{"para":955,"vripara":null,"refs":["sn4.8:1"],"lines":["Paṭhamaāyusuttavaṇṇanā 145."],"lineRefs":[["sn4.8:1"]]}],"wordLinks":[],"before":[{"para":952,"vripara":null,"title":"Nandatisuttavaṇṇanā","lines":["Nandatisuttavaṇṇanā 144."]}],"after":[{"para":956,"vripara":"145","title":"Paṭhamaāyusuttavaṇṇanā","lines":["<b>Paṇṇāsaṃ</b> <b>vā vassāni jīvati</b> vassasatato upari seyyathāpi thero anuruddho.","<b>Saṭṭhi vā vassāni</b> seyyathāpi thero bākulo.","Paṭiharitvā paccanīkabhāve sātaṃ sukhaṃ etassāti paccanīkasāto, tabbhāvo <b>paccanīkasātatā,</b> tāya.","<b>Abhibhavitvā abhāsi</b> paṭivacanaṃ jānamānova."]}]},"tika2":null}
