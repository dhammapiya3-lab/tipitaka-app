{"suttaId":"tha-ap437","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[674,691],"vripara":"44"},"segments":{"tha-ap437:0.3":"Ucchukhaṇḍikattheraapadānaṃ","tha-ap437:1.1":"“Nagare bandhumatiyā,","tha-ap437:1.2":"dvārapālo ahosahaṃ;","tha-ap437:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap437:1.4":"sabbadhammāna pāraguṃ.","tha-ap437:2.1":"“Ucchukhaṇḍikamādāya,","tha-ap437:2.2":"buddhaseṭṭhassadāsahaṃ;","tha-ap437:2.3":"Pasannacitto sumano,","tha-ap437:2.4":"vipassissa mahesino.","tha-ap437:3.1":"“Ekanavutito kappe,","tha-ap437:3.2":"yaṃ ucchumadadiṃ tadā;","tha-ap437:3.3":"Duggatiṃ nābhijānāmi,","tha-ap437:3.4":"ucchukhaṇḍassidaṃ phalaṃ.","tha-ap437:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap437:4.3":"viharāmi anāsavo.","tha-ap437:5.1":"“Svāgataṃ vata me āsi … pe …","tha-ap437:5.3":"kataṃ buddhassa sāsanaṃ.","tha-ap437:6.1":"“Paṭisambhidā catasso … pe …","tha-ap437:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap437:7.1":"Itthaṃ sudaṃ āyasmā ucchukhaṇḍiko thero imā gāthāyo Abhāsitthāti.","tha-ap437:8.1":"Ucchukhaṇḍikattherassāpadānaṃ pañcamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
