{"suttaId":"thi-ap4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[6631,6647],"vripara":"31"},"segments":{"thi-ap4:0.3":"Saṅkamanatthātherīapadānaṃ","thi-ap4:1.1":"“Vipassissa bhagavato [koṇḍaññassa bhagavato (syā. pī.)], lokajeṭṭhassa tādino;","thi-ap4:1.3":"Rathiyaṃ paṭipannassa, tārayantassa pāṇino.","thi-ap4:2.1":"“Gharato nikkhamitvāna, avakujjā nipajjahaṃ;","thi-ap4:2.3":"Anukampako lokanātho, sirasi [sīsante (sī. ka.)] akkamī mama [tadā (syā. pī.)].","thi-ap4:3.1":"“Akkamitvāna sirasi [sambuddho (ka.)], agamā lokanāyako;","thi-ap4:3.3":"Tena cittappasādena, tusitaṃ agamāsahaṃ.","thi-ap4:4.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavā.","thi-ap4:5.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","thi-ap4:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","thi-ap4:7.1":"Itthaṃ sudaṃ saṅkamanatthā [saṅkamanadā (syā.)] bhikkhunī imā gāthāyo abhāsitthāti.","thi-ap4:8.1":"Saṅkamanatthātheriyāpadānaṃ catutthaṃ."},"attha":null,"tika":null}
