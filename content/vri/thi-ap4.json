{"suttaId":"thi-ap4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[6631,6647],"vripara":"31"},"segments":{"thi-ap4:0.3":"Saṅkamanatthātherīapadānaṃ","thi-ap4:1.1":"“Vipassissa bhagavato [koṇḍaññassa bhagavato (syā. pī.)],","thi-ap4:1.2":"lokajeṭṭhassa tādino;","thi-ap4:1.3":"Rathiyaṃ paṭipannassa,","thi-ap4:1.4":"tārayantassa pāṇino.","thi-ap4:2.1":"“Gharato nikkhamitvāna,","thi-ap4:2.2":"avakujjā nipajjahaṃ;","thi-ap4:2.3":"Anukampako lokanātho,","thi-ap4:2.4":"sirasi [sīsante (sī. ka.)] akkamī mama [tadā (syā. pī.)].","thi-ap4:3.1":"“Akkamitvāna sirasi [sambuddho (ka.)],","thi-ap4:3.2":"agamā lokanāyako;","thi-ap4:3.3":"Tena cittappasādena,","thi-ap4:3.4":"tusitaṃ agamāsahaṃ.","thi-ap4:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","thi-ap4:4.3":"viharāmi anāsavā.","thi-ap4:5.1":"“Svāgataṃ vata me āsi … pe …","thi-ap4:5.3":"kataṃ buddhassa sāsanaṃ.","thi-ap4:6.1":"“Paṭisambhidā catasso … pe …","thi-ap4:6.3":"kataṃ buddhassa sāsanaṃ”.","thi-ap4:7.1":"Itthaṃ sudaṃ saṅkamanatthā [saṅkamanadā (syā.)] bhikkhunī imā gāthāyo abhāsitthāti.","thi-ap4:8.1":"Saṅkamanatthātheriyāpadānaṃ catutthaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
