{"suttaId":"ja210","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1377,1387],"vripara":"119"},"segments":{"ja210:0.4":"Kandagalakajātakaṃ (2-6-10)","ja210:1.1":"Ambho ko nāma yaṃ rukkho,","ja210:1.2":"sinnapatto [sīnapatto (sī. pī.)] sakaṇṭako;","ja210:1.3":"Yattha ekappahārena,","ja210:1.4":"uttamaṅgaṃ vibhijjitaṃ [visāṭikaṃ (sī. syā. pī.), vighāṭitaṃ (sī. niyya)].","ja210:2.1":"Acāri vatāyaṃ vitudaṃ vanāni,","ja210:2.2":"kaṭṭhaṅgarukkhesu asārakesu;","ja210:2.3":"Athāsadā khadiraṃ jātasāraṃ [jātisāraṃ (ka.)],","ja210:2.4":"yatthabbhidā garuḷo uttamaṅganti.","ja210:3.1":"Kandagalaka [kandalaka (ka.)] jātakaṃ dasamaṃ.","ja210:3.2":"Nataṃdaḷhavaggo chaṭṭho.","ja210:4.1":"Tassuddānaṃ –","ja210:5.1":"Daḷhabandhana haṃsavaro ca puna,","ja210:5.2":"virūpakkha saviṭṭhaka macchavaro;","ja210:5.3":"Sakuruṅga saassaka ambavaro,","ja210:5.4":"puna kukkuṭako garuḷena dasāti."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1029,"to":1034,"paras":[{"para":1029,"vripara":null,"refs":["ja210:1"],"lines":["Tattha <b>ambho ko nāmayaṃ rukkho</b>ti, bho khadiravaniya, ko nāma ayaṃ rukkho.","“Ko nāma so” tipi pāṭho.","<b>Sinnapatto</b>ti sukhumapatto.","<b>Yattha ekappahārenā</b>ti yasmiṃ rukkhe ekeneva pahārena.","<b>Uttamaṅgaṃ vibhijjitan</b>ti sīsaṃ bhinnaṃ, na kevalañca sīsaṃ, tuṇḍampi bhinnaṃ.","So vedanāppattatāya khadirarukkhaṃ “kiṃ rukkho nāmeso”ti jānituṃ asakkonto vedanāppatto hutvā imāya gāthāya vippalapi."],"lineRefs":[["ja210:1"],["ja210:1"],["ja210:1"],["ja210:1"],["ja210:1"],["ja210:1"]]},{"para":1030,"vripara":null,"refs":["ja210:1"],"lines":["Taṃ vacanaṃ sutvā khadiravaniyo dutiyaṃ gāthamāha –"],"lineRefs":[["ja210:1"]]},{"para":1032,"vripara":"120","refs":["ja210:1"],"lines":["“Acāri vatāyaṃ vitudaṃ vanāni, kaṭṭhaṅgarukkhesu asārakesu;"],"lineRefs":[["ja210:1"]]},{"para":1033,"vripara":null,"refs":["ja210:1"],"lines":["Athāsadā khadiraṃ jātasāraṃ, yatthabbhidā garuḷo uttamaṅgan”ti."],"lineRefs":[["ja210:1"]]},{"para":1034,"vripara":null,"refs":["ja210:2"],"lines":["Tattha <b>acāri vatāyan</b>ti acari vata ayaṃ.","<b>Vitudaṃ vanānī</b>ti nissārasimbalipālibhaddakavanāni vitudanto vijjhanto.","<b>Kaṭṭhaṅgarukkhesū</b>ti vanakaṭṭhakoṭṭhāsesu rukkhesu.","<b>Asārakesū</b>ti nissāresu pālibhaddakasimbaliādīsu.","<b>Athāsadā khadiraṃ jātasāran</b>ti atha potakakālato paṭṭhāya jātasāraṃ khadiraṃ sampāpuṇi.","<b>Yatthabbhidā garuḷo uttamaṅgan</b>ti <b>yatthabbhidā</b>ti yasmiṃ khadire abhindi padālayi.","<b>Garuḷo</b>ti sakuṇo.","Sabbasakuṇānañhetaṃ sagāravasappatissa vacanaṃ."],"lineRefs":[["ja210:2"],["ja210:2"],["ja210:2"],["ja210:2"],["ja210:2"],["ja210:2"],["ja210:2"],["ja210:2"]]}],"wordLinks":[["ja210:1.1","ambho ko nāmayaṃ rukkho",0,0],["ja210:1.1","sinnapatto",0,2],["ja210:1.3","yattha ekappahārenā",0,3],["ja210:1.3","uttamaṅgaṃ vibhijjitaṃ",0,4],["ja210:2.1","acāri vatāyaṃ",4,0],["ja210:2.1","vitudaṃ vanānī",4,1],["ja210:2.1","kaṭṭhaṅgarukkhesū",4,2],["ja210:2.1","asārakesū",4,3],["ja210:2.3","athāsadā khadiraṃ jātasāraṃ",4,4],["ja210:2.3","yatthabbhidā",4,5],["ja210:2.3","yatthabbhidā garuḷo uttamaṅgaṃ",4,5],["ja210:2.3","garuḷo",4,6]],"after":[{"para":1035,"vripara":null,"title":"[210] 10. Kandagalakajātakavaṇṇanā","lines":["Iti naṃ khadiravaniyo vatvā “bho kandagalaka, yattha tvaṃ uttamaṅgaṃ abhindi, khadiro nāmeso sārarukkho”ti āha.","So tattheva jīvitakkhayaṃ pāpuṇi."]},{"para":1036,"vripara":null,"title":"[210] 10. Kandagalakajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā kandagalako devadatto ahosi, khadiravaniyo pana ahameva ahosin”ti."]},{"para":1037,"vripara":null,"title":"[210] 10. Kandagalakajātakavaṇṇanā","lines":["Kandagalakajātakavaṇṇanā dasamā."]},{"para":1038,"vripara":null,"title":"[210] 10. Kandagalakajātakavaṇṇanā","lines":["Nataṃdaḷhavaggo chaṭṭho."]},{"para":1039,"vripara":null,"title":"[210] 10. Kandagalakajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":1040,"vripara":null,"title":"[210] 10. Kandagalakajātakavaṇṇanā","lines":["Bandhanāgāraṃ keḷisīlaṃ, khaṇḍaṃ vīrakagaṅgeyyaṃ;"]},{"para":1041,"vripara":null,"title":"[210] 10. Kandagalakajātakavaṇṇanā","lines":["Kuruṅgamassakañceva, susumārañca kukkuṭaṃ;"]},{"para":1042,"vripara":null,"title":"[210] 10. Kandagalakajātakavaṇṇanā","lines":["Kandagalakanti te dasa."]}]},"tika":null,"tika2":null}
