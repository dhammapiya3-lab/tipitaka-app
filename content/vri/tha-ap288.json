{"suttaId":"tha-ap288","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8785,8803],"vripara":"24"},"segments":{"tha-ap288:0.3":"Upaṭṭhākadāyakattheraapadānaṃ","tha-ap288:1.1":"“Rathiyaṃ paṭipajjantaṃ, āhutīnaṃ paṭiggahaṃ;","tha-ap288:1.3":"Dvipadindaṃ mahānāgaṃ, lokajeṭṭhaṃ narāsabhaṃ.","tha-ap288:2.1":"“Pakkosāpiya tassāhaṃ, sabbalokahitesino;","tha-ap288:2.3":"Upaṭṭhāko mayā dinno, siddhatthassa mahesino.","tha-ap288:3.1":"“Paṭiggahetvā [paṭiggahesi (ka.)] sambuddho, niyyādesi mahāmuni [mahāisi (ka.)];","tha-ap288:3.3":"Uṭṭhāya āsanā tamhā, pakkāmi pācināmukho.","tha-ap288:4.1":"“Catunnavutito kappe, upaṭṭhākamadaṃ tadā;","tha-ap288:4.3":"Duggatiṃ nābhijānāmi, upaṭṭhānassidaṃ phalaṃ.","tha-ap288:5.1":"“Sattapaññāsito kappe, balasenasanāmako;","tha-ap288:5.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap288:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap288:7.1":"Itthaṃ sudaṃ āyasmā upaṭṭhākadāyako thero imā gāthāyo abhāsitthāti.","tha-ap288:8.1":"Upaṭṭhākadāyakattherassāpadānaṃ chaṭṭhaṃ."},"attha":null,"tika":null,"tika2":null}
