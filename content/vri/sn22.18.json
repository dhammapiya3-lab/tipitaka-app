{"suttaId":"sn22.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[124,124],"vripara":"18"},"segments":{"sn22.18:0.3":"Sahetuaniccasuttaṃ","sn22.18:1.1":"Sāvatthinidānaṃ.","sn22.18:1.2":"“Rūpaṃ, bhikkhave, aniccaṃ.","sn22.18:1.3":"Yopi hetu, yopi paccayo rūpassa uppādāya, sopi anicco.","sn22.18:1.4":"Aniccasambhūtaṃ, bhikkhave, rūpaṃ kuto niccaṃ bhavissati!","sn22.18:1.5":"Vedanā aniccā.","sn22.18:1.6":"Yopi hetu, yopi paccayo vedanāya uppādāya, sopi anicco.","sn22.18:1.7":"Aniccasambhūtā, bhikkhave, vedanā kuto niccā bhavissati!","sn22.18:1.8":"Saññā aniccā …","sn22.18:1.9":"saṅkhārā aniccā.","sn22.18:1.10":"Yopi hetu yopi paccayo saṅkhārānaṃ uppādāya, sopi anicco.","sn22.18:1.11":"Aniccasambhūtā, bhikkhave, saṅkhārā kuto niccā bhavissanti!","sn22.18:1.12":"Viññāṇaṃ aniccaṃ.","sn22.18:1.13":"Yopi hetu yopi paccayo viññāṇassa uppādāya, sopi anicco.","sn22.18:1.14":"Aniccasambhūtaṃ, bhikkhave, viññāṇaṃ kuto niccaṃ bhavissati!","sn22.18:1.15":"Evaṃ passaṃ … pe …","sn22.18:1.16":"nāparaṃ itthattāyāti pajānātī”ti.","sn22.18:1.17":"Sattamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":70,"to":73,"paras":[{"para":70,"vripara":"12-21","refs":["sn22.18:1"],"lines":["12-21. Aniccavagge pariyosānasuttaṃ pucchāvasikaṃ, sesāni tathā tathā bujjhanakānañca vasena desitānīti.","Paṭhamādīni."],"lineRefs":[["sn22.18:1"],["sn22.18:1"]]},{"para":71,"vripara":null,"refs":["sn22.18:1"],"lines":["Aniccavaggo dutiyo."],"lineRefs":[["sn22.18:1"]]},{"para":72,"vripara":null,"refs":["sn22.18:1"],"lines":["Bhāravaggo"],"lineRefs":[["sn22.18:1"]]},{"para":73,"vripara":null,"refs":["sn22.18:1"],"lines":["Bhārasuttavaṇṇanā"],"lineRefs":[["sn22.18:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":66,"to":70,"paras":[{"para":66,"vripara":"12-21","refs":["sn22.18:1"],"lines":["12-21. <b>Pucchāvasikaṃ</b> ānandatt