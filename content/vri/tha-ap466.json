{"suttaId":"tha-ap466","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1351,1365],"vripara":"16"},"segments":{"tha-ap466:0.3":"Setudāyakattheraapadānaṃ","tha-ap466:1.1":"“Vipassino bhagavato, caṅkamantassa sammukhā;","tha-ap466:1.3":"Pasannacitto sumano, setuṃ kārāpayiṃ ahaṃ.","tha-ap466:2.1":"“Ekanavutito kappe, yaṃ setuṃ kārayiṃ ahaṃ;","tha-ap466:2.3":"Duggatiṃ nābhijānāmi, setudānassidaṃ phalaṃ.","tha-ap466:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap466:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap466:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap466:6.1":"Itthaṃ sudaṃ āyasmā setudāyako thero imā gāthāyo Abhāsitthāti.","tha-ap466:7.1":"Setudāyakattherassāpadānaṃ catutthaṃ."},"attha":null,"tika":null,"tika2":null}
