{"suttaId":"kp4","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Khp","vriCode":"s0501m.mul","paras":[37,47],"vripara":"1"},"segments":{"kp4:0.2":"Kumārapañhā","kp4:1.1":"“Ekaṃ nāma kiṃ”?","kp4:1.2":"“Sabbe sattā āhāraṭṭhitikā”. 2.","kp4:2.1":"“Dve nāma kiṃ”?","kp4:2.2":"“Nāmañca rūpañca”. 3.","kp4:3.1":"“Tīṇi nāma kiṃ”?","kp4:3.2":"“Tisso vedanā”. 4.","kp4:4.1":"“Cattāri nāma kiṃ”?","kp4:4.2":"“Cattāri ariyasaccāni”. 5.","kp4:5.1":"“Pañca nāma kiṃ”?","kp4:5.2":"“Pañcupādānakkhandhā”. 6.","kp4:6.1":"“Cha nāma kiṃ”?","kp4:6.2":"“Cha ajjhattikāni āyatanāni”. 7.","kp4:7.1":"“Satta nāma kiṃ”?","kp4:7.2":"“Satta bojjhaṅgā”. 8.","kp4:8.1":"“Aṭṭha nāma kiṃ”?","kp4:8.2":"“Ariyo aṭṭhaṅgiko maggo”. 9.","kp4:9.1":"“Nava nāma kiṃ”?","kp4:9.2":"“Nava sattāvāsā”. 10.","kp4:10.1":"“Dasa nāma kiṃ”?","kp4:10.2":"“Dasahaṅgehi samannāgato ‘arahā’ti vuccatī”ti.","kp4:11.1":"Kumārapañhā niṭṭhitā. 5."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
