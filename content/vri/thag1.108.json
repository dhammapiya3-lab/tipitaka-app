{"suttaId":"thag1.108","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[624,627],"vripara":"108"},"segments":{"thag1.108:0.4":"Dhammasavapituttheragāthā","thag1.108:1.1":"“Sa vīsavassasatiko,","thag1.108:1.2":"pabbajiṃ anagāriyaṃ;","thag1.108:1.3":"Tisso vijjā anuppattā,","thag1.108:1.4":"kataṃ buddhassa sāsanan”ti.","thag1.108:1.5":"… Dhammasavapitu thero …."},"unsure":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2650,"to":2650,"paras":[{"para":2650,"vripara":null,"refs":["thag1.108:1"],"lines":["Tattha <b>sa vīsavassasatiko</b>ti so vīsaṃvassasatiko, so ahaṃ jātiyā vīsādhikavassasatiko samāno.","<b>Pabbajin</b>ti pabbajjaṃ upagacchiṃ.","Sesaṃ vuttanayameva.","Idameva ca imassa therassa aññābyākaraṇaṃ ahosi."],"lineRefs":[["thag1.108:1"],["thag1.108:1"],["thag1.108:1"],["thag1.108:1"]]}],"wordLinks":[["thag1.108:1.1","sa vīsavassasatiko",0,0],["thag1.108:1.1","pabbajiṃ",0,1]],"before":[{"para":2636,"vripara":null,"refs":[],"lines":["Dhammasavattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2637,"vripara":null,"refs":[],"lines":["Dhammasavapituttheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":2638,"vripara":null,"refs":[],"lines":["<b>Sa vīsavassasatiko</b>ti āyasmato dhammasavapituttherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro buddhasuññe loke kulagehe nibbattitvā viññutaṃ patto bhūtagaṇe nāma pabbate viharantaṃ paccekasambuddhaṃ disvā pasannamānaso tiṇasūlapupphehi pūjaṃ akāsi.","So tena puññakammena devaloke nibbattitvā aparāparaṃ sugatīsuyeva saṃsaranto imasmiṃ buddhuppāde magadharaṭṭhe brāhmaṇakule nibbattitvā viññutaṃ patto dārapariggahaṃ katvā dhammasavaṃ nāma puttaṃ labhitvā tasmiṃ pabbajite sayampi vīsavassasatiko hutvā,“mama putto tāva taruṇo pabbaji, atha kasmā nāhaṃ pabbajissāmī”ti sañjātasaṃvego satthu santikaṃ gantvā dhammaṃ sutvā pabbajitvā vipassanaṃ paṭṭhapetvā nacirasseva arahattaṃ sacchākāsi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.16.35-38)–"],"lineRefs":[[],[],[],[],[]]},{"para":2639,"vripara":null,"refs":[],"lines":["“Himavantassāvidūre, bhūtagaṇo nāma pabbato;"],"lineRefs":[[]]},{"para":2640,"vripara":null,"refs":[],"lines":["Vasateko jino tattha, sayambhū lokanissaṭo."],"lineRefs":[[]]},{"para":2641,"vripara":null,"refs":[],"lines":["“Tiṇasūlaṃ gahetvāna, buddhassa abhiropayiṃ;"],"lineRefs":[[]]},{"para":2642,"vripara":null,"refs":[],"lines":["Ekūnasatasahassaṃ, kappaṃ na vinipātiko."],"lineRefs":[[]]},{"para":2643,"vripara":null,"refs":[],"lines":["“Ito ekādase kappe, ekosiṃ dharaṇīruho;"],"lineRefs":[[]]},{"para":2644,"vripara":null,"refs":[],"lines":["Sattaratanasampanno, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":2645,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":2646,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā attano paṭipattiṃ paccavekkhitvā sañjātasomanasso udānento –"],"lineRefs":[[]]},{"para":2648,"vripara":"108","refs":[],"lines":["“Sa vīsavassasatiko, pabbajiṃ anagāriyaṃ;"],"lineRefs":[[]]},{"para":2649,"vripara":null,"refs":[],"lines":["Tisso vijjā anuppattā, kataṃ buddhassa sāsanan”ti.","– gāthaṃ abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
