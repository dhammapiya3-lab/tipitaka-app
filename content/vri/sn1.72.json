{"suttaId":"sn1.72","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[798,802],"vripara":"72"},"segments":{"sn1.72:0.3":"Rathasuttaṃ","sn1.72:1.1":"“Kiṃsu rathassa paññāṇaṃ, kiṃsu paññāṇamaggino;","sn1.72:1.3":"Kiṃsu raṭṭhassa paññāṇaṃ, kiṃsu paññāṇamitthiyā”ti.","sn1.72:2.1":"“Dhajo rathassa paññāṇaṃ, dhūmo paññāṇamaggino;","sn1.72:2.3":"Rājā raṭṭhassa paññāṇaṃ, bhattā paññāṇamitthiyā”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":478,"to":478,"paras":[{"para":478,"vripara":"72","refs":["sn1.72:1","sn1.72:2"],"lines":["Dutiye paññāyati etenāti <b>paññāṇaṃ.</b>","<b>Dhajo rathassā</b>ti mahantasmiṃ hi saṅgāmasīse dūratova dhajaṃ disvā “asukarañño nāma ayaṃ ratho”ti ratho pākaṭo hoti.","Tena vuttaṃ “dhajo rathassa paññāṇan”ti.","<b>Aggi</b> pi dūratova dhūmena paññāyati.","Coḷaraṭṭhaṃ paṇḍuraṭṭhanti evaṃ <b>raṭṭha</b> mpi raññā paññāyati.","Cakkavattirañño dhītāpi pana <b>itthī</b> “asukassa nāma bhariyā”ti bhattāraṃ patvāva paññāyati.","Tasmā <b>dhūmo paññāṇamaggino</b>tiādi vuttaṃ.","Dutiyaṃ."],"lineRefs":[["sn1.72:1"],["sn1.72:2"],["sn1.72:2"],["sn1.72:2"],["sn1.72:2"],["sn1.72:2"],["sn1.72:2"],["sn1.72:2"]]}],"wordLinks":[["sn1.72:1.1","paññāṇaṃ",0,0],["sn1.72:1.3","paññāṇaṃ",0,0],["sn1.72:2.1","dhajo rathassā",0,1],["sn1.72:2.1","aggi",0,3],["sn1.72:2.3","raṭṭha",0,4],["sn1.72:2.3","itthī",0,5],["sn1.72:2.1","dhūmo paññāṇamaggino",0,6]]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":595,"to":595,"paras":[{"para":595,"vripara":"72","refs":["sn1.72:1"],"lines":["<b>Paññāṇan</b>ti lakkhaṇaṃ sallakkhaṇūpāyo.","<b>Disvā</b>ti dassanahetu.","“Coḷarañño raṭṭhaṃ coḷaraṭṭhan”ti evaṃ <b>raṭṭhaṃ raññā paññāyati</b>."],"lineRefs":[["sn1.72:1"],["sn1.72:1"],["sn1.72:1"]]}],"wordLinks":[["sn1.72:1.1","paññāṇaṃ",0,0],["sn1.72:1.3","paññāṇaṃ",0,0]]},"tika2":null}
