{"suttaId":"tha-ap36","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[3266,3314],"vripara":"48"},"segments":{"tha-ap36:0.3":"Kāḷudāyittheraapadānaṃ","tha-ap36:1.1":"“Padumuttarabuddhassa,","tha-ap36:1.2":"lokajeṭṭhassa tādino;","tha-ap36:1.3":"Addhānaṃ paṭipannassa,","tha-ap36:1.4":"carato cārikaṃ tadā.","tha-ap36:2.1":"“Suphullaṃ padumaṃ gayha,","tha-ap36:2.2":"uppalaṃ mallikañcahaṃ;","tha-ap36:2.3":"Paramannaṃ gahetvāna,","tha-ap36:2.4":"adāsiṃ satthuno ahaṃ.","tha-ap36:3.1":"“Paribhuñji mahāvīro,","tha-ap36:3.2":"paramannaṃ subhojanaṃ;","tha-ap36:3.3":"Tañca pupphaṃ gahetvāna,","tha-ap36:3.4":"janassa sampadassayi.","tha-ap36:4.1":"“Iṭṭhaṃ kantaṃ [kantayidaṃ (syā.)], piyaṃ loke,","tha-ap36:4.2":"jalajaṃ pupphamuttamaṃ;","tha-ap36:4.3":"Sudukkaraṃ kataṃ tena,","tha-ap36:4.4":"yo me pupphaṃ adāsidaṃ.","tha-ap36:5.1":"“Yo pupphamabhiropesi,","tha-ap36:5.2":"paramannañcadāsi me;","tha-ap36:5.3":"Tamahaṃ kittayissāmi,","tha-ap36:5.4":"suṇātha mama bhāsato.","tha-ap36:6.1":"“‘Dasa aṭṭha cakkhattuṃ [dasa caṭṭhakkhattuṃ (sī.), dasamaṭṭhakkhattuṃ (syā.)] so,","tha-ap36:6.2":"devarajjaṃ karissati;","tha-ap36:6.3":"Uppalaṃ padumañcāpi,","tha-ap36:6.4":"mallikañca taduttari.","tha-ap36:7.1":"“‘Assa puññavipākena,","tha-ap36:7.2":"dibbagandhasamāyutaṃ;","tha-ap36:7.3":"Ākāse chadanaṃ katvā,","tha-ap36:7.4":"dhārayissati tāvade.","tha-ap36:8.1":"“‘Pañcavīsatikkhattuñca,","tha-ap36:8.2":"cakkavattī bhavissati;","tha-ap36:8.3":"Pathabyā rajjaṃ pañcasataṃ,","tha-ap36:8.4":"vasudhaṃ āvasissati.","tha-ap36:9.1":"“‘Kappasatasahassamhi,","tha-ap36:9.2":"okkākakulasambhavo;","tha-ap36:9.3":"Gotamo nāma gottena [nāmena (sī. syā. ka.)],","tha-ap36:9.4":"satthā loke bhavissati.","tha-ap36:10.1":"“‘Sakakammābhiraddho so,","tha-ap36:10.2":"sukkamūlena codito;","tha-ap36:10.3":"Sakyānaṃ nandijanano,","tha-ap36:10.4":"ñātibandhu bhavissati.","tha-ap36:11.1":"“‘So pacchā pabbajitvāna,","tha-ap36:11.2":"sukkamūlena codito;","tha-ap36:11.3":"Sabbāsave pariññāya,","tha-ap36:11.4":"nibbāyissatināsavo.","tha-ap36:12.1":"“‘Paṭisambhidamanuppattaṃ,","tha-ap36:12.2":"katakiccamanāsavaṃ;","tha-ap36:12.3":"Gotamo lokabandhu taṃ [so (sī.)],","tha-ap36:12.4":"etadagge ṭhapessati.","tha-ap36:13.1":"“‘Padhānapahitatto so,","tha-ap36:13.2":"upasanto nirūpadhi;","tha-ap36:13.3":"Udāyī nāma nāmena,","tha-ap36:13.4":"hessati satthu sāvako’.","tha-ap36:14.1":"“Rāgo doso ca moho ca,","tha-ap36:14.2":"māno makkho ca dhaṃsito;","tha-ap36:14.3":"Sabbāsave pariññāya,","tha-ap36:14.4":"viharāmi anāsavo.","tha-ap36:15.1":"“Tosayiñcāpi sambuddhaṃ,","tha-ap36:15.2":"ātāpī nipako ahaṃ;","tha-ap36:15.3":"Pasādito [pamodito (sī.)] ca sambuddho,","tha-ap36:15.4":"etadagge ṭhapesi maṃ.","tha-ap36:16.1":"“Paṭisambhidā catasso … pe …","tha-ap36:16.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap36:17.1":"Itthaṃ sudaṃ āyasmā kāḷudāyī thero imā gāthāyo abhāsitthāti;","tha-ap36:18.1":"Kāḷudāyītherassāpadānaṃ catutthaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2454,"to":2454,"paras":[{"para":2454,"vripara":"48-49","refs":["tha-ap36:1"],"lines":["48-9. Evaṃ so katapuññasambhārānurūpena arahattaṃ patvā pattaetadaggaṭṭhāno attano pubbakammaṃ saritvā somanassavasena pubbacaritāpadānaṃ pakāsento <b>padumuttarassa buddhassā</b>tiādimāha.","<b>Addhānaṃ paṭipannassā</b>ti apararaṭṭhaṃ gamanatthāya dūramaggaṃ paṭipajjantassa.","<b>Carato cārikaṃ tadā</b>ti antomaṇḍalaṃ majjhemaṇḍalaṃ bahimaṇḍalanti tīṇi maṇḍalāni tadā cārikaṃ carato carantassa <b>padumuttarabuddhassa</b> bhagavato <b>suphullaṃ</b> suṭṭhu phullaṃ pabodhitaṃ <b>gayha</b> gahetvā na kevalameva padumaṃ, uppalañca <b>mallikaṃ</b> vikasitaṃ ahaṃ gayha ubhohi hatthehi gahetvā pūresinti sambandho.","<b>Paramannaṃ gahetvānā</b>ti paramaṃ uttamaṃ seṭṭhaṃ madhuraṃ sabbasupakkaṃ sāliodanaṃ gahetvā satthuno <b>adāsiṃ</b> bhojesinti attho."],"lineRefs":[["tha-ap36:1"],["tha-ap36:1"],["tha-ap36:1"],["tha-ap36:1"]]}],"wordLinks":[["tha-ap36:1.3","addhānaṃ paṭipannassā",0,1],["tha-ap36:1.1","padumuttarabuddhassa",0,2],["tha-ap36:1.3","carato cārikaṃ tadā",0,2]]},"tika":null,"tika2":null}
