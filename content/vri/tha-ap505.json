{"suttaId":"tha-ap505","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3036,3053],"vripara":"51"},"segments":{"tha-ap505:0.3":"Kāsumāraphaliyattheraapadānaṃ","tha-ap505:1.1":"“Kaṇikāraṃva jotantaṃ,","tha-ap505:1.2":"nisinnaṃ pabbatantare;","tha-ap505:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap505:1.4":"lokajeṭṭhaṃ narāsabhaṃ. 52.","tha-ap505:2.1":"“Pasannacitto sumano,","tha-ap505:2.2":"sire katvāna añjaliṃ;","tha-ap505:2.3":"Kāsumārikamādāya,","tha-ap505:2.4":"buddhaseṭṭhassadāsahaṃ. 53.","tha-ap505:3.1":"“Ekatiṃse ito kappe,","tha-ap505:3.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap505:3.3":"Duggatiṃ nābhijānāmi,","tha-ap505:3.4":"phaladānassidaṃ phalaṃ. 54.","tha-ap505:4.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap505:4.3":"viharāmi anāsavo. 55.","tha-ap505:5.1":"“Svāgataṃ vata me āsi…pe…","tha-ap505:5.3":"kataṃ buddhassa sāsanaṃ. 56.","tha-ap505:6.1":"“Paṭisambhidā catasso…pe…","tha-ap505:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap505:7.1":"Itthaṃ sudaṃ āyasmā kāsumāraphaliyo thero imā gāthāyo Abhāsitthāti.","tha-ap505:8.1":"Kāsumāraphaliyattherassāpadānaṃ tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
