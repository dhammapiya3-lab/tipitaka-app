{"suttaId":"sn35.99","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[598,598],"vripara":"99"},"segments":{"sn35.99:0.3":"Samādhisuttaṃ","sn35.99:1.1":"“Samādhiṃ, bhikkhave, bhāvetha.","sn35.99:1.2":"Samāhito, bhikkhave, bhikkhu yathābhūtaṃ pajānāti.","sn35.99:1.3":"Kiñca yathābhūtaṃ pajānāti?","sn35.99:1.4":"‘Cakkhu anicca’nti yathābhūtaṃ pajānāti;","sn35.99:1.5":"‘rūpā aniccā’ti yathābhūtaṃ pajānāti;","sn35.99:1.6":"‘cakkhuviññāṇaṃ anicca’nti yathābhūtaṃ pajānāti;","sn35.99:1.7":"‘cakkhusamphasso anicco’ti yathābhūtaṃ pajānāti.","sn35.99:1.8":"‘Yampidaṃ cakkhusamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi anicca’nti yathābhūtaṃ pajānāti…pe…","sn35.99:1.9":"‘mano anicca’nti yathābhūtaṃ pajānāti.","sn35.99:1.10":"Dhammā…","sn35.99:1.11":"manoviññāṇaṃ…","sn35.99:1.12":"manosamphasso…","sn35.99:1.13":"‘yampidaṃ manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi anicca’nti yathābhūtaṃ pajānāti.","sn35.99:1.14":"Samādhiṃ, bhikkhave, bhāvetha.","sn35.99:1.15":"Samāhito, bhikkhave, bhikkhu yathābhūtaṃ pajānātī”ti.","sn35.99:1.16":"Chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":175,"to":175,"paras":[{"para":175,"vripara":"99","refs":["sn35.99:1"],"lines":["Chaṭṭhe <b>samādhi</b>nti cittekaggataṃ.","Idañhi suttaṃ cittekaggatāya parihāyamāne disvā, “imesaṃ cittekaggataṃ labhantānaṃ kammaṭṭhānaṃ phātiṃ gamissatī”ti ñatvā kathitaṃ. 7."],"lineRefs":[["sn35.99:1"],["sn35.99:1"]]}],"wordLinks":[["sn35.99:1.1","samādhiṃ",0,0],["sn35.99:1.14","samādhiṃ",0,0]],"before":[{"para":174,"vripara":null,"title":"Samādhisuttavaṇṇanā","lines":["Samādhisuttavaṇṇanā 99."]}]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":181,"to":182,"paras":[{"para":181,"vripara":"99","refs":["sn35.99:1"],"lines":["<b>Cittekaggatāyā</b>ti samathavasena cittekaggatāya.","<b>Parihāyamāne</b>ti tassa alābhena parihāyamāne.","<b>Kammaṭṭhāna</b>nti vipassanākammaṭṭhānaṃ, samathameva vā. 7."],"lineRefs":[["sn35.99:1"],["sn35.99:1"],["sn35.99:1"]]},{"para":182,"vripara":null,"refs":["sn35.99:1"],"lines":["Paṭisallānasuttavaṇṇanā 100."],"lineRefs":[["sn35.99:1"]]}],"wordLinks":[]},"tika2":null}
