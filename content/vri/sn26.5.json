{"suttaId":"sn26.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1174,1175],"vripara":"316"},"segments":{"sn26.5:0.3":"Samphassajasuttaṃ","sn26.5:1.1":"Sāvatthinidānaṃ.","sn26.5:1.2":"“Yo kho, bhikkhave, cakkhusamphassajāya vedanāya uppādo ṭhiti … pe … jarāmaraṇassa pātubhāvo … pe ….","sn26.5:2.1":"Yo manosamphassajāya vedanāya uppādo ṭhiti … pe …","sn26.5:2.2":"jarāmaraṇassa pātubhāvo.","sn26.5:2.3":"Yo ca kho, bhikkhave, cakkhusamphassajāya vedanāya nirodho vūpasamo … pe …","sn26.5:2.4":"jarāmaraṇassa atthaṅgamo … pe …","sn26.5:2.5":"yo manosamphassajāya vedanāya nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo”ti.","sn26.5:2.6":"Pañcamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":452,"to":454,"paras":[{"para":452,"vripara":"312-321","refs":["sn26.5:1"],"lines":["312-321. Uppādasaṃyutte sabbaṃ pākaṭameva."],"lineRefs":[["sn26.5:1"]]},{"para":453,"vripara":null,"refs":["sn26.5:1"],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn26.5:1"]]},{"para":454,"vripara":null,"refs":["sn26.5:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.5:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":476,"to":478,"paras":[{"para":476,"vripara":"312-321","refs":["sn26.5:1"],"lines":["312-321. <b>Sabbaṃ pākaṭameva</b> apubbassa abhāvato."],"lineRefs":[["sn26.5:1"]]},{"para":477,"vripara":null,"refs":["sn26.5:1"],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn26.5:1"]]},{"para":478,"vripara":null,"refs":["sn26.5:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.5:1"]]}],"wordLinks":[]},"tika2":null}
