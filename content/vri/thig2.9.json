{"suttaId":"thig2.9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[168,174],"vripara":"35"},"segments":{"thig2.9:0.3":"Abhayātherīgāthā","thig2.9:1.1":"“Abhaye bhiduro kāyo,","thig2.9:1.2":"yattha satā puthujjanā;","thig2.9:1.3":"Nikkhipissāmimaṃ dehaṃ,","thig2.9:1.4":"sampajānā satīmatī. 36.","thig2.9:2.1":"“Bahūhi dukkhadhammehi,","thig2.9:2.2":"appamādaratāya me;","thig2.9:2.3":"Taṇhakkhayo anuppatto,","thig2.9:2.4":"kataṃ buddhassa sāsana”nti. …","thig2.9:3.1":"Abhayā therī…. 10."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":563,"to":564,"paras":[{"para":563,"vripara":null,"refs":["thig2.9:3"],"lines":["Tattha <b>abhaye</b>ti attānameva ālapati.","<b>Bhiduro</b>ti bhijjanasabhāvo, aniccoti attho.","<b>Yattha sattā puthujjanā</b>ti yasmiṃ khaṇena bhijjanasīle asuciduggandhajegucchapaṭikkūlasabhāve kāye ime andhaputhujjanā sattā laggā laggitā.","<b>Nikkhipissāmimaṃ deha</b>nti ahaṃ pana imaṃ dehaṃ pūtikāyaṃ puna anādānena nirapekkhā khipissāmi chaḍḍessāmi.","Tattha kāraṇamāha <b>“sampajānā satīmatī”</b>ti."],"lineRefs":[["thig2.9:3"],["thig2.9:3"],["thig2.9:3"],["thig2.9:3"],["thig2.9:3"]]},{"para":564,"vripara":null,"refs":["thig2.9:2"],"lines":["<b>Bahūhi dukkhadhammehī</b>ti jātijarādīhi anekehi dukkhadhammehi phuṭṭhāyāti adhippāyo.","<b>Appamādaratāyā</b>ti tāya eva dukkhotiṇṇatāya paṭiladdhasaṃvegattā satiavippavāsasaṅkhāte appamāde ratāya.","Sesaṃ vuttanayameva.","Ettha ca satthārā desitaniyāmena –"],"lineRefs":[["thig2.9:2"],["thig2.9:2"],["thig2.9:2"],["thig2.9:2"]]}],"wordLinks":[["thig2.9:3.1","abhaye",0,0],["thig2.9:2.1","bahūhi dukkhadhammehī",1,0],["thig2.9:2.1","appamādaratāyā",1,1]],"before":[{"para":518,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Abhayātherīgāthāvaṇṇanā"]},{"para":519,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["<b>Abhaye bhiduro kāyo</b>tiādikā abhayattheriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ puññaṃ upacinantī sikhissa bhagavato kāle khattiyamahāsālakule nibbattitvā viññutaṃ patvā <b>aruṇa</b>rañño aggamahesī ahosi.","Rājā tassā ekadivasaṃ gandhasampannāni satta uppalāni adāsi.","Sā tāni gahetvā “kiṃ me imehi piḷandhantehi.","Yaṃnūnāhaṃ imehi bhagavantaṃ pūjessāmī”ti cintetvā nisīdi.","Bhagavā ca bhikkhācāravelāyaṃ rājanivesanaṃ pāvisi.","Sā bhagavantaṃ disvā pasannamānasā paccuggantvā tehi pupphehi pūjetvā pañcapatiṭṭhitena vandi.","Sā tena puññakammena devamanussesu saṃsarantī imasmiṃ buddhuppāde ujjeniyaṃ kulagehe nibbattitvā viññutaṃ patvā abhayamātusahāyikā hutvā tāya pabbajitāya tassā sinehena sayampi pabbajitvā tāya saddhiṃ rājagahe vasamānā ekadivasaṃ asubhadassanatthaṃ sītavanaṃ agamāsi.","Satthā gandhakuṭiyaṃ nisinnova tassā anubhūtapubbaṃ ārammaṇaṃ purato katvā tassā uddhumātakādibhāvaṃ pakāsesi.","Taṃ disvā saṃvegamānasā aṭṭhāsi.","Satthā obhāsaṃ pharitvā purato nisinnaṃ viya attānaṃ dassetvā – 35."]},{"para":521,"vripara":"35","title":"Abhayātherīgāthāvaṇṇanā","lines":["“Abhaye bhiduro kāyo, yattha sattā puthujjanā;"]},{"para":522,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Nikkhipissāmimaṃ dehaṃ, sampajānā satīmatī. 36."]},{"para":524,"vripara":"36","title":"Abhayātherīgāthāvaṇṇanā","lines":["“Bahūhi dukkhadhammehi, appamādaratāya me;"]},{"para":525,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Taṇhakkhayo anuppatto, kataṃ buddhassa sāsana”nti. –"]},{"para":526,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Imā gāthā abhāsi.","Sā gāthāpariyosāne arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.1.71-90) –"]},{"para":527,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Nagare aruṇavatiyā, aruṇo nāma khattiyo;"]},{"para":528,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Tassa rañño ahuṃ bhariyā, vāritaṃ vārayāmahaṃ."]},{"para":529,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Sattamālaṃ gahetvāna, uppalā devagandhikā;"]},{"para":530,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Nisajja pāsādavare, evaṃ cintesi tāvade."]},{"para":531,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Kiṃ me imāhi mālāhi, sirasāropitāhi me;"]},{"para":532,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Varaṃ me buddhaseṭṭhassa, ñāṇamhi abhiropitaṃ."]},{"para":533,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Sambuddhaṃ paṭimānentī, dvārāsanne nisīdahaṃ;"]},{"para":534,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Yadā ehiti sambuddho, pūjayissaṃ mahāmuniṃ."]},{"para":535,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Kakudho vilasantova, migarājāva kesarī;"]},{"para":536,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Bhikkhusaṅghena sahito, āgacchi vīthiyā jino."]},{"para":537,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Buddhassa raṃsiṃ disvāna, haṭṭhā saṃviggamānasā;"]},{"para":538,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Dvāraṃ avāpuritvāna, buddhaseṭṭhamapūjayiṃ."]},{"para":539,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Satta uppalapupphāni, parikiṇṇāni ambare;"]},{"para":540,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Chadiṃ karonto buddhassa, matthake dhārayanti te."]},{"para":541,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Udaggacittā sumanā, vedajātā katañjalī;"]},{"para":542,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Tattha cittaṃ pasādetvā, tāvatiṃsamagacchahaṃ."]},{"para":543,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Mahānelassa chādanaṃ, dhārenti mama muddhani;"]},{"para":544,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Dibbagandhaṃ pavāyāmi, sattuppalassidaṃ phalaṃ."]},{"para":545,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Kadāci nīyamānāya, ñātisaṅghena me tadā;"]},{"para":546,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Yāvatā parisā mayhaṃ, mahānelaṃ dharīyati."]},{"para":547,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Sattati devarājūnaṃ, mahesittamakārayiṃ;"]},{"para":548,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Sabbattha issarā hutvā, saṃsarāmi bhavābhave."]},{"para":549,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Tesaṭṭhi cakkavattīnaṃ, mahesittamakārayiṃ;"]},{"para":550,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Sabbe mamanuvattanti, ādeyyavacanā ahuṃ."]},{"para":551,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Uppalasseva me vaṇṇo, gandho ceva pavāyati;"]},{"para":552,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Dubbaṇṇiyaṃ na jānāmi, buddhapūjāyidaṃ phalaṃ."]},{"para":553,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Iddhipādesu kusalā, bojjhaṅgabhāvanāratā;"]},{"para":554,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Abhiññāpāramippattā, buddhapūjāyidaṃ phalaṃ."]},{"para":555,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Satipaṭṭhānakusalā, samādhijhānagocarā;"]},{"para":556,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Sammappadhānamanuyuttā, buddhapūjāyidaṃ phalaṃ."]},{"para":557,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Vīriyaṃ me dhuradhorayhaṃ, yogakkhemādhivāhanaṃ;"]},{"para":558,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."]},{"para":559,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Ekatiṃse ito kappe, yaṃ pupphamabhipūjayiṃ;"]},{"para":560,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."]},{"para":561,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti. (apa. therī 2.1.71-90);"]},{"para":562,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Arahattaṃ pana patvā udānentī tā eva gāthā parivattitvā abhāsi."]}],"after":[{"para":565,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["“Nikkhipāhi imaṃ dehaṃ, appamādaratāya te;"]},{"para":566,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Taṇhakkhayaṃ pāpuṇāhi, karohi buddhasāsana”nti. –"]},{"para":567,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Pāṭho, theriyā vuttaniyāmeneva pana saṃgītiṃ āropitattā.","<b>Appamādaratāya te</b>ti appamādaratāya tayā bhavitabbanti attho."]},{"para":568,"vripara":null,"title":"Abhayātherīgāthāvaṇṇanā","lines":["Abhayātherīgāthāvaṇṇanā niṭṭhitā. 10."]}]},"tika":null,"tika2":null}
