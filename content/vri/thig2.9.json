{"suttaId":"thig2.9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[168,174],"vripara":"35"},"segments":{"thig2.9:0.3":"Abhayātherīgāthā","thig2.9:1.1":"“Abhaye bhiduro kāyo,","thig2.9:1.2":"yattha satā puthujjanā;","thig2.9:1.3":"Nikkhipissāmimaṃ dehaṃ,","thig2.9:1.4":"sampajānā satīmatī.","thig2.9:2.1":"“Bahūhi dukkhadhammehi,","thig2.9:2.2":"appamādaratāya me;","thig2.9:2.3":"Taṇhakkhayo anuppatto,","thig2.9:2.4":"kataṃ buddhassa sāsanan”ti.","thig2.9:3.1":"… Abhayā therī …."},"unsure":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":563,"to":564,"paras":[{"para":563,"vripara":null,"refs":["thig2.9:3"],"lines":["Tattha <b>abhaye</b>ti attānameva ālapati.","<b>Bhiduro</b>ti bhijjanasabhāvo, aniccoti attho.","<b>Yattha sattā puthujjanā</b>ti yasmiṃ khaṇena bhijjanasīle asuciduggandhajegucchapaṭikkūlasabhāve kāye ime andhaputhujjanā sattā laggā laggitā.","<b>Nikkhipissāmimaṃ dehan</b>ti ahaṃ pana imaṃ dehaṃ pūtikāyaṃ puna anādānena nirapekkhā khipissāmi chaḍḍessāmi.","Tattha kāraṇamāha <b>“sampajānā satīmatī”</b>ti."],"lineRefs":[["thig2.9:3"],["thig2.9:3"],["thig2.9:3"],["thig2.9:3"],["thig2.9:3"]]},{"para":564,"vripara":null,"refs":["thig2.9:2"],"lines":["<b>Bahūhi dukkhadhammehī</b>ti jātijarādīhi anekehi dukkhadhammehi phuṭṭhāyāti adhippāyo.","<b>Appamādaratāyā</b>ti tāya eva dukkhotiṇṇatāya paṭiladdhasaṃvegattā satiavippavāsasaṅkhāte appamāde ratāya.","Sesaṃ vuttanayameva.","Ettha ca satthārā desitaniyāmena –"],"lineRefs":[["thig2.9:2"],["thig2.9:2"],["thig2.9:2"],["thig2.9:2"]]}],"wordLinks":[["thig2.9:3.1","abhaye",0,0],["thig2.9:2.1","bahūhi dukkhadhammehī",1,0],["thig2.9:2.1","appamādaratāyā",1,1]],"before":[{"para":517,"vripara":null,"refs":[],"lines":["Abhayamātutherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":518,"vripara":null,"refs":[],"lines":["Abhayātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":519,"vripara":null,"refs":[],"lines":["<b>Abhaye bhiduro kāyo</b>tiādikā abhayattheriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ puññaṃ upacinantī sikhissa bhagavato kāle khattiyamahāsālakule nibbattitvā viññutaṃ patvā <b>aruṇa</b> rañño aggamahesī ahosi.","Rājā tassā ekadivasaṃ gandhasampannāni satta uppalāni adāsi.","Sā tāni gahetvā “kiṃ me imehi piḷandhantehi.","Yaṃnūnāhaṃ imehi bhagavantaṃ pūjessāmī”ti cintetvā nisīdi.","Bhagavā ca bhikkhācāravelāyaṃ rājanivesanaṃ pāvisi.","Sā bhagavantaṃ disvā pasannamānasā paccuggantvā tehi pupphehi pūjetvā pañcapatiṭṭhitena vandi.","Sā tena puññakammena devamanussesu saṃsarantī imasmiṃ buddhuppāde ujjeniyaṃ kulagehe nibbattitvā viññutaṃ patvā abhayamātusahāyikā hutvā tāya pabbajitāya tassā sinehena sayampi pabbajitvā tāya saddhiṃ rājagahe vasamānā ekadivasaṃ asubhadassanatthaṃ sītavanaṃ agamāsi.","Satthā gandhakuṭiyaṃ nisinnova tassā anubhūtapubbaṃ ārammaṇaṃ purato katvā tassā uddhumātakādibhāvaṃ pakāsesi.","Taṃ disvā saṃvegamānasā aṭṭhāsi.","Satthā obhāsaṃ pharitvā purato nisinnaṃ viya attānaṃ dassetvā –"],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[]]},{"para":521,"vripara":"35","refs":[],"lines":["“Abhaye bhiduro kāyo, yattha sattā puthujjanā;"],"lineRefs":[[]]},{"para":522,"vripara":null,"refs":[],"lines":["Nikkhipissāmimaṃ dehaṃ, sampajānā satīmatī."],"lineRefs":[[]]},{"para":524,"vripara":"36","refs":[],"lines":["“Bahūhi dukkhadhammehi, appamādaratāya me;"],"lineRefs":[[]]},{"para":525,"vripara":null,"refs":[],"lines":["Taṇhakkhayo anuppatto, kataṃ buddhassa sāsanan”ti.","–"],"lineRefs":[[],[]]},{"para":526,"vripara":null,"refs":[],"lines":["Imā gāthā abhāsi.","Sā gāthāpariyosāne arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.1.71-90)–"],"lineRefs":[[],[],[]]},{"para":527,"vripara":null,"refs":[],"lines":["“Nagare aruṇavatiyā, aruṇo nāma khattiyo;"],"lineRefs":[[]]},{"para":528,"vripara":null,"refs":[],"lines":["Tassa rañño ahuṃ bhariyā, vāritaṃ vārayāmahaṃ."],"lineRefs":[[]]},{"para":529,"vripara":null,"refs":[],"lines":["“Sattamālaṃ gahetvāna, uppalā devagandhikā;"],"lineRefs":[[]]},{"para":530,"vripara":null,"refs":[],"lines":["Nisajja pāsādavare, evaṃ cintesi tāvade."],"lineRefs":[[]]},{"para":531,"vripara":null,"refs":[],"lines":["“Kiṃ me imāhi mālāhi, sirasāropitāhi me;"],"lineRefs":[[]]},{"para":532,"vripara":null,"refs":[],"lines":["Varaṃ me buddhaseṭṭhassa, ñāṇamhi abhiropitaṃ."],"lineRefs":[[]]},{"para":533,"vripara":null,"refs":[],"lines":["“Sambuddhaṃ paṭimānentī, dvārāsanne nisīdahaṃ;"],"lineRefs":[[]]},{"para":534,"vripara":null,"refs":[],"lines":["Yadā ehiti sambuddho, pūjayissaṃ mahāmuniṃ."],"lineRefs":[[]]},{"para":535,"vripara":null,"refs":[],"lines":["“Kakudho vilasantova, migarājāva kesarī;"],"lineRefs":[[]]},{"para":536,"vripara":null,"refs":[],"lines":["Bhikkhusaṅghena sahito, āgacchi vīthiyā jino."],"lineRefs":[[]]},{"para":537,"vripara":null,"refs":[],"lines":["“Buddhassa raṃsiṃ disvāna, haṭṭhā saṃviggamānasā;"],"lineRefs":[[]]},{"para":538,"vripara":null,"refs":[],"lines":["Dvāraṃ avāpuritvāna, buddhaseṭṭhamapūjayiṃ."],"lineRefs":[[]]},{"para":539,"vripara":null,"refs":[],"lines":["“Satta uppalapupphāni, parikiṇṇāni ambare;"],"lineRefs":[[]]},{"para":540,"vripara":null,"refs":[],"lines":["Chadiṃ karonto buddhassa, matthake dhārayanti te."],"lineRefs":[[]]},{"para":541,"vripara":null,"refs":[],"lines":["“Udaggacittā sumanā, vedajātā katañjalī;"],"lineRefs":[[]]},{"para":542,"vripara":null,"refs":[],"lines":["Tattha cittaṃ pasādetvā, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":543,"vripara":null,"refs":[],"lines":["“Mahānelassa chādanaṃ, dhārenti mama muddhani;"],"lineRefs":[[]]},{"para":544,"vripara":null,"refs":[],"lines":["Dibbagandhaṃ pavāyāmi, sattuppalassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":545,"vripara":null,"refs":[],"lines":["“Kadāci nīyamānāya, ñātisaṅghena me tadā;"],"lineRefs":[[]]},{"para":546,"vripara":null,"refs":[],"lines":["Yāvatā parisā mayhaṃ, mahānelaṃ dharīyati."],"lineRefs":[[]]},{"para":547,"vripara":null,"refs":[],"lines":["“Sattati devarājūnaṃ, mahesittamakārayiṃ;"],"lineRefs":[[]]},{"para":548,"vripara":null,"refs":[],"lines":["Sabbattha issarā hutvā, saṃsarāmi bhavābhave."],"lineRefs":[[]]},{"para":549,"vripara":null,"refs":[],"lines":["“Tesaṭṭhi cakkavattīnaṃ, mahesittamakārayiṃ;"],"lineRefs":[[]]},{"para":550,"vripara":null,"refs":[],"lines":["Sabbe mamanuvattanti, ādeyyavacanā ahuṃ."],"lineRefs":[[]]},{"para":551,"vripara":null,"refs":[],"lines":["“Uppalasseva me vaṇṇo, gandho ceva pavāyati;"],"lineRefs":[[]]},{"para":552,"vripara":null,"refs":[],"lines":["Dubbaṇṇiyaṃ na jānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":553,"vripara":null,"refs":[],"lines":["“Iddhipādesu kusalā, bojjhaṅgabhāvanāratā;"],"lineRefs":[[]]},{"para":554,"vripara":null,"refs":[],"lines":["Abhiññāpāramippattā, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":555,"vripara":null,"refs":[],"lines":["“Satipaṭṭhānakusalā, samādhijhānagocarā;"],"lineRefs":[[]]},{"para":556,"vripara":null,"refs":[],"lines":["Sammappadhānamanuyuttā, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":557,"vripara":null,"refs":[],"lines":["“Vīriyaṃ me dhuradhorayhaṃ, yogakkhemādhivāhanaṃ;"],"lineRefs":[[]]},{"para":558,"vripara":null,"refs":[],"lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."],"lineRefs":[[]]},{"para":559,"vripara":null,"refs":[],"lines":["“Ekatiṃse ito kappe, yaṃ pupphamabhipūjayiṃ;"],"lineRefs":[[]]},{"para":560,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":561,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti.(apa. therī 2.1.71-90);"],"lineRefs":[[]]},{"para":562,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā udānentī tā eva gāthā parivattitvā abhāsi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
