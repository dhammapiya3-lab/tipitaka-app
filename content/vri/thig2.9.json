{"suttaId":"thig2.9","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[168,174],"vripara":"35"},"segments":{"thig2.9:0.3":"Abhayātherīgāthā","thig2.9:1.1":"“Abhaye bhiduro kāyo, yattha satā puthujjanā;","thig2.9:1.3":"Nikkhipissāmimaṃ dehaṃ, sampajānā satīmatī.","thig2.9:2.1":"“Bahūhi dukkhadhammehi, appamādaratāya me;","thig2.9:2.3":"Taṇhakkhayo anuppatto, kataṃ buddhassa sāsanan”ti.","thig2.9:3.1":"… Abhayā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":563,"to":564,"paras":[{"para":563,"vripara":null,"refs":["thig2.9:3"],"lines":["Tattha <b>abhaye</b>ti attānameva ālapati.","<b>Bhiduro</b>ti bhijjanasabhāvo, aniccoti attho.","<b>Yattha sattā puthujjanā</b>ti yasmiṃ khaṇena bhijjanasīle asuciduggandhajegucchapaṭikkūlasabhāve kāye ime andhaputhujjanā sattā laggā laggitā.","<b>Nikkhipissāmimaṃ dehan</b>ti ahaṃ pana imaṃ dehaṃ pūtikāyaṃ puna anādānena nirapekkhā khipissāmi chaḍḍessāmi.","Tattha kāraṇamāha <b>“sampajānā satīmatī”</b>ti."],"lineRefs":[["thig2.9:3"],["thig2.9:3"],["thig2.9:3"],["thig2.9:3"],["thig2.9:3"]]},{"para":564,"vripara":null,"refs":["thig2.9:2"],"lines":["<b>Bahūhi dukkhadhammehī</b>ti jātijarādīhi anekehi dukkhadhammehi phuṭṭhāyāti adhippāyo.","<b>Appamādaratāyā</b>ti tāya eva dukkhotiṇṇatāya paṭiladdhasaṃvegattā satiavippavāsasaṅkhāte appamāde ratāya.","Sesaṃ vuttanayameva.","Ettha ca satthārā desitaniyāmena –"],"lineRefs":[["thig2.9:2"],["thig2.9:2"],["thig2.9:2"],["thig2.9:2"]]}],"wordLinks":[["thig2.9:3.1","abhaye",0,0],["thig2.9:2.1","bahūhi dukkhadhammehī",1,0],["thig2.9:2.1","appamādaratāyā",1,1]]},"tika":null,"tika2":null}
