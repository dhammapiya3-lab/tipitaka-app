{"suttaId":"thag2.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[851,857],"vripara":"155"},"segments":{"thag2.18:0.4":"Kimilattheragāthā","thag2.18:1.1":"“Pācīnavaṃsadāyamhi, sakyaputtā sahāyakā;","thag2.18:1.3":"Pahāyānappake bhoge, uñchāpattāgate ratā.","thag2.18:2.1":"“Āraddhavīriyā pahitattā, niccaṃ daḷhaparakkamā;","thag2.18:2.3":"Ramanti dhammaratiyā, hitvāna lokiyaṃ ratin”ti.","thag2.18:2.5":"… Kimilo [kimbilo (sī. syā. pī.)] thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":3591,"to":3591,"paras":[{"para":3591,"vripara":null,"refs":["thag2.18:2"],"lines":["<b>Āraddhavīriyā</b>ti uttamatthassa adhigamāya āditova pageva sampāditavīriyā.","<b>Pahitattā</b>ti ninnapoṇapabbhārabhāvena kālena kālaṃ samāpajjanena ca nibbānaṃ patipesitacittā.","<b>Niccaṃ daḷhaparakkamā</b>ti vattapaṭipattīsu diṭṭhadhammasukhavihārānuyogena sabbakālaṃ asithilaparakkamā.","<b>Ramanti dhammaratiyā, hitvāna lokiyaṃ ratin</b>ti loke viditatāya lokapariyāpannatāya ca lokiyaṃ rūpārammaṇādiratiṃ pahāya maggapaññāya pajahitvā lokuttaradhammaratiyā aggaphalanibbānābhiratiyā ca ramanti abhiramantīti."],"lineRefs":[["thag2.18:2"],["thag2.18:2"],["thag2.18:2"],["thag2.18:2"]]}],"wordLinks":[["thag2.18:2.1","āraddhavīriyā",0,0],["thag2.18:2.1","pahitattā",0,1],["thag2.18:2.1","niccaṃ daḷhaparakkamā",0,2],["thag2.18:2.3","ramanti dhammaratiyā hitvāna lokiyaṃ ratiṃ",0,3]]},"tika":null,"tika2":null}
