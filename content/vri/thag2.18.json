{"suttaId":"thag2.18","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[851,857],"vripara":"155"},"segments":{"thag2.18:0.4":"Kimilattheragāthā","thag2.18:1.1":"“Pācīnavaṃsadāyamhi, sakyaputtā sahāyakā;","thag2.18:1.3":"Pahāyānappake bhoge, uñchāpattāgate ratā.","thag2.18:2.1":"“Āraddhavīriyā pahitattā, niccaṃ daḷhaparakkamā;","thag2.18:2.3":"Ramanti dhammaratiyā, hitvāna lokiyaṃ ratin”ti.","thag2.18:2.5":"… Kimilo [kimbilo (sī. syā. pī.)] thero …."},"attha":null,"tika":null}
