{"suttaId":"an2.64-76","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-ii","vriCode":"s0402m1.mul","paras":[153,166],"vripara":"65"},"segments":{"an2.64:0.2":"(7) 2. Sukhavaggo","an2.64:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.64:1.2":"Katamāni dve?","an2.64:1.3":"Gihisukhañca pabbajitasukhañca.","an2.64:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.64:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ pabbajitasukhan”ti.","an2.65:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.65:1.2":"Katamāni dve?","an2.65:1.3":"Kāmasukhañca nekkhammasukhañca.","an2.65:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.65:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ nekkhammasukhan”ti.","an2.66:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.66:1.2":"Katamāni dve?","an2.66:1.3":"Upadhisukhañca nirupadhisukhañca.","an2.66:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.66:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ nirupadhisukhan”ti.","an2.67:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.67:1.2":"Katamāni dve?","an2.67:1.3":"Sāsavasukhañca anāsavasukhañca.","an2.67:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.67:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ anāsavasukhan”ti.","an2.68:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.68:1.2":"Katamāni dve?","an2.68:1.3":"Sāmisañca sukhaṃ nirāmisañca sukhaṃ.","an2.68:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.68:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ nirāmisaṃ sukhan”ti.","an2.69:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.69:1.2":"Katamāni dve?","an2.69:1.3":"Ariyasukhañca anariyasukhañca.","an2.69:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.69:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ ariyasukhan”ti.","an2.70:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.70:1.2":"Katamāni dve?","an2.70:1.3":"Kāyikañca sukhaṃ cetasikañca sukhaṃ.","an2.70:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.70:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ cetasikaṃ sukhan”ti.","an2.71:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.71:1.2":"Katamāni dve?","an2.71:1.3":"Sappītikañca sukhaṃ nippītikañca sukhaṃ.","an2.71:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.71:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ nippītikaṃ sukhan”ti.","an2.72:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.72:1.2":"Katamāni dve?","an2.72:1.3":"Sātasukhañca upekkhāsukhañca.","an2.72:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.72:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ upekkhāsukhan”ti.","an2.73:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.73:1.2":"Katamāni dve?","an2.73:1.3":"Samādhisukhañca asamādhisukhañca.","an2.73:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.73:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ samādhisukhan”ti.","an2.74:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.74:1.2":"Katamāni dve?","an2.74:1.3":"Sappītikārammaṇañca sukhaṃ nippītikārammaṇañca sukhaṃ.","an2.74:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.74:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ nippītikārammaṇaṃ sukhan”ti.","an2.75:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.75:1.2":"Katamāni dve?","an2.75:1.3":"Sātārammaṇañca sukhaṃ upekkhārammaṇañca sukhaṃ.","an2.75:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.75:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ upekkhārammaṇaṃ sukhan”ti.","an2.76:1.1":"“Dvemāni, bhikkhave, sukhāni.","an2.76:1.2":"Katamāni dve?","an2.76:1.3":"Rūpārammaṇañca sukhaṃ arūpārammaṇañca sukhaṃ.","an2.76:1.4":"Imāni kho, bhikkhave, dve sukhāni.","an2.76:1.5":"Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ arūpārammaṇaṃ sukhan”ti.","an2.76:1.6":"Sukhavaggo dutiyo."},"unsure":[],"preface":[],"attha":{"book":"Mp-ii","bookName":"Dukanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":207,"to":218,"paras":[{"para":207,"vripara":"65","refs":["an2.64"],"lines":["Dutiyassa paṭhame <b>gihisukhan</b>ti gihīnaṃ sabbakāmanipphattimūlakaṃ sukhaṃ.","<b>Pabbajitasukhan</b>ti pabbajitānaṃ pabbajjāmūlakaṃ sukhaṃ."],"lineRefs":[["an2.64"],["an2.64"]]},{"para":208,"vripara":"66","refs":["an2.65"],"lines":["Dutiye <b>kāmasukhan</b>ti kāme ārabbha uppajjanakasukhaṃ.","<b>Nekkhammasukhan</b>ti nekkhammaṃ vuccati pabbajjā, taṃ ārabbha uppajjanakasukhaṃ."],"lineRefs":[["an2.65"],["an2.65"]]},{"para":209,"vripara":"67","refs":["an2.66"],"lines":["Tatiye <b>upadhisukhan</b>ti tebhūmakasukhaṃ.","<b>Nirupadhisukhan</b>ti lokuttarasukhaṃ."],"lineRefs":[["an2.66"],["an2.66"]]},{"para":210,"vripara":"68","refs":["an2.67"],"lines":["Catutthe <b>sāsavasukhan</b>ti āsavānaṃ paccayabhūtaṃ vaṭṭasukhaṃ.","<b>Anāsavasukhan</b>ti tesaṃ apaccayabhūtaṃ vivaṭṭasukhaṃ."],"lineRefs":[["an2.67"],["an2.67"]]},{"para":211,"vripara":"69","refs":["an2.68"],"lines":["Pañcame <b>sāmisan</b>ti saṃkilesaṃ vaṭṭagāmisukhaṃ.","<b>Nirāmisan</b>ti nikkilesaṃ vivaṭṭagāmisukhaṃ."],"lineRefs":[["an2.68"],["an2.68"]]},{"para":212,"vripara":"70","refs":["an2.69"],"lines":["Chaṭṭhe <b>ariyasukhan</b>ti aputhujjanasukhaṃ.","<b>Anariyasukhan</b>ti puthujjanasukhaṃ."],"lineRefs":[["an2.69"],["an2.69"]]},{"para":213,"vripara":"71","refs":["an2.70"],"lines":["Sattame <b>kāyikan</b>ti kāyaviññāṇasahajātaṃ.","<b>Cetasikan</b>ti manodvārikasukhaṃ.","Taṃ lokiyalokuttaramissakaṃ kathitaṃ."],"lineRefs":[["an2.70"],["an2.70"],["an2.70"]]},{"para":214,"vripara":"72","refs":["an2.71"],"lines":["Aṭṭhame <b>sappītikan</b>ti paṭhamadutiyajjhānasukhaṃ.","<b>Nippītikan</b>ti tatiyacatutthajjhānasukhaṃ.","Tattha lokiyasappītikato lokiyanippītikaṃ, lokuttarasappītikato ca lokuttaranippītikaṃ agganti evaṃ bhummantaraṃ abhinditvā aggabhāvo veditabbo."],"lineRefs":[["an2.71"],["an2.71"],["an2.71"]]},{"para":215,"vripara":"73","refs":["an2.72"],"lines":["Navame <b>sātasukhan</b>ti tīsu jhānesu sukhaṃ.","<b>Upekkhāsukhan</b>ti catutthajjhānasukhaṃ."],"lineRefs":[["an2.72"],["an2.72"]]},{"para":216,"vripara":"74","refs":["an2.73"],"lines":["Dasame <b>samādhisukhan</b>ti appanaṃ vā upacāraṃ vā pattasukhaṃ.","<b>Asamādhisukhan</b>ti tadubhayaṃ appattasukhaṃ."],"lineRefs":[["an2.73"],["an2.73"]]},{"para":217,"vripara":"75","refs":["an2.74"],"lines":["Ekādasame <b>sappītikārammaṇan</b>ti sappītikaṃ jhānadvayaṃ paccavekkhantassa uppannasukhaṃ.","<b>Nippītikārammaṇe</b> pi eseva nayo.","Dvādasamepi imināva upāyena attho veditabbo."],"lineRefs":[["an2.74"],["an2.74"],["an2.74"]]},{"para":218,"vripara":"77","refs":["an2.76"],"lines":["Terasame <b>rūpārammaṇan</b>ti rūpāvacaracatutthajjhānārammaṇaṃ, yaṃkiñci rūpaṃ ārabbha uppajjanakaṃ vā.","<b>Arūpārammaṇan</b>ti arūpāvacarajjhānārammaṇaṃ, yaṃkiñci arūpaṃ ārabbha uppajjanakaṃ vāti."],"lineRefs":[["an2.76"],["an2.76"]]}],"wordLinks":[["an2.64:1.3","gihisukhaṃ",0,0],["an2.64:1.3","pabbajitasukhaṃ",0,1],["an2.64:1.5","pabbajitasukhaṃ",0,1],["an2.65:1.3","kāmasukhaṃ",1,0],["an2.65:1.3","nekkhammasukhaṃ",1,1],["an2.65:1.5","nekkhammasukhaṃ",1,1],["an2.66:1.3","upadhisukhaṃ",2,0],["an2.66:1.5","upadhisukhaṃ",2,0],["an2.66:1.3","nirupadhisukhaṃ",2,1],["an2.66:1.5","nirupadhisukhaṃ",2,1],["an2.67:1.3","sāsavasukhaṃ",3,0],["an2.67:1.3","anāsavasukhaṃ",3,1],["an2.67:1.5","anāsavasukhaṃ",3,1],["an2.68:1.3","sāmisaṃ",4,0],["an2.68:1.3","nirāmisaṃ",4,1],["an2.68:1.5","nirāmisaṃ",4,1],["an2.69:1.3","ariyasukhaṃ",5,0],["an2.69:1.5","ariyasukhaṃ",5,0],["an2.69:1.3","anariyasukhaṃ",5,1],["an2.70:1.3","kāyikaṃ",6,0],["an2.70:1.3","cetasikaṃ",6,1],["an2.70:1.5","cetasikaṃ",6,1],["an2.71:1.3","sappītikaṃ",7,0],["an2.71:1.3","nippītikaṃ",7,1],["an2.71:1.5","nippītikaṃ",7,1],["an2.72:1.3","sātasukhaṃ",8,0],["an2.72:1.3","upekkhāsukhaṃ",8,1],["an2.72:1.5","upekkhāsukhaṃ",8,1],["an2.73:1.3","samādhisukhaṃ",9,0],["an2.73:1.5","samādhisukhaṃ",9,0],["an2.73:1.3","asamādhisukhaṃ",9,1],["an2.74:1.3","sappītikārammaṇaṃ",10,0],["an2.74:1.3","nippītikārammaṇe",10,1],["an2.74:1.5","nippītikārammaṇe",10,1],["an2.76:1.3","rūpārammaṇaṃ",11,0],["an2.76:1.5","rūpārammaṇaṃ",11,0],["an2.76:1.3","arūpārammaṇaṃ",11,1],["an2.76:1.5","arūpārammaṇaṃ",11,1]],"before":[{"para":206,"vripara":null,"title":"2. Sukhavaggavaṇṇanā","lines":["(7)2. Sukhavaggavaṇṇanā"]}],"after":[{"para":219,"vripara":null,"title":"2. Sukhavaggavaṇṇanā","lines":["Sukhavaggo dutiyo."]}]},"tika":{"book":"Mp-t-ii","bookName":"Dukanipāta-ṭīkā","vriCode":"s0402t.tik","from":185,"to":198,"paras":[{"para":185,"vripara":"66","refs":["an2.65"],"lines":["Dutiye <b>kāme</b>ti pañca kāmaguṇe, sabbepi vā tebhūmake dhamme.","Vuttañhetaṃ “sabbepi tebhūmakā dhammā kamanīyaṭṭhena kāmā”ti (mahāni.1).","<b>Nekkhammaṃ vuccati pabbajjā</b> gharabandhanato nikkhantattā.","Nibbānameva vā –"],"lineRefs":[["an2.65"],["an2.65"],["an2.65"],["an2.65"]]},{"para":186,"vripara":null,"refs":["an2.65"],"lines":["“Pabbajjā paṭhamaṃ jhānaṃ, nibbānañca vipassanā;"],"lineRefs":[["an2.65"]]},{"para":187,"vripara":null,"refs":["an2.65"],"lines":["Sabbepi kusalā dhammā, nekkhammanti pavuccare”ti.(itivu. aṭṭha.109)–"],"lineRefs":[["an2.65"]]},{"para":188,"vripara":null,"refs":["an2.65"],"lines":["Hi vuttaṃ."],"lineRefs":[["an2.65"]]},{"para":189,"vripara":"67","refs":["an2.66"],"lines":["Tatiye upadhī vuccanti pañcupādānakkhandhā, tannissitaṃ sukhaṃ <b>upadhisukhaṃ</b>.","Tappaṭipakkhato <b>nirupadhisukhaṃ lokuttarasukhaṃ</b>."],"lineRefs":[["an2.66"],["an2.66"]]},{"para":190,"vripara":"68","refs":["an2.66"],"lines":["Catutthe vaṭṭapariyāpannaṃ sukhaṃ <b>vaṭṭasukhaṃ</b>.","Nibbānārammaṇaṃ sukhaṃ <b>vivaṭṭasukhaṃ</b>."],"lineRefs":[["an2.66"],["an2.66"]]},{"para":191,"vripara":"69","refs":["an2.66"],"lines":["Pañcame <b>saṃkilesan</b>ti saṃkiliṭṭhaṃ.","Tenāha <b>“vaṭṭagāmisukhan”</b>ti.","<b>Vivaṭṭasukhan</b>ti maggaphalasahagataṃ sukhaṃ."],"lineRefs":[["an2.66"],["an2.66"],["an2.66"]]},{"para":192,"vripara":"70","refs":["an2.69"],"lines":["Chaṭṭhe ariyānameva sukhaṃ <b>ariyasukhaṃ,</b> ariyañca taṃ sukhañcātipi <b>ariyasukhaṃ</b>.","Anariyānameva sukhaṃ <b>anariyasukhaṃ</b>.","Anariyañca taṃ sukhañcātipi <b>anariyasukhaṃ</b>."],"lineRefs":[["an2.69"],["an2.69"],["an2.69"]]},{"para":193,"vripara":"71","refs":["an2.69"],"lines":["Sattame <b>tan</b>ti cetasikasukhaṃ."],"lineRefs":[["an2.69"]]},{"para":194,"vripara":"72","refs":["an2.71"],"lines":["Aṭṭhame saha pītiyā vattatīti <b>sappītikaṃ,</b> pītisahagataṃ sukhaṃ.","Sabhāvato virāgato ca natthi etassa pītīti <b>nippītikaṃ sukhaṃ</b>.","Aṭṭhakathāyaṃ panettha jhānasukhameva uddhaṭaṃ, tathā ca “lokiyasappītikasukhato lokiyanippītikasukhaṃ aggan”ti vuttaṃ.","Lokiyanippītikampi hi aggaṃ labbhatevāti bhūmantaraṃ bhinditvā aggabhāvo veditabbo."],"lineRefs":[["an2.71"],["an2.71"],["an2.71"],["an2.71"]]},{"para":195,"vripara":"73","refs":["an2.72"],"lines":["Navame sātasabhāvameva sukhaṃ <b>sātasukhaṃ,</b> na upekkhāsukhaṃ viya asātasabhāvaṃ.","Kāmañcettha kāyaviññāṇasahagatampi sātasukhameva, aṭṭhakathāyaṃ pana “tīsu jhānesu sukhan” teva vuttaṃ."],"lineRefs":[["an2.72"],["an2.72"]]},{"para":196,"vripara":"74","refs":["an2.73"],"lines":["Dasame samādhisampayuttaṃ sukhaṃ <b>samādhisukhaṃ</b>.","Na samādhisampayuttaṃ sukhaṃ <b>asamādhisukhaṃ</b>."],"lineRefs":[["an2.73"],["an2.73"]]},{"para":197,"vripara":"75","refs":["an2.73"],"lines":["Ekādasame suttantakathā esāti <b>“sappītikaṃ jhānadvayan”</b>ti vuttaṃ."],"lineRefs":[["an2.73"]]},{"para":198,"vripara":"77","refs":["an2.76"],"lines":["Terasame rūpajjhānaṃ rūpaṃ uttarapadalopena, taṃ ārammaṇaṃ etassāti <b>rūpārammaṇaṃ</b>.","Catutthajjhānaggahaṇaṃ pana yadassa paṭiyogī, tena samānayogakkhamadassanaparaṃ.","<b>Yaṃ kiñci rūpan</b>ti yaṃ kiñci ruppanalakkhaṇaṃ rūpaṃ.","Tappaṭikkhepena <b>arūpaṃ</b> veditabbaṃ."],"lineRefs":[["an2.76"],["an2.76"],["an2.76"],["an2.76"]]}],"wordLinks":[["an2.65:1.3","kāme",0,0],["an2.66:1.3","upadhisukhaṃ",4,0],["an2.66:1.5","upadhisukhaṃ",4,0],["an2.69:1.3","ariyasukhaṃ",7,0],["an2.69:1.5","ariyasukhaṃ",7,0],["an2.69:1.3","anariyasukhaṃ",7,1],["an2.69:1.3","anariyasukhaṃ",7,2],["an2.71:1.3","sappītikaṃ",9,0],["an2.71:1.5","nippītikaṃ sukhaṃ",9,1],["an2.72:1.3","sātasukhaṃ",10,0],["an2.73:1.3","samādhisukhaṃ",11,0],["an2.73:1.5","samādhisukhaṃ",11,0],["an2.73:1.3","asamādhisukhaṃ",11,1],["an2.76:1.3","rūpārammaṇaṃ",13,0],["an2.76:1.5","rūpārammaṇaṃ",13,0]],"before":[{"para":183,"vripara":null,"title":"2. Sukhavaggavaṇṇanā","lines":["(7)2. Sukhavaggavaṇṇanā"]},{"para":184,"vripara":"65","title":"2. Sukhavaggavaṇṇanā","lines":["Dutiyassa paṭhame <b>sabbakāmanipphattimūlakaṃ sukhan</b>ti anavasesaupabhogaparibhogavatthunipphattihetukaṃ kāmasukhaṃ.","<b>Pabbajjāmūlakaṃ sukhan</b>ti pabbajjāhetukaṃ pavivekasukhaṃ."]}],"after":[{"para":199,"vripara":null,"title":"2. Sukhavaggavaṇṇanā","lines":["Sukhavaggavaṇṇanā niṭṭhitā."]}]},"tika2":null}
