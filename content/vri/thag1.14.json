{"suttaId":"thag1.14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[86,90],"vripara":"14"},"segments":{"thag1.14:0.4":"Sivakasāmaṇeragāthā","thag1.14:1.1":"“Upajjhāyo maṃ avaca, ito gacchāma sīvaka;","thag1.14:1.3":"Gāme me vasati kāyo, araññaṃ me gato mano;","thag1.14:1.5":"Semānakopi gacchāmi, natthi saṅgo vijānatan”ti.","thag1.14:1.7":"… Sivako sāmaṇero …."},"attha":null,"tika":null}
