{"suttaId":"tha-ap439","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[709,723],"vripara":"55"},"segments":{"tha-ap439:0.3":"Ambāṭakadāyakattheraapadānaṃ","tha-ap439:1.1":"“Vipine buddhaṃ disvāna, sayambhuṃ aparājitaṃ;","tha-ap439:1.3":"Ambāṭakaṃ gahetvāna, sayambhussa adāsahaṃ.","tha-ap439:2.1":"“Ekatiṃse ito kappe, yaṃ phalamadadiṃ tadā;","tha-ap439:2.3":"Duggatiṃ nābhijānāmi, phaladānassidaṃ phalaṃ.","tha-ap439:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap439:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap439:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap439:6.1":"Itthaṃ sudaṃ āyasmā ambāṭakadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap439:7.1":"Ambāṭakadāyakattherassāpadānaṃ sattamaṃ."},"attha":null,"tika":null}
