{"suttaId":"tha-ap439","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[709,723],"vripara":"55"},"segments":{"tha-ap439:0.3":"Ambāṭakadāyakattheraapadānaṃ","tha-ap439:1.1":"“Vipine buddhaṃ disvāna,","tha-ap439:1.2":"sayambhuṃ aparājitaṃ;","tha-ap439:1.3":"Ambāṭakaṃ gahetvāna,","tha-ap439:1.4":"sayambhussa adāsahaṃ. 56.","tha-ap439:2.1":"“Ekatiṃse ito kappe,","tha-ap439:2.2":"yaṃ phalamadadiṃ tadā;","tha-ap439:2.3":"Duggatiṃ nābhijānāmi,","tha-ap439:2.4":"phaladānassidaṃ phalaṃ. 57.","tha-ap439:3.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap439:3.3":"viharāmi anāsavo. 58.","tha-ap439:4.1":"“Svāgataṃ vata me āsi…pe…","tha-ap439:4.3":"kataṃ buddhassa sāsanaṃ. 59.","tha-ap439:5.1":"“Paṭisambhidā catasso…pe…","tha-ap439:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap439:6.1":"Itthaṃ sudaṃ āyasmā ambāṭakadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap439:7.1":"Ambāṭakadāyakattherassāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
