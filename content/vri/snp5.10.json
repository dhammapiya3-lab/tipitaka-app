{"suttaId":"snp5.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3753,3767],"vripara":"1094"},"segments":{"snp5.10:0.2":"Todeyyamāṇavapucchā","snp5.10:1.1":"“Yasmiṃ kāmā na vasanti,","snp5.10:1.2":"(iccāyasmā todeyyo)","snp5.10:1.3":"Taṇhā yassa na vijjati;","snp5.10:1.4":"Kathaṃkathā ca yo tiṇṇo,","snp5.10:1.5":"vimokkho tassa kīdiso”.","snp5.10:2.1":"“Yasmiṃ kāmā na vasanti,","snp5.10:2.2":"(todeyyāti bhagavā)","snp5.10:2.3":"Taṇhā yassa na vijjati;","snp5.10:2.4":"Kathaṃkathā ca yo tiṇṇo,","snp5.10:2.5":"vimokkho tassa nāparo”.","snp5.10:3.1":"“Nirāsaso so uda āsasāno,","snp5.10:3.2":"paññāṇavā so uda paññakappī;","snp5.10:3.3":"Muniṃ ahaṃ sakka yathā vijaññaṃ,","snp5.10:3.4":"taṃ me viyācikkha samantacakkhu”.","snp5.10:4.1":"“Nirāsaso so na ca āsasāno,","snp5.10:4.2":"paññāṇavā so na ca paññakappī;","snp5.10:4.3":"Evampi todeyya muniṃ vijāna,","snp5.10:4.4":"akiñcanaṃ kāmabhave asattan”ti.","snp5.10:4.5":"Todeyyamāṇavapucchā navamā niṭṭhitā."},"unsure":[],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2596,"to":2597,"paras":[{"para":2596,"vripara":"1095","refs":["snp5.10:2"],"lines":["<b>Yasmiṃ kāmā</b>ti todeyyasuttaṃ.","Tattha <b>vimokkho tassa kīdiso</b>ti tassa kīdiso vimokkho icchitabboti pucchati.","Idāni tassa aññavimokkhābhāvaṃ dassento bhagavā dutiyaṃ gāthamāha.","Tattha <b>vimokkho tassa nāparo</b>ti tassa añño vimokkho natthi."],"lineRefs":[["snp5.10:2"],["snp5.10:2"],["snp5.10:2"],["snp5.10:2"]]},{"para":2597,"vripara":"1097-1098","refs":["snp5.10:2","snp5.10:4"],"lines":["1097-8. Evaṃ “taṇhakkhayo eva vimokkho”ti vuttepi tamatthaṃ asallakkhento <b>“nirāsaso so uda āsasāno”</b>ti puna pucchati.","Tattha <b>uda paññakappī</b>ti udāhu samāpattiñāṇādinā ñāṇena taṇhākappaṃ vā diṭṭhikappaṃ vā kappayati.","Athassa bhagavā taṃ ācikkhanto dutiyaṃ gāthamāha.","Tattha <b>kāmabhave</b>ti kāme ca bhave ca.","Sesaṃ sabbattha pākaṭameva."],"lineRefs":[["snp5.10:2"],["snp5.10:2"],["snp5.10:2"],["snp5.10:4"],["snp5.10:4"]]}],"wordLinks":[["snp5.10:2.1","yasmiṃ kāmā",0,0],["snp5.10:2.4","vimokkho tassa nāparo",0,3],["snp5.10:4.3","kāmabhave",1,3]]},"tika":null,"tika2":null}
