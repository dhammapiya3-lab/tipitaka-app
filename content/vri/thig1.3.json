{"suttaId":"thig1.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[16,19],"vripara":"3"},"segments":{"thig1.3:0.3":"Puṇṇātherīgāthā","thig1.3:1.1":"“Puṇṇe pūrassu dhammehi,","thig1.3:1.2":"cando pannaraseriva;","thig1.3:1.3":"Paripuṇṇāya paññāya,","thig1.3:1.4":"tamokhandhaṃ [tamokkhandhaṃ (sī. syā.)] padālayā”ti.","thig1.3:2.1":"Itthaṃ sudaṃ puṇṇā therī gāthaṃ abhāsitthāti. 4."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":57,"to":57,"paras":[{"para":57,"vripara":null,"refs":["thig1.3:1"],"lines":["Tattha <b>puṇṇe</b>ti tassā ālapanaṃ.","<b>Pūrassu dhammehī</b>ti sattatiṃsabodhipakkhiyadhammehi paripuṇṇā hohi.","<b>Cando pannaraserivā</b>ti ra-kāro padasandhikaro.","Pannarase puṇṇamāsiyaṃ sabbāhi kalāhi paripuṇṇo cando viya.","<b>Paripuṇṇāya paññāyā</b>ti soḷasannaṃ kiccānaṃ pāripūriyā paripuṇṇāya arahattamaggapaññāya.","<b>Tamokhandhaṃ padālayā</b>ti mohakkhandhaṃ anavasesato bhinda samucchinda.","Mohakkhandhapadālanena saheva sabbepi kilesā padālitā hontīti."],"lineRefs":[["thig1.3:1"],["thig1.3:1"],["thig1.3:1"],["thig1.3:1"],["thig1.3:1"],["thig1.3:1"],["thig1.3:1"]]}],"wordLinks":[["thig1.3:1.1","puṇṇe",0,0],["thig1.3:1.3","puṇṇe",0,0],["thig1.3:1.1","pūrassu dhammehī",0,1],["thig1.3:1.1","cando pannaraserivā",0,2],["thig1.3:1.3","paripuṇṇāya paññāyā",0,4],["thig1.3:1.3","tamokhandhaṃ padālayā",0,5]],"before":[{"para":52,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Puṇṇātherīgāthāvaṇṇanā"]},{"para":53,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["<b>Puṇṇe</b> <b>pūrassu dhammehī</b>ti puṇṇāya nāma sikkhamānāya gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī buddhasuññe loke candabhāgāya nadiyā tīre kinnarayoniyaṃ nibbattā.","Ekadivasaṃ tattha aññataraṃ paccekabuddhaṃ disvā pasannamānasā naḷamālāya taṃ pūjetvā añjaliṃ paggayha aṭṭhāsi.","Sā tena puññakammena sugatīsuyeva saṃsarantī imasmiṃ buddhuppāde sāvatthiyaṃ gahapatimahāsālakule nibbatti.","<b>Puṇṇā</b>tissā nāmaṃ ahosi.","Sā upanissayasampannatāya vīsativassāni vasamānā mahāpajāpatigotamiyā santike dhammaṃ sutvā paṭiladdhasaddhā pabbajitvā sikkhamānā eva hutvā vipassanaṃ ārabhi.","Satthā tassā gandhakuṭiyaṃ nisinno eva obhāsaṃ vissajjetvā – 3."]},{"para":55,"vripara":"3","title":"Puṇṇātherīgāthāvaṇṇanā","lines":["“Puṇṇe pūrassu dhammehi, cando pannaraseriva;"]},{"para":56,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Paripuṇṇāya paññāya, tamokhandhaṃ padālayā”ti. –","imaṃ gāthamāha;"]}],"after":[{"para":58,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Sā taṃ gāthaṃ sutvā vipassanaṃ vaḍḍhetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.1.37-45) –"]},{"para":59,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["“Candabhāgānadītīre, ahosiṃ kinnarī tadā;"]},{"para":60,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Addasaṃ virajaṃ buddhaṃ, sayambhuṃ aparājitaṃ."]},{"para":61,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["“Pasannacittā sumanā, vedajātā katañjalī;"]},{"para":62,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Naḷamālaṃ gahetvāna, sayambhuṃ abhipūjayiṃ."]},{"para":63,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"]},{"para":64,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Jahitvā kinnarīdehaṃ, agacchiṃ tidasaṃ gatiṃ."]},{"para":65,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["“Chattiṃsadevarājūnaṃ, mahesittamakārayiṃ;"]},{"para":66,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Dasannaṃ cakkavattīnaṃ, mahesittamakārayiṃ;"]},{"para":67,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Saṃvejetvāna me cittaṃ, pabbajiṃ anagāriyaṃ."]},{"para":68,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ, bhavā sabbe samūhatā;"]},{"para":69,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."]},{"para":70,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["“Catunnavutito kappe, yaṃ pupphamabhipūjayiṃ;"]},{"para":71,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, pupphapūjāyidaṃ phalaṃ."]},{"para":72,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti."]},{"para":73,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Arahattaṃ pana patvā sā therī tameva gāthaṃ udānesi.","Ayameva cassā aññābyākaraṇagāthā ahosīti."]},{"para":74,"vripara":null,"title":"Puṇṇātherīgāthāvaṇṇanā","lines":["Puṇṇātherīgāthāvaṇṇanā niṭṭhitā. 4."]}]},"tika":null,"tika2":null}
