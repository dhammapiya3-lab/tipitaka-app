{"suttaId":"an7.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[14,19],"vripara":"3"},"segments":{"an7.3:0.3":"Saṃkhittabalasuttaṃ","an7.3:1.1":"Evaṃ me sutaṃ –","an7.3:1.2":"ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme … pe …","an7.3:1.3":"sattimāni, bhikkhave, balāni.","an7.3:1.4":"Katamāni satta?","an7.3:1.5":"Saddhābalaṃ, vīriyabalaṃ, hirībalaṃ, ottappabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ.","an7.3:1.6":"Imāni kho, bhikkhave, satta balānīti.","an7.3:2.1":"“Saddhābalaṃ vīriyañca,","an7.3:2.2":"hirī [hiri (sī. pī. ka.)] ottappiyaṃ balaṃ;","an7.3:2.3":"Satibalaṃ samādhi ca,","an7.3:2.4":"paññā ve sattamaṃ balaṃ;","an7.3:2.5":"Etehi balavā bhikkhu,","an7.3:2.6":"sukhaṃ jīvati paṇḍito;","an7.3:3.1":"“Yoniso vicine dhammaṃ,","an7.3:3.2":"paññāyatthaṃ vipassati;","an7.3:3.3":"Pajjotasseva nibbānaṃ,","an7.3:3.4":"vimokkho hoti cetaso”ti.","an7.3:3.5":"tatiyaṃ;"},"unsure":[],"preface":[],"attha":{"book":"Mp-vii","bookName":"Sattakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":796,"to":797,"paras":[{"para":796,"vripara":"1-5","refs":["an7.3:1"],"lines":["1-5. Sattakanipātassa paṭhame <b>anavaññattikāmo</b>ti abhiññātabhāvakāmo.","Tatiye <b>yoniso vicine dhamman</b>ti upāyena catusaccadhammaṃ vicināti.","<b>Paññāyatthaṃ vipassatī</b>ti sahavipassanāya maggapaññāya saccadhammaṃ vipassati.","<b>Pajjotassevā</b>ti dīpasseva.","<b>Vimokkho hoti cetaso</b>ti tassa imehi balehi samannāgatassa khīṇāsavassa dīpanibbānaṃ viya carimakacittassa vatthārammaṇehi vimokkho hoti, gataṭṭhānaṃ na paññāyati.","Catutthe <b>saddho hotī</b>tiādīni pañcakanipāte vaṇṇitāneva.","Pañcame <b>dhanānī</b>ti adāliddiyakaraṇaṭṭhena dhanāni."],"lineRefs":[["an7.3:1"],["an7.3:1"],["an7.3:1"],["an7.3:1"],["an7.3:1"],["an7.3:1"],["an7.3:1"]]},{"para":797,"vripara":null,"refs":["an7.3:1"],"lines":["Uggasuttavaṇṇanā"],"lineRefs":[["an7.3:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-vii","bookName":"Sattakanipāta-ṭīkā","vriCode":"s0403t.tik","from":796,"to":798,"paras":[{"para":796,"vripara":"1-10","refs":["an7.3:1"],"lines":["1-10. Sattakanipātassa paṭhamo vaggo uttānattho."],"lineRefs":[["an7.3:1"]]},{"para":797,"vripara":null,"refs":["an7.3:1"],"lines":["Anusayavaggo"],"lineRefs":[["an7.3:1"]]},{"para":798,"vripara":null,"refs":["an7.3:1"],"lines":["Puggalasuttavaṇṇanā"],"lineRefs":[["an7.3:1"]]}],"wordLinks":[]},"tika2":null}
