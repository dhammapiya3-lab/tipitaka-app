{"suttaId":"tha-ap323","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9428,9447],"vripara":"1"},"segments":{"tha-ap323:0.3":"Umāpupphiyattheraapadānaṃ","tha-ap323:1.1":"“Samāhitaṃ samāpannaṃ,","tha-ap323:1.2":"siddhatthamaparājitaṃ;","tha-ap323:1.3":"Samādhinā upaviṭṭhaṃ,","tha-ap323:1.4":"addasāhaṃ naruttamaṃ. 2.","tha-ap323:2.1":"“Umāpupphaṃ gahetvāna,","tha-ap323:2.2":"buddhassa abhiropayiṃ;","tha-ap323:2.3":"Sabbapupphā ekasīsā,","tha-ap323:2.4":"uddhaṃvaṇṭā adhomukhā. 3.","tha-ap323:3.1":"“Sucittā viya tiṭṭhante,","tha-ap323:3.2":"ākāse pupphasantharā;","tha-ap323:3.3":"Tena cittappasādena,","tha-ap323:3.4":"tusitaṃ upapajjahaṃ. 4.","tha-ap323:4.1":"“Catunnavutito kappe,","tha-ap323:4.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap323:4.3":"Duggatiṃ nābhijānāmi,","tha-ap323:4.4":"buddhapūjāyidaṃ phalaṃ. 5.","tha-ap323:5.1":"“Pañcapaññāsito kappe,","tha-ap323:5.2":"eko āsiṃ mahīpati;","tha-ap323:5.3":"Samantachadano nāma,","tha-ap323:5.4":"cakkavattī mahabbalo. 6.","tha-ap323:6.1":"“Paṭisambhidā catasso,","tha-ap323:6.2":"vimokkhāpi ca aṭṭhime;","tha-ap323:6.3":"Chaḷabhiññā sacchikatā,","tha-ap323:6.4":"kataṃ buddhassa sāsanaṃ.","tha-ap323:7.1":"Itthaṃ sudaṃ āyasmā umāpupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap323:8.1":"Umāpupphiyattherassāpadānaṃ paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
