{"suttaId":"sn22.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[122,122],"vripara":"17"},"segments":{"sn22.17:0.3":"Yadanattāsuttaṃ","sn22.17:1.1":"Sāvatthinidānaṃ.","sn22.17:1.2":"“Rūpaṃ, bhikkhave, anattā.","sn22.17:1.3":"Yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn22.17:1.4":"Vedanā anattā … saññā anattā … saṅkhārā anattā … viññāṇaṃ anattā.","sn22.17:1.8":"Yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn22.17:1.9":"Evaṃ passaṃ … pe … nāparaṃ itthattāyāti pajānātī”ti.","sn22.17:1.11":"Chaṭṭhaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":70,"to":73,"paras":[{"para":70,"vripara":"12-21","refs":["sn22.17:1"],"lines":["12-21. Aniccavagge pariyosānasuttaṃ pucchāvasikaṃ, sesāni tathā tathā bujjhanakānañca vasena desitānīti.","Paṭhamādīni."],"lineRefs":[["sn22.17:1"],["sn22.17:1"]]},{"para":71,"vripara":null,"refs":["sn22.17:1"],"lines":["Aniccavaggo dutiyo."],"lineRefs":[["sn22.17:1"]]},{"para":72,"vripara":null,"refs":["sn22.17:1"],"lines":["Bhāravaggo"],"lineRefs":[["sn22.17:1"]]},{"para":73,"vripara":null,"refs":["sn22.17:1"],"lines":["Bhārasuttavaṇṇanā"],"lineRefs":[["sn22.17:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":66,"to":70,"paras":[{"para":66,"vripara":"12-21","refs":["sn22.17:1"],"lines":["12-21. <b>Pucchāvasikaṃ</b> ānandattherassa pucchāvasena desitattā."],"lineRefs":[["sn22.17:1"]]},{"para":67,"vripara":null,"refs":["sn22.17:1"],"lines":["Aniccādisuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.17:1"]]},{"para":68,"vripara":null,"refs":["sn22.17:1"],"lines":["Aniccavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.17:1"]]},{"para":69,"vripara":null,"refs":["sn22.17:1"],"lines":["Bhāravaggo"],"lineRefs":[["sn22.17:1"]]},{"para":70,"vripara":null,"refs":["sn22.17:1"],"lines":["