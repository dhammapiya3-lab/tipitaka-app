{"suttaId":"sn45.165","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[363,363],"vripara":"165"},"segments":{"sn45.165:0.3":"Dukkhatāsuttaṃ","sn45.165:1.1":"“Tisso imā, bhikkhave, dukkhatā.","sn45.165:1.2":"Katamā tisso?","sn45.165:1.3":"Dukkhadukkhatā, saṅkhāradukkhatā, vipariṇāmadukkhatā – imā kho, bhikkhave, tisso dukkhatā.","sn45.165:1.5":"Imāsaṃ kho, bhikkhave, tissannaṃ dukkhatānaṃ abhiññāya pariññāya parikkhayāya pahānāya … pe … aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.165:1.6":"Pañcamaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":114,"to":117,"paras":[{"para":114,"vripara":"162-171","refs":["sn45.165:1"],"lines":["162-171. <b>Vidhā</b>ti mānakoṭṭhāsā mānaṭhapanā vā.","<b>Seyyohamasmīti vidhā</b>ti ahamasmi seyyoti evaṃ mānakoṭṭhāso mānaṭhapanā vā.","<b>Nīghā</b>ti dukkhā.","Vacanattho panettha yassa uppajjanti, taṃ purisaṃ nīhanantīti nīghā.","Sesamettha uttānamevāti."],"lineRefs":[["sn45.165:1"],["sn45.165:1"],["sn45.165:1"],["sn45.165:1"],["sn45.165:1"]]},{"para":115,"vripara":null,"refs":[],"lines":["Esanāvaggo dasamo."],"lineRefs":[[]]},{"para":116,"vripara":null,"refs":[],"lines":["Oghavaggo"],"lineRefs":[[]]},{"para":117,"vripara":null,"refs":["sn45.165:1"],"lines":["1-2. Oghasuttādivaṇṇanā"],"lineRefs":[["sn45.165:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":114,"to":117,"paras":[{"para":114,"vripara":"162-171","refs":["sn45.165:1"],"lines":["162-171. Seyyohamasmītiādinā taṃtaṃvibhāgena dhīyanti vidhīyantīti <b>vidhā,</b> mānakoṭṭhāsā, mānaṭṭhapanā vā.","<b>Nīhanantī</b>ti vibādhenti."],"lineRefs":[["sn45.165:1"],["sn45.165:1"]]},{"para":115,"vripara":null,"refs":[],"lines":["Esanāvaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":116,"vripara":null,"refs":[],"lines":["Oghavaggo"],"lineRefs":[[]]},{"para":117,"vripara":null,"refs":["sn45.165:1"],"lines":["1-2. Oghasuttādivaṇṇanā"],"lineRefs":[["sn45.165:1"]]}],"wordLinks":[]},"tika2":null}
