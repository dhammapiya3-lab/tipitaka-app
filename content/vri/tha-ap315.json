{"suttaId":"tha-ap315","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9262,9274],"vripara":"10"},"segments":{"tha-ap315:0.3":"Gatasaññakattheraapadānaṃ","tha-ap315:1.1":"“Ākāseva padaṃ natthi,","tha-ap315:1.2":"ambare anilañjase;","tha-ap315:1.3":"Siddhatthaṃ jinamaddakkhiṃ,","tha-ap315:1.4":"gacchantaṃ tidivaṅgaṇe [tidivaṅgaṇaṃ (syā. ka.)].","tha-ap315:2.1":"“Anileneritaṃ disvā,","tha-ap315:2.2":"sammāsambuddhacīvaraṃ;","tha-ap315:2.3":"Vitti mamāhu tāvade [vitti me pāhuṇā tāva (syā.), vitti me tāvade jātā (sī.)],","tha-ap315:2.4":"disvāna gamanaṃ muniṃ [mune (sī.)].","tha-ap315:3.1":"“Catunnavutito kappe,","tha-ap315:3.2":"yaṃ saññamalabhiṃ tadā;","tha-ap315:3.3":"Duggatiṃ nābhijānāmi,","tha-ap315:3.4":"buddhasaññāyidaṃ phalaṃ.","tha-ap315:4.1":"“Paṭisambhidā catasso … pe …","tha-ap315:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap315:5.1":"Itthaṃ sudaṃ āyasmā gatasaññako thero imā gāthāyo abhāsitthāti.","tha-ap315:6.1":"Gatasaññakattherassāpadānaṃ tatiyaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
