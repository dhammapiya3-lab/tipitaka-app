{"suttaId":"thag16.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[3280,3335],"vripara":"842"},"segments":{"thag16.7:0.4":"Kāḷigodhāputtabhaddiyattheragāthā","thag16.7:1.1":"“Yātaṃ me hatthigīvāya,","thag16.7:1.2":"sukhumā vatthā padhāritā;","thag16.7:1.3":"Sālīnaṃ odano bhutto,","thag16.7:1.4":"sucimaṃsūpasecano.","thag16.7:2.1":"“Sojja bhaddo sātatiko,","thag16.7:2.2":"uñchāpattāgate rato;","thag16.7:2.3":"Jhāyati anupādāno,","thag16.7:2.4":"putto godhāya bhaddiyo.","thag16.7:3.1":"“Paṃsukūlī sātatiko,","thag16.7:3.2":"uñchāpattāgate rato;","thag16.7:3.3":"Jhāyati anupādāno,","thag16.7:3.4":"putto godhāya bhaddiyo.","thag16.7:4.1":"“Piṇḍapātī sātatiko … pe ….","thag16.7:5.1":"“Tecīvarī sātatiko … pe ….","thag16.7:6.1":"“Sapadānacārī sātatiko … pe ….","thag16.7:7.1":"“Ekāsanī sātatiko … pe ….","thag16.7:7.3":"“Pattapiṇḍī sātatiko … pe ….","thag16.7:9.1":"“Khalupacchābhattī sātatiko … pe ….","thag16.7:10.1":"“Āraññiko sātatiko … pe ….","thag16.7:11.1":"“Rukkhamūliko sātatiko … pe ….","thag16.7:12.1":"“Abbhokāsī sātatiko … pe ….","thag16.7:13.1":"“Sosāniko sātatiko … pe ….","thag16.7:14.1":"“Yathāsanthatiko sātatiko … pe ….","thag16.7:15.1":"“Nesajjiko sātatiko … pe ….","thag16.7:16.1":"“Appiccho sātatiko … pe ….","thag16.7:17.1":"“Santuṭṭho sātatiko … pe ….","thag16.7:17.3":"“Pavivitto sātatiko … pe ….","thag16.7:19.1":"“Asaṃsaṭṭho sātatiko … pe ….","thag16.7:20.1":"“Āraddhavīriyo sātatiko … pe ….","thag16.7:21.1":"“Hitvā satapalaṃ kaṃsaṃ,","thag16.7:21.2":"sovaṇṇaṃ satarājikaṃ;","thag16.7:21.3":"Aggahiṃ mattikāpattaṃ,","thag16.7:21.4":"idaṃ dutiyābhisecanaṃ.","thag16.7:22.1":"“Ucce maṇḍalipākāre,","thag16.7:22.2":"daḷhamaṭṭālakoṭṭhake;","thag16.7:22.3":"Rakkhito khaggahatthehi,","thag16.7:22.4":"uttasaṃ vihariṃ pure.","thag16.7:23.1":"“Sojja bhaddo anutrāsī,","thag16.7:23.2":"pahīnabhayabheravo;","thag16.7:23.3":"Jhāyati vanamogayha,","thag16.7:23.4":"putto godhāya bhaddiyo.","thag16.7:24.1":"“Sīlakkhandhe patiṭṭhāya,","thag16.7:24.2":"satiṃ paññañca bhāvayaṃ;","thag16.7:24.3":"Pāpuṇiṃ anupubbena,","thag16.7:24.4":"sabbasaṃyojanakkhayan”ti.","thag16.7:24.5":"… Bhaddiyo kāḷigodhāya putto thero …."},"unsure":["thag16.7:7.3","thag16.7:17.3"],"preface":[],"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":3987,"to":3990,"paras":[{"para":3987,"vripara":null,"refs":["thag16.7:24"],"lines":["Tattha <b>yātaṃ me hatthigīvāyā</b>ti, bhante, pubbe mayā gacchantenāpi hatthigīvāya hatthikkhandhe nisīditvā yātaṃ caritaṃ.","Vatthāni pariharantenāpi <b>sukhumā</b> sukhasamphassā kāsikavatthavisesā dhāritā.","Odanaṃ bhuñjantenāpi tivassikānaṃ purāṇagandhasālīnaṃ odano tittirakapiñjarādinā sucinā maṃsena upasittatāya <b>sucimaṃsūpasecano</b> bhutto, tathāpi taṃ sukhaṃ na mayhaṃ cittaparitosakaraṃ ahosi, yathā etarahi vivekasukhanti dassento āha <b>“sojja bhaddo”</b>tiādi.","Ettha ca hatthiggahaṇeneva assarathayānāni, vatthaggahaṇena sabbarājālaṅkārā, odanaggahaṇena sabbabhojanavikati gahitāti veditabbaṃ.","<b>Sojjā</b>ti so ajja etarahi pabbajjāyaṃ ṭhito.","<b>Bhaddo</b>ti sīlādiguṇehi samannāgatattā bhaddo.","<b>Sātatiko</b>ti samaṇadhamme diṭṭhadhammasukhavihāre sātaccayutto.","<b>Uñchāpattāgate rato</b>ti uñchācariyāya patte āgate pattapariyāpanne abhirato, teneva santuṭṭhoti adhippāyo.","<b>Jhāyatī</b>ti phalasamāpattijhānena jhāyati.","<b>Putto godhāyā</b>ti kāḷigodhāya nāma khattiyāya putto.","<b>Bhaddiyo</b>ti evaṃnāmo attānameva thero aññaṃ viya katvā vadati."],"lineRefs":[["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"]]},{"para":3988,"vripara":null,"refs":["thag16.7:24"],"lines":["Gahapaticīvaraṃ paṭikkhipitvā paṃsukūlikaṅgasamādānena <b>paṃsukūliko</b>.","Saṅghabhattaṃ paṭikkhipitvā piṇḍapātikaṅgasamādānena <b>piṇḍapātiko</b>.","Atirekacīvaraṃ paṭikkhipitvā tecīvarikaṅgasamādānena <b>tecīvariko</b>.","Loluppacāraṃ paṭikkhipitvā sapadānacārikaṅgasamādānena <b>sapadānacārī</b>.","Nānāsanabhojanaṃ paṭikkhipitvā ekāsanikaṅgasamādānena <b>ekāsaniko</b>.","Dutiyakabhājanaṃ paṭikkhipitvā pattapiṇḍikaṅgasamādānena <b>pattapiṇḍiko</b>.","Atirittabhojanaṃ paṭikkhipitvā khalupacchābhattikaṅgasamādānena <b>khalupacchābhattiko</b>.","Gāmantasenāsanaṃ paṭikkhipitvā āraññikaṅgasamādānena <b>āraññiko</b>.","Channavāsaṃ paṭikkhipitvā rukkhamūlikaṅgasamādānena <b>rukkhamūliko</b>.","Channarukkhamūlāni paṭikkhipitvā abbhokāsikaṅgasamādānena <b>abbhokāsiko</b>.","Nasusānaṃ paṭikkhipitvā sosānikaṅgasamādānena <b>sosāniko</b>.","Senāsanaloluppaṃ paṭikkhipitvā yathāsanthatikaṅgasamādānena <b>yathāsanthatiko</b>.","Sayanaṃ paṭikkhipitvā nesajjikaṅgasamādānena <b>nesajjiko</b>.","Ayamettha saṅkhepo.","Vitthārato pana dhutaṅgakathā <b>visuddhimagge</b> (visuddhi.1.22 ādayo) vuttanayeneva gahetabbā."],"lineRefs":[["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"],["thag16.7:24"]]},{"para":3989,"vripara":null,"refs":["thag16.7:24"],"lines":["<b>Ucce</b>ti uccādiṭṭhāne, uparipāsādatāya vā ucce.","<b>Maṇḍalipākāre</b>ti maṇḍalākārena pākāraparikkhitte.","<b>Daḷhamaṭṭālakoṭṭhake</b>ti thirehi aṭṭālehi dvārakoṭṭhakehi ca samannāgate, nagareti attho."],"lineRefs":[["thag16.7:24"],["thag16.7:24"],["thag16.7:24"]]},{"para":3990,"vripara":null,"refs":["thag16.7:24"],"lines":["<b>Satiṃ paññañcā</b>ti ettha satisīsena samādhiṃ vadati.","Phalasamāpattinirodhasamāpattiyo sandhāya “satiṃ paññañca bhāvayan”ti vutto.","Sesaṃ tattha tattha vuttanayattā uttānameva."],"lineRefs":[["thag16.7:24"],["thag16.7:24"],["thag16.7:24"]]}],"wordLinks":[["thag16.7:24.5","bhaddo",0,5],["thag16.7:24.5","bhaddiyo",0,10],["thag16.7:24.1","satiṃ paññañcā",3,0]],"before":[{"para":3927,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā"]},{"para":3928,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["<b>Yātaṃ me hatthigīvāyā</b>tiādikā āyasmato bhaddiyattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro padumuttarassa bhagavato kāle mahābhogakule nibbattitvā viññutaṃ patto ekadivasaṃ satthu santike dhammaṃ suṇanto satthārā ekaṃ bhikkhuṃ uccākulikānaṃ aggaṭṭhāne ṭhapiyamānaṃ disvā sayampi taṃ ṭhānantaraṃ patthetvā sattāhaṃ buddhappamukhassa bhikkhusaṅghassa mahādānaṃ datvā paṇidhānaṃ akāsi.","Satthāpissa anantarāyena samijjhanabhāvaṃ disvā byākāsi.","Sopi taṃ byākaraṇaṃ sutvā uccākulikasaṃvattanikaṃ kammaṃ pucchitvā dhammassavanassa kārāpanaṃ, dhammamaṇḍape āsanadānaṃ, bījanīdānaṃ, dhammakathikānaṃ pūjāsakkārakaraṇaṃ, uposathāgāre paṭissayadānanti evamādiṃ yāvajīvaṃ bahupuññaṃ katvā tato cuto devamanussesu saṃsaranto kassapassa bhagavato aparabhāge amhākaṃ bhagavato uppattiyā puretaraṃ bārāṇasiyaṃ kuṭumbiyaghare nibbatto sambahule paccekabuddhe piṇḍāya caritvā ekasmiṃyeva ṭhāne samāgantvā bhattavissaggaṃ karonte disvā tattha pāsāṇaphalakāni attharitvā pādodakādiṃ upaṭṭhapento yāvajīvaṃ upaṭṭhahi."]},{"para":3929,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["So ekaṃ buddhantaraṃ devamanussesu saṃsaritvā imasmiṃ buddhuppāde kapilavatthunagare sākiyarājakule nibbatti, <b>bhaddiyo</b>tissa nāmaṃ ahosi.","So vayappatto anuruddhādīhi pañcahi khattiyehi saddhiṃ satthari anupiyambavane viharante satthu santike pabbajitvā arahattaṃ pāpuṇi.","Taṃ satthā aparabhāge jetavane ariyagaṇamajjhe nisinno uccākulikānaṃ bhikkhūnaṃ aggaṭṭhāne ṭhapesi.","So phalasukhena nibbānasukhena ca vītināmento araññagatopi rukkhamūlagatopi suññāgāragatopi “aho sukhaṃ, aho sukhan”ti abhikkhaṇaṃ udānaṃ udānesi.","Taṃ sutvā bhikkhū satthu ārocesuṃ –","“āyasmā bhaddiyo kāḷigodhāya putto abhikkhaṇaṃ ‘aho sukhaṃ, aho sukhan’ti vadati, anabhirato maññe brahmacariyaṃ caratī”ti.","Satthā taṃ pakkosāpetvā “saccaṃ kira tvaṃ, bhaddiya, abhikkhaṇaṃ ‘aho sukhaṃ, aho sukhan’ti vadasī”ti pucchi.","So “saccaṃ bhagavā”ti paṭijānitvā “pubbe me, bhante, rajjaṃ kārentassa susaṃvihitārakkho ahosiṃ, tathāpi bhīto ubbiggo ussaṅkito vihāsiṃ.","Idāni pana pabbajito abhīto anubbiggo anussaṅkito viharāmī”ti vatvā –"]},{"para":3931,"vripara":"842","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Yātaṃ me hatthigīvāya, sukhumā vatthā padhāritā;"]},{"para":3932,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Sālīnaṃ odano bhutto, sucimaṃsūpasecano."]},{"para":3934,"vripara":"843","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Sojja bhaddo sātatiko, uñchāpattāgate rato;"]},{"para":3935,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Jhāyati anupādāno, putto godhāya bhaddiyo."]},{"para":3937,"vripara":"844","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Paṃsukūlī sātatiko, uñchāpattāgate rato;"]},{"para":3938,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Jhāyati anupādāno, putto godhāya bhaddiyo."]},{"para":3941,"vripara":"845","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Piṇḍapātī sātatiko … pe …."]},{"para":3943,"vripara":"846","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Tecīvarī sātatiko … pe …."]},{"para":3945,"vripara":"847","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Sapadānacārī sātatiko … pe …."]},{"para":3947,"vripara":"848","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Ekāsanī sātatiko … pe …."]},{"para":3949,"vripara":"849","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Pattapiṇḍī sātatiko … pe …."]},{"para":3951,"vripara":"850","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Khalupacchābhattī sātatiko … pe …."]},{"para":3953,"vripara":"851","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Āraññiko sātatiko … pe …."]},{"para":3955,"vripara":"852","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Rukkhamūliko sātatiko … pe …."]},{"para":3957,"vripara":"853","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Abbhokāsī sātatiko … pe …."]},{"para":3959,"vripara":"854","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Sosāniko sātatiko … pe …."]},{"para":3961,"vripara":"855","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Yathāsanthatiko sātatiko … pe …."]},{"para":3963,"vripara":"856","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Nesajjiko sātatiko … pe …."]},{"para":3965,"vripara":"857","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Appiccho sātatiko … pe …."]},{"para":3967,"vripara":"858","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Santuṭṭho sātatiko … pe …."]},{"para":3969,"vripara":"859","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Pavivitto sātatiko … pe …."]},{"para":3971,"vripara":"860","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Asaṃsaṭṭho sātatiko … pe …."]},{"para":3973,"vripara":"861","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Āraddhavīriyo sātatiko … pe …."]},{"para":3975,"vripara":"862","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Hitvā satapalaṃ kaṃsaṃ, sovaṇṇaṃ satarājikaṃ;"]},{"para":3976,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Aggahiṃ mattikāpattaṃ, idaṃ dutiyābhisecanaṃ."]},{"para":3978,"vripara":"863","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Ucce maṇḍalipākāre, daḷhamaṭṭālakoṭṭhake;"]},{"para":3979,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Rakkhito khaggahatthehi, uttamaṃ vihariṃ pure."]},{"para":3981,"vripara":"864","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Sojja bhaddo anutrāsī, pahīnabhayabheravo;"]},{"para":3982,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Jhāyati vanamogayha, putto godhāya bhaddiyo."]},{"para":3984,"vripara":"865","title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["“Sīlakkhandhe patiṭṭhāya, satiṃ paññañca bhāvayaṃ;"]},{"para":3985,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Pāpuṇiṃ anupubbena, sabbasaṃyojanakkhayan”ti.","–"]},{"para":3986,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Imāhi gāthāhi satthu purato sīhanādaṃ nadi."]}],"after":[{"para":3991,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Evaṃ thero satthu sammukhā sīhanādaṃ nadi.","Taṃ sutvā bhikkhū abhippasannā ahesuṃ."]},{"para":3992,"vripara":null,"title":"Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā","lines":["Kāḷigodhāputtabhaddiyattheragāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
