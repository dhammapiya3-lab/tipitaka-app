{"suttaId":"sn35.106","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[653,654],"vripara":"106"},"segments":{"sn35.106:0.3":"Dukkhasamudayasuttaṃ","sn35.106:1.1":"“Dukkhassa, bhikkhave, samudayañca atthaṅgamañca desessāmi.","sn35.106:1.2":"Taṃ suṇātha.","sn35.106:1.3":"Katamo ca, bhikkhave, dukkhassa samudayo?","sn35.106:1.4":"Cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ. Tiṇṇaṃ saṅgati phasso.","sn35.106:1.5":"Phassapaccayā vedanā;","sn35.106:1.6":"vedanāpaccayā taṇhā.","sn35.106:1.7":"Ayaṃ dukkhassa samudayo…pe…","sn35.106:1.8":"jivhañca paṭicca rase ca uppajjati jivhāviññāṇaṃ. Tiṇṇaṃ saṅgati phasso.","sn35.106:1.9":"Phassapaccayā vedanā;","sn35.106:1.10":"vedanāpaccayā taṇhā.","sn35.106:1.11":"Ayaṃ dukkhassa samudayo…pe… manañca paṭicca dhamme ca uppajjati manoviññāṇaṃ.","sn35.106:1.12":"Tiṇṇaṃ saṅgati phasso.","sn35.106:1.13":"Phassapaccayā vedanā;","sn35.106:1.14":"vedanāpaccayā taṇhā.","sn35.106:1.15":"Ayaṃ kho, bhikkhave, dukkhassa samudayo.","sn35.106:2.1":"“Katamo ca, bhikkhave, dukkhassa atthaṅgamo?","sn35.106:2.2":"Cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ. Tiṇṇaṃ saṅgati phasso.","sn35.106:2.3":"Phassapaccayā vedanā;","sn35.106:2.4":"vedanāpaccayā taṇhā.","sn35.106:2.5":"Tassāyeva taṇhāya asesavirāganirodhā upādānanirodho;","sn35.106:2.6":"upādānanirodhā bhavanirodho;","sn35.106:2.7":"bhavanirodhā jātinirodho;","sn35.106:2.8":"jātinirodhā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā nirujjhanti.","sn35.106:2.9":"Evametassa kevalassa dukkhakkhandhassa nirodho hoti.","sn35.106:2.10":"Ayaṃ dukkhassa atthaṅgamo…pe…","sn35.106:2.11":"jivhañca paṭicca rase ca uppajjati jivhāviññāṇaṃ…pe…","sn35.106:2.12":"manañca paṭicca dhamme ca uppajjati manoviññāṇaṃ. Tiṇṇaṃ saṅgati phasso.","sn35.106:2.13":"Phassapaccayā vedanā;","sn35.106:2.14":"vedanāpaccayā taṇhā.","sn35.106:2.15":"Tassāyeva taṇhāya asesavirāganirodhā upādānanirodho;","sn35.106:2.16":"upādānanirodhā bhavanirodho;","sn35.106:2.17":"bhavanirodhā jātinirodho;","sn35.106:2.18":"jātinirodhā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā nirujjhanti.","sn35.106:2.19":"Evametassa kevalassa dukkhakkhandhassa nirodho hoti.","sn35.106:2.20":"Ayaṃ kho, bhikkhave, dukkhassa atthaṅgamo”ti.","sn35.106:2.21":"Tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":190,"to":193,"paras":[{"para":190,"vripara":"105-113","refs":["sn35.106:1"],"lines":["Dutiye vedanāsukhadukkhaṃ kathitaṃ, taṃ pana vipākasukhadukkhaṃ vaṭṭati.","Tatiye <b>dukkhassā</b>ti vaṭṭadukkhassa.","Catutthe <b>lokassā</b>ti saṅkhāralokassa.","Pañcamādīsu yaṃ vattabbaṃ siyā, taṃ khandhiyavagge vuttanayameva."],"lineRefs":[["sn35.106:1"],["sn35.106:1"],["sn35.106:1"],["sn35.106:1"]]},{"para":191,"vripara":null,"refs":["sn35.106:1"],"lines":["Yogakkhemivaggo ekādasamo. 12."],"lineRefs":[["sn35.106:1"]]},{"para":192,"vripara":null,"refs":["sn35.106:1"],"lines":["Lokakāmaguṇavaggo 1-2."],"lineRefs":[["sn35.106:1"]]},{"para":193,"vripara":null,"refs":["sn35.106:1"],"lines":["Paṭhamamārapāsasuttādivaṇṇanā 114-115."],"lineRefs":[["sn35.106:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":196,"to":200,"paras":[{"para":196,"vripara":"105-113","refs":["sn35.106:1"],"lines":["<b>Vedanāsukhadukkha</b>nti vedanāsaṅkhātaṃ sukhañca dukkhañca kathitaṃ.","“Ajjhattaṃ sukhaṃ dukkha”nti vuttattā vimuttisukhassa ca saḷāyatanadukkhassa ca kathitattā vivaṭṭasukhaṃ cettha kathitamevāti sakkā viññātuṃ.","Kāmaṃ khandhiyavagge khandhavasena desanā āgatā, na āyatanavasena.","Ettha pana vattabbaṃ atthajātaṃ khandhiyavagge vuttanayamevāti."],"lineRefs":[["sn35.106:1"],["sn35.106:1"],["sn35.106:1"],["sn35.106:1"]]},{"para":197,"vripara":null,"refs":["sn35.106:1"],"lines":["Upādāyasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.106:1"]]},{"para":198,"vripara":null,"refs":["sn35.106:1"],"lines":["Yogakkhemivaggavaṇṇanā niṭṭhitā. 12."],"lineRefs":[["sn35.106:1"]]},{"para":199,"vripara":null,"refs":["sn35.106:1"],"lines":["Lokakāmaguṇavaggo 1-2."],"lineRefs":[["sn35.106:1"]]},{"para":200,"vripara":null,"refs":["sn35.106:1"],"lines":["Paṭhamamārapāsasuttādivaṇṇanā 114-115."],"lineRefs":[["sn35.106:1"]]}],"wordLinks":[]},"tika2":null}
