{"suttaId":"sn14.35","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[847,848],"vripara":"119"},"segments":{"sn14.35:0.3":"Abhinandasuttaṃ","sn14.35:1.1":"Sāvatthiyaṃ viharati…pe…","sn14.35:1.2":"“yo, bhikkhave, pathavīdhātuṃ abhinandati, dukkhaṃ so abhinandati.","sn14.35:1.3":"Yo dukkhaṃ abhinandati, aparimutto so dukkhasmāti vadāmi.","sn14.35:1.4":"Yo āpodhātuṃ abhinandati…pe…","sn14.35:1.5":"yo tejodhātuṃ…","sn14.35:1.6":"yo vāyodhātuṃ abhinandati, dukkhaṃ so abhinandati.","sn14.35:1.7":"Yo dukkhaṃ abhinandati, aparimutto so dukkhasmāti vadāmi”.","sn14.35:2.1":"“Yo ca kho, bhikkhave, pathavīdhātuṃ nābhinandati, dukkhaṃ so nābhinandati.","sn14.35:2.2":"Yo dukkhaṃ nābhinandati, parimutto so dukkhasmāti vadāmi.","sn14.35:2.3":"Yo āpodhātuṃ…pe…","sn14.35:2.4":"yo tejodhātuṃ…","sn14.35:2.5":"yo vāyodhātuṃ nābhinandati, dukkhaṃ so nābhinandati.","sn14.35:2.6":"Yo dukkhaṃ nābhinandati, parimutto so dukkhasmāti vadāmī”ti.","sn14.35:2.7":"Chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":613,"to":618,"paras":[{"para":613,"vripara":"119-123","refs":["sn14.35:1"],"lines":["Chaṭṭhasattamesu vivaṭṭaṃ, avasāne tīsu catusaccamevāti.","Chaṭṭhādīni."],"lineRefs":[["sn14.35:1"],["sn14.35:1"]]},{"para":614,"vripara":null,"refs":["sn14.35:1"],"lines":["Catuttho vaggo."],"lineRefs":[["sn14.35:1"]]},{"para":615,"vripara":null,"refs":["sn14.35:1"],"lines":["Dhātusaṃyuttavaṇṇanā niṭṭhitā. 4."],"lineRefs":[["sn14.35:1"]]},{"para":616,"vripara":null,"refs":["sn14.35:1"],"lines":["Anamataggasaṃyuttaṃ 1."],"lineRefs":[["sn14.35:1"]]},{"para":617,"vripara":null,"refs":["sn14.35:1"],"lines":["Paṭhamavaggo 1."],"lineRefs":[["sn14.35:1"]]},{"para":618,"vripara":null,"refs":["sn14.35:1"],"lines":["Tiṇakaṭṭhasuttavaṇṇanā 124."],"lineRefs":[["sn14.35:1"]]}],"wordLinks":[],"before":[{"para":612,"vripara":null,"title":"Abhinandasuttādivaṇṇanā","lines":["Abhinandasuttādivaṇ