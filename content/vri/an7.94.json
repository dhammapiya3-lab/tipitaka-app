{"suttaId":"an7.94","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[752,756],"vripara":"94"},"segments":{"an7.94:0.3":"Saddhammasuttaṃ","an7.94:1.1":"“Sattime, bhikkhave, saddhammā.","an7.94:1.2":"Katame satta?","an7.94:1.3":"Saddho hoti, hirīmā hoti, ottappī hoti, bahussuto hoti, āraddhavīriyo hoti, satimā hoti, paññavā hoti.","an7.94:1.4":"Ime kho, bhikkhave, satta saddhammā”ti.","an7.94:1.5":"Dasamaṃ.","an7.94:1.6":"Samaṇavaggo navamo.","an7.94:2.0":"Tassuddānaṃ –","an7.94:2.1":"Bhikkhuṃ samaṇo brāhmaṇo,","an7.94:2.2":"sottiyo ceva nhātako;","an7.94:2.3":"Vedagū ariyo arahā,","an7.94:2.4":"asaddhammā ca saddhammāti."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
