{"suttaId":"tha-ap509","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3109,3126],"vripara":"74"},"segments":{"tha-ap509:0.3":"Ajeliphaladāyakattheraapadānaṃ","tha-ap509:1.1":"“Ajjuno [ajino (syā.)] nāma sambuddho,","tha-ap509:1.2":"himavante vasī tadā;","tha-ap509:1.3":"Caraṇena ca sampanno,","tha-ap509:1.4":"samādhikusalo muni.","tha-ap509:2.1":"“Kumbhamattaṃ gahetvāna,","tha-ap509:2.2":"ajeliṃ [añjaliṃ (syā.), ajelaṃ (pī.)] jīvajīvakaṃ;","tha-ap509:2.3":"Chattapaṇṇaṃ gahetvāna,","tha-ap509:2.4":"adāsiṃ satthuno ahaṃ.","tha-ap509:3.1":"“Catunnavutito kappe,","tha-ap509:3.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap509:3.3":"Duggatiṃ nābhijānāmi,","tha-ap509:3.4":"phaladānassidaṃ phalaṃ.","tha-ap509:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap509:4.3":"viharāmi anāsavo.","tha-ap509:5.1":"“Svāgataṃ vata me āsi … pe …","tha-ap509:5.3":"kataṃ buddhassa sāsanaṃ.","tha-ap509:6.1":"“Paṭisambhidā catasso … pe …","tha-ap509:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap509:7.1":"Itthaṃ sudaṃ āyasmā ajeliphaladāyako thero imā Gāthāyo abhāsitthāti.","tha-ap509:8.1":"Ajeliphaladāyakattherassāpadānaṃ sattamaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
