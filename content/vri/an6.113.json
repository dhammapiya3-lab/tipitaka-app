{"suttaId":"an6.113","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[828,828],"vripara":"113"},"segments":{"an6.113:0.3":"Aratisuttaṃ","an6.113:1.1":"“Tayome, bhikkhave, dhammā.","an6.113:1.2":"Katame tayo?","an6.113:1.3":"Arati, vihiṃsā [vihesā (ka.)], adhammacariyā.","an6.113:1.4":"Ime kho, bhikkhave, tayo dhammā.","an6.113:1.5":"Imesaṃ kho, bhikkhave, tiṇṇaṃ dhammānaṃ pahānāya tayo dhammā bhāvetabbā.","an6.113:1.6":"Katame tayo?","an6.113:1.7":"Aratiyā pahānāya muditā bhāvetabbā, vihiṃsāya pahānāya avihiṃsā bhāvetabbā, adhammacariyāya pahānāya dhammacariyā bhāvetabbā.","an6.113:1.8":"Imesaṃ kho, bhikkhave, tiṇṇaṃ dhammānaṃ pahānāya ime tayo dhammā bhāvetabbā”ti.","an6.113:1.9":"Sattamaṃ."},"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":780,"to":780,"paras":[{"para":780,"vripara":"113","refs":["an6.113:1"],"lines":["Sattame <b>adhammacariyā</b>ti dasa akusalakammapathā."],"lineRefs":[["an6.113:1"]]}],"wordLinks":[["an6.113:1.3","adhammacariyā",0,0],["an6.113:1.7","adhammacariyā",0,0]],"before":[{"para":779,"vripara":null,"refs":[],"lines":["Aratisuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":788,"to":788,"paras":[{"para":788,"vripara":"107-116","refs":["an6.113:1"],"lines":["107-116. Ekādasamavaggo uttānatthoyeva."],"lineRefs":[["an6.113:1"]]}],"wordLinks":[]},"tika2":null}
