{"suttaId":"tha-ap469","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1402,1425],"vripara":"32"},"segments":{"tha-ap469:0.3":"Labujaphaladāyakattheraapadānaṃ","tha-ap469:1.1":"“Nagare bandhumatiyā,","tha-ap469:1.2":"ārāmiko ahaṃ tadā;","tha-ap469:1.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap469:1.4":"gacchantaṃ anilañjase. 33.","tha-ap469:2.1":"“Labujaṃ phalamādāya,","tha-ap469:2.2":"buddhaseṭṭhassadāsahaṃ;","tha-ap469:2.3":"Ākāseva ṭhito santo,","tha-ap469:2.4":"paṭiggaṇhi mahāyaso. 34.","tha-ap469:3.1":"“Vittisañjanano mayhaṃ,","tha-ap469:3.2":"diṭṭhadhammasukhāvaho;","tha-ap469:3.3":"Phalaṃ buddhassa datvāna,","tha-ap469:3.4":"vippasannena cetasā. 35.","tha-ap469:4.1":"“Adhigañchiṃ tadā pītiṃ,","tha-ap469:4.2":"vipulaṃ sukhamuttamaṃ;","tha-ap469:4.3":"Uppajjateva [uppajjate me (syā.)] ratanaṃ,","tha-ap469:4.4":"nibbattassa tahiṃ tahiṃ. 36.","tha-ap469:5.1":"“Ekanavutito kappe,","tha-ap469:5.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap469:5.3":"Duggatiṃ nābhijānāmi,","tha-ap469:5.4":"phaladānassidaṃ phalaṃ. 37.","tha-ap469:6.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap469:6.3":"viharāmi anāsavo. 38.","tha-ap469:7.1":"“Svāgataṃ vata me āsi…pe…","tha-ap469:7.3":"kataṃ buddhassa sāsanaṃ. 39.","tha-ap469:8.1":"“Paṭisambhidā catasso…pe…","tha-ap469:8.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap469:9.1":"Itthaṃ sudaṃ āyasmā labujaphaladāyako thero imā Gāthāyo abhāsitthāti.","tha-ap469:10.1":"Labujaphaladāyakattherassāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
