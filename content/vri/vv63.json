{"suttaId":"vv63","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2345,2447],"vripara":"981"},"segments":{"vv63:0.4":"Cūḷarathavimānavatthu","vv63:1.1":"“Daḷhadhammā nisārassa,","vv63:1.2":"dhanuṃ olubbha tiṭṭhasi;","vv63:1.3":"Khattiyo nusi rājañño,","vv63:1.4":"adu luddo vanecaro”ti [vanācaroti (syā. ka.)]. 982.","vv63:2.1":"“Assakādhipatissāhaṃ,","vv63:2.2":"bhante putto vanecaro;","vv63:2.3":"Nāmaṃ me bhikkhu te brūmi,","vv63:2.4":"sujāto iti maṃ vidū [viduṃ (sī.)]. 983.","vv63:3.1":"“Mige gavesamānohaṃ,","vv63:3.2":"ogāhanto brahāvanaṃ;","vv63:3.3":"Migaṃ tañceva [migaṃ gantveva (syā.), migavadhañca (ka.)] nāddakkhiṃ,","vv63:3.4":"tañca disvā ṭhito aha”nti. 984.","vv63:4.1":"“Svāgataṃ te mahāpuñña,","vv63:4.2":"atho te adurāgataṃ;","vv63:4.3":"Etto udakamādāya,","vv63:4.4":"pāde pakkhālayassu te. 985.","vv63:5.1":"“Idampi pānīyaṃ sītaṃ,","vv63:5.2":"ābhataṃ girigabbharā;","vv63:5.3":"Rājaputta tato pitvā [pītvā (sī. syā.)],","vv63:5.4":"santhatasmiṃ upāvisā”ti. 986.","vv63:6.1":"“Kalyāṇī vata te vācā,","vv63:6.2":"savanīyā mahāmuni;","vv63:6.3":"Nelā atthavatī [catthavatī (sī.)] vaggu,","vv63:6.4":"mantvā [mantā (syā. pī. ka.)] atthañca bhāsasi [bhāsase (sī.)]. 987.","vv63:7.1":"“Kā te rati vane viharato,","vv63:7.2":"isinisabha vadehi puṭṭho;","vv63:7.3":"Tava vacanapathaṃ nisāmayitvā,","vv63:7.4":"atthadhammapadaṃ samācaremase”ti. 988.","vv63:8.1":"“Ahiṃsā sabbapāṇīnaṃ,","vv63:8.2":"kumāramhāka ruccati;","vv63:8.3":"Theyyā ca aticārā ca,","vv63:8.4":"majjapānā ca ārati. 989.","vv63:9.1":"“Ārati samacariyā ca,","vv63:9.2":"bāhusaccaṃ kataññutā;","vv63:9.3":"Diṭṭheva dhamme pāsaṃsā,","vv63:9.4":"dhammā ete pasaṃsiyāti. 990.","vv63:10.1":"“Santike maraṇaṃ tuyhaṃ,","vv63:10.2":"oraṃ māsehi pañcahi;","vv63:10.3":"Rājaputta vijānāhi,","vv63:10.4":"attānaṃ parimocayā”ti. 991.","vv63:11.1":"“Katamaṃ svāhaṃ janapadaṃ gantvā,","vv63:11.2":"kiṃ kammaṃ kiñca porisaṃ;","vv63:11.3":"Kāya vā pana vijjāya,","vv63:11.4":"bhaveyyaṃ ajarāmaro”ti. 992.","vv63:12.1":"“Na vijjate so padeso,","vv63:12.2":"kammaṃ vijjā ca porisaṃ;","vv63:12.3":"Yattha gantvā bhave macco,","vv63:12.4":"rājaputtājarāmaro. 993.","vv63:13.1":"“Mahaddhanā mahābhogā,","vv63:13.2":"raṭṭhavantopi khattiyā;","vv63:13.3":"Pahūtadhanadhaññāse,","vv63:13.4":"tepi no [tepi na (bahūsu)] ajarāmarā. 994.","vv63:14.1":"“Yadi te sutā andhakaveṇḍuputtā [andhakaveṇhuputtā (sī.), aṇḍakaveṇḍaputtā (syā. ka.)],","vv63:14.2":"sūrā vīrā vikkantappahārino;","vv63:14.3":"Tepi āyukkhayaṃ pattā,","vv63:14.4":"viddhastā sassatīsamā. 995.","vv63:15.1":"“Khattiyā brāhmaṇā vessā,","vv63:15.2":"suddā caṇḍālapukkusā;","vv63:15.3":"Ete caññe ca jātiyā,","vv63:15.4":"tepi no ajarāmarā. 996.","vv63:16.1":"“Ye mantaṃ parivattenti,","vv63:16.2":"chaḷaṅgaṃ brahmacintitaṃ;","vv63:16.3":"Ete caññe ca vijjāya,","vv63:16.4":"tepi no ajarāmarā. 997.","vv63:17.1":"“Isayo cāpi ye santā,","vv63:17.2":"saññatattā tapassino;","vv63:17.3":"Sarīraṃ tepi kālena,","vv63:17.4":"vijahanti tapassino. 998.","vv63:18.1":"“Bhāvitattāpi arahanto,","vv63:18.2":"katakiccā anāsavā;","vv63:18.3":"Nikkhipanti imaṃ dehaṃ,","vv63:18.4":"puññapāpaparikkhayā”ti. 999.","vv63:19.1":"“Subhāsitā atthavatī,","vv63:19.2":"gāthāyo te mahāmuni;","vv63:19.3":"Nijjhattomhi subhaṭṭhena,","vv63:19.4":"tvañca me saraṇaṃ bhavā”ti. 1000.","vv63:20.1":"“Mā maṃ tvaṃ saraṇaṃ gaccha,","vv63:20.2":"tameva saraṇaṃ vaja [bhaja (ka.)];","vv63:20.3":"Sakyaputtaṃ mahāvīraṃ,","vv63:20.4":"yamahaṃ saraṇaṃ gato”ti. 1001.","vv63:21.1":"“Katarasmiṃ so janapade,","vv63:21.2":"satthā tumhāka mārisa;","vv63:21.3":"Ahampi daṭṭhuṃ gacchissaṃ,","vv63:21.4":"jinaṃ appaṭipuggala”nti. 1002.","vv63:22.1":"“Puratthimasmiṃ janapade,","vv63:22.2":"okkākakulasambhavo;","vv63:22.3":"Tatthāsi purisājañño,","vv63:22.4":"so ca kho parinibbuto”ti. 1003.","vv63:23.1":"“Sace hi buddho tiṭṭheyya,","vv63:23.2":"satthā tumhāka mārisa;","vv63:23.3":"Yojanāni sahassāni,","vv63:23.4":"gaccheyyaṃ [gacche (syā. pī. ka.)] payirupāsituṃ. 1004.","vv63:24.1":"“Yato ca kho [yatā kho (pī. ka.)] parinibbuto,","vv63:24.2":"satthā tumhāka mārisa;","vv63:24.3":"Nibbutampi [parinibbutaṃ (syā. ka.)] mahāvīraṃ,","vv63:24.4":"gacchāmi saraṇaṃ ahaṃ. 1005.","vv63:25.1":"“Upemi saraṇaṃ buddhaṃ,","vv63:25.2":"dhammañcāpi anuttaraṃ;","vv63:25.3":"Saṅghañca naradevassa,","vv63:25.4":"gacchāmi saraṇaṃ ahaṃ. 1006.","vv63:26.1":"“Pāṇātipātā viramāmi khippaṃ,","vv63:26.2":"loke adinnaṃ parivajjayāmi;","vv63:26.3":"Amajjapo no ca musā bhaṇāmi,","vv63:26.4":"sakena dārena ca homi tuṭṭho”ti. 1007.","vv63:27.1":"“Sahassaraṃsīva yathā mahappabho,","vv63:27.2":"disaṃ yathā bhāti nabhe anukkamaṃ;","vv63:27.3":"Tathāpakāro [tathappakāro (sī. syā.)] tavāyaṃ [tavayaṃ (sī. pī.)] mahāratho,","vv63:27.4":"samantato yojanasattamāyato. 1008.","vv63:28.1":"“Suvaṇṇapaṭṭehi samantamotthaṭo,","vv63:28.2":"urassa muttāhi maṇīhi cittito;","vv63:28.3":"Lekhā suvaṇṇassa ca rūpiyassa ca,","vv63:28.4":"sobhenti veḷuriyamayā sunimmitā. 1009.","vv63:29.1":"“Sīsañcidaṃ veḷuriyassa nimmitaṃ,","vv63:29.2":"yugañcidaṃ lohitakāya cittitaṃ;","vv63:29.3":"Yuttā suvaṇṇassa ca rūpiyassa ca,","vv63:29.4":"sobhanti assā ca ime manojavā. 1010.","vv63:30.1":"“So tiṭṭhasi hemarathe adhiṭṭhito,","vv63:30.2":"devānamindova sahassavāhano;","vv63:30.3":"Pucchāmi tāhaṃ yasavanta kovidaṃ [kovida (ka.)],","vv63:30.4":"kathaṃ tayā laddho ayaṃ uḷāro”ti. 1011.","vv63:31.1":"“Sujāto nāmahaṃ bhante,","vv63:31.2":"rājaputto pure ahuṃ;","vv63:31.3":"Tvañca maṃ anukampāya,","vv63:31.4":"saññamasmiṃ nivesayi. 1012.","vv63:32.1":"“Khīṇāyukañca maṃ ñatvā,","vv63:32.2":"sarīraṃ pādāsi satthuno;","vv63:32.3":"Imaṃ sujāta pūjehi,","vv63:32.4":"taṃ te atthāya hehiti. 1013.","vv63:33.1":"“Tāhaṃ gandhehi mālehi,","vv63:33.2":"pūjayitvā samuyyuto;","vv63:33.3":"Pahāya mānusaṃ dehaṃ,","vv63:33.4":"upapannomhi nandanaṃ. 1014.","vv63:34.1":"“Nandane ca vane [nandanopavane (sī.), nandane pavane (syā. ka.)] ramme,","vv63:34.2":"nānādijagaṇāyute;","vv63:34.3":"Ramāmi naccagītehi,","vv63:34.4":"accharāhi purakkhato”ti.","vv63:35.1":"Cūḷarathavimānaṃ terasamaṃ. 14."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2775,"to":2911,"paras":[{"para":2775,"vripara":null,"refs":["vv63:1"],"lines":["Pucchi.","Tattha <b>daḷhadhammā</b>ti daḷhadhanu.","Daḷhadhanu nāma dvisahassathāmaṃ vuccati.","Dvisahassathāmanti ca yassa āropitassa jiyāya baddho lohasīsādīnaṃ bhāro daṇḍe gahetvā yāva kaṇḍappamāṇā ukkhittassa pathavito muccati.","<b>Nisārassā</b>ti niratisayasārassa visiṭṭhasārassa rukkhassa dhanuṃ, sāratararukkhamayaṃ dhanunti attho.","<b>Olubbhā</b>ti sannirumbhitvā.","<b>Rājañño</b>ti rājakumāro.","<b>Vanecaro</b>ti vanacaro."],"lineRefs":[["vv63:1"],["vv63:1"],["vv63:1"],["vv63:1"],["vv63:1"],["vv63:1"],["vv63:1"],["vv63:1"]]},{"para":2776,"vripara":null,"refs":["vv63:1"],"lines":["Atha so attānaṃ āvikaronto – 982."],"lineRefs":[["vv63:1"]]},{"para":2778,"vripara":"982","refs":["vv63:1"],"lines":["“Assakādhipatissāhaṃ, bhante putto vanecaro;"],"lineRefs":[["vv63:1"]]},{"para":2779,"vripara":null,"refs":["vv63:1"],"lines":["Nāmaṃ me bhikkhu te brūmi, sujāto iti maṃ vidū. 983."],"lineRefs":[["vv63:1"]]},{"para":2781,"vripara":"983","refs":["vv63:1"],"lines":["“Mige gavesamānohaṃ, ogāhanto brahāvanaṃ;"],"lineRefs":[["vv63:1"]]},{"para":2782,"vripara":null,"refs":["vv63:1"],"lines":["Migaṃ tañceva nāddakkhiṃ, tañca disvā ṭhito aha”nti. –"],"lineRefs":[["vv63:1"]]},{"para":2783,"vripara":null,"refs":["vv63:1","vv63:3"],"lines":["Āha.","Tattha <b>assakādhipatissā</b>ti assakaraṭṭhādhipatino assakarājassa.","<b>Bhikkhū</b>ti theraṃ ālapati.","<b>Mige gavesamāno</b>ti migasūkarādike gavesanto, migavaṃ carantoti attho."],"lineRefs":[["vv63:1"],["vv63:1"],["vv63:1"],["vv63:3"]]},{"para":2784,"vripara":null,"refs":["vv63:3"],"lines":["Taṃ sutvā thero tena saddhiṃ paṭisanthāraṃ karonto – 984."],"lineRefs":[["vv63:3"]]},{"para":2786,"vripara":"984","refs":["vv63:3"],"lines":["“Svāgataṃ te mahāpuñña, atho te adurāgataṃ;"],"lineRefs":[["vv63:3"]]},{"para":2787,"vripara":null,"refs":["vv63:3"],"lines":["Etto udakamādāya, pāde pakkhālayassu te. 985."],"lineRefs":[["vv63:3"]]},{"para":2789,"vripara":"985","refs":["vv63:3"],"lines":["“Idampi pānīyaṃ sītaṃ, ābhataṃ girigabbharā;"],"lineRefs":[["vv63:3"]]},{"para":2790,"vripara":null,"refs":["vv63:3"],"lines":["Rājaputta tato pitvā, santhatasmiṃ upāvisā”ti. –","āha; 984."],"lineRefs":[["vv63:3"],["vv63:3"]]},{"para":2791,"vripara":"984","refs":["vv63:4"],"lines":["Tattha <b>adurāgata</b>nti durāgamanavajjitaṃ, mahāpuñña, te idhāgamanaṃ svāgataṃ, na te appakampi durāgamanaṃ atthi tuyhañca mayhañca pītisomanassajananatoti adhippāyo.","“Adhunāgata”ntipi pāṭho, idāni āgamananti attho. 985."],"lineRefs":[["vv63:4"],["vv63:4"]]},{"para":2792,"vripara":"985","refs":["vv63:5"],"lines":["<b>Santhatasmiṃ upāvisā</b>ti anantarahitāya bhūmiyā anisīditvā amukasmiṃ tiṇasanthārake nisīdāti."],"lineRefs":[["vv63:5"]]},{"para":2793,"vripara":null,"refs":["vv63:5"],"lines":["Tato rājakumāro therassa paṭisanthāraṃ sampaṭicchanto āha – 986."],"lineRefs":[["vv63:5"]]},{"para":2795,"vripara":"986","refs":["vv63:5"],"lines":["“Kalyāṇī vata te vācā, savanīyā mahāmuni;"],"lineRefs":[["vv63:5"]]},{"para":2796,"vripara":null,"refs":["vv63:5"],"lines":["Nelā atthavatī vaggu, mantvā atthañca bhāsasi. 987."],"lineRefs":[["vv63:5"]]},{"para":2798,"vripara":"987","refs":["vv63:5"],"lines":["“Kā te rati vane viharato, isinisabha vadehi puṭṭho;"],"lineRefs":[["vv63:5"]]},{"para":2799,"vripara":null,"refs":["vv63:5"],"lines":["Tava vacanapathaṃ nisāmayitvā, atthadhammapadaṃ samācaremase”ti. 986."],"lineRefs":[["vv63:5"]]},{"para":2800,"vripara":"986","refs":["vv63:6"],"lines":["Tattha <b>kalyāṇī</b>ti sundarā sobhanā.","<b>Savanīyā</b>ti sotuṃ yuttā.","<b>Nelā</b>ti niddosā.","<b>Atthavatī</b>ti atthayuttā diṭṭhadhammikādinā hitena upetā.","<b>Vaggū</b>ti madhurā.","<b>Mantvā</b>ti jānitvā paññāya paricchinditvā.","<b>Attha</b>nti atthato anapetaṃ ekantahitāvahaṃ. 987."],"lineRefs":[["vv63:6"],["vv63:6"],["vv63:6"],["vv63:6"],["vv63:6"],["vv63:6"],["vv63:6"]]},{"para":2801,"vripara":"987","refs":["vv63:7"],"lines":["<b>Isinisabhā</b>ti isīsu nisabha ājānīyasadisa.","<b>Vacanapatha</b>nti vacanaṃ.","Vacanameva hi atthādhigamassa upāyabhāvato “vacanapatha”nti vuttaṃ.","<b>Atthadhammapadaṃ</b> <b>samācaremase</b>ti idha ceva samparāye ca atthāvahaṃ sīlādidhammakoṭṭhāsaṃ paṭipajjāmase."],"lineRefs":[["vv63:7"],["vv63:7"],["vv63:7"],["vv63:7"]]},{"para":2802,"vripara":null,"refs":["vv63:7"],"lines":["Idāni thero attano sammāpaṭipattiṃ tassa anucchavikaṃ vadanto – 988."],"lineRefs":[["vv63:7"]]},{"para":2804,"vripara":"988","refs":["vv63:7"],"lines":["“Ahiṃsā sabbapāṇīnaṃ, kumāramhāka ruccati;"],"lineRefs":[["vv63:7"]]},{"para":2805,"vripara":null,"refs":["vv63:7"],"lines":["Theyyā ca aticārā ca, majjapānā ca ārati. 989."],"lineRefs":[["vv63:7"]]},{"para":2807,"vripara":"989","refs":["vv63:7"],"lines":["“Ārati samacariyā ca, bāhusaccaṃ kataññutā;"],"lineRefs":[["vv63:7"]]},{"para":2808,"vripara":null,"refs":["vv63:7"],"lines":["Diṭṭheva dhamme pāsaṃsā, dhammā ete pasaṃsiyā”ti. –","āha; 989."],"lineRefs":[["vv63:7"],["vv63:7"]]},{"para":2809,"vripara":"989","refs":["vv63:9"],"lines":["Tattha <b>ārati samacariyā cā</b>ti yathāvuttā ca pāpadhammato ārati, paṭivirati kāyasamatādisamacariyā ca.","<b>Bāhusacca</b>nti pariyattibāhusaccaṃ.","<b>Kataññutā</b>ti parehi attano katassa upakārassa jānanā.","<b>Pāsaṃsā</b>ti atthakāmehi kulaputtehi pakārato āsaṃsitabbā.","<b>Dhammā ete</b>ti ete yathāvuttā ahiṃsādidhammā.","<b>Pasaṃsiyā</b>ti viññūhi pasaṃsitabbā."],"lineRefs":[["vv63:9"],["vv63:9"],["vv63:9"],["vv63:9"],["vv63:9"],["vv63:9"]]},{"para":2810,"vripara":null,"refs":["vv63:9"],"lines":["Evaṃ thero tassa anucchavikaṃ sammāpaṭipattiṃ vatvā anāgataṃsañāṇena āyusaṅkhāre olokento “pañcamāsamattamevā”ti disvā taṃ saṃvejetvā daḷhaṃ tattha sammāpaṭipattiyaṃ patiṭṭhāpetuṃ imaṃ gāthamāha – 990."],"lineRefs":[["vv63:9"]]},{"para":2812,"vripara":"990","refs":["vv63:9"],"lines":["“Santike maraṇaṃ tuyhaṃ, oraṃ māsehi pañcahi;"],"lineRefs":[["vv63:9"]]},{"para":2813,"vripara":null,"refs":["vv63:9"],"lines":["Rājaputta vijānāhi, attānaṃ parimocayā”ti."],"lineRefs":[["vv63:9"]]},{"para":2814,"vripara":null,"refs":["vv63:10"],"lines":["Tattha <b>attānaṃ parimocayā</b>ti attānaṃ apāyadukkhato mocehi."],"lineRefs":[["vv63:10"]]},{"para":2815,"vripara":null,"refs":["vv63:10"],"lines":["Tato kumāro attano muttiyā upāyaṃ pucchanto āha – 991."],"lineRefs":[["vv63:10"]]},{"para":2817,"vripara":"991","refs":["vv63:10"],"lines":["“Katamaṃ svāhaṃ janapadaṃ gantvā, kiṃ kammaṃ kiñca porisaṃ;"],"lineRefs":[["vv63:10"]]},{"para":2818,"vripara":null,"refs":["vv63:10"],"lines":["Kāya vā pana vijjāya, bhaveyyaṃ ajarāmaro”ti."],"lineRefs":[["vv63:10"]]},{"para":2819,"vripara":null,"refs":["vv63:11"],"lines":["Tattha <b>katamaṃ svāha</b>nti katamaṃ su ahaṃ, katamaṃ nūti attho.","<b>Kiṃ kammaṃ kiñca porisa</b>nti katvāti vacanaseso.","<b>Porisa</b>nti purisakiccaṃ."],"lineRefs":[["vv63:11"],["vv63:11"],["vv63:11"]]},{"para":2820,"vripara":null,"refs":["vv63:11"],"lines":["Tato thero tassa dhammaṃ desetuṃ imā gāthāyo avoca – 992."],"lineRefs":[["vv63:11"]]},{"para":2822,"vripara":"992","refs":["vv63:11"],"lines":["“Na vijjate so padeso, kammaṃ vijjā ca porisaṃ;"],"lineRefs":[["vv63:11"]]},{"para":2823,"vripara":null,"refs":["vv63:11"],"lines":["Yattha gantvā bhave macco, rājaputtājarāmaro. 993."],"lineRefs":[["vv63:11"]]},{"para":2825,"vripara":"993","refs":["vv63:11"],"lines":["“Mahaddhanā mahābhogā, raṭṭhavantopi khattiyā;"],"lineRefs":[["vv63:11"]]},{"para":2826,"vripara":null,"refs":["vv63:11"],"lines":["Pahūtadhanadhaññāse, tepi no ajarāmarā. 994."],"lineRefs":[["vv63:11"]]},{"para":2828,"vripara":"994","refs":["vv63:11"],"lines":["“Yadi te sutā andhakaveṇḍuputtā, sūrā vīrā vikkantappahārino;"],"lineRefs":[["vv63:11"]]},{"para":2829,"vripara":null,"refs":["vv63:11"],"lines":["Tepi āyukkhayaṃ pattā, viddhastā sassatīsamā. 995."],"lineRefs":[["vv63:11"]]},{"para":2831,"vripara":"995","refs":["vv63:11"],"lines":["“Khattiyā brāhmaṇā vessā, suddā caṇḍālapukkusā;"],"lineRefs":[["vv63:11"]]},{"para":2832,"vripara":null,"refs":["vv63:11"],"lines":["Ete caññe ca jātiyā, tepi no ajarāmarā. 996."],"lineRefs":[["vv63:11"]]},{"para":2834,"vripara":"996","refs":["vv63:11"],"lines":["“Ye mantaṃ parivattenti, chaḷaṅgaṃ brahmacintitaṃ;"],"lineRefs":[["vv63:11"]]},{"para":2835,"vripara":null,"refs":["vv63:11"],"lines":["Ete caññe ca vijjāya, tepi no ajarāmarā. 997."],"lineRefs":[["vv63:11"]]},{"para":2837,"vripara":"997","refs":["vv63:11"],"lines":["“Isayo cāpi ye santā, saññatattā tapassino;"],"lineRefs":[["vv63:11"]]},{"para":2838,"vripara":null,"refs":["vv63:11"],"lines":["Sarīraṃ tepi kālena, vijahanti tapassino. 998."],"lineRefs":[["vv63:11"]]},{"para":2840,"vripara":"998","refs":["vv63:11"],"lines":["“Bhāvitattāpi arahanto, katakiccā anāsavā;"],"lineRefs":[["vv63:11"]]},{"para":2841,"vripara":null,"refs":["vv63:11"],"lines":["Nikkhipanti imaṃ dehaṃ, puññapāpaparikkhayā”ti. 992."],"lineRefs":[["vv63:11"]]},{"para":2842,"vripara":"992","refs":["vv63:12"],"lines":["Tattha <b>yattha gantvā</b>ti yaṃ padesaṃ gantvā kammaṃ vijjaṃ porisañca kāyapayogena itarapayogena ca upagantvā pāpuṇitvā bhaveyya ajarāmaroti attho. 993."],"lineRefs":[["vv63:12"]]},{"para":2843,"vripara":"993","refs":["vv63:13"],"lines":["Heṭṭhimakoṭiyā koṭisatādiparimāṇaṃ saṃharitvā ṭhapitaṃ mahantaṃ dhanaṃ etesanti <b>mahaddhanā</b>.","Kumbhattayādikahāpaṇaparibbayo mahanto bhogo etesanti <b>mahābhogā.</b>","<b>Raṭṭhavanto</b>ti raṭṭhasāmikā, anekayojanaparimāṇaṃ raṭṭhaṃ pasāsantāti adhippāyo.","<b>Khattiyā</b>ti khattiyajātikā.","<b>Pahūtadhanadhaññāse</b>ti mahādhanadhaññasannicayā, attano parisāya ca sattaṭṭhasaṃvaccharapahonakadhanadhaññasannicayā.","<b>Tepi no ajarāmarā</b>ti jarāmaraṇadhammā eva, mahaddhanatādīnipi tesaṃ upari nipatantaṃ jarāmaraṇaṃ nivattetuṃ na sakkontīti attho. 994."],"lineRefs":[["vv63:13"],["vv63:13"],["vv63:13"],["vv63:13"],["vv63:13"],["vv63:13"]]},{"para":2844,"vripara":"994","refs":["vv63:14"],"lines":["<b>Andhakaveṇḍuputtā</b>ti andhakaveṇḍussa puttāti paññātā.","<b>Sūrā</b>ti sattimanto.","<b>Vīrā</b>ti vīriyavanto.","<b>Vikkantappahārino</b>ti sūravīrabhāveneva paṭisattubalaṃ vikkamma pasayha paharaṇasīlā.","<b>Viddhastā</b>ti vinaṭṭhā.","<b>Sassatīsamā</b>ti kulaparamparāya sassatīhi candasūriyādīhi samānā, tepi acirakālapavattakulanvayāti attho. 995."],"lineRefs":[["vv63:14"],["vv63:14"],["vv63:14"],["vv63:14"],["vv63:14"],["vv63:14"]]},{"para":2845,"vripara":"995","refs":["vv63:15"],"lines":["<b>Jātiyā</b>ti attano jātiyā, visiṭṭhatarā pana jātipi nesaṃ jarāmaraṇaṃ nivattetuṃ na sakkotīti attho. 996."],"lineRefs":[["vv63:15"]]},{"para":2846,"vripara":"996","refs":["vv63:16"],"lines":["<b>Manta</b>nti vedaṃ.","<b>Chaḷaṅga</b>nti kappabyākaraṇaniruttisikkhāchandovicitijotisatthasaṅkhātehi chahi aṅgehi chaḷaṅgaṃ.","<b>Brahmacintita</b>nti brahmehi aṭṭhakādīhi cintitaṃ paññācakkhunā diṭṭhaṃ. 997."],"lineRefs":[["vv63:16"],["vv63:16"],["vv63:16"]]},{"para":2847,"vripara":"997","refs":["vv63:17"],"lines":["<b>Santā</b>ti upasantakāyavacīkammantā.","<b>Saññatattā</b>ti saññatacittā.","<b>Tapassino</b>ti tapanissitā."],"lineRefs":[["vv63:17"],["vv63:17"],["vv63:17"]]},{"para":2848,"vripara":null,"refs":["vv63:17"],"lines":["Idāni kumāro attanā kattabbaṃ vadanto – 999."],"lineRefs":[["vv63:17"]]},{"para":2850,"vripara":"999","refs":["vv63:17"],"lines":["“Subhāsitā atthavatī, gāthāyo te mahāmuni;"],"lineRefs":[["vv63:17"]]},{"para":2851,"vripara":null,"refs":["vv63:17"],"lines":["Nijjhattomhi subhaṭṭhena, tvañca me saraṇaṃ bhavā”ti. –"],"lineRefs":[["vv63:17"]]},{"para":2852,"vripara":null,"refs":["vv63:17","vv63:19"],"lines":["Āha.","Tattha <b>nijjhattomhī</b>ti nijjhāpito dhammojasaññāya saññattigato amhi.","<b>Subhaṭṭhenā</b>ti suṭṭhu bhāsitena."],"lineRefs":[["vv63:17"],["vv63:19"],["vv63:19"]]},{"para":2853,"vripara":null,"refs":["vv63:19"],"lines":["Tato thero taṃ anusāsanto imaṃ gāthaṃ abhāsi – 1000."],"lineRefs":[["vv63:19"]]},{"para":2855,"vripara":"1000","refs":["vv63:19"],"lines":["“Mā maṃ tvaṃ saraṇaṃ gaccha, tameva saraṇaṃ vaja;"],"lineRefs":[["vv63:19"]]},{"para":2856,"vripara":null,"refs":["vv63:19"],"lines":["Sakyaputtaṃ mahāvīraṃ, yamahaṃ saraṇaṃ gato”ti."],"lineRefs":[["vv63:19"]]},{"para":2857,"vripara":null,"refs":["vv63:19"],"lines":["Tato rājakumāro āha – 1001."],"lineRefs":[["vv63:19"]]},{"para":2859,"vripara":"1001","refs":["vv63:19"],"lines":["“Katarasmiṃ so janapade, satthā tumhāka mārisa;"],"lineRefs":[["vv63:19"]]},{"para":2860,"vripara":null,"refs":["vv63:19"],"lines":["Ahampi daṭṭhuṃ gacchissaṃ, jinaṃ appaṭipuggala”nti."],"lineRefs":[["vv63:19"]]},{"para":2861,"vripara":null,"refs":["vv63:19"],"lines":["Puna thero āha – 1002."],"lineRefs":[["vv63:19"]]},{"para":2863,"vripara":"1002","refs":["vv63:19"],"lines":["“Puratthimasmiṃ janapade, okkākakulasambhavo;"],"lineRefs":[["vv63:19"]]},{"para":2864,"vripara":null,"refs":["vv63:19"],"lines":["Tatthāsi purisājañño, so ca kho parinibbuto”ti."],"lineRefs":[["vv63:19"]]},{"para":2865,"vripara":null,"refs":["vv63:22"],"lines":["Tattha therena nisinnapadesato majjhimadesassa pācīnadisābhāgattā vuttaṃ <b>“puratthimasmiṃ janapade”</b>ti."],"lineRefs":[["vv63:22"]]},{"para":2866,"vripara":null,"refs":["vv63:22"],"lines":["Evaṃ so rājaputto therassa dhammadesanaṃ sutvā pasannamānaso saraṇesu ca sīlesu ca patiṭṭhahi.","Tena vuttaṃ – 1003."],"lineRefs":[["vv63:22"],["vv63:22"]]},{"para":2868,"vripara":"1003","refs":["vv63:22"],"lines":["“Sace hi buddho tiṭṭheyya, satthā tumhāka mārisa;"],"lineRefs":[["vv63:22"]]},{"para":2869,"vripara":null,"refs":["vv63:22"],"lines":["Yojanāni sahassāni, gaccheyyaṃ payirupāsituṃ. 1004."],"lineRefs":[["vv63:22"]]},{"para":2871,"vripara":"1004","refs":["vv63:22"],"lines":["“Yato ca kho parinibbuto, satthā tumhāka mārisa;"],"lineRefs":[["vv63:22"]]},{"para":2872,"vripara":null,"refs":["vv63:22"],"lines":["Nibbutampi mahāvīraṃ, gacchāmi saraṇaṃ ahaṃ. 1005."],"lineRefs":[["vv63:22"]]},{"para":2874,"vripara":"1005","refs":["vv63:22"],"lines":["“Upemi saraṇaṃ buddhaṃ, dhammañcāpi anuttaraṃ;"],"lineRefs":[["vv63:22"]]},{"para":2875,"vripara":null,"refs":["vv63:22"],"lines":["Saṅghañca naradevassa, gacchāmi saraṇaṃ ahaṃ. 1006."],"lineRefs":[["vv63:22"]]},{"para":2877,"vripara":"1006","refs":["vv63:22"],"lines":["“Pāṇātipātā viramāmi khippaṃ, loke adinnaṃ parivajjayāmi;"],"lineRefs":[["vv63:22"]]},{"para":2878,"vripara":null,"refs":["vv63:22"],"lines":["Amajjapo no ca musā bhaṇāmi, sakena dārena ca homi tuṭṭho”ti."],"lineRefs":[["vv63:22"]]},{"para":2879,"vripara":null,"refs":["vv63:22"],"lines":["Evaṃ pana taṃ saraṇesu ca sīlesu ca patiṭṭhitaṃ thero evamāha “rājakumāra, tuyhaṃ idha araññavāsena attho natthi, na ciraṃ tava jīvitaṃ, pañcamāsabbhantare eva kālaṃ karissasi, tasmā tava pitu santikameva gantvā dānādīni puññāni katvā saggaparāyaṇo bhaveyyāsī”ti vatvā attano santike dhātuyo datvā vissajjesi.","So gacchanto “ahaṃ, bhante, tumhākaṃ vacanena ito gamissāmi, tumhehipi mayhaṃ anukampāya tattha āgantabba”nti vatvā therassa adhivāsanaṃ viditvā vanditvā padakkhiṇaṃ katvā pitu nagaraṃ gantvā uyyānaṃ pavisitvā attano āgatabhāvaṃ rañño nivedesi."],"lineRefs":[["vv63:22"],["vv63:22"]]},{"para":2880,"vripara":null,"refs":["vv63:22"],"lines":["Taṃ sutvā rājā saparivāro uyyānaṃ gantvā kumāraṃ āliṅgitvā antepuraṃ netvā abhisiñcitukāmo ahosi.","Kumāro “deva, mayhaṃ appakaṃ āyu, ito catunnaṃ māsānaṃ accayena maraṇaṃ bhavissati, kiṃ me rajjena, tumhe nissāya puññameva karissāmī”ti vatvā therassa guṇaṃ ratanattayassa ca ānubhāvaṃ pavedesi.","Taṃ sutvā rājā saṃvegappatto ratanattaye ca there ca pasannamānaso mahantaṃ vihāraṃ kāretvā mahākaccāyanattherassa santike dūtaṃ pāhesi.","Theropi rājānaṃ mahājanañca anuggaṇhanto āgacchi.","Rājā ca saparivāro dūratova paccuggamanaṃ katvā theraṃ vihāraṃ pavesetvā catūhi paccayehi sakkaccaṃ upaṭṭhahanto saraṇesu ca sīlesu ca patiṭṭhahi.","Kumāro ca sīlāni samādiyitvā theraṃ bhikkhū ceva sakkaccaṃ upaṭṭhahanto dānāni dadanto dhammaṃ suṇanto catunnaṃ māsānaṃ accayena kālaṃ katvā tāvatiṃsabhavane nibbatti.","Tassa puññānubhāvena sattaratanapaṭimaṇḍito sattayojanappamāṇo ratho uppajji, anekāni cassa accharāsahassāni parivāro ahosi."],"lineRefs":[["vv63:22"],["vv63:22"],["vv63:22"],["vv63:22"],["vv63:22"],["vv63:22"],["vv63:22"]]},{"para":2881,"vripara":null,"refs":["vv63:22"],"lines":["Rājā kumārassa sarīrasakkāraṃ katvā bhikkhusaṅghassa ca mahādānaṃ pavattetvā cetiyassa pūjaṃ akāsi, tattha mahājano sannipati, theropi saparivāro taṃ padesaṃ upagañchi.","Atha devaputto attanā katakusalakammaṃ oloketvā kataññutāya “gantvā theraṃ vandissāmi, sāsanaguṇe ca pākaṭe karissāmī”ti cintetvā dibbarathaṃ āruyha mahatā parivārena dissamānarūpo āgantvā rathā oruyha therassa pāde vanditvā pitarā saddhiṃ paṭisanthāraṃ katvā theraṃ payirupāsamāno añjaliṃ paggayha aṭṭhāsi.","Taṃ thero imāhi gāthāhi pucchi – 1007."],"lineRefs":[["vv63:22"],["vv63:22"],["vv63:22"]]},{"para":2883,"vripara":"1007","refs":["vv63:22"],"lines":["“Sahassaraṃsīva yathāmahappabho, disaṃ yathā bhāti nabhe anukkamaṃ;"],"lineRefs":[["vv63:22"]]},{"para":2884,"vripara":null,"refs":["vv63:22"],"lines":["Tathāpakāro tavāyaṃ mahāratho, samantato yojanasattamāyato. 1008."],"lineRefs":[["vv63:22"]]},{"para":2886,"vripara":"1008","refs":["vv63:22"],"lines":["“Suvaṇṇapaṭṭehi samantamotthaṭo, urassa muttāhi maṇīhi cittito;"],"lineRefs":[["vv63:22"]]},{"para":2887,"vripara":null,"refs":["vv63:22"],"lines":["Lekhā suvaṇṇassa ca rūpiyassa ca, sobhenti veḷuriyamayā sunimmitā. 1009."],"lineRefs":[["vv63:22"]]},{"para":2889,"vripara":"1009","refs":["vv63:22"],"lines":["“Sīsañcidaṃ veḷuriyassa nimmitaṃ, yugañcidaṃ lohitakāya cittitaṃ;"],"lineRefs":[["vv63:22"]]},{"para":2890,"vripara":null,"refs":["vv63:22"],"lines":["Yuttā suvaṇṇassa ca rūpiyassa ca, sobhanti assā ca ime manojavā. 1010."],"lineRefs":[["vv63:22"]]},{"para":2892,"vripara":"1010","refs":["vv63:22"],"lines":["“So tiṭṭhasi hemarathe adhiṭṭhito, devānamindova sahassavāhano;"],"lineRefs":[["vv63:22"]]},{"para":2893,"vripara":null,"refs":["vv63:22"],"lines":["Pucchāmi tāhaṃ yasavanta kovidaṃ, kathaṃ tayā laddho ayaṃ uḷāro”ti. 1007."],"lineRefs":[["vv63:22"]]},{"para":2894,"vripara":"1007","refs":["vv63:27"],"lines":["Tattha <b>sahassaraṃsī</b>ti sūriyo.","So hi anekasahassaraṃsimantatāya “sahassaraṃsī”ti vuccati.","<b>Yathāmahappabho</b>ti attano mahattassa anurūpappabho.","Yathā hi mahattena sūriyamaṇḍalena sadisaṃ jotimaṇḍalaṃ natthi, evaṃ pabhāyapi.","Tathā hi taṃ ekasmiṃ khaṇe tīsu mahādīpesu ālokaṃ pharantaṃ tiṭṭhati.","<b>Disaṃ yathā bhāti nabhe anukkama</b>nti nabhe ākāse yatheva disaṃ anukkamanto gacchanto yathā yena pakārena bhāti dibbati jotati.","<b>Tathāpakāro</b>ti tādisākāro.","<b>Tavāya</b>nti tava ayaṃ. 1008."],"lineRefs":[["vv63:27"],["vv63:27"],["vv63:27"],["vv63:27"],["vv63:27"],["vv63:27"],["vv63:27"],["vv63:27"]]},{"para":2895,"vripara":"1008","refs":["vv63:28"],"lines":["<b>Suvaṇṇapaṭṭehī</b>ti suvaṇṇamayehi paṭṭehi.","<b>Samantamotthaṭo</b> samantato chādito.","<b>Urassā</b>ti uro assa, rathassa uroti ca īsāmūlaṃ vadati.","<b>Lekhā</b>ti veḷuriyamayā mālākammalatākammādilekhā.","Tāsaṃ suvaṇṇapaṭṭesu ca rajatapaṭṭesu ca dissamānattā vuttaṃ <b>“suvaṇṇassa ca rūpiyassa cā”</b>ti.","<b>Sobhentī</b>ti rathaṃ sobhayanti. 1009."],"lineRefs":[["vv63:28"],["vv63:28"],["vv63:28"],["vv63:28"],["vv63:28"],["vv63:28"]]},{"para":2896,"vripara":"1009","refs":["vv63:29"],"lines":["<b>Sīsa</b>nti rathakubbarasīsaṃ.","<b>Veḷuriyassa nimmita</b>nti veḷuriyena nimmitaṃ, veḷuriyamaṇimayanti attho.","<b>Lohitakāyā</b>ti lohitakamaṇinā, yena kenaci rattamaṇinā vā.","<b>Yuttā</b>ti yojitā, atha vā <b>yottā suvaṇṇassa ca rūpiyassa cā</b>ti suvaṇṇamayā ca rūpiyamayā ca yottā, saṅkhalikāti attho. 1010."],"lineRefs":[["vv63:29"],["vv63:29"],["vv63:29"],["vv63:29"]]},{"para":2897,"vripara":"1010","refs":["vv63:30"],"lines":["<b>Adhiṭṭhito</b>ti attano deviddhiyā sakalamidaṃ ṭhānaṃ abhibhavitvā ṭhito.","<b>Sahassavāhano</b>ti sahassayuttavāhano, sahassaājānīyayuttaratho devānamindo yathāti adhippāyo.","<b>Yasavantā</b>ti ālapanaṃ, yasassīti attho.","<b>Kovida</b>nti kusalañāṇavantaṃ, rathārohane vā chekaṃ.","<b>Ayaṃ uḷāro</b>ti ayaṃ uḷāro mahanto yasoti adhippāyo."],"lineRefs":[["vv63:30"],["vv63:30"],["vv63:30"],["vv63:30"],["vv63:30"]]},{"para":2898,"vripara":null,"refs":["vv63:30"],"lines":["Evaṃ therena puṭṭho devaputto imāhi gāthāhi byākāsi – 1011."],"lineRefs":[["vv63:30"]]},{"para":2900,"vripara":"1011","refs":["vv63:30"],"lines":["“Sujāto nāmahaṃ bhante, rājaputto pure ahuṃ;"],"lineRefs":[["vv63:30"]]},{"para":2901,"vripara":null,"refs":["vv63:30"],"lines":["Tvañca maṃ anukampāya, saññamasmiṃ nivesayi. 1012."],"lineRefs":[["vv63:30"]]},{"para":2903,"vripara":"1012","refs":["vv63:30"],"lines":["“Khīṇāyukañca maṃ ñatvā, sarīraṃ pādāsi satthuno;"],"lineRefs":[["vv63:30"]]},{"para":2904,"vripara":null,"refs":["vv63:30"],"lines":["Imaṃ sujāta pūjehi, taṃ te atthāya hehiti. 1013."],"lineRefs":[["vv63:30"]]},{"para":2906,"vripara":"1013","refs":["vv63:30"],"lines":["“Tāhaṃ gandhehi mālehi, pūjayitvā samuyyuto;"],"lineRefs":[["vv63:30"]]},{"para":2907,"vripara":null,"refs":["vv63:30"],"lines":["Pahāya mānusaṃ dehaṃ, upapannomhi nandanaṃ. 1014."],"lineRefs":[["vv63:30"]]},{"para":2909,"vripara":"1014","refs":["vv63:30"],"lines":["“Nandane ca vane ramme, nānādijagaṇāyute;"],"lineRefs":[["vv63:30"]]},{"para":2910,"vripara":null,"refs":["vv63:30"],"lines":["Ramāmi naccagītehi, accharāhi purakkhato”ti. 1012-3."],"lineRefs":[["vv63:30"]]},{"para":2911,"vripara":"1012-1013","refs":["vv63:32"],"lines":["Tattha <b>sarīra</b>ntī sarīradhātuṃ.","<b>Hehitī</b>ti bhavissati.","<b>Samuyyuto</b>ti sammā uyyutto, yuttappayuttoti attho."],"lineRefs":[["vv63:32"],["vv63:32"],["vv63:32"]]}],"wordLinks":[["vv63:1.1","daḷhadhammā",0,1],["vv63:1.1","nisārassā",0,4],["vv63:1.1","olubbhā",0,5],["vv63:1.3","rājañño",0,6],["vv63:1.3","vanecaro",0,7],["vv63:3.1","mige gavesamāno",6,3],["vv63:4.1","adurāgataṃ",12,0],["vv63:5.3","santhatasmiṃ upāvisā",13,0],["vv63:6.1","kalyāṇī",19,0],["vv63:6.1","savanīyā",19,1],["vv63:6.3","nelā",19,2],["vv63:6.3","atthavatī",19,3],["vv63:6.3","vaggū",19,4],["vv63:6.3","mantvā",19,5],["vv63:6.3","atthaṃ",19,6],["vv63:7.1","isinisabhā",20,0],["vv63:7.3","vacanapathaṃ",20,1],["vv63:7.3","atthadhammapadaṃ samācaremase",20,3],["vv63:9.1","ārati samacariyā cā",26,0],["vv63:9.1","bāhusaccaṃ",26,1],["vv63:9.1","kataññutā",26,2],["vv63:9.3","pāsaṃsā",26,3],["vv63:9.3","dhammā ete",26,4],["vv63:9.3","pasaṃsiyā",26,5],["vv63:10.3","attānaṃ parimocayā",30,0],["vv63:11.1","katamaṃ svāhaṃ",34,0],["vv63:11.1","kiṃ kammaṃ kiñca porisaṃ",34,1],["vv63:11.1","porisaṃ",34,2],["vv63:12.3","yattha gantvā",50,0],["vv63:13.1","mahaddhanā",51,0],["vv63:13.1","mahābhogā",51,1],["vv63:13.1","raṭṭhavanto",51,2],["vv63:13.1","khattiyā",51,3],["vv63:13.3","pahūtadhanadhaññāse",51,4],["vv63:13.3","tepi no ajarāmarā",51,5],["vv63:14.1","andhakaveṇḍuputtā",52,0],["vv63:14.1","sūrā",52,1],["vv63:14.1","vīrā",52,2],["vv63:14.1","vikkantappahārino",52,3],["vv63:14.3","viddhastā",52,4],["vv63:14.3","sassatīsamā",52,5],["vv63:15.3","jātiyā",53,0],["vv63:16.1","mantaṃ",54,0],["vv63:16.1","chaḷaṅgaṃ",54,1],["vv63:16.1","brahmacintitaṃ",54,2],["vv63:17.1","santā",55,0],["vv63:17.1","saññatattā",55,1],["vv63:17.1","tapassino",55,2],["vv63:17.3","tapassino",55,2],["vv63:19.3","nijjhattomhī",59,1],["vv63:19.3","subhaṭṭhenā",59,2],["vv63:22.1","puratthimasmiṃ janapade",69,0],["vv63:27.1","sahassaraṃsī",90,0],["vv63:27.1","yathāmahappabho",90,2],["vv63:27.1","disaṃ yathā bhāti nabhe anukkamaṃ",90,5],["vv63:27.3","tathāpakāro",90,6],["vv63:27.3","tavāyaṃ",90,7],["vv63:28.1","suvaṇṇapaṭṭehī",91,0],["vv63:28.1","samantamotthaṭo",91,1],["vv63:28.1","urassā",91,2],["vv63:28.3","lekhā",91,3],["vv63:28.3","suvaṇṇassa ca rūpiyassa cā",91,4],["vv63:28.3","sobhentī",91,5],["vv63:29.1","sīsaṃ",92,0],["vv63:29.1","veḷuriyassa nimmitaṃ",92,1],["vv63:29.1","lohitakāyā",92,2],["vv63:29.3","yuttā",92,3],["vv63:30.1","adhiṭṭhito",93,0],["vv63:30.1","sahassavāhano",93,1],["vv63:30.3","yasavantā",93,2],["vv63:30.3","kovidaṃ",93,3],["vv63:30.3","ayaṃ uḷāro",93,4],["vv63:32.1","sarīra",103,0],["vv63:32.3","hehitī",103,1]],"before":[{"para":2768,"vripara":null,"title":"Cūḷarathavimānavaṇṇanā","lines":["Cūḷarathavimānavaṇṇanā"]},{"para":2769,"vripara":null,"title":"Cūḷarathavimānavaṇṇanā","lines":["<b>Daḷhadhammā</b> <b>nisārassā</b>ti cūḷarathavimānaṃ.","Tassa kā uppatti?","Bhagavati parinibbute dhātuvibhāgaṃ katvā tattha tattha satthu thūpesu patiṭṭhāpiyamānesu mahākassapattherappamukhesu dhammaṃ saṅgāyituṃ uccinitvā gahitesu sāvakesu yāva vassūpagamanā veneyyāpekkhāya attano attano parisāya saddhiṃ tattha tattha vasantesu āyasmā mahākaccāyano paccantadese aññatarasmiṃ araññāyatane viharati.","Tena samayena assakaraṭṭhe potalinagare assakarājā rajjaṃ kāreti, tassa jeṭṭhāya deviyā putto sujāto nāma kumāro soḷasavassuddesiko kaniṭṭhāya deviyā nibandhanena pitarā raṭṭhato pabbājito araññaṃ pavisitvā vanacarake nissāya araññe vasati.","So kira kassapassa bhagavato sāsane pabbajitvā sīlamatte patiṭṭhito puthujjanakālakiriyaṃ katvā tāvatiṃsesu nibbattitvā tattha yāvatāyukaṃ ṭhatvā aparāparaṃ sugatiyaṃyeva paribbhamanto imasmiṃ buddhuppāde bhagavato abhisambodhito tiṃsavasse assakaraṭṭhe assakarañño aggamahesiyā kucchismiṃ nibbatti, “sujāto”tissa nāmaṃ ahosi.","So mahantena parivārena vaḍḍhati."]},{"para":2770,"vripara":null,"title":"Cūḷarathavimānavaṇṇanā","lines":["Tassa pana mātari kālakatāya rājā aññaṃ rājadhītaraṃ aggamahesiṭṭhāne ṭhapesi.","Sāpi aparena samayena puttaṃ vijāyi.","Tassā rājā puttaṃ disvā pasanno “bhadde, tayā icchitaṃ varaṃ gaṇhāhī”ti varaṃ adāsi.","Sā gahitakaṃ katvā ṭhapetvā yadā sujātakumāro soḷasavassuddesiko jāto, tadā rājānaṃ āha “deva, tumhehi mama puttaṃ disvā tuṭṭhacittehi varo dinno, taṃ idāni dethā”ti.","“Gaṇha, devī”ti.","“Mayhaṃ puttassa rajjaṃ dethā”ti.","“Nassa, vasali, mama jeṭṭhaputte devakumārasadise sujātakumāre ṭhite kasmā evaṃ vadasī”ti paṭikkhipi.","Devī punappunaṃ nibandhanaṃ karontī manaṃ alabhitvā ekadivasaṃ āha “deva, yadi sacce tiṭṭhasi, dehi evā”ti.","Rājā “anupadhāretvā mayā imissā varo dinno, ayañca evaṃ vadatī”ti vippaṭisārī hutvā sujātakumāraṃ pakkositvā tamatthaṃ ārocetvā assūni pavattesi.","Kumāro pitaraṃ socamānaṃ disvā domanassappatto assūni pavattetvā “anujānāhi, deva, ahaṃ aññattha gamissāmī”ti āha.","Taṃ sutvā raññā “aññaṃ te nagaraṃ māpessāmi, tattha vaseyyāsī”ti vutte kumāro na icchi.","“Mama sahāyānaṃ rājūnaṃ santike pesessāmī”ti ca vutte tampi nānujāni.","Kevalaṃ “deva, araññaṃ gamissāmī”ti āha.","Rājā puttaṃ āliṅgitvā sīse cumbitvā “mamaccayena idhāgantvā rajje patiṭṭhahā”ti vatvā vissajjesi."]},{"para":2771,"vripara":null,"title":"Cūḷarathavimānavaṇṇanā","lines":["So araññaṃ pavisitvā vanacarake nissāya vasanto ekadivasaṃ migavaṃ gato.","Tassa samaṇakāle sahāyavaro eko devaputto hitesitāya migarūpena taṃ palobhento dhāvitvā āyasmato mahākaccāyanassa vasanaṭṭhānasamīpaṃ patvā antaradhāyi.","So “imaṃ migaṃ idāni gaṇhissāmī”ti upadhāvanto therassa vasanaṭṭhānaṃ patvā taṃ apassanto bahi paṇṇasālāya theraṃ nisinnaṃ disvā tassa samīpe cāpakoṭiṃ olubbha aṭṭhāsi.","Thero taṃ oloketvā ādito paṭṭhāya sabbaṃ tassa pavattiṃ ñatvā anuggaṇhanto ajānanto viya saṅgahaṃ karonto – 981."]},{"para":2773,"vripara":"981","title":"Cūḷarathavimānavaṇṇanā","lines":["“Daḷhadhammā nisārassa, dhanuṃ olubbha tiṭṭhasi;"]},{"para":2774,"vripara":null,"title":"Cūḷarathavimānavaṇṇanā","lines":["Khattiyo nusi rājañño, adu luddo vanecaro”ti. –"]}],"after":[{"para":2912,"vripara":null,"title":"Cūḷarathavimānavaṇṇanā","lines":["Evaṃ devaputto therena pucchitamatthaṃ kathetvā theraṃ vanditvā padakkhiṇaṃ katvā pitaraṃ āpucchitvā rathaṃ āruyha devalokameva gato.","Theropi tamatthaṃ aṭṭhuppattiṃ katvā sampattaparisāya vitthārena dhammakathaṃ kathesi.","Sā dhammakathā mahājanassa sātthikā ahosi.","Atha thero taṃ sabbaṃ attanā ca tena ca kathitaniyāmeneva saṅgītikāle dhammasaṅgāhakānaṃ ārocesi, te ca taṃ tathā saṅgahaṃ āropesunti."]},{"para":2913,"vripara":null,"title":"Cūḷarathavimānavaṇṇanā","lines":["Cūḷarathavimānavaṇṇanā niṭṭhitā. 14."]}]},"tika":null,"tika2":null}
