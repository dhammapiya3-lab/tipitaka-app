{"suttaId":"vv60","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2290,2307],"vripara":"961"},"segments":{"vv60:0.4":"Paṭhamanāgavimānavatthu","vv60:1.1":"“Susukkakhandhaṃ abhiruyha nāgaṃ,","vv60:1.2":"akācinaṃ dantiṃ baliṃ mahājavaṃ;","vv60:1.3":"Abhiruyha gajavaraṃ [gajaṃ varaṃ (syā.)] sukappitaṃ,","vv60:1.4":"idhāgamā vehāyasaṃ antalikkhe.","vv60:2.1":"“Nāgassa dantesu duvesu nimmitā,","vv60:2.2":"acchodakā paduminiyo suphullā;","vv60:2.3":"Padumesu ca turiyagaṇā pavajjare,","vv60:2.4":"imā ca naccanti manoharāyo.","vv60:3.1":"“Deviddhipattosi mahānubhāvo,","vv60:3.2":"manussabhūto kimakāsi puññaṃ;","vv60:3.3":"Kenāsi evaṃ jalitānubhāvo,","vv60:3.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv60:4.1":"So devaputto attamano,","vv60:4.2":"moggallānena pucchito;","vv60:4.3":"Pañhaṃ puṭṭho viyākāsi,","vv60:4.4":"yassa kammassidaṃ phalaṃ.","vv60:5.1":"“Aṭṭheva muttapupphāni,","vv60:5.2":"kassapassa mahesino [bhagavato (syā. ka.)];","vv60:5.3":"Thūpasmiṃ abhiropesiṃ,","vv60:5.4":"pasanno sehi pāṇibhi.","vv60:6.1":"“Tena metādiso vaṇṇo … pe …","vv60:6.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv60:7.1":"Paṭhamanāgavimānaṃ dasamaṃ."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2703,"to":2703,"paras":[{"para":2703,"vripara":"961","refs":["vv60:1"],"lines":["Tattha <b>susukkakhandhan</b>ti suṭṭhu setakhandhaṃ.","Kiñcāpi tassa nāgassa cattāro pādā, vatthikosaṃ, mukhappadeso, ubho kaṇṇā, vāladhīti ettakaṃ muñcitvā sabbo kāyo setova, khandhappadesassa pana sātisayaṃ dhavalataratāya vuttaṃ “susukkakhandhan”ti.","<b>Nāgan</b>ti dibbaṃ hatthināgaṃ.","<b>Akācinan</b>ti niddosaṃ, sabalalavaṅkatilakādichavidosavirahitanti attho.","“Ājānīyan” tipi pāḷi, ājānīyalakkhaṇūpetanti attho.","<b>Dantin</b>ti vipularuciradantavantaṃ.","<b>Balin</b>ti balavantaṃ mahābalaṃ.","<b>Mahājavan</b>ti atijavaṃ sīghagāmiṃ.","Puna <b>abhiruyhā</b>ti ettha anunāsikalopo daṭṭhabbo, abhiruyhaṃ ārohanīyanti vuttaṃ hoti.","Sesaṃ vuttanayameva."],"lineRefs":[["vv60:1"],["vv60:1"],["vv60:1"],["vv60:1"],["vv60:1"],["vv60:1"],["vv60:1"],["vv60:1"],["vv60:1"],["vv60:1"]]}],"wordLinks":[["vv60:1.1","susukkakhandhaṃ",0,0],["vv60:1.1","nāgaṃ",0,2],["vv60:1.1","akācinaṃ",0,3],["vv60:1.1","dantiṃ",0,5],["vv60:1.1","baliṃ",0,6],["vv60:1.1","mahājavaṃ",0,7],["vv60:1.1","abhiruyhā",0,8],["vv60:1.3","abhiruyhā",0,8]],"before":[{"para":2694,"vripara":"961","refs":[],"lines":["“Susukkakhandhaṃ abhiruyha nāgaṃ, akācinaṃ dantiṃ baliṃ mahājavaṃ;"],"lineRefs":[[]]},{"para":2695,"vripara":null,"refs":[],"lines":["Abhiruyha gajavaraṃ sukappitaṃ, idhāgamā vehāyasaṃ antalikkhe."],"lineRefs":[[]]},{"para":2697,"vripara":"962","refs":[],"lines":["“Nāgassa dantesu duvesu nimmitā, acchodakā paduminiyo suphullā;"],"lineRefs":[[]]},{"para":2698,"vripara":null,"refs":[],"lines":["Padumesu ca tūriyagaṇā pavajjare, imā ca naccanti manoharāyo."],"lineRefs":[[]]},{"para":2700,"vripara":"963","refs":[],"lines":["“Deviddhipattosi mahānubhāvo, manussabhūto kimakāsi puññaṃ;"],"lineRefs":[[]]},{"para":2701,"vripara":null,"refs":[],"lines":["Kenāsi evaṃ jalitānubhāvo, vaṇṇo ca te sabbadisā pabhāsatī”ti.","–"],"lineRefs":[[],[]]},{"para":2702,"vripara":null,"refs":[],"lines":["Tassa sampattikittanamukhena katakammaṃ pucchi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
