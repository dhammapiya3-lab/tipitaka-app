{"suttaId":"an10.2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[19,20],"vripara":"2"},"segments":{"an10.2:0.3":"Cetanākaraṇīyasuttaṃ","an10.2:1.1":"[a. ni.11.2]“Sīlavato, bhikkhave, sīlasampannassa na cetanāya karaṇīyaṃ –","an10.2:1.2":"‘avippaṭisāro me uppajjatū’ti.","an10.2:1.3":"Dhammatā esā, bhikkhave, yaṃ sīlavato sīlasampannassa avippaṭisāro uppajjati.","an10.2:1.4":"Avippaṭisārissa, bhikkhave, na cetanāya karaṇīyaṃ –","an10.2:1.5":"‘pāmojjaṃ me uppajjatū’ti.","an10.2:1.6":"Dhammatā esā, bhikkhave, yaṃ avippaṭisārissa pāmojjaṃ jāyati.","an10.2:1.7":"Pamuditassa, bhikkhave, na cetanāya karaṇīyaṃ –","an10.2:1.8":"‘pīti me uppajjatū’ti.","an10.2:1.9":"Dhammatā esā, bhikkhave, yaṃ pamuditassa pīti uppajjati.","an10.2:1.10":"Pītimanassa, bhikkhave, na cetanāya karaṇīyaṃ –","an10.2:1.11":"‘kāyo me passambhatū’ti.","an10.2:1.12":"Dhammatā esā, bhikkhave, yaṃ pītimanassa kāyo passambhati.","an10.2:1.13":"Passaddhakāyassa, bhikkhave, na cetanāya karaṇīyaṃ –","an10.2:1.14":"‘sukhaṃ vediyāmī’ti.","an10.2:1.15":"Dhammatā esā, bhikkhave, yaṃ passaddhakāyo sukhaṃ vediyati.","an10.2:1.16":"Sukhino, bhikkhave, na cetanāya karaṇīyaṃ –","an10.2:1.17":"‘cittaṃ me samādhiyatū’ti.","an10.2:1.18":"Dhammatā esā, bhikkhave, yaṃ sukhino cittaṃ samādhiyati.","an10.2:1.19":"Samāhitassa, bhikkhave, na cetanāya karaṇīyaṃ –","an10.2:1.20":"‘yathābhūtaṃ jānāmi passāmī’ti.","an10.2:1.21":"Dhammatā esā, bhikkhave, yaṃ samāhito yathābhūtaṃ jānāti passati.","an10.2:1.22":"Yathābhūtaṃ, bhikkhave, jānato passato na cetanāya karaṇīyaṃ –","an10.2:1.23":"‘nibbindāmi virajjāmī’ti.","an10.2:1.24":"Dhammatā esā, bhikkhave, yaṃ yathābhūtaṃ jānaṃ passaṃ nibbindati virajjati.","an10.2:1.25":"Nibbinnassa [nibbindassa (sī. ka.)], bhikkhave, virattassa na cetanāya karaṇīyaṃ –","an10.2:1.26":"‘vimuttiñāṇadassanaṃ sacchikaromī’ti.","an10.2:1.27":"Dhammatā esā, bhikkhave, yaṃ nibbinno [nibbindo (sī. ka.)] viratto vimuttiñāṇadassanaṃ sacchikaroti.","an10.2:2.1":"“Iti kho, bhikkhave, nibbidāvirāgo vimuttiñāṇadassanattho vimuttiñāṇadassanānisaṃso;","an10.2:2.2":"yathābhūtañāṇadassanaṃ nibbidāvirāgatthaṃ nibbidāvirāgānisaṃsaṃ;","an10.2:2.3":"samādhi yathābhūtañāṇadassanattho yathābhūtañāṇadassanānisaṃso;","an10.2:2.4":"sukhaṃ samādhatthaṃ samādhānisaṃsaṃ;","an10.2:2.5":"passaddhi sukhatthā sukhānisaṃsā;","an10.2:2.6":"pīti passaddhatthā passaddhānisaṃsā;","an10.2:2.7":"pāmojjaṃ pītatthaṃ pītānisaṃsaṃ;","an10.2:2.8":"avippaṭisāro pāmojjattho pāmojjānisaṃso;","an10.2:2.9":"kusalāni sīlāni avippaṭisāratthāni avippaṭisārānisaṃsāni.","an10.2:2.10":"Iti kho, bhikkhave, dhammā dhamme abhisandenti, dhammā dhamme paripūrenti apārā pāraṃ gamanāyā”ti.","an10.2:2.11":"Dutiyaṃ."},"unsure":[],"attha":{"book":"Mp-x","bookName":"Dasakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":415,"to":415,"paras":[{"para":415,"vripara":"2","refs":["an10.2:1","an10.2:2"],"lines":["Dutiye <b>na cetanāya karaṇīyan</b>ti na cetetvā kappetvā pakappetvā kātabbaṃ.","<b>Dhammatā esā</b>ti dhammasabhāvo eso kāraṇaniyamo ayaṃ.","<b>Abhisandentī</b>ti pavattenti.","<b>Paripūrentī</b>ti paripuṇṇaṃ karonti.","<b>Apārā pāraṃ gamanāyā</b>ti orimatīrabhūtā tebhūmakavaṭṭā nibbānapāraṃ gamanatthāya."],"lineRefs":[["an10.2:1"],["an10.2:1"],["an10.2:2"],["an10.2:2"],["an10.2:2"]]}],"wordLinks":[["an10.2:1.1","na cetanāya karaṇīyaṃ",0,0],["an10.2:1.4","na cetanāya karaṇīyaṃ",0,0],["an10.2:1.7","na cetanāya karaṇīyaṃ",0,0],["an10.2:1.10","na cetanāya karaṇīyaṃ",0,0],["an10.2:1.13","na cetanāya karaṇīyaṃ",0,0],["an10.2:1.16","na cetanāya karaṇīyaṃ",0,0],["an10.2:1.19","na cetanāya karaṇīyaṃ",0,0],["an10.2:1.22","na cetanāya karaṇīyaṃ",0,0],["an10.2:1.25","na cetanāya karaṇīyaṃ",0,0],["an10.2:1.3","dhammatā esā",0,1],["an10.2:1.6","dhammatā esā",0,1],["an10.2:1.9","dhammatā esā",0,1],["an10.2:1.12","dhammatā esā",0,1],["an10.2:1.15","dhammatā esā",0,1],["an10.2:1.18","dhammatā esā",0,1],["an10.2:1.21","dhammatā esā",0,1],["an10.2:1.24","dhammatā esā",0,1],["an10.2:1.27","dhammatā esā",0,1],["an10.2:2.10","abhisandentī",0,2],["an10.2:2.10","paripūrentī",0,3],["an10.2:2.10","apārā pāraṃ gamanāyā",0,4]],"before":[{"para":414,"vripara":null,"refs":[],"lines":["Cetanākaraṇīyasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":473,"to":473,"paras":[{"para":473,"vripara":"2-5","refs":["an10.2:2"],"lines":["2-5. Dutiye saṃsāramahoghassa paratīrabhāvato yo naṃ adhigacchati, taṃ pāreti gametīti <b>pāraṃ,</b> nibbānaṃ.","Tabbidūratāya natthi ettha pāranti <b>apāraṃ,</b> saṃsāro.","Tenāha <b>“orimatīrabhūtā tebhūmakavaṭṭā”</b>tiādi.","Tatiyādīsu natthi vattabbaṃ."],"lineRefs":[["an10.2:2"],["an10.2:2"],["an10.2:2"],["an10.2:2"]]}],"wordLinks":[["an10.2:2.10","pāraṃ",0,0]],"before":[{"para":471,"vripara":null,"refs":[],"lines":["Kimatthiyasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":472,"vripara":null,"refs":[],"lines":["2-5. Cetanākaraṇīyasuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
