{"suttaId":"tha-ap528","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3579,3597],"vripara":"36"},"segments":{"tha-ap528:0.3":"Daṇḍadāyakattheraapadānaṃ","tha-ap528:1.1":"“Kānanaṃ vanamogayha,","tha-ap528:1.2":"veḷuṃ chetvānahaṃ tadā;","tha-ap528:1.3":"Ālambaṇaṃ karitvāna,","tha-ap528:1.4":"saṅghassa adadiṃ bahuṃ [ahaṃ (sī. syā. pī.)].","tha-ap528:2.1":"“Tena cittappasādena,","tha-ap528:2.2":"subbate abhivādiya;","tha-ap528:2.3":"Ālambadaṇḍaṃ datvāna,","tha-ap528:2.4":"pakkāmiṃ uttarāmukho.","tha-ap528:3.1":"“Catunnavutito kappe,","tha-ap528:3.2":"yaṃ daṇḍamadadiṃ tadā;","tha-ap528:3.3":"Duggatiṃ nābhijānāmi,","tha-ap528:3.4":"daṇḍadānassidaṃ phalaṃ.","tha-ap528:4.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap528:4.3":"viharāmi anāsavo.","tha-ap528:5.1":"“Svāgataṃ vata me āsi … pe …","tha-ap528:5.3":"kataṃ buddhassa sāsanaṃ.","tha-ap528:6.1":"“Paṭisambhidā catasso … pe …","tha-ap528:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap528:7.1":"Itthaṃ sudaṃ āyasmā daṇḍadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap528:8.1":"Daṇḍadāyakattherassāpadānaṃ chaṭṭhaṃ.","tha-ap528:8.2":"Tevīsatimaṃ bhāṇavāraṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
