{"suttaId":"sn1.62","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[732,736],"vripara":"62"},"segments":{"sn1.62:0.3":"Cittasuttaṃ","sn1.62:1.1":"“Kenassu nīyati loko, kenassu parikassati;","sn1.62:1.3":"Kissassu ekadhammassa, sabbeva vasamanvagū”ti.","sn1.62:2.1":"“Cittena nīyati loko, cittena parikassati;","sn1.62:2.3":"Cittassa ekadhammassa, sabbeva vasamanvagū”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":460,"to":460,"paras":[{"para":460,"vripara":"62","refs":["sn1.62:1"],"lines":["Dutiye <b>sabbeva vasamanvagū</b>ti ye cittassa vasaṃ gacchanti, tesaṃyeva anavasesapariyādānametaṃ.","Dutiyaṃ."],"lineRefs":[["sn1.62:1"],["sn1.62:1"]]}],"wordLinks":[["sn1.62:1.3","sabbeva vasamanvagū",0,0]]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":563,"to":565,"paras":[{"para":563,"vripara":"62","refs":["sn1.62:1"],"lines":["<b>Ye cittassa vasaṃ gacchantī</b>ti ye apariññātavatthukā, tesaṃyeva.","<b>Anavasesapariyādānan</b>ti anavasesaggahaṇaṃ.","Na hi pariññātakkhandhā pahīnakilesā cittassa vasaṃ gacchanti, taṃ attano vase vattenti."],"lineRefs":[["sn1.62:1"],["sn1.62:1"],["sn1.62:1"]]},{"para":564,"vripara":null,"refs":[],"lines":["Cittasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":565,"vripara":null,"refs":["sn1.62:1"],"lines":["Taṇhāsuttavaṇṇanā"],"lineRefs":[["sn1.62:1"]]}],"wordLinks":[]}}
