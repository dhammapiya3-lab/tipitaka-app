{"suttaId":"ja279","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2065,2075],"vripara":"85"},"segments":{"ja279:0.4":"Satapattajātakaṃ (3-3-9)","ja279:1.1":"Yathā māṇavako panthe, siṅgāliṃ vanagocariṃ;","ja279:1.3":"Atthakāmaṃ pavedentiṃ [pavadantiṃ (pī.)], anatthakāmāti maññati;","ja279:1.5":"Anatthakāmaṃ satapattaṃ, atthakāmoti maññati.","ja279:2.1":"Evameva idhekacco, puggalo hoti tādiso;","ja279:2.3":"Hitehi vacanaṃ vutto, paṭigaṇhāti vāmato.","ja279:3.1":"Ye ca kho naṃ pasaṃsanti, bhayā ukkaṃsayanti vā [ca (sī. pī.)];","ja279:3.3":"Tañhi so maññate mittaṃ, satapattaṃva māṇavoti.","ja279:4.1":"Satapattajātakaṃ navamaṃ."},"attha":null,"tika":null}
