{"suttaId":"ja190","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1196,1206],"vripara":"79"},"segments":{"ja190:0.4":"Sīlānisaṃsajātakaṃ (2-4-10)","ja190:1.1":"Passa saddhāya sīlassa, cāgassa ca ayaṃ phalaṃ;","ja190:1.3":"Nāgo nāvāya vaṇṇena, saddhaṃ vahatupāsakaṃ.","ja190:2.1":"Sabbhireva samāsetha, sabbhi kubbetha santhavaṃ;","ja190:2.3":"Satañhi sannivāsena, sotthiṃ gacchati nhāpitoti.","ja190:3.1":"Sīlānisaṃsajātakaṃ dasamaṃ.","ja190:3.2":"Asadisavaggo catuttho.","ja190:4.1":"Tassuddānaṃ –","ja190:5.1":"Dhanuggaha kuñjara apparaso, giridattamanāvilacittavaraṃ;","ja190:5.3":"Dadhivāhana jambūka sīhanakho, haritayava nāgavarena dasāti."},"attha":null,"tika":null}
