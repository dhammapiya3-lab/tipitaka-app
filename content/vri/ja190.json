{"suttaId":"ja190","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1196,1206],"vripara":"79"},"segments":{"ja190:0.4":"Sīlānisaṃsajātakaṃ (2-4-10)","ja190:1.1":"Passa saddhāya sīlassa,","ja190:1.2":"cāgassa ca ayaṃ phalaṃ;","ja190:1.3":"Nāgo nāvāya vaṇṇena,","ja190:1.4":"saddhaṃ vahatupāsakaṃ. 80.","ja190:2.1":"Sabbhireva samāsetha,","ja190:2.2":"sabbhi kubbetha santhavaṃ;","ja190:2.3":"Satañhi sannivāsena,","ja190:2.4":"sotthiṃ gacchati nhāpitoti.","ja190:3.1":"Sīlānisaṃsajātakaṃ dasamaṃ.","ja190:3.2":"Asadisavaggo catuttho.","ja190:4.1":"Tassuddānaṃ –","ja190:5.1":"Dhanuggaha kuñjara apparaso,","ja190:5.2":"giridattamanāvilacittavaraṃ;","ja190:5.3":"Dadhivāhana jambūka sīhanakho,","ja190:5.4":"haritayava nāgavarena dasāti. 5."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":689,"to":689,"paras":[{"para":689,"vripara":null,"refs":["ja190:2"],"lines":["Tattha <b>passā</b>ti kañci aniyametvā passathāti ālapati.","<b>Saddhāyā</b>ti lokiyalokuttarāya saddhāya.","Sīlepi eseva nayo.","<b>Cāgassā</b>ti deyyadhammapariccāgassa ceva kilesapariccāgassa ca.","<b>Ayaṃ phala</b>nti idaṃ phalaṃ, guṇaṃ ānisaṃsanti attho.","Atha vā cāgassa ca phalaṃ passa, ayaṃ nāgo nāvāya vaṇṇenāti evampettha attho daṭṭhabbo.","<b>Nāvāya vaṇṇenā</b>ti nāvāya saṇṭhānena.","<b>Saddha</b>nti tīsu ratanesu patiṭṭhitasaddhaṃ.","<b>Sabbhirevā</b>ti paṇḍitehiyeva.","<b>Samāsethā</b>ti ekato āvaseyya, upavaseyyāti attho.","<b>Kubbethā</b>ti kareyya.","<b>Santhava</b>nti mittasanthavaṃ.","Taṇhāsanthavo pana kenacipi saddhiṃ na kātabbo.","<b>Nhāpito</b>ti nhāpitakuṭumbiko.","“Nahāpito”tipi pāṭho."],"lineRefs":[["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"]]}],"wordLinks":[["ja190:2.1","sabbhirevā",0,8],["ja190:2.1","samāsethā",0,9],["ja190:2.1","kubbethā",0,10],["ja190:2.1","santhavaṃ",0,11],["ja190:2.3","nhāpito",0,13]],"after":[{"para":690,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Evaṃ samuddadevatā ākāse ṭhatvā dhammaṃ desetvā ovaditvā nāgarājānaṃ gaṇhitvā attano vimānameva agamāsi."]},{"para":691,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi – saccapariyosāne upāsako sakadāgāmiphale patiṭṭhahi.","“Tadā sotāpannaupāsako parinibbāyi, nāgarājā sāriputto ahosi, samuddadevatā pana ahameva ahosi”nti."]},{"para":692,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Sīlānisaṃsajātakavaṇṇanā dasamā."]},{"para":693,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Asadisavaggo catuttho."]},{"para":694,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":695,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Asadisañca saṅgāmaṃ, vālodakaṃ giridattaṃ;"]},{"para":696,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Nabhirati dadhivāhaṃ, catumaṭṭhaṃ sīhakoṭṭhaṃ;"]},{"para":697,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Sīhacammaṃ sīlānisaṃsaṃ. 5."]}]},"tika":null,"tika2":null}
