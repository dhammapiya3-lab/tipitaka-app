{"suttaId":"ja190","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1196,1206],"vripara":"79"},"segments":{"ja190:0.4":"Sīlānisaṃsajātakaṃ (2-4-10)","ja190:1.1":"Passa saddhāya sīlassa,","ja190:1.2":"cāgassa ca ayaṃ phalaṃ;","ja190:1.3":"Nāgo nāvāya vaṇṇena,","ja190:1.4":"saddhaṃ vahatupāsakaṃ. 80.","ja190:2.1":"Sabbhireva samāsetha,","ja190:2.2":"sabbhi kubbetha santhavaṃ;","ja190:2.3":"Satañhi sannivāsena,","ja190:2.4":"sotthiṃ gacchati nhāpitoti.","ja190:3.1":"Sīlānisaṃsajātakaṃ dasamaṃ.","ja190:3.2":"Asadisavaggo catuttho.","ja190:4.1":"Tassuddānaṃ –","ja190:5.1":"Dhanuggaha kuñjara apparaso,","ja190:5.2":"giridattamanāvilacittavaraṃ;","ja190:5.3":"Dadhivāhana jambūka sīhanakho,","ja190:5.4":"haritayava nāgavarena dasāti. 5."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":689,"to":689,"paras":[{"para":689,"vripara":null,"refs":["ja190:2"],"lines":["Tattha <b>passā</b>ti kañci aniyametvā passathāti ālapati.","<b>Saddhāyā</b>ti lokiyalokuttarāya saddhāya.","Sīlepi eseva nayo.","<b>Cāgassā</b>ti deyyadhammapariccāgassa ceva kilesapariccāgassa ca.","<b>Ayaṃ phala</b>nti idaṃ phalaṃ, guṇaṃ ānisaṃsanti attho.","Atha vā cāgassa ca phalaṃ passa, ayaṃ nāgo nāvāya vaṇṇenāti evampettha attho daṭṭhabbo.","<b>Nāvāya vaṇṇenā</b>ti nāvāya saṇṭhānena.","<b>Saddha</b>nti tīsu ratanesu patiṭṭhitasaddhaṃ.","<b>Sabbhirevā</b>ti paṇḍitehiyeva.","<b>Samāsethā</b>ti ekato āvaseyya, upavaseyyāti attho.","<b>Kubbethā</b>ti kareyya.","<b>Santhava</b>nti mittasanthavaṃ.","Taṇhāsanthavo pana kenacipi saddhiṃ na kātabbo.","<b>Nhāpito</b>ti nhāpitakuṭumbiko.","“Nahāpito”tipi pāṭho."],"lineRefs":[["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"]]}],"wordLinks":[["ja190:2.1","sabbhirevā",0,8],["ja190:2.1","samāsethā",0,9],["ja190:2.1","kubbethā",0,10],["ja190:2.1","santhavaṃ",0,11],["ja190:2.3","nhāpito",0,13]],"after":[{"para":690,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Evaṃ samuddadevatā ākāse ṭhatvā dhammaṃ desetvā ovaditvā nāgarājānaṃ gaṇhitvā attano vimānameva agamāsi."]},{"para":691,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi – saccapariyosāne upāsako sakadāgāmiphale patiṭṭhahi.","“Tadā sotāpannaupāsako parinibbāyi, nāgarājā sāriputto ahosi, samuddadevatā pana ahameva ahosi”nti."]},{"para":692,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Sīlānisaṃsajātakavaṇṇanā dasamā."]},{"para":693,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Asadisavaggo catuttho."]},{"para":694,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Tassuddānaṃ –"]},{"para":695,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Asadisañca saṅgāmaṃ, vālodakaṃ giridattaṃ;"]},{"para":696,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Nabhirati dadhivāhaṃ, catumaṭṭhaṃ sīhakoṭṭhaṃ;"]},{"para":697,"vripara":null,"title":"[190] 10. Sīlānisaṃsajātakavaṇṇanā","lines":["Sīhacammaṃ sīlānisaṃsaṃ. 5."]}]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":376,"to":388,"paras":[{"para":376,"vripara":null,"refs":["ja190:1"],"lines":["10-sīlānisaṃsajātakavaṇṇanā (190)"],"lineRefs":[["ja190:1"]]},{"para":377,"vripara":null,"refs":["ja190:1"],"lines":["<b>tvaññeva buddhaguṇe anussaritvā patiṭṭhaṃ laddho</b>ti tvaṃ yeva buddhaguṇe punappunaṃ anussaritvā patiṭṭhaṃ alabhīti attho.","ta-paccayo hi kattuatthe.","<b>nhāpitaṃ tassa upāsakassa hatthe nikkhipī</b>ti nhāpitaṃ tassa upāsakassa bhāraṃ katvā niyyādesīti attho.","<b>niyāmako</b>ti nāviko.","yo potavāhoti vuccati.","<b>tayo kūpakā</b>ti tayo alaṅkārathambhā."],"lineRefs":[["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"]]},{"para":378,"vripara":null,"refs":["ja190:1"],"lines":["<b>devatā</b>ti samuddadevatā.","imā gāthā avocāti sambandho.","<b>passā</b>ti vacanavipallāso daṭṭhabbo.","athavā gāthābandhavasena tha-kāralopo daṭṭhabbo.","tenāha — “passāti kiñcī”ti ādi.","<b>ayaṃ phala</b>nti ettha liṅgavipallāso daṭṭhabbo.","tenāha — “ayaṃ phalanti idaṃ phalaṃ guṇaṃ ānisaṃsa”nti attho.","athavā ayaṃ saddo nāgoti iminā sambandhitabbo.","tenāha — “athavā”ti ādi.","<b>sabbhirevā</b>ti ettha tatiyābahuvacanavasena attho daṭṭhabbo.","so ca kho santaïti akārantapakativasena.","aññattha pana sabbhīti ikārantapakativasenāpi attho gahetabbo.","tathā hi “sabbhīti sappuriso nibbānañca.","sundarādhivacanaṃ vā etaṃ sabbhī”ti. sabbo cāyamattho sāṭṭhakathāya “bahumpetaṃ asabbhi jātavedā”ti imāya pāḷiyā “santo have sabbhi pavedayantī”ti imāya ca dīpetabbo."],"lineRefs":[["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"]]},{"para":379,"vripara":null,"refs":["ja190:1"],"lines":["<i>ālapane ca paccatte. tatiyā pañcamīsu ca.</i>","<i>samāsamhi ca yojeyya. sabbhisaddaṃ sumedhaso.</i>"],"lineRefs":[["ja190:1"],["ja190:1"]]},{"para":380,"vripara":null,"refs":["ja190:1"],"lines":["atrāyaṃ yojanā — bho sabbhi tiṭṭha.","sabbhi tiṭṭhati.","sabbhi saha gacchati.","sabbhi apeti.","asabbharūpo puriso.","yasmā panāyaṃ sāsanā-nukūlā.","tasmā imissā tadanukūlattaṃ dassetuṃ idha sāsanato payoge dassessāma.","atakkāvacare vicitte sugatapāḷinaye sotūnaṃ visāradamatipaṭilābhatthaṃ.","taṃ yathā — “bahumpetaṃ asabbhi jātaveda.","yaṃ taṃ vāladhinā abhipūjayāma.","sabbhi kubbetha santhavaṃ.","yaṃ sālavanasmiṃ senako pāpakammamakari asabbhirūpaṃ.","ābādhoyaṃ asabbhirūpo.","asammodako thaddho asabbhirūpo”ti.","tattha ālapanavacane diṭṭheyeva paccattavacanaṃ pāḷiyaṃ sarūpato anāgatampi diṭṭhameva hoti.","yathā karaṇavacane diṭṭheyeva nissakkavacanampi diṭṭhameva hoti.","samāse saddarūpe diṭṭheyeva.","byāse saddarūpaṃ yathāsambhavaṃ diṭṭhameva hoti.","ṭhapetvā hetusatthāradassananti ādīni.","tattha ca nibbānavācako ce sabbhisaddo itthiliṅgo.","santi,visuddhi, nibbūtisaddo viya.","so ca yamakamahātheramate rattinayena yoje-tabbo.","sabbesamikārantitthiliṅgānaṃ sādhāraṇo hi so nayo.","sundaratthavācako ce.","aggirattiaṭṭhinayehi yojetabbo.","vaccaliṅgattā.","sabbhidhammabhūtaṃ nibbānanti ettha hi sundaradhammabhūtaṃ nibbānanti attho.","evaṃ pāḷinayavasena ālapanādīsu pañcasu ṭhānesu sabbhisaddassa pavattiṃ ñatvā"],"lineRefs":[["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"]]},{"para":381,"vripara":null,"refs":["ja190:1"],"lines":["footnote 1.","nīti.","pada.","puna aṭṭhakathānayavasenāpi tappavatti veditabbā.","kathaṃ — yasmā sagāthā-vaggaaṭṭhakathāyaṃ “santo sabbhīhi saddhiṃ sataṃ dhammo na jaraṃ upetīti pavedayantī”ti.","imasmiṃ padese sabbhīhīti vacanavisesena saddaracanā-viseso aṭṭhakathācariyehi dassito.","tasmā sabbhisaddo sabbesupi vibhattivacanesu yojebbo.","tatridaṃ vadāma —"],"lineRefs":[["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"]]},{"para":382,"vripara":null,"refs":["ja190:1"],"lines":["<i>garū sabbhīhi saddhinti. dhīro sabbattha yojaye.</i>","<i>yato tato sabbhisaddaṃ. dhīro sabbattha yojaye.</i>","<i>asabbhi rūpo itipi. samāsavisaye sutaṃ.</i>","<i>yasmā tasmā sabbhisaddaṃ. viññūhi sabbadhi yojaye.</i>"],"lineRefs":[["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"]]},{"para":383,"vripara":null,"refs":["ja190:1"],"lines":["”ovadeyyānusāseyya.","asabbhā ca nivāraye”ti ettha pana asabbhātipadaṃ vicitravuttīsu taddhitapaccayesu ṇyapaccayavasena nipphatti-mupāgatanti veditabbaṃ.","kathaṃ — yebhuyyena asabbhīsu bhavaṃ asabbhaṃ.","kintaṃ?","akusalaṃ.","tato asabbhā akusalato nivāraye ca, kusale dhamme patiṭṭhapeyyācāti attho.","“amhehi asabbhāhi vācāhi vikkosamānā tibbāhi satīhi hanissantī”ti ettha tu asabbhīnaṃ etāti asabbhā.","na vā sabbhīnaṃ etātipi asabbhāti nibbacanaṃ ṇyapaccayavasena ca padasiddhi veditabbā."],"lineRefs":[["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"],["ja190:1"]]},{"para":384,"vripara":null,"refs":["ja190:1"],"lines":["sabbhidevāti dantajakkharenāpi pāṭho dissati.","<b>nhāpitotipi pāṭho</b>ti nhāpitoti pi nakārahakārānaṃ saṃyogavasena pāṭhopi dissatīti."],"lineRefs":[["ja190:1"],["ja190:1"]]},{"para":385,"vripara":null,"refs":["ja190:1"],"lines":["ending sīlānisaṃsajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja190:1"]]},{"para":386,"vripara":null,"refs":["ja190:1"],"lines":["ending asadisavaggo catuttho"],"lineRefs":[["ja190:1"]]},{"para":387,"vripara":null,"refs":["ja190:1"],"lines":["footnote 1.","nīti pada."],"lineRefs":[["ja190:1"],["ja190:1"]]},{"para":388,"vripara":null,"refs":["ja190:1"],"lines":["footnote 2.","nahāpitotipi pāṭho.","chaṭṭha."],"lineRefs":[["ja190:1"],["ja190:1"],["ja190:1"]]}],"wordLinks":[]},"tika2":null}
