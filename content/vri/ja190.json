{"suttaId":"ja190","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1196,1206],"vripara":"79"},"segments":{"ja190:0.4":"Sīlānisaṃsajātakaṃ (2-4-10)","ja190:1.1":"Passa saddhāya sīlassa, cāgassa ca ayaṃ phalaṃ;","ja190:1.3":"Nāgo nāvāya vaṇṇena, saddhaṃ vahatupāsakaṃ.","ja190:2.1":"Sabbhireva samāsetha, sabbhi kubbetha santhavaṃ;","ja190:2.3":"Satañhi sannivāsena, sotthiṃ gacchati nhāpitoti.","ja190:3.1":"Sīlānisaṃsajātakaṃ dasamaṃ.","ja190:3.2":"Asadisavaggo catuttho.","ja190:4.1":"Tassuddānaṃ –","ja190:5.1":"Dhanuggaha kuñjara apparaso, giridattamanāvilacittavaraṃ;","ja190:5.3":"Dadhivāhana jambūka sīhanakho, haritayava nāgavarena dasāti."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":689,"to":689,"paras":[{"para":689,"vripara":null,"refs":["ja190:2"],"lines":["Tattha <b>passā</b>ti kañci aniyametvā passathāti ālapati.","<b>Saddhāyā</b>ti lokiyalokuttarāya saddhāya.","Sīlepi eseva nayo.","<b>Cāgassā</b>ti deyyadhammapariccāgassa ceva kilesapariccāgassa ca.","<b>Ayaṃ phalan</b>ti idaṃ phalaṃ, guṇaṃ ānisaṃsanti attho.","Atha vā cāgassa ca phalaṃ passa, ayaṃ nāgo nāvāya vaṇṇenāti evampettha attho daṭṭhabbo.","<b>Nāvāya vaṇṇenā</b>ti nāvāya saṇṭhānena.","<b>Saddhan</b>ti tīsu ratanesu patiṭṭhitasaddhaṃ.","<b>Sabbhirevā</b>ti paṇḍitehiyeva.","<b>Samāsethā</b>ti ekato āvaseyya, upavaseyyāti attho.","<b>Kubbethā</b>ti kareyya.","<b>Santhavan</b>ti mittasanthavaṃ.","Taṇhāsanthavo pana kenacipi saddhiṃ na kātabbo.","<b>Nhāpito</b>ti nhāpitakuṭumbiko.","“Nahāpito” tipi pāṭho."],"lineRefs":[["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"],["ja190:2"]]}],"wordLinks":[["ja190:2.1","sabbhirevā",0,8],["ja190:2.1","samāsethā",0,9],["ja190:2.1","kubbethā",0,10],["ja190:2.1","santhavaṃ",0,11],["ja190:2.3","nhāpito",0,13]]},"tika":null,"tika2":null}
