{"suttaId":"thig13.2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[992,1055],"vripara":"271"},"segments":{"thig13.2:0.3":"Rohinītherīgāthā","thig13.2:1.1":"“‘Samaṇā’ti bhoti supi [bhoti tvaṃ sayasi (sī.), bhoti maṃ vipassi (syā.)],","thig13.2:1.2":"‘samaṇā’ti pabujjhasi [paṭibujjhasi (sī. syā.)];","thig13.2:1.3":"Samaṇāneva [samaṇānameva (sī. syā.)] kittesi,","thig13.2:1.4":"samaṇī nūna [samaṇī nu (ka.)] bhavissasi.","thig13.2:2.1":"“Vipulaṃ annañca pānañca,","thig13.2:2.2":"samaṇānaṃ paveccasi [payacchasi (sī.)];","thig13.2:2.3":"Rohinī dāni pucchāmi,","thig13.2:2.4":"kena te samaṇā piyā.","thig13.2:3.1":"“Akammakāmā alasā,","thig13.2:3.2":"paradattūpajīvino;","thig13.2:3.3":"Āsaṃsukā sādukāmā,","thig13.2:3.4":"kena te samaṇā piyā”.","thig13.2:4.1":"“Cirassaṃ vata maṃ tāta,","thig13.2:4.2":"samaṇānaṃ paripucchasi;","thig13.2:4.3":"Tesaṃ te kittayissāmi,","thig13.2:4.4":"paññāsīlaparakkamaṃ.","thig13.2:5.1":"“Kammakāmā analasā,","thig13.2:5.2":"kammaseṭṭhassa kārakā;","thig13.2:5.3":"Rāgaṃ dosaṃ pajahanti,","thig13.2:5.4":"tena me samaṇā piyā.","thig13.2:6.1":"“Tīṇi pāpassa mūlāni,","thig13.2:6.2":"dhunantntti sucikārino;","thig13.2:6.3":"Sabbaṃ pāpaṃ pahīnesaṃ,","thig13.2:6.4":"tena me samaṇā piyā.","thig13.2:7.1":"“Kāyakammaṃ suci nesaṃ,","thig13.2:7.2":"vacīkammañca tādisaṃ;","thig13.2:7.3":"Manokammaṃ suci nesaṃ,","thig13.2:7.4":"tena me samaṇā piyā.","thig13.2:8.1":"“Vimalā saṅkhamuttāva,","thig13.2:8.2":"suddhā santarabāhirā;","thig13.2:8.3":"Puṇṇā sukkāna dhammānaṃ [sukkehi dhammehi (sī. syā. aṭṭha.)],","thig13.2:8.4":"tena me samaṇā piyā.","thig13.2:9.1":"“Bahussutā dhammadharā,","thig13.2:9.2":"ariyā dhammajīvino;","thig13.2:9.3":"Atthaṃ dhammañca desenti,","thig13.2:9.4":"tena me samaṇā piyā.","thig13.2:10.1":"“Bahussutā dhammadharā,","thig13.2:10.2":"ariyā dhammajīvino;","thig13.2:10.3":"Ekaggacittā satimanto,","thig13.2:10.4":"tena me samaṇā piyā.","thig13.2:11.1":"“Dūraṅgamā satimanto,","thig13.2:11.2":"mantabhāṇī anuddhatā;","thig13.2:11.3":"Dukkhassantaṃ pajānanti,","thig13.2:11.4":"tena me samaṇā piyā.","thig13.2:12.1":"“Yasmā gāmā pakkamanti,","thig13.2:12.2":"na vilokenti kiñcanaṃ;","thig13.2:12.3":"Anapekkhāva gacchanti,","thig13.2:12.4":"tena me samaṇā piyā.","thig13.2:13.1":"“Na tesaṃ koṭṭhe openti,","thig13.2:13.2":"na kumbhiṃ na khaḷopiyaṃ;","thig13.2:13.3":"Pariniṭṭhitamesānā,","thig13.2:13.4":"tena me samaṇā piyā.","thig13.2:14.1":"“Na te hiraññaṃ gaṇhanti,","thig13.2:14.2":"na suvaṇṇaṃ na rūpiyaṃ;","thig13.2:14.3":"Paccuppannena yāpenti,","thig13.2:14.4":"tena me samaṇā piyā.","thig13.2:15.1":"“Nānākulā pabbajitā,","thig13.2:15.2":"nānājanapadehi ca;","thig13.2:15.3":"Aññamaññaṃ piyāyanti [pihayanti (ka.)],","thig13.2:15.4":"tena me samaṇā piyā”.","thig13.2:16.1":"“Atthāya vata no bhoti,","thig13.2:16.2":"kule jātāsi rohinī;","thig13.2:16.3":"Saddhā buddhe ca dhamme ca,","thig13.2:16.4":"saṅghe ca tibbagāravā.","thig13.2:17.1":"“Tuvaṃ hetaṃ pajānāsi,","thig13.2:17.2":"puññakkhettaṃ anuttaraṃ;","thig13.2:17.3":"Amhampi ete samaṇā,","thig13.2:17.4":"paṭigaṇhanti dakkhiṇaṃ”.","thig13.2:18.1":"“Patiṭṭhito hettha yañño,","thig13.2:18.2":"vipulo no bhavissati;","thig13.2:18.3":"Sace bhāyasi dukkhassa,","thig13.2:18.4":"sace te dukkhamappiyaṃ.","thig13.2:19.1":"“Upehi saraṇaṃ buddhaṃ,","thig13.2:19.2":"dhammaṃ saṅghañca tādinaṃ;","thig13.2:19.3":"Samādiyāhi sīlāni,","thig13.2:19.4":"taṃ te atthāya hehiti”.","thig13.2:20.1":"“Upemi saraṇaṃ buddhaṃ,","thig13.2:20.2":"dhammaṃ saṅghañca tādinaṃ;","thig13.2:20.3":"Samādiyāmi sīlāni,","thig13.2:20.4":"taṃ me atthāya hehiti.","thig13.2:21.1":"“Brahmabandhu pure āsiṃ,","thig13.2:21.2":"so idānimhi brāhmaṇo;","thig13.2:21.3":"Tevijjo sottiyo camhi,","thig13.2:21.4":"vedagū camhi nhātako”.","thig13.2:22.1":"… Rohinī therī …."},"unsure":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":3452,"to":3452,"paras":[{"para":3452,"vripara":null,"refs":["thig13.2:21"],"lines":["Evaṃ brāhmaṇo saraṇesu sīlesu ca patiṭṭhito aparabhāge sañjātasaṃvego pabbajitvā vipassanaṃ vaḍḍhetvā arahatte patiṭṭhāya attano paṭipattiṃ paccavekkhitvā udānento <b>“brahmabandhū”</b>ti gāthamāha.","Tassattho heṭṭhā vuttoyeva."],"lineRefs":[["thig13.2:21"],["thig13.2:21"]]}],"wordLinks":[["thig13.2:21.1","brahmabandhū",0,0]],"before":[{"para":3316,"vripara":null,"refs":[],"lines":["Evaṃ ayaṃ therī attano attabhāve aniccatāya sallakkhaṇamukhena sabbesupi tebhūmakadhammesu aniccataṃ upadhāretvā tadanusārena tattha dukkhalakkhaṇaṃ anattalakkhaṇañca āropetvā vipassanaṃ ussukkāpentī maggapaṭipāṭiyā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.4.204-219)–"],"lineRefs":[[],[]]},{"para":3317,"vripara":null,"refs":[],"lines":["“Yo raṃsiphusitāveḷo, phusso nāma mahāmuni;"],"lineRefs":[[]]},{"para":3318,"vripara":null,"refs":[],"lines":["Tassāhaṃ bhaginī āsiṃ, ajāyiṃ khattiye kule."],"lineRefs":[[]]},{"para":3319,"vripara":null,"refs":[],"lines":["“Tassa dhammaṃ suṇitvāhaṃ, vippasannena cetasā;"],"lineRefs":[[]]},{"para":3320,"vripara":null,"refs":[],"lines":["Mahādānaṃ daditvāna, patthayiṃ rūpasampadaṃ."],"lineRefs":[[]]},{"para":3321,"vripara":null,"refs":[],"lines":["“Ekatiṃse ito kappe, sikhī lokagganāyako;"],"lineRefs":[[]]},{"para":3322,"vripara":null,"refs":[],"lines":["Uppanno lokapajjoto, tilokasaraṇo jino."],"lineRefs":[[]]},{"para":3323,"vripara":null,"refs":[],"lines":["“Tadāruṇapure ramme, brahmaññakulasambhavā;"],"lineRefs":[[]]},{"para":3324,"vripara":null,"refs":[],"lines":["Vimuttacittaṃ kupitā, bhikkhuniṃ abhisāpayiṃ."],"lineRefs":[[]]},{"para":3325,"vripara":null,"refs":[],"lines":["“Vesikāva anācārā, jinasāsanadūsikā;"],"lineRefs":[[]]},{"para":3326,"vripara":null,"refs":[],"lines":["Evaṃ akkosayitvāna, tena pāpena kammunā."],"lineRefs":[[]]},{"para":3327,"vripara":null,"refs":[],"lines":["“Dāruṇaṃ nirayaṃ gantvā, mahādukkhasamappitā;"],"lineRefs":[[]]},{"para":3328,"vripara":null,"refs":[],"lines":["Tato cutā manussesu, upapannā tapassinī."],"lineRefs":[[]]},{"para":3329,"vripara":null,"refs":[],"lines":["“Dasajātisahassāni, gaṇikattamakārayiṃ;"],"lineRefs":[[]]},{"para":3330,"vripara":null,"refs":[],"lines":["Tamhā pāpā na muccissaṃ, bhutvā duṭṭhavisaṃ yathā."],"lineRefs":[[]]},{"para":3331,"vripara":null,"refs":[],"lines":["“Brahmacariyamasevissaṃ, kassape jinasāsane;"],"lineRefs":[[]]},{"para":3332,"vripara":null,"refs":[],"lines":["Tena kammavipākena, ajāyiṃ tidase pure."],"lineRefs":[[]]},{"para":3333,"vripara":null,"refs":[],"lines":["“Pacchime bhave sampatte, ahosiṃ opapātikā;"],"lineRefs":[[]]},{"para":3334,"vripara":null,"refs":[],"lines":["Ambasākhantare jātā, ambapālīti tenahaṃ."],"lineRefs":[[]]},{"para":3335,"vripara":null,"refs":[],"lines":["“Parivutā pāṇakoṭīhi, pabbajiṃ jinasāsane;"],"lineRefs":[[]]},{"para":3336,"vripara":null,"refs":[],"lines":["Pattāhaṃ acalaṃ ṭhānaṃ, dhītā buddhassa orasā."],"lineRefs":[[]]},{"para":3337,"vripara":null,"refs":[],"lines":["“Iddhīsu ca vasī homi, sotadhātuvisuddhiyā;"],"lineRefs":[[]]},{"para":3338,"vripara":null,"refs":[],"lines":["Cetopariyañāṇassa, vasī homi mahāmuni."],"lineRefs":[[]]},{"para":3339,"vripara":null,"refs":[],"lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"],"lineRefs":[[]]},{"para":3340,"vripara":null,"refs":[],"lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."],"lineRefs":[[]]},{"para":3341,"vripara":null,"refs":[],"lines":["“Atthadhammaniruttīsu, paṭibhāne tatheva ca;"],"lineRefs":[[]]},{"para":3342,"vripara":null,"refs":[],"lines":["Ñāṇaṃ me vimalaṃ suddhaṃ, buddhaseṭṭhassa vāhasā."],"lineRefs":[[]]},{"para":3343,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ, bhavā sabbe samūhatā;"],"lineRefs":[[]]},{"para":3344,"vripara":null,"refs":[],"lines":["Nāgīva bandhanaṃ chetvā, viharāmi anāsavā."],"lineRefs":[[]]},{"para":3345,"vripara":null,"refs":[],"lines":["“Svāgataṃ vata me āsi, buddhaseṭṭhassa santike;"],"lineRefs":[[]]},{"para":3346,"vripara":null,"refs":[],"lines":["Tisso vijjā anuppattā, kataṃ buddhassa sāsanaṃ."],"lineRefs":[[]]},{"para":3347,"vripara":null,"refs":[],"lines":["“Paṭisambhidā catasso, vimokkhāpi ca aṭṭhime;"],"lineRefs":[[]]},{"para":3348,"vripara":null,"refs":[],"lines":["Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":3349,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā attano paṭipattiṃ paccavekkhitvā udānavasena tā eva gāthā paccudāhāsīti."],"lineRefs":[[]]},{"para":3350,"vripara":null,"refs":[],"lines":["Ambapālītherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3351,"vripara":null,"refs":[],"lines":["Rohinītherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":3352,"vripara":null,"refs":[],"lines":["<b>Samaṇāti bhoti supī</b>tiādikā rohiniyā theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī ito ekanavutikappe vipassissa bhagavato kāle kulagehe nibbattitvā viññutaṃ patvā, ekadivasaṃ bandhumatīnagare bhagavantaṃ piṇḍāya carantaṃ disvā pattaṃ gahetvā pūvassa pūretvā bhagavato datvā pītisomanassajātā pañcapatiṭṭhitena vandi.","Sā tena puññakammena devamanussesu saṃsarantī anukkamena upacitavimokkhasambhārā hutvā imasmiṃ buddhuppāde vesāliyaṃ mahāvibhavassa brāhmaṇassa gehe nibbattitvā <b>rohinī</b>ti laddhanāmā viññutaṃ patvā, satthari vesāliyaṃ viharante vihāraṃ gantavā dhammaṃ sutvā sotāpannā hutvā mātāpitūnaṃ dhammaṃ desetvā sāsane pasādaṃ uppādetvā te anujānāpetvā sayaṃ pabbajitvā vipassanāya kammaṃ karontī na cirasseva saha paṭisambhidāhi arahattaṃ pāpuṇi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[]]},{"para":3353,"vripara":null,"refs":[],"lines":["“Nagare bandhumatiyā, vipassissa mahesino;"],"lineRefs":[[]]},{"para":3354,"vripara":null,"refs":[],"lines":["Piṇḍāya vicarantassa, pūvedāsimahaṃ tadā."],"lineRefs":[[]]},{"para":3355,"vripara":null,"refs":[],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":3356,"vripara":null,"refs":[],"lines":["Tattha cittaṃ pasādetvā, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":3357,"vripara":null,"refs":[],"lines":["“Chattiṃsadevarājūnaṃ, mahesittamakārayiṃ;"],"lineRefs":[[]]},{"para":3358,"vripara":null,"refs":[],"lines":["Paññāsacakkavattīnaṃ, mahesittamakārayiṃ."],"lineRefs":[[]]},{"para":3359,"vripara":null,"refs":[],"lines":["“Manasā patthitā nāma, sabbā mayhaṃ samijjhatha;"],"lineRefs":[[]]},{"para":3360,"vripara":null,"refs":[],"lines":["Sampattiṃ anubhotvāna, devesu manujesu ca."],"lineRefs":[[]]},{"para":3361,"vripara":null,"refs":[],"lines":["“Pacchime bhavasampatte, jāto vippakule ahaṃ;"],"lineRefs":[[]]},{"para":3362,"vripara":null,"refs":[],"lines":["Rohinī nāma nāmena, ñātakehi piyāyitā."],"lineRefs":[[]]},{"para":3363,"vripara":null,"refs":[],"lines":["“Bhikkhūnaṃ santikaṃ gantvā, dhammaṃ sutvā yathātathaṃ;"],"lineRefs":[[]]},{"para":3364,"vripara":null,"refs":[],"lines":["Saṃviggamānasā hutvā, pabbajiṃ anagāriyaṃ."],"lineRefs":[[]]},{"para":3365,"vripara":null,"refs":[],"lines":["“Yoniso padahantīnaṃ, arahattamapāpuṇiṃ;"],"lineRefs":[[]]},{"para":3366,"vripara":null,"refs":[],"lines":["Ekanavutito kappe, yaṃ dānamadadiṃ tadā;"],"lineRefs":[[]]},{"para":3367,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, pūvadānassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":3368,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":3369,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā attano paṭipattiṃ paccavekkhitvā pubbe sotāpannakāle pitarā attanā ca vacanapaṭivacanavasena vuttagāthā udānavasena bhāsantī –"],"lineRefs":[[]]},{"para":3371,"vripara":"271","refs":[],"lines":["“Samaṇāti bhoti supi, samaṇāti pabujjhasi;"],"lineRefs":[[]]},{"para":3372,"vripara":null,"refs":[],"lines":["Samaṇāneva kittesi, samaṇī nūna bhavissasi."],"lineRefs":[[]]},{"para":3374,"vripara":"272","refs":[],"lines":["“Vipulaṃ annañca pānañca, samaṇānaṃ pavecchasi;"],"lineRefs":[[]]},{"para":3375,"vripara":null,"refs":[],"lines":["Rohinī dāni pucchāmi, kena te samaṇā piyā."],"lineRefs":[[]]},{"para":3377,"vripara":"273","refs":[],"lines":["“Akammakāmā alasā, paradattūpajīvino;"],"lineRefs":[[]]},{"para":3378,"vripara":null,"refs":[],"lines":["Āsaṃsukā sādukāmā, kena te samaṇā piyā."],"lineRefs":[[]]},{"para":3380,"vripara":"274","refs":[],"lines":["“Cirassaṃ vata maṃ tāta, samaṇānaṃ paripucchasi;"],"lineRefs":[[]]},{"para":3381,"vripara":null,"refs":[],"lines":["Tesaṃ te kittayissāmi, paññāsīlaparakkamaṃ."],"lineRefs":[[]]},{"para":3383,"vripara":"275","refs":[],"lines":["“Kammakāmā analasā, kammaseṭṭhassa kārakā;"],"lineRefs":[[]]},{"para":3384,"vripara":null,"refs":[],"lines":["Rāgaṃ dosaṃ pajahanti, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3386,"vripara":"276","refs":[],"lines":["“Tīṇi pāpassa mūlāni, dhunanti sucikārino;"],"lineRefs":[[]]},{"para":3387,"vripara":null,"refs":[],"lines":["Sabbaṃ pāpaṃ pahīnesaṃ, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3389,"vripara":"277","refs":[],"lines":["“Kāyakammaṃ suci nesaṃ, vacīkammañca tādisaṃ;"],"lineRefs":[[]]},{"para":3390,"vripara":null,"refs":[],"lines":["Manokammaṃ suci nesaṃ, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3392,"vripara":"278","refs":[],"lines":["“Vimalā saṅkhamuttāva, suddhā santarabāhirā;"],"lineRefs":[[]]},{"para":3393,"vripara":null,"refs":[],"lines":["Puṇṇā sukkāna dhammānaṃ, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3395,"vripara":"279","refs":[],"lines":["“Bahussutā dhammadharā, ariyā dhammajīvino;"],"lineRefs":[[]]},{"para":3396,"vripara":null,"refs":[],"lines":["Atthaṃ dhammañca desenti, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3398,"vripara":"280","refs":[],"lines":["“Bahussutā dhammadharā, ariyā dhammajīvino;"],"lineRefs":[[]]},{"para":3399,"vripara":null,"refs":[],"lines":["Ekaggacittā satimanto, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3401,"vripara":"281","refs":[],"lines":["“Dūraṅgamā satimanto, mantabhāṇī anuddhatā;"],"lineRefs":[[]]},{"para":3402,"vripara":null,"refs":[],"lines":["Dukkhassantaṃ pajānanti, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3404,"vripara":"282","refs":[],"lines":["“Yasmā gāmā pakkamanti, na vilokenti kiñcanaṃ;"],"lineRefs":[[]]},{"para":3405,"vripara":null,"refs":[],"lines":["Anapekkhāva gacchanti, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3407,"vripara":"283","refs":[],"lines":["“Na te saṃ koṭṭhe openti, na kumbhiṃ na khaḷopiyaṃ;"],"lineRefs":[[]]},{"para":3408,"vripara":null,"refs":[],"lines":["Pariniṭṭhitamesānā, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3410,"vripara":"284","refs":[],"lines":["“Na te hiraññaṃ gaṇhanti, na suvaṇṇaṃ na rūpiyaṃ;"],"lineRefs":[[]]},{"para":3411,"vripara":null,"refs":[],"lines":["Paccuppannena yāpenti, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3413,"vripara":"285","refs":[],"lines":["“Nānākulā pabbajitā, nānājanapadehi ca;"],"lineRefs":[[]]},{"para":3414,"vripara":null,"refs":[],"lines":["Aññamaññaṃ pihayanti, tena me samaṇā piyā."],"lineRefs":[[]]},{"para":3416,"vripara":"286","refs":[],"lines":["“Atthāya vata no bhoti, kule jātāsi rohinī;"],"lineRefs":[[]]},{"para":3417,"vripara":null,"refs":[],"lines":["Saddhā buddhe ca dhamme ca, saṅghe ca tibbagāravā."],"lineRefs":[[]]},{"para":3419,"vripara":"287","refs":[],"lines":["“Tuvañhetaṃ pajānāsi, puññakkhettaṃ anuttaraṃ;"],"lineRefs":[[]]},{"para":3420,"vripara":null,"refs":[],"lines":["Amhampi ete samaṇā, paṭiggaṇhanti dakkhiṇaṃ."],"lineRefs":[[]]},{"para":3422,"vripara":"288","refs":[],"lines":["“Patiṭṭhito hettha yañño, vipulo no bhavissati;"],"lineRefs":[[]]},{"para":3423,"vripara":null,"refs":[],"lines":["Sace bhāyasi dukkhassa, sace te dukkhamappiyaṃ."],"lineRefs":[[]]},{"para":3425,"vripara":"289","refs":[],"lines":["“Upehi saraṇaṃ buddhaṃ, dhammaṃ saṅghañca tādinaṃ;"],"lineRefs":[[]]},{"para":3426,"vripara":null,"refs":[],"lines":["Samādiyāhi sīlāni, taṃ te atthāya hehiti."],"lineRefs":[[]]},{"para":3428,"vripara":"290","refs":[],"lines":["“Upemi saraṇaṃ buddhaṃ, dhammaṃ saṅghañca tādinaṃ;"],"lineRefs":[[]]},{"para":3429,"vripara":null,"refs":[],"lines":["Samādiyāmi sīlāni, taṃ me atthāya hehiti."],"lineRefs":[[]]},{"para":3431,"vripara":"291","refs":[],"lines":["“Brahmabandhu pure āsiṃ, so idānimhi brāhmaṇo;"],"lineRefs":[[]]},{"para":3432,"vripara":null,"refs":[],"lines":["Tevijjo sottiyo camhi, vedagū camhi nhātako”ti.","–"],"lineRefs":[[],[]]},{"para":3433,"vripara":null,"refs":[],"lines":["Imā gāthā paccudāhāsi."],"lineRefs":[[]]},{"para":3434,"vripara":null,"refs":[],"lines":["Tattha ādito tisso gāthā attano dhītu bhikkhūsu sammutiṃ anicchantena vuttā.","Tattha <b>samaṇāti bhoti supī</b>ti bhoti tvaṃ supanakālepi “samaṇā samaṇā”ti kittentī samaṇapaṭibaddhaṃyeva kathaṃ kathentī supasi.","<b>Samaṇāti pabujjhasī</b>ti supanato uṭṭhahantīpi “samaṇā” iccevaṃ vatvā pabujjhasi niddāya vuṭṭhāsi.","<b>Samaṇāneva kittesī</b>ti sabbakālampi samaṇe eva samaṇānameva vā guṇe kittesi abhitthavasi.","<b>Samaṇī nūna bhavissasī</b>ti gihirūpena ṭhitāpi cittena samaṇī eva maññe bhavissasi.","Atha vā <b>samaṇī nūna bhavissasī</b>ti idāni gihirūpena ṭhitāpi na cireneva samaṇī eva maññe bhavissasi samaṇesu eva ninnapoṇabhāvato."],"lineRefs":[[],[],[],[],[],[]]},{"para":3435,"vripara":null,"refs":[],"lines":["<b>Pavecchasī</b>ti desi.","<b>Rohinī dāni pucchāmī</b>ti, amma rohini, taṃ ahaṃ idāni pucchāmīti brāhmaṇo attano dhītaraṃ pucchanto āha.","<b>Kena te samaṇā piyā</b>ti, amma rohini, tvaṃ sayantīpi pabujjhantīpi aññadāpi samaṇānameva guṇe kittayasi, kena nāma kāraṇena tuyhaṃ samaṇā piyāyitabbā jātāti attho."],"lineRefs":[[],[],[]]},{"para":3436,"vripara":null,"refs":[],"lines":["Idāni brāhmaṇo samaṇesu dosaṃ dhītu ācikkhanto <b>“akammakāmā”</b>ti gāthamāha.","Tattha <b>akammakāmā</b>ti na kammakāmā, attano paresañca atthāvahaṃ kiñci kammaṃ na kātukāmā.","<b>Alasā</b>ti kusītā.","<b>Paradattūpajīvino</b>ti parehi dinneneva upajīvanasīlā.","<b>Āsaṃsukā</b>ti tato eva ghāsacchādanādīnaṃ āsīsanakā.","<b>Sādukāmā</b>ti sāduṃ madhurameva āhāraṃ icchanakā.","Sabbametaṃ brāhmaṇo samaṇānaṃ guṇe ajānanto attanāva parikappitaṃ dosamāha."],"lineRefs":[[],[],[],[],[],[],[]]},{"para":3437,"vripara":null,"refs":[],"lines":["Taṃ sutvā rohinī “laddho dāni me okāso ayyānaṃ guṇe kathetun”ti tuṭṭhamānasā bhikkhūnaṃ guṇe kittetukāmā paṭhamaṃ tāva tesaṃ kittane somanassaṃ pavedentī <b>“cīrassaṃ vata maṃ, tātā”</b>ti gāthamāha.","Tattha <b>cirassaṃ vatā</b>ti cirena vata.","<b>Tātā</b>ti pitaraṃ ālapati.","<b>Samaṇānan</b>ti samaṇe samaṇānaṃ vā mayhaṃ piyāyitabbaṃ paripucchasi.","<b>Tesan</b>ti samaṇānaṃ.","<b>Paññāsīlaparakkaman</b>ti paññañca sīlañca ussāhañca."],"lineRefs":[[],[],[],[],[],[]]},{"para":3438,"vripara":null,"refs":[],"lines":["<b>Kittayissāmī</b>ti kathayissāmi.","Paṭijānetvā te kittentī “akammakāmā alasā”ti tena vuttaṃ dosaṃ tāva nibbeṭhetvā tappaṭipakkhabhūtaṃ guṇaṃ dassetuṃ <b>“kammakāmā”</b>tiādimāha.","Tattha <b>kammakāmā</b>ti vattapaṭivattādibhedaṃ kammaṃ samaṇakiccaṃ paripūraṇavasena kāmenti icchantīti kammakāmā.","Tattha yuttappayuttā hutvā uṭṭhāya samuṭṭhāya vāyamanato na alasāti <b>analasā</b>.","Taṃ pana kammaṃ seṭṭhaṃ uttamaṃ nibbānāvahameva karontīti <b>kammaseṭṭhassa kārakā</b>.","Karontā pana taṃ paṭipattiyā anavajjabhāvato <b>rāgaṃ dosaṃ pajahanti,</b> yathā rāgadosā pahīyanti, evaṃ samaṇā kammaṃ karonti.","<b>Tena me samaṇā piyā</b>ti tena yathāvuttena sammāpaṭipajjanena mayhaṃ samaṇā piyāyitabbāti attho."],"lineRefs":[[],[],[],[],[],[],[]]},{"para":3439,"vripara":null,"refs":[],"lines":["<b>Tīṇi pāpassa mūlānī</b>ti lobhadosamohasaṅkhātāni akusalassa tīṇi mūlāni.","<b>Dhunantī</b>ti nigghātenti, pajahantīti attho.","<b>Sucikārino</b>ti anavajjakammakārino.","<b>Sabbaṃ pāpaṃ pahīnesan</b>ti aggamaggādhigamena esaṃ sabbampi pāpaṃ pahīnaṃ."],"lineRefs":[[],[],[],[]]},{"para":3440,"vripara":null,"refs":[],"lines":["Evaṃ “samaṇā sucikārino”ti saṅkhepato vuttamatthaṃ vibhajitvā dassetuṃ <b>“kāyakamman”</b>ti gāthamāha.","Taṃ suviññeyyameva."],"lineRefs":[[],[]]},{"para":3441,"vripara":null,"refs":[],"lines":["<b>Vimalā saṅkhamuttāvā</b>ti sudhotasaṅkhā viya muttā viya ca vigatamalā rāgādimalarahitā.","<b>Suddhā santarabāhirā</b>ti santarañca bāhirañca santarabāhiraṃ.","Tato santarabāhirato suddhā, suddhāsayapayogāti attho.","<b>Puṇṇā sukkāna dhammānan</b>ti ekantasukkehi anavajjadhammehi paripuṇṇā, asekhehi sīlakkhandhādīhi samannāgatāti attho."],"lineRefs":[[],[],[],[]]},{"para":3442,"vripara":null,"refs":[],"lines":["Suttageyyādibahuṃ sutaṃ etesaṃ, sutena vā uppannāti <b>bahussutā,</b> pariyattibāhusaccena paṭivedhabāhusaccena ca samannāgatāti attho.","Tameva duvidhampi dhammaṃ dhārentīti <b>dhammadharā</b>.","Sattānaṃ ācārasamācārasikkhāpadena arīyantīti <b>ariyā</b>.","Dhammena ñāyena jīvantīti <b>dhammajīvino.</b>","<b>Atthaṃ dhammañca desentī</b>ti bhāsitatthañca desanādhammañca kathenti pakāsenti.","Atha vā atthato anapetaṃ dhammato anapetañca desenti ācikkhanti."],"lineRefs":[[],[],[],[],[],[]]},{"para":3443,"vripara":null,"refs":[],"lines":["<b>Ekaggacittā</b>ti samāhitacittā.","<b>Satimanto</b>ti upaṭṭhitasatino."],"lineRefs":[[],[]]},{"para":3444,"vripara":null,"refs":[],"lines":["<b>Dūraṅgamā</b>ti araññagatā, manussūpacāraṃ muñcitvā dūraṃ gacchantā, iddhānubhāvena vā yathārucitaṃ dūraṃ ṭhānaṃ gacchantīti dūraṅgamā.","Mantā vuccati paññā, tāya bhaṇanasīlatāya <b>mantabhāṇī</b>.","Na uddhatāti <b>anuddhatā,</b> uddhaccarahitā vūpasantacittā.","<b>Dukkhassantaṃ pajānantī</b>ti vaṭṭadukkhassa pariyantabhūtaṃ nibbānaṃ paṭivijjhanti."],"lineRefs":[[],[],[],[]]},{"para":3445,"vripara":null,"refs":[],"lines":["<b>Na vilokenti kiñcanan</b>ti yato gāmato pakkamanti, tasmiṃ gāme kañci sattaṃ vā saṅkhāraṃ vā apekkhāvasena na olokenti, atha kho pana anapekkhāva gacchanti pakkamanti."],"lineRefs":[[]]},{"para":3446,"vripara":null,"refs":[],"lines":["<b>Na te saṃ koṭṭhe opentī</b>ti te samaṇā saṃ attano santakaṃ sāpateyyaṃ koṭṭhe na openti na paṭisāmetvā ṭhapenti tādisassa pariggahassa abhāvato.","<b>Kumbhin</b>ti kumbhiyaṃ.","<b>Khaḷopiyan</b>ti pacchiyaṃ.","<b>Pariniṭṭhitamesānā</b>ti parakulesu paresaṃ atthāya siddhameva ghāsaṃ pariyesantā."],"lineRefs":[[],[],[],[]]},{"para":3447,"vripara":null,"refs":[],"lines":["<b>Hiraññan</b>ti kahāpaṇaṃ.","<b>Rūpiyan</b>ti rajataṃ.","<b>Paccuppannena yāpentī</b>ti atītaṃ ananusocantā anāgatañca apaccāsīsantā paccuppannena yāpenti attabhāvaṃ pavattenti."],"lineRefs":[[],[],[]]},{"para":3448,"vripara":null,"refs":[],"lines":["<b>Aññamaññaṃ pihayantī</b>ti aññamaññasmiṃ mettiṃ karonti.","“Pihāyanti” pi pāṭho, so eva attho."],"lineRefs":[[],[]]},{"para":3449,"vripara":null,"refs":[],"lines":["Evaṃ so brāhmaṇo dhītuyā santike bhikkhūnaṃ guṇe sutvā pasannamānaso dhītaraṃ pasaṃsanto <b>“atthāya vatā”</b>tiādimāha."],"lineRefs":[[]]},{"para":3450,"vripara":null,"refs":[],"lines":["<b>Amhampī</b>ti amhākampi.","<b>Dakkhiṇan</b>ti deyyadhammaṃ."],"lineRefs":[[],[]]},{"para":3451,"vripara":null,"refs":[],"lines":["<b>Etthā</b>ti etesu samaṇesu.","<b>Yañño</b>ti dānadhammo.","<b>Vipulo</b>ti vipulaphalo.","Sesaṃ vuttanayameva."],"lineRefs":[[],[],[],[]]}]},"tika":null,"tika2":null}
