{"suttaId":"thag2.39","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1036,1042],"vripara":"197"},"segments":{"thag2.39:0.4":"Usabhattheragāthā","thag2.39:1.1":"“Ambapallavasaṅkāsaṃ, aṃse katvāna cīvaraṃ;","thag2.39:1.3":"Nisinno hatthigīvāyaṃ, gāmaṃ piṇḍāya pāvisiṃ.","thag2.39:2.1":"“Hatthikkhandhato oruyha, saṃvegaṃ alabhiṃ tadā;","thag2.39:2.3":"Sohaṃ ditto tadā santo, patto me āsavakkhayo”ti.","thag2.39:2.5":"… Usabho thero …."},"attha":null,"tika":null}
