{"suttaId":"an6.140","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[851,851],"vripara":"140"},"segments":{"an6.140:0.3":"Rāgapeyyālaṃ","an6.140:1.1":"“Rāgassa, bhikkhave, abhiññāya cha dhammā bhāvetabbā.","an6.140:1.2":"Katame cha?","an6.140:1.3":"Dassanānuttariyaṃ, savanānuttariyaṃ, lābhānuttariyaṃ, sikkhānuttariyaṃ, pāricariyānuttariyaṃ, anussatānuttariyaṃ.","an6.140:1.4":"Rāgassa, bhikkhave, abhiññāya ime cha dhammā bhāvetabbā”ti."},"unsure":[],"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":787,"to":787,"paras":[{"para":787,"vripara":"140","refs":["an6.140:1"],"lines":["<b>Rāgassā</b>ti pañcakāmaguṇikarāgassa.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["an6.140:1"],["an6.140:1"]]}],"wordLinks":[["an6.140:1.1","rāgassā",0,0],["an6.140:1.4","rāgassā",0,0]],"before":[{"para":786,"vripara":null,"refs":[],"lines":["Rāgapeyyālavaṇṇanā"],"lineRefs":[[]]}],"after":[{"para":788,"vripara":null,"lines":["Manorathapūraṇiyā aṅguttaranikāya-aṭṭhakathāya"]},{"para":789,"vripara":null,"lines":["Chakkanipātassa saṃvaṇṇanā niṭṭhitā."]},{"para":790,"vripara":null,"lines":["Namo tassa bhagavato arahato sammāsambuddhassa"]},{"para":791,"vripara":null,"lines":["Aṅguttaranikāye"]},{"para":792,"vripara":null,"lines":["Sattakanipāta-aṭṭhakathā"]}]},"tika":null,"tika2":null}
