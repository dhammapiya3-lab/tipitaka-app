{"suttaId":"tha-ap263","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8401,8417],"vripara":"1"},"segments":{"tha-ap263:0.3":"Ākāsukkhipiyattheraapadānaṃ","tha-ap263:1.1":"“Suvaṇṇavaṇṇaṃ siddhatthaṃ,","tha-ap263:1.2":"gacchantaṃ antarāpaṇe;","tha-ap263:1.3":"Jalajagge duve gayha,","tha-ap263:1.4":"upāgacchiṃ narāsabhaṃ.","tha-ap263:2.1":"“Ekañca pupphaṃ pādesu,","tha-ap263:2.2":"buddhaseṭṭhassa nikkhipiṃ;","tha-ap263:2.3":"Ekañca pupphaṃ paggayha,","tha-ap263:2.4":"ākāse ukkhipiṃ ahaṃ.","tha-ap263:3.1":"“Catunnavutito kappe,","tha-ap263:3.2":"yaṃ pupphamabhiropayiṃ;","tha-ap263:3.3":"Duggatiṃ nābhijānāmi,","tha-ap263:3.4":"pupphadānassidaṃ phalaṃ.","tha-ap263:4.1":"“Ito chattiṃsakappamhi,","tha-ap263:4.2":"eko āsiṃ mahīpati;","tha-ap263:4.3":"Antalikkhakaro nāma,","tha-ap263:4.4":"cakkavattī mahabbalo.","tha-ap263:5.1":"“Paṭisambhidā catasso,","tha-ap263:5.2":"vimokkhāpi ca aṭṭhime;","tha-ap263:5.3":"Chaḷabhiññā sacchikatā,","tha-ap263:5.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap263:6.1":"Itthaṃ sudaṃ āyasmā ākāsukkhipiyo thero imā gāthāyo abhāsitthāti.","tha-ap263:7.1":"Ākāsukkhipiyattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3222,"to":3222,"paras":[{"para":3222,"vripara":"1-2","refs":["tha-ap263:1"],"lines":["1-2. Sattavīsatime vagge paṭhamāpadāne <b>jalajagge duve gayhā</b>ti jale udake jāte agge uppalādayo dve pupphe gahetvā buddhassa samīpaṃ gantvā ekaṃ pupphaṃ pādesu <b>nikkhipiṃ</b> pūjesiṃ, ekaṃ pupphaṃ ākāse khipinti attho."],"lineRefs":[["tha-ap263:1"]]}],"wordLinks":[["tha-ap263:1.3","jalajagge duve gayhā",0,0]]},"tika":null,"tika2":null}
