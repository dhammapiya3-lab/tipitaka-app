{"suttaId":"sn46.175-184","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[870,875],"vripara":null},"segments":{"sn46.175-184:0.3":"Punaoghādisuttaṃ","sn46.175-184:1.2":"Bojjhaṅgasaṃyutassa punaoghavaggo aṭṭhārasamo.","sn46.175-184:2.0":"Uddānaṃ –","sn46.175-184:2.1":"Ogho yogo upādānaṃ,","sn46.175-184:2.2":"ganthā anusayena ca;","sn46.175-184:2.3":"Kāmaguṇā nīvaraṇā,","sn46.175-184:2.4":"khandhā oruddhambhāgiyānīti.","sn46.175-184:3.1":"(Rāgavinayapariyosāna-dosavinayapariyosāna-mohavinayapariyosānavaggo vitthāretabbo).","sn46.175-184:3.2":"(Yadapi maggasaṃyuttaṃ vitthāretabbaṃ, tadapi bojjhaṅgasaṃyuttaṃ vitthāretabbaṃ).","sn46.175-184:3.3":"Bojjhaṅgasaṃyuttaṃ dutiyaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
