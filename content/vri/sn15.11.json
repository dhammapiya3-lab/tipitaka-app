{"suttaId":"sn15.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[912,912],"vripara":"134"},"segments":{"sn15.11:0.3":"Duggatasuttaṃ","sn15.11:1.1":"Ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati.","sn15.11:1.2":"Tatra kho bhagavā bhikkhu āmantesi – “bhikkhavo”ti. “Bhadante”ti te bhikkhū bhagavato paccassosuṃ. Bhagavā etadavoca –","sn15.11:1.3":"“anamataggoyaṃ, bhikkhave, saṃsāro.","sn15.11:1.4":"Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ.","sn15.11:1.5":"Yaṃ, bhikkhave, passeyyātha duggataṃ durūpetaṃ niṭṭhamettha gantabbaṃ –","sn15.11:1.6":"‘amhehipi evarūpaṃ paccanubhūtaṃ iminā dīghena addhunā’ti.","sn15.11:1.7":"Taṃ kissa hetu … pe …","sn15.11:1.8":"yāvañcidaṃ, bhikkhave, alameva sabbasaṅkhāresu nibbindituṃ alaṃ virajjituṃ alaṃ vimuccitun”ti.","sn15.11:1.9":"Paṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":639,"to":639,"paras":[{"para":639,"vripara":"134","refs":["sn15.11:1"],"lines":["Dutiyavaggassa paṭhame <b>duggatan</b>ti daliddaṃ kapaṇaṃ.","<b>Durūpetan</b>ti dussaṇṭhānehi hatthapādehi upetaṃ.","Paṭhamaṃ."],"lineRefs":[["sn15.11:1"],["sn15.11:1"],["sn15.11:1"]]}],"wordLinks":[["sn15.11:1.5","duggataṃ",0,0],["sn15.11:1.5","durūpetaṃ",0,1]],"before":[{"para":637,"vripara":null,"title":"Dutiyavaggo","lines":["Dutiyavaggo"]},{"para":638,"vripara":null,"title":"Duggatasuttavaṇṇanā","lines":["Duggatasuttavaṇṇanā"]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":651,"to":651,"paras":[{"para":651,"vripara":"134","refs":["sn15.11:1"],"lines":["<b>Duggatan</b>ti kicchajīvikattā sabbathā dukkhaṃ gataṃ upagataṃ.","Tathābhūto pana daliddo varāko nāma hotīti vuttaṃ <b>“daliddaṃ kapaṇan”</b>ti.","<b>Hatthapādehī</b>ti nidassanamattaṃ, aññehipi sarīrāvayavehi dussaṇṭhānehi upeto durupeto evāti."],"lineRefs":[["sn15.11:1"],["sn15.11:1"],["sn15.11:1"]]}],"wordLinks":[["sn15.11:1.5","duggataṃ",0,0]],"after":[{"para":652,"vripara":null,"title":"Duggatasuttavaṇṇanā","lines":["Duggatasuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
