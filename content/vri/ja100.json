{"suttaId":"ja100","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[558,566],"vripara":"100"},"segments":{"ja100:0.4":"Asātarūpajātakaṃ","ja100:1.1":"Asātaṃ sātarūpena, piyarūpena appiyaṃ;","ja100:1.3":"Dukkhaṃ sukhassa rūpena, pamattamativattatīti.","ja100:2.1":"Asātarūpajātakaṃ dasamaṃ.","ja100:2.2":"Littavaggo dasamo.","ja100:3.1":"Tassuddānaṃ –","ja100:4.1":"Gilamakkhakutūhala mātukassā, muninā ca aniccata pattavaraṃ;","ja100:4.3":"Dhanapālivaro atipaṇḍitako, saparosahassaasātadasāti.","ja100:5.1":"Majjhimo paṇṇāsako."},"attha":null,"tika":null}
