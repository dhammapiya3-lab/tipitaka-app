{"suttaId":"iti58","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"It","vriCode":"s0504m.mul","paras":[530,537],"vripara":"58"},"segments":{"iti58:0.4":"Taṇhāsuttaṃ","iti58:1.1":"Vuttañhetaṃ bhagavatā, vuttamarahatāti me sutaṃ –","iti58:2.1":"“Tisso imā, bhikkhave, taṇhā.","iti58:2.2":"Katamā tisso?","iti58:2.3":"Kāmataṇhā, bhavataṇhā, vibhavataṇhā –","iti58:2.4":"imā kho, bhikkhave, tisso taṇhā”ti.","iti58:2.5":"Etamatthaṃ bhagavā avoca.","iti58:2.6":"Tatthetaṃ iti vuccati –","iti58:3.1":"“Taṇhāyogena saṃyuttā,","iti58:3.2":"rattacittā bhavābhave;","iti58:3.3":"Te yogayuttā mārassa,","iti58:3.4":"ayogakkhemino janā;","iti58:3.5":"Sattā gacchanti saṃsāraṃ,","iti58:3.6":"jātīmaraṇagāmino.","iti58:4.1":"“Ye ca taṇhaṃ pahantvāna,","iti58:4.2":"vītataṇhā [nikkaṇhā ca (sī. ka.)] bhavābhave;","iti58:4.3":"Te ve [te ca (sī. pī. ka.)] pāraṅgatā [pāragatā (ka. sī. syā.)] loke,","iti58:4.4":"ye pattā āsavakkhaya”nti.","iti58:5.1":"Ayampi attho vutto bhagavatā, iti me sutanti.","iti58:5.2":"Navamaṃ. 10."},"unsure":[],"preface":[],"attha":{"book":"It-a","bookName":"Itivuttaka-aṭṭhakathā","vriCode":"s0504a.att","from":961,"to":970,"paras":[{"para":961,"vripara":"58","refs":["iti58:2"],"lines":["Navame taṇhāyanaṭṭhena <b>taṇhā,</b> rūpādivisayaṃ tasatīti vā <b>taṇhā</b>.","Idāni taṃ vibhajitvā dassetuṃ <b>“kāmataṇhā”</b>tiādi vuttaṃ.","Tattha pañcakāmaguṇiko rāgo <b>kāmataṇhā</b>.","Rūpārūpabhavesu chandarāgo jhānanikanti sassatadiṭṭhisahagato rāgo bhavavasena patthanā ca <b>bhavataṇhā</b>.","Ucchedadiṭṭhisahagato rāgo <b>vibhavataṇhā</b>.","Apica pacchimataṇhādvayaṃ ṭhapetvā sesā sabbāpi taṇhā kāmataṇhā eva.","Yathāha –"],"lineRefs":[["iti58:2"],["iti58:2"],["iti58:2"],["iti58:2"],["iti58:2"],["iti58:2"],["iti58:2"]]},{"para":962,"vripara":null,"refs":["iti58:2"],"lines":["“Tattha katamā bhavataṇhā?","Sassatadiṭṭhisahagato rāgo sārāgo cittassa sārāgo – ayaṃ vuccati bhavataṇhā.","Tattha katamā vibhavataṇhā?","Ucchedadiṭṭhisahagato rāgo sārāgo cittassa sārāgo, ayaṃ vuccati vibhavataṇhā.","Avasesā taṇhā kāmataṇhā”ti (vibha. 916)."],"lineRefs":[["iti58:2"],["iti58:2"],["iti58:2"],["iti58:2"],["iti58:2"]]},{"para":963,"vripara":null,"refs":["iti58:2"],"lines":["Imā ca tisso taṇhā rūpataṇhā…pe… dhammataṇhāti visayabhedato paccekaṃ chabbidhāti katvā aṭṭhārasa honti.","Tā ajjhattarūpādīsu aṭṭhārasa, bahiddhārūpādīsu aṭṭhārasāti chattiṃsa, iti atītā chattiṃsa, anāgatā chattiṃsa, paccuppannā chattiṃsāti vibhāgato aṭṭhasataṃ honti.","Puna saṅgahe kariyamāne kālabhedaṃ anāmasitvā gayhamānā chattiṃseva honti, rūpādīnaṃ ajjhattikabāhiravibhāge akariyamāne aṭṭhāraseva, rūpādiārammaṇavibhāgamatte gayhamāne chaḷeva, ārammaṇavibhāgampi akatvā gayhamānā tissoyeva hontīti."],"lineRefs":[["iti58:2"],["iti58:2"],["iti58:2"]]},{"para":964,"vripara":null,"refs":["iti58:3"],"lines":["Gāthāsu <b>taṇhāyogenā</b>ti taṇhāsaṅkhātena yogena, kāmayogena, bhavayogena ca.","<b>Saṃyuttā</b>ti sambandhā, bhavādīsu saṃyojitā vā.","Tenevāha <b>“rattacittā bhavābhave”</b>ti.","Khuddake ceva mahante ca bhave laggacittāti attho.","Atha vā <b>bhavo</b>ti sassatadiṭṭhi, <b>abhavo</b>ti ucchedadiṭṭhi.","Tasmā bhavābhave sassatucchedadiṭṭhīsu sattavisattacittāti.","Etena bhavataṇhā, vibhavataṇhā ca dassitā.","Imasmiṃ pakkhe “taṇhāyogenā”ti iminā kāmataṇhāva dassitāti veditabbā.","<b>Te yogayuttā mārassā</b>ti te evaṃbhūtā puggalā mārassa pāsasaṅkhātena yogena yuttā baddhā.","Rāgo hi mārayogo mārapāsoti vuccati.","Yathāha –"],"lineRefs":[["iti58:3"],["iti58:3"],["iti58:3"],["iti58:3"],["iti58:3"],["iti58:3"],["iti58:3"],["iti58:3"],["iti58:3"],["iti58:3"],["iti58:3"]]},{"para":965,"vripara":null,"refs":["iti58:3"],"lines":["“Antalikkhacaro pāso, yvāyaṃ carati mānaso;"],"lineRefs":[["iti58:3"]]},{"para":966,"vripara":null,"refs":["iti58:3"],"lines":["Tena taṃ bādhayissāmi, na me samaṇa mokkhasī”ti. (saṃ. ni. 1.151; mahāva. 33);"],"lineRefs":[["iti58:3"]]},{"para":967,"vripara":null,"refs":["iti58:3"],"lines":["Catūhi yogehi anupaddutattā yogakkhemaṃ, nibbānaṃ arahattañca, tassa anadhigamena <b>ayogakkhemino</b>.","Uparūpari kilesābhisaṅkhārānaṃ jananato <b>janā,</b> pāṇino.","Rūpādīsu sattā visattāti <b>sattā</b>."],"lineRefs":[["iti58:3"],["iti58:3"],["iti58:3"]]},{"para":968,"vripara":null,"refs":["iti58:3"],"lines":["“Khandhānañca paṭipāṭi, dhātuāyatanāna ca;"],"lineRefs":[["iti58:3"]]},{"para":969,"vripara":null,"refs":["iti58:3"],"lines":["Abbocchinnaṃ vattamānā, saṃsāroti pavuccatī”ti. –"],"lineRefs":[["iti58:3"]]},{"para":970,"vripara":null,"refs":["iti58:3","iti58:4"],"lines":["Evaṃ vuttaṃ khandhādīnaṃ aparāparuppattisaṅkhātaṃ <b>saṃsāraṃ gacchanti,</b> tato na muccanti.","Kasmā?","Taṇhāyogayuttattā.","<b>Jātimaraṇagāmino</b> punappunaṃ jananamaraṇasseva upagamanasīlāti.","Ettāvatā vaṭṭaṃ dassetvā idāni vivaṭṭaṃ dassetuṃ <b>“ye ca taṇhaṃ pahantvānā”</b>ti gāthamāha.","Sā heṭṭhā vuttanayattā suviññeyyāva."],"lineRefs":[["iti58:3"],["iti58:3"],["iti58:3"],["iti58:3"],["iti58:4"],["iti58:4"]]}],"wordLinks":[["iti58:2.1","taṇhā",0,0],["iti58:2.3","taṇhā",0,0],["iti58:2.3","kāmataṇhā",0,1],["iti58:2.3","kāmataṇhā",0,2],["iti58:2.3","bhavataṇhā",0,3],["iti58:2.3","vibhavataṇhā",0,4],["iti58:3.1","taṇhāyogenā",3,0],["iti58:3.1","saṃyuttā",3,1],["iti58:3.1","rattacittā bhavābhave",3,2],["iti58:3.1","bhavo",3,4],["iti58:3.3","te yogayuttā mārassā",3,8],["iti58:3.3","ayogakkhemino",6,0],["iti58:3.3","janā",6,1],["iti58:3.5","sattā",6,2],["iti58:4.1","ye ca taṇhaṃ pahantvānā",9,4]],"after":[{"para":971,"vripara":null,"title":"Taṇhāsuttavaṇṇanā","lines":["Navamasuttavaṇṇanā niṭṭhitā. 10."]}]},"tika":null,"tika2":null}
