{"suttaId":"sn1.81","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[879,892],"vripara":"81"},"segments":{"sn1.81:0.3":"Araṇasuttaṃ","sn1.81:1.1":"“Kesūdha araṇā loke,","sn1.81:1.2":"kesaṃ vusitaṃ na nassati;","sn1.81:1.3":"Kedha icchaṃ parijānanti,","sn1.81:1.4":"kesaṃ bhojissiyaṃ sadā.","sn1.81:2.1":"“Kiṃsu mātā pitā bhātā,","sn1.81:2.2":"vandanti naṃ patiṭṭhitaṃ;","sn1.81:2.3":"Kiṃsu idha jātihīnaṃ,","sn1.81:2.4":"abhivādenti khattiyā”ti.","sn1.81:3.1":"“Samaṇīdha araṇā loke,","sn1.81:3.2":"samaṇānaṃ vusitaṃ na nassati;","sn1.81:3.3":"Samaṇā icchaṃ parijānanti,","sn1.81:3.4":"samaṇānaṃ bhojissiyaṃ sadā.","sn1.81:4.1":"“Samaṇaṃ mātā pitā bhātā,","sn1.81:4.2":"vandanti naṃ patiṭṭhitaṃ;","sn1.81:4.3":"Samaṇīdha jātihīnaṃ,","sn1.81:4.4":"abhivādenti khattiyā”ti.","sn1.81:4.5":"Chetvāvaggo aṭṭhamo.","sn1.81:5.0":"Tassuddānaṃ –","sn1.81:5.1":"Chetvā rathañca cittañca,","sn1.81:5.2":"vuṭṭhi bhītā najīrati;","sn1.81:5.3":"Issaraṃ kāmaṃ pātheyyaṃ,","sn1.81:5.4":"pajjoto araṇena cāti.","sn1.81:5.5":"Devatāsaṃyuttaṃ samattaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":499,"to":499,"paras":[{"para":499,"vripara":"81","refs":["sn1.81:1","sn1.81:3","sn1.81:4"],"lines":["Ekādasame <b>araṇā</b>ti nikkilesā.","<b>Vusita</b>nti vusitavāso.","<b>Bhojissiya</b>nti adāsabhāvo.","<b>Samaṇā</b>ti khīṇāsavasamaṇā.","Te hi ekantena araṇā nāma.","<b>Vusitaṃ na nassatī</b>ti tesaṃ ariyamaggavāso na nassati.","<b>Parijānantī</b>ti puthujjanakalyāṇakato paṭṭhāya sekhā lokiyalokuttarāya pariññāya parijānanti.","<b>Bhojissiya</b>nti khīṇāsavasamaṇānaṃyeva niccaṃ bhujissabhāvo nāma.","<b>Vandantī</b>ti pabbajitadivasato paṭṭhāya vandanti.","<b>Patiṭṭhita</b>nti sīle patiṭṭhitaṃ.","<b>Samaṇīdhā</b>ti samaṇaṃ idha.","<b>Jātihīna</b>nti api caṇḍālakulā pabbajitaṃ.","<b>Khattiyā</b>ti na kevalaṃ khattiyāva, devāpi sīlasampannaṃ samaṇaṃ vandantiyevāti.","Ekādasamaṃ."],"lineRefs":[["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:3"],["sn1.81:3"],["sn1.81:3"],["sn1.81:3"],["sn1.81:3"],["sn1.81:4"],["sn1.81:4"],["sn1.81:4"],["sn1.81:4"],["sn1.81:4"],["sn1.81:4"]]}],"wordLinks":[["sn1.81:1.1","araṇā",0,0],["sn1.81:1.1","vusitaṃ",0,1],["sn1.81:1.3","bhojissiyaṃ",0,2],["sn1.81:3.1","samaṇā",0,3],["sn1.81:3.3","samaṇā",0,3],["sn1.81:3.1","vusitaṃ na nassatī",0,5],["sn1.81:3.3","parijānantī",0,6],["sn1.81:3.3","bhojissiyaṃ",0,7],["sn1.81:4.1","vandantī",0,8],["sn1.81:4.1","patiṭṭhitaṃ",0,9],["sn1.81:4.3","samaṇīdhā",0,10],["sn1.81:4.3","jātihīnaṃ",0,11],["sn1.81:4.3","khattiyā",0,12]],"before":[{"para":498,"vripara":null,"title":"Araṇasuttavaṇṇanā","lines":["Araṇasuttavaṇṇanā 81."]}],"after":[{"para":500,"vripara":null,"title":"Araṇasuttavaṇṇanā","lines":["Chetvāvaggo aṭṭhamo."]},{"para":501,"vripara":null,"title":"Araṇasuttavaṇṇanā","lines":["Iti sāratthappakāsiniyā"]},{"para":502,"vripara":null,"title":"Araṇasuttavaṇṇanā","lines":["Saṃyuttanikāya-aṭṭhakathāya"]},{"para":503,"vripara":null,"title":"Araṇasuttavaṇṇanā","lines":["Devatāsaṃyuttavaṇṇanā niṭṭhitā. 2."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":626,"to":626,"paras":[{"para":626,"vripara":"81","refs":["sn1.81:1","sn1.81:2","sn1.81:3","sn1.81:4"],"lines":["Raṇanti kandanti etehīti raṇā, rāgādayo.","Tehi abhibhūtatāya hi sattā nānappakāraṃ kandanti paridevanti.","Te pana sabbaso natthi etesaṃ raṇāti <b>araṇā.</b>","<b>Nikkilesā</b> khīṇāsavā.","<b>Vusitavāso</b>ti vusitabrahmacariyavāso.","<b>Bhojissiya</b>nti bhujissabhāvo.","Tenāha <b>“adāsabhāvo”</b>ti.","<b>Samaṇā</b>ti samitapāpasamaṇāti āha <b>“khīṇāsavasamaṇā”</b>ti.","Puthujjanakalyāṇakāle lokiyapariññāya, <b>sekkhā</b> pubbabhāge lokiyapariññāya, paccavekkhaṇe <b>lokiyalokuttarāya pariññāya</b> pariññeyyaṃ tebhūmakaṃ khandhapañcakaṃ <b>parijānanti</b> paricchijjanti.","Khīṇāsavā pana pariññātapariññeyyā honti.","Tathā hi te sāmī hutvā paribhuñjanti.","<b>Vandanti naṃ patiṭṭhita</b>nti vuttaṃ, vandanīyabhāvo ca sīlasampannatāyāti āha <b>“patiṭṭhitanti sīle patiṭṭhita”</b>nti.","<b>Idhā</b>ti imasmiṃ loke.","<b>Khattiyā</b>ti lakkhaṇavacananti āha <b>“na kevalaṃ khattiyāvā”</b>tiādi."],"lineRefs":[["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:3"],["sn1.81:3"],["sn1.81:3"],["sn1.81:3"],["sn1.81:4"],["sn1.81:2"],["sn1.81:2"]]}],"wordLinks":[["sn1.81:1.1","araṇā",0,2],["sn1.81:1.3","bhojissiyaṃ",0,5],["sn1.81:3.1","samaṇā",0,7],["sn1.81:3.3","samaṇā",0,7],["sn1.81:3.3","parijānanti",0,8],["sn1.81:4.1","vandanti naṃ patiṭṭhitaṃ",0,11],["sn1.81:2.3","idhā",0,12],["sn1.81:2.3","khattiyā",0,13]],"before":[{"para":625,"vripara":null,"title":"Araṇasuttavaṇṇanā","lines":["Araṇasuttavaṇṇanā 81."]}],"after":[{"para":627,"vripara":null,"title":"Araṇasuttavaṇṇanā","lines":["Araṇasuttavaṇṇanā niṭṭhitā."]},{"para":628,"vripara":null,"title":"Araṇasuttavaṇṇanā","lines":["Chetvāvaggavaṇṇanā niṭṭhitā."]},{"para":629,"vripara":null,"title":"Araṇasuttavaṇṇanā","lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"]},{"para":630,"vripara":null,"title":"Araṇasuttavaṇṇanā","lines":["Devatāsaṃyuttavaṇṇanāya līnatthappakāsanā samattā. 2."]}]},"tika2":null}
