{"suttaId":"sn1.81","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[879,892],"vripara":"81"},"segments":{"sn1.81:0.3":"Araṇasuttaṃ","sn1.81:1.1":"“Kesūdha araṇā loke, kesaṃ vusitaṃ na nassati;","sn1.81:1.3":"Kedha icchaṃ parijānanti, kesaṃ bhojissiyaṃ sadā.","sn1.81:2.1":"“Kiṃsu mātā pitā bhātā, vandanti naṃ patiṭṭhitaṃ;","sn1.81:2.3":"Kiṃsu idha jātihīnaṃ, abhivādenti khattiyā”ti.","sn1.81:3.1":"“Samaṇīdha araṇā loke, samaṇānaṃ vusitaṃ na nassati;","sn1.81:3.3":"Samaṇā icchaṃ parijānanti, samaṇānaṃ bhojissiyaṃ sadā.","sn1.81:4.1":"“Samaṇaṃ mātā pitā bhātā, vandanti naṃ patiṭṭhitaṃ;","sn1.81:4.3":"Samaṇīdha jātihīnaṃ, abhivādenti khattiyā”ti.","sn1.81:4.5":"Chetvāvaggo aṭṭhamo.","sn1.81:5.0":"Tassuddānaṃ –","sn1.81:5.1":"Chetvā rathañca cittañca, vuṭṭhi bhītā najīrati;","sn1.81:5.3":"Issaraṃ kāmaṃ pātheyyaṃ, pajjoto araṇena cāti.","sn1.81:5.5":"Devatāsaṃyuttaṃ samattaṃ."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":499,"to":499,"paras":[{"para":499,"vripara":"81","refs":["sn1.81:1","sn1.81:3","sn1.81:4"],"lines":["Ekādasame <b>araṇā</b>ti nikkilesā.","<b>Vusitan</b>ti vusitavāso.","<b>Bhojissiyan</b>ti adāsabhāvo.","<b>Samaṇā</b>ti khīṇāsavasamaṇā.","Te hi ekantena araṇā nāma.","<b>Vusitaṃ na nassatī</b>ti tesaṃ ariyamaggavāso na nassati.","<b>Parijānantī</b>ti puthujjanakalyāṇakato paṭṭhāya sekhā lokiyalokuttarāya pariññāya parijānanti.","<b>Bhojissiyan</b>ti khīṇāsavasamaṇānaṃyeva niccaṃ bhujissabhāvo nāma.","<b>Vandantī</b>ti pabbajitadivasato paṭṭhāya vandanti.","<b>Patiṭṭhitan</b>ti sīle patiṭṭhitaṃ.","<b>Samaṇīdhā</b>ti samaṇaṃ idha.","<b>Jātihīnan</b>ti api caṇḍālakulā pabbajitaṃ.","<b>Khattiyā</b>ti na kevalaṃ khattiyāva, devāpi sīlasampannaṃ samaṇaṃ vandantiyevāti.","Ekādasamaṃ."],"lineRefs":[["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:3"],["sn1.81:3"],["sn1.81:3"],["sn1.81:3"],["sn1.81:3"],["sn1.81:4"],["sn1.81:4"],["sn1.81:4"],["sn1.81:4"],["sn1.81:4"],["sn1.81:4"]]}],"wordLinks":[["sn1.81:1.1","araṇā",0,0],["sn1.81:1.1","vusitaṃ",0,1],["sn1.81:1.3","bhojissiyaṃ",0,2],["sn1.81:3.1","samaṇā",0,3],["sn1.81:3.3","samaṇā",0,3],["sn1.81:3.1","vusitaṃ na nassatī",0,5],["sn1.81:3.3","parijānantī",0,6],["sn1.81:3.3","bhojissiyaṃ",0,7],["sn1.81:4.1","vandantī",0,8],["sn1.81:4.1","patiṭṭhitaṃ",0,9],["sn1.81:4.3","samaṇīdhā",0,10],["sn1.81:4.3","jātihīnaṃ",0,11],["sn1.81:4.3","khattiyā",0,12]],"before":[{"para":498,"vripara":null,"refs":[],"lines":["Araṇasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":626,"to":626,"paras":[{"para":626,"vripara":"81","refs":["sn1.81:1","sn1.81:2","sn1.81:3","sn1.81:4"],"lines":["Raṇanti kandanti etehīti raṇā, rāgādayo.","Tehi abhibhūtatāya hi sattā nānappakāraṃ kandanti paridevanti.","Te pana sabbaso natthi etesaṃ raṇāti <b>araṇā.</b>","<b>Nikkilesā</b> khīṇāsavā.","<b>Vusitavāso</b>ti vusitabrahmacariyavāso.","<b>Bhojissiyan</b>ti bhujissabhāvo.","Tenāha <b>“adāsabhāvo”</b>ti.","<b>Samaṇā</b>ti samitapāpasamaṇāti āha <b>“khīṇāsavasamaṇā”</b>ti.","Puthujjanakalyāṇakāle lokiyapariññāya, <b>sekkhā</b> pubbabhāge lokiyapariññāya, paccavekkhaṇe <b>lokiyalokuttarāya pariññāya</b> pariññeyyaṃ tebhūmakaṃ khandhapañcakaṃ <b>parijānanti</b> paricchijjanti.","Khīṇāsavā pana pariññātapariññeyyā honti.","Tathā hi te sāmī hutvā paribhuñjanti.","<b>Vandanti naṃ patiṭṭhitan</b>ti vuttaṃ, vandanīyabhāvo ca sīlasampannatāyāti āha <b>“patiṭṭhitanti sīle patiṭṭhitan”</b>ti.","<b>Idhā</b>ti imasmiṃ loke.","<b>Khattiyā</b>ti lakkhaṇavacananti āha <b>“na kevalaṃ khattiyāvā”</b>tiādi."],"lineRefs":[["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:1"],["sn1.81:3"],["sn1.81:3"],["sn1.81:3"],["sn1.81:3"],["sn1.81:4"],["sn1.81:2"],["sn1.81:2"]]}],"wordLinks":[["sn1.81:1.1","araṇā",0,2],["sn1.81:1.3","bhojissiyaṃ",0,5],["sn1.81:3.1","samaṇā",0,7],["sn1.81:3.3","samaṇā",0,7],["sn1.81:3.3","parijānanti",0,8],["sn1.81:4