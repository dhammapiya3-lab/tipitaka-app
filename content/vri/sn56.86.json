{"suttaId":"sn56.86","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[2783,2783],"vripara":"1156"},"segments":{"sn56.86:0.3":"Kumārikasuttaṃ","sn56.86:1.1":"… Pe …“evameva kho, bhikkhave, appakā te sattā ye itthikumārikapaṭiggahaṇā [itthikumārikāpaṭiggahaṇā (ka.)] paṭiviratā; atha kho eteva bahutarā sattā ye itthikumārikapaṭiggahaṇā appaṭiviratā … pe ….","sn56.86:1.2":"Chaṭṭhaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":969,"to":969,"paras":[{"para":969,"vripara":"1156","refs":["sn56.86:1"],"words":["itthikumārikapaṭiggahaṇā","itthī","kumārikā"],"lines":["<b>Itthikumārikapaṭiggahaṇā</b>ti ettha <b>itthī</b>ti purisantaragatā, itarā <b>kumārikā</b> nāma.","Tāsaṃ paṭiggahaṇampi āmasanampi akappiyameva."],"lineRefs":[["sn56.86:1"],["sn56.86:1"]]}]},"tika":null}
