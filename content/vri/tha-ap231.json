{"suttaId":"tha-ap231","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7935,7950],"vripara":"43"},"segments":{"tha-ap231:0.3":"Sukatāveḷiyattheraapadānaṃ","tha-ap231:1.1":"“Asito nāma nāmena,","tha-ap231:1.2":"mālākāro ahaṃ [ahuṃ (?)] tadā;","tha-ap231:1.3":"Āveḷaṃ paggahetvāna,","tha-ap231:1.4":"rañño dātuṃ vajāmahaṃ. 44.","tha-ap231:2.1":"“Asampattomhi [asampattamhi (sī.), asampattova (?)] rājānaṃ,","tha-ap231:2.2":"addasaṃ sikhināyakaṃ;","tha-ap231:2.3":"Haṭṭho haṭṭhena cittena,","tha-ap231:2.4":"buddhassa abhiropayiṃ. 45.","tha-ap231:3.1":"“Ekattiṃse ito kappe,","tha-ap231:3.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap231:3.3":"Duggatiṃ nābhijānāmi,","tha-ap231:3.4":"buddhapūjāyidaṃ phalaṃ. 46.","tha-ap231:4.1":"“Pañcavīse ito kappe,","tha-ap231:4.2":"rājāhosiṃ mahabbalo;","tha-ap231:4.3":"Vebhāro nāma nāmena,","tha-ap231:4.4":"cakkavattī mahabbalo. 47.","tha-ap231:5.1":"“Paṭisambhidā catasso…pe…","tha-ap231:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap231:6.1":"Itthaṃ sudaṃ āyasmā sukatāveḷiyo thero imā gāthāyo abhāsitthāti.","tha-ap231:7.1":"Sukatāveḷiyattherassāpadānaṃ navamaṃ. 10."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
