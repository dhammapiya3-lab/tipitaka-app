{"suttaId":"thag2.28","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[937,943],"vripara":"175"},"segments":{"thag2.28:0.4":"Bharatattheragāthā","thag2.28:1.1":"“Ehi nandaka gacchāma, upajjhāyassa santikaṃ;","thag2.28:1.3":"Sīhanādaṃ nadissāma, buddhaseṭṭhassa sammukhā.","thag2.28:2.1":"“Yāya no anukampāya, amhe pabbājayī muni;","thag2.28:2.3":"So no attho anuppatto, sabbasaṃyojanakkhayo”ti.","thag2.28:2.5":"… Bharato thero …."},"attha":null,"tika":null}
