{"suttaId":"sn20.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1298,1298],"vripara":"223"},"segments":{"sn20.1:0.3":"Kūṭasuttaṃ","sn20.1:1.1":"Evaṃ me sutaṃ –","sn20.1:1.2":"ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme.","sn20.1:1.3":"Tatra kho bhagavā bhikkhū āmantesi – “bhikkhavo”ti. “Bhadante”ti te bhikkhū bhagavato paccassosuṃ. Bhagavā etadavoca –","sn20.1:1.4":"“seyyathāpi, bhikkhave, kūṭāgārassa yā kāci gopānasiyo sabbā tā kūṭaṅgamā kūṭasamosaraṇā kūṭasamugghātā sabbā tā samugghātaṃ gacchanti;","sn20.1:1.5":"evameva kho, bhikkhave, ye keci akusalā dhammā sabbe te avijjāmūlakā avijjāsamosaraṇā avijjāsamugghātā, sabbe te samugghātaṃ gacchanti.","sn20.1:1.6":"Tasmātiha, bhikkhave, evaṃ sikkhitabbaṃ –","sn20.1:1.7":"‘appamattā viharissāmā’ti.","sn20.1:1.8":"Evañhi vo, bhikkhave, sikkhitabban”ti.","sn20.1:1.9":"Paṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":897,"to":897,"paras":[{"para":897,"vripara":"223","refs":["sn20.1:1"],"lines":["Opammasaṃyuttassa paṭhame kūṭaṃ gacchantīti <b>kūṭaṅgamā</b>.","Kūṭaṃ samosarantīti <b>kūṭasamosaraṇā.</b>","<b>Kūṭasamugghātā</b>ti kūṭassa samugghātena.","<b>Avijjāsamugghātā</b>ti arahattamaggena avijjāya samugghātena.","<b>Appamattā</b>ti satiyā avippavāse ṭhitā hutvā.","Paṭhamaṃ."],"lineRefs":[["sn20.1:1"],["sn20.1:1"],["sn20.1:1"],["sn20.1:1"],["sn20.1:1"],["sn20.1:1"]]}],"wordLinks":[["sn20.1:1.4","kūṭaṅgamā",0,0],["sn20.1:1.4","kūṭasamosaraṇā",0,1],["sn20.1:1.4","kūṭasamugghātā",0,2],["sn20.1:1.5","avijjāsamugghātā",0,3],["sn20.1:1.7","appamattā",0,4]]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":925,"to":925,"paras":[{"para":925,"vripara":"223","refs":["sn20.1:1"],"lines":["<b>Kūṭaṃ gacchantī</b>ti kūṭacchiddassa anupavisanavasena kūṭaṃ gacchanti.","Yā ca gopānasiyo gopānasantaragatā, tāpi kūṭaṃ āhacca ṭhānena <b>kūṭaṅgamā</b>.","Duvidhāpi kūṭe samosaraṇā.","<b>Kūṭassa samugghātena</b> vināsena bhijjanena.","<b>Avijjāya samugghātenā</b>ti avijjāya accantameva appavattiyā.","Tena ca mokkhadhammādhigamena tadanurūpadhammādhigamo dassito.","<b>Appamattā</b>ti pana iminā tassa upāyo dassito."],"lineRefs":[["sn20.1:1"],["sn20.1:1"],["sn20.1:1"],["sn20.1:1"],["sn20.1:1"],["sn20.1:1"],["sn20.1:1"]]}],"wordLinks":[["sn20.1:1.4","kūṭaṅgamā",0,1],["sn20.1:1.7","appamattā",0,6]],"after":[{"para":926,"vripara":null,"title":"Kūṭasuttavaṇṇanā","lines":["Kūṭasuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
