{"suttaId":"sn56.91","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[2798,2798],"vripara":"1161"},"segments":{"sn56.91:0.3":"Khettavatthusuttaṃ","sn56.91:1.1":"… Pe … “evameva kho, bhikkhave, appakā te sattā ye khettavatthupaṭiggahaṇā paṭiviratā; atha kho eteva bahutarā sattā ye khettavatthupaṭiggahaṇā appaṭiviratā … pe ….","sn56.91:1.2":"Paṭhamaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":974,"to":974,"paras":[{"para":974,"vripara":"1161","refs":["sn56.91:1"],"lines":["<b>Ajeḷakā</b> dīsu <b>khettavatthu</b> pariyosānesu kappiyākappiyanayo vinayavasena upaparikkhitabbo.","Tattha khettaṃ nāma yasmiṃ pubbaṇṇaṃ ruhati.","Vatthu nāma yasmiṃ aparaṇṇaṃ ruhati.","Yattha vā ubhayaṃ ruhati, taṃ khettaṃ.","Tadatthāya akatabhūmibhāgo vatthu.","Khettavatthusīsena cettha vāpitaḷākādīnipi saṅgahitāneva."],"lineRefs":[["sn56.91:1"],["sn56.91:1"],["sn56.91:1"],["sn56.91:1"],["sn56.91:1"],["sn56.91:1"]]}],"wordLinks":[["sn56.91:1.1","khettavatthu",0,0]],"before":[{"para":972,"vripara":null,"refs":[],"lines":["Catutthaāmakadhaññapeyyālavaggo"],"lineRefs":[[]]},{"para":973,"vripara":null,"refs":[],"lines":["Khettavatthusuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
