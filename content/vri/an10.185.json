{"suttaId":"an10.185","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[1416,1417],"vripara":"185"},"segments":{"an10.185:0.3":"Tapanīyasuttaṃ","an10.185:1.1":"“Tapanīyañca vo, bhikkhave, dhammaṃ desessāmi atapanīyañca.","an10.185:1.2":"Taṃ suṇātha … pe … katamo ca, bhikkhave, tapanīyo dhammo?","an10.185:1.4":"Pāṇātipāto … pe … micchādiṭṭhi – ayaṃ vuccati, bhikkhave, tapanīyo dhammo.","an10.185:2.1":"“Katamo ca, bhikkhave, atapanīyo dhammo?","an10.185:2.2":"Pāṇātipātā veramaṇī … pe … sammādiṭṭhi – ayaṃ vuccati, bhikkhave, atapanīyo dhammo”ti.","an10.185:2.5":"Aṭṭhamaṃ."},"attha":null,"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":765,"to":769,"paras":[{"para":765,"vripara":"167-210","refs":["an10.185:1"],"lines":["167-210. Dutiye ca paṭhamādīni uttānatthāni.","Dasame <b>pacchābhūmivāsino</b>ti paccantadesavāsino.","<b>Sevālamālikā</b>ti pātova udakaṃ orohitvā sevālañceva uppalādīni ca gahetvā attano udakasuddhikabhāvajānanatthañceva “lokassa ca udakena suddhi hotī”ti imassa atthassa jānanatthañca mālaṃ katvā pilandhanakā.","<b>Udakorohakā</b>ti pāto majjhanhe sāyanhe ca udakaorohaṇakā.","Tenāha <b>“sāyatatiyakaṃ udakorohaṇānuyogamanuyuttā”</b>ti.","Ekādasamādīni uttānatthāni.","Catutthe paṇṇāsake natthi vattabbaṃ."],"lineRefs":[["an10.185:1"],["an10.185:1"],["an10.185:1"],["an10.185:1"],["an10.185:1"],["an10.185:1"],["an10.185:1"]]},{"para":766,"vripara":null,"refs":["an10.185:1"],"lines":["Brāhmaṇapaccorohaṇīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an10.185:1"]]},{"para":767,"vripara":null,"refs":["an10.185:1"],"lines":["Catutthapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an10.185:1"]]},{"para":768,"vripara":null,"refs":["an10.185:1"],"lines":["(21)1. Karajakāyavaggo"],"lineRefs":[["an10.185:1"]]},{"para":769,"vripara":null,"refs":["an10.185:1"],"lines":["1-536. Paṭhamanirayasaggasuttādivaṇṇanā"],"lineRefs":[["an10.185:1"]]}],"wordLinks":[]},"tika2":null}
