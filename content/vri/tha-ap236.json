{"suttaId":"tha-ap236","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8018,8033],"vripara":"14"},"segments":{"tha-ap236:0.3":"Kilañjadāyakattheraapadānaṃ","tha-ap236:1.1":"“Tivarāyaṃ pure ramme, naḷakāro ahaṃ tadā;","tha-ap236:1.3":"Siddhatthe lokapajjote, pasannā janatā tahiṃ.","tha-ap236:2.1":"“Pūjatthaṃ lokanāthassa, kilañjaṃ pariyesati;","tha-ap236:2.3":"Buddhapūjaṃ karontānaṃ, kilañjaṃ adadiṃ ahaṃ.","tha-ap236:3.1":"“Catunnavutito kappe, yaṃ kammamakariṃ tadā;","tha-ap236:3.3":"Duggatiṃ nābhijānāmi, kilañjassa idaṃ phalaṃ.","tha-ap236:4.1":"“Sattasattatikappamhi, rājā āsiṃ jaladdharo [jutindharo (sī.)];","tha-ap236:4.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap236:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap236:6.1":"Itthaṃ sudaṃ āyasmā kilañjadāyako thero imā gāthāyo abhāsitthāti.","tha-ap236:7.1":"Kilañjadāyakattherassāpadānaṃ catutthaṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3188,"to":3188,"paras":[{"para":3188,"vripara":"14","refs":["tha-ap236:1"],"lines":["Catutthāpadāne <b>tivarāyaṃ pure ramme</b>ti tīhi pākārehi parivāritā parikkhittāti tivarā, khajjabhojjādiupabhogavatthābharaṇādinaccagītādīhi ramaṇīyanti rammaṃ, tasmiṃ tivarāyaṃ pure nagare <b>ramme</b> naḷakāro ahaṃ ahosinti sambandho."],"lineRefs":[["tha-ap236:1"]]}],"wordLinks":[["tha-ap236:1.1","ramme",0,0],["tha-ap236:1.1","tivarāyaṃ pure ramme",0,0]]},"tika":null,"tika2":null}
