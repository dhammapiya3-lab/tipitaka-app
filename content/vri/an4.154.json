{"suttaId":"an4.154","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1228,1228],"vripara":"154"},"segments":{"an4.154:0.3":"Satibalasuttaṃ","an4.154:1.1":"“Cattārimāni, bhikkhave, balāni.","an4.154:1.2":"Katamāni cattāri?","an4.154:1.3":"Satibalaṃ, samādhibalaṃ, anavajjabalaṃ, saṅgahabalaṃ –","an4.154:1.4":"imāni kho, bhikkhave, cattāri balānī”ti.","an4.154:1.5":"Catutthaṃ. 5."},"unsure":[],"preface":[],"attha":null,"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1647,"to":1649,"paras":[{"para":1647,"vripara":"151-155","refs":["an4.154:1"],"lines":["Catutthassa paṭhamādīni uttānāneva."],"lineRefs":[["an4.154:1"]]},{"para":1648,"vripara":null,"refs":["an4.154:1"],"lines":["Indriyasuttādivaṇṇanā niṭṭhitā. 6-8."],"lineRefs":[["an4.154:1"]]},{"para":1649,"vripara":null,"refs":["an4.154:1"],"lines":["Kappasuttādivaṇṇanā 156-158."],"lineRefs":[["an4.154:1"]]}],"wordLinks":[]},"tika2":null}
