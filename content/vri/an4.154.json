{"suttaId":"an4.154","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1228,1228],"vripara":"154"},"segments":{"an4.154:0.3":"Satibalasuttaṃ","an4.154:1.1":"“Cattārimāni, bhikkhave, balāni.","an4.154:1.2":"Katamāni cattāri?","an4.154:1.3":"Satibalaṃ, samādhibalaṃ, anavajjabalaṃ, saṅgahabalaṃ – imāni kho, bhikkhave, cattāri balānī”ti.","an4.154:1.5":"Catutthaṃ."},"attha":null,"tika":null}
