{"suttaId":"tha-ap207","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7497,7509],"vripara":"21"},"segments":{"tha-ap207:0.3":"Nigguṇḍipupphiyattheraapadānaṃ","tha-ap207:1.1":"“Vipassissa bhagavato, āsimārāmiko ahaṃ;","tha-ap207:1.3":"Nigguṇḍipupphaṃ paggayha, buddhassa abhiropayiṃ.","tha-ap207:2.1":"“Ekanavutito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap207:2.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap207:3.1":"“Pañcavīse [pañcatiṃse (sī. syā.)] ito kappe, eko āsiṃ janādhipo;","tha-ap207:3.3":"Mahāpatāpanāmena, cakkavattī mahabbalo.","tha-ap207:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap207:5.1":"Itthaṃ sudaṃ āyasmā nigguṇḍipupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap207:6.1":"Nigguṇḍipupphiyattherassāpadānaṃ pañcamaṃ."},"attha":null,"tika":null,"tika2":null}
