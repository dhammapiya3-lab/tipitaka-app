{"suttaId":"thag2.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[843,849],"vripara":"153"},"segments":{"thag2.17:0.4":"Tissattheragāthā","thag2.17:1.1":"“Bahū sapatte labhati, muṇḍo saṅghāṭipāruto;","thag2.17:1.3":"Lābhī annassa pānassa, vatthassa sayanassa ca.","thag2.17:2.1":"“Etamādīnavaṃ ñatvā, sakkāresu mahabbhayaṃ;","thag2.17:2.3":"Appalābho anavassuto, sato bhikkhu paribbaje”ti.","thag2.17:2.5":"… Tisso thero …."},"attha":null,"tika":null}
