{"suttaId":"thag2.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[843,849],"vripara":"153"},"segments":{"thag2.17:0.4":"Tissattheragāthā","thag2.17:1.1":"“Bahū sapatte labhati, muṇḍo saṅghāṭipāruto;","thag2.17:1.3":"Lābhī annassa pānassa, vatthassa sayanassa ca.","thag2.17:2.1":"“Etamādīnavaṃ ñatvā, sakkāresu mahabbhayaṃ;","thag2.17:2.3":"Appalābho anavassuto, sato bhikkhu paribbaje”ti.","thag2.17:2.5":"… Tisso thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":3580,"to":3580,"paras":[{"para":3580,"vripara":null,"refs":["thag2.17:2"],"lines":["Tassattho – sikhampi asesetvā muṇḍitakesatāya <b>muṇḍo,</b> chinditvā saṅghāṭitakāsāvadhāritāya <b>saṅghāṭipāruto,</b> evaṃ vevaṇṇiyaṃ ajjhupagato parāyattavuttiko pabbajito sace annapānādīnaṃ <b>lābhī</b> hoti, sopi <b>bahū sapatte labhati,</b> tassa usūyantā bahū sambhavanti.","Tasmā <b>etaṃ</b> evarūpaṃ lābha <b>sakkāresu mahabbhayaṃ</b> vipulabhayaṃ <b>ādīnavaṃ</b> dosaṃ viditvā appicchataṃ santosañca hadaye ṭhapetvā anavajjuppādassāpi uppannassa lābhassa parivajjanena <b>appalābho,</b> tato eva tattha taṇhāvassutābhāvena <b>anavassuto,</b> saṃsāre bhayassa ikkhanato bhinnakilesatāya vā <b>bhikkhu</b> santuṭṭhiṭṭhānīyassa satisampajaññassa vasena <b>sato</b> hutvā <b>paribbaje</b> careyya vihareyyāti.","Taṃ sutvā te bhikkhū tāvadeva theraṃ khamāpesuṃ."],"lineRefs":[["thag2.17:2"],["thag2.17:2"],["thag2.17:2"]]}],"wordLinks":[["thag2.17:2.3","lābhī",0,0],["thag2.17:2.1","etaṃ",0,1],["thag2.17:2.1","sakkāresu mahabbhayaṃ",0,1],["thag2.17:2.1","ādīnavaṃ",0,1],["thag2.17:2.3","anavassuto",0,1],["thag2.17:2.3","appalābho",0,1],["thag2.17:2.3","bhikkhu",0,1],["thag2.17:2.3","paribbaje",0,1],["thag2.17:2.3","sato",0,1]],"before":[{"para":3503,"vripara":null,"refs":[],"lines":["“Himavantassāvidūre, udaṅgaṇo nāma pabbato;"],"lineRefs":[[]]},{"para":3504,"vripara":null,"refs":[],"lines":["Tatthaddasaṃ paṃsukūlaṃ, dumaggamhi vilambitaṃ."],"lineRefs":[[]]},{"para":3505,"vripara":null,"refs":[],"lines":["“Tīṇi kiṅkaṇipupphāni, ocinitvānahaṃ tadā;"],"lineRefs":[[]]},{"para":3506,"vripara":null,"refs":[],"lines":["Haṭṭho haṭṭhena cittena, paṃsukūlamapūjayiṃ."],"lineRefs":[[]]},{"para":3507,"vripara":null,"refs":[],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":3508,"vripara":null,"refs":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":3509,"vripara":null,"refs":[],"lines":["“Ekanavutito kappe, yaṃ kammamakariṃ tadā;"],"lineRefs":[[]]},{"para":3510,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, pūjitvā arahaddhajaṃ."],"lineRefs":[[]]},{"para":3511,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":3512,"vripara":null,"refs":[],"lines":["Mahākāḷattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":3513,"vripara":null,"refs":[],"lines":["Tissattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":3514,"vripara":null,"refs":[],"lines":["<b>Bahū sapatte labhatī</b>ti āyasmato tissattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayaṃ puññaṃ upacinanto piyadassissa bhagavato kāle brāhmaṇakule nibbattitvā viññutaṃ patto sippesu nipphattiṃ gantvā kāmesu ādīnavaṃ disvā gharāvāsaṃ pahāya tāpasapabbajjaṃ pabbajitvā araññāyatane sālavane assamaṃ kāretvā vasati.","Bhagavā tassa anuggaṇhanatthaṃ assamassa avidūre sālavane nirodhaṃ samāpajjitvā nisīdi.","So assamato nikkhamitvā phalāphalatthāya gacchanto bhagavantaṃ disvā pasannamānaso cattāro daṇḍe ṭhapetvā bhagavato upari pupphitāhi sālasākhāhi sākhāmaṇḍapaṃ katvā sattāhaṃ navanavehi sālapupphehi bhagavantaṃ pūjento aṭṭhāsi buddhārammaṇaṃ pītiṃ avijahanto.","Satthā sattāhassa accayena nirodhato vuṭṭhahitvā bhikkhusaṅghaṃ cintesi.","Tāvadeva satasahassamattā khīṇāsavā satthāraṃ parivāresuṃ.","Bhagavā tassa bhāviniṃ sampattiṃ vibhāvento anumodanaṃ vatvā pakkāmi.","So tena puññakammena devaloke nibbattitvā aparāparaṃ sugatīsuyeva saṃsaranto imasmiṃ buddhuppāde rājagahe brāhmaṇakule nibbattitvā <b>tisso</b>ti laddhanāmo vayappatto tiṇṇaṃ vedānaṃ pāragū hutvā pañcamattāni māṇavakasatāni mante vācento lābhaggayasaggappatto hutvā satthu rājagahagamane buddhānubhāvaṃ disvā paṭiladdhasaddho pabbajitvā vipassanaṃ paṭṭhapetvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.49.190-220)–"],"lineRefs":[[],[],[],[],[],[],[],[],[],[]]},{"para":3515,"vripara":null,"refs":[],"lines":["“Ajjhogāhetvā sālavanaṃ, sukato assamo mama;"],"lineRefs":[[]]},{"para":3516,"vripara":null,"refs":[],"lines":["Sālapupphehi sañchanno, vasāmi vipine tadā."],"lineRefs":[[]]},{"para":3517,"vripara":null,"refs":[],"lines":["“Piyadassī ca bhagavā, sayambhū aggapuggalo;"],"lineRefs":[[]]},{"para":3518,"vripara":null,"refs":[],"lines":["Vivekakāmo sambuddho, sālavanamupāgami."],"lineRefs":[[]]},{"para":3519,"vripara":null,"refs":[],"lines":["“Assamā abhinikkhamma, pavanaṃ agamāsahaṃ;"],"lineRefs":[[]]},{"para":3520,"vripara":null,"refs":[],"lines":["Mūlaphalaṃ gavesanto, āhiṇḍāmi vane tadā."],"lineRefs":[[]]},{"para":3521,"vripara":null,"refs":[],"lines":["“Tatthaddasāsiṃ sambuddhaṃ, piyadassiṃ mahāyasaṃ;"],"lineRefs":[[]]},{"para":3522,"vripara":null,"refs":[],"lines":["Sunisinnaṃ samāpannaṃ, virocantaṃ mahāvane."],"lineRefs":[[]]},{"para":3523,"vripara":null,"refs":[],"lines":["“Catudaṇḍe ṭhapetvāna, buddhassa uparī ahaṃ;"],"lineRefs":[[]]},{"para":3524,"vripara":null,"refs":[],"lines":["Maṇḍapaṃ sukataṃ katvā, sālapupphehi chādayiṃ."],"lineRefs":[[]]},{"para":3525,"vripara":null,"refs":[],"lines":["“Sattāhaṃ dhārayitvāna, maṇḍapaṃ sālachāditaṃ;"],"lineRefs":[[]]},{"para":3526,"vripara":null,"refs":[],"lines":["Tattha cittaṃ pasādetvā, buddhaseṭṭhamavandahaṃ."],"lineRefs":[[]]},{"para":3527,"vripara":null,"refs":[],"lines":["“Bhagavā tamhi samaye, vuṭṭhahitvā samādhito;"],"lineRefs":[[]]},{"para":3528,"vripara":null,"refs":[],"lines":["Yugamattaṃ pekkhamāno, nisīdi purisuttamo."],"lineRefs":[[]]},{"para":3529,"vripara":null,"refs":[],"lines":["“Sāvako varuṇo nāma, piyadassissa satthuno;"],"lineRefs":[[]]},{"para":3530,"vripara":null,"refs":[],"lines":["Vasīsatasahassehi, upagacchi vināyakaṃ."],"lineRefs":[[]]},{"para":3531,"vripara":null,"refs":[],"lines":["“Piyadassī ca bhagavā, lokajeṭṭho narāsabho;"],"lineRefs":[[]]},{"para":3532,"vripara":null,"refs":[],"lines":["Bhikkhusaṅghe nisīditvāna, sitaṃ pātukarī jino."],"lineRefs":[[]]},{"para":3533,"vripara":null,"refs":[],"lines":["“Anuruddho upaṭṭhāko, piyadassissa satthuno;"],"lineRefs":[[]]},{"para":3534,"vripara":null,"refs":[],"lines":["Ekaṃsaṃ cīvaraṃ katvā, apucchittha mahāmuniṃ."],"lineRefs":[[]]},{"para":3535,"vripara":null,"refs":[],"lines":["“Ko nu kho bhagavā hetu, sitakammassa satthuno;"],"lineRefs":[[]]},{"para":3536,"vripara":null,"refs":[],"lines":["Kāraṇe vijjamānamhi, satthā pātukare sitaṃ."],"lineRefs":[[]]},{"para":3537,"vripara":null,"refs":[],"lines":["“Sattāhaṃ sālacchadanaṃ, yo me dhāresi māṇavo;"],"lineRefs":[[]]},{"para":3538,"vripara":null,"refs":[],"lines":["Tassa kammaṃ saritvāna, sitaṃ pātukariṃ ahaṃ."],"lineRefs":[[]]},{"para":3539,"vripara":null,"refs":[],"lines":["“Anokāsaṃ na passāmi, yattha puññaṃ vipaccati;"],"lineRefs":[[]]},{"para":3540,"vripara":null,"refs":[],"lines":["Devaloke manusse vā, okāsova na sammati."],"lineRefs":[[]]},{"para":3541,"vripara":null,"refs":[],"lines":["“Devaloke vasantassa, puññakammasamaṅgino;"],"lineRefs":[[]]},{"para":3542,"vripara":null,"refs":[],"lines":["Yāvatā parisā tassa, sālacchannā bhavissati."],"lineRefs":[[]]},{"para":3543,"vripara":null,"refs":[],"lines":["“Tattha dibbehi naccehi, gītehi vāditehi ca;"],"lineRefs":[[]]},{"para":3544,"vripara":null,"refs":[],"lines":["Ramissati sadā santo, puññakammasamāhito."],"lineRefs":[[]]},{"para":3545,"vripara":null,"refs":[],"lines":["“Yāvatā parisā tassa, gandhagandhī bhavissati;"],"lineRefs":[[]]},{"para":3546,"vripara":null,"refs":[],"lines":["Sālassa pupphavasso ca, pavassissati tāvade."],"lineRefs":[[]]},{"para":3547,"vripara":null,"refs":[],"lines":["“Tato cutoyaṃ manujo, mānusaṃ āgamissati;"],"lineRefs":[[]]},{"para":3548,"vripara":null,"refs":[],"lines":["Idhāpi sālacchadanaṃ, sabbakālaṃ dharissati."],"lineRefs":[[]]},{"para":3549,"vripara":null,"refs":[],"lines":["“Idha naccañca gītañca, sammatāḷasamāhitaṃ;"],"lineRefs":[[]]},{"para":3550,"vripara":null,"refs":[],"lines":["Parivāressanti maṃ niccaṃ, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":3551,"vripara":null,"refs":[],"lines":["“Uggacchante ca sūriye, sālavassaṃ pavassati;"],"lineRefs":[[]]},{"para":3552,"vripara":null,"refs":[],"lines":["Puññakammena saṃyuttaṃ, vassate sabbakālikaṃ."],"lineRefs":[[]]},{"para":3553,"vripara":null,"refs":[],"lines":["“Aṭṭhārase kappasate, okkākakulasambhavo;"],"lineRefs":[[]]},{"para":3554,"vripara":null,"refs":[],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[[]]},{"para":3555,"vripara":null,"refs":[],"lines":["“Tassa dhammesu dāyādo, oraso dhammanimmito;"],"lineRefs":[[]]},{"para":3556,"vripara":null,"refs":[],"lines":["Sabbāsave pariññāya, nibbāyissatināsavo."],"lineRefs":[[]]},{"para":3557,"vripara":null,"refs":[],"lines":["“Dhammaṃ abhisamentassa, sālacchannaṃ bhavissati;"],"lineRefs":[[]]},{"para":3558,"vripara":null,"refs":[],"lines":["Citake jhāyamānassa, chadanaṃ tattha hessati."],"lineRefs":[[]]},{"para":3559,"vripara":null,"refs":[],"lines":["“Vipākaṃ kittayitvāna, piyadassī mahāmuni;"],"lineRefs":[[]]},{"para":3560,"vripara":null,"refs":[],"lines":["Parisāya dhammaṃ desesi, tappento dhammavuṭṭhiyā."],"lineRefs":[[]]},{"para":3561,"vripara":null,"refs":[],"lines":["“Tiṃsakappāni devesu, devarajjamakārayiṃ;"],"lineRefs":[[]]},{"para":3562,"vripara":null,"refs":[],"lines":["Saṭṭhi ca sattakkhattuñca, cakkavattī ahosahaṃ."],"lineRefs":[[]]},{"para":3563,"vripara":null,"refs":[],"lines":["“Devalokā idhāgantvā, labhāmi vipulaṃ sukhaṃ;"],"lineRefs":[[]]},{"para":3564,"vripara":null,"refs":[],"lines":["Idhāpi sālacchadanaṃ, maṇḍapassa idaṃ phalaṃ."],"lineRefs":[[]]},{"para":3565,"vripara":null,"refs":[],"lines":["“Ayaṃ pacchimako mayhaṃ, carimo vattate bhavo;"],"lineRefs":[[]]},{"para":3566,"vripara":null,"refs":[],"lines":["Idhāpi sālacchadanaṃ, hessati sabbakālikaṃ."],"lineRefs":[[]]},{"para":3567,"vripara":null,"refs":[],"lines":["“Mahāmuniṃ tosayitvā, gotamaṃ sakyapuṅgavaṃ;"],"lineRefs":[[]]},{"para":3568,"vripara":null,"refs":[],"lines":["Pattomhi acalaṃ ṭhānaṃ, hitvā jayaparājayaṃ."],"lineRefs":[[]]},{"para":3569,"vripara":null,"refs":[],"lines":["“Aṭṭhārase kappasate, yaṃ buddhamabhipūjayiṃ;"],"lineRefs":[[]]},{"para":3570,"vripara":null,"refs":[],"lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."],"lineRefs":[[]]},{"para":3571,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":3572,"vripara":null,"refs":[],"lines":["So arahattaṃ pana patvā visesato lābhaggayasaggappatto ahosi.","Tattha keci puthujjanabhikkhū therassa lābhasakkāraṃ disvā bālabhāvena asahanākāraṃ pavedesuṃ.","Thero taṃ ñatvā lābhasakkāre ādīnavaṃ tattha attano alaggabhāvañca pakāsento –"],"lineRefs":[[],[],[]]},{"para":3574,"vripara":"153","refs":[],"lines":["“Bahū sapatte labhati, muṇḍo saṅghāṭipāruto;"],"lineRefs":[[]]},{"para":3575,"vripara":null,"refs":[],"lines":["Lābhī annassa pānassa, vatthassa sayanassa ca."],"lineRefs":[[]]},{"para":3577,"vripara":"154","refs":[],"lines":["“Etamādīnavaṃ ñatvā, sakkāresu mahabbhayaṃ;"],"lineRefs":[[]]},{"para":3578,"vripara":null,"refs":[],"lines":["Appalābho anavassuto, sato bhikkhu paribbaje”ti.","–"],"lineRefs":[[],[]]},{"para":3579,"vripara":null,"refs":[],"lines":["Gāthādvayaṃ abhāsi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
