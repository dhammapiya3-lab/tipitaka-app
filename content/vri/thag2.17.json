{"suttaId":"thag2.17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[843,849],"vripara":"153"},"segments":{"thag2.17:0.4":"Tissattheragāthā","thag2.17:1.1":"“Bahū sapatte labhati,","thag2.17:1.2":"muṇḍo saṅghāṭipāruto;","thag2.17:1.3":"Lābhī annassa pānassa,","thag2.17:1.4":"vatthassa sayanassa ca. 154.","thag2.17:2.1":"“Etamādīnavaṃ ñatvā,","thag2.17:2.2":"sakkāresu mahabbhayaṃ;","thag2.17:2.3":"Appalābho anavassuto,","thag2.17:2.4":"sato bhikkhu paribbaje”ti. …","thag2.17:2.5":"Tisso thero…. 8."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":3580,"to":3580,"paras":[{"para":3580,"vripara":null,"refs":["thag2.17:2"],"lines":["Tassattho – sikhampi asesetvā muṇḍitakesatāya <b>muṇḍo,</b> chinditvā saṅghāṭitakāsāvadhāritāya <b>saṅghāṭipāruto,</b> evaṃ vevaṇṇiyaṃ ajjhupagato parāyattavuttiko pabbajito sace annapānādīnaṃ <b>lābhī</b> hoti, sopi <b>bahū sapatte labhati,</b> tassa usūyantā bahū sambhavanti.","Tasmā <b>etaṃ</b> evarūpaṃ lābha<b>sakkāresu</b> <b>mahabbhayaṃ</b> vipulabhayaṃ <b>ādīnavaṃ</b> dosaṃ viditvā appicchataṃ santosañca hadaye ṭhapetvā anavajjuppādassāpi uppannassa lābhassa parivajjanena <b>appalābho,</b> tato eva tattha taṇhāvassutābhāvena <b>anavassuto,</b> saṃsāre bhayassa ikkhanato bhinnakilesatāya vā <b>bhikkhu</b> santuṭṭhiṭṭhānīyassa satisampajaññassa vasena <b>sato</b> hutvā <b>paribbaje</b> careyya vihareyyāti.","Taṃ sutvā te bhikkhū tāvadeva theraṃ khamāpesuṃ."],"lineRefs":[["thag2.17:2"],["thag2.17:2"],["thag2.17:2"]]}],"wordLinks":[["thag2.17:2.3","lābhī",0,0],["thag2.17:2.1","etaṃ",0,1],["thag2.17:2.1","sakkāresu mahabbhayaṃ",0,1],["thag2.17:2.1","ādīnavaṃ",0,1],["thag2.17:2.3","anavassuto",0,1],["thag2.17:2.3","appalābho",0,1],["thag2.17:2.3","bhikkhu",0,1],["thag2.17:2.3","paribbaje",0,1],["thag2.17:2.3","sato",0,1]],"before":[{"para":3513,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Tissattheragāthāvaṇṇanā"]},{"para":3514,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["<b>Bahū</b> <b>sapatte labhatī</b>ti āyasmato tissattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayaṃ puññaṃ upacinanto piyadassissa bhagavato kāle brāhmaṇakule nibbattitvā viññutaṃ patto sippesu nipphattiṃ gantvā kāmesu ādīnavaṃ disvā gharāvāsaṃ pahāya tāpasapabbajjaṃ pabbajitvā araññāyatane sālavane assamaṃ kāretvā vasati.","Bhagavā tassa anuggaṇhanatthaṃ assamassa avidūre sālavane nirodhaṃ samāpajjitvā nisīdi.","So assamato nikkhamitvā phalāphalatthāya gacchanto bhagavantaṃ disvā pasannamānaso cattāro daṇḍe ṭhapetvā bhagavato upari pupphitāhi sālasākhāhi sākhāmaṇḍapaṃ katvā sattāhaṃ navanavehi sālapupphehi bhagavantaṃ pūjento aṭṭhāsi buddhārammaṇaṃ pītiṃ avijahanto.","Satthā sattāhassa accayena nirodhato vuṭṭhahitvā bhikkhusaṅghaṃ cintesi.","Tāvadeva satasahassamattā khīṇāsavā satthāraṃ parivāresuṃ.","Bhagavā tassa bhāviniṃ sampattiṃ vibhāvento anumodanaṃ vatvā pakkāmi.","So tena puññakammena devaloke nibbattitvā aparāparaṃ sugatīsuyeva saṃsaranto imasmiṃ buddhuppāde rājagahe brāhmaṇakule nibbattitvā <b>tisso</b>ti laddhanāmo vayappatto tiṇṇaṃ vedānaṃ pāragū hutvā pañcamattāni māṇavakasatāni mante vācento lābhaggayasaggappatto hutvā satthu rājagahagamane buddhānubhāvaṃ disvā paṭiladdhasaddho pabbajitvā vipassanaṃ paṭṭhapetvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.49.190-220) –"]},{"para":3515,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Ajjhogāhetvā sālavanaṃ, sukato assamo mama;"]},{"para":3516,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Sālapupphehi sañchanno, vasāmi vipine tadā."]},{"para":3517,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Piyadassī ca bhagavā, sayambhū aggapuggalo;"]},{"para":3518,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Vivekakāmo sambuddho, sālavanamupāgami."]},{"para":3519,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Assamā abhinikkhamma, pavanaṃ agamāsahaṃ;"]},{"para":3520,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Mūlaphalaṃ gavesanto, āhiṇḍāmi vane tadā."]},{"para":3521,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Tatthaddasāsiṃ sambuddhaṃ, piyadassiṃ mahāyasaṃ;"]},{"para":3522,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Sunisinnaṃ samāpannaṃ, virocantaṃ mahāvane."]},{"para":3523,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Catudaṇḍe ṭhapetvāna, buddhassa uparī ahaṃ;"]},{"para":3524,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Maṇḍapaṃ sukataṃ katvā, sālapupphehi chādayiṃ."]},{"para":3525,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Sattāhaṃ dhārayitvāna, maṇḍapaṃ sālachāditaṃ;"]},{"para":3526,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Tattha cittaṃ pasādetvā, buddhaseṭṭhamavandahaṃ."]},{"para":3527,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Bhagavā tamhi samaye, vuṭṭhahitvā samādhito;"]},{"para":3528,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Yugamattaṃ pekkhamāno, nisīdi purisuttamo."]},{"para":3529,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Sāvako varuṇo nāma, piyadassissa satthuno;"]},{"para":3530,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Vasīsatasahassehi, upagacchi vināyakaṃ."]},{"para":3531,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Piyadassī ca bhagavā, lokajeṭṭho narāsabho;"]},{"para":3532,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Bhikkhusaṅghe nisīditvāna, sitaṃ pātukarī jino."]},{"para":3533,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Anuruddho upaṭṭhāko, piyadassissa satthuno;"]},{"para":3534,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Ekaṃsaṃ cīvaraṃ katvā, apucchittha mahāmuniṃ."]},{"para":3535,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Ko nu kho bhagavā hetu, sitakammassa satthuno;"]},{"para":3536,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Kāraṇe vijjamānamhi, satthā pātukare sitaṃ."]},{"para":3537,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Sattāhaṃ sālacchadanaṃ, yo me dhāresi māṇavo;"]},{"para":3538,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Tassa kammaṃ saritvāna, sitaṃ pātukariṃ ahaṃ."]},{"para":3539,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Anokāsaṃ na passāmi, yattha puññaṃ vipaccati;"]},{"para":3540,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Devaloke manusse vā, okāsova na sammati."]},{"para":3541,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Devaloke vasantassa, puññakammasamaṅgino;"]},{"para":3542,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Yāvatā parisā tassa, sālacchannā bhavissati."]},{"para":3543,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Tattha dibbehi naccehi, gītehi vāditehi ca;"]},{"para":3544,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Ramissati sadā santo, puññakammasamāhito."]},{"para":3545,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Yāvatā parisā tassa, gandhagandhī bhavissati;"]},{"para":3546,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Sālassa pupphavasso ca, pavassissati tāvade."]},{"para":3547,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Tato cutoyaṃ manujo, mānusaṃ āgamissati;"]},{"para":3548,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Idhāpi sālacchadanaṃ, sabbakālaṃ dharissati."]},{"para":3549,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Idha naccañca gītañca, sammatāḷasamāhitaṃ;"]},{"para":3550,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Parivāressanti maṃ niccaṃ, buddhapūjāyidaṃ phalaṃ."]},{"para":3551,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Uggacchante ca sūriye, sālavassaṃ pavassati;"]},{"para":3552,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Puññakammena saṃyuttaṃ, vassate sabbakālikaṃ."]},{"para":3553,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Aṭṭhārase kappasate, okkākakulasambhavo;"]},{"para":3554,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Gotamo nāma gottena, satthā loke bhavissati."]},{"para":3555,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Tassa dhammesu dāyādo, oraso dhammanimmito;"]},{"para":3556,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Sabbāsave pariññāya, nibbāyissatināsavo."]},{"para":3557,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Dhammaṃ abhisamentassa, sālacchannaṃ bhavissati;"]},{"para":3558,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Citake jhāyamānassa, chadanaṃ tattha hessati."]},{"para":3559,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Vipākaṃ kittayitvāna, piyadassī mahāmuni;"]},{"para":3560,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Parisāya dhammaṃ desesi, tappento dhammavuṭṭhiyā."]},{"para":3561,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Tiṃsakappāni devesu, devarajjamakārayiṃ;"]},{"para":3562,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Saṭṭhi ca sattakkhattuñca, cakkavattī ahosahaṃ."]},{"para":3563,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Devalokā idhāgantvā, labhāmi vipulaṃ sukhaṃ;"]},{"para":3564,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Idhāpi sālacchadanaṃ, maṇḍapassa idaṃ phalaṃ."]},{"para":3565,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Ayaṃ pacchimako mayhaṃ, carimo vattate bhavo;"]},{"para":3566,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Idhāpi sālacchadanaṃ, hessati sabbakālikaṃ."]},{"para":3567,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Mahāmuniṃ tosayitvā, gotamaṃ sakyapuṅgavaṃ;"]},{"para":3568,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Pattomhi acalaṃ ṭhānaṃ, hitvā jayaparājayaṃ."]},{"para":3569,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Aṭṭhārase kappasate, yaṃ buddhamabhipūjayiṃ;"]},{"para":3570,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."]},{"para":3571,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti."]},{"para":3572,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["So arahattaṃ pana patvā visesato lābhaggayasaggappatto ahosi.","Tattha keci puthujjanabhikkhū therassa lābhasakkāraṃ disvā bālabhāvena asahanākāraṃ pavedesuṃ.","Thero taṃ ñatvā lābhasakkāre ādīnavaṃ tattha attano alaggabhāvañca pakāsento – 153."]},{"para":3574,"vripara":"153","title":"Tissattheragāthāvaṇṇanā","lines":["“Bahū sapatte labhati, muṇḍo saṅghāṭipāruto;"]},{"para":3575,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Lābhī annassa pānassa, vatthassa sayanassa ca. 154."]},{"para":3577,"vripara":"154","title":"Tissattheragāthāvaṇṇanā","lines":["“Etamādīnavaṃ ñatvā, sakkāresu mahabbhayaṃ;"]},{"para":3578,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Appalābho anavassuto, sato bhikkhu paribbaje”ti. –"]},{"para":3579,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Gāthādvayaṃ abhāsi."]}],"after":[{"para":3581,"vripara":null,"title":"Tissattheragāthāvaṇṇanā","lines":["Tissattheragāthāvaṇṇanā niṭṭhitā. 8."]}]},"tika":null,"tika2":null}
