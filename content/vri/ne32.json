{"suttaId":"ne32","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Nett","vriCode":"s0519m.mul","paras":[741,743],"vripara":"75"},"segments":{"ne32:0.4":"Sodhanahārasampāto","ne32:1.1":"Tattha katamo sodhano hārasampāto?","ne32:2.1":"“Tasmā rakkhitacittassa, sammāsaṅkappagocaro”ti gāthā.","ne32:2.2":"Yattha ārambho suddho, so pañho visajjito bhavati.","ne32:2.3":"Yattha pana ārambho na suddho, na tāva so pañho visajjito bhavati.","ne32:2.4":"Niyutto sodhano hārasampāto. 14."},"unsure":[],"preface":[],"attha":null,"tika":{"book":"Nett-vbh","bookName":"Nettivibhāvinī","vriCode":"s0501t.nrf","from":1159,"to":1159,"paras":[{"para":1159,"vripara":"75","refs":["ne32:2"],"lines":["<b>Yatthā</b>ti yasmiṃ pañhe.","<b>Ārambho</b> attho <b>suddho</b> paripuṇṇo, so pañho niravasesato vissajjito bhavati.","<b>Yattha</b> pañhe pana <b>ārambho</b> attho <b>na suddho</b> aparipuṇṇo koci vissajjetabbo avasiṭṭho, so pañho tāva vissajjito na bhavati. 15."],"lineRefs":[["ne32:2"],["ne32:2"],["ne32:2"]]}],"wordLinks":[["ne32:2.2","yatthā",0,0],["ne32:2.3","yatthā",0,0],["ne32:2.2","suddho",0,1],["ne32:2.2","ārambho",0,1],["ne32:2.3","suddho",0,1],["ne32:2.3","ārambho",0,1],["ne32:2.2","yattha",0,2],["ne32:2.2","ārambho",0,2],["ne32:2.3","na suddho",0,2],["ne32:2.3","yattha",0,2],["ne32:2.3","ārambho",0,2]],"before":[{"para":1158,"vripara":null,"title":"Sodhanahārasampātavibhāvanā","lines":["Sodhanahārasampātavibhāvanā 75."]}]},"tika2":{"book":"Nett-vbh","bookName":"Nettivibhāvinī","vriCode":"s0501t.nrf","from":1159,"to":1159,"paras":[{"para":1159,"vripara":"75","refs":["ne32:2"],"lines":["<b>Yatthā</b>ti yasmiṃ pañhe.","<b>Ārambho</b> attho <b>suddho</b> paripuṇṇo, so pañho niravasesato vissajjito bhavati.","<b>Yattha</b> pañhe pana <b>ārambho</b> attho <b>na suddho</b> aparipuṇṇo koci vissajjetabbo avasiṭṭho, so pañho tāva vissajjito na bhavati. 15."],"lineRefs":[["ne32:2"],["ne32:2"],["ne32:2"]]}],"wordLinks":[["ne32:2.2","yatthā",0,0],["ne32:2.3","yatthā",0,0],["ne32:2.2","