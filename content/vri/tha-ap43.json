{"suttaId":"tha-ap43","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[3484,3557],"vripara":"1"},"segments":{"tha-ap43:0.3":"Bhāgineyyupālittheraapadānaṃ","tha-ap43:1.1":"“Khīṇāsavasahassehi,","tha-ap43:1.2":"parivuto [pareto (ka. aṭṭha)] lokanāyako;","tha-ap43:1.3":"Vivekamanuyutto so,","tha-ap43:1.4":"gacchate paṭisallituṃ.","tha-ap43:2.1":"“Ajinena nivatthohaṃ,","tha-ap43:2.2":"tidaṇḍaparidhārako;","tha-ap43:2.3":"Bhikkhusaṅghaparibyūḷhaṃ,","tha-ap43:2.4":"addasaṃ lokanāyakaṃ.","tha-ap43:3.1":"“Ekaṃsaṃ ajinaṃ katvā,","tha-ap43:3.2":"sire katvāna añjaliṃ;","tha-ap43:3.3":"Sambuddhaṃ abhivādetvā,","tha-ap43:3.4":"santhaviṃ lokanāyakaṃ.","tha-ap43:4.1":"“Yathāṇḍajā ca saṃsedā,","tha-ap43:4.2":"opapātī jalābujā;","tha-ap43:4.3":"Kākādipakkhino sabbe,","tha-ap43:4.4":"antalikkhacarā sadā.","tha-ap43:5.1":"“Ye keci pāṇabhūtatthi,","tha-ap43:5.2":"saññino vā asaññino;","tha-ap43:5.3":"Sabbe te tava ñāṇamhi,","tha-ap43:5.4":"anto honti samogadhā.","tha-ap43:6.1":"“Gandhā ca pabbateyyā ye,","tha-ap43:6.2":"himavantanaguttame;","tha-ap43:6.3":"Sabbe te tava sīlamhi,","tha-ap43:6.4":"kalāyapi na yujjare.","tha-ap43:7.1":"“Mohandhakārapakkhando,","tha-ap43:7.2":"ayaṃ loko sadevako;","tha-ap43:7.3":"Tava ñāṇamhi jotante,","tha-ap43:7.4":"andhakārā vidhaṃsitā.","tha-ap43:8.1":"“Yathā atthaṅgate sūriye,","tha-ap43:8.2":"honti sattā tamogatā;","tha-ap43:8.3":"Evaṃ buddhe anuppanne,","tha-ap43:8.4":"hoti loko tamogato.","tha-ap43:9.1":"“Yathodayanto ādicco,","tha-ap43:9.2":"vinodeti tamaṃ sadā;","tha-ap43:9.3":"Tatheva tvaṃ buddhaseṭṭha,","tha-ap43:9.4":"viddhaṃsesi tamaṃ sadā.","tha-ap43:10.1":"“Padhānapahitattosi,","tha-ap43:10.2":"buddho loke sadevake;","tha-ap43:10.3":"Tava kammābhiraddhena,","tha-ap43:10.4":"tosesi janataṃ bahuṃ.","tha-ap43:11.1":"“Taṃ sabbaṃ anumoditvā,","tha-ap43:11.2":"padumuttaro mahāmuni;","tha-ap43:11.3":"Nabhaṃ abbhuggamī dhīro,","tha-ap43:11.4":"haṃsarājāva ambare.","tha-ap43:12.1":"“Abbhuggantvāna sambuddho,","tha-ap43:12.2":"mahesi padumuttaro;","tha-ap43:12.3":"Antalikkhe ṭhito satthā,","tha-ap43:12.4":"imā gāthā abhāsatha.","tha-ap43:13.1":"“Yenidaṃ thavitaṃ ñāṇaṃ,","tha-ap43:13.2":"opammehi samāyutaṃ;","tha-ap43:13.3":"Tamahaṃ kittayissāmi,","tha-ap43:13.4":"suṇātha mama bhāsato.","tha-ap43:14.1":"“‘Aṭṭhārasañca khattuṃ so,","tha-ap43:14.2":"devarājā bhavissati;","tha-ap43:14.3":"Pathabyā rajjaṃ tisataṃ,","tha-ap43:14.4":"vasudhaṃ āvasissati.","tha-ap43:15.1":"“‘Pañcavīsatikkhattuñca,","tha-ap43:15.2":"cakkavattī bhavissati;","tha-ap43:15.3":"Padesarajjaṃ vipulaṃ,","tha-ap43:15.4":"gaṇanāto asaṅkhiyaṃ.","tha-ap43:16.1":"“‘Kappasatasahassamhi,","tha-ap43:16.2":"okkākakulasambhavo;","tha-ap43:16.3":"Gotamo nāma gottena,","tha-ap43:16.4":"satthā loke bhavissati.","tha-ap43:17.1":"“‘Tusitā hi cavitvāna,","tha-ap43:17.2":"sukkamūlena codito;","tha-ap43:17.3":"Hīnova jātiyā santo,","tha-ap43:17.4":"upāli nāma hessati.","tha-ap43:18.1":"“‘So pacchā pabbajitvāna,","tha-ap43:18.2":"virājetvāna pāpakaṃ;","tha-ap43:18.3":"Sabbāsave pariññāya,","tha-ap43:18.4":"nibbāyissatināsavo.","tha-ap43:19.1":"“‘Tuṭṭho ca gotamo buddho,","tha-ap43:19.2":"sakyaputto mahāyaso;","tha-ap43:19.3":"Vinayādhigataṃ tassa,","tha-ap43:19.4":"etadagge ṭhapessati’.","tha-ap43:20.1":"“Saddhāyāhaṃ pabbajito,","tha-ap43:20.2":"katakicco anāsavo;","tha-ap43:20.3":"Sabbāsave pariññāya,","tha-ap43:20.4":"viharāmi anāsavo.","tha-ap43:21.1":"“Bhagavā cānukampī maṃ,","tha-ap43:21.2":"vinayehaṃ visārado;","tha-ap43:21.3":"Sakakammābhiraddho ca,","tha-ap43:21.4":"viharāmi anāsavo.","tha-ap43:22.1":"“Saṃvuto pātimokkhamhi,","tha-ap43:22.2":"indriyesu ca pañcasu;","tha-ap43:22.3":"Dhāremi vinayaṃ sabbaṃ,","tha-ap43:22.4":"kevalaṃ ratanākaraṃ [ratanaggharaṃ (ka.)].","tha-ap43:23.1":"“Mamañca guṇamaññāya,","tha-ap43:23.2":"satthā loke anuttaro;","tha-ap43:23.3":"Bhikkhusaṅghe nisīditvā,","tha-ap43:23.4":"etadagge ṭhapesi maṃ.","tha-ap43:24.1":"“Paṭisambhidā catasso,","tha-ap43:24.2":"vimokkhāpi ca aṭṭhime;","tha-ap43:24.3":"Chaḷabhiññā sacchikatā,","tha-ap43:24.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap43:25.1":"Itthaṃ sudaṃ āyasmā upālithero imā gāthāyo abhāsitthāti.","tha-ap43:26.1":"Bhāgineyyupālittherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2491,"to":2492,"paras":[{"para":2491,"vripara":"1","refs":["tha-ap43:1"],"lines":["So evaṃ etadaggaṭṭhānaṃ patvā attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>khīṇāsavasahassehī</b>tiādimāha.","Tattha <b>ā</b> samantato yāvabhavaggā savanti pavattantīti āsavā.","Kāmāsavādayo cattāro āsavā, te khīṇā sositā visositā viddhaṃsitā yehi teti khīṇāsavā, teyeva sahassā khīṇāsavasahassā, tehi khīṇāsavasahassehi.","<b>Pareto</b> parivuto <b>lokanāyako</b> lokassa nibbānapāpanako vivekaṃ anuyutto paṭisallituṃ ekībhavituṃ gacchateti sambandho."],"lineRefs":[["tha-ap43:1"],["tha-ap43:1"],["tha-ap43:1"],["tha-ap43:1"]]},{"para":2492,"vripara":"2","refs":["tha-ap43:2"],"lines":["<b>Ajinena nivatthohan</b>ti ahaṃ ajinamigacammena paṭicchanno, ajinacammavasanoti attho.","<b>Tidaṇḍaparidhārako</b>ti kuṇḍikaṭṭhapanatthāya tidaṇḍaṃ gahetvā dhārentoti attho.","Bhikkhusaṅghena paribyūḷhaṃ parivāritaṃ lokanāyakaṃ addasanti sambandho.","Sesaṃ pākaṭamevāti."],"lineRefs":[["tha-ap43:2"],["tha-ap43:2"],["tha-ap43:2"],["tha-ap43:2"]]}],"wordLinks":[["tha-ap43:1.1","khīṇāsavasahassehī",0,0],["tha-ap43:1.1","ā",0,1],["tha-ap43:1.3","ā",0,1],["tha-ap43:1.1","lokanāyako",0,3],["tha-ap43:2.1","ajinena nivatthohaṃ",1,0],["tha-ap43:2.1","tidaṇḍaparidhārako",1,1]]},"tika":null,"tika2":null}
