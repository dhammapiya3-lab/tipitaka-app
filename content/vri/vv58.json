{"suttaId":"vv58","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2253,2269],"vripara":"944"},"segments":{"vv58:0.4":"Paṭhamasūcivimānavatthu","vv58:1.1":"“Uccamidaṃ maṇithūṇaṃ vimānaṃ,","vv58:1.2":"samantato dvādasa yojanāni;","vv58:1.3":"Kūṭāgārā sattasatā uḷārā,","vv58:1.4":"veḷuriyathambhā rucakatthatā subhā.","vv58:2.1":"“Tatthacchasi pivasi khādasi ca,","vv58:2.2":"dibbā ca vīṇā pavadanti vagguṃ;","vv58:2.3":"Dibbā rasā kāmaguṇettha pañca,","vv58:2.4":"nāriyo ca naccanti suvaṇṇachannā.","vv58:3.1":"“Kena tetādiso vaṇṇo … pe …","vv58:3.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv58:4.1":"So devaputto attamano … pe …","vv58:4.3":"yassa kammassidaṃ phalaṃ.","vv58:5.1":"“Yaṃ dadāti na taṃ hoti,","vv58:5.2":"Yañceva dajjā tañceva seyyo;","vv58:5.3":"Sūci dinnā sūcimeva seyyo.","vv58:6.1":"“Tena metādiso vaṇṇo … pe …","vv58:6.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv58:7.1":"Paṭhamasūcivimānaṃ aṭṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2673,"to":2673,"paras":[{"para":2673,"vripara":"949","refs":["vv58:5"],"lines":["Tattha <b>yaṃ dadātī</b>ti yādisaṃ deyyadhammaṃ dadāti.","<b>Na taṃ hotī</b>ti tassa tādisameva phalaṃ na hoti.","Atha kho khettasampattiyā ca cittasampattiyā ca tato vipulataraṃ uḷāratarameva phalaṃ hoti.","Tasmā <b>yañceva dajjā tañceva seyyo</b>ti yaṃkiñcideva vijjamānaṃ dajjā dadeyya, tañceva tadeva seyyo, yassa kassaci anavajjassa deyyadhammassa dānameva seyyo, kasmā?","Mayā hi <b>sūci dinnā sūcimeva seyyo,</b> sūcidānameva mayhaṃ seyyaṃ jātaṃ, yato ayamīdisī sampatti laddhāti adhippāyo."],"lineRefs":[["vv58:5"],["vv58:5"],["vv58:5"],["vv58:5"],["vv58:5"]]}],"wordLinks":[["vv58:5.1","yaṃ dadātī",0,0],["vv58:5.1","na taṃ hotī",0,1],["vv58:5.2","yañceva dajjā tañceva seyyo",0,3],["vv58:5.3","sūci dinnā sūcimeva seyyo",0,4]],"after":[{"para":2674,"vripara":null,"title":"Paṭhamasūcivimānavaṇṇanā","lines":["Sūcivimānavaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
