{"suttaId":"an5.171","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1157,1159],"vripara":"171"},"segments":{"an5.171:0.3":"Sārajjasuttaṃ","an5.171:1.1":"Evaṃ me sutaṃ –","an5.171:1.2":"ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme.","an5.171:1.3":"Tatra kho bhagavā bhikkhū āmantesi –","an5.171:1.4":"“bhikkhavo”ti.","an5.171:1.5":"“Bhadante”ti te bhikkhū bhagavato paccassosuṃ.","an5.171:1.6":"Bhagavā etadavoca –","an5.171:2.1":"“Pañcahi, bhikkhave, dhammehi samannāgato upāsako sārajjaṃ okkanto hoti.","an5.171:2.2":"Katamehi pañcahi?","an5.171:2.3":"Pāṇātipātī hoti, adinnādāyī hoti, kāmesumicchācārī hoti, musāvādī hoti, surāmerayamajjapamādaṭṭhāyī hoti.","an5.171:2.4":"Imehi kho, bhikkhave, pañcahi dhammehi samannāgato upāsako sārajjaṃ okkanto hoti.","an5.171:3.1":"“Pañcahi, bhikkhave, dhammehi samannāgato upāsako visārado hoti.","an5.171:3.2":"Katamehi pañcahi?","an5.171:3.3":"Pāṇātipātā paṭivirato hoti, adinnādānā paṭivirato hoti, kāmesumicchācārā paṭivirato hoti, musāvādā paṭivirato hoti, surāmerayamajjapamādaṭṭhānā paṭivirato hoti.","an5.171:3.4":"Imehi kho, bhikkhave, pañcahi dhammehi samannāgato upāsako visārado hotī”ti.","an5.171:3.5":"Paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":355,"to":356,"paras":[{"para":355,"vripara":"171-173","refs":["an5.171:1"],"lines":["Tatiyassa paṭhamadutiyatatiyesu agāriyappaṭipatti kathitā.","Sotāpannasakadāgāminopi hontu, vaṭṭantiyeva. 4."],"lineRefs":[["an5.171:1"],["an5.171:1"]]},{"para":356,"vripara":null,"refs":["an5.171:1"],"lines":["Verasuttavaṇṇanā 174."],"lineRefs":[["an5.171:1"]]}],"wordLinks":[],"before":[{"para":353,"vripara":null,"title":"3. Upāsakavaggo","lines":["Upāsakavaggo 1-3."]},{"para":354,"vripara":null,"title":"Sārajjasuttādivaṇṇanā","lines":["Sārajjasuttādivaṇṇanā 171-173."]}]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":311,"to":313,"paras":[{"para":311,"vripara":"171-176","refs":["an5.171:1"],"lines":["Tatiyassa paṭhamadutiyatatiyacatutthe natthi vattabbaṃ.","Pañcame <b>upāsakapacchimako</b>ti upāsakanihīno.","“Iminā diṭṭhādinā idaṃ nāma maṅgalaṃ bhavissatī”ti evaṃ bālajanaparikappitakotūhalasaṅkhātena diṭṭhasutamutamaṅgalena samannāgato <b>kotūhalamaṅgaliko</b>.","Tenāha <b>“iminā idaṃ bhavissatī”</b>tiādi.","<b>Maṅgalaṃ paccetī</b>ti diṭṭhamaṅgalādibhedaṃ maṅgalameva patthiyāyati.","<b>No kamma</b>nti kammassakataṃ no patthiyāyati.","<b>Imamhā sāsanā</b>ti ito sabbaññubuddhasāsanato.","<b>Bahiddhā</b>ti bāhirakasamaye.","<b>Dakkhiṇeyyaṃ pariyesatī</b>ti “duppaṭipannā dakkhiṇeyyā”ti saññī gavesati.","Ettha dakkhiṇapariyesanapubbakāre ekaṃ katvā pañca dhammā veditabbā.","Chaṭṭhaṃ uttānameva."],"lineRefs":[["an5.171:1"],["an5.171:1"],["an5.171:1"],["an5.171:1"],["an5.171:1"],["an5.171:1"],["an5.171:1"],["an5.171:1"],["an5.171:1"],["an5.171:1"],["an5.171:1"]]},{"para":312,"vripara":null,"refs":["an5.171:1"],"lines":["Sārajjasuttādivaṇṇanā niṭṭhitā. 7-8."],"lineRefs":[["an5.171:1"]]},{"para":313,"vripara":null,"refs":["an5.171:1"],"lines":["Vaṇijjāsuttādivaṇṇanā 177-8."],"lineRefs":[["an5.171:1"]]}],"wordLinks":[],"before":[{"para":309,"vripara":null,"title":"3. Upāsakavaggo","lines":["Upāsakavaggo 1-6."]},{"para":310,"vripara":null,"title":"Sārajjasuttādivaṇṇanā","lines":["Sārajjasuttādivaṇṇanā 171-176."]}]},"tika2":null}
