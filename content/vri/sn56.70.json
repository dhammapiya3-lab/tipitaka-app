{"suttaId":"sn56.70","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[2740,2745],"vripara":"1140"},"segments":{"sn56.70:0.3":"Pacāyikasuttaṃ","sn56.70:1.1":"…“Evameva kho, bhikkhave, appakā te sattā ye kule jeṭṭhāpacāyino; atha kho eteva bahutarā sattā ye kule ajeṭṭhāpacāyinoti [akule jeṭṭhāpacāyinoti (syā. kaṃ.)]… pe ….","sn56.70:1.2":"Dasamaṃ.","sn56.70:1.3":"Paṭhamaāmakadhaññapeyyālavaggo sattamo.","sn56.70:2.0":"Tassuddānaṃ –","sn56.70:2.1":"Aññatra paccantaṃ paññā,","sn56.70:2.2":"surāmerayaodakā;","sn56.70:2.3":"Matteyya petteyyā cāpi,","sn56.70:2.4":"sāmaññaṃ brahmapacāyikanti."},"unsure":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":949,"to":949,"paras":[{"para":949,"vripara":"1140","refs":["sn56.70:1"],"lines":["<b>Kule jeṭṭhāpacāyino</b>ti kule jeṭṭhānaṃ apacāyino, nīcavuttinoti attho."],"lineRefs":[["sn56.70:1"]]}],"wordLinks":[["sn56.70:1.1","kule jeṭṭhāpacāyino",0,0]]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":815,"to":817,"paras":[{"para":815,"vripara":"1140","refs":["sn56.70:1"],"lines":["<b>Nīcavuttino</b>ti kule jeṭṭhānaṃ mahāpitucūḷapitujeṭṭhabhātikādīnaṃ abhivādanapaccuṭṭhānaañjalikammasāmīcikammādivasena nīcavuttino."],"lineRefs":[["sn56.70:1"]]},{"para":816,"vripara":null,"refs":["sn56.70:1"],"lines":["Dutiyaāmakadhaññapeyyālavaggo"],"lineRefs":[["sn56.70:1"]]},{"para":817,"vripara":null,"refs":["sn56.70:1"],"lines":["Bījagāmasuttavaṇṇanā"],"lineRefs":[["sn56.70:1"]]}],"wordLinks":[]},"tika2":null}
