{"suttaId":"vv25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[794,822],"vripara":"246"},"segments":{"vv25:0.4":"Niddāvimānavatthu","vv25:1.1":"“Abhikkantena vaṇṇena,","vv25:1.2":"yā tvaṃ tiṭṭhasi devate;","vv25:1.3":"Obhāsentī disā sabbā,","vv25:1.4":"osadhī viya tārakā. 247.","vv25:2.1":"“Kena tetādiso vaṇṇo…pe…","vv25:2.3":"Vaṇṇo ca te sabbadisā pabhāsatī”ti. 249.","vv25:3.1":"Sā devatā attamanā…pe…","vv25:3.3":"yassa kammassidaṃ phalaṃ. 250.","vv25:4.1":"“Niddāti [saddhāti (sī.)] mamaṃ aññaṃsu,","vv25:4.2":"rājagahasmiṃ upāsikā;","vv25:4.3":"Saddhā sīlena sampannā,","vv25:4.4":"saṃvibhāgaratā sadā. 251.","vv25:5.1":"“Acchādanañca bhattañca,","vv25:5.2":"senāsanaṃ padīpiyaṃ;","vv25:5.3":"Adāsiṃ ujubhūtesu,","vv25:5.4":"vippasannena cetasā. 252.","vv25:6.1":"“Cātuddasiṃ pañcadasiṃ,","vv25:6.2":"yā ca pakkhassa aṭṭhamī;","vv25:6.3":"Pāṭihāriyapakkhañca,","vv25:6.4":"aṭṭhaṅgasusamāgataṃ. 253.","vv25:7.1":"“Uposathaṃ upavasissaṃ,","vv25:7.2":"sadā sīlesu saṃvutā;","vv25:7.3":"Saññamā saṃvibhāgā ca,","vv25:7.4":"vimānaṃ āvasāmahaṃ. 254.","vv25:8.1":"“Pāṇātipātā viratā,","vv25:8.2":"musāvādā ca saññatā;","vv25:8.3":"Theyyā ca aticārā ca,","vv25:8.4":"majjapānā ca ārakā. 255.","vv25:9.1":"“Pañcasikkhāpade ratā,","vv25:9.2":"ariyasaccāna kovidā;","vv25:9.3":"Upāsikā cakkhumato,","vv25:9.4":"gotamassa yasassino. 256.","vv25:10.1":"“Tena metādiso vaṇṇo…pe…","vv25:10.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv25:11.1":"Niddāvimānaṃ [saddhāvimānaṃ (sī.)] aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1090,"to":1099,"paras":[{"para":1090,"vripara":"246","refs":["vv25:1"],"lines":["“Abhikkantena vaṇṇena…pe…"],"lineRefs":[["vv25:1"]]},{"para":1091,"vripara":null,"refs":["vv25:1"],"lines":["Vaṇṇo ca te sabbadisā pabhāsatī”ti. 247."],"lineRefs":[["vv25:1"]]},{"para":1093,"vripara":"247","refs":["vv25:2"],"lines":["“Sā devatā attamanā…pe… yassa kammassidaṃ phalaṃ”. 248."],"lineRefs":[["vv25:2"]]},{"para":1095,"vripara":"248","refs":["vv25:2"],"lines":["“Niddāti mamaṃ aññaṃsu, rājagahasmiṃ upāsikā…pe…"],"lineRefs":[["vv25:2"]]},{"para":1096,"vripara":null,"refs":["vv25:2"],"lines":["Gotamassa yasassino. 256."],"lineRefs":[["vv25:2"]]},{"para":1098,"vripara":"256","refs":["vv25:10"],"lines":["“Tena metādiso vaṇṇo…pe…vaṇṇo ca me sabbadisā pabhāsatī”ti. 258."],"lineRefs":[["vv25:10"]]}],"wordLinks":[],"before":[{"para":1087,"vripara":null,"title":"Niddā-suniddāvimānavaṇṇanā","lines":["Niddā-suniddāvimānavaṇṇanā"]},{"para":1088,"vripara":null,"title":"Niddā-suniddāvimānavaṇṇanā","lines":["Aṭṭhamanavamavimānāni rājagahanidānāni.","Aṭṭhuppattiyaṃ yathākkamaṃ “niddā nāma upāsikā…pe… gotamassa yasassino.","Tena metādiso vaṇṇo…pe… suniddā nāma upāsikā”ti vattabbaṃ.","Sesaṃ vuttanayameva.","Gāthāsupi apubbaṃ natthi.","Tathā hi ekaccesu potthakesu pāḷi peyyālavasena ṭhapitāti.","Tena vuttaṃ – 246."]}]},"tika":null,"tika2":null}
