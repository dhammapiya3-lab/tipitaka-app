{"suttaId":"vv25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[794,822],"vripara":"246"},"segments":{"vv25:0.4":"Niddāvimānavatthu","vv25:1.1":"“Abhikkantena vaṇṇena, yā tvaṃ tiṭṭhasi devate;","vv25:1.3":"Obhāsentī disā sabbā, osadhī viya tārakā.","vv25:2.1":"“Kena tetādiso vaṇṇo … pe …","vv25:2.3":"Vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv25:3.1":"Sā devatā attamanā … pe … yassa kammassidaṃ phalaṃ.","vv25:4.1":"“Niddāti [saddhāti (sī.)] mamaṃ aññaṃsu, rājagahasmiṃ upāsikā;","vv25:4.3":"Saddhā sīlena sampannā, saṃvibhāgaratā sadā.","vv25:5.1":"“Acchādanañca bhattañca, senāsanaṃ padīpiyaṃ;","vv25:5.3":"Adāsiṃ ujubhūtesu, vippasannena cetasā.","vv25:6.1":"“Cātuddasiṃ pañcadasiṃ, yā ca pakkhassa aṭṭhamī;","vv25:6.3":"Pāṭihāriyapakkhañca, aṭṭhaṅgasusamāgataṃ.","vv25:7.1":"“Uposathaṃ upavasissaṃ, sadā sīlesu saṃvutā;","vv25:7.3":"Saññamā saṃvibhāgā ca, vimānaṃ āvasāmahaṃ.","vv25:8.1":"“Pāṇātipātā viratā, musāvādā ca saññatā;","vv25:8.3":"Theyyā ca aticārā ca, majjapānā ca ārakā.","vv25:9.1":"“Pañcasikkhāpade ratā, ariyasaccāna kovidā;","vv25:9.3":"Upāsikā cakkhumato, gotamassa yasassino.","vv25:10.1":"“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv25:11.1":"Niddāvimānaṃ [saddhāvimānaṃ (sī.)] aṭṭhamaṃ."},"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1090,"to":1099,"paras":[{"para":1090,"vripara":"246","refs":["vv25:1"],"lines":["“Abhikkantena vaṇṇena … pe …"],"lineRefs":[["vv25:1"]]},{"para":1091,"vripara":null,"refs":["vv25:1"],"lines":["Vaṇṇo ca te sabbadisā pabhāsatī”ti."],"lineRefs":[["vv25:1"]]},{"para":1093,"vripara":"247","refs":["vv25:2"],"lines":["“Sā devatā attamanā … pe … yassa kammassidaṃ phalaṃ”."],"lineRefs":[["vv25:2"]]},{"para":1095,"vripara":"248","refs":["vv25:2"],"lines":["“Niddāti mamaṃ aññaṃsu, rājagahasmiṃ upāsikā … pe …"],"lineRefs":[["vv25:2"]]},{"para":1096,"vripara":null,"refs":["vv25:2"],"lines":["Gotamassa yasassino."],"lineRefs":[["vv25:2"]]},{"para":1098,"vripara":"256","refs":["vv25:10"],"lines":["“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti."],"lineRefs":[["vv25:10"]]}],"wordLinks":[],"before":[{"para":1086,"vripara":null,"refs":[],"lines":["Uposathāvimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1087,"vripara":null,"refs":[],"lines":["8-9. Niddā-suniddāvimānavaṇṇanā"],"lineRefs":[[]]},{"para":1088,"vripara":null,"refs":[],"lines":["Aṭṭhamanavamavimānāni rājagahanidānāni.","Aṭṭhuppattiyaṃ yathākkamaṃ “niddā nāma upāsikā … pe … gotamassa yasassino.","Tena metādiso vaṇṇo … pe … suniddā nāma upāsikā”ti vattabbaṃ.","Sesaṃ vuttanayameva.","Gāthāsupi apubbaṃ natthi.","Tathā hi ekaccesu potthakesu pāḷi peyyālavasena ṭhapitāti.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[],[],[]]}]},"tika":null,"tika2":null}
