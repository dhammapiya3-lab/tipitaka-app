{"suttaId":"an4.86","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[885,885],"vripara":"86"},"segments":{"an4.86:0.3":"Oṇatoṇatasuttaṃ","an4.86:1.1":"“Cattārome, bhikkhave, puggalā santo saṃvijjamānā lokasmiṃ.","an4.86:1.2":"Katame cattāro?","an4.86:1.3":"Oṇatoṇato, oṇatuṇṇato, uṇṇatoṇato, uṇṇatuṇṇato.","an4.86:1.7":"Ime kho, bhikkhave, cattāro puggalā santo saṃvijjamānā lokasmin”ti [pu. pa.169].","an4.86:1.8":"Chaṭṭhaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1335,"to":1335,"paras":[{"para":1335,"vripara":"86","refs":["an4.86:1"],"words":["oṇatoṇato","oṇatuṇṇato","uṇṇatoṇato","uṇṇatuṇṇato"],"lines":["Chaṭṭhe <b>oṇatoṇato</b>ti idāni nīcako āyatimpi nīcako bhavissati.","<b>Oṇatuṇṇato</b>ti idāni nīco āyatiṃ ucco bhavissati.","<b>Uṇṇatoṇato</b>ti idāni ucco āyatiṃ nīco bhavissati.","<b>Uṇṇatuṇṇato</b>ti idāni ucco āyatimpi ucco bhavissati.","Vitthāro pana nesaṃ purimasuttanayeneva veditabbo."],"lineRefs":[["an4.86:1"],["an4.86:1"],["an4.86:1"],["an4.86:1"],["an4.86:1"]]}]},"tika":null}
