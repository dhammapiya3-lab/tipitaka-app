{"suttaId":"sn22.109","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[732,732],"vripara":"109"},"segments":{"sn22.109:0.3":"Sotāpannasuttaṃ","sn22.109:1.1":"Sāvatthinidānaṃ.","sn22.109:1.2":"“Pañcime, bhikkhave, upādānakkhandhā.","sn22.109:1.3":"Katame pañca?","sn22.109:1.4":"Seyyathidaṃ – rūpupādānakkhandho … pe … viññāṇupādānakkhandho.","sn22.109:1.5":"Yato kho, bhikkhave, ariyasāvako imesaṃ pañcannaṃ upādānakkhandhānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ pajānāti.","sn22.109:1.6":"Ayaṃ vuccati, bhikkhave, ariyasāvako sotāpanno avinipātadhammo niyato sambodhiparāyano”ti.","sn22.109:1.7":"Sattamaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":367,"to":370,"paras":[{"para":367,"vripara":"107-112","refs":["sn22.109:1"],"lines":["107-112. Pañcamādīsu catūsu cattāri saccāni kathitāni.","Navamadasamesu kilesappahānanti.","Pañcamādīni."],"lineRefs":[["sn22.109:1"],["sn22.109:1"],["sn22.109:1"]]},{"para":368,"vripara":null,"refs":["sn22.109:1"],"lines":["Antavaggo ekādasamo."],"lineRefs":[["sn22.109:1"]]},{"para":369,"vripara":null,"refs":["sn22.109:1"],"lines":["Dhammakathikavaggo"],"lineRefs":[["sn22.109:1"]]},{"para":370,"vripara":null,"refs":["sn22.109:1"],"lines":["1-2. Avijjāsuttādivaṇṇanā"],"lineRefs":[["sn22.109:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":359,"to":364,"paras":[{"para":359,"vripara":"107-112","refs":["sn22.109:1"],"lines":["107-112. <b>Cattāri saccāni kathitāni</b> assādādīnaṃ samudayādīnañca desitattā."],"lineRefs":[["sn22.109:1"]]},{"para":360,"vripara":null,"refs":["sn22.109:1"],"lines":["<b>Kilesappahānaṃ kathitaṃ</b> rāgappahānassa jotitattā."],"lineRefs":[["sn22.109:1"]]},{"para":361,"vripara":null,"refs":["sn22.109:1"],"lines":["Samaṇasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.109:1"]]},{"para":362,"vripara":null,"refs":["sn22.