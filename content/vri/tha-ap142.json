{"suttaId":"tha-ap142","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6237,6264],"vripara":"66"},"segments":{"tha-ap142:0.3":"Piyālaphaladāyakattheraapadānaṃ","tha-ap142:1.1":"“Pārāvato [parodhako (syā.)] tadā āsiṃ,","tha-ap142:1.2":"paraṃ anuparodhako;","tha-ap142:1.3":"Pabbhāre seyyaṃ kappemi,","tha-ap142:1.4":"avidūre sikhisatthuno.","tha-ap142:2.1":"“Sāyaṃ pātañca passāmi,","tha-ap142:2.2":"buddhaṃ lokagganāyakaṃ;","tha-ap142:2.3":"Deyyadhammo ca me natthi,","tha-ap142:2.4":"dvipadindassa tādino.","tha-ap142:3.1":"“Piyālaphalamādāya,","tha-ap142:3.2":"agamaṃ buddhasantikaṃ;","tha-ap142:3.3":"Paṭiggahesi bhagavā,","tha-ap142:3.4":"lokajeṭṭho narāsabho.","tha-ap142:4.1":"“Tato paraṃ upādāya,","tha-ap142:4.2":"paricāriṃ vināyakaṃ;","tha-ap142:4.3":"Tena cittappasādena,","tha-ap142:4.4":"tattha kālaṅkato ahaṃ.","tha-ap142:5.1":"“Ekattiṃse ito kappe,","tha-ap142:5.2":"yaṃ phalaṃ adadiṃ ahaṃ;","tha-ap142:5.3":"Duggatiṃ nābhijānāmi,","tha-ap142:5.4":"phaladānassidaṃ phalaṃ.","tha-ap142:6.1":"“Ito pannarase kappe,","tha-ap142:6.2":"tayo āsuṃ piyālino;","tha-ap142:6.3":"Sattaratanasampannā,","tha-ap142:6.4":"cakkavattī mahabbalā.","tha-ap142:7.1":"“Paṭisambhidā catasso … pe …","tha-ap142:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap142:8.1":"Itthaṃ sudaṃ āyasmā piyālaphaladāyako thero imā gāthāyo abhāsitthāti.","tha-ap142:9.1":"Piyālaphaladāyakattherassāpadānaṃ dasamaṃ.","tha-ap142:10.1":"Sobhitavaggo cuddasamo.","tha-ap142:11.1":"Tassuddānaṃ –","tha-ap142:12.1":"Sobhitasudassano ca,","tha-ap142:12.2":"candano pupphachadano;","tha-ap142:12.3":"Raho campakapupphī ca,","tha-ap142:12.4":"atthasandassakena ca.","tha-ap142:13.1":"Ekapasādī [ekaraṃsi (syā.)] sāladado,","tha-ap142:13.2":"dasamo phaladāyako;","tha-ap142:13.3":"Gāthāyo sattati dve ca,","tha-ap142:13.4":"gaṇitāyo vibhāvibhi."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2979,"to":2980,"paras":[{"para":2979,"vripara":"66","refs":["tha-ap142:1"],"lines":["So tattha dibbasampattiyo anubhavitvā manussesu ca anekavidhasampattiyo anubhavitvā imasmiṃ buddhuppāde gahapatikule nibbatto viññutaṃ patto gharāvāsaṃ saṇṭhapetvā tattha anabhirato gehaṃ pahāya satthu santike pabbajitvā vipassanaṃ vaḍḍhetvā nacirasseva arahattaṃ patto attano kataphaladānakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>parodhako tadā āsin</b>tiādimāha.","Tattha yadā ahaṃ piyālaphalaṃ datvā cittaṃ pasādesiṃ, tadā ahaṃ parodhako āsinti sambandho.","<b>Parodhako</b>ti parasattarodhako vihesako.","“Pararodhako”ti vattabbe pubbassa ra-kārassa lopaṃ katvā “parodhako”ti vuttaṃ."],"lineRefs":[["tha-ap142:1"],["tha-ap142:1"],["tha-ap142:1"],["tha-ap142:1"]]},{"para":2980,"vripara":"69","refs":["tha-ap142:4"],"lines":["<b>Paricāriṃ vināyakan</b>ti taṃ nibbānapāpakaṃ satthāraṃ,“bhante, imaṃ phalaṃ paribhuñjathā”ti pavāriṃ nimantesiṃ ārādhesinti attho.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap142:4"],["tha-ap142:4"]]}],"wordLinks":[["tha-ap142:1.1","parodhako",0,2],["tha-ap142:4.1","paricāriṃ vināyakaṃ",1,0]]},"tika":null,"tika2":null}
