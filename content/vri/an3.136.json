{"suttaId":"an3.136","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[1194,1194],"vripara":"137"},"segments":{"an3.136:0.3":"Uppādāsuttaṃ","an3.136:1.1":"“Uppādā vā, bhikkhave, tathāgatānaṃ anuppādā vā tathāgatānaṃ, ṭhitāva sā dhātu dhammaṭṭhitatā dhammaniyāmatā.","an3.136:1.2":"Sabbe saṅkhārā aniccā.","an3.136:1.3":"Taṃ tathāgato abhisambujjhati abhisameti.","an3.136:1.4":"Abhisambujjhitvā abhisametvā ācikkhati deseti paññāpeti paṭṭhapeti vivarati vibhajati uttānīkaroti –","an3.136:1.5":"‘sabbe saṅkhārā aniccā’ti.","an3.136:1.6":"Uppādā vā, bhikkhave, tathāgatānaṃ anuppādā vā tathāgatānaṃ ṭhitāva sā dhātu dhammaṭṭhitatā dhammaniyāmatā.","an3.136:1.7":"Sabbe saṅkhārā dukkhā.","an3.136:1.8":"Taṃ tathāgato abhisambujjhati abhisameti.","an3.136:1.9":"Abhisambujjhitvā abhisametvā ācikkhati deseti paññāpeti paṭṭhapeti vivarati vibhajati uttānīkaroti –","an3.136:1.10":"‘sabbe saṅkhārā dukkhā’ti.","an3.136:1.11":"Uppādā vā, bhikkhave, tathāgatānaṃ anuppādā vā tathāgatānaṃ ṭhitāva sā dhātu dhammaṭṭhitatā dhammaniyāmatā.","an3.136:1.12":"Sabbe dhammā anattā.","an3.136:1.13":"Taṃ tathāgato abhisambujjhati abhisameti.","an3.136:1.14":"Abhisambujjhitvā abhisametvā ācikkhati deseti paññāpeti paṭṭhapeti vivarati vibhajati uttānīkaroti –","an3.136:1.15":"‘sabbe dhammā anattā’”ti.","an3.136:1.16":"Catutthaṃ."},"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":960,"to":960,"paras":[{"para":960,"vripara":"137","refs":["an3.136:1"],"lines":["Catutthe <b>dhammaṭṭhitatā</b>ti sabhāvaṭṭhitatā.","<b>Dhammaniyāmatā</b>ti sabhāvaniyāmatā.","<b>Sabbe saṅkhārā</b>ti catubhūmakasaṅkhārā.","<b>Aniccā</b>ti hutvā abhāvaṭṭhena aniccā.","<b>Dukkhā</b>ti sampaṭipīḷanaṭṭhena dukkhā.","<b>Anattā</b>ti avasavattanaṭṭhena anattā.","Iti imasmiṃ sutte tīṇi lakkhaṇāni missakāni kathitāni."],"lineRefs":[["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"]]}],"wordLinks":[["an3.136:1.1","dhammaṭṭhitatā",0,0],["an3.136:1.6","dhammaṭṭhitatā",0,0],["an3.136:1.11","dhammaṭṭhitatā",0,0],["an3.136:1.1","dhammaniyāmatā",0,1],["an3.136:1.6","dhammaniyāmatā",0,1],["an3.136:1.11","dhammaniyāmatā",0,1],["an3.136:1.2","sabbe saṅkhārā",0,2],["an3.136:1.5","sabbe saṅkhārā",0,2],["an3.136:1.7","sabbe saṅkhārā",0,2],["an3.136:1.10","sabbe saṅkhārā",0,2],["an3.136:1.2","aniccā",0,3],["an3.136:1.5","aniccā",0,3],["an3.136:1.7","dukkhā",0,4],["an3.136:1.10","dukkhā",0,4],["an3.136:1.12","anattā",0,5],["an3.136:1.15","anattā",0,5]]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":997,"to":1000,"paras":[{"para":997,"vripara":"137","refs":["an3.136:1"],"lines":["Catutthe <b>uppādā vā tathāgatānan</b>ti tathāgatānaṃ uppādepi veneyyapuggalānaṃ maggaphaluppatti viya saṅkhārānaṃ aniccādisabhāvo na tathāgatuppādāyatto, atha kho tathāgatānaṃ uppādepi anuppādepi hotimevāti vuttaṃ hoti.","<b>Ṭhitāva sā dhātū</b>ti ṭhito eva so aniccasabhāvo byabhicārābhāvato na kadāci saṅkhārā aniccā na hoti.","Kāmaṃ asaṅkhatā viya dhātu na nicco so sabhāvo, tathāpi sabbakālikoyevāti adhippāyo."],"lineRefs":[["an3.136:1"],["an3.136:1"],["an3.136:1"]]},{"para":998,"vripara":null,"refs":["an3.136:1"],"lines":["Aparo nayo – <b>ṭhitāva sā dhātū</b>ti “sabbe saṅkhārā aniccā”ti esā dhātu esa sabhāvo tathāgatānaṃ uppādato pubbe uddhañca appaṭivijjhiyamāno na tathāgatehi uppādito, atha kho sabbakālaṃ sabbe saṅkhārā aniccā, ṭhitāva sā dhātu, kevalaṃ pana sayambhuñāṇena abhisambujjhanato “ayaṃ dhammo tathāgatena abhisambuddho”ti pavedanato ca tathāgato dhammassāmīti vuccati apubbassa tassa uppādanato.","Tena vuttaṃ <b>“ṭhitāva sā dhātū”</b>ti."],"lineRefs":[["an3.136:1"],["an3.136:1"]]},{"para":999,"vripara":null,"refs":["an3.136:1"],"lines":["<b>Abhisambujjhatī</b>ti ñāṇena abhisambujjhati.","<b>Abhisametī</b>ti ñāṇena abhisamāgacchati.","<b>Ācikkhatī</b>ti katheti.","<b>Desetī</b>ti dasseti.","<b>Paññāpetī</b>ti jānāpeti.","<b>Paṭṭhapetī</b>ti ñāṇamukhe ṭhapeti.","<b>Vivaratī</b>ti vivaritvā dasseti.","<b>Vibhajatī</b>ti vibhāgato dasseti.","<b>Uttānīkarotī</b>ti pākaṭaṃ karoti."],"lineRefs":[["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"]]},{"para":1000,"vripara":null,"refs":["an3.136:1"],"lines":["Atha vā <b>abhisambujjhatī</b>ti paccakkhakaraṇena abhimukhaṃ bujjhati, yāthāvato paṭivijjhati.","Tato eva <b>abhisameti</b> abhimukhaṃ samāgacchati.","Ādito kathento <b>ācikkhati,</b> uddisatīti attho.","Tameva uddesaṃ pariyosāpento <b>deseti</b>.","Yathāuddiṭṭhamatthaṃ nidassanavasena pakārehi ñāpento <b>paññāpeti</b>.","Pakārehi etamatthaṃ patiṭṭhapento <b>paṭṭhapeti</b>.","Yathāuddiṭṭhaṃ paṭinidassanavasena <b>vivarati vibhajati</b>.","Vivaṭaṃ vibhattañca atthaṃ hetūdāharaṇadassanehi pākaṭaṃ karonto <b>uttānīkaroti</b>."],"lineRefs":[["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"],["an3.136:1"]]}],"wordLinks":[["an3.136:1.1","uppādā vā tathāgatānaṃ",0,0],["an3.136:1.6","uppādā vā tathāgatānaṃ",0,0],["an3.136:1.11","uppādā vā tathāgatānaṃ",0,0],["an3.136:1.1","ṭhitāva sā dhātū",0,1],["an3.136:1.6","ṭhitāva sā dhātū",0,1],["an3.136:1.11","ṭhitāva sā dhātū",0,1],["an3.136:1.1","ṭhitāva sā dhātū",1,0],["an3.136:1.6","ṭhitāva sā dhātū",1,0],["an3.136:1.11","ṭhitāva sā dhātū",1,0],["an3.136:1.1","ṭhitāva sā dhātū",1,1],["an3.136:1.6","ṭhitāva sā dhātū",1,1],["an3.136:1.11","ṭhitāva sā dhātū",1,1],["an3.136:1.3","abhisambujjhatī",2,0],["an3.136:1.8","abhisambujjhatī",2,0],["an3.136:1.13","abhisambujjhatī",2,0],["an3.136:1.3","abhisametī",2,1],["an3.136:1.4","abhisametī",2,1],["an3.136:1.8","abhisametī",2,1],["an3.136:1.9","abhisametī",2,1],["an3.136:1.13","abhisametī",2,1],["an3.136:1.14","abhisametī",2,1],["an3.136:1.4","ācikkhatī",2,2],["an3.136:1.9","ācikkhatī",2,2],["an3.136:1.14","ācikkhatī",2,2],["an3.136:1.4","desetī",2,3],["an3.136:1.9","desetī",2,3],["an3.136:1.14","desetī",2,3],["an3.13