{"suttaId":"vv27","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[842,857],"vripara":"270"},"segments":{"vv27:0.4":"Paṭhamabhikkhādāyikāvimānavatthu","vv27:1.1":"“Abhikkantena vaṇṇena, yā tvaṃ tiṭṭhasi devate;","vv27:1.3":"Obhāsentī disā sabbā, osadhī viya tārakā.","vv27:2.1":"“Kena tetādiso vaṇṇo … pe … vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv27:3.1":"Sā devatā attamanā … pe … yassa kammassidaṃ phalaṃ.","vv27:4.1":"“Ahaṃ manussesu manussabhūtā, purimāya jātiyā manussaloke.","vv27:5.1":"“Addasaṃ virajaṃ buddhaṃ, vippasannamanāvilaṃ;","vv27:5.3":"Tassa adāsahaṃ bhikkhaṃ, pasannā sehi pāṇibhi.","vv27:6.1":"“Tena metādiso vaṇṇo … pe …","vv27:6.3":"Vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv27:7.1":"Paṭhamabhikkhādāyikāvimānaṃ dasamaṃ."},"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1113,"to":1132,"paras":[{"para":1113,"vripara":"270","refs":["vv27:1"],"lines":["“Abhikkantena vaṇṇena … pe … osadhī viya tārakā."],"lineRefs":[["vv27:1"]]},{"para":1115,"vripara":"271","refs":["vv27:2"],"lines":["“Kena tetādiso vaṇṇo … pe …"],"lineRefs":[["vv27:2"]]},{"para":1116,"vripara":null,"refs":[],"lines":["Vaṇṇo ca te sabbadisā pabhāsatī”ti.","– gāthāhi pucchi;"],"lineRefs":[[],[]]},{"para":1118,"vripara":"273","refs":["vv27:3"],"lines":["“Sā devatā attamanā … pe … yassa kammassidaṃ phalaṃ”."],"lineRefs":[["vv27:3"]]},{"para":1120,"vripara":"274","refs":["vv27:4"],"lines":["“Ahaṃ manussesu manussabhūtā,"],"lineRefs":[["vv27:4"]]},{"para":1121,"vripara":null,"refs":[],"lines":["Purimāya jātiyā manussaloke."],"lineRefs":[[]]},{"para":1123,"vripara":"275","refs":["vv27:5"],"lines":["“Addasaṃ virajaṃ buddhaṃ, vippasannamanāvilaṃ;"],"lineRefs":[["vv27:5"]]},{"para":1124,"vripara":null,"refs":[],"lines":["Tassa adāsahaṃ bhikkhaṃ, pasannā sehi pāṇibhi."],"lineRefs":[[]]},{"para":1126,"vripara":"276","refs":["vv27:6"],"lines":["“Tena metādiso vaṇṇo … pe …"],"lineRefs":[["vv27:6"]]},{"para":1127,"vripara":null,"refs":[],"lines":["Vaṇṇo ca me sabbadisā pabhāsatī”ti.","–"],"lineRefs":[[],[]]},{"para":1128,"vripara":null,"refs":[],"lines":["Devatā byākāsi.","Sesaṃ sabbaṃ heṭṭhā vuttanayattā uttānatthameva."],"lineRefs":[[],[]]},{"para":1129,"vripara":null,"refs":[],"lines":["Paṭhamabhikkhādāyikāvimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1130,"vripara":null,"refs":[],"lines":["Dutiyabhikkhādāyikāvimānavaṇṇanā"],"lineRefs":[[]]},{"para":1131,"vripara":null,"refs":[],"lines":["<b>Abhikkantena vaṇṇenā</b>ti dutiyabhikkhādāyikāvimānaṃ.","Tassa kā uppatti?","Bhagavā rājagahe viharati.","Tattha aññatarā itthī saddhā pasannā aññataraṃ khīṇāsavattheraṃ piṇḍāya carantaṃ disvā attano gehaṃ pavesetvā bhojanaṃ adāsi.","Sā aparena samayena kālaṃ katvā tāvatiṃsabhavane nibbatti.","Sesaṃ anantaravimānasadisameva."],"lineRefs":[[],[],[],[],[],[]]}],"wordLinks":[]},"tika":null,"tika2":null}
