{"suttaId":"vv27","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[842,857],"vripara":"270"},"segments":{"vv27:0.4":"Paṭhamabhikkhādāyikāvimānavatthu","vv27:1.1":"“Abhikkantena vaṇṇena,","vv27:1.2":"yā tvaṃ tiṭṭhasi devate;","vv27:1.3":"Obhāsentī disā sabbā,","vv27:1.4":"osadhī viya tārakā. 271.","vv27:2.1":"“Kena tetādiso vaṇṇo…pe…","vv27:2.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti. 273.","vv27:3.1":"Sā devatā attamanā…pe…","vv27:3.3":"yassa kammassidaṃ phalaṃ. 274.","vv27:4.1":"“Ahaṃ manussesu manussabhūtā,","vv27:4.2":"purimāya jātiyā manussaloke. 275.","vv27:5.1":"“Addasaṃ virajaṃ buddhaṃ,","vv27:5.2":"vippasannamanāvilaṃ;","vv27:5.3":"Tassa adāsahaṃ bhikkhaṃ,","vv27:5.4":"pasannā sehi pāṇibhi. 276.","vv27:6.1":"“Tena metādiso vaṇṇo…pe…","vv27:6.3":"Vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv27:7.1":"Paṭhamabhikkhādāyikāvimānaṃ dasamaṃ. 11."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1113,"to":1132,"paras":[{"para":1113,"vripara":"270","refs":["vv27:1"],"lines":["“Abhikkantena vaṇṇena…pe… osadhī viya tārakā. 271."],"lineRefs":[["vv27:1"]]},{"para":1115,"vripara":"271","refs":["vv27:2"],"lines":["“Kena tetādiso vaṇṇo…pe…"],"lineRefs":[["vv27:2"]]},{"para":1116,"vripara":null,"refs":["vv27:2"],"lines":["Vaṇṇo ca te sabbadisā pabhāsatī”ti. –","gāthāhi pucchi; 273."],"lineRefs":[["vv27:2"],["vv27:2"]]},{"para":1118,"vripara":"273","refs":["vv27:3"],"lines":["“Sā devatā attamanā…pe… yassa kammassidaṃ phalaṃ”. 274."],"lineRefs":[["vv27:3"]]},{"para":1120,"vripara":"274","refs":["vv27:4"],"lines":["“Ahaṃ manussesu manussabhūtā,"],"lineRefs":[["vv27:4"]]},{"para":1121,"vripara":null,"refs":["vv27:4"],"lines":["Purimāya jātiyā manussaloke. 275."],"lineRefs":[["vv27:4"]]},{"para":1123,"vripara":"275","refs":["vv27:5"],"lines":["“Addasaṃ virajaṃ buddhaṃ, vippasannamanāvilaṃ;"],"lineRefs":[["vv27:5"]]},{"para":1124,"vripara":null,"refs":["vv27:5"],"lines":["Tassa