{"suttaId":"snp5.12","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3786,3803],"vripara":"1102"},"segments":{"snp5.12:0.2":"Jatukaṇṇimāṇavapucchā","snp5.12:1.1":"“Sutvānahaṃ vīramakāmakāmiṃ,","snp5.12:1.2":"(iccāyasmā jatukaṇṇi)","snp5.12:1.3":"Oghātigaṃ puṭṭhumakāmamāgamaṃ;","snp5.12:1.4":"Santipadaṃ brūhi sahajanetta,","snp5.12:1.5":"yathātacchaṃ bhagavā brūhi me taṃ. 1103.","snp5.12:2.1":"“Bhagavā hi kāme abhibhuyya iriyati,","snp5.12:2.2":"ādiccova pathaviṃ tejī tejasā;","snp5.12:2.3":"Parittapaññassa me bhūripañña,","snp5.12:2.4":"ācikkha dhammaṃ yamahaṃ vijaññaṃ;","snp5.12:2.5":"Jātijarāya idha vippahānaṃ”. 1104.","snp5.12:3.1":"“Kāmesu vinaya gedhaṃ,","snp5.12:3.2":"(jatukaṇṇīti bhagavā)","snp5.12:3.3":"nekkhammaṃ daṭṭhu khemato;","snp5.12:3.4":"Uggahītaṃ nirattaṃ vā,","snp5.12:3.5":"mā te vijjittha kiñcanaṃ. 1105.","snp5.12:4.1":"“Yaṃ pubbe taṃ visosehi,","snp5.12:4.2":"pacchā te māhu kiñcanaṃ;","snp5.12:4.3":"Majjhe ce no gahessasi,","snp5.12:4.4":"upasanto carissasi. 1106.","snp5.12:5.1":"“Sabbaso nāmarūpasmiṃ,","snp5.12:5.2":"vītagedhassa brāhmaṇa;","snp5.12:5.3":"Āsavāssa na vijjanti,","snp5.12:5.4":"yehi maccuvasaṃ vaje”ti.","snp5.12:5.5":"Jatukaṇṇimāṇavapucchā ekādasamā niṭṭhitā. 12."},"unsure":[],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2608,"to":2609,"paras":[{"para":2608,"vripara":"1103-1104","refs":["snp5.12:2"],"lines":["<b>Sutvānaha</b>nti jatukaṇṇisuttaṃ.","Tattha <b>sutvānahaṃ vīramakāmakāmi</b>nti ahaṃ “itipi so bhagavā”tiādinā nayena vīraṃ kāmānaṃ akāmanato akāmakāmiṃ buddhaṃ sutvā.","<b>Akāmamāgama</b>nti nikkāmaṃ bhagavantaṃ pucchituṃ āgatomhi.","<b>Sahajanettā</b>ti sahajātasabbaññutaññāṇacakkhu.","<b>Yathātaccha</b>nti yathātathaṃ.","<b>Brūhi me</b>ti puna yācanto bhaṇati.","Yācanto hi sahassakkhattumpi bhaṇeyya, ko pana vādo dvikkhattuṃ.","<b>Tejī tejasā</b>ti tejena samannāgato tejasā abhibhuyya.","<b>Yamahaṃ vijaññaṃ jātijarāya idha vippahāna</b>nti yamahaṃ jātijarānaṃ pahānabhūtaṃ dhammaṃ idheva jāneyyaṃ. 1105-7."],"lineRefs":[["snp5.12:2"],["snp5.12:2"],["snp5.12:2"],["snp5.12:2"],["snp5.12:2"],["snp5.12:2"],["snp5.12:2"],["snp5.12:2"],["snp5.12:2"]]},{"para":2609,"vripara":"1105-1107","refs":["snp5.12:2","snp5.12:4"],"lines":["Athassa bhagavā taṃ dhammamācikkhanto tisso gāthāyo abhāsi.","Tattha <b>nekkhammaṃ daṭṭhu khemato</b>ti nibbānañca nibbānagāminiñca paṭipadaṃ “khema”nti disvā.","<b>Uggahita</b>nti taṇhādiṭṭhivasena gahitaṃ.","<b>Nirattaṃ vā</b>ti nirassitabbaṃ vā, muñcitabbanti vuttaṃ hoti.","<b>Mā te vijjitthā</b>ti mā te ahosi.","<b>Kiñcana</b>nti rāgādikiñcanaṃ vāpi te mā vijjittha.","<b>Pubbe</b>ti atīte saṅkhāre ārabbha uppannakilesā.","<b>Brāhmaṇā</b>ti bhagavā jatukaṇṇiṃ ālapati.","Sesaṃ sabbattha pākaṭameva."],"lineRefs":[["snp5.12:2"],["snp5.12:2"],["snp5.12:2"],["snp5.12:2"],["snp5.12:2"],["snp5.12:4"],["snp5.12:4"],["snp5.12:4"],["snp5.12:4"]]}],"wordLinks":[["snp5.12:2.1","tejī tejasā",0,7],["snp5.12:4.1","kiñcanaṃ",1,5],["snp5.12:4.1","pubbe",1,6]]},"tika":null,"tika2":null}
