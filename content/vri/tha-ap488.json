{"suttaId":"tha-ap488","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[2167,2181],"vripara":"106"},"segments":{"tha-ap488:0.3":"Dhātupūjakattheraapadānaṃ","tha-ap488:1.1":"“Nibbute lokanāthamhi, siddhatthe lokanāyake;","tha-ap488:1.3":"Mama ñātī samānetvā, dhātupūjaṃ akāsahaṃ.","tha-ap488:2.1":"“Catunnavutito kappe, yaṃ dhātumabhipūjayiṃ;","tha-ap488:2.3":"Duggatiṃ nābhijānāmi, dhātupūjāyidaṃ phalaṃ.","tha-ap488:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap488:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap488:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap488:6.1":"Itthaṃ sudaṃ āyasmā dhātupūjako thero imā gāthāyo Abhāsitthāti.","tha-ap488:7.1":"Dhātupūjakattherassāpadānaṃ chaṭṭhaṃ."},"attha":null,"tika":null,"tika2":null}
