{"suttaId":"sn22.129","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[797,798],"vripara":"129"},"segments":{"sn22.129:0.3":"Assādasuttaṃ","sn22.129:1.1":"Bārāṇasiyaṃ viharanti isipatane migadāye … pe …","sn22.129:1.2":"ekamantaṃ nisinno kho āyasmā mahākoṭṭhiko āyasmantaṃ sāriputtaṃ etadavoca –","sn22.129:1.3":"“‘avijjā, avijjā’ti, āvuso sāriputta, vuccati.","sn22.129:1.4":"Katamā nu kho, āvuso, avijjā,","sn22.129:1.5":"kittāvatā ca avijjāgato hotī”ti?","sn22.129:2.1":"“Idhāvuso assutavā puthujjano rūpassa assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānāti.","sn22.129:2.2":"Vedanāya … pe …","sn22.129:2.3":"saññāya …","sn22.129:2.4":"saṅkhārānaṃ …","sn22.129:2.5":"viññāṇassa assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānāti.","sn22.129:2.6":"Ayaṃ vuccatāvuso, avijjā;","sn22.129:2.7":"ettāvatā ca avijjāgato hotī”ti.","sn22.129:2.8":"Catutthaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":387,"to":390,"paras":[{"para":387,"vripara":"126-135","refs":["sn22.129:1"],"lines":["126-135. Avijjāvaggo uttānatthova.","Imasmiñhi vagge sabbasuttesu catusaccameva kathitaṃ."],"lineRefs":[["sn22.129:1"],["sn22.129:1"]]},{"para":388,"vripara":null,"refs":["sn22.129:1"],"lines":["Avijjāvaggo terasamo."],"lineRefs":[["sn22.129:1"]]},{"para":389,"vripara":null,"refs":["sn22.129:1"],"lines":["Kukkuḷavaggo"],"lineRefs":[["sn22.129:1"]]},{"para":390,"vripara":null,"refs":["sn22.129:1"],"lines":["1-13. Kukkuḷasuttādivaṇṇanā"],"lineRefs":[["sn22.129:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":390,"to":394,"paras":[{"para":390,"vripara":"126-135","refs":["sn22.129:1"],"lines":["126-135. <b>Imasmin</b>ti avijjāvagge.","<b>Catusaccameva kathitaṃ, tasmā</b> heṭṭhā vuttanayattā uttānamevāti adhippāyo."],"lineRefs":[["sn22.129:1"],["sn22.129:1"]]},{"para":391,"vripara":null,"refs":["sn22.129:1"]