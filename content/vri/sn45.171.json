{"suttaId":"sn45.171","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[382,382],"vripara":"172"},"segments":{"sn45.171:0.3":"Oghasuttaṃ","sn45.171:1.1":"Sāvatthinidānaṃ.","sn45.171:1.2":"“Cattārome, bhikkhave, oghā.","sn45.171:1.3":"Katame cattāro?","sn45.171:1.4":"Kāmogho, bhavogho, diṭṭhogho, avijjogho –","sn45.171:1.5":"ime kho, bhikkhave, cattāro oghā.","sn45.171:1.6":"Imesaṃ kho, bhikkhave, catunnaṃ oghānaṃ abhiññāya pariññāya parikkhayāya pahānāya … pe … ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.171:1.7":"(Yathā esanā, evaṃ sabbaṃ vitthāretabbaṃ.)","sn45.171:1.8":"Paṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":118,"to":118,"paras":[{"para":118,"vripara":"172-173","refs":["sn45.171:1"],"lines":["172-173. Oghavagge <b>kāmogho</b>ti pañcasu kāmaguṇesu chandarāgo.","<b>Bhavogho</b>ti rūpārūpabhavesu chandarāgo.","<b>Diṭṭhogho</b>ti dvāsaṭṭhi diṭṭhiyo.","<b>Avijjogho</b>ti catūsu saccesu aññāṇaṃ.","<b>Kāmayogā</b> dīsupi eseva nayo."],"lineRefs":[["sn45.171:1"],["sn45.171:1"],["sn45.171:1"],["sn45.171:1"],["sn45.171:1"]]}],"wordLinks":[["sn45.171:1.4","kāmogho",0,0],["sn45.171:1.4","bhavogho",0,1],["sn45.171:1.4","diṭṭhogho",0,2],["sn45.171:1.4","avijjogho",0,3]]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":118,"to":118,"paras":[{"para":118,"vripara":"172-173","refs":["sn45.171:1"],"lines":["172-173. Vaṭṭe ohananti osīdāpentīti <b>oghā.</b>","<b>Rūpārūpabhave</b>ti rūpabhave ca arūpabhave ca rūpārūpataṇhopanissayā rūpārūpāvacarakammanibbattā khandhā.","Yojanaṭṭhena <b>yogo</b>."],"lineRefs":[["sn45.171:1"],["sn45.171:1"],["sn45.171:1"]]}],"wordLinks":[["sn45.171:1.2","oghā",0,0],["sn45.171:1.4","oghā",0,0],["sn45.171:1.6","oghā",0,0]]},"tika2":null}
