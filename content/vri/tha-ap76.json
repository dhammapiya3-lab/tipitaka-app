{"suttaId":"tha-ap76","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4540,4556],"vripara":"13"},"segments":{"tha-ap76:0.3":"Bhisāluvadāyakattheraapadānaṃ","tha-ap76:1.1":"“Kānanaṃ vanamogayha,","tha-ap76:1.2":"vasāmi vipine ahaṃ;","tha-ap76:1.3":"Vipassiṃ addasaṃ buddhaṃ,","tha-ap76:1.4":"āhutīnaṃ paṭiggahaṃ.","tha-ap76:2.1":"“Bhisāluvañca pādāsiṃ,","tha-ap76:2.2":"udakaṃ hatthadhovanaṃ;","tha-ap76:2.3":"Vanditvā sirasā pāde,","tha-ap76:2.4":"pakkāmi uttarāmukho.","tha-ap76:3.1":"“Ekanavutito kappe,","tha-ap76:3.2":"bhisāluvamadaṃ tadā;","tha-ap76:3.3":"Duggatiṃ nābhijānāmi,","tha-ap76:3.4":"puññakammassidaṃ phalaṃ.","tha-ap76:4.1":"“Ito tatiyake kappe,","tha-ap76:4.2":"bhisasammatakhattiyo;","tha-ap76:4.3":"Sattaratanasampanno,","tha-ap76:4.4":"cakkavattī mahabbalo.","tha-ap76:5.1":"“Paṭisambhidā catasso … pe …","tha-ap76:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap76:6.1":"Itthaṃ sudaṃ āyasmā bhisāluvadāyako thero imā gāthāyo abhāsitthāti.","tha-ap76:7.1":"Bhisāluvadāyakattherassāpadānaṃ catutthaṃ.","tha-ap76:7.2":"Chaṭṭhabhāṇavāraṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2675,"to":2675,"paras":[{"para":2675,"vripara":"13","refs":["tha-ap76:1"],"lines":["So tato attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>kānanaṃ vanamoggayhā</b>tiādimāha.","Taṃ heṭṭhā vuttatthameva.","<b>Vasāmi vipine ahan</b>ti vivekavāso ahaṃ vasāmīti sambandho.","Sesaṃ uttānatthamevāti."],"lineRefs":[["tha-ap76:1"],["tha-ap76:1"],["tha-ap76:1"],["tha-ap76:1"]]}],"wordLinks":[["tha-ap76:1.1","vasāmi vipine ahaṃ",0,2]]},"tika":null,"tika2":null}
