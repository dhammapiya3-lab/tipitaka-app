{"suttaId":"ja286","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2148,2157],"vripara":"106"},"segments":{"ja286:0.4":"Sālūkajātakaṃ (3-4-6)","ja286:1.1":"Mā sālūkassa pihayi, āturannāni bhuñjati;","ja286:1.3":"Appossukko bhusaṃ khāda, etaṃ dīghāyulakkhaṇaṃ.","ja286:2.1":"Idāni so idhāgantvā, atithī yuttasevako;","ja286:2.3":"Atha dakkhasi sālūkaṃ, sayantaṃ musaluttaraṃ.","ja286:3.1":"Vikantaṃ [vikattaṃ (sī.), vikantiyamānaṃ chindiyamānaṃti attho] sūkaraṃ disvā, sayantaṃ musaluttaraṃ;","ja286:3.3":"Jaraggavā vicintesuṃ, varamhākaṃ bhusāmivāti.","ja286:4.1":"Sālūkajātakaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
