{"suttaId":"ja337","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2856,2868],"vripara":"145"},"segments":{"ja337:0.4":"Pīṭhajātakaṃ (4-4-7)","ja337:1.1":"Na te pīṭhamadāyimhā [madāsimha (pī. ka.)], na pānaṃ napi bhojanaṃ;","ja337:1.3":"Brahmacāri khamassu me, etaṃ passāmi accayaṃ.","ja337:2.1":"Nevābhisajjāmi na cāpi kuppe, na cāpi me appiyamāsi kiñci;","ja337:2.3":"Athopi me āsi manovitakko, etādiso nūna kulassa dhammo.","ja337:3.1":"Esasmākaṃ kule dhammo, pitupitāmaho sadā;","ja337:3.3":"Āsanaṃ udakaṃ pajjaṃ, sabbetaṃ nipadāmase.","ja337:4.1":"Esasmākaṃ kule dhammo, pitupitāmaho sadā;","ja337:4.3":"Sakkaccaṃ upatiṭṭhāma, uttamaṃ viya ñātakanti.","ja337:5.1":"Pīṭhajātakaṃ sattamaṃ."},"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":959,"to":972,"paras":[{"para":959,"vripara":null,"refs":["ja337:1"],"lines":["Tattha <b>na te pīṭhamadāyimhā</b>ti pīṭhampi te na dāpayimha."],"lineRefs":[["ja337:1"]]},{"para":960,"vripara":null,"refs":[],"lines":["Taṃ sutvā bodhisatto dutiyaṃ gāthamāha –"],"lineRefs":[[]]},{"para":962,"vripara":"146","refs":[],"lines":["“Nevābhisajjāmi na cāpi kuppe, na cāpi me appiyamāsi kiñci;"],"lineRefs":[[]]},{"para":963,"vripara":null,"refs":[],"lines":["Athopi me āsi manovitakko, etādiso nūna kulassa dhammo”ti."],"lineRefs":[[]]},{"para":964,"vripara":null,"refs":["ja337:2"],"lines":["Tattha <b>nevābhisajjāmī</b>ti neva laggāmi.","<b>Etādiso</b>ti “imassa kulassa etādiso nūna sabhāvo, adāyakavaṃso esa bhavissatī”ti evaṃ me manovitakko uppanno."],"lineRefs":[["ja337:2"],["ja337:2"]]},{"para":965,"vripara":null,"refs":[],"lines":["Taṃ sutvā seṭṭhi itarā dve gāthā abhāsi –"],"lineRefs":[[]]},{"para":967,"vripara":"147","refs":[],"lines":["“Esasmākaṃ kule dhammo, pitupitāmaho sadā;"],"lineRefs":[[]]},{"para":968,"vripara":null,"refs":[],"lines":["Āsanaṃ udakaṃ pajjaṃ, sabbetaṃ nipadāmase."],"lineRefs":[[]]},{"para":970,"vripara":"148","refs":[],"lines":["“Esasmākaṃ kule dhammo, pitupitāmaho sadā;"],"lineRefs":[[]]},{"para":971,"vripara":null,"refs":[],"lines":["Sakkaccaṃ upatiṭṭhāma, uttamaṃ viya ñātakan”ti."],"lineRefs":[[]]},{"para":972,"vripara":null,"refs":["ja337:4"],"lines":["Tattha <b>dhammo</b>ti sabhāvo.","<b>Pitupitāmaho</b>ti pitūnañca pitāmahānañca santako.","<b>Udakan</b>ti pādadhovanaudakaṃ.","<b>Pajjan</b>ti pādamakkhanatelaṃ.","Sabbetanti sabbaṃ etaṃ.","<b>Nipadāmase</b>ti <b>ni</b> kāra <b>pa</b> kārā upasaggā, dāmaseti attho, dadāmāti vuttaṃ hoti.","Iminā yāva sattamā kulaparivaṭṭā dāyakavaṃso amhākaṃ vaṃsoti dasseti.","<b>Uttamaṃ viya ñātakan</b>ti mātaraṃ viya pitaraṃ viya ca mayaṃ dhammikaṃ samaṇaṃ vā brāhmaṇaṃ vā disvā sakkaccaṃ sahatthena upaṭṭhahāmāti attho."],"lineRefs":[["ja337:4"],["ja337:4"],["ja337:4"],["ja337:4"],["ja337:4"],["ja337:4"],["ja337:4"],["ja337:4"]]}],"wordLinks":[["ja337:1.1","na te pīṭhamadāyimhā",0,0],["ja337:2.1","nevābhisajjāmī",4,0],["ja337:2.3","etādiso",4,1],["ja337:4.1","dhammo",10,0],["ja337:4.1","pitupitāmaho",10,1],["ja337:4.3","pa",10,5],["ja337:4.3","uttamaṃ viya ñātakaṃ",10,7]]},"tika":null}
