{"suttaId":"sn23.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[912,912],"vripara":"167"},"segments":{"sn23.8:0.3":"Arahantasuttaṃ","sn23.8:1.1":"Sāvatthinidānaṃ.","sn23.8:1.2":"Ekamantaṃ nisinnaṃ kho āyasmantaṃ rādhaṃ bhagavā etadavoca –","sn23.8:1.3":"“pañcime, rādha, upādānakkhandhā.","sn23.8:1.4":"Katame pañca?","sn23.8:1.5":"Rūpupādānakkhandho … pe … viññāṇupādānakkhandho.","sn23.8:1.6":"Yato kho, rādha, bhikkhu imesaṃ pañcannaṃ upādānakkhandhānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā anupādāvimutto hoti – ayaṃ vuccati, rādha, arahaṃ khīṇāsavo vusitavā katakaraṇīyo ohitabhāro anuppattasadattho parikkhīṇabhavasaṃyojano sammadaññāvimutto”ti.","sn23.8:1.8":"Aṭṭhamaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":406,"to":409,"paras":[{"para":406,"vripara":"161-169","refs":["sn23.8:1"],"lines":["161-169. Dutiye <b>satto satto</b>ti laggapucchā.","<b>Tatra satto tatra visatto</b>ti tatra laggo tatra vilaggo.","<b>Paṃsvāgārakehī</b>ti paṃsugharakehi.","<b>Keḷāyantī</b>ti kīḷanti.","<b>Dhanāyantī</b>ti dhanaṃ viya maññanti.","<b>Mamāyantī</b>ti “mama idaṃ, mama idan”ti mamattaṃ karonti, aññassa phusitumpi na denti.","<b>Vikīḷaniyaṃ karontī</b>ti “niṭṭhitā kīḷā”ti te bhindamānā kīḷāvigamaṃ karonti.","Tatiye <b>bhavanettī</b>ti bhavarajju.","Catutthaṃ uttānameva.","Pañcamādīsu catūsu cattāri saccāni kathitāni, dvīsu kilesappahānanti.","Dutiyādīni."],"lineRefs":[["sn23.8:1"],["sn23.8:1"],["sn23.8:1"],["sn23.8:1"],["sn23.8:1"],["sn23.8:1"],["sn23.8:1"],["sn23.8:1"],["sn23.8:1"],["sn23.8:1"],["sn23.8:1"]]},{"para":407,"vripara":null,"refs":["sn23.8:1"],"lines":["Paṭhamo vaggo."],"lineRefs":[["sn23.8:1"]]},{"para":408,"vripara":null,"refs":["sn23.8:1"],"lines":["Dutiyavaggo"],"lineRefs":[["sn23.8:1"]]},{"para":409,"vripara":null,"refs":["sn23.8:1"],"lines":["1-12. Mārasuttādivaṇṇanā"],"lineRefs":[["sn23.8:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":415,"to":419,"paras":[{"para":415,"vripara":"161-169","refs":["sn23.8:1"],"lines":["161-169. <b>Laggapucchā</b>ti lagganassa bajjhanassa pucchā.","Yadi rūpādīsu sattattā satto, khīṇāsavā kathaṃ sattāti?","Sattabhūtapubbāti katvā.","<b>Kīḷāvigaman</b>ti kīḷāya apanayanaṃ oramaṇaṃ.","Yantarajju viya bhavapabandhassa nayanato <b>bhavarajjū</b>ti taṇhā vuttā."],"lineRefs":[["sn23.8:1"],["sn23.8:1"],["sn23.8:1"],["sn23.8:1"],["sn23.8:1"]]},{"para":416,"vripara":null,"refs":["sn23.8:1"],"lines":["Sattasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn23.8:1"]]},{"para":417,"vripara":null,"refs":["sn23.8:1"],"lines":["Paṭhamavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn23.8:1"]]},{"para":418,"vripara":null,"refs":["sn23.8:1"],"lines":["Dutiyavaggo"],"lineRefs":[["sn23.8:1"]]},{"para":419,"vripara":null,"refs":["sn23.8:1"],"lines":["1-12. Mārasuttādivaṇṇanā"],"lineRefs":[["sn23.8:1"]]}],"wordLinks":[]},"tika2":null}
