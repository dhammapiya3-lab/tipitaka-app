{"suttaId":"an7.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[67,67],"vripara":"8"},"segments":{"an7.8:0.3":"Saṃyojanasuttaṃ","an7.8:1.1":"“Sattimāni, bhikkhave, saṃyojanāni.","an7.8:1.2":"Katamāni satta?","an7.8:1.3":"Anunayasaṃyojanaṃ, paṭighasaṃyojanaṃ, diṭṭhisaṃyojanaṃ, vicikicchāsaṃyojanaṃ, mānasaṃyojanaṃ, bhavarāgasaṃyojanaṃ, avijjāsaṃyojanaṃ.","an7.8:1.4":"Imāni kho, bhikkhave, satta saṃyojanānī”ti.","an7.8:1.5":"Aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Mp-vii","bookName":"Sattakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":800,"to":800,"paras":[{"para":800,"vripara":"8","refs":["an7.8:1"],"lines":["Aṭṭhame <b>anunayasaṃyojana</b>nti kāmarāgasaṃyojanaṃ.","Sabbāneva cetāni bandhanaṭṭhena saṃyojanānīti veditabbāni.","Imasmiṃ sutte vaṭṭameva kathitaṃ.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["an7.8:1"],["an7.8:1"],["an7.8:1"],["an7.8:1"]]}],"wordLinks":[["an7.8:1.3","anunayasaṃyojanaṃ",0,0]],"before":[{"para":799,"vripara":null,"title":"Saṃyojanasuttavaṇṇanā","lines":["Saṃyojanasuttavaṇṇanā 8."]}],"after":[{"para":801,"vripara":null,"title":"Saṃyojanasuttavaṇṇanā","lines":["Dhanavaggo paṭhamo. 2."]}]},"tika":{"book":"Mp-t-vii","bookName":"Sattakanipāta-ṭīkā","vriCode":"s0403t.tik","from":796,"to":798,"paras":[{"para":796,"vripara":"1-10","refs":["an7.8:1"],"lines":["Sattakanipātassa paṭhamo vaggo uttānattho. 2."],"lineRefs":[["an7.8:1"]]},{"para":797,"vripara":null,"refs":["an7.8:1"],"lines":["Anusayavaggo 4."],"lineRefs":[["an7.8:1"]]},{"para":798,"vripara":null,"refs":["an7.8:1"],"lines":["Puggalasuttavaṇṇanā 14."],"lineRefs":[["an7.8:1"]]}],"wordLinks":[]},"tika2":null}
