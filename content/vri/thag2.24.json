{"suttaId":"thag2.24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[905,911],"vripara":"167"},"segments":{"thag2.24:0.4":"Valliyattheragāthā","thag2.24:1.1":"“Yaṃ kiccaṃ daḷhavīriyena,","thag2.24:1.2":"yaṃ kiccaṃ boddhumicchatā;","thag2.24:1.3":"Karissaṃ nāvarajjhissaṃ [nāvarujjhissaṃ (ka. sī. ka.)],","thag2.24:1.4":"passa vīriyaṃ parakkama.","thag2.24:2.1":"“Tvañca me maggamakkhāhi,","thag2.24:2.2":"añjasaṃ amatogadhaṃ;","thag2.24:2.3":"Ahaṃ monena monissaṃ,","thag2.24:2.4":"gaṅgāsotova sāgaran”ti.","thag2.24:2.5":"… Valliyo thero …."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":3859,"to":3859,"paras":[{"para":3859,"vripara":null,"refs":["thag2.24:2"],"lines":["<b>Tvañcā</b>ti kammaṭṭhānadāyakaṃ kalyāṇamittaṃ ālapati.","<b>Me</b>ti mayhaṃ.","<b>Maggamakkhāhī</b>ti ariyamaggaṃ kathehi, lokuttaramaggasampāpakaṃ catusaccakammaṭṭhānaṃ kathehīti attho.","<b>Añjasan</b>ti ujukaṃ majjhimapaṭipadābhāvena antadvayassa anupagamanato.","Amate nibbāne sampāpakabhāvena patiṭṭhitattā <b>amatogadhaṃ.</b>","<b>Monenā</b>ti ñāṇena maggapaññāya.","<b>Monissan</b>ti jānissaṃ nibbānaṃ paṭivijjhissaṃ pāpuṇissaṃ.","<b>Gaṅgāsotova sāgaran</b>ti yathā gaṅgāya soto sāgaraṃ samuddaṃ avirajjhanto ekaṃsato ogāhati, evaṃ “ahaṃ kammaṭṭhānaṃ anuyuñjanto maggañāṇena nibbānaṃ adhigamissāmi, tasmā taṃ kammaṭṭhānaṃ me ācikkhathā”ti theraṃ kammaṭṭhānaṃ yāci."],"lineRefs":[["thag2.24:2"],["thag2.24:2"],["thag2.24:2"],["thag2.24:2"],["thag2.24:2"],["thag2.24:2"],["thag2.24:2"],["thag2.24:2"]]}],"wordLinks":[["thag2.24:2.1","tvañcā",0,0],["thag2.24:2.1","me",0,1],["thag2.24:2.1","maggamakkhāhī",0,2],["thag2.24:2.1","añjasaṃ",0,3],["thag2.24:2.1","amatogadhaṃ",0,4],["thag2.24:2.3","monenā",0,5],["thag2.24:2.3","monissaṃ",0,6],["thag2.24:2.3","gaṅgāsotova sāgaraṃ",0,7]],"before":[{"para":3850,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Valliyattheragāthāvaṇṇanā"]},{"para":3851,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["<b>Yaṃ kiccaṃ daḷhavīriyenā</b>tiādikā āyasmato valliyattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto sumedhassa bhagavato kāle brāhmaṇakule nibbattitvā viññutaṃ patto vijjāsippesu nipphattiṃ gato asītikoṭivibhavaṃ pahāya tāpasapabbajjaṃ pabbajitvā pabbatapāde araññāyatane ekissā nadiyā tīre assamaṃ kāretvā viharanto attano anuggaṇhanatthaṃ upagataṃ satthāraṃ disvā pasannamānaso ajinacammaṃ pattharitvā adāsi.","Tattha nisinnaṃ bhagavantaṃ pupphehi ca candanena ca pūjetvā ambaphalāni datvā pañcapatiṭṭhitena vandi.","Tassa bhagavā nisinnāsanasampattiṃ pakāsento anumodanaṃ vatvā pakkāmi.","So tena puññakammena devamanussesu saṃsaranto imasmiṃ buddhuppāde vesāliyaṃ brāhmaṇakule nibbattitvā “kaṇhamitto”ti laddhanāmo vayappatto satthu vesāligamane buddhānubhāvaṃ disvā paṭiladdhasaddho mahākaccānattherassa santike pabbaji.","So mandapañño dandhaparakkamo ca hutvā ciraṃ kālaṃ viññuṃ sabrahmacāriṃ nissāyeva vasati.","Bhikkhū “yathā nāma valli rukkhādīsu kiñci anissāya vaḍḍhituṃ na sakkoti, evamayampi kañci paṇḍitaṃ anissāya vaḍḍhituṃ na sakkotī”ti <b>valliyo</b> tveva samudācariṃsu.","Aparabhāge pana veṇudattattheraṃ upasaṅkamitvā tassa ovāde ṭhatvā sato sampajāno hutvā viharanto ñāṇassa paripākaṃ gatattā paṭipattikkamaṃ theraṃ pucchanto –"]},{"para":3853,"vripara":"167","title":"Valliyattheragāthāvaṇṇanā","lines":["“Yaṃ kiccaṃ daḷhavīriyena, yaṃ kiccaṃ boddhumicchatā;"]},{"para":3854,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Karissaṃ nāvarajjhissaṃ, passa vīriyaṃ parakkamaṃ."]},{"para":3856,"vripara":"168","title":"Valliyattheragāthāvaṇṇanā","lines":["“Tvañca me maggamakkhāhi, añjasaṃ amatogadhaṃ;"]},{"para":3857,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Ahaṃ monena monissaṃ, gaṅgāsotova sāgaran”ti.","– gāthādvayaṃ abhāsi;"]},{"para":3858,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Tattha <b>yaṃ kiccaṃ daḷhavīriyenā</b>ti daḷhena vīriyena thirena parakkamena, daḷhavīriyena vā purisadhorayhena yaṃ kiccaṃ kātabbaṃ paṭipajjitabbaṃ.","<b>Yaṃ kiccaṃ boddhumicchatā</b>ti cattāri ariyasaccāni nibbānameva vā boddhuṃ bujjhituṃ icchantena paṭivijjhitukāmena yaṃ kiccaṃ karaṇīyaṃ.","<b>Karissaṃ nāvarajjhissan</b>ti tamahaṃ dāni karissaṃ na virādhessaṃ, yathānusiṭṭhaṃ paṭipajjissāmi.","<b>Passa vīriyaṃ parakkaman</b>ti yathā paṭipajjamāne dhamme vidhinā īraṇato <b>“vīriyaṃ”,</b> paraṃ paraṃ ṭhānaṃ akkamanato <b>“parakkamo”</b>ti ca laddhanāmaṃ sammāvāyāmaṃ passa na saddhamevāti attano kattukāmataṃ dasseti."]}],"after":[{"para":3860,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Taṃ sutvā veṇudattatthero tassa kammaṭṭhānaṃ adāsi.","Sopi kammaṭṭhānaṃ anuyuñjanto nacirasseva vipassanaṃ ussukkāpetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 2.49.75-105)–"]},{"para":3861,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Pañca kāmaguṇe hitvā, piyarūpe manorame;"]},{"para":3862,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Asīti koṭiyo hitvā, pabbajiṃ anagāriyaṃ."]},{"para":3863,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Pabbajitvāna kāyena, pāpakammaṃ vivajjayiṃ;"]},{"para":3864,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Vacīduccaritaṃ hitvā, nadīkūle vasāmahaṃ."]},{"para":3865,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Ekakaṃ maṃ viharantaṃ, buddhaseṭṭho upāgami;"]},{"para":3866,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Nāhaṃ jānāmi buddhoti, akāsiṃ paṭisanthāraṃ."]},{"para":3867,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Karitvā paṭisanthāraṃ, nāmagottamapucchahaṃ;"]},{"para":3868,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Devatānusi gandhabbo, adu sakko purindado."]},{"para":3869,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Ko vā tvaṃ kassa vā putto, mahābrahmā idhāgato;"]},{"para":3870,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Virocesi disā sabbā, udayaṃ sūriyo yathā."]},{"para":3871,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Sahassārāni cakkāni, pāde dissanti mārisa;"]},{"para":3872,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Ko vā tvaṃ kassa vā putto, kathaṃ jānemu taṃ mayaṃ."]},{"para":3873,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Nāmagottaṃ pavedehi, saṃsayaṃ apanehi me;"]},{"para":3874,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Namhi devā na gandhabbo, namhi sakko purindado."]},{"para":3875,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Brahmabhāvo ca me natthi, etesaṃ uttamo ahaṃ;"]},{"para":3876,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Atīto visayaṃ tesaṃ, dālayiṃ kāmabandhanaṃ."]},{"para":3877,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Sabbe kilese jhāpetvā, patto sambodhimuttamaṃ;"]},{"para":3878,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Tassa vācaṃ suṇitvāhaṃ, idaṃ vacanamabraviṃ."]},{"para":3879,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Yadi buddhosi sabbaññū, nisīda tvaṃ mahāmune;"]},{"para":3880,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Tamahaṃ pūjayissāmi, dukkhassantakaro tuvaṃ."]},{"para":3881,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Pattharitvājinacammaṃ, adāsi satthuno ahaṃ;"]},{"para":3882,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Nisīdi tattha bhagavā, sīhova girigabbhare."]},{"para":3883,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Khippaṃ pabbatamāruyha, ambassa phalamaggahiṃ;"]},{"para":3884,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Sālakalyāṇikaṃ pupphaṃ, candanañca mahārahaṃ."]},{"para":3885,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Khippaṃ paggayha taṃ sabbaṃ, upetvā lokanāyakaṃ;"]},{"para":3886,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Phalaṃ buddhassa datvāna, sālapupphamapūjayiṃ."]},{"para":3887,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Candanaṃ anulimpitvā, avandiṃ satthuno ahaṃ;"]},{"para":3888,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Pasannacitto sumano, vipulāya ca pītiyā."]},{"para":3889,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Ajinamhi nisīditvā, sumedho lokanāyako;"]},{"para":3890,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Mama kammaṃ pakittesi, hāsayanto mamaṃ tadā."]},{"para":3891,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Iminā phaladānena, gandhamālehi cūbhayaṃ;"]},{"para":3892,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Pañcavīse kappasate, devaloke ramissati."]},{"para":3893,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Anūnamanasaṅkappo, vasavattī bhavissati;"]},{"para":3894,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Chabbīsatikappasate, manussattaṃ gamissati."]},{"para":3895,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Bhavissati cakkavattī, cāturanto mahiddhiko;"]},{"para":3896,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Vebhāraṃ nāma nagaraṃ, vissakammena māpitaṃ."]},{"para":3897,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Hessati sabbasovaṇṇaṃ, nānāratanabhūsitaṃ;"]},{"para":3898,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Eteneva upāyena, saṃsarissati so bhave."]},{"para":3899,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Sabbattha pūjito hutvā, devatte atha mānuse;"]},{"para":3900,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Pacchime bhave sampatte, brahmabandhu bhavissati."]},{"para":3901,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Agārā abhinikkhamma, anagārī bhavissati;"]},{"para":3902,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Abhiññāpāragū hutvā, nibbāyissatināsavo."]},{"para":3903,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Idaṃ vatvāna sambuddho, sumedho lokanāyako;"]},{"para":3904,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Mama nijjhāyamānassa, pakkāmi anilañjase."]},{"para":3905,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"]},{"para":3906,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."]},{"para":3907,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Tusitato cavitvāna, nibbattiṃ mātukucchiyaṃ;"]},{"para":3908,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Bhoge me ūnatā natthi, yamhi gabbhe vasāmahaṃ."]},{"para":3909,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Mātukucchigate mayi, annapānañca bhojanaṃ;"]},{"para":3910,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Mātuyā mama chandena, nibbattati yadicchakaṃ."]},{"para":3911,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Jātiyā pañcavassena, pabbajiṃ anagāriyaṃ;"]},{"para":3912,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Oropitamhi kesamhi, arahattamapāpuṇiṃ."]},{"para":3913,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Pubbakammaṃ gavesanto, orena nāddasaṃ ahaṃ;"]},{"para":3914,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Tiṃsakappasahassamhi, mama kammamanussariṃ."]},{"para":3915,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Namo te purisājañña, namo te purisuttama;"]},{"para":3916,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Tava sāsanamāgamma, pattomhi acalaṃ padaṃ."]},{"para":3917,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Tiṃsakappasahassamhi, yaṃ buddhamabhipūjayiṃ;"]},{"para":3918,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ."]},{"para":3919,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."]},{"para":3920,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Arahattaṃ pana patvā aññaṃ byākaronto thero imāyeva gāthā abhāsīti."]},{"para":3921,"vripara":null,"title":"Valliyattheragāthāvaṇṇanā","lines":["Valliyattheragāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
