{"suttaId":"thag2.24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[905,911],"vripara":"167"},"segments":{"thag2.24:0.4":"Valliyattheragāthā","thag2.24:1.1":"“Yaṃ kiccaṃ daḷhavīriyena, yaṃ kiccaṃ boddhumicchatā;","thag2.24:1.3":"Karissaṃ nāvarajjhissaṃ [nāvarujjhissaṃ (ka. sī. ka.)], passa vīriyaṃ parakkama.","thag2.24:2.1":"“Tvañca me maggamakkhāhi, añjasaṃ amatogadhaṃ;","thag2.24:2.3":"Ahaṃ monena monissaṃ, gaṅgāsotova sāgaran”ti.","thag2.24:2.5":"… Valliyo thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":3859,"to":3859,"paras":[{"para":3859,"vripara":null,"refs":["thag2.24:2"],"lines":["<b>Tvañcā</b>ti kammaṭṭhānadāyakaṃ kalyāṇamittaṃ ālapati.","<b>Me</b>ti mayhaṃ.","<b>Maggamakkhāhī</b>ti ariyamaggaṃ kathehi, lokuttaramaggasampāpakaṃ catusaccakammaṭṭhānaṃ kathehīti attho.","<b>Añjasan</b>ti ujukaṃ majjhimapaṭipadābhāvena antadvayassa anupagamanato.","Amate nibbāne sampāpakabhāvena patiṭṭhitattā <b>amatogadhaṃ.</b>","<b>Monenā</b>ti ñāṇena maggapaññāya.","<b>Monissan</b>ti jānissaṃ nibbānaṃ paṭivijjhissaṃ pāpuṇissaṃ.","<b>Gaṅgāsotova sāgaran</b>ti yathā gaṅgāya soto sāgaraṃ samuddaṃ avirajjhanto ekaṃsato ogāhati, evaṃ “ahaṃ kammaṭṭhānaṃ anuyuñjanto maggañāṇena nibbānaṃ adhigamissāmi, tasmā taṃ kammaṭṭhānaṃ me ācikkhathā”ti theraṃ kammaṭṭhānaṃ yāci."],"lineRefs":[["thag2.24:2"],["thag2.24:2"],["thag2.24:2"],["thag2.24:2"],["thag2.24:2"],["thag2.24:2"],["thag2.24:2"],["thag2.24:2"]]}],"wordLinks":[["thag2.24:2.1","tvañcā",0,0],["thag2.24:2.1","me",0,1],["thag2.24:2.1","maggamakkhāhī",0,2],["thag2.24:2.1","añjasaṃ",0,3],["thag2.24:2.1","amatogadhaṃ",0,4],["thag2.24:2.3","monenā",0,5],["thag2.24:2.3","monissaṃ",0,6],["thag2.24:2.3","gaṅgāsotova sāgaraṃ",0,7]]},"tika":null}
