{"suttaId":"thag2.24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[905,911],"vripara":"167"},"segments":{"thag2.24:0.4":"Valliyattheragāthā","thag2.24:1.1":"“Yaṃ kiccaṃ daḷhavīriyena, yaṃ kiccaṃ boddhumicchatā;","thag2.24:1.3":"Karissaṃ nāvarajjhissaṃ [nāvarujjhissaṃ (ka. sī. ka.)], passa vīriyaṃ parakkama.","thag2.24:2.1":"“Tvañca me maggamakkhāhi, añjasaṃ amatogadhaṃ;","thag2.24:2.3":"Ahaṃ monena monissaṃ, gaṅgāsotova sāgaran”ti.","thag2.24:2.5":"… Valliyo thero …."},"attha":null,"tika":null}
