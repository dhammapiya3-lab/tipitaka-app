{"suttaId":"ja31","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[176,179],"vripara":"31"},"segments":{"ja31:0.4":"Kulāvakajātakaṃ","ja31:1.1":"Kulāvakā mātali simbalismiṃ, īsāmukhena parivajjayassu;","ja31:1.3":"Kāmaṃ cajāma asuresu pāṇaṃ, mā me dijā vikkulavā [māyime dijā vikulāvā (sī. syā. pī.)] ahesunti.","ja31:2.1":"Kulāvakajātakaṃ paṭhamaṃ."},"attha":null,"tika":null}
