{"suttaId":"an4.42","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[465,473],"vripara":"42"},"segments":{"an4.42:0.3":"Pañhabyākaraṇasuttaṃ","an4.42:1.1":"“Cattārimāni, bhikkhave, pañhabyākaraṇāni [pañhābyākaraṇāni (ka.)].","an4.42:1.2":"Katamāni cattāri?","an4.42:1.3":"Atthi, bhikkhave, pañho ekaṃsabyākaraṇīyo;","an4.42:1.4":"atthi, bhikkhave, pañho vibhajjabyākaraṇīyo;","an4.42:1.5":"atthi, bhikkhave, pañho paṭipucchābyākaraṇīyo;","an4.42:1.6":"atthi, bhikkhave, pañho ṭhapanīyo.","an4.42:1.7":"Imāni kho, bhikkhave, cattāri pañhabyākaraṇānī”ti.","an4.42:2.1":"“Ekaṃsavacanaṃ ekaṃ,","an4.42:2.2":"vibhajjavacanāparaṃ;","an4.42:2.3":"Tatiyaṃ paṭipuccheyya,","an4.42:2.4":"catutthaṃ pana ṭhāpaye.","an4.42:3.1":"“Yo ca tesaṃ [nesaṃ (sī. syā. kaṃ.)] tattha tattha,","an4.42:3.2":"jānāti anudhammataṃ;","an4.42:3.3":"Catupañhassa kusalo,","an4.42:3.4":"āhu bhikkhuṃ tathāvidhaṃ.","an4.42:4.1":"“Durāsado duppasaho,","an4.42:4.2":"gambhīro duppadhaṃsiyo;","an4.42:4.3":"Atho atthe anatthe ca,","an4.42:4.4":"ubhayassa hoti kovido [ubhayatthassa kovido (syā. kaṃ.)].","an4.42:5.1":"“Anatthaṃ parivajjeti,","an4.42:5.2":"atthaṃ gaṇhāti paṇḍito;","an4.42:5.3":"Atthābhisamayā dhīro,","an4.42:5.4":"paṇḍitoti pavuccatī”ti.","an4.42:5.5":"dutiyaṃ;"},"unsure":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1234,"to":1234,"paras":[{"para":1234,"vripara":"42","refs":["an4.42:3","an4.42:4","an4.42:5"],"lines":["Dutiye <b>yo ca tesaṃ tattha tattha, jānāti anudhammatan</b>ti yo etesaṃ pañhānaṃ tasmiṃ tasmiṃ ṭhāne byākaraṇaṃ jānāti.","<b>Catupañhassa kusalo, āhu bhikkhuṃ tathāvidhan</b>ti tathāvidhaṃ bhikkhuṃ tesu catūsu pañhesu kusaloti evaṃ vadanti.","<b>Durāsado duppasaho</b>ti parehi ghaṭṭetuṃ vā abhibhavituṃ vā na sakkā.","<b>Gambhīro</b>ti sattasīdantaramahāsamuddo viya gambhīro.","<b>Duppadhaṃsiyo</b>ti dummocāpayo, gahitaggahaṇaṃ vissajjāpetuṃ na sakkāti attho.","<b>Atthe anatthe cā</b>ti vaḍḍhiyañca avaḍḍhiyañca.","<b>Atthābhisamayā</b>ti atthasamāgamena.","<b>Dhīro paṇḍitoti pavuccatī</b>ti dhitisampanno puggalo “paṇḍito ayan”ti evaṃ pavuccati."],"lineRefs":[["an4.42:3"],["an4.42:3"],["an4.42:4"],["an4.42:4"],["an4.42:4"],["an4.42:4"],["an4.42:5"],["an4.42:5"]]}],"wordLinks":[["an4.42:3.1","yo ca tesaṃ tattha tattha jānāti anudhammataṃ",0,0],["an4.42:3.3","catupañhassa kusalo āhu bhikkhuṃ tathāvidhaṃ",0,1],["an4.42:4.1","durāsado duppasaho",0,2],["an4.42:4.1","gambhīro",0,3],["an4.42:4.1","duppadhaṃsiyo",0,4],["an4.42:4.3","atthe anatthe cā",0,5],["an4.42:5.3","atthābhisamayā",0,6],["an4.42:5.3","dhīro paṇḍitoti pavuccatī",0,7]],"before":[{"para":1233,"vripara":null,"refs":[],"lines":["Pañhabyākaraṇasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1415,"to":1417,"paras":[{"para":1415,"vripara":"42-44","refs":["an4.42:1"],"lines":["42-44. Dutiye <b>etesaṃ pañhānan</b>ti ekaṃsabyākaraṇādīnaṃ catunnaṃ pañhānaṃ.","<b>Tasmiṃ tasmiṃ ṭhāne byākaraṇaṃ jānātī</b>ti “cakkhuṃ aniccan”ti puṭṭhe “aniccan”ti ekaṃseneva byākātabbaṃ.","“Aniccā nāma cakkhun”ti puṭṭhe pana “na kevalaṃ cakkhumeva, sotampi aniccan”ti evaṃ vibhajitvā byākātabbaṃ.","“Yathā cakkhuṃ tathā sotaṃ, yathā sotaṃ tathā cakkhun”ti puṭṭhe “kenaṭṭhena pucchasī”ti paṭipucchitvā “dassanaṭṭhena pucchāmī”ti vutte “na hī”ti byākātabbaṃ.","“Aniccaṭṭhena pucchāmī”ti vutte “āmā”ti byākātabbaṃ.","“Taṃ jīvaṃ taṃ sarīran”tiādīni puṭṭhena pana “abyākatametaṃ bhagavatā”ti ṭhapetabbo, esa pañho na byākātabboti evaṃ jānātīti attho.","<b>Atthasamāgamenā</b>ti atthassa paṭilābhena laddhabbena.","Samiti saṅgati samodhānanti samayo, paṭilābho.","Samayo eva <b>abhisamayo,</b> abhimukhabhāvena vā samayo <b>abhisamayo</b>ti evamettha padattho veditabbo.","Sesaṃ suviññeyyameva.","Tatiyacatutthāni uttānatthāneva."],"lineRefs":[["an4.42:1"],["an4.42:1"],["an4.42:1"],["an4.42:1"],["an4.42:1"],["an4.42:1"],["an4.42:1"],["an4.42:1"],["an4.42:1"],["an4.42:1"],["an4.42:1"]]},{"para":1416,"vripara":null,"refs":["an4.42:1"],"lines":["Pañhabyākaraṇasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an4.42:1"]]},{"para":1417,"vripara":null,"refs":["an4.42:1"],"lines":["5-6. Rohitassasuttādivaṇṇanā"],"lineRefs":[["an4.42:1"]]}],"wordLinks":[],"before":[{"para":1413,"vripara":null,"refs":[],"lines":["Samādhibhāvanāsuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1414,"vripara":null,"refs":[],"lines":["2-4. Pañhabyākaraṇasuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
