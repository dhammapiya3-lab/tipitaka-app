{"suttaId":"thig6.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[549,567],"vripara":"139"},"segments":{"thig6.3:0.3":"Khemātherīgāthā","thig6.3:1.1":"“Daharā tvaṃ rūpavatī,","thig6.3:1.2":"ahampi daharo yuvā;","thig6.3:1.3":"Pañcaṅgikena turiyena [tūrena (ka.)],","thig6.3:1.4":"ehi kheme ramāmase”. 140.","thig6.3:2.1":"“Iminā pūtikāyena,","thig6.3:2.2":"āturena pabhaṅgunā;","thig6.3:2.3":"Aṭṭiyāmi harāyāmi,","thig6.3:2.4":"kāmataṇhā samūhatā. 141.","thig6.3:3.1":"“Sattisūlūpamā kāmā,","thig6.3:3.2":"khandhāsaṃ adhikuṭṭanā;","thig6.3:3.3":"Yaṃ ‘tvaṃ kāmaratiṃ’ brūsi,","thig6.3:3.4":"‘aratī’ dāni sā mama. 142.","thig6.3:4.1":"“Sabbattha vihatā nandī,","thig6.3:4.2":"tamokhandho padālito;","thig6.3:4.3":"Evaṃ jānāhi pāpima,","thig6.3:4.4":"nihato tvamasi antaka. 143.","thig6.3:5.1":"“Nakkhattāni namassantā,","thig6.3:5.2":"aggiṃ paricaraṃ vane;","thig6.3:5.3":"Yathābhuccamajānantā,","thig6.3:5.4":"bālā suddhimamaññatha. 144.","thig6.3:6.1":"“Ahañca kho namassantī,","thig6.3:6.2":"sambuddhaṃ purisuttamaṃ;","thig6.3:6.3":"Pamuttā [parimuttā (sī. syā.)] sabbadukkhehi,","thig6.3:6.4":"satthusāsanakārikā”ti. …","thig6.3:7.1":"Khemā therī…. 4."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":2086,"to":2109,"paras":[{"para":2086,"vripara":"139","refs":["thig6.3:1"],"lines":["“Daharā tvaṃ rūpavatī, ahampi daharo yuvā;"],"lineRefs":[["thig6.3:1"]]},{"para":2087,"vripara":null,"refs":["thig6.3:1"],"lines":["Pañcaṅgikena turiyena, ehi kheme ramāmase”ti. –","gāthamāha;"],"lineRefs":[["thig6.3:1"],["thig6.3:1"]]},{"para":2088,"vripara":null,"refs":["thig6.3:1"],"lines":["Tassattho – kheme, tvaṃ taruṇappattā, yobbane ṭhitā rūpasampannā, ahampi taruṇo yuvā, tasmā mayaṃ yobbaññaṃ akhepetvā pañcaṅgikena turiyena vajjamānena ehi kāmakhiḍḍāratiyā ramāma kīḷāmāti."],"lineRefs":[["thig6.3:1"]]},{"para":2089,"vripara":null,"refs":["thig6.3:1"],"lines":["Taṃ sutvā sā kāmesu sabbadhammesu ca attano virattabhāvaṃ tassa ca mārabhāvaṃ attābhinivesesu sattesu attano thāmagataṃ appasādaṃ katakiccatañca pakāsentī – 140."],"lineRefs":[["thig6.3:1"]]},{"para":2091,"vripara":"140","refs":["thig6.3:2"],"lines":["“Iminā pūtikāyena, āturena pabhaṅgunā;"],"lineRefs":[["thig6.3:2"]]},{"para":2092,"vripara":null,"refs":["thig6.3:2"],"lines":["Aṭṭiyāmi harāyāmi, kāmataṇhā samūhatā. 141."],"lineRefs":[["thig6.3:2"]]},{"para":2094,"vripara":"141","refs":["thig6.3:3"],"lines":["“Sattisūlūpamā kāmā, khandhāsaṃ adhikuṭṭanā;"],"lineRefs":[["thig6.3:3"]]},{"para":2095,"vripara":null,"refs":["thig6.3:3"],"lines":["Yaṃ tvaṃ kāmaratiṃ brūsi, aratī dāni sā mama. 142."],"lineRefs":[["thig6.3:3"]]},{"para":2097,"vripara":"142","refs":["thig6.3:4"],"lines":["“Sabbattha vihatā nandī, tamokhandho padālito;"],"lineRefs":[["thig6.3:4"]]},{"para":2098,"vripara":null,"refs":["thig6.3:4"],"lines":["Evaṃ jānāhi pāpima, nihato tvamasi antaka. 143."],"lineRefs":[["thig6.3:4"]]},{"para":2100,"vripara":"143","refs":["thig6.3:5"],"lines":["“Nakkhattāni namassantā, aggiṃ paricaraṃ vane;"],"lineRefs":[["thig6.3:5"]]},{"para":2101,"vripara":null,"refs":["thig6.3:5"],"lines":["Yathābhuccamajānantā, bālā suddhimamaññatha. 144."],"lineRefs":[["thig6.3:5"]]},{"para":2103,"vripara":"144","refs":["thig6.3:6"],"lines":["“Ahañca kho namassantī, sambuddhaṃ purisuttamaṃ;"],"lineRefs":[["thig6.3:6"]]},{"para":2104,"vripara":null,"refs":["thig6.3:6"],"lines":["Pamuttā sabbadukkhehi, satthusāsanakārikā”ti. –","imā gāthā abhāsi;"],"lineRefs":[["thig6.3:6"],["thig6.3:6"]]},{"para":2105,"vripara":null,"refs":["thig6.3:6"],"lines":["Tattha <b>aggiṃ paricaraṃ vane</b>ti tapovane aggihuttaṃ paricaranto.","<b>Yathābhuccamajānantā</b>ti pavattiyo yathābhūtaṃ aparijānantā.","Sesamettha heṭṭhā vuttanayattā uttānameva."],"lineRefs":[["thig6.3:6"],["thig6.3:6"],["thig6.3:6"]]},{"para":2106,"vripara":null,"refs":["thig6.3:6"],"lines":["Khemātherīgāthāvaṇṇanā niṭṭhitā. 4."],"lineRefs":[["thig6.3:6"]]},{"para":2107,"vripara":null,"refs":["thig6.3:6"],"lines":["Sujātātherīgāthāvaṇṇanā"],"lineRefs":[["thig6.3:6"]]},{"para":2108,"vripara":null,"refs":["thig6.3:6"],"lines":["<b>Alaṅkatā suvasanā</b>tiādikā sujātāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī anukkamena sambhatavimokkhasambhārā hutvā imasmiṃ buddhuppāde sāketanagare seṭṭhikule nibbattitvā vayappattā mātāpitūhi samānajātikassa seṭṭhiputtassa dinnā hutvā patikulaṃ gatā.","Tattha tena saddhiṃ sukhasaṃvāsaṃ vasantī ekadivasaṃ uyyānaṃ gantvā nakkhattakīḷaṃ kīḷitvā parijanena saddhiṃ nagaraṃ āgacchantī añjanavane satthāraṃ disvā pasannamānasā upasaṅkamitvā vanditvā ekamantaṃ nisīdi.","Satthā tassā anupubbiṃ kathaṃ kathetvā kallacittataṃ ñatvā upari sāmukkaṃsikaṃ dhammadesanaṃ pakāsesi.","Sā desanāvasāne attano katādhikāratāya ñāṇassa paripākaṃ gatattā ca, satthu ca desanāvilāsena yathānisinnāva saha paṭisambhidāhi arahattaṃ patvā satthāraṃ vanditvā gehaṃ gantvā sāmikañca mātāpitaro ca anujānāpetvā satthuāṇāya bhikkhunupassayaṃ gantvā bhikkhunīnaṃ santike pabbaji.","Pabbajitvā ca attano paṭipattiṃ paccavekkhitvā udānavasena – 145."],"lineRefs":[["thig6.3:6"],["thig6.3:6"],["thig6.3:6"],["thig6.3:6"],["thig6.3:6"],["thig6.3:6"]]}],"wordLinks":[],"before":[{"para":1892,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Khemātherīgāthāvaṇṇanā"]},{"para":1893,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["<b>Daharā tvaṃ rūpavatī</b>tiādikā khemāya theriyā gāthā.","Ayaṃ kira padumuttarassa bhagavato kāle haṃsavatīnagare parādhīnavuttikā paresaṃ dāsī ahosi.","Sā paresaṃ veyyāvaccakaraṇena jīvikaṃ kappentī ekadivasaṃ padumuttarassa sammāsambuddhassa aggasāvakaṃ sujātattheraṃ piṇḍāya carantaṃ disvā tayo modake datvā taṃdivasameva attano kese vissajjetvā therassa dānaṃ datvā “anāgate mahāpaññā buddhassa sāvikā bhaveyya”nti patthanaṃ katvā yāvajīvaṃ kusalakamme appamattā hutvā devamanussesu saṃsarantī anukkamena chakāmasagge, tesaṃ tesaṃ devarājūnaṃ mahesibhāvena upapannā, manussalokepi anekavāraṃ cakkavattīnaṃ maṇḍalarājūnañca mahesibhāvaṃ upagatā mahāsampattiyo anubhavitvā vipassissa bhagavato kāle manussaloke uppajjitvā viññutaṃ patvā, satthu santike dhammaṃ sutvā paṭiladdhasaṃvegā pabbajitvā dasavassasahassāni brahmacariyaṃ carantī bahussutā dhammakathikā hutvā bahujanassa dhammakathanādinā paññāsaṃvattaniyakammaṃ katvā tato cavitvā sugatīsuyeva saṃsarantī imasmiṃ kappe bhagavato ca kakusandhassa bhagavato ca koṇāgamanassa kāle vibhavasampanne kule nibbattitvā viññutaṃ patvā mahantaṃ saṅghārāmaṃ kāretvā buddhappamukhassa bhikkhusaṅghassa niyyādesi."]},{"para":1894,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Bhagavato pana kassapadasabalassa kāle kikissa kāsirañño sabbajeṭṭhikā samaṇī nāma dhītā hutvā, satthu santike dhammaṃ sutvā paṭiladdhasaṃvegā agāreyeva ṭhitā, vīsati vassasahassāni komāribrahmacariyaṃ carantī samaṇaguttādīhi attano bhaginīhi saddhiṃ ramaṇīyaṃ pariveṇaṃ kāretvā buddhappamukhassa bhikkhusaṅghassa niyyādesi.","Evameva tattha tattha bhave āyatanagataṃ uḷāraṃ puññakammaṃ katvā sugatīsuyeva saṃsaritvā imasmiṃ buddhuppāde maddaraṭṭhe sākalanagare rājakule nibbatti.","<b>Khemā</b>tissā nāmaṃ ahosi, suvaṇṇavaṇṇā kañcanasannibhattacā.","Sā vayappattā bimbisārarañño gehaṃ gatā.","Satthari veḷuvane viharante rūpamattā hutvā “rūpe dosaṃ dassetī”ti satthu dassanāya na gacchati."]},{"para":1895,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Rājā manussehi veḷuvanassa vaṇṇe pakāsāpetvā deviyā vihāradassanāya cittaṃ uppādesi.","Atha devī “vihāraṃ passissāmī”ti rājānaṃ paṭipucchi.","Rājā “vihāraṃ gantvā satthāraṃ adisvā āgantuṃ na labhissasī”ti vatvā purisānaṃ saññaṃ adāsi –","“balakkārenapi deviṃ dasabalaṃ dassethā”ti.","Devī vihāraṃ gantvā divasabhāgaṃ khepetvā nivattentī satthāraṃ adisvāva gantuṃ āraddhā.","Atha naṃ rājapurisā anicchantimpi satthu santikaṃ nayiṃsu.","Satthā taṃ āgacchantiṃ disvā iddhiyā devaccharāsadisaṃ itthiṃ nimminitvā tālapaṇṇaṃ gahetvā bījayamānaṃ akāsi.","Khemā devī taṃ disvā cintesi –","“evarūpā nāma devaccharapaṭibhāgā itthiyo bhagavato avidūre tiṭṭhanti, ahaṃ etāsaṃ paricārikatāyapi nappahomi, manampi nikkāraṇā pāpacittassa vasena naṭṭhā”ti nimittaṃ gahetvā tameva itthiṃ olokayamānā aṭṭhāsi.","Athassā passantiyāva satthu adhiṭṭhānabalena sā itthī paṭhamavayaṃ atikkamma majjhimavayampi atikkamma pacchimavayaṃ patvā khaṇḍadantā palitakesā valittacā hutvā saddhiṃ tālapaṇṇena parivattitvā pati.","Tato khemā katādhikārattā evaṃ cintesi –","“evaṃvidhampi sarīraṃ īdisaṃ vipattiṃ pāpuṇi, mayhampi sarīraṃ evaṃgatikameva bhavissatī”ti.","Athassā cittācāraṃ ñatvā satthā –"]},{"para":1896,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Ye rāgarattānupatanti sotaṃ, sayaṃ kataṃ makkaṭakova jālaṃ;"]},{"para":1897,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Etampi chetvāna paribbajanti, anapekkhino kāmasukhaṃ pahāyā”ti. –"]},{"para":1898,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Gāthamāha.","Sā gāthāpariyosāne saha paṭisambhidāhi arahattaṃ pāpuṇīti aṭṭhakathāsu āgataṃ.","Apadāne pana “imaṃ gāthaṃ sutvā sotāpattiphale patiṭṭhitā rājānaṃ anujānāpetvā pabbajitvā arahattaṃ pāpuṇī”ti āgataṃ.","Tatthāyaṃ <b>apadānapāḷi</b> (apa. therī 2.2.289-383) –"]},{"para":1899,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Padumuttaro nāma jino, sabbadhammesu cakkhumā;"]},{"para":1900,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Ito satasahassamhi, kappe uppajji nāyako."]},{"para":1901,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tadāhaṃ haṃsavatiyaṃ, jātā seṭṭhikule ahuṃ;"]},{"para":1902,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Nānāratanapajjote, mahāsukhasamappitā."]},{"para":1903,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Upetvā taṃ mahāvīraṃ, assosiṃ dhammadesanaṃ;"]},{"para":1904,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Tato jātappasādāhaṃ, upemi saraṇaṃ jinaṃ."]},{"para":1905,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Mātaraṃ pitaraṃ cāhaṃ, āyācitvā vināyakaṃ;"]},{"para":1906,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Nimantayitvā sattāhaṃ, bhojayiṃ sahasāvakaṃ."]},{"para":1907,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Atikkante ca sattāhe, mahāpaññānamuttamaṃ;"]},{"para":1908,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Bhikkhuniṃ etadaggamhi, ṭhapesi narasārathi."]},{"para":1909,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Taṃ sutvā muditā hutvā, puno tassa mahesino;"]},{"para":1910,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Kāraṃ katvāna taṃ ṭhānaṃ, paṇipacca paṇīdahiṃ."]},{"para":1911,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tato mama jino āha, sijjhataṃ paṇidhī tava;"]},{"para":1912,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Sasaṅghe me kataṃ kāraṃ, appameyyaphalaṃ tayā."]},{"para":1913,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Satasahassito kappe, okkākakulasambhavo;"]},{"para":1914,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Gotamo nāma gottena, satthā loke bhavissati."]},{"para":1915,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tassa dhammesu dāyādā, orasā dhammanimmitā;"]},{"para":1916,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Etadaggamanuppattā, khemā nāma bhavissati."]},{"para":1917,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"]},{"para":1918,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsūpagā ahaṃ."]},{"para":1919,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tato cutā yāmamagaṃ, tatohaṃ tusitaṃ gatā;"]},{"para":1920,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Tato ca nimmānaratiṃ, vasavattipuraṃ tato."]},{"para":1921,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Yattha yatthūpapajjāmi, tassa kammassa vāhasā;"]},{"para":1922,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Tattha tattheva rājūnaṃ, mahesittamakārayiṃ."]},{"para":1923,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tato cutā manussatte, rājūnaṃ cakkavattinaṃ;"]},{"para":1924,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Maṇḍalīnañca rājūnaṃ, mahesittamakārayiṃ."]},{"para":1925,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Sampattiṃ anubhotvāna, devesu manujesu ca;"]},{"para":1926,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Sabbattha sukhitā hutvā, nekakappesu saṃsariṃ."]},{"para":1927,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Ekanavutito kappe, vipassī lokanāyako;"]},{"para":1928,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Uppajji cārudassano, sabbadhammavipassako."]},{"para":1929,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tamahaṃ lokanāyakaṃ, upetvā narasārathiṃ;"]},{"para":1930,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Dhammaṃ bhaṇitaṃ sutvāna, pabbajiṃ anagāriyaṃ."]},{"para":1931,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Dasavassasahassāni, tassa vīrassa sāsane;"]},{"para":1932,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Brahmacariyaṃ caritvāna, yuttayogā bahussutā."]},{"para":1933,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Paccayākārakusalā, catusaccavisāradā;"]},{"para":1934,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Nipuṇā cittakathikā, satthusāsanakārikā."]},{"para":1935,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tato cutāhaṃ tusitaṃ, upapannā yasassinī;"]},{"para":1936,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Abhibhomi tahiṃ aññe, brahmacārīphalenahaṃ."]},{"para":1937,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Yattha yatthūpapannāhaṃ, mahābhogā mahaddhanā;"]},{"para":1938,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Medhāvinī sīlavatī, vinītaparisāpi ca."]},{"para":1939,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Bhavāmi tena kammena, yogena jinasāsane;"]},{"para":1940,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Sabbā sampattiyo mayhaṃ, sulabhā manaso piyā."]},{"para":1941,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Yopi me bhavate bhattā, yattha yattha gatāyapi;"]},{"para":1942,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Vimāneti na maṃ koci, paṭipattibalena me."]},{"para":1943,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Imamhi bhaddake kappe, brahmabandhu mahāyaso;"]},{"para":1944,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Nāmena koṇāgamano, uppajji vadataṃ varo."]},{"para":1945,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tadā hi bārāṇasiyaṃ, susamiddhakulappajā;"]},{"para":1946,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Dhanañjānī sumedhā ca, ahampi ca tayo janā."]},{"para":1947,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Saṅghārāmamadāsimha, dānasahāyikā pure;"]},{"para":1948,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Saṅghassa ca vihārampi, uddissa kārikā mayaṃ."]},{"para":1949,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tato cutā mayaṃ sabbā, tāvatiṃsūpagā ahuṃ;"]},{"para":1950,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Yasasā aggataṃ pattā, manussesu tatheva ca."]},{"para":1951,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Imasmiṃyeva kappamhi, brahmabandhu mahāyaso;"]},{"para":1952,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Kassapo nāma gottena, uppajji vadataṃ varo."]},{"para":1953,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Upaṭṭhāko mahesissa, tadā āsi narissaro;"]},{"para":1954,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Kāsirājā kikī nāma, bārāṇasipuruttame."]},{"para":1955,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tassāsiṃ jeṭṭhikā dhītā, samaṇī iti vissutā;"]},{"para":1956,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Dhammaṃ sutvā jinaggassa, pabbajjaṃ samarocayiṃ."]},{"para":1957,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Anujāni na no tāto, agāreva tadā mayaṃ;"]},{"para":1958,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Vīsavassasahassāni, vicarimha atanditā."]},{"para":1959,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Komāribrahmacariyaṃ, rājakaññā sukhedhitā;"]},{"para":1960,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Buddhopaṭṭhānaniratā, muditā satta dhītaro."]},{"para":1961,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Samaṇī samaṇaguttā ca, bhikkhunī bhikkhudāyikā;"]},{"para":1962,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Dhammā ceva sudhammā ca, sattamī saṅghadāyikā."]},{"para":1963,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Ahaṃ uppalavaṇṇā ca, paṭācārā ca kuṇḍalā;"]},{"para":1964,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Kisāgotamī dhammadinnā, visākhā hoti sattamī."]},{"para":1965,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Kadāci so narādicco, dhammaṃ desesi abbhutaṃ;"]},{"para":1966,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Mahānidānasuttantaṃ, sutvā taṃ pariyāpuṇiṃ."]},{"para":1967,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tehi kammehi sukatehi, cetanāpaṇidhīhi ca;"]},{"para":1968,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."]},{"para":1969,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Pacchime ca bhave dāni, sākalāya puruttame;"]},{"para":1970,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Rañño maddassa dhītāmhi, manāpā dayitā piyā."]},{"para":1971,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Saha me jātamattamhi, khemaṃ tamhi pure ahu;"]},{"para":1972,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Tato khemāti nāmaṃ me, guṇato upapajjatha."]},{"para":1973,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Yadāhaṃ yobbanaṃ pattā, rūpalāvaññabhūsitā;"]},{"para":1974,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Tadā adāsi maṃ tāto, bimbisārassa rājino."]},{"para":1975,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tassāhaṃ suppiyā āsiṃ, rūpakelāyane ratā;"]},{"para":1976,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Rūpānaṃ dosavādīti, na upesiṃ mahādayaṃ."]},{"para":1977,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Bimbisāro tadā rājā, mamānuggahabuddhiyā;"]},{"para":1978,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Vaṇṇayitvā veḷuvanaṃ, gāyake gāpayī mamaṃ."]},{"para":1979,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Rammaṃ veḷuvanaṃ yena, na diṭṭhaṃ sugatālayaṃ;"]},{"para":1980,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Na tena nandanaṃ diṭṭhaṃ, iti maññāmase mayaṃ."]},{"para":1981,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Yena veḷuvanaṃ diṭṭhaṃ, naranandananandanaṃ;"]},{"para":1982,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Sudiṭṭhaṃ nandanaṃ tena, amarindasunandanaṃ."]},{"para":1983,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Vihāya nandanaṃ devā, otaritvā mahītalaṃ;"]},{"para":1984,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Rammaṃ veḷuvanaṃ disvā, na tappanti suvimhitā."]},{"para":1985,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Rājapuññena nibbattaṃ, buddhapuññena bhūsitaṃ;"]},{"para":1986,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Ko vattā tassa nissesaṃ, vanassa guṇasañcayaṃ."]},{"para":1987,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Taṃ sutvā vanasamiddhaṃ, mama sotamanoharaṃ;"]},{"para":1988,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Daṭṭhukāmā tamuyyānaṃ, rañño ārocayiṃ tadā."]},{"para":1989,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Mahatā parivārena, tadā ca so mahīpati;"]},{"para":1990,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Maṃ pesesi tamuyyānaṃ, dassanāya samussukaṃ."]},{"para":1991,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Gaccha passa mahābhoge, vanaṃ nettarasāyanaṃ;"]},{"para":1992,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Yaṃ sadā bhāti siriyā, sugatābhānurañjitaṃ."]},{"para":1993,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Yadā ca piṇḍāya muni, giribbajapuruttamaṃ;"]},{"para":1994,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Paviṭṭhohaṃ tadāyeva, vanaṃ daṭṭhumupāgamiṃ."]},{"para":1995,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tadā taṃ phullavipinaṃ, nānābhamarakūjitaṃ;"]},{"para":1996,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Kokilāgītasahitaṃ, mayūragaṇanaccitaṃ."]},{"para":1997,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Appasaddamanākiṇṇaṃ, nānācaṅkamabhūsitaṃ;"]},{"para":1998,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Kuṭimaṇḍapasaṃkiṇṇaṃ, yogīvaravirājitaṃ."]},{"para":1999,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Vicarantī amaññissaṃ, saphalaṃ nayanaṃ mama;"]},{"para":2000,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Tatthāpi taruṇaṃ bhikkhuṃ, yuttaṃ disvā vicintayiṃ."]},{"para":2001,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Īdise vipine ramme, ṭhitoyaṃ navayobbane;"]},{"para":2002,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Vasantamiva kantena, rūpena ca samanvito."]},{"para":2003,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Nisinno rukkhamūlamhi, muṇḍo saṅghāṭipāruto;"]},{"para":2004,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Jhāyate vatayaṃ bhikkhu, hitvā visayajaṃ ratiṃ."]},{"para":2005,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Nanu nāma gahaṭṭhena, kāmaṃ bhutvā yathāsukhaṃ;"]},{"para":2006,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Pacchā jiṇṇena dhammoyaṃ, caritabbo subhaddako."]},{"para":2007,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Suññakanti viditvāna, gandhagehaṃ jinālayaṃ;"]},{"para":2008,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Upetvā jinamaddakkhaṃ, udayantaṃ va bhākaraṃ."]},{"para":2009,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Ekakaṃ sukhamāsīnaṃ, bījamānaṃ varitthiyā;"]},{"para":2010,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Disvānevaṃ vicintesiṃ, nāyaṃ lūkho narāsabho."]},{"para":2011,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Sā kaññā kanakābhāsā, padumānanalocanā;"]},{"para":2012,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Bimboṭṭhī kundadasanā, manonettarasāyanā."]},{"para":2013,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Hemadolābhasavanā, kalikākārasutthanī;"]},{"para":2014,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Vedimajjhāva sussoṇī, rambhoru cārubhūsanā."]},{"para":2015,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Rattaṃsakupasaṃbyānā, nīlamaṭṭhanivāsanā;"]},{"para":2016,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Atappaneyyarūpena, hāsabhāvasamanvitā."]},{"para":2017,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Disvā tamevaṃ cintesiṃ, ahoyamabhirūpinī;"]},{"para":2018,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Na mayānena nettena, diṭṭhapubbā kudācanaṃ."]},{"para":2019,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tato jarābhibhūtā sā, vivaṇṇā vikatānanā;"]},{"para":2020,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Bhinnadantā setasirā, salālā vadanāsuci."]},{"para":2021,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Saṃkhittakaṇṇā setakkhī, lambāsubhapayodharā;"]},{"para":2022,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Valivitatasabbaṅgī, sirāvitatadehinī."]},{"para":2023,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Nataṅgā daṇḍadutiyā, upphāsulikatā kisā;"]},{"para":2024,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Pavedhamānā patitā, nissasantī muhuṃ muhuṃ."]},{"para":2025,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tato me āsi saṃvego, abbhuto lomahaṃsano;"]},{"para":2026,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Dhiratthu rūpaṃ asuciṃ, ramante yattha bālisā."]},{"para":2027,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tadā mahākāruṇiko, disvā saṃviggamānasaṃ;"]},{"para":2028,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Udaggacitto sugato, imā gāthā abhāsatha."]},{"para":2029,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Āturaṃ asuciṃ pūtiṃ, passa kheme samussayaṃ;"]},{"para":2030,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Uggharantaṃ paggharantaṃ, bālānaṃ abhinanditaṃ."]},{"para":2031,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ;"]},{"para":2032,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Sati kāyagatā tyatthu, nibbidā bahulā bhava."]},{"para":2033,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Yathā idaṃ tathā etaṃ, yathā etaṃ tathā idaṃ;"]},{"para":2034,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Ajjhattañca bahiddhā ca, kāye chandaṃ virājaya."]},{"para":2035,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Animittañca bhāvehi, mānānusayamujjaha;"]},{"para":2036,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Tato mānābhisamayā, upasantā carissasi."]},{"para":2037,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Ye rāgarattānupatanti sotaṃ, sayaṃ kataṃ makkaṭakova jālaṃ;"]},{"para":2038,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Etampi chetvāna paribbajanti, anapekkhino kāmasukhaṃ pahāya."]},{"para":2039,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tato kallitacittaṃ maṃ, ñatvāna narasārathi;"]},{"para":2040,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Mahānidānaṃ desesi, suttantaṃ vinayāya me."]},{"para":2041,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Sutvā suttantaseṭṭhaṃ taṃ, pubbasaññamanussariṃ;"]},{"para":2042,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Tattha ṭhitāvahaṃ santī, dhammacakkhuṃ visodhayiṃ."]},{"para":2043,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Nipatitvā mahesissa, pādamūlamhi tāvade;"]},{"para":2044,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Accayaṃ desanatthāya, idaṃ vacanamabraviṃ."]},{"para":2045,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Namo te sabbadassāvi, namo te karuṇākara;"]},{"para":2046,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Namo te tiṇṇasaṃsāra, namo te amataṃ dada."]},{"para":2047,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Diṭṭhigahanapakkhandā, kāmarāgavimohitā;"]},{"para":2048,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Tayā sammā upāyena, vinītā vinaye ratā."]},{"para":2049,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Adassanena vibhogā, tādisānaṃ mahesinaṃ;"]},{"para":2050,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Anubhonti mahādukkhaṃ, sattā saṃsārasāgare."]},{"para":2051,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Yadāhaṃ lokasaraṇaṃ, araṇaṃ araṇantaguṃ;"]},{"para":2052,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Nāddasāmi adūraṭṭhaṃ, desayāmi tamaccayaṃ."]},{"para":2053,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Mahāhitaṃ varadadaṃ, ahitoti visaṅkitā;"]},{"para":2054,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Nopesiṃ rūpaniratā, desayāmi tamaccayaṃ."]},{"para":2055,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tadā madhuranigghoso, mahākāruṇiko jino;"]},{"para":2056,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Avoca tiṭṭha khemeti, siñcanto amatena maṃ."]},{"para":2057,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tadā pakamya sirasā, katvā ca naṃ padakkhiṇaṃ;"]},{"para":2058,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Gantvā disvā narapatiṃ, idaṃ vacanamabraviṃ."]},{"para":2059,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Aho sammā upāyo te, cintitoyamarindama;"]},{"para":2060,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Vanadassanakāmāya, diṭṭho nibbānato muni."]},{"para":2061,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Yadi te ruccate rāja, sāsane tassa tādino;"]},{"para":2062,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Pabbajissāmi rūpehaṃ, nibbinnā munivāṇinā."]},{"para":2063,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Añjaliṃ paggahetvāna, tadāha sa mahīpati;"]},{"para":2064,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Anujānāmi te bhadde, pabbajjā tava sijjhatu."]},{"para":2065,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Pabbajitvā tadā cāhaṃ, addhamāse upaṭṭhite;"]},{"para":2066,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Dīpodayañca bhedañca, disvā saṃviggamānasā."]},{"para":2067,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Nibbinnā sabbasaṅkhāre, paccayākārakovidā;"]},{"para":2068,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Caturoghe atikkamma, arahattamapāpuṇiṃ."]},{"para":2069,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Iddhīsu ca vasī āsiṃ, dibbāya sotadhātuyā;"]},{"para":2070,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Cetopariyañāṇassa, vasī cāpi bhavāmahaṃ."]},{"para":2071,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"]},{"para":2072,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."]},{"para":2073,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Atthadhammaniruttīsa, paṭibhāne tatheva ca;"]},{"para":2074,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Parisuddhaṃ mama ñāṇaṃ, uppannaṃ buddhasāsane."]},{"para":2075,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Kusalāhaṃ visuddhīsu, kathāvatthuvisāradā;"]},{"para":2076,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Abhidhammanayaññū ca, vasippattāmhi sāsane."]},{"para":2077,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tato toraṇavatthusmiṃ, raññā kosalasāminā;"]},{"para":2078,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Pucchitā nipuṇe pañhe, byākarontī yathātathaṃ."]},{"para":2079,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Tadā sa rājā sugataṃ, upasaṅkamma pucchatha;"]},{"para":2080,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Tatheva buddho byākāsi, yathā te byākatā mayā."]},{"para":2081,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Jino tasmiṃ guṇe tuṭṭho, etadagge ṭhapesi maṃ;"]},{"para":2082,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Mahāpaññānamaggāti, bhikkhunīnaṃ naruttamo."]},{"para":2083,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti. (apa. therī 2.2.289-383);"]},{"para":2084,"vripara":null,"title":"Khemātherīgāthāvaṇṇanā","lines":["Arahattaṃ pana patvā phalasukhena nibbānasukhena ca viharantiyā imissā theriyā satipi aññāsaṃ khīṇāsavattherīnaṃ paññāvepullappattiyaṃ tattha pana katādhikāratāya mahāpaññābhāvo pākaṭo ahosi.","Tathā hi naṃ bhagavā jetavanamahāvihāre ariyagaṇamajjhe nisinno paṭipāṭiyā bhikkhuniyo ṭhānantare ṭhapento “etadaggaṃ, bhikkhave, mama sāvikānaṃ bhikkhunīnaṃ mahāpaññānaṃ yadidaṃ khemā”ti (a. ni. 1.235-236) mahāpaññatāya aggaṭṭhāne ṭhapesi.","Taṃ ekadivasaṃ aññatarasmiṃ rukkhamūle divāvihāraṃ nisinnaṃ māro pāpimā taruṇarūpena upasaṅkamitvā kāmehi palobhento – 139."]}]},"tika":null,"tika2":null}
