{"suttaId":"thig6.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[549,567],"vripara":"139"},"segments":{"thig6.3:0.3":"Khemātherīgāthā","thig6.3:1.1":"“Daharā tvaṃ rūpavatī, ahampi daharo yuvā;","thig6.3:1.3":"Pañcaṅgikena turiyena [tūrena (ka.)], ehi kheme ramāmase”.","thig6.3:2.1":"“Iminā pūtikāyena, āturena pabhaṅgunā;","thig6.3:2.3":"Aṭṭiyāmi harāyāmi, kāmataṇhā samūhatā.","thig6.3:3.1":"“Sattisūlūpamā kāmā, khandhāsaṃ adhikuṭṭanā;","thig6.3:3.3":"Yaṃ ‘tvaṃ kāmaratiṃ’ brūsi,‘aratī’ dāni sā mama.","thig6.3:4.1":"“Sabbattha vihatā nandī, tamokhandho padālito;","thig6.3:4.3":"Evaṃ jānāhi pāpima, nihato tvamasi antaka.","thig6.3:5.1":"“Nakkhattāni namassantā, aggiṃ paricaraṃ vane;","thig6.3:5.3":"Yathābhuccamajānantā, bālā suddhimamaññatha.","thig6.3:6.1":"“Ahañca kho namassantī, sambuddhaṃ purisuttamaṃ;","thig6.3:6.3":"Pamuttā [parimuttā (sī. syā.)] sabbadukkhehi, satthusāsanakārikā”ti.","thig6.3:7.1":"… Khemā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":2086,"to":2109,"paras":[{"para":2086,"vripara":"139","refs":["thig6.3:1"],"lines":["“Daharā tvaṃ rūpavatī, ahampi daharo yuvā;"],"lineRefs":[["thig6.3:1"]]},{"para":2087,"vripara":null,"refs":["thig6.3:1"],"lines":["Pañcaṅgikena turiyena, ehi kheme ramāmase”ti.","– gāthamāha;"],"lineRefs":[["thig6.3:1"],["thig6.3:1"]]},{"para":2088,"vripara":null,"refs":["thig6.3:1"],"lines":["Tassattho – kheme, tvaṃ taruṇappattā, yobbane ṭhitā rūpasampannā, ahampi taruṇo yuvā, tasmā mayaṃ yobbaññaṃ akhepetvā pañcaṅgikena turiyena vajjamānena ehi kāmakhiḍḍāratiyā ramāma kīḷāmāti."],"lineRefs":[["thig6.3:1"]]},{"para":2089,"vripara":null,"refs":["thig6.3:1"],"lines":["Taṃ sutvā sā kāmesu sabbadhammesu ca attano virattabhāvaṃ tassa ca mārabhāvaṃ attābhinivesesu sattesu attano thāmagataṃ appasādaṃ katakiccatañca pakāsentī –"],"lineRefs":[["thig6.3:1"]]},{"para":2091,"vripara":"140","refs":["thig6.3:2"],"lines":["“Iminā pūtikāyena, āturena pabhaṅgunā;"],"lineRefs":[["thig6.3:2"]]},{"para":2092,"vripara":null,"refs":["thig6.3:2"],"lines":["Aṭṭiyāmi harāyāmi, kāmataṇhā samūhatā."],"lineRefs":[["thig6.3:2"]]},{"para":2094,"vripara":"141","refs":["thig6.3:3"],"lines":["“Sattisūlūpamā kāmā, khandhāsaṃ adhikuṭṭanā;"],"lineRefs":[["thig6.3:3"]]},{"para":2095,"vripara":null,"refs":["thig6.3:3"],"lines":["Yaṃ tvaṃ kāmaratiṃ brūsi, aratī dāni sā mama."],"lineRefs":[["thig6.3:3"]]},{"para":2097,"vripara":"142","refs":["thig6.3:4"],"lines":["“Sabbattha vihatā nandī, tamokhandho padālito;"],"lineRefs":[["thig6.3:4"]]},{"para":2098,"vripara":null,"refs":["thig6.3:4"],"lines":["Evaṃ jānāhi pāpima, nihato tvamasi antaka."],"lineRefs":[["thig6.3:4"]]},{"para":2100,"vripara":"143","refs":["thig6.3:5"],"lines":["“Nakkhattāni namassantā, aggiṃ paricaraṃ vane;"],"lineRefs":[["thig6.3:5"]]},{"para":2101,"vripara":null,"refs":["thig6.3:5"],"lines":["Yathābhuccamajānantā, bālā suddhimamaññatha."],"lineRefs":[["thig6.3:5"]]},{"para":2103,"vripara":"144","refs":["thig6.3:6"],"lines":["“Ahañca kho namassantī, sambuddhaṃ purisuttamaṃ;"],"lineRefs":[["thig6.3:6"]]},{"para":2104,"vripara":null,"refs":["thig6.3:6"],"lines":["Pamuttā sabbadukkhehi, satthusāsanakārikā”ti.","– imā gāthā abhāsi;"],"lineRefs":[["thig6.3:6"],["thig6.3:6"]]},{"para":2105,"vripara":null,"refs":["thig6.3:6"],"lines":["Tattha <b>aggiṃ paricaraṃ vane</b>ti tapovane aggihuttaṃ paricaranto.","<b>Yathābhuccamajānantā</b>ti pavattiyo yathābhūtaṃ aparijānantā.","Sesamettha heṭṭhā vuttanayattā uttānameva."],"lineRefs":[["thig6.3:6"],["thig6.3:6"],["thig6.3:6"]]},{"para":2106,"vripara":null,"refs":["thig6.3:6"],"lines":["Khemātherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[["thig6.3:6"]]},{"para":2107,"vripara":null,"refs":["thig6.3:6"],"lines":["Sujātātherīgāthāvaṇṇanā"],"lineRefs":[["thig6.3:6"]]},{"para":2108,"vripara":null,"refs":["thig6.3:6"],"lines":["<b>Alaṅkatā suvasanā</b>tiādikā sujātāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī anukkamena sambhatavimokkhasambhārā hutvā imasmiṃ buddhuppāde sāketanagare seṭṭhikule nibbattitvā vayappattā mātāpitūhi samānajātikassa seṭṭhiputtassa dinnā hutvā patikulaṃ gatā.","Tattha tena saddhiṃ sukhasaṃvāsaṃ vasantī ekadivasaṃ uyyānaṃ gantvā nakkhattakīḷaṃ kīḷitvā parijanena saddhiṃ nagaraṃ āgacchantī añjanavane satthāraṃ disvā pasannamānasā upasaṅkamitvā vanditvā ekamantaṃ nisīdi.","Satthā tassā anupubbiṃ kathaṃ kathetvā kallacittataṃ ñatvā upari sāmukkaṃsikaṃ dhammadesanaṃ pakāsesi.","Sā desanāvasāne attano katādhikāratāya ñāṇassa paripākaṃ gatattā ca, satthu ca desanāvilāsena yathānisinnāva saha paṭisambhidāhi arahattaṃ patvā satthāraṃ vanditvā gehaṃ gantvā sāmikañca mātāpitaro ca anujānāpetvā satthuāṇāya bhikkhunupassayaṃ gantvā bhikkhunīnaṃ santike pabbaji.","Pabbajitvā ca attano paṭipattiṃ paccavekkhitvā udānavasena –"],"lineRefs":[["thig6.3:6"],["thig6.3:6"],["thig6.3:6"],["thig6.3:6"],["thig6.3:6"],["thig6.3:6"]]}],"wordLinks":[],"before":[{"para":1891,"vripara":null,"refs":[],"lines":["Vāseṭṭhītherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1892,"vripara":null,"refs":[],"lines":["Khemātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":1893,"vripara":null,"refs":[],"lines":["<b>Daharā tvaṃ rūpavatī</b>tiādikā khemāya theriyā gāthā.","Ayaṃ kira padumuttarassa bhagavato kāle haṃsavatīnagare parādhīnavuttikā paresaṃ dāsī ahosi.","Sā paresaṃ veyyāvaccakaraṇena jīvikaṃ kappentī ekadivasaṃ padumuttarassa sammāsambuddhassa aggasāvakaṃ sujātattheraṃ piṇḍāya carantaṃ disvā tayo modake datvā taṃdivasameva attano kese vissajjetvā therassa dānaṃ datvā “anāgate mahāpaññā buddhassa sāvikā bhaveyyan”ti patthanaṃ katvā yāvajīvaṃ kusalakamme appamattā hutvā devamanussesu saṃsarantī anukkamena chakāmasagge, tesaṃ tesaṃ devarājūnaṃ mahesibhāvena upapannā, manussalokepi anekavāraṃ cakkavattīnaṃ maṇḍalarājūnañca mahesibhāvaṃ upagatā mahāsampattiyo anubhavitvā vipassissa bhagavato kāle manussaloke uppajjitvā viññutaṃ patvā, satthu santike dhammaṃ sutvā paṭiladdhasaṃvegā pabbajitvā dasavassasahassāni brahmacariyaṃ carantī bahussutā dhammakathikā hutvā bahujanassa dhammakathanādinā paññāsaṃvattaniyakammaṃ katvā tato cavitvā sugatīsuyeva saṃsarantī imasmiṃ kappe bhagavato ca kakusandhassa bhagavato ca koṇāgamanassa kāle vibhavasampanne kule nibbattitvā viññutaṃ patvā mahantaṃ saṅghārāmaṃ kāretvā buddhappamukhassa bhikkhusaṅghassa niyyādesi."],"lineRefs":[[],[],[]]},{"para":1894,"vripara":null,"refs":[],"lines":["Bhagavato pana kassapadasabalassa kāle kikissa kāsirañño sabbajeṭṭhikā samaṇī nāma dhītā hutvā, satthu santike dhammaṃ sutvā paṭiladdhasaṃvegā agāreyeva ṭhitā, vīsati vassasahassāni komāribrahmacariyaṃ carantī samaṇaguttādīhi attano bhaginīhi saddhiṃ ramaṇīyaṃ pariveṇaṃ kāretvā buddhappamukhassa bhikkhusaṅghassa niyyādesi.","Evameva tattha tattha bhave āyatanagataṃ uḷāraṃ puññakammaṃ katvā sugatīsuyeva saṃsaritvā imasmiṃ buddhuppāde maddaraṭṭhe sākalanagare rājakule nibbatti.","<b>Khemā</b>tissā nāmaṃ ahosi, suvaṇṇavaṇṇā kañcanasannibhattacā.","Sā vayappattā bimbisārarañño gehaṃ gatā.","Satthari veḷuvane viharante rūpamattā hutvā “rūpe dosaṃ dassetī”ti satthu dassanāya na gacchati."],"lineRefs":[[],[],[],[],[]]},{"para":1895,"vripara":null,"refs":[],"lines":["Rājā manussehi veḷuvanassa vaṇṇe pakāsāpetvā deviyā vihāradassanāya cittaṃ uppādesi.","Atha devī “vihāraṃ passissāmī”ti rājānaṃ paṭipucchi.","Rājā “vihāraṃ gantvā satthāraṃ adisvā āgantuṃ na labhissasī”ti vatvā purisānaṃ saññaṃ adāsi –","“balakkārenapi deviṃ dasabalaṃ dassethā”ti.","Devī vihāraṃ gantvā divasabhāgaṃ khepetvā nivattentī satthāraṃ adisvāva gantuṃ āraddhā.","Atha naṃ rājapurisā anicchantimpi satthu santikaṃ nayiṃsu.","Satthā taṃ āgacchantiṃ disvā iddhiyā devaccharāsadisaṃ itthiṃ nimminitvā tālapaṇṇaṃ gahetvā bījayamānaṃ akāsi.","Khemā devī taṃ disvā cintesi –","“evarūpā nāma devaccharapaṭibhāgā itthiyo bhagavato avidūre tiṭṭhanti, ahaṃ etāsaṃ paricārikatāyapi nappahomi, manampi nikkāraṇā pāpacittassa vasena naṭṭhā”ti nimittaṃ gahetvā tameva itthiṃ olokayamānā aṭṭhāsi.","Athassā passantiyāva satthu adhiṭṭhānabalena sā itthī paṭhamavayaṃ atikkamma majjhimavayampi atikkamma pacchimavayaṃ patvā khaṇḍadantā palitakesā valittacā hutvā saddhiṃ tālapaṇṇena parivattitvā pati.","Tato khemā katādhikārattā evaṃ cintesi –","“evaṃvidhampi sarīraṃ īdisaṃ vipattiṃ pāpuṇi, mayhampi sarīraṃ evaṃgatikameva bhavissatī”ti.","Athassā cittācāraṃ ñatvā satthā –"],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":1896,"vripara":null,"refs":[],"lines":["“Ye rāgarattānupatanti sotaṃ, sayaṃ kataṃ makkaṭakova jālaṃ;"],"lineRefs":[[]]},{"para":1897,"vripara":null,"refs":[],"lines":["Etampi chetvāna paribbajanti, anapekkhino kāmasukhaṃ pahāyā”ti.","–"],"lineRefs":[[],[]]},{"para":1898,"vripara":null,"refs":[],"lines":["Gāthamāha.","Sā gāthāpariyosāne saha paṭisambhidāhi arahattaṃ pāpuṇīti aṭṭhakathāsu āgataṃ.","Apadāne pana “imaṃ gāthaṃ sutvā sotāpattiphale patiṭṭhitā rājānaṃ anujānāpetvā pabbajitvā arahattaṃ pāpuṇī”ti āgataṃ.","Tatthāyaṃ <b>apadānapāḷi</b> (apa. therī 2.2.289-383)–"],"lineRefs":[[],[],[],[]]},{"para":1899,"vripara":null,"refs":[],"lines":["“Padumuttaro nāma jino, sabbadhammesu cakkhumā;"],"lineRefs":[[]]},{"para":1900,"vripara":null,"refs":[],"lines":["Ito satasahassamhi, kappe uppajji nāyako."],"lineRefs":[[]]},{"para":1901,"vripara":null,"refs":[],"lines":["“Tadāhaṃ haṃsavatiyaṃ, jātā seṭṭhikule ahuṃ;"],"lineRefs":[[]]},{"para":1902,"vripara":null,"refs":[],"lines":["Nānāratanapajjote, mahāsukhasamappitā."],"lineRefs":[[]]},{"para":1903,"vripara":null,"refs":[],"lines":["“Upetvā taṃ mahāvīraṃ, assosiṃ dhammadesanaṃ;"],"lineRefs":[[]]},{"para":1904,"vripara":null,"refs":[],"lines":["Tato jātappasādāhaṃ, upemi saraṇaṃ jinaṃ."],"lineRefs":[[]]},{"para":1905,"vripara":null,"refs":[],"lines":["“Mātaraṃ pitaraṃ cāhaṃ, āyācitvā vināyakaṃ;"],"lineRefs":[[]]},{"para":1906,"vripara":null,"refs":[],"lines":["Nimantayitvā sattāhaṃ, bhojayiṃ sahasāvakaṃ."],"lineRefs":[[]]},{"para":1907,"vripara":null,"refs":[],"lines":["“Atikkante ca sattāhe, mahāpaññānamuttamaṃ;"],"lineRefs":[[]]},{"para":1908,"vripara":null,"refs":[],"lines":["Bhikkhuniṃ etadaggamhi, ṭhapesi narasārathi."],"lineRefs":[[]]},{"para":1909,"vripara":null,"refs":[],"lines":["“Taṃ sutvā muditā hutvā, puno tassa mahesino;"],"lineRefs":[[]]},{"para":1910,"vripara":null,"refs":[],"lines":["Kāraṃ katvāna taṃ ṭhānaṃ, paṇipacca paṇīdahiṃ."],"lineRefs":[[]]},{"para":1911,"vripara":null,"refs":[],"lines":["“Tato mama jino āha, sijjhataṃ paṇidhī tava;"],"lineRefs":[[]]},{"para":1912,"vripara":null,"refs":[],"lines":["Sasaṅghe me kataṃ kāraṃ, appameyyaphalaṃ tayā."],"lineRefs":[[]]},{"para":1913,"vripara":null,"refs":[],"lines":["“Satasahassito kappe, okkākakulasambhavo;"],"lineRefs":[[]]},{"para":1914,"vripara":null,"refs":[],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[[]]},{"para":1915,"vripara":null,"refs":[],"lines":["“Tassa dhammesu dāyādā, orasā dhammanimmitā;"],"lineRefs":[[]]},{"para":1916,"vripara":null,"refs":[],"lines":["Etadaggamanuppattā, khemā nāma bhavissati."],"lineRefs":[[]]},{"para":1917,"vripara":null,"refs":[],"lines":["“Tena kammena sukatena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":1918,"vripara":null,"refs":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsūpagā ahaṃ."],"lineRefs":[[]]},{"para":1919,"vripara":null,"refs":[],"lines":["“Tato cutā yāmamagaṃ, tatohaṃ tusitaṃ gatā;"],"lineRefs":[[]]},{"para":1920,"vripara":null,"refs":[],"lines":["Tato ca nimmānaratiṃ, vasavattipuraṃ tato."],"lineRefs":[[]]},{"para":1921,"vripara":null,"refs":[],"lines":["“Yattha yatthūpapajjāmi, tassa kammassa vāhasā;"],"lineRefs":[[]]},{"para":1922,"vripara":null,"refs":[],"lines":["Tattha tattheva rājūnaṃ, mahesittamakārayiṃ."],"lineRefs":[[]]},{"para":1923,"vripara":null,"refs":[],"lines":["“Tato cutā manussatte, rājūnaṃ cakkavattinaṃ;"],"lineRefs":[[]]},{"para":1924,"vripara":null,"refs":[],"lines":["Maṇḍalīnañca rājūnaṃ, mahesittamakārayiṃ."],"lineRefs":[[]]},{"para":1925,"vripara":null,"refs":[],"lines":["“Sampattiṃ anubhotvāna, devesu manujesu ca;"],"lineRefs":[[]]},{"para":1926,"vripara":null,"refs":[],"lines":["Sabbattha sukhitā hutvā, nekakappesu saṃsariṃ."],"lineRefs":[[]]},{"para":1927,"vripara":null,"refs":[],"lines":["“Ekanavutito kappe, vipassī lokanāyako;"],"lineRefs":[[]]},{"para":1928,"vripara":null,"refs":[],"lines":["Uppajji cārudassano, sabbadhammavipassako."],"lineRefs":[[]]},{"para":1929,"vripara":null,"refs":[],"lines":["“Tamahaṃ lokanāyakaṃ, upetvā narasārathiṃ;"],"lineRefs":[[]]},{"para":1930,"vripara":null,"refs":[],"lines":["Dhammaṃ bhaṇitaṃ sutvāna, pabbajiṃ anagāriyaṃ."],"lineRefs":[[]]},{"para":1931,"vripara":null,"refs":[],"lines":["“Dasavassasahassāni, tassa vīrassa sāsane;"],"lineRefs":[[]]},{"para":1932,"vripara":null,"refs":[],"lines":["Brahmacariyaṃ caritvāna, yuttayogā bahussutā."],"lineRefs":[[]]},{"para":1933,"vripara":null,"refs":[],"lines":["“Paccayākārakusalā, catusaccavisāradā;"],"lineRefs":[[]]},{"para":1934,"vripara":null,"refs":[],"lines":["Nipuṇā cittakathikā, satthusāsanakārikā."],"lineRefs":[[]]},{"para":1935,"vripara":null,"refs":[],"lines":["“Tato cutāhaṃ tusitaṃ, upapannā yasassinī;"],"lineRefs":[[]]},{"para":1936,"vripara":null,"refs":[],"lines":["Abhibhomi tahiṃ aññe, brahmacārīphalenahaṃ."],"lineRefs":[[]]},{"para":1937,"vripara":null,"refs":[],"lines":["“Yattha yatthūpapannāhaṃ, mahābhogā mahaddhanā;"],"lineRefs":[[]]},{"para":1938,"vripara":null,"refs":[],"lines":["Medhāvinī sīlavatī, vinītaparisāpi ca."],"lineRefs":[[]]},{"para":1939,"vripara":null,"refs":[],"lines":["“Bhavāmi tena kammena, yogena jinasāsane;"],"lineRefs":[[]]},{"para":1940,"vripara":null,"refs":[],"lines":["Sabbā sampattiyo mayhaṃ, sulabhā manaso piyā."],"lineRefs":[[]]},{"para":1941,"vripara":null,"refs":[],"lines":["“Yopi me bhavate bhattā, yattha yattha gatāyapi;"],"lineRefs":[[]]},{"para":1942,"vripara":null,"refs":[],"lines":["Vimāneti na maṃ koci, paṭipattibalena me."],"lineRefs":[[]]},{"para":1943,"vripara":null,"refs":[],"lines":["“Imamhi bhaddake kappe, brahmabandhu mahāyaso;"],"lineRefs":[[]]},{"para":1944,"vripara":null,"refs":[],"lines":["Nāmena koṇāgamano, uppajji vadataṃ varo."],"lineRefs":[[]]},{"para":1945,"vripara":null,"refs":[],"lines":["“Tadā hi bārāṇasiyaṃ, susamiddhakulappajā;"],"lineRefs":[[]]},{"para":1946,"vripara":null,"refs":[],"lines":["Dhanañjānī sumedhā ca, ahampi ca tayo janā."],"lineRefs":[[]]},{"para":1947,"vripara":null,"refs":[],"lines":["“Saṅghārāmamadāsimha, dānasahāyikā pure;"],"lineRefs":[[]]},{"para":1948,"vripara":null,"refs":[],"lines":["Saṅghassa ca vihārampi, uddissa kārikā mayaṃ."],"lineRefs":[[]]},{"para":1949,"vripara":null,"refs":[],"lines":["“Tato cutā mayaṃ sabbā, tāvatiṃsūpagā ahuṃ;"],"lineRefs":[[]]},{"para":1950,"vripara":null,"refs":[],"lines":["Yasasā aggataṃ pattā, manussesu tatheva ca."],"lineRefs":[[]]},{"para":1951,"vripara":null,"refs":[],"lines":["“Imasmiṃyeva kappamhi, brahmabandhu mahāyaso;"],"lineRefs":[[]]},{"para":1952,"vripara":null,"refs":[],"lines":["Kassapo nāma gottena, uppajji vadataṃ varo."],"lineRefs":[[]]},{"para":1953,"vripara":null,"refs":[],"lines":["“Upaṭṭhāko mahesissa, tadā āsi narissaro;"],"lineRefs":[[]]},{"para":1954,"vripara":null,"refs":[],"lines":["Kāsirājā kikī nāma, bārāṇasipuruttame."],"lineRefs":[[]]},{"para":1955,"vripara":null,"refs":[],"lines":["“Tassāsiṃ jeṭṭhikā dhītā, samaṇī iti vissutā;"],"lineRefs":[[]]},{"para":1956,"vripara":null,"refs":[],"lines":["Dhammaṃ sutvā jinaggassa, pabbajjaṃ samarocayiṃ."],"lineRefs":[[]]},{"para":1957,"vripara":null,"refs":[],"lines":["“Anujāni na no tāto, agāreva tadā mayaṃ;"],"lineRefs":[[]]},{"para":1958,"vripara":null,"refs":[],"lines":["Vīsavassasahassāni, vicarimha atanditā."],"lineRefs":[[]]},{"para":1959,"vripara":null,"refs":[],"lines":["“Komāribrahmacariyaṃ, rājakaññā sukhedhitā;"],"lineRefs":[[]]},{"para":1960,"vripara":null,"refs":[],"lines":["Buddhopaṭṭhānaniratā, muditā satta dhītaro."],"lineRefs":[[]]},{"para":1961,"vripara":null,"refs":[],"lines":["“Samaṇī samaṇaguttā ca, bhikkhunī bhikkhudāyikā;"],"lineRefs":[[]]},{"para":1962,"vripara":null,"refs":[],"lines":["Dhammā ceva sudhammā ca, sattamī saṅghadāyikā."],"lineRefs":[[]]},{"para":1963,"vripara":null,"refs":[],"lines":["“Ahaṃ uppalavaṇṇā ca, paṭācārā ca kuṇḍalā;"],"lineRefs":[[]]},{"para":1964,"vripara":null,"refs":[],"lines":["Kisāgotamī dhammadinnā, visākhā hoti sattamī."],"lineRefs":[[]]},{"para":1965,"vripara":null,"refs":[],"lines":["“Kadāci so narādicco, dhammaṃ desesi abbhutaṃ;"],"lineRefs":[[]]},{"para":1966,"vripara":null,"refs":[],"lines":["Mahānidānasuttantaṃ, sutvā taṃ pariyāpuṇiṃ."],"lineRefs":[[]]},{"para":1967,"vripara":null,"refs":[],"lines":["“Tehi kammehi sukatehi, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":1968,"vripara":null,"refs":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":1969,"vripara":null,"refs":[],"lines":["“Pacchime ca bhave dāni, sākalāya puruttame;"],"lineRefs":[[]]},{"para":1970,"vripara":null,"refs":[],"lines":["Rañño maddassa dhītāmhi, manāpā dayitā piyā."],"lineRefs":[[]]},{"para":1971,"vripara":null,"refs":[],"lines":["“Saha me jātamattamhi, khemaṃ tamhi pure ahu;"],"lineRefs":[[]]},{"para":1972,"vripara":null,"refs":[],"lines":["Tato khemāti nāmaṃ me, guṇato upapajjatha."],"lineRefs":[[]]},{"para":1973,"vripara":null,"refs":[],"lines":["“Yadāhaṃ yobbanaṃ pattā, rūpalāvaññabhūsitā;"],"lineRefs":[[]]},{"para":1974,"vripara":null,"refs":[],"lines":["Tadā adāsi maṃ tāto, bimbisārassa rājino."],"lineRefs":[[]]},{"para":1975,"vripara":null,"refs":[],"lines":["“Tassāhaṃ suppiyā āsiṃ, rūpakelāyane ratā;"],"lineRefs":[[]]},{"para":1976,"vripara":null,"refs":[],"lines":["Rūpānaṃ dosavādīti, na upesiṃ mahādayaṃ."],"lineRefs":[[]]},{"para":1977,"vripara":null,"refs":[],"lines":["“Bimbisāro tadā rājā, mamānuggahabuddhiyā;"],"lineRefs":[[]]},{"para":1978,"vripara":null,"refs":[],"lines":["Vaṇṇayitvā veḷuvanaṃ, gāyake gāpayī mamaṃ."],"lineRefs":[[]]},{"para":1979,"vripara":null,"refs":[],"lines":["“Rammaṃ veḷuvanaṃ yena, na diṭṭhaṃ sugatālayaṃ;"],"lineRefs":[[]]},{"para":1980,"vripara":null,"refs":[],"lines":["Na tena nandanaṃ diṭṭhaṃ, iti maññāmase mayaṃ."],"lineRefs":[[]]},{"para":1981,"vripara":null,"refs":[],"lines":["“Yena veḷuvanaṃ diṭṭhaṃ, naranandananandanaṃ;"],"lineRefs":[[]]},{"para":1982,"vripara":null,"refs":[],"lines":["Sudiṭṭhaṃ nandanaṃ tena, amarindasunandanaṃ."],"lineRefs":[[]]},{"para":1983,"vripara":null,"refs":[],"lines":["“Vihāya nandanaṃ devā, otaritvā mahītalaṃ;"],"lineRefs":[[]]},{"para":1984,"vripara":null,"refs":[],"lines":["Rammaṃ veḷuvanaṃ disvā, na tappanti suvimhitā."],"lineRefs":[[]]},{"para":1985,"vripara":null,"refs":[],"lines":["“Rājapuññena nibbattaṃ, buddhapuññena bhūsitaṃ;"],"lineRefs":[[]]},{"para":1986,"vripara":null,"refs":[],"lines":["Ko vattā tassa nissesaṃ, vanassa guṇasañcayaṃ."],"lineRefs":[[]]},{"para":1987,"vripara":null,"refs":[],"lines":["“Taṃ sutvā vanasamiddhaṃ, mama sotamanoharaṃ;"],"lineRefs":[[]]},{"para":1988,"vripara":null,"refs":[],"lines":["Daṭṭhukāmā tamuyyānaṃ, rañño ārocayiṃ tadā."],"lineRefs":[[]]},{"para":1989,"vripara":null,"refs":[],"lines":["“Mahatā parivārena, tadā ca so mahīpati;"],"lineRefs":[[]]},{"para":1990,"vripara":null,"refs":[],"lines":["Maṃ pesesi tamuyyānaṃ, dassanāya samussukaṃ."],"lineRefs":[[]]},{"para":1991,"vripara":null,"refs":[],"lines":["“Gaccha passa mahābhoge, vanaṃ nettarasāyanaṃ;"],"lineRefs":[[]]},{"para":1992,"vripara":null,"refs":[],"lines":["Yaṃ sadā bhāti siriyā, sugatābhānurañjitaṃ."],"lineRefs":[[]]},{"para":1993,"vripara":null,"refs":[],"lines":["“Yadā ca piṇḍāya muni, giribbajapuruttamaṃ;"],"lineRefs":[[]]},{"para":1994,"vripara":null,"refs":[],"lines":["Paviṭṭhohaṃ tadāyeva, vanaṃ daṭṭhumupāgamiṃ."],"lineRefs":[[]]},{"para":1995,"vripara":null,"refs":[],"lines":["“Tadā taṃ phullavipinaṃ, nānābhamarakūjitaṃ;"],"lineRefs":[[]]},{"para":1996,"vripara":null,"refs":[],"lines":["Kokilāgītasahitaṃ, mayūragaṇanaccitaṃ."],"lineRefs":[[]]},{"para":1997,"vripara":null,"refs":[],"lines":["“Appasaddamanākiṇṇaṃ, nānācaṅkamabhūsitaṃ;"],"lineRefs":[[]]},{"para":1998,"vripara":null,"refs":[],"lines":["Kuṭimaṇḍapasaṃkiṇṇaṃ, yogīvaravirājitaṃ."],"lineRefs":[[]]},{"para":1999,"vripara":null,"refs":[],"lines":["“Vicarantī amaññissaṃ, saphalaṃ nayanaṃ mama;"],"lineRefs":[[]]},{"para":2000,"vripara":null,"refs":[],"lines":["Tatthāpi taruṇaṃ bhikkhuṃ, yuttaṃ disvā vicintayiṃ."],"lineRefs":[[]]},{"para":2001,"vripara":null,"refs":[],"lines":["“Īdise vipine ramme, ṭhitoyaṃ navayobbane;"],"lineRefs":[[]]},{"para":2002,"vripara":null,"refs":[],"lines":["Vasantamiva kantena, rūpena ca samanvito."],"lineRefs":[[]]},{"para":2003,"vripara":null,"refs":[],"lines":["“Nisinno rukkhamūlamhi, muṇḍo saṅghāṭipāruto;"],"lineRefs":[[]]},{"para":2004,"vripara":null,"refs":[],"lines":["Jhāyate vatayaṃ bhikkhu, hitvā visayajaṃ ratiṃ."],"lineRefs":[[]]},{"para":2005,"vripara":null,"refs":[],"lines":["“Nanu nāma gahaṭṭhena, kāmaṃ bhutvā yathāsukhaṃ;"],"lineRefs":[[]]},{"para":2006,"vripara":null,"refs":[],"lines":["Pacchā jiṇṇena dhammoyaṃ, caritabbo subhaddako."],"lineRefs":[[]]},{"para":2007,"vripara":null,"refs":[],"lines":["“Suññakanti viditvāna, gandhagehaṃ jinālayaṃ;"],"lineRefs":[[]]},{"para":2008,"vripara":null,"refs":[],"lines":["Upetvā jinamaddakkhaṃ, udayantaṃ va bhākaraṃ."],"lineRefs":[[]]},{"para":2009,"vripara":null,"refs":[],"lines":["“Ekakaṃ sukhamāsīnaṃ, bījamānaṃ varitthiyā;"],"lineRefs":[[]]},{"para":2010,"vripara":null,"refs":[],"lines":["Disvānevaṃ vicintesiṃ, nāyaṃ lūkho narāsabho."],"lineRefs":[[]]},{"para":2011,"vripara":null,"refs":[],"lines":["“Sā kaññā kanakābhāsā, padumānanalocanā;"],"lineRefs":[[]]},{"para":2012,"vripara":null,"refs":[],"lines":["Bimboṭṭhī kundadasanā, manonettarasāyanā."],"lineRefs":[[]]},{"para":2013,"vripara":null,"refs":[],"lines":["“Hemadolābhasavanā, kalikākārasutthanī;"],"lineRefs":[[]]},{"para":2014,"vripara":null,"refs":[],"lines":["Vedimajjhāva sussoṇī, rambhoru cārubhūsanā."],"lineRefs":[[]]},{"para":2015,"vripara":null,"refs":[],"lines":["“Rattaṃsakupasaṃbyānā, nīlamaṭṭhanivāsanā;"],"lineRefs":[[]]},{"para":2016,"vripara":null,"refs":[],"lines":["Atappaneyyarūpena, hāsabhāvasamanvitā."],"lineRefs":[[]]},{"para":2017,"vripara":null,"refs":[],"lines":["“Disvā tamevaṃ cintesiṃ, ahoyamabhirūpinī;"],"lineRefs":[[]]},{"para":2018,"vripara":null,"refs":[],"lines":["Na mayānena nettena, diṭṭhapubbā kudācanaṃ."],"lineRefs":[[]]},{"para":2019,"vripara":null,"refs":[],"lines":["“Tato jarābhibhūtā sā, vivaṇṇā vikatānanā;"],"lineRefs":[[]]},{"para":2020,"vripara":null,"refs":[],"lines":["Bhinnadantā setasirā, salālā vadanāsuci."],"lineRefs":[[]]},{"para":2021,"vripara":null,"refs":[],"lines":["“Saṃkhittakaṇṇā setakkhī, lambāsubhapayodharā;"],"lineRefs":[[]]},{"para":2022,"vripara":null,"refs":[],"lines":["Valivitatasabbaṅgī, sirāvitatadehinī."],"lineRefs":[[]]},{"para":2023,"vripara":null,"refs":[],"lines":["“Nataṅgā daṇḍadutiyā, upphāsulikatā kisā;"],"lineRefs":[[]]},{"para":2024,"vripara":null,"refs":[],"lines":["Pavedhamānā patitā, nissasantī muhuṃ muhuṃ."],"lineRefs":[[]]},{"para":2025,"vripara":null,"refs":[],"lines":["“Tato me āsi saṃvego, abbhuto lomahaṃsano;"],"lineRefs":[[]]},{"para":2026,"vripara":null,"refs":[],"lines":["Dhiratthu rūpaṃ asuciṃ, ramante yattha bālisā."],"lineRefs":[[]]},{"para":2027,"vripara":null,"refs":[],"lines":["“Tadā mahākāruṇiko, disvā saṃviggamānasaṃ;"],"lineRefs":[[]]},{"para":2028,"vripara":null,"refs":[],"lines":["Udaggacitto sugato, imā gāthā abhāsatha."],"lineRefs":[[]]},{"para":2029,"vripara":null,"refs":[],"lines":["“Āturaṃ asuciṃ pūtiṃ, passa kheme samussayaṃ;"],"lineRefs":[[]]},{"para":2030,"vripara":null,"refs":[],"lines":["Uggharantaṃ paggharantaṃ, bālānaṃ abhinanditaṃ."],"lineRefs":[[]]},{"para":2031,"vripara":null,"refs":[],"lines":["“Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ;"],"lineRefs":[[]]},{"para":2032,"vripara":null,"refs":[],"lines":["Sati kāyagatā tyatthu, nibbidā bahulā bhava."],"lineRefs":[[]]},{"para":2033,"vripara":null,"refs":[],"lines":["“Yathā idaṃ tathā etaṃ, yathā etaṃ tathā idaṃ;"],"lineRefs":[[]]},{"para":2034,"vripara":null,"refs":[],"lines":["Ajjhattañca bahiddhā ca, kāye chandaṃ virājaya."],"lineRefs":[[]]},{"para":2035,"vripara":null,"refs":[],"lines":["“Animittañca bhāvehi, mānānusayamujjaha;"],"lineRefs":[[]]},{"para":2036,"vripara":null,"refs":[],"lines":["Tato mānābhisamayā, upasantā carissasi."],"lineRefs":[[]]},{"para":2037,"vripara":null,"refs":[],"lines":["“Ye rāgarattānupatanti sotaṃ, sayaṃ kataṃ makkaṭakova jālaṃ;"],"lineRefs":[[]]},{"para":2038,"vripara":null,"refs":[],"lines":["Etampi chetvāna paribbajanti, anapekkhino kāmasukhaṃ pahāya."],"lineRefs":[[]]},{"para":2039,"vripara":null,"refs":[],"lines":["“Tato kallitacittaṃ maṃ, ñatvāna narasārathi;"],"lineRefs":[[]]},{"para":2040,"vripara":null,"refs":[],"lines":["Mahānidānaṃ desesi, suttantaṃ vinayāya me."],"lineRefs":[[]]},{"para":2041,"vripara":null,"refs":[],"lines":["“Sutvā suttantaseṭṭhaṃ taṃ, pubbasaññamanussariṃ;"],"lineRefs":[[]]},{"para":2042,"vripara":null,"refs":[],"lines":["Tattha ṭhitāvahaṃ santī, dhammacakkhuṃ visodhayiṃ."],"lineRefs":[[]]},{"para":2043,"vripara":null,"refs":[],"lines":["“Nipatitvā mahesissa, pādamūlamhi tāvade;"],"lineRefs":[[]]},{"para":2044,"vripara":null,"refs":[],"lines":["Accayaṃ desanatthāya, idaṃ vacanamabraviṃ."],"lineRefs":[[]]},{"para":2045,"vripara":null,"refs":[],"lines":["“Namo te sabbadassāvi, namo te karuṇākara;"],"lineRefs":[[]]},{"para":2046,"vripara":null,"refs":[],"lines":["Namo te tiṇṇasaṃsāra, namo te amataṃ dada."],"lineRefs":[[]]},{"para":2047,"vripara":null,"refs":[],"lines":["“Diṭṭhigahanapakkhandā, kāmarāgavimohitā;"],"lineRefs":[[]]},{"para":2048,"vripara":null,"refs":[],"lines":["Tayā sammā upāyena, vinītā vinaye ratā."],"lineRefs":[[]]},{"para":2049,"vripara":null,"refs":[],"lines":["“Adassanena vibhogā, tādisānaṃ mahesinaṃ;"],"lineRefs":[[]]},{"para":2050,"vripara":null,"refs":[],"lines":["Anubhonti mahādukkhaṃ, sattā saṃsārasāgare."],"lineRefs":[[]]},{"para":2051,"vripara":null,"refs":[],"lines":["“Yadāhaṃ lokasaraṇaṃ, araṇaṃ araṇantaguṃ;"],"lineRefs":[[]]},{"para":2052,"vripara":null,"refs":[],"lines":["Nāddasāmi adūraṭṭhaṃ, desayāmi tamaccayaṃ."],"lineRefs":[[]]},{"para":2053,"vripara":null,"refs":[],"lines":["“Mahāhitaṃ varadadaṃ, ahitoti visaṅkitā;"],"lineRefs":[[]]},{"para":2054,"vripara":null,"refs":[],"lines":["Nopesiṃ rūpaniratā, desayāmi tamaccayaṃ."],"lineRefs":[[]]},{"para":2055,"vripara":null,"refs":[],"lines":["“Tadā madhuranigghoso, mahākāruṇiko jino;"],"lineRefs":[[]]},{"para":2056,"vripara":null,"refs":[],"lines":["Avoca tiṭṭha khemeti, siñcanto amatena maṃ."],"lineRefs":[[]]},{"para":2057,"vripara":null,"refs":[],"lines":["“Tadā pakamya sirasā, katvā ca naṃ padakkhiṇaṃ;"],"lineRefs":[[]]},{"para":2058,"vripara":null,"refs":[],"lines":["Gantvā disvā narapatiṃ, idaṃ vacanamabraviṃ."],"lineRefs":[[]]},{"para":2059,"vripara":null,"refs":[],"lines":["“Aho sammā upāyo te, cintitoyamarindama;"],"lineRefs":[[]]},{"para":2060,"vripara":null,"refs":[],"lines":["Vanadassanakāmāya, diṭṭho nibbānato muni."],"lineRefs":[[]]},{"para":2061,"vripara":null,"refs":[],"lines":["“Yadi te ruccate rāja, sāsane tassa tādino;"],"lineRefs":[[]]},{"para":2062,"vripara":null,"refs":[],"lines":["Pabbajissāmi rūpehaṃ, nibbinnā munivāṇinā."],"lineRefs":[[]]},{"para":2063,"vripara":null,"refs":[],"lines":["“Añjaliṃ paggahetvāna, tadāha sa mahīpati;"],"lineRefs":[[]]},{"para":2064,"vripara":null,"refs":[],"lines":["Anujānāmi te bhadde, pabbajjā tava sijjhatu."],"lineRefs":[[]]},{"para":2065,"vripara":null,"refs":[],"lines":["“Pabbajitvā tadā cāhaṃ, addhamāse upaṭṭhite;"],"lineRefs":[[]]},{"para":2066,"vripara":null,"refs":[],"lines":["Dīpodayañca bhedañca, disvā saṃviggamānasā."],"lineRefs":[[]]},{"para":2067,"vripara":null,"refs":[],"lines":["“Nibbinnā sabbasaṅkhāre, paccayākārakovidā;"],"lineRefs":[[]]},{"para":2068,"vripara":null,"refs":[],"lines":["Caturoghe atikkamma, arahattamapāpuṇiṃ."],"lineRefs":[[]]},{"para":2069,"vripara":null,"refs":[],"lines":["“Iddhīsu ca vasī āsiṃ, dibbāya sotadhātuyā;"],"lineRefs":[[]]},{"para":2070,"vripara":null,"refs":[],"lines":["Cetopariyañāṇassa, vasī cāpi bhavāmahaṃ."],"lineRefs":[[]]},{"para":2071,"vripara":null,"refs":[],"lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"],"lineRefs":[[]]},{"para":2072,"vripara":null,"refs":[],"lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."],"lineRefs":[[]]},{"para":2073,"vripara":null,"refs":[],"lines":["“Atthadhammaniruttīsa, paṭibhāne tatheva ca;"],"lineRefs":[[]]},{"para":2074,"vripara":null,"refs":[],"lines":["Parisuddhaṃ mama ñāṇaṃ, uppannaṃ buddhasāsane."],"lineRefs":[[]]},{"para":2075,"vripara":null,"refs":[],"lines":["“Kusalāhaṃ visuddhīsu, kathāvatthuvisāradā;"],"lineRefs":[[]]},{"para":2076,"vripara":null,"refs":[],"lines":["Abhidhammanayaññū ca, vasippattāmhi sāsane."],"lineRefs":[[]]},{"para":2077,"vripara":null,"refs":[],"lines":["“Tato toraṇavatthusmiṃ, raññā kosalasāminā;"],"lineRefs":[[]]},{"para":2078,"vripara":null,"refs":[],"lines":["Pucchitā nipuṇe pañhe, byākarontī yathātathaṃ."],"lineRefs":[[]]},{"para":2079,"vripara":null,"refs":[],"lines":["“Tadā sa rājā sugataṃ, upasaṅkamma pucchatha;"],"lineRefs":[[]]},{"para":2080,"vripara":null,"refs":[],"lines":["Tatheva buddho byākāsi, yathā te byākatā mayā."],"lineRefs":[[]]},{"para":2081,"vripara":null,"refs":[],"lines":["“Jino tasmiṃ guṇe tuṭṭho, etadagge ṭhapesi maṃ;"],"lineRefs":[[]]},{"para":2082,"vripara":null,"refs":[],"lines":["Mahāpaññānamaggāti, bhikkhunīnaṃ naruttamo."],"lineRefs":[[]]},{"para":2083,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti.(apa. therī 2.2.289-383);"],"lineRefs":[[]]},{"para":2084,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā phalasukhena nibbānasukhena ca viharantiyā imissā theriyā satipi aññāsaṃ khīṇāsavattherīnaṃ paññāvepullappattiyaṃ tattha pana katādhikāratāya mahāpaññābhāvo pākaṭo ahosi.","Tathā hi naṃ bhagavā jetavanamahāvihāre ariyagaṇamajjhe nisinno paṭipāṭiyā bhikkhuniyo ṭhānantare ṭhapento “etadaggaṃ, bhikkhave, mama sāvikānaṃ bhikkhunīnaṃ mahāpaññānaṃ yadidaṃ khemā”ti (a. ni.1.235-236) mahāpaññatāya aggaṭṭhāne ṭhapesi.","Taṃ ekadivasaṃ aññatarasmiṃ rukkhamūle divāvihāraṃ nisinnaṃ māro pāpimā taruṇarūpena upasaṅkamitvā kāmehi palobhento –"],"lineRefs":[[],[],[]]}]},"tika":null,"tika2":null}
