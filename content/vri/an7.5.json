{"suttaId":"an7.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[35,41],"vripara":"5"},"segments":{"an7.5:0.3":"Saṃkhittadhanasuttaṃ","an7.5:1.1":"“Sattimāni, bhikkhave, dhanāni.","an7.5:1.2":"Katamāni satta?","an7.5:1.3":"Saddhādhanaṃ, sīladhanaṃ, hirīdhanaṃ, ottappadhanaṃ, sutadhanaṃ, cāgadhanaṃ, paññādhanaṃ.","an7.5:1.4":"Imāni kho, bhikkhave, satta dhanānīti.","an7.5:2.1":"“Saddhādhanaṃ sīladhanaṃ, hirī ottappiyaṃ dhanaṃ;","an7.5:2.3":"Sutadhanañca cāgo ca, paññā ve sattamaṃ dhanaṃ.","an7.5:3.1":"“Yassa ete dhanā atthi, itthiyā purisassa vā;","an7.5:3.3":"Adaliddoti taṃ āhu, amoghaṃ tassa jīvitaṃ.","an7.5:4.1":"“Tasmā saddhañca sīlañca, pasādaṃ dhammadassanaṃ;","an7.5:4.3":"Anuyuñjetha medhāvī, saraṃ [varaṃ (ka.)] buddhāna sāsanan”ti.","an7.5:4.5":"pañcamaṃ;"},"attha":{"book":"Mp-vii","bookName":"Sattakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":796,"to":797,"paras":[{"para":796,"vripara":"1-5","refs":["an7.5:1"],"lines":["1-5. Sattakanipātassa paṭhame <b>anavaññattikāmo</b>ti abhiññātabhāvakāmo.","Tatiye <b>yoniso vicine dhamman</b>ti upāyena catusaccadhammaṃ vicināti.","<b>Paññāyatthaṃ vipassatī</b>ti sahavipassanāya maggapaññāya saccadhammaṃ vipassati.","<b>Pajjotassevā</b>ti dīpasseva.","<b>Vimokkho hoti cetaso</b>ti tassa imehi balehi samannāgatassa khīṇāsavassa dīpanibbānaṃ viya carimakacittassa vatthārammaṇehi vimokkho hoti, gataṭṭhānaṃ na paññāyati.","Catutthe <b>saddho hotī</b>tiādīni pañcakanipāte vaṇṇitāneva.","Pañcame <b>dhanānī</b>ti adāliddiyakaraṇaṭṭhena dhanāni."],"lineRefs":[["an7.5:1"],["an7.5:1"],["an7.5:1"],["an7.5:1"],["an7.5:1"],["an7.5:1"],["an7.5:1"]]},{"para":797,"vripara":null,"refs":["an7.5:1"],"lines":["Uggasuttavaṇṇanā"],"lineRefs":[["an7.5:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-vii","bookName":"Sattakanipāta-ṭīkā","vriCode":"s0403t.tik","from":796,"to":798,"paras":[{"para":796,"vripara":"1-10","refs":["an7.5:1"],"lines":["1-10. Sattakanipātassa paṭhamo vaggo uttānattho."],"lineRefs":[["an7.5:1"]]},{"para":797,"vripara":null,"refs":[],"lines":["Anusayavaggo"],"lineRefs":[[]]},{"para":798,"vripara":null,"refs":["an7.5:1"],"lines":["Puggalasuttavaṇṇanā"],"lineRefs":[["an7.5:1"]]}],"wordLinks":[]}}
