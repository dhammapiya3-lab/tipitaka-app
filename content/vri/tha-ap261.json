{"suttaId":"tha-ap261","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8364,8376],"vripara":"33"},"segments":{"tha-ap261:0.3":"Kuṭidāyakattheraapadānaṃ","tha-ap261:1.1":"“Vipinacārī sambuddho, rukkhamūle vasī tadā;","tha-ap261:1.3":"Paṇṇasālaṃ karitvāna, adāsiṃ aparājite.","tha-ap261:2.1":"“Ekanavutito kappe, yaṃ paṇṇakuṭikaṃ adaṃ;","tha-ap261:2.3":"Duggatiṃ nābhijānāmi, kuṭidānassidaṃ phalaṃ.","tha-ap261:3.1":"“Aṭṭhavīse [aṭṭhatiṃse (syā.)] ito kappe, soḷasāsiṃsu rājāno;","tha-ap261:3.3":"Sabbattha abhivassīti, vuccare cakkavattino.","tha-ap261:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap261:5.1":"Itthaṃ sudaṃ āyasmā kuṭidāyako thero imā gāthāyo abhāsitthāti.","tha-ap261:6.1":"Kuṭidāyakattherassāpadānaṃ navamaṃ."},"attha":null,"tika":null}
