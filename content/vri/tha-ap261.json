{"suttaId":"tha-ap261","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8364,8376],"vripara":"33"},"segments":{"tha-ap261:0.3":"Kuṭidāyakattheraapadānaṃ","tha-ap261:1.1":"“Vipinacārī sambuddho,","tha-ap261:1.2":"rukkhamūle vasī tadā;","tha-ap261:1.3":"Paṇṇasālaṃ karitvāna,","tha-ap261:1.4":"adāsiṃ aparājite. 34.","tha-ap261:2.1":"“Ekanavutito kappe,","tha-ap261:2.2":"yaṃ paṇṇakuṭikaṃ adaṃ;","tha-ap261:2.3":"Duggatiṃ nābhijānāmi,","tha-ap261:2.4":"kuṭidānassidaṃ phalaṃ. 35.","tha-ap261:3.1":"“Aṭṭhavīse [aṭṭhatiṃse (syā.)] ito kappe,","tha-ap261:3.2":"soḷasāsiṃsu rājāno;","tha-ap261:3.3":"Sabbattha abhivassīti,","tha-ap261:3.4":"vuccare cakkavattino. 36.","tha-ap261:4.1":"“Paṭisambhidā catasso…pe…","tha-ap261:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap261:5.1":"Itthaṃ sudaṃ āyasmā kuṭidāyako thero imā gāthāyo abhāsitthāti.","tha-ap261:6.1":"Kuṭidāyakattherassāpadānaṃ navamaṃ. 10."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
