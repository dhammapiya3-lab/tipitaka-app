{"suttaId":"sn22.104","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[722,722],"vripara":"104"},"segments":{"sn22.104:0.3":"Dukkhasuttaṃ","sn22.104:1.1":"Sāvatthinidānaṃ.","sn22.104:1.2":"“Dukkhañca vo, bhikkhave, desessāmi dukkhasamudayañca dukkhanirodhañca dukkhanirodhagāminiñca paṭipadaṃ.","sn22.104:1.3":"Taṃ suṇātha.","sn22.104:1.4":"Katamañca, bhikkhave, dukkhaṃ?","sn22.104:1.5":"Pañcupādānakkhandhātissa vacanīyaṃ.","sn22.104:1.6":"Katame pañca?","sn22.104:1.7":"Seyyathidaṃ – rūpupādānakkhandho … pe … viññāṇupādānakkhandho.","sn22.104:1.8":"Idaṃ vuccati, bhikkhave, dukkhaṃ.","sn22.104:1.9":"Katamo ca, bhikkhave, dukkhasamudayo?","sn22.104:1.10":"Yāyaṃ taṇhā ponobhavikā … pe … kāmataṇhā, bhavataṇhā, vibhavataṇhā –","sn22.104:1.11":"ayaṃ vuccati, bhikkhave, dukkhasamudayo.","sn22.104:1.12":"Katamo ca, bhikkhave, dukkhanirodho?","sn22.104:1.13":"Yo tassāyeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo –","sn22.104:1.14":"ayaṃ vuccati, bhikkhave, dukkhanirodho.","sn22.104:1.15":"Katamā ca, bhikkhave, dukkhanirodhagāminī paṭipadā?","sn22.104:1.16":"Ayameva ariyo aṭṭhaṅgiko maggo.","sn22.104:1.17":"Seyyathidaṃ – sammādiṭṭhi … pe … sammāsamādhi.","sn22.104:1.18":"Ayaṃ vuccati, bhikkhave, dukkhanirodhagāminī paṭipadā”ti.","sn22.104:1.19":"Dutiyaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":363,"to":363,"paras":[{"para":363,"vripara":"104-105","refs":["sn22.104:1"],"lines":["104-105. Dutiyampi pañcakkhandhe catusaccavasena yojetvā <b>dukkhan</b>ti bujjhanakānaṃ ajjhāsayena kathitaṃ.","Tatiyampi tatheva <b>sakkāyo</b>ti bujjhanakānaṃ ajjhāsayena kathitaṃ.","Dutiyatatiyāni."],"lineRefs":[["sn22.104:1"],["sn22.104:1"],["sn22.104:1"]]}],"wordLinks":[["sn22.104:1.2","dukkhaṃ",0,0],["sn22.104:1.4","dukkhaṃ",0,0],["sn22.104:1.8","dukkhaṃ",0,0],["sn22.104:1.9","dukkhaṃ",0,0],["sn22.104:1.10","dukkhaṃ",0,0],["sn22.104:1.12","dukkhaṃ",0,0],["sn22.104:1.13","dukkhaṃ",0,0],["sn22.104:1.15","dukkhaṃ",0,0],["sn22.104:1.18","dukkhaṃ",0,0]],"before":[{"para":362,"vripara":null,"refs":[],"lines":["2-3. Dukkhasuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":352,"to":355,"paras":[{"para":352,"vripara":"104-105","refs":["sn22.104:1"],"lines":["104-105. <b>Dutiyampī</b>ti <b>api</b> -saddo sampiṇḍanattho.","Tena na kevalaṃ paṭhamasuttameva, atha kho dutiyampīti."],"lineRefs":[["sn22.104:1"],["sn22.104:1"]]},{"para":353,"vripara":null,"refs":["sn22.104:1"],"lines":["<b>Tatiyampi tathevā</b>ti iminā “pañcakkhandhe catusaccavasena yojetvā”ti idaṃ upasaṃharati."],"lineRefs":[["sn22.104:1"]]},{"para":354,"vripara":null,"refs":["sn22.104:1"],"lines":["Dukkhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.104:1"]]},{"para":355,"vripara":null,"refs":["sn22.104:1"],"lines":["Pariññeyyasuttavaṇṇanā"],"lineRefs":[["sn22.104:1"]]}],"wordLinks":[],"before":[{"para":350,"vripara":null,"refs":[],"lines":["Antasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":351,"vripara":null,"refs":[],"lines":["2-3. Dukkhasuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
