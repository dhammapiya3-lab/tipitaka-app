{"suttaId":"pv24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[1130,1193],"vripara":"348"},"segments":{"pv24:0.3":"Kaṇṇamuṇḍapetivatthu","pv24:1.1":"“Soṇṇasopānaphalakā, soṇṇavālukasanthatā;","pv24:1.3":"Tattha sogandhiyā vaggū, sucigandhā manoramā.","pv24:2.1":"“Nānārukkhehi sañchannā, nānāgandhasameritā;","pv24:2.3":"Nānāpadumasañchannā, puṇḍarīkasamotatā [samohatā (ka.)].","pv24:3.1":"“Surabhiṃ sampavāyanti, manuññā māluteritā;","pv24:3.3":"Haṃsakoñcābhirudā ca, cakkavakkābhikūjitā.","pv24:4.1":"“Nānādijagaṇākiṇṇā, nānāsaragaṇāyutā;","pv24:4.3":"Nānāphaladharā rukkhā, nānāpupphadharā vanā.","pv24:5.1":"“Na manussesu īdisaṃ, nagaraṃ yādisaṃ idaṃ;","pv24:5.3":"Pāsādā bahukā tuyhaṃ, sovaṇṇarūpiyāmayā;","pv24:5.5":"Daddallamānā ābhenti [ābhanti (ka.)], samantā caturo disā.","pv24:6.1":"“Pañca dāsisatā tuyhaṃ, yā temā paricārikā;","pv24:6.3":"Tā [kā (ka.)] kambukāyūradharā [kambukeyūradharā (sī.)], kañcanāveḷabhūsitā.","pv24:7.1":"“Pallaṅkā bahukā tuyhaṃ, sovaṇṇarūpiyāmayā;","pv24:7.3":"Kadalimigasañchannā [kādalimigasañchannā (sī.)], sajjā gonakasanthatā.","pv24:8.1":"“Yattha tvaṃ vāsūpagatā, sabbakāmasamiddhinī;","pv24:8.3":"Sampattāyaḍḍharattāya [… rattiyā (ka.)], tato uṭṭhāya gacchasi.","pv24:9.1":"“Uyyānabhūmiṃ gantvāna, pokkharaññā samantato;","pv24:9.3":"Tassā tīre tuvaṃ ṭhāsi, harite saddale subhe.","pv24:10.1":"“Tato te kaṇṇamuṇḍo sunakho, aṅgamaṅgāni khādati;","pv24:10.3":"Yadā ca khāyitā āsi, aṭṭhisaṅkhalikā katā;","pv24:10.5":"Ogāhasi pokkharaṇiṃ, hoti kāyo yathā pure.","pv24:11.1":"“Tato tvaṃ aṅgapaccaṅgī [aṅgapaccaṅgā (ka.)], sucāru piyadassanā;","pv24:11.3":"Vatthena pārupitvāna, āyāsi mama santikaṃ.","pv24:12.1":"“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;","pv24:12.3":"Kissa kammavipākena, kaṇṇamuṇḍo sunakho tavaaṅgamaṅgāni khādatī”ti.","pv24:13.1":"“Kimilāyaṃ [kimbilāyaṃ (sī. syā.)] gahapati, saddho āsi upāsako;","pv24:13.3":"Tassāhaṃ bhariyā āsiṃ, dussīlā aticārinī.","pv24:14.1":"“So maṃ aticaramānāya [evamāticaramānāya (syā. pī.)], sāmiko etadabravi;","pv24:14.3":"‘Netaṃ channaṃ [netaṃ channaṃ na (sī.), netaṃ channaṃ netaṃ (ka.)] patirūpaṃ, yaṃ tvaṃ aticarāsi maṃ’.","pv24:15.1":"“Sāhaṃ ghorañca sapathaṃ, musāvādañca bhāsisaṃ;","pv24:15.3":"‘Nāhaṃ taṃ aticarāmi, kāyena uda cetasā.","pv24:16.1":"“‘Sacāhaṃ taṃ aticarāmi, kāyena uda cetasā;","pv24:16.3":"Kaṇṇamuṇḍo yaṃ sunakho, aṅgamaṅgāni khādatu’.","pv24:17.1":"“Tassa kammassa vipākaṃ, musāvādassa cūbhayaṃ;","pv24:17.3":"Satteva vassasatāni, anubhūtaṃ yato hi me;","pv24:17.5":"Kaṇṇamuṇḍo ca sunakho, aṅgamaṅgāni khādati.","pv24:18.1":"“Tvañca deva bahukāro, atthāya me idhāgato;","pv24:18.3":"Sumuttāhaṃ kaṇṇamuṇḍassa, asokā akutobhayā.","pv24:19.1":"“Tāhaṃ deva namassāmi, yācāmi pañjalīkatā;","pv24:19.3":"Bhuñja amānuse kāme, rama deva mayā sahā”ti.","pv24:20.1":"“Bhuttā amānusā kāmā, ramitomhi tayā saha;","pv24:20.3":"Tāhaṃ subhage yācāmi, khippaṃ paṭinayāhi man”ti.","pv24:21.1":"Kaṇṇamuṇḍapetivatthu dvādasamaṃ."},"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":1573,"to":1615,"paras":[{"para":1573,"vripara":"348","refs":["pv24:1"],"words":["soṇṇasopānaphalakā","soṇṇavālukasanthatā","tatthā","sogandhiyā","vaggū","sucigandhā"],"lines":["Tattha <b>soṇṇasopānaphalakā</b>ti suvaṇṇamayasopānaphalakā.","<b>Soṇṇavālukasanthatā</b>ti samantato suvaṇṇamayāhi vālukāhi santhatā.","<b>Tatthā</b>ti pokkharaṇiyaṃ.","<b>Sogandhiyā</b>ti sogandhikā.","<b>Vaggū</b>ti sundarā rucirā.","<b>Sucigandhā</b>ti manuññagandhā."],"lineRefs":[["pv24:1"],["pv24:1"],["pv24:1"],["pv24:1"],["pv24:1"],["pv24:1"]]},{"para":1574,"vripara":"349","refs":["pv24:2"],"words":["nānāgandhasameritā","nānāpadumasañchannā","puṇḍarīkasamotatā"],"lines":["<b>Nānāgandhasameritā</b>ti nānāvidhasurabhigandhavasena gandhavāyunā samantato eritā.","<b>Nānāpadumasañchannā</b>ti nānāvidharattapadumasañchāditasalilatalā.","<b>Puṇḍarīkasamotatā</b>ti setapadumehi ca samokiṇṇā."],"lineRefs":[["pv24:2"],["pv24:2"],["pv24:2"]]},{"para":1575,"vripara":"350","refs":["pv24:3"],"words":["surabhiṃ sampavāyantī","haṃsakoñcābhirudā"],"lines":["<b>Surabhiṃ sampavāyantī</b>ti sammadeva sugandhaṃ vāyati pokkharaṇīti adhippāyo.","<b>Haṃsakoñcābhirudā</b>ti haṃsehi ca koñcehi ca abhināditā."],"lineRefs":[["pv24:3"],["pv24:3"]]},{"para":1576,"vripara":"351","refs":["pv24:4"],"words":["nānādijagaṇākiṇṇā","nānāsaragaṇāyutā","nānāphaladharā","nānāpupphadharā vanā"],"lines":["<b>Nānādijagaṇākiṇṇā</b>ti nānādijagaṇākiṇṇā.","<b>Nānāsaragaṇāyutā</b>ti nānāvidhavihaṅgamābhirudasamūhayuttā.","<b>Nānāphaladharā</b>ti nānāvidhaphaladhārino sabbakālaṃ vividhaphalabhāranamitasākhattā.","<b>Nānāpupphadharā vanā</b>ti nānāvidhasurabhikusumadāyikāni vanānīti attho.","Liṅgavipallāsena hi “vanā”ti vuttaṃ."],"lineRefs":[["pv24:4"],["pv24:4"],["pv24:4"],["pv24:4"],["pv24:4"]]},{"para":1577,"vripara":"352","refs":["pv24:5"],"words":["na manussesu īdisaṃ nagaraṃ","daddallamānā","ābhentī","samantā caturo disā"],"lines":["<b>Na manussesu īdisaṃ nagaran</b>ti yādisaṃ tava idaṃ nagaraṃ, īdisaṃ manussesu natthi, manussaloke na upalabbhatīti attho.","<b>Rūpiyamayā</b>ti rajatamayā.","<b>Daddallamānā</b>ti ativiya virocamānā.","<b>Ābhentī</b>ti sobhayanti.","<b>Samantā caturo disā</b>ti samantato catassopi disāyo."],"lineRefs":[["pv24:5"],["pv24:5"],["pv24:5"],["pv24:5"],["pv24:5"]]},{"para":1578,"vripara":"353","refs":["pv24:6"],"words":["yā temā","paricārikā","tā","kambukāyūradharā","kañcanāveḷabhūsitā"],"lines":["<b>Yā temā</b>ti yā te imā.","<b>Paricārikā</b>ti veyyāvaccakāriniyo.","<b>Tā</b>ti tā paricārikāyo.","<b>Kambukāyūradharā</b>ti saṅkhavalayakāyūravibhūsitā.","<b>Kañcanāveḷabhūsitā</b>ti suvaṇṇavaṭaṃsakasamalaṅkatakesahatthā."],"lineRefs":[["pv24:6"],["pv24:6"],["pv24:6"],["pv24:6"],["pv24:6"]]},{"para":1579,"vripara":"354","refs":["pv24:7"],"words":["kadalimigasañchannā","sajjā","gonakasanthatā"],"lines":["<b>Kadalimigasañchannā</b>ti kadalimigacammapaccattharaṇatthatā.","<b>Sajjā</b>ti sajjitā sayituṃ yuttarūpā.","<b>Gonakasanthatā</b>ti dīghalomakena kojavena santhatā."],"lineRefs":[["pv24:7"],["pv24:7"],["pv24:7"]]},{"para":1580,"vripara":"355","refs":["pv24:8"],"words":["yatthā","vāsūpagatā","sampattāyaḍḍharattāyā","tato"],"lines":["<b>Yatthā</b>ti yasmiṃ pallaṅke.","<b>Vāsūpagatā</b>ti vāsaṃ upagatā, sayitāti attho.","<b>Sampattāyaḍḍharattāyā</b>ti aḍḍharattiyā upagatāya.","<b>Tato</b>ti pallaṅkato."],"lineRefs":[["pv24:8"],["pv24:8"],["pv24:8"],["pv24:8"]]},{"para":1581,"vripara":"356","refs":["pv24:9"],"words":["pokkharaññā","harite","saddale","subhe"],"lines":["<b>Pokkharaññā</b>ti pokkharaṇiyā.","<b>Harite</b>ti nīle.","<b>Saddale</b>ti taruṇatiṇasañchanne.","<b>Subhe</b>ti suddhe.","Subheti vā tassā ālapanaṃ.","Bhadde, samantato harite saddale tassā pokkharaṇiyā tīre tvaṃ gantvāna ṭhāsi tiṭṭhasīti yojanā."],"lineRefs":[["pv24:9"],["pv24:9"],["pv24:9"],["pv24:9"],["pv24:9"],["pv24:9"]]},{"para":1582,"vripara":"357","refs":["pv24:10"],"words":["kaṇṇamuṇḍo","khāyitā āsī","aṭṭhisaṅkhalikā katā","yathā pure"],"lines":["<b>Kaṇṇamuṇḍo</b>ti khaṇḍitakaṇṇo chinnakaṇṇo.","<b>Khāyitā āsī</b>ti khāditā ahosi.","<b>Aṭṭhisaṅkhalikā katā</b>ti aṭṭhisaṅkhalikamattā katā.","<b>Yathā pure</b>ti sunakhena khādanato pubbe viya."],"lineRefs":[["pv24:10"],["pv24:10"],["pv24:10"],["pv24:10"]]},{"para":1583,"vripara":"358","refs":["pv24:11"],"words":["tato","aṅgapaccaṅgī","sucārū","piyadassanā","āyāsī"],"lines":["<b>Tato</b>ti pokkharaṇiṃ ogāhanato pacchā.","<b>Aṅgapaccaṅgī</b>ti paripuṇṇasabbaṅgapaccaṅgavatī.","<b>Sucārū</b>ti suṭṭhu manoramā.","<b>Piyadassanā</b>ti dassanīyā.","<b>Āyāsī</b>ti āgacchasi."],"lineRefs":[["pv24:11"],["pv24:11"],["pv24:11"],["pv24:11"],["pv24:11"]]},{"para":1584,"vripara":null,"refs":[],"words":[],"lines":["Evaṃ tena raññā pucchitā sā petī ādito paṭṭhāya attano pavattiṃ tassa kathentī –"],"lineRefs":[[]]},{"para":1586,"vripara":"360","refs":[],"words":[],"lines":["“Kimilāyaṃ gahapati, saddho āsi upāsako;"],"lineRefs":[[]]},{"para":1587,"vripara":null,"refs":[],"words":[],"lines":["Tassāhaṃ bhariyā āsiṃ, dussīlā aticārinī."],"lineRefs":[[]]},{"para":1589,"vripara":"361","refs":[],"words":[],"lines":["“So maṃ aticaramānāya, sāmiko etadabravi;"],"lineRefs":[[]]},{"para":1590,"vripara":null,"refs":[],"words":[],"lines":["‘Netaṃ taṃ channaṃ patirūpaṃ, yaṃ tvaṃ aticarāsi maṃ’."],"lineRefs":[[]]},{"para":1592,"vripara":"362","refs":[],"words":[],"lines":["“Sāhaṃ ghorañca sapathaṃ, musāvādañca bhāsisaṃ;"],"lineRefs":[[]]},{"para":1593,"vripara":null,"refs":[],"words":[],"lines":["‘Nāhaṃ taṃ aticarāmi, kāyena uda cetasā."],"lineRefs":[[]]},{"para":1595,"vripara":"363","refs":[],"words":[],"lines":["“‘Sacāhaṃ taṃ aticarāmi, kāyena uda cetasā;"],"lineRefs":[[]]},{"para":1596,"vripara":null,"refs":[],"words":[],"lines":["Kaṇṇamuṇḍoyaṃ sunakho, aṅgamaṅgāni khādatu’."],"lineRefs":[[]]},{"para":1598,"vripara":"364","refs":[],"words":[],"lines":["“Tassa kammassa vipākaṃ, musāvādassa cūbhayaṃ;"],"lineRefs":[[]]},{"para":1599,"vripara":null,"refs":[],"words":[],"lines":["Satteva vassasatāni, anubhūtaṃ yato hi me;"],"lineRefs":[[]]},{"para":1600,"vripara":null,"refs":[],"words":[],"lines":["Kaṇṇamuṇḍo ca sunakho, aṅgamaṅgāni khādatī”ti.","– pañca gāthā āha;"],"lineRefs":[[],[]]},{"para":1601,"vripara":"360-361","refs":["pv24:13"],"words":["kimilāyaṃ","aticārinī","yaṃ"],"lines":["360-1. Tattha <b>kimilāyan</b>ti evaṃnāmake nagare.","<b>Aticārinī</b>ti bhariyā hi patiṃ atikkamma caraṇato “aticārinī”ti vuccati.","Aticaramānāya mayi so sāmiko maṃ etadabravīti yojanā.","<b>Netaṃ channan</b>tiādi vuttākāradassanaṃ.","Tattha <b>netaṃ channan</b>ti na etaṃ yuttaṃ.","<b>Na patirūpan</b>ti tasseva vevacanaṃ.","<b>Yan</b>ti kiriyāparāmasanaṃ.","<b>Aticarāsī</b>ti aticarasi, ayameva vā pāṭho.","Yaṃ maṃ tvaṃ aticarasi, tattha yaṃ aticaraṇaṃ, netaṃ channaṃ netaṃ patirūpanti attho."],"lineRefs":[["pv24:13"],["pv24:13"],["pv24:13"],["pv24:13"],["pv24:13"],["pv24:13"],["pv24:13"],["pv24:13"],["pv24:13"]]},{"para":1602,"vripara":"362-364","refs":["pv24:15"],"words":["ghoraṃ","sapathaṃ","bhāsisaṃ","taṃ"],"lines":["362-4. <b>Ghoran</b>ti dāruṇaṃ.","<b>Sapathan</b>ti sapanaṃ.","<b>Bhāsisan</b>ti abhāsiṃ.","<b>Sacāhan</b>ti sace ahaṃ.","<b>Tan</b>ti tvaṃ.","<b>Tassa kammassā</b>ti tassa pāpakammassa dussīlyakammassa.","<b>Musāvādassa cā</b>ti “nāhaṃ taṃ aticarāmī”ti vuttamusāvādassa ca.","<b>Ubhayan</b>ti ubhayassa vipākaṃ.","<b>Anubhūtan</b>ti anubhūyamānaṃ mayāti attho.","<b>Yato</b>ti yato pāpakammato."],"lineRefs":[["pv24:15"],["pv24:15"],["pv24:15"],["pv24:15"],["pv24:15"],["pv24:15"],["pv24:15"],["pv24:15"],["pv24:15"],["pv24:15"]]},{"para":1603,"vripara":null,"refs":[],"words":[],"lines":["Evañca pana vatvā tena attano kataṃ upakāraṃ kittentī –"],"lineRefs":[[]]},{"para":1605,"vripara":"365","refs":[],"words":[],"lines":["“Tvañca deva bahukāro, atthāya me idhāgato;"],"lineRefs":[[]]},{"para":1606,"vripara":null,"refs":[],"words":[],"lines":["Sumuttāhaṃ kaṇṇamuṇḍassa, asokā akutobhayā."],"lineRefs":[[]]},{"para":1608,"vripara":"366","refs":[],"words":[],"lines":["“Tāhaṃ deva namassāmi, yācāmi pañjalīkatā;"],"lineRefs":[[]]},{"para":1609,"vripara":null,"refs":[],"words":[],"lines":["Bhuñja amānuse kāme, rama deva mayā sahā”ti.","–"],"lineRefs":[[],[]]},{"para":1610,"vripara":null,"refs":["pv24:19"],"words":["devā","tāhaṃ  deva  namassāmī"],"lines":["Dve gāthā āha.","Tattha <b>devā</b>ti rājānaṃ ālapati.","<b>Kaṇṇamuṇḍassā</b>ti kaṇṇamuṇḍato.","Nissakke hi idaṃ sāmivacanaṃ.","Atha rājā tattha vāsena nibbinnamānaso gamanajjhāsayaṃ pakāsesi.","Taṃ sutvā petī rañño paṭibaddhacittā tatthevassa vāsaṃ yācantī <b>“tāhaṃ, deva, namassāmī”</b>ti gāthamāha."],"lineRefs":[["pv24:19"],["pv24:19"],["pv24:19"],["pv24:19"],["pv24:19"],["pv24:19"]]},{"para":1611,"vripara":null,"refs":[],"words":[],"lines":["Puna rājā ekaṃsena nagaraṃ gantukāmova hutvā attano ajjhāsayaṃ pavedento –"],"lineRefs":[[]]},{"para":1613,"vripara":"367","refs":[],"words":[],"lines":["“Bhuttā amānusā kāmā, ramitomhi tayā saha;"],"lineRefs":[[]]},{"para":1614,"vripara":null,"refs":[],"words":[],"lines":["Tāhaṃ subhage yācāmi, khippaṃ paṭinayāhi man”ti.","–"],"lineRefs":[[],[]]},{"para":1615,"vripara":null,"refs":["pv24:20"],"words":["tāhaṃ","subhage","paṭinayāhi maṃ"],"lines":["Osānagāthamāha.","Tattha <b>tāhan</b>ti taṃ ahaṃ.","<b>Subhage</b>ti subhagayutte.","<b>Paṭinayāhi man</b>ti mayhaṃ nagarameva maṃ paṭinehi.","Sesaṃ sabbattha pākaṭameva."],"lineRefs":[["pv24:20"],["pv24:20"],["pv24:20"],["pv24:20"],["pv24:20"]]}]},"tika":null}
