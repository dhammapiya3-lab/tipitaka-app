{"suttaId":"thag4.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1425,1437],"vripara":"295"},"segments":{"thag4.8:0.4":"Rāhulattheragāthā","thag4.8:1.1":"“Ubhayeneva sampanno,","thag4.8:1.2":"rāhulabhaddoti maṃ vidū;","thag4.8:1.3":"Yañcamhi putto buddhassa,","thag4.8:1.4":"yañca dhammesu cakkhumā. 296.","thag4.8:2.1":"“Yañca me āsavā khīṇā,","thag4.8:2.2":"yañca natthi punabbhavo;","thag4.8:2.3":"Arahā dakkhiṇeyyomhi,","thag4.8:2.4":"tevijjo amataddaso. 297.","thag4.8:3.1":"“Kāmandhā jālapacchannā,","thag4.8:3.2":"taṇhāchādanachāditā;","thag4.8:3.3":"Pamattabandhunā baddhā,","thag4.8:3.4":"macchāva kumināmukhe. 298.","thag4.8:4.1":"“Taṃ kāmaṃ ahamujjhitvā,","thag4.8:4.2":"chetvā mārassa bandhanaṃ;","thag4.8:4.3":"Samūlaṃ taṇhamabbuyha,","thag4.8:4.4":"sītibhūtosmi nibbuto”ti. …","thag4.8:4.5":"Rāhulo thero…. 9."},"unsure":[],"preface":[],"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":279,"to":279,"paras":[{"para":279,"vripara":null,"refs":["thag4.8:4"],"lines":["<b>Taṃ</b> tathārūpaṃ <b>kāmaṃ</b> bandhanabhūtaṃ <b>ujjhitvā</b> pubbabhāgapaṭipattiyā pahāya kilesa<b>mārassa bandhanaṃ chetvā,</b> puna ariyamaggasatthena anavasesato samucchinditvā tato eva avijjāsaṅkhātena mūlena <b>samūlaṃ,</b> kāmataṇhādikaṃ <b>taṇhaṃ abbuyha</b> uddharitvā sabbakilesadarathapariḷāhābhāvato, <b>sītibhūto</b> saupādisesāya nibbānadhātuyā nibbuto, ahaṃ <b>asmi</b> homīti attho."],"lineRefs":[["thag4.8:4"]]}],"wordLinks":[["thag4.8:4.1","kāmaṃ",0,0],["thag4.8:4.1","taṃ",0,0],["thag4.8:4.1","ujjhitvā",0,0],["thag4.8:4.3","samūlaṃ",0,0],["thag4.8:4.3","sītibhūto",0,0]],"before":[{"para":224,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Rāhulattheragāthāvaṇṇanā"]},{"para":225,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["<b>Ubhayenā</b>tiādikā āyasmato rāhulattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto padumuttarassa bhagavato kāle kulagehe nibbattitvā viññutaṃ patto satthāraṃ ekaṃ bhikkhuṃ sikkhākāmānaṃ aggaṭṭhāne ṭhapentaṃ disvā sayampi taṃ ṭhānantaraṃ patthetvā senāsanavisodhanavijjotanādikaṃ uḷāraṃ puññaṃ katvā paṇidhānamakāsi.","So tato cavitvā devamanussesu saṃsaranto imasmiṃ buddhuppāde amhākaṃ bodhisattaṃ paṭicca yasodharāya deviyā kucchimhi nibbattitvā <b>rāhulo</b>ti laddhanāmo mahatā khattiyaparivārena vaḍḍhi, tassa pabbajjāvidhānaṃ khandhake (mahāva. 105) āgatameva.","So pabbajitvā satthu santike anekehi suttapadehi suladdhovādo paripakkañāṇo vipassanaṃ ussukkāpetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.2.68-85) –"]},{"para":226,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Padumuttarassa bhagavato, lokajeṭṭhassa tādino;"]},{"para":227,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Sattabhūmamhi pāsāde, ādāsaṃ santhariṃ ahaṃ."]},{"para":228,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Khīṇāsavasahassehi, parikiṇṇo mahāmuni;"]},{"para":229,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Upāgami gandhakuṭiṃ, dvipadindo narāsabho."]},{"para":230,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Virocento gandhakuṭiṃ, devadevo narāsabho;"]},{"para":231,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Bhikkhusaṅghe ṭhito satthā, imā gāthā abhāsatha."]},{"para":232,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Yenāyaṃ jotitā seyyā, ādāsova susanthato;"]},{"para":233,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."]},{"para":234,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Soṇṇamayā rūpimayā, atho veḷuriyāmayā;"]},{"para":235,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Nibbattissanti pāsādā, ye keci manaso piyā."]},{"para":236,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Catusaṭṭhikkhattuṃ devindo, devarajjaṃ karissati;"]},{"para":237,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Sahassakkhattuṃ cakkavattī, bhavissati anantarā."]},{"para":238,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Ekavīsatikappamhi, vimalo nāma khattiyo;"]},{"para":239,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Cāturanto vijitāvī, cakkavattī bhavissati."]},{"para":240,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Nagaraṃ reṇuvatī nāma, iṭṭhakāhi sumāpitaṃ;"]},{"para":241,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Āyāmato tīṇi sataṃ, caturassasamāyutaṃ."]},{"para":242,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Sudassano nāma pāsādo, vissakammena māpito;"]},{"para":243,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Kūṭāgāravarūpeto, sattaratanabhūsito."]},{"para":244,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Dasasaddāvivittaṃ taṃ, vijjādharasamākulaṃ;"]},{"para":245,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Sudassanaṃva nagaraṃ, devatānaṃ bhavissati."]},{"para":246,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Pabhā niggacchate tassa, uggacchanteva sūriye;"]},{"para":247,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Virocessati taṃ niccaṃ, samantā aṭṭhayojanaṃ."]},{"para":248,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Kappasatasahassamhi, okkākakulasambhavo;"]},{"para":249,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Gotamo nāma gottena, satthā loke bhavissati."]},{"para":250,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Tusitā so cavitvāna, sukkamūlena codito;"]},{"para":251,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Gotamassa bhagavato, atrajo so bhavissati."]},{"para":252,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Sacevaseyya agāraṃ, cakkavattī bhaveyya so;"]},{"para":253,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Aṭṭhānametaṃ yaṃ tādī, agāre ratimajjhagā."]},{"para":254,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Nikkhamitvā agāramhā, pabbajissati subbato;"]},{"para":255,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Rāhulo nāma nāmena, arahā so bhavissati."]},{"para":256,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Kikīva aṇḍaṃ rakkheyya, cāmarī viya vāladhiṃ;"]},{"para":257,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Nipako sīlasampanno, mamaṃ rakkhi mahāmuni."]},{"para":258,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Tassāhaṃ dhammamaññāya, vihāsiṃ sāsane rato;"]},{"para":259,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Sabbāsave pariññāya, viharāmi anāsavo."]},{"para":260,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ…pe… kataṃ buddhassa sāsana”nti."]},{"para":261,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Arahattaṃ pana patvā attano paṭipattiṃ paccavekkhitvā aññaṃ byākaronto – 295."]},{"para":263,"vripara":"295","title":"Rāhulattheragāthāvaṇṇanā","lines":["“Ubhayeneva sampanno, rāhulabhaddoti maṃ vidū;"]},{"para":264,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Yañcamhi putto buddhassa, yañca dhammesu cakkhumā. 296."]},{"para":266,"vripara":"296","title":"Rāhulattheragāthāvaṇṇanā","lines":["“Yañca me āsavā khīṇā, yañca natthi punabbhavo;"]},{"para":267,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Arahā dakkhiṇeyyomhi, tevijjo amataddaso. 297."]},{"para":269,"vripara":"297","title":"Rāhulattheragāthāvaṇṇanā","lines":["“Kāmandhā jālapacchannā, taṇhāchadanachāditā;"]},{"para":270,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Pamattabandhunā baddhā, macchāva kumināmukhe. 298."]},{"para":272,"vripara":"298","title":"Rāhulattheragāthāvaṇṇanā","lines":["“Taṃ kāmaṃ ahamujjhitvā, chetvā mārassa bandhanaṃ;"]},{"para":273,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Samūlaṃ taṇhamabbuyha, sītibhūtosmi nibbuto”ti. –"]},{"para":274,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Catasso gāthā abhāsi."]},{"para":275,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Tattha <b>ubhayeneva sampanno</b>ti jātisampadā, paṭipattisampadāti ubhayasampattiyāpi sampanno samannāgato.","<b>Rāhulabhaddoti maṃ vidū</b>ti “rāhulabhaddo”ti maṃ sabrahmacārino sañjānanti.","Tassa hi jātasāsanaṃ sutvā bodhisattena “rāhu jāto, bandhanaṃ jāta”nti vuttavacanaṃ upādāya suddhodanamahārājā “rāhulo”ti nāmaṃ gaṇhi.","Tattha ādito pitarā vuttapariyāyameva gahetvā āha –","“rāhulabhaddoti maṃ vidū”ti.","<b>Bhaddo</b>ti ca pasaṃsāvacanametaṃ."]},{"para":276,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Idāni taṃ ubhayasampattiṃ dassetuṃ <b>“yañcamhī”</b>tiādi vuttaṃ.","Tattha <b>ya</b>nti yasmā.","<b>Ca</b>-saddo samuccayattho.","<b>Amhi putto buddhassā</b>ti sammāsambuddhassa orasaputto amhi.","<b>Dhammesū</b>ti lokiyesu lokuttaresu ca dhammesu, catusaccadhammesūti attho.","<b>Cakkhumā</b>ti maggapaññācakkhunā cakkhumā ca amhīti yojetabbaṃ."]},{"para":277,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Puna aparāparehipi pariyāyehi attani ubhayasampattiṃ dassetuṃ –","<b>“yañca me āsavā khīṇā”</b>ti gāthamāha.","Tattha <b>dakkhiṇeyyo</b>ti dakkhiṇāraho.","<b>Amataddaso</b>ti nibbānassa dassāvī.","Sesaṃ suviññeyyameva."]},{"para":278,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Idāni yāya vijjāsampattiyā ca vimuttisampattiyā ca abhāvena sattakāyo kumine bandhamacchā viya saṃsāre parivattati, taṃ ubhayasampattiṃ attani dassetuṃ <b>“kāmandhā”</b>ti gāthādvayamāha.","Tattha kāmehi kāmesu vā andhāti <b>kāmandhā</b>.","“Chando rāgo”tiādivibhāgehi (cūḷani. ajitamāṇavapucchāniddesa 8) kilesakāmehi rūpādīsu vatthukāmesu anādīnavadassitāya andhīkatā.","<b>Jālapacchannā</b>ti sakalaṃ bhavattayaṃ ajjhottharitvā ṭhitena visattikājālena pakārato channā paliguṇṭhitā.","<b>Taṇhāchadanachāditā</b>ti tato eva taṇhāsaṅkhātena chadanena chāditā nivutā sabbaso paṭikujjitā.","<b>Pamattabandhunā baddhā, macchāva kumināmukhe</b>ti kumināmukhe macchabandhānaṃ macchapasibbakamukhe baddhā macchā viya pamattabandhunā mārena yena kāmabandhanena baddhā ime sattā tato na nigacchanti antobandhanagatāva honti."]}],"after":[{"para":280,"vripara":null,"title":"Rāhulattheragāthāvaṇṇanā","lines":["Rāhulattheragāthāvaṇṇanā niṭṭhitā. 9."]}]},"tika":null,"tika2":null}
