{"suttaId":"thag4.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1425,1437],"vripara":"295"},"segments":{"thag4.8:0.4":"Rāhulattheragāthā","thag4.8:1.1":"“Ubhayeneva sampanno, rāhulabhaddoti maṃ vidū;","thag4.8:1.3":"Yañcamhi putto buddhassa, yañca dhammesu cakkhumā.","thag4.8:2.1":"“Yañca me āsavā khīṇā, yañca natthi punabbhavo;","thag4.8:2.3":"Arahā dakkhiṇeyyomhi, tevijjo amataddaso.","thag4.8:3.1":"“Kāmandhā jālapacchannā, taṇhāchādanachāditā;","thag4.8:3.3":"Pamattabandhunā baddhā, macchāva kumināmukhe.","thag4.8:4.1":"“Taṃ kāmaṃ ahamujjhitvā, chetvā mārassa bandhanaṃ;","thag4.8:4.3":"Samūlaṃ taṇhamabbuyha, sītibhūtosmi nibbuto”ti.","thag4.8:4.5":"… Rāhulo thero …."},"attha":{"book":"Th-a-ii","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a2.att","from":279,"to":279,"paras":[{"para":279,"vripara":null,"refs":["thag4.8:4"],"lines":["<b>Taṃ</b> tathārūpaṃ <b>kāmaṃ</b> bandhanabhūtaṃ <b>ujjhitvā</b> pubbabhāgapaṭipattiyā pahāya kilesa <b>mārassa bandhanaṃ chetvā,</b> puna ariyamaggasatthena anavasesato samucchinditvā tato eva avijjāsaṅkhātena mūlena <b>samūlaṃ,</b> kāmataṇhādikaṃ <b>taṇhaṃ abbuyha</b> uddharitvā sabbakilesadarathapariḷāhābhāvato, <b>sītibhūto</b> saupādisesāya nibbānadhātuyā nibbuto, ahaṃ <b>asmi</b> homīti attho."],"lineRefs":[["thag4.8:4"]]}],"wordLinks":[["thag4.8:4.1","kāmaṃ",0,0],["thag4.8:4.1","taṃ",0,0],["thag4.8:4.1","ujjhitvā",0,0],["thag4.8:4.3","samūlaṃ",0,0],["thag4.8:4.3","sītibhūto",0,0]],"before":[{"para":222,"vripara":null,"refs":[],"lines":["Sesagāthādvayassa vuttavipariyāyena attho veditabbo.","Keci panettha –","“tarati dandhaye” tipadānaṃ atthabhāvena bhāvanācittassa paggahaniggahe uddharanti.","Taṃ pacchimagāthāsu yujjati.","Purimā hi dve gāthā pabbajitakālato paṭṭhāya caritabbaṃ samaṇadhammaṃ akatvā kukkuccapakatatāya dasa vatthūni dīpetvā saṅghena nikkaḍḍhite vajjiputtake sandhāya therena vuttā.","Pacchimā pana attasadise sammā paṭipanne sakatthaṃ nipphādetvā ṭhiteti."],"lineRefs":[[],[],[],[],[],[]]},{"para":223,"vripara":null,"refs":[],"lines":["Sambhūtattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":224,"vripara":null,"refs":[],"lines":["Rāhulattheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":225,"vripara":null,"refs":[],"lines":["<b>Ubhayenā</b>tiādikā āyasmato rāhulattherassa gāthā.","Kā uppatti?","Ayampi purimabuddhesu katādhikāro tattha tattha bhave puññāni upacinanto padumuttarassa bhagavato kāle kulagehe nibbattitvā viññutaṃ patto satthāraṃ ekaṃ bhikkhuṃ sikkhākāmānaṃ aggaṭṭhāne ṭhapentaṃ disvā sayampi taṃ ṭhānantaraṃ patthetvā senāsanavisodhanavijjotanādikaṃ uḷāraṃ puññaṃ katvā paṇidhānamakāsi.","So tato cavitvā devamanussesu saṃsaranto imasmiṃ buddhuppāde amhākaṃ bodhisattaṃ paṭicca yasodharāya deviyā kucchimhi nibbattitvā <b>rāhulo</b>ti laddhanāmo mahatā khattiyaparivārena vaḍḍhi, tassa pabbajjāvidhānaṃ khandhake (mahāva.105) āgatameva.","So pabbajitvā satthu santike anekehi suttapadehi suladdhovādo paripakkañāṇo vipassanaṃ ussukkāpetvā arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.2.68-85)–"],"lineRefs":[[],[],[],[],[],[]]},{"para":226,"vripara":null,"refs":[],"lines":["“Padumuttarassa bhagavato, lokajeṭṭhassa tādino;"],"lineRefs":[[]]},{"para":227,"vripara":null,"refs":[],"lines":["Sattabhūmamhi pāsāde, ādāsaṃ santhariṃ ahaṃ."],"lineRefs":[[]]},{"para":228,"vripara":null,"refs":[],"lines":["“Khīṇāsavasahassehi, parikiṇṇo mahāmuni;"],"lineRefs":[[]]},{"para":229,"vripara":null,"refs":[],"lines":["Upāgami gandhakuṭiṃ, dvipadindo narāsabho."],"lineRefs":[[]]},{"para":230,"vripara":null,"refs":[],"lines":["“Virocento gandhakuṭiṃ, devadevo narāsabho;"],"lineRefs":[[]]},{"para":231,"vripara":null,"refs":[],"lines":["Bhikkhusaṅghe ṭhito satthā, imā gāthā abhāsatha."],"lineRefs":[[]]},{"para":232,"vripara":null,"refs":[],"lines":["“Yenāyaṃ jotitā seyyā, ādāsova susanthato;"],"lineRefs":[[]]},{"para":233,"vripara":null,"refs":[],"lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."],"lineRefs":[[]]},{"para":234,"vripara":null,"refs":[],"lines":["“Soṇṇamayā rūpimayā, atho veḷuriyāmayā;"],"lineRefs":[[]]},{"para":235,"vripara":null,"refs":[],"lines":["Nibbattissanti pāsādā, ye keci manaso piyā."],"lineRefs":[[]]},{"para":236,"vripara":null,"refs":[],"lines":["“Catusaṭṭhikkhattuṃ devindo, devarajjaṃ karissati;"],"lineRefs":[[]]},{"para":237,"vripara":null,"refs":[],"lines":["Sahassakkhattuṃ cakkavattī, bhavissati anantarā."],"lineRefs":[[]]},{"para":238,"vripara":null,"refs":[],"lines":["“Ekavīsatikappamhi, vimalo nāma khattiyo;"],"lineRefs":[[]]},{"para":239,"vripara":null,"refs":[],"lines":["Cāturanto vijitāvī, cakkavattī bhavissati."],"lineRefs":[[]]},{"para":240,"vripara":null,"refs":[],"lines":["“Nagaraṃ reṇuvatī nāma, iṭṭhakāhi sumāpitaṃ;"],"lineRefs":[[]]},{"para":241,"vripara":null,"refs":[],"lines":["Āyāmato tīṇi sataṃ, caturassasamāyutaṃ."],"lineRefs":[[]]},{"para":242,"vripara":null,"refs":[],"lines":["“Sudassano nāma pāsādo, vissakammena māpito;"],"lineRefs":[[]]},{"para":243,"vripara":null,"refs":[],"lines":["Kūṭāgāravarūpeto, sattaratanabhūsito."],"lineRefs":[[]]},{"para":244,"vripara":null,"refs":[],"lines":["“Dasasaddāvivittaṃ taṃ, vijjādharasamākulaṃ;"],"lineRefs":[[]]},{"para":245,"vripara":null,"refs":[],"lines":["Sudassanaṃva nagaraṃ, devatānaṃ bhavissati."],"lineRefs":[[]]},{"para":246,"vripara":null,"refs":[],"lines":["“Pabhā niggacchate tassa, uggacchanteva sūriye;"],"lineRefs":[[]]},{"para":247,"vripara":null,"refs":[],"lines":["Virocessati taṃ niccaṃ, samantā aṭṭhayojanaṃ."],"lineRefs":[[]]},{"para":248,"vripara":null,"refs":[],"lines":["“Kappasatasahassamhi, okkākakulasambhavo;"],"lineRefs":[[]]},{"para":249,"vripara":null,"refs":[],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[[]]},{"para":250,"vripara":null,"refs":[],"lines":["“Tusitā so cavitvāna, sukkamūlena codito;"],"lineRefs":[[]]},{"para":251,"vripara":null,"refs":[],"lines":["Gotamassa bhagavato, atrajo so bhavissati."],"lineRefs":[[]]},{"para":252,"vripara":null,"refs":[],"lines":["“Sacevaseyya agāraṃ, cakkavattī bhaveyya so;"],"lineRefs":[[]]},{"para":253,"vripara":null,"refs":[],"lines":["Aṭṭhānametaṃ yaṃ tādī, agāre ratimajjhagā."],"lineRefs":[[]]},{"para":254,"vripara":null,"refs":[],"lines":["“Nikkhamitvā agāramhā, pabbajissati subbato;"],"lineRefs":[[]]},{"para":255,"vripara":null,"refs":[],"lines":["Rāhulo nāma nāmena, arahā so bhavissati."],"lineRefs":[[]]},{"para":256,"vripara":null,"refs":[],"lines":["“Kikīva aṇḍaṃ rakkheyya, cāmarī viya vāladhiṃ;"],"lineRefs":[[]]},{"para":257,"vripara":null,"refs":[],"lines":["Nipako sīlasampanno, mamaṃ rakkhi mahāmuni."],"lineRefs":[[]]},{"para":258,"vripara":null,"refs":[],"lines":["“Tassāhaṃ dhammamaññāya, vihāsiṃ sāsane rato;"],"lineRefs":[[]]},{"para":259,"vripara":null,"refs":[],"lines":["Sabbāsave pariññāya, viharāmi anāsavo."],"lineRefs":[[]]},{"para":260,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":261,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā attano paṭipattiṃ paccavekkhitvā aññaṃ byākaronto –"],"lineRefs":[[]]},{"para":263,"vripara":"295","refs":[],"lines":["“Ubhayeneva sampanno, rāhulabhaddoti maṃ vidū;"],"lineRefs":[[]]},{"para":264,"vripara":null,"refs":[],"lines":["Yañcamhi putto buddhassa, yañca dhammesu cakkhumā."],"lineRefs":[[]]},{"para":266,"vripara":"296","refs":[],"lines":["“Yañca me āsavā khīṇā, yañca natthi punabbhavo;"],"lineRefs":[[]]},{"para":267,"vripara":null,"refs":[],"lines":["Arahā dakkhiṇeyyomhi, tevijjo amataddaso."],"lineRefs":[[]]},{"para":269,"vripara":"297","refs":[],"lines":["“Kāmandhā jālapacchannā, taṇhāchadanachāditā;"],"lineRefs":[[]]},{"para":270,"vripara":null,"refs":[],"lines":["Pamattabandhunā baddhā, macchāva kumināmukhe."],"lineRefs":[[]]},{"para":272,"vripara":"298","refs":[],"lines":["“Taṃ kāmaṃ ahamujjhitvā, chetvā mārassa bandhanaṃ;"],"lineRefs":[[]]},{"para":273,"vripara":null,"refs":[],"lines":["Samūlaṃ taṇhamabbuyha, sītibhūtosmi nibbuto”ti.","–"],"lineRefs":[[],[]]},{"para":274,"vripara":null,"refs":[],"lines":["Catasso gāthā abhāsi."],"lineRefs":[[]]},{"para":275,"vripara":null,"refs":[],"lines":["Tattha <b>ubhayeneva sampanno</b>ti jātisampadā, paṭipattisampadāti ubhayasampattiyāpi sampanno samannāgato.","<b>Rāhulabhaddoti maṃ vidū</b>ti “rāhulabhaddo”ti maṃ sabrahmacārino sañjānanti.","Tassa hi jātasāsanaṃ sutvā bodhisattena “rāhu jāto, bandhanaṃ jātan”ti vuttavacanaṃ upādāya suddhodanamahārājā “rāhulo”ti nāmaṃ gaṇhi.","Tattha ādito pitarā vuttapariyāyameva gahetvā āha –","“rāhulabhaddoti maṃ vidū”ti.","<b>Bhaddo</b>ti ca pasaṃsāvacanametaṃ."],"lineRefs":[[],[],[],[],[],[]]},{"para":276,"vripara":null,"refs":[],"lines":["Idāni taṃ ubhayasampattiṃ dassetuṃ <b>“yañcamhī”</b>tiādi vuttaṃ.","Tattha <b>yan</b>ti yasmā.","<b>Ca</b> -saddo samuccayattho.","<b>Amhi putto buddhassā</b>ti sammāsambuddhassa orasaputto amhi.","<b>Dhammesū</b>ti lokiyesu lokuttaresu ca dhammesu, catusaccadhammesūti attho.","<b>Cakkhumā</b>ti maggapaññācakkhunā cakkhumā ca amhīti yojetabbaṃ."],"lineRefs":[[],[],[],[],[],[]]},{"para":277,"vripara":null,"refs":[],"lines":["Puna aparāparehipi pariyāyehi attani ubhayasampattiṃ dassetuṃ –","<b>“yañca me āsavā khīṇā”</b>ti gāthamāha.","Tattha <b>dakkhiṇeyyo</b>ti dakkhiṇāraho.","<b>Amataddaso</b>ti nibbānassa dassāvī.","Sesaṃ suviññeyyameva."],"lineRefs":[[],[],[],[],[]]},{"para":278,"vripara":null,"refs":[],"lines":["Idāni yāya vijjāsampattiyā ca vimuttisampattiyā ca abhāvena sattakāyo kumine bandhamacchā viya saṃsāre parivattati, taṃ ubhayasampattiṃ attani dassetuṃ <b>“kāmandhā”</b>ti gāthādvayamāha.","Tattha kāmehi kāmesu vā andhāti <b>kāmandhā</b>.","“Chando rāgo”tiādivibhāgehi (cūḷani. ajitamāṇavapucchāniddesa 8) kilesakāmehi rūpādīsu vatthukāmesu anādīnavadassitāya andhīkatā.","<b>Jālapacchannā</b>ti sakalaṃ bhavattayaṃ ajjhottharitvā ṭhitena visattikājālena pakārato channā paliguṇṭhitā.","<b>Taṇhāchadanachāditā</b>ti tato eva taṇhāsaṅkhātena chadanena chāditā nivutā sabbaso paṭikujjitā.","<b>Pamattabandhunā baddhā, macchāva kumināmukhe</b>ti kumināmukhe macchabandhānaṃ macchapasibbakamukhe baddhā macchā viya pamattabandhunā mārena yena kāmabandhanena baddhā ime sattā tato na nigacchanti antobandhanagatāva honti."],"lineRefs":[[],[],[],[],[],[]]}]},"tika":null,"tika2":null}
