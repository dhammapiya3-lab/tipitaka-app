{"suttaId":"sn36.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1289,1294],"vripara":"253"},"segments":{"sn36.5:0.3":"Daṭṭhabbasuttaṃ","sn36.5:1.1":"“Tisso imā, bhikkhave, vedanā.","sn36.5:1.2":"Katamā tisso?","sn36.5:1.3":"Sukhā vedanā, dukkhā vedanā, adukkhamasukhā vedanā.","sn36.5:1.4":"Sukhā, bhikkhave, vedanā dukkhato daṭṭhabbā, dukkhā vedanā sallato daṭṭhabbā, adukkhamasukhā vedanā aniccato daṭṭhabbā.","sn36.5:1.5":"Yato kho, bhikkhave, bhikkhuno sukhā vedanā dukkhato diṭṭhā hoti, dukkhā vedanā sallato diṭṭhā hoti, adukkhamasukhā vedanā aniccato diṭṭhā hoti –","sn36.5:1.6":"ayaṃ vuccati, bhikkhave,‘bhikkhu sammaddaso acchecchi taṇhaṃ, vivattayi saṃyojanaṃ, sammā mānābhisamayā antamakāsi dukkhassā’”ti.","sn36.5:2.1":"“Yo sukhaṃ dukkhato adda,","sn36.5:2.2":"dukkhamaddakkhi sallato;","sn36.5:2.3":"Adukkhamasukhaṃ santaṃ,","sn36.5:2.4":"addakkhi naṃ aniccato.","sn36.5:3.1":"“Sa ve sammaddaso bhikkhu,","sn36.5:3.2":"parijānāti vedanā;","sn36.5:3.3":"So vedanā pariññāya,","sn36.5:3.4":"diṭṭhe dhamme anāsavo;","sn36.5:3.5":"Kāyassa bhedā dhammaṭṭho,","sn36.5:3.6":"saṅkhyaṃ nopeti vedagū”ti.","sn36.5:3.7":"pañcamaṃ;"},"unsure":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":606,"to":606,"paras":[{"para":606,"vripara":"253","refs":["sn36.5:1","sn36.5:2"],"lines":["Pañcame <b>dukkhato daṭṭhabbā</b>ti vipariṇāmanavasena dukkhato daṭṭhabbā.","<b>Sallato</b>ti dukkhāpanavinivijjhanaṭṭhena sallāti daṭṭhabbā.","<b>Aniccato</b>ti adukkhamasukhā hutvā abhāvākārena aniccato daṭṭhabbā.","<b>Addā</b>ti addasa.","<b>Santan</b>ti santasabhāvaṃ."],"lineRefs":[["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:2"]]}],"wordLinks":[["sn36.5:1.4","dukkhato daṭṭhabbā",0,0],["sn36.5:1.4","sallato",0,1],["sn36.5:1.5","sallato",0,1],["sn36.5:1.4","aniccato",0,2],["sn36.5:1.5","aniccato",0,2],["sn36.5:1.5","addā",0,3],["sn36.5:2.3","santaṃ",0,4]],"before":[{"para":605,"vripara":null,"refs":[],"lines":["Daṭṭhabbasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":503,"to":503,"paras":[{"para":503,"vripara":"253","refs":["sn36.5:1"],"lines":["<b>Vipariṇāmanavasena dukkhato daṭṭhabbā</b>ti kiñcāpi sukhā, pariṇāmadukkhatā pana sukhavedanāya ekantikāti.","<b>Vinivijjhanaṭṭhenā</b>ti pīḷanavasena attabhāvassa vijjhanaṭṭhena.","<b>Hutvā</b>ti paccayasamāgamena uppajjitvā.","Tena pākabhāvapubbako attalābho vutto.","<b>Abhāvākārenā</b>ti bhaṅgupagamanākārena.","Tena viddhaṃsabhāvo vutto.","Ubhayena udayabbayaparicchinnatāya sikhappattaṃ aniccataṃ dasseti.","Svāyaṃ hutvā abhāvākāro itarāsupi vedanāsu labbhateva, adhiko ca pana dvinnaṃ dukkhasabhāvo.","Dukkhatāvasena purimānaṃ vedanānaṃ daṭṭhabbatāya dassitattā pacchimāya vedanāya evaṃ daṭṭhabbatā dassitā.","<b>Addā</b>ti ñāṇagatiyā sacchikatvā adakkhi.","Ñāṇagamanañhetaṃ, yadidaṃ dukkhato dassanaṃ.","<b>Santasabhāvaṃ</b> sukhadukkhato upasantarūpattā."],"lineRefs":[["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:1"],["sn36.5:1"]]}],"wordLinks":[["sn36.5:1.5","addā",0,9]],"before":[{"para":500,"vripara":null,"refs":[],"lines":["<b>Na patiṭṭhāsī</b>ti patiṭṭhaṃ na labhi.","<b>Anibaddhan</b>ti anibandhanatthaṃ yaṃkiñci.","<b>Dubbalañāṇo</b>ti ñāṇabalarahito.","“Assutavā puthujjano”ti vatvā “sutavā ariyasāvako”ti vuttattā <b>“sotāpanno dhuran”</b>ti vuttaṃ.","Itaresu ariyasāvakesu vattabbameva natthi.","Tesañhi vedanā supariññātā.","<b>Balavavipassako … pe … yogāvacaropi vaṭṭati</b> mattaso vedanānaṃ pariññātattā."],"lineRefs":[[],[],[],[],[],[],[]]},{"para":501,"vripara":null,"refs":[],"lines":["Pātālasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":502,"vripara":null,"refs":[],"lines":["Daṭṭhabbasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
