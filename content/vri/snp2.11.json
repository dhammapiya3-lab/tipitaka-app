{"suttaId":"snp2.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[1152,1177],"vripara":"337"},"segments":{"snp2.11:0.2":"Rāhulasuttaṃ","snp2.11:1.1":"“Kacci abhiṇhasaṃvāsā, nāvajānāsi paṇḍitaṃ;","snp2.11:1.3":"Ukkādhāro [okkādhāro (syā. ka.)] manussānaṃ, kacci apacito tayā”[tava (sī. aṭṭha.)].","snp2.11:2.1":"“Nāhaṃ abhiṇhasaṃvāsā, avajānāmi paṇḍitaṃ;","snp2.11:2.3":"Ukkādhāro manussānaṃ, niccaṃ apacito mayā”.","snp2.11:3.1":"“Pañca kāmaguṇe hitvā, piyarūpe manorame;","snp2.11:3.3":"Saddhāya gharā nikkhamma, dukkhassantakaro bhava.","snp2.11:4.1":"“Mitte bhajassu kalyāṇe, pantañca sayanāsanaṃ;","snp2.11:4.3":"Vivittaṃ appanigghosaṃ, mattaññū hohi bhojane.","snp2.11:5.1":"“Cīvare piṇḍapāte ca, paccaye sayanāsane;","snp2.11:5.3":"Etesu taṇhaṃ mākāsi, mā lokaṃ punarāgami.","snp2.11:6.1":"“Saṃvuto pātimokkhasmiṃ, indriyesu ca pañcasu;","snp2.11:6.3":"Sati kāyagatātyatthu, nibbidābahulo bhava.","snp2.11:7.1":"“Nimittaṃ parivajjehi, subhaṃ rāgūpasañhitaṃ;","snp2.11:7.3":"Asubhāya cittaṃ bhāvehi, ekaggaṃ susamāhitaṃ.","snp2.11:8.1":"“Animittañca bhāvehi, mānānusayamujjaha;","snp2.11:8.3":"Tato mānābhisamayā, upasanto carissatī”ti.","snp2.11:9.1":"Itthaṃ sudaṃ bhagavā āyasmantaṃ rāhulaṃ imāhi gāthāhi abhiṇhaṃ ovadatīti.","snp2.11:9.2":"Rāhulasuttaṃ ekādasamaṃ niṭṭhitaṃ."},"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":1533,"to":1533,"paras":[{"para":1533,"vripara":"344","refs":["snp2.11:8"],"words":["nimittaṃ"],"lines":["Ettāvatā nibbedhabhāgiyaṃ upacārabhūmiṃ dassetvā idāni appanābhūmiṃ dassento <b>“nimittaṃ parivajjehī”</b>tiādimāha.","Tattha <b>nimittan</b>ti rāgaṭṭhāniyaṃ subhanimittaṃ.","Teneva naṃ parato visesento āha –","<b>“subhaṃ rāgūpasañhitan”</b>ti.","<b>Parivajjehī</b>ti amanasikārena pariccajāhi.","<b>Asubhāya cittaṃ bhāvehī</b>ti yathā saviññāṇake aviññāṇake vā kāye asubhabhāvanā sampajjati, evaṃ cittaṃ bhāvehi.","<b>Ekaggaṃ susamāhitan</b>ti upacārasamādhinā ekaggaṃ, appanāsamādhinā susamāhitaṃ.","Yathā te īdisaṃ cittaṃ hoti, tathā naṃ bhāvehīti attho."],"lineRefs":[["snp2.11:8"],["snp2.11:8"],["snp2.11:8"],["snp2.11:8"],["snp2.11:8"],["snp2.11:8"],["snp2.11:8"],["snp2.11:8"]]}]},"tika":null}
