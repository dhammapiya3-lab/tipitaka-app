{"suttaId":"an4.59","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[680,686],"vripara":"59"},"segments":{"an4.59:0.3":"Bhojanasuttaṃ","an4.59:1.1":"“Bhojanaṃ, bhikkhave, dadamāno dāyako paṭiggāhakānaṃ cattāri ṭhānāni deti.","an4.59:1.2":"Katamāni cattāri?","an4.59:1.3":"Āyuṃ deti, vaṇṇaṃ deti, sukhaṃ deti, balaṃ deti.","an4.59:1.4":"Āyuṃ kho pana datvā āyussa bhāgī hoti dibbassa vā mānusassa vā.","an4.59:1.5":"Vaṇṇaṃ datvā … sukhaṃ datvā … balaṃ datvā balassa bhāgī hoti dibbassa vā mānusassa vā.","an4.59:1.6":"Bhojanaṃ, bhikkhave, dadamāno dāyako paṭiggāhakānaṃ imāni cattāri ṭhānāni detī”ti.","an4.59:2.1":"[mahāva.282]“Yo saññatānaṃ paradattabhojinaṃ,","an4.59:2.2":"Kālena sakkacca dadāti bhojanaṃ;","an4.59:2.3":"Cattāri ṭhānāni anuppavecchati,","an4.59:2.4":"Āyuñca vaṇṇañca sukhaṃ balañca.","an4.59:3.1":"“So āyudāyī vaṇṇadāyī,","an4.59:3.2":"sukhaṃ balaṃ dado naro;","an4.59:3.3":"Dīghāyu yasavā hoti,","an4.59:3.4":"yattha yatthūpapajjatī”ti.","an4.59:3.5":"navamaṃ;"},"unsure":[],"attha":null,"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1454,"to":1458,"paras":[{"para":1454,"vripara":"57-60","refs":["an4.59:1"],"lines":["57-60. Sattame <b>āyubhāgapaṭilābhinī hotī</b>ti āyukoṭṭhāsassa paṭilābhinī hoti.","<b>Tividhalokan</b>ti sattasaṅkhārabhājanasaṅkhātaṃ tividhaṃ lokaṃ.","<b>Viditaṃ katvā</b>ti vibhūtaṃ katvā.","<b>Lokavidūnan</b>ti karaṇatthe sāmivacananti āha <b>“buddhehi pasatthā”</b>ti.","Aṭṭhamanavamadasamāni uttānatthāneva."],"lineRefs":[["an4.59:1"],["an4.59:1"],["an4.59:1"],["an4.59:1"],["an4.59:1"]]},{"para":1455,"vripara":null,"refs":["an4.59:1"],"lines":["Suppavāsāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an4.59:1"]]},{"para":1456,"vripara":null,"refs":["an4.59:1"],"lines":["Puññābhisandavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an4.59:1"]]},{"para":1457,"vripara":null,"refs":["an4.59:1"],"lines":["(7)2. Pattakammavaggo"],"lineRefs":[["an4.59:1"]]},{"para":1458,"vripara":null,"refs":["an4.59:1"],"lines":["1-4. Pattakammasuttādivaṇṇanā"],"lineRefs":[["an4.59:1"]]}],"wordLinks":[]},"tika2":null}
