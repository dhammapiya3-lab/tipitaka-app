{"suttaId":"ja507","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[9018,9111],"vripara":"284"},"segments":{"ja507:0.4":"Mahāpalobhanajātakaṃ (11)","ja507:1.1":"Brahmalokā cavitvāna,","ja507:1.2":"devaputto mahiddhiko;","ja507:1.3":"Rañño putto udapādi,","ja507:1.4":"sabbakāmasamiddhisu. 285.","ja507:2.1":"Kāmā vā kāmasaññā vā,","ja507:2.2":"brahmaloke na vijjati;","ja507:2.3":"Svāssu [yvāssa (sī.)] tāyeva saññāya,","ja507:2.4":"kāmehi vijigucchatha. 286.","ja507:3.1":"Tassa cantepure āsi,","ja507:3.2":"jhānāgāraṃ sumāpitaṃ;","ja507:3.3":"So tattha paṭisallīno [paṭisallāno (ka.)],","ja507:3.4":"eko rahasi jhāyatha. 287.","ja507:4.1":"Sa rājā paridevesi,","ja507:4.2":"puttasokena aṭṭito;","ja507:4.3":"Ekaputto cayaṃ mayhaṃ,","ja507:4.4":"na ca kāmāni bhuñjati. 288.","ja507:5.1":"Ko nu khvettha [khettha (sī. pī.)] upāyo so,","ja507:5.2":"ko vā jānāti kiñcanaṃ;","ja507:5.3":"Yo [ko (sī. pī.)] me puttaṃ palobheyya,","ja507:5.4":"yathā kāmāni patthaye. 289.","ja507:6.1":"Ahu kumārī tattheva,","ja507:6.2":"vaṇṇarūpasamāhitā;","ja507:6.3":"Kusalā naccagītassa,","ja507:6.4":"vādite ca padakkhiṇā. 290.","ja507:7.1":"Sā tattha upasaṅkamma,","ja507:7.2":"rājānaṃ etadabravi;","ja507:7.3":"Ahaṃ kho naṃ palobheyyaṃ,","ja507:7.4":"sace bhattā bhavissati. 291.","ja507:8.1":"Taṃ tathāvādiniṃ rājā,","ja507:8.2":"kumāriṃ etadabravi;","ja507:8.3":"Tvaññeva naṃ palobhehi,","ja507:8.4":"tava bhattā bhavissati. 292.","ja507:9.1":"Sā ca antepuraṃ gantvā,","ja507:9.2":"bahuṃ kāmupasaṃhitaṃ;","ja507:9.3":"Hadayaṅgamā pemanīyā,","ja507:9.4":"citrā gāthā abhāsatha. 293.","ja507:10.1":"Tassā ca gāyamānāya,","ja507:10.2":"saddaṃ sutvāna nāriyā;","ja507:10.3":"Kāmacchandassa uppajji,","ja507:10.4":"janaṃ so paripucchatha. 294.","ja507:11.1":"Kasseso saddo ko vā so,","ja507:11.2":"bhaṇati uccāvacaṃ bahuṃ;","ja507:11.3":"Hadayaṅgamaṃ pemanīyaṃ,","ja507:11.4":"aho [atho (sī. pī.)] kaṇṇasukhaṃ mama. 295.","ja507:12.1":"Esā kho pamadā deva,","ja507:12.2":"khiḍḍā esā anappikā [anappakā (ka.)];","ja507:12.3":"Sace tvaṃ kāme bhuñjeyya,","ja507:12.4":"bhiyyo bhiyyo chādeyyu taṃ. 296.","ja507:13.1":"Iṅgha āgacchatorena [āgacchatorenaṃ (ka.) āgacchatu + orena],","ja507:13.2":"avidūramhi gāyatu;","ja507:13.3":"Assamassa samīpamhi,","ja507:13.4":"santike mayhaṃ gāyatu. 297.","ja507:14.1":"Tirokuṭṭamhi gāyitvā,","ja507:14.2":"jhānāgāramhi pāvisi;","ja507:14.3":"Bandhi naṃ [bhandhituṃ (syā. ka.)] anupubbena,","ja507:14.4":"āraññamiva kuñjaraṃ. 298.","ja507:15.1":"Tassa [tassā (syā.)] kāmarasaṃ ñatvā,","ja507:15.2":"issādhammo ajāyatha;","ja507:15.3":"“Ahameva kāme bhuñjeyyaṃ,","ja507:15.4":"mā añño puriso ahu”. 299.","ja507:16.1":"Tato asiṃ gahetvāna,","ja507:16.2":"purise hantuṃ upakkami;","ja507:16.3":"Ahameveko bhuñjissaṃ,","ja507:16.4":"mā añño puriso siyā. 300.","ja507:17.1":"Tato jānapadā sabbe,","ja507:17.2":"vikkandiṃsu samāgatā;","ja507:17.3":"Putto tyāyaṃ mahārāja,","ja507:17.4":"janaṃ heṭhetyadūsakaṃ. 301.","ja507:18.1":"Tañca rājā vivāhesi [nivāhesi (syā.), vihāhesi (pī.)],","ja507:18.2":"samhā raṭṭhā ca [raṭṭhāto (sī. pī.), raṭṭhato (ka.)] khattiyo;","ja507:18.3":"Yāvatā vijitaṃ mayhaṃ,","ja507:18.4":"na te vatthabba [vattabba (sī. pī.)] tāvade. 302.","ja507:19.1":"Tato so bhariyamādāya,","ja507:19.2":"samuddaṃ upasaṅkami;","ja507:19.3":"Paṇṇasālaṃ karitvāna,","ja507:19.4":"vanamuñchāya pāvisi. 303.","ja507:20.1":"Athettha isi māgacchi,","ja507:20.2":"samuddaṃ uparūpari;","ja507:20.3":"So tassa gehaṃ pāvekkhi,","ja507:20.4":"bhattakāle upaṭṭhite. 304.","ja507:21.1":"Tañca bhariyā palobhesi,","ja507:21.2":"passa yāva sudāruṇaṃ;","ja507:21.3":"Cuto so brahmacariyamhā,","ja507:21.4":"iddhiyā parihāyatha. 305.","ja507:22.1":"Rājaputto ca uñchāto,","ja507:22.2":"vanamūlaphalaṃ bahuṃ;","ja507:22.3":"Sāyaṃ kājena [kācena (pī.)] ādāya,","ja507:22.4":"assamaṃ upasaṅkami. 306.","ja507:23.1":"Isī ca khattiyaṃ disvā,","ja507:23.2":"samuddaṃ upasaṅkami;","ja507:23.3":"“Vehāyasaṃ gamissa”nti,","ja507:23.4":"sīdate so mahaṇṇave. 307.","ja507:24.1":"Khattiyo ca isiṃ disvā,","ja507:24.2":"sīdamānaṃ mahaṇṇave;","ja507:24.3":"Tasseva anukampāya,","ja507:24.4":"imā gāthā abhāsatha. 308.","ja507:25.1":"Abhijjamāne vārismiṃ,","ja507:25.2":"sayaṃ āgamma iddhiyā;","ja507:25.3":"Missībhāvitthiyā gantvā,","ja507:25.4":"saṃsīdasi mahaṇṇave. 309.","ja507:26.1":"Āvaṭṭanī mahāmāyā,","ja507:26.2":"brahmacariyavikopanā;","ja507:26.3":"Sīdanti naṃ viditvāna,","ja507:26.4":"ārakā parivajjaye. 310.","ja507:27.1":"Analā mudusambhāsā,","ja507:27.2":"duppūrā tā nadīsamā;","ja507:27.3":"Sīdanti naṃ viditvāna,","ja507:27.4":"ārakā parivajjaye. 311.","ja507:28.1":"Yaṃ etā upasevanti,","ja507:28.2":"chandasā vā dhanena vā;","ja507:28.3":"Jātavedova saṃ ṭhānaṃ,","ja507:28.4":"khippaṃ anudahanti naṃ. 312.","ja507:29.1":"Khattiyassa vaco sutvā,","ja507:29.2":"isissa nibbidā ahu;","ja507:29.3":"Laddhā porāṇakaṃ maggaṃ,","ja507:29.4":"gacchate so vihāyasaṃ. 313.","ja507:30.1":"Khattiyo ca isiṃ disvā,","ja507:30.2":"gacchamānaṃ vihāyasaṃ;","ja507:30.3":"Saṃvegaṃ alabhī dhīro,","ja507:30.4":"pabbajjaṃ samarocayi. 314.","ja507:31.1":"Tato so pabbajitvāna,","ja507:31.2":"kāmarāgaṃ virājayi;","ja507:31.3":"Kāmarāgaṃ virājetvā,","ja507:31.4":"brahmalokūpago ahūti.","ja507:32.1":"Mahāpalobhanajātakaṃ ekādasamaṃ. 508."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iv","bookName":"Jātaka-aṭṭhakathā-4","vriCode":"s0513a4.att","from":4978,"to":4997,"paras":[{"para":4978,"vripara":null,"refs":["ja507:4"],"lines":["Tattha <b>sabbakāmasamiddhisū</b>ti sabbakāmānaṃ samiddhīsu sampattīsu ṭhitassa rañño putto hutvā eko devaputto nibbatti.","<b>Svāssū</b>ti so kumāro.","<b>Tāyevā</b>ti tāya brahmaloke nibbattitāya jhānasaññāya eva.","<b>Sumāpita</b>nti pitarā suṭṭhu manāpaṃ katvā māpitaṃ.","<b>Rahasi jhāyathā</b>ti mātugāmaṃ apassanto vasi.","<b>Paridevesī</b>ti vilapi."],"lineRefs":[["ja507:4"],["ja507:4"],["ja507:4"],["ja507:4"],["ja507:4"],["ja507:4"]]},{"para":4979,"vripara":null,"refs":["ja507:4"],"lines":["Pañcamā rañño paridevanagāthā – 288."],"lineRefs":[["ja507:4"]]},{"para":4981,"vripara":"288","refs":["ja507:4"],"lines":["“Ko nu khvettha upāyo so, ko vā jānāti kiñcanaṃ;"],"lineRefs":[["ja507:4"]]},{"para":4982,"vripara":null,"refs":["ja507:4"],"lines":["Yo me puttaṃ palobheyya, yathā kāmāni patthaye”ti."],"lineRefs":[["ja507:4"]]},{"para":4983,"vripara":null,"refs":["ja507:5"],"lines":["Tattha <b>ko nu khvettha upāyo</b>ti ko nu kho ettha etassa kāmānaṃ bhuñjanaupāyo.","“Ko nu kho idhupāyo so”tipi pāṭho, aṭṭhakathāyaṃ pana “ko nu kho etaṃ upavasitvā upalāpanakāraṇaṃ jānātī”ti vuttaṃ.","<b>Ko vā jānāti kiñcana</b>nti ko vā etassa palibodhakāraṇaṃ jānātīti attho."],"lineRefs":[["ja507:5"],["ja507:5"],["ja507:5"]]},{"para":4984,"vripara":null,"refs":["ja507:5"],"lines":["Tato paraṃ diyaḍḍhagāthā abhisambuddhagāthā – 289."],"lineRefs":[["ja507:5"]]},{"para":4986,"vripara":"289","refs":["ja507:5"],"lines":["“Ahu kumārī tattheva, vaṇṇarūpasamāhitā;"],"lineRefs":[["ja507:5"]]},{"para":4987,"vripara":null,"refs":["ja507:5"],"lines":["Kusalā naccagītassa, vādite ca padakkhiṇā. 290."],"lineRefs":[["ja507:5"]]},{"para":4989,"vripara":"290","refs":["ja507:5"],"lines":["“Sā tattha upasaṅkamma, rājānaṃ etadabravī”ti;"],"lineRefs":[["ja507:5"]]},{"para":4990,"vripara":null,"refs":["ja507:5"],"lines":["Tattha <b>ahū</b>ti bhikkhave, tattheva antepure cūḷanāṭakānaṃ antare ekā taruṇakumārikā ahosi.","<b>Padakkhiṇā</b>ti susikkhitā."],"lineRefs":[["ja507:5"],["ja507:5"]]},{"para":4991,"vripara":null,"refs":["ja507:5"],"lines":["“Ahaṃ kho naṃ palobheyyaṃ, sace bhattā bhavissatī”ti. –"],"lineRefs":[["ja507:5"]]},{"para":4992,"vripara":null,"refs":["ja507:5"],"lines":["Upaḍḍhagāthā kumārikāya vuttā."],"lineRefs":[["ja507:5"]]},{"para":4993,"vripara":null,"refs":["ja507:7"],"lines":["Tattha <b>sace bhattā</b>ti sace esa mayhaṃ pati bhavissatīti. 291."],"lineRefs":[["ja507:7"]]},{"para":4995,"vripara":"291","refs":["ja507:7"],"lines":["“Taṃ tathāvādiniṃ rājā, kumāriṃ etadabravi;"],"lineRefs":[["ja507:7"]]},{"para":4996,"vripara":null,"refs":["ja507:7"],"lines":["Tvaññeva naṃ palobhehi, tava bhattā bhavissatīti."],"lineRefs":[["ja507:7"]]},{"para":4997,"vripara":null,"refs":["ja507:8"],"lines":["Tattha <b>tava bhattā</b>ti tavesa pati bhavissati, tvaññeva tassa aggamahesī bhavissasi, gaccha naṃ palobhehi, kāmarasaṃ jānāpehīti."],"lineRefs":[["ja507:8"]]}],"wordLinks":[["ja507:4.1","paridevesī",0,5],["ja507:5.1","ko nu khvettha upāyo",4,0],["ja507:5.1","ko vā jānāti kiñcanaṃ",4,2],["ja507:7.3","sace bhattā",12,0],["ja507:8.3","tava bhattā",15,0]],"after":[{"para":4998,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Evaṃ vatvā rājā “imissā kira okāsaṃ karontū”ti kumārassa upaṭṭhākānaṃ pesesi.","Sā paccūsakāle vīṇaṃ ādāya gantvā kumārassa sayanagabbhassa bahi avidūre ṭhatvā agganakhehi vīṇaṃ vādentī madhurasarena gāyitvā taṃ palobhesi.","Tamatthaṃ pakāsento satthā āha – 292."]},{"para":5000,"vripara":"292","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Sā ca antepuraṃ gantvā, bahuṃ kāmupasaṃhitaṃ;"]},{"para":5001,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Hadayaṅgamā pemanīyā, citrā gāthā abhāsatha. 293."]},{"para":5003,"vripara":"293","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Tassā ca gāyamānāya, saddaṃ sutvāna nāriyā;"]},{"para":5004,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Kāmacchandassa uppajji, janaṃ so paripucchatha. 294."]},{"para":5006,"vripara":"294","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Kasseso saddo ko vā so, bhaṇati uccāvacaṃ bahuṃ;"]},{"para":5007,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Hadayaṅgamaṃ pemanīyaṃ, aho kaṇṇasukhaṃ mama. 295."]},{"para":5009,"vripara":"295","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Esā kho pamadā deva, khiḍḍā esā anappikā;"]},{"para":5010,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Sace tvaṃ kāme bhuñjeyya, bhiyyo bhiyyo chādeyyu taṃ. 296."]},{"para":5012,"vripara":"296","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Iṅgha āgacchatorena, avidūramhi gāyatu;"]},{"para":5013,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Assamassa samīpamhi, santike mayha gāyatu. 297."]},{"para":5015,"vripara":"297","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Tirokuṭṭamhi gāyitvā, jhānāgāramhi pāvisi;"]},{"para":5016,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Bandhi naṃ anupubbena, āraññamiva kuñjaraṃ. 298."]},{"para":5018,"vripara":"298","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Tassa kāmarasaṃ ñatvā, issādhammo ajāyatha;"]},{"para":5019,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["‘Ahameva kāme bhuñjeyyaṃ, mā añño puriso ahu’. 299."]},{"para":5021,"vripara":"299","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Tato asiṃ gahetvāna, purise hantuṃ upakkami;"]},{"para":5022,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Ahameveko bhuñjissaṃ, mā añño puriso siyā. 300."]},{"para":5024,"vripara":"300","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Tato jānapadā sabbe, vikkandiṃsu samāgatā;"]},{"para":5025,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Putto tyāyaṃ mahārāja, janaṃ heṭhetyadūsakaṃ. 301."]},{"para":5027,"vripara":"301","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Tañca rājā vivāhesi, samhā raṭṭhā ca khattiyo;"]},{"para":5028,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Yāvatā vijitaṃ mayhaṃ, na te vatthabba tāvade. 302."]},{"para":5030,"vripara":"302","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Tato so bhariyamādāya, samuddaṃ upasaṅkami;"]},{"para":5031,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Paṇṇasālaṃ karitvāna, vanamuñchāya pāvisi. 303."]},{"para":5033,"vripara":"303","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Athettha isi māgacchi, samuddaṃ uparūpari;"]},{"para":5034,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["So tassa gehaṃ pāvekkhi, bhattakāle upaṭṭhite. 304."]},{"para":5036,"vripara":"304","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Tañca bhariyā palobhesi, passa yāva sudāruṇaṃ;"]},{"para":5037,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Cuto so brahmacariyamhā, iddhiyā parihāyatha. 305."]},{"para":5039,"vripara":"305","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Rājaputto ca uñchāto, vanamūlaphalaṃ bahuṃ;"]},{"para":5040,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Sāyaṃ kājena ādāya, assamaṃ upasaṅkami. 306."]},{"para":5042,"vripara":"306","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Isī ca khattiyaṃ disvā, samuddaṃ upasaṅkami;"]},{"para":5043,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["‘Vehāyasaṃ gamissa’nti, sīdate so mahaṇṇave. 307."]},{"para":5045,"vripara":"307","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Khattiyo ca isiṃ disvā, sīdamānaṃ mahaṇṇave;"]},{"para":5046,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Tasseva anukampāya, imā gāthā abhāsatha. 308."]},{"para":5048,"vripara":"308","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Abhijjamāne vārismiṃ, sayaṃ āgamma iddhiyā;"]},{"para":5049,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Missībhāvitthiyā gantvā, saṃsīdasi mahaṇṇave. 309."]},{"para":5051,"vripara":"309","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Āvaṭṭanī mahāmāyā, brahmacariyavikopanā;"]},{"para":5052,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Sīdanti naṃ viditvāna, ārakā parivajjaye. 310."]},{"para":5054,"vripara":"310","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Analā mudusambhāsā, duppūrā tā nadīsamā;"]},{"para":5055,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Sīdanti naṃ viditvāna, ārakā parivajjaye. 311."]},{"para":5057,"vripara":"311","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Yaṃ etā upasevanti, chandasā vā dhanena vā;"]},{"para":5058,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Jātavedova saṃ ṭhānaṃ, khippaṃ anudahanti taṃ. 312."]},{"para":5060,"vripara":"312","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Khattiyassa vaco sutvā, isissa nibbidā ahu;"]},{"para":5061,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Laddhā porāṇakaṃ maggaṃ, gacchate so vihāyasaṃ. 313."]},{"para":5063,"vripara":"313","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Khattiyo ca isiṃ disvā, gacchamānaṃ vihāyasaṃ;"]},{"para":5064,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Saṃvegaṃ alabhī dhīro, pabbajjaṃ samarocayi. 314."]},{"para":5066,"vripara":"314","title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["“Tato so pabbajitvāna, kāmarāgaṃ virājayi;"]},{"para":5067,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Kāmarāgaṃ virājetvā, brāhmalokūpago ahū”ti."]},{"para":5068,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Tattha <b>antepura</b>nti kumārassa vasanaṭṭhānaṃ.","<b>Bahu</b>nti bahuṃ nānappakāraṃ.","<b>Kāmupasaṃhita</b>nti kāmanissitaṃ gītaṃ pavattayamānā.","<b>Kāmacchandassā</b>ti assa anitthigandhakumārassa kāmacchando uppajji.","<b>Jana</b>nti attano santikāvacaraṃ paricārikajanaṃ.","<b>Uccāvaca</b>nti uggatañca anuggatañca.","<b>Bhuñjeyyā</b>ti sace bhuñjeyyāsi.","<b>Chādeyyu ta</b>nti ete kāmā nāma tava rucceyyuṃ.","So “pamadā”ti vacanaṃ sutvā tuṇhī ahosi.","Itarā punadivasepi gāyi.","Evaṃ kumāro paṭibaddhacitto hutvā tassā āgamanaṃ rocento paricārike āmantetvā <b>“iṅghā”</b>ti gāthamāha."]},{"para":5069,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["<b>Tirokuṭṭamhī</b>ti sayanagabbhakuṭṭassa bahi.","<b>Mā añño</b>ti añño kāme paribhuñjanto puriso nāma mā siyā.","<b>Hantuṃ upakkamī</b>ti antaravīthiṃ otaritvā māretuṃ ārabhi.","<b>Vikandiṃsū</b>ti kumārena katipayesu purisesu pahatesu purisā palāyitvā gehāni pavisiṃsu.","So purise alabhanto thokaṃ vissami.","Tasmiṃ khaṇe rājaṅgaṇe sannipatitvā upakkosiṃsu.","<b>Janaṃ heṭhetyadūsaka</b>nti niraparādhaṃ janaṃ heṭheti, taṃ gaṇhāpethāti vadiṃsu.","Rājā upāyena kumāraṃ gaṇhāpetvā “imassa kiṃ kattabba”nti pucchi.","“Deva, aññaṃ natthi, imaṃ pana kumāraṃ tāya kumārikāya saddhiṃ raṭṭhā pabbājetuṃ vaṭṭatī”ti vutte tathā akāsi.","Tamatthaṃ pakāsento satthā <b>“tañcā”</b>tiādimāha.","Tattha <b>vivāhesī</b>ti pabbājesi.","<b>Na te vatthabba tāvade</b>ti yattakaṃ mayhaṃ vijitaṃ, tattake tayā na vatthabbaṃ.","<b>Uñchāyā</b>ti phalāphalatthāya."]},{"para":5070,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Tasmiṃ pana vanaṃ paviṭṭhe itarā yaṃ tattha pacitabbayuttakaṃ atthi, taṃ pacitvā tassāgamanaṃ olokentī paṇṇasāladvāre nisīdati.","Evaṃ kāle gacchante ekadivasaṃ antaradīpakavāsī eko iddhimantatāpaso assamapadato nikkhamitvā maṇiphalakaṃ viya udakaṃ maddamānova ākāse uppatitvā bhikkhācāraṃ gacchanto paṇṇasālāya uparibhāgaṃ patvā dhūmaṃ disvā “imasmiṃ ṭhāne manussā vasanti maññe”ti paṇṇasāladvāre otari.","Sā taṃ disvā nisīdāpetvā paṭibaddhacittā hutvā itthikuttaṃ dassetvā tena saddhiṃ anācāraṃ acari.","Tamatthaṃ pakāsento satthā <b>“athetthā”</b>tiādimāha.","Tattha <b>isi māgacchī</b>ti isi āgacchi.","<b>Samuddaṃ uparūparī</b>ti samuddassa matthakamatthakena.","<b>Passa yāva sudāruṇa</b>nti passatha, bhikkhave, tāya kumārikāya yāva sudāruṇaṃ kammaṃ katanti attho."]},{"para":5071,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["<b>Sāya</b>nti sāyanhasamaye.","<b>Disvā</b>ti taṃ vijahituṃ asakkonto sakaladivasaṃ tattheva hutvā sāyanhasamaye rājaputtaṃ āgataṃ disvā palāyituṃ “vehāyasaṃ gamissa”nti uppatanākāraṃ karonto patitvā mahaṇṇave sīdati.","<b>Isiṃ disvā</b>ti anubandhamāno gantvā passitvā.","<b>Anukampāyā</b>ti sacāyaṃ bhūmiyā āgato abhavissa, palāyitvā araññaṃ paviseyya, ākāsena āgato bhavissati, tasmā samudde patitopi uppatanākārameva karotīti anukampaṃ uppādetvā tasseva anukampāya abhāsatha.","Tāsaṃ pana gāthānaṃ attho tikanipāte vuttoyeva.","<b>Nibbidā ahū</b>ti kāmesu nibbedo jāto.","<b>Porāṇakaṃ magga</b>nti pubbe adhigataṃ jhānavisesaṃ.","<b>Pabbajitvānā</b>ti taṃ itthiṃ manussāvāsaṃ netvā nivattitvā araññe isipabbajjaṃ pabbajitvā kāmarāgaṃ virājayi, virājetvā brahmalokūpago ahosīti."]},{"para":5072,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā “evaṃ, bhikkhave, mātugāmaṃ paṭicca visuddhasattāpi saṃkilissantī”ti vatvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne ukkaṇṭhitabhikkhu arahattaṃ patto.","Tadā anitthigandhakumāro ahameva ahosinti."]},{"para":5073,"vripara":null,"title":"[507] 11. Mahāpalobhanajātakavaṇṇanā","lines":["Mahāpalobhanajātakavaṇṇanā ekādasamā. [508] 12."]},{"para":5075,"vripara":null,"title":"[508] 12. Pañcapaṇḍitajātakavaṇṇanā","lines":["Pañcapaṇḍitajātakavaṇṇanā 315-336."]}]},"tika":null,"tika2":null}
