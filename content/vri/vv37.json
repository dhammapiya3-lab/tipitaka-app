{"suttaId":"vv37","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1448,1491],"vripara":"666"},"segments":{"vv37:0.4":"Visālakkhivimānavatthu","vv37:1.1":"“Kā nāma tvaṃ visālakkhi [visālakkhī (syā.)],","vv37:1.2":"ramme cittalatāvane;","vv37:1.3":"Samantā anupariyāsi,","vv37:1.4":"nārīgaṇapurakkhatā [purakkhitā (syā. ka.)]. 667.","vv37:2.1":"“Yadā devā tāvatiṃsā,","vv37:2.2":"pavisanti imaṃ vanaṃ;","vv37:2.3":"Sayoggā sarathā sabbe,","vv37:2.4":"citrā honti idhāgatā. 668.","vv37:3.1":"“Tuyhañca idha pattāya,","vv37:3.2":"uyyāne vicarantiyā;","vv37:3.3":"Kāye na dissatī cittaṃ,","vv37:3.4":"kena rūpaṃ tavedisaṃ;","vv37:3.5":"Devate pucchitācikkha,","vv37:3.6":"kissa kammassidaṃ phala”nti. 669.","vv37:4.1":"“Yena kammena devinda,","vv37:4.2":"rūpaṃ mayhaṃ gatī ca me;","vv37:4.3":"Iddhi ca ānubhāvo ca,","vv37:4.4":"taṃ suṇohi purindada. 670.","vv37:5.1":"“Ahaṃ rājagahe ramme,","vv37:5.2":"sunandā nāmupāsikā;","vv37:5.3":"Saddhā sīlena sampannā,","vv37:5.4":"saṃvibhāgaratā sadā. 671.","vv37:6.1":"“Acchādanañca bhattañca,","vv37:6.2":"senāsanaṃ padīpiyaṃ;","vv37:6.3":"Adāsiṃ ujubhūtesu,","vv37:6.4":"vippasannena cetasā. 672.","vv37:7.1":"“Cātuddasiṃ [catuddasiṃ (pī. ka.)] pañcadasiṃ,","vv37:7.2":"yā ca pakkhassa aṭṭhamī;","vv37:7.3":"Pāṭihāriyapakkhañca,","vv37:7.4":"aṭṭhaṅgasusamāgataṃ. 673.","vv37:8.1":"“Uposathaṃ upavasissaṃ,","vv37:8.2":"sadā sīlesu saṃvutā;","vv37:8.3":"Saññamā saṃvibhāgā ca,","vv37:8.4":"vimānaṃ āvasāmahaṃ. 674.","vv37:9.1":"“Pāṇātipātā viratā,","vv37:9.2":"musāvādā ca saññatā;","vv37:9.3":"Theyyā ca aticārā ca,","vv37:9.4":"majjapānā ca ārakā. 675.","vv37:10.1":"“Pañcasikkhāpade ratā,","vv37:10.2":"ariyasaccāna kovidā;","vv37:10.3":"Upāsikā cakkhumato,","vv37:10.4":"gotamassa yasassino. 676.","vv37:11.1":"“Tassā me ñātikulā dāsī [ñātikulaṃ āsī (syā. ka.)],","vv37:11.2":"sadā mālābhihārati;","vv37:11.3":"Tāhaṃ bhagavato thūpe,","vv37:11.4":"sabbamevābhiropayiṃ. 677.","vv37:12.1":"“Uposathe cahaṃ gantvā,","vv37:12.2":"mālāgandhavilepanaṃ;","vv37:12.3":"Thūpasmiṃ abhiropesiṃ,","vv37:12.4":"pasannā sehi pāṇibhi. 678.","vv37:13.1":"“Tena kammena devinda,","vv37:13.2":"rūpaṃ mayhaṃ gatī ca me;","vv37:13.3":"Iddhī ca ānubhāvo ca,","vv37:13.4":"yaṃ mālaṃ abhiropayiṃ. 679.","vv37:14.1":"“Yañca sīlavatī āsiṃ,","vv37:14.2":"na taṃ tāva vipaccati;","vv37:14.3":"Āsā ca pana me devinda,","vv37:14.4":"sakadāgāminī siya”nti.","vv37:15.1":"Visālakkhivimānaṃ navamaṃ. 10."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1688,"to":1728,"paras":[{"para":1688,"vripara":"666","refs":["vv37:1"],"lines":["Tattha <b>kā nāma tva</b>nti purimattabhāve kā nāma kīdisī nāma tvaṃ, yattha katena sucaritena ayaṃ te īdisī ānubhāvasampatti ahosīti adhippāyo.","<b>Visālakkhī</b>ti vipulalocane. 667."],"lineRefs":[["vv37:1"],["vv37:1"]]},{"para":1689,"vripara":"667","refs":["vv37:2"],"lines":["<b>Yadā</b>ti yasmiṃ kāle.","<b>Imaṃ vana</b>nti imaṃ cittalatānāmakaṃ upavanaṃ.","<b>Citrā hontī</b>ti imasmiṃ cittalatāvane vicittapabhāsaṃsaggena attano sarīravatthālaṅkārādīnaṃ pakatiobhāsatopi visiṭṭhabhāvappattiyā vicitrākārā honti.","<b>Idhāgatā</b>ti idha āgatā sampattā, idha vā āgamanahetu. 668."],"lineRefs":[["vv37:2"],["vv37:2"],["vv37:2"],["vv37:2"]]},{"para":1690,"vripara":"668","refs":["vv37:3"],"lines":["<b>Idha pattāyā</b>ti imaṃ ṭhānaṃ sampattāya upagatāya.","<b>Kena</b> <b>rūpaṃ tavedisa</b>nti kena kāraṇena tava rūpaṃ sarīraṃ edisaṃ evarūpaṃ, cittalatāvanassa pabhaṃ abhibhavantaṃ tiṭṭhatīti adhippāyo."],"lineRefs":[["vv37:3"],["vv37:3"]]},{"para":1691,"vripara":null,"refs":["vv37:3"],"lines":["Evaṃ sakkena puṭṭhā sā devatā imāhi gāthāhi byākāsi – 669."],"lineRefs":[["vv37:3"]]},{"para":1693,"vripara":"669","refs":["vv37:3"],"lines":["“Yena kammena devinda, rūpaṃ mayhaṃ gatī ca me;"],"lineRefs":[["vv37:3"]]},{"para":1694,"vripara":null,"refs":["vv37:3"],"lines":["Iddhi ca ānubhāvo ca, taṃ suṇohi purindada. 670."],"lineRefs":[["vv37:3"]]},{"para":1696,"vripara":"670","refs":["vv37:3"],"lines":["“Ahaṃ rājagahe ramme, sunandā nāmupāsikā;"],"lineRefs":[["vv37:3"]]},{"para":1697,"vripara":null,"refs":["vv37:3"],"lines":["Saddhā sīlena sampannā, saṃvibhāgaratā sadā. 671."],"lineRefs":[["vv37:3"]]},{"para":1699,"vripara":"671","refs":["vv37:3"],"lines":["“Acchādanañca bhattañca, senāsanaṃ padīpiyaṃ;"],"lineRefs":[["vv37:3"]]},{"para":1700,"vripara":null,"refs":["vv37:3"],"lines":["Adāsiṃ ujubhūtesu, vippasannena cetasā. 672."],"lineRefs":[["vv37:3"]]},{"para":1702,"vripara":"672","refs":["vv37:3"],"lines":["“Cātuddasiṃ pañcadasiṃ, yā ca pakkhassa aṭṭhamī;"],"lineRefs":[["vv37:3"]]},{"para":1703,"vripara":null,"refs":["vv37:3"],"lines":["Pāṭihāriyapakkhañca, aṭṭhaṅgasusamāgataṃ. 673."],"lineRefs":[["vv37:3"]]},{"para":1705,"vripara":"673","refs":["vv37:3"],"lines":["“Uposathaṃ upavasissaṃ, sadā sīlesu saṃvutā;"],"lineRefs":[["vv37:3"]]},{"para":1706,"vripara":null,"refs":["vv37:3"],"lines":["Saññamā saṃvibhāgā ca, vimānaṃ āvasāmahaṃ. 674."],"lineRefs":[["vv37:3"]]},{"para":1708,"vripara":"674","refs":["vv37:3"],"lines":["“Pāṇātipātā viratā, musāvādā ca saññatā;"],"lineRefs":[["vv37:3"]]},{"para":1709,"vripara":null,"refs":["vv37:3"],"lines":["Theyyā ca aticārā ca, majjapānā ca ārakā. 675."],"lineRefs":[["vv37:3"]]},{"para":1711,"vripara":"675","refs":["vv37:3"],"lines":["“Pañcasikkhāpade ratā, ariyasaccāna kovidā;"],"lineRefs":[["vv37:3"]]},{"para":1712,"vripara":null,"refs":["vv37:3"],"lines":["Upāsikā cakkhumato, gotamassa yasassino. 676."],"lineRefs":[["vv37:3"]]},{"para":1714,"vripara":"676","refs":["vv37:3"],"lines":["“Tassā me ñātikulā dāsī, sadā mālābhihārati;"],"lineRefs":[["vv37:3"]]},{"para":1715,"vripara":null,"refs":["vv37:3"],"lines":["Tāhaṃ bhagavato thūpe, sabbamevābhiropayiṃ. 677."],"lineRefs":[["vv37:3"]]},{"para":1717,"vripara":"677","refs":["vv37:3"],"lines":["“Uposathe cahaṃ gantvā, mālāgandhavilepanaṃ;"],"lineRefs":[["vv37:3"]]},{"para":1718,"vripara":null,"refs":["vv37:3"],"lines":["Thūpasmiṃ abhiropesiṃ, pasannā sehi pāṇibhi. 678."],"lineRefs":[["vv37:3"]]},{"para":1720,"vripara":"678","refs":["vv37:3"],"lines":["“Tena kammena devinda, rūpaṃ mayhaṃ gatī ca me;"],"lineRefs":[["vv37:3"]]},{"para":1721,"vripara":null,"refs":["vv37:3"],"lines":["Iddhi ca ānubhāvo ca, yaṃ mālaṃ abhiropayiṃ. 679."],"lineRefs":[["vv37:3"]]},{"para":1723,"vripara":"679","refs":["vv37:3"],"lines":["“Yañca sīlavatī āsiṃ, na taṃ tāva vipaccati;"],"lineRefs":[["vv37:3"]]},{"para":1724,"vripara":null,"refs":["vv37:3"],"lines":["Āsā ca pana me devinda, sakadāgāminī siya”nti. 669."],"lineRefs":[["vv37:3"]]},{"para":1725,"vripara":"669","refs":["vv37:4"],"lines":["Tattha <b>gatī</b>ti ayaṃ devagati, nibbatti vā.","<b>Iddhī</b>ti ayaṃ deviddhi, adhippāyasamijjhanaṃ vā.","<b>Ānubhāvo</b>ti pabhāvo.","<b>Purindadā</b>ti sakkaṃ ālapati.","So hi pure dānaṃ adāsīti “purindado”ti vuccati. 676."],"lineRefs":[["vv37:4"],["vv37:4"],["vv37:4"],["vv37:4"],["vv37:4"]]},{"para":1726,"vripara":"676","refs":["vv37:11"],"lines":["<b>Ñātikulā</b>ti pitu gehaṃ sandhāya vadati.","<b>Sadā mālābhihāratī</b>ti sadā sabbakālaṃ divase divase ñātikulato dāsiyā pupphaṃ mayhaṃ abhiharīyati.","<b>Sabbamevābhiropayi</b>nti mayhaṃ piḷandhanatthāya pitugehato āhaṭaṃ mālaṃ aññañca gandhādiṃ sabbameva attanā aparibhuñjitvā bhagavato thūpe pūjanavasena abhiropayiṃ pūjaṃ kāresiṃ. 677-8."],"lineRefs":[["vv37:11"],["vv37:11"],["vv37:11"]]},{"para":1727,"vripara":"677-678","refs":["vv37:12"],"lines":["<b>Uposathe cahaṃ gantvā</b>ti uposathadivase ahameva thūpaṭṭhānaṃ gantvā.","<b>Yaṃ mālaṃ abhiropayi</b>nti yaṃ tadā bhagavato thūpe mālāgandhābhiropanaṃ kataṃ, tena kammenāti yojanā. 679."],"lineRefs":[["vv37:12"],["vv37:12"]]},{"para":1728,"vripara":"679","refs":["vv37:14"],"lines":["<b>Na taṃ tāva vipaccatī</b>ti yaṃ sīlavatī āsiṃ, taṃ sīlarakkhaṇaṃ taṃ rakkhitaṃ sīlaṃ pūjāmayapuññassa balavabhāvena aladdhokāsaṃ na tāva vipaccati, na vipaccituṃ āraddhaṃ, aparasmiṃyeva attabhāve tassa vipākoti attho.","<b>Āsā ca pana me devinda, sakadāgāminī siya</b>nti “kathaṃ nu kho ahaṃ sakadāgāminī bhaveyya”nti patthanā ca me devinda, ariyadhammavisayāva, na bhavavisesavisayā.","Sā pana sappimaṇḍaṃ icchato dadhito pacitaṃ viya anipphādinīti dasseti.","Sesaṃ vuttanayameva."],"lineRefs":[["vv37:14"],["vv37:14"],["vv37:14"],["vv37:14"]]}],"wordLinks":[["vv37:1.1","kā nāma tvaṃ",0,0],["vv37:1.1","visālakkhī",0,1],["vv37:2.1","yadā",1,0],["vv37:2.1","imaṃ vanaṃ",1,1],["vv37:2.3","citrā hontī",1,2],["vv37:2.3","idhāgatā",1,3],["vv37:3.1","idha pattāyā",2,0],["vv37:3.3","kena rūpaṃ tavedisaṃ",2,1],["vv37:4.1","gatī",26,0],["vv37:4.3","iddhī",26,1],["vv37:4.3","ānubhāvo",26,2],["vv37:4.3","purindadā",26,3],["vv37:11.1","ñātikulā",27,0],["vv37:11.1","sadā mālābhihāratī",27,1],["vv37:11.3","sabbamevābhiropayiṃ",27,2],["vv37:12.1","uposathe cahaṃ gantvā",28,0],["vv37:14.1","na taṃ tāva vipaccatī",29,0],["vv37:14.3","āsā ca pana me devinda sakadāgāminī siyaṃ",29,1]],"before":[{"para":1676,"vripara":null,"title":"Visālakkhivimānavaṇṇanā","lines":["Visālakkhivimānavaṇṇanā"]},{"para":1677,"vripara":null,"title":"Visālakkhivimānavaṇṇanā","lines":["<b>Kā nāma tvaṃ visālakkhī</b>ti visālakkhivimānaṃ.","Tassa kā uppatti?","Bhagavati parinibbute raññā ajātasattunā attanā paṭiladdhā bhagavatā sarīradhātuyo gahetvā rājagahe thūpe ca mahe ca kate rājagahavāsinī ekā mālākāradhītā sunandā nāma upāsikā ariyasāvikā sotāpannā pituṃ gehato pesitaṃ bahuṃ mālañca gandhañca pesetvā devasikaṃ cetiye pūjaṃ kāresi, uposathadivasesu pana sayameva gantvā pūjaṃ akāsi.","Sā aparabhāge aññatarena rogena phuṭṭhā kālaṃ katvā sakkassa devarañño paricārikā hutvā nibbatti.","Athekadivasaṃ sā sakkena devānamindena saha cittalatāvanaṃ pāvisi.","Tattha ca aññāsaṃ devatānaṃ pabhā pupphādīnaṃ pabhāhi paṭihatā hutvā vicittavaṇṇā hoti, sunandāya pana pabhā tāhi anabhibhūtā sabhāveneva aṭṭhāsi.","Taṃ disvā sakko devarājā tāya katasucaritaṃ ñātukāmo imāhi gāthāhi pucchi – 666."]},{"para":1679,"vripara":"666","title":"Visālakkhivimānavaṇṇanā","lines":["“Kā nāma tvaṃ visālakkhi, ramme cittalatāvane;"]},{"para":1680,"vripara":null,"title":"Visālakkhivimānavaṇṇanā","lines":["Samantā anupariyāsi, nārīgaṇapurakkhatā. 667."]},{"para":1682,"vripara":"667","title":"Visālakkhivimānavaṇṇanā","lines":["“Yadā devā tāvatiṃsā, pavisanti imaṃ vanaṃ;"]},{"para":1683,"vripara":null,"title":"Visālakkhivimānavaṇṇanā","lines":["Sayoggā sarathā sabbe, citrā honti idhāgatā. 668."]},{"para":1685,"vripara":"668","title":"Visālakkhivimānavaṇṇanā","lines":["“Tuyhañca idha pattāya, uyyāne vicarantiyā;"]},{"para":1686,"vripara":null,"title":"Visālakkhivimānavaṇṇanā","lines":["Kāye na dissatī cittaṃ, kena rūpaṃ tavedisaṃ;"]},{"para":1687,"vripara":null,"title":"Visālakkhivimānavaṇṇanā","lines":["Devate pucchitācikkha, kissa kammassidaṃ phala”nti. 666."]}],"after":[{"para":1729,"vripara":null,"title":"Visālakkhivimānavaṇṇanā","lines":["Imaṃ pana atthaṃ sakko devānamindo attanā ca tāya devadhītāya ca vuttaniyāmeneva āyasmato vaṅgīsattherassa ārocesi.","Āyasmā vaṅgīso saṅgītikāle dhammasaṅgāhakānaṃ mahātherānaṃ ārocesi, te ca taṃ tatheva saṅgītiṃ āropayiṃsūti."]},{"para":1730,"vripara":null,"title":"Visālakkhivimānavaṇṇanā","lines":["Visālakkhivimānavaṇṇanā niṭṭhitā. 10."]}]},"tika":null,"tika2":null}
