{"suttaId":"sn14.36","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[850,851],"vripara":"120"},"segments":{"sn14.36:0.3":"Uppādasuttaṃ","sn14.36:1.1":"Sāvatthiyaṃ viharati … pe …","sn14.36:1.2":"“yo, bhikkhave, pathavīdhātuyā uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo rogānaṃ ṭhiti jarāmaraṇassa pātubhāvo.","sn14.36:1.3":"Yo āpodhātuyā … pe …","sn14.36:1.4":"yo tejodhātuyā …","sn14.36:1.5":"yo vāyodhātuyā uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo rogānaṃ ṭhiti jarāmaraṇassa pātubhāvo”.","sn14.36:2.1":"“Yo ca kho, bhikkhave, pathavīdhātuyā nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho rogānaṃ vūpasamo jarāmaraṇassa atthaṅgamo.","sn14.36:2.2":"Yo āpodhātuyā … pe …","sn14.36:2.3":"yo tejodhātuyā …","sn14.36:2.4":"yo vāyodhātuyā nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho rogānaṃ vūpasamo jarāmaraṇassa atthaṅgamo”ti.","sn14.36:2.5":"Sattamaṃ."},"unsure":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":613,"to":618,"paras":[{"para":613,"vripara":"119-123","refs":["sn14.36:1"],"lines":["119-123. Chaṭṭhasattamesu vivaṭṭaṃ, avasāne tīsu catusaccamevāti.","Chaṭṭhādīni."],"lineRefs":[["sn14.36:1"],["sn14.36:1"]]},{"para":614,"vripara":null,"refs":["sn14.36:1"],"lines":["Catuttho vaggo."],"lineRefs":[["sn14.36:1"]]},{"para":615,"vripara":null,"refs":["sn14.36:1"],"lines":["Dhātusaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn14.36:1"]]},{"para":616,"vripara":null,"refs":["sn14.36:1"],"lines":["Anamataggasaṃyuttaṃ"],"lineRefs":[["sn14.36:1"]]},{"para":617,"vripara":null,"refs":["sn14.36:1"],"lines":["Paṭhamavaggo"],"lineRefs":[["sn14.36:1"]]},{"para":618,"vripara":null,"refs":["sn14.36:1"],"lines":["Tiṇakaṭṭhasuttavaṇṇanā"],"lineRefs":[["sn14.36:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":611,"to":618,"paras":[{"para":611,"vripara":"119-123","refs":["sn14.36:1"],"lines":["119-123. Chaṭṭhasattamesu vaṭṭavivaṭṭaṃ kathitaṃ.","Aṭṭhakathāyaṃ pana <b>“vivaṭṭaṃ kathitan”</b>ti vuttaṃ.","<b>Tīsu</b> suttesu.","<b>Catusaccamevā</b>ti cattāri saccāni samāhaṭāni catusaccanti tesaṃ ekajjhaṃ gahaṇaṃ, niyamo pana tabbinimuttassa paramatthassa abhāvato."],"lineRefs":[["sn14.36:1"],["sn14.36:1"],["sn14.36:1"],["sn14.36:1"]]},{"para":612,"vripara":null,"refs":["sn14.36:1"],"lines":["Abhinandasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn14.36:1"]]},{"para":613,"vripara":null,"refs":["sn14.36:1"],"lines":["Catutthavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn14.36:1"]]},{"para":614,"vripara":null,"refs":["sn14.36:1"],"lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"],"lineRefs":[["sn14.36:1"]]},{"para":615,"vripara":null,"refs":["sn14.36:1"],"lines":["Dhātusaṃyuttavaṇṇanāya līnatthappakāsanā samattā."],"lineRefs":[["sn14.36:1"]]},{"para":616,"vripara":null,"refs":["sn14.36:1"],"lines":["Anamataggasaṃyuttaṃ"],"lineRefs":[["sn14.36:1"]]},{"para":617,"vripara":null,"refs":["sn14.36:1"],"lines":["Paṭhamavaggo"],"lineRefs":[["sn14.36:1"]]},{"para":618,"vripara":null,"refs":["sn14.36:1"],"lines":["Tiṇakaṭṭhasuttavaṇṇanā"],"lineRefs":[["sn14.36:1"]]}],"wordLinks":[]},"tika2":null}
