{"suttaId":"sn14.36","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[850,851],"vripara":"120"},"segments":{"sn14.36:0.3":"Uppādasuttaṃ","sn14.36:1.1":"Sāvatthiyaṃ viharati … pe …“yo, bhikkhave, pathavīdhātuyā uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo rogānaṃ ṭhiti jarāmaraṇassa pātubhāvo.","sn14.36:1.3":"Yo āpodhātuyā … pe … yo tejodhātuyā … yo vāyodhātuyā uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo rogānaṃ ṭhiti jarāmaraṇassa pātubhāvo”.","sn14.36:2.1":"“Yo ca kho, bhikkhave, pathavīdhātuyā nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho rogānaṃ vūpasamo jarāmaraṇassa atthaṅgamo.","sn14.36:2.2":"Yo āpodhātuyā … pe … yo tejodhātuyā … yo vāyodhātuyā nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho rogānaṃ vūpasamo jarāmaraṇassa atthaṅgamo”ti.","sn14.36:2.5":"Sattamaṃ."},"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":613,"to":618,"paras":[{"para":613,"vripara":"119-123","refs":["sn14.36:1"],"lines":["119-123. Chaṭṭhasattamesu vivaṭṭaṃ, avasāne tīsu catusaccamevāti.","Chaṭṭhādīni."],"lineRefs":[["sn14.36:1"],["sn14.36:1"]]},{"para":614,"vripara":null,"refs":[],"lines":["Catuttho vaggo."],"lineRefs":[[]]},{"para":615,"vripara":null,"refs":[],"lines":["Dhātusaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":616,"vripara":null,"refs":[],"lines":["Anamataggasaṃyuttaṃ"],"lineRefs":[[]]},{"para":617,"vripara":null,"refs":[],"lines":["Paṭhamavaggo"],"lineRefs":[[]]},{"para":618,"vripara":null,"refs":["sn14.36:1"],"lines":["Tiṇakaṭṭhasuttavaṇṇanā"],"lineRefs":[["sn14.36:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":611,"to":618,"paras":[{"para":611,"vripara":"119-123","refs":["sn14.36:1"],"lines":["119-123. Chaṭṭhasattamesu vaṭṭavivaṭṭaṃ kathitaṃ.","Aṭṭhakathāyaṃ pana <b>“vivaṭṭaṃ kathitan”</b>ti vuttaṃ.","<b>Tīsu</b> suttesu.","<b>Catusaccamevā</b>ti cattāri saccāni samāhaṭāni catusaccanti tesaṃ ekajjhaṃ gahaṇaṃ, niyamo pana tabbinimuttassa paramatthassa abhāvato."],"lineRefs":[["sn14.36:1"],["sn14.36:1"],["sn14.36:1"],["sn14.36:1"]]},{"para":612,"vripara":null,"refs":[],"lines":["Abhinandasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":613,"vripara":null,"refs":[],"lines":["Catutthavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":614,"vripara":null,"refs":[],"lines":["Sāratthappakāsiniyā saṃyuttanikāya-aṭṭhakathāya"],"lineRefs":[[]]},{"para":615,"vripara":null,"refs":[],"lines":["Dhātusaṃyuttavaṇṇanāya līnatthappakāsanā samattā."],"lineRefs":[[]]},{"para":616,"vripara":null,"refs":[],"lines":["Anamataggasaṃyuttaṃ"],"lineRefs":[[]]},{"para":617,"vripara":null,"refs":[],"lines":["Paṭhamavaggo"],"lineRefs":[[]]},{"para":618,"vripara":null,"refs":["sn14.36:1"],"lines":["Tiṇakaṭṭhasuttavaṇṇanā"],"lineRefs":[["sn14.36:1"]]}],"wordLinks":[]}}
