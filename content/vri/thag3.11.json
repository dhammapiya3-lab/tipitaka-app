{"suttaId":"thag3.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1251,1260],"vripara":"249"},"segments":{"thag3.11:0.4":"Upālittheragāthā","thag3.11:1.1":"“Saddhāya abhinikkhamma,","thag3.11:1.2":"navapabbajito navo;","thag3.11:1.3":"Mitte bhajeyya kalyāṇe,","thag3.11:1.4":"suddhājīve atandite.","thag3.11:2.1":"“Saddhāya abhinikkhamma,","thag3.11:2.2":"navapabbajito navo;","thag3.11:2.3":"Saṅghasmiṃ viharaṃ bhikkhu,","thag3.11:2.4":"sikkhetha vinayaṃ budho.","thag3.11:3.1":"“Saddhāya abhinikkhamma,","thag3.11:3.2":"navapabbajito navo;","thag3.11:3.3":"Kappākappesu kusalo,","thag3.11:3.4":"careyya apurakkhato”ti.","thag3.11:3.5":"… Upālitthero …."},"unsure":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":5313,"to":5313,"paras":[{"para":5313,"vripara":null,"refs":["thag3.11:3"],"lines":["Tattha <b>saddhāyā</b>ti saddhānimittaṃ, na jīvikatthanti attho.","<b>Saddhāyā</b>ti vā kammaphalāni ratanattayaguṇañca saddahitvā.","<b>Abhinikkhammā</b>ti gharāvāsato nikkhamitvā.","<b>Navapabbajito</b>ti navo hutvā pabbajito, paṭhamavaye eva pabbajito.","<b>Navo</b>ti sāsane sikkhāya abhinavo daharo.","<b>Mitte bhajeyya kalyāṇe suddhājīve atandite</b>ti “piyo garu bhāvanīyo”tiādinā (a. ni.7.37) vuttalakkhaṇe kalyāṇamitte, micchājīvavivajjanena suddhājīve, āraddhavīriyatāya atandite bhajeyya upasaṅkameyya, tesaṃ ovādānusāsanīpaṭiggahaṇavasena seveyya.","<b>Saṅghasmiṃ viharan</b>ti saṅghe bhikkhusamūhe vattapaṭivattapūraṇavasena viharanto.","<b>Sikkhetha vinayaṃ budho</b>ti bodhañāṇatāsukusalo hutvā vinayapariyattiṃ sikkheyya.","Vinayo hi sāsanassa āyu, tasmiṃ ṭhite sāsanaṃ ṭhitaṃ hoti.","“Buddho”ti ca paṭhanti, so evattho.","<b>Kappākappesū</b>ti kappiyākappiyesu kusalo suttavasena suttānulomavasena ca nipuṇo cheko.","<b>Apurakkhato</b>ti na purakkhato taṇhādīhi kutoci purekkhāraṃ apaccāsīsanto hutvā vihareyya."],"lineRefs":[["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"]]}],"wordLinks":[["thag3.11:3.1","saddhāyā",0,0],["thag3.11:3.1","saddhāyā",0,1],["thag3.11:3.1","abhinikkhammā",0,2],["thag3.11:3.1","navapabbajito",0,3],["thag3.11:3.1","navo",0,4],["thag3.11:3.3","kappākappesū",0,10],["thag3.11:3.3","apurakkhato",0,11]],"before":[{"para":4994,"vripara":null,"refs":[],"lines":["Sāṭimattiyattheragāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":4995,"vripara":null,"refs":[],"lines":["Upālittheragāthāvaṇṇanā"],"lineRefs":[[]]},{"para":4996,"vripara":null,"refs":[],"lines":["<b>Saddhāya abhinikkhammā</b>ti āyasmato upālittherassa gāthā.","Kā uppatti?","Ayampi padumuttarassa bhagavato kāle haṃsavatīnagare kulaghare nibbatto ekadivasaṃ satthu dhammaṃ suṇanto satthāraṃ ekaṃ bhikkhuṃ vinayadharānaṃ aggaṭṭhāne ṭhapentaṃ disvā adhikārakammaṃ katvā taṃ ṭhānantaraṃ patthesi.","So yāvajīvaṃ kusalaṃ katvā devamanussesu saṃsaranto imasmiṃ buddhuppāde kappakagehe paṭisandhiṃ gaṇhi, <b>upālī</b>tissa nāmaṃ akaṃsu.","So vayappatto anuruddhādīnaṃ channaṃ khattiyānaṃ pasādako hutvā tathāgate anupiyambavane viharante pabbajanatthāya nikkhamantehi chahi khattiyehi saddhiṃ nikkhamitvā pabbaji.","Tassa pabbajjāvidhānaṃ pāḷiyaṃ āgatameva (cūḷava.330)."],"lineRefs":[[],[],[],[],[],[]]},{"para":4997,"vripara":null,"refs":[],"lines":["So pabbajitvā upasampanno satthu santike kammaṭṭhānaṃ gahetvā “mayhaṃ, bhante, araññavāsaṃ anujānāthā”ti āha.","Bhikkhu tava araññe vasantassa ekameva dhuraṃ vaḍḍhissati, amhākaṃ pana santike vasantassa ganthadhurañca vipassanādhurañca paripūressatīti.","Thero satthu vacanaṃ sampaṭicchitvā vipassanāya kammaṃ karonto nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.1.441-595)–"],"lineRefs":[[],[],[],[]]},{"para":4998,"vripara":null,"refs":[],"lines":["“Nagare haṃsavatiyā, sujāto nāma brāhmaṇo;"],"lineRefs":[[]]},{"para":4999,"vripara":null,"refs":[],"lines":["Asītikoṭinicayo, pahūtadhanadhaññavā."],"lineRefs":[[]]},{"para":5000,"vripara":null,"refs":[],"lines":["“Ajjhāyako mantadharo, tiṇṇaṃ vedāna pāragū;"],"lineRefs":[[]]},{"para":5001,"vripara":null,"refs":[],"lines":["Lakkhaṇe itihāse ca, sadhamme pāramiṃ gato."],"lineRefs":[[]]},{"para":5002,"vripara":null,"refs":[],"lines":["“Paribbājā ekasikhā, gotamā buddhasāvakā;"],"lineRefs":[[]]},{"para":5003,"vripara":null,"refs":[],"lines":["Carakā tāpasā ceva, caranti mahiyā tadā."],"lineRefs":[[]]},{"para":5004,"vripara":null,"refs":[],"lines":["“Tepi maṃ parivārenti, brāhmaṇo vissuto iti;"],"lineRefs":[[]]},{"para":5005,"vripara":null,"refs":[],"lines":["Bahujjano maṃ pūjeti, nāhaṃ pūjemi kiñcanaṃ."],"lineRefs":[[]]},{"para":5006,"vripara":null,"refs":[],"lines":["“Pūjārahaṃ na passāmi, mānatthaddho ahaṃ tadā;"],"lineRefs":[[]]},{"para":5007,"vripara":null,"refs":[],"lines":["Buddhoti vacanaṃ natthi, tāva nuppajjate jino."],"lineRefs":[[]]},{"para":5008,"vripara":null,"refs":[],"lines":["“Accayena ahorattaṃ, padumuttaranāmako;"],"lineRefs":[[]]},{"para":5009,"vripara":null,"refs":[],"lines":["Sabbaṃ tamaṃ vinodetvā, loke uppajji cakkhumā."],"lineRefs":[[]]},{"para":5010,"vripara":null,"refs":[],"lines":["“Vitthārike bāhujaññe, puthubhūte ca sāsane;"],"lineRefs":[[]]},{"para":5011,"vripara":null,"refs":[],"lines":["Upāgami tadā buddho, nagaraṃ haṃsasavhayaṃ."],"lineRefs":[[]]},{"para":5012,"vripara":null,"refs":[],"lines":["“Pitu atthāya so buddho, dhammaṃ desesi cakkhumā;"],"lineRefs":[[]]},{"para":5013,"vripara":null,"refs":[],"lines":["Tena kālena parisā, samantā yojanaṃ tadā."],"lineRefs":[[]]},{"para":5014,"vripara":null,"refs":[],"lines":["“Sammato manujānaṃ so, sunando nāma tāpaso;"],"lineRefs":[[]]},{"para":5015,"vripara":null,"refs":[],"lines":["Yāvatā buddhaparisā, pupphehacchādayī tadā."],"lineRefs":[[]]},{"para":5016,"vripara":null,"refs":[],"lines":["“Catusaccaṃ pakāsente, seṭṭhe ca pupphamaṇḍape;"],"lineRefs":[[]]},{"para":5017,"vripara":null,"refs":[],"lines":["Koṭisatasahassānaṃ, dhammābhisamayo ahu."],"lineRefs":[[]]},{"para":5018,"vripara":null,"refs":[],"lines":["“Sattarattindivaṃ buddho, vassetvā dhammavuṭṭhiyo;"],"lineRefs":[[]]},{"para":5019,"vripara":null,"refs":[],"lines":["Aṭṭhame divase patte, sunandaṃ kittayī jino."],"lineRefs":[[]]},{"para":5020,"vripara":null,"refs":[],"lines":["“Devaloke manusse vā, saṃsaranto ayaṃ bhave;"],"lineRefs":[[]]},{"para":5021,"vripara":null,"refs":[],"lines":["Sabbesaṃ pavaro hutvā, bhavesu saṃsarissati."],"lineRefs":[[]]},{"para":5022,"vripara":null,"refs":[],"lines":["“Kappasatasahassamhi, okkākakulasambhavo;"],"lineRefs":[[]]},{"para":5023,"vripara":null,"refs":[],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[[]]},{"para":5024,"vripara":null,"refs":[],"lines":["“Tassa dhammesu dāyādo, oraso dhammanimmito;"],"lineRefs":[[]]},{"para":5025,"vripara":null,"refs":[],"lines":["Mantāṇiputto puṇṇoti, hessati satthu sāvako."],"lineRefs":[[]]},{"para":5026,"vripara":null,"refs":[],"lines":["“Evaṃ kittayi sambuddho, sunandaṃ tāpasaṃ tadā;"],"lineRefs":[[]]},{"para":5027,"vripara":null,"refs":[],"lines":["Hāsayanto janaṃ sabbaṃ, dassayanto sakaṃ balaṃ."],"lineRefs":[[]]},{"para":5028,"vripara":null,"refs":[],"lines":["“Katañjalī namassanti, sunandaṃ tāpasaṃ janā;"],"lineRefs":[[]]},{"para":5029,"vripara":null,"refs":[],"lines":["Buddhe kāraṃ karitvāna, sodhesi gatimattano."],"lineRefs":[[]]},{"para":5030,"vripara":null,"refs":[],"lines":["“Tattha me ahu saṅkappo, sutvāna munino vacaṃ;"],"lineRefs":[[]]},{"para":5031,"vripara":null,"refs":[],"lines":["Ahampi kāraṃ kassāmi, yathā passāmi gotamaṃ."],"lineRefs":[[]]},{"para":5032,"vripara":null,"refs":[],"lines":["“Evāhaṃ cintayitvāna, kiriyaṃ cintayiṃ mama;"],"lineRefs":[[]]},{"para":5033,"vripara":null,"refs":[],"lines":["Kyāhaṃ kammaṃ ācarāmi, puññakkhette anuttare."],"lineRefs":[[]]},{"para":5034,"vripara":null,"refs":[],"lines":["“Ayañca pāṭhiko bhikkhu, sabbapāṭhissa sāsane;"],"lineRefs":[[]]},{"para":5035,"vripara":null,"refs":[],"lines":["Vinaye agganikkhitto, taṃ ṭhānaṃ patthaye ahaṃ."],"lineRefs":[[]]},{"para":5036,"vripara":null,"refs":[],"lines":["“Idaṃ me amitaṃ bhogaṃ, akkhobhaṃ sāgarūpamaṃ;"],"lineRefs":[[]]},{"para":5037,"vripara":null,"refs":[],"lines":["Tena bhogena buddhassa, ārāmaṃ māpaye ahaṃ."],"lineRefs":[[]]},{"para":5038,"vripara":null,"refs":[],"lines":["“Sobhanaṃ nāma ārāmaṃ, nagarassa puratthato;"],"lineRefs":[[]]},{"para":5039,"vripara":null,"refs":[],"lines":["Kiṇitvā satasahassena, saṅghārāmaṃ amāpayiṃ."],"lineRefs":[[]]},{"para":5040,"vripara":null,"refs":[],"lines":["“Kūṭāgāre ca pāsāde, maṇḍape hammiye guhā;"],"lineRefs":[[]]},{"para":5041,"vripara":null,"refs":[],"lines":["Caṅkame sukate katvā, saṅghārāmaṃ amāpayiṃ."],"lineRefs":[[]]},{"para":5042,"vripara":null,"refs":[],"lines":["“Jantāgharaṃ aggisālaṃ, atho udakamāḷakaṃ;"],"lineRefs":[[]]},{"para":5043,"vripara":null,"refs":[],"lines":["Nhānagharaṃ māpayitvā, bhikkhusaṅghassadāsahaṃ."],"lineRefs":[[]]},{"para":5044,"vripara":null,"refs":[],"lines":["“Āsandiyo pīṭhake ca, paribhoge ca bhājane;"],"lineRefs":[[]]},{"para":5045,"vripara":null,"refs":[],"lines":["Ārāmikañca bhesajjaṃ, sabbametaṃ adāsahaṃ."],"lineRefs":[[]]},{"para":5046,"vripara":null,"refs":[],"lines":["“Ārakkhaṃ paṭṭhapetvāna, pākāraṃ kārayiṃ daḷhaṃ;"],"lineRefs":[[]]},{"para":5047,"vripara":null,"refs":[],"lines":["Mā naṃ koci viheṭhesi, santacittāna tādinaṃ."],"lineRefs":[[]]},{"para":5048,"vripara":null,"refs":[],"lines":["“Satasahassenāvāsaṃ, saṅghārāme amāpayiṃ;"],"lineRefs":[[]]},{"para":5049,"vripara":null,"refs":[],"lines":["Vepullaṃ taṃ māpayitvā, sambuddhaṃ upanāmayiṃ."],"lineRefs":[[]]},{"para":5050,"vripara":null,"refs":[],"lines":["“Niṭṭhāpito mayārāmo, sampaṭiccha tuvaṃ muni;"],"lineRefs":[[]]},{"para":5051,"vripara":null,"refs":[],"lines":["Niyyādessāmi taṃ vīra, adhivāsehi cakkhuma."],"lineRefs":[[]]},{"para":5052,"vripara":null,"refs":[],"lines":["“Padumuttaro lokavidū, āhutīnaṃ paṭiggaho;"],"lineRefs":[[]]},{"para":5053,"vripara":null,"refs":[],"lines":["Mama saṅkappamaññāya, adhivāsesi nāyako."],"lineRefs":[[]]},{"para":5054,"vripara":null,"refs":[],"lines":["“Adhivāsanamaññāya, sabbaññussa mahesino;"],"lineRefs":[[]]},{"para":5055,"vripara":null,"refs":[],"lines":["Bhojanaṃ paṭiyādetvā, kālamārocayiṃ ahaṃ."],"lineRefs":[[]]},{"para":5056,"vripara":null,"refs":[],"lines":["“Ārocitamhi kālamhi, padumuttaranāyako;"],"lineRefs":[[]]},{"para":5057,"vripara":null,"refs":[],"lines":["Khīṇāsavasahassehi, ārāmaṃ me upāgami."],"lineRefs":[[]]},{"para":5058,"vripara":null,"refs":[],"lines":["“Nisinnaṃ kālamaññāya, annapānena tappayiṃ;"],"lineRefs":[[]]},{"para":5059,"vripara":null,"refs":[],"lines":["Bhuttāviṃ kālamaññāya, idaṃ vacanamabraviṃ."],"lineRefs":[[]]},{"para":5060,"vripara":null,"refs":[],"lines":["“Kīto satasahassena, tattakeneva kārito;"],"lineRefs":[[]]},{"para":5061,"vripara":null,"refs":[],"lines":["Sobhano nāma ārāmo, sampaṭiccha tuvaṃ muni."],"lineRefs":[[]]},{"para":5062,"vripara":null,"refs":[],"lines":["“Iminārāmadānena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":5063,"vripara":null,"refs":[],"lines":["Bhave nibbattamānohaṃ, labhāmi mama patthitaṃ."],"lineRefs":[[]]},{"para":5064,"vripara":null,"refs":[],"lines":["“Paṭiggahetvā sambuddho, saṅghārāmaṃ sumāpitaṃ;"],"lineRefs":[[]]},{"para":5065,"vripara":null,"refs":[],"lines":["Bhikkhusaṅghe nisīditvā, idaṃ vacanamabravi."],"lineRefs":[[]]},{"para":5066,"vripara":null,"refs":[],"lines":["“Yo so buddhassa pādāsi, saṅghārāmaṃ sumāpitaṃ;"],"lineRefs":[[]]},{"para":5067,"vripara":null,"refs":[],"lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."],"lineRefs":[[]]},{"para":5068,"vripara":null,"refs":[],"lines":["“Hatthī assā rathā pattī, senā ca caturaṅginī;"],"lineRefs":[[]]},{"para":5069,"vripara":null,"refs":[],"lines":["Parivāressantimaṃ niccaṃ, saṅghārāmassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":5070,"vripara":null,"refs":[],"lines":["“Saṭṭhi tūrasahassāni, bheriyo samalaṅkatā;"],"lineRefs":[[]]},{"para":5071,"vripara":null,"refs":[],"lines":["Parivāressantimaṃ niccaṃ, saṅghārāmassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":5072,"vripara":null,"refs":[],"lines":["“Chaḷasītisahassāni, nāriyo samalaṅkatā;"],"lineRefs":[[]]},{"para":5073,"vripara":null,"refs":[],"lines":["Vicittavatthābharaṇā, āmuttamaṇikuṇḍalā."],"lineRefs":[[]]},{"para":5074,"vripara":null,"refs":[],"lines":["“Aḷārapamhā hasulā, susaññā tanumajjhimā;"],"lineRefs":[[]]},{"para":5075,"vripara":null,"refs":[],"lines":["Parivāressantimaṃ niccaṃ, saṅghārāmassidaṃ phalaṃ."],"lineRefs":[[]]},{"para":5076,"vripara":null,"refs":[],"lines":["“Tiṃsakappasahassāni, devaloke ramissati;"],"lineRefs":[[]]},{"para":5077,"vripara":null,"refs":[],"lines":["Sahassakkhattuṃ devindo, devarajjaṃ karissati."],"lineRefs":[[]]},{"para":5078,"vripara":null,"refs":[],"lines":["“Devarājena pattabbaṃ, sabbaṃ paṭilabhissati;"],"lineRefs":[[]]},{"para":5079,"vripara":null,"refs":[],"lines":["Anūnabhogo hutvāna, devarajjaṃ karissati."],"lineRefs":[[]]},{"para":5080,"vripara":null,"refs":[],"lines":["“Sahassakkhattuṃ cakkavattī, rājā raṭṭhe bhavissati."],"lineRefs":[[]]},{"para":5081,"vripara":null,"refs":[],"lines":["Pathabyā rajjaṃ vipulaṃ, gaṇanāto asaṅkhiyaṃ."],"lineRefs":[[]]},{"para":5082,"vripara":null,"refs":[],"lines":["“Kappasatasahassamhi, okkākakulasambhavo;"],"lineRefs":[[]]},{"para":5083,"vripara":null,"refs":[],"lines":["Gotamo nāma gottena, satthā loke bhavissati."],"lineRefs":[[]]},{"para":5084,"vripara":null,"refs":[],"lines":["“Tassa dhammesu dāyādo, oraso dhammanimmito;"],"lineRefs":[[]]},{"para":5085,"vripara":null,"refs":[],"lines":["Upāli nāma nāmena, hessati satthu sāvako."],"lineRefs":[[]]},{"para":5086,"vripara":null,"refs":[],"lines":["“Vinaye pāramiṃ patvā, ṭhānāṭhāne ca kovido;"],"lineRefs":[[]]},{"para":5087,"vripara":null,"refs":[],"lines":["Jinasāsanaṃ dhārento, viharissatināsavo."],"lineRefs":[[]]},{"para":5088,"vripara":null,"refs":[],"lines":["“Sabbametaṃ abhiññāya, gotamo sakyapuṅgavo;"],"lineRefs":[[]]},{"para":5089,"vripara":null,"refs":[],"lines":["Bhikkhusaṅghe nisīditvā, etadagge ṭhapessati."],"lineRefs":[[]]},{"para":5090,"vripara":null,"refs":[],"lines":["“Aparimeyyupādāya, patthemi tava sāsanaṃ;"],"lineRefs":[[]]},{"para":5091,"vripara":null,"refs":[],"lines":["So me attho anuppatto, sabbasaṃyojanakkhayo."],"lineRefs":[[]]},{"para":5092,"vripara":null,"refs":[],"lines":["“Yathā sūlāvuto poso, rājadaṇḍena tajjito;"],"lineRefs":[[]]},{"para":5093,"vripara":null,"refs":[],"lines":["Sūle sātaṃ avindanto, parimuttiṃva icchati."],"lineRefs":[[]]},{"para":5094,"vripara":null,"refs":[],"lines":["“Tathevāhaṃ mahāvīra, bhavadaṇḍena tajjito;"],"lineRefs":[[]]},{"para":5095,"vripara":null,"refs":[],"lines":["Kammasūlāvuto santo, pipāsāvedanaṭṭito."],"lineRefs":[[]]},{"para":5096,"vripara":null,"refs":[],"lines":["“Bhave sātaṃ na vindāmi, ḍayhanto tīhi aggibhi;"],"lineRefs":[[]]},{"para":5097,"vripara":null,"refs":[],"lines":["Parimuttiṃ gavesāmi, yathāpi rājadaṇḍito."],"lineRefs":[[]]},{"para":5098,"vripara":null,"refs":[],"lines":["“Yathā visādo puriso, visena paripīḷito;"],"lineRefs":[[]]},{"para":5099,"vripara":null,"refs":[],"lines":["Agadaṃ so gaveseyya, visaghātāyupālanaṃ."],"lineRefs":[[]]},{"para":5100,"vripara":null,"refs":[],"lines":["“Gavesamāno passeyya, agadaṃ visaghātakaṃ;"],"lineRefs":[[]]},{"para":5101,"vripara":null,"refs":[],"lines":["Taṃ pivitvā sukhī assa, visamhā parimuttiyā."],"lineRefs":[[]]},{"para":5102,"vripara":null,"refs":[],"lines":["“Tathevāhaṃ mahāvīra, yathā visahato naro;"],"lineRefs":[[]]},{"para":5103,"vripara":null,"refs":[],"lines":["Sampīḷito avijjāya, saddhammāgadamesahaṃ."],"lineRefs":[[]]},{"para":5104,"vripara":null,"refs":[],"lines":["“Dhammāgadaṃ gavesanto, addakkhiṃ sakyasāsanaṃ;"],"lineRefs":[[]]},{"para":5105,"vripara":null,"refs":[],"lines":["Aggaṃ sabbosadhānaṃ taṃ, sabbasallavinodanaṃ."],"lineRefs":[[]]},{"para":5106,"vripara":null,"refs":[],"lines":["“Dhammosadhaṃ pivitvāna, visaṃ sabbaṃ samūhaniṃ;"],"lineRefs":[[]]},{"para":5107,"vripara":null,"refs":[],"lines":["Ajarāmaraṃ sītibhāvaṃ, nibbānaṃ phassayiṃ ahaṃ."],"lineRefs":[[]]},{"para":5108,"vripara":null,"refs":[],"lines":["“Yathā bhūtaṭṭito poso, bhūtaggāhena pīḷito;"],"lineRefs":[[]]},{"para":5109,"vripara":null,"refs":[],"lines":["Bhūtavejjaṃ gaveseyya, bhūtasmā parimuttiyā."],"lineRefs":[[]]},{"para":5110,"vripara":null,"refs":[],"lines":["“Gavesamāno passeyya, bhūtavijjāsu kovidaṃ;"],"lineRefs":[[]]},{"para":5111,"vripara":null,"refs":[],"lines":["Tassa so vihane bhūtaṃ, samūlañca vināsaye."],"lineRefs":[[]]},{"para":5112,"vripara":null,"refs":[],"lines":["“Tathevāhaṃ mahāvīra, tamaggāhena pīḷito;"],"lineRefs":[[]]},{"para":5113,"vripara":null,"refs":[],"lines":["Ñāṇālokaṃ gavesāmi, tamato parimuttiyā."],"lineRefs":[[]]},{"para":5114,"vripara":null,"refs":[],"lines":["“Athaddasaṃ sakyamuniṃ, kilesatamasodhanaṃ;"],"lineRefs":[[]]},{"para":5115,"vripara":null,"refs":[],"lines":["So me tamaṃ vinodesi, bhūtavejjova bhūtakaṃ."],"lineRefs":[[]]},{"para":5116,"vripara":null,"refs":[],"lines":["“Saṃsārasotaṃ sañchindiṃ, taṇhāsotaṃ nivārayiṃ;"],"lineRefs":[[]]},{"para":5117,"vripara":null,"refs":[],"lines":["Bhavaṃ ugghāṭayiṃ sabbaṃ, bhūtavejjova mūlato."],"lineRefs":[[]]},{"para":5118,"vripara":null,"refs":[],"lines":["“Garuḷo yathā opatati, pannagaṃ bhakkhamattano;"],"lineRefs":[[]]},{"para":5119,"vripara":null,"refs":[],"lines":["Samantā yojanasataṃ, vikkhobheti mahāsaraṃ."],"lineRefs":[[]]},{"para":5120,"vripara":null,"refs":[],"lines":["“Pannagaṃ so gahetvāna, adhosīsaṃ viheṭhayaṃ;"],"lineRefs":[[]]},{"para":5121,"vripara":null,"refs":[],"lines":["Ādāya so pakkamati, yenakāmaṃ vihaṅgamo."],"lineRefs":[[]]},{"para":5122,"vripara":null,"refs":[],"lines":["“Tathevāhaṃ mahāvīra, yathāpi garuḷo balī;"],"lineRefs":[[]]},{"para":5123,"vripara":null,"refs":[],"lines":["Asaṅkhataṃ gavesanto, dose vikkhālayiṃ ahaṃ."],"lineRefs":[[]]},{"para":5124,"vripara":null,"refs":[],"lines":["“Diṭṭho ahaṃ dhammavaraṃ, santipadamanuttaraṃ;"],"lineRefs":[[]]},{"para":5125,"vripara":null,"refs":[],"lines":["Ādāya viharāmetaṃ, garuḷo pannagaṃ yathā."],"lineRefs":[[]]},{"para":5126,"vripara":null,"refs":[],"lines":["“Āsāvatī nāma latā, jātā cittalatāvane;"],"lineRefs":[[]]},{"para":5127,"vripara":null,"refs":[],"lines":["Tassā vassasahassena, ekaṃ nibbattate phalaṃ."],"lineRefs":[[]]},{"para":5128,"vripara":null,"refs":[],"lines":["“Taṃ devā payirupāsanti, tāvadūraphale sati;"],"lineRefs":[[]]},{"para":5129,"vripara":null,"refs":[],"lines":["Devānaṃ sā piyā evaṃ, āsāvatī latuttamā."],"lineRefs":[[]]},{"para":5130,"vripara":null,"refs":[],"lines":["“Satasahassupādāya, tāhaṃ paricare muni;"],"lineRefs":[[]]},{"para":5131,"vripara":null,"refs":[],"lines":["Sāyaṃ pātaṃ namassāmi, devā āsāvatiṃ yathā."],"lineRefs":[[]]},{"para":5132,"vripara":null,"refs":[],"lines":["“Avañjhā pāricariyā, amoghā ca namassanā;"],"lineRefs":[[]]},{"para":5133,"vripara":null,"refs":[],"lines":["Dūrāgatampi maṃ santaṃ, khaṇoyaṃ na virādhayi."],"lineRefs":[[]]},{"para":5134,"vripara":null,"refs":[],"lines":["“Paṭisandhiṃ na passāmi, vicinanto bhave ahaṃ;"],"lineRefs":[[]]},{"para":5135,"vripara":null,"refs":[],"lines":["Nirūpadhi vippamutto, upasanto carāmahaṃ."],"lineRefs":[[]]},{"para":5136,"vripara":null,"refs":[],"lines":["“Yathāpi padumaṃ nāma, sūriyaraṃsena pupphati;"],"lineRefs":[[]]},{"para":5137,"vripara":null,"refs":[],"lines":["Tathevāhaṃ mahāvīra, buddharaṃsena pupphito."],"lineRefs":[[]]},{"para":5138,"vripara":null,"refs":[],"lines":["“Yathā balākayonimhi, na vijjati pumo sadā;"],"lineRefs":[[]]},{"para":5139,"vripara":null,"refs":[],"lines":["Meghesu gajjamānesu, gabbhaṃ gaṇhanti tā sadā."],"lineRefs":[[]]},{"para":5140,"vripara":null,"refs":[],"lines":["“Cirampi gabbhaṃ dhārenti, yāva megho na gajjati;"],"lineRefs":[[]]},{"para":5141,"vripara":null,"refs":[],"lines":["Bhārato parimuccanti, yadā megho pavassati."],"lineRefs":[[]]},{"para":5142,"vripara":null,"refs":[],"lines":["“Padumuttarabuddhassa, dhammameghena gajjato;"],"lineRefs":[[]]},{"para":5143,"vripara":null,"refs":[],"lines":["Saddena dhammameghassa, dhammagabbhaṃ agaṇhahaṃ."],"lineRefs":[[]]},{"para":5144,"vripara":null,"refs":[],"lines":["“Satasahassupādāya, puññagabbhaṃ dharemahaṃ;"],"lineRefs":[[]]},{"para":5145,"vripara":null,"refs":[],"lines":["Nappamuccāmi bhārato, dhammamegho na gajjati."],"lineRefs":[[]]},{"para":5146,"vripara":null,"refs":[],"lines":["“Yadā tuvaṃ sakyamuni, ramme kapilavatthave;"],"lineRefs":[[]]},{"para":5147,"vripara":null,"refs":[],"lines":["Gajjasi dhammameghena, bhārato parimuccahaṃ."],"lineRefs":[[]]},{"para":5148,"vripara":null,"refs":[],"lines":["“Suññataṃ animittañca, tathāppaṇihitampi ca;"],"lineRefs":[[]]},{"para":5149,"vripara":null,"refs":[],"lines":["Caturo ca phale sabbe, dhammevaṃ vijanayiṃ ahaṃ."],"lineRefs":[[]]},{"para":5150,"vripara":null,"refs":[],"lines":["“Aparimeyyupādāya, patthemi tava sāsanaṃ;"],"lineRefs":[[]]},{"para":5151,"vripara":null,"refs":[],"lines":["So me attho anuppatto, santipadamanuttaraṃ."],"lineRefs":[[]]},{"para":5152,"vripara":null,"refs":[],"lines":["“Vinaye pāramiṃ patto, yathāpi pāṭhiko isi;"],"lineRefs":[[]]},{"para":5153,"vripara":null,"refs":[],"lines":["Na me samasamo atthi, dhāremi sāsanaṃ ahaṃ."],"lineRefs":[[]]},{"para":5154,"vripara":null,"refs":[],"lines":["“Vinaye khandhake cāpi, tikacchede ca pañcake;"],"lineRefs":[[]]},{"para":5155,"vripara":null,"refs":[],"lines":["Ettha me vimati natthi, akkhare byañjanepi vā."],"lineRefs":[[]]},{"para":5156,"vripara":null,"refs":[],"lines":["“Niggahe paṭikamme ca, ṭhānāṭhāne ca kovido;"],"lineRefs":[[]]},{"para":5157,"vripara":null,"refs":[],"lines":["Osāraṇe vuṭṭhāpane, sabbattha pāramiṃ gato."],"lineRefs":[[]]},{"para":5158,"vripara":null,"refs":[],"lines":["“Vinaye khandhake vāpi, nikkhipitvā padaṃ ahaṃ;"],"lineRefs":[[]]},{"para":5159,"vripara":null,"refs":[],"lines":["Ubhato viniveṭhetvā, rasato osareyyahaṃ."],"lineRefs":[[]]},{"para":5160,"vripara":null,"refs":[],"lines":["“Niruttiyā sukusalo, atthānatthe ca kovido;"],"lineRefs":[[]]},{"para":5161,"vripara":null,"refs":[],"lines":["Anaññātaṃ mayā natthi, ekaggo satthu sāsane."],"lineRefs":[[]]},{"para":5162,"vripara":null,"refs":[],"lines":["“Rūpadakkho ahaṃ ajja, sakyaputtassa sāsane;"],"lineRefs":[[]]},{"para":5163,"vripara":null,"refs":[],"lines":["Kaṅkhaṃ sabbaṃ vinodemi, chindāmi sabbasaṃsayaṃ."],"lineRefs":[[]]},{"para":5164,"vripara":null,"refs":[],"lines":["“Padaṃ anupadañcāpi, akkharañcāpi byañjanaṃ;"],"lineRefs":[[]]},{"para":5165,"vripara":null,"refs":[],"lines":["Nidāne pariyosāne, sabbattha kovido ahaṃ."],"lineRefs":[[]]},{"para":5166,"vripara":null,"refs":[],"lines":["“Yathāpi rājā balavā, niggaṇhitvā parantape;"],"lineRefs":[[]]},{"para":5167,"vripara":null,"refs":[],"lines":["Vijinitvāna saṅgāmaṃ, nagaraṃ tattha māpaye."],"lineRefs":[[]]},{"para":5168,"vripara":null,"refs":[],"lines":["“Pākāraṃ parikhañcāpi, esikaṃ dvārakoṭṭhakaṃ;"],"lineRefs":[[]]},{"para":5169,"vripara":null,"refs":[],"lines":["Aṭṭālake ca vividhe, kāraye nagare bahū."],"lineRefs":[[]]},{"para":5170,"vripara":null,"refs":[],"lines":["“Siṅghāṭakaṃ caccarañca, suvibhattantarāpaṇaṃ;"],"lineRefs":[[]]},{"para":5171,"vripara":null,"refs":[],"lines":["Kārayeyya sabhaṃ tattha, atthānatthavinicchayaṃ."],"lineRefs":[[]]},{"para":5172,"vripara":null,"refs":[],"lines":["“Nigghātatthaṃ amittānaṃ, chiddāchiddañca jānituṃ;"],"lineRefs":[[]]},{"para":5173,"vripara":null,"refs":[],"lines":["Balakāyassa rakkhāya, senāpaccaṃ ṭhapeti so."],"lineRefs":[[]]},{"para":5174,"vripara":null,"refs":[],"lines":["“Ārakkhatthāya bhaṇḍassa, nidhānakusalaṃ naraṃ;"],"lineRefs":[[]]},{"para":5175,"vripara":null,"refs":[],"lines":["Mā me bhaṇḍaṃ vinassīti, bhaṇḍarakkhaṃ ṭhapeti so."],"lineRefs":[[]]},{"para":5176,"vripara":null,"refs":[],"lines":["“Mamatto hoti yo rañño, vuddhiṃ yassa ca icchati;"],"lineRefs":[[]]},{"para":5177,"vripara":null,"refs":[],"lines":["Tassādhikaraṇaṃ deti, mittassa paṭipajjituṃ."],"lineRefs":[[]]},{"para":5178,"vripara":null,"refs":[],"lines":["“Uppātesu nimittesu, lakkhaṇesu ca kovidaṃ;"],"lineRefs":[[]]},{"para":5179,"vripara":null,"refs":[],"lines":["Ajjhāyakaṃ mantadharaṃ, porohicce ṭhapeti so."],"lineRefs":[[]]},{"para":5180,"vripara":null,"refs":[],"lines":["“Etehaṅgehi sampanno, khattiyoti pavuccati;"],"lineRefs":[[]]},{"para":5181,"vripara":null,"refs":[],"lines":["Sadā rakkhanti rājānaṃ, cakkavākova dukkhitaṃ."],"lineRefs":[[]]},{"para":5182,"vripara":null,"refs":[],"lines":["“Tatheva tvaṃ mahāvīra, hatāmittova khattiyo;"],"lineRefs":[[]]},{"para":5183,"vripara":null,"refs":[],"lines":["Sadevakassa lokassa, dhammarājāti vuccati."],"lineRefs":[[]]},{"para":5184,"vripara":null,"refs":[],"lines":["“Titthiye nihanitvāna, mārañcāpi sasenakaṃ;"],"lineRefs":[[]]},{"para":5185,"vripara":null,"refs":[],"lines":["Tamandhakāraṃ vidhamitvā, dhammanagaraṃ amāpayi."],"lineRefs":[[]]},{"para":5186,"vripara":null,"refs":[],"lines":["“Sīlaṃ pākārakaṃ tattha, ñāṇaṃ te dvārakoṭṭhakaṃ;"],"lineRefs":[[]]},{"para":5187,"vripara":null,"refs":[],"lines":["Saddhā te esikā vīra, dvārapālo ca saṃvaro."],"lineRefs":[[]]},{"para":5188,"vripara":null,"refs":[],"lines":["“Satipaṭṭhānamaṭṭālaṃ, paññā te caccaraṃ mune;"],"lineRefs":[[]]},{"para":5189,"vripara":null,"refs":[],"lines":["Iddhipādañca siṅghāṭaṃ, dhammavīthi sumāpitā."],"lineRefs":[[]]},{"para":5190,"vripara":null,"refs":[],"lines":["“Suttantaṃ abhidhammañca, vinayañcāpi kevalaṃ;"],"lineRefs":[[]]},{"para":5191,"vripara":null,"refs":[],"lines":["Navaṅgaṃ buddhavacanaṃ, esā dhammasabhā tava."],"lineRefs":[[]]},{"para":5192,"vripara":null,"refs":[],"lines":["“Suññataṃ animittañca, vihārañcappaṇīhitaṃ;"],"lineRefs":[[]]},{"para":5193,"vripara":null,"refs":[],"lines":["Āneñjañca nirodho ca, esā dhammakuṭī tava."],"lineRefs":[[]]},{"para":5194,"vripara":null,"refs":[],"lines":["“Paññāya aggo nikkhitto, paṭibhāne ca kovido;"],"lineRefs":[[]]},{"para":5195,"vripara":null,"refs":[],"lines":["Sāriputtoti nāmena, dhammasenāpatī tava."],"lineRefs":[[]]},{"para":5196,"vripara":null,"refs":[],"lines":["“Cutūpapātakusalo, iddhiyā pāramiṃ gato;"],"lineRefs":[[]]},{"para":5197,"vripara":null,"refs":[],"lines":["Kolito nāma nāmena, porohicco tavaṃ mune."],"lineRefs":[[]]},{"para":5198,"vripara":null,"refs":[],"lines":["“Porāṇakavaṃsadharo, uggatejo durāsado;"],"lineRefs":[[]]},{"para":5199,"vripara":null,"refs":[],"lines":["Dhutavādīguṇenaggo, akkhadasso tavaṃ mune."],"lineRefs":[[]]},{"para":5200,"vripara":null,"refs":[],"lines":["“Bahussuto dhammadharo, sabbapāṭhī ca sāsane;"],"lineRefs":[[]]},{"para":5201,"vripara":null,"refs":[],"lines":["Ānando nāma nāmena, dhammārakkho tavaṃ mune."],"lineRefs":[[]]},{"para":5202,"vripara":null,"refs":[],"lines":["“Ete sabbe atikkamma, pamesi bhagavā mamaṃ;"],"lineRefs":[[]]},{"para":5203,"vripara":null,"refs":[],"lines":["Vinicchayaṃ me pādāsi, vinaye viññudesitaṃ."],"lineRefs":[[]]},{"para":5204,"vripara":null,"refs":[],"lines":["“Yo koci vinaye pañhaṃ, pucchati buddhasāvako;"],"lineRefs":[[]]},{"para":5205,"vripara":null,"refs":[],"lines":["Tattha me cintanā natthi, taññevatthaṃ kathemahaṃ."],"lineRefs":[[]]},{"para":5206,"vripara":null,"refs":[],"lines":["“Yāvatā buddhakhettamhi, ṭhapetvā taṃ mahāmuni;"],"lineRefs":[[]]},{"para":5207,"vripara":null,"refs":[],"lines":["Vinaye mādiso natthi, kuto bhiyyo bhavissati."],"lineRefs":[[]]},{"para":5208,"vripara":null,"refs":[],"lines":["“Bhikkhusaṅghe nisīditvā, evaṃ gajjati gotamo;"],"lineRefs":[[]]},{"para":5209,"vripara":null,"refs":[],"lines":["Upālissa samo natthi, vinaye khandhakesu ca."],"lineRefs":[[]]},{"para":5210,"vripara":null,"refs":[],"lines":["“Yāvatā buddhabhaṇitaṃ, navaṅgaṃ satthusāsanaṃ;"],"lineRefs":[[]]},{"para":5211,"vripara":null,"refs":[],"lines":["Vinayogadhaṃ taṃ sabbaṃ, vinayamūlapassino."],"lineRefs":[[]]},{"para":5212,"vripara":null,"refs":[],"lines":["“Mama kammaṃ saritvāna, gotamo sakyapuṅgavo;"],"lineRefs":[[]]},{"para":5213,"vripara":null,"refs":[],"lines":["Bhikkhusaṅghe nisīditvā, etadagge ṭhapesi maṃ."],"lineRefs":[[]]},{"para":5214,"vripara":null,"refs":[],"lines":["“Satasahassupādāya, imaṃ ṭhānaṃ apatthayiṃ;"],"lineRefs":[[]]},{"para":5215,"vripara":null,"refs":[],"lines":["So me attho anuppatto, vinaye pāramiṃ gato."],"lineRefs":[[]]},{"para":5216,"vripara":null,"refs":[],"lines":["“Sakyānaṃ nandijanano, kappako āsahaṃ pure;"],"lineRefs":[[]]},{"para":5217,"vripara":null,"refs":[],"lines":["Vijahitvāna taṃ jātiṃ, putto jāto mahesino."],"lineRefs":[[]]},{"para":5218,"vripara":null,"refs":[],"lines":["“Ito dutiyake kappe, añjaso nāma khattiyo;"],"lineRefs":[[]]},{"para":5219,"vripara":null,"refs":[],"lines":["Anantatejo amitayaso, bhūmipālo mahaddhano."],"lineRefs":[[]]},{"para":5220,"vripara":null,"refs":[],"lines":["“Tassa rañño ahaṃ putto, candano nāma khattiyo;"],"lineRefs":[[]]},{"para":5221,"vripara":null,"refs":[],"lines":["Jātimadenupatthaddho, yasabhogamadena ca."],"lineRefs":[[]]},{"para":5222,"vripara":null,"refs":[],"lines":["“Nāgasatasahassāni, sabbālaṅkārabhūsitā;"],"lineRefs":[[]]},{"para":5223,"vripara":null,"refs":[],"lines":["Tidhāpabhinnā mātaṅgā, parivārenti maṃ sadā."],"lineRefs":[[]]},{"para":5224,"vripara":null,"refs":[],"lines":["“Sabalehi paretohaṃ, uyyānaṃ gantukāmako;"],"lineRefs":[[]]},{"para":5225,"vripara":null,"refs":[],"lines":["Āruyha sirikaṃ nāgaṃ, nagarā nikkhamiṃ tadā."],"lineRefs":[[]]},{"para":5226,"vripara":null,"refs":[],"lines":["“Caraṇena ca sampanno, guttadvāro susaṃvuto;"],"lineRefs":[[]]},{"para":5227,"vripara":null,"refs":[],"lines":["Devalo nāma sambuddho, āgacchi purato mama."],"lineRefs":[[]]},{"para":5228,"vripara":null,"refs":[],"lines":["“Pesetvā sirikaṃ nāgaṃ, buddhaṃ āsādayiṃ tadā;"],"lineRefs":[[]]},{"para":5229,"vripara":null,"refs":[],"lines":["Tato sañjātakopo so, nāgo nuddharate padaṃ."],"lineRefs":[[]]},{"para":5230,"vripara":null,"refs":[],"lines":["“Nāgaṃ ruṇṇamanaṃ disvā, buddhe kodhaṃ akāsahaṃ;"],"lineRefs":[[]]},{"para":5231,"vripara":null,"refs":[],"lines":["Vihesayitvā sambuddhaṃ, uyyānaṃ agamāsahaṃ."],"lineRefs":[[]]},{"para":5232,"vripara":null,"refs":[],"lines":["“Sātaṃ tattha na vindāmi, siro pajjalito yathā;"],"lineRefs":[[]]},{"para":5233,"vripara":null,"refs":[],"lines":["Pariḷāhena ḍayhāmi, macchova baḷisādako."],"lineRefs":[[]]},{"para":5234,"vripara":null,"refs":[],"lines":["“Sasāgarantā pathavī, ādittā viya hoti me;"],"lineRefs":[[]]},{"para":5235,"vripara":null,"refs":[],"lines":["Pitu santikupāgamma, idaṃ vacanamabraviṃ."],"lineRefs":[[]]},{"para":5236,"vripara":null,"refs":[],"lines":["“Āsīvisaṃva kupitaṃ, aggikkhandhaṃva āgataṃ;"],"lineRefs":[[]]},{"para":5237,"vripara":null,"refs":[],"lines":["Mattaṃva kuñjaraṃ dantiṃ, yaṃ sayambhumasādayiṃ."],"lineRefs":[[]]},{"para":5238,"vripara":null,"refs":[],"lines":["“Āsādito mayā buddho, ghoro uggatapo jino;"],"lineRefs":[[]]},{"para":5239,"vripara":null,"refs":[],"lines":["Purā sabbe vinassāma, khamāpessāma taṃ muniṃ."],"lineRefs":[[]]},{"para":5240,"vripara":null,"refs":[],"lines":["“No ce taṃ nijjhāpessāma, attadantaṃ samāhitaṃ;"],"lineRefs":[[]]},{"para":5241,"vripara":null,"refs":[],"lines":["Orena sattadivasā, raṭṭhaṃ me vidhamissati."],"lineRefs":[[]]},{"para":5242,"vripara":null,"refs":[],"lines":["“Sumekhalo kosiyo ca, siggavo cāpi sattako;"],"lineRefs":[[]]},{"para":5243,"vripara":null,"refs":[],"lines":["Āsādayitvā isayo, duggatā te saraṭṭhakā."],"lineRefs":[[]]},{"para":5244,"vripara":null,"refs":[],"lines":["“Yadā kuppanti isayo, saññatā brahmacārino;"],"lineRefs":[[]]},{"para":5245,"vripara":null,"refs":[],"lines":["Sadevakaṃ vināsenti, sasāgaraṃ sapabbataṃ."],"lineRefs":[[]]},{"para":5246,"vripara":null,"refs":[],"lines":["“Tiyojanasahassamhi, purise sannipātayiṃ;"],"lineRefs":[[]]},{"para":5247,"vripara":null,"refs":[],"lines":["Accayaṃ desanatthāya, sayambhuṃ upasaṅkamiṃ."],"lineRefs":[[]]},{"para":5248,"vripara":null,"refs":[],"lines":["“Allavatthā allasirā, sabbeva pañjalīkatā;"],"lineRefs":[[]]},{"para":5249,"vripara":null,"refs":[],"lines":["Buddhassa pāde nipatitvā, idaṃ vacanamabravuṃ."],"lineRefs":[[]]},{"para":5250,"vripara":null,"refs":[],"lines":["“Khamassu tvaṃ mahāvīra, abhiyācati taṃ jano;"],"lineRefs":[[]]},{"para":5251,"vripara":null,"refs":[],"lines":["Pariḷāhaṃ vinodehi, mā no raṭṭhaṃ vināsaya."],"lineRefs":[[]]},{"para":5252,"vripara":null,"refs":[],"lines":["“Sadevamānusā sabbe, sadānavā sarakkhasā;"],"lineRefs":[[]]},{"para":5253,"vripara":null,"refs":[],"lines":["Ayomayena kūṭena, siraṃ bhindeyyu me sadā."],"lineRefs":[[]]},{"para":5254,"vripara":null,"refs":[],"lines":["“Dake aggi na saṇṭhāti, bījaṃ sele na rūhati;"],"lineRefs":[[]]},{"para":5255,"vripara":null,"refs":[],"lines":["Agade kimi na saṇṭhāti, kopo buddhe na jāyati."],"lineRefs":[[]]},{"para":5256,"vripara":null,"refs":[],"lines":["“Yathā ca bhūmi acalā, appameyyo ca sāgaro;"],"lineRefs":[[]]},{"para":5257,"vripara":null,"refs":[],"lines":["Anantako ca ākāso, evaṃ buddhā akhobhiyā."],"lineRefs":[[]]},{"para":5258,"vripara":null,"refs":[],"lines":["“Sadā khantā mahāvīrā, khamitā ca tapassino;"],"lineRefs":[[]]},{"para":5259,"vripara":null,"refs":[],"lines":["Khantānaṃ khamitānañca, gamanaṃ taṃ na vijjati."],"lineRefs":[[]]},{"para":5260,"vripara":null,"refs":[],"lines":["“Idaṃ vatvāna sambuddho, pariḷāhaṃ vinodayaṃ;"],"lineRefs":[[]]},{"para":5261,"vripara":null,"refs":[],"lines":["Mahājanassa purato, nabhaṃ abbhuggamī tadā."],"lineRefs":[[]]},{"para":5262,"vripara":null,"refs":[],"lines":["“Tena kammenahaṃ vīra, hīnattaṃ ajjhupāgato;"],"lineRefs":[[]]},{"para":5263,"vripara":null,"refs":[],"lines":["Samatikkamma taṃ jātiṃ, pāvisiṃ abhayaṃ puraṃ."],"lineRefs":[[]]},{"para":5264,"vripara":null,"refs":[],"lines":["“Tadāpi maṃ mahāvīra, ḍayhamānaṃ susaṇṭhitaṃ;"],"lineRefs":[[]]},{"para":5265,"vripara":null,"refs":[],"lines":["Pariḷāhaṃ vinodesi, sayambhuñca khamāpayiṃ."],"lineRefs":[[]]},{"para":5266,"vripara":null,"refs":[],"lines":["“Ajjāpi maṃ mahāvīra, ḍayhamānaṃ tihaggibhi;"],"lineRefs":[[]]},{"para":5267,"vripara":null,"refs":[],"lines":["Nibbāpesi tayo aggī, sītibhāvañca pāpayiṃ."],"lineRefs":[[]]},{"para":5268,"vripara":null,"refs":[],"lines":["“Yesaṃ sotāvadhānatthi, suṇātha mama bhāsato;"],"lineRefs":[[]]},{"para":5269,"vripara":null,"refs":[],"lines":["Atthaṃ tuyhaṃ pavakkhāmi, yathā diṭṭhaṃ padaṃ mama."],"lineRefs":[[]]},{"para":5270,"vripara":null,"refs":[],"lines":["“Sayambhuṃ taṃ vimānetvā, santacittaṃ samāhitaṃ;"],"lineRefs":[[]]},{"para":5271,"vripara":null,"refs":[],"lines":["Tena kammenahaṃ ajja, jātomhi nīcayoniyaṃ."],"lineRefs":[[]]},{"para":5272,"vripara":null,"refs":[],"lines":["“Mā vo khaṇaṃ virādhetha, khaṇātītā hi socare;"],"lineRefs":[[]]},{"para":5273,"vripara":null,"refs":[],"lines":["Sadatthe vāyameyyātha, khaṇo vo paṭipādito."],"lineRefs":[[]]},{"para":5274,"vripara":null,"refs":[],"lines":["“Ekaccānañca vamanaṃ, ekaccānaṃ virecanaṃ;"],"lineRefs":[[]]},{"para":5275,"vripara":null,"refs":[],"lines":["Visaṃ halāhalaṃ eke, ekaccānañca osadhaṃ."],"lineRefs":[[]]},{"para":5276,"vripara":null,"refs":[],"lines":["“Vamanaṃ paṭipannānaṃ, phalaṭṭhānaṃ virecanaṃ;"],"lineRefs":[[]]},{"para":5277,"vripara":null,"refs":[],"lines":["Osadhaṃ phalalābhīnaṃ, puññakkhettaṃ gavesinaṃ."],"lineRefs":[[]]},{"para":5278,"vripara":null,"refs":[],"lines":["“Sāsanena viruddhānaṃ, visaṃ halāhalaṃ yathā;"],"lineRefs":[[]]},{"para":5279,"vripara":null,"refs":[],"lines":["Āsīviso diṭṭhaviso, evaṃ jhāpeti taṃ naraṃ."],"lineRefs":[[]]},{"para":5280,"vripara":null,"refs":[],"lines":["“Sakiṃ pītaṃ halāhalaṃ, uparundhati jīvitaṃ;"],"lineRefs":[[]]},{"para":5281,"vripara":null,"refs":[],"lines":["Sāsanena virujjhitvā, kappakoṭimhi ḍayhati."],"lineRefs":[[]]},{"para":5282,"vripara":null,"refs":[],"lines":["“Khantiyā avihiṃsāya, mettacittavatāya ca;"],"lineRefs":[[]]},{"para":5283,"vripara":null,"refs":[],"lines":["Sadevakaṃ so tāreti, tasmā te avirādhiyā."],"lineRefs":[[]]},{"para":5284,"vripara":null,"refs":[],"lines":["“Lābhālābhe na sajjanti, sammānanavimānane;"],"lineRefs":[[]]},{"para":5285,"vripara":null,"refs":[],"lines":["Pathavīsadisā buddhā, tasmā te na virādhiyā."],"lineRefs":[[]]},{"para":5286,"vripara":null,"refs":[],"lines":["“Devadatte ca vadhake, core aṅgulimālake;"],"lineRefs":[[]]},{"para":5287,"vripara":null,"refs":[],"lines":["Rāhule dhanapāle ca, sabbesaṃ samako muni."],"lineRefs":[[]]},{"para":5288,"vripara":null,"refs":[],"lines":["“Etesaṃ paṭigho natthi, rāgomesaṃ na vijjati;"],"lineRefs":[[]]},{"para":5289,"vripara":null,"refs":[],"lines":["Sabbesaṃ samako buddho, vadhakassorasassa ca."],"lineRefs":[[]]},{"para":5290,"vripara":null,"refs":[],"lines":["“Panthe disvāna kāsāvaṃ, chaḍḍitaṃ mīḷhamakkhitaṃ;"],"lineRefs":[[]]},{"para":5291,"vripara":null,"refs":[],"lines":["Sirasmiṃ añjaliṃ katvā, vanditabbaṃ isiddhajaṃ."],"lineRefs":[[]]},{"para":5292,"vripara":null,"refs":[],"lines":["“Abbhatītā ca ye buddhā, vattamānā anāgatā;"],"lineRefs":[[]]},{"para":5293,"vripara":null,"refs":[],"lines":["Dhajenānena sujjhanti, tasmā ete namassiyā."],"lineRefs":[[]]},{"para":5294,"vripara":null,"refs":[],"lines":["“Satthukappaṃ suvinayaṃ, dhāremi hadayenahaṃ;"],"lineRefs":[[]]},{"para":5295,"vripara":null,"refs":[],"lines":["Namassamāno vinayaṃ, viharissāmi sabbadā."],"lineRefs":[[]]},{"para":5296,"vripara":null,"refs":[],"lines":["“Vinayo āsayo mayhaṃ, vinayo ṭhānacaṅkamaṃ;"],"lineRefs":[[]]},{"para":5297,"vripara":null,"refs":[],"lines":["Kappemi vinaye vāsaṃ, vinayo mama gocaro."],"lineRefs":[[]]},{"para":5298,"vripara":null,"refs":[],"lines":["“Vinaye pāramippatto, samathe cāpi kovido;"],"lineRefs":[[]]},{"para":5299,"vripara":null,"refs":[],"lines":["Upāli taṃ mahāvīra, pāde vandati satthuno."],"lineRefs":[[]]},{"para":5300,"vripara":null,"refs":[],"lines":["“So ahaṃ vicarissāmi, gāmā gāmaṃ purā puraṃ;"],"lineRefs":[[]]},{"para":5301,"vripara":null,"refs":[],"lines":["Namassamāno sambuddhaṃ, dhammassa ca sudhammataṃ."],"lineRefs":[[]]},{"para":5302,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":5303,"vripara":null,"refs":[],"lines":["Tattha hi naṃ satthā sayameva sakalaṃ vinayapiṭakaṃ uggaṇhāpesi.","So aparabhāge bhārukacchakavatthuṃ (pārā.78) ajjukavatthuṃ (pārā.158) kumārakassapavatthunti imāni tīṇi vatthūni vinicchayi.","Satthā ekekasmiṃ vinicchite sādhukāraṃ datvā tayopi vinicchaye aṭṭhuppattiṃ katvā theraṃ vinayadharānaṃ aggaṭṭhāne ṭhapesi.","So aparabhāge ekasmiṃ uposathadivase pātimokkhuddesasamaye bhikkhū ovadanto –"],"lineRefs":[[],[],[],[]]},{"para":5305,"vripara":"249","refs":[],"lines":["“Saddhāya abhinikkhamma, navapabbajito navo;"],"lineRefs":[[]]},{"para":5306,"vripara":null,"refs":[],"lines":["Mitte bhajeyya kalyāṇe, suddhājīve atandite."],"lineRefs":[[]]},{"para":5308,"vripara":"250","refs":[],"lines":["“Saddhāya abhinikkhamma, navapabbajito navo;"],"lineRefs":[[]]},{"para":5309,"vripara":null,"refs":[],"lines":["Saṅghasmiṃ viharaṃ bhikkhu, sikkhetha vinayaṃ budho."],"lineRefs":[[]]},{"para":5311,"vripara":"251","refs":[],"lines":["“Saddhāya abhinikkhamma, navapabbajito navo;"],"lineRefs":[[]]},{"para":5312,"vripara":null,"refs":[],"lines":["Kappākappesu kusalo, careyya apurakkhato”ti.","– tisso gāthā abhāsi;"],"lineRefs":[[],[]]}]},"tika":null,"tika2":null}
