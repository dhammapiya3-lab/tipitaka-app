{"suttaId":"thag3.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1251,1260],"vripara":"249"},"segments":{"thag3.11:0.4":"Upālittheragāthā","thag3.11:1.1":"“Saddhāya abhinikkhamma,","thag3.11:1.2":"navapabbajito navo;","thag3.11:1.3":"Mitte bhajeyya kalyāṇe,","thag3.11:1.4":"suddhājīve atandite.","thag3.11:2.1":"“Saddhāya abhinikkhamma,","thag3.11:2.2":"navapabbajito navo;","thag3.11:2.3":"Saṅghasmiṃ viharaṃ bhikkhu,","thag3.11:2.4":"sikkhetha vinayaṃ budho.","thag3.11:3.1":"“Saddhāya abhinikkhamma,","thag3.11:3.2":"navapabbajito navo;","thag3.11:3.3":"Kappākappesu kusalo,","thag3.11:3.4":"careyya apurakkhato”ti.","thag3.11:3.5":"… Upālitthero …."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":5313,"to":5313,"paras":[{"para":5313,"vripara":null,"refs":["thag3.11:3"],"lines":["Tattha <b>saddhāyā</b>ti saddhānimittaṃ, na jīvikatthanti attho.","<b>Saddhāyā</b>ti vā kammaphalāni ratanattayaguṇañca saddahitvā.","<b>Abhinikkhammā</b>ti gharāvāsato nikkhamitvā.","<b>Navapabbajito</b>ti navo hutvā pabbajito, paṭhamavaye eva pabbajito.","<b>Navo</b>ti sāsane sikkhāya abhinavo daharo.","<b>Mitte bhajeyya kalyāṇe suddhājīve atandite</b>ti “piyo garu bhāvanīyo”tiādinā (a. ni.7.37) vuttalakkhaṇe kalyāṇamitte, micchājīvavivajjanena suddhājīve, āraddhavīriyatāya atandite bhajeyya upasaṅkameyya, tesaṃ ovādānusāsanīpaṭiggahaṇavasena seveyya.","<b>Saṅghasmiṃ viharan</b>ti saṅghe bhikkhusamūhe vattapaṭivattapūraṇavasena viharanto.","<b>Sikkhetha vinayaṃ budho</b>ti bodhañāṇatāsukusalo hutvā vinayapariyattiṃ sikkheyya.","Vinayo hi sāsanassa āyu, tasmiṃ ṭhite sāsanaṃ ṭhitaṃ hoti.","“Buddho”ti ca paṭhanti, so evattho.","<b>Kappākappesū</b>ti kappiyākappiyesu kusalo suttavasena suttānulomavasena ca nipuṇo cheko.","<b>Apurakkhato</b>ti na purakkhato taṇhādīhi kutoci purekkhāraṃ apaccāsīsanto hutvā vihareyya."],"lineRefs":[["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"],["thag3.11:3"]]}],"wordLinks":[["thag3.11:3.1","saddhāyā",0,0],["thag3.11:3.1","saddhāyā",0,1],["thag3.11:3.1","abhinikkhammā",0,2],["thag3.11:3.1","navapabbajito",0,3],["thag3.11:3.1","navo",0,4],["thag3.11:3.3","kappākappesū",0,10],["thag3.11:3.3","apurakkhato",0,11]],"before":[{"para":4995,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Upālittheragāthāvaṇṇanā"]},{"para":4996,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["<b>Saddhāya abhinikkhammā</b>ti āyasmato upālittherassa gāthā.","Kā uppatti?","Ayampi padumuttarassa bhagavato kāle haṃsavatīnagare kulaghare nibbatto ekadivasaṃ satthu dhammaṃ suṇanto satthāraṃ ekaṃ bhikkhuṃ vinayadharānaṃ aggaṭṭhāne ṭhapentaṃ disvā adhikārakammaṃ katvā taṃ ṭhānantaraṃ patthesi.","So yāvajīvaṃ kusalaṃ katvā devamanussesu saṃsaranto imasmiṃ buddhuppāde kappakagehe paṭisandhiṃ gaṇhi, <b>upālī</b>tissa nāmaṃ akaṃsu.","So vayappatto anuruddhādīnaṃ channaṃ khattiyānaṃ pasādako hutvā tathāgate anupiyambavane viharante pabbajanatthāya nikkhamantehi chahi khattiyehi saddhiṃ nikkhamitvā pabbaji.","Tassa pabbajjāvidhānaṃ pāḷiyaṃ āgatameva (cūḷava.330)."]},{"para":4997,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["So pabbajitvā upasampanno satthu santike kammaṭṭhānaṃ gahetvā “mayhaṃ, bhante, araññavāsaṃ anujānāthā”ti āha.","Bhikkhu tava araññe vasantassa ekameva dhuraṃ vaḍḍhissati, amhākaṃ pana santike vasantassa ganthadhurañca vipassanādhurañca paripūressatīti.","Thero satthu vacanaṃ sampaṭicchitvā vipassanāya kammaṃ karonto nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.1.441-595)–"]},{"para":4998,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Nagare haṃsavatiyā, sujāto nāma brāhmaṇo;"]},{"para":4999,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Asītikoṭinicayo, pahūtadhanadhaññavā."]},{"para":5000,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Ajjhāyako mantadharo, tiṇṇaṃ vedāna pāragū;"]},{"para":5001,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Lakkhaṇe itihāse ca, sadhamme pāramiṃ gato."]},{"para":5002,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Paribbājā ekasikhā, gotamā buddhasāvakā;"]},{"para":5003,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Carakā tāpasā ceva, caranti mahiyā tadā."]},{"para":5004,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tepi maṃ parivārenti, brāhmaṇo vissuto iti;"]},{"para":5005,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Bahujjano maṃ pūjeti, nāhaṃ pūjemi kiñcanaṃ."]},{"para":5006,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Pūjārahaṃ na passāmi, mānatthaddho ahaṃ tadā;"]},{"para":5007,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Buddhoti vacanaṃ natthi, tāva nuppajjate jino."]},{"para":5008,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Accayena ahorattaṃ, padumuttaranāmako;"]},{"para":5009,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sabbaṃ tamaṃ vinodetvā, loke uppajji cakkhumā."]},{"para":5010,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Vitthārike bāhujaññe, puthubhūte ca sāsane;"]},{"para":5011,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Upāgami tadā buddho, nagaraṃ haṃsasavhayaṃ."]},{"para":5012,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Pitu atthāya so buddho, dhammaṃ desesi cakkhumā;"]},{"para":5013,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tena kālena parisā, samantā yojanaṃ tadā."]},{"para":5014,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sammato manujānaṃ so, sunando nāma tāpaso;"]},{"para":5015,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Yāvatā buddhaparisā, pupphehacchādayī tadā."]},{"para":5016,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Catusaccaṃ pakāsente, seṭṭhe ca pupphamaṇḍape;"]},{"para":5017,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Koṭisatasahassānaṃ, dhammābhisamayo ahu."]},{"para":5018,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sattarattindivaṃ buddho, vassetvā dhammavuṭṭhiyo;"]},{"para":5019,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Aṭṭhame divase patte, sunandaṃ kittayī jino."]},{"para":5020,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Devaloke manusse vā, saṃsaranto ayaṃ bhave;"]},{"para":5021,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sabbesaṃ pavaro hutvā, bhavesu saṃsarissati."]},{"para":5022,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Kappasatasahassamhi, okkākakulasambhavo;"]},{"para":5023,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Gotamo nāma gottena, satthā loke bhavissati."]},{"para":5024,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tassa dhammesu dāyādo, oraso dhammanimmito;"]},{"para":5025,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Mantāṇiputto puṇṇoti, hessati satthu sāvako."]},{"para":5026,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Evaṃ kittayi sambuddho, sunandaṃ tāpasaṃ tadā;"]},{"para":5027,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Hāsayanto janaṃ sabbaṃ, dassayanto sakaṃ balaṃ."]},{"para":5028,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Katañjalī namassanti, sunandaṃ tāpasaṃ janā;"]},{"para":5029,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Buddhe kāraṃ karitvāna, sodhesi gatimattano."]},{"para":5030,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tattha me ahu saṅkappo, sutvāna munino vacaṃ;"]},{"para":5031,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ahampi kāraṃ kassāmi, yathā passāmi gotamaṃ."]},{"para":5032,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Evāhaṃ cintayitvāna, kiriyaṃ cintayiṃ mama;"]},{"para":5033,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Kyāhaṃ kammaṃ ācarāmi, puññakkhette anuttare."]},{"para":5034,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Ayañca pāṭhiko bhikkhu, sabbapāṭhissa sāsane;"]},{"para":5035,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Vinaye agganikkhitto, taṃ ṭhānaṃ patthaye ahaṃ."]},{"para":5036,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Idaṃ me amitaṃ bhogaṃ, akkhobhaṃ sāgarūpamaṃ;"]},{"para":5037,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tena bhogena buddhassa, ārāmaṃ māpaye ahaṃ."]},{"para":5038,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sobhanaṃ nāma ārāmaṃ, nagarassa puratthato;"]},{"para":5039,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Kiṇitvā satasahassena, saṅghārāmaṃ amāpayiṃ."]},{"para":5040,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Kūṭāgāre ca pāsāde, maṇḍape hammiye guhā;"]},{"para":5041,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Caṅkame sukate katvā, saṅghārāmaṃ amāpayiṃ."]},{"para":5042,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Jantāgharaṃ aggisālaṃ, atho udakamāḷakaṃ;"]},{"para":5043,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Nhānagharaṃ māpayitvā, bhikkhusaṅghassadāsahaṃ."]},{"para":5044,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Āsandiyo pīṭhake ca, paribhoge ca bhājane;"]},{"para":5045,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ārāmikañca bhesajjaṃ, sabbametaṃ adāsahaṃ."]},{"para":5046,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Ārakkhaṃ paṭṭhapetvāna, pākāraṃ kārayiṃ daḷhaṃ;"]},{"para":5047,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Mā naṃ koci viheṭhesi, santacittāna tādinaṃ."]},{"para":5048,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Satasahassenāvāsaṃ, saṅghārāme amāpayiṃ;"]},{"para":5049,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Vepullaṃ taṃ māpayitvā, sambuddhaṃ upanāmayiṃ."]},{"para":5050,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Niṭṭhāpito mayārāmo, sampaṭiccha tuvaṃ muni;"]},{"para":5051,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Niyyādessāmi taṃ vīra, adhivāsehi cakkhuma."]},{"para":5052,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Padumuttaro lokavidū, āhutīnaṃ paṭiggaho;"]},{"para":5053,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Mama saṅkappamaññāya, adhivāsesi nāyako."]},{"para":5054,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Adhivāsanamaññāya, sabbaññussa mahesino;"]},{"para":5055,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Bhojanaṃ paṭiyādetvā, kālamārocayiṃ ahaṃ."]},{"para":5056,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Ārocitamhi kālamhi, padumuttaranāyako;"]},{"para":5057,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Khīṇāsavasahassehi, ārāmaṃ me upāgami."]},{"para":5058,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Nisinnaṃ kālamaññāya, annapānena tappayiṃ;"]},{"para":5059,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Bhuttāviṃ kālamaññāya, idaṃ vacanamabraviṃ."]},{"para":5060,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Kīto satasahassena, tattakeneva kārito;"]},{"para":5061,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sobhano nāma ārāmo, sampaṭiccha tuvaṃ muni."]},{"para":5062,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Iminārāmadānena, cetanāpaṇidhīhi ca;"]},{"para":5063,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Bhave nibbattamānohaṃ, labhāmi mama patthitaṃ."]},{"para":5064,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Paṭiggahetvā sambuddho, saṅghārāmaṃ sumāpitaṃ;"]},{"para":5065,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Bhikkhusaṅghe nisīditvā, idaṃ vacanamabravi."]},{"para":5066,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yo so buddhassa pādāsi, saṅghārāmaṃ sumāpitaṃ;"]},{"para":5067,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."]},{"para":5068,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Hatthī assā rathā pattī, senā ca caturaṅginī;"]},{"para":5069,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Parivāressantimaṃ niccaṃ, saṅghārāmassidaṃ phalaṃ."]},{"para":5070,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Saṭṭhi tūrasahassāni, bheriyo samalaṅkatā;"]},{"para":5071,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Parivāressantimaṃ niccaṃ, saṅghārāmassidaṃ phalaṃ."]},{"para":5072,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Chaḷasītisahassāni, nāriyo samalaṅkatā;"]},{"para":5073,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Vicittavatthābharaṇā, āmuttamaṇikuṇḍalā."]},{"para":5074,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Aḷārapamhā hasulā, susaññā tanumajjhimā;"]},{"para":5075,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Parivāressantimaṃ niccaṃ, saṅghārāmassidaṃ phalaṃ."]},{"para":5076,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tiṃsakappasahassāni, devaloke ramissati;"]},{"para":5077,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sahassakkhattuṃ devindo, devarajjaṃ karissati."]},{"para":5078,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Devarājena pattabbaṃ, sabbaṃ paṭilabhissati;"]},{"para":5079,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Anūnabhogo hutvāna, devarajjaṃ karissati."]},{"para":5080,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sahassakkhattuṃ cakkavattī, rājā raṭṭhe bhavissati."]},{"para":5081,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Pathabyā rajjaṃ vipulaṃ, gaṇanāto asaṅkhiyaṃ."]},{"para":5082,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Kappasatasahassamhi, okkākakulasambhavo;"]},{"para":5083,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Gotamo nāma gottena, satthā loke bhavissati."]},{"para":5084,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tassa dhammesu dāyādo, oraso dhammanimmito;"]},{"para":5085,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Upāli nāma nāmena, hessati satthu sāvako."]},{"para":5086,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Vinaye pāramiṃ patvā, ṭhānāṭhāne ca kovido;"]},{"para":5087,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Jinasāsanaṃ dhārento, viharissatināsavo."]},{"para":5088,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sabbametaṃ abhiññāya, gotamo sakyapuṅgavo;"]},{"para":5089,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Bhikkhusaṅghe nisīditvā, etadagge ṭhapessati."]},{"para":5090,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Aparimeyyupādāya, patthemi tava sāsanaṃ;"]},{"para":5091,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["So me attho anuppatto, sabbasaṃyojanakkhayo."]},{"para":5092,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yathā sūlāvuto poso, rājadaṇḍena tajjito;"]},{"para":5093,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sūle sātaṃ avindanto, parimuttiṃva icchati."]},{"para":5094,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tathevāhaṃ mahāvīra, bhavadaṇḍena tajjito;"]},{"para":5095,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Kammasūlāvuto santo, pipāsāvedanaṭṭito."]},{"para":5096,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Bhave sātaṃ na vindāmi, ḍayhanto tīhi aggibhi;"]},{"para":5097,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Parimuttiṃ gavesāmi, yathāpi rājadaṇḍito."]},{"para":5098,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yathā visādo puriso, visena paripīḷito;"]},{"para":5099,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Agadaṃ so gaveseyya, visaghātāyupālanaṃ."]},{"para":5100,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Gavesamāno passeyya, agadaṃ visaghātakaṃ;"]},{"para":5101,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Taṃ pivitvā sukhī assa, visamhā parimuttiyā."]},{"para":5102,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tathevāhaṃ mahāvīra, yathā visahato naro;"]},{"para":5103,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sampīḷito avijjāya, saddhammāgadamesahaṃ."]},{"para":5104,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Dhammāgadaṃ gavesanto, addakkhiṃ sakyasāsanaṃ;"]},{"para":5105,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Aggaṃ sabbosadhānaṃ taṃ, sabbasallavinodanaṃ."]},{"para":5106,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Dhammosadhaṃ pivitvāna, visaṃ sabbaṃ samūhaniṃ;"]},{"para":5107,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ajarāmaraṃ sītibhāvaṃ, nibbānaṃ phassayiṃ ahaṃ."]},{"para":5108,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yathā bhūtaṭṭito poso, bhūtaggāhena pīḷito;"]},{"para":5109,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Bhūtavejjaṃ gaveseyya, bhūtasmā parimuttiyā."]},{"para":5110,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Gavesamāno passeyya, bhūtavijjāsu kovidaṃ;"]},{"para":5111,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tassa so vihane bhūtaṃ, samūlañca vināsaye."]},{"para":5112,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tathevāhaṃ mahāvīra, tamaggāhena pīḷito;"]},{"para":5113,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ñāṇālokaṃ gavesāmi, tamato parimuttiyā."]},{"para":5114,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Athaddasaṃ sakyamuniṃ, kilesatamasodhanaṃ;"]},{"para":5115,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["So me tamaṃ vinodesi, bhūtavejjova bhūtakaṃ."]},{"para":5116,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Saṃsārasotaṃ sañchindiṃ, taṇhāsotaṃ nivārayiṃ;"]},{"para":5117,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Bhavaṃ ugghāṭayiṃ sabbaṃ, bhūtavejjova mūlato."]},{"para":5118,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Garuḷo yathā opatati, pannagaṃ bhakkhamattano;"]},{"para":5119,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Samantā yojanasataṃ, vikkhobheti mahāsaraṃ."]},{"para":5120,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Pannagaṃ so gahetvāna, adhosīsaṃ viheṭhayaṃ;"]},{"para":5121,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ādāya so pakkamati, yenakāmaṃ vihaṅgamo."]},{"para":5122,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tathevāhaṃ mahāvīra, yathāpi garuḷo balī;"]},{"para":5123,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Asaṅkhataṃ gavesanto, dose vikkhālayiṃ ahaṃ."]},{"para":5124,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Diṭṭho ahaṃ dhammavaraṃ, santipadamanuttaraṃ;"]},{"para":5125,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ādāya viharāmetaṃ, garuḷo pannagaṃ yathā."]},{"para":5126,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Āsāvatī nāma latā, jātā cittalatāvane;"]},{"para":5127,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tassā vassasahassena, ekaṃ nibbattate phalaṃ."]},{"para":5128,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Taṃ devā payirupāsanti, tāvadūraphale sati;"]},{"para":5129,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Devānaṃ sā piyā evaṃ, āsāvatī latuttamā."]},{"para":5130,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Satasahassupādāya, tāhaṃ paricare muni;"]},{"para":5131,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sāyaṃ pātaṃ namassāmi, devā āsāvatiṃ yathā."]},{"para":5132,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Avañjhā pāricariyā, amoghā ca namassanā;"]},{"para":5133,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Dūrāgatampi maṃ santaṃ, khaṇoyaṃ na virādhayi."]},{"para":5134,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Paṭisandhiṃ na passāmi, vicinanto bhave ahaṃ;"]},{"para":5135,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Nirūpadhi vippamutto, upasanto carāmahaṃ."]},{"para":5136,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yathāpi padumaṃ nāma, sūriyaraṃsena pupphati;"]},{"para":5137,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tathevāhaṃ mahāvīra, buddharaṃsena pupphito."]},{"para":5138,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yathā balākayonimhi, na vijjati pumo sadā;"]},{"para":5139,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Meghesu gajjamānesu, gabbhaṃ gaṇhanti tā sadā."]},{"para":5140,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Cirampi gabbhaṃ dhārenti, yāva megho na gajjati;"]},{"para":5141,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Bhārato parimuccanti, yadā megho pavassati."]},{"para":5142,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Padumuttarabuddhassa, dhammameghena gajjato;"]},{"para":5143,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Saddena dhammameghassa, dhammagabbhaṃ agaṇhahaṃ."]},{"para":5144,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Satasahassupādāya, puññagabbhaṃ dharemahaṃ;"]},{"para":5145,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Nappamuccāmi bhārato, dhammamegho na gajjati."]},{"para":5146,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yadā tuvaṃ sakyamuni, ramme kapilavatthave;"]},{"para":5147,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Gajjasi dhammameghena, bhārato parimuccahaṃ."]},{"para":5148,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Suññataṃ animittañca, tathāppaṇihitampi ca;"]},{"para":5149,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Caturo ca phale sabbe, dhammevaṃ vijanayiṃ ahaṃ."]},{"para":5150,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Aparimeyyupādāya, patthemi tava sāsanaṃ;"]},{"para":5151,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["So me attho anuppatto, santipadamanuttaraṃ."]},{"para":5152,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Vinaye pāramiṃ patto, yathāpi pāṭhiko isi;"]},{"para":5153,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Na me samasamo atthi, dhāremi sāsanaṃ ahaṃ."]},{"para":5154,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Vinaye khandhake cāpi, tikacchede ca pañcake;"]},{"para":5155,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ettha me vimati natthi, akkhare byañjanepi vā."]},{"para":5156,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Niggahe paṭikamme ca, ṭhānāṭhāne ca kovido;"]},{"para":5157,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Osāraṇe vuṭṭhāpane, sabbattha pāramiṃ gato."]},{"para":5158,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Vinaye khandhake vāpi, nikkhipitvā padaṃ ahaṃ;"]},{"para":5159,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ubhato viniveṭhetvā, rasato osareyyahaṃ."]},{"para":5160,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Niruttiyā sukusalo, atthānatthe ca kovido;"]},{"para":5161,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Anaññātaṃ mayā natthi, ekaggo satthu sāsane."]},{"para":5162,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Rūpadakkho ahaṃ ajja, sakyaputtassa sāsane;"]},{"para":5163,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Kaṅkhaṃ sabbaṃ vinodemi, chindāmi sabbasaṃsayaṃ."]},{"para":5164,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Padaṃ anupadañcāpi, akkharañcāpi byañjanaṃ;"]},{"para":5165,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Nidāne pariyosāne, sabbattha kovido ahaṃ."]},{"para":5166,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yathāpi rājā balavā, niggaṇhitvā parantape;"]},{"para":5167,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Vijinitvāna saṅgāmaṃ, nagaraṃ tattha māpaye."]},{"para":5168,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Pākāraṃ parikhañcāpi, esikaṃ dvārakoṭṭhakaṃ;"]},{"para":5169,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Aṭṭālake ca vividhe, kāraye nagare bahū."]},{"para":5170,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Siṅghāṭakaṃ caccarañca, suvibhattantarāpaṇaṃ;"]},{"para":5171,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Kārayeyya sabhaṃ tattha, atthānatthavinicchayaṃ."]},{"para":5172,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Nigghātatthaṃ amittānaṃ, chiddāchiddañca jānituṃ;"]},{"para":5173,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Balakāyassa rakkhāya, senāpaccaṃ ṭhapeti so."]},{"para":5174,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Ārakkhatthāya bhaṇḍassa, nidhānakusalaṃ naraṃ;"]},{"para":5175,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Mā me bhaṇḍaṃ vinassīti, bhaṇḍarakkhaṃ ṭhapeti so."]},{"para":5176,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Mamatto hoti yo rañño, vuddhiṃ yassa ca icchati;"]},{"para":5177,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tassādhikaraṇaṃ deti, mittassa paṭipajjituṃ."]},{"para":5178,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Uppātesu nimittesu, lakkhaṇesu ca kovidaṃ;"]},{"para":5179,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ajjhāyakaṃ mantadharaṃ, porohicce ṭhapeti so."]},{"para":5180,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Etehaṅgehi sampanno, khattiyoti pavuccati;"]},{"para":5181,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sadā rakkhanti rājānaṃ, cakkavākova dukkhitaṃ."]},{"para":5182,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tatheva tvaṃ mahāvīra, hatāmittova khattiyo;"]},{"para":5183,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sadevakassa lokassa, dhammarājāti vuccati."]},{"para":5184,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Titthiye nihanitvāna, mārañcāpi sasenakaṃ;"]},{"para":5185,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tamandhakāraṃ vidhamitvā, dhammanagaraṃ amāpayi."]},{"para":5186,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sīlaṃ pākārakaṃ tattha, ñāṇaṃ te dvārakoṭṭhakaṃ;"]},{"para":5187,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Saddhā te esikā vīra, dvārapālo ca saṃvaro."]},{"para":5188,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Satipaṭṭhānamaṭṭālaṃ, paññā te caccaraṃ mune;"]},{"para":5189,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Iddhipādañca siṅghāṭaṃ, dhammavīthi sumāpitā."]},{"para":5190,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Suttantaṃ abhidhammañca, vinayañcāpi kevalaṃ;"]},{"para":5191,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Navaṅgaṃ buddhavacanaṃ, esā dhammasabhā tava."]},{"para":5192,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Suññataṃ animittañca, vihārañcappaṇīhitaṃ;"]},{"para":5193,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Āneñjañca nirodho ca, esā dhammakuṭī tava."]},{"para":5194,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Paññāya aggo nikkhitto, paṭibhāne ca kovido;"]},{"para":5195,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sāriputtoti nāmena, dhammasenāpatī tava."]},{"para":5196,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Cutūpapātakusalo, iddhiyā pāramiṃ gato;"]},{"para":5197,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Kolito nāma nāmena, porohicco tavaṃ mune."]},{"para":5198,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Porāṇakavaṃsadharo, uggatejo durāsado;"]},{"para":5199,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Dhutavādīguṇenaggo, akkhadasso tavaṃ mune."]},{"para":5200,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Bahussuto dhammadharo, sabbapāṭhī ca sāsane;"]},{"para":5201,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ānando nāma nāmena, dhammārakkho tavaṃ mune."]},{"para":5202,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Ete sabbe atikkamma, pamesi bhagavā mamaṃ;"]},{"para":5203,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Vinicchayaṃ me pādāsi, vinaye viññudesitaṃ."]},{"para":5204,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yo koci vinaye pañhaṃ, pucchati buddhasāvako;"]},{"para":5205,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tattha me cintanā natthi, taññevatthaṃ kathemahaṃ."]},{"para":5206,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yāvatā buddhakhettamhi, ṭhapetvā taṃ mahāmuni;"]},{"para":5207,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Vinaye mādiso natthi, kuto bhiyyo bhavissati."]},{"para":5208,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Bhikkhusaṅghe nisīditvā, evaṃ gajjati gotamo;"]},{"para":5209,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Upālissa samo natthi, vinaye khandhakesu ca."]},{"para":5210,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yāvatā buddhabhaṇitaṃ, navaṅgaṃ satthusāsanaṃ;"]},{"para":5211,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Vinayogadhaṃ taṃ sabbaṃ, vinayamūlapassino."]},{"para":5212,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Mama kammaṃ saritvāna, gotamo sakyapuṅgavo;"]},{"para":5213,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Bhikkhusaṅghe nisīditvā, etadagge ṭhapesi maṃ."]},{"para":5214,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Satasahassupādāya, imaṃ ṭhānaṃ apatthayiṃ;"]},{"para":5215,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["So me attho anuppatto, vinaye pāramiṃ gato."]},{"para":5216,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sakyānaṃ nandijanano, kappako āsahaṃ pure;"]},{"para":5217,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Vijahitvāna taṃ jātiṃ, putto jāto mahesino."]},{"para":5218,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Ito dutiyake kappe, añjaso nāma khattiyo;"]},{"para":5219,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Anantatejo amitayaso, bhūmipālo mahaddhano."]},{"para":5220,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tassa rañño ahaṃ putto, candano nāma khattiyo;"]},{"para":5221,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Jātimadenupatthaddho, yasabhogamadena ca."]},{"para":5222,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Nāgasatasahassāni, sabbālaṅkārabhūsitā;"]},{"para":5223,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tidhāpabhinnā mātaṅgā, parivārenti maṃ sadā."]},{"para":5224,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sabalehi paretohaṃ, uyyānaṃ gantukāmako;"]},{"para":5225,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Āruyha sirikaṃ nāgaṃ, nagarā nikkhamiṃ tadā."]},{"para":5226,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Caraṇena ca sampanno, guttadvāro susaṃvuto;"]},{"para":5227,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Devalo nāma sambuddho, āgacchi purato mama."]},{"para":5228,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Pesetvā sirikaṃ nāgaṃ, buddhaṃ āsādayiṃ tadā;"]},{"para":5229,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tato sañjātakopo so, nāgo nuddharate padaṃ."]},{"para":5230,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Nāgaṃ ruṇṇamanaṃ disvā, buddhe kodhaṃ akāsahaṃ;"]},{"para":5231,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Vihesayitvā sambuddhaṃ, uyyānaṃ agamāsahaṃ."]},{"para":5232,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sātaṃ tattha na vindāmi, siro pajjalito yathā;"]},{"para":5233,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Pariḷāhena ḍayhāmi, macchova baḷisādako."]},{"para":5234,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sasāgarantā pathavī, ādittā viya hoti me;"]},{"para":5235,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Pitu santikupāgamma, idaṃ vacanamabraviṃ."]},{"para":5236,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Āsīvisaṃva kupitaṃ, aggikkhandhaṃva āgataṃ;"]},{"para":5237,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Mattaṃva kuñjaraṃ dantiṃ, yaṃ sayambhumasādayiṃ."]},{"para":5238,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Āsādito mayā buddho, ghoro uggatapo jino;"]},{"para":5239,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Purā sabbe vinassāma, khamāpessāma taṃ muniṃ."]},{"para":5240,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“No ce taṃ nijjhāpessāma, attadantaṃ samāhitaṃ;"]},{"para":5241,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Orena sattadivasā, raṭṭhaṃ me vidhamissati."]},{"para":5242,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sumekhalo kosiyo ca, siggavo cāpi sattako;"]},{"para":5243,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Āsādayitvā isayo, duggatā te saraṭṭhakā."]},{"para":5244,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yadā kuppanti isayo, saññatā brahmacārino;"]},{"para":5245,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sadevakaṃ vināsenti, sasāgaraṃ sapabbataṃ."]},{"para":5246,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tiyojanasahassamhi, purise sannipātayiṃ;"]},{"para":5247,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Accayaṃ desanatthāya, sayambhuṃ upasaṅkamiṃ."]},{"para":5248,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Allavatthā allasirā, sabbeva pañjalīkatā;"]},{"para":5249,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Buddhassa pāde nipatitvā, idaṃ vacanamabravuṃ."]},{"para":5250,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Khamassu tvaṃ mahāvīra, abhiyācati taṃ jano;"]},{"para":5251,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Pariḷāhaṃ vinodehi, mā no raṭṭhaṃ vināsaya."]},{"para":5252,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sadevamānusā sabbe, sadānavā sarakkhasā;"]},{"para":5253,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Ayomayena kūṭena, siraṃ bhindeyyu me sadā."]},{"para":5254,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Dake aggi na saṇṭhāti, bījaṃ sele na rūhati;"]},{"para":5255,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Agade kimi na saṇṭhāti, kopo buddhe na jāyati."]},{"para":5256,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yathā ca bhūmi acalā, appameyyo ca sāgaro;"]},{"para":5257,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Anantako ca ākāso, evaṃ buddhā akhobhiyā."]},{"para":5258,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sadā khantā mahāvīrā, khamitā ca tapassino;"]},{"para":5259,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Khantānaṃ khamitānañca, gamanaṃ taṃ na vijjati."]},{"para":5260,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Idaṃ vatvāna sambuddho, pariḷāhaṃ vinodayaṃ;"]},{"para":5261,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Mahājanassa purato, nabhaṃ abbhuggamī tadā."]},{"para":5262,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tena kammenahaṃ vīra, hīnattaṃ ajjhupāgato;"]},{"para":5263,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Samatikkamma taṃ jātiṃ, pāvisiṃ abhayaṃ puraṃ."]},{"para":5264,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Tadāpi maṃ mahāvīra, ḍayhamānaṃ susaṇṭhitaṃ;"]},{"para":5265,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Pariḷāhaṃ vinodesi, sayambhuñca khamāpayiṃ."]},{"para":5266,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Ajjāpi maṃ mahāvīra, ḍayhamānaṃ tihaggibhi;"]},{"para":5267,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Nibbāpesi tayo aggī, sītibhāvañca pāpayiṃ."]},{"para":5268,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Yesaṃ sotāvadhānatthi, suṇātha mama bhāsato;"]},{"para":5269,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Atthaṃ tuyhaṃ pavakkhāmi, yathā diṭṭhaṃ padaṃ mama."]},{"para":5270,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sayambhuṃ taṃ vimānetvā, santacittaṃ samāhitaṃ;"]},{"para":5271,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tena kammenahaṃ ajja, jātomhi nīcayoniyaṃ."]},{"para":5272,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Mā vo khaṇaṃ virādhetha, khaṇātītā hi socare;"]},{"para":5273,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sadatthe vāyameyyātha, khaṇo vo paṭipādito."]},{"para":5274,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Ekaccānañca vamanaṃ, ekaccānaṃ virecanaṃ;"]},{"para":5275,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Visaṃ halāhalaṃ eke, ekaccānañca osadhaṃ."]},{"para":5276,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Vamanaṃ paṭipannānaṃ, phalaṭṭhānaṃ virecanaṃ;"]},{"para":5277,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Osadhaṃ phalalābhīnaṃ, puññakkhettaṃ gavesinaṃ."]},{"para":5278,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sāsanena viruddhānaṃ, visaṃ halāhalaṃ yathā;"]},{"para":5279,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Āsīviso diṭṭhaviso, evaṃ jhāpeti taṃ naraṃ."]},{"para":5280,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Sakiṃ pītaṃ halāhalaṃ, uparundhati jīvitaṃ;"]},{"para":5281,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sāsanena virujjhitvā, kappakoṭimhi ḍayhati."]},{"para":5282,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Khantiyā avihiṃsāya, mettacittavatāya ca;"]},{"para":5283,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sadevakaṃ so tāreti, tasmā te avirādhiyā."]},{"para":5284,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Lābhālābhe na sajjanti, sammānanavimānane;"]},{"para":5285,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Pathavīsadisā buddhā, tasmā te na virādhiyā."]},{"para":5286,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Devadatte ca vadhake, core aṅgulimālake;"]},{"para":5287,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Rāhule dhanapāle ca, sabbesaṃ samako muni."]},{"para":5288,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Etesaṃ paṭigho natthi, rāgomesaṃ na vijjati;"]},{"para":5289,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sabbesaṃ samako buddho, vadhakassorasassa ca."]},{"para":5290,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Panthe disvāna kāsāvaṃ, chaḍḍitaṃ mīḷhamakkhitaṃ;"]},{"para":5291,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Sirasmiṃ añjaliṃ katvā, vanditabbaṃ isiddhajaṃ."]},{"para":5292,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Abbhatītā ca ye buddhā, vattamānā anāgatā;"]},{"para":5293,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Dhajenānena sujjhanti, tasmā ete namassiyā."]},{"para":5294,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Satthukappaṃ suvinayaṃ, dhāremi hadayenahaṃ;"]},{"para":5295,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Namassamāno vinayaṃ, viharissāmi sabbadā."]},{"para":5296,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Vinayo āsayo mayhaṃ, vinayo ṭhānacaṅkamaṃ;"]},{"para":5297,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Kappemi vinaye vāsaṃ, vinayo mama gocaro."]},{"para":5298,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Vinaye pāramippatto, samathe cāpi kovido;"]},{"para":5299,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Upāli taṃ mahāvīra, pāde vandati satthuno."]},{"para":5300,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“So ahaṃ vicarissāmi, gāmā gāmaṃ purā puraṃ;"]},{"para":5301,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Namassamāno sambuddhaṃ, dhammassa ca sudhammataṃ."]},{"para":5302,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."]},{"para":5303,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Tattha hi naṃ satthā sayameva sakalaṃ vinayapiṭakaṃ uggaṇhāpesi.","So aparabhāge bhārukacchakavatthuṃ (pārā.78) ajjukavatthuṃ (pārā.158) kumārakassapavatthunti imāni tīṇi vatthūni vinicchayi.","Satthā ekekasmiṃ vinicchite sādhukāraṃ datvā tayopi vinicchaye aṭṭhuppattiṃ katvā theraṃ vinayadharānaṃ aggaṭṭhāne ṭhapesi.","So aparabhāge ekasmiṃ uposathadivase pātimokkhuddesasamaye bhikkhū ovadanto –"]},{"para":5305,"vripara":"249","title":"Upālittheragāthāvaṇṇanā","lines":["“Saddhāya abhinikkhamma, navapabbajito navo;"]},{"para":5306,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Mitte bhajeyya kalyāṇe, suddhājīve atandite."]},{"para":5308,"vripara":"250","title":"Upālittheragāthāvaṇṇanā","lines":["“Saddhāya abhinikkhamma, navapabbajito navo;"]},{"para":5309,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Saṅghasmiṃ viharaṃ bhikkhu, sikkhetha vinayaṃ budho."]},{"para":5311,"vripara":"251","title":"Upālittheragāthāvaṇṇanā","lines":["“Saddhāya abhinikkhamma, navapabbajito navo;"]},{"para":5312,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Kappākappesu kusalo, careyya apurakkhato”ti.","– tisso gāthā abhāsi;"]}],"after":[{"para":5314,"vripara":null,"title":"Upālittheragāthāvaṇṇanā","lines":["Upālittheragāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
