{"suttaId":"thag3.11","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1251,1260],"vripara":"249"},"segments":{"thag3.11:0.4":"Upālittheragāthā","thag3.11:1.1":"“Saddhāya abhinikkhamma, navapabbajito navo;","thag3.11:1.3":"Mitte bhajeyya kalyāṇe, suddhājīve atandite.","thag3.11:2.1":"“Saddhāya abhinikkhamma, navapabbajito navo;","thag3.11:2.3":"Saṅghasmiṃ viharaṃ bhikkhu, sikkhetha vinayaṃ budho.","thag3.11:3.1":"“Saddhāya abhinikkhamma, navapabbajito navo;","thag3.11:3.3":"Kappākappesu kusalo, careyya apurakkhato”ti.","thag3.11:3.5":"… Upālitthero …."},"attha":null,"tika":null}
