{"suttaId":"ja520","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[10385,10506],"vripara":"332"},"segments":{"ja520:0.4":"Gandhatindukajātakaṃ (10)","ja520:1.1":"Appamādo amataṃ padaṃ [amatapadaṃ (sī. pī.)],","ja520:1.2":"pamādo maccuno padaṃ;","ja520:1.3":"Appamattā na mīyanti,","ja520:1.4":"ye pamattā yathā matā.","ja520:2.1":"Madā pamādo jāyetha,","ja520:2.2":"pamādā jāyate khayo;","ja520:2.3":"Khayā padosā [khayā ca dosā (sī.)] jāyanti,","ja520:2.4":"mā pamādo [mā mado (sī. syā. pī.)] bharatūsabha [bhāradhūsabha (ka.)].","ja520:3.1":"Bahū hi khattiyā jīnā,","ja520:3.2":"atthaṃ raṭṭhaṃ pamādino;","ja520:3.3":"Athopi gāmino gāmā,","ja520:3.4":"anagārā agārino.","ja520:4.1":"Khattiyassa pamattassa,","ja520:4.2":"raṭṭhasmiṃ raṭṭhavaḍḍhana;","ja520:4.3":"Sabbe bhogā vinassanti,","ja520:4.4":"rañño taṃ vuccate aghaṃ.","ja520:5.1":"Nesa dhammo mahārāja,","ja520:5.2":"ativelaṃ pamajjasi;","ja520:5.3":"Iddhaṃ phītaṃ janapadaṃ,","ja520:5.4":"corā viddhaṃsayanti naṃ.","ja520:6.1":"Na te puttā bhavissanti,","ja520:6.2":"na hiraññaṃ na dhāniyaṃ [na hiraññanidhāniyā (ka.)];","ja520:6.3":"Raṭṭhe viluppamānamhi,","ja520:6.4":"sabbabhogehi jiyyasi.","ja520:7.1":"Sabbabhogā parijiṇṇaṃ,","ja520:7.2":"rājānaṃ vāpi khattiyaṃ [khattiya (ka.)];","ja520:7.3":"Ñātimittā suhajjā ca,","ja520:7.4":"na taṃ maññanti māniyaṃ [mantiyaṃ (syā.)].","ja520:8.1":"Hatthārohā anīkaṭṭhā,","ja520:8.2":"rathikā pattikārakā;","ja520:8.3":"Tamevamupajīvantā,","ja520:8.4":"na taṃ maññanti māniyaṃ.","ja520:9.1":"Asaṃvihitakammantaṃ,","ja520:9.2":"bālaṃ dummantimantinaṃ;","ja520:9.3":"Sirī jahati dummedhaṃ,","ja520:9.4":"jiṇṇaṃva urago tacaṃ.","ja520:10.1":"Susaṃvihitakammantaṃ,","ja520:10.2":"kāluṭṭhāyiṃ atanditaṃ;","ja520:10.3":"Sabbe bhogābhivaḍḍhanti,","ja520:10.4":"gāvo sausabhāmiva.","ja520:11.1":"Upassutiṃ mahārāja,","ja520:11.2":"raṭṭhe janapade cara;","ja520:11.3":"Tattha disvā ca sutvā ca,","ja520:11.4":"tato taṃ [tvaṃ (ka.)] paṭipajjasi.","ja520:12.1":"Evaṃ vedetu pañcālo,","ja520:12.2":"saṅgāme saramappito [samappito (sī. pī.)];","ja520:12.3":"Yathāhamajja vedemi,","ja520:12.4":"kaṇṭakena samappito.","ja520:13.1":"Jiṇṇo dubbalacakkhūsi,","ja520:13.2":"na rūpaṃ sādhu passasi;","ja520:13.3":"Kiṃ tattha brahmadattassa,","ja520:13.4":"yaṃ taṃ maggeyya [maggheyya (pī.)] kaṇṭako [kaṇḍako (sī. syā. pī.)].","ja520:14.1":"Bahvettha brahmadattassa,","ja520:14.2":"sohaṃ [yohaṃ (sī. syā. pī.)] maggasmi [maggosmi (pī.)] brāhmaṇa;","ja520:14.3":"Arakkhitā jānapadā,","ja520:14.4":"adhammabalinā hatā.","ja520:15.1":"Rattiñhi [rattiñca (sī.)] corā khādanti,","ja520:15.2":"divā khādanti tuṇḍiyā;","ja520:15.3":"Raṭṭhasmiṃ kūṭarājassa,","ja520:15.4":"bahu adhammiko jano.","ja520:16.1":"Etādise bhaye jāte [tāta (sī. pī.)],","ja520:16.2":"bhayaṭṭā tāta [tāva (sī. pī.)] māṇavā;","ja520:16.3":"Nillenakāni kubbanti,","ja520:16.4":"vane āhatva kaṇṭakaṃ.","ja520:17.1":"Kadāssu nāmayaṃ rājā,","ja520:17.2":"brahmadatto marissati;","ja520:17.3":"Yassa raṭṭhamhi jiyyanti,","ja520:17.4":"appatikā kumārikā.","ja520:18.1":"Dubbhāsitañhi te jammi,","ja520:18.2":"anatthapadakovide;","ja520:18.3":"Kuhiṃ rājā kumārīnaṃ,","ja520:18.4":"bhattāraṃ pariyesati.","ja520:19.1":"Na me dubbhāsitaṃ brahme,","ja520:19.2":"kovidatthapadā ahaṃ;","ja520:19.3":"Arakkhitā jānapadā,","ja520:19.4":"adhammabalinā hatā.","ja520:20.1":"Rattiñhi corā khādanti,","ja520:20.2":"divā khādanti tuṇḍiyā;","ja520:20.3":"Raṭṭhasmiṃ kūṭarājassa,","ja520:20.4":"bahu adhammiko jano;","ja520:20.5":"Dujjīve dubbhare dāre,","ja520:20.6":"kuto bhattā kumāriyo.","ja520:21.1":"Evaṃ sayatu pañcālo,","ja520:21.2":"saṅgāme sattiyā hato;","ja520:21.3":"Yathāyaṃ kapaṇo seti,","ja520:21.4":"hato phālena sāliyo.","ja520:22.1":"Adhammena tuvaṃ jamma,","ja520:22.2":"brahmadattassa kujjhasi;","ja520:22.3":"Yo tvaṃ sapasi rājānaṃ,","ja520:22.4":"aparajjhitvāna attano [attanā (pī.)].","ja520:23.1":"Dhammena brahmadattassa,","ja520:23.2":"ahaṃ kujjhāmi brāhmaṇa;","ja520:23.3":"Arakkhitā jānapadā,","ja520:23.4":"adhammabalinā hatā.","ja520:24.1":"Rattiñhi corā khādanti,","ja520:24.2":"divā khādanti tuṇḍiyā;","ja520:24.3":"Raṭṭhasmiṃ kūṭarājassa,","ja520:24.4":"bahu adhammiko jano.","ja520:25.1":"Sā nūna puna re pakkā,","ja520:25.2":"vikāle bhattamāhari;","ja520:25.3":"Bhattahāriṃ apekkhanto,","ja520:25.4":"hato phālena sāliyo.","ja520:26.1":"Evaṃ haññatu pañcālo,","ja520:26.2":"saṅgāme asinā hato [daḷhaṃ (pī.)];","ja520:26.3":"Yathāhamajja pahato,","ja520:26.4":"khīrañca me pavaṭṭitaṃ.","ja520:27.1":"Yaṃ pasu khīraṃ chaḍḍeti,","ja520:27.2":"pasupālaṃ vihiṃsati [pasupālañca hiṃsati (sī.), pasu phālañca hiṃsati (pī.)];","ja520:27.3":"Kiṃ tattha brahmadattassa,","ja520:27.4":"yaṃ no garahate [garahato (pī.)] bhavaṃ.","ja520:28.1":"Gārayho brahme pañcālo,","ja520:28.2":"brahmadattassa rājino;","ja520:28.3":"Arakkhitā jānapadā,","ja520:28.4":"adhammabalinā hatā.","ja520:29.1":"Rattiñhi corā khādanti,","ja520:29.2":"divā khādanti tuṇḍiyā;","ja520:29.3":"Raṭṭhasmiṃ kūṭarājassa,","ja520:29.4":"bahu adhammiko jano.","ja520:30.1":"Caṇḍā aṭanakā [aṭanaka (pī.), akaṭanā (ka.)] gāvī,","ja520:30.2":"yaṃ pure na duhāmase;","ja520:30.3":"Taṃ dāni ajja dohāma,","ja520:30.4":"khīrakāmehupaddutā.","ja520:31.1":"Evaṃ kandatu pañcālo,","ja520:31.2":"viputto vippasukkhatu;","ja520:31.3":"Yathāyaṃ kapaṇā gāvī,","ja520:31.4":"viputtā paridhāvati.","ja520:32.1":"Yaṃ pasu pasupālassa,","ja520:32.2":"sambhameyya [pabbhameyya (sī. pī.)] raveyya vā;","ja520:32.3":"Ko nīdha aparādhatthi,","ja520:32.4":"brahmadattassa rājino.","ja520:33.1":"Aparādho mahābrahme,","ja520:33.2":"brahmadattassa rājino;","ja520:33.3":"Arakkhitā jānapadā,","ja520:33.4":"adhammabalinā hatā.","ja520:34.1":"Rattiñhi corā khādanti,","ja520:34.2":"divā khādanti tuṇḍiyā;","ja520:34.3":"Raṭṭhasmiṃ kūṭarājassa,","ja520:34.4":"bahu adhammiko jano;","ja520:34.5":"Kathaṃ no asikosatthā,","ja520:34.6":"khīrapā haññate pajā.","ja520:35.1":"Evaṃ khajjatu pañcālo,","ja520:35.2":"hato yuddhe saputtako;","ja520:35.3":"Yathāhamajja khajjāmi,","ja520:35.4":"gāmikehi [gāmakehi (sī. pī.)] araññajo.","ja520:36.1":"Na sabbabhūtesu vidhenti [vidhanti (ka.)] rakkhaṃ,","ja520:36.2":"rājāno maṇḍūka manussaloke;","ja520:36.3":"Nettāvatā rājā adhammacārī,","ja520:36.4":"yaṃ tādisaṃ jīvamadeyyu dhaṅkā.","ja520:37.1":"Adhammarūpo vata brahmacārī,","ja520:37.2":"anuppiyaṃ bhāsasi khattiyassa;","ja520:37.3":"Viluppamānāya puthuppajāya,","ja520:37.4":"pūjesi rājaṃ paramappamādaṃ [rājaṃ paramappavādaṃ (sī.), rājā paramappavādiṃ (syā.)].","ja520:38.1":"Sace imaṃ brahme surajjakaṃ siyā,","ja520:38.2":"phītaṃ raṭṭhaṃ muditaṃ [pūritaṃ (ka.)] vippasannaṃ;","ja520:38.3":"Bhutvā baliṃ aggapiṇḍañca kākā,","ja520:38.4":"na mādisaṃ jīvamadeyyu dhaṅkāti.","ja520:39.1":"Gandhatindukajātakaṃ dasamaṃ.","ja520:40.1":"Tassuddānaṃ –","ja520:42.1":"Kiṃchanda kumbha jayaddisa chaddanta,","ja520:42.2":"atha paṇḍitasambhava sirakapi;","ja520:42.3":"Dakarakkhasa paṇḍaranāgavaro,","ja520:42.4":"atha sambula tindukadevasutoti. Tiṃsanipātaṃ niṭṭhitaṃ.","ja520:43.1":"Jātakapāḷiyā paṭhamo bhāgo niṭṭhito."},"unsure":["ja520:40.1"],"preface":[],"attha":{"book":"Ja-a-vi-b","bookName":"Jātaka-aṭṭhakathā-5","vriCode":"s0513a4.att","from":6614,"to":6730,"paras":[{"para":6614,"vripara":null,"refs":["ja520:11"],"lines":["<b>Sirī</b>ti yasavibhavo.","<b>Tacan</b>ti yathā urago jiṇṇatacaṃ jigucchanto jahati, na puna oloketi, evaṃ tādisaṃ rājānaṃ sirī jahati.","<b>Susaṃvihitakammantan</b>ti kāyadvārādīhi pāpakammaṃ akarontaṃ.","<b>Abhivaḍḍhantī</b>ti abhimukhaṃ gacchantā vaḍḍhanti.","<b>Sausabhāmivā</b>ti sausabhā iva.","Appamattassa hi sausabhajeṭṭhako gogaṇo viya bhogā vaḍḍhanti.","<b>Upassutin</b>ti janapadacārittasavanāya cārikaṃ attano sakalaraṭṭhe ca janapade ca cara.","<b>Tatthā</b>ti tasmiṃ raṭṭhe caranto daṭṭhabbaṃ disvā sotabbaṃ sutvā attano guṇāguṇaṃ paccakkhaṃ katvā tato attano hitapaṭipattiṃ paṭipajjissasīti."],"lineRefs":[["ja520:11"],["ja520:11"],["ja520:11"],["ja520:11"],["ja520:11"],["ja520:11"],["ja520:11"],["ja520:11"]]},{"para":6615,"vripara":null,"refs":["ja520:11"],"lines":["Iti mahāsatto ekādasahi gāthāhi rājānaṃ ovaditvā “gaccha papañcaṃ akatvā pariggaṇha raṭṭhaṃ, mā nāsayī”ti vatvā sakaṭṭhānameva gato.","Rājāpi tassa vacanaṃ sutvā saṃvegappatto punadivase rajjaṃ amacce paṭicchāpetvā purohitena saddhiṃ kālasseva pācīnadvārena nagarā nikkhamitvā yojanamattaṃ gato.","Tattheko gāmavāsī mahallako aṭavito kaṇṭakasākhaṃ āharitvā gehadvāraṃ parikkhipitvā pidahitvā puttadāraṃ ādāya araññaṃ pavisitvā sāyaṃ rājapurisesu pakkantesu attano gharaṃ āgacchanto gehadvāre pāde kaṇṭakena viddho ukkuṭikaṃ nisīditvā kaṇṭakaṃ nīharanto –"],"lineRefs":[["ja520:11"],["ja520:11"],["ja520:11"]]},{"para":6617,"vripara":"343","refs":["ja520:11"],"lines":["“Evaṃ vedetu pañcālo, saṅgāme saramappito;"],"lineRefs":[["ja520:11"]]},{"para":6618,"vripara":null,"refs":["ja520:11"],"lines":["Yathāhamajja vedemi, kaṇṭakena samappito”ti.","–"],"lineRefs":[["ja520:11"],["ja520:11"]]},{"para":6619,"vripara":null,"refs":["ja520:11"],"lines":["Imāya gāthāya rājānaṃ akkosi.","Taṃ panassa akkosanaṃ bodhisattānubhāvena ahosi.","Bodhisattena adhiggahitova so akkosīti veditabbo.","Tasmiṃ pana samaye rājā ca purohito ca aññātakavesena tassa santikeva aṭṭhaṃsu.","Athassa vacanaṃ sutvā purohito itaraṃ gāthamāha –"],"lineRefs":[["ja520:11"],["ja520:11"],["ja520:11"],["ja520:11"],["ja520:11"]]},{"para":6621,"vripara":"344","refs":["ja520:11"],"lines":["“Jiṇṇo dubbalacakkhūsi, na rūpaṃ sādhu passasi;"],"lineRefs":[["ja520:11"]]},{"para":6622,"vripara":null,"refs":["ja520:11"],"lines":["Kiṃ tattha brahmadattassa, yaṃ taṃ maggeyya kaṇṭako”ti."],"lineRefs":[["ja520:11"]]},{"para":6623,"vripara":null,"refs":["ja520:13"],"lines":["Tattha <b>maggeyyā</b>ti vijjheyya.","Idaṃ vuttaṃ hoti – yadi tvaṃ attano abyattatāya kaṇṭakena viddho, ko ettha rañño doso.","Yena rājānaṃ akkosi, kiṃ te raññā kaṇṭako oloketvāva ācikkhitabboti."],"lineRefs":[["ja520:13"],["ja520:13"],["ja520:13"]]},{"para":6624,"vripara":null,"refs":["ja520:13"],"lines":["Taṃ sutvā mahallako tisso gāthā abhāsi –"],"lineRefs":[["ja520:13"]]},{"para":6626,"vripara":"345","refs":["ja520:13"],"lines":["“Bahvettha brahmadattassa, sohaṃ maggasmi brāhmaṇa;"],"lineRefs":[["ja520:13"]]},{"para":6627,"vripara":null,"refs":["ja520:13"],"lines":["Arakkhitā jānapadā, adhammabalinā hatā."],"lineRefs":[["ja520:13"]]},{"para":6629,"vripara":"346","refs":["ja520:13"],"lines":["“Rattiñhi corā khādanti, divā khādanti tuṇḍiyā;"],"lineRefs":[["ja520:13"]]},{"para":6630,"vripara":null,"refs":["ja520:13"],"lines":["Raṭṭhasmiṃ kūṭarājassa, bahu adhammiko jano."],"lineRefs":[["ja520:13"]]},{"para":6632,"vripara":"347","refs":["ja520:13"],"lines":["“Etādise bhaye jāte, bhayaṭṭā tāta māṇavā;"],"lineRefs":[["ja520:13"]]},{"para":6633,"vripara":null,"refs":["ja520:13"],"lines":["Nillenakāni kubbanti, vane āhatva kaṇṭakan”ti."],"lineRefs":[["ja520:13"]]},{"para":6634,"vripara":null,"refs":["ja520:13","ja520:16"],"lines":["Tattha <b>bahvetthā</b>ti, brāhmaṇa, sohaṃ sakaṇṭake magge patito sannisinno, bahu ettha brahmadattassa doso, tvaṃ ettakaṃ kālaṃ rañño dosena mama sakaṇṭake magge vicaraṇabhāvaṃ na jānāsi.","Tassa hi arakkhitā jānapadā … pe … kaṇṭakanti.","Tattha <b>khādantī</b>ti vilumpanti.","<b>Tuṇḍiyā</b>ti vadhabandhādīhi pīḷetvā adhammena balisādhakā.","<b>Kūṭarājassā</b>ti pāparañño.","<b>Adhammiko</b>ti paṭicchannakammanto.","<b>Tātā</b>ti purohitaṃ ālapati.","<b>Māṇavā</b>ti manussā.","<b>Nillenakānī</b>ti nilīyanaṭṭhānāni.","<b>Vane āhatva kaṇṭakan</b>ti kaṇṭakaṃ āharitvā dvārāni pidahitvā gharaṃ chaḍḍetvā puttadāraṃ ādāya vanaṃ pavisitvā tasmiṃ vane attano nilīyanaṭṭhānāni karonti.","Atha vā vane yo kaṇṭako, taṃ āharitvā gharāni parikkhipanti.","Iti rañño dosenevamhi kaṇṭakena viddho, mā evarūpassa rañño upatthambho hohīti."],"lineRefs":[["ja520:13"],["ja520:13"],["ja520:13"],["ja520:13"],["ja520:13"],["ja520:13"],["ja520:16"],["ja520:16"],["ja520:16"],["ja520:16"],["ja520:16"],["ja520:16"]]},{"para":6635,"vripara":null,"refs":["ja520:16"],"lines":["Taṃ sutvā rājā purohitaṃ āmantetvā,“ācariya, mahallako yuttaṃ bhaṇati, amhākameva doso, ehi nivattāma, dhammena rajjaṃ kāressāmā”ti āha.","Bodhisatto purohitassa sarīre adhimuccitvā purato gantvā “pariggaṇhissāma tāva, mahārājā”ti āha.","Te tamhā gāmā aññaṃ gāmaṃ gacchantā antarāmagge ekissā mahallikāya saddaṃ assosuṃ.","Sā kirekā dalidditthī dve dhītaro vayappattā rakkhamānā tāsaṃ araññaṃ gantuṃ na deti.","Sayaṃ araññato dārūni ceva sākañca āharitvā dhītaro paṭijaggati.","Sā taṃ divasaṃ ekaṃ gumbaṃ āruyha sākaṃ gaṇhantī pavaṭṭamānā bhūmiyaṃ patitvā rājānaṃ maraṇena akkosantī gāthamāha –"],"lineRefs":[["ja520:16"],["ja520:16"],["ja520:16"],["ja520:16"],["ja520:16"],["ja520:16"]]},{"para":6637,"vripara":"348","refs":["ja520:16"],"lines":["“Kadāssu nāmayaṃ rājā, brahmadatto marissati;"],"lineRefs":[["ja520:16"]]},{"para":6638,"vripara":null,"refs":["ja520:16"],"lines":["Yassa raṭṭhamhi jīyanti, appatikā kumārikā”ti."],"lineRefs":[["ja520:16"]]},{"para":6639,"vripara":null,"refs":["ja520:17"],"lines":["Tattha <b>appatikā</b>ti assāmikā.","Sace hi tāsaṃ sāmikā assu, maṃ poseyyuṃ.","Pāparañño pana rajje ahaṃ dukkhaṃ anubhomi, kadā nu kho esa marissatīti."],"lineRefs":[["ja520:17"],["ja520:17"],["ja520:17"]]},{"para":6640,"vripara":null,"refs":["ja520:17"],"lines":["Evaṃ bodhisattānubhāveneva sā akkosi.","Atha naṃ purohito paṭisedhento gāthamāha –"],"lineRefs":[["ja520:17"],["ja520:17"]]},{"para":6642,"vripara":"349","refs":["ja520:17"],"lines":["“Dubbhāsitañhi te jammi, anatthapadakovide;"],"lineRefs":[["ja520:17"]]},{"para":6643,"vripara":null,"refs":["ja520:17"],"lines":["Kuhiṃ rājā kumārīnaṃ, bhattāraṃ pariyesatī”ti."],"lineRefs":[["ja520:17"]]},{"para":6644,"vripara":null,"refs":["ja520:17"],"lines":["Taṃ sutvā mahallikā dve gāthā abhāsi –"],"lineRefs":[["ja520:17"]]},{"para":6646,"vripara":"350","refs":["ja520:17"],"lines":["“Na me dubbhāsitaṃ brahme, kovidatthapadā ahaṃ;"],"lineRefs":[["ja520:17"]]},{"para":6647,"vripara":null,"refs":["ja520:17"],"lines":["Arakkhitā jānapadā, adhammabalinā hatā."],"lineRefs":[["ja520:17"]]},{"para":6649,"vripara":"351","refs":["ja520:17"],"lines":["“Rattiñhi corā khādanti, divā khādanti tuṇḍiyā;"],"lineRefs":[["ja520:17"]]},{"para":6650,"vripara":null,"refs":["ja520:17"],"lines":["Raṭṭhasmiṃ kūṭarājassa, bahu adhammiko jano;"],"lineRefs":[["ja520:17"]]},{"para":6651,"vripara":null,"refs":["ja520:17"],"lines":["Dujjīve dubbhare dāre, kuto bhattā kumāriyo”ti."],"lineRefs":[["ja520:17"]]},{"para":6652,"vripara":null,"refs":["ja520:17","ja520:20"],"lines":["Tattha <b>kovidatthapadā</b>ti ahaṃ atthapade kāraṇapade kovidā chekā, mā tvaṃ etaṃ pāparājānaṃ pasaṃsi.","<b>Dujjīve</b>ti dujjīve raṭṭhe dubbhare dāre jāte manussesu bhītatasitesu araññe vasantesu <b>kuto bhattā kumāriyo,</b> kuto kumāriyo bhattāraṃ labhissantīti attho."],"lineRefs":[["ja520:17"],["ja520:20"]]},{"para":6653,"vripara":null,"refs":["ja520:20"],"lines":["Te tassā vacanaṃ sutvā “yuttaṃ sā kathetī”ti tato paraṃ gacchantā ekassa kassakassa saddaṃ assosuṃ.","Tassa kira kasantassa sāliyo nāma balibaddo phālena pahaṭo sayi.","So rājānaṃ akkosanto gāthamāha –"],"lineRefs":[["ja520:20"],["ja520:20"],["ja520:20"]]},{"para":6655,"vripara":"352","refs":["ja520:20"],"lines":["“Evaṃ sayatu pañcālo, saṅgāme sattiyā hato;"],"lineRefs":[["ja520:20"]]},{"para":6656,"vripara":null,"refs":["ja520:20"],"lines":["Yathāyaṃ kapaṇo seti, hato phālena sāliyo”ti."],"lineRefs":[["ja520:20"]]},{"para":6657,"vripara":null,"refs":["ja520:21"],"lines":["Tattha <b>yathā</b>ti yathā ayaṃ vedanāppatto sāliyabalibaddo seti, evaṃ sayatūti attho."],"lineRefs":[["ja520:21"]]},{"para":6658,"vripara":null,"refs":["ja520:21"],"lines":["Atha naṃ purohito paṭisedhento gāthamāha –"],"lineRefs":[["ja520:21"]]},{"para":6660,"vripara":"353","refs":["ja520:21"],"lines":["“Adhammena tuvaṃ jamma, brahmadattassa kujjhasi;"],"lineRefs":[["ja520:21"]]},{"para":6661,"vripara":null,"refs":["ja520:21"],"lines":["Yo tvaṃ sapasi rājānaṃ, aparajjhitvāna attano”ti."],"lineRefs":[["ja520:21"]]},{"para":6662,"vripara":null,"refs":["ja520:22"],"lines":["Tattha <b>adhammenā</b>ti akāraṇena asabhāvena."],"lineRefs":[["ja520:22"]]},{"para":6663,"vripara":null,"refs":["ja520:22"],"lines":["Taṃ sutvā so tisso gāthā abhāsi –"],"lineRefs":[["ja520:22"]]},{"para":6665,"vripara":"354","refs":["ja520:22"],"lines":["“Dhammena brahmadattassa, ahaṃ kujjhāmi brāhmaṇa;"],"lineRefs":[["ja520:22"]]},{"para":6666,"vripara":null,"refs":["ja520:22"],"lines":["Arakkhitā jānapadā adhammabalinā hatā."],"lineRefs":[["ja520:22"]]},{"para":6668,"vripara":"355","refs":["ja520:22"],"lines":["“Rattiñhi corā khādanti, divā khādanti tuṇḍiyā;"],"lineRefs":[["ja520:22"]]},{"para":6669,"vripara":null,"refs":["ja520:22"],"lines":["Raṭṭhasmiṃ kūṭarājassa, bahu adhammiko jano."],"lineRefs":[["ja520:22"]]},{"para":6671,"vripara":"356","refs":["ja520:22"],"lines":["“Sā nūna puna re pakkā, vikāle bhattamāhari;"],"lineRefs":[["ja520:22"]]},{"para":6672,"vripara":null,"refs":["ja520:22"],"lines":["Bhattahāriṃ apekkhanto, hato phālena sāliyo”ti."],"lineRefs":[["ja520:22"]]},{"para":6673,"vripara":null,"refs":["ja520:22","ja520:25"],"lines":["Tattha <b>dhammenā</b>ti kāraṇeneva, akāraṇena akkosatīti saññaṃ mā kari.","<b>Sā nūna puna re pakkā, vikāle bhattamāharī</b>ti, brāhmaṇa, sā bhattahārikā itthī pātova mama bhattaṃ pacitvā āharantī adhammabalisādhakehi brahmadattassa dāsehi palibuddhā bhavissati, te parivisitvā puna mayhaṃ bhattaṃ pakkaṃ bhavissati, tena kāraṇena vikāle bhattaṃ āhari,“ajja vikāle bhattaṃ āharī”ti cintetvā chātajjhatto ahaṃ taṃ bhattahāriṃ olokento goṇaṃ aṭṭhāne patodena vijjhiṃ, tenesa pādaṃ ukkhipitvā phālaṃ paharanto hato phālena sāliyo.","Tasmā “esa mayā hato”ti saññaṃ mā kari, pāparaññoyeva hato nāmesa, mā tassa vaṇṇaṃ bhaṇīti."],"lineRefs":[["ja520:22"],["ja520:25"],["ja520:25"]]},{"para":6674,"vripara":null,"refs":["ja520:25"],"lines":["Te purato gantvā ekasmiṃ gāme vasiṃsu.","Punadivase pātova ekā kūṭadhenu godohakaṃ pādena paharitvā saddhiṃ khīrena pavaṭṭesi.","So brahmadattaṃ akkosanto gāthamāha –"],"lineRefs":[["ja520:25"],["ja520:25"],["ja520:25"]]},{"para":6676,"vripara":"357","refs":["ja520:25"],"lines":["“Evaṃ haññatu pañcālo, saṅgāme asinā hato;"],"lineRefs":[["ja520:25"]]},{"para":6677,"vripara":null,"refs":["ja520:25"],"lines":["Yathāhamajja pahato, khīrañca me pavaṭṭitan”ti."],"lineRefs":[["ja520:25"]]},{"para":6678,"vripara":null,"refs":["ja520:25"],"lines":["Taṃ sutvā purohito paṭisedhento gāthamāha –"],"lineRefs":[["ja520:25"]]},{"para":6680,"vripara":"358","refs":["ja520:25"],"lines":["“Yaṃ pasu khīraṃ chaḍḍeti, pasupālaṃ vihiṃsati;"],"lineRefs":[["ja520:25"]]},{"para":6681,"vripara":null,"refs":["ja520:25"],"lines":["Kiṃ tattha brahmadattassa, yaṃ no garahate bhavan”ti."],"lineRefs":[["ja520:25"]]},{"para":6682,"vripara":null,"refs":["ja520:25"],"lines":["Brāhmaṇena gāthāya vuttāya puna so tisso gāthā abhāsi –"],"lineRefs":[["ja520:25"]]},{"para":6684,"vripara":"359","refs":["ja520:25"],"lines":["“Gārayho brahme pañcālo, brahmadattassa rājino;"],"lineRefs":[["ja520:25"]]},{"para":6685,"vripara":null,"refs":["ja520:25"],"lines":["Arakkhitā jānapadā, adhammabalinā hatā."],"lineRefs":[["ja520:25"]]},{"para":6687,"vripara":"360","refs":["ja520:25"],"lines":["“Rattiñhi corā khādanti, divā khādanti tuṇḍiyā;"],"lineRefs":[["ja520:25"]]},{"para":6688,"vripara":null,"refs":["ja520:25"],"lines":["Raṭṭhasmiṃ kūṭarājassa, bahu adhammiko jano."],"lineRefs":[["ja520:25"]]},{"para":6690,"vripara":"361","refs":["ja520:25"],"lines":["“Caṇḍā aṭanakā gāvī, yaṃ pure na duhāmase;"],"lineRefs":[["ja520:25"]]},{"para":6691,"vripara":null,"refs":["ja520:25"],"lines":["Taṃ dāni ajja dohāma, khīrakāmehupaddutā”ti."],"lineRefs":[["ja520:25"]]},{"para":6692,"vripara":null,"refs":["ja520:30"],"lines":["Tattha <b>caṇḍā</b>ti pharusā.","<b>Aṭanakā</b>ti palāyanasīlā.","<b>Khīrakāmehī</b>ti adhammikarañño purisehi bahuṃ khīraṃ āharāpentehi upaddutā duhāma.","Sace hi so dhammena rajjaṃ kāreyya, na no evarūpaṃ bhayaṃ āgaccheyyāti."],"lineRefs":[["ja520:30"],["ja520:30"],["ja520:30"],["ja520:30"]]},{"para":6693,"vripara":null,"refs":["ja520:30"],"lines":["Te “so yuttaṃ kathetī”ti tamhā gāmā nikkhamma mahāmaggaṃ āruyha nagarābhimukhā gamiṃsu.","Ekasmiñca gāme balisādhakā asikosatthāya ekaṃ taruṇaṃ kabaravacchakaṃ māretvā cammaṃ gaṇhiṃsu.","Vacchakamātā dhenu puttasokena tiṇaṃ na khādati pānīyaṃ na pivati, paridevamānā āhiṇḍati.","Taṃ disvā gāmadārakā rājānaṃ akkosantā gāthamāhaṃsu –"],"lineRefs":[["ja520:30"],["ja520:30"],["ja520:30"],["ja520:30"]]},{"para":6695,"vripara":"362","refs":["ja520:30"],"lines":["“Evaṃ kandatu pañcālo, viputto vippasukkhatu;"],"lineRefs":[["ja520:30"]]},{"para":6696,"vripara":null,"refs":["ja520:30"],"lines":["Yathāyaṃ kapaṇā gāvī, viputtā paridhāvatī”ti."],"lineRefs":[["ja520:30"]]},{"para":6697,"vripara":null,"refs":["ja520:31"],"lines":["Tattha <b>paridhāvatī</b>ti paridevamāno dhāvati."],"lineRefs":[["ja520:31"]]},{"para":6698,"vripara":null,"refs":["ja520:31"],"lines":["Tato purohito itaraṃ gāthamāha –"],"lineRefs":[["ja520:31"]]},{"para":6700,"vripara":"363","refs":["ja520:31"],"lines":["“Yaṃ pasu pasupālassa, sambhameyya raveyya vā;"],"lineRefs":[["ja520:31"]]},{"para":6701,"vripara":null,"refs":["ja520:31"],"lines":["Konīdha aparādhatthi, brahmadattassa rājino”ti."],"lineRefs":[["ja520:31"]]},{"para":6702,"vripara":null,"refs":["ja520:32"],"lines":["Tattha <b>sambhameyya raveyya vā</b>ti bhameyya vā viraveyya vā.","Idaṃ vuttaṃ hoti – tātā, pasu nāma pasupālassa rakkhantasseva dhāvatipi viravatipi, tiṇampi na khādati pānīyampi na pivati, idha rañño ko nu aparādhoti."],"lineRefs":[["ja520:32"],["ja520:32"]]},{"para":6703,"vripara":null,"refs":["ja520:32"],"lines":["Tato gāmadārakā dve gāthā abhāsiṃsu –"],"lineRefs":[["ja520:32"]]},{"para":6705,"vripara":"364","refs":["ja520:32"],"lines":["“Aparādho mahābrahme, brahmadattassa rājino;"],"lineRefs":[["ja520:32"]]},{"para":6706,"vripara":null,"refs":["ja520:32"],"lines":["Arakkhitā jānapadā, adhammabalinā hatā."],"lineRefs":[["ja520:32"]]},{"para":6708,"vripara":"365","refs":["ja520:32"],"lines":["“Rattiñhi corā khādanti, divā khādanti tuṇḍiyā;"],"lineRefs":[["ja520:32"]]},{"para":6709,"vripara":null,"refs":["ja520:32"],"lines":["Raṭṭhasmiṃ kūṭarājassa, bahu adhammiko jano;"],"lineRefs":[["ja520:32"]]},{"para":6710,"vripara":null,"refs":["ja520:32"],"lines":["Kathaṃ no asikosatthā, khīrapā haññate pajā”ti."],"lineRefs":[["ja520:32"]]},{"para":6711,"vripara":null,"refs":["ja520:32","ja520:34"],"lines":["Tattha <b>mahābrahme</b>ti mahābrāhmaṇa.","<b>Rājino</b>ti rañño.","<b>Kathaṃ no</b>ti kathaṃ nu kena nāma kāraṇena.","<b>Khīrapā haññate pajā</b>ti pāparājassa sevakehi khīrapako vacchako haññati, idāni sā dhenu puttasokena paridevati, sopi rājā ayaṃ dhenu viya paridevatūti rājānaṃ akkosiṃsuyeva."],"lineRefs":[["ja520:32"],["ja520:32"],["ja520:34"],["ja520:34"]]},{"para":6712,"vripara":null,"refs":["ja520:34"],"lines":["Te “sādhu vo kāraṇaṃ vadathā”ti vatvā pakkamiṃsu.","Athantarāmagge ekissā sukkhapokkharaṇiyā kākā tuṇḍehi vijjhitvā maṇḍūke khādanti.","Bodhisatto tesu taṃ ṭhānaṃ sampattesu attano ānubhāvena maṇḍūkena –"],"lineRefs":[["ja520:34"],["ja520:34"],["ja520:34"]]},{"para":6714,"vripara":"366","refs":["ja520:34"],"lines":["“Evaṃ khajjatu pañcālo, hato yuddhe saputtako;"],"lineRefs":[["ja520:34"]]},{"para":6715,"vripara":null,"refs":["ja520:34"],"lines":["Yathāhamajja khajjāmi, gāmikehi araññajo”ti.","–"],"lineRefs":[["ja520:34"],["ja520:34"]]},{"para":6716,"vripara":null,"refs":["ja520:34"],"lines":["Rājānaṃ akkosāpesi."],"lineRefs":[["ja520:34"]]},{"para":6717,"vripara":null,"refs":["ja520:35"],"lines":["Tattha <b>gāmikehī</b>ti gāmavāsīhi."],"lineRefs":[["ja520:35"]]},{"para":6718,"vripara":null,"refs":["ja520:35"],"lines":["Taṃ sutvā purohito maṇḍūkena saddhiṃ sallapanto gāthamāha –"],"lineRefs":[["ja520:35"]]},{"para":6720,"vripara":"367","refs":["ja520:35"],"lines":["“Na sabbabhūtesu vidhenti rakkhaṃ, rājāno maṇḍūka manussaloke;"],"lineRefs":[["ja520:35"]]},{"para":6721,"vripara":null,"refs":["ja520:35"],"lines":["Nettāvatā rājā adhammacārī, yaṃ tādisaṃ jīvamadeyyu dhaṅkā”ti."],"lineRefs":[["ja520:35"]]},{"para":6722,"vripara":null,"refs":["ja520:36"],"lines":["Tattha <b>jīvan</b>ti jīvantaṃ.","<b>Adeyyun</b>ti khādeyyuṃ.","<b>Dhaṅkā</b>ti kākā.","Ettāvatā rājā adhammiko nāma na hoti, kiṃ sakkā araññaṃ pavisitvā raññā taṃ rakkhantena caritunti."],"lineRefs":[["ja520:36"],["ja520:36"],["ja520:36"],["ja520:36"]]},{"para":6723,"vripara":null,"refs":["ja520:36"],"lines":["Taṃ sutvā maṇḍūko dve gāthā abhāsi –"],"lineRefs":[["ja520:36"]]},{"para":6725,"vripara":"368","refs":["ja520:36"],"lines":["“Adhammarūpo vata brahmacārī, anuppiyaṃ bhāsasi khattiyassa;"],"lineRefs":[["ja520:36"]]},{"para":6726,"vripara":null,"refs":["ja520:36"],"lines":["Viluppamānāya puthuppajāya, pūjesi rājaṃ paramappamādaṃ."],"lineRefs":[["ja520:36"]]},{"para":6728,"vripara":"369","refs":["ja520:36"],"lines":["“Sace idaṃ brahme surajjakaṃ siyā, phītaṃ raṭṭhaṃ muditaṃ vippasannaṃ;"],"lineRefs":[["ja520:36"]]},{"para":6729,"vripara":null,"refs":["ja520:36"],"lines":["Bhutvā baliṃ aggapiṇḍañca kākā, na mādisaṃ jīvamadeyyu dhaṅkā”ti."],"lineRefs":[["ja520:36"]]},{"para":6730,"vripara":null,"refs":["ja520:36","ja520:38"],"lines":["Tattha <b>brahmacārī</b>ti purohitaṃ garahanto āha.","<b>Khattiyassā</b>ti evarūpassa pāparañño.","<b>Viluppamānāyā</b>ti vilumpamānāya, ayameva vā pāṭho.","<b>Puthuppajāyā</b>ti vipulāya pajāya vināsiyamānāya.","<b>Pūjesī</b>ti pasaṃsi.","<b>Surajjakan</b>ti chandādivasena agantvā dasa rājadhamme akopentena appamattena raññā rakkhiyamānaṃ sace idaṃ surajjakaṃ bhaveyya.","<b>Phītan</b>ti devesu sammādhāraṃ anuppavecchantesu sampannasassaṃ.","<b>Na mādisan</b>ti evaṃ sante mādisaṃ jīvamānaññeva kākā na khādeyyuṃ."],"lineRefs":[["ja520:36"],["ja520:36"],["ja520:36"],["ja520:36"],["ja520:36"],["ja520:38"],["ja520:38"],["ja520:38"]]}],"wordLinks":[["ja520:11.1","upassutiṃ",0,6],["ja520:11.3","tatthā",0,7],["ja520:13.3","maggeyyā",7,0],["ja520:16.1","tātā",15,6],["ja520:16.1","māṇavā",15,7],["ja520:16.3","nillenakānī",15,8],["ja520:16.3","vane āhatva kaṇṭakaṃ",15,9],["ja520:17.3","appatikā",19,0],["ja520:20.5","dujjīve",29,1],["ja520:20.5","kuto bhattā kumāriyo",29,1],["ja520:21.3","yathā",33,0],["ja520:22.1","adhammenā",37,0],["ja520:25.1","sā nūna puna re pakkā vikāle bhattamāharī",45,1],["ja520:30.1","caṇḍā",59,0],["ja520:30.1","aṭanakā",59,1],["ja520:30.3","khīrakāmehī",59,2],["ja520:31.3","paridhāvatī",63,0],["ja520:32.1","sambhameyya raveyya vā",67,0],["ja520:34.5","kathaṃ no",74,2],["ja520:34.5","khīrapā haññate pajā",74,3],["ja520:35.3","gāmikehī",79,0],["ja520:36.3","jīvaṃ",83,0],["ja520:36.3","adeyyuṃ",83,1],["ja520:36.3","dhaṅkā",83,2],["ja520:38.1","surajjakaṃ",89,5],["ja520:38.1","phītaṃ",89,6],["ja520:38.3","na mādisaṃ",89,7]],"after":[{"para":6731,"vripara":null,"title":"[520] 10. Gandhatindukajātakavaṇṇanā","lines":["Evaṃ chasupi ṭhānesu akkosanaṃ bodhisattasseva ānubhāvena ahosi;"]},{"para":6732,"vripara":null,"title":"[520] 10. Gandhatindukajātakavaṇṇanā","lines":["Taṃ sutvā rājā ca purohito ca “araññavāsiṃ tiracchānagataṃ maṇḍūkaṃ upādāya sabbe amheyeva akkosantī”ti vatvā tato nagaraṃ gantvā dhammena rajjaṃ kāretvā mahāsattassovāde ṭhitā dānādīni puññāni kariṃsu."]},{"para":6733,"vripara":null,"title":"[520] 10. Gandhatindukajātakavaṇṇanā","lines":["Satthā kosalarañño imaṃ dhammadesanaṃ āharitvā,“mahārāja, raññā nāma agatigamanaṃ pahāya dhammena rajjaṃ kāretabban”ti vatvā jātakaṃ samodhānesi “tadā gandhatindukadevatā ahameva ahosin”ti."]},{"para":6734,"vripara":null,"title":"[520] 10. Gandhatindukajātakavaṇṇanā","lines":["Gandhatindukajātakavaṇṇanā dasamā."]},{"para":6735,"vripara":null,"title":"[520] 10. Gandhatindukajātakavaṇṇanā","lines":["Jātakuddānaṃ"]},{"para":6736,"vripara":null,"title":"[520] 10. Gandhatindukajātakavaṇṇanā","lines":["Kiṃchanda kumbha jayaddisa chaddanta, atha paṇḍitasambhava sirakapi;"]},{"para":6737,"vripara":null,"title":"[520] 10. Gandhatindukajātakavaṇṇanā","lines":["Dakarakkhasa paṇḍaranāgavaro, atha sambula tindukadevasutoti."]},{"para":6738,"vripara":null,"title":"[520] 10. Gandhatindukajātakavaṇṇanā","lines":["Tiṃsanipātavaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
