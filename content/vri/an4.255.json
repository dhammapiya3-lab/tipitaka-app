{"suttaId":"an4.255","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1866,1867],"vripara":"255"},"segments":{"an4.255:0.3":"Pariyesanāsuttaṃ","an4.255:1.1":"“Catasso imā, bhikkhave, anariyapariyesanā.","an4.255:1.2":"Katamā catasso?","an4.255:1.3":"Idha, bhikkhave, ekacco attanā jarādhammo samāno jarādhammaṃyeva pariyesati;","an4.255:1.4":"attanā byādhidhammo samāno byādhidhammaṃyeva pariyesati;","an4.255:1.5":"attanā maraṇadhammo samāno maraṇadhammaṃyeva pariyesati;","an4.255:1.6":"attanā saṃkilesadhammo samāno saṃkilesadhammaṃyeva pariyesati.","an4.255:1.7":"Imā kho, bhikkhave, catasso anariyapariyesanā.","an4.255:2.1":"“Catasso imā, bhikkhave, ariyapariyesanā.","an4.255:2.2":"Katamā catasso?","an4.255:2.3":"Idha, bhikkhave, ekacco attanā jarādhammo samāno jarādhamme ādīnavaṃ viditvā ajaraṃ anuttaraṃ yogakkhemaṃ nibbānaṃ pariyesati;","an4.255:2.4":"attanā byādhidhammo samāno byādhidhamme ādīnavaṃ viditvā abyādhiṃ anuttaraṃ yogakkhemaṃ nibbānaṃ pariyesati;","an4.255:2.5":"attanā maraṇadhammo samāno maraṇadhamme ādīnavaṃ viditvā amataṃ anuttaraṃ yogakkhemaṃ nibbānaṃ pariyesati;","an4.255:2.6":"attanā saṃkilesadhammo samāno saṃkilesadhamme ādīnavaṃ viditvā asaṃkiliṭṭhaṃ anuttaraṃ yogakkhemaṃ nibbānaṃ pariyesati.","an4.255:2.7":"Imā kho, bhikkhave, catasso ariyapariyesanā”ti.","an4.255:2.8":"Dutiyaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1711,"to":1712,"paras":[{"para":1711,"vripara":"254-256","refs":["an4.255:1"],"lines":["254-256. Chaṭṭhassa paṭhame <b>abhiññāyā</b>ti jānitvā.","<b>Samatho ca vipassanā cā</b>ti cittekaggatā ca saṅkhārapariggahavipassanāñāṇañca.","<b>Vijjā ca vimutti cā</b>ti maggañāṇavijjā ca sesā sampayuttakadhammā ca.","Dutiye <b>anariyapariyesanā</b>ti anariyānaṃ esanā gavesanā.","<b>Jarādhamman</b>ti jarāsabhāvaṃ.","Sesesupi eseva nayo.","Tatiyaṃ uttānameva."],"lineRefs":[["an4.255:1"],["an4.255:1"],["an4.255:1"],["an4.255:1"],["an4.255:1"],["an4.255:1"],["an4.255:1"]]},{"para":1712,"vripara":null,"refs":["an4.255:1"],"lines":["Mālukyaputtasuttavaṇṇanā"],"lineRefs":[["an4.255:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1916,"to":1919,"paras":[{"para":1916,"vripara":"254-256","refs":["an4.255:1"],"lines":["254-256. Chaṭṭhassa paṭhame paccanīkasamanato <b>samatho,</b> samādhīti āha <b>“cittekaggatā”</b>ti.","Aniccādinā vividhenākārena dassanato <b>vipassanā,</b> saṅkhārapariggāhakañāṇaṃ.","Tenāha <b>“saṅkhārapariggahavipassanāñāṇan”</b>ti."],"lineRefs":[["an4.255:1"],["an4.255:1"],["an4.255:1"]]},{"para":1917,"vripara":null,"refs":[],"lines":["Dutiye anariyehi pariyesitabbattā anariyānaṃ pariyesanāti <b>anariyapariyesanā</b>.","Sayaṃ lāmakatāya anariyānaṃ pariyesanāti vā <b>anariyapariyesanā.</b>","<b>Jarāsabhāvan</b>ti jīraṇapakatikaṃ.","Tatiyaṃ uttānameva."],"lineRefs":[[],[],[],[]]},{"para":1918,"vripara":null,"refs":[],"lines":["Abhiññāsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1919,"vripara":null,"refs":["an4.255:1"],"lines":["4-10. Mālukyaputtasuttādivaṇṇanā"],"lineRefs":[["an4.255:1"]]}],"wordLinks":[]}}
