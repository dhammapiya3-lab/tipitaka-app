{"suttaId":"tha-ap418","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[14423,14474],"vripara":"124"},"segments":{"tha-ap418:0.3":"Ekadīpiyattheraapadānaṃ","tha-ap418:1.1":"“Parinibbute sugate,","tha-ap418:1.2":"siddhatthe lokanāyake;","tha-ap418:1.3":"Sadevamānusā sabbe,","tha-ap418:1.4":"pūjenti dvipaduttamaṃ. 125.","tha-ap418:2.1":"“Āropite ca citake,","tha-ap418:2.2":"siddhatthe lokanāyake;","tha-ap418:2.3":"Yathāsakena thāmena,","tha-ap418:2.4":"citaṃ pūjenti satthuno. 126.","tha-ap418:3.1":"“Avidūre citakassa,","tha-ap418:3.2":"dīpaṃ ujjālayiṃ ahaṃ;","tha-ap418:3.3":"Yāva udeti sūriyo,","tha-ap418:3.4":"dīpaṃ me tāva ujjali. 127.","tha-ap418:4.1":"“Tena kammena sukatena,","tha-ap418:4.2":"cetanāpaṇidhīhi ca;","tha-ap418:4.3":"Jahitvā mānusaṃ dehaṃ,","tha-ap418:4.4":"tāvatiṃsamagacchahaṃ. 128.","tha-ap418:5.1":"“Tattha me sukataṃ byamhaṃ,","tha-ap418:5.2":"ekadīpīti ñāyati;","tha-ap418:5.3":"Dīpasatasahassāni,","tha-ap418:5.4":"byamhe pajjalare mama. 129.","tha-ap418:6.1":"“Udayantova sūriyo,","tha-ap418:6.2":"deho me jotate sadā;","tha-ap418:6.3":"Sappabhāhi sarīrassa,","tha-ap418:6.4":"āloko hoti me sadā. 130.","tha-ap418:7.1":"“Tirokuṭṭaṃ [tirokuḍḍaṃ (sī. syā. ka.)] tiroselaṃ,","tha-ap418:7.2":"samatiggayha [sabbatthapi evameva dissati] pabbataṃ;","tha-ap418:7.3":"Samantā yojanasataṃ,","tha-ap418:7.4":"passāmi cakkhunā ahaṃ. 131.","tha-ap418:8.1":"“Sattasattatikkhattuñca,","tha-ap418:8.2":"devaloke ramiṃ ahaṃ;","tha-ap418:8.3":"Ekatiṃsatikkhattuñca,","tha-ap418:8.4":"devarajjamakārayiṃ. 132.","tha-ap418:9.1":"“Aṭṭhavīsatikkhattuñca,","tha-ap418:9.2":"cakkavattī ahosahaṃ;","tha-ap418:9.3":"Padesarajjaṃ vipulaṃ,","tha-ap418:9.4":"gaṇanāto asaṅkhiyaṃ. 133.","tha-ap418:10.1":"“Devalokā cavitvāna,","tha-ap418:10.2":"nibbattiṃ mātukucchiyaṃ;","tha-ap418:10.3":"Mātukucchigatassāpi,","tha-ap418:10.4":"akkhi me na nimīlati. 134.","tha-ap418:11.1":"“Jātiyā catuvassohaṃ,","tha-ap418:11.2":"pabbajiṃ anagāriyaṃ;","tha-ap418:11.3":"Aḍḍhamāse asampatte,","tha-ap418:11.4":"arahattamapāpuṇiṃ. 135.","tha-ap418:12.1":"“Dibbacakkhuṃ visodhesiṃ,","tha-ap418:12.2":"bhavā sabbe samūhatā;","tha-ap418:12.3":"Sabbe kilesā sañchinnā,","tha-ap418:12.4":"ekadīpassidaṃ phalaṃ. 136.","tha-ap418:13.1":"“Tirokuṭṭaṃ tiroselaṃ,","tha-ap418:13.2":"pabbatañcāpi kevalaṃ;","tha-ap418:13.3":"Samatikkamma [sabbatthapī evameva dissati] passāmi,","tha-ap418:13.4":"ekadīpassidaṃ phalaṃ. 137.","tha-ap418:14.1":"“Visamā me samā honti,","tha-ap418:14.2":"andhakāro na vijjati;","tha-ap418:14.3":"Nāhaṃ passāmi timiraṃ,","tha-ap418:14.4":"ekadīpassidaṃ phalaṃ. 138.","tha-ap418:15.1":"“Catunnavutito kappe,","tha-ap418:15.2":"yaṃ dīpamadadiṃ tadā;","tha-ap418:15.3":"Duggatiṃ nābhijānāmi,","tha-ap418:15.4":"ekadīpassidaṃ phalaṃ. 139.","tha-ap418:16.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap418:16.3":"viharāmi anāsavo. 140.","tha-ap418:17.1":"“Svāgataṃ vata me āsi…pe…","tha-ap418:17.3":"kataṃ buddhassa sāsanaṃ. 141.","tha-ap418:18.1":"“Paṭisambhidā catasso…pe…","tha-ap418:18.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap418:19.1":"Itthaṃ sudaṃ āyasmā ekadīpiyo thero imā gāthāyo abhāsitthāti.","tha-ap418:20.1":"Ekadīpiyattherassāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
