{"suttaId":"sn5.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[2043,2054],"vripara":"168"},"segments":{"sn5.7:0.3":"Upacālāsuttaṃ","sn5.7:1.1":"Sāvatthinidānaṃ.","sn5.7:1.2":"Atha kho upacālā bhikkhunī pubbaṇhasamayaṃ nivāsetvā…pe…","sn5.7:1.3":"aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi.","sn5.7:1.4":"Atha kho māro pāpimā yena upacālā bhikkhunī tenupasaṅkami; upasaṅkamitvā upacālaṃ bhikkhuniṃ etadavoca –","sn5.7:1.5":"“kattha nu tvaṃ, bhikkhuni, uppajjitukāmā”ti?","sn5.7:1.6":"“Na khvāhaṃ, āvuso, katthaci uppajjitukāmā”ti.","sn5.7:2.1":"“Tāvatiṃsā ca yāmā ca,","sn5.7:2.2":"tusitā cāpi devatā;","sn5.7:2.3":"Nimmānaratino devā,","sn5.7:2.4":"ye devā vasavattino;","sn5.7:2.5":"Tattha cittaṃ paṇidhehi,","sn5.7:2.6":"ratiṃ paccanubhossasī”ti.","sn5.7:3.1":"“Tāvatiṃsā ca yāmā ca,","sn5.7:3.2":"tusitā cāpi devatā;","sn5.7:3.3":"Nimmānaratino devā,","sn5.7:3.4":"ye devā vasavattino;","sn5.7:3.5":"Kāmabandhanabaddhā te,","sn5.7:3.6":"enti māravasaṃ puna.","sn5.7:4.1":"“Sabbo ādīpito [sabbova āditto (syā. kaṃ.)] loko,","sn5.7:4.2":"sabbo loko padhūpito;","sn5.7:4.3":"Sabbo pajjalito [pajjalito (sabbattha)] loko,","sn5.7:4.4":"sabbo loko pakampito.","sn5.7:5.1":"“Akampitaṃ apajjalitaṃ [acalitaṃ (sī. syā. kaṃ. pī.)],","sn5.7:5.2":"aputhujjanasevitaṃ;","sn5.7:5.3":"Agati yattha mārassa,","sn5.7:5.4":"tattha me nirato mano”ti.","sn5.7:6.1":"Atha kho māro pāpimā “jānāti maṃ upacālā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti. 8."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":885,"to":885,"paras":[{"para":885,"vripara":"168","refs":["sn5.7:3","sn5.7:4","sn5.7:5"],"lines":["Sattame <b>enti māravasaṃ punā</b>ti punappunaṃ maraṇamārakilesamāradevaputtamārānaṃ vasaṃ āgacchanti.","<b>Padhūpito</b>ti santāpito.","<b>Agati yattha mārassā</b>ti yattha tuyhaṃ mārassa agati.","<b>Tatthā</b>ti tasmiṃ nibbāne.","Sattamaṃ. 8."],"lineRefs":[["sn5.7:3"],["sn5.7:4"],["sn5.7:5"],["sn5.7:5"],["sn5.7:5"]]}],"wordLinks":[["sn5.7:3.5","enti māravasaṃ punā",0,0],["sn5.7:4.1","padhūpito",0,1],["sn5.7:5.3","agati yattha mārassā",0,2],["sn5.7:5.3","tatthā",0,3]],"before":[{"para":884,"vripara":null,"title":"Upacālāsuttavaṇṇanā","lines":["Upacālāsuttavaṇṇanā 168."]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1068,"to":1068,"paras":[{"para":1068,"vripara":"168","refs":["sn5.7:5"],"lines":["<b>Punappunaṃ…pe… āgacchanti</b> kāraṇassa asamūhatattā.","<b>Santāpito</b> kilesasantāpehi.","<b>Agatī</b>ti avisayo."],"lineRefs":[["sn5.7:5"],["sn5.7:5"],["sn5.7:5"]]}],"wordLinks":[["sn5.7:5.3","agatī",0,2]],"before":[{"para":1067,"vripara":null,"title":"Upacālāsuttavaṇṇanā","lines":["Upacālāsuttavaṇṇanā 168."]}],"after":[{"para":1069,"vripara":null,"title":"Upacālāsuttavaṇṇanā","lines":["Upacālāsuttavaṇṇanā niṭṭhitā. 8."]}]},"tika2":null}
