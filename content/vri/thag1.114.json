{"suttaId":"thag1.114","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[660,663],"vripara":"114"},"segments":{"thag1.114:0.4":"Adhimuttattheragāthā","thag1.114:1.1":"“Kāyaduṭṭhullagaruno,","thag1.114:1.2":"hiyyamānamhi [hīyamānamhi (sī.)] jīvite;","thag1.114:1.3":"Sarīrasukhagiddhassa,","thag1.114:1.4":"kuto samaṇasādhutā”ti.","thag1.114:1.5":"… Adhimutto thero …."},"unsure":[],"preface":[],"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":2807,"to":2807,"paras":[{"para":2807,"vripara":null,"refs":["thag1.114:1"],"lines":["Tattha <b>kāyaduṭṭhullagaruno</b>ti duṭṭhullaṃ asubhayogyatā, kāyassa duṭṭhullaṃ kāyaduṭṭhullaṃ, kāyaduṭṭhullaṃ garu sambhāvitaṃ yassa so kāyaduṭṭhullagaru, anissaraṇappañño hutvā kāyaposanappasuto kāyadaḷhibahuloti attho, tassa kāyaduṭṭhullagaruno.","<b>Hiyyamānamhi jīvite</b>ti kunnadīnaṃ udakaṃ viya jīvitasaṅkhāre lahuso khīyamāne.","<b>Sarīrasukhagiddhassā</b>ti paṇītāhārādīhi attano kāyassa sukhena gedhaṃ āpannassa.","<b>Kuto samaṇasādhutā</b>ti evarūpassa puggalassa samaṇabhāvena sādhutā susamaṇatā kuto kena kāraṇena siyā, ekaṃsato pana kāye jīvite ca nirapekkhassa itarītarasantosena santuṭṭhassa āraddhavīriyasseva samaṇasādhutāti adhippāyo."],"lineRefs":[["thag1.114:1"],["thag1.114:1"],["thag1.114:1"],["thag1.114:1"]]}],"wordLinks":[["thag1.114:1.1","kāyaduṭṭhullagaruno",0,0],["thag1.114:1.1","hiyyamānamhi jīvite",0,1],["thag1.114:1.3","sarīrasukhagiddhassā",0,2],["thag1.114:1.3","kuto samaṇasādhutā",0,3]],"before":[{"para":2748,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Adhimuttattheragāthāvaṇṇanā"]},{"para":2749,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["<b>Kāyaduṭṭhullagaruno</b>ti āyasmato adhimuttattherassa gāthā.","Kā uppatti?","So kira padumuttarassa bhagavato kāle brāhmaṇakule nibbattitvā viññutaṃ patto brāhmaṇavijjāsu nipphattiṃ gato kāmesu ādīnavaṃ disvā gharāvāsaṃ pahāya tāpasapabbajjaṃ pabbajitvā araññe viharanto buddhuppādaṃ sutvā manussūpacāraṃ upagantvā satthāraṃ bhikkhusaṅghaparivutaṃ gacchantaṃ disvā pasannamānaso attano vākacīraṃ satthu pādamūle patthari.","Satthā tassa ajjhāsayaṃ ñatvā tasmiṃ aṭṭhāsi.","Tattha ṭhitaṃ bhagavantaṃ kāḷānusārena gandhena pūjetvā “samuddharasimaṃ lokan”tiādikāhi dasahi gāthāhi abhitthavi.","Taṃ satthā “anāgate ito satasahassakappamatthake gotamassa nāma sammāsambuddhassa sāsane pabbajitvā chaḷabhiñño bhavissatī”ti byākaritvā pakkāmi.","So tena puññakammena devaloke nibbattitvā tato yāvāyaṃ buddhuppādo, tāva devamanussesu saṃsaranto imasmiṃ buddhuppāde sāvatthiyaṃ brāhmaṇakule nibbattitvā <b>adhimutto</b>ti laddhanāmo viññutaṃ patto brāhmaṇavijjāsu nipphattiṃ gantvā tattha sāraṃ apassanto pacchimabhavikattā nissaraṇaṃ gavesanto jetavanapaṭiggahaṇe buddhānubhāvaṃ disvā paṭiladdhasaddho satthu santike pabbajitvā vipassanaṃ paṭṭhapetvā nacirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. thera 1.40.304-332)–"]},{"para":2750,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Kaṇikāraṃva jalitaṃ, dīparukkhaṃva ujjalaṃ;"]},{"para":2751,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Osadhiṃva virocantaṃ, vijjutaṃ gagane yathā."]},{"para":2752,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Asambhītaṃ anuttāsiṃ, migarājaṃva kesariṃ;"]},{"para":2753,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Ñāṇālokaṃ pakāsentaṃ, maddantaṃ titthiye gaṇe."]},{"para":2754,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Uddharantaṃ imaṃ lokaṃ, chindantaṃ sabbasaṃsayaṃ;"]},{"para":2755,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Gajjantaṃ migarājaṃva, addasaṃ lokanāyakaṃ."]},{"para":2756,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Jaṭājinadharo āsiṃ, brahā uju patāpavā;"]},{"para":2757,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Vākacīraṃ gahetvāna, pādamūle apatthariṃ."]},{"para":2758,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Kāḷānusāriyaṃ gayhaṃ, anulimpiṃ tathāgataṃ;"]},{"para":2759,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Sambuddhamanulimpetvā, santhaviṃ lokanāyakaṃ."]},{"para":2760,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Samuddharasimaṃ lokaṃ, oghatiṇṇa mahāmuni;"]},{"para":2761,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Ñāṇālokena jotesi, nāvaṭaṃ ñāṇamuttamaṃ."]},{"para":2762,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Dhammacakkaṃ pavattesi, maddase paratitthiye;"]},{"para":2763,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Usabho jitasaṅgāmo, sampakampesi medaniṃ."]},{"para":2764,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Mahāsamudde ūmiyo, velantamhi pabhijjare;"]},{"para":2765,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Tatheva tava ñāṇamhi, sabbadiṭṭhī pabhijjare."]},{"para":2766,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Sukhumacchikajālena, saramhi sampatānite;"]},{"para":2767,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Antojālīkatā pāṇā, pīḷitā honti tāvade."]},{"para":2768,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Tatheva titthiyā loke, puthupāsaṇḍanissitā;"]},{"para":2769,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Antoñāṇavare tuyhaṃ, parivattanti mārisa."]},{"para":2770,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Patiṭṭhā vuyhataṃ oghe, tvañhi nātho abandhunaṃ;"]},{"para":2771,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Bhayaṭṭitānaṃ saraṇaṃ, muttitthīnaṃ parāyaṇaṃ."]},{"para":2772,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Ekavīro asadiso, mettākaruṇasañcayo;"]},{"para":2773,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Asamo susamo santo, vasī tādī jitañjayo."]},{"para":2774,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Dhīro vigatasammoho, anejo akathaṃkathī;"]},{"para":2775,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Tusito vantadososi, nimmalo saṃyato suci."]},{"para":2776,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Saṅgātigo hatamado, tevijjo tibhavantago;"]},{"para":2777,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Sīmātigo dhammagaru, gatattho hitavabbhuto."]},{"para":2778,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Tārako tvaṃ yathā nāvā, nidhīvassāsakārako;"]},{"para":2779,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Asambhīto yathā sīho, gajarājāva dappito."]},{"para":2780,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Thometvā dasagāthāhi, padumuttaraṃ mahāyasaṃ;"]},{"para":2781,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Vanditvā satthuno pāde, tuṇhī aṭṭhāsahaṃ tadā."]},{"para":2782,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Padumuttaro lokavidū, āhutīnaṃ paṭiggaho;"]},{"para":2783,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Bhikkhusaṅghe ṭhito satthā, imā gāthā abhāsatha."]},{"para":2784,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Yo me sīlañca ñāṇañca, saddhammañcāpi vaṇṇayi;"]},{"para":2785,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Tamahaṃ kittayissāmi, suṇātha mama bhāsato."]},{"para":2786,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Saṭṭhi kappasahassāni, devaloke ramissati;"]},{"para":2787,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Aññe devebhibhavitvā, issaraṃ kārayissati."]},{"para":2788,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“So pacchā pabbajitvāna, sukkamūlena codito;"]},{"para":2789,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Gotamassa bhagavato, sāsane pabbajissati."]},{"para":2790,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Pabbajitvāna kāyena, pāpakammaṃ vivajjiya;"]},{"para":2791,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Sabbāsave pariññāya, nibbāyissatināsavo."]},{"para":2792,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Yathāpi megho thanayaṃ, tappeti medaniṃ imaṃ;"]},{"para":2793,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Tatheva tvaṃ mahāvīra, dhammena tappayī mamaṃ."]},{"para":2794,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Sīlaṃ paññañca dhammañca, thavitvā lokanāyakaṃ;"]},{"para":2795,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Pattomhi paramaṃ santiṃ, nibbānaṃ padamaccutaṃ."]},{"para":2796,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Aho nūna sa bhagavā, ciraṃ tiṭṭheyya cakkhumā;"]},{"para":2797,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Aññātañca vijāneyyuṃ, phuseyyuṃ amataṃ padaṃ."]},{"para":2798,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Ayaṃ me pacchimā jāti, bhavā sabbe samūhatā;"]},{"para":2799,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Sabbāsave pariññāya, viharāmi anāsavo."]},{"para":2800,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Satasahassito kappe, yaṃ buddhamabhithomayiṃ;"]},{"para":2801,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Duggatiṃ nābhijānāmi, kittanāya idaṃ phalaṃ."]},{"para":2802,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."]},{"para":2803,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Arahattaṃ pana patvā attanā saha vasante kāyadaḷhibahule bhikkhū ovadanto –"]},{"para":2805,"vripara":"114","title":"Adhimuttattheragāthāvaṇṇanā","lines":["“Kāyaduṭṭhullagaruno, hiyyamānamhi jīvite;"]},{"para":2806,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Sarīrasukhagiddhassa, kuto samaṇasādhutā”ti.","– gāthaṃ abhāsi;"]}],"after":[{"para":2808,"vripara":null,"title":"Adhimuttattheragāthāvaṇṇanā","lines":["Adhimuttattheragāthāvaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
