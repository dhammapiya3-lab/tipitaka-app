{"suttaId":"iti10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"It","vriCode":"s0504m.mul","paras":[70,79],"vripara":"10"},"segments":{"iti10:0.4":"Dosapariññāsuttaṃ","iti10:1.1":"Vuttañhetaṃ bhagavatā, vuttamarahatāti me sutaṃ –","iti10:2.1":"“Dosaṃ, bhikkhave, anabhijānaṃ aparijānaṃ tattha cittaṃ avirājayaṃ appajahaṃ abhabbo dukkhakkhayāya.","iti10:2.2":"Dosañca kho, bhikkhave, abhijānaṃ parijānaṃ tattha cittaṃ virājayaṃ pajahaṃ bhabbo dukkhakkhayāyā”ti.","iti10:2.3":"Etamatthaṃ bhagavā avoca.","iti10:2.4":"Tatthetaṃ iti vuccati –","iti10:3.1":"“Yena dosena duṭṭhāse,","iti10:3.2":"sattā gacchanti duggatiṃ;","iti10:3.3":"Taṃ dosaṃ sammadaññāya,","iti10:3.4":"pajahanti vipassino;","iti10:3.5":"Pahāya na punāyanti,","iti10:3.6":"imaṃ lokaṃ kudācana”nti.","iti10:4.1":"Ayampi attho vutto bhagavatā, iti me sutanti.","iti10:4.2":"Dasamaṃ.","iti10:4.3":"Paṭhamo vaggo niṭṭhito.","iti10:5.0":"Tassuddānaṃ –","iti10:5.1":"Rāgadosā atha moho,","iti10:5.2":"kodhamakkhā mānaṃ sabbaṃ;","iti10:5.3":"Mānato rāgadosā puna dve,","iti10:5.4":"pakāsitā vaggamāhu paṭhamanti. 2."},"unsure":[],"preface":[],"attha":{"book":"It-a","bookName":"Itivuttaka-aṭṭhakathā","vriCode":"s0504a.att","from":268,"to":272,"paras":[{"para":268,"vripara":"9-10","refs":["iti10:1"],"lines":["Navamadasamesu apubbaṃ natthi.","Desanāvilāsavasena tathā bujjhanakānaṃ veneyyānaṃ ajjhāsayavasena vā tathā desitānīti daṭṭhabbaṃ."],"lineRefs":[["iti10:1"],["iti10:1"]]},{"para":269,"vripara":null,"refs":["iti10:1"],"lines":["Navamadasamasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["iti10:1"]]},{"para":270,"vripara":null,"refs":["iti10:1"],"lines":["Paṭhamavaggavaṇṇanā niṭṭhitā. 2."],"lineRefs":[["iti10:1"]]},{"para":271,"vripara":null,"refs":["iti10:1"],"lines":["Dutiyavaggo 1-3."],"lineRefs":[["iti10:1"]]},{"para":272,"vripara":null,"refs":["iti10:1"],"lines":["Mohapariññādisuttavaṇṇanā 11-13."],"lineRefs":[["iti10:1"]]}],"wordLinks":[],"before":[{"para":267,"vripara":null,"title":"Lobhadosapariññāsuttadvayavaṇṇanā","lines":["Lobhadosapariññāsuttadvayavaṇṇanā 9-10."]}]},"tika":null,"tika2":null}
