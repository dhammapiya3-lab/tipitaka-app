{"suttaId":"thag2.29","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[945,951],"vripara":"177"},"segments":{"thag2.29:0.4":"Bhāradvājattheragāthā","thag2.29:1.1":"“Nadanti evaṃ sappaññā, sīhāva girigabbhare;","thag2.29:1.3":"Vīrā vijitasaṅgāmā, jetvā māraṃ savāhaniṃ [savāhanaṃ (bahūsu)].","thag2.29:2.1":"“Satthā ca pariciṇṇo me, dhammo saṅgho ca pūjito;","thag2.29:2.3":"Ahañca vitto sumano, puttaṃ disvā anāsavan”ti.","thag2.29:2.5":"… Bhāradvājo thero …."},"attha":null,"tika":null}
