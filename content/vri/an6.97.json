{"suttaId":"an6.97","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vi","vriCode":"s0403m2.mul","paras":[787,787],"vripara":"97"},"segments":{"an6.97:0.3":"Ānisaṃsasuttaṃ","an6.97:1.1":"“Chayime, bhikkhave, ānisaṃsā sotāpattiphalasacchikiriyāya.","an6.97:1.2":"Katame cha?","an6.97:1.3":"Saddhammaniyato hoti, aparihānadhammo hoti, pariyantakatassa dukkhaṃ hoti [dukkhaṃ na hoti (syā. pī. ka.)], asādhāraṇena ñāṇena samannāgato hoti, hetu cassa sudiṭṭho, hetusamuppannā ca dhammā.","an6.97:1.4":"Ime kho, bhikkhave, cha ānisaṃsā sotāpattiphalasacchikiriyāyā”ti.","an6.97:1.5":"Dutiyaṃ."},"attha":{"book":"Mp-vi","bookName":"Chakkanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":765,"to":766,"paras":[{"para":765,"vripara":"96-97","refs":["an6.97:1"],"lines":["96-97. Dasamassa paṭhame <b>ariyāyatane</b>ti majjhimadese.","<b>Indriyānan</b>ti manacchaṭṭhānaṃ.","Dutiye <b>saddhammaniyato</b>ti sāsanasaddhamme niyato.","<b>Asādhāraṇenā</b>ti puthujjanehi asādhāraṇena."],"lineRefs":[["an6.97:1"],["an6.97:1"],["an6.97:1"],["an6.97:1"]]},{"para":766,"vripara":null,"refs":["an6.97:1"],"lines":["Anavatthitasuttavaṇṇanā"],"lineRefs":[["an6.97:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-vi","bookName":"Chakkanipāta-ṭīkā","vriCode":"s0403t.tik","from":785,"to":787,"paras":[{"para":785,"vripara":"96-106","refs":["an6.97:1"],"lines":["96-106. Dasamassa paṭhamādīsu natthi vattabbaṃ.","Aṭṭhame mettā etassa atthīti mettāvā, tassa bhāvo <b>mettāvatā,</b> mettāpaṭipatti, tāya.","Sā pana mettāvatā mettāvasena pāricariyāti āha <b>“mettāyuttāya pāricariyāyā”</b>ti.","<b>Paricaranti</b> vippakatabrahmacariyattā.","Pariciṇṇasatthukena sāvakena nāma satthuno yāva dhammena kātabbā pāricariyā, tāya sammadeva sampāditattā.","Navamādīni uttānatthāni."],"lineRefs":[["an6.97:1"],["an6.97:1"],["an6.97:1"],["an6.97:1"],["an6.97:1"],["an6.97:1"]]},{"para":786,"vripara":null,"refs":["an6.97:1"],"lines":["Pātubhāvasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an6.97:1"]]},{"para":787,"vripara":null,"refs":["an6.97:1"],"lines":["Ānisaṃsavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["an6.97:1"]]}],"wordLinks":[]},"tika2":null}
