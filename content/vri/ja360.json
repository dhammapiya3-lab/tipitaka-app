{"suttaId":"ja360","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[3250,3269],"vripara":"55"},"segments":{"ja360:0.4":"Suyonandījātakaṃ (5-1-10)","ja360:1.1":"Vāti gandho timirānaṃ,","ja360:1.2":"kusamuddo ca [va (syā. pī.)] ghosavā;","ja360:1.3":"Dūre ito suyonandī [ito hi susandī (sī. syā.), itopi sussondī (pī.)],","ja360:1.4":"tambakāmā tudanti maṃ.","ja360:2.1":"Kathaṃ samuddamatari,","ja360:2.2":"kathaṃ addakkhi sedumaṃ [serumaṃ (sī. syā. pī.)];","ja360:2.3":"Kathaṃ tassā ca tuyhañca,","ja360:2.4":"ahu sagga [agga (sī. syā.)] samāgamo.","ja360:3.1":"Kurukacchā [bharukacchā (sī. syā. pī.)] payātānaṃ,","ja360:3.2":"vāṇijānaṃ dhanesinaṃ;","ja360:3.3":"Makarehi abhidā [makarehibbhidā (sī.), makarehi’ bhidā (syā.), makarehi bhinnā (pī.)] nāvā,","ja360:3.4":"phalakenāhamaplaviṃ.","ja360:4.1":"Sā maṃ saṇhena mudunā,","ja360:4.2":"niccaṃ candanagandhinī;","ja360:4.3":"Aṅgena [aṅkena (pī. ka.)] uddharī bhaddā,","ja360:4.4":"mātā puttaṃva orasaṃ.","ja360:5.1":"Sā maṃ annena pānena,","ja360:5.2":"vatthena sayanena ca;","ja360:5.3":"Attanāpi ca mandakkhī,","ja360:5.4":"evaṃ tamba vijānāhīti.","ja360:6.1":"Suyonandījātakaṃ dasamaṃ.","ja360:6.2":"Maṇikuṇḍalavaggo paṭhamo.","ja360:7.1":"Tassuddānaṃ –","ja360:8.1":"Atha jinavaro haritaṃ tiṇako,","ja360:8.2":"atha bhinnaplavo uragova ghaṭo;","ja360:8.3":"Dariyā puna kuñjara bhūnahatā,","ja360:8.4":"migamuttamasaggavarena dasāti."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":1582,"to":1598,"paras":[{"para":1582,"vripara":null,"refs":["ja360:1"],"lines":["Tattha <b>timirānan</b>ti timirarukkhapupphānaṃ.","Taṃ kira nigrodhaṃ parivāretvā timirarukkhā atthi, te sandhāyevaṃ vadati.","<b>Kusamuddo</b>ti khuddakasamuddo.","<b>Ghosavā</b>ti mahāravo.","Tasseva nigrodhassa santike samuddaṃ sandhāyevamāha.","<b>Ito</b>ti imamhā nagarā.","<b>Tambā</b>ti rājānaṃ ālapati.","Atha vā <b>tambakāmā</b>ti tambena kāmitakāmā tambakāmā nāma.","Te maṃ hadaye vijjhantīti dīpeti."],"lineRefs":[["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"]]},{"para":1583,"vripara":null,"refs":["ja360:1"],"lines":["Taṃ sutvā supaṇṇo dutiyaṃ gāthamāha –"],"lineRefs":[["ja360:1"]]},{"para":1585,"vripara":"56","refs":["ja360:1"],"lines":["“Kathaṃ samuddamatari, kathaṃ addakkhi sedumaṃ;"],"lineRefs":[["ja360:1"]]},{"para":1586,"vripara":null,"refs":["ja360:1"],"lines":["Kathaṃ tassā ca tuyhañca, ahu sagga samāgamo”ti."],"lineRefs":[["ja360:1"]]},{"para":1587,"vripara":null,"refs":["ja360:2"],"lines":["Tattha <b>seduman</b>ti sedumadīpaṃ."],"lineRefs":[["ja360:2"]]},{"para":1588,"vripara":null,"refs":["ja360:2"],"lines":["Tato saggo tisso gāthā abhāsi –"],"lineRefs":[["ja360:2"]]},{"para":1590,"vripara":"57","refs":["ja360:2"],"lines":["“Kurukacchā payātānaṃ, vāṇijānaṃ dhanesinaṃ;"],"lineRefs":[["ja360:2"]]},{"para":1591,"vripara":null,"refs":["ja360:2"],"lines":["Makarehi abhidā nāvā, phalakenāhamaplaviṃ."],"lineRefs":[["ja360:2"]]},{"para":1593,"vripara":"58","refs":["ja360:2"],"lines":["“Sā maṃ saṇhena mudunā, niccaṃ candanagandhinī;"],"lineRefs":[["ja360:2"]]},{"para":1594,"vripara":null,"refs":["ja360:2"],"lines":["Aṅgena uddharī bhaddā, mātā puttaṃva orasaṃ."],"lineRefs":[["ja360:2"]]},{"para":1596,"vripara":"59","refs":["ja360:2"],"lines":["“Sā maṃ annena pānena, vatthena sayanena ca;"],"lineRefs":[["ja360:2"]]},{"para":1597,"vripara":null,"refs":["ja360:2"],"lines":["Attanāpi ca mandakkhī, evaṃ tamba vijānahī”ti."],"lineRefs":[["ja360:2"]]},{"para":1598,"vripara":null,"refs":["ja360:2","ja360:5"],"lines":["Tattha <b>sā maṃ saṇhena mudunā</b>ti evaṃ phalakena tīraṃ uttiṇṇaṃ maṃ samuddatīre vicarantī sā disvā “mā bhāyī”ti saṇhena mudunā vacanena samassāsetvāti attho.","<b>Aṅgenā</b>ti bāhuyugaḷaṃ idha “aṅgenā”ti vuttaṃ.","<b>Bhaddā</b>ti dassanīyā pāsādikā.","<b>Sā maṃ annenā</b>ti sā maṃ etena annādinā santappesīti attho.","<b>Attanāpi cā</b>ti na kevalaṃ annādīheva, attanāpi maṃ abhiramentī santappesīti dīpeti.","<b>Mandakkhī</b>ti mandadassanī, mudunā ākārena olokanasīlāti vuttaṃ hoti.","“Mattakkhī” tipi pāṭho, madamattehi viya akkhīhi samannāgatāti attho.","<b>Evaṃ tambā</b>ti evaṃ tambarāja jānāhīti."],"lineRefs":[["ja360:2"],["ja360:2"],["ja360:2"],["ja360:5"],["ja360:5"],["ja360:5"],["ja360:5"],["ja360:5"]]}],"wordLinks":[["ja360:1.1","timirānaṃ",0,0],["ja360:1.1","kusamuddo",0,2],["ja360:1.1","ghosavā",0,3],["ja360:1.3","ito",0,5],["ja360:1.3","tambā",0,6],["ja360:1.3","tambakāmā",0,7],["ja360:2.1","sedumaṃ",4,0],["ja360:5.1","sā maṃ annenā",12,3],["ja360:5.3","attanāpi cā",12,4],["ja360:5.3","mandakkhī",12,5],["ja360:5.3","evaṃ tambā",12,7]],"after":[{"para":1599,"vripara":null,"title":"[360] 10. Suyonandījātakavaṇṇanā","lines":["Supaṇṇo gandhabbassa kathentasseva vippaṭisārī hutvā “ahaṃ supaṇṇabhavane vasantopi rakkhituṃ nāsakkhiṃ, kiṃ me tāya dussīlāyā”ti taṃ ānetvā rañño paṭidatvā pakkāmi, tato paṭṭhāya puna nāgacchīti."]},{"para":1600,"vripara":null,"title":"[360] 10. Suyonandījātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne ukkaṇṭhitabhikkhu sotāpattiphale patiṭṭhahi.","Tadā rājā ānando ahosi, supaṇṇarājā pana ahameva ahosinti."]},{"para":1601,"vripara":null,"title":"[360] 10. Suyonandījātakavaṇṇanā","lines":["Suyonandījātakavaṇṇanā dasamā."]},{"para":1602,"vripara":null,"title":"[360] 10. Suyonandījātakavaṇṇanā","lines":["Maṇikuṇḍalavaggo paṭhamo."]}]},"tika":null,"tika2":null}
