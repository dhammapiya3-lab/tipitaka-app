{"suttaId":"ja360","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[3250,3269],"vripara":"55"},"segments":{"ja360:0.4":"Suyonandījātakaṃ (5-1-10)","ja360:1.1":"Vāti gandho timirānaṃ,","ja360:1.2":"kusamuddo ca [va (syā. pī.)] ghosavā;","ja360:1.3":"Dūre ito suyonandī [ito hi susandī (sī. syā.), itopi sussondī (pī.)],","ja360:1.4":"tambakāmā tudanti maṃ. 56.","ja360:2.1":"Kathaṃ samuddamatari,","ja360:2.2":"kathaṃ addakkhi sedumaṃ [serumaṃ (sī. syā. pī.)];","ja360:2.3":"Kathaṃ tassā ca tuyhañca,","ja360:2.4":"ahu sagga [agga (sī. syā.)] samāgamo. 57.","ja360:3.1":"Kurukacchā [bharukacchā (sī. syā. pī.)] payātānaṃ,","ja360:3.2":"vāṇijānaṃ dhanesinaṃ;","ja360:3.3":"Makarehi abhidā [makarehibbhidā (sī.), makarehi’bhidā (syā.), makarehi bhinnā (pī.)] nāvā,","ja360:3.4":"phalakenāhamaplaviṃ. 58.","ja360:4.1":"Sā maṃ saṇhena mudunā,","ja360:4.2":"niccaṃ candanagandhinī;","ja360:4.3":"Aṅgena [aṅkena (pī. ka.)] uddharī bhaddā,","ja360:4.4":"mātā puttaṃva orasaṃ. 59.","ja360:5.1":"Sā maṃ annena pānena,","ja360:5.2":"vatthena sayanena ca;","ja360:5.3":"Attanāpi ca mandakkhī,","ja360:5.4":"evaṃ tamba vijānāhīti.","ja360:6.1":"Suyonandījātakaṃ dasamaṃ.","ja360:6.2":"Maṇikuṇḍalavaggo paṭhamo.","ja360:7.1":"Tassuddānaṃ –","ja360:8.1":"Atha jinavaro haritaṃ tiṇako,","ja360:8.2":"atha bhinnaplavo uragova ghaṭo;","ja360:8.3":"Dariyā puna kuñjara bhūnahatā,","ja360:8.4":"migamuttamasaggavarena dasāti. 2."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":1582,"to":1598,"paras":[{"para":1582,"vripara":null,"refs":["ja360:1"],"lines":["Tattha <b>timirāna</b>nti timirarukkhapupphānaṃ.","Taṃ kira nigrodhaṃ parivāretvā timirarukkhā atthi, te sandhāyevaṃ vadati.","<b>Kusamuddo</b>ti khuddakasamuddo.","<b>Ghosavā</b>ti mahāravo.","Tasseva nigrodhassa santike samuddaṃ sandhāyevamāha.","<b>Ito</b>ti imamhā nagarā.","<b>Tambā</b>ti rājānaṃ ālapati.","Atha vā <b>tambakāmā</b>ti tambena kāmitakāmā tambakāmā nāma.","Te maṃ hadaye vijjhantīti dīpeti."],"lineRefs":[["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"]]},{"para":1583,"vripara":null,"refs":["ja360:1"],"lines":["Taṃ sutvā supaṇṇo dutiyaṃ gāthamāha – 56."],"lineRefs":[["ja360:1"]]},{"para":1585,"vripara":"56","refs":["ja360:1"],"lines":["“Kathaṃ samuddamatari, kathaṃ addakkhi sedumaṃ;"],"lineRefs":[["ja360:1"]]},{"para":1586,"vripara":null,"refs":["ja360:1"],"lines":["Kathaṃ tassā ca tuyhañca, ahu sagga samāgamo”ti."],"lineRefs":[["ja360:1"]]},{"para":1587,"vripara":null,"refs":["ja360:2"],"lines":["Tattha <b>seduma</b>nti sedumadīpaṃ."],"lineRefs":[["ja360:2"]]},{"para":1588,"vripara":null,"refs":["ja360:2"],"lines":["Tato saggo tisso gāthā abhāsi – 57."],"lineRefs":[["ja360:2"]]},{"para":1590,"vripara":"57","refs":["ja360:2"],"lines":["“Kurukacchā payātānaṃ, vāṇijānaṃ dhanesinaṃ;"],"lineRefs":[["ja360:2"]]},{"para":1591,"vripara":null,"refs":["ja360:2"],"lines":["Makarehi abhidā nāvā, phalakenāhamaplaviṃ. 58."],"lineRefs":[["ja360:2"]]},{"para":1593,"vripara":"58","refs":["ja360:2"],"lines":["“Sā maṃ saṇhena mudunā, niccaṃ candanagandhinī;"],"lineRefs":[["ja360:2"]]},{"para":1594,"vripara":null,"refs":["ja360:2"],"lines":["Aṅgena uddharī bhaddā, mātā puttaṃva orasaṃ. 59."],"lineRefs":[["ja360:2"]]},{"para":1596,"vripara":"59","refs":["ja360:2"],"lines":["“Sā maṃ annena pānena, vatthena sayanena ca;"],"lineRefs":[["ja360:2"]]},{"para":1597,"vripara":null,"refs":["ja360:2"],"lines":["Attanāpi ca mandakkhī, evaṃ tamba vijānahī”ti."],"lineRefs":[["ja360:2"]]},{"para":1598,"vripara":null,"refs":["ja360:2","ja360:5"],"lines":["Tattha <b>sā maṃ saṇhena mudunā</b>ti evaṃ phalakena tīraṃ uttiṇṇaṃ maṃ samuddatīre vicarantī sā disvā “mā bhāyī”ti saṇhena mudunā vacanena samassāsetvāti attho.","<b>Aṅgenā</b>ti bāhuyugaḷaṃ idha “aṅgenā”ti vuttaṃ.","<b>Bhaddā</b>ti dassanīyā pāsādikā.","<b>Sā maṃ annenā</b>ti sā maṃ etena annādinā santappesīti attho.","<b>Attanāpi cā</b>ti na kevalaṃ annādīheva, attanāpi maṃ abhiramentī santappesīti dīpeti.","<b>Mandakkhī</b>ti mandadassanī, mudunā ākārena olokanasīlāti vuttaṃ hoti.","“Mattakkhī”tipi pāṭho, madamattehi viya akkhīhi samannāgatāti attho.","<b>Evaṃ tambā</b>ti evaṃ tambarāja jānāhīti."],"lineRefs":[["ja360:2"],["ja360:2"],["ja360:2"],["ja360:5"],["ja360:5"],["ja360:5"],["ja360:5"],["ja360:5"]]}],"wordLinks":[["ja360:1.1","timirānaṃ",0,0],["ja360:1.1","kusamuddo",0,2],["ja360:1.1","ghosavā",0,3],["ja360:1.3","ito",0,5],["ja360:1.3","tambā",0,6],["ja360:1.3","tambakāmā",0,7],["ja360:2.1","sedumaṃ",4,0],["ja360:5.1","sā maṃ annenā",12,3],["ja360:5.3","attanāpi cā",12,4],["ja360:5.3","mandakkhī",12,5],["ja360:5.3","evaṃ tambā",12,7]],"after":[{"para":1599,"vripara":null,"title":"[360] 10. Suyonandījātakavaṇṇanā","lines":["Supaṇṇo gandhabbassa kathentasseva vippaṭisārī hutvā “ahaṃ supaṇṇabhavane vasantopi rakkhituṃ nāsakkhiṃ, kiṃ me tāya dussīlāyā”ti taṃ ānetvā rañño paṭidatvā pakkāmi, tato paṭṭhāya puna nāgacchīti."]},{"para":1600,"vripara":null,"title":"[360] 10. Suyonandījātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne ukkaṇṭhitabhikkhu sotāpattiphale patiṭṭhahi.","Tadā rājā ānando ahosi, supaṇṇarājā pana ahameva ahosinti."]},{"para":1601,"vripara":null,"title":"[360] 10. Suyonandījātakavaṇṇanā","lines":["Suyonandījātakavaṇṇanā dasamā."]},{"para":1602,"vripara":null,"title":"[360] 10. Suyonandījātakavaṇṇanā","lines":["Maṇikuṇḍalavaggo paṭhamo. 2."]}]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":1884,"to":1895,"paras":[{"para":1884,"vripara":null,"refs":["ja360:1"],"lines":["10-suyonandījātakavaṇṇanā (360)"],"lineRefs":[["ja360:1"]]},{"para":1885,"vripara":null,"refs":["ja360:1"],"lines":["<b>uparipī</b>ti itthāgārampi.","suyonandī nāma aggamahesīpi ahosi.","uparipi ahosīti sambandho.","sā hi pubbe orodhaṭṭhāne patiṭṭhāsi.","pacchā pana raññā atipiyatāya aggamahesiṭṭhāne patiṭṭhāpitattā aggamahesī ahosi.","vuttañca “itthāgārañca orodho uparītipi vuccatī”ti.","aggamahesī ca nāma uparipubbaaggamahesī anuparipubbaaggamahesī-vasena duvidhā hotīti veditabbā.","tattha ayaṃ pana suyonandī"],"lineRefs":[["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"]]},{"para":1886,"vripara":null,"refs":["ja360:1"],"lines":["footnote 1.","nīti.","pada."],"lineRefs":[["ja360:1"],["ja360:1"],["ja360:1"]]},{"para":1887,"vripara":null,"refs":["ja360:1"],"lines":["footnote 2.","aṭṭhakathāyaṃ natthi."],"lineRefs":[["ja360:1"],["ja360:1"]]},{"para":1888,"vripara":null,"refs":["ja360:1"],"lines":["footnote 3.","chaṭṭhasaṅgītipotthake uparipīti pāṭho natthi.","katthaci pana upparīpīti pāṭho atthi.","uparipubbaaggamahesī nāmāti vuttaṃ hoti.","<b>sedumadīpo</b>ti tattha tadā sirīsampannānaṃ sepaṇṇiādidumānaṃ ussannatāya sedumadīpoti vuccati.","sirīsaddassa hi seādeso hoti.","yathā sepaṇṇīti.","pacchā pana bahavo nāgā vasiṃsu.","tena so nāgadīpoti vuccati.","<b>dārukacchaṃ pāpuṇī</b>ti ettha dārukacchaṃ nāma mahāsamudde bahūsu titthesu ekassa titthassa nāmaṃ.","tattha hi bahū vāṇijā vasanti.","tato tato ca bahū vāṇijā vohā-ratthāya āgacchanti.","mahājanakādayopi vohāratthāya tattheva āgacchanti.(tattha sathunanagaraṃ nāma atthi. tattha tatiyasaṅgītikāle mahāmahindatthe-rena pesitā soṇuttarattherā āgantvā nisīditvā sāsanaṃ patiṭṭhāpe-suṃ. tattha sāmuddikā kakkhaḷā yakkhā yebhuyyena vicaranti.) <b>vetana</b>nti bhatiṃ.","<b>khaṇḍetvā</b>ti paricchinditvā.","<b>sukhayātāyā</b>ti sukhena gacchantiyā.","<b>vīṇaṃ mucchitvā</b>ti ādīsu yaṃ vattabbaṃ.","taṃ heṭṭhā guttilajātake vuttameva.","<b>sammattā</b>ti bhusaṃ pamattā.","<b>makaro</b>ti eko vāḷamacchaviseso.","<b>uppatitvā</b>ti vīṇāsaddena pamattā hutvā uggantvā.","<b>timirarukkhapupphāna</b>nti mucalindarukkhapupphānaṃ.","temeti attano silesenāti timiroti vuccati.","<b>kusamuddo</b>ti ettha kusaddo appakattho kunnadīti ādīsu viyāti āha “kusamuddoti khuddakasamuddo”ti."],"lineRefs":[["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"]]},{"para":1889,"vripara":null,"refs":["ja360:1"],"lines":["<b>ghosavā</b>ti ettha vantupaccayo atisayatthe bhavati.","tenāha — “ghosavāti mahāravo”ti.","nanu ca samuddo nāma khuddako natthi mahantoyeva.","atha kasmā kusamuddoti āhāti codanaṃ manasikatvā — tassevātiādi vuttaṃ.","<b>tambena kāmitā</b>ti tambarājena kāmitā icchitāti kāmā tambakāmā nāmāti attho.","tañca suyonandiṃ nāma deviṃ sandhāya vuttaṃ.","<b>te</b>ti kāmā.","pāḷiyaṃ <b>tassā cā</b>ti suyonandiyā ca.","<b>saggā</b>ti ālapanametaṃ.","<b>samāgamo</b>ti kilesavasena santhavo.","<b>dārukacchā payātāna</b>nti dārukacchato gatānaṃ.","<b>dhanesina</b>nti dhanaṃ esantānaṃ."],"lineRefs":[["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"]]},{"para":1890,"vripara":null,"refs":["ja360:1"],"lines":["footnote 1.( ) vicāretabbaṃ."],"lineRefs":[["ja360:1"]]},{"para":1891,"vripara":null,"refs":["ja360:1"],"lines":["footnote 2.","sukhapayātāya.","chaṭṭha."],"lineRefs":[["ja360:1"],["ja360:1"],["ja360:1"]]},{"para":1892,"vripara":null,"refs":["ja360:1"],"lines":["footnote 3.","tambena kāmitakāmā.","chaṭṭha."],"lineRefs":[["ja360:1"],["ja360:1"],["ja360:1"]]},{"para":1893,"vripara":null,"refs":["ja360:1"],"lines":["footnote 4.","kurukacchā.","chaṭṭha.","<b>abhidā</b>ti bhinnā.","<b>aplava</b>nti uttariṃ.","<b>annādīhevā</b>ti na kevalaṃ annādiheva aramā maṃ santappesi.","atha kho attanāpi aramantaṃ maṃ santappesiyevāti dīpetīti attho.","<b>madamattehi viyā</b>ti migalocanehi viya.","miga-locanāhi passantānaṃ atimadakaraṇato madamattāti vuccati.","madamatta-sadisehi akkhīhi samannāgatāti attho.","<b>paṭiyādetvā</b>ti puna datvā.","niyyādetvāti atthoti."],"lineRefs":[["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"],["ja360:1"]]},{"para":1894,"vripara":null,"refs":["ja360:1"],"lines":["ending suyonandījātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja360:1"]]},{"para":1895,"vripara":null,"refs":["ja360:1"],"lines":["ending maṇikuṇḍalavaggo paṭhamo."],"lineRefs":[["ja360:1"]]}],"wordLinks":[]},"tika2":null}
