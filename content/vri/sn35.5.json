{"suttaId":"sn35.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[16,16],"vripara":"5"},"segments":{"sn35.5:0.3":"Bāhiradukkhasuttaṃ","sn35.5:1.1":"“Rūpā, bhikkhave, dukkhā.","sn35.5:1.2":"Yaṃ dukkhaṃ tadanattā;","sn35.5:1.3":"yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.5:1.4":"Saddā…","sn35.5:1.5":"gandhā…","sn35.5:1.6":"rasā…","sn35.5:1.7":"phoṭṭhabbā…","sn35.5:1.8":"dhammā dukkhā.","sn35.5:1.9":"Yaṃ dukkhaṃ tadanattā.","sn35.5:1.10":"Yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.5:1.11":"Evaṃ passaṃ…pe…","sn35.5:1.12":"nāparaṃ itthattāyāti pajānātī”ti.","sn35.5:1.13":"Pañcamaṃ. 6."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":13,"to":14,"paras":[{"para":13,"vripara":"4-6","refs":["sn35.5:1"],"lines":["Catutthe <b>rūpagandharasaphoṭṭhabbā</b> catusamuṭṭhānā, <b>saddo</b> dvisamuṭṭhāno, <b>dhammā</b>ti tebhūmakadhammārammaṇaṃ.","Idampi bāhiresu chasu āyatanesu tilakkhaṇaṃ dassetvā kathite bujjhanakānaṃ vasena vuttaṃ.","Pañcame chaṭṭhe ca dutiyatatiyesu vuttasadisova nayo. 7-12."],"lineRefs":[["sn35.5:1"],["sn35.5:1"],["sn35.5:1"]]},{"para":14,"vripara":null,"refs":["sn35.5:1"],"lines":["Ajjhattāniccātītānāgatasuttādivaṇṇanā 7-12."],"lineRefs":[["sn35.5:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":15,"to":17,"paras":[{"para":15,"vripara":"4-6","refs":["sn35.5:1"],"lines":["<b>Vuttasadisovā</b>ti “dve lakkhaṇānī”tiādinā vuttasadiso eva.","<b>Nayo</b>ti atidesanayo."],"lineRefs":[["sn35.5:1"],["sn35.5:1"]]},{"para":16,"vripara":null,"refs":["sn35.5:1"],"lines":["Bāhirāniccasuttādivaṇṇanā niṭṭhitā. 7-12."],"lineRefs":[["sn35.5:1"]]},{"para":17,"vripara":null,"refs":["sn35.5:1"],"lines":["Ajjhattāniccātītānāgatasuttādivaṇṇanā 7-12."],"lineRefs":[["sn3