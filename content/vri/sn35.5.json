{"suttaId":"sn35.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[16,16],"vripara":"5"},"segments":{"sn35.5:0.3":"Bāhiradukkhasuttaṃ","sn35.5:1.1":"“Rūpā, bhikkhave, dukkhā.","sn35.5:1.2":"Yaṃ dukkhaṃ tadanattā;","sn35.5:1.3":"yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.5:1.4":"Saddā … gandhā … rasā … phoṭṭhabbā … dhammā dukkhā.","sn35.5:1.9":"Yaṃ dukkhaṃ tadanattā.","sn35.5:1.10":"Yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn35.5:1.11":"Evaṃ passaṃ … pe … nāparaṃ itthattāyāti pajānātī”ti.","sn35.5:1.13":"Pañcamaṃ."},"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":13,"to":14,"paras":[{"para":13,"vripara":"4-6","refs":["sn35.5:1"],"lines":["4-6. Catutthe <b>rūpagandharasaphoṭṭhabbā</b> catusamuṭṭhānā, <b>saddo</b> dvisamuṭṭhāno, <b>dhammā</b>ti tebhūmakadhammārammaṇaṃ.","Idampi bāhiresu chasu āyatanesu tilakkhaṇaṃ dassetvā kathite bujjhanakānaṃ vasena vuttaṃ.","Pañcame chaṭṭhe ca dutiyatatiyesu vuttasadisova nayo."],"lineRefs":[["sn35.5:1"],["sn35.5:1"],["sn35.5:1"]]},{"para":14,"vripara":null,"refs":["sn35.5:1"],"lines":["7-12. Ajjhattāniccātītānāgatasuttādivaṇṇanā"],"lineRefs":[["sn35.5:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":15,"to":17,"paras":[{"para":15,"vripara":"4-6","refs":["sn35.5:1"],"lines":["4-6. <b>Vuttasadisovā</b>ti “dve lakkhaṇānī”tiādinā vuttasadiso eva.","<b>Nayo</b>ti atidesanayo."],"lineRefs":[["sn35.5:1"],["sn35.5:1"]]},{"para":16,"vripara":null,"refs":[],"lines":["Bāhirāniccasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":17,"vripara":null,"refs":["sn35.5:1"],"lines":["7-12. Ajjhattāniccātītānāgatasuttādivaṇṇanā"],"lineRefs":[["sn35.5:1"]]}],"wordLinks":[]}}
