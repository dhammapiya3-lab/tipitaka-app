{"suttaId":"vv42","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1601,1617],"vripara":"711"},"segments":{"vv42:0.4":"Alomavimānavatthu","vv42:1.1":"“Abhikkantena vaṇṇena,","vv42:1.2":"yā tvaṃ tiṭṭhasi devate;","vv42:1.3":"Obhāsentī disā sabbā,","vv42:1.4":"osadhī viya tārakā. 712.","vv42:2.1":"“Kena tetādiso vaṇṇo…pe…","vv42:2.3":"Vaṇṇo ca te sabbadisā pabhāsatī”ti. 714.","vv42:3.1":"Sā devatā attamanā…pe…","vv42:3.3":"yassa kammassidaṃ phalaṃ. 715.","vv42:4.1":"“Ahañca bārāṇasiyaṃ,","vv42:4.2":"buddhassādiccabandhuno;","vv42:4.3":"Adāsiṃ sukkhakummāsaṃ,","vv42:4.4":"pasannā sehi pāṇibhi. 716.","vv42:5.1":"“Sukkhāya aloṇikāya ca,","vv42:5.2":"passa phalaṃ kummāsapiṇḍiyā;","vv42:5.3":"Alomaṃ sukhitaṃ disvā,","vv42:5.4":"ko puññaṃ na karissati. 717.","vv42:6.1":"“Tena metādiso vaṇṇo…pe…","vv42:6.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv42:7.1":"Alomavimānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1884,"to":1884,"paras":[{"para":1884,"vripara":"716","refs":["vv42:5"],"lines":["Tattha <b>alomaṃ sukhitaṃ disvā</b>ti alomampi nāma sukkhakummāsamattaṃ datvā evaṃ dibbasukhena sukhitaṃ disvā.","<b>Ko puññaṃ na karissatī</b>ti ko nāma attano hitasukhaṃ icchanto puññaṃ na karissatīti.","Sesaṃ vuttanayameva."],"lineRefs":[["vv42:5"],["vv42:5"],["vv42:5"]]}],"wordLinks":[["vv42:5.3","alomaṃ sukhitaṃ disvā",0,0],["vv42:5.3","ko puññaṃ na karissatī",0,1]],"before":[{"para":1869,"vripara":null,"title":"Alomavimānavaṇṇanā","lines":["Alomavimānavaṇṇanā"]},{"para":1870,"vripara":null,"title":"Alomavimānavaṇṇanā","lines":["<b>Abhikkantena</b> <b>vaṇṇenā</b>ti alomavimānaṃ.","Tassa kā uppatti?","Bhagavā bārāṇasiyaṃ isipatane migadāye viharanto pubbaṇhasamayaṃ nivāsetvā pattacīvaramādāya bārāṇasiṃ piṇḍāya pāvisi.","Tatthekā alomā nāma duggatitthī bhagavantaṃ disvā pasannacittā aññaṃ dātabbaṃ apassantī “īdisampi bhagavato dinnaṃ mayhaṃ mahapphalaṃ bhavissatī”ti cintetvā paribhinnavaṇṇaṃ aloṇaṃ sukkhakummāsaṃ upanesi, bhagavā paṭiggahesi.","Sā taṃ dānaṃ ārammaṇaṃ katvā somanassaṃ pavedesi, sā aparabhāge kālaṃ katvā tāvatiṃsesu nibbatti.","Taṃ āyasmā mahāmoggallāno – 711."]},{"para":1872,"vripara":"711","title":"Alomavimānavaṇṇanā","lines":["“Abhikkantena vaṇṇena…pe… vaṇṇo ca te sabbadisā pabhāsatī”ti. –"]},{"para":1873,"vripara":null,"title":"Alomavimānavaṇṇanā","lines":["Pucchi.","Sāpi tassa byākāsi, taṃ dassetuṃ – 714."]},{"para":1875,"vripara":"714","title":"Alomavimānavaṇṇanā","lines":["“Sā devatā attamanā…pe… yassa kammassidaṃ phala”nti. –","vuttaṃ; 715."]},{"para":1877,"vripara":"715","title":"Alomavimānavaṇṇanā","lines":["“Ahañca bārāṇasiyaṃ, buddhassādiccabandhuno;"]},{"para":1878,"vripara":null,"title":"Alomavimānavaṇṇanā","lines":["Adāsiṃ sukkhakummāsaṃ, pasannā sehi pāṇibhi. 716."]},{"para":1880,"vripara":"716","title":"Alomavimānavaṇṇanā","lines":["“Sukkhāya aloṇikāya ca, passa phalaṃ kummāsapiṇḍiyā;"]},{"para":1881,"vripara":null,"title":"Alomavimānavaṇṇanā","lines":["Alomaṃ sukhitaṃ disvā, ko puññaṃ na karissati. 717."]},{"para":1883,"vripara":"717","title":"Alomavimānavaṇṇanā","lines":["“Tena metādiso vaṇṇo…pe… vaṇṇo ca me sabbadisā pabhāsatī”ti. 716."]}],"after":[{"para":1885,"vripara":null,"title":"Alomavimānavaṇṇanā","lines":["Alomavimānavaṇṇanā niṭṭhitā. 5."]}]},"tika":null,"tika2":null}
