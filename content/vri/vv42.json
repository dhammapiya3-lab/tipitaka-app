{"suttaId":"vv42","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1601,1617],"vripara":"711"},"segments":{"vv42:0.4":"Alomavimānavatthu","vv42:1.1":"“Abhikkantena vaṇṇena,","vv42:1.2":"yā tvaṃ tiṭṭhasi devate;","vv42:1.3":"Obhāsentī disā sabbā,","vv42:1.4":"osadhī viya tārakā.","vv42:2.1":"“Kena tetādiso vaṇṇo … pe …","vv42:2.3":"Vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv42:3.1":"Sā devatā attamanā … pe …","vv42:3.3":"yassa kammassidaṃ phalaṃ.","vv42:4.1":"“Ahañca bārāṇasiyaṃ,","vv42:4.2":"buddhassādiccabandhuno;","vv42:4.3":"Adāsiṃ sukkhakummāsaṃ,","vv42:4.4":"pasannā sehi pāṇibhi.","vv42:5.1":"“Sukkhāya aloṇikāya ca,","vv42:5.2":"passa phalaṃ kummāsapiṇḍiyā;","vv42:5.3":"Alomaṃ sukhitaṃ disvā,","vv42:5.4":"ko puññaṃ na karissati.","vv42:6.1":"“Tena metādiso vaṇṇo … pe …","vv42:6.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv42:7.1":"Alomavimānaṃ catutthaṃ."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":1884,"to":1884,"paras":[{"para":1884,"vripara":"716","refs":["vv42:5"],"lines":["Tattha <b>alomaṃ sukhitaṃ disvā</b>ti alomampi nāma sukkhakummāsamattaṃ datvā evaṃ dibbasukhena sukhitaṃ disvā.","<b>Ko puññaṃ na karissatī</b>ti ko nāma attano hitasukhaṃ icchanto puññaṃ na karissatīti.","Sesaṃ vuttanayameva."],"lineRefs":[["vv42:5"],["vv42:5"],["vv42:5"]]}],"wordLinks":[["vv42:5.3","alomaṃ sukhitaṃ disvā",0,0],["vv42:5.3","ko puññaṃ na karissatī",0,1]],"before":[{"para":1868,"vripara":null,"refs":[],"lines":["Nāgavimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1869,"vripara":null,"refs":[],"lines":["Alomavimānavaṇṇanā"],"lineRefs":[[]]},{"para":1870,"vripara":null,"refs":[],"lines":["<b>Abhikkantena vaṇṇenā</b>ti alomavimānaṃ.","Tassa kā uppatti?","Bhagavā bārāṇasiyaṃ isipatane migadāye viharanto pubbaṇhasamayaṃ nivāsetvā pattacīvaramādāya bārāṇasiṃ piṇḍāya pāvisi.","Tatthekā alomā nāma duggatitthī bhagavantaṃ disvā pasannacittā aññaṃ dātabbaṃ apassantī “īdisampi bhagavato dinnaṃ mayhaṃ mahapphalaṃ bhavissatī”ti cintetvā paribhinnavaṇṇaṃ aloṇaṃ sukkhakummāsaṃ upanesi, bhagavā paṭiggahesi.","Sā taṃ dānaṃ ārammaṇaṃ katvā somanassaṃ pavedesi, sā aparabhāge kālaṃ katvā tāvatiṃsesu nibbatti.","Taṃ āyasmā mahāmoggallāno –"],"lineRefs":[[],[],[],[],[],[]]},{"para":1872,"vripara":"711","refs":[],"lines":["“Abhikkantena vaṇṇena … pe … vaṇṇo ca te sabbadisā pabhāsatī”ti.","–"],"lineRefs":[[],[]]},{"para":1873,"vripara":null,"refs":[],"lines":["Pucchi.","Sāpi tassa byākāsi, taṃ dassetuṃ –"],"lineRefs":[[],[]]},{"para":1875,"vripara":"714","refs":[],"lines":["“Sā devatā attamanā … pe … yassa kammassidaṃ phalan”ti.","– vuttaṃ;"],"lineRefs":[[],[]]},{"para":1877,"vripara":"715","refs":[],"lines":["“Ahañca bārāṇasiyaṃ, buddhassādiccabandhuno;"],"lineRefs":[[]]},{"para":1878,"vripara":null,"refs":[],"lines":["Adāsiṃ sukkhakummāsaṃ, pasannā sehi pāṇibhi."],"lineRefs":[[]]},{"para":1880,"vripara":"716","refs":[],"lines":["“Sukkhāya aloṇikāya ca, passa phalaṃ kummāsapiṇḍiyā;"],"lineRefs":[[]]},{"para":1881,"vripara":null,"refs":[],"lines":["Alomaṃ sukhitaṃ disvā, ko puññaṃ na karissati."],"lineRefs":[[]]},{"para":1883,"vripara":"717","refs":[],"lines":["“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
