{"suttaId":"sn52.22","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1836,1836],"vripara":"920"},"segments":{"sn52.22:0.3":"Pubbenivāsasuttaṃ","sn52.22:1.1":"“Imesañca panāhaṃ, āvuso, catunnaṃ satipaṭṭhānānaṃ bhāvitattā bahulīkatattā anekavihitaṃ pubbenivāsaṃ anussarāmi, seyyathidaṃ – ekampi jātiṃ dvepi jātiyo…pe… iti sākāraṃ sauddesaṃ anekavihitaṃ pubbenivāsaṃ anussarāmī”ti.","sn52.22:1.2":"Dvādasamaṃ. 13."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":711,"to":713,"paras":[{"para":711,"vripara":"909-922","refs":["sn52.22:1"],"lines":["Dutiyavagge <b>ṭhānañca ṭhānato</b>tiādīhi thero dasabalañāṇaṃ paṭijānāti.","Kimpanetaṃ sāvakānaṃ hotīti?","Ekadesena hoti, sabbaññubuddhānaṃ panetaṃ nippadesaṃ sabbākāraparipūranti."],"lineRefs":[["sn52.22:1"],["sn52.22:1"],["sn52.22:1"]]},{"para":712,"vripara":null,"refs":["sn52.22:1"],"lines":["Anuruddhasaṃyuttavaṇṇanā niṭṭhitā. 9."],"lineRefs":[["sn52.22:1"]]},{"para":713,"vripara":null,"refs":["sn52.22:1"],"lines":["Jhānasaṃyuttavaṇṇanā 923."],"lineRefs":[["sn52.22:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":615,"to":618,"paras":[{"para":615,"vripara":"909-922","refs":["sn52.22:1"],"lines":["<b>Dasabalañāṇa</b>nti dasavidhabalañāṇaṃ.","<b>Ekadesenā</b>ti padesavasena.","Sāvakānampi attano abhinīhārānurūpaṃ ñāṇaṃ pavattatīti te kālapadesavasena ceva yathāparicayasattapadesavasena ca ṭhānānīti jānanti, sammāsambuddhānaṃ pana anantañāṇatāya sabbattheva appaṭihatameva ñāṇanti āha –","<b>“sabbaññubuddhānaṃ panā”</b>tiādi.","<b>Etaṃ</b> dasabalañāṇaṃ anantavisayattā <b>nippadesaṃ</b> anūnatāya <b>sabbākāraparipūraṃ</b>."],"lineRefs":[["sn52.22:1"],["sn52.22:1"],["sn52.22:1"],["sn52.22:1"],["sn52.22:1"]]},{"para":616,"vripara":null,"refs":["sn52.22:1"],"lines":["Dutiyavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn52.22:1"]]},{"para":617,"vripara":null,"refs":["sn52.22:1"],"lines":["Anuruddhasaṃyuttavaṇṇanā niṭṭhitā. 9."],"lineRefs":[["sn52.22:1"]]},{"para":618,"vripara":null,"refs":["sn52.22:1"],"lines":["Jhānasaṃyuttavaṇṇanā 923."],"lineRefs":[["sn52.22:1"]]}],"wordLinks":[]},"tika2":null}
