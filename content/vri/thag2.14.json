{"suttaId":"thag2.14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[817,824],"vripara":"147"},"segments":{"thag2.14:0.4":"Somamittattheragāthā","thag2.14:1.1":"“Parittaṃ dārumāruyha, yathā sīde mahaṇṇave;","thag2.14:1.3":"Evaṃ kusītamāgamma, sādhujīvīpi sīdati;","thag2.14:1.5":"Tasmā taṃ parivajjeyya, kusītaṃ hīnavīriyaṃ.","thag2.14:2.1":"“Pavivittehi ariyehi, pahitattehi jhāyibhi;","thag2.14:2.3":"Niccaṃ āraddhavīriyehi, paṇḍitehi sahāvase”ti.","thag2.14:2.5":"… Somamitto thero …."},"attha":null,"tika":null}
