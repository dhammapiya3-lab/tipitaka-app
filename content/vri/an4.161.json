{"suttaId":"an4.161","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1272,1272],"vripara":"161"},"segments":{"an4.161:0.3":"Saṃkhittasuttaṃ","an4.161:1.1":"“Catasso imā, bhikkhave, paṭipadā.","an4.161:1.2":"Katamā catasso?","an4.161:1.3":"Dukkhā paṭipadā dandhābhiññā, dukkhā paṭipadā khippābhiññā, sukhā paṭipadā dandhābhiññā, sukhā paṭipadā khippābhiññā – imā kho, bhikkhave, catasso paṭipadā”ti.","an4.161:1.8":"Paṭhamaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1478,"to":1478,"paras":[{"para":1478,"vripara":"161","refs":["an4.161:1"],"words":["dukkhāpaṭipadā","dandhābhiññā"],"lines":["Dutiyassa paṭhame sukhapaṭikkhepena dukkhā paṭipajjitabbato paṭipadā etissāti <b>dukkhāpaṭipadā</b>.","Asīghappavattitāya garubhāvena dandhā abhiññā etissāti <b>dandhābhiññā</b>.","Imināva nayena sabbapadesu attho veditabbo."],"lineRefs":[["an4.161:1"],["an4.161:1"],["an4.161:1"]]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1662,"to":1662,"paras":[{"para":1662,"vripara":"161","refs":["an4.161:1"],"words":["dukkhāpaṭipadā dandhābhiññā"],"lines":["Dutiyassa paṭhame <b>dukkhāpaṭipadā dandhābhiññā</b>tiādīsu pāḷiyā āgatanayena attho veditabbo.","Tathā hi –"],"lineRefs":[["an4.161:1"],["an4.161:1"]]}]}}
