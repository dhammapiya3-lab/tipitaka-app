{"suttaId":"tha-ap308","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9130,9154],"vripara":"24"},"segments":{"tha-ap308:0.3":"Sampasādakattheraapadānaṃ","tha-ap308:1.1":"“‘Namo te buddha vīratthu,","tha-ap308:1.2":"vippamuttosi sabbadhi;","tha-ap308:1.3":"Byasanamhi [byasanaṃ hi (sī.)] anuppatto,","tha-ap308:1.4":"tassa me saraṇaṃ bhava’. 25.","tha-ap308:2.1":"“Siddhattho tassa byākāsi,","tha-ap308:2.2":"loke appaṭipuggalo;","tha-ap308:2.3":"‘Mahodadhisamo saṅgho,","tha-ap308:2.4":"appameyyo anuttaro. 26.","tha-ap308:3.1":"“‘Tattha tvaṃ viraje khette,","tha-ap308:3.2":"anantaphaladāyake;","tha-ap308:3.3":"Saṅghe cittaṃ pasādetvā,","tha-ap308:3.4":"subījaṃ vāpa [cāpi (sī.), vāpi (syā.)] ropaya. 27.","tha-ap308:4.1":"“Idaṃ vatvāna sabbaññū,","tha-ap308:4.2":"lokajeṭṭho narāsabho;","tha-ap308:4.3":"Mameva anusāsitvā,","tha-ap308:4.4":"vehāsaṃ nabhamuggami. 28.","tha-ap308:5.1":"“Aciraṃ gatamattamhi,","tha-ap308:5.2":"sabbaññumhi narāsabhe;","tha-ap308:5.3":"Maraṇaṃ samanuppatto,","tha-ap308:5.4":"tusitaṃ upapajjahaṃ. 29.","tha-ap308:6.1":"“Tadāhaṃ viraje khette,","tha-ap308:6.2":"anantaphaladāyake;","tha-ap308:6.3":"Saṅghe cittaṃ pasādetvā,","tha-ap308:6.4":"kappaṃ saggamhi modahaṃ. 30.","tha-ap308:7.1":"“Catunnavutito kappe,","tha-ap308:7.2":"pasādamalabhiṃ tadā;","tha-ap308:7.3":"Duggatiṃ nābhijānāmi,","tha-ap308:7.4":"pasādassa idaṃ phalaṃ. 31.","tha-ap308:8.1":"“Paṭisambhidā catasso…pe…","tha-ap308:8.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap308:9.1":"Itthaṃ sudaṃ āyasmā sampasādako thero imā gāthāyo abhāsitthāti.","tha-ap308:10.1":"Sampasādakattherassāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
