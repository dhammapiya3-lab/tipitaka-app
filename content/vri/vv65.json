{"suttaId":"vv65","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2558,2572],"vripara":"1048"},"segments":{"vv65:0.4":"Paṭhamaagāriyavimānavatthu","vv65:1.1":"“Yathā vanaṃ cittalataṃ pabhāsati [pakāsati (ka.)], uyyānaseṭṭhaṃ tidasānamuttamaṃ;","vv65:1.3":"Tathūpamaṃ tuyhamidaṃ vimānaṃ, obhāsayaṃ tiṭṭhati antalikkhe.","vv65:2.1":"“Deviddhipattosi mahānubhāvo, manussabhūto kimakāsi puññaṃ;","vv65:2.3":"Kenāsi evaṃ jalitānubhāvo, vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv65:3.1":"So devaputto attamano, moggallānena pucchito;","vv65:3.3":"Pañhaṃ puṭṭho viyākāsi, yassa kammassidaṃ phalaṃ.","vv65:4.1":"“Ahañca bhariyā ca manussaloke, opānabhūtā gharamāvasimha;","vv65:4.3":"Annañca pānañca pasannacittā, sakkacca dānaṃ vipulaṃ adamha.","vv65:5.1":"“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv65:6.1":"Paṭhamaagāriyavimānaṃ paṭhamaṃ."},"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3058,"to":3077,"paras":[{"para":3058,"vripara":"1048","refs":["vv65:1"],"lines":["“Yathā vanaṃ cittalataṃ pabhāsati, uyyānaseṭṭhaṃ tidasānamuttamaṃ;"],"lineRefs":[["vv65:1"]]},{"para":3059,"vripara":null,"refs":[],"lines":["Tathūpamaṃ tuyhamidaṃ vimānaṃ, obhāsayaṃ tiṭṭhati antalikkhe."],"lineRefs":[[]]},{"para":3061,"vripara":"1049","refs":["vv65:2"],"lines":["“Deviddhipattosi mahānubhāvo, manussabhūto kimakāsi puññaṃ;"],"lineRefs":[["vv65:2"]]},{"para":3062,"vripara":null,"refs":[],"lines":["Kenāsi evaṃ jalitānubhāvo, vaṇṇo ca te sabbadisā pabhāsatī”ti.","–"],"lineRefs":[[],[]]},{"para":3063,"vripara":null,"refs":[],"lines":["Thero pucchi."],"lineRefs":[[]]},{"para":3065,"vripara":"1050","refs":["vv65:3"],"lines":["“So devaputto attamano, moggallānena pucchito;"],"lineRefs":[["vv65:3"]]},{"para":3066,"vripara":null,"refs":[],"lines":["Pañhaṃ puṭṭho viyākāsi, yassa kammassidaṃ phalaṃ”."],"lineRefs":[[]]},{"para":3068,"vripara":"1051","refs":["vv65:4"],"lines":["“Ahañca bhariyā ca manussalo