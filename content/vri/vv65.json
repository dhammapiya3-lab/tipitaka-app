{"suttaId":"vv65","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2558,2572],"vripara":"1048"},"segments":{"vv65:0.4":"Paṭhamaagāriyavimānavatthu","vv65:1.1":"“Yathā vanaṃ cittalataṃ pabhāsati [pakāsati (ka.)],","vv65:1.2":"uyyānaseṭṭhaṃ tidasānamuttamaṃ;","vv65:1.3":"Tathūpamaṃ tuyhamidaṃ vimānaṃ,","vv65:1.4":"obhāsayaṃ tiṭṭhati antalikkhe. 1049.","vv65:2.1":"“Deviddhipattosi mahānubhāvo,","vv65:2.2":"manussabhūto kimakāsi puññaṃ;","vv65:2.3":"Kenāsi evaṃ jalitānubhāvo,","vv65:2.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti. 1050.","vv65:3.1":"So devaputto attamano,","vv65:3.2":"moggallānena pucchito;","vv65:3.3":"Pañhaṃ puṭṭho viyākāsi,","vv65:3.4":"yassa kammassidaṃ phalaṃ. 1051.","vv65:4.1":"“Ahañca bhariyā ca manussaloke,","vv65:4.2":"opānabhūtā gharamāvasimha;","vv65:4.3":"Annañca pānañca pasannacittā,","vv65:4.4":"sakkacca dānaṃ vipulaṃ adamha. 1052.","vv65:5.1":"“Tena metādiso vaṇṇo…pe…","vv65:5.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv65:6.1":"Paṭhamaagāriyavimānaṃ paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3058,"to":3077,"paras":[{"para":3058,"vripara":"1048","refs":["vv65:1"],"lines":["“Yathā vanaṃ cittalataṃ pabhāsati, uyyānaseṭṭhaṃ tidasānamuttamaṃ;"],"lineRefs":[["vv65:1"]]},{"para":3059,"vripara":null,"refs":["vv65:1"],"lines":["Tathūpamaṃ tuyhamidaṃ vimānaṃ, obhāsayaṃ tiṭṭhati antalikkhe. 1049."],"lineRefs":[["vv65:1"]]},{"para":3061,"vripara":"1049","refs":["vv65:2"],"lines":["“Deviddhipattosi mahānubhāvo, manussabhūto kimakāsi puññaṃ;"],"lineRefs":[["vv65:2"]]},{"para":3062,"vripara":null,"refs":["vv65:2"],"lines":["Kenāsi evaṃ jalitānubhāvo, vaṇṇo ca te sabbadisā pabhāsatī”ti. –"],"lineRefs":[["vv65:2"]]},{"para":3063,"vripara":null,"refs":["vv65:2"],"lines":["Thero pucchi. 1050."],"lineRefs":[["vv65:2"]]},{"para":3065,"vripara":"1050","refs":["vv65:3"],"lines":["“So devaputto attamano, moggallānena pucchito;"],"lineRefs":[["vv65:3"]]},{"para":3066,"vripara":null,"refs":["vv65:3"],"lines":["Pañhaṃ puṭṭho viyākāsi, yassa kammassidaṃ phalaṃ”. 1051."],"lineRefs":[["vv65:3"]]},{"para":3068,"vripara":"1051","refs":["vv65:4"],"lines":["“Ahañca bhariyā ca manussaloke, opānabhūtā gharamāvasimha;"],"lineRefs":[["vv65:4"]]},{"para":3069,"vripara":null,"refs":["vv65:4"],"lines":["Annañca pānañca pasannacittā, sakkacca dānaṃ vipulaṃ adamha. 1052."],"lineRefs":[["vv65:4"]]},{"para":3071,"vripara":"1052","refs":["vv65:5"],"lines":["“Tena metādiso vaṇṇo…pe…"],"lineRefs":[["vv65:5"]]},{"para":3072,"vripara":null,"refs":["vv65:5"],"lines":["Vaṇṇo ca me sabbadisā pabhāsatī”ti. –"],"lineRefs":[["vv65:5"]]},{"para":3073,"vripara":null,"refs":["vv65:5"],"lines":["Attano sampattiṃ byākāsi.","Gāthāsupi apubbaṃ natthi."],"lineRefs":[["vv65:5"],["vv65:5"]]},{"para":3074,"vripara":null,"refs":["vv65:5"],"lines":["Paṭhamaagāriyavimānavaṇṇanā niṭṭhitā. 2."],"lineRefs":[["vv65:5"]]},{"para":3075,"vripara":null,"refs":["vv65:5"],"lines":["Dutiyaagāriyavimānavaṇṇanā"],"lineRefs":[["vv65:5"]]},{"para":3076,"vripara":null,"refs":["vv65:5"],"lines":["<b>Yathā</b> <b>vanaṃ cittalata</b>nti dutiyaagāriyavimānaṃ.","Etthāpi aṭṭhuppatti anantarasadisāva. 1054."],"lineRefs":[["vv65:5"],["vv65:5"]]}],"wordLinks":[],"before":[{"para":3054,"vripara":null,"title":"Pāyāsivaggo","lines":["Pāyāsivaggo 1."]},{"para":3055,"vripara":null,"title":"Paṭhamaagāriyavimānavaṇṇanā","lines":["Paṭhamaagāriyavimānavaṇṇanā"]},{"para":3056,"vripara":null,"title":"Paṭhamaagāriyavimānavaṇṇanā","lines":["<b>Yathā</b> <b>vanaṃ cittalataṃ pabhāsatī</b>ti agāriyavimānaṃ.","Tassa kā uppatti?","Bhagavā rājagahe viharati veḷuvane.","Tena samayena rājagahe ekaṃ kulaṃ ubhatopasannaṃ hoti sīlācārasampannaṃ opānabhūtaṃ bhikkhūnaṃ bhikkhunīnaṃ.","Te dve jayampatikā ratanattayaṃ uddissa yāvajīvaṃ puññāni katvā tato cutā tāvatiṃsesu nibbattiṃsu, tesaṃ dvādasayojanikaṃ kanakavimānaṃ nibbatti.","Te tattha dibbasampattiṃ anubhavanti.","Athāyasmā mahāmoggallāno