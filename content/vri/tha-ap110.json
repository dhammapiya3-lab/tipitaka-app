{"suttaId":"tha-ap110","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5310,5328],"vripara":"47"},"segments":{"tha-ap110:0.3":"Āsanupaṭṭhāhakattheraapadānaṃ","tha-ap110:1.1":"“Kānanaṃ vanamogayha,","tha-ap110:1.2":"appasaddaṃ nirākulaṃ;","tha-ap110:1.3":"Sīhāsanaṃ mayā dinnaṃ,","tha-ap110:1.4":"atthadassissa tādino. 48.","tha-ap110:2.1":"“Mālāhatthaṃ gahetvāna,","tha-ap110:2.2":"katvā ca naṃ padakkhiṇaṃ;","tha-ap110:2.3":"Satthāraṃ payirupāsitvā,","tha-ap110:2.4":"pakkāmiṃ uttarāmukho. 49.","tha-ap110:3.1":"“Tena kammena dvipadinda,","tha-ap110:3.2":"lokajeṭṭha narāsabha;","tha-ap110:3.3":"Sannibbāpemi [sandiṭṭhāpemi (ka.)] attānaṃ,","tha-ap110:3.4":"bhavā sabbe samūhatā. 50.","tha-ap110:4.1":"“Aṭṭhārasakappasate,","tha-ap110:4.2":"yaṃ dānamadadiṃ tadā;","tha-ap110:4.3":"Duggatiṃ nābhijānāmi,","tha-ap110:4.4":"sīhāsanassidaṃ phalaṃ. 51.","tha-ap110:5.1":"“Ito sattakappasate,","tha-ap110:5.2":"sannibbāpaka [sanniṭṭho nāma (ka.)] khattiyo;","tha-ap110:5.3":"Sattaratanasampanno,","tha-ap110:5.4":"cakkavattī mahabbalo. 52.","tha-ap110:6.1":"“Paṭisambhidā catasso…pe…","tha-ap110:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap110:7.1":"Itthaṃ sudaṃ āyasmā āsanupaṭṭhāhako thero imā gāthāyo abhāsitthāti.","tha-ap110:8.1":"Āsanupaṭṭhāhakattherassāpadānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
