{"suttaId":"sn13.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[637,638],"vripara":"76"},"segments":{"sn13.3:0.3":"Sambhejjaudakasuttaṃ","sn13.3:1.1":"Sāvatthiyaṃ viharati … pe …“seyyathāpi, bhikkhave, yatthimā mahānadiyo saṃsandanti samenti, seyyathidaṃ – gaṅgā yamunā aciravatī sarabhū mahī, tato puriso dve vā tīṇi vā udakaphusitāni uddhareyya.","sn13.3:1.4":"Taṃ kiṃ maññatha, bhikkhave, katamaṃ nu kho bahutaraṃ, yāni vā dve vā tīṇi vā udakaphusitāni ubbhatāni yaṃ vā sambhejjaudakan”ti?","sn13.3:2.1":"“Etadeva, bhante, bahutaraṃ yadidaṃ sambhejjaudakaṃ;","sn13.3:2.2":"appamattakāni dve vā tīṇi vā udakaphusitāni ubbhatāni.","sn13.3:2.3":"Neva satimaṃ kalaṃ upenti na sahassimaṃ kalaṃ upenti na satasahassimaṃ kalaṃ upenti sambhejjaudakaṃ upanidhāya dve vā tīṇi vā udakaphusitāni ubbhatānī”ti.","sn13.3:2.4":"“Evameva kho, bhikkhave … pe … dhammacakkhupaṭilābho”ti.","sn13.3:2.6":"Tatiyaṃ."},"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":482,"to":482,"paras":[{"para":482,"vripara":"76-77","refs":["sn13.3:1"],"lines":["76-77. Tatiye <b>yatthimā</b>ti yasmiṃ sambhijjaṭṭhāne imā.","<b>Saṃsandantī</b>ti samāgantvā sandanti.","<b>Samentī</b>ti samāgacchanti.","<b>Dve vā</b>ti <b>vā</b>ti dve vā tīṇi vā.","<b>Udakaphusitānī</b>ti udakabindūni.","<b>Saṃbhejjaudakan</b>ti aññāhi nadīhi saddhiṃ sambhinnaṭṭhāne udakaṃ.","Catutthaṃ uttānatthameva.","Tatiyacatutthāni."],"lineRefs":[["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"]]}],"wordLinks":[["sn13.3:1.1","yatthimā",0,0],["sn13.3:1.1","saṃsandantī",0,1],["sn13.3:1.1","samentī",0,2],["sn13.3:1.1","dve vā",0,3],["sn13.3:1.1","vā",0,3],["sn13.3:1.4","dve vā",0,3],["sn13.3:1.4","vā",0,3],["sn13.3:1.1","udakaphusitānī",0,4],["sn13.3:1.4","udakaphusitānī",0,4]],"before":[{"para":481,"vripara":null,"refs":[],"lines":["Saṃbhejjaudakasuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":472,"to":472,"paras":[{"para":472,"vripara":"76-77","refs":["sn13.3:1"],"lines":["76-77. <b>Sambhijjaṭṭhāne</b>ti sambhijjasamodhānagataṭṭhāne.","<b>Samenti</b> sametā honti.","Tenāha <b>“samāgacchantī”</b>ti.","Pāḷiyaṃ vibhattilopena niddesoti tamatthaṃ dassento <b>“tīṇi vā”</b>ti āha.","Sambhijjati missībhāvaṃ gacchati etthāti sambhejjaṃ, missitaṭṭhānaṃ.","Tattha udakaṃ <b>sambhejjaudakaṃ</b>.","Tenāha <b>“sambhinnaṭṭhāne udakan”</b>ti."],"lineRefs":[["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"]]}],"wordLinks":[["sn13.3:1.1","samenti",0,1],["sn13.3:1.1","tīṇi vā",0,3],["sn13.3:1.4","tīṇi vā",0,3],["sn13.3:1.4","sambhejjaudakaṃ",0,5]],"before":[{"para":470,"vripara":null,"refs":[],"lines":["Pokkharaṇīsuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":471,"vripara":null,"refs":[],"lines":["Saṃbhejjaudakasuttādivaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
