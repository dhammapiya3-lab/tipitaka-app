{"suttaId":"sn13.3","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[637,638],"vripara":"76"},"segments":{"sn13.3:0.3":"Sambhejjaudakasuttaṃ","sn13.3:1.1":"Sāvatthiyaṃ viharati…pe…","sn13.3:1.2":"“seyyathāpi, bhikkhave, yatthimā mahānadiyo saṃsandanti samenti, seyyathidaṃ –","sn13.3:1.3":"gaṅgā yamunā aciravatī sarabhū mahī, tato puriso dve vā tīṇi vā udakaphusitāni uddhareyya.","sn13.3:1.4":"Taṃ kiṃ maññatha, bhikkhave,","sn13.3:1.5":"katamaṃ nu kho bahutaraṃ, yāni vā dve vā tīṇi vā udakaphusitāni ubbhatāni yaṃ vā sambhejjaudaka”nti?","sn13.3:2.1":"“Etadeva, bhante, bahutaraṃ yadidaṃ sambhejjaudakaṃ;","sn13.3:2.2":"appamattakāni dve vā tīṇi vā udakaphusitāni ubbhatāni.","sn13.3:2.3":"Neva satimaṃ kalaṃ upenti na sahassimaṃ kalaṃ upenti na satasahassimaṃ kalaṃ upenti sambhejjaudakaṃ upanidhāya dve vā tīṇi vā udakaphusitāni ubbhatānī”ti.","sn13.3:2.4":"“Evameva kho, bhikkhave…pe…","sn13.3:2.5":"dhammacakkhupaṭilābho”ti.","sn13.3:2.6":"Tatiyaṃ. 4."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":482,"to":482,"paras":[{"para":482,"vripara":"76-77","refs":["sn13.3:1"],"lines":["Tatiye <b>yatthimā</b>ti yasmiṃ sambhijjaṭṭhāne imā.","<b>Saṃsandantī</b>ti samāgantvā sandanti.","<b>Samentī</b>ti samāgacchanti.","<b>Dve vā ti vā</b>ti dve vā tīṇi vā.","<b>Udakaphusitānī</b>ti udakabindūni.","<b>Saṃbhejjaudaka</b>nti aññāhi nadīhi saddhiṃ sambhinnaṭṭhāne udakaṃ.","Catutthaṃ uttānatthameva.","Tatiyacatutthāni. 5."],"lineRefs":[["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"]]}],"wordLinks":[["sn13.3:1.1","yatthimā",0,0],["sn13.3:1.1","saṃsandantī",0,1],["sn13.3:1.1","samentī",0,2],["sn13.3:1.1","dve vā",0,3],["sn13.3:1.1","vā",0,3],["sn13.3:1.4","dve vā",0,3],["sn13.3:1.4","vā",0,3],["sn13.3:1.1","udakaphusitānī",0,4],["sn13.3:1.4","udakaphusitānī",0,4]],"before":[{"para":481,"vripara":null,"title":"Saṃbhejjaudakasuttādivaṇṇanā","lines":["Saṃbhejjaudakasuttādivaṇṇanā 76-77."]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":472,"to":472,"paras":[{"para":472,"vripara":"76-77","refs":["sn13.3:1"],"lines":["<b>Sambhijjaṭṭhāne</b>ti sambhijjasamodhānagataṭṭhāne.","<b>Samenti</b> sametā honti.","Tenāha <b>“samāgacchantī”</b>ti.","Pāḷiyaṃ vibhattilopena niddesoti tamatthaṃ dassento <b>“tīṇi vā”</b>ti āha.","Sambhijjati missībhāvaṃ gacchati etthāti sambhejjaṃ, missitaṭṭhānaṃ.","Tattha udakaṃ <b>sambhejjaudakaṃ</b>.","Tenāha <b>“sambhinnaṭṭhāne udaka”</b>nti."],"lineRefs":[["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"],["sn13.3:1"]]}],"wordLinks":[["sn13.3:1.1","samenti",0,1],["sn13.3:1.1","tīṇi vā",0,3],["sn13.3:1.4","tīṇi vā",0,3],["sn13.3:1.4","sambhejjaudakaṃ",0,5]],"before":[{"para":471,"vripara":null,"title":"Saṃbhejjaudakasuttādivaṇṇanā","lines":["Saṃbhejjaudakasuttādivaṇṇanā 76-77."]}]},"tika2":null}
