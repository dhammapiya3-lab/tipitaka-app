{"suttaId":"thag2.13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[809,815],"vripara":"145"},"segments":{"thag2.13:0.4":"Heraññakānittheragāthā","thag2.13:1.1":"“Accayanti ahorattā, jīvitaṃ uparujjhati;","thag2.13:1.3":"Āyu khīyati maccānaṃ, kunnadīnaṃva odakaṃ.","thag2.13:2.1":"“Atha pāpāni kammāni, karaṃ bālo na bujjhati;","thag2.13:2.3":"Pacchāssa kaṭukaṃ hoti, vipāko hissa pāpako”ti.","thag2.13:2.5":"… Heraññakānitthero …."},"attha":null,"tika":null}
