{"suttaId":"an5.217","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1438,1439],"vripara":"217"},"segments":{"an5.217:0.3":"Paṭhamaapāsādikasuttaṃ","an5.217:1.1":"“Pañcime, bhikkhave, ādīnavā apāsādike.","an5.217:1.2":"Katame pañca?","an5.217:1.3":"Attāpi attānaṃ upavadati,","an5.217:1.4":"anuvicca viññū garahanti,","an5.217:1.5":"pāpako kittisaddo abbhuggacchati,","an5.217:1.6":"sammūḷho kālaṃ karoti,","an5.217:1.7":"kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjati.","an5.217:1.8":"Ime kho, bhikkhave, pañca ādīnavā apāsādike.","an5.217:2.1":"“Pañcime, bhikkhave, ānisaṃsā pāsādike.","an5.217:2.2":"Katame pañca?","an5.217:2.3":"Attāpi attānaṃ na upavadati,","an5.217:2.4":"anuvicca viññū pasaṃsanti,","an5.217:2.5":"kalyāṇo kittisaddo abbhuggacchati,","an5.217:2.6":"asammūḷho kālaṃ karoti,","an5.217:2.7":"kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati.","an5.217:2.8":"Ime kho, bhikkhave, pañca ānisaṃsā pāsādike”ti.","an5.217:2.9":"Sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":452,"to":452,"paras":[{"para":452,"vripara":"217","refs":["an5.217:1"],"lines":["Sattame <b>apāsādike</b>ti apāsādikehi kāyakammādīhi samannāgate.","<b>Pāsādike</b>ti pasādāvahe parisuddhasamācāre.","Aṭṭhamanavamāni uttānatthāneva. 10."],"lineRefs":[["an5.217:1"],["an5.217:1"],["an5.217:1"]]}],"wordLinks":[["an5.217:1.1","apāsādike",0,0],["an5.217:1.8","apāsādike",0,0],["an5.217:1.1","pāsādike",0,1],["an5.217:1.8","pāsādike",0,1]],"before":[{"para":451,"vripara":null,"title":"Paṭhamaapāsādikasuttavaṇṇanā","lines":["Paṭhamaapāsādikasuttavaṇṇanā 217."]}]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":456,"to":461,"paras":[{"para":456,"vripara":"213-220","refs":["an5.217:1"],"lines":["Tatiye (dī. ni. ṭī. 2.149) <b>dussīlo</b>ti ettha <b>du</b>-saddo abhāvattho “duppañño”tiādīsu (ma. ni. 1.449) viya, na garahaṇatthoti āha <b>“asīlo nissīlo”</b>ti.","<b>Bhinnasaṃvaro</b>ti ettha samādinnasīlo kenaci kāraṇena sīlabhedaṃ patto, so tāva bhinnasaṃvaro hotu.","Yo pana sabbena sabbaṃ asamādinnasīlo ācārahīno, so kathaṃ bhinnasaṃvaro nāma hotīti?","Sopi sādhusamācārassa pariharaṇīyassa bheditattā bhinnasaṃvaro eva nāma.","Vinaṭṭhasaṃvaro saṃvararahitoti hi vuttaṃ hoti.","<b>Taṃ taṃ</b> sippaṭṭhānaṃ.","<b>Māghātakāle</b>ti “mā ghātetha pāṇīna”nti evaṃ māghātaghosanaṃ ghositadivase.","<b>Abbhuggacchati</b> pāpako kittisaddo.","<b>Ajjhāsayena maṅku hotiyeva</b> vippaṭisāribhāvato."],"lineRefs":[["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"]]},{"para":457,"vripara":null,"refs":["an5.217:1"],"lines":["<b>Tassā</b>ti dussīlassa.","<b>Samādāya vattitaṭṭhāna</b>nti uṭṭhāya samuṭṭhāya katakāraṇaṃ.","<b>Āpāthaṃ āgacchatī</b>ti taṃ manaso upaṭṭhāti.","<b>Ummīletvā idhaloka</b>nti ummīlanakāle attano puttadārādivasena idhalokaṃ passati.","<b>Nimīletvā paraloka</b>nti nimīlanakāle gatinimittupaṭṭhānavasena paralokaṃ passati.","Tenāha <b>“cattāro apāyā”</b>tiādi.","<b>Pañcamapada</b>nti “kāyassa bhedā”tiādinā vutto pañcamo ādīnavakoṭṭhāso.","<b>Vuttavipariyāyenāti</b> vuttatthāya ādīnavakathāya vipariyāyena “appamatto taṃ taṃ kasivaṇijjādiṃ yathākālaṃ sampādetuṃ sakkotī”tiādinā.","Pāsaṃsaṃ sīlamassa atthīti <b>sīlavā.</b>","<b>Sīlasampanno</b>ti sīlena samannāgato sampannasīloti evamādikaṃ pana atthavacanaṃ sukaranti anāmaṭṭhaṃ.","Catutthādīni uttānatthāneva."],"lineRefs":[["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"],["an5.217:1"]]},{"para":458,"vripara":null,"refs":["an5.217:1"],"lines":["Sīlasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an5.217:1"]]},{"para":459,"vripara":null,"refs":["an5.217:1"],"lines":["Akkosakavaggavaṇṇanā niṭṭhitā. (23) 3."],"lineRefs":[["an5.217:1"]]},{"para":460,"vripara":null,"refs":["an5.217:1"],"lines":["Dīghacārikavaggo 1-10."],"lineRefs":[["an5.217:1"]]},{"para":461,"vripara":null,"refs":["an5.217:1"],"lines":["Paṭhamadīghacārikasuttādivaṇṇanā 221-230."],"lineRefs":[["an5.217:1"]]}],"wordLinks":[]},"tika2":null}
