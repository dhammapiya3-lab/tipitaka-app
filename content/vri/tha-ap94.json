{"suttaId":"tha-ap94","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4966,4984],"vripara":"8"},"segments":{"tha-ap94:0.3":"Sucintikattheraapadānaṃ","tha-ap94:1.1":"“Tissassa lokanāthassa,","tha-ap94:1.2":"suddhapīṭhamadāsahaṃ;","tha-ap94:1.3":"Haṭṭho haṭṭhena cittena,","tha-ap94:1.4":"buddhassādiccabandhuno.","tha-ap94:2.1":"“Aṭṭhārase [aṭṭhatiṃse (sī. syā.)] ito kappe,","tha-ap94:2.2":"rājā āsiṃ mahāruci;","tha-ap94:2.3":"Bhogo ca vipulo āsi,","tha-ap94:2.4":"sayanañca anappakaṃ.","tha-ap94:3.1":"“Pīṭhaṃ buddhassa datvāna,","tha-ap94:3.2":"vippasannena cetasā;","tha-ap94:3.3":"Anubhomi sakaṃ kammaṃ,","tha-ap94:3.4":"pubbe sukatamattano.","tha-ap94:4.1":"“Dvenavute ito kappe,","tha-ap94:4.2":"yaṃ pīṭhamadadiṃ tadā;","tha-ap94:4.3":"Duggatiṃ nābhijānāmi,","tha-ap94:4.4":"pīṭhadānassidaṃ phalaṃ.","tha-ap94:5.1":"“Aṭṭhatiṃse ito kappe,","tha-ap94:5.2":"tayo te cakkavattino;","tha-ap94:5.3":"Ruci uparuci ceva,","tha-ap94:5.4":"mahāruci tatiyako.","tha-ap94:6.1":"“Paṭisambhidā catasso … pe …","tha-ap94:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap94:7.1":"Itthaṃ sudaṃ āyasmā sucintiko thero imā gāthāyo abhāsitthāti.","tha-ap94:8.1":"Sucintikattherassāpadānaṃ dutiyaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2762,"to":2762,"paras":[{"para":2762,"vripara":"8","refs":["tha-ap94:1"],"lines":["So pattaarahattaphalo pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>tissassa lokanāthassā</b>tiādimāha.","Taṃ sabbaṃ uttānatthamevāti."],"lineRefs":[["tha-ap94:1"],["tha-ap94:1"]]}],"wordLinks":[["tha-ap94:1.1","tissassa lokanāthassā",0,0]],"before":[{"para":2760,"vripara":null,"title":"Sucintikattheraapadānavaṇṇanā","lines":["Sucintikattheraapadānavaṇṇanā"]},{"para":2761,"vripara":null,"title":"Sucintikattheraapadānavaṇṇanā","lines":["<b>Tissassa lokanāthassā</b>tiādikaṃ āyasmato sucintikattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro anekāsu jātīsu nibbānādhigamāya puññaṃ upacinitvā tissassa bhagavato kāle ekasmiṃ kulagehe nibbatto vuddhimanvāya satthari pasīditvā satthu nisīdanatthāya parisuddhaṃ siliṭṭhaṃ kaṭṭhamayamanagghapīṭhamadāsi.","So tena puññakammena sugatisukhamanubhavitvā tattha tattha saṃsaranto imasmiṃ buddhuppāde ekasmiṃ kulagehe nibbatto vuddhimanvāya satthari pasīditvā pabbajito nacirasseva arahā ahosi."]}],"after":[{"para":2763,"vripara":null,"title":"Sucintikattheraapadānavaṇṇanā","lines":["Sucintikattheraapadānavaṇṇanā samattā."]}]},"tika":null,"tika2":null}
