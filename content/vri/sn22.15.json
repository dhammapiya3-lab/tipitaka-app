{"suttaId":"sn22.15","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[118,118],"vripara":"15"},"segments":{"sn22.15:0.3":"Yadaniccasuttaṃ","sn22.15:1.1":"Sāvatthinidānaṃ.","sn22.15:1.2":"“Rūpaṃ, bhikkhave, aniccaṃ.","sn22.15:1.3":"Yadaniccaṃ taṃ dukkhaṃ;","sn22.15:1.4":"yaṃ dukkhaṃ tadanattā;","sn22.15:1.5":"yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn22.15:1.6":"Vedanā aniccā.","sn22.15:1.7":"Yadaniccaṃ taṃ dukkhaṃ;","sn22.15:1.8":"yaṃ dukkhaṃ tadanattā;","sn22.15:1.9":"yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn22.15:1.10":"Saññā aniccā … pe … saṅkhārā aniccā … viññāṇaṃ aniccaṃ.","sn22.15:1.13":"Yadaniccaṃ taṃ dukkhaṃ;","sn22.15:1.14":"yaṃ dukkhaṃ tadanattā;","sn22.15:1.15":"yadanattā taṃ ‘netaṃ mama, nesohamasmi, na meso attā’ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ.","sn22.15:1.16":"Evaṃ passaṃ … pe … nāparaṃ itthattāyāti pajānātī”ti.","sn22.15:1.18":"Catutthaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":70,"to":73,"paras":[{"para":70,"vripara":"12-21","refs":["sn22.15:1"],"lines":["12-21. Aniccavagge pariyosānasuttaṃ pucchāvasikaṃ, sesāni tathā tathā bujjhanakānañca vasena desitānīti.","Paṭhamādīni."],"lineRefs":[["sn22.15:1"],["sn22.15:1"]]},{"para":71,"vripara":null,"refs":[],"lines":["Aniccavaggo dutiyo."],"lineRefs":[[]]},{"para":72,"vripara":null,"refs":[],"lines":["Bhāravaggo"],"lineRefs":[[]]},{"para":73,"vripara":null,"refs":["sn22.15:1"],"lines":["Bhārasuttavaṇṇanā"],"lineRefs":[["sn22.15:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":66,"to":70,"paras":[{"para":66,"vripara":"12-21","refs":["sn22.15:1"],"lines":["12-21. <b>Pucchāvasikaṃ</b> ānandattherassa pucchāvasena desitattā."],"lineRefs":[["sn22.15:1"]]},{"para":67,"vripara":null,"refs":[],"lines":["Ani