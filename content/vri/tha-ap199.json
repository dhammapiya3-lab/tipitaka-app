{"suttaId":"tha-ap199","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7338,7359],"vripara":"35"},"segments":{"tha-ap199:0.3":"Tindukadāyakattheraapadānaṃ","tha-ap199:1.1":"“Giriduggacaro āsiṃ,","tha-ap199:1.2":"makkaṭo thāmavegiko;","tha-ap199:1.3":"Phalinaṃ tindukaṃ disvā,","tha-ap199:1.4":"buddhaseṭṭhaṃ anussariṃ. 36.","tha-ap199:2.1":"“Nikkhamitvā katipāhaṃ,","tha-ap199:2.2":"viciniṃ lokanāyakaṃ;","tha-ap199:2.3":"Pasannacitto sumano,","tha-ap199:2.4":"siddhatthaṃ tibhavantaguṃ. 37.","tha-ap199:3.1":"“Mama saṅkappamaññāya,","tha-ap199:3.2":"satthā loke anuttaro;","tha-ap199:3.3":"Khīṇāsavasahassehi,","tha-ap199:3.4":"āgacchi mama santikaṃ. 38.","tha-ap199:4.1":"“Pāmojjaṃ janayitvāna,","tha-ap199:4.2":"phalahattho upāgamiṃ;","tha-ap199:4.3":"Paṭiggahesi bhagavā,","tha-ap199:4.4":"sabbaññū vadataṃ varo. 39.","tha-ap199:5.1":"“Catunnavutito kappe,","tha-ap199:5.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap199:5.3":"Duggatiṃ nābhijānāmi,","tha-ap199:5.4":"phaladānassidaṃ phalaṃ. 40.","tha-ap199:6.1":"“Sattapaññāsakappamhi,","tha-ap199:6.2":"upanandasanāmako;","tha-ap199:6.3":"Sattaratanasampanno,","tha-ap199:6.4":"cakkavattī mahabbalo. 41.","tha-ap199:7.1":"“Paṭisambhidā catasso…pe…","tha-ap199:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap199:8.1":"Itthaṃ sudaṃ āyasmā tindukadāyako thero imā gāthāyo abhāsitthāti.","tha-ap199:9.1":"Tindukadāyakattherassāpadānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
