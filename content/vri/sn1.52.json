{"suttaId":"sn1.52","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[665,669],"vripara":"52"},"segments":{"sn1.52:0.3":"Ajarasāsuttaṃ","sn1.52:1.1":"“Kiṃsu ajarasā sādhu, kiṃsu sādhu adhiṭṭhitaṃ;","sn1.52:1.3":"Kiṃsu narānaṃ ratanaṃ, kiṃsu corehyahāriyan”ti.","sn1.52:2.1":"“Sīlaṃ ajarasā sādhu, saddhā sādhu adhiṭṭhitā;","sn1.52:2.3":"Paññā narānaṃ ratanaṃ, puññaṃ corehyahāriyan”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":440,"to":440,"paras":[{"para":440,"vripara":"52","refs":["sn1.52:1","sn1.52:2"],"words":["ajarasā"],"lines":["Dutiye <b>ajarasā</b>ti ajīraṇena, avipattiyāti attho.","Sīlañhi avipannameva sādhu hoti, vipannasīlaṃ ācariyupajjhāyādayopi na saṅgaṇhanti, gatagataṭṭhāne niddhamitabbova hotīti.","Dutiyaṃ."],"lineRefs":[["sn1.52:1"],["sn1.52:1"],["sn1.52:1"]]}]},"tika":null}
