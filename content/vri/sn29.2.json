{"suttaId":"sn29.2","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1255,1255],"vripara":"343"},"segments":{"sn29.2:0.3":"Paṇītatarasuttaṃ","sn29.2:1.1":"Sāvatthinidānaṃ.","sn29.2:1.2":"“Catasso imā, bhikkhave, nāgayoniyo.","sn29.2:1.3":"Katamā catasso?","sn29.2:1.4":"Aṇḍajā nāgā, jalābujā nāgā, saṃsedajā nāgā, opapātikā nāgā.","sn29.2:1.5":"Tatra, bhikkhave, aṇḍajehi nāgehi jalābujā ca saṃsedajā ca opapātikā ca nāgā paṇītatarā.","sn29.2:1.6":"Tatra, bhikkhave, aṇḍajehi ca jalābujehi ca nāgehi saṃsedajā ca opapātikā ca nāgā paṇītatarā.","sn29.2:1.7":"Tatra, bhikkhave, aṇḍajehi ca jalābujehi ca saṃsedajehi ca nāgehi opapātikā nāgā paṇītatarā.","sn29.2:1.8":"Imā kho, bhikkhave, catasso nāgayoniyo”ti.","sn29.2:1.9":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":468,"to":470,"paras":[{"para":468,"vripara":"343-391","refs":["sn29.2:1"],"lines":["Dutiyādīsu <b>vossaṭṭhakāyā</b>ti ahituṇḍikaparibuddhaṃ agaṇetvā vissaṭṭhakāyā.","<b>Dvayakārino</b>ti duvidhakārino, kusalākusalakārinoti attho.","<b>Sacajja maya</b>nti sace ajja mayaṃ.","<b>Sahabyataṃ upapajjatī</b>ti sahabhāvaṃ āpajjati.","Tatrassa akusalaṃ upapattiyā paccayo hoti, kusalaṃ upapannānaṃ sampattiyā.","<b>Anna</b>nti khādanīyabhojanīyaṃ.","<b>Pāna</b>nti yaṃkiñci pānakaṃ.","<b>Vattha</b>nti nivāsanapārupanaṃ.","<b>Yāna</b>nti chattupāhanaṃ ādiṃ katvā yaṃkiñci gamanapaccayaṃ.","<b>Māla</b>nti yaṃkiñci sumanamālādipupphaṃ.","<b>Gandha</b>nti yaṃkiñci candanādigandhaṃ.","<b>Vilepana</b>nti yaṃkiñci chavirāgakaraṇaṃ.","<b>Seyyāvasathapadīpeyya</b>nti mañcapīṭhādiseyyaṃ ekabhūmikādiāvasathaṃ vaṭṭitelādipadīpūpakaraṇañca detīti attho.","Tesañhi dīghāyukatāya ca vaṇṇavantatāya ca sukhabahulatāya ca patthanaṃ katvā imaṃ dasavidhaṃ dānavatthuṃ datvā taṃ sampattiṃ anubhavituṃ tattha nibbattanti.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"]]},{"para":469,"vripara":null,"refs":["sn29.2:1"],"lines":["Nāgasaṃyuttavaṇṇanā niṭṭhitā. 9."],"lineRefs":[["sn29.2:1"]]},{"para":470,"vripara":null,"refs":["sn29.2:1"],"lines":["Supaṇṇasaṃyuttavaṇṇanā 392-437."],"lineRefs":[["sn29.2:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":495,"to":498,"paras":[{"para":495,"vripara":"343-391","refs":["sn29.2:1"],"lines":["<b>Vissaṭṭhakāyā</b>ti “ye cammena vā rudhirena vā aṭṭhinā vā atthikā, te sabbaṃ gaṇhantū”ti tattha nirapekkhacittatāya adhiṭṭhitasīlatāya pariccattasarīrā.","<b>Duvidhakārino</b>ti “kālena kusalaṃ, kālena akusala”nti evaṃ kusalākusalakārino.","Saha byayati pavattatīti sahabyo, sahacāro.","Tassa bhāvo sahabyatā, taṃ <b>sahabyataṃ</b>.","Adanīyato <b>annaṃ</b>.","Khādanīyato <b>khajjaṃ</b>.","Pātabbato <b>pānaṃ</b>.","Nivasanīyato <b>vatthaṃ</b>.","Nivasitabbaṃ <b>nivāsanaṃ</b>.","Parivaritabbaṃ <b>pāvuraṇaṃ</b>.","Yānti tenāti <b>yānaṃ,</b> upāhanādiyānāni.","Ādisaddena vayhasivikādīnaṃ saṅgaho.","Chattampi parissayātapadukkhaparirakkhaṇena maggagamanasādhananti katvā <b>“chattupāhana”</b>ntiādi vuttaṃ.","Tena vuttaṃ <b>“yaṃ kiñci gamanapaccaya”</b>nti.","<b>Patthanaṃ katvā…pe… tattha nibbattanti</b> campeyyanāgarājā viyāti daṭṭhabbaṃ."],"lineRefs":[["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"],["sn29.2:1"]]},{"para":496,"vripara":null,"refs":["sn29.2:1"],"lines":["Paṇītatarasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn29.2:1"]]},{"para":497,"vripara":null,"refs":["sn29.2:1"],"lines":["Nāgasaṃyuttavaṇṇanā niṭṭhitā. 9."],"lineRefs":[["sn29.2:1"]]},{"para":498,"vripara":null,"refs":["sn29.2:1"],"lines":["Supaṇṇasaṃyuttavaṇṇanā 392-437."],"lineRefs":[["sn29.2:1"]]}],"wordLinks":[]},"tika2":null}
