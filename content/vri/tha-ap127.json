{"suttaId":"tha-ap127","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[5809,5881],"vripara":"41"},"segments":{"tha-ap127:0.3":"Sammukhāthavikattheraapadānaṃ","tha-ap127:1.1":"“Jāyamāne vipassimhi,","tha-ap127:1.2":"nimittaṃ byākariṃ ahaṃ;","tha-ap127:1.3":"‘Nibbāpayiñca [nibbāpayaṃ ca (sī. syā.), nibbāpayanto (?)] janataṃ,","tha-ap127:1.4":"buddho loke bhavissati.","tha-ap127:2.1":"“‘Yasmiñca jāyamānasmiṃ,","tha-ap127:2.2":"dasasahassi kampati;","tha-ap127:2.3":"So dāni bhagavā satthā,","tha-ap127:2.4":"dhammaṃ deseti cakkhumā.","tha-ap127:3.1":"“‘Yasmiñca jāyamānasmiṃ,","tha-ap127:3.2":"āloko vipulo ahu;","tha-ap127:3.3":"So dāni bhagavā satthā,","tha-ap127:3.4":"dhammaṃ deseti cakkhumā.","tha-ap127:4.1":"“‘Yasmiñca jāyamānasmiṃ,","tha-ap127:4.2":"saritāyo na sandayuṃ [sandisuṃ (sī. syā.)];","tha-ap127:4.3":"So dāni bhagavā satthā,","tha-ap127:4.4":"dhammaṃ deseti cakkhumā.","tha-ap127:5.1":"“‘Yasmiñca jāyamānasmiṃ,","tha-ap127:5.2":"avīcaggi na pajjali;","tha-ap127:5.3":"So dāni bhagavā satthā,","tha-ap127:5.4":"dhammaṃ deseti cakkhumā.","tha-ap127:6.1":"“‘Yasmiñca jāyamānasmiṃ,","tha-ap127:6.2":"pakkhisaṅgho na saṃcari;","tha-ap127:6.3":"So dāni bhagavā satthā,","tha-ap127:6.4":"dhammaṃ deseti cakkhumā.","tha-ap127:7.1":"“‘Yasmiñca jāyamānasmiṃ,","tha-ap127:7.2":"vātakkhandho na vāyati;","tha-ap127:7.3":"So dāni bhagavā satthā,","tha-ap127:7.4":"dhammaṃ deseti cakkhumā.","tha-ap127:8.1":"“‘Yasmiñca jāyamānasmiṃ,","tha-ap127:8.2":"sabbaratanāni jotayuṃ [jotisuṃ (sī. syā.)];","tha-ap127:8.3":"So dāni bhagavā satthā,","tha-ap127:8.4":"dhammaṃ deseti cakkhumā.","tha-ap127:9.1":"“‘Yasmiñca jāyamānasmiṃ,","tha-ap127:9.2":"sattāsuṃ padavikkamā;","tha-ap127:9.3":"So dāni bhagavā satthā,","tha-ap127:9.4":"dhammaṃ deseti cakkhumā.","tha-ap127:10.1":"“‘Jātamatto ca sambuddho,","tha-ap127:10.2":"disā sabbā vilokayi;","tha-ap127:10.3":"Vācāsabhimudīresi,","tha-ap127:10.4":"esā buddhāna dhammatā’.","tha-ap127:11.1":"“Saṃvejayitvā janataṃ,","tha-ap127:11.2":"thavitvā lokanāyakaṃ;","tha-ap127:11.3":"Sambuddhaṃ abhivādetvā,","tha-ap127:11.4":"pakkāmiṃ pācināmukho.","tha-ap127:12.1":"“Ekanavutito kappe,","tha-ap127:12.2":"yaṃ buddhamabhithomayiṃ;","tha-ap127:12.3":"Duggatiṃ nābhijānāmi,","tha-ap127:12.4":"thomanāya idaṃ phalaṃ.","tha-ap127:13.1":"“Ito navutikappamhi,","tha-ap127:13.2":"sammukhāthavikavhayo;","tha-ap127:13.3":"Sattaratanasampanno,","tha-ap127:13.4":"cakkavattī mahabbalo.","tha-ap127:14.1":"“Pathavīdundubhi nāma [duddasi nāma (ka.)],","tha-ap127:14.2":"ekūnanavutimhito;","tha-ap127:14.3":"Sattaratanasampanno,","tha-ap127:14.4":"cakkavattī mahabbalo.","tha-ap127:15.1":"“Aṭṭhāsītimhito kappe,","tha-ap127:15.2":"obhāso nāma khattiyo;","tha-ap127:15.3":"Sattaratanasampanno,","tha-ap127:15.4":"cakkavattī mahabbalo.","tha-ap127:16.1":"“Sattāsītimhito kappe,","tha-ap127:16.2":"saritacchedanavhayo;","tha-ap127:16.3":"Sattaratanasampanno,","tha-ap127:16.4":"cakkavattī mahabbalo.","tha-ap127:17.1":"“Agginibbāpano nāma,","tha-ap127:17.2":"kappānaṃ chaḷasītiyā;","tha-ap127:17.3":"Sattaratanasampanno,","tha-ap127:17.4":"cakkavattī mahabbalo.","tha-ap127:18.1":"“Gatipacchedano nāma,","tha-ap127:18.2":"kappānaṃ pañcasītiyā;","tha-ap127:18.3":"Sattaratanasampanno,","tha-ap127:18.4":"cakkavattī mahabbalo.","tha-ap127:19.1":"“Rājā vātasamo nāma,","tha-ap127:19.2":"kappānaṃ cullasītiyā;","tha-ap127:19.3":"Sattaratanasampanno,","tha-ap127:19.4":"cakkavattī mahabbalo.","tha-ap127:20.1":"“Ratanapajjalo nāma,","tha-ap127:20.2":"kappānaṃ teasītiyā;","tha-ap127:20.3":"Sattaratanasampanno,","tha-ap127:20.4":"cakkavattī mahabbalo.","tha-ap127:21.1":"“Padavikkamano nāma,","tha-ap127:21.2":"kappānaṃ dveasītiyā;","tha-ap127:21.3":"Sattaratanasampanno,","tha-ap127:21.4":"cakkavattī mahabbalo.","tha-ap127:22.1":"“Rājā vilokano nāma,","tha-ap127:22.2":"kappānaṃ ekasītiyā;","tha-ap127:22.3":"Sattaratanasampanno,","tha-ap127:22.4":"cakkavattī mahabbalo.","tha-ap127:23.1":"“Girasāroti nāmena,","tha-ap127:23.2":"kappesītimhi khattiyo;","tha-ap127:23.3":"Sattaratanasampanno,","tha-ap127:23.4":"cakkavattī mahabbalo.","tha-ap127:24.1":"“Paṭisambhidā catasso … pe …","tha-ap127:24.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap127:25.1":"Itthaṃ sudaṃ āyasmā sammukhāthaviko thero imā gāthāyo abhāsitthāti.","tha-ap127:26.1":"Sammukhāthavikattherassāpadānaṃ pañcamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2913,"to":2913,"paras":[{"para":2913,"vripara":"41","refs":["tha-ap127:1"],"lines":["So attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>jāyamāne vipassimhī</b>tiādimāha.","<b>Vipassimhi</b> sammāsambuddhe <b>jāyamāne</b> uppajjamāne mātukucchito nikkhante ahaṃ pātubhūtaṃ <b>nimittaṃ</b> kāraṇaṃ buddhabhāvassa hetuṃ <b>byākariṃ</b> kathesiṃ, anekāni acchariyāni pākaṭāni akāsinti attho.","Sesaṃ vuttanayānusārena suviññeyyamevāti."],"lineRefs":[["tha-ap127:1"],["tha-ap127:1"],["tha-ap127:1"]]}],"wordLinks":[["tha-ap127:1.1","jāyamāne vipassimhī",0,0],["tha-ap127:1.1","byākariṃ",0,1],["tha-ap127:1.1","jāyamāne",0,1],["tha-ap127:1.1","nimittaṃ",0,1],["tha-ap127:1.1","vipassimhi",0,1]],"before":[{"para":2911,"vripara":null,"title":"Sammukhāthavikattheraapadānavaṇṇanā","lines":["Sammukhāthavikattheraapadānavaṇṇanā"]},{"para":2912,"vripara":null,"title":"Sammukhāthavikattheraapadānavaṇṇanā","lines":["<b>Jāyamāne vipassimhī</b>tiādikaṃ āyasmato sammukhāthavikattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto vipassissa bhagavato kāle brāhmaṇakule nibbatto sattavassikakāleyeva sakasippe nipphattiṃ patto gharāvāsaṃ saṇṭhapetvā vasanto vipassimhi bodhisatte uppanne sabbabuddhānaṃ lakkhaṇāni vedattaye dissamānāni tāni rājappamukhassa janakāyassa vipassībodhisattassa lakkhaṇañca buddhabhāvañca byākaritvā janānaṃ mānasaṃ nibbāpesi, anekāni ca thutivacanāni nivedesi.","So tena kusalakammena cha kāmāvacarasampattiyo anubhavitvā manussesu ca cakkavattisampattiyo anubhavitvā imasmiṃ buddhuppāde kulagehe nibbatto viññutaṃ patto saddhājāto pabbajitvā nacirasseva arahā ahosi.","Katakusalanāmena <b>sammukhāthavikatthero</b>ti pākaṭo."]}],"after":[{"para":2914,"vripara":null,"title":"Sammukhāthavikattheraapadānavaṇṇanā","lines":["Sammukhāthavikattheraapadānavaṇṇanā samattā."]}]},"tika":null,"tika2":null}
