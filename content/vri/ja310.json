{"suttaId":"ja310","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2457,2473],"vripara":"37"},"segments":{"ja310:0.4":"Seyyajātakaṃ (4-1-10)","ja310:1.1":"Sasamuddapariyāyaṃ,","ja310:1.2":"mahiṃ sāgarakuṇḍalaṃ;","ja310:1.3":"Na icche saha nindāya,","ja310:1.4":"evaṃ seyya [sayha (sī. syā. pī.)] vijānahi. 38.","ja310:2.1":"Dhiratthu taṃ yasalābhaṃ,","ja310:2.2":"dhanalābhañca brāhmaṇa;","ja310:2.3":"Yā vutti vinipātena,","ja310:2.4":"adhammacaraṇena vā. 39.","ja310:3.1":"Api ce pattamādāya,","ja310:3.2":"anagāro paribbaje;","ja310:3.3":"Sāyeva jīvikā seyyo,","ja310:3.4":"yā cādhammena esanā. 40.","ja310:4.1":"Api ce pattamādāya,","ja310:4.2":"anagāro paribbaje;","ja310:4.3":"Aññaṃ ahiṃsayaṃ loke,","ja310:4.4":"api rajjena taṃ varanti.","ja310:5.1":"Seyyajātakaṃ [sayhajātakaṃ (sī. syā. pī.)] dasamaṃ.","ja310:5.2":"Kāliṅgavaggo [vivaravaggo (sī. pī.)] paṭhamo.","ja310:6.1":"Tassuddānaṃ –","ja310:7.1":"Vivarañca adeyya samiddhavaraṃ,","ja310:7.2":"atha daddara pāpamahātiraho;","ja310:7.3":"Atha koli palāsavarañca kara,","ja310:7.4":"carimaṃ sasamuddavarena dasāti. 2."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":258,"to":259,"paras":[{"para":258,"vripara":null,"refs":["ja310:5"],"lines":["Tattha <b>sasamuddapariyāya</b>nti pariyāyo vuccati parivāro, samuddaṃ parivāretvā ṭhitena cakkavāḷapabbatena saddhiṃ, samuddasaṅkhātena vā parivārena saddhinti attho.","<b>Sāgarakuṇḍala</b>nti sāgaramajjhe dīpavasena ṭhitattā tassa kuṇḍalabhūtanti attho.","<b>Nindāyā</b>ti jhānasukhasampannaṃ pabbajjaṃ chaḍḍetvā issariyaṃ gaṇhīti imāya nindāya.","<b>Seyyā</b>ti taṃ nāmenālapati.","<b>Vijānahī</b>ti dhammaṃ vijānāhi.","<b>Yā vutti vinipātenā</b>ti yā purohitaṭṭhānavasena laddhā yasalābhadhanalābhavutti jhānasukhato attavinipātanasaṅkhātena vinipātena ito gantvā issariyamadamattassa adhammacaraṇena vā hoti, taṃ vuttiṃ dhiratthu."],"lineRefs":[["ja310:5"],["ja310:5"],["ja310:5"],["ja310:5"],["ja310:5"],["ja310:5"]]},{"para":259,"vripara":null,"refs":["ja310:4"],"lines":["<b>Pattamādāyā</b>ti bhikkhābhājanaṃ gahetvā.","<b>Anagāro</b>ti api ahaṃ agāravirahito parakulesu careyyaṃ.","<b>Sāyeva jīvikā</b>ti sā eva me jīvikā seyyo varatarā.","<b>Yā cādhammena esanā</b>ti yā ca adhammena esanā.","Idaṃ vuttaṃ hoti – yā adhammena esanā, tato esāva jīvikā sundaratarāti.","<b>Ahiṃsaya</b>nti aviheṭhento.","<b>Api rajjenā</b>ti evaṃ paraṃ aviheṭhento kapālahatthassa mama jīvikakappanaṃ rajjenāpi varaṃ uttamanti."],"lineRefs":[["ja310:4"],["ja310:4"],["ja310:4"],["ja310:4"],["ja310:4"],["ja310:4"],["ja310:4"]]}],"wordLinks":[["ja310:5.1","seyyā",0,3],["ja310:4.1","pattamādāyā",1,0],["ja310:4.1","anagāro",1,1],["ja310:4.3","ahiṃsayaṃ",1,5],["ja310:4.3","api rajjenā",1,6]],"after":[{"para":260,"vripara":null,"title":"[310] 10. Seyyajātakavaṇṇanā","lines":["Iti so punappunaṃ yācantampi taṃ paṭikkhipi.","Seyyopi tassa manaṃ alabhitvā taṃ vanditvā gantvā tassa anāgamanabhāvaṃ rañño ārocesi."]},{"para":261,"vripara":null,"title":"[310] 10. Seyyajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne ukkaṇṭhitabhikkhu sotāpattiphale patiṭṭhahi, aparepi bahū sotāpattiphalādīni sacchikariṃsu."]},{"para":262,"vripara":null,"title":"[310] 10. Seyyajātakavaṇṇanā","lines":["Tadā rājā ānando ahosi, seyyo sāriputto, purohitaputto pana ahameva ahosinti."]},{"para":263,"vripara":null,"title":"[310] 10. Seyyajātakavaṇṇanā","lines":["Seyyajātakavaṇṇanā dasamā."]},{"para":264,"vripara":null,"title":"[310] 10. Seyyajātakavaṇṇanā","lines":["Kāliṅgavaggo paṭhamo. 2."]}]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":1466,"to":1473,"paras":[{"para":1466,"vripara":null,"refs":["ja310:1"],"lines":["10-seyyajātakavaṇṇanā (310)"],"lineRefs":[["ja310:1"]]},{"para":1467,"vripara":null,"refs":["ja310:1"],"lines":["<b>aññamaññaṃ vissāso thiro ahosī</b>ti aññamaññaṃ vissāso daḷhataro ahosi.","<b>sallakkhitakkhaṇeyevā</b>ti anussari-takkhaṇeyeva.","<b>vivekaṃ anubrūhessāmī</b>ti kāyavivekaṃ cittavivekañca bhāvayissāmi.","<b>sakalakāsikosalajambudīparajjaṃ cakkavattisirimevā</b>ti sakalakāsikosalarajjañca jambudīparajjañca cakkavattisirimeva ca labhantopi na gacchissāmīti attho.","<b>niṭṭhubhakheḷasadisa</b>nti niṭṭhānavasena ubhati pūretīti niṭṭhubho.","niṭṭhubho ca so kheḷo cāti niṭṭhubhakheḷo.","tena sadisaṃ niṭṭhubhakheḷasadisaṃ.","samantato sāsati pavattatīti parisāso.","parivāroti āha “parisāso vuccati parivāro”ti."],"lineRefs":[["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"]]},{"para":1468,"vripara":null,"refs":["ja310:1"],"lines":["ending seyyajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja310:1"]]},{"para":1469,"vripara":null,"refs":["ja310:1"],"lines":["ending kāliṅgavaggo paṭhamo."],"lineRefs":[["ja310:1"]]},{"para":1470,"vripara":null,"refs":["ja310:1"],"lines":["footnote 1.","mato.","jā.","ṭṭha.","27."],"lineRefs":[["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"]]},{"para":1471,"vripara":null,"refs":["ja310:1"],"lines":["footnote 2.","udare baddho.","jā.","ṭṭha.","27."],"lineRefs":[["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"]]},{"para":1472,"vripara":null,"refs":["ja310:1"],"lines":["footnote 3.","rattapupphadāmapilandhanavaṃso.","jā.","ṭṭha.","30."],"lineRefs":[["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"]]},{"para":1473,"vripara":null,"refs":["ja310:1"],"lines":["footnote 4.","pariyāyo.","jā.","ṭṭha.","30."],"lineRefs":[["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"],["ja310:1"]]}],"wordLinks":[]},"tika2":null}
