{"suttaId":"sn3.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[1491,1496],"vripara":"127"},"segments":{"sn3.16:0.3":"Mallikāsuttaṃ","sn3.16:1.1":"Sāvatthinidānaṃ.","sn3.16:1.2":"Atha kho rājā pasenadi kosalo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi.","sn3.16:1.3":"Atha kho aññataro puriso yena rājā pasenadi kosalo tenupasaṅkami; upasaṅkamitvā rañño pasenadissa kosalassa upakaṇṇake ārocesi –","sn3.16:1.4":"“mallikā, deva, devī dhītaraṃ vijātā”ti.","sn3.16:1.5":"Evaṃ vutte, rājā pasenadi kosalo anattamano ahosi.","sn3.16:2.1":"Atha kho bhagavā rājānaṃ pasenadiṃ kosalaṃ anattamanataṃ viditvā tāyaṃ velāyaṃ imā gāthāyo abhāsi –","sn3.16:3.1":"“Itthīpi hi ekacciyā,","sn3.16:3.2":"seyyā posa janādhipa;","sn3.16:3.3":"Medhāvinī sīlavatī,","sn3.16:3.4":"sassudevā patibbatā.","sn3.16:4.1":"“Tassā yo jāyati poso,","sn3.16:4.2":"sūro hoti disampati;","sn3.16:4.3":"Tādisā subhagiyā [subhariyāputto (ka.)] putto,","sn3.16:4.4":"rajjampi anusāsatī”ti."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":713,"to":713,"paras":[{"para":713,"vripara":"127","refs":["sn3.16:1","sn3.16:3","sn3.16:4"],"lines":["Chaṭṭhe <b>upasaṅkamī</b>ti mallikāya deviyā gabbhavuṭṭhānakāle sūtigharaṃ paṭijaggāpetvā ārakkhaṃ datvā upasaṅkami.","<b>Anattamano ahosī</b>ti,“duggatakulassa me dhītu mahantaṃ issariyaṃ dinnaṃ, sace puttaṃ alabhissa, mahantaṃ sakkāraṃ adhigamissa, tato dāni parihīnā”ti anattamano ahosi.","<b>Seyyā</b>ti dandhapaññasmā elamūgaputtato ekaccā itthīyeva seyyā.","<b>Posā</b>ti posehi.","<b>Janādhipā</b>ti janādhibhuṃ rājānaṃ ālapati.","<b>Sassudevā</b>ti sassusasuradevatā.","<b>Disampatī</b>ti disājeṭṭhakā.","<b>Tādisā subhagiyā</b>ti tādisāya subhariyāya.","Chaṭṭhaṃ."],"lineRefs":[["sn3.16:1"],["sn3.16:1"],["sn3.16:3"],["sn3.16:3"],["sn3.16:3"],["sn3.16:3"],["sn3.16:4"],["sn3.16:4"],["sn3.16:4"]]}],"wordLinks":[["sn3.16:1.2","upasaṅkamī",0,0],["sn3.16:1.3","upasaṅkamī",0,0],["sn3.16:1.5","anattamano ahosī",0,1],["sn3.16:3.1","seyyā",0,2],["sn3.16:3.1","posā",0,3],["sn3.16:3.1","janādhipā",0,4],["sn3.16:3.3","sassudevā",0,5],["sn3.16:4.1","disampatī",0,6],["sn3.16:4.3","tādisā subhagiyā",0,7]],"before":[{"para":712,"vripara":null,"title":"Mallikāsuttavaṇṇanā","lines":["Mallikāsuttavaṇṇanā"]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":855,"to":855,"paras":[{"para":855,"vripara":"127","refs":["sn3.16:3"],"lines":["<b>Ekaccā</b>ti paṇḍitā sapaññā.","<b>Seyyā</b>ti varā.","Gāthāsukhatthaṃ sasurasaddalopaṃ katvā “sassudevā”ti vuttanti āha <b>“sassusasuradevatā”</b>ti.","<b>Disājeṭṭhakā</b>ti catūsupi disāsu jeṭṭhakasīsena hi lokaṃ vadati.","<b>Tādisāyā</b>ti tathārūpāya medhāvitādiguṇavuttiyā.","<b>Subhariyāyā</b>ti sukhettabhūtāya sundaritthiyāti attho."],"lineRefs":[["sn3.16:3"],["sn3.16:3"],["sn3.16:3"],["sn3.16:3"],["sn3.16:3"],["sn3.16:3"]]}],"wordLinks":[["sn3.16:3.1","ekaccā",0,0],["sn3.16:3.1","seyyā",0,1]],"before":[{"para":854,"vripara":null,"title":"Mallikāsuttavaṇṇanā","lines":["Mallikāsuttavaṇṇanā"]}],"after":[{"para":856,"vripara":null,"title":"Mallikāsuttavaṇṇanā","lines":["Mallikāsuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
