{"suttaId":"tha-ap547","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[5407,5472],"vripara":"143"},"segments":{"tha-ap547:0.3":"Nandakattheraapadānaṃ","tha-ap547:1.1":"“Padumuttaro nāma jino,","tha-ap547:1.2":"sabbadhammesu cakkhumā;","tha-ap547:1.3":"Ito satasahassamhi,","tha-ap547:1.4":"kappe uppajji nāyako.","tha-ap547:2.1":"“Hitāya sabbasattānaṃ,","tha-ap547:2.2":"sukhāya vadataṃ varo;","tha-ap547:2.3":"Atthāya purisājañño,","tha-ap547:2.4":"paṭipanno sadevake.","tha-ap547:3.1":"“Yasaggapatto sirimā,","tha-ap547:3.2":"kittivaṇṇabhato [kittivaṇṇa bhaṭo (syā. ka.)] jino;","tha-ap547:3.3":"Pūjito sabbalokassa,","tha-ap547:3.4":"disā sabbāsu vissuto.","tha-ap547:4.1":"“Uttiṇṇavicikiccho so,","tha-ap547:4.2":"vītivattakathaṃkatho;","tha-ap547:4.3":"Paripuṇṇamanasaṅkappo,","tha-ap547:4.4":"patto sambodhimuttamaṃ.","tha-ap547:5.1":"“Anuppannassa maggassa,","tha-ap547:5.2":"uppādetā naruttamo;","tha-ap547:5.3":"Anakkhātañca akkhāsi,","tha-ap547:5.4":"asañjātañca sañjanī.","tha-ap547:6.1":"“Maggaññū maggavidū [so maggavidū (sī. pī.)] ca,","tha-ap547:6.2":"maggakkhāyī narāsabho;","tha-ap547:6.3":"Maggassa kusalo satthā,","tha-ap547:6.4":"sārathīnaṃ varuttamo [naruttamo (syā.)].","tha-ap547:7.1":"“Tadā mahākāruṇiko,","tha-ap547:7.2":"dhammaṃ desesi nāyako;","tha-ap547:7.3":"Nimugge kāmapaṅkamhi [mohapaṅkamhi (sī. syā.), mohamaggamhi (pī.)],","tha-ap547:7.4":"samuddharati pāṇine.","tha-ap547:8.1":"“Bhikkhunīnaṃ ovadane,","tha-ap547:8.2":"sāvakaṃ seṭṭhasammataṃ;","tha-ap547:8.3":"Vaṇṇayaṃ etadaggamhi,","tha-ap547:8.4":"paññapesi mahāmuni.","tha-ap547:9.1":"“Taṃ sutvāhaṃ pamudito,","tha-ap547:9.2":"nimantetvā tathāgataṃ;","tha-ap547:9.3":"Bhojayitvā sasaṅghaṃ taṃ,","tha-ap547:9.4":"patthayiṃ ṭhānamuttamaṃ.","tha-ap547:10.1":"“Tadā pamudito nātho,","tha-ap547:10.2":"maṃ avoca mahāisi;","tha-ap547:10.3":"‘Sukhī bhavassu dīghāvu [dīghāyu (sī. syā.)],","tha-ap547:10.4":"lacchase taṃ manorathaṃ.","tha-ap547:11.1":"“‘Satasahassito kappe,","tha-ap547:11.2":"okkākakulasambhavo;","tha-ap547:11.3":"Gotamo nāma gottena,","tha-ap547:11.4":"satthā loke bhavissati.","tha-ap547:12.1":"“‘Tassa dhammesu dāyādo,","tha-ap547:12.2":"oraso dhammanimmito;","tha-ap547:12.3":"Nandako nāma nāmena,","tha-ap547:12.4":"hessati satthu sāvako’.","tha-ap547:13.1":"“Tena kammena sukatena,","tha-ap547:13.2":"cetanāpaṇidhīhi ca;","tha-ap547:13.3":"Jahitvā mānusaṃ dehaṃ,","tha-ap547:13.4":"tāvatiṃsūpago ahaṃ.","tha-ap547:14.1":"“Pacchime ca bhave dāni,","tha-ap547:14.2":"jāto seṭṭhikule ahaṃ;","tha-ap547:14.3":"Sāvatthiyaṃ pure vare,","tha-ap547:14.4":"iddhe phīte mahaddhane.","tha-ap547:15.1":"“Purappavese sugataṃ,","tha-ap547:15.2":"disvā vimhitamānaso;","tha-ap547:15.3":"Jetārāmapaṭiggāhe,","tha-ap547:15.4":"pabbajiṃ anagāriyaṃ.","tha-ap547:16.1":"“Nacireneva kālena,","tha-ap547:16.2":"arahattamapāpuṇiṃ;","tha-ap547:16.3":"Tatohaṃ tiṇṇasaṃsāro,","tha-ap547:16.4":"sāsito sabbadassinā.","tha-ap547:17.1":"“Bhikkhunīnaṃ dhammakathaṃ,","tha-ap547:17.2":"paṭipucchākariṃ ahaṃ;","tha-ap547:17.3":"Sāsitā tā mayā sabbā,","tha-ap547:17.4":"abhaviṃsu anāsavā.","tha-ap547:18.1":"“Satāni pañcanūnāni,","tha-ap547:18.2":"tadā tuṭṭho mahāhito;","tha-ap547:18.3":"Bhikkhunīnaṃ ovadataṃ,","tha-ap547:18.4":"aggaṭṭhāne ṭhapesi maṃ.","tha-ap547:19.1":"“Satasahasse kataṃ kammaṃ,","tha-ap547:19.2":"phalaṃ dassesi me idha;","tha-ap547:19.3":"Sumutto saravegova,","tha-ap547:19.4":"kilese jhāpayiṃ mama.","tha-ap547:20.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap547:20.3":"viharāmi anāsavo.","tha-ap547:21.1":"“Svāgataṃ vata me āsi … pe …","tha-ap547:21.3":"kataṃ buddhassa sāsanaṃ.","tha-ap547:22.1":"“Paṭisambhidā catasso … pe …","tha-ap547:22.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap547:23.1":"Itthaṃ sudaṃ āyasmā nandako thero imā gāthāyo Abhāsitthāti.","tha-ap547:24.1":"Nandakattherassāpadānaṃ pañcamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":1465,"to":1549,"paras":[{"para":1465,"vripara":"143","refs":["tha-ap547:1"],"lines":["“Asakkharā apabbhārā, sādu appaṭigandhikā;"],"lineRefs":[["tha-ap547:1"]]},{"para":1466,"vripara":null,"refs":["tha-ap547:1"],"lines":["Sandatī nadikā tattha, sobhayantā mamassamaṃ”."],"lineRefs":[["tha-ap547:1"]]},{"para":1467,"vripara":null,"refs":["tha-ap547:1"],"lines":["Tattha <b>asakkharā</b>ti “pulinākiṇṇā”ti vuttattā asakkharā sakkharavirahitā.","<b>Apabbhārā</b>ti pabbhāravirahitā, agambhīrakūlāti attho.","<b>Sādu appaṭigandhikā</b>ti sādurasodakā duggandharahitā mayhaṃ assamapadaṃ sobhayantī <b>nadikā</b> khuddakanadī <b>sandati</b> pavattatīti attho."],"lineRefs":[["tha-ap547:1"],["tha-ap547:1"],["tha-ap547:1"]]},{"para":1469,"vripara":"144","refs":["tha-ap547:2"],"lines":["“Kumbhīlā makarā cettha, susumārā ca kacchapā;"],"lineRefs":[["tha-ap547:2"]]},{"para":1470,"vripara":null,"refs":["tha-ap547:2"],"lines":["Sandati nadikā tattha, sobhayantā mamassamaṃ”."],"lineRefs":[["tha-ap547:2"]]},{"para":1471,"vripara":null,"refs":["tha-ap547:2"],"lines":["Tattha <b>kumbhīla</b> macchā <b>makara</b> macchā ca <b>susumārā</b> caṇḍamacchā ca <b>kacchapa</b> macchā ca <b>ettha</b> etissaṃ nadiyaṃ kīḷantā ahesunti sambandho.","Mamassamaṃ sobhayantā <b>nadikā</b> khuddakanadī <b>sandati</b> pavattatīti sambandho."],"lineRefs":[["tha-ap547:2"],["tha-ap547:2"]]},{"para":1473,"vripara":"145","refs":["tha-ap547:3"],"lines":["“Pāṭhīnā pāvusā macchā, balajā muñjarohitā;"],"lineRefs":[["tha-ap547:3"]]},{"para":1474,"vripara":null,"refs":["tha-ap547:3"],"lines":["Vaggaḷā papatāyantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap547:3"]]},{"para":1475,"vripara":null,"refs":["tha-ap547:3"],"lines":["<b>Pāṭhīna</b> macchā ca <b>pāvusā macchā</b> ca <b>balaja</b> macchā ca <b>muñja</b> macchā <b>rohita</b> macchā ca <b>vaggaḷa</b> macchā ca ete sabbe macchajātikā ito cito ca <b>papatāyantā</b> nadiyā saddhiṃ pavattantā mama assamapadaṃ sobhayantīti attho."],"lineRefs":[["tha-ap547:3"]]},{"para":1477,"vripara":"146","refs":["tha-ap547:4"],"lines":["“Ubho kūlesu nadiyā, pupphino phalino dumā;"],"lineRefs":[["tha-ap547:4"]]},{"para":1478,"vripara":null,"refs":["tha-ap547:4"],"lines":["Ubhato abhilambantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap547:4"]]},{"para":1479,"vripara":null,"refs":["tha-ap547:4"],"lines":["Tattha <b>ubho kūlesū</b>ti tassā nadiyā ubhosu passesu dhuva <b>pupphino</b> dhuva <b>phalino</b> rukkhā <b>ubhato abhilambantā</b> nadiyā ubho tīre heṭṭhā onamantā mama assamaṃ sobhayantīti attho."],"lineRefs":[["tha-ap547:4"]]},{"para":1481,"vripara":"147","refs":["tha-ap547:5"],"lines":["“Ambā sālā ca tilakā, pāṭalī sinduvārakā;"],"lineRefs":[["tha-ap547:5"]]},{"para":1482,"vripara":null,"refs":["tha-ap547:5"],"lines":["Dibbagandhā sampavanti, pupphitā mama assame”."],"lineRefs":[["tha-ap547:5"]]},{"para":1483,"vripara":null,"refs":["tha-ap547:5"],"lines":["Tattha <b>ambā</b>ti madhupiṇḍiambā ca <b>sāla</b> rukkhā ca <b>tilaka</b> rukkhā ca <b>pāṭali</b> rukkhā ca <b>sinduvāraka</b> rukkhā ca ete rukkhā niccakālaṃ <b>pupphitā</b> pupphantā.","Dibbā gandhā iva mama assame sugandhā <b>sampavanti</b> samantato pavāyantīti attho."],"lineRefs":[["tha-ap547:5"],["tha-ap547:5"]]},{"para":1485,"vripara":"148","refs":["tha-ap547:6"],"lines":["“Campakā saḷalā nīpā, nāgapunnāgaketakā;"],"lineRefs":[["tha-ap547:6"]]},{"para":1486,"vripara":null,"refs":["tha-ap547:6"],"lines":["Dibbagandhā sampavanti, pupphitā mama assame”."],"lineRefs":[["tha-ap547:6"]]},{"para":1487,"vripara":null,"refs":["tha-ap547:6"],"lines":["Tattha <b>campaka</b> rukkhā ca <b>saḷala</b> rukkhā ca suvaṇṇavaṭṭalasadisapupphā <b>nīpa</b> rukkhā ca <b>nāga</b> rukkhā ca <b>punnāga</b> rukkhā ca sugandhayantā <b>ketaka</b> rukkhā ca ete sabbe rukkhā dibbā gandhāriva mama assame <b>pupphitā</b> phullitā <b>sampavanti</b> sugandhaṃ suṭṭhu pavāyantīti attho."],"lineRefs":[["tha-ap547:6"]]},{"para":1489,"vripara":"149","refs":["tha-ap547:7"],"lines":["Asokā ca “adhimuttā asokā ca, bhaginīmālā ca pupphitā;"],"lineRefs":[["tha-ap547:7"]]},{"para":1490,"vripara":null,"refs":["tha-ap547:7"],"lines":["Aṅkolā bimbijālā ca, pupphitā mama assame”."],"lineRefs":[["tha-ap547:7"]]},{"para":1491,"vripara":null,"refs":["tha-ap547:7"],"lines":["Tattha pupphitā <b>adhimuttaka</b> rukkhā ca pupphitā <b>asoka</b> rukkhā ca pupphitā <b>bhaginīmālā ca</b> pupphitā <b>aṅkolā</b> ca pupphitā <b>bimbijālā</b> ca ete rukkhā mama assame phullitā sobhayantīti sambandho."],"lineRefs":[["tha-ap547:7"]]},{"para":1493,"vripara":"150","refs":["tha-ap547:8"],"lines":["“Ketakā kandali ceva, godhukā tiṇasūlikā;"],"lineRefs":[["tha-ap547:8"]]},{"para":1494,"vripara":null,"refs":["tha-ap547:8"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap547:8"]]},{"para":1495,"vripara":null,"refs":["tha-ap547:8"],"lines":["Tattha <b>ketakā</b>ti sugandhaketakagacchā ca.","<b>Kandali</b> rukkhā ca <b>godhuka</b> rukkhā ca <b>tiṇasūlika</b> gacchā ca ete sabbe rukkhajātikā dibbagandhaṃ pavāyamānā mama assamaṃ sakalaṃ sobhayantīti attho."],"lineRefs":[["tha-ap547:8"],["tha-ap547:8"]]},{"para":1497,"vripara":"151","refs":["tha-ap547:9"],"lines":["“Kaṇikārā kaṇṇikā ca, asanā ajjunā bahū;"],"lineRefs":[["tha-ap547:9"]]},{"para":1498,"vripara":null,"refs":["tha-ap547:9"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap547:9"]]},{"para":1499,"vripara":null,"refs":["tha-ap547:9"],"lines":["Ete kaṇikārādayo rukkhā mama assamaṃ sakalaṃ sobhayantā dibbagandhaṃ sampavāyantīti sambandho."],"lineRefs":[["tha-ap547:9"]]},{"para":1501,"vripara":"152","refs":["tha-ap547:10"],"lines":["“Punnāgā giripunnāgā, koviḷārā ca pupphitā;"],"lineRefs":[["tha-ap547:10"]]},{"para":1502,"vripara":null,"refs":["tha-ap547:10"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap547:10"]]},{"para":1503,"vripara":null,"refs":["tha-ap547:10"],"lines":["Punnāgādayo rukkhā dibbagandhaṃ pavāyamānā mama assamaṃ sobhayantīti attho."],"lineRefs":[["tha-ap547:10"]]},{"para":1505,"vripara":"153","refs":["tha-ap547:11"],"lines":["“Uddālakā ca kuṭajā, kadambā vakulā bahū;"],"lineRefs":[["tha-ap547:11"]]},{"para":1506,"vripara":null,"refs":["tha-ap547:11"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap547:11"]]},{"para":1507,"vripara":null,"refs":["tha-ap547:11"],"lines":["Uddālakādayo rukkhā dibbagandhaṃ vāyamānā mama assamaṃ sobhayantīti sambandho."],"lineRefs":[["tha-ap547:11"]]},{"para":1509,"vripara":"154","refs":["tha-ap547:12"],"lines":["“Āḷakā isimuggā ca, kadalimātuluṅgiyo;"],"lineRefs":[["tha-ap547:12"]]},{"para":1510,"vripara":null,"refs":["tha-ap547:12"],"lines":["Gandhodakena saṃvaḍḍhā, phalāni dhārayanti te”."],"lineRefs":[["tha-ap547:12"]]},{"para":1511,"vripara":null,"refs":["tha-ap547:12"],"lines":["Tattha ete āḷakādayo gacchā candanādisugandhagandhodakena vaḍḍhitvā suvaṇṇaphalāni dhārentā mama assamaṃ sobhayantīti attho."],"lineRefs":[["tha-ap547:12"]]},{"para":1513,"vripara":"155","refs":["tha-ap547:13"],"lines":["“Aññe pupphanti padumā, aññe jāyanti kesarī;"],"lineRefs":[["tha-ap547:13"]]},{"para":1514,"vripara":null,"refs":["tha-ap547:13"],"lines":["Aññe opupphā padumā, pupphitā taḷāke tadā”."],"lineRefs":[["tha-ap547:13"]]},{"para":1515,"vripara":null,"refs":["tha-ap547:13"],"lines":["Tattha <b>aññe pupphanti padumā</b>ti mama assamassa avidūre taḷāke aññe ekacce padumā pupphanti, ekacce <b>kesarī</b> padumā <b>jāyanti</b> nibbattanti, ekacce padumā <b>opupphā</b> vigalitapattakesarāti attho."],"lineRefs":[["tha-ap547:13"]]},{"para":1517,"vripara":"156","refs":["tha-ap547:14"],"lines":["“Gabbhaṃ gaṇhanti padumā, niddhāvanti muḷāliyo;"],"lineRefs":[["tha-ap547:14"]]},{"para":1518,"vripara":null,"refs":["tha-ap547:14"],"lines":["Siṅghāṭipattamākiṇṇā, sobhanti taḷāke tadā”."],"lineRefs":[["tha-ap547:14"]]},{"para":1519,"vripara":null,"refs":["tha-ap547:14"],"lines":["Tattha <b>gabbhaṃ gaṇhanti padumā</b>ti tadā tāpasena hutvā mama vasanasamaye ekacce padumā taḷākabbhantare makuḷapupphādayo gaṇhanti.","<b>Muḷāliyo</b> padumamūlā <b>niddhāvanti</b> ito kaddamabbhantarato hatthidāṭhā viya gacchantīti attho.","Pattapupphamākiṇṇā gahanībhūtā siṅghāṭiyo sobhayantīti attho."],"lineRefs":[["tha-ap547:14"],["tha-ap547:14"],["tha-ap547:14"]]},{"para":1521,"vripara":"157","refs":["tha-ap547:15"],"lines":["“Nayitā ambagandhī ca, uttalī bandhujīvakā;"],"lineRefs":[["tha-ap547:15"]]},{"para":1522,"vripara":null,"refs":["tha-ap547:15"],"lines":["Dibbagandhā sampavanti, pupphitā taḷāke tadā”."],"lineRefs":[["tha-ap547:15"]]},{"para":1523,"vripara":null,"refs":["tha-ap547:15"],"lines":["<b>Tadā</b> mama vasanasamaye taḷākassa samīpe <b>nayitā</b> ca gacchā <b>ambagandhī ca</b> gacchā <b>uttalī</b> nāma gacchā ca <b>bandhujīvakā</b> ca ete sabbe gacchā <b>pupphitā</b> pupphadhāritā sugandhavāhakā taḷākaṃ sobhayantīti attho."],"lineRefs":[["tha-ap547:15"]]},{"para":1525,"vripara":"158","refs":["tha-ap547:16"],"lines":["“Pāṭhīnā pāvusā macchā, balajā muñjarohitā;"],"lineRefs":[["tha-ap547:16"]]},{"para":1526,"vripara":null,"refs":["tha-ap547:16"],"lines":["Saṃgulā maggurā ceva, vasanti taḷāke tadā”."],"lineRefs":[["tha-ap547:16"]]},{"para":1527,"vripara":null,"refs":["tha-ap547:16"],"lines":["<b>Tadā</b> mama vasanasamaye nibbhītā pāṭhīnādayo macchā <b>taḷāke</b> vasantīti sambandho."],"lineRefs":[["tha-ap547:16"]]},{"para":1529,"vripara":"159","refs":["tha-ap547:17"],"lines":["“Kumbhīlā susumārā ca, tantigāhā ca rakkhasā;"],"lineRefs":[["tha-ap547:17"]]},{"para":1530,"vripara":null,"refs":["tha-ap547:17"],"lines":["Oguhā ajagarā ca, vasanti taḷāke tadā”."],"lineRefs":[["tha-ap547:17"]]},{"para":1531,"vripara":null,"refs":["tha-ap547:17"],"lines":["<b>Tadā</b> mama vasanasamaye mama assamasamīpe <b>taḷāke</b> ete kumbhīlādayo macchā nibbhītā nirūpaddavā vasantīti sambandho."],"lineRefs":[["tha-ap547:17"]]},{"para":1533,"vripara":"160","refs":["tha-ap547:18"],"lines":["“Pārevatā ravihaṃsā, cakkavākā nadīcarā;"],"lineRefs":[["tha-ap547:18"]]},{"para":1534,"vripara":null,"refs":["tha-ap547:18"],"lines":["Kokilā sukasāḷikā, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap547:18"]]},{"para":1535,"vripara":null,"refs":["tha-ap547:18"],"lines":["Tattha mama assamasamīpe saraṃ nissāya <b>pārevatā</b> pakkhī ca <b>ravihaṃsā</b> pakkhī ca <b>nadīcarā cakkavāka</b> pakkhī ca <b>kokilā</b> pakkhī ca <b>suka</b> pakkhī ca <b>sāḷikā</b> pakkhī ca taṃ saraṃ upanissāya jīvantīti sambandho."],"lineRefs":[["tha-ap547:18"]]},{"para":1537,"vripara":"161","refs":["tha-ap547:19"],"lines":["“Kukutthakā kuḷīrakā, vane pokkharasātakā;"],"lineRefs":[["tha-ap547:19"]]},{"para":1538,"vripara":null,"refs":["tha-ap547:19"],"lines":["Dindibhā suvapotā ca, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap547:19"]]},{"para":1539,"vripara":null,"refs":["tha-ap547:19"],"lines":["Tattha <b>kukutthakā</b>ti evaṃnāmikā pakkhī ca.","<b>Kuḷīrakā</b>ti evaṃnāmikā pakkhī ca.","Vane <b>pokkharasātakā</b> pakkhī ca <b>dindibhā</b> pakkhī ca <b>suvapotā</b> pakkhī ca ete sabbe pakkhino taṃ mama assamasamīpe saraṃ nissāya jīvantīti sambandho."],"lineRefs":[["tha-ap547:19"],["tha-ap547:19"],["tha-ap547:19"]]},{"para":1541,"vripara":"162","refs":["tha-ap547:20"],"lines":["“Haṃsā koñcā mayūrā ca, kokilā tambacūḷakā;"],"lineRefs":[["tha-ap547:20"]]},{"para":1542,"vripara":null,"refs":["tha-ap547:20"],"lines":["Pammakā jīvaṃjīvā ca, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap547:20"]]},{"para":1543,"vripara":null,"refs":["tha-ap547:20"],"lines":["Sabbe ete haṃsādayo pakkhino taṃ saraṃ upanissāya jīvanti jīvikaṃ pālentīti attho."],"lineRefs":[["tha-ap547:20"]]},{"para":1545,"vripara":"163","refs":["tha-ap547:21"],"lines":["“Kosikā poṭṭhasīsā ca, kurarā senakā bahū;"],"lineRefs":[["tha-ap547:21"]]},{"para":1546,"vripara":null,"refs":["tha-ap547:21"],"lines":["Mahākāḷā ca sakuṇā, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap547:21"]]},{"para":1547,"vripara":null,"refs":["tha-ap547:21"],"lines":["Tattha <b>kosikā</b> ca pakkhī <b>poṭṭhasīsā</b> ca pakkhī <b>kurarā</b> ca pakkhī <b>senakā</b> ca pakkhī <b>mahākāḷā</b> ca pakkhī thale <b>bahū</b> pakkhino taṃ saraṃ tassa sarassa samīpe <b>jīvanti</b> jīvikaṃ kappentīti attho."],"lineRefs":[["tha-ap547:21"]]},{"para":1549,"vripara":"164","refs":["tha-ap547:22"],"lines":["“Pasadā ca varāhā ca, camarā gaṇḍakā bahū;"],"lineRefs":[["tha-ap547:22"]]}],"wordLinks":[]},"tika":null,"tika2":null}
