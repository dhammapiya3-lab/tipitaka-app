{"suttaId":"vv81","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2886,2969],"vripara":"1171"},"segments":{"vv81:0.4":"Kaṇḍakavimānavatthu","vv81:1.1":"“Puṇṇamāse yathā cando,","vv81:1.2":"nakkhattaparivārito;","vv81:1.3":"Samantā anupariyāti,","vv81:1.4":"tārakādhipatī sasī.","vv81:2.1":"“Tathūpamaṃ idaṃ byamhaṃ,","vv81:2.2":"dibbaṃ devapuramhi ca;","vv81:2.3":"Atirocati vaṇṇena,","vv81:2.4":"udayantova raṃsimā.","vv81:3.1":"“Veḷuriyasuvaṇṇassa,","vv81:3.2":"phalikā rūpiyassa ca;","vv81:3.3":"Masāragallamuttāhi,","vv81:3.4":"lohitaṅgamaṇīhi ca.","vv81:4.1":"“Citrā manoramā bhūmi,","vv81:4.2":"veḷūriyassa santhatā;","vv81:4.3":"Kūṭāgārā subhā rammā,","vv81:4.4":"pāsādo te sumāpito.","vv81:5.1":"“Rammā ca te pokkharaṇī,","vv81:5.2":"puthulomanisevitā;","vv81:5.3":"Acchodakā vippasannā,","vv81:5.4":"sovaṇṇavālukasanthatā.","vv81:6.1":"“Nānāpadumasañchannā,","vv81:6.2":"puṇḍarīkasamotatā [samotthatā (ka.), samogatā (syā.)];","vv81:6.3":"Surabhiṃ sampavāyanti,","vv81:6.4":"manuññā māluteritā.","vv81:7.1":"“Tassā te ubhato passe,","vv81:7.2":"vanagumbā sumāpitā;","vv81:7.3":"Upetā puppharukkhehi,","vv81:7.4":"phalarukkhehi cūbhayaṃ.","vv81:8.1":"“Sovaṇṇapāde pallaṅke,","vv81:8.2":"muduke goṇakatthate [colasanthate (sī.)];","vv81:8.3":"Nisinnaṃ devarājaṃva,","vv81:8.4":"upatiṭṭhanti accharā.","vv81:9.1":"“Sabbābharaṇasañchannā,","vv81:9.2":"nānāmālāvibhūsitā;","vv81:9.3":"Ramenti taṃ mahiddhikaṃ,","vv81:9.4":"vasavattīva modasi.","vv81:10.1":"“Bherisaṅkhamudiṅgāhi,","vv81:10.2":"vīṇāhi paṇavehi ca;","vv81:10.3":"Ramasi ratisampanno,","vv81:10.4":"naccagīte suvādite.","vv81:11.1":"“Dibbā te vividhā rūpā,","vv81:11.2":"dibbā saddā atho rasā;","vv81:11.3":"Gandhā ca te adhippetā,","vv81:11.4":"phoṭṭhabbā ca manoramā.","vv81:12.1":"“Tasmiṃ vimāne pavare,","vv81:12.2":"devaputta mahappabho;","vv81:12.3":"Atirocasi vaṇṇena,","vv81:12.4":"udayantova bhāṇumā.","vv81:13.1":"“Dānassa te idaṃ phalaṃ,","vv81:13.2":"atho sīlassa vā pana;","vv81:13.3":"Atho añjalikammassa,","vv81:13.4":"taṃ me akkhāhi pucchito”.","vv81:14.1":"So devaputto attamano … pe …","vv81:14.3":"yassa kammassidaṃ phalaṃ.","vv81:15.1":"“Ahaṃ kapilavatthusmiṃ,","vv81:15.2":"sākiyānaṃ puruttame;","vv81:15.3":"Suddhodanassa puttassa,","vv81:15.4":"kaṇḍako sahajo ahaṃ.","vv81:16.1":"“Yadā so aḍḍharattāyaṃ,","vv81:16.2":"bodhāya mabhinikkhami;","vv81:16.3":"So maṃ mudūhi pāṇīhi,","vv81:16.4":"jāli [jāla (sī.)] tambanakhehi ca.","vv81:17.1":"“Satthiṃ ākoṭayitvāna,","vv81:17.2":"vaha sammāti cabravi;","vv81:17.3":"Ahaṃ lokaṃ tārayissaṃ,","vv81:17.4":"patto sambodhimuttamaṃ.","vv81:18.1":"“Taṃ me giraṃ suṇantassa,","vv81:18.2":"hāso me vipulo ahu;","vv81:18.3":"Udaggacitto sumano,","vv81:18.4":"abhisīsiṃ [abhisiṃsiṃ (sī.), abhisīsi (pī.)] tadā ahaṃ.","vv81:19.1":"“Abhirūḷhañca maṃ ñatvā,","vv81:19.2":"sakyaputtaṃ mahāyasaṃ;","vv81:19.3":"Udaggacitto mudito,","vv81:19.4":"vahissaṃ purisuttamaṃ.","vv81:20.1":"“Paresaṃ vijitaṃ gantvā,","vv81:20.2":"uggatasmiṃ divākare [divaṅkare (syā. ka.)];","vv81:20.3":"Mamaṃ channañca ohāya,","vv81:20.4":"anapekkho so apakkami.","vv81:21.1":"“Tassa tambanakhe pāde,","vv81:21.2":"jivhāya parilehisaṃ;","vv81:21.3":"Gacchantañca mahāvīraṃ,","vv81:21.4":"rudamāno udikkhisaṃ.","vv81:22.1":"“Adassanenahaṃ tassa,","vv81:22.2":"sakyaputtassa sirīmato;","vv81:22.3":"Alatthaṃ garukābādhaṃ,","vv81:22.4":"khippaṃ me maraṇaṃ ahu.","vv81:23.1":"“Tasseva ānubhāvena,","vv81:23.2":"vimānaṃ āvasāmidaṃ;","vv81:23.3":"Sabbakāmaguṇopetaṃ,","vv81:23.4":"dibbaṃ devapuramhi ca.","vv81:24.1":"“Yañca me ahuvā hāso,","vv81:24.2":"saddaṃ sutvāna bodhiyā;","vv81:24.3":"Teneva kusalamūlena,","vv81:24.4":"phusissaṃ āsavakkhayaṃ.","vv81:25.1":"“Sace hi bhante gaccheyyāsi,","vv81:25.2":"satthu buddhassa santike;","vv81:25.3":"Mamāpi naṃ vacanena,","vv81:25.4":"sirasā vajjāsi vandanaṃ.","vv81:26.1":"“Ahampi daṭṭhuṃ gacchissaṃ,","vv81:26.2":"jinaṃ appaṭipuggalaṃ;","vv81:26.3":"Dullabhaṃ dassanaṃ hoti,","vv81:26.4":"lokanāthāna tādinan”ti.","vv81:27.1":"So kataññū katavedī,","vv81:27.2":"satthāraṃ upasaṅkami;","vv81:27.3":"Sutvā giraṃ cakkhumato,","vv81:27.4":"dhammacakkhuṃ visodhayi.","vv81:28.1":"Visodhetvā diṭṭhigataṃ,","vv81:28.2":"vicikicchaṃ vatāni ca;","vv81:28.3":"Vanditvā satthuno pāde,","vv81:28.4":"tatthevantaradhāyathāti [tatthevantaradhāyatīti (ka.)].","vv81:29.1":"Kaṇḍakavimānaṃ sattamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3542,"to":3567,"paras":[{"para":3542,"vripara":"1171","refs":["vv81:1"],"lines":["Tattha <b>puṇṇamāse</b>ti puṇṇamāsiyaṃ sukkapakkhe pannarasiyaṃ.","<b>Tārakādhipatī</b>ti tārakānaṃ adhipati.","<b>Sasī</b>ti sasalañchanavā.","“Tārakādhipa dissatī”ti keci paṭhanti, tesaṃ tārakādhipāti avibhattikaniddeso, tārakānaṃ adhipo hutvā dissati anupariyāti cāti yojanā kātabbā."],"lineRefs":[["vv81:1"],["vv81:1"],["vv81:1"],["vv81:1"]]},{"para":3543,"vripara":"1172","refs":["vv81:2"],"lines":["<b>Dibbaṃ devapuramhi cā</b>ti devapurasmimpi dibbaṃ.","Yathā manussānaṃ ṭhānato devapuraṃ uttamaṃ, evaṃ devapurato cāpi idaṃ tava vimānaṃ uttamanti dasseti.","Tenāha <b>“atirocati vaṇṇena, udayantova raṃsimā”</b>ti, uggacchanto sūriyo viyāti attho."],"lineRefs":[["vv81:2"],["vv81:2"],["vv81:2"]]},{"para":3544,"vripara":"1173","refs":["vv81:2","vv81:3"],"lines":["<b>Veḷūriyasuvaṇṇassā</b>ti veḷuriyena suvaṇṇena ca idaṃ byamhaṃ nimmitanti vacanasesena yojanā.","<b>Phalikā</b>ti phalikamaṇinā."],"lineRefs":[["vv81:2"],["vv81:3"]]},{"para":3545,"vripara":"1175","refs":["vv81:5"],"lines":["<b>Pokkharaṇī</b>ti pokkharaṇiyo."],"lineRefs":[["vv81:5"]]},{"para":3546,"vripara":"1177-1178","refs":["vv81:7"],"lines":["1177-8. <b>Tassā</b>ti tassā pokkharaṇiyā.","<b>Vanagumbā</b>ti uyyāne supupphagacche sandhāya vadati.","<b>Devarājaṃvā</b>ti sakkaṃ viya.","<b>Upatiṭṭhantī</b>ti upaṭṭhānaṃ karonti."],"lineRefs":[["vv81:7"],["vv81:7"],["vv81:7"],["vv81:7"]]},{"para":3547,"vripara":"1179","refs":["vv81:9"],"lines":["<b>Sabbābharaṇasañchannā</b>ti sabbehi itthālaṅkārehi paṭicchāditā, sabbaso vibhūsitasarīrāti attho.","<b>Vasavattīvā</b>ti vasavattidevarājā viya."],"lineRefs":[["vv81:9"],["vv81:9"]]},{"para":3548,"vripara":"1180","refs":["vv81:10"],"lines":["<b>Bherisaṅkhamudiṅgāhī</b>ti liṅgavipallāsena vuttaṃ, bherīhi ca saṅkhehi ca mudiṅgehi cāti yojanā.","<b>Ratisampanno</b>ti dibbāya ratiyā samaṅgībhūto.","<b>Naccagīte suvādite</b>ti nacce ca gīte ca sundare vādite ca, naccane ca gāyane ca sundare vādite ca hetubhūte.","Nimittatthe hi etaṃ bhummaṃ, pavattiteti vā vacanaseso."],"lineRefs":[["vv81:10"],["vv81:10"],["vv81:10"],["vv81:10"]]},{"para":3549,"vripara":"1181","refs":["vv81:11"],"lines":["<b>Dibbā te vividhā rūpā</b>ti devalokapariyāpannā nānappakārā cakkhuviññeyyā rūpā tuyhaṃ adhippetā yathādhippetā manoramā vijjantīti kiriyāpadaṃ ānetvā yojetabbaṃ.","<b>Dibbā saddā</b>tiādīsupi eseva nayo."],"lineRefs":[["vv81:11"],["vv81:11"]]},{"para":3550,"vripara":"1185","refs":["vv81:15"],"lines":["<b>Kaṇḍako sahajo ahan</b>ti ettha <b>ahan</b>ti nipātamattaṃ.","“Ahū”ti keci paṭṭhanti, kaṇḍako nāma assarājā mahāsattena saha ekasmiṃyeva divase jātattā sahajo ahosinti attho."],"lineRefs":[["vv81:15"],["vv81:15"]]},{"para":3551,"vripara":"1186","refs":["vv81:16"],"lines":["<b>Aḍḍharattāyan</b>ti aḍḍharattiyaṃ, majjhimayāmasamayeti attho.","<b>Bodhāya mabhinikkhamī</b>ti ma-kāro padasandhikaro, abhisambodhiatthaṃ mahābhinikkhamanaṃ nikkhamīti attho.","<b>Mudūhi pāṇīhī</b>ti muduhatthataṃ mahāpurisalakkhaṇaṃ vadati.","<b>Jālitambanakhehī</b>ti jālavantehi abhilohitanakhehi.","Tena jālahatthataṃ mahāpurisalakkhaṇaṃ tambanakhataṃ anubyañjanañca dasseti."],"lineRefs":[["vv81:16"],["vv81:16"],["vv81:16"],["vv81:16"],["vv81:16"]]},{"para":3552,"vripara":"1187","refs":["vv81:17"],"lines":["<b>Satthi</b> nāma jaṅghā, idha pana satthino āsannaṭṭhānabhūto ūruppadeso “satthī”ti vutto.","<b>Ākoṭayitvānā</b>ti appoṭhetvā.","<b>“Vaha sammā”ti cabravī</b>ti “samma kaṇḍaka, ajjekarattiṃ maṃ vaha, mayhaṃ opavuyhaṃ hohī”ti ca kathesi.","Vahane pana payojanaṃ tadā mahāsattena dassitaṃ vadanto <b>“ahaṃ lokaṃ tārayissaṃ, patto sambodhimuttaman”</b>ti āha.","Tena “ahaṃ uttamaṃ anuttaraṃ sammāsambodhiṃ patto adhigato hutvā sadevakaṃ lokaṃ saṃsāramahoghato tārayissāmi, tasmā nayidaṃ gamanaṃ yaṃkiñcīti cinteyyāsī”ti gamane payojanassa anuttarabhāvaṃ dasseti."],"lineRefs":[["vv81:17"],["vv81:17"],["vv81:17"],["vv81:17"],["vv81:17"]]},{"para":3553,"vripara":"1188-1189","refs":["vv81:18"],"lines":["1188-9. <b>Hāso</b>ti tuṭṭhi.","<b>Vipulo</b>ti mahāuḷāro.","<b>Abhisīsin</b>ti āsisiṃ icchiṃ sampaṭicchiṃ.","<b>Abhirūḷhañca maṃ ñatvā, sakyaputtaṃ mahāyasan</b>ti patthaṭavipulayasaṃ sakyarājaputtaṃ mahāsattaṃ maṃ abhiruyha nisinnaṃ jānitvā.","<b>Vahissan</b>ti nesiṃ."],"lineRefs":[["vv81:18"],["vv81:18"],["vv81:18"],["vv81:18"],["vv81:18"]]},{"para":3554,"vripara":"1190-1191","refs":["vv81:20"],"lines":["1190-91. <b>Paresan</b>ti pararājūnaṃ.","<b>Vijitan</b>ti desaṃ pararajjaṃ.","<b>Ohāyā</b>ti vissajjitvā.","<b>Apakkamī</b>ti apakkamituṃ ārabhi.","“Paribbajī”ti ca paṭhanti.","<b>Parilehisan</b>ti parito lehiṃ.","<b>Udikkhisan</b>ti olokesiṃ."],"lineRefs":[["vv81:20"],["vv81:20"],["vv81:20"],["vv81:20"],["vv81:20"],["vv81:20"],["vv81:20"]]},{"para":3555,"vripara":"1192-1193","refs":["vv81:22"],"lines":["1192-3. <b>Garukābādhan</b>ti garukaṃ bāḷhaṃ ābādhaṃ, maraṇantikaṃ dukkhanti attho.","Tenāha <b>“khippaṃ me maraṇaṃ ahū”</b>ti.","So hi anekāsu jātīsu mahāsattena daḷhabhattiko hutvā āgato, tasmā viyogadukkhaṃ sahituṃ nāsakkhi,“sammāsambodhiṃ adhigantuṃ nikkhanto”ti pana sutvā nirāmisaṃ uḷāraṃ pītisomanassañca uppajji, tena maraṇānantaraṃ tāvatiṃsesu nibbatti, uḷārā cassa dibbasampattiyo pāturahesuṃ.","Tena vuttaṃ <b>“tasseva ānubhāvenā”</b>ti, ṭhānagatassa pasādamayapuññassa balena.","<b>Devo devapuramhivā</b>ti tāvatiṃsabhavane sakko devarājā viya."],"lineRefs":[["vv81:22"],["vv81:22"],["vv81:22"],["vv81:22"],["vv81:22"]]},{"para":3556,"vripara":"1194","refs":["vv81:24"],"lines":["<b>Yañca me ahuvā hāso, saddaṃ sutvāna bodhiyā</b>ti “patto sambodhimuttaman”ti paṭhamataraṃ bodhisaddaṃ sutvā tadā mayhaṃ hāso ahu, yaṃ hāsassa bhavanaṃ sussanaṃ, <b>teneva kusalamūlena</b> teneva kusalabījena <b>phusissan</b>ti phusissāmi pāpuṇissāmi."],"lineRefs":[["vv81:24"]]},{"para":3557,"vripara":"1195","refs":["vv81:25"],"lines":["Evaṃ devaputto yathādhigatāya anāgatāya bhavasampattiyā kāraṇabhūtaṃ attano kusalakammaṃ kathento idāni attanā bhagavato santikaṃ gantukāmopi puretaraṃ therena satthu vandanaṃ pesento <b>“sace”</b>ti gāthamāha.","Tattha <b>sace gaccheyyāsī</b>ti yadi gamissasi.","“Sace gacchasī”ti keci paṭhanti, so evattho.","<b>Mamāpi naṃ vacanenā</b>ti na kevalaṃ tava sabhāveneva, atha kho mamāpi vacanena bhagavantaṃ.","<b>Vajjāsī</b>ti vadeyyāsi, mamāpi <b>sirasā vandanan</b>ti yojanā."],"lineRefs":[["vv81:25"],["vv81:25"],["vv81:25"],["vv81:25"],["vv81:25"]]},{"para":3558,"vripara":"1196","refs":["vv81:26"],"lines":["Yadipi dāni vandanañca pesemi, pesetvā eva pana na tiṭṭhāmīti dassento āha <b>“ahampi daṭṭhuṃ gacchissaṃ, jinaṃ appaṭipuggalan”</b>ti.","Gamane pana daḷhataraṃ kāraṇaṃ dassetuṃ <b>“dullabhaṃ dassanaṃ hoti, lokanāthāna tādinan”</b>ti āha."],"lineRefs":[["vv81:26"],["vv81:26"]]},{"para":3560,"vripara":"1197","refs":["vv81:26"],"lines":["“So kataññū katavedī, satthāraṃ upasaṅkami;"],"lineRefs":[["vv81:26"]]},{"para":3561,"vripara":null,"refs":["vv81:26"],"lines":["Sutvā giraṃ cakkhumato, dhammacakkhuṃ visodhayi."],"lineRefs":[["vv81:26"]]},{"para":3563,"vripara":"1198","refs":["vv81:26"],"lines":["“Visodhetvā diṭṭhigataṃ, vicikicchaṃ vatāni ca;"],"lineRefs":[["vv81:26"]]},{"para":3564,"vripara":null,"refs":["vv81:26"],"lines":["Vanditvā satthuno pāde, tatthevantaradhāyathā”ti.","–"],"lineRefs":[["vv81:26"],["vv81:26"]]},{"para":3565,"vripara":null,"refs":["vv81:26"],"lines":["Imā dve gāthā saṅgītikārehi ṭhapitā."],"lineRefs":[["vv81:26"]]},{"para":3566,"vripara":"1197","refs":["vv81:27"],"lines":["Tattha <b>sutvā giraṃ cakkhumato</b>ti pañcahi cakkhūhi cakkhumato sammāsambuddhassa vacanaṃ sutvā.","<b>Dhammacakkhun</b>ti sotāpattimaggaṃ.","<b>Visodhayī</b>ti adhigacchi.","Adhigamoyeva hi tassa visodhanaṃ."],"lineRefs":[["vv81:27"],["vv81:27"],["vv81:27"],["vv81:27"]]},{"para":3567,"vripara":"1198","refs":["vv81:28"],"lines":["<b>Visodhetvā diṭṭhigatan</b>ti diṭṭhigataṃ samugghātetvā.","<b>Vicikicchaṃ vatāni cā</b>ti soḷasavatthukaṃ aṭṭhavatthukañca vicikicchañca “sīlabbatehi suddhī”ti pavattanakasīlabbataparāmāse ca visodhayīti yojanā.","Tattha hi saha pariyāyehi tathā pavattā parāmāsā “vatānī”ti vuttaṃ.","Sesaṃ vuttanayameva."],"lineRefs":[["vv81:28"],["vv81:28"],["vv81:28"],["vv81:28"]]}],"wordLinks":[["vv81:1.1","puṇṇamāse",0,0],["vv81:1.3","tārakādhipatī",0,1],["vv81:1.3","sasī",0,2],["vv81:2.1","dibbaṃ devapuramhi cā",1,0],["vv81:2.3","atirocati vaṇṇena udayantova raṃsimā",1,2],["vv81:3.1","phalikā",2,1],["vv81:5.1","pokkharaṇī",3,0],["vv81:7.1","tassā",4,0],["vv81:7.1","vanagumbā",4,1],["vv81:9.1","sabbābharaṇasañchannā",5,0],["vv81:9.3","vasavattīvā",5,1],["vv81:10.1","bherisaṅkhamudiṅgāhī",6,0],["vv81:10.3","ratisampanno",6,1],["vv81:10.3","naccagīte suvādite",6,2],["vv81:11.1","dibbā te vividhā rūpā",7,0],["vv81:11.1","dibbā saddā",7,1],["vv81:15.1","ahaṃ",8,0],["vv81:15.3","ahaṃ",8,0],["vv81:15.3","kaṇḍako sahajo ahaṃ",8,0],["vv81:16.1","aḍḍharattāyaṃ",9,0],["vv81:16.1","bodhāya mabhinikkhamī",9,1],["vv81:16.3","mudūhi pāṇīhī",9,2],["vv81:16.3","jālitambanakhehī",9,3],["vv81:17.1","satthi",10,0],["vv81:17.1","ākoṭayitvānā",10,1],["vv81:17.1","vaha sammā ti cabravī",10,2],["vv81:17.3","ahaṃ lokaṃ tārayissaṃ patto sambodhimuttamaṃ",10,3],["vv81:18.1","hāso",11,0],["vv81:18.1","vipulo",11,1],["vv81:18.3","abhisīsiṃ",11,2],["vv81:20.1","paresaṃ",12,0],["vv81:20.1","vijitaṃ",12,1],["vv81:20.3","ohāyā",12,2],["vv81:20.3","apakkamī",12,3],["vv81:22.3","garukābādhaṃ",13,0],["vv81:22.3","khippaṃ me maraṇaṃ ahū",13,1],["vv81:24.1","yañca me ahuvā hāso saddaṃ sutvāna bodhiyā",14,0],["vv81:24.3","phusissaṃ",14,0],["vv81:24.3","teneva kusalamūlena",14,0],["vv81:25.1","sace",15,0],["vv81:25.3","mamāpi naṃ vacanenā",15,3],["vv81:25.3","vajjāsī",15,4],["vv81:26.1","ahampi daṭṭhuṃ gacchissaṃ jinaṃ appaṭipuggalaṃ",16,0],["vv81:26.3","dullabhaṃ dassanaṃ hoti lokanāthāna tādinaṃ",16,1],["vv81:27.3","sutvā giraṃ cakkhumato",22,0],["vv81:27.3","dhammacakkhuṃ",22,1],["vv81:27.3","visodhayī",22,2],["vv81:28.1","visodhetvā diṭṭhigataṃ",23,0],["vv81:28.1","vicikicchaṃ vatāni cā",23,1]],"before":[{"para":3460,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Kaṇḍakavimānavaṇṇanā"]},{"para":3461,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["<b>Puṇṇamāse yathā cando</b>ti kaṇḍakavimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tena ca samayena āyasmā mahāmoggallāno heṭṭhā vuttanayeneva devacārikaṃ caranto tāvatiṃsabhavanaṃ gato.","Tasmiṃ khaṇe kaṇḍako devaputto sakabhavanato nikkhamitvā dibbayānaṃ abhiruhitvā mahantena parivārena mahatiyā deviddhiyā uyyānaṃ gacchanto āyasmantaṃ mahāmoggallānaṃ disvā sañjātagāravabahumāno sahasā yānato oruyha theraṃ upasaṅkamitvā pañcapatiṭṭhitena vanditvā sirasmiṃ añjaliṃ paggayha aṭṭhāsi.","Atha naṃ thero –"]},{"para":3463,"vripara":"1171","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Puṇṇamāse yathā cando, nakkhattaparivārito;"]},{"para":3464,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Samantā anupariyāti, tārakādhipatī sasī."]},{"para":3466,"vripara":"1172","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Tathūpamaṃ idaṃ byamhaṃ, dibbaṃ devapuramhi ca;"]},{"para":3467,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Atirocati vaṇṇena, udayantova raṃsimā."]},{"para":3469,"vripara":"1173","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Veḷūriyasuvaṇṇassa, phalikā rūpiyassa ca;"]},{"para":3470,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Masāragallamuttāhi, lohitaṅgamaṇīhi ca."]},{"para":3472,"vripara":"1174","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Citrā manoramā bhūmi, veḷūriyassa santhatā;"]},{"para":3473,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Kūṭāgārā subhā rammā, pāsādo te sumāpito."]},{"para":3475,"vripara":"1175","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Rammā ca te pokkharaṇī, puthulomanisevitā;"]},{"para":3476,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Acchodakā vippasannā, soṇṇavālukasanthatā."]},{"para":3478,"vripara":"1176","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Nānāpadumasañchannā, puṇḍarīkasamotatā;"]},{"para":3479,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Surabhiṃ sampavāyanti, manuññā mātuteritā."]},{"para":3481,"vripara":"1177","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Tassā te ubhato passe, vanagumbā sumāpitā;"]},{"para":3482,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Upetā puppharukkhehi, phalarukkhehi cūbhayaṃ."]},{"para":3484,"vripara":"1178","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Sovaṇṇapāde pallaṅke, muduke gonakatthate;"]},{"para":3485,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Nisinnaṃ devarājaṃva, upatiṭṭhanti accharā."]},{"para":3487,"vripara":"1179","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Sabbābharaṇasañchannā, nānāmālāvibhūsitā;"]},{"para":3488,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Ramenti taṃ mahiddhikaṃ, vasavattīva modasi."]},{"para":3490,"vripara":"1180","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Bherisaṅkhamudiṅgāhi, vīṇāhi paṇavehi ca;"]},{"para":3491,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Ramasi ratisampanno, naccagīte suvādite."]},{"para":3493,"vripara":"1181","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Dibbā te vividhā rūpā, dibbā saddā atho rasā;"]},{"para":3494,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Gandhā ca te adhippetā, phoṭṭhabbā ca manoramā."]},{"para":3496,"vripara":"1182","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Tasmiṃ vimāne pavare, devaputta mahappabho;"]},{"para":3497,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Atirocasi vaṇṇena, udayantova bhāṇumā."]},{"para":3499,"vripara":"1183","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Dānassa te idaṃ phalaṃ, atho sīlassa vā pana;"]},{"para":3500,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Atho añjalikammassa, taṃ me akkhāhi pucchito”ti.","–"]},{"para":3501,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Adhigatasampattikittanamukhena katakammaṃ pucchi."]},{"para":3503,"vripara":"1184","title":"Kaṇḍakavimānavaṇṇanā","lines":["“So devaputto attamano, moggallānena pucchito;"]},{"para":3504,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Pañhaṃ puṭṭho viyākāsi, yassa kammassidaṃ phalaṃ”."]},{"para":3506,"vripara":"1185","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Ahaṃ kapilavatthusmiṃ, sākiyānaṃ puruttame;"]},{"para":3507,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Suddhodanassa puttassa, kaṇḍako sahajo ahaṃ."]},{"para":3509,"vripara":"1186","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Yadā so aḍḍharattāyaṃ, bodhāya mabhinikkhami;"]},{"para":3510,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["So maṃ mudūhi pāṇīhi, jālitambanakhehi ca."]},{"para":3512,"vripara":"1187","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Satthiṃ ākoṭayitvāna, vaha sammāti cabravi;"]},{"para":3513,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["‘Ahaṃ lokaṃ tārayissaṃ, patto sambodhimuttamaṃ’."]},{"para":3515,"vripara":"1188","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Taṃ me giraṃ suṇantassa, hāso me vipulo ahu;"]},{"para":3516,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Udaggacitto sumano, abhisīsiṃ tadā ahaṃ."]},{"para":3518,"vripara":"1189","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Abhirūḷhañca maṃ ñatvā, sakyaputtaṃ mahāyasaṃ;"]},{"para":3519,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Udaggacitto mudito, vahissaṃ purisuttamaṃ."]},{"para":3521,"vripara":"1190","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Paresaṃ vijitaṃ gantvā, uggatasmiṃ divākare;"]},{"para":3522,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Mamaṃ channañca ohāya, anapekkho so apakkami."]},{"para":3524,"vripara":"1191","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Tassa tambanakhe pāde, jivhāya parilehisaṃ;"]},{"para":3525,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Gacchantañca mahāvīraṃ, rudamāno udikkhisaṃ."]},{"para":3527,"vripara":"1192","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Adassanenahaṃ tassa, sakyaputtassa sirīmato;"]},{"para":3528,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Alatthaṃ garukābādhaṃ, khippaṃ me maraṇaṃ ahu."]},{"para":3530,"vripara":"1193","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Tasseva ānubhāvena, vimānaṃ āvasāmidaṃ;"]},{"para":3531,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Sabbakāmaguṇopetaṃ, devo devapuramhiva."]},{"para":3533,"vripara":"1194","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Yañca me ahuvā hāso, saddaṃ sutvāna bodhiyā;"]},{"para":3534,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Teneva kusalamūlena, phusissaṃ āsavakkhayaṃ."]},{"para":3536,"vripara":"1195","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Sace hi bhante gaccheyyāsi, satthu buddhassa santike;"]},{"para":3537,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Mamāpi naṃ vacanena, sirasā vajjāsi vandanaṃ."]},{"para":3539,"vripara":"1196","title":"Kaṇḍakavimānavaṇṇanā","lines":["“Ahampi daṭṭhuṃ gacchissaṃ, jinaṃ appaṭipuggalaṃ;"]},{"para":3540,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Dullabhaṃ dassanaṃ hoti, lokanāthāna tādinan”ti.","–"]},{"para":3541,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Sopi attanā katakammaṃ kathesi.","Ayañhi anantare attabhāve amhākaṃ bodhisattena sahajāto kaṇḍako assarājā ahosi.","So abhinikkhamanasamaye abhiruḷho teneva rattāvasesena tīṇi rajjāni mahāpurisaṃ atikkamāpetvā anomānadītīraṃ sampāpesi.","Atha so mahāsattena sūriye uggate ghaṭikāramahābrahmunā upanītāni pattacīvarāni gahetvā pabbajitvā channena saddhiṃ kapilavatthuṃ uddissa vissajjito.","Sinehabhārikena hadayena mahāpurisassa pāde attano jivhāya lehitvā pasādasommāni akkhīni ummīletvā yāva dassanapathā olokento dassanūpacāraṃ pana atikkante lokanāthe “evaṃvidhaṃ nāma lokagganāyakaṃ mahāpurisaṃ ahaṃ vahiṃ, saphalaṃ vata me sarīraṃ ahosī”ti pasannamānaso hutvā puna cirakālaṃ saṅgatassa pemassa vasena viyogadukkhaṃ asahanto bhāviniyā dibbasampattiyā vasena dhammatāya codiyamāno kālaṃ katvā tāvatiṃsabhavane nibbatti.","Taṃ sandhāya vuttaṃ <b>“puṇṇamāse yathā cando … pe … ahaṃ kapilavatthusmin”</b>tiādi."]}],"after":[{"para":3568,"vripara":null,"title":"Kaṇḍakavimānavaṇṇanā","lines":["Kaṇḍakavimānavaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
