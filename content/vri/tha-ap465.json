{"suttaId":"tha-ap465","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1335,1349],"vripara":"11"},"segments":{"tha-ap465:0.3":"Citakanibbāpakattheraapadānaṃ","tha-ap465:1.1":"“Dayhamāne sarīramhi,","tha-ap465:1.2":"vessabhussa mahesino;","tha-ap465:1.3":"Gandhodakaṃ gahetvāna,","tha-ap465:1.4":"citaṃ nibbāpayiṃ ahaṃ.","tha-ap465:2.1":"“Ekatiṃse ito kappe,","tha-ap465:2.2":"citaṃ nibbāpayiṃ ahaṃ;","tha-ap465:2.3":"Duggatiṃ nābhijānāmi,","tha-ap465:2.4":"gandhodakassidaṃ phalaṃ.","tha-ap465:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap465:3.3":"viharāmi anāsavo.","tha-ap465:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap465:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap465:5.1":"“Paṭisambhidā catasso … pe …","tha-ap465:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap465:6.1":"Itthaṃ sudaṃ āyasmā citakanibbāpako thero imā Gāthāyo abhāsitthāti.","tha-ap465:7.1":"Citakanibbāpakattherassāpadānaṃ tatiyaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
