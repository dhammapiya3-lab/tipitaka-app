{"suttaId":"vv75","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2725,2739],"vripara":"1114"},"segments":{"vv75:0.4":"Cittalatāvimānavatthu","vv75:1.1":"“Yathā vanaṃ cittalataṃ pabhāsati,","vv75:1.2":"uyyānaseṭṭhaṃ tidasānamuttamaṃ;","vv75:1.3":"Tathūpamaṃ tuyhamidaṃ vimānaṃ,","vv75:1.4":"obhāsayaṃ tiṭṭhati antalikkhe.","vv75:2.1":"“Deviddhipattosi mahānubhāvo,","vv75:2.2":"manussabhūto kimakāsi puññaṃ;","vv75:2.3":"Kenāsi evaṃ jalitānubhāvo,","vv75:2.4":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv75:3.1":"So devaputto attamano … pe …","vv75:3.3":"yassa kammassidaṃ phalaṃ.","vv75:4.1":"“Ahaṃ manussesu manussabhūto,","vv75:4.2":"daliddo atāṇo kapaṇo kammakaro ahosiṃ;","vv75:4.3":"Jiṇṇe ca mātāpitaro abhāriṃ [abhariṃ (sī. syā.)],","vv75:4.4":"piyā ca me sīlavanto ahesuṃ;","vv75:4.5":"Annañca pānañca pasannacitto,","vv75:4.6":"sakkacca dānaṃ vipulaṃ adāsi.","vv75:5.1":"“Tena metādiso vaṇṇo … pe …","vv75:5.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv75:6.1":"Cittalatāvimānaṃ paṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":3264,"to":3281,"paras":[{"para":3264,"vripara":"1114","refs":["vv75:1"],"lines":["“Yathā vanaṃ cittalataṃ pabhāsati, uyyānaseṭṭhaṃ tidasānamuttamaṃ;"],"lineRefs":[["vv75:1"]]},{"para":3265,"vripara":null,"refs":["vv75:1"],"lines":["Tathūpamaṃ tuyhamidaṃ vimānaṃ, obhāsayaṃ tiṭṭhati antalikkhe."],"lineRefs":[["vv75:1"]]},{"para":3267,"vripara":"1115","refs":["vv75:2"],"lines":["“Deviddhipattosi mahānubhāvo … pe …"],"lineRefs":[["vv75:2"]]},{"para":3268,"vripara":null,"refs":["vv75:2"],"lines":["Vaṇṇo ca te sabbadisā pabhāsatī”ti."],"lineRefs":[["vv75:2"]]},{"para":3270,"vripara":"1116","refs":["vv75:3"],"lines":["“So devaputto attamano … pe … yassa kammassidaṃ phalaṃ”."],"lineRefs":[["vv75:3"]]},{"para":3272,"vripara":"1117","refs":["vv75:4"],"lines":["“Ahaṃ manussesu manussabhūto, daliddo atāṇo kapaṇo kammakaro ahosiṃ;"],"lineRefs":[["vv75:4"]]},{"para":3273,"vripara":null,"refs":["vv75:4"],"lines":["Jiṇṇe ca mātāpitaro abhāriṃ, piyā ca me sīlavanto ahesuṃ;"],"lineRefs":[["vv75:4"]]},{"para":3274,"vripara":null,"refs":["vv75:4"],"lines":["Annañca pānañca pasannacitto, sakkacca dānaṃ vipulaṃ adāsiṃ."],"lineRefs":[["vv75:4"]]},{"para":3276,"vripara":"1118","refs":["vv75:5"],"lines":["“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti.","–"],"lineRefs":[["vv75:5"],["vv75:5"]]},{"para":3277,"vripara":null,"refs":["vv75:5"],"lines":["Sopi tassa byākāsi.","Sesaṃ vuttanayameva."],"lineRefs":[["vv75:5"],["vv75:5"]]},{"para":3278,"vripara":null,"refs":["vv75:5"],"lines":["Cittalatāvimānavaṇṇanā niṭṭhitā."],"lineRefs":[["vv75:5"]]},{"para":3279,"vripara":null,"refs":["vv75:5"],"lines":["Nandanavimānavaṇṇanā"],"lineRefs":[["vv75:5"]]},{"para":3280,"vripara":null,"refs":["vv75:5"],"lines":["<b>Yathā vanaṃ nandanaṃ pabhāsatī</b>ti nandanavimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tena samayena sāvatthiyaṃ aññataro upāsakotiādi sabbaṃ anantaravimānasadisaṃ.","Ayaṃ pana dārapariggahaṃ katvā mātāpitaro posesīti ayameva viseso."],"lineRefs":[["vv75:5"],["vv75:5"],["vv75:5"],["vv75:5"],["vv75:5"]]}],"wordLinks":[],"before":[{"para":3260,"vripara":null,"title":"Sunikkhittavimānavaggo","lines":["Sunikkhittavimānavaggo"]},{"para":3261,"vripara":null,"title":"Cittalatāvimānavaṇṇanā","lines":["Cittalatāvimānavaṇṇanā"]},{"para":3262,"vripara":null,"title":"Cittalatāvimānavaṇṇanā","lines":["<b>Yathā vanaṃ cittalataṃ pabhāsatī</b>ti cittalatāvimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tena samayena sāvatthiyaṃ aññataro upāsako daliddo appabhogo paresaṃ kammaṃ katvā jīvati.","So saddho pasanno jiṇṇe vuḍḍhe mātāpitaro posento “itthiyo nāma patikule ṭhitā issariyaṃ karonti, sassusasurānaṃ manāpacāriniyo dullabhā”ti mātāpitūnaṃ cittadukkhaṃ pariharanto dārapariggahaṃ akatvā sayameva ne upaṭṭhahati, sīlāni rakkhati, uposathaṃ upavasati, yathāvibhavaṃ dānāni deti.","So aparabhāge kālaṃ katvā tāvatiṃsesu dvādasayojanike vimāne nibbatti.","Taṃ āyasmā mahāmoggallāno heṭṭhā vuttanayena gantvā katakammaṃ imāhi gāthāhi paṭipucchi –"]}]},"tika":null,"tika2":null}
