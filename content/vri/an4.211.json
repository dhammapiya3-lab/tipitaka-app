{"suttaId":"an4.211","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1700,1701],"vripara":"211"},"segments":{"an4.211:0.3":"Parisāsuttaṃ","an4.211:1.1":"“Cattārome, bhikkhave, parisadūsanā.","an4.211:1.2":"Katame cattāro?","an4.211:1.3":"Bhikkhu, bhikkhave [idha bhikkhave bhikkhu (pī. ka.)], dussīlo pāpadhammo parisadūsano;","an4.211:1.4":"bhikkhunī, bhikkhave, dussīlā pāpadhammā parisadūsanā;","an4.211:1.5":"upāsako, bhikkhave, dussīlo pāpadhammo parisadūsano;","an4.211:1.6":"upāsikā, bhikkhave, dussīlā pāpadhammā parisadūsanā.","an4.211:1.7":"Ime kho, bhikkhave, cattāro parisadūsanā.","an4.211:2.1":"“Cattārome, bhikkhave, parisasobhanā.","an4.211:2.2":"Katame cattāro?","an4.211:2.3":"Bhikkhu, bhikkhave, sīlavā kalyāṇadhammo parisasobhano;","an4.211:2.4":"bhikkhunī, bhikkhave, sīlavatī kalyāṇadhammā parisasobhanā;","an4.211:2.5":"upāsako, bhikkhave, sīlavā kalyāṇadhammo parisasobhano;","an4.211:2.6":"upāsikā, bhikkhave, sīlavatī kalyāṇadhammā parisasobhanā.","an4.211:2.7":"Ime kho, bhikkhave, cattāro parisasobhanā”ti.","an4.211:2.8":"Paṭhamaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1663,"to":1663,"paras":[{"para":1663,"vripara":"211","refs":["an4.211:1","an4.211:2"],"words":["parisadūsanā","parisasobhanā"],"lines":["Dutiyassa paṭhame parisaṃ dūsentīti <b>parisadūsanā</b>.","Parisaṃ sobhentīti <b>parisasobhanā</b>."],"lineRefs":[["an4.211:1"],["an4.211:2"]]}]},"tika":null}
