{"suttaId":"tha-ap436","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[646,672],"vripara":"35"},"segments":{"tha-ap436:0.3":"Ñāṇatthavikattheraapadānaṃ","tha-ap436:1.1":"“Kaṇikāraṃva jalitaṃ,","tha-ap436:1.2":"dīparukkhaṃva jotitaṃ;","tha-ap436:1.3":"Kañcanaṃva virocantaṃ,","tha-ap436:1.4":"addasaṃ dvipaduttamaṃ. 36.","tha-ap436:2.1":"“Kamaṇḍaluṃ ṭhapetvāna,","tha-ap436:2.2":"vākacīrañca kuṇḍikaṃ;","tha-ap436:2.3":"Ekaṃsaṃ ajinaṃ katvā,","tha-ap436:2.4":"buddhaseṭṭhaṃ thaviṃ ahaṃ. 37.","tha-ap436:3.1":"“‘Tamandhakāraṃ vidhamaṃ,","tha-ap436:3.2":"mohajālasamākulaṃ;","tha-ap436:3.3":"Ñāṇālokaṃ dassetvāna,","tha-ap436:3.4":"nittiṇṇosi mahāmuni. 38.","tha-ap436:4.1":"“‘Samuddharasimaṃ lokaṃ,","tha-ap436:4.2":"sabbāvantamanuttaraṃ;","tha-ap436:4.3":"Ñāṇe te upamā natthi,","tha-ap436:4.4":"yāvatājagatogati [yāvatā ca gatogati (pī. ka.)]. 39.","tha-ap436:5.1":"“‘Tena ñāṇena sabbaññū,","tha-ap436:5.2":"iti buddho pavuccati;","tha-ap436:5.3":"Vandāmi taṃ mahāvīraṃ,","tha-ap436:5.4":"sabbaññutamanāvaraṃ’. 40.","tha-ap436:6.1":"“Satasahassito kappe,","tha-ap436:6.2":"buddhaseṭṭhaṃ thaviṃ ahaṃ;","tha-ap436:6.3":"Duggatiṃ nābhijānāmi,","tha-ap436:6.4":"ñāṇatthavāyidaṃ phalaṃ; 41.","tha-ap436:7.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap436:7.3":"viharāmi anāsavo; 42.","tha-ap436:8.1":"“Svāgataṃ vata me āsi…pe…","tha-ap436:8.3":"kataṃ buddhassa sāsanaṃ. 43.","tha-ap436:9.1":"“Paṭisambhidā catasso…pe…","tha-ap436:9.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap436:10.1":"Itthaṃ sudaṃ āyasmā ñāṇatthaviko thero imā gāthāyo Abhāsitthāti.","tha-ap436:11.1":"Ñāṇatthavikattherassāpadānaṃ catutthaṃ. 5."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
