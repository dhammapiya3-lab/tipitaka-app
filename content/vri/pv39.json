{"suttaId":"pv39","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[2313,2385],"vripara":"714"},"segments":{"pv39:0.3":"Revatīpetavatthu","pv39:1.1":"“Uṭṭhehi revate supāpadhamme,","pv39:1.2":"apārutadvāre adānasīle;","pv39:1.3":"Nessāma taṃ yattha thunanti duggatā,","pv39:1.4":"samappitā [samajjatā (sī.)] nerayikā dukhenā”ti. 715.","pv39:2.1":"Icceva [iccevaṃ (syā. ka.)] vatvāna yamassa dūtā,","pv39:2.2":"te dve yakkhā lohitakkhā brahantā;","pv39:2.3":"Paccekabāhāsu gahetvā revataṃ,","pv39:2.4":"pakkāmayuṃ devagaṇassa santike. 716.","pv39:3.1":"“Ādiccavaṇṇaṃ ruciraṃ pabhassaraṃ,","pv39:3.2":"byamhaṃ subhaṃ kañcanajālachannaṃ;","pv39:3.3":"Kassetamākiṇṇajanaṃ vimānaṃ,","pv39:3.4":"suriyassa raṃsīriva jotamānaṃ. 717.","pv39:4.1":"“Nārīgaṇā candanasāralittā [candanasārānulittā (syā.)],","pv39:4.2":"ubhato vimānaṃ upasobhayanti;","pv39:4.3":"Taṃ dissati suriyasamānavaṇṇaṃ,","pv39:4.4":"ko modati saggapatto vimāne”ti. 718.","pv39:5.1":"“Bārāṇasiyaṃ nandiyo nāmāsi,","pv39:5.2":"upāsako amaccharī dānapati vadaññū;","pv39:5.3":"Tassetamākiṇṇajanaṃ vimānaṃ,","pv39:5.4":"suriyassa raṃsīriva jotamānaṃ. 719.","pv39:6.1":"“Nārīgaṇā candanasāralittā,","pv39:6.2":"ubhato vimānaṃ upasobhayanti;","pv39:6.3":"Taṃ dissati suriyasamānavaṇṇaṃ,","pv39:6.4":"so modati saggapatto vimāne”ti. 720.","pv39:7.1":"“Nandiyassāhaṃ bhariyā,","pv39:7.2":"agārinī sabbakulassa issarā;","pv39:7.3":"Bhattu vimāne ramissāmi dānahaṃ,","pv39:7.4":"na patthaye nirayadassanāyā”ti. 721.","pv39:8.1":"“Eso te nirayo supāpadhamme,","pv39:8.2":"puññaṃ tayā akataṃ jīvaloke;","pv39:8.3":"Na hi maccharī rosako pāpadhammo,","pv39:8.4":"saggūpagānaṃ labhati sahabyata”nti. 722.","pv39:9.1":"“Kiṃ nu gūthañca muttañca,","pv39:9.2":"asucī paṭidissati;","pv39:9.3":"Duggandhaṃ kimidaṃ mīḷhaṃ,","pv39:9.4":"kimetaṃ upavāyatī”ti. 723.","pv39:10.1":"“Esa saṃsavako nāma,","pv39:10.2":"gambhīro sataporiso;","pv39:10.3":"Yattha vassasahassāni,","pv39:10.4":"tuvaṃ paccasi revate”ti. 724.","pv39:11.1":"“Kiṃ nu kāyena vācāya,","pv39:11.2":"manasā dukkaṭaṃ kataṃ;","pv39:11.3":"Kena saṃsavako laddho,","pv39:11.4":"gambhīro sataporiso”ti. 725.","pv39:12.1":"“Samaṇe brāhmaṇe cāpi,","pv39:12.2":"aññe vāpi vanibbake;","pv39:12.3":"Musāvādena vañcesi,","pv39:12.4":"taṃ pāpaṃ pakataṃ tayā. 726.","pv39:13.1":"“Tena saṃsavako laddho,","pv39:13.2":"gambhīro sataporiso;","pv39:13.3":"Tattha vassasahassāni,","pv39:13.4":"tuvaṃ paccasi revate. 727.","pv39:14.1":"“Hatthepi chindanti athopi pāde,","pv39:14.2":"kaṇṇepi chindanti athopi nāsaṃ;","pv39:14.3":"Athopi kākoḷagaṇā samecca,","pv39:14.4":"saṅgamma khādanti viphandamāna”nti. 728.","pv39:15.1":"“Sādhu kho maṃ paṭinetha,","pv39:15.2":"kāhāmi kusalaṃ bahuṃ;","pv39:15.3":"Dānena samacariyāya,","pv39:15.4":"saṃyamena damena ca;","pv39:15.5":"Yaṃ katvā sukhitā honti,","pv39:15.6":"na ca pacchānutappare”ti. 729.","pv39:16.1":"“Pure tuvaṃ pamajjitvā,","pv39:16.2":"idāni paridevasi;","pv39:16.3":"Sayaṃ katānaṃ kammānaṃ,","pv39:16.4":"vipākaṃ anubhossasī”ti. 730.","pv39:17.1":"“Ko devalokato manussalokaṃ,","pv39:17.2":"gantvāna puṭṭho me evaṃ vadeyya;","pv39:17.3":"‘Nikkhittadaṇḍesu dadātha dānaṃ,","pv39:17.4":"acchādanaṃ seyya [sayana (sī.)] mathannapānaṃ;","pv39:17.5":"Na hi maccharī rosako pāpadhammo,","pv39:17.6":"saggūpagānaṃ labhati sahabyataṃ’. 731.","pv39:18.1":"“Sāhaṃ nūna ito gantvā,","pv39:18.2":"yoniṃ laddhāna mānusiṃ;","pv39:18.3":"Vadaññū sīlasampannā,","pv39:18.4":"kāhāmi kusalaṃ bahuṃ;","pv39:18.5":"Dānena samacariyāya,","pv39:18.6":"saṃyamena damena ca. 732.","pv39:19.1":"“Ārāmāni ca ropissaṃ,","pv39:19.2":"dugge saṅkamanāni ca;","pv39:19.3":"Papañca udapānañca,","pv39:19.4":"vippasannena cetasā. 733.","pv39:20.1":"“Cātuddasiṃ pañcadasiṃ,","pv39:20.2":"yā ca pakkhassa aṭṭhamī;","pv39:20.3":"Pāṭihāriyapakkhañca,","pv39:20.4":"aṭṭhaṅgasusamāgataṃ. 734.","pv39:21.1":"“Uposathaṃ upavasissaṃ,","pv39:21.2":"sadā sīlesu saṃvutā;","pv39:21.3":"Na ca dāne pamajjissaṃ,","pv39:21.4":"sāmaṃ diṭṭhamidaṃ mayā”ti. 735.","pv39:22.1":"Iccevaṃ vippalapantiṃ,","pv39:22.2":"phandamānaṃ tato tato;","pv39:22.3":"Khipiṃsu niraye ghore,","pv39:22.4":"uddhaṃpādaṃ avaṃsiraṃ. 736.","pv39:23.1":"“Ahaṃ pure maccharinī ahosiṃ,","pv39:23.2":"paribhāsikā samaṇabrāhmaṇānaṃ;","pv39:23.3":"Vitathena ca sāmikaṃ vañcayitvā,","pv39:23.4":"paccāmahaṃ niraye ghorarūpe”ti.","pv39:24.1":"Revatīpetavatthu catutthaṃ. 5."},"unsure":[],"preface":[],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":2849,"to":2849,"paras":[{"para":2849,"vripara":"714-736","refs":["pv39:1"],"lines":["<b>Uṭṭhehi</b>, <b>revate, supāpadhamme</b>ti idaṃ revatīpetavatthu.","Taṃ yasmā revatīvimānavatthunā nibbisesaṃ, tasmā yadettha aṭṭhuppattiyaṃ gāthāsu ca vattabbaṃ, taṃ paramatthadīpaniyaṃ vimānavatthuvaṇṇanāyaṃ (vi. va. aṭṭha. 860 revatīvimānavaṇṇanā) vuttanayeneva veditabbaṃ.","Idañhi nandiyassa devaputtassa vasena vimānavatthupāḷiyaṃ saṅgahaṃ āropitampi revatīpaṭibaddhāya gāthāya vasena “revatīpetavatthu”nti petavatthupāḷiyampi saṅgahaṃ āropitanti daṭṭhabbaṃ."],"lineRefs":[["pv39:1"],["pv39:1"],["pv39:1"]]}],"wordLinks":[["pv39:1.1","revate supāpadhamme",0,0],["pv39:1.1","uṭṭhehi",0,0]],"before":[{"para":2848,"vripara":null,"title":"Revatīpetavatthuvaṇṇanā","lines":["Revatīpetavatthuvaṇṇanā 714-36."]}],"after":[{"para":2850,"vripara":null,"title":"Revatīpetavatthuvaṇṇanā","lines":["Revatīpetavatthuvaṇṇanā niṭṭhitā. 5."]}]},"tika":null,"tika2":null}
