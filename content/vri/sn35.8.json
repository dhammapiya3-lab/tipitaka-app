{"suttaId":"sn35.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[22,22],"vripara":"8"},"segments":{"sn35.8:0.3":"Ajjhattadukkhātītānāgatasuttaṃ","sn35.8:1.1":"“Cakkhuṃ, bhikkhave, dukkhaṃ atītānāgataṃ;","sn35.8:1.2":"ko pana vādo paccuppannassa!","sn35.8:1.3":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītasmiṃ cakkhusmiṃ anapekkho hoti;","sn35.8:1.4":"anāgataṃ cakkhuṃ nābhinandati;","sn35.8:1.5":"paccuppannassa cakkhussa nibbidāya virāgāya nirodhāya paṭipanno hoti.","sn35.8:1.6":"Sotaṃ dukkhaṃ … pe …","sn35.8:1.7":"ghānaṃ dukkhaṃ … pe …","sn35.8:1.8":"jivhā dukkhā atītānāgatā;","sn35.8:1.9":"ko pana vādo paccuppannāya!","sn35.8:1.10":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītāya jivhāya anapekkho hoti;","sn35.8:1.11":"anāgataṃ jivhaṃ nābhinandati;","sn35.8:1.12":"paccuppannāya jivhāya nibbidāya virāgāya nirodhāya paṭipanno hoti.","sn35.8:1.13":"Kāyo dukkho … pe …","sn35.8:1.14":"mano dukkho atītānāgato;","sn35.8:1.15":"ko pana vādo paccuppannassa!","sn35.8:1.16":"Evaṃ passaṃ, bhikkhave, sutavā ariyasāvako atītasmiṃ manasmiṃ anapekkho hoti;","sn35.8:1.17":"anāgataṃ manaṃ nābhinandati;","sn35.8:1.18":"paccuppannassa manassa nibbidāya virāgāya nirodhāya paṭipanno hotī”ti.","sn35.8:1.19":"Aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":15,"to":18,"paras":[{"para":15,"vripara":"7-12","refs":["sn35.8:1"],"lines":["7-12. Sattamādīni atītānāgatesu cakkhādīsu aniccalakkhaṇādīni sallakkhetvā paccuppannesu balavagāhena kilamantānaṃ vasena vuttāni.","Sesaṃ sabbattha heṭṭhā vuttanayamevāti."],"lineRefs":[["sn35.8:1"],["sn35.8:1"]]},{"para":16,"vripara":null,"refs":["sn35.8:1"],"lines":["Aniccavaggo paṭhamo."],"lineRefs":[["sn35.8:1"]]},{"para":17,"vripara":null,"refs":["sn35.8:1"],"lines":["Yamakavaggo"],"lineRefs":[["sn35.8:1"]]},{"para":18,"vripara":null,"refs":["sn35.8:1"],"lines":["1-4. Paṭhamapubbesambodhasuttādivaṇṇanā"],"lineRefs":[["sn35.8:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":18,"to":22,"paras":[{"para":18,"vripara":"7-12","refs":["sn35.8:1"],"lines":["7-12. <b>Sallakkhetvā</b>ti atītānāgatānaṃ avijjamānattā gāhassa daḷhatāya sallakkhetvā.","<b>Paccuppannesu</b> vijjamānattā balavatā taṇhādigāhena vipassanāvīthiṃ paṭipādetuṃ <b>kilamantānaṃ</b> vineyyānaṃ <b>vasena</b>."],"lineRefs":[["sn35.8:1"],["sn35.8:1"]]},{"para":19,"vripara":null,"refs":["sn35.8:1"],"lines":["Ajjhattāniccātītānāgatasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.8:1"]]},{"para":20,"vripara":null,"refs":["sn35.8:1"],"lines":["Aniccavaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.8:1"]]},{"para":21,"vripara":null,"refs":["sn35.8:1"],"lines":["Yamakavaggo"],"lineRefs":[["sn35.8:1"]]},{"para":22,"vripara":null,"refs":["sn35.8:1"],"lines":["1-4. Paṭhamapubbesambodhasuttādivaṇṇanā"],"lineRefs":[["sn35.8:1"]]}],"wordLinks":[]},"tika2":null}
