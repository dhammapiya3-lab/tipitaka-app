{"suttaId":"tha-ap241","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8085,8094],"vripara":"33"},"segments":{"tha-ap241:0.3":"Jagatikārakattheraapadānaṃ","tha-ap241:1.1":"“Nibbute lokanāthamhi,","tha-ap241:1.2":"atthadassi naruttame;","tha-ap241:1.3":"Jagatī kāritā mayhaṃ,","tha-ap241:1.4":"buddhassa thūpamuttame. 34.","tha-ap241:2.1":"“Aṭṭhārase kappasate,","tha-ap241:2.2":"yaṃ kammamakariṃ tadā;","tha-ap241:2.3":"Duggatiṃ nābhijānāmi,","tha-ap241:2.4":"jagatiyā idaṃ phalaṃ. 35.","tha-ap241:3.1":"“Paṭisambhidā catasso…pe…","tha-ap241:3.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap241:4.1":"Itthaṃ sudaṃ āyasmā jagatikārako thero imā gāthāyo abhāsitthāti.","tha-ap241:5.1":"Jagatikārakattherassāpadānaṃ navamaṃ. 10."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3193,"to":3193,"paras":[{"para":3193,"vripara":"33","refs":["tha-ap241:1"],"lines":["Navamāpadāne <b>jagatī kāritā mayha</b>nti atthadassissa bhagavato sarīradhātunidhāpitacetiye jagati chinnabhinnaālindapupphādhānasaṅkhātā jagati mayā kāritā kārāpitāti attho."],"lineRefs":[["tha-ap241:1"]]}],"wordLinks":[["tha-ap241:1.3","jagatī kāritā mayhaṃ",0,0]],"after":[{"para":3194,"vripara":null,"title":"Udakāsanadāyakattheraapadānādivaṇṇanā","lines":["Dasamāpadānaṃ uttānatthamevāti."]},{"para":3195,"vripara":null,"title":"Udakāsanadāyakattheraapadānādivaṇṇanā","lines":["Catuvīsatimavaggavaṇṇanā samattā. 25."]}]},"tika":null,"tika2":null}
