{"suttaId":"an3.48","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iii","vriCode":"s0402m2.mul","paras":[373,383],"vripara":"49"},"segments":{"an3.48:0.3":"Pabbatarājasuttaṃ","an3.48:1.1":"“Himavantaṃ, bhikkhave, pabbatarājaṃ nissāya mahāsālā tīhi vaḍḍhīhi vaḍḍhanti.","an3.48:1.2":"Katamāhi tīhi?","an3.48:1.3":"Sākhāpattapalāsena vaḍḍhanti, tacapapaṭikāya vaḍḍhanti, pheggusārena vaḍḍhanti.","an3.48:1.4":"Himavantaṃ, bhikkhave, pabbatarājaṃ nissāya mahāsālā imāhi tīhi vaḍḍhīhi vaḍḍhanti.","an3.48:2.1":"“Evamevaṃ kho, bhikkhave, saddhaṃ kulapatiṃ nissāya anto jano tīhi vaḍḍhīhi vaḍḍhati.","an3.48:2.2":"Katamāhi tīhi?","an3.48:2.3":"Saddhāya vaḍḍhati, sīlena vaḍḍhati, paññāya vaḍḍhati.","an3.48:2.4":"Saddhaṃ, bhikkhave, kulapatiṃ nissāya anto jano imāhi tīhi vaḍḍhīhi vaḍḍhatī”ti.","an3.48:3.1":"“Yathāpi pabbato selo,","an3.48:3.2":"araññasmiṃ brahāvane;","an3.48:3.3":"Taṃ rukkhā upanissāya,","an3.48:3.4":"vaḍḍhante te vanappatī.","an3.48:4.1":"“Tatheva sīlasampannaṃ,","an3.48:4.2":"saddhaṃ kulapatiṃ idha;","an3.48:4.3":"Upanissāya vaḍḍhanti,","an3.48:4.4":"puttadārā ca bandhavā;","an3.48:4.5":"Amaccā ñātisaṅghā ca,","an3.48:4.6":"ye cassa anujīvino.","an3.48:5.1":"“Tyāssa sīlavato sīlaṃ,","an3.48:5.2":"cāgaṃ sucaritāni ca;","an3.48:5.3":"Passamānānukubbanti,","an3.48:5.4":"attamatthaṃ [ye bhavanti (sī. syā. kaṃ. pī.)] vicakkhaṇā.","an3.48:6.1":"“Idha dhammaṃ caritvāna,","an3.48:6.2":"maggaṃ sugatigāminaṃ;","an3.48:6.3":"Nandino devalokasmiṃ,","an3.48:6.4":"modanti kāmakāmino”ti.","an3.48:6.5":"navamaṃ;"},"unsure":[],"attha":{"book":"Mp-iii","bookName":"Tikanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":576,"to":576,"paras":[{"para":576,"vripara":"49","refs":["an3.48:1","an3.48:2","an3.48:3","an3.48:6"],"lines":["Navame <b>mahāsālā</b>ti mahārukkhā.","<b>Kulapatin</b>ti kulajeṭṭhakaṃ.","<b>Selo</b>ti silāmayo.","<b>Araññasmin</b>ti agāmakaṭṭhāne.","<b>Brahmā</b>ti mahanto.","<b>Vane</b>ti aṭaviyaṃ.","<b>Vanappatī</b>ti vanajeṭṭhakā.","<b>Idha dhammaṃ caritvāna, maggaṃ sugatigāminan</b>ti sugatigāmikamaggasaṅkhātaṃ dhammaṃ caritvā."],"lineRefs":[["an3.48:1"],["an3.48:2"],["an3.48:3"],["an3.48:3"],["an3.48:3"],["an3.48:3"],["an3.48:3"],["an3.48:6"]]}],"wordLinks":[["an3.48:1.1","mahāsālā",0,0],["an3.48:1.4","mahāsālā",0,0],["an3.48:2.1","kulapatiṃ",0,1],["an3.48:2.4","kulapatiṃ",0,1],["an3.48:3.1","selo",0,2],["an3.48:3.1","araññasmiṃ",0,3],["an3.48:3.1","vane",0,5],["an3.48:3.3","vane",0,5],["an3.48:3.3","vanappatī",0,6],["an3.48:6.1","idha dhammaṃ caritvāna maggaṃ sugatigāminaṃ",0,7]],"before":[{"para":573,"vripara":null,"refs":[],"lines":["Asaṅkhatalakkhaṇasuttavaṇṇanā"],"lineRefs":[[]]},{"para":574,"vripara":"48","refs":[],"lines":["Aṭṭhame <b>asaṅkhatassā</b>ti paccayehi samāgantvā akatassa.","<b>Asaṅkhatalakkhaṇānī</b>ti asaṅkhataṃ etanti sañjānanakāraṇāni nimittāni.","<b>Na uppādo paññāyatī</b>tiādīhi uppādajarābhaṅgānaṃ abhāvo vutto.","Uppādādīnañhi abhāvena asaṅkhatanti paññāyati."],"lineRefs":[[],[],[],[]]},{"para":575,"vripara":null,"refs":[],"lines":["Pabbatarājasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-iii","bookName":"Tikanipāta-ṭīkā","vriCode":"s0402t.tik","from":578,"to":578,"paras":[{"para":578,"vripara":"49","refs":["an3.48:1"],"lines":["Navame idha <b>sāla</b> -saddo rukkhasāmaññapariyāyo, na rukkhavisesapariyāyoti āha <b>“mahāsālāti mahārukkhā”</b>ti.","<b>Kulajeṭṭhakan</b>ti tasmiṃ kule jeṭṭhabhūtaṃ sāmibhūtaṃ.","<b>Silāmayo</b> na paṃsumayo missako ca.","Gāmaṃ gāmūpacārañca ṭhapetvā sabbaṃ araññanti āha <b>“araññasminti agāmakaṭṭhāne”</b>ti.","Mahanto pabbato seloti yojanā."],"lineRefs":[["an3.48:1"],["an3.48:1"],["an3.48:1"],["an3.48:1"],["an3.48:1"]]}],"wordLinks":[["an3.48:1.1","sāla",0,0],["an3.48:1.4","sāla",0,0]],"before":[{"para":573,"vripara":null,"refs":[],"lines":["Saṅkhatalakkhaṇasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":574,"vripara":null,"refs":[],"lines":["Asaṅkhatalakkhaṇasuttavaṇṇanā"],"lineRefs":[[]]},{"para":575,"vripara":"48","refs":[],"lines":["Aṭṭhame <b>asaṅkhatassā</b>ti vuttanayena na saṅkhatassa.","Tenāha <b>“paccayehī”</b>tiādi.","Yathā uppādādīnaṃ bhāvena saṅkhatadhammajātaṃ saṅkhatanti paññāyati, evaṃ tesaṃ abhāvena nibbānaṃ asaṅkhatanti paññāyati."],"lineRefs":[[],[],[]]},{"para":576,"vripara":null,"refs":[],"lines":["Asaṅkhatalakkhaṇasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":577,"vripara":null,"refs":[],"lines":["Pabbatarājasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
