{"suttaId":"thi-ap13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-iii","vriCode":"s0510m2.mul","paras":[7026,7045],"vripara":"30"},"segments":{"thi-ap13:0.3":"Modakadāyikātherīapadānaṃ","thi-ap13:1.1":"“Nagare bandhumatiyā,","thi-ap13:1.2":"kumbhadāsī ahosahaṃ;","thi-ap13:1.3":"Mama bhāgaṃ gahetvāna,","thi-ap13:1.4":"gacchaṃ udakahārikā [udakahārikaṃ (sī.), udakahārike (syā.)].","thi-ap13:2.1":"“Panthamhi samaṇaṃ disvā,","thi-ap13:2.2":"santacittaṃ samāhataṃ;","thi-ap13:2.3":"Pasannacittā sumanā,","thi-ap13:2.4":"modake tīṇidāsahaṃ.","thi-ap13:3.1":"“Tena kammena sukatena,","thi-ap13:3.2":"cetanāpaṇidhīhi ca;","thi-ap13:3.3":"Ekanavutikappāni [ekūnatiṃsakappāni (syā.)],","thi-ap13:3.4":"vinipātaṃ nagacchahaṃ.","thi-ap13:4.1":"“Sampatti taṃ [sampattiñca (syā.), sampattikaṃ (ka.)] karitvāna,","thi-ap13:4.2":"sabbaṃ anubhaviṃ ahaṃ;","thi-ap13:4.3":"Modake tīṇi datvāna,","thi-ap13:4.4":"pattāhaṃ acalaṃ padaṃ.","thi-ap13:5.1":"“Kilesā jhāpitā mayhaṃ … pe …","thi-ap13:5.3":"viharāmi anāsavā.","thi-ap13:6.1":"“Svāgataṃ vata me āsi … pe …","thi-ap13:6.3":"kataṃ buddhassa sāsanaṃ.","thi-ap13:7.1":"“Paṭisambhidā catasso … pe …","thi-ap13:7.3":"kataṃ buddhassa sāsanaṃ”.","thi-ap13:8.1":"Itthaṃ sudaṃ modakadāyikā bhikkhunī imā gāthāyo abhāsitthāti.","thi-ap13:9.1":"Modakadāyikātheriyāpadānaṃ tatiyaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
