{"suttaId":"tha-ap161","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6602,6617],"vripara":"46"},"segments":{"tha-ap161:0.3":"Punnāgapupphiyattheraapadānaṃ","tha-ap161:1.1":"“Kānanaṃ vanamogayha,","tha-ap161:1.2":"vasāmi luddako ahaṃ;","tha-ap161:1.3":"Punnāgaṃ pupphitaṃ disvā,","tha-ap161:1.4":"buddhaseṭṭhaṃ anussariṃ.","tha-ap161:2.1":"“Taṃ pupphaṃ ocinitvāna,","tha-ap161:2.2":"sugandhaṃ gandhitaṃ subhaṃ;","tha-ap161:2.3":"Thūpaṃ karitvā puline,","tha-ap161:2.4":"buddhassa abhiropayiṃ.","tha-ap161:3.1":"“Dvenavute ito kappe,","tha-ap161:3.2":"yaṃ pupphamabhipūjayiṃ;","tha-ap161:3.3":"Duggatiṃ nābhijānāmi,","tha-ap161:3.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap161:4.1":"“Ekamhi navute kappe,","tha-ap161:4.2":"eko āsiṃ tamonudo;","tha-ap161:4.3":"Sattaratanasampanno,","tha-ap161:4.4":"cakkavattī mahabbalo.","tha-ap161:5.1":"“Paṭisambhidā catasso … pe …","tha-ap161:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap161:6.1":"Itthaṃ sudaṃ āyasmā punnāgapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap161:7.1":"Punnāgapupphiyattherassāpadānaṃ navamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3068,"to":3068,"paras":[{"para":3068,"vripara":"46","refs":["tha-ap161:1"],"lines":["So tena puññena dvenavutikappe nirantaraṃ devamanussasampattiyoyeva anubhavitvā imasmiṃ buddhuppāde sāvatthiyaṃ vibhavasampanne kule nibbatto vuddhimanvāya pubbavāsanābalena sāsane pasanno pabbajitvā vāyamanto nacirasseva arahā hutvā pubbe katakusalaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>kānanaṃ vanamogayhā</b>tiādimāha.","Taṃ sabbaṃ heṭṭhā vuttattā uttānatthamevāti."],"lineRefs":[["tha-ap161:1"],["tha-ap161:1"]]}],"wordLinks":[["tha-ap161:1.1","kānanaṃ vanamogayhā",0,0]]},"tika":null,"tika2":null}
