{"suttaId":"tha-ap79","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4598,4616],"vripara":"30"},"segments":{"tha-ap79:0.3":"Sūcidāyakattheraapadānaṃ","tha-ap79:1.1":"“Tiṃsakappasahassamhi,","tha-ap79:1.2":"sambuddho lokanāyako;","tha-ap79:1.3":"Sumedho nāma nāmena,","tha-ap79:1.4":"bāttiṃsavaralakkhaṇo.","tha-ap79:2.1":"“Tassa kañcanavaṇṇassa,","tha-ap79:2.2":"dvipadindassa tādino;","tha-ap79:2.3":"Pañca sūcī mayā dinnā,","tha-ap79:2.4":"sibbanatthāya cīvaraṃ.","tha-ap79:3.1":"“Teneva sūcidānena,","tha-ap79:3.2":"nipuṇatthavipassakaṃ;","tha-ap79:3.3":"Tikkhaṃ lahuñca phāsuñca,","tha-ap79:3.4":"ñāṇaṃ me udapajjatha.","tha-ap79:4.1":"“Kilesā jhāpitā mayhaṃ,","tha-ap79:4.2":"bhavā sabbe samūhatā;","tha-ap79:4.3":"Dhāremi antimaṃ dehaṃ,","tha-ap79:4.4":"sammāsambuddhasāsane.","tha-ap79:5.1":"“Dvipadādhipatī nāma,","tha-ap79:5.2":"rājāno caturo ahuṃ;","tha-ap79:5.3":"Sattaratanasampannā,","tha-ap79:5.4":"cakkavattī mahabbalā.","tha-ap79:6.1":"“Paṭisambhidā catasso … pe …","tha-ap79:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap79:7.1":"Itthaṃ sudaṃ āyasmā sūcidāyako thero imā gāthāyo abhāsitthāti.","tha-ap79:8.1":"Sūcidāyakattherassāpadānaṃ sattamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2688,"to":2689,"paras":[{"para":2688,"vripara":"30","refs":["tha-ap79:1"],"lines":["So aparabhāge puññaṃ paccavekkhanto taṃ disvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>tiṃsakappasahassamhī</b>tiādimāha.","Antarantaraṃ panettha suviññeyyameva."],"lineRefs":[["tha-ap79:1"],["tha-ap79:1"]]},{"para":2689,"vripara":"31","refs":["tha-ap79:2"],"lines":["<b>Pañcasūcī mayā dinnā</b>ti ettha sūcati chiddaṃ karoti vijjhatīti sūci, pañcamattā sūcī pañcasūcī mayā dinnāti attho.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap79:2"],["tha-ap79:2"]]}],"wordLinks":[["tha-ap79:1.1","tiṃsakappasahassamhī",0,0],["tha-ap79:2.3","pañcasūcī mayā dinnā",1,0]]},"tika":null,"tika2":null}
