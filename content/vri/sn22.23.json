{"suttaId":"sn22.23","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[147,147],"vripara":"23"},"segments":{"sn22.23:0.3":"Pariññasuttaṃ","sn22.23:1.1":"Sāvatthinidānaṃ.","sn22.23:1.2":"“Pariññeyye ca, bhikkhave, dhamme desessāmi pariññañca.","sn22.23:1.3":"Taṃ suṇātha.","sn22.23:1.4":"Katame ca, bhikkhave, pariññeyyā dhammā?","sn22.23:1.5":"Rūpaṃ, bhikkhave, pariññeyyo dhammo, vedanā pariññeyyo dhammo, saññā pariññeyyo dhammo, saṅkhārā pariññeyyo dhammo, viññāṇaṃ pariññeyyo dhammo.","sn22.23:1.6":"Ime vuccanti, bhikkhave, pariññeyyā dhammā.","sn22.23:1.7":"Katamā ca, bhikkhave, pariññā?","sn22.23:1.8":"Yo, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo.","sn22.23:1.9":"Ayaṃ vuccati, bhikkhave, pariññā”ti.","sn22.23:1.10":"Dutiyaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":77,"to":77,"paras":[{"para":77,"vripara":"23","refs":["sn22.23:1"],"lines":["Dutiye <b>pariññeyye</b>ti parijānitabbe, samatikkamitabbeti attho.","<b>Pariññan</b>ti accantapariññaṃ, samatikkamanti attho.","<b>Rāgakkhayo</b>tiādi nibbānassa nāmaṃ.","Tañhi accantapariññā nāma.","Dutiyaṃ."],"lineRefs":[["sn22.23:1"],["sn22.23:1"],["sn22.23:1"],["sn22.23:1"],["sn22.23:1"]]}],"wordLinks":[["sn22.23:1.2","pariññeyye",0,0],["sn22.23:1.4","pariññeyye",0,0],["sn22.23:1.5","pariññeyye",0,0],["sn22.23:1.6","pariññeyye",0,0],["sn22.23:1.2","pariññaṃ",0,1],["sn22.23:1.8","rāgakkhayo",0,2]],"before":[{"para":76,"vripara":null,"refs":[],"lines":["Pariññasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":75,"to":77,"paras":[{"para":75,"vripara":"23","refs":["sn22.23:1"],"lines":["<b>Parijānitabbe</b>ti pahānapariññāya parijānitabbe.","Tathā parijānanañca tattha chandarāgappahānaṃ, tesaṃ atikkamoti āha <b>“samatikkamitabbeti attho”</b>ti.","<b>Accantapariññan</b>ti nibbānaṃ vadati.","Tenāha <b>“samatikkamanti attho”</b>ti."],"lineRefs":[["sn22.23:1"],["sn22.23:1"],["sn22.23:1"],["sn22.23:1"]]},{"para":76,"vripara":null,"refs":["sn22.23:1"],"lines":["Pariññasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.23:1"]]},{"para":77,"vripara":null,"refs":["sn22.23:1"],"lines":["Abhijānasuttavaṇṇanā"],"lineRefs":[["sn22.23:1"]]}],"wordLinks":[],"before":[{"para":73,"vripara":null,"refs":[],"lines":["Bhārasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":74,"vripara":null,"refs":[],"lines":["Pariññasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
