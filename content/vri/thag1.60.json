{"suttaId":"thag1.60","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[349,357],"vripara":"60"},"segments":{"thag1.60:0.4":"Sīvalittheragāthā","thag1.60:1.1":"“Te me ijjhiṃsu saṅkappā, yadattho pāvisiṃ kuṭiṃ;","thag1.60:1.3":"Vijjāvimuttiṃ paccesaṃ, mānānusayamujjahan”ti.","thag1.60:1.5":"… Sīvalitthero ….","thag1.60:1.6":"Vaggo chaṭṭho niṭṭhito.","thag1.60:2.0":"Tassuddānaṃ –","thag1.60:2.1":"Godhiko ca subāhu ca, valliyo uttiyo isi;","thag1.60:2.3":"Añjanavaniyo thero, duve kuṭivihārino;","thag1.60:2.5":"Ramaṇīyakuṭiko ca, kosalavhayasīvalīti."},"attha":null,"tika":null}
