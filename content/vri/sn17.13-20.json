{"suttaId":"sn17.13-20","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1113,1118],"vripara":"169"},"segments":{"sn17.13-20:0.3":"3-10. Suvaṇṇanikkhasuttādiaṭṭhakaṃ","sn17.13-20:1.1":"Sāvatthiyaṃ viharati … pe …","sn17.13-20:1.2":"“idhāhaṃ, bhikkhave, ekaccaṃ puggalaṃ evaṃ cetasā ceto paricca pajānāmi –","sn17.13-20:1.3":"‘na cāyamāyasmā suvaṇṇanikkhassāpi hetu … pe …","sn17.13-20:1.4":"suvaṇṇanikkhasatassāpi hetu …","sn17.13-20:1.5":"siṅgīnikkhassāpi hetu …","sn17.13-20:1.6":"siṅgīnikkhasatassāpi hetu …","sn17.13-20:1.7":"pathaviyāpi jātarūpaparipūrāya hetu …","sn17.13-20:1.8":"āmisakiñcikkhahetupi …","sn17.13-20:1.9":"jīvitahetupi …","sn17.13-20:1.10":"janapadakalyāṇiyāpi hetu sampajānamusā bhāseyyā’ti.","sn17.13-20:1.11":"Tamenaṃ passāmi aparena samayena lābhasakkārasilokena abhibhūtaṃ pariyādiṇṇacittaṃ sampajānamusā bhāsantaṃ.","sn17.13-20:1.12":"Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko … pe …","sn17.13-20:1.13":"evañhi vo, bhikkhave, sikkhitabban”ti.","sn17.13-20:1.14":"Dasamaṃ.","sn17.13-20:1.15":"Dutiyo vaggo.","sn17.13-20:2.0":"Tassuddānaṃ –","sn17.13-20:2.1":"Dve pāti dve suvaṇṇā ca,","sn17.13-20:2.2":"siṅgīhi apare duve;","sn17.13-20:2.3":"Pathavī kiñcikkhajīvitaṃ,","sn17.13-20:2.4":"janapadakalyāṇiyā dasāti."},"unsure":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":805,"to":805,"paras":[{"para":805,"vripara":"169","refs":["sn17.13-20:1"],"lines":["Tatiyādīsu <b>suvaṇṇanikkhassā</b>ti ekassa kañcananikkhassa.","<b>Siṅgīnikkhassā</b>ti siṅgīsuvaṇṇanikkhassa.","<b>Pathaviyā</b>ti cakkavāḷabbhantarāya mahāpathaviyā.","<b>Āmisakiñcikkhahetū</b>ti kassacideva āmisassa hetu antamaso kuṇḍakamuṭṭhinopi.","<b>Jīvitahetū</b>ti aṭaviyaṃ corehi gahetvā jīvite voropiyamāne tassapi hetu.","<b>Janapadakalyāṇiyā</b>ti janapade uttamitthiyā.","Tatiyādīni."],"lineRefs":[["sn17.13-20:1"],["sn17.13-20:1"],["sn17.13-20:1"],["sn17.13-20:1"],["sn17.13-20:1"],["sn17.13-20:1"],["sn17.13-20:1"]]}],"wordLinks":[["sn17.13-20:1.3","suvaṇṇanikkhassā",0,0],["sn17.13-20:1.3","siṅgīnikkhassā",0,1],["sn17.13-20:1.3","pathaviyā",0,2],["sn17.13-20:1.3","āmisakiñcikkhahetū",0,3],["sn17.13-20:1.3","jīvitahetū",0,4],["sn17.13-20:1.3","janapadakalyāṇiyā",0,5]]},"tika":null,"tika2":null}
