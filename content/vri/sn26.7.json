{"suttaId":"sn26.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1179,1179],"vripara":"318"},"segments":{"sn26.7:0.3":"Sañcetanāsuttaṃ","sn26.7:1.1":"Sāvatthinidānaṃ.","sn26.7:1.2":"“Yo kho, bhikkhave, rūpasañcetanāya uppādo ṭhiti … pe …","sn26.7:1.3":"jarāmaraṇassa pātubhāvo … pe …","sn26.7:1.4":"yo dhammasañcetanāya uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo.","sn26.7:1.5":"Yo ca kho, bhikkhave, rūpasañcetanāya nirodho … pe …","sn26.7:1.6":"jarāmaraṇassa atthaṅgamo … pe …","sn26.7:1.7":"yo dhammasañcetanāya nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo”ti.","sn26.7:1.8":"Sattamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":452,"to":454,"paras":[{"para":452,"vripara":"312-321","refs":["sn26.7:1"],"lines":["312-321. Uppādasaṃyutte sabbaṃ pākaṭameva."],"lineRefs":[["sn26.7:1"]]},{"para":453,"vripara":null,"refs":["sn26.7:1"],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn26.7:1"]]},{"para":454,"vripara":null,"refs":["sn26.7:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.7:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":476,"to":478,"paras":[{"para":476,"vripara":"312-321","refs":["sn26.7:1"],"lines":["312-321. <b>Sabbaṃ pākaṭameva</b> apubbassa abhāvato."],"lineRefs":[["sn26.7:1"]]},{"para":477,"vripara":null,"refs":["sn26.7:1"],"lines":["Uppādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn26.7:1"]]},{"para":478,"vripara":null,"refs":["sn26.7:1"],"lines":["Kilesasaṃyuttavaṇṇanā"],"lineRefs":[["sn26.7:1"]]}],"wordLinks":[]},"tika2":null}
