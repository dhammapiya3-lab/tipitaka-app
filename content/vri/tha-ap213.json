{"suttaId":"tha-ap213","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7602,7618],"vripara":"1"},"segments":{"tha-ap213:0.3":"Hatthidāyakattheraapadānaṃ","tha-ap213:1.1":"“Siddhatthassa bhagavato,","tha-ap213:1.2":"dvipadindassa tādino;","tha-ap213:1.3":"Nāgaseṭṭho mayā dinno,","tha-ap213:1.4":"īsādanto urūḷhavā. 2.","tha-ap213:2.1":"“Uttamatthaṃ anubhomi,","tha-ap213:2.2":"santipadamanuttaraṃ;","tha-ap213:2.3":"Nāgadānaṃ [aggadānaṃ (sī. ka.)] mayā dinnaṃ,","tha-ap213:2.4":"sabbalokahitesino. 3.","tha-ap213:3.1":"“Catunnavutito kappe,","tha-ap213:3.2":"yaṃ nāga [dāna (sī. ka.)] madadiṃ tadā;","tha-ap213:3.3":"Duggatiṃ nābhijānāmi,","tha-ap213:3.4":"nāgadānassidaṃ phalaṃ. 4.","tha-ap213:4.1":"“Aṭṭhasattatikappamhi,","tha-ap213:4.2":"soḷasāsiṃsu khattiyā;","tha-ap213:4.3":"Samantapāsādikā nāma,","tha-ap213:4.4":"cakkavattī mahabbalā. 5.","tha-ap213:5.1":"“Paṭisambhidā catasso,","tha-ap213:5.2":"vimokkhāpi ca aṭṭhime;","tha-ap213:5.3":"Chaḷabhiññā sacchikatā,","tha-ap213:5.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap213:6.1":"Itthaṃ sudaṃ āyasmā hatthidāyako thero imā gāthāyo abhāsitthāti.","tha-ap213:7.1":"Hatthidāyakattherassāpadānaṃ paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
