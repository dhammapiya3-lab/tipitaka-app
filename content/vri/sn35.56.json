{"suttaId":"sn35.56","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[172,172],"vripara":"56"},"segments":{"sn35.56:0.3":"Āsavapahānasuttaṃ","sn35.56:1.1":"“Kathaṃ nu kho, bhante, jānato, kathaṃ passato āsavā pahīyantī”ti … pe ….","sn35.56:1.2":"Catutthaṃ."},"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":71,"to":74,"paras":[{"para":71,"vripara":"53-62","refs":["sn35.56:1"],"lines":["53-62. Avijjāvagge <b>avijjā</b>ti catūsu saccesu aññāṇaṃ.","<b>Vijjā</b>ti arahattamaggavijjā.","<b>Aniccato jānato passato</b>ti dukkhānattavasenāpi jānato passato pahīyatiyeva, idaṃ pana aniccavasena kathite bujjhanakapuggalassa ajjhāsayena vuttaṃ.","Eseva nayo sabbattha.","Api cettha <b>saṃyojanā</b>ti dasa saṃyojanāni.","<b>Āsavā</b>ti cattāro āsavā.","<b>Anusayā</b>ti satta anusayā.","<b>Sabbupādānapariññāyā</b>ti sabbesaṃ catunnampi upādānānaṃ tīhi pariññāhi parijānanatthāya.","<b>Pariyādānāyā</b>ti khepanatthāya.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"]]},{"para":72,"vripara":null,"refs":["sn35.56:1"],"lines":["Avijjāvaggo chaṭṭho."],"lineRefs":[["sn35.56:1"]]},{"para":73,"vripara":null,"refs":["sn35.56:1"],"lines":["Migajālavaggo"],"lineRefs":[["sn35.56:1"]]},{"para":74,"vripara":null,"refs":["sn35.56:1"],"lines":["Paṭhamamigajālasuttavaṇṇanā"],"lineRefs":[["sn35.56:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":80,"to":83,"paras":[{"para":80,"vripara":"53-62","refs":["sn35.56:1"],"lines":["53-62. <b>Catūsu saccesu aññāṇaṃ</b> tappaṭicchādakasammoho.","Avindiyaṃ vindati, vindiyaṃ na vindatīti katvā vijjāya paṭipakkhova <b>avijjā</b>.","Vijjāya uppannāya anavasesato avijjā pahīyati, taṃ dassento <b>“vijjāti arahattamaggavijjā”</b>ti āha.","Na kevalaṃ aniccānupassanāvaseneva maggavuṭṭhānaṃ, atha kho itarānupassanāvasenapīti dassento <b>“dukkhā … pe … pahīyatiyevā”</b>ti āha.","<b>Sabbatthā</b>ti uparisuttante sandhāyāha.","Tato aparepi taṃatthalakkhaṇavasena kathitasuttantepi.","Tānipi hi tathā bujjhanakapuggalānamajjhāsayena vuttānīti."],"lineRefs":[["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"],["sn35.56:1"]]},{"para":81,"vripara":null,"refs":["sn35.56:1"],"lines":["Avijjāvaggavaṇṇanā niṭṭhitā."],"lineRefs":[["sn35.56:1"]]},{"para":82,"vripara":null,"refs":["sn35.56:1"],"lines":["Migajālavaggo"],"lineRefs":[["sn35.56:1"]]},{"para":83,"vripara":null,"refs":["sn35.56:1"],"lines":["Paṭhamamigajālasuttavaṇṇanā"],"lineRefs":[["sn35.56:1"]]}],"wordLinks":[]},"tika2":null}
