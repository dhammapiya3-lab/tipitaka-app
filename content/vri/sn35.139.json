{"suttaId":"sn35.139","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[902,902],"vripara":"139"},"segments":{"sn35.139:0.3":"Dutiyanatumhākaṃsuttaṃ","sn35.139:1.1":"“Yaṃ, bhikkhave, na tumhākaṃ, taṃ pajahatha.","sn35.139:1.2":"Taṃ vo pahīnaṃ hitāya sukhāya bhavissati.","sn35.139:1.3":"Kiñca, bhikkhave, na tumhākaṃ?","sn35.139:1.4":"Rūpā, bhikkhave, na tumhākaṃ;","sn35.139:1.5":"te pajahatha. Te vo pahīnā hitāya sukhāya bhavissanti.","sn35.139:1.6":"Saddā … gandhā … rasā … phoṭṭhabbā … dhammā na tumhākaṃ;","sn35.139:1.10":"te pajahatha.","sn35.139:1.11":"Te vo pahīnā hitāya sukhāya bhavissanti.","sn35.139:1.12":"Seyyathāpi, bhikkhave, yaṃ imasmiṃ jetavane … pe … evameva kho, bhikkhave, rūpā na tumhākaṃ;","sn35.139:1.13":"te pajahatha.","sn35.139:1.14":"Te vo pahīnā hitāya sukhāya bhavissantī”ti.","sn35.139:1.15":"Chaṭṭhaṃ."},"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":263,"to":266,"paras":[{"para":263,"vripara":"137-145","refs":["sn35.139:1"],"lines":["137-145. Catutthaṃ suddhikaṃ katvā desiyamāne bujjhanakānaṃ ajjhāsayena vuttaṃ.","Pañcamādīni tathā tathā bujjhantānaṃ ajjhāsayena vuttāni.","Attho pana tesaṃ pākaṭoyevāti."],"lineRefs":[["sn35.139:1"],["sn35.139:1"],["sn35.139:1"]]},{"para":264,"vripara":null,"refs":[],"lines":["Devadahavaggo cuddasamo."],"lineRefs":[[]]},{"para":265,"vripara":null,"refs":[],"lines":["Navapurāṇavaggo"],"lineRefs":[[]]},{"para":266,"vripara":null,"refs":["sn35.139:1"],"lines":["Kammanirodhasuttavaṇṇanā"],"lineRefs":[["sn35.139:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":273,"to":277,"paras":[{"para":273,"vripara":"137-145","refs":["sn35.139:1"],"lines":["137-145. <b>Suddhikaṃ katvā</b> gāthābandhanena vinā kevalaṃ cuṇṇiyapadavaseneva.","<b>Tathā tathā</b>ti ajjhattikāni bāhirāni ca āyatanāni aniccalakkhaṇena dukkhānattalakkhaṇehi ca yojetvā dassanavasena."],"lineRefs":[[