{"suttaId":"kp1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Khp","vriCode":"s0501m.mul","paras":[5,14],"vripara":null},"segments":{"kp1:0.2":"Saraṇattayaṃ","kp1:2.1":"Buddhaṃ saraṇaṃ gacchāmi;","kp1:2.2":"Dhammaṃ saraṇaṃ gacchāmi;","kp1:2.3":"Saṅghaṃ saraṇaṃ gacchāmi.","kp1:3.1":"Dutiyampi buddhaṃ saraṇaṃ gacchāmi;","kp1:3.2":"Dutiyampi dhammaṃ saraṇaṃ gacchāmi;","kp1:3.3":"Dutiyampi saṅghaṃ saraṇaṃ gacchāmi.","kp1:4.1":"Tatiyampi buddhaṃ saraṇaṃ gacchāmi;","kp1:4.2":"Tatiyampi dhammaṃ saraṇaṃ gacchāmi;","kp1:4.3":"Tatiyampi saṅghaṃ saraṇaṃ gacchāmi.","kp1:5.1":"Saraṇattayaṃ [saraṇagamanaṃ niṭṭhitaṃ (syā.)] niṭṭhitaṃ."},"unsure":[],"preface":["Namo tassa bhagavato arahato sammāsambuddhassa"],"attha":null,"tika":null,"tika2":null}
