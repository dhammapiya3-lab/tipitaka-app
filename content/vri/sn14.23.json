{"suttaId":"sn14.23","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[799,800],"vripara":"107"},"segments":{"sn14.23:0.3":"Asamāhitasuttaṃ","sn14.23:1.1":"Sāvatthiyaṃ viharati … pe …“dhātusova, bhikkhave, sattā saṃsandanti samenti.","sn14.23:1.3":"Assaddhā assaddhehi saddhiṃ saṃsandanti samenti;","sn14.23:1.4":"ahirikā ahirikehi saddhiṃ saṃsandanti samenti;","sn14.23:1.5":"anottappino anottappīhi saddhiṃ saṃsandanti samenti;","sn14.23:1.6":"asamāhitā asamāhitehi saddhiṃ saṃsandanti samenti;","sn14.23:1.7":"duppaññā duppaññehi saddhiṃ saṃsandanti samenti”.","sn14.23:2.1":"“Saddhā saddhehi saddhiṃ saṃsandanti samenti;","sn14.23:2.2":"hirimanā hirimanehi saddhiṃ saṃsandanti samenti;","sn14.23:2.3":"ottappino ottappīhi saddhiṃ saṃsandanti samenti;","sn14.23:2.4":"samāhitā samāhitehi saddhiṃ saṃsandanti samenti;","sn14.23:2.5":"paññavanto paññavantehi saddhiṃ saṃsandanti samentī”ti.","sn14.23:2.6":"Paṭhamaṃ."},"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":560,"to":560,"paras":[{"para":560,"vripara":"107-108","refs":["sn14.23:1"],"lines":["107-108. Ito paresu paṭhamaṃ assaddhādipañcakavasena vuttaṃ, tathā dutiyaṃ.","Paṭhame pana asamāhitapadaṃ catutthaṃ, dutiye dussīlapadaṃ.","Evaṃ vuccamāne bujjhanakapuggalānaṃ ajjhāsayena hi etāni vuttāni.","Ettha <b>asamāhitā</b>ti upacārappanāsamādhirahitā.","<b>Dussīlā</b>ti nissīlā.","Paṭhamadutiyāni."],"lineRefs":[["sn14.23:1"],["sn14.23:1"],["sn14.23:1"],["sn14.23:1"],["sn14.23:1"],["sn14.23:1"]]}],"wordLinks":[["sn14.23:1.6","asamāhitā",0,3]]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":565,"to":565,"paras":[{"para":565,"vripara":"107-108","refs":["sn14.23:2"],"lines":["107-108. <b>Ito paresū</b>ti ito dutiyavaggato paresu suttesu.","<b>Paṭhaman</b>ti paṭhamavagge paṭhamaṃ.","Kasmā panettha evaṃ desanā pavattāti āha <b>“evaṃ vuccamāne”</b>tiādi."],"lineRefs":[["sn14.23:2"],["sn14.23:2"],["sn14.23:2"]]}],"wordLinks":[["sn14.23:2.6","paṭhamaṃ",0,1]]}}
