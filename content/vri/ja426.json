{"suttaId":"ja426","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[4873,4901],"vripara":"88"},"segments":{"ja426:0.4":"Dīpijātakaṃ (10)","ja426:1.1":"Khamanīyaṃ yāpanīyaṃ,","ja426:1.2":"kacci mātula te sukhaṃ;","ja426:1.3":"Sukhaṃ te ammā avaca,","ja426:1.4":"sukhakāmāva [sukhakāmā hi (sī. syā. pī.)] te mayaṃ. 89.","ja426:2.1":"Naṅguṭṭhaṃ me avakkamma [apakkamma (ka.)],","ja426:2.2":"heṭhayitvāna [pothayitvāna (ka.)] eḷike [eḷaki (syā.), eḷiki (pī.)];","ja426:2.3":"Sājja mātulavādena,","ja426:2.4":"muñcitabbā nu maññasi. 90.","ja426:3.1":"Puratthāmukho nisinnosi,","ja426:3.2":"ahaṃ te mukhamāgatā;","ja426:3.3":"Pacchato tuyhaṃ naṅguṭṭhaṃ,","ja426:3.4":"kathaṃ khvāhaṃ avakkamiṃ [apakkamiṃ (ka.)]. 91.","ja426:4.1":"Yāvatā caturo dīpā,","ja426:4.2":"sasamuddā sapabbatā;","ja426:4.3":"Tāvatā mayhaṃ naṅguṭṭhaṃ,","ja426:4.4":"kathaṃ kho tvaṃ vivajjayi. 92.","ja426:5.1":"Pubbeva metamakkhiṃsu [metaṃ akkhaṃsu (sī. pī.)],","ja426:5.2":"mātā pitā ca bhātaro;","ja426:5.3":"Dīghaṃ duṭṭhassa naṅguṭṭhaṃ,","ja426:5.4":"sāmhi vehāyasāgatā. 93.","ja426:6.1":"Tañca disvāna āyantiṃ,","ja426:6.2":"antalikkhasmi eḷike;","ja426:6.3":"Migasaṅgho palāyittha,","ja426:6.4":"bhakkho me nāsito tayā. 94.","ja426:7.1":"Iccevaṃ vilapantiyā,","ja426:7.2":"eḷakiyā ruhagghaso;","ja426:7.3":"Galakaṃ anvāvamaddi,","ja426:7.4":"natthi duṭṭhe subhāsitaṃ. 95.","ja426:8.1":"Neva duṭṭhe nayo atthi,","ja426:8.2":"na dhammo na subhāsitaṃ;","ja426:8.3":"Nikkamaṃ duṭṭhe yuñjetha,","ja426:8.4":"so ca sabbhiṃ na rañjatīti.","ja426:9.1":"Dīpijātakaṃ dasamaṃ.","ja426:10.1":"Aṭṭhakanipātaṃ niṭṭhitaṃ.","ja426:11.1":"Tassuddānaṃ –","ja426:12.1":"Parisuddhā manāvilā vatthadharā,","ja426:12.2":"bakarājassa kāyuraṃ daṇḍavaro;","ja426:12.3":"Atha aṅgāra cetiya devilinā,","ja426:12.4":"atha āditta gaṅgā daseḷakināti. 9."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iii","bookName":"Jātaka-aṭṭhakathā-3","vriCode":"s0513a3.att","from":4258,"to":4291,"paras":[{"para":4258,"vripara":null,"refs":["ja426:1"],"lines":["Tattha <b>sukhaṃ te ammā</b>ti mayhaṃ mātāpi “tumhākaṃ sukhaṃ puccheyyāsī”ti ajja maṃ avacāti attho.","<b>Maya</b>nti mātula mayampi tumhākaṃ sukhaṃ eva icchāmāti."],"lineRefs":[["ja426:1"],["ja426:1"]]},{"para":4259,"vripara":null,"refs":["ja426:1"],"lines":["Taṃ sutvā dīpiko “ayaṃ dhuttikā maṃ mātulavādena vañcetukāmā, na me kakkhaḷabhāvaṃ jānātī”ti cintetvā dutiyaṃ gāthamāha – 89."],"lineRefs":[["ja426:1"]]},{"para":4261,"vripara":"89","refs":["ja426:1"],"lines":["“Naṅguṭṭhaṃ me avakkamma, heṭhayitvāna eḷike;"],"lineRefs":[["ja426:1"]]},{"para":4262,"vripara":null,"refs":["ja426:1"],"lines":["Sājja mātulavādena, muñcitabbā nu maññasī”ti."],"lineRefs":[["ja426:1"]]},{"para":4263,"vripara":null,"refs":["ja426:1"],"lines":["Tassattho – tvaṃ mama naṅguṭṭhamaṇḍalaṃ akkamitvā heṭhayitvā āgacchasi, sā tvaṃ “ajja mātulavādena muñcitabbāhamasmī”ti maññasi nu, evaṃ maññasi maññeti."],"lineRefs":[["ja426:1"]]},{"para":4264,"vripara":null,"refs":["ja426:1"],"lines":["Taṃ sutvā itarā “mātula, mā evaṃ karī”ti vatvā tatiyaṃ gāthamāha – 90."],"lineRefs":[["ja426:1"]]},{"para":4266,"vripara":"90","refs":["ja426:1"],"lines":["“Puratthāmukho nisinnosi, ahaṃ te mukhamāgatā;"],"lineRefs":[["ja426:1"]]},{"para":4267,"vripara":null,"refs":["ja426:1"],"lines":["Pacchato tuyhaṃ naṅguṭṭhaṃ, kathaṃ khvāhaṃ avakkami”nti."],"lineRefs":[["ja426:1"]]},{"para":4268,"vripara":null,"refs":["ja426:3"],"lines":["Tattha <b>mukha</b>nti abhimukhaṃ.","<b>Kathaṃ khvāhaṃ avakkami</b>nti tava pacchato ṭhitaṃ ahaṃ kathaṃ avakkaminti attho."],"lineRefs":[["ja426:3"],["ja426:3"]]},{"para":4269,"vripara":null,"refs":["ja426:3"],"lines":["Atha naṃ so “kiṃ kathesi eḷike, mama naṅguṭṭhassa aṭṭhitaṭṭhānaṃ nāma natthī”ti vatvā catutthaṃ gāthamāha – 91."],"lineRefs":[["ja426:3"]]},{"para":4271,"vripara":"91","refs":["ja426:3"],"lines":["“Yāvatā caturo dīpā, sasamuddā sapabbatā;"],"lineRefs":[["ja426:3"]]},{"para":4272,"vripara":null,"refs":["ja426:3"],"lines":["Tāvatā mayhaṃ naṅguṭṭhaṃ, kathaṃ kho taṃ vivajjayī”ti."],"lineRefs":[["ja426:3"]]},{"para":4273,"vripara":null,"refs":["ja426:3"],"lines":["Tattha tāvatāti ettakaṃ ṭhānaṃ mama naṅguṭṭhaṃ parikkhipitvā gatanti vadati."],"lineRefs":[["ja426:3"]]},{"para":4274,"vripara":null,"refs":["ja426:3"],"lines":["Taṃ sutvā eḷikā “ayaṃ pāpo madhurakathāya na allīyati, paṭisattu hutvā tassa kathessāmī”ti vatvā pañcamaṃ gāthamāha – 92."],"lineRefs":[["ja426:3"]]},{"para":4276,"vripara":"92","refs":["ja426:3"],"lines":["“Pubbeva metamakkhiṃsu, mātā pitā ca bhātaro;"],"lineRefs":[["ja426:3"]]},{"para":4277,"vripara":null,"refs":["ja426:3"],"lines":["Dīghaṃ duṭṭhassa naṅguṭṭhaṃ, sāmhi vehāyasāgatā”ti."],"lineRefs":[["ja426:3"]]},{"para":4278,"vripara":null,"refs":["ja426:5"],"lines":["Tattha <b>akkhiṃsū</b>ti pubbeva me etaṃ mātā ca pitā ca bhātaro ca ācikkhiṃsu.","<b>Sāmhī</b>ti sā ahaṃ ñātakānaṃ santikā tava naṅguṭṭhassa dīghabhāvaṃ sutvā tava naṅguṭṭhaṃ pariharantī <b>vehāyasā</b> ākāsena āgatāti."],"lineRefs":[["ja426:5"],["ja426:5"]]},{"para":4279,"vripara":null,"refs":["ja426:5"],"lines":["Atha naṃ so “jānāmi te ahaṃ ākāsena āgatabhāvaṃ, evaṃ āgacchantī pana mayhaṃ bhakkhe nāsetvā āgatāsī”ti vatvā chaṭṭhaṃ gāthamāha – 93."],"lineRefs":[["ja426:5"]]},{"para":4281,"vripara":"93","refs":["ja426:5"],"lines":["“Tañca disvāna āyantiṃ, antalikkhasmi eḷike;"],"lineRefs":[["ja426:5"]]},{"para":4282,"vripara":null,"refs":["ja426:5"],"lines":["Migasaṅgho palāyittha, bhakkho me nāsito tayā”ti."],"lineRefs":[["ja426:5"]]},{"para":4283,"vripara":null,"refs":["ja426:5"],"lines":["Taṃ sutvā itarā maraṇabhayabhītā aññaṃ kāraṇaṃ āharituṃ asakkontī “mātula, mā evarūpaṃ kakkhaḷakammaṃ kari, jīvitaṃ me dehī”ti vilapi.","Itaropi naṃ vilapantiññeva khandhe gahetvā māretvā khādi. 94."],"lineRefs":[["ja426:5"],["ja426:5"]]},{"para":4285,"vripara":"94","refs":["ja426:5"],"lines":["“Iccevaṃ vilapantiyā, eḷakiyā ruhagghaso;"],"lineRefs":[["ja426:5"]]},{"para":4286,"vripara":null,"refs":["ja426:5"],"lines":["Galakaṃ anvāvamaddi, natthi duṭṭhe subhāsitaṃ. 95."],"lineRefs":[["ja426:5"]]},{"para":4288,"vripara":"95","refs":["ja426:5"],"lines":["“Neva duṭṭhe nayo atthi, na dhammo na subhāsitaṃ;"],"lineRefs":[["ja426:5"]]},{"para":4289,"vripara":null,"refs":["ja426:5"],"lines":["Nikkamaṃ duṭṭhe yuñjetha, so ca sabbhiṃ na rañjatī”ti. –"],"lineRefs":[["ja426:5"]]},{"para":4290,"vripara":null,"refs":["ja426:5"],"lines":["Imā dve abhisambuddhagāthā –"],"lineRefs":[["ja426:5"]]},{"para":4291,"vripara":null,"refs":["ja426:5","ja426:8"],"lines":["Tattha <b>ruhagghaso</b>ti ruhirabhakkho lohitapāyī sāhasikadīpiko.","<b>Galakaṃ anvāvamaddī</b>ti gīvaṃ maddi, ḍaṃsitvā phālesīti attho.","<b>Nayo</b>ti kāraṇaṃ.","<b>Dhammo</b>ti sabhāvo.","<b>Subhāsita</b>nti sukathitavacanaṃ, sabbametaṃ duṭṭhe natthīti attho.","<b>Nikkamaṃ duṭṭhe yuñjethā</b>ti bhikkhave, duṭṭhapuggale parakkamameva yuñjeyya.","<b>So ca sabbhiṃ na rañjatī</b>ti so pana puggalo sabbhiṃ sundaraṃ subhāsitaṃ na rañjati, na piyāyatīti attho.","Tāpaso tesaṃ kiriyaṃ sabbaṃ addasa."],"lineRefs":[["ja426:5"],["ja426:5"],["ja426:8"],["ja426:8"],["ja426:8"],["ja426:8"],["ja426:8"],["ja426:8"]]}],"wordLinks":[["ja426:1.3","sukhaṃ te ammā",0,0],["ja426:1.3","mayaṃ",0,1],["ja426:3.1","mukhaṃ",8,0],["ja426:3.3","kathaṃ khvāhaṃ avakkamiṃ",8,1],["ja426:5.1","akkhiṃsū",16,0],["ja426:5.3","sāmhī",16,1],["ja426:5.3","vehāyasā",16,1],["ja426:8.1","nayo",26,2],["ja426:8.1","dhammo",26,3],["ja426:8.1","subhāsitaṃ",26,4],["ja426:8.3","nikkamaṃ duṭṭhe yuñjethā",26,5],["ja426:8.3","so ca sabbhiṃ na rañjatī",26,6]],"after":[{"para":4292,"vripara":null,"title":"[426] 10. Dīpijātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā jātakaṃ samodhānesi –","“tadā eḷikāva etarahi eḷikā ahosi, dīpikopi etarahi dīpikova, tāpaso pana ahameva ahosi”nti."]},{"para":4293,"vripara":null,"title":"[426] 10. Dīpijātakavaṇṇanā","lines":["Dīpijātakavaṇṇanā dasamā."]},{"para":4294,"vripara":null,"title":"[426] 10. Dīpijātakavaṇṇanā","lines":["Jātakuddānaṃ –"]},{"para":4295,"vripara":null,"title":"[426] 10. Dīpijātakavaṇṇanā","lines":["Kaccānī aṭṭhasaddañca, sulasā ca sumaṅgalaṃ;"]},{"para":4296,"vripara":null,"title":"[426] 10. Dīpijātakavaṇṇanā","lines":["Gaṅgamālañca cetiyaṃ, indriyañceva ādittaṃ;"]},{"para":4297,"vripara":null,"title":"[426] 10. Dīpijātakavaṇṇanā","lines":["Aṭṭhānañceva dīpi ca, dasa aṭṭhanipātake."]},{"para":4298,"vripara":null,"title":"[426] 10. Dīpijātakavaṇṇanā","lines":["Aṭṭhakanipātavaṇṇanā niṭṭhitā. 9."]}]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":2604,"to":2611,"paras":[{"para":2604,"vripara":null,"refs":["ja426:1"],"lines":["10-dīpajātakavaṇṇanā (426)"],"lineRefs":[["ja426:1"]]},{"para":2605,"vripara":null,"refs":["ja426:1"],"lines":["<b>tadā taṃ eḷakapālakā</b>ti tasmiṃ kāle taṃ eḷakaṃ pavesetvāti sambandho.","eḷakapālakā kīḷantā viharantīti sambandho.","<b>ettha carantū</b>ti bahavopi aññe eḷakā imasmiṃ ṭhāne carantīti evaṃ manasikaritvā giribbajaṃ pavesetvā kīḷantā viharantīti attho.","<b>tesū</b>ti eḷakapālakesu gacchantesūti sambandho.","<b>sāyaṃ āgantvā</b>ti sāyanasamayaṃ kīḷanaṭṭhānato āgantvā.","<b>ohiyī</b>ti avasesayi.","<b>taṃ pacchā nikkhamanti</b>nti pacchā ekako nikkhamantiṃ taṃ eḷikaṃ.","<b>taṃ disvā</b>ti taṃ dīpikaṃ disvā.","<b>siṅgāni ukkhipitvā</b>ti saha sīsena siṅgāni ukkhipitvā.","<b>gahana</b>nti pavanaṃ.","<b>eḷake carantesū</b>ti eḷake gocaraṃ gaṇhāpentesūti attho.","<b>hadayamassa mudukaṃ janetvā</b>ti assa dīpikassa cittaṃ mudukaṃ janetvā cittassa mudubhāvaṃ katvāti vuttaṃ hoti.","<b>mātulā</b>ti piyākārena dīpikaṃ ālapati.","<b>parikkhipitvā</b>ti samantato khipitvā ṭhitanti vadati.","<b>ācikkhiṃsū</b>ti pubbeva me etaṃ “duṭṭhassa naguၤṭṭhaṃ dīgha”nti vacanaṃ mātā ca pitā ca bhātaro ca ācikkhiṃsu.","<b>sāmhī</b>ti"],"lineRefs":[["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"]]},{"para":2606,"vripara":null,"refs":["ja426:1"],"lines":["footnote 1.","ceṭo.","chaṭṭha."],"lineRefs":[["ja426:1"],["ja426:1"],["ja426:1"]]},{"para":2607,"vripara":null,"refs":["ja426:1"],"lines":["footnote 2.","tadā eḷakapālako.","chaṭṭha."],"lineRefs":[["ja426:1"],["ja426:1"],["ja426:1"]]},{"para":2608,"vripara":null,"refs":["ja426:1"],"lines":["footnote 3.","akkhiṃsu.","chaṭṭha.","ettha sā amhīti chedo.","<b>pariharantī</b>ti apaharanti.","parivajjayantīti attho.","<b>ākāsena gatā</b>ti ākāsapathena gatā amhīti attho.","<b>atha naṃ so “ jānāmi te ahaṃ ākāsena gatabhāva”</b>nti tasmiṃ kāle naṃ eḷikaṃ vatvāti āhāti sambandho.","so dīpiko “te ākāsena gatabhāvaṃ” ahaṃ jānāmi.","<b>evaṃ āgacchantī</b>ti evaṃ ākāsena āgacchantī pana tvaṃ mayhaṃ bhakkhe nāsetvā āgatā asīti evaṃ vatvā “tañca disvā.","la.","tayā”ti chaṭṭhaṃ gāthamāhāti attho."],"lineRefs":[["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"]]},{"para":2609,"vripara":null,"refs":["ja426:1"],"lines":["pāḷiyaṃ <b>eḷake</b>ti ālapanaṃ vacanaṃ.","antalikkhasmiṃ āyantiṃ āgacchantiṃ tañca tuvaṃ yeva disvāna migayo palāyittha.","bhakkho me tayā nāsitoti sambandho.","<b>ruhagghaso</b>ti ettha ruhigghasoti vattabbe ikārassa akāraṃ katvā evaṃ vuttaṃ.","<b>duṭṭhe</b>ti duṭṭhapuggale.","<b>parakkamamevā</b>ti ussāhameva.","<b>so ca sabbhiṃ na rañjatī</b>ti ettha santānaṃ idaṃ sabbhi.","sundarabhāvo, subhāsitañca.","tenāha — “sabbhiṃ sundaraṃ subhāsita” nti."],"lineRefs":[["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"],["ja426:1"]]},{"para":2610,"vripara":null,"refs":["ja426:1"],"lines":["ending dīpijātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja426:1"]]},{"para":2611,"vripara":null,"refs":["ja426:1"],"lines":["ending iti asammohavilāsiniyā nāma jātakakaṭṭhakathāya aṭṭhakanipātavaṇṇanā niṭṭhitā."],"lineRefs":[["ja426:1"]]}],"wordLinks":[]},"tika2":null}
