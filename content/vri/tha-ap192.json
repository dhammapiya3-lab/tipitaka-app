{"suttaId":"tha-ap192","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7197,7220],"vripara":"57"},"segments":{"tha-ap192:0.3":"Tivaṇṭipupphiyattheraapadānaṃ","tha-ap192:1.1":"“Abhibhūtaṃ panijjhanti [abhibhūtopanijjhanti (sī.)],","tha-ap192:1.2":"sabbe saṅgamma te mamaṃ [abhibhuṃ theraṃ panijjhāma, sabbe saṅgamma te mayaṃ (syā.)];","tha-ap192:1.3":"Tesaṃ nijjhāyamānānaṃ,","tha-ap192:1.4":"pariḷāho ajāyatha.","tha-ap192:2.1":"“Sunando nāma nāmena,","tha-ap192:2.2":"buddhassa sāvako tadā;","tha-ap192:2.3":"Dhammadassissa munino,","tha-ap192:2.4":"āgacchi mama santikaṃ.","tha-ap192:3.1":"“Ye me baddhacarā āsuṃ,","tha-ap192:3.2":"te me pupphaṃ aduṃ tadā;","tha-ap192:3.3":"Tāhaṃ pupphaṃ gahetvāna,","tha-ap192:3.4":"sāvake abhiropayiṃ.","tha-ap192:4.1":"“Sohaṃ kālaṃkato tattha,","tha-ap192:4.2":"punāpi upapajjahaṃ;","tha-ap192:4.3":"Aṭṭhārase kappasate,","tha-ap192:4.4":"vinipātaṃ na gacchahaṃ.","tha-ap192:5.1":"“Teraseto kappasate,","tha-ap192:5.2":"aṭṭhāsuṃ dhūmaketuno;","tha-ap192:5.3":"Sattaratanasampannā,","tha-ap192:5.4":"cakkavattī mahabbalā.","tha-ap192:6.1":"“Paṭisambhidā catasso … pe …","tha-ap192:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap192:7.1":"Itthaṃ sudaṃ āyasmā tivaṇṭipupphiyo thero imā gāthāyo abhāsitthāti;","tha-ap192:8.1":"Tivaṇṭipupphiyattherassāpadānaṃ dasamaṃ.","tha-ap192:9.1":"Kuṭajapupphiyavaggo ekūnavīsatimo.","tha-ap192:10.1":"Tassuddānaṃ –","tha-ap192:11.1":"Kuṭajo bandhujīvī ca,","tha-ap192:11.2":"koṭumbarikahatthiyo;","tha-ap192:11.3":"Isimuggo ca bodhi ca,","tha-ap192:11.4":"ekacintī tikaṇṇiko;","tha-ap192:11.5":"Ekacārī tivaṇṭi ca,","tha-ap192:11.6":"gāthā dvāsaṭṭhi kittitāti."},"unsure":[],"attha":null,"tika":null,"tika2":null}
