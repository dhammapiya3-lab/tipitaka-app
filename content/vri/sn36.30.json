{"suttaId":"sn36.30","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1413,1413],"vripara":"278"},"segments":{"sn36.30:0.3":"Suddhikasuttaṃ","sn36.30:1.1":"“Tisso imā, bhikkhave, vedanā.","sn36.30:1.2":"Katamā tisso?","sn36.30:1.3":"Sukhā vedanā, dukkhā vedanā, adukkhamasukhā vedanā – imā kho, bhikkhave, tisso vedanā”ti.","sn36.30:1.5":"Dasamaṃ."},"attha":null,"tika":null}
