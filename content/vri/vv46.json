{"suttaId":"vv46","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1769,1796],"vripara":"783"},"segments":{"vv46:0.4":"Ambavimānavatthu","vv46:1.1":"“Dibbaṃ te ambavanaṃ rammaṃ,","vv46:1.2":"pāsādettha mahallako;","vv46:1.3":"Nānāturiyasaṅghuṭṭho,","vv46:1.4":"accharāgaṇaghosito. 784.","vv46:2.1":"“Padīpo cettha jalati,","vv46:2.2":"niccaṃ sovaṇṇayo mahā;","vv46:2.3":"Dussaphalehi rukkhehi,","vv46:2.4":"samantā parivārito. 785.","vv46:3.1":"“Kena tetādiso vaṇṇo…pe…","vv46:3.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti; 787.","vv46:4.1":"Sā devatā attamanā…pe…","vv46:4.3":"yassa kammassidaṃ phalaṃ. 788.","vv46:5.1":"“Ahaṃ manussesu manussabhūtā,","vv46:5.2":"purimāya jātiyā manussaloke;","vv46:5.3":"Vihāraṃ saṅghassa kāresiṃ,","vv46:5.4":"ambehi parivāritaṃ. 789.","vv46:6.1":"“Pariyosite vihāre,","vv46:6.2":"kārente niṭṭhite mahe;","vv46:6.3":"Ambehi chādayitvāna [ambe acchādayitvāna (sī. syā.), ambehacchādayitvāna (pī. ka.)],","vv46:6.4":"katvā dussamaye phale. 790.","vv46:7.1":"“Padīpaṃ tattha jāletvā,","vv46:7.2":"bhojayitvā gaṇuttamaṃ;","vv46:7.3":"Niyyādesiṃ taṃ saṅghassa,","vv46:7.4":"pasannā sehi pāṇibhi. 791.","vv46:8.1":"“Tena me ambavanaṃ rammaṃ,","vv46:8.2":"pāsādettha mahallako;","vv46:8.3":"Nānāturiyasaṅghuṭṭho,","vv46:8.4":"accharāgaṇaghosito. 792.","vv46:9.1":"“Padīpo cettha jalati,","vv46:9.2":"niccaṃ sovaṇṇayo mahā;","vv46:9.3":"Dussaphalehi rukkhehi,","vv46:9.4":"samantā parivārito. 793.","vv46:10.1":"“Tena metādiso vaṇṇo…pe…","vv46:10.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv46:11.1":"Ambavimānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2094,"to":2097,"paras":[{"para":2094,"vripara":"783","refs":["vv46:1"],"lines":["Tattha <b>mahallako</b>ti mahanto āyāmavitthārehi ubbedhena ca vipulo, uḷāratamoti attho.","<b>Accharāgaṇaghosito</b>ti taṃ pamodituṃ saṅgītivasena ceva piyasallāpavasena ca accharāsaṅghena samugghosito. 784."],"lineRefs":[["vv46:1"],["vv46:1"]]},{"para":2095,"vripara":"784","refs":["vv46:2"],"lines":["<b>Padīpo cettha jalatī</b>ti sūriyarasmisamujjalakiraṇavitāno ratanappadīpo ca ettha etasmiṃ pāsāde abhijalati.","<b>Dussaphalehī</b>ti dussāni phalāni etesanti dussaphalā.","Tehi samuggiriyamānadibbavatthehīti attho. 789."],"lineRefs":[["vv46:2"],["vv46:2"],["vv46:2"]]},{"para":2096,"vripara":"789","refs":["vv46:6"],"lines":["<b>Kārente niṭṭhite mahe</b>ti katapariyositassa vihārassa mahe pūjāya karīyamānāya ca.","<b>Katvā dussamaye phale</b>ti dusseyeva tesaṃ ambānaṃ phalaṃ katvā. 790."],"lineRefs":[["vv46:6"],["vv46:6"]]},{"para":2097,"vripara":"790","refs":["vv46:7"],"lines":["<b>Gaṇuttama</b>nti gaṇānaṃ uttamaṃ bhagavato sāvakasaṅghaṃ.","<b>Niyyādesi</b>nti sampaṭicchāpesiṃ, adāsinti attho.","Sesaṃ vuttanayameva."],"lineRefs":[["vv46:7"],["vv46:7"],["vv46:7"]]}],"wordLinks":[["vv46:1.1","mahallako",0,0],["vv46:1.3","accharāgaṇaghosito",0,1],["vv46:2.1","padīpo cettha jalatī",1,0],["vv46:2.3","dussaphalehī",1,1],["vv46:6.1","kārente niṭṭhite mahe",2,0],["vv46:6.3","katvā dussamaye phale",2,1],["vv46:7.1","gaṇuttamaṃ",3,0],["vv46:7.3","niyyādesiṃ",3,1]],"before":[{"para":2065,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Ambavimānavaṇṇanā"]},{"para":2066,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["<b>Dibbaṃ</b> <b>te ambavanaṃ ramma</b>nti ambavimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tena samayena sāvatthiyaṃ aññatarā upāsikā āvāsadānassa mahapphalataṃ mahānisaṃsatañca sutvā chandajātā bhagavantaṃ abhivādetvā evamāha “ahaṃ, bhante, ekaṃ āvāsaṃ kāretukāmā, icchāmi tādisaṃ okāsaṃ, ācikkhatū”ti.","Bhagavā bhikkhū āṇāpesi, bhikkhū tassā okāsaṃ dassesuṃ.","Sā tattha ramaṇīyaṃ āvāsaṃ kāretvā tassa samantato ambarukkhe ropesi.","So āvāso samantato ambapantīhi parikkhitto chāyūdakasampanno muttājālasadisavālukākiṇṇapaṇḍarabhūmibhāgo ativiya manoharo ahosi.","Sā taṃ vihāraṃ nānāvaṇṇehi vatthehi pupphadāmagandhadāmādīhi ca devavimānaṃ viya alaṅkaritvā telapadīpaṃ āropetvā ambarukkhe ca ahatehi vatthehi veṭhetvā saṅghassa niyyādesi."]},{"para":2067,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Sā aparabhāge kālaṃ katvā tāvatiṃsabhavane nibbatti, tassā mahantaṃ vimānaṃ pāturahosi ambavanaparikkhittaṃ.","Sā tattha accharāgaṇaparivāritā dibbasampattiṃ anubhavati.","Taṃ āyasmā mahāmoggallāno upagantvā imāhi gāthāhi pucchi – 783."]},{"para":2069,"vripara":"783","title":"Ambavimānavaṇṇanā","lines":["“Dibbaṃ te ambavanaṃ rammaṃ, pāsādettha mahallako;"]},{"para":2070,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Nānātūriyasaṅghuṭṭho, accharāgaṇaghosito. 784."]},{"para":2072,"vripara":"784","title":"Ambavimānavaṇṇanā","lines":["“Padīpo cettha jalati, niccaṃ sovaṇṇayo mahā;"]},{"para":2073,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Dussaphalehi rukkhehi, samantā parivārito. 785."]},{"para":2074,"vripara":"785","title":"Ambavimānavaṇṇanā","lines":["“Kena tetādiso vaṇṇo…pe…vaṇṇo ca te sabbadisā pabhāsatī”ti. 787."]},{"para":2075,"vripara":"787","title":"Ambavimānavaṇṇanā","lines":["“Sā devatā attamanā…pe… yassa kammassidaṃ phalaṃ”. 788."]},{"para":2077,"vripara":"788","title":"Ambavimānavaṇṇanā","lines":["“Ahaṃ manussesu manussabhūtā, purimāya jātiyā manussaloke;"]},{"para":2078,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Vihāraṃ saṅghassa kāresiṃ, ambehi parivāritaṃ. 789."]},{"para":2080,"vripara":"789","title":"Ambavimānavaṇṇanā","lines":["“Pariyosite vihāre, kārente niṭṭhite mahe;"]},{"para":2081,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Ambehi chādayitvāna, katvā dussamaye phale. 790."]},{"para":2083,"vripara":"790","title":"Ambavimānavaṇṇanā","lines":["“Padīpaṃ tattha jāletvā, bhojayitvā gaṇuttamaṃ;"]},{"para":2084,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Niyyādesiṃ taṃ saṅghassa, pasannā sehi pāṇibhi. 791."]},{"para":2086,"vripara":"791","title":"Ambavimānavaṇṇanā","lines":["“Tena me ambavanaṃ rammaṃ, pāsādettha mahallako;"]},{"para":2087,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Nānātūriyasaṅghuṭṭho, accharāgaṇaghosito. 792."]},{"para":2089,"vripara":"792","title":"Ambavimānavaṇṇanā","lines":["“Padīpo cettha jalati, niccaṃ sovaṇṇayo mahā;"]},{"para":2090,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Dussaphalehi rukkhehi, samantā parivārito. 793."]},{"para":2092,"vripara":"793","title":"Ambavimānavaṇṇanā","lines":["“Tena metādiso vaṇṇo…pe…vaṇṇo ca me sabbadisā pabhāsatī”ti. –"]},{"para":2093,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Sā devatā byākāsi. 783."]}],"after":[{"para":2098,"vripara":null,"title":"Ambavimānavaṇṇanā","lines":["Ambavimānavaṇṇanā niṭṭhitā. 9."]}]},"tika":null,"tika2":null}
