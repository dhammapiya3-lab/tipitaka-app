{"suttaId":"vv46","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1769,1796],"vripara":"783"},"segments":{"vv46:0.4":"Ambavimānavatthu","vv46:1.1":"“Dibbaṃ te ambavanaṃ rammaṃ,","vv46:1.2":"pāsādettha mahallako;","vv46:1.3":"Nānāturiyasaṅghuṭṭho,","vv46:1.4":"accharāgaṇaghosito.","vv46:2.1":"“Padīpo cettha jalati,","vv46:2.2":"niccaṃ sovaṇṇayo mahā;","vv46:2.3":"Dussaphalehi rukkhehi,","vv46:2.4":"samantā parivārito.","vv46:3.1":"“Kena tetādiso vaṇṇo … pe …","vv46:3.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti;","vv46:4.1":"Sā devatā attamanā … pe …","vv46:4.3":"yassa kammassidaṃ phalaṃ.","vv46:5.1":"“Ahaṃ manussesu manussabhūtā,","vv46:5.2":"purimāya jātiyā manussaloke;","vv46:5.3":"Vihāraṃ saṅghassa kāresiṃ,","vv46:5.4":"ambehi parivāritaṃ.","vv46:6.1":"“Pariyosite vihāre,","vv46:6.2":"kārente niṭṭhite mahe;","vv46:6.3":"Ambehi chādayitvāna [ambe acchādayitvāna (sī. syā.), ambehacchādayitvāna (pī. ka.)],","vv46:6.4":"katvā dussamaye phale.","vv46:7.1":"“Padīpaṃ tattha jāletvā,","vv46:7.2":"bhojayitvā gaṇuttamaṃ;","vv46:7.3":"Niyyādesiṃ taṃ saṅghassa,","vv46:7.4":"pasannā sehi pāṇibhi.","vv46:8.1":"“Tena me ambavanaṃ rammaṃ,","vv46:8.2":"pāsādettha mahallako;","vv46:8.3":"Nānāturiyasaṅghuṭṭho,","vv46:8.4":"accharāgaṇaghosito.","vv46:9.1":"“Padīpo cettha jalati,","vv46:9.2":"niccaṃ sovaṇṇayo mahā;","vv46:9.3":"Dussaphalehi rukkhehi,","vv46:9.4":"samantā parivārito.","vv46:10.1":"“Tena metādiso vaṇṇo … pe …","vv46:10.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv46:11.1":"Ambavimānaṃ aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2094,"to":2097,"paras":[{"para":2094,"vripara":"783","refs":["vv46:1"],"lines":["Tattha <b>mahallako</b>ti mahanto āyāmavitthārehi ubbedhena ca vipulo, uḷāratamoti attho.","<b>Accharāgaṇaghosito</b>ti taṃ pamodituṃ saṅgītivasena ceva piyasallāpavasena ca accharāsaṅghena samugghosito."],"lineRefs":[["vv46:1"],["vv46:1"]]},{"para":2095,"vripara":"784","refs":["vv46:2"],"lines":["<b>Padīpo cettha jalatī</b>ti sūriyarasmisamujjalakiraṇavitāno ratanappadīpo ca ettha etasmiṃ pāsāde abhijalati.","<b>Dussaphalehī</b>ti dussāni phalāni etesanti dussaphalā.","Tehi samuggiriyamānadibbavatthehīti attho."],"lineRefs":[["vv46:2"],["vv46:2"],["vv46:2"]]},{"para":2096,"vripara":"789","refs":["vv46:6"],"lines":["<b>Kārente niṭṭhite mahe</b>ti katapariyositassa vihārassa mahe pūjāya karīyamānāya ca.","<b>Katvā dussamaye phale</b>ti dusseyeva tesaṃ ambānaṃ phalaṃ katvā."],"lineRefs":[["vv46:6"],["vv46:6"]]},{"para":2097,"vripara":"790","refs":["vv46:7"],"lines":["<b>Gaṇuttaman</b>ti gaṇānaṃ uttamaṃ bhagavato sāvakasaṅghaṃ.","<b>Niyyādesin</b>ti sampaṭicchāpesiṃ, adāsinti attho.","Sesaṃ vuttanayameva."],"lineRefs":[["vv46:7"],["vv46:7"],["vv46:7"]]}],"wordLinks":[["vv46:1.1","mahallako",0,0],["vv46:1.3","accharāgaṇaghosito",0,1],["vv46:2.1","padīpo cettha jalatī",1,0],["vv46:2.3","dussaphalehī",1,1],["vv46:6.1","kārente niṭṭhite mahe",2,0],["vv46:6.3","katvā dussamaye phale",2,1],["vv46:7.1","gaṇuttamaṃ",3,0],["vv46:7.3","niyyādesiṃ",3,1]],"before":[{"para":2063,"vripara":null,"refs":[],"lines":["Evaṃ tāhi attanā katakamme kathite thero tāsaṃ anupubbiṃ kathaṃ kathetvā saccāni pakāsesi.","Saccapariyosāne sā sabbāpi sahaparivārā sotāpannā ahesuṃ.","Thero taṃ pavattiṃ manussalokaṃ āgantvā bhagavato ārocesi.","Bhagavā tamatthaṃ aṭṭhuppattiṃ katvā sampattaparisāya dhammaṃ desesi.","Sā dhammadesanā mahājanassa sātthikā jātāti."],"lineRefs":[[],[],[],[],[]]},{"para":2064,"vripara":null,"refs":[],"lines":["Caturitthivimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2065,"vripara":null,"refs":[],"lines":["Ambavimānavaṇṇanā"],"lineRefs":[[]]},{"para":2066,"vripara":null,"refs":[],"lines":["<b>Dibbaṃ te ambavanaṃ ramman</b>ti ambavimānaṃ.","Tassa kā uppatti?","Bhagavā sāvatthiyaṃ viharati jetavane.","Tena samayena sāvatthiyaṃ aññatarā upāsikā āvāsadānassa mahapphalataṃ mahānisaṃsatañca sutvā chandajātā bhagavantaṃ abhivādetvā evamāha “ahaṃ, bhante, ekaṃ āvāsaṃ kāretukāmā, icchāmi tādisaṃ okāsaṃ, ācikkhatū”ti.","Bhagavā bhikkhū āṇāpesi, bhikkhū tassā okāsaṃ dassesuṃ.","Sā tattha ramaṇīyaṃ āvāsaṃ kāretvā tassa samantato ambarukkhe ropesi.","So āvāso samantato ambapantīhi parikkhitto chāyūdakasampanno muttājālasadisavālukākiṇṇapaṇḍarabhūmibhāgo ativiya manoharo ahosi.","Sā taṃ vihāraṃ nānāvaṇṇehi vatthehi pupphadāmagandhadāmādīhi ca devavimānaṃ viya alaṅkaritvā telapadīpaṃ āropetvā ambarukkhe ca ahatehi vatthehi veṭhetvā saṅghassa niyyādesi."],"lineRefs":[[],[],[],[],[],[],[],[]]},{"para":2067,"vripara":null,"refs":[],"lines":["Sā aparabhāge kālaṃ katvā tāvatiṃsabhavane nibbatti, tassā mahantaṃ vimānaṃ pāturahosi ambavanaparikkhittaṃ.","Sā tattha accharāgaṇaparivāritā dibbasampattiṃ anubhavati.","Taṃ āyasmā mahāmoggallāno upagantvā imāhi gāthāhi pucchi –"],"lineRefs":[[],[],[]]},{"para":2069,"vripara":"783","refs":[],"lines":["“Dibbaṃ te ambavanaṃ rammaṃ, pāsādettha mahallako;"],"lineRefs":[[]]},{"para":2070,"vripara":null,"refs":[],"lines":["Nānātūriyasaṅghuṭṭho, accharāgaṇaghosito."],"lineRefs":[[]]},{"para":2072,"vripara":"784","refs":[],"lines":["“Padīpo cettha jalati, niccaṃ sovaṇṇayo mahā;"],"lineRefs":[[]]},{"para":2073,"vripara":null,"refs":[],"lines":["Dussaphalehi rukkhehi, samantā parivārito."],"lineRefs":[[]]},{"para":2074,"vripara":"785","refs":[],"lines":["“Kena tetādiso vaṇṇo … pe … vaṇṇo ca te sabbadisā pabhāsatī”ti."],"lineRefs":[[]]},{"para":2075,"vripara":"787","refs":[],"lines":["“Sā devatā attamanā … pe … yassa kammassidaṃ phalaṃ”."],"lineRefs":[[]]},{"para":2077,"vripara":"788","refs":[],"lines":["“Ahaṃ manussesu manussabhūtā, purimāya jātiyā manussaloke;"],"lineRefs":[[]]},{"para":2078,"vripara":null,"refs":[],"lines":["Vihāraṃ saṅghassa kāresiṃ, ambehi parivāritaṃ."],"lineRefs":[[]]},{"para":2080,"vripara":"789","refs":[],"lines":["“Pariyosite vihāre, kārente niṭṭhite mahe;"],"lineRefs":[[]]},{"para":2081,"vripara":null,"refs":[],"lines":["Ambehi chādayitvāna, katvā dussamaye phale."],"lineRefs":[[]]},{"para":2083,"vripara":"790","refs":[],"lines":["“Padīpaṃ tattha jāletvā, bhojayitvā gaṇuttamaṃ;"],"lineRefs":[[]]},{"para":2084,"vripara":null,"refs":[],"lines":["Niyyādesiṃ taṃ saṅghassa, pasannā sehi pāṇibhi."],"lineRefs":[[]]},{"para":2086,"vripara":"791","refs":[],"lines":["“Tena me ambavanaṃ rammaṃ, pāsādettha mahallako;"],"lineRefs":[[]]},{"para":2087,"vripara":null,"refs":[],"lines":["Nānātūriyasaṅghuṭṭho, accharāgaṇaghosito."],"lineRefs":[[]]},{"para":2089,"vripara":"792","refs":[],"lines":["“Padīpo cettha jalati, niccaṃ sovaṇṇayo mahā;"],"lineRefs":[[]]},{"para":2090,"vripara":null,"refs":[],"lines":["Dussaphalehi rukkhehi, samantā parivārito."],"lineRefs":[[]]},{"para":2092,"vripara":"793","refs":[],"lines":["“Tena metādiso vaṇṇo … pe … vaṇṇo ca me sabbadisā pabhāsatī”ti.","–"],"lineRefs":[[],[]]},{"para":2093,"vripara":null,"refs":[],"lines":["Sā devatā byākāsi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
