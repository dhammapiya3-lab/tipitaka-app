{"suttaId":"thag1.30","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[176,184],"vripara":"30"},"segments":{"thag1.30:0.4":"Uttiyattheragāthā","thag1.30:1.1":"“Ābādhe me samuppanne, sati me udapajjatha;","thag1.30:1.3":"Ābādho me samuppanno, kālo me nappamajjitun”ti.","thag1.30:1.5":"… Uttiyo thero ….","thag1.30:1.6":"Vaggo tatiyo niṭṭhito.","thag1.30:2.0":"Tassuddānaṃ –","thag1.30:2.1":"Nigrodho cittako thero, gosālathero sugandho;","thag1.30:2.3":"Nandiyo abhayo thero, thero lomasakaṅgiyo;","thag1.30:2.5":"Jambugāmikaputto ca, hārito uttiyo isīti."},"attha":null,"tika":null}
