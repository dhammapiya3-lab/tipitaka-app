{"suttaId":"an4.69","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[795,801],"vripara":"69"},"segments":{"an4.69:0.3":"Padhānasuttaṃ","an4.69:1.1":"“Cattārimāni, bhikkhave, padhānāni.","an4.69:1.2":"Katamāni cattāri?","an4.69:1.3":"Saṃvarappadhānaṃ, pahānappadhānaṃ, bhāvanāppadhānaṃ, anurakkhaṇāppadhānaṃ.","an4.69:1.4":"Katamañca, bhikkhave, saṃvarappadhānaṃ?","an4.69:1.5":"Idha, bhikkhave, bhikkhu anuppannānaṃ pāpakānaṃ akusalānaṃ dhammānaṃ anuppādāya chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati.","an4.69:1.6":"Idaṃ vuccati, bhikkhave, saṃvarappadhānaṃ.","an4.69:2.1":"“Katamañca, bhikkhave, pahānappadhānaṃ?","an4.69:2.2":"Idha, bhikkhave, bhikkhu uppannānaṃ pāpakānaṃ akusalānaṃ dhammānaṃ pahānāya chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati.","an4.69:2.3":"Idaṃ vuccati, bhikkhave, pahānappadhānaṃ.","an4.69:3.1":"“Katamañca, bhikkhave, bhāvanāppadhānaṃ?","an4.69:3.2":"Idha, bhikkhave, bhikkhu anuppannānaṃ kusalānaṃ dhammānaṃ uppādāya chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati.","an4.69:3.3":"Idaṃ vuccati, bhikkhave, bhāvanāppadhānaṃ.","an4.69:4.1":"“Katamañca, bhikkhave, anurakkhaṇāppadhānaṃ?","an4.69:4.2":"Idha, bhikkhave, bhikkhu uppannānaṃ kusalānaṃ dhammānaṃ ṭhitiyā asammosāya bhiyyobhāvāya vepullāya bhāvanāya pāripūriyā chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati.","an4.69:4.3":"Idaṃ vuccati, bhikkhave, anurakkhaṇāppadhānaṃ.","an4.69:4.4":"Imāni kho, bhikkhave, cattāri padhānānī”ti.","an4.69:5.1":"“Saṃvaro ca pahānañca,","an4.69:5.2":"bhāvanā anurakkhaṇā;","an4.69:5.3":"Ete padhānā cattāro,","an4.69:5.4":"desitādiccabandhunā;","an4.69:5.5":"Yo hi [yehi (?)] bhikkhu idhātāpī,","an4.69:5.6":"khayaṃ dukkhassa pāpuṇe”ti.","an4.69:5.7":"navamaṃ;"},"unsure":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1305,"to":1305,"paras":[{"para":1305,"vripara":"69","refs":["an4.69:1"],"lines":["Navame kilesānaṃ saṃvaratthāya pavesanadvāraṃ pidahanatthāya padhānaṃ <b>saṃvarappadhānaṃ,</b> pajahanatthāya padhānaṃ <b>pahānappadhānaṃ,</b> kusalānaṃ dhammānaṃ brūhanatthāya vaḍḍhanatthāya padhānaṃ <b>bhāvanāppadhānaṃ,</b> tesaṃyeva anurakkhaṇatthāya padhānaṃ <b>anurakkhaṇāppadhānaṃ</b>."],"lineRefs":[["an4.69:1"]]}],"wordLinks":[["an4.69:1.3","anurakkhaṇāppadhānaṃ",0,0],["an4.69:1.3","bhāvanāppadhānaṃ",0,0],["an4.69:1.3","pahānappadhānaṃ",0,0],["an4.69:1.3","saṃvarappadhānaṃ",0,0],["an4.69:1.4","saṃvarappadhānaṃ",0,0],["an4.69:1.6","saṃvarappadhānaṃ",0,0]],"before":[{"para":1304,"vripara":null,"refs":[],"lines":["Padhānasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1482,"to":1482,"paras":[{"para":1482,"vripara":"69","refs":["an4.69:1"],"lines":["Navame padahati etehīti <b>padhānāni.</b>","<b>Uttamavīriyāni</b> seṭṭhavīriyāni visiṭṭhassa atthassa sādhanato.","<b>Kilesānaṃ saṃvaratthāyā</b>ti yathā abhijjhādayo na uppajjanti, evaṃ satiyā upaṭṭhānena kilesānaṃ saṃvaraṇatthāya.","<b>Pajahanatthāyā</b>ti kāmavitakkādīnaṃ vinodanatthāya.","<b>Padhānan</b>ti tasseva pajahanassa sādhanavasena pavattavīriyaṃ.","<b>Kusalānaṃ dhammānaṃ brūhanatthāyā</b>ti bojjhaṅgasaṅkhātānaṃ kusaladhammānaṃ vaḍḍhanatthāya.","<b>Padhānan</b>ti tasseva vaḍḍhanassa sādhanavasena pavattavīriyaṃ."],"lineRefs":[["an4.69:1"],["an4.69:1"],["an4.69:1"],["an4.69:1"],["an4.69:1"],["an4.69:1"],["an4.69:1"]]}],"wordLinks":[["an4.69:1.1","padhānāni",0,0],["an4.69:1.3","padhānaṃ",0,4],["an4.69:1.4","padhānaṃ",0,4],["an4.69:1.6","padhānaṃ",0,4],["an4.69:1.3","padhānaṃ",0,6],["an4.69:1.4","padhānaṃ",0,6],["an4.69:1.6","padhānaṃ",0,6]],"before":[{"para":1480,"vripara":null,"refs":[],"lines":["Devadattasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":1481,"vripara":null,"refs":[],"lines":["Padhānasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
