{"suttaId":"thig1.13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[67,70],"vripara":"13"},"segments":{"thig1.13:0.3":"Visākhātherīgāthā","thig1.13:1.1":"“Karotha buddhasāsanaṃ,","thig1.13:1.2":"yaṃ katvā nānutappati;","thig1.13:1.3":"Khippaṃ pādāni dhovitvā,","thig1.13:1.4":"ekamante nisīdathā”ti. …","thig1.13:2.1":"Visākhā therī…. 14."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":230,"to":230,"paras":[{"para":230,"vripara":null,"refs":["thig1.13:1"],"lines":["Tattha <b>karotha buddhasāsana</b>nti buddhasāsanaṃ ovādaanusiṭṭhiṃ karotha, yathānusiṭṭhaṃ paṭipajjathāti attho.","<b>Yaṃ katvā nānutappatī</b>ti anusiṭṭhiṃ katvā karaṇahetu na anutappati takkarassa sammadeva adhippāyānaṃ samijjhanato.","<b>Khippaṃ pādāni dhovitvā, ekamante nisīdathā</b>ti idaṃ yasmā sayaṃ pacchābhattaṃ piṇḍapātapaṭikkantā ācariyupajjhāyānaṃ vattaṃ dassetvā attano divāṭṭhāne pāde dhovitvā raho nisinnā sadatthaṃ matthakaṃ pāpesi, tasmā tattha aññepi niyojentī avoca."],"lineRefs":[["thig1.13:1"],["thig1.13:1"],["thig1.13:1"]]}],"wordLinks":[["thig1.13:1.1","karotha buddhasāsanaṃ",0,0],["thig1.13:1.1","yaṃ katvā nānutappatī",0,1],["thig1.13:1.3","khippaṃ pādāni dhovitvā ekamante nisīdathā",0,2]],"before":[{"para":224,"vripara":null,"title":"Visākhātherīgāthāvaṇṇanā","lines":["Visākhātherīgāthāvaṇṇanā"]},{"para":225,"vripara":null,"title":"Visākhātherīgāthāvaṇṇanā","lines":["<b>Karotha</b> <b>buddhasāsana</b>nti visākhāya theriyā gāthā.","Tassā vatthu dhīrātheriyāvatthusadisameva.","Sā arahattaṃ patvā vimuttisukhena vītināmentī – 13."]},{"para":227,"vripara":"13","title":"Visākhātherīgāthāvaṇṇanā","lines":["“Karotha buddhasāsanaṃ, yaṃ katvā nānutappati;"]},{"para":228,"vripara":null,"title":"Visākhātherīgāthāvaṇṇanā","lines":["Khippaṃ pādāni dhovitvā, ekamante nisīdathā”ti. –"]},{"para":229,"vripara":null,"title":"Visākhātherīgāthāvaṇṇanā","lines":["Imāya gāthāya aññaṃ byākāsi.