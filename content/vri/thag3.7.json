{"suttaId":"thag3.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1207,1216],"vripara":"237"},"segments":{"thag3.7:0.4":"Vāraṇattheragāthā","thag3.7:1.1":"“Yodha koci manussesu, parapāṇāni hiṃsati;","thag3.7:1.3":"Asmā lokā paramhā ca, ubhayā dhaṃsate naro.","thag3.7:2.1":"“Yo ca mettena cittena, sabbapāṇānukampati;","thag3.7:2.3":"Bahuñhi so pasavati, puññaṃ tādisako naro.","thag3.7:3.1":"“Subhāsitassa sikkhetha, samaṇūpāsanassa ca;","thag3.7:3.3":"Ekāsanassa ca raho, cittavūpasamassa cā”ti.","thag3.7:3.5":"… Vāraṇo thero …."},"attha":null,"tika":null}
