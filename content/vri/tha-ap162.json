{"suttaId":"tha-ap162","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6619,6645],"vripara":"51"},"segments":{"tha-ap162:0.3":"Kumudadāyakattheraapadānaṃ","tha-ap162:1.1":"“Himavantassāvidūre,","tha-ap162:1.2":"mahājātassaro ahu;","tha-ap162:1.3":"Padumuppalasañchanno,","tha-ap162:1.4":"puṇḍarīkasamotthaṭo. 52.","tha-ap162:2.1":"“Kukuttho nāma nāmena,","tha-ap162:2.2":"tatthāsiṃ sakuṇo tadā;","tha-ap162:2.3":"Sīlavā buddhisampanno,","tha-ap162:2.4":"puññāpuññesu kovido. 53.","tha-ap162:3.1":"“Padumuttaro lokavidū,","tha-ap162:3.2":"āhutīnaṃ paṭiggaho;","tha-ap162:3.3":"Jātassarassāvidūre,","tha-ap162:3.4":"sañcarittha mahāmuni. 54.","tha-ap162:4.1":"“Jalajaṃ kumudaṃ chetvā,","tha-ap162:4.2":"upanesiṃ mahesino;","tha-ap162:4.3":"Mama saṅkappamaññāya,","tha-ap162:4.4":"paṭiggahi mahāmuni. 55.","tha-ap162:5.1":"“Tañca dānaṃ daditvāna,","tha-ap162:5.2":"sukkamūlena codito;","tha-ap162:5.3":"Kappānaṃ satasahassaṃ,","tha-ap162:5.4":"duggatiṃ nupapajjahaṃ. 56.","tha-ap162:6.1":"“Soḷaseto kappasate,","tha-ap162:6.2":"āsuṃ varuṇanāmakā;","tha-ap162:6.3":"Aṭṭha ete janādhipā,","tha-ap162:6.4":"cakkavattī mahabbalā. 57.","tha-ap162:7.1":"“Paṭisambhidā catasso…pe…","tha-ap162:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap162:8.1":"Itthaṃ sudaṃ āyasmā kumudadāyako thero imā gāthāyo abhāsitthāti.","tha-ap162:9.1":"Kumudadāyakattherassāpadānaṃ dasamaṃ.","tha-ap162:10.1":"Bandhujīvakavaggo soḷasamo.","tha-ap162:11.1":"Tassuddānaṃ –","tha-ap162:12.1":"Bandhujīvo tambapupphī,","tha-ap162:12.2":"vīthikakkārupupphiyo;","tha-ap162:12.3":"Mandāravo kadambī ca,","tha-ap162:12.4":"sūlako nāgapupphiyo;","tha-ap162:12.5":"Punnāgo komudī gāthā,","tha-ap162:12.6":"chappaññāsa pakittitāti. 17."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3072,"to":3072,"paras":[{"para":3072,"vripara":"51","refs":["tha-ap162:1"],"lines":["So tena puññena devamanussesu ubhayasampattisukhaṃ anubhavitvā imasmiṃ buddhuppāde sāvatthiyaṃ aññatarasmiṃ kule nibbatto vuddhimanvāya mahaddhano mahābhogo ratanattaye pasanno satthu dhammadesanaṃ sutvā paṭiladdhasaddho pabbajitvā nacirasseva arahā hutvā attano pubbakammaṃ paccakkhato ñatvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>himavantassāvidūre</b>tiādimāha.","<b>Padumuppalasañchanno</b>ti ettha satapattehi sampuṇṇo setapadumo ca tīṇi nīlarattasetuppalāni ca padumuppalāni tehi sañchanno gahanībhūto sampuṇṇo mahājātassaro ahūti sambandho.","<b>Puṇḍarīkasamotthaṭo</b>ti puṇḍarīkehi rattapadumehi otthaṭo sampuṇṇoti attho.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap162:1"],["tha-ap162:1"],["tha-ap162:1"],["tha-ap162:1"]]}],"wordLinks":[["tha-ap162:1.1","himavantassāvidūre",0,0],["tha-ap162:1.3","padumuppalasañchanno",0,1],["tha-ap162:1.3","puṇḍarīkasamotthaṭo",0,2]],"before":[{"para":3070,"vripara":null,"title":"Kumudadāyakattheraapadānavaṇṇanā","lines":["Kumudadāyakattheraapadānavaṇṇanā"]},{"para":3071,"vripara":null,"title":"Kumudadāyakattheraapadānavaṇṇanā","lines":["<b>Himavantassāvidūre</b>tiādikaṃ āyasmato kumudadāyakattherassa apadānaṃ.","Ayampi thero purimabuddhesu katādhikāro anekesu bhavesu vivaṭṭūpanissayāni puññāni upacinanto padumuttarassa bhagavato kāle himavantassa āsanne mahante jātassare kukuttho nāma pakkhī hutvā nibbatto kenaci akusalena pakkhī samānopi pubbe katasambhārena buddhisampanno puññāpuññesu cheko sīlavā pāṇagocarato paṭivirato ahosi.","Tasmiṃ samaye padumuttaro bhagavā ākāsenāgantvā tassa samīpe caṅkamati.","Atha so sakuṇo bhagavantaṃ disvā pasannacitto kumudapupphaṃ ḍaṃsitvā bhagavato pādamūle pūjesi.","Bhagavā tassa somanassuppādanatthaṃ paṭiggahetvā anumodanamakāsi. 51."]}],"after":[{"para":3073,"vripara":null,"title":"Kumudadāyakattheraapadānavaṇṇanā","lines":["Kumudadāyakattheraapadānavaṇṇanā samattā."]},{"para":3074,"vripara":null,"title":"Kumudadāyakattheraapadānavaṇṇanā","lines":["Soḷasamavaggavaṇṇanā samattā. 17."]}]},"tika":null,"tika2":null}
