{"suttaId":"thig4.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[280,293],"vripara":"63"},"segments":{"thig4.1:0.3":"Bhaddākāpilānītherīgāthā","thig4.1:1.1":"“Putto buddhassa dāyādo,","thig4.1:1.2":"kassapo susamāhito;","thig4.1:1.3":"Pubbenivāsaṃ yovedi,","thig4.1:1.4":"saggāpāyañca passati.","thig4.1:2.1":"“Atho jātikkhayaṃ patto,","thig4.1:2.2":"abhiññāvosito muni;","thig4.1:2.3":"Etāhi tīhi vijjāhi,","thig4.1:2.4":"tevijjo hoti brāhmaṇo.","thig4.1:3.1":"“Tatheva bhaddā kāpilānī,","thig4.1:3.2":"tevijjā maccuhāyinī;","thig4.1:3.3":"Dhāreti antimaṃ dehaṃ,","thig4.1:3.4":"jetvā māraṃ savāhanaṃ.","thig4.1:4.1":"“Disvā ādīnavaṃ loke,","thig4.1:4.2":"ubho pabbajitā mayaṃ;","thig4.1:4.3":"Tyamha khīṇāsavā dantā,","thig4.1:4.4":"sītibhūtamha nibbutā”ti.","thig4.1:5.1":"… Bhaddā kāpilānī therī ….","thig4.1:6.1":"Catukkanipāto niṭṭhito."},"unsure":[],"preface":[],"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":1104,"to":1104,"paras":[{"para":1104,"vripara":null,"refs":["thig4.1:4"],"lines":["Idāni yathā therassa paṭipatti ādimajjhapariyosānakalyāṇā, evaṃ mamapīti dassentī <b>“disvā ādīnavan”</b>ti osānagāthamāha.","Tattha <b>tyamha khīṇāsavā dantā</b>ti te mayaṃ mahākassapatthero ahañca uttamena damena dantā sabbaso khīṇāsavā ca amha.","<b>Sītibhūtāmha nibbutā</b>ti tato eva kilesapariḷāhābhāvato sītibhūtā saupādisesāya nibbānadhātuyā nibbutā ca amha bhavāmāti attho."],"lineRefs":[["thig4.1:4"],["thig4.1:4"],["thig4.1:4"]]}],"wordLinks":[["thig4.1:4.1","disvā ādīnavaṃ",0,0],["thig4.1:4.3","tyamha khīṇāsavā dantā",0,1]],"before":[{"para":949,"vripara":null,"title":"Catukkanipāto","lines":["Catukkanipāto"]},{"para":950,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Bhaddākāpilānītherīgāthāvaṇṇanā"]},{"para":951,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Catukkanipāte <b>putto buddhassa dāyādo</b>tiādikā bhaddāya kāpilāniyā theriyā gāthā.","Sā kira padumuttarassa bhagavato kāle haṃsavatīnagare kulagehe nibbattitvā viññutaṃ patvā satthu santike dhammaṃ suṇantī satthāraṃ ekaṃ bhikkhuniṃ pubbenivāsaṃ anussarantīnaṃ aggaṭṭhāne ṭhapentaṃ disvā adhikārakammaṃ katvā sayampi taṃ ṭhānantaraṃ patthetvā yāvajīvaṃ puññāni katvā tato cutā devamanussesu saṃsarantī anuppanne buddhe bārāṇasiyaṃ kulagehe nibbattitvā patikulaṃ gantvā, ekadivasaṃ attano nanandāya saddhiṃ kalahaṃ karontī tāya paccekabuddhassa piṇḍapāte dinne “ayaṃ imassa dānaṃ datvā uḷārasampattiṃ labhissatī”ti paccekabuddhassa hatthato pattaṃ gahetvā bhattaṃ chaḍḍetvā kalalassa pūretvā adāsi.","Mahājano garahi –","“bāle, paccekabuddho te kiṃ aparajjhī”ti?","Sā tesaṃ vacanena lajjamānā puna pattaṃ gahetvā kalalaṃ nīharitvā dhovitvā gandhacuṇṇena ubbaṭṭetvā catumadhurassa pūretvā upari āsittena padumagabbhavaṇṇena sappinā vijjotamānaṃ paccekabuddhassa hatthe ṭhapetvā “yathā ayaṃ piṇḍapāto obhāsajāto, evaṃ obhāsajātaṃ me sarīraṃ hotū”ti patthanaṃ paṭṭhapesi.","Sā tato cavitvā sugatīsuyeva saṃsarantī kassapabuddhakāle bārāṇasiyaṃ mahāvibhavassa seṭṭhino dhītā hutvā nibbatti.","Pubbakammaphalena duggandhasarīrā manussehi jigucchitabbā hutvā saṃvegajātā attano ābharaṇehi suvaṇṇiṭṭhakaṃ kāretvā bhagavato cetiye patiṭṭhapesi, uppalahatthena ca pūjaṃ akāsi.","Tenassā sarīraṃ tasmiṃyeva bhave sugandhaṃ manoharaṃ jātaṃ.","Sā patino piyā manāpā hutvā yāvajīvaṃ kusalaṃ katvā tato cutā sagge nibbatti.","Tatthāpi yāvajīvaṃ dibbasukhaṃ anubhavitvā, tato cutā bārāṇasirañño dhītā hutvā tattha devasampattisadisaṃ sampattiṃ anubhavantī cirakālaṃ paccekabuddhe upaṭṭhahitvā, tesu parinibbutesu saṃvegajātā tāpasapabbajjāya pabbajitvā uyyāne vasantī jhānāni bhāvetvā brahmaloke nibbattitvā tato cutā sāgalanagare kosiyagottassa brāhmaṇakulassa gehe nibbattitvā mahatā parihārena vaḍḍhitvā vayappattā mahātitthagāme pipphalikumārassa gehaṃ nītā.","Tasmiṃ pabbajituṃ nikkhante mahantaṃ bhogakkhandhaṃ mahantañca ñātiparivaṭṭaṃ pahāya pabbajjatthāya nikkhamitvā pañca vassāni titthiyārāme pavisitvā aparabhāge mahāpajāpatigotamiyā santike pabbajjaṃ upasampadañca labhitvā vipassanaṃ paṭṭhapetvā na cirasseva arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.3.244-313)–"]},{"para":952,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Padumuttaro nāma jino, sabbadhammāna pāragū;"]},{"para":953,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Ito satasahassamhi, kappe uppajji nāyako."]},{"para":954,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tadāhu haṃsavatiyaṃ, videho nāma nāmato;"]},{"para":955,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Seṭṭhī pahūtaratano, tassa jāyā ahosahaṃ."]},{"para":956,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Kadāci so narādiccaṃ, upecca saparijjano;"]},{"para":957,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Dhammamassosi buddhassa, sabbadukkhabhayappahaṃ."]},{"para":958,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Sāvakaṃ dhutavādānaṃ, aggaṃ kittesi nāyako;"]},{"para":959,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Sutvā sattāhikaṃ dānaṃ, datvā buddhassa tādino."]},{"para":960,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Nipacca sirasā pāde, taṃ ṭhānamabhipatthayiṃ;"]},{"para":961,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Sa hāsayanto parisaṃ, tadā hi narapuṅgavo."]},{"para":962,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Seṭṭhino anukampāya, imā gāthā abhāsatha;"]},{"para":963,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Lacchase patthitaṃ ṭhānaṃ, nibbuto hohi puttaka."]},{"para":964,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Satasahassito kappe, okkākakulasambhavo;"]},{"para":965,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Gotamo nāma gottena, satthā loke bhavissati."]},{"para":966,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tassa dhammesu dāyādo, oraso dhammanimmito;"]},{"para":967,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Kassapo nāma gottena, hessati satthu sāvako."]},{"para":968,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Taṃ sutvā mudito hutvā, yāvajīvaṃ tadā jinaṃ;"]},{"para":969,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Mettacitto paricari, paccayehi vināyakaṃ."]},{"para":970,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Sāsanaṃ jotayitvāna, so madditvā kutitthiye;"]},{"para":971,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Veneyyaṃ vinayitvā ca, nibbuto so sasāvako."]},{"para":972,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Nibbute tamhi lokagge, pūjanatthāya satthuno;"]},{"para":973,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Ñātimitte samānetvā, saha tehi akārayi."]},{"para":974,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Sattayojanikaṃ thūpaṃ, ubbiddhaṃ ratanāmayaṃ;"]},{"para":975,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Jalantaṃ sataraṃsiṃva, sālarājaṃva phullitaṃ."]},{"para":976,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Sattasatasahassāni, pātiyo tattha kārayi;"]},{"para":977,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Naḷaggī viya jotantī, rataneheva sattahi."]},{"para":978,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Gandhatelena pūretvā, dīpānujjalayī tahiṃ;"]},{"para":979,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Pūjanatthāya mahesissa, sabbabhūtānukampino."]},{"para":980,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Sattasatasahassāni, puṇṇakumbhāni kārayi;"]},{"para":981,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Rataneheva puṇṇāni, pūjanatthāya mahesino."]},{"para":982,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Majjhe aṭṭhaṭṭhakumbhīnaṃ, ussitā kañcanagghiyo;"]},{"para":983,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Atirocanti vaṇṇena, saradeva divākaro."]},{"para":984,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Catudvāresu sobhanti, toraṇā ratanāmayā;"]},{"para":985,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Ussitā phalakā rammā, sobhanti ratanāmayā."]},{"para":986,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Virocanti parikkhittā, avaṭaṃsā sunimmitā;"]},{"para":987,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Ussitāni paṭākāni, ratanāni virocare."]},{"para":988,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Surattaṃ sukataṃ cittaṃ, cetiyaṃ ratanāmayaṃ;"]},{"para":989,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Atirocati vaṇṇena, sasañjhova divākaro."]},{"para":990,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Thūpassa vediyo tisso, haritālena pūrayi;"]},{"para":991,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Ekaṃ manosilāyekaṃ, añjanena ca ekikaṃ."]},{"para":992,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Pūjaṃ etādisaṃ rammaṃ, kāretvā varavādino;"]},{"para":993,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Adāsi dānaṃ saṅghassa, yāvajīvaṃ yathābalaṃ."]},{"para":994,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Sahāva seṭṭhinā tena, tāni puññāni sabbaso;"]},{"para":995,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Yāvajīvaṃ karitvāna, sahāva sugatiṃ gatā."]},{"para":996,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Sampattiyonubhotvāna, devatte atha mānuse;"]},{"para":997,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Chāyā viya sarīrena, saha teneva saṃsariṃ."]},{"para":998,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Ekanavutito kappe, vipassī nāma nāyako;"]},{"para":999,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Uppajji cārudassano, sabbadhammavipassako."]},{"para":1000,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tadāyaṃ bandhupatiyaṃ, brāhmaṇo sādhusammato;"]},{"para":1001,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Aḍḍho santo guṇenāpi, dhanena ca suduggato."]},{"para":1002,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tadāpi tassāhaṃ āsiṃ, brāhmaṇī samacetasā;"]},{"para":1003,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Kadāci so dijavaro, saṅgamesi mahāmuniṃ."]},{"para":1004,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Nisinnaṃ janakāyamhi, desentaṃ amataṃ padaṃ;"]},{"para":1005,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Sutvā dhammaṃ pamudito, adāsi ekasāṭakaṃ."]},{"para":1006,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Gharamekena vatthena, gantvānetaṃ sa mabravi;"]},{"para":1007,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Anumoda mahāpuññaṃ, dinnaṃ buddhassa sāṭakaṃ."]},{"para":1008,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tadāhaṃ añjaliṃ katvā, anumodiṃ supīṇitā;"]},{"para":1009,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Sudinno sāṭako sāmi, buddhaseṭṭhassa tādino."]},{"para":1010,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Sukhito sajjito hutvā, saṃsaranto bhavābhave;"]},{"para":1011,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Bārāṇasipure ramme, rājā āsi mahīpati."]},{"para":1012,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tadā tassa mahesīhaṃ, itthigumbassa uttamā;"]},{"para":1013,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Tassāti dayitā āsiṃ, pubbasnehena bhattuno."]},{"para":1014,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Piṇḍāya vicarante te, aṭṭha paccekanāyake;"]},{"para":1015,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Disvā pamudito hutvā, datvā piṇḍaṃ mahārahaṃ."]},{"para":1016,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Puno nimantayitvāna, katvā ratanamaṇḍapaṃ;"]},{"para":1017,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Kammārehi kataṃ pattaṃ, sovaṇṇaṃ vata tattakaṃ."]},{"para":1018,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Samānetvāna te sabbe, tesaṃ dānamadāsi so;"]},{"para":1019,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Soṇṇāsane paviṭṭhānaṃ, pasanno sehi pāṇibhi."]},{"para":1020,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tampi dānaṃ sahādāsiṃ, kāsirājenahaṃ tadā;"]},{"para":1021,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Punāhaṃ bārāṇasiyaṃ, jātā kāsikagāmake."]},{"para":1022,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Kuṭumbikakule phīte, sukhito so sabhātuko;"]},{"para":1023,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Jeṭṭhassa bhātuno jāyā, ahosiṃ supatibbatā."]},{"para":1024,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Paccekabuddhaṃ disvāna, kaniyassa mama bhattuno;"]},{"para":1025,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Bhāgannaṃ tassa datvāna, āgate tamhi pāvadiṃ."]},{"para":1026,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Nābhinandittha so dānaṃ, tato tassa adāsahaṃ;"]},{"para":1027,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Ukhā āniya taṃ annaṃ, puno tasseva so adā."]},{"para":1028,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tadannaṃ chaḍḍayitvāna, duṭṭhā buddhassahaṃ tadā;"]},{"para":1029,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Pattaṃ kalalapuṇṇaṃ taṃ, adāsiṃ tassa tādino."]},{"para":1030,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Dāne ca gahaṇe ceva, apace padusepi ca;"]},{"para":1031,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Samacittamukhaṃ disvā, tadāhaṃ saṃvijiṃ bhusaṃ."]},{"para":1032,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Puno pattaṃ gahetvāna, sodhayitvā sugandhinā,"]},{"para":1033,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Pasannacittā pūretvā, saghataṃ sakkaraṃ adaṃ."]},{"para":1034,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Yattha yatthūpapajjāmi, surūpā homi dānato;"]},{"para":1035,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Buddhassa apakārena, duggandhā vadanena ca."]},{"para":1036,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Puna kassapavīrassa, nidhāyantamhi cetiye;"]},{"para":1037,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Sovaṇṇaṃ iṭṭhakaṃ varaṃ, adāsiṃ muditā ahaṃ."]},{"para":1038,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Catujjātena gandhena, nicayitvā tamiṭṭhakaṃ;"]},{"para":1039,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Muttā duggandhadosamhā, sabbaṅgasusamāgatā."]},{"para":1040,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Satta pātisahassāni, rataneheva sattahi;"]},{"para":1041,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Kāretvā ghatapūrāni, vaṭṭīni ca sahassaso."]},{"para":1042,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Pakkhipitvā padīpetvā, ṭhapayiṃ sattapantiyo;"]},{"para":1043,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Pūjanatthaṃ lokanāthassa, vippasannena cetasā."]},{"para":1044,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tadāpi tamhi puññamhi, bhāginīyi visesato;"]},{"para":1045,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Puna kāsīsu sañjāto, sumittā iti vissuto."]},{"para":1046,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tassāhaṃ bhariyā āsiṃ, sukhitā sajjitā piyā;"]},{"para":1047,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Tadā paccekamunino, adāsiṃ ghanaveṭhanaṃ."]},{"para":1048,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tassāpi bhāginī āsiṃ, moditvā dānamuttamaṃ;"]},{"para":1049,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Punāpi kāsiraṭṭhamhi, jāto koliyajātiyā."]},{"para":1050,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tadā koliyaputtānaṃ, satehi saha pañcahi;"]},{"para":1051,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Pañca paccekabuddhānaṃ, satāni samupaṭṭhahi."]},{"para":1052,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Temāsaṃ tappayitvāna, adāsi ca ticīvare;"]},{"para":1053,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Jāyā tassa tadā āsiṃ, puññakammapathānugā."]},{"para":1054,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tato cuto ahu rājā, nando nāma mahāyaso;"]},{"para":1055,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Tassāpi mahesī āsiṃ, sabbakāmasamiddhinī."]},{"para":1056,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tadā rājā bhavitvāna, brahmadatto mahīpati;"]},{"para":1057,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Padumavatīputtānaṃ, paccekamuninaṃ tadā."]},{"para":1058,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Satāni pañcanūnāni, yāvajīvaṃ upaṭṭhahiṃ;"]},{"para":1059,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Rājuyyāne nivāsetvā, nibbutāni ca pūjayiṃ."]},{"para":1060,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Cetiyāni ca kāretvā, pabbajitvā ubho mayaṃ;"]},{"para":1061,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Bhāvetvā appamaññāyo, brahmalokaṃ agamhase."]},{"para":1062,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tato cuto mahātitthe, sujāto pipphalāyano;"]},{"para":1063,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Mātā sumanadevīti, kosigotto dijo pitā."]},{"para":1064,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Ahaṃ madde janapade, sākalāya puruttame;"]},{"para":1065,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Kappilassa dijassāsiṃ, dhītā mātā sucīmati."]},{"para":1066,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Gharakañcanabimbena, nimminitvāna maṃ pitā;"]},{"para":1067,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Adā kassapadhīrassa, kāmehi vajjitassamaṃ."]},{"para":1068,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Kadāci so kāruṇiko, gantvā kammantapekkhako;"]},{"para":1069,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Kākādikehi khajjante, pāṇe disvāna saṃviji."]},{"para":1070,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Gharevāhaṃ tile jāte, disvānātapatāpane;"]},{"para":1071,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Kimī kākehi khajjante, saṃvegamalabhiṃ tadā."]},{"para":1072,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tadā so pabbajī dhīro, ahaṃ tamanupabbajiṃ;"]},{"para":1073,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Pañca vassāni nivasiṃ, paribbājavate ahaṃ."]},{"para":1074,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Yadā pabbajitā āsi, gotamī jinaposikā;"]},{"para":1075,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Tadāhaṃ tamupagantvā, buddhena anusāsitā."]},{"para":1076,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Na cireneva kālena, arahattamapāpuṇiṃ;"]},{"para":1077,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Aho kalyāṇamittattaṃ, kassapassa sirīmato."]},{"para":1078,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Suto buddhassa dāyādo, kassapo susamāhito;"]},{"para":1079,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Pubbenivāsaṃ yo vedi, saggāpāyañca passati."]},{"para":1080,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Atho jātikkhayaṃ patto, abhiññāvosito muni;"]},{"para":1081,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Etāhi tīhi vijjāhi, tevijjo hoti brāhmaṇo."]},{"para":1082,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tatheva bhaddākāpilānī, tevijjā maccuhāyinī;"]},{"para":1083,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Dhāreti antimaṃ dehaṃ, jitvā māraṃ savāhanaṃ."]},{"para":1084,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Disvā ādīnavaṃ loke, ubho pabbajitā mayaṃ;"]},{"para":1085,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Tyamha khīṇāsavā dantā, sītibhūtāmha nibbutā."]},{"para":1086,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti.(apa. therī 2.3.244-313);"]},{"para":1087,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Arahattaṃ pana patvā pubbenivāsañāṇe ciṇṇavasī ahosi.","Tattha sātisayaṃ katādhikārattā aparabhāge taṃ satthā jetavane ariyagaṇamajjhe nisinno bhikkhuniyo paṭipāṭiyā ṭhānantaresu ṭhapento pubbenivāsaṃ anussarantīnaṃ aggaṭṭhāne ṭhapesi.","Sā ekadivasaṃ mahākassapattherassa guṇābhitthavanapubbakaṃ attano katakiccatādivibhāvanamukhena udānaṃ udānentī –"]},{"para":1089,"vripara":"63","title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Putto buddhassa dāyādo, kassapo susamāhito;"]},{"para":1090,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Pubbenivāsaṃ yovedi, saggāpāyañca passati."]},{"para":1092,"vripara":"64","title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Atho jātikkhayaṃ patto, abhiññāvosito muni;"]},{"para":1093,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Etāhi tīhi vijjāhi, tevijjo hoti brāhmaṇo."]},{"para":1095,"vripara":"65","title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Tatheva bhaddākāpilānī, tevijjā maccuhāyinī;"]},{"para":1096,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Dhāreti antimaṃ dehaṃ, jetvā māraṃ savāhanaṃ."]},{"para":1098,"vripara":"66","title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["“Disvā ādīnavaṃ loke, ubho pabbajitā mayaṃ;"]},{"para":1099,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Tyamha khīṇāsavā dantā, sītibhūtāmha nibbutā”ti.","–"]},{"para":1100,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Imā gāthā abhāsi."]},{"para":1101,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Tattha <b>putto buddhassa dāyādo</b>ti buddhānubuddhabhāvato sammāsambuddhassa anujātasuto tato eva tassa dāyabhūtassa navalokuttaradhammassa ādānena dāyādo kassapo lokiyalokuttarehi samādhīhi suṭṭhu samāhitacittatāya <b>susamāhito.</b>","<b>Pubbenivāsaṃ yovedī</b>ti yo mahākassapatthero pubbenivāsaṃ attano paresañca nivutthakkhandhasantānaṃ pubbenivāsānussatiñāṇena pākaṭaṃ katvā avedi aññāsi paṭivijjhi.","<b>Saggāpāyañca passatī</b>ti chabbīsatidevalokabhedaṃ saggaṃ catubbidhaṃ apāyañca dibbacakkhunā hatthatale āmalakaṃ viya passati."]},{"para":1102,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["<b>Atho jātikkhayaṃ patto</b>ti tato paraṃ jātikkhayasaṅkhātaṃ arahattaṃ patto.","<b>Abhiññāya</b> abhivisiṭṭhena ñāṇena abhiññeyyaṃ dhammaṃ abhijānitvā pariññeyyaṃ parijānitvā, pahātabbaṃ pahāya, sacchikātabbaṃ sacchikatvā <b>vosito</b> niṭṭhaṃ patto katakicco.","Āsavakkhayapaññāsaṅkhātaṃ monaṃ pattattā <b>muni</b>."]},{"para":1103,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["<b>Tatheva bhaddākāpilānī</b>ti yathā mahākassapo etāhi yathāvuttāhi tīhi vijjāhi tevijjo maccuhāyī ca, tatheva bhaddākāpilānī tevijjā maccuhāyinīti.","Tato eva <b>dhāreti antimaṃ dehaṃ, jetvā māraṃ savāhanan</b>ti attānameva paraṃ viya katvā dasseti."]}],"after":[{"para":1105,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Bhaddākāpilānītherīgāthāvaṇṇanā niṭṭhitā."]},{"para":1106,"vripara":null,"title":"Bhaddākāpilānītherīgāthāvaṇṇanā","lines":["Catukkanipātavaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
