{"suttaId":"ja235","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1597,1604],"vripara":"169"},"segments":{"ja235:0.4":"Vacchanakhajātakaṃ (2-9-5)","ja235:1.1":"Sukhā gharā vacchanakha,","ja235:1.2":"sahiraññā sabhojanā;","ja235:1.3":"Yattha bhutvā pivitvā ca,","ja235:1.4":"sayeyyātha anussuko. 170.","ja235:2.1":"Gharā nānīhamānassa,","ja235:2.2":"gharā nābhaṇato musā;","ja235:2.3":"Gharā nādinnadaṇḍassa,","ja235:2.4":"paresaṃ anikubbato [anikrubbato (ka.)];","ja235:2.5":"Evaṃ chiddaṃ durabhisambhavaṃ [durabhibhavaṃ (sī. pī.)],","ja235:2.6":"ko gharaṃ paṭipajjatīti.","ja235:3.1":"Vacchanakhajātakaṃ pañcamaṃ. 236."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1489,"to":1495,"paras":[{"para":1489,"vripara":null,"refs":["ja235:1"],"lines":["Tattha <b>sahiraññā</b>ti sattaratanasampannā.","<b>Sabhojanā</b>ti bahukhādanīyabhojanīyā.","<b>Yattha bhutvā pivitvā cā</b>ti yesu sahiraññabhojanesu gharesu nānaggarasāni bhojanāni paribhuñjitvā nānāpānāni ca pivitvā.","<b>Sayeyyātha anussuko</b>ti yesu alaṅkatasirisayanapiṭṭhe anussuko hutvā sayeyyāsi, te gharā nāma ativiya sukhāti."],"lineRefs":[["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"]]},{"para":1490,"vripara":null,"refs":["ja235:1"],"lines":["Athassa taṃ sutvā bodhisatto “mahāseṭṭhi, tvaṃ aññāṇatāya kāmagiddho hutvā gharāvāsassa guṇaṃ, pabbajjāya ca aguṇaṃ kathesi, gharāvāsassa te aguṇaṃ kathessāmi, suṇāhi dānī”ti vatvā dutiyaṃ gāthamāha – 170."],"lineRefs":[["ja235:1"]]},{"para":1492,"vripara":"170","refs":["ja235:1"],"lines":["“Gharā nānīhamānassa, gharā nābhaṇato musā;"],"lineRefs":[["ja235:1"]]},{"para":1493,"vripara":null,"refs":["ja235:1"],"lines":["Gharā nādinnadaṇḍassa, paresaṃ anikubbato;"],"lineRefs":[["ja235:1"]]},{"para":1494,"vripara":null,"refs":["ja235:1"],"lines":["Evaṃ chiddaṃ durabhisambhavaṃ, ko gharaṃ paṭipajjatī”ti."],"lineRefs":[["ja235:1"]]},{"para":1495,"vripara":null,"refs":["ja235:2"],"lines":["Tattha <b>gharā nānīhamānassā</b>ti niccakālaṃ kasigorakkhādikaraṇena anīhamānassa avāyamantassa gharā nāma natthi, gharāvāso na patiṭṭhātīti attho.","<b>Gharā nābhaṇato musā</b>ti khettavatthuhiraññasuvaṇṇādīnaṃ atthāya amusābhaṇatopi gharā nāma natthi.","<b>Gharā nādinnadaṇḍassa, paresaṃ anikubbato</b>ti <b>nādinnadaṇḍassā</b>ti aggahitadaṇḍassa, nikkhittadaṇḍassa paresaṃ anikubbato gharā nāma natthi.","Yo pana ādinnadaṇḍo hutvā paresaṃ dāsakammakarādīnaṃ tasmiṃ tasmiṃ aparādhe aparādhānurūpaṃ vadhabandhanachedanatāḷanādivasena karoti, tasseva gharāvāso saṇṭhahatīti attho.","<b>Evaṃ chiddaṃ durabhisambhavaṃ, ko gharaṃ paṭipajjatī</b>ti taṃ dāni evaṃ etesaṃ īhanādīnaṃ akaraṇe sati tāya tāya parihāniyā chiddaṃ karaṇepi sati niccameva kātabbato durabhisambhavaṃ durārādhanīyaṃ, niccaṃ karontassapi vā durabhisambhavameva duppūraṃ gharāvāsaṃ “ahaṃ nipparitasso hutvā ajjhāvasissāmī”ti ko paṭipajjatīti."],"lineRefs":[["ja235:2"],["ja235:2"],["ja235:2"],["ja235:2"],["ja235:2"]]}],"wordLinks":[["ja235:1.1","sahiraññā",0,0],["ja235:1.1","sabhojanā",0,1],["ja235:1.3","yattha bhutvā pivitvā cā",0,2],["ja235:1.3","sayeyyātha anussuko",0,3],["ja235:2.1","gharā nānīhamānassā",5,0],["ja235:2.1","gharā nābhaṇato musā",5,1],["ja235:2.3","gharā nādinnadaṇḍassa paresaṃ anikubbato",5,2],["ja235:2.3","nādinnadaṇḍassā",5,2],["ja235:2.5","evaṃ chiddaṃ durabhisambhavaṃ ko gharaṃ paṭipajjatī",5,4]]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":822,"to":830,"paras":[{"para":822,"vripara":null,"refs":["ja235:1"],"lines":["5-vacchanakhajātakavaṇṇanā (235)"],"lineRefs":[["ja235:1"]]},{"para":823,"vripara":null,"refs":["ja235:1"],"lines":["<b>rojamalla</b>nti rojanāmakaṃ mallarājānaṃ.","<b>ubho agāraṃ ajjhāvasissāmā</b>ti tvañca agāraṃ ajjhāvasissasi.","ahañca ajjhāvasissāmīti ubho mayaṃ agāraṃ vasissāmāti attho.","<b>pemavissāsavasenā</b>ti pemato uppannassa vissāsassavasena.","<b>sahiraññā</b>ti ettha hiraññasaddena"],"lineRefs":[["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"]]},{"para":824,"vripara":null,"refs":["ja235:1"],"lines":["footnote 1.","aṭṭhakathāyaṃ natthi."],"lineRefs":[["ja235:1"],["ja235:1"]]},{"para":825,"vripara":null,"refs":["ja235:1"],"lines":["footnote 2.anādarataṃ.","ṭṭha."],"lineRefs":[["ja235:1"],["ja235:1"]]},{"para":826,"vripara":null,"refs":["ja235:1"],"lines":["footnote 3.","ajjhāvasāma-chaṭṭha.","sabbānipi ratanāni upalakkhitāni.","tenāha — “sahiraññāti sattaratana-sampannāti.","sampannasaddena cettha sasaddassa atthaṃ dasseti.","<b>sa bhojanā</b>ti etthāpi sasaddo sampannatthova.","atisayavasena pana sampannataṃ dassetuṃ “bahukhādanīyabhojanīyā”ti vuttaṃ.","<b>anussuko</b>ti ussukkarahito.","vigatacittadukkho hutvā sayeyyāsīti attho."],"lineRefs":[["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"]]},{"para":827,"vripara":null,"refs":["ja235:1"],"lines":["<b>anīhamānassā</b>ti ettha īha-vāyāmeti dhātu.","tenāha — “avāyamantassā”ti.","<b>gharānāmā</b>ti ettha liṅgavipallāsavasena vuttaṃ.","gharāni nāmāti vuttaṃ hoti.","athavā gharasaddena gharāvāso adhippeto uttarapadalopavasena taddhitavasena vā.","tenāha — “gharāvāso na tiṭṭhatīti attho”ti.","<b>abhaṇato musā</b>ti ettha vipariyāyena atthaṃ dassetuṃ — “amusā bhaṇatopī”ti vuttaṃ.","<b>nādinnadaṇḍassā</b>ti ettha āpubbo dāsaddo ādānatthoti āha “nādinnadaṇḍassāti aggahitadaṇḍassā”ti.","gahaṇaṃ nāma nikkhipanaṃ yevāti āha “nikkhitta-daṇḍassā”ti.","<b>anikrubbato</b>ti na nikrubbato.","akarototi attho.","<b>tasmiṃ tasmi</b>nti tattha tattha aparādhe.","<b>saṇṭhahatī</b>ti saṃtiṭṭhati.","<b>durābhibhavaniya</b>nti anatikkamanīyaṃ.","niccaṃ karontassāpi durābhisambhavameva.","duppūrattā gharāvāsassāti sambandho.","<b>duppūra</b>nti pūretuṃ dukkaraṃ.","duppūraṃ gharāvāsanti idaṃ bhūmatthe upayogavacanaṃ “ajjhāvasissāmī”ti kammappavaca-nīyayogato.","duppūre gharāvāseti vuttaṃ hotīti."],"lineRefs":[["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"],["ja235:1"]]},{"para":828,"vripara":null,"refs":["ja235:1"],"lines":["ending vacchanakhajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja235:1"]]},{"para":829,"vripara":null,"refs":["ja235:1"],"lines":["footnote 1.","anikubbato-chaṭṭha."],"lineRefs":[["ja235:1"],["ja235:1"]]},{"para":830,"vripara":null,"refs":["ja235:1"],"lines":["footnote 2.","durabhisambhavaṃ-chaṭṭha."],"lineRefs":[["ja235:1"],["ja235:1"]]}],"wordLinks":[]},"tika2":null}
