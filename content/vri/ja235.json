{"suttaId":"ja235","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1597,1604],"vripara":"169"},"segments":{"ja235:0.4":"Vacchanakhajātakaṃ (2-9-5)","ja235:1.1":"Sukhā gharā vacchanakha, sahiraññā sabhojanā;","ja235:1.3":"Yattha bhutvā pivitvā ca, sayeyyātha anussuko.","ja235:2.1":"Gharā nānīhamānassa, gharā nābhaṇato musā;","ja235:2.3":"Gharā nādinnadaṇḍassa, paresaṃ anikubbato [anikrubbato (ka.)];","ja235:2.5":"Evaṃ chiddaṃ durabhisambhavaṃ [durabhibhavaṃ (sī. pī.)], ko gharaṃ paṭipajjatīti.","ja235:3.1":"Vacchanakhajātakaṃ pañcamaṃ."},"attha":null,"tika":null}
