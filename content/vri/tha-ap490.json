{"suttaId":"tha-ap490","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[2295,2342],"vripara":"148"},"segments":{"tha-ap490:0.3":"Taraṇiyattheraapadānaṃ","tha-ap490:1.1":"“Atthadassī tu bhagavā,","tha-ap490:1.2":"sayambhū lokanāyako;","tha-ap490:1.3":"Vinatā nadiyā tīraṃ [tīre (syā. pī. ka.)],","tha-ap490:1.4":"upāgacchi tathāgato.","tha-ap490:2.1":"“Udakā abhinikkhamma,","tha-ap490:2.2":"kacchapo vārigocaro;","tha-ap490:2.3":"Buddhaṃ tāretukāmohaṃ,","tha-ap490:2.4":"upesiṃ lokanāyakaṃ.","tha-ap490:3.1":"“‘Abhirūhatu maṃ buddho,","tha-ap490:3.2":"atthadassī mahāmuni;","tha-ap490:3.3":"Ahaṃ taṃ tārayissāmi,","tha-ap490:3.4":"dukkhassantakaro tuvaṃ’.","tha-ap490:4.1":"“Mama saṅkappamaññāya,","tha-ap490:4.2":"atthadassī mahāyaso;","tha-ap490:4.3":"Abhirūhitvā me piṭṭhiṃ,","tha-ap490:4.4":"aṭṭhāsi lokanāyako.","tha-ap490:5.1":"“Yato sarāmi attānaṃ,","tha-ap490:5.2":"yato pattosmi viññutaṃ;","tha-ap490:5.3":"Sukhaṃ me tādisaṃ natthi,","tha-ap490:5.4":"phuṭṭhe pādatale yathā.","tha-ap490:6.1":"“Uttaritvāna sambuddho,","tha-ap490:6.2":"atthadassī mahāyaso;","tha-ap490:6.3":"Nadītīramhi ṭhatvāna,","tha-ap490:6.4":"imā gāthā abhāsatha.","tha-ap490:7.1":"“‘Yāvatā vattate cittaṃ,","tha-ap490:7.2":"gaṅgāsotaṃ tarāmahaṃ;","tha-ap490:7.3":"Ayañca kacchapo rājā,","tha-ap490:7.4":"tāresi mama paññavā.","tha-ap490:8.1":"“‘Iminā buddhataraṇena,","tha-ap490:8.2":"mettacittavatāya ca;","tha-ap490:8.3":"Aṭṭhārase kappasate,","tha-ap490:8.4":"devaloke ramissati.","tha-ap490:9.1":"“‘Devalokā idhāgantvā,","tha-ap490:9.2":"sukkamūlena codito;","tha-ap490:9.3":"Ekāsane nisīditvā,","tha-ap490:9.4":"kaṅkhāsotaṃ tarissati.","tha-ap490:10.1":"“‘Yathāpi bhaddake khette,","tha-ap490:10.2":"bījaṃ appampi ropitaṃ;","tha-ap490:10.3":"Sammādhāre pavacchante,","tha-ap490:10.4":"phalaṃ toseti kassakaṃ [kassake (syā.)].","tha-ap490:11.1":"“‘Tathevidaṃ buddhakhettaṃ,","tha-ap490:11.2":"sammāsambuddhadesitaṃ;","tha-ap490:11.3":"Sammādhāre pavacchante,","tha-ap490:11.4":"phalaṃ maṃ tosayissati’.","tha-ap490:12.1":"“Padhānapahitattomhi,","tha-ap490:12.2":"upasanto nirūpadhi;","tha-ap490:12.3":"Sabbāsave pariññāya,","tha-ap490:12.4":"viharāmi anāsavo.","tha-ap490:13.1":"“Aṭṭhārase kappasate,","tha-ap490:13.2":"yaṃ kammamakariṃ tadā;","tha-ap490:13.3":"Duggatiṃ nābhijānāmi,","tha-ap490:13.4":"taraṇāya idaṃ phalaṃ.","tha-ap490:14.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap490:14.3":"viharāmi anāsavo.","tha-ap490:15.1":"“Svāgataṃ vata me āsi … pe …","tha-ap490:15.3":"kataṃ buddhassa sāsanaṃ.","tha-ap490:16.1":"“Paṭisambhidā catasso … pe …","tha-ap490:16.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap490:17.1":"Itthaṃ sudaṃ āyasmā taraṇiyo thero imā gāthāyo Abhāsitthāti.","tha-ap490:18.1":"Taraṇiyattherassāpadānaṃ aṭṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":1485,"to":1545,"paras":[{"para":1485,"vripara":"148","refs":["tha-ap490:1"],"lines":["“Campakā saḷalā nīpā, nāgapunnāgaketakā;"],"lineRefs":[["tha-ap490:1"]]},{"para":1486,"vripara":null,"refs":["tha-ap490:1"],"lines":["Dibbagandhā sampavanti, pupphitā mama assame”."],"lineRefs":[["tha-ap490:1"]]},{"para":1487,"vripara":null,"refs":["tha-ap490:1"],"lines":["Tattha <b>campaka</b> rukkhā ca <b>saḷala</b> rukkhā ca suvaṇṇavaṭṭalasadisapupphā <b>nīpa</b> rukkhā ca <b>nāga</b> rukkhā ca <b>punnāga</b> rukkhā ca sugandhayantā <b>ketaka</b> rukkhā ca ete sabbe rukkhā dibbā gandhāriva mama assame <b>pupphitā</b> phullitā <b>sampavanti</b> sugandhaṃ suṭṭhu pavāyantīti attho."],"lineRefs":[["tha-ap490:1"]]},{"para":1489,"vripara":"149","refs":["tha-ap490:2"],"lines":["Asokā ca “adhimuttā asokā ca, bhaginīmālā ca pupphitā;"],"lineRefs":[["tha-ap490:2"]]},{"para":1490,"vripara":null,"refs":["tha-ap490:2"],"lines":["Aṅkolā bimbijālā ca, pupphitā mama assame”."],"lineRefs":[["tha-ap490:2"]]},{"para":1491,"vripara":null,"refs":["tha-ap490:2"],"lines":["Tattha pupphitā <b>adhimuttaka</b> rukkhā ca pupphitā <b>asoka</b> rukkhā ca pupphitā <b>bhaginīmālā ca</b> pupphitā <b>aṅkolā</b> ca pupphitā <b>bimbijālā</b> ca ete rukkhā mama assame phullitā sobhayantīti sambandho."],"lineRefs":[["tha-ap490:2"]]},{"para":1493,"vripara":"150","refs":["tha-ap490:3"],"lines":["“Ketakā kandali ceva, godhukā tiṇasūlikā;"],"lineRefs":[["tha-ap490:3"]]},{"para":1494,"vripara":null,"refs":["tha-ap490:3"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap490:3"]]},{"para":1495,"vripara":null,"refs":["tha-ap490:3"],"lines":["Tattha <b>ketakā</b>ti sugandhaketakagacchā ca.","<b>Kandali</b> rukkhā ca <b>godhuka</b> rukkhā ca <b>tiṇasūlika</b> gacchā ca ete sabbe rukkhajātikā dibbagandhaṃ pavāyamānā mama assamaṃ sakalaṃ sobhayantīti attho."],"lineRefs":[["tha-ap490:3"],["tha-ap490:3"]]},{"para":1497,"vripara":"151","refs":["tha-ap490:4"],"lines":["“Kaṇikārā kaṇṇikā ca, asanā ajjunā bahū;"],"lineRefs":[["tha-ap490:4"]]},{"para":1498,"vripara":null,"refs":["tha-ap490:4"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap490:4"]]},{"para":1499,"vripara":null,"refs":["tha-ap490:4"],"lines":["Ete kaṇikārādayo rukkhā mama assamaṃ sakalaṃ sobhayantā dibbagandhaṃ sampavāyantīti sambandho."],"lineRefs":[["tha-ap490:4"]]},{"para":1501,"vripara":"152","refs":["tha-ap490:5"],"lines":["“Punnāgā giripunnāgā, koviḷārā ca pupphitā;"],"lineRefs":[["tha-ap490:5"]]},{"para":1502,"vripara":null,"refs":["tha-ap490:5"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap490:5"]]},{"para":1503,"vripara":null,"refs":["tha-ap490:5"],"lines":["Punnāgādayo rukkhā dibbagandhaṃ pavāyamānā mama assamaṃ sobhayantīti attho."],"lineRefs":[["tha-ap490:5"]]},{"para":1505,"vripara":"153","refs":["tha-ap490:6"],"lines":["“Uddālakā ca kuṭajā, kadambā vakulā bahū;"],"lineRefs":[["tha-ap490:6"]]},{"para":1506,"vripara":null,"refs":["tha-ap490:6"],"lines":["Dibbagandhaṃ sampavantā, sobhayanti mamassamaṃ”."],"lineRefs":[["tha-ap490:6"]]},{"para":1507,"vripara":null,"refs":["tha-ap490:6"],"lines":["Uddālakādayo rukkhā dibbagandhaṃ vāyamānā mama assamaṃ sobhayantīti sambandho."],"lineRefs":[["tha-ap490:6"]]},{"para":1509,"vripara":"154","refs":["tha-ap490:7"],"lines":["“Āḷakā isimuggā ca, kadalimātuluṅgiyo;"],"lineRefs":[["tha-ap490:7"]]},{"para":1510,"vripara":null,"refs":["tha-ap490:7"],"lines":["Gandhodakena saṃvaḍḍhā, phalāni dhārayanti te”."],"lineRefs":[["tha-ap490:7"]]},{"para":1511,"vripara":null,"refs":["tha-ap490:7"],"lines":["Tattha ete āḷakādayo gacchā candanādisugandhagandhodakena vaḍḍhitvā suvaṇṇaphalāni dhārentā mama assamaṃ sobhayantīti attho."],"lineRefs":[["tha-ap490:7"]]},{"para":1513,"vripara":"155","refs":["tha-ap490:8"],"lines":["“Aññe pupphanti padumā, aññe jāyanti kesarī;"],"lineRefs":[["tha-ap490:8"]]},{"para":1514,"vripara":null,"refs":["tha-ap490:8"],"lines":["Aññe opupphā padumā, pupphitā taḷāke tadā”."],"lineRefs":[["tha-ap490:8"]]},{"para":1515,"vripara":null,"refs":["tha-ap490:8"],"lines":["Tattha <b>aññe pupphanti padumā</b>ti mama assamassa avidūre taḷāke aññe ekacce padumā pupphanti, ekacce <b>kesarī</b> padumā <b>jāyanti</b> nibbattanti, ekacce padumā <b>opupphā</b> vigalitapattakesarāti attho."],"lineRefs":[["tha-ap490:8"]]},{"para":1517,"vripara":"156","refs":["tha-ap490:9"],"lines":["“Gabbhaṃ gaṇhanti padumā, niddhāvanti muḷāliyo;"],"lineRefs":[["tha-ap490:9"]]},{"para":1518,"vripara":null,"refs":["tha-ap490:9"],"lines":["Siṅghāṭipattamākiṇṇā, sobhanti taḷāke tadā”."],"lineRefs":[["tha-ap490:9"]]},{"para":1519,"vripara":null,"refs":["tha-ap490:9"],"lines":["Tattha <b>gabbhaṃ gaṇhanti padumā</b>ti tadā tāpasena hutvā mama vasanasamaye ekacce padumā taḷākabbhantare makuḷapupphādayo gaṇhanti.","<b>Muḷāliyo</b> padumamūlā <b>niddhāvanti</b> ito kaddamabbhantarato hatthidāṭhā viya gacchantīti attho.","Pattapupphamākiṇṇā gahanībhūtā siṅghāṭiyo sobhayantīti attho."],"lineRefs":[["tha-ap490:9"],["tha-ap490:9"],["tha-ap490:9"]]},{"para":1521,"vripara":"157","refs":["tha-ap490:10"],"lines":["“Nayitā ambagandhī ca, uttalī bandhujīvakā;"],"lineRefs":[["tha-ap490:10"]]},{"para":1522,"vripara":null,"refs":["tha-ap490:10"],"lines":["Dibbagandhā sampavanti, pupphitā taḷāke tadā”."],"lineRefs":[["tha-ap490:10"]]},{"para":1523,"vripara":null,"refs":["tha-ap490:10"],"lines":["<b>Tadā</b> mama vasanasamaye taḷākassa samīpe <b>nayitā</b> ca gacchā <b>ambagandhī ca</b> gacchā <b>uttalī</b> nāma gacchā ca <b>bandhujīvakā</b> ca ete sabbe gacchā <b>pupphitā</b> pupphadhāritā sugandhavāhakā taḷākaṃ sobhayantīti attho."],"lineRefs":[["tha-ap490:10"]]},{"para":1525,"vripara":"158","refs":["tha-ap490:11"],"lines":["“Pāṭhīnā pāvusā macchā, balajā muñjarohitā;"],"lineRefs":[["tha-ap490:11"]]},{"para":1526,"vripara":null,"refs":["tha-ap490:11"],"lines":["Saṃgulā maggurā ceva, vasanti taḷāke tadā”."],"lineRefs":[["tha-ap490:11"]]},{"para":1527,"vripara":null,"refs":["tha-ap490:11"],"lines":["<b>Tadā</b> mama vasanasamaye nibbhītā pāṭhīnādayo macchā <b>taḷāke</b> vasantīti sambandho."],"lineRefs":[["tha-ap490:11"]]},{"para":1529,"vripara":"159","refs":["tha-ap490:12"],"lines":["“Kumbhīlā susumārā ca, tantigāhā ca rakkhasā;"],"lineRefs":[["tha-ap490:12"]]},{"para":1530,"vripara":null,"refs":["tha-ap490:12"],"lines":["Oguhā ajagarā ca, vasanti taḷāke tadā”."],"lineRefs":[["tha-ap490:12"]]},{"para":1531,"vripara":null,"refs":["tha-ap490:12"],"lines":["<b>Tadā</b> mama vasanasamaye mama assamasamīpe <b>taḷāke</b> ete kumbhīlādayo macchā nibbhītā nirūpaddavā vasantīti sambandho."],"lineRefs":[["tha-ap490:12"]]},{"para":1533,"vripara":"160","refs":["tha-ap490:13"],"lines":["“Pārevatā ravihaṃsā, cakkavākā nadīcarā;"],"lineRefs":[["tha-ap490:13"]]},{"para":1534,"vripara":null,"refs":["tha-ap490:13"],"lines":["Kokilā sukasāḷikā, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap490:13"]]},{"para":1535,"vripara":null,"refs":["tha-ap490:13"],"lines":["Tattha mama assamasamīpe saraṃ nissāya <b>pārevatā</b> pakkhī ca <b>ravihaṃsā</b> pakkhī ca <b>nadīcarā cakkavāka</b> pakkhī ca <b>kokilā</b> pakkhī ca <b>suka</b> pakkhī ca <b>sāḷikā</b> pakkhī ca taṃ saraṃ upanissāya jīvantīti sambandho."],"lineRefs":[["tha-ap490:13"]]},{"para":1537,"vripara":"161","refs":["tha-ap490:14"],"lines":["“Kukutthakā kuḷīrakā, vane pokkharasātakā;"],"lineRefs":[["tha-ap490:14"]]},{"para":1538,"vripara":null,"refs":["tha-ap490:14"],"lines":["Dindibhā suvapotā ca, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap490:14"]]},{"para":1539,"vripara":null,"refs":["tha-ap490:14"],"lines":["Tattha <b>kukutthakā</b>ti evaṃnāmikā pakkhī ca.","<b>Kuḷīrakā</b>ti evaṃnāmikā pakkhī ca.","Vane <b>pokkharasātakā</b> pakkhī ca <b>dindibhā</b> pakkhī ca <b>suvapotā</b> pakkhī ca ete sabbe pakkhino taṃ mama assamasamīpe saraṃ nissāya jīvantīti sambandho."],"lineRefs":[["tha-ap490:14"],["tha-ap490:14"],["tha-ap490:14"]]},{"para":1541,"vripara":"162","refs":["tha-ap490:15"],"lines":["“Haṃsā koñcā mayūrā ca, kokilā tambacūḷakā;"],"lineRefs":[["tha-ap490:15"]]},{"para":1542,"vripara":null,"refs":["tha-ap490:15"],"lines":["Pammakā jīvaṃjīvā ca, upajīvanti taṃ saraṃ”."],"lineRefs":[["tha-ap490:15"]]},{"para":1543,"vripara":null,"refs":["tha-ap490:15"],"lines":["Sabbe ete haṃsādayo pakkhino taṃ saraṃ upanissāya jīvanti jīvikaṃ pālentīti attho."],"lineRefs":[["tha-ap490:15"]]},{"para":1545,"vripara":"163","refs":["tha-ap490:16"],"lines":["“Kosikā poṭṭhasīsā ca, kurarā senakā bahū;"],"lineRefs":[["tha-ap490:16"]]}],"wordLinks":[]},"tika":null,"tika2":null}
