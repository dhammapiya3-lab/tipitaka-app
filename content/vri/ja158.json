{"suttaId":"ja158","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[913,919],"vripara":"15"},"segments":{"ja158:0.4":"Suhanujātakaṃ (2-1-8)","ja158:1.1":"Nayidaṃ visamasīlena, soṇena suhanū saha;","ja158:1.3":"Suhanūpi tādisoyeva, yo soṇassa sagocaro.","ja158:2.1":"Pakkhandinā pagabbhena, niccaṃ sandānakhādinā;","ja158:2.3":"Sameti pāpaṃ pāpena, sameti asatā asanti.","ja158:3.1":"Suhanujātakaṃ aṭṭhamaṃ."},"attha":null,"tika":null}
