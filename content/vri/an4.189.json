{"suttaId":"an4.189","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1483,1486],"vripara":"189"},"segments":{"an4.189:0.3":"Sacchikaraṇīyasuttaṃ","an4.189:1.1":"“Cattārome, bhikkhave, sacchikaraṇīyā dhammā.","an4.189:1.2":"Katame cattāro?","an4.189:1.3":"Atthi, bhikkhave, dhammā kāyena sacchikaraṇīyā;","an4.189:1.4":"atthi, bhikkhave, dhammā satiyā sacchikaraṇīyā;","an4.189:1.5":"atthi, bhikkhave, dhammā cakkhunā sacchikaraṇīyā;","an4.189:1.6":"atthi, bhikkhave, dhammā paññāya sacchikaraṇīyā.","an4.189:1.7":"Katame ca, bhikkhave, dhammā kāyena sacchikaraṇīyā?","an4.189:1.8":"Aṭṭha vimokkhā, bhikkhave, kāyena sacchikaraṇīyā.","an4.189:2.1":"“Katame ca, bhikkhave, dhammā satiyā sacchikaraṇīyā?","an4.189:2.2":"Pubbenivāso, bhikkhave, satiyā sacchikaraṇīyo.","an4.189:3.1":"“Katame ca, bhikkhave, dhammā cakkhunā sacchikaraṇīyā?","an4.189:3.2":"Sattānaṃ cutūpapāto, bhikkhave, cakkhunā sacchikaraṇīyo.","an4.189:4.1":"“Katame ca, bhikkhave, dhammā paññāya sacchikaraṇīyā?","an4.189:4.2":"Āsavānaṃ khayo, bhikkhave, paññāya sacchikaraṇīyo.","an4.189:4.3":"Ime kho, bhikkhave, cattāro sacchikaraṇīyā dhammā”ti.","an4.189:4.4":"Navamaṃ."},"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1562,"to":1562,"paras":[{"para":1562,"vripara":"189","refs":["an4.189:1","an4.189:2","an4.189:3","an4.189:4"],"words":["kāyenā","sacchikaraṇīyā","satiyā","cakkhunā","paññāyā"],"lines":["Navame <b>kāyenā</b>ti nāmakāyena.","<b>Sacchikaraṇīyā</b>ti paccakkhaṃ kātabbā.","<b>Satiyā</b>ti pubbenivāsānussatiyā.","<b>Cakkhunā</b>ti dibbacakkhunā.","<b>Paññāyā</b>ti jhānapaññāya vipassanāpaññā sacchikātabbā, vipassanāpaññāya maggapaññā, maggapaññāya phalapaññā, phalapaññāya paccavekkhaṇapaññā sacchikātabbā, pattabbāti attho.","Āsavānaṃ khayasaṅkhātaṃ pana arahattaṃ paccavekkhaṇavasena paccavekkhaṇapaññāya sacchikaraṇīyaṃ nāmāti."],"lineRefs":[["an4.189:1"],["an4.189:1"],["an4.189:1"],["an4.189:1"],["an4.189:1"],["an4.189:1"]]}]},"tika":null}
