{"suttaId":"an4.189","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1483,1486],"vripara":"189"},"segments":{"an4.189:0.3":"Sacchikaraṇīyasuttaṃ","an4.189:1.1":"“Cattārome, bhikkhave, sacchikaraṇīyā dhammā.","an4.189:1.2":"Katame cattāro?","an4.189:1.3":"Atthi, bhikkhave, dhammā kāyena sacchikaraṇīyā;","an4.189:1.4":"atthi, bhikkhave, dhammā satiyā sacchikaraṇīyā;","an4.189:1.5":"atthi, bhikkhave, dhammā cakkhunā sacchikaraṇīyā;","an4.189:1.6":"atthi, bhikkhave, dhammā paññāya sacchikaraṇīyā.","an4.189:1.7":"Katame ca, bhikkhave, dhammā kāyena sacchikaraṇīyā?","an4.189:1.8":"Aṭṭha vimokkhā, bhikkhave, kāyena sacchikaraṇīyā.","an4.189:2.1":"“Katame ca, bhikkhave, dhammā satiyā sacchikaraṇīyā?","an4.189:2.2":"Pubbenivāso, bhikkhave, satiyā sacchikaraṇīyo.","an4.189:3.1":"“Katame ca, bhikkhave, dhammā cakkhunā sacchikaraṇīyā?","an4.189:3.2":"Sattānaṃ cutūpapāto, bhikkhave, cakkhunā sacchikaraṇīyo.","an4.189:4.1":"“Katame ca, bhikkhave, dhammā paññāya sacchikaraṇīyā?","an4.189:4.2":"Āsavānaṃ khayo, bhikkhave, paññāya sacchikaraṇīyo.","an4.189:4.3":"Ime kho, bhikkhave, cattāro sacchikaraṇīyā dhammā”ti.","an4.189:4.4":"Navamaṃ. 10."},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1562,"to":1562,"paras":[{"para":1562,"vripara":"189","refs":["an4.189:1"],"lines":["Navame <b>kāyenā</b>ti nāmakāyena.","<b>Sacchikaraṇīyā</b>ti paccakkhaṃ kātabbā.","<b>Satiyā</b>ti pubbenivāsānussatiyā.","<b>Cakkhunā</b>ti dibbacakkhunā.","<b>Paññāyā</b>ti jhānapaññāya vipassanāpaññā sacchikātabbā, vipassanāpaññāya maggapaññā, maggapaññāya phalapaññā, phalapaññāya paccavekkhaṇapaññā sacchikātabbā, pattabbāti attho.","Āsavānaṃ khayasaṅkhātaṃ pana arahattaṃ paccavekkhaṇavasena paccavekkhaṇapaññāya sacchikaraṇīyaṃ nāmāti. 10."],"lineRefs":[["an4.189:1"],["an4.189:1"],["an4.189:1"],["an4.189:1"],["an4.189:1"],["an4.189:1"]]}],"wordLinks":[["an4.189:1.3","kāyenā",0,0],["an4.189:1.7","kāyenā",0,0],["an4.189:1.8","kāyenā",0,0],["an4.189:1.1","sacchikaraṇīyā",0,1],["an4.189:1.3","sacchikaraṇīyā",0,1],["an4.189:1.4","sacchikaraṇīyā",0,1],["an4.189:1.5","sacchikaraṇīyā",0,1],["an4.189:1.6","sacchikaraṇīyā",0,1],["an4.189:1.7","sacchikaraṇīyā",0,1],["an4.189:1.8","sacchikaraṇīyā",0,1],["an4.189:1.4","satiyā",0,2],["an4.189:1.5","cakkhunā",0,3],["an4.189:1.6","paññāyā",0,4]],"before":[{"para":1561,"vripara":null,"title":"Sacchikaraṇīyasuttavaṇṇanā","lines":["Sacchikaraṇīyasuttavaṇṇanā 189."]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1762,"to":1764,"paras":[{"para":1762,"vripara":"189","refs":["an4.189:1"],"lines":["Navame <b>nāmakāyenā</b>ti sahajātanāmakāyena.","Sesamettha uttānameva."],"lineRefs":[["an4.189:1"],["an4.189:1"]]},{"para":1763,"vripara":null,"refs":["an4.189:1"],"lines":["Sacchikaraṇīyasuttavaṇṇanā niṭṭhitā. 10."],"lineRefs":[["an4.189:1"]]},{"para":1764,"vripara":null,"refs":["an4.189:1"],"lines":["Uposathasuttavaṇṇanā 190."],"lineRefs":[["an4.189:1"]]}],"wordLinks":[],"before":[{"para":1761,"vripara":null,"title":"Sacchikaraṇīyasuttavaṇṇanā","lines":["Sacchikaraṇīyasuttavaṇṇanā 189."]}]},"tika2":null}
