{"suttaId":"sn50.1-12","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1498,1502],"vripara":"705-716"},"segments":{"sn50.1-12:0.3":"1-12. Balādisuttadvādasakaṃ","sn50.1-12:1.1":"“Pañcimāni, bhikkhave, balāni.","sn50.1-12:1.2":"Katamāni pañca?","sn50.1-12:1.3":"Saddhābalaṃ, vīriyabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ –","sn50.1-12:1.4":"imāni kho, bhikkhave, pañca balānīti.","sn50.1-12:1.5":"Seyyathāpi, bhikkhave, gaṅgā nadī pācīnaninnā pācīnapoṇā pācīnapabbhārā;","sn50.1-12:1.6":"evameva kho, bhikkhave, bhikkhu pañca balāni bhāvento pañcabalāni bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro.","sn50.1-12:1.7":"Kathañca, bhikkhave, bhikkhu pañca balāni bhāvento pañca balāni bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro?","sn50.1-12:1.8":"Idha, bhikkhave, bhikkhu saddhābalaṃ bhāveti vivekanissitaṃ virāganissitaṃ nirodhanissitaṃ vossaggapariṇāmiṃ,","sn50.1-12:1.9":"vīriyabalaṃ…pe…","sn50.1-12:1.10":"satibalaṃ…","sn50.1-12:1.11":"samādhibalaṃ…","sn50.1-12:1.12":"paññābalaṃ bhāveti vivekanissitaṃ virāganissitaṃ nirodhanissitaṃ vossaggapariṇāmiṃ.","sn50.1-12:1.13":"Evaṃ kho, bhikkhave, bhikkhu pañca balāni bhāvento pañca balāni bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro”ti.","sn50.1-12:1.14":"Dvādasamaṃ.","sn50.1-12:1.15":"Gaṅgāpeyyālavaggo paṭhamo.","sn50.1-12:2.0":"Tassuddānaṃ –","sn50.1-12:2.1":"Cha pācīnato ninnā,","sn50.1-12:2.2":"cha ninnā ca samuddato;","sn50.1-12:2.3":"Dvete cha dvādasa honti,","sn50.1-12:2.4":"vaggo tena pavuccatīti. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":635,"to":639,"paras":[{"para":635,"vripara":"705-812","refs":["sn50.1-12:1"],"lines":["Balasaṃyutte balāni missakāneva kathitāni.","Sesaṃ sabbattha uttānamevāti."],"lineRefs":[["sn50.1-12:1"],["sn50.1-12:1"]]},{"para":636,"vripara":null,"refs":["sn50.1-12:1"],"lines":["Balasaṃyuttavaṇṇanā niṭṭhitā. 7."],"lineRefs":[["sn50.1-12:1"]]},{"para":637,"vripara":null,"refs":["sn50.1-12:1"],"lines":["Iddhipādasaṃyuttaṃ 1."],"lineRefs":[["sn50.1-12:1"]]},{"para":638,"vripara":null,"refs":["sn50.1-12:1"],"lines":["Cāpālavaggo 1."],"lineRefs":[["sn50.1-12:1"]]},{"para":639,"vripara":null,"refs":["sn50.1-12:1"],"lines":["Apārasuttavaṇṇanā 813."],"lineRefs":[["sn50.1-12:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":547,"to":551,"paras":[{"para":547,"vripara":"705-812","refs":["sn50.1-12:1"],"lines":["<b>Balasaṃyutte balāni missakāneva kathitāni</b> “vivekanissita”nti vacanato."],"lineRefs":[["sn50.1-12:1"]]},{"para":548,"vripara":null,"refs":["sn50.1-12:1"],"lines":["Balasaṃyuttavaṇṇanā niṭṭhitā. 7."],"lineRefs":[["sn50.1-12:1"]]},{"para":549,"vripara":null,"refs":["sn50.1-12:1"],"lines":["Iddhipādasaṃyuttaṃ 1."],"lineRefs":[["sn50.1-12:1"]]},{"para":550,"vripara":null,"refs":["sn50.1-12:1"],"lines":["Cāpālavaggo 1."],"lineRefs":[["sn50.1-12:1"]]},{"para":551,"vripara":null,"refs":["sn50.1-12:1"],"lines":["Apārasuttavaṇṇanā 813."],"lineRefs":[["sn50.1-12:1"]]}],"wordLinks":[]},"tika2":null}
