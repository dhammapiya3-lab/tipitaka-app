{"suttaId":"an5.204","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1391,1391],"vripara":"204"},"segments":{"an5.204:0.3":"Balasuttaṃ","an5.204:1.1":"“Pañcimāni, bhikkhave, balāni.","an5.204:1.2":"Katamāni pañca?","an5.204:1.3":"Saddhābalaṃ, hiribalaṃ, ottappabalaṃ, vīriyabalaṃ, paññābalaṃ – imāni kho, bhikkhave, pañca balānī”ti.","an5.204:1.5":"Catutthaṃ."},"attha":null,"tika":null}
