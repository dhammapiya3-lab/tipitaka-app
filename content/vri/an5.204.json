{"suttaId":"an5.204","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1391,1391],"vripara":"204"},"segments":{"an5.204:0.3":"Balasuttaṃ","an5.204:1.1":"“Pañcimāni, bhikkhave, balāni.","an5.204:1.2":"Katamāni pañca?","an5.204:1.3":"Saddhābalaṃ, hiribalaṃ, ottappabalaṃ, vīriyabalaṃ, paññābalaṃ – imāni kho, bhikkhave, pañca balānī”ti.","an5.204:1.5":"Catutthaṃ."},"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":423,"to":424,"paras":[{"para":423,"vripara":"203-204","refs":["an5.204:1"],"lines":["203-204. Tatiye <b>ajjavenā</b>ti ujubhāvena avaṅkagamanena.","<b>Javenā</b>ti padajavena.","<b>Maddavenā</b>ti sarīramudutāya.","<b>Khantiyā</b>ti adhivāsanakkhantiyā.","<b>Soraccenā</b>ti sucisīlatāya.","Bhikkhuvāre <b>ajjavan</b>ti ñāṇassa ujukagamanaṃ.","<b>Javo</b>ti sūraṃ hutvā ñāṇassa gamanabhāvo.","<b>Maddavan</b>ti sīlamaddavaṃ.","<b>Khantī</b>ti adhivāsanakkhantiyeva.","<b>Soraccaṃ</b> sucisīlatāyeva.","Catutthe pañca balāni missakāni kathitāni."],"lineRefs":[["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"]]},{"para":424,"vripara":null,"refs":["an5.204:1"],"lines":["Cetokhilasuttavaṇṇanā"],"lineRefs":[["an5.204:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":438,"to":440,"paras":[{"para":438,"vripara":"201-204","refs":["an5.204:1"],"lines":["201-4. Pañcamassa paṭhamadutiyāni uttānatthāneva.","Tatiye adhivāsanaṃ khamanaṃ, paresaṃ dukkaṭaṃ duruttañca paṭivirodhākaraṇena attano upari āropetvā vāsanaṃ adhivāsanaṃ, tadeva khantīti <b>adhivāsanakkhanti</b>.","Subhe ratoti sūrato, suṭṭhu vā pāpato orato virato sorato, tassa bhāvo <b>soraccaṃ</b>.","Tenāha <b>“soraccenāti sucisīlatāyā”</b>ti.","Sā hi sobhanakammaratatā, suṭṭhu vā pāpato oratabhāvo viratatā.","Catutthe natthi vattabbaṃ."],"lineRefs":[["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"],["an5.204:1"]]},{"para":439,"vripara":null,"refs":["an5.204:1"],"lines":["Kimilasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an5.204:1"]]},{"para":440,"vripara":null,"refs":["an5.204:1"],"lines":["Cetokhilasuttavaṇṇanā"],"lineRefs":[["an5.204:1"]]}],"wordLinks":[]},"tika2":null}
