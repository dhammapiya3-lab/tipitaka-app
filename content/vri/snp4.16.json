{"suttaId":"snp4.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Sn","vriCode":"s0505m.mul","paras":[3268,3344],"vripara":"961"},"segments":{"snp4.16:0.2":"Sāriputtasuttaṃ","snp4.16:1.1":"“Na me diṭṭho ito pubbe,","snp4.16:1.2":"(iccāyasmā sāriputto)","snp4.16:1.3":"Na suto uda kassaci;","snp4.16:1.4":"Evaṃ vagguvado satthā,","snp4.16:1.5":"Tusitā gaṇimāgato. 962.","snp4.16:2.1":"“Sadevakassa lokassa,","snp4.16:2.2":"yathā dissati cakkhumā;","snp4.16:2.3":"Sabbaṃ tamaṃ vinodetvā,","snp4.16:2.4":"ekova ratimajjhagā. 963.","snp4.16:3.1":"“Taṃ buddhaṃ asitaṃ tādiṃ,","snp4.16:3.2":"akuhaṃ gaṇimāgataṃ;","snp4.16:3.3":"Bahūnamidha baddhānaṃ,","snp4.16:3.4":"atthi pañhena āgamaṃ. 964.","snp4.16:4.1":"“Bhikkhuno vijigucchato,","snp4.16:4.2":"bhajato rittamāsanaṃ;","snp4.16:4.3":"Rukkhamūlaṃ susānaṃ vā,","snp4.16:4.4":"pabbatānaṃ guhāsu vā. 965.","snp4.16:5.1":"“Uccāvacesu sayanesu,","snp4.16:5.2":"kīvanto tattha bheravā;","snp4.16:5.3":"Yehi bhikkhu na vedheyya,","snp4.16:5.4":"nigghose sayanāsane. 966.","snp4.16:6.1":"“Katī parissayā loke,","snp4.16:6.2":"gacchato agataṃ disaṃ;","snp4.16:6.3":"Ye bhikkhu abhisambhave,","snp4.16:6.4":"pantamhi sayanāsane. 967.","snp4.16:7.1":"“Kyāssa byappathayo assu,","snp4.16:7.2":"kyāssassu idha gocarā;","snp4.16:7.3":"Kāni sīlabbatānāssu,","snp4.16:7.4":"pahitattassa bhikkhuno. 968.","snp4.16:8.1":"“Kaṃ so sikkhaṃ samādāya,","snp4.16:8.2":"ekodi nipako sato;","snp4.16:8.3":"Kammāro rajatasseva,","snp4.16:8.4":"niddhame malamattano”. 969.","snp4.16:9.1":"“Vijigucchamānassa yadidaṃ phāsu,","snp4.16:9.2":"(sāriputtāti bhagavā)","snp4.16:9.3":"Rittāsanaṃ sayanaṃ sevato ce;","snp4.16:9.4":"Sambodhikāmassa yathānudhammaṃ,","snp4.16:9.5":"Taṃ te pavakkhāmi yathā pajānaṃ. 970.","snp4.16:10.1":"“Pañcannaṃ dhīro bhayānaṃ na bhāye,","snp4.16:10.2":"bhikkhu sato sapariyantacārī;","snp4.16:10.3":"Ḍaṃsādhipātānaṃ sarīsapānaṃ,","snp4.16:10.4":"manussaphassānaṃ catuppadānaṃ. 971.","snp4.16:11.1":"“Paradhammikānampi na santaseyya,","snp4.16:11.2":"disvāpi tesaṃ bahubheravāni;","snp4.16:11.3":"Athāparāni abhisambhaveyya,","snp4.16:11.4":"parissayāni kusalānuesī. 972.","snp4.16:12.1":"“Ātaṅkaphassena khudāya phuṭṭho,","snp4.16:12.2":"sītaṃ atuṇhaṃ [accuṇhaṃ (sī. syā.)] adhivāsayeyya;","snp4.16:12.3":"So tehi phuṭṭho bahudhā anoko, vīriyaṃ parakkammadaḷhaṃ kareyya. 973.","snp4.16:13.1":"“Theyyaṃ na kāre [na kareyya (sī. syā. ka.)] na musā bhaṇeyya,","snp4.16:13.2":"mettāya phasse tasathāvarāni;","snp4.16:13.3":"Yadāvilattaṃ manaso vijaññā,","snp4.16:13.4":"kaṇhassa pakkhoti vinodayeyya. 974.","snp4.16:14.1":"“Kodhātimānassa vasaṃ na gacche,","snp4.16:14.2":"mūlampi tesaṃ palikhañña tiṭṭhe;","snp4.16:14.3":"Athappiyaṃ vā pana appiyaṃ vā,","snp4.16:14.4":"addhā bhavanto abhisambhaveyya. 975.","snp4.16:15.1":"“Paññaṃ purakkhatvā kalyāṇapīti,","snp4.16:15.2":"vikkhambhaye tāni parissayāni;","snp4.16:15.3":"Aratiṃ sahetha sayanamhi pante,","snp4.16:15.4":"caturo sahetha paridevadhamme. 976.","snp4.16:16.1":"“Kiṃsū asissāmi kuvaṃ vā [kudha vā (ka.), kutha vā (niddesa)] asissaṃ,","snp4.16:16.2":"dukkhaṃ vata settha kvajja sessaṃ;","snp4.16:16.3":"Ete vitakke paridevaneyye,","snp4.16:16.4":"vinayetha sekho aniketacārī. 977.","snp4.16:17.1":"“Annañca laddhā vasanañca kāle,","snp4.16:17.2":"mattaṃ so jaññā idha tosanatthaṃ;","snp4.16:17.3":"So tesu gutto yatacāri gāme,","snp4.16:17.4":"rusitopi vācaṃ pharusaṃ na vajjā. 978.","snp4.16:18.1":"“Okkhittacakkhu na ca pādalolo,","snp4.16:18.2":"jhānānuyutto bahujāgarassa;","snp4.16:18.3":"Upekkhamārabbha samāhitatto,","snp4.16:18.4":"takkāsayaṃ kukkucciyūpachinde. 979.","snp4.16:19.1":"“Cudito vacībhi satimābhinande,","snp4.16:19.2":"sabrahmacārīsu khilaṃ pabhinde;","snp4.16:19.3":"Vācaṃ pamuñce kusalaṃ nātivelaṃ,","snp4.16:19.4":"janavādadhammāya na cetayeyya. 980.","snp4.16:20.1":"“Athāparaṃ pañca rajāni loke,","snp4.16:20.2":"yesaṃ satīmā vinayāya sikkhe;","snp4.16:20.3":"Rūpesu saddesu atho rasesu,","snp4.16:20.4":"gandhesu phassesu sahetha rāgaṃ. 981.","snp4.16:21.1":"“Etesu dhammesu vineyya chandaṃ,","snp4.16:21.2":"bhikkhu satimā suvimuttacitto;","snp4.16:21.3":"Kālena so sammā dhammaṃ parivīmaṃsamāno,","snp4.16:21.4":"Ekodibhūto vihane tamaṃ so”ti.","snp4.16:21.5":"Sāriputtasuttaṃ soḷasamaṃ niṭṭhitaṃ.","snp4.16:21.6":"Aṭṭhakavaggo catuttho Niṭṭhito.","snp4.16:22.0":"Tassuddānaṃ –","snp4.16:22.1":"Kāmaṃ guhañca duṭṭhā ca,","snp4.16:22.2":"suddhañca paramā jarā;","snp4.16:22.3":"Metteyyo ca pasūro ca,","snp4.16:22.4":"māgaṇḍi purābhedanaṃ.","snp4.16:23.1":"Kalahaṃ dve ca byūhāni [byūhāni (sī.)],","snp4.16:23.2":"punadeva tuvaṭṭakaṃ;","snp4.16:23.3":"Attadaṇḍavaraṃ suttaṃ,","snp4.16:23.4":"therapuṭṭhena [therapañhena (sī.), sāriputtena (syā.)] soḷasa;","snp4.16:23.5":"Iti etāni suttāni,","snp4.16:23.6":"sabbānaṭṭhakavaggikāti. 5."},"unsure":["snp4.16:12.3"],"preface":[],"attha":{"book":"Pj-ii","bookName":"Suttanipāta-aṭṭhakathā","vriCode":"s0505a.att","from":2463,"to":2463,"paras":[{"para":2463,"vripara":"968-969","refs":["snp4.16:8"],"lines":["Sattamagāthāya <b>kyāssa byappathayo assū</b>ti kīdisāni tassa vacanāni assu.","Aṭṭhamagāthāya <b>ekodi nipako</b>ti ekaggacitto paṇḍito. 970."],"lineRefs":[["snp4.16:8"],["snp4.16:8"]]}],"wordLinks":[["snp4.16:8.1","ekodi nipako",0,1]]},"tika":null,"tika2":null}
