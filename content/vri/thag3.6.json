{"suttaId":"thag3.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1196,1205],"vripara":"234"},"segments":{"thag3.6:0.4":"Khujjasobhitattheragāthā","thag3.6:1.1":"“Ye cittakathī bahussutā, samaṇā pāṭaliputtavāsino;","thag3.6:1.3":"Tesaññataroyamāyuvā, dvāre tiṭṭhati khujjasobhito.","thag3.6:2.1":"“Ye cittakathī bahussutā, samaṇā pāṭaliputtavāsino;","thag3.6:2.3":"Tesaññataroyamāyuvā, dvāre tiṭṭhati māluterito.","thag3.6:3.1":"“Suyuddhena suyiṭṭhena, saṅgāmavijayena ca;","thag3.6:3.3":"Brahmacariyānuciṇṇena, evāyaṃ sukhamedhatī”ti.","thag3.6:3.5":"… Khujjasobhito thero …."},"attha":{"book":"Th-a-i","bookName":"Theragāthā-1-aṭṭhakathā","vriCode":"s0508a1.att","from":4872,"to":4881,"paras":[{"para":4872,"vripara":null,"refs":["thag3.6:1"],"lines":["Tattha <b>cittakathī</b>ti vicittadhammakathikā, saṅkhipanaṃ, vitthāraṇaṃ gambhīrakaraṇaṃ uttānīkaraṇaṃ kaṅkhāvinodanaṃ dhammapatiṭṭhāpananti evamādīhi nānānayehi paresaṃ ajjhāsayānurūpaṃ dhammassa kathanasīlāti attho.","<b>Bahussutā</b>ti pariyattipaṭivedhabāhusaccapāripūriyā bahussutā.","Sabbaso samitapāpatāya <b>samaṇā.</b>","<b>Pāṭaliputtavāsino, tesaññataro</b>ti pāṭaliputtanagaravāsitāya pāṭaliputtavāsino, tesaṃ aññataro, <b>ayaṃ āyuvā</b> dīghāyu āyasmā.","<b>Dvāre tiṭṭhatī</b>ti sattapaṇṇiguhāya dvāre tiṭṭhati, saṅghassa anumatiyā pavisitunti attho.","Taṃ sutvā sā devatā therassa āgamanaṃ saṅghassa nivedentī –"],"lineRefs":[["thag3.6:1"],["thag3.6:1"],["thag3.6:1"],["thag3.6:1"],["thag3.6:1"],["thag3.6:1"]]},{"para":4874,"vripara":"235","refs":[],"lines":["“Ye cittakathī … pe … dvāre tiṭṭhati māluterito”ti.","– dutiyaṃ gāthamāha;"],"lineRefs":[[],[]]},{"para":4875,"vripara":null,"refs":["thag3.6:2"],"lines":["Tattha <b>māluterito</b>ti iddhicittajanitena vāyunā erito, iddhibalena āgatoti attho."],"lineRefs":[["thag3.6:2"]]},{"para":4876,"vripara":null,"refs":[],"lines":["Evaṃ tāya devatāya niveditena saṅghena katokāso thero saṅghassa santikaṃ gacchanto –"],"lineRefs":[[]]},{"para":4878,"vripara":"236","refs":[],"lines":["“Suyuddhena suyiṭṭhena, saṅgāmavijayena ca;"],"lineRefs":[[]]},{"para":4879,"vripara":null,"refs":[],"lines":["Brahmacariyānuciṇṇena, evāyaṃ sukhamedhatī”ti.","–"],"lineRefs":[[],[]]},{"para":4880,"vripara":null,"refs":[],"lines":["Imāya tatiyagāthāya aññaṃ byākāsi."],"lineRefs":[[]]},{"para":4881,"vripara":null,"refs":["thag3.6:3"],"lines":["Tattha <b>suyuddhenā</b>ti pubbabhāge tadaṅgavikkhambhanappahānavasena kilesehi suṭṭhu yujjhanena.","<b>Suyiṭṭhenā</b>ti antarantarā kalyāṇamittehi dinnasappāyadhammadānena.","<b>Saṅgāmavijayena cā</b>ti samucchedappahānavasena sabbaso kilesābhisaṅkhāranimmathanena laddhasaṅgāmavijayena ca.","<b>Brahmacariyānuciṇṇenā</b>ti anuciṇṇena aggamaggabrahmacariyena.","<b>Evāyaṃ sukhamedhatī</b>ti evaṃ vuttappakārena ayaṃ khujjasobhito nibbānasukhaṃ phalasamāpattisukhañca edhati, anubhavatīti attho."],"lineRefs":[["thag3.6:3"],["thag3.6:3"],["thag3.6:3"],["thag3.6:3"],["thag3.6:3"]]}],"wordLinks":[["thag3.6:1.1","cittakathī",0,0],["thag3.6:1.1","bahussutā",0,1],["thag3.6:1.1","samaṇā",0,2],["thag3.6:1.3","dvāre tiṭṭhatī",0,4],["thag3.6:2.3","māluterito",2,0],["thag3.6:3.1","suyuddhenā",7,0],["thag3.6:3.1","suyiṭṭhenā",7,1],["thag3.6:3.1","saṅgāmavijayena cā",7,2],["thag3.6:3.3","brahmacariyānuciṇṇenā",7,3],["thag3.6:3.3","evāyaṃ sukhamedhatī",7,4]]},"tika":null}
