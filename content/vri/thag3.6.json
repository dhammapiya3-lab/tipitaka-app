{"suttaId":"thag3.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[1196,1205],"vripara":"234"},"segments":{"thag3.6:0.4":"Khujjasobhitattheragāthā","thag3.6:1.1":"“Ye cittakathī bahussutā, samaṇā pāṭaliputtavāsino;","thag3.6:1.3":"Tesaññataroyamāyuvā, dvāre tiṭṭhati khujjasobhito.","thag3.6:2.1":"“Ye cittakathī bahussutā, samaṇā pāṭaliputtavāsino;","thag3.6:2.3":"Tesaññataroyamāyuvā, dvāre tiṭṭhati māluterito.","thag3.6:3.1":"“Suyuddhena suyiṭṭhena, saṅgāmavijayena ca;","thag3.6:3.3":"Brahmacariyānuciṇṇena, evāyaṃ sukhamedhatī”ti.","thag3.6:3.5":"… Khujjasobhito thero …."},"attha":null,"tika":null}
