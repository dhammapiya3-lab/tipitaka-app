{"suttaId":"pv31","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[1510,1558],"vripara":"464"},"segments":{"pv31:0.3":"Seriṇīpetavatthu","pv31:1.1":"“Naggā dubbaṇṇarūpāsi,","pv31:1.2":"kisā dhamanisanthatā;","pv31:1.3":"Upphāsulike kisike,","pv31:1.4":"kā nu tvaṃ idha tiṭṭhasī”ti.","pv31:2.1":"“Ahaṃ bhadante petīmhi,","pv31:2.2":"duggatā yamalokikā;","pv31:2.3":"Pāpakammaṃ karitvāna,","pv31:2.4":"petalokaṃ ito gatā”ti.","pv31:3.1":"“Kiṃ nu kāyena vācāya,","pv31:3.2":"manasā kukkaṭaṃ kataṃ;","pv31:3.3":"Kissa kammavipākena,","pv31:3.4":"petalokaṃ ito gatā”ti.","pv31:4.1":"“Anāvaṭesu titthesu,","pv31:4.2":"viciniṃ aḍḍhamāsakaṃ;","pv31:4.3":"Santesu deyyadhammesu,","pv31:4.4":"dīpaṃ nākāsimattano.","pv31:5.1":"“Nadiṃ upemi tasitā,","pv31:5.2":"rittakā parivattati;","pv31:5.3":"Chāyaṃ upemi uṇhesu,","pv31:5.4":"ātapo parivattati.","pv31:6.1":"“Aggivaṇṇo ca me vāto,","pv31:6.2":"ḍahanto upavāyati;","pv31:6.3":"Etañca bhante arahāmi,","pv31:6.4":"aññañca pāpakaṃ tato.","pv31:7.1":"“Gantvāna hatthiniṃ puraṃ,","pv31:7.2":"vajjesi mayha mātaraṃ;","pv31:7.3":"‘Dhītā ca te mayā diṭṭhā,","pv31:7.4":"duggatā yamalokikā;","pv31:7.5":"Pāpakammaṃ karitvāna,","pv31:7.6":"petalokaṃ ito gatā’.","pv31:8.1":"“Atthi me ettha nikkhittaṃ,","pv31:8.2":"anakkhātañca taṃ mayā;","pv31:8.3":"Cattārisatasahassāni,","pv31:8.4":"pallaṅkassa ca heṭṭhato.","pv31:9.1":"“Tato me dānaṃ dadatu,","pv31:9.2":"tassā ca hotu jīvikā;","pv31:9.3":"Dānaṃ datvā ca me mātā,","pv31:9.4":"dakkhiṇaṃ anudicchatu [anudissatu (sī. pī.), anvādissatu (syā.)];","pv31:9.5":"Tadāhaṃ sukhitā hessaṃ,","pv31:9.6":"sabbakāmasamiddhinī”ti.","pv31:10.1":"“Sādhū”ti so paṭissutvā,","pv31:10.2":"gantvāna hatthiniṃ puraṃ;","pv31:10.3":"Avoca tassā mātaraṃ –","pv31:11.1":"‘Dhītā ca te mayā diṭṭhā,","pv31:11.2":"duggatā yamalokikā;","pv31:11.3":"Pāpakammaṃ karitvāna,","pv31:11.4":"petalokaṃ ito gatā’.","pv31:12.1":"“Sā maṃ tattha samādapesi,()[(gantvāna hatthiniṃ puraṃ)(syā. ka.)]","pv31:12.2":"vajjesi mayha mātaraṃ;","pv31:12.3":"‘Dhītā ca te mayā diṭṭhā,","pv31:12.4":"duggatā yamalokikā;","pv31:12.5":"Pāpakammaṃ karitvāna,","pv31:12.6":"petalokaṃ ito gatā’.","pv31:13.1":"“Atthi ca me ettha nikkhittaṃ,","pv31:13.2":"anakkhātañca taṃ mayā;","pv31:13.3":"Cattārisatasahassāni,","pv31:13.4":"pallaṅkassa ca heṭṭhato.","pv31:14.1":"“Tato me dānaṃ dadatu,","pv31:14.2":"tassā ca hotu jīvikā;","pv31:14.3":"Dānaṃ datvā ca me mātā,","pv31:14.4":"dakkhiṇaṃ anudicchatu ()[(tato tuvaṃ dānaṃ dehi, tassā dakkhiṇamādisī)(ka.)];","pv31:14.5":"‘Tadā sā sukhitā hessaṃ,","pv31:14.6":"sabbakāmasamiddhinī’”ti.","pv31:15.1":"Tato hi sā dānamadā,","pv31:15.2":"tassā dakkhiṇamādisī;","pv31:15.3":"Petī ca sukhitā āsi,","pv31:15.4":"tassā cāsi sujīvikāti.","pv31:16.1":"Seriṇīpetavatthu chaṭṭhaṃ."},"unsure":[],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":2087,"to":2090,"paras":[{"para":2087,"vripara":"467","refs":["pv31:4"],"lines":["Tattha <b>anāvaṭesu titthesū</b>ti kenaci anivāritesu nadītaḷākādīnaṃ titthapadesesu, yattha manussā nhāyanti, udakakiccaṃ karonti, tādisesu ṭhānesu.","<b>Viciniṃ aḍḍhamāsakan</b>ti “manussehi ṭhapetvā vissaritaṃ apināmettha kiñci labheyyan”ti lobhābhibhūtā aḍḍhamāsakamattampi viciniṃ gavesiṃ.","Atha vā <b>anāvaṭesu titthesū</b>ti upasaṅkamanena kenaci anivāritesu sattānaṃ payogāsayasuddhiyā kāraṇabhāvena titthabhūtesu samaṇabrāhmaṇesu vijjamānesu.","<b>Viciniṃ aḍḍhamāsakan</b>ti maccheramalapariyuṭṭhitacittā kassaci kiñci adentī aḍḍhamāsakampi visesena ciniṃ, na sañciniṃ puññaṃ.","Tenāha <b>“santesu deyyadhammesu, dīpaṃ nākāsimattano”</b>ti."],"lineRefs":[["pv31:4"],["pv31:4"],["pv31:4"],["pv31:4"],["pv31:4"]]},{"para":2088,"vripara":"468","refs":["pv31:5"],"lines":["<b>Tasitā</b>ti pipāsitā.","<b>Rittakā</b>ti kākapeyyā sandamānāpi nadī mama pāpakammena udakena rittā tucchā vālikamattā hutvā parivattati.","<b>Uṇhesū</b>ti uṇhasamayesu.","<b>Ātapo parivattatī</b>ti chāyāṭṭhānaṃ mayi upagatāya ātapo sampajjati."],"lineRefs":[["pv31:5"],["pv31:5"],["pv31:5"],["pv31:5"]]},{"para":2089,"vripara":"469-470","refs":["pv31:6"],"lines":["469-70. <b>Aggivaṇṇo</b>ti samphassena aggisadiso.","Tena vuttaṃ <b>“ḍahanto upavāyatī”</b>ti.","<b>Etañca, bhante, arahāmī</b>ti, <b>bhante</b>ti taṃ upāsakaṃ garukārena vadati.","Bhante, etañca yathāvuttaṃ pipāsādidukkhaṃ, aññañca tato pāpakaṃ dāruṇaṃ dukkhaṃ anubhavituṃ arahāmi tajjassa pāpassa katattāti adhippāyo.","<b>Vajjesī</b>ti vadeyyāsi."],"lineRefs":[["pv31:6"],["pv31:6"],["pv31:6"],["pv31:6"],["pv31:6"]]},{"para":2090,"vripara":"471-472","refs":["pv31:8"],"lines":["471-72. <b>Ettha nikkhittaṃ, anakkhātan</b>ti “ettakaṃ ettha nikkhittan”ti anācikkhitaṃ.","Idāni tassa parimāṇaṃ ṭhapitaṭṭhānañca dassentī <b>“cattāri satasahassāni, pallaṅkassa ca heṭṭhato”</b>ti āha.","Tattha <b>pallaṅkassā</b>ti pubbe attano sayanapallaṅkassa.","<b>Tato</b>ti nihitadhanato ekadesaṃ gahetvā mamaṃ uddissa dānaṃ detu.","<b>Tassā</b>ti mayhaṃ mātuyā."],"lineRefs":[["pv31:8"],["pv31:8"],["pv31:8"],["pv31:8"],["pv31:8"]]}],"wordLinks":[["pv31:4.1","anāvaṭesu titthesū",0,0],["pv31:4.1","viciniṃ aḍḍhamāsakaṃ",0,1],["pv31:4.1","anāvaṭesu titthesū",0,2],["pv31:4.1","viciniṃ aḍḍhamāsakaṃ",0,3],["pv31:4.3","santesu deyyadhammesu dīpaṃ nākāsimattano",0,4],["pv31:5.1","tasitā",1,0],["pv31:5.1","rittakā",1,1],["pv31:5.3","uṇhesū",1,2],["pv31:5.3","ātapo parivattatī",1,3],["pv31:6.1","aggivaṇṇo",2,0],["pv31:6.1","ḍahanto upavāyatī",2,1],["pv31:6.3","bhante",2,2],["pv31:6.3","etañca bhante arahāmī",2,2],["pv31:8.1","ettha nikkhittaṃ anakkhātaṃ",3,0],["pv31:8.3","cattāri satasahassāni pallaṅkassa ca heṭṭhato",3,1],["pv31:8.3","pallaṅkassā",3,2]],"before":[{"para":2050,"vripara":null,"refs":[],"lines":["Kumārapetavatthuvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2051,"vripara":null,"refs":[],"lines":["Seriṇīpetivatthuvaṇṇanā"],"lineRefs":[[]]},{"para":2052,"vripara":null,"refs":[],"lines":["<b>Naggā dubbaṇṇarūpāsī</b>ti idaṃ satthari jetavane viharante seriṇīpetiṃ ārabbha vuttaṃ.","Kururaṭṭhe kira hatthinipure seriṇī nāma ekā rūpūpajīvinī ahosi.","Tattha ca uposathakaraṇatthāya tato tato bhikkhū sannipatiṃsu.","Puna mahābhikkhusannipāto ahosi.","Taṃ disvā manussā tilataṇḍulādiṃ sappinavanītamadhuādiñca bahuṃ dānūpakaraṇaṃ sajjetvā mahādānaṃ pavattesuṃ.","Tena ca samayena sā gaṇikā assaddhā appasannā maccheramalapariyuṭṭhitacittā tehi manussehi “ehi tāva idaṃ dānaṃ anumodāhī”ti ussāhitāpi “kiṃ tena muṇḍakānaṃ samaṇānaṃ dinnenā”ti appasādameva nesaṃ sampavedesi, kuto appamattakassa pariccāgo."],"lineRefs":[[],[],[],[],[],[]]},{"para":2053,"vripara":null,"refs":[],"lines":["Sā aparena samayena kālaṃ katvā aññatarassa paccantanagarassa parikhāpiṭṭhe petī hutvā nibbatti.","Atha hatthinipuravāsī aññataro upāsako vaṇijjāya taṃ nagaraṃ gantvā rattiyā paccūsasamaye parikhāpiṭṭhaṃ gato tādisena payojanena.","Sā tattha taṃ disvā sañjānitvā naggā aṭṭhittacamattāvasesasarīrā ativiya bībhacchadassanā avidūre ṭhatvā attānaṃ dassesi.","So taṃ disvā –"],"lineRefs":[[],[],[],[]]},{"para":2055,"vripara":"464","refs":[],"lines":["“Naggā dubbaṇṇarūpāsi, kisā dhamanisanthatā;"],"lineRefs":[[]]},{"para":2056,"vripara":null,"refs":[],"lines":["Upphāsulike kisike, kā nu tvaṃ idha tiṭṭhasī”ti.","–"],"lineRefs":[[],[]]},{"para":2057,"vripara":null,"refs":[],"lines":["Gāthāya pucchi.","Sāpissa –"],"lineRefs":[[],[]]},{"para":2059,"vripara":"465","refs":[],"lines":["“Ahaṃ bhadante petīmhi, duggatā yamalokikā;"],"lineRefs":[[]]},{"para":2060,"vripara":null,"refs":[],"lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gatā”ti.","–"],"lineRefs":[[],[]]},{"para":2061,"vripara":null,"refs":[],"lines":["Gāthāya attānaṃ pakāsesi.","Puna tena –"],"lineRefs":[[],[]]},{"para":2063,"vripara":"466","refs":[],"lines":["“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;"],"lineRefs":[[]]},{"para":2064,"vripara":null,"refs":[],"lines":["Kissakammavipākena, petalokaṃ ito gatā”ti.","–"],"lineRefs":[[],[]]},{"para":2065,"vripara":null,"refs":[],"lines":["Gāthāya katakammaṃ pucchitā –"],"lineRefs":[[]]},{"para":2067,"vripara":"467","refs":[],"lines":["“Anāvaṭesu titthesu, viciniṃ aḍḍhamāsakaṃ;"],"lineRefs":[[]]},{"para":2068,"vripara":null,"refs":[],"lines":["Santesu deyyadhammesu, dīpaṃ nākāsimattano."],"lineRefs":[[]]},{"para":2070,"vripara":"468","refs":[],"lines":["“Nadiṃ upemi tasitā, rittakā parivattati;"],"lineRefs":[[]]},{"para":2071,"vripara":null,"refs":[],"lines":["Chāyaṃ upemi uṇhesu, ātapo parivattati."],"lineRefs":[[]]},{"para":2073,"vripara":"469","refs":[],"lines":["“Aggivaṇṇo ca me vāto, ḍahanto upavāyati;"],"lineRefs":[[]]},{"para":2074,"vripara":null,"refs":[],"lines":["Etañca bhante arahāmi, aññañca pāpakaṃ tato."],"lineRefs":[[]]},{"para":2076,"vripara":"470","refs":[],"lines":["“Gantvāna hatthiniṃ puraṃ, vajjesi mayha mātaraṃ;"],"lineRefs":[[]]},{"para":2077,"vripara":null,"refs":[],"lines":["‘Dhītā ca te mayā diṭṭhā, duggatā yamalokikā;"],"lineRefs":[[]]},{"para":2078,"vripara":null,"refs":[],"lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gatā’."],"lineRefs":[[]]},{"para":2080,"vripara":"471","refs":[],"lines":["“Atthi me ettha nikkhittaṃ, anakkhātañca taṃ mayā;"],"lineRefs":[[]]},{"para":2081,"vripara":null,"refs":[],"lines":["Cattāri satasahassāni, pallaṅkassa ca heṭṭhato."],"lineRefs":[[]]},{"para":2083,"vripara":"472","refs":[],"lines":["“Tato me dānaṃ dadatu, tassā ca hotu jīvikā;"],"lineRefs":[[]]},{"para":2084,"vripara":null,"refs":[],"lines":["Dānaṃ datvā ca me mātā, dakkhiṇaṃ anudicchatu;"],"lineRefs":[[]]},{"para":2085,"vripara":null,"refs":[],"lines":["Tadāhaṃ sukhitā hessaṃ, sabbakāmasamiddhinī”ti.","–"],"lineRefs":[[],[]]},{"para":2086,"vripara":null,"refs":[],"lines":["Imāhi chahi gāthāhi attanā katakammañceva puna tena attano kātabbaṃ atthañca ācikkhi."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
