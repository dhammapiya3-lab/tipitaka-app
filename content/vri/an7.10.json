{"suttaId":"an7.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-vii","vriCode":"s0403m3.mul","paras":[71,75],"vripara":"10"},"segments":{"an7.10:0.3":"Macchariyasuttaṃ","an7.10:1.1":"“Sattimāni, bhikkhave, saṃyojanāni.","an7.10:1.2":"Katamāni satta?","an7.10:1.3":"Anunayasaṃyojanaṃ, paṭighasaṃyojanaṃ, diṭṭhisaṃyojanaṃ, vicikicchāsaṃyojanaṃ, mānasaṃyojanaṃ, issāsaṃyojanaṃ, macchariyasaṃyojanaṃ.","an7.10:1.4":"Imāni kho, bhikkhave, satta saṃyojanānī”ti.","an7.10:1.5":"Dasamaṃ.","an7.10:1.6":"Dhanavaggo paṭhamo.","an7.10:2.0":"Tassuddānaṃ –","an7.10:2.1":"Dve piyāni balaṃ dhanaṃ, saṃkhittañceva vitthataṃ;","an7.10:2.3":"Uggaṃ saṃyojanañceva,","an7.10:2.4":"pahānaṃ macchariyena cāti."},"unsure":["an7.10:2.1"],"preface":[],"attha":null,"tika":{"book":"Mp-t-vii","bookName":"Sattakanipāta-ṭīkā","vriCode":"s0403t.tik","from":796,"to":798,"paras":[{"para":796,"vripara":"1-10","refs":["an7.10:1"],"lines":["1-10. Sattakanipātassa paṭhamo vaggo uttānattho."],"lineRefs":[["an7.10:1"]]},{"para":797,"vripara":null,"refs":["an7.10:1"],"lines":["Anusayavaggo"],"lineRefs":[["an7.10:1"]]},{"para":798,"vripara":null,"refs":["an7.10:1"],"lines":["Puggalasuttavaṇṇanā"],"lineRefs":[["an7.10:1"]]}],"wordLinks":[]},"tika2":null}
