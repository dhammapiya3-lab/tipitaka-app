{"suttaId":"an2.310-479","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-ii","vriCode":"s0402m1.mul","paras":[313,318],"vripara":"231"},"segments":{"an2.310-319:0.2":"Rāgapeyyālaṃ","an2.310-319:1.1":"“Rāgassa, bhikkhave, abhiññāya dve dhammā bhāvetabbā.","an2.310-319:1.2":"Katame dve?","an2.310-319:1.3":"Samatho ca vipassanā ca.","an2.310-319:1.4":"Rāgassa, bhikkhave, abhiññāya ime dve dhammā bhāvetabbā”ti.","an2.310-319:2.1":"“Rāgassa, bhikkhave, pariññāya dve dhammā bhāvetabbā.","an2.320-479:1.2":"Katame dve?","an2.320-479:1.3":"Samatho ca vipassanā ca.","an2.320-479:1.4":"232-246. “Dosassa … pe … mohassa … kodhassa … upanāhassa … makkhassa … paḷāsassa … issāya … macchariyassa … māyāya … sāṭheyyassa … thambhassa … sārambhassa … mānassa … atimānassa … madassa … pamādassa, bhikkhave, abhiññāya dve dhammā bhāvetabbā. Pamādassa, bhikkhave, paṭinissaggāya ime dve dhammā bhāvetabbā”ti.","an2.320-479:2.1":"(Idamavoca bhagavā.","an2.320-479:2.2":"Attamanā te bhikkhū bhagavato bhāsitaṃ abhinandunti.)[() etthantare pāṭho sī. syā. kaṃ. pī. potthakesu natthi]","an2.320-479:2.3":"Rāgapeyyālaṃ niṭṭhitaṃ.","an2.320-479:2.4":"Dukanipātapāḷi niṭṭhitā."},"unsure":[],"attha":{"book":"Mp-ii","bookName":"Dukanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":318,"to":319,"paras":[{"para":318,"vripara":"231","refs":["an2.310-319"],"lines":["<b>Rāgassa</b>, <b>bhikkhave, abhiññāyā</b>ti pañcakāmaguṇikarāgassa abhijānanatthaṃ paccakkhakaraṇatthaṃ.","<b>Pariññāyā</b>ti parijānanatthaṃ.","<b>Parikkhayāyā</b>ti parikkhayagamanatthaṃ.","<b>Pahānāyā</b>ti pajahanatthaṃ.","<b>Khayāya vayāyā</b>ti khayavayagamanatthaṃ.","<b>Virāgāyā</b>ti virajjanatthaṃ.","<b>Nirodhāyā</b>ti nirujjhanatthaṃ.","<b>Cāgāyā</b>ti cajanatthaṃ.","<b>Paṭinissaggāyā</b>ti paṭinissajjanatthaṃ."],"lineRefs":[["an2.310-319"],["an2.310-319"],["an2.310-319"],["an2.310-319"],["an2.310-319"],["an2.310-319"],["an2.310-319"],["an2.310-319"],["an2.310-319"]]},{"para":319,"vripara":"232-246","refs":["an2.320-479"],"lines":["232-246. <b>Thambhassā</b>ti kodhamānavasena thaddhabhāvassa.","<b>Sārabbhassā</b>ti kāraṇuttariyalakkhaṇassa sārabbhassa.","<b>Mānassā</b>ti navavidhamānassa.","<b>Atimānassā</b>ti atikkamitvā maññanamānassa.","<b>Madassā</b>ti majjanākāramadassa.","<b>Pamādassā</b>ti sativippavāsassa, pañcasu kāmaguṇesu cittavossaggassa.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["an2.320-479"],["an2.320-479"],["an2.320-479"],["an2.320-479"],["an2.320-479"],["an2.320-479"],["an2.320-479"]]}],"wordLinks":[["an2.310-319:1.1","bhikkhave abhiññāyā",0,0],["an2.310-319:1.1","rāgassa",0,0],["an2.310-319:1.4","bhikkhave abhiññāyā",0,0],["an2.310-319:1.4","rāgassa",0,0],["an2.310-319:2.1","rāgassa",0,0],["an2.310-319:2.1","pariññāyā",0,1],["an2.320-479:1.4","thambhassā",1,0],["an2.320-479:1.4","mānassā",1,2],["an2.320-479:1.4","atimānassā",1,3],["an2.320-479:1.4","madassā",1,4],["an2.320-479:1.4","pamādassā",1,5]],"before":[{"para":316,"vripara":null,"refs":[],"lines":["Vinayapeyyālaṃ niṭṭhitaṃ."],"lineRefs":[[]]},{"para":317,"vripara":null,"refs":[],"lines":["Rāgapeyyālaṃ"],"lineRefs":[[]]}]},"tika":null,"tika2":null}
