{"suttaId":"vv47","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1798,1837],"vripara":"795"},"segments":{"vv47:0.4":"Pītavimānavatthu","vv47:1.1":"“Pītavatthe pītadhaje,","vv47:1.2":"pītālaṅkārabhūsite;","vv47:1.3":"Pītacandanalittaṅge,","vv47:1.4":"pītauppalamālinī [pītuppalamadhārinī (syā. ka.), pītuppalamālinī (pī.)].","vv47:2.1":"“Pītapāsādasayane,","vv47:2.2":"pītāsane pītabhājane;","vv47:2.3":"Pītachatte pītarathe,","vv47:2.4":"pītasse pītabījane.","vv47:3.1":"“Kiṃ kammamakarī bhadde,","vv47:3.2":"pubbe mānusake bhave;","vv47:3.3":"Devate pucchitācikkha,","vv47:3.4":"kissa kammassidaṃ phalan”ti.","vv47:4.1":"“Kosātakī nāma latatthi bhante,","vv47:4.2":"tittikā anabhicchitā;","vv47:4.3":"Tassā cattāri pupphāni,","vv47:4.4":"thūpaṃ abhihariṃ ahaṃ.","vv47:5.1":"“Satthu sarīramuddissa,","vv47:5.2":"vippasannena cetasā;","vv47:5.3":"Nāssa maggaṃ avekkhissaṃ,","vv47:5.4":"na taggamanasā [tadaggamanasā (sī.), tadaṅgamanasā (syā.)] satī.","vv47:6.1":"“Tato maṃ avadhī gāvī,","vv47:6.2":"thūpaṃ apattamānasaṃ;","vv47:6.3":"Tañcāhaṃ abhisañceyyaṃ,","vv47:6.4":"bhiyyo [bhīyo (sī. aṭṭha.)] nūna ito siyā.","vv47:7.1":"“Tena kammena devinda,","vv47:7.2":"maghavā devakuñjaro;","vv47:7.3":"Pahāya mānusaṃ dehaṃ,","vv47:7.4":"tava sahabya [sahabyata (sī. syā.)] māgatā”ti.","vv47:8.1":"Idaṃ sutvā tidasādhipati,","vv47:8.2":"maghavā devakuñjaro;","vv47:8.3":"Tāvatiṃse pasādento,","vv47:8.4":"mātaliṃ etadabravi [etadabrūvīti (sī.)].","vv47:9.1":"“Passa mātali accheraṃ,","vv47:9.2":"cittaṃ kammaphalaṃ idaṃ;","vv47:9.3":"Appakampi kataṃ deyyaṃ,","vv47:9.4":"puññaṃ hoti mahapphalaṃ.","vv47:10.1":"“Natthi citte pasannamhi,","vv47:10.2":"appakā nāma dakkhiṇā;","vv47:10.3":"Tathāgate vā sambuddhe,","vv47:10.4":"atha vā tassa sāvake.","vv47:11.1":"“Ehi mātali amhepi,","vv47:11.2":"bhiyyo bhiyyo mahemase;","vv47:11.3":"Tathāgatassa dhātuyo,","vv47:11.4":"sukho puññāna muccayo.","vv47:12.1":"“Tiṭṭhante nibbute cāpi,","vv47:12.2":"same citte samaṃ phalaṃ;","vv47:12.3":"Cetopaṇidhihetu hi,","vv47:12.4":"sattā gacchanti suggatiṃ.","vv47:13.1":"“Bahūnaṃ [bahunnaṃ (sī. syā.)] vata atthāya,","vv47:13.2":"uppajjanti tathāgatā;","vv47:13.3":"Yattha kāraṃ karitvāna,","vv47:13.4":"saggaṃ gacchanti dāyakā”ti.","vv47:14.1":"Pītavimānaṃ navamaṃ."},"unsure":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2123,"to":2150,"paras":[{"para":2123,"vripara":"795-796","refs":["vv47:1"],"lines":["795-6. Tattha <b>pītacandanalittaṅge</b>ti suvaṇṇavaṇṇena candanena anulittasarīre.","<b>Pītapāsādasayane</b>ti sabbasovaṇṇamayena pāsādena suvaṇṇaparikkhittehi sayanehi ca samannāgate.","Evaṃ sabbattha heṭṭhā upari ca pītasaddena suvaṇṇameva gahitanti daṭṭhabbaṃ."],"lineRefs":[["vv47:1"],["vv47:1"],["vv47:1"]]},{"para":2124,"vripara":"798","refs":["vv47:4"],"lines":["<b>Latatthī</b>ti latā atthi.","<b>Bhante</b>ti sakkaṃ devarājānaṃ gāravena ālapati.","<b>Anabhicchitā</b>ti na abhikaṅkhitā."],"lineRefs":[["vv47:4"],["vv47:4"],["vv47:4"]]},{"para":2125,"vripara":"799","refs":["vv47:5"],"lines":["<b>Sarīran</b>ti sarīrabhūtaṃ dhātuṃ.","Avayave cāyaṃ samudāyavohāro yathā “paṭo ḍaḍḍho, samuddo diṭṭho”ti ca.","<b>Assā</b>ti gorūpassa.","<b>Maggan</b>ti āgamanamaggaṃ.","<b>Na avekkhissan</b>ti na olokayiṃ.","Kasmā?","<b>Na taggamanasā satī</b>ti, tassaṃ gāviyaṃ gatamanā ṭhapitamanā na hontī, aññadatthu bhagavato thūpagatamanā eva samānāti attho.","“Tadaṅgamanasā satī”ti ca pāṭho, tadaṅge tassa bhagavato dhātuyā aṅge mano etissāti tadaṅgamanasā.","Evaṃbhūtā ahaṃ tadā tassā maggaṃ nāvekkhissanti dasseti."],"lineRefs":[["vv47:5"],["vv47:5"],["vv47:5"],["vv47:5"],["vv47:5"],["vv47:5"],["vv47:5"],["vv47:5"],["vv47:5"]]},{"para":2126,"vripara":"800","refs":["vv47:6"],"lines":["<b>Thūpaṃ apattamānasan</b>ti thūpaṃ cetiyaṃ asampattaajjhāsayaṃ, manasi bhavoti hi mānaso, ajjhāsayo manoratho.","“Thūpaṃ upagantvā pupphehi pūjessāmī”ti uppannamanorathassa asampuṇṇatāya evaṃ vuttaṃ.","Thūpaṃ cetiyaṃ pana pupphehi pūjanacittaṃ siddhameva, yena sā devaloke uppanna.","<b>Tañcāhaṃ abhisañceyyan</b>ti tañce ahaṃ abhisañcineyyaṃ, pupphapūjanena hi puññaṃ ahaṃ thūpaṃ abhigantvā yathādhippāyaṃ pūjanena sammadeva cineyyaṃ upacineyyanti attho.","<b>Bhiyyo nūna ito siyā</b>ti ito yathāladdhasampattitopi bhiyyo upari uttaritarā sampatti siyāti maññeti attho."],"lineRefs":[["vv47:6"],["vv47:6"],["vv47:6"],["vv47:6"],["vv47:6"]]},{"para":2127,"vripara":"801","refs":["vv47:7"],"lines":["<b>Maghavā devakuñjarā</b>ti ālapanaṃ.","Tattha <b>devakuñjarā</b>ti sabbabalaparakkamādivisesehi devesu kuñjarasadiso.","<b>Sahabyan</b>ti sahabhāvaṃ."],"lineRefs":[["vv47:7"],["vv47:7"],["vv47:7"]]},{"para":2129,"vripara":"802","refs":["vv47:7"],"lines":["“Idaṃ sutvā tidasādhipati, maghavā devakuñjaro;"],"lineRefs":[["vv47:7"]]},{"para":2130,"vripara":null,"refs":["vv47:7"],"lines":["Tāvatiṃse pasādento, mātaliṃ etadabravī”ti.","–"],"lineRefs":[["vv47:7"],["vv47:7"]]},{"para":2131,"vripara":null,"refs":["vv47:7"],"lines":["Idaṃ dhammasaṅgāhakavacanaṃ.","Tato sakko mātalipamukhassa devagaṇassa imāhi gāthāhi dhammaṃ desesi –"],"lineRefs":[["vv47:7"],["vv47:7"]]},{"para":2133,"vripara":"803","refs":["vv47:7"],"lines":["“Passa mātali accheraṃ, cittaṃ kammaphalaṃ idaṃ;"],"lineRefs":[["vv47:7"]]},{"para":2134,"vripara":null,"refs":["vv47:7"],"lines":["Appakampi kataṃ deyyaṃ, puññaṃ hoti mahapphalaṃ."],"lineRefs":[["vv47:7"]]},{"para":2136,"vripara":"804","refs":["vv47:7"],"lines":["“Natthi citte pasannamhi, appakā nāma dakkhiṇā;"],"lineRefs":[["vv47:7"]]},{"para":2137,"vripara":null,"refs":["vv47:7"],"lines":["Tathāgate vā sambuddhe, atha vā tassa sāvake."],"lineRefs":[["vv47:7"]]},{"para":2139,"vripara":"805","refs":["vv47:7"],"lines":["“Ehi mātali amhepi, bhiyyo bhiyyo mahemase;"],"lineRefs":[["vv47:7"]]},{"para":2140,"vripara":null,"refs":["vv47:7"],"lines":["Tathāgatassa dhātuyo, sukho puññānamuccayo."],"lineRefs":[["vv47:7"]]},{"para":2142,"vripara":"806","refs":["vv47:7"],"lines":["“Tiṭṭhante nibbute cāpi, same citte samaṃ phalaṃ;"],"lineRefs":[["vv47:7"]]},{"para":2143,"vripara":null,"refs":["vv47:7"],"lines":["Cetopaṇidhihetuhi, sattā gacchanti suggatiṃ."],"lineRefs":[["vv47:7"]]},{"para":2145,"vripara":"807","refs":["vv47:7"],"lines":["“Bahūnaṃ vata atthāya, uppajjanti tathāgatā;"],"lineRefs":[["vv47:7"]]},{"para":2146,"vripara":null,"refs":["vv47:7"],"lines":["Yattha kāraṃ karitvāna, saggaṃ gacchanti dāyakā”ti."],"lineRefs":[["vv47:7"]]},{"para":2147,"vripara":"802","refs":["vv47:8"],"lines":["Tattha <b>pasādento</b>ti pasanne karonto, ratanattaye saddhaṃ uppādentoti attho."],"lineRefs":[["vv47:8"]]},{"para":2148,"vripara":"803","refs":["vv47:9"],"lines":["<b>Cittan</b>ti vicittaṃ acinteyyaṃ.","<b>Kammaphalan</b>ti deyyadhammassa anuḷārattepi khettasampattiyā ca cittasampattiyā ca uḷārassa puññakammassa phalaṃ passāti yojanā.","<b>Appakampi kataṃ deyyaṃ, puññaṃ hoti mahapphalan</b>ti ettha <b>katan</b>ti kāravasena sakkāravasena āyatane viniyuttaṃ.","<b>Deyyan</b>ti dātabbavatthuṃ.","<b>Puññan</b>ti tathāpavattaṃ puññakammaṃ."],"lineRefs":[["vv47:9"],["vv47:9"],["vv47:9"],["vv47:9"],["vv47:9"]]},{"para":2149,"vripara":"804","refs":["vv47:10"],"lines":["Idāni yattha appakampi kataṃ puññaṃ mahapphalaṃ hoti, taṃ pākaṭaṃ katvā dassento <b>“natthi citte pasannamhī”</b>ti gāthamāha.","Taṃ suviññeyyameva."],"lineRefs":[["vv47:10"],["vv47:10"]]},{"para":2150,"vripara":"805-806","refs":["vv47:11"],"lines":["805-6. <b>Amhepī</b>ti mayampi.","<b>Mahemase</b>ti mahāmase pūjāmase.","<b>Cetopaṇidhihetu hī</b>ti attano cittassa sammadeva ṭhapananimittaṃ, attasammāpaṇidhānenāti attho.","Tenāha bhagavā –"],"lineRefs":[["vv47:11"],["vv47:11"],["vv47:11"],["vv47:11"]]}],"wordLinks":[["vv47:1.3","pītacandanalittaṅge",0,0],["vv47:4.1","latatthī",1,0],["vv47:4.1","bhante",1,1],["vv47:4.1","anabhicchitā",1,2],["vv47:5.1","sarīraṃ",2,0],["vv47:5.3","maggaṃ",2,3],["vv47:5.3","na taggamanasā satī",2,6],["vv47:6.1","thūpaṃ apattamānasaṃ",3,0],["vv47:6.3","tañcāhaṃ abhisañceyyaṃ",3,3],["vv47:6.3","bhiyyo nūna ito siyā",3,4],["vv47:7.1","maghavā devakuñjarā",4,0],["vv47:7.1","devakuñjarā",4,1],["vv47:7.3","sahabyaṃ",4,2],["vv47:8.3","pasādento",18,0],["vv47:9.1","cittaṃ",19,0],["vv47:9.1","kammaphalaṃ",19,1],["vv47:9.3","appakampi kataṃ deyyaṃ puññaṃ hoti mahapphalaṃ",19,2],["vv47:9.3","kataṃ",19,2],["vv47:9.3","deyyaṃ",19,3],["vv47:9.3","puññaṃ",19,4],["vv47:10.1","natthi citte pasannamhī",20,0],["vv47:11.1","amhepī",21,0],["vv47:11.1","mahemase",21,1]],"before":[{"para":2098,"vripara":null,"refs":[],"lines":["Ambavimānavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2099,"vripara":null,"refs":[],"lines":["Pītavimānavaṇṇanā"],"lineRefs":[[]]},{"para":2100,"vripara":null,"refs":[],"lines":["<b>Pītavatthe pītadhaje</b>ti pītavimānaṃ.","Tassa kā uppatti?","Bhagavati parinibbute raññā ajātasattunā attanā paṭiladdhā bhagavato sarīradhātuyo gahetvā thūpe ca mahe ca kate rājagahavāsinī aññatarā upāsikā pātova katasarīrapaṭijagganā “satthu thūpaṃ pūjessāmī”ti yathāladdhāni cattāri kosātakīpupphāni gahetvā saddhāvegena samussāhitamānasā maggaparissayaṃ anupadhāretvāva thūpābhimukhī gacchati.","Atha naṃ taruṇavacchā gāvī abhidhāvantī vegena āpatitvā siṅgena paharitvā jīvitakkhayaṃ pāpesi.","Sā tāvadeva tāvatiṃsabhavane nibbattantī sakkassa devarañño uyyānakīḷāya gacchantassa parivārabhūtānaṃ aḍḍhatiyānaṃ nāṭakakoṭīnaṃ majjhe attano sarīrapabhāya tā sabbā abhibhavantī saha rathena pāturahosi.","Taṃ disvā sakko devarājā vimhitacitto acchariyabbhutajāto “kīdisena nu kho oḷārikena kammunā ayaṃ edisiṃ sumahatiṃ deviddhimupāgatā”ti taṃ imāhi gāthāhi pucchi –"],"lineRefs":[[],[],[],[],[],[]]},{"para":2102,"vripara":"795","refs":[],"lines":["“Pītavatthe pītadhaje, pītālaṅkārabhūsite;"],"lineRefs":[[]]},{"para":2103,"vripara":null,"refs":[],"lines":["Pītacandanalittaṅge, pītauppalamālinī."],"lineRefs":[[]]},{"para":2105,"vripara":"796","refs":[],"lines":["“Pītapāsādasayane, pītāsane pītabhājane;"],"lineRefs":[[]]},{"para":2106,"vripara":null,"refs":[],"lines":["Pītachatte pītarathe, pītasse pītabījane."],"lineRefs":[[]]},{"para":2108,"vripara":"797","refs":[],"lines":["“Kiṃ kammamakarī bhadde, pubbe mānusake bhave;"],"lineRefs":[[]]},{"para":2109,"vripara":null,"refs":[],"lines":["Devate pucchitācikkha, kissa kammassidaṃ phalan”ti."],"lineRefs":[[]]},{"para":2110,"vripara":null,"refs":[],"lines":["Sāpissa imāhi gāthāhi byākāsi –"],"lineRefs":[[]]},{"para":2112,"vripara":"798","refs":[],"lines":["“Kosātakī nāma latatthi bhante, tittikā anabhicchitā;"],"lineRefs":[[]]},{"para":2113,"vripara":null,"refs":[],"lines":["Tassā cattāri pupphāni, thūpaṃ abhihariṃ ahaṃ."],"lineRefs":[[]]},{"para":2115,"vripara":"799","refs":[],"lines":["“Satthu sarīramuddissa, vippasannena cetasā;"],"lineRefs":[[]]},{"para":2116,"vripara":null,"refs":[],"lines":["Nāssa maggaṃ avekkhissaṃ, na taggamanasā satī."],"lineRefs":[[]]},{"para":2118,"vripara":"800","refs":[],"lines":["“Tato maṃ avadhī gāvī, thūpaṃ apattamānasaṃ;"],"lineRefs":[[]]},{"para":2119,"vripara":null,"refs":[],"lines":["Tañcāhaṃ abhisañceyyaṃ, bhiyyo nūna ito siyā."],"lineRefs":[[]]},{"para":2121,"vripara":"801","refs":[],"lines":["“Tena kammena devinda, maghavā devakuñjara;"],"lineRefs":[[]]},{"para":2122,"vripara":null,"refs":[],"lines":["Pahāya mānusaṃ dehaṃ, tava sahabyamāgatā”ti."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
