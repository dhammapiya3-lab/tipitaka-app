{"suttaId":"sn39.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1577,1579],"vripara":"331"},"segments":{"sn39.16:0.3":"Dukkarasuttaṃ","sn39.16:1.1":"“Kiṃ nu kho, āvuso sāriputta, imasmiṃ dhammavinaye dukkaran”ti?","sn39.16:1.2":"“Pabbajjā kho, āvuso, imasmiṃ dhammavinaye dukkarā”ti.","sn39.16:1.3":"“Pabbajitena panāvuso, kiṃ dukkaran”ti?","sn39.16:1.4":"“Pabbajitena kho, āvuso, abhirati dukkarā”ti.","sn39.16:1.5":"“Abhiratena panāvuso, kiṃ dukkaran”ti?","sn39.16:1.6":"“Abhiratena kho, āvuso, dhammānudhammappaṭipatti dukkarā”ti.","sn39.16:1.7":"“Kīvaciraṃ panāvuso, dhammānudhammappaṭipanno bhikkhu arahaṃ assā”ti?","sn39.16:1.8":"“Naciraṃ, āvuso”ti.","sn39.16:1.9":"Soḷasamaṃ.","sn39.16:1.10":"(Purimakasadisaṃ uddānaṃ.)","sn39.16:1.11":"Sāmaṇḍakasaṃyuttaṃ samattaṃ."},"attha":null,"tika":null}
