{"suttaId":"sn39.16","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1577,1579],"vripara":"331"},"segments":{"sn39.16:0.3":"Dukkarasuttaṃ","sn39.16:1.1":"“Kiṃ nu kho, āvuso sāriputta, imasmiṃ dhammavinaye dukkaran”ti?","sn39.16:1.2":"“Pabbajjā kho, āvuso, imasmiṃ dhammavinaye dukkarā”ti.","sn39.16:1.3":"“Pabbajitena panāvuso, kiṃ dukkaran”ti?","sn39.16:1.4":"“Pabbajitena kho, āvuso, abhirati dukkarā”ti.","sn39.16:1.5":"“Abhiratena panāvuso, kiṃ dukkaran”ti?","sn39.16:1.6":"“Abhiratena kho, āvuso, dhammānudhammappaṭipatti dukkarā”ti.","sn39.16:1.7":"“Kīvaciraṃ panāvuso, dhammānudhammappaṭipanno bhikkhu arahaṃ assā”ti?","sn39.16:1.8":"“Naciraṃ, āvuso”ti.","sn39.16:1.9":"Soḷasamaṃ.","sn39.16:1.10":"(Purimakasadisaṃ uddānaṃ.)","sn39.16:1.11":"Sāmaṇḍakasaṃyuttaṃ samattaṃ."},"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":676,"to":679,"paras":[{"para":676,"vripara":"330-331","refs":["sn39.16:1"],"lines":["330-331. Sāmaṇḍakasaṃyuttepi imināva nayena attho veditabbo."],"lineRefs":[["sn39.16:1"]]},{"para":677,"vripara":null,"refs":[],"lines":["Sāmaṇḍakasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":678,"vripara":null,"refs":[],"lines":["Moggallānasaṃyuttaṃ"],"lineRefs":[[]]},{"para":679,"vripara":null,"refs":["sn39.16:1"],"lines":["1-8. Paṭhamajhānapañhāsuttādivaṇṇanā"],"lineRefs":[["sn39.16:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":586,"to":589,"paras":[{"para":586,"vripara":"330-331","refs":["sn39.16:1"],"lines":["330-331. <b>Imināva nayenā</b>ti yo jambukhādakasaṃyutte atthanayo, imināva nayena.","Iminā hi dve saṃyuttāni pāḷito atthato ca aññamaññaṃ sadisānevāti dasseti."],"lineRefs":[["sn39.16:1"],["sn39.16:1"]]},{"para":587,"vripara":null,"refs":[],"lines":["Sāmaṇḍakasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":588,"vripara":null,"refs":[],"lines":["Moggallānasaṃyuttaṃ"],"lineRefs":[[]]},{"para":589,"vripara":null,"refs":["sn39.16:1"],"lines":["1-8. Paṭhamajjhānapañhasuttādivaṇṇanā"],"lineRefs":[["sn39.16:1"]]}],"wordLinks":[]}}
