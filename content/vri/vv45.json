{"suttaId":"vv45","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[1729,1767],"vripara":"755"},"segments":{"vv45:0.4":"Caturitthivimānavatthu","vv45:1.1":"“Abhikkantena vaṇṇena … pe …","vv45:1.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv45:2.1":"Sā devatā attamanā … pe …","vv45:2.3":"yassa kammassidaṃ phalaṃ.","vv45:3.1":"“Indīvarānaṃ hatthakaṃ ahamadāsiṃ,","vv45:3.2":"bhikkhuno piṇḍāya carantassa;","vv45:3.3":"Esikānaṃ uṇṇatasmiṃ,","vv45:3.4":"nagaravare paṇṇakate ramme.","vv45:4.1":"“Tena metādiso vaṇṇo … pe …","vv45:4.3":"vaṇṇo ca me sabbadissā pabhāsatī”ti.","vv45:9.1":"“Abhikkantena vaṇṇena … pe …","vv45:9.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv45:10.1":"Sā devatā attamanā … pe …","vv45:10.3":"yassa kammassidaṃ phalaṃ.","vv45:11.1":"“Odātamūlakaṃ haritapattaṃ,","vv45:11.2":"udakasmiṃ sare jātaṃ ahamadāsiṃ;","vv45:11.3":"Bhikkhuno piṇḍāya carantassa,","vv45:11.4":"esikānaṃ uṇṇatasmiṃ;","vv45:11.5":"Nagaravare paṇṇakate ramme.","vv45:12.1":"“Tena metādiso vaṇṇo … pe …","vv45:12.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv45:13.1":"“Abhikkantena vaṇṇena … pe …","vv45:13.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti.","vv45:14.1":"Sā devatā attamanā … pe …","vv45:14.3":"yassa kammassidaṃ phalaṃ.","vv45:15.1":"“Ahaṃ sumanā sumanassa sumanamakuḷāni,","vv45:15.2":"dantavaṇṇāni ahamadāsiṃ;","vv45:15.3":"Bhikkhuno piṇḍāya carantassa,","vv45:15.4":"esikānaṃ uṇṇatasmiṃ;","vv45:15.5":"Nagaravare paṇṇakate ramme.","vv45:16.1":"“Tena metādiso vaṇṇo … pe …","vv45:16.3":"vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv45:17.1":"Caturitthivimānaṃ sattamaṃ."},"unsure":["vv45:4.3"],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2059,"to":2062,"paras":[{"para":2059,"vripara":"759","refs":["vv45:3"],"lines":["Tattha <b>indīvarānaṃ hatthakan</b>ti uddālakapupphahatthaṃ vātaghātakapupphakalāpaṃ.","<b>Esikānan</b>ti esikāraṭṭhassa.","<b>Uṇṇatasmiṃ nagaravare</b>ti uṇṇate bhūmipadese niviṭṭhe meghodaraṃ liha