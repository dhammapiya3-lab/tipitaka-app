{"suttaId":"sn36.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1256,1260],"vripara":"249"},"segments":{"sn36.1:0.3":"Samādhisuttaṃ","sn36.1:1.1":"“Tisso imā, bhikkhave, vedanā.","sn36.1:1.2":"Katamā tisso?","sn36.1:1.3":"Sukhā vedanā, dukkhā vedanā, adukkhamasukhā vedanā –","sn36.1:1.4":"imā kho, bhikkhave, tisso vedanāti.","sn36.1:2.1":"“Samāhito sampajāno,","sn36.1:2.2":"sato buddhassa sāvako;","sn36.1:2.3":"Vedanā ca pajānāti,","sn36.1:2.4":"vedanānañca sambhavaṃ.","sn36.1:3.1":"“Yattha cetā nirujjhanti,","sn36.1:3.2":"maggañca khayagāminaṃ;","sn36.1:3.3":"Vedanānaṃ khayā bhikkhu,","sn36.1:3.4":"nicchāto parinibbuto”ti.","sn36.1:3.5":"paṭhamaṃ; 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-iv","bookName":"Saḷāyatanavagga-aṭṭhakathā","vriCode":"s0304a.att","from":594,"to":594,"paras":[{"para":594,"vripara":"249","refs":["sn36.1:2","sn36.1:3"],"lines":["Vedanāsaṃyutte sagāthāvaggassa paṭhame <b>samāhito</b>ti upacārena vā appanāya vā samāhito.","<b>Vedanā ca pajānātī</b>ti vedanā dukkhasaccavasena pajānāti.","<b>Vedanānañca sambhava</b>nti tāsaṃyeva sambhavaṃ samudayasaccavasena pajānāti.","<b>Yattha cetā</b>ti yatthetā vedanā nirujjhanti, taṃ nibbānaṃ nirodhasaccavasena pajānāti.","<b>Khayagāmina</b>nti tāsaṃyeva vedanānaṃ khayagāminaṃ maggaṃ maggasaccavasena pajānāti.","<b>Nicchāto parinibbuto</b>ti nittaṇho hutvā kilesaparinibbānena parinibbuto.","Evamettha sutte sammasanacāravedanā kathitā.","Gāthāsu dvīhi padehi samathavipassanā kathitā, sesehi catusaccaṃ kathitaṃ.","Evamettha sabbasaṅgāhiko catubhūmakadhammaparicchedo vutto. 2."],"lineRefs":[["sn36.1:2"],["sn36.1:2"],["sn36.1:2"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"]]}],"wordLinks":[["sn36.1:2.1","samāhito",0,0],["sn36.1:2.3","vedanā ca pajānātī",0,1],["sn36.1:2.3","vedanānañca sambhavaṃ",0,2],["sn36.1:3.1","yattha cetā",0,3],["sn36.1:3.1","khayagāminaṃ",0,4],["sn36.1:3.3","nicchāto parinibbuto",0,5]],"before":[{"para":591,"vripara":null,"title":"Vedanāsaṃyuttaṃ","lines":["Vedanāsaṃyuttaṃ 1."]},{"para":592,"vripara":null,"title":"Sagāthāvaggo","lines":["Sagāthāvaggo 1."]},{"para":593,"vripara":null,"title":"Samādhisuttavaṇṇanā","lines":["Samādhisuttavaṇṇanā 249."]}]},"tika":{"book":"Spk-t-iv","bookName":"Saḷāyatanavagga-ṭīkā","vriCode":"s0304t.tik","from":488,"to":488,"paras":[{"para":488,"vripara":"249","refs":["sn36.1:2","sn36.1:3"],"lines":["<b>Vedanā</b> <b>ca pajānātī</b>ti saccābhisambodhavasena vuccamānavedanānaṃ pajānanaṃ sātisayasamādhānapubbakanti bhagavatā “samāhito”ti vuttanti āha <b>“upacārena vā appanāya vā samāhito”</b>ti.","<b>Vedanā</b>ti tissopi vedanā.","<b>Dukkhasaccavasenā</b>ti dukkhasaccabhāvena, parijānanavasenāti attho.","<b>Sambhava</b>nti samudayaṃ taṇhāvijjākammaphassādippabhedaṃ uppattikāraṇaṃ.","Tenāha <b>“samudayasaccavasena pajānātī”</b>ti.","<b>Yatthā</b>ti yaṃnimittaṃ, yaṃ āgamma kāmataṇhāvijjādinirodhā vedanānirodho, tesaṃ ayaṃ nirodho.","Nibbānaṃ ārabbha ariyamaggappavattiyā hi nibbānaṃ vedanānirodhoti vutto.","Khayaṃ gametīti khayagāmī, taṃ <b>khayagāminaṃ</b>.","Chātaṃ vuccati taṇhā kāmānaṃ pātukāmatāvasena pavattanato, accantameva samucchinnattā natthi etasmiṃ chātanti <b>nicchāto</b>.","Tenāha <b>“nittaṇho”</b>ti.","<b>Sammasanacāravedanā</b>ti sammasanūpacāravedanā.","<b>Dvīhi padehī</b>ti “samāhito sampajāno”ti imehi dvīhi.","“Sato”ti pana idaṃ sampajānapadasseva upabrūhananti adhippāyo.","<b>Sesehi</b> catūhi <b>catusaccaṃ kathitaṃ,</b> itarehi pana dvīhi catusaccabujjhanameva kathitaṃ.","<b>Sabbasaṅgāhiko</b>ti sabbasabhāvadhammānaṃ saṅgaṇhanako.","Tenāha <b>“catubhūmakadhammaparicchedo vutto”</b>ti."],"lineRefs":[["sn36.1:2"],["sn36.1:2"],["sn36.1:2"],["sn36.1:2"],["sn36.1:2"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"],["sn36.1:3"]]}],"wordLinks":[["sn36.1:2.3","vedanā ca pajānātī",0,0],["sn36.1:2.3","vedanā",0,1],["sn36.1:2.3","sambhavaṃ",0,3],["sn36.1:3.1","yatthā",0,5],["sn36.1:3.1","khayagāminaṃ",0,7],["sn36.1:3.3","nicchāto",0,8]],"before":[{"para":485,"vripara":null,"title":"Vedanāsaṃyuttaṃ","lines":["Vedanāsaṃyuttaṃ 1."]},{"para":486,"vripara":null,"title":"Sagāthāvaggo","lines":["Sagāthāvaggo 1."]},{"para":487,"vripara":null,"title":"Samādhisuttavaṇṇanā","lines":["Samādhisuttavaṇṇanā 249."]}],"after":[{"para":489,"vripara":null,"title":"Samādhisuttavaṇṇanā","lines":["Samādhisuttavaṇṇanā niṭṭhitā. 2."]}]},"tika2":null}
