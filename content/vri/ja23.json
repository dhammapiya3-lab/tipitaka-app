{"suttaId":"ja23","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[130,133],"vripara":"23"},"segments":{"ja23:0.4":"Gojānīyajātakaṃ","ja23:1.1":"Api passena semāno, sallebhi sallalīkato;","ja23:1.3":"Seyyova vaḷavā gojo [bhojjo (sī.), bhojjho (syā. pī.)], yuñja maññeva sārathīti.","ja23:2.1":"Gojānīya [bhojājānīya (sī. syā. pī.)] jātakaṃ tatiyaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1296,"to":1296,"paras":[{"para":1296,"vripara":null,"refs":["ja23:1"],"lines":["Tattha <b>api passena semāno</b>ti ekena passena sayamānakopi.","<b>Sallebhi sallalīkato</b>ti sallehi viddhopi samāno.","<b>Seyyova vaḷavā bhojjho</b>ti <b>vaḷavā</b>ti sindhavakulesu ajāto khaluṅkasso.","<b>Bhojjho</b>ti bhojājānīyasindhavo.","Iti etasmā vaḷavā sallehi viddhopi bhojājānīyasindhavova seyyo varo uttamo.","<b>Yuñja maññeva sārathī</b>ti yasmā eva gatopi ahameva seyyo, tasmā mamaññeva yojehi, maṃ vammehīti vadati."],"lineRefs":[["ja23:1"],["ja23:1"],["ja23:1"],["ja23:1"],["ja23:1"],["ja23:1"]]}],"wordLinks":[["ja23:1.1","api passena semāno",0,0],["ja23:1.1","sallebhi sallalīkato",0,1],["ja23:1.3","vaḷavā",0,2],["ja23:1.3","yuñja maññeva sārathī",0,5]]},"tika":null}
