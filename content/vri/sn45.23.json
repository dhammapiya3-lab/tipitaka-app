{"suttaId":"sn45.23","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[104,104],"vripara":"23"},"segments":{"sn45.23:0.3":"Paṭhamapaṭipadāsuttaṃ","sn45.23:1.1":"Sāvatthinidānaṃ.","sn45.23:1.2":"“Micchāpaṭipadañca vo, bhikkhave, desessāmi, sammāpaṭipadañca.","sn45.23:1.3":"Taṃ suṇātha.","sn45.23:1.4":"Katamā ca, bhikkhave, micchāpaṭipadā?","sn45.23:1.5":"Seyyathidaṃ – micchādiṭṭhi … pe … micchāsamādhi.","sn45.23:1.6":"Ayaṃ vuccati, bhikkhave, micchāpaṭipadā.","sn45.23:1.7":"Katamā ca, bhikkhave, sammāpaṭipadā?","sn45.23:1.8":"Seyyathidaṃ – sammādiṭṭhi … pe … sammāsamādhi.","sn45.23:1.9":"Ayaṃ vuccati, bhikkhave, sammāpaṭipadā”ti.","sn45.23:1.10":"Tatiyaṃ."},"attha":null,"tika":null}
