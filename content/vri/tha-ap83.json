{"suttaId":"tha-ap83","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[4747,4775],"vripara":"1"},"segments":{"tha-ap83:0.3":"Timirapupphiyattheraapadānaṃ","tha-ap83:1.1":"“Candabhāgānadītīre,","tha-ap83:1.2":"anusotaṃ vajāmahaṃ;","tha-ap83:1.3":"Nisinnaṃ samaṇaṃ disvā,","tha-ap83:1.4":"vippasannamanāvilaṃ.","tha-ap83:2.1":"“Tattha cittaṃ pasādetvā [pasādesiṃ (syā.)],","tha-ap83:2.2":"evaṃ cintesahaṃ tadā;","tha-ap83:2.3":"Tārayissati tiṇṇoyaṃ,","tha-ap83:2.4":"dantoyaṃ damayissati.","tha-ap83:3.1":"“Assāsissati assattho,","tha-ap83:3.2":"santo ca samayissati;","tha-ap83:3.3":"Mocayissati mutto ca,","tha-ap83:3.4":"nibbāpessati nibbuto.","tha-ap83:4.1":"“Evāhaṃ cintayitvāna,","tha-ap83:4.2":"siddhatthassa mahesino;","tha-ap83:4.3":"Gahetvā timirapupphaṃ,","tha-ap83:4.4":"matthake okiriṃ ahaṃ [tadā (syā.)].","tha-ap83:5.1":"“Añjaliṃ paggahetvāna,","tha-ap83:5.2":"katvā ca naṃ padakkhiṇaṃ;","tha-ap83:5.3":"Vanditvā satthuno pāde,","tha-ap83:5.4":"pakkāmiṃ aparaṃ disaṃ.","tha-ap83:6.1":"“Aciraṃ gatamattaṃ maṃ,","tha-ap83:6.2":"migarājā viheṭhayi;","tha-ap83:6.3":"Papātamanugacchanto,","tha-ap83:6.4":"tattheva papatiṃ ahaṃ.","tha-ap83:7.1":"“Catunnavutito kappe,","tha-ap83:7.2":"yaṃ pupphamabhiropayiṃ;","tha-ap83:7.3":"Duggatiṃ nābhijānāmi,","tha-ap83:7.4":"pupphapūjāyidaṃ [buddhapūjāyidaṃ (sī. syā.)] phalaṃ.","tha-ap83:8.1":"“Chappaññāsamhi kappamhi,","tha-ap83:8.2":"sattevāsuṃ mahāyasā [mahārahā (syā. ka.)];","tha-ap83:8.3":"Sattaratanasampannā,","tha-ap83:8.4":"cakkavattī mahabbalā.","tha-ap83:9.1":"“Paṭisambhidā catasso,","tha-ap83:9.2":"vimokkhāpi ca aṭṭhime;","tha-ap83:9.3":"Chaḷabhiññā sacchikatā,","tha-ap83:9.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap83:10.1":"Itthaṃ sudaṃ āyasmā timirapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap83:11.1":"Timirapupphiyattherassāpadānaṃ paṭhamaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2708,"to":2711,"paras":[{"para":2708,"vripara":"1","refs":["tha-ap83:1"],"lines":["So aparabhāge pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>candabhāgānadītīre</b>tiādimāha.","Tassattho heṭṭhā vuttova.","<b>Anubhotaṃ vajāmahan</b>ti gaṅgāya āsanne vasanabhāvena sabbattha rammabhāvena gaṅgāto heṭṭhā sotānusārena ahaṃ vajāmi gacchāmi tattha tattha vasāmīti attho.","<b>Nisinnaṃ samaṇaṃ disvā</b>ti samitapāpattā sositapāpattā samaṇasaṅkhātaṃ sammāsambuddhaṃ disvāti attho."],"lineRefs":[["tha-ap83:1"],["tha-ap83:1"],["tha-ap83:1"],["tha-ap83:1"]]},{"para":2709,"vripara":"2","refs":["tha-ap83:2"],"lines":["<b>Evaṃ cintesahaṃ tadā</b>ti ayaṃ bhagavā sayaṃ tiṇṇo sabbasatte tārayissati saṃsārato uttāreti sayaṃ kāyadvārādīhi damito ayaṃ bhagavā pare dameti."],"lineRefs":[["tha-ap83:2"]]},{"para":2710,"vripara":"3","refs":["tha-ap83:3"],"lines":["Sayaṃ <b>assattho</b> assāsampatto, kilesapariḷāhato mutto sabbasatte assāseti, santabhāvaṃ āpāpeti.","Sayaṃ <b>santo</b> santakāyacitto paresaṃ santakāyacittaṃ pāpeti.","Sayaṃ <b>mutto</b> saṃsārato muccito pare saṃsārato mocayissati.","So ayaṃ bhagavā sayaṃ <b>nibbuto</b> kilesaggīhi nibbuto paresampi kilesaggīhi nibbāpessatīti ahaṃ tadā evaṃ cintesinti attho."],"lineRefs":[["tha-ap83:3"],["tha-ap83:3"],["tha-ap83:3"],["tha-ap83:3"]]},{"para":2711,"vripara":"4","refs":["tha-ap83:4"],"lines":["<b>Gahetvā timirapupphan</b>ti sakalaṃ vanantaṃ nīlakāḷaraṃsīhi andhakāraṃ viya kurumānaṃ khāyatīti timiraṃ pupphaṃ taṃ gahetvā kaṇṇikāvaṇṭaṃ gahetvā <b>matthake</b> sīsassa upari ākāse <b>okiriṃ</b> pūjesinti attho.","Sesaṃ uttānatthamevāti."],"lineRefs":[["tha-ap83:4"],["tha-ap83:4"]]}],"wordLinks":[["tha-ap83:1.1","candabhāgānadītīre",0,0],["tha-ap83:1.3","nisinnaṃ samaṇaṃ disvā",0,3],["tha-ap83:2.1","evaṃ cintesahaṃ tadā",1,0],["tha-ap83:3.1","assattho",2,0],["tha-ap83:3.1","santo",2,1],["tha-ap83:3.3","mutto",2,2],["tha-ap83:3.3","nibbuto",2,3],["tha-ap83:4.3","gahetvā timirapupphaṃ",3,0],["tha-ap83:4.3","matthake",3,0],["tha-ap83:4.3","okiriṃ",3,0]]},"tika":null,"tika2":null}
