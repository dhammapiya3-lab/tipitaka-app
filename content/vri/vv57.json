{"suttaId":"vv57","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Vv","vriCode":"s0506m.mul","paras":[2232,2251],"vripara":"935"},"segments":{"vv57:0.4":"Dutiyakaraṇīyavimānavatthu","vv57:1.1":"“Uccamidaṃ maṇithūṇaṃ vimānaṃ,","vv57:1.2":"samantato dvādasa yojanāni;","vv57:1.3":"Kūṭāgārā sattasatā uḷārā,","vv57:1.4":"veḷuriyathambhā rucakatthatā subhā. 936.","vv57:2.1":"“Tatthacchasi pivasi khādasi ca,","vv57:2.2":"dibbā ca vīṇā pavadanti vagguṃ;","vv57:2.3":"Dibbā rasā kāmaguṇettha pañca,","vv57:2.4":"nāriyo ca naccanti suvaṇṇachannā. 937.","vv57:3.1":"“Kena tetādiso vaṇṇo…pe…","vv57:3.3":"vaṇṇo ca te sabbadisā pabhāsatī”ti. 939.","vv57:4.1":"So devaputto attamano…pe…","vv57:4.3":"yassa kammassidaṃ phalaṃ. 940.","vv57:5.1":"“Karaṇīyāni puññāni,","vv57:5.2":"paṇḍitena vijānatā;","vv57:5.3":"Sammaggatesu bhikkhūsu,","vv57:5.4":"yattha dinnaṃ mahapphalaṃ. 941.","vv57:6.1":"“Atthāya vata me bhikkhu,","vv57:6.2":"araññā gāmamāgato;","vv57:6.3":"Tattha cittaṃ pasādetvā,","vv57:6.4":"tāvatiṃsūpago ahaṃ. 942.","vv57:7.1":"“Tena metādiso vaṇṇo…pe…","vv57:7.3":"Vaṇṇo ca me sabbadisā pabhāsatī”ti.","vv57:8.1":"Dutiyakaraṇīyavimānaṃ sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Vv-a","bookName":"Vimānavatthu-aṭṭhakathā","vriCode":"s0506a.att","from":2645,"to":2663,"paras":[{"para":2645,"vripara":"935","refs":["vv57:1"],"lines":["“Uccamidaṃ maṇithūṇaṃ vimānaṃ, samantato dvādasa yojanāni;"],"lineRefs":[["vv57:1"]]},{"para":2646,"vripara":null,"refs":["vv57:1"],"lines":["Kūṭāgārā sattasatā uḷārā, veḷuriyathambhā rucakatthatā subhā. 936."],"lineRefs":[["vv57:1"]]},{"para":2648,"vripara":"936","refs":["vv57:2"],"lines":["“Tatthacchasi pivasi khādasi ca, dibbā ca vīṇā pavadanti vagguṃ;"],"lineRefs":[["vv57:2"]]},{"para":2649,"vripara":null,"refs":["vv57:2"],"lines":["Dibbā rasā kāmaguṇettha pañca, nāriyo ca naccanti suvaṇṇachannā. 937."],"lineRefs":[["vv57:2"]]},{"para":2650,"vripara":"937","refs":["vv57:3"],"lines":["“Kena tetādiso vaṇṇo…pe… vaṇṇo ca te sabbadisā pabhāsatīti. 938."],"lineRefs":[["vv57:3"]]},{"para":2652,"vripara":"938","refs":["vv57:3"],"lines":["“So devaputto attamano…pe… yassa kammassidaṃ phalaṃ”. 940."],"lineRefs":[["vv57:3"]]},{"para":2654,"vripara":"940","refs":["vv57:5"],"lines":["“Karaṇīyāni puññāni, paṇḍitena vijānatā;"],"lineRefs":[["vv57:5"]]},{"para":2655,"vripara":null,"refs":["vv57:5"],"lines":["Sammaggatesu bhikkhūsu, yattha dinnaṃ mahapphalaṃ. 941."],"lineRefs":[["vv57:5"]]},{"para":2657,"vripara":"941","refs":["vv57:6"],"lines":["“Atthāya vata me bhikkhu, araññā gāmamāgato;"],"lineRefs":[["vv57:6"]]},{"para":2658,"vripara":null,"refs":["vv57:6"],"lines":["Tattha cittaṃ pasādetvā, tāvatiṃsūpago ahaṃ. 942."],"lineRefs":[["vv57:6"]]},{"para":2659,"vripara":"942","refs":["vv57:7"],"lines":["“Tena metādiso vaṇṇo…pe… vaṇṇo ca me sabbadisā pabhāsatī”ti."],"lineRefs":[["vv57:7"]]},{"para":2660,"vripara":null,"refs":["vv57:7"],"lines":["Dutiyakaraṇīyavimānavaṇṇanā niṭṭhitā. 8."],"lineRefs":[["vv57:7"]]},{"para":2661,"vripara":null,"refs":["vv57:7"],"lines":["Paṭhamasūcivimānavaṇṇanā"],"lineRefs":[["vv57:7"]]},{"para":2662,"vripara":null,"refs":["vv57:7"],"lines":["<b>Uccamidaṃ</b> <b>maṇithūṇaṃ vimāna</b>nti sūcivimānaṃ.","Tassa kā uppatti?","Bhagavā rājagahe viharati veḷuvane.","Tena samayena āyasmato sāriputtassa cīvarakammaṃ kātabbaṃ hoti, attho ca hoti sūciyā.","So rājagahe piṇḍāya caranto kammārassa gehadvāre aṭṭhāsi.","Taṃ disvā kammāro āha “kena, bhante, attho”ti?","“Cīvarakammaṃ kātabbaṃ atthi, sūciyā attho”ti.","Kammāro pasannamānaso katapariyositā dve sūciyo datvā “punapi, bhante, sūciyā atthe sati mama ācikkheyyāthā”ti vatvā pañcapatiṭṭhitena vandi.","Thero tassa anumodanaṃ katvā pakkāmi.","So aparabhāge kālaṃ katvā tāvatiṃsesu uppajji.","Atha āyasmā mahāmoggallāno devacārikaṃ caranto taṃ devaputtaṃ imāhi gāthāhi pucchi – 944."],"lineRefs":[["vv57:7"],["vv57:7"],["vv57:7"],["vv57:7"],["vv57:7"],["vv57:7"],["vv57:7"],["vv57:7"],["vv57:7"],["vv57:7"],["vv57:7"]]}],"wordLinks":[],"before":[{"para":2642,"vripara":null,"title":"Dutiyakaraṇīyavimānavaṇṇanā","lines":["Dutiyakaraṇīyavimānavaṇṇanā"]},{"para":2643,"vripara":null,"title":"Dutiyakaraṇīyavimānavaṇṇanā","lines":["Sattamavimānaṃ chaṭṭhavimānasadisaṃ.","Kevalaṃ tattha upāsakena bhagavato āhāro dinno, idha aññatarassa therassa.","Esaṃ vuttanayameva.","Tena vuttaṃ – 935."]}],"after":[{"para":2664,"vripara":"944","title":"Paṭhamasūcivimānavaṇṇanā","lines":["“Uccamidaṃ maṇithūṇaṃ vimānaṃ…pe…"]},{"para":2665,"vripara":null,"title":"Paṭhamasūcivimānavaṇṇanā","lines":["Vaṇṇo ca te sabbadisā pabhāsatī”ti. 948."]},{"para":2666,"vripara":"948","title":"Paṭhamasūcivimānavaṇṇanā","lines":["“So devaputto attamano…pe… yassa kammassidaṃ phalaṃ”. 949."]},{"para":2668,"vripara":"949","title":"Paṭhamasūcivimānavaṇṇanā","lines":["“Yaṃ dadāti na taṃ hoti, yañceva dajjā tañceva seyyo;"]},{"para":2669,"vripara":null,"title":"Paṭhamasūcivimānavaṇṇanā","lines":["Sūci dinnā sūcimeva seyyo. 950."]},{"para":2671,"vripara":"950","title":"Paṭhamasūcivimānavaṇṇanā","lines":["“Tena metādiso vaṇṇo…pe…"]},{"para":2672,"vripara":null,"title":"Paṭhamasūcivimānavaṇṇanā","lines":["Vaṇṇo ca me sabbadisā pabhāsatī”ti. 949."]}]},"tika":null,"tika2":null}
