{"suttaId":"ja52","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[292,295],"vripara":"52"},"segments":{"ja52:0.4":"Cūḷajanakajātakaṃ","ja52:1.1":"Vāyametheva puriso, na nibbindeyya paṇḍito;","ja52:1.3":"Passāmi vohaṃ attānaṃ, udakā thalamubbhatanti.","ja52:2.1":"Cūḷajanakajātakaṃ dutiyaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1737,"to":1737,"paras":[{"para":1737,"vripara":null,"refs":["ja52:1"],"lines":["Tattha <b>vāyamethevā</b>ti vāyāmaṃ karotheva.","<b>Udakā thalamubbhatan</b>ti udakato thalamuttiṇṇaṃ thale patiṭṭhitaṃ attānaṃ passāmīti.","Idhāpi ossaṭṭhavīriyo bhikkhu arahattaṃ patto, janakarājā sammāsambuddhova ahosīti."],"lineRefs":[["ja52:1"],["ja52:1"],["ja52:1"]]}],"wordLinks":[["ja52:1.1","vāyamethevā",0,0],["ja52:1.3","udakā thalamubbhataṃ",0,1]]},"tika":null}
