{"suttaId":"sn17.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1097,1107],"vripara":"166"},"segments":{"sn17.10:0.3":"Sagāthakasuttaṃ","sn17.10:1.1":"Sāvatthiyaṃ viharati … pe …","sn17.10:1.2":"“dāruṇo, bhikkhave, lābhasakkārasiloko … pe … adhigamāya.","sn17.10:1.3":"Idhāhaṃ, bhikkhave, ekaccaṃ puggalaṃ passāmi sakkārena abhibhūtaṃ pariyādiṇṇacittaṃ, kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapannaṃ.","sn17.10:1.4":"Idha panāhaṃ, bhikkhave, ekaccaṃ puggalaṃ passāmi asakkārena abhibhūtaṃ pariyādiṇṇacittaṃ, kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapannaṃ.","sn17.10:1.5":"Idha panāhaṃ, bhikkhave, ekaccaṃ puggalaṃ passāmi sakkārena ca asakkārena ca tadubhayena abhibhūtaṃ pariyādiṇṇacittaṃ, kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapannaṃ.","sn17.10:1.6":"Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko … pe …","sn17.10:1.7":"evañhi vo, bhikkhave, sikkhitabban”ti.","sn17.10:2.1":"Idamavoca bhagavā.","sn17.10:2.2":"Idaṃ vatvāna sugato athāparaṃ etadavoca satthā –","sn17.10:3.1":"“Yassa sakkariyamānassa,","sn17.10:3.2":"asakkārena cūbhayaṃ;","sn17.10:3.3":"Samādhi na vikampati,","sn17.10:3.4":"appamāṇavihārino [appamādavihārino (pī. ka.) appamāṇoti hettha phalasamādhi, na sati].","sn17.10:4.1":"“Taṃ jhāyinaṃ sātatikaṃ,","sn17.10:4.2":"sukhumaṃ diṭṭhivipassakaṃ;","sn17.10:4.3":"Upādānakkhayārāmaṃ,","sn17.10:4.4":"āhu sappuriso itī”ti.","sn17.10:4.5":"dasamaṃ;","sn17.10:4.6":"Paṭhamo vaggo.","sn17.10:5.0":"Tassuddānaṃ –","sn17.10:5.1":"Dāruṇo baḷisaṃ kummaṃ,","sn17.10:5.2":"dīghalomi ca mīḷhakaṃ;","sn17.10:5.3":"Asani diddhaṃ siṅgālaṃ,","sn17.10:5.4":"verambhena sagāthakanti."},"unsure":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":799,"to":799,"paras":[{"para":799,"vripara":"166","refs":["sn17.10:3","sn17.10:4"],"lines":["Dasame <b>asakkārena cūbhayan</b>ti asakkārena ca ubhayena.","<b>Samādhī</b>ti arahattaphalasamādhi.","So hi tena na vikampati.","<b>Appamāṇavihārino</b>ti appamāṇena phalasamādhinā viharantassa.","<b>Sātatikan</b>ti satatakāriṃ.","<b>Sukhumaṃdiṭṭhivipassakan</b>ti arahattamaggadiṭṭhiyā sukhumadiṭṭhiphalasamāpattiatthāya vipassanaṃ paṭṭhapetvā āgatattā vipassakaṃ.","<b>Upādānakkhayārāman</b>ti upādānakkhayasaṅkhāte nibbāne rataṃ.","<b>Āhu sappuriso itī</b>ti sappurisoti kathentīti.","Dasamaṃ."],"lineRefs":[["sn17.10:3"],["sn17.10:3"],["sn17.10:3"],["sn17.10:3"],["sn17.10:4"],["sn17.10:4"],["sn17.10:4"],["sn17.10:4"],["sn17.10:4"]]}],"wordLinks":[["sn17.10:3.1","asakkārena cūbhayaṃ",0,0],["sn17.10:3.3","samādhī",0,1],["sn17.10:3.3","appamāṇavihārino",0,3],["sn17.10:4.1","sātatikaṃ",0,4],["sn17.10:4.1","sukhumaṃdiṭṭhivipassakaṃ",0,5],["sn17.10:4.3","upādānakkhayārāmaṃ",0,6],["sn17.10:4.3","āhu sappuriso itī",0,7]],"before":[{"para":798,"vripara":null,"refs":[],"lines":["Sagāthakasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":805,"to":805,"paras":[{"para":805,"vripara":"166","refs":["sn17.10:3","sn17.10:4"],"lines":["<b>“Yassa sakkariyamānassā”</b>ti ettha <b>asakkārena cūbhayan</b>ti asakkārena ca ubhayañca, kadāci sakkārena, kadāci asakkārena kadāci ubhayenāti attho.","Tenāha <b>“asakkārenā”</b>tiādi.","Satatavihārānaṃ sampattiyā <b>sātatiko</b>ti āha <b>“arahatta … pe … sukhumadiṭṭhī”</b>tiādi.","Tathā hi sā “vajirūpamañāṇan”ti vuccati.","<b>Āgatattā</b>ti phalasamāpattiṃ samāpajjituṃ tassā pubbaparikammaṃ upagatattā."],"lineRefs":[["sn17.10:3"],["sn17.10:3"],["sn17.10:4"],["sn17.10:4"],["sn17.10:4"]]}],"wordLinks":[["sn17.10:3.1","asakkārena cūbhayaṃ",0,0],["sn17.10:3.1","yassa sakkariyamānassā",0,0],["sn17.10:3.1","asakkārenā",0,1],["sn17.10:4.1","sātatiko",0,2]]},"tika2":null}
