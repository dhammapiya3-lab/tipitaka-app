{"suttaId":"an10.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[7,17],"vripara":"1"},"segments":{"an10.1:0.3":"Kimatthiyasuttaṃ","an10.1:1.1":"Evaṃ me sutaṃ – ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme.","an10.1:1.3":"Atha kho āyasmā ānando yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho āyasmā ānando bhagavantaṃ etadavoca –","an10.1:2.1":"“Kimatthiyāni, bhante, kusalāni sīlāni kimānisaṃsānī”ti?","an10.1:2.2":"“Avippaṭisāratthāni kho, ānanda, kusalāni sīlāni avippaṭisārānisaṃsānī”ti.","an10.1:3.1":"“Avippaṭisāro pana, bhante, kimatthiyo kimānisaṃso”ti?","an10.1:3.2":"“Avippaṭisāro kho, ānanda, pāmojjattho pāmojjānisaṃso”ti [pāmujjattho pāmujjānisaṃsoti (sī. syā. pī.) a. ni.11.1].","an10.1:4.1":"“Pāmojjaṃ pana, bhante, kimatthiyaṃ kimānisaṃsan”ti?","an10.1:4.2":"“Pāmojjaṃ kho, ānanda, pītatthaṃ pītānisaṃsan”ti.","an10.1:5.1":"“Pīti pana, bhante, kimatthiyā kimānisaṃsā”ti?","an10.1:5.2":"“Pīti kho, ānanda, passaddhatthā passaddhānisaṃsā”ti.","an10.1:6.1":"“Passaddhi pana, bhante, kimatthiyā kimānisaṃsā”ti?","an10.1:6.2":"“Passaddhi kho, ānanda, sukhatthā sukhānisaṃsā”ti.","an10.1:7.1":"“Sukhaṃ pana, bhante, kimatthiyaṃ kimānisaṃsan”ti?","an10.1:7.2":"“Sukhaṃ kho, ānanda, samādhatthaṃ samādhānisaṃsan”ti.","an10.1:8.1":"“Samādhi pana, bhante, kimatthiyo kimānisaṃso”ti?","an10.1:8.2":"“Samādhi kho, ānanda, yathābhūtañāṇadassanattho yathābhūtañāṇadassanānisaṃso”ti.","an10.1:9.1":"“Yathābhūtañāṇadassanaṃ pana, bhante, kimatthiyaṃ kimānisaṃsan”ti?","an10.1:9.2":"“Yathābhūtañāṇadassanaṃ kho, ānanda, nibbidāvirāgatthaṃ nibbidāvirāgānisaṃsan”ti.","an10.1:10.1":"“Nibbidāvirāgo pana, bhante kimatthiyo kimānisaṃso”ti?","an10.1:10.2":"“Nibbidāvirāgo kho, ānanda, vimuttiñāṇadassanattho vimuttiñāṇadassanānisaṃso [… nisaṃsoti (sī. ka.)].","an10.1:11.1":"“Iti kho, ānanda, kusalāni sīlāni avippaṭisāratthāni avippaṭisārānisaṃsāni;","an10.1:11.2":"avippaṭisāro pāmojjattho pāmojjānisaṃso;","an10.1:11.3":"pāmojjaṃ pītatthaṃ pītānisaṃsaṃ;","an10.1:11.4":"pīti passaddhatthā passaddhānisaṃsā;","an10.1:11.5":"passaddhi sukhatthā sukhānisaṃsā;","an10.1:11.6":"sukhaṃ samādhatthaṃ samādhānisaṃsaṃ;","an10.1:11.7":"samādhi yathābhūtañāṇadassanattho yathābhūtañāṇadassanānisaṃso;","an10.1:11.8":"yathābhūtañāṇadassanaṃ nibbidāvirāgatthaṃ nibbidāvirāgānisaṃsaṃ;","an10.1:11.9":"nibbidāvirāgo vimuttiñāṇadassanattho vimuttiñāṇadassanānisaṃso.","an10.1:11.10":"Iti kho, ānanda, kusalāni sīlāni anupubbena aggāya parentī”ti [arahattāya pūrentīti (syā.)].","an10.1:11.11":"Paṭhamaṃ."},"attha":{"book":"Mp-x","bookName":"Dasakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":413,"to":413,"paras":[{"para":413,"vripara":"1","refs":["an10.1:2","an10.1:8","an10.1:9","an10.1:10","an10.1:11"],"lines":["Dasakanipātassa paṭhame <b>kusalāni sīlānī</b>ti anavajjasīlāni.","Amaṅkubhāvassa avippaṭisārassa atthāya saṃvattantīti <b>avippaṭisāratthāni</b>.","So nesaṃ ānisaṃsoti <b>avippaṭisārānisaṃsāni.</b>","<b>Yathābhūtañāṇadassanattho</b>tiādīsu <b>yathābhūtañāṇadassanaṃ</b> nāma taruṇavipassanā, <b>nibbidā</b> nāma balavavipassanā, <b>virāgo</b> nāma maggo, <b>vimutti</b> nāma arahattaphalaṃ, <b>ñāṇadassanaṃ</b> nāma paccavekkhaṇañāṇaṃ.","<b>Aggāya parentī</b>ti arahattatthāya gacchanti."],"lineRefs":[["an10.1:2"],["an10.1:2"],["an10.1:2"],["an10.1:8"],["an10.1:11"]]}],"wordLinks":[["an10.1:2.1","kusalāni sīlānī",0,0],["an10.1:2.2","kusalāni sīlānī",0,0],["an10.1:2.2","avippaṭisāratthāni",0,1],["an10.1:2.2","avippaṭisārānisaṃsāni",0,2],["an10.1:8.2","yathābhūtañāṇadassanattho",0,3],["an10.1:8.2","yathābhūtañāṇadassanaṃ",0,3],["an10.1:8.2","ñāṇadassanaṃ",0,3],["an10.1:11.10","aggāya parentī",0,4]]},"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":470,"to":470,"paras":[{"para":470,"vripara":"1","refs":["an10.1:2","an10.1:11"],"lines":["Dasakanipātassa paṭhame <b>avippaṭisāratthānī</b>ti avippaṭisārappayojanāni.","<b>Avippaṭisārānisaṃsānī</b>ti avippaṭisārudayāni.","Etena avippaṭisāro nāma sīlasssa udayamattaṃ, saṃvaddhitassa rukkhassa chāyāpupphasadisaṃ, añño eva panānena nipphādetabbo samādhiādiguṇoti dasseti.","“Yāva maggāmaggañāṇadassanavisuddhi, tāva taruṇavipassanā”ti hi vacanato upakkilesavimuttaudayabbayañāṇato paraṃ ayañca vipassanā virajjati yogāvacaro viratto puriso viya bhariyāya saṅkhārato etenāti virāgo."],"lineRefs":[["an10.1:2"],["an10.1:2"],["an10.1:2"],["an10.1:2"]]}],"wordLinks":[["an10.1:2.2","avippaṭisāratthānī",0,0],["an10.1:2.2","avippaṭisārānisaṃsānī",0,1]]}}
