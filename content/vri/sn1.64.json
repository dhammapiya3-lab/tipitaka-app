{"suttaId":"sn1.64","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[744,748],"vripara":"64"},"segments":{"sn1.64:0.3":"Saṃyojanasuttaṃ","sn1.64:1.1":"“Kiṃsu saṃyojano loko,","sn1.64:1.2":"kiṃsu tassa vicāraṇaṃ;","sn1.64:1.3":"Kissassu vippahānena,","sn1.64:1.4":"nibbānaṃ iti vuccatī”ti.","sn1.64:2.1":"“Nandīsaṃyojano [nandisaṃyojano (sī. syā. kaṃ.)] loko,","sn1.64:2.2":"vitakkassa vicāraṇaṃ;","sn1.64:2.3":"Taṇhāya vippahānena,","sn1.64:2.4":"nibbānaṃ iti vuccatī”ti."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":463,"to":463,"paras":[{"para":463,"vripara":"64","refs":["sn1.64:1","sn1.64:2"],"lines":["Catutthe <b>kiṃ su saṃyojano</b>ti kiṃ saṃyojano kiṃ bandhano?","<b>Vicāraṇan</b>ti vicaraṇā pādāni.","Bahuvacane ekavacanaṃ kataṃ.","<b>Vitakkassa vicāraṇan</b>ti vitakko tassa pādā.","Catutthaṃ."],"lineRefs":[["sn1.64:1"],["sn1.64:1"],["sn1.64:1"],["sn1.64:2"],["sn1.64:2"]]}],"wordLinks":[["sn1.64:1.1","kiṃ su saṃyojano",0,0],["sn1.64:1.1","vicāraṇaṃ",0,1],["sn1.64:2.1","vitakkassa vicāraṇaṃ",0,3]]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":569,"to":569,"paras":[{"para":569,"vripara":"64","refs":["sn1.64:1"],"lines":["<b>Kiṃ su saṃyojano</b>ti <b>sū</b>ti nipātamattanti āha <b>“kiṃ-saṃyojano”</b>ti?","Vicaranti etehīti <b>vicāraṇā,</b> pādā.","Bahuvacane hi vattabbe ekavacanaṃ kataṃ.","<b>Tassā</b>ti lokassa."],"lineRefs":[["sn1.64:1"],["sn1.64:1"],["sn1.64:1"],["sn1.64:1"]]}],"wordLinks":[["sn1.64:1.1","kiṃ su saṃyojano",0,0],["sn1.64:1.1","sū",0,0],["sn1.64:1.3","sū",0,0],["sn1.64:1.1","vicāraṇā",0,1],["sn1.64:1.1","tassā",0,3]],"before":[{"para":568,"vripara":null,"title":"Saṃyojanasuttavaṇṇanā","lines":["Saṃyojanasuttavaṇṇanā"]}],"after":[{"para":570,"vripara":null,"title":"Saṃyojanasuttavaṇṇanā","lines":["Saṃyojanasuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
