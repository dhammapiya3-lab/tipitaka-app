{"suttaId":"ja17","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[95,98],"vripara":"17"},"segments":{"ja17:0.4":"Mālutajātakaṃ","ja17:1.1":"Kāḷe vā yadi vā juṇhe, yadā vāyati māluto;","ja17:1.3":"Vātajāni hi sītāni, ubhotthamaparājitāti.","ja17:2.1":"Mālutajātakaṃ sattamaṃ."},"attha":{"book":"Ja-a-i","bookName":"Jātaka-aṭṭhakathā-1","vriCode":"s0513a1.att","from":1215,"to":1215,"paras":[{"para":1215,"vripara":null,"refs":["ja17:1"],"lines":["Tattha <b>kāḷe vā yadi vā juṇhe</b>ti kāḷapakkhe vā juṇhapakkhe vā.","<b>Yadā vāyati māluto</b>ti yasmiṃ samaye puratthimādibhedo vāto vāyati, tasmiṃ samaye sītaṃ hoti.","Kiṃkāraṇā?","<b>Vātajāni hi sītāni,</b> yasmā vāte vijjanteyeva sītāni honti, kāḷapakkho vā juṇhapakkho vā ettha apamāṇanti vuttaṃ hoti.","<b>Ubhotthamaparājitā</b>ti ubhopi tumhe imasmiṃ pañhe aparājitāti.","Evaṃ bodhisatto te sahāyake saññāpesi."],"lineRefs":[["ja17:1"],["ja17:1"],["ja17:1"],["ja17:1"],["ja17:1"],["ja17:1"]]}],"wordLinks":[["ja17:1.1","kāḷe vā yadi vā juṇhe",0,0],["ja17:1.1","yadā vāyati māluto",0,1],["ja17:1.3","vātajāni hi sītāni",0,3],["ja17:1.3","ubhotthamaparājitā",0,4]]},"tika":null,"tika2":null}
