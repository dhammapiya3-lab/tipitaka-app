{"suttaId":"tha-ap467","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1367,1381],"vripara":"21"},"segments":{"tha-ap467:0.3":"Sumanatālavaṇṭiyattheraapadānaṃ","tha-ap467:1.1":"“Siddhatthassa bhagavato,","tha-ap467:1.2":"tālavaṇṭamadāsahaṃ;","tha-ap467:1.3":"Sumanehi paṭicchannaṃ,","tha-ap467:1.4":"dhārayāmi mahāyasaṃ.","tha-ap467:2.1":"“Catunnavutito kappe,","tha-ap467:2.2":"tālavaṇṭamadāsahaṃ;","tha-ap467:2.3":"Duggatiṃ nābhijānāmi,","tha-ap467:2.4":"tālavaṇṭassidaṃ phalaṃ.","tha-ap467:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap467:3.3":"viharāmi anāsavo.","tha-ap467:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap467:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap467:5.1":"“Paṭisambhidā catasso … pe …","tha-ap467:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap467:6.1":"Itthaṃ sudaṃ āyasmā sumanatālavaṇṭiyo thero imā Gāthāyo abhāsitthāti.","tha-ap467:7.1":"Sumanatālavaṇṭiyattherassāpadānaṃ pañcamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
