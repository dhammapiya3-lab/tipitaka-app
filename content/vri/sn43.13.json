{"suttaId":"sn43.13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iv","vriCode":"s0304m.mul","paras":[1911,1911],"vripara":"378"},"segments":{"sn43.13:0.3":"Anatasuttaṃ","sn43.13:1.1":"“Anatañca vo, bhikkhave, desessāmi, anatagāmiñca maggaṃ.","sn43.13:1.2":"Taṃ suṇātha.","sn43.13:1.3":"Katamañca, bhikkhave, anataṃ … pe …”.(Yathā asaṅkhataṃ tathā vitthāretabbaṃ).","sn43.13:1.5":"Dutiyaṃ."},"attha":null,"tika":null}
