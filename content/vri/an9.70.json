{"suttaId":"an9.70","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-ix","vriCode":"s0404m2.mul","paras":[462,463],"vripara":"70"},"segments":{"an9.70:0.3":"Uddhambhāgiyasuttaṃ","an9.70:1.1":"“Pañcimāni, bhikkhave, uddhambhāgiyāni saṃyojanāni.","an9.70:1.2":"Katamāni pañca?","an9.70:1.3":"Rūparāgo, arūparāgo, māno, uddhaccaṃ, avijjā –","an9.70:1.4":"imāni kho, bhikkhave, pañcuddhambhāgiyāni saṃyojanāni.","an9.70:2.1":"“Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ pahānāya…pe… ime cattāro satipaṭṭhānā bhāvetabbā”ti.","an9.70:2.2":"Aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
