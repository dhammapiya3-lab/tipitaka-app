{"suttaId":"tha-ap514","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3220,3234],"vripara":"7"},"segments":{"tha-ap514:0.3":"Kapitthaphaladāyakattheraapadānaṃ","tha-ap514:1.1":"“Suvaṇṇavaṇṇaṃ sambuddhaṃ, āhutīnaṃ paṭiggahaṃ;","tha-ap514:1.3":"Rathiyaṃ paṭipajjantaṃ, kapitthaṃ [kapiṭṭhaṃ (syā.)] adadiṃ phalaṃ.","tha-ap514:2.1":"“Ekanavutito kappe, yaṃ phalaṃ adadiṃ tadā;","tha-ap514:2.3":"Duggatiṃ nābhijānāmi, phaladānassidaṃ phalaṃ.","tha-ap514:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap514:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap514:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap514:6.1":"Itthaṃ sudaṃ āyasmā kapitthaphaladāyako thero imā Gāthāyo abhāsitthāti.","tha-ap514:7.1":"Kapitthaphaladāyakattherassāpadānaṃ dutiyaṃ."},"attha":null,"tika":null,"tika2":null}
