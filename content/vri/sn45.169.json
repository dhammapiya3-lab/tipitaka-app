{"suttaId":"sn45.169","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[371,371],"vripara":"169"},"segments":{"sn45.169:0.3":"Vedanāsuttaṃ","sn45.169:1.1":"“Tisso imā, bhikkhave, vedanā.","sn45.169:1.2":"Katamā tisso?","sn45.169:1.3":"Sukhā vedanā, dukkhā vedanā, adukkhamasukhā vedanā – imā kho, bhikkhave, tisso vedanā.","sn45.169:1.5":"Imāsaṃ kho, bhikkhave, tissannaṃ vedanānaṃ abhiññāya pariññāya parikkhayāya pahānāya … pe … ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.169:1.6":"Navamaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":114,"to":117,"paras":[{"para":114,"vripara":"162-171","refs":["sn45.169:1"],"lines":["162-171. <b>Vidhā</b>ti mānakoṭṭhāsā mānaṭhapanā vā.","<b>Seyyohamasmīti vidhā</b>ti ahamasmi seyyoti evaṃ mānakoṭṭhāso mānaṭhapanā vā.","<b>Nīghā</b>ti dukkhā.","Vacanattho panettha yassa uppajjanti, taṃ purisaṃ nīhanantīti nīghā.","Sesamettha uttānamevāti."],"lineRefs":[["sn45.169:1"],["sn45.169:1"],["sn45.169:1"],["sn45.169:1"],["sn45.169:1"]]},{"para":115,"vripara":null,"refs":[],"lines":["Esanāvaggo dasamo."],"lineRefs":[[]]},{"para":116,"vripara":null,"refs":[],"lines":["Oghavaggo"],"lineRefs":[[]]},{"para":117,"vripara":null,"refs":["sn45.169:1"],"lines":["1-2. Oghasuttādivaṇṇanā"],"lineRefs":[["sn45.169:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":114,"to":117,"paras":[{"para":114,"vripara":"162-171","refs":["sn45.169:1"],"lines":["162-171. Seyyohamasmītiādinā taṃtaṃvibhāgena dhīyanti vidhīyantīti <b>vidhā,</b> mānakoṭṭhāsā, mānaṭṭhapanā vā.","<b>Nīhanantī</b>ti vibādhenti."],"lineRefs":[["sn45.169:1"],["sn45.169:1"]]},{"para":115,"vripara":null,"refs":[],"lines":["Esanāvaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":116,"vripara":null,"refs":[],"lines":["Oghavaggo"],"lineRefs":[[]]},{"para":117,"vripara":null,"refs":["sn45.169:1"],"lines":["1-2. Oghasuttādivaṇṇanā"],"lineRefs":[["sn45.169:1"]]}],"wordLinks":[]}}
