{"suttaId":"an5.93","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[720,720],"vripara":"93"},"segments":{"an5.93:0.3":"Byākaraṇasuttaṃ","an5.93:1.1":"“Pañcimāni, bhikkhave, aññābyākaraṇāni.","an5.93:1.2":"Katamāni pañca?","an5.93:1.3":"Mandattā momūhattā aññaṃ byākaroti;","an5.93:1.4":"pāpiccho icchāpakato aññaṃ byākaroti;","an5.93:1.5":"ummādā cittakkhepā aññaṃ byākaroti;","an5.93:1.6":"adhimānena aññaṃ byākaroti;","an5.93:1.7":"sammadeva aññaṃ byākaroti.","an5.93:1.8":"Imāni kho, bhikkhave, pañca aññābyākaraṇānī”ti.","an5.93:1.9":"Tatiyaṃ."},"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":216,"to":216,"paras":[{"para":216,"vripara":"93","refs":["an5.93:1"],"words":["aññābyākaraṇānī","mandattā","momūhattā","aññaṃ byākarotī","icchāpakato","adhimānenā","sammadevā"],"lines":["Tatiye <b>aññābyākaraṇānī</b>ti arahattabyākaraṇāni.","<b>Mandattā</b>ti mandabhāvena aññāṇena.","<b>Momūhattā</b>ti atimūḷhabhāvena.","<b>Aññaṃ byākarotī</b>ti arahattaṃ pattosmīti katheti.","<b>Icchāpakato</b>ti icchāya abhibhūto.","<b>Adhimānenā</b>ti adhigatamānena.","<b>Sammadevā</b>ti hetunā nayena kāraṇeneva."],"lineRefs":[["an5.93:1"],["an5.93:1"],["an5.93:1"],["an5.93:1"],["an5.93:1"],["an5.93:1"],["an5.93:1"]]}]},"tika":null}
