{"suttaId":"an5.93","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[720,720],"vripara":"93"},"segments":{"an5.93:0.3":"Byākaraṇasuttaṃ","an5.93:1.1":"“Pañcimāni, bhikkhave, aññābyākaraṇāni.","an5.93:1.2":"Katamāni pañca?","an5.93:1.3":"Mandattā momūhattā aññaṃ byākaroti;","an5.93:1.4":"pāpiccho icchāpakato aññaṃ byākaroti;","an5.93:1.5":"ummādā cittakkhepā aññaṃ byākaroti;","an5.93:1.6":"adhimānena aññaṃ byākaroti;","an5.93:1.7":"sammadeva aññaṃ byākaroti.","an5.93:1.8":"Imāni kho, bhikkhave, pañca aññābyākaraṇānī”ti.","an5.93:1.9":"Tatiyaṃ."},"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":216,"to":216,"paras":[{"para":216,"vripara":"93","refs":["an5.93:1"],"lines":["Tatiye <b>aññābyākaraṇānī</b>ti arahattabyākaraṇāni.","<b>Mandattā</b>ti mandabhāvena aññāṇena.","<b>Momūhattā</b>ti atimūḷhabhāvena.","<b>Aññaṃ byākarotī</b>ti arahattaṃ pattosmīti katheti.","<b>Icchāpakato</b>ti icchāya abhibhūto.","<b>Adhimānenā</b>ti adhigatamānena.","<b>Sammadevā</b>ti hetunā nayena kāraṇeneva."],"lineRefs":[["an5.93:1"],["an5.93:1"],["an5.93:1"],["an5.93:1"],["an5.93:1"],["an5.93:1"],["an5.93:1"]]}],"wordLinks":[["an5.93:1.1","aññābyākaraṇānī",0,0],["an5.93:1.8","aññābyākaraṇānī",0,0],["an5.93:1.3","mandattā",0,1],["an5.93:1.3","momūhattā",0,2],["an5.93:1.3","aññaṃ byākarotī",0,3],["an5.93:1.4","aññaṃ byākarotī",0,3],["an5.93:1.5","aññaṃ byākarotī",0,3],["an5.93:1.6","aññaṃ byākarotī",0,3],["an5.93:1.7","aññaṃ byākarotī",0,3],["an5.93:1.4","icchāpakato",0,4],["an5.93:1.6","adhimānenā",0,5],["an5.93:1.7","sammadevā",0,6]]},"tika":null}
