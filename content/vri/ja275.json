{"suttaId":"ja275","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2021,2030],"vripara":"73"},"segments":{"ja275:0.4":"Rucirajātakaṃ (3-3-5)","ja275:1.1":"Kāyaṃ balākā rucirā, kākanīḷasmimacchati;","ja275:1.3":"Caṇḍo kāko sakhā mayhaṃ, yassa [tassa (sī. pī.)] cetaṃ kulāvakaṃ.","ja275:2.1":"Nanu maṃ samma jānāsi, dija sāmākabhojana;","ja275:2.3":"Akatvā vacanaṃ tuyhaṃ, passa lūnosmi āgato.","ja275:3.1":"Punapāpajjasī samma, sīlañhi tava tādisaṃ;","ja275:3.3":"Na hi mānusakā bhogā, subhuñjā honti pakkhināti.","ja275:4.1":"Rucirajātakaṃ pañcamaṃ."},"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":2407,"to":2407,"paras":[{"para":2407,"vripara":null,"refs":["ja275:4"],"lines":["Tattha <b>“rucirā”</b>ti takkamakkhitasarīratāya setavaṇṇataṃ sandhāya vadati.","Rucirā piyadassanā, paṇḍarāti attho.","<b>Kākanīḷasmin</b>ti kākakulāvake.","“Kākaniḍḍhasmin” tipi pāṭho.","<b>Dijā</b>ti kāko pārevataṃ ālapati.","<b>Sāmākabhojanā</b>ti tiṇabījabhojana.","Sāmākaggahaṇena hettha sabbampi tiṇabījaṃ gahitaṃ.","Idhāpi bodhisatto “na idāni sakkā ito paṭṭhāya mayā ettha vasitun”ti uppatitvā aññattha gato."],"lineRefs":[["ja275:4"],["ja275:4"],["ja275:4"],["ja275:4"],["ja275:4"],["ja275:4"],["ja275:4"],["ja275:4"]]}],"wordLinks":[["ja275:4.1","rucirā",0,0]]},"tika":null}
