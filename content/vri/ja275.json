{"suttaId":"ja275","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[2021,2030],"vripara":"73"},"segments":{"ja275:0.4":"Rucirajātakaṃ (3-3-5)","ja275:1.1":"Kāyaṃ balākā rucirā,","ja275:1.2":"kākanīḷasmimacchati;","ja275:1.3":"Caṇḍo kāko sakhā mayhaṃ,","ja275:1.4":"yassa [tassa (sī. pī.)] cetaṃ kulāvakaṃ.","ja275:2.1":"Nanu maṃ samma jānāsi,","ja275:2.2":"dija sāmākabhojana;","ja275:2.3":"Akatvā vacanaṃ tuyhaṃ,","ja275:2.4":"passa lūnosmi āgato.","ja275:3.1":"Punapāpajjasī samma,","ja275:3.2":"sīlañhi tava tādisaṃ;","ja275:3.3":"Na hi mānusakā bhogā,","ja275:3.4":"subhuñjā honti pakkhināti.","ja275:4.1":"Rucirajātakaṃ pañcamaṃ."},"unsure":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":2407,"to":2407,"paras":[{"para":2407,"vripara":null,"refs":["ja275:4"],"lines":["Tattha <b>“rucirā”</b>ti takkamakkhitasarīratāya setavaṇṇataṃ sandhāya vadati.","Rucirā piyadassanā, paṇḍarāti attho.","<b>Kākanīḷasmin</b>ti kākakulāvake.","“Kākaniḍḍhasmin” tipi pāṭho.","<b>Dijā</b>ti kāko pārevataṃ ālapati.","<b>Sāmākabhojanā</b>ti tiṇabījabhojana.","Sāmākaggahaṇena hettha sabbampi tiṇabījaṃ gahitaṃ.","Idhāpi bodhisatto “na idāni sakkā ito paṭṭhāya mayā ettha vasitun”ti uppatitvā aññattha gato."],"lineRefs":[["ja275:4"],["ja275:4"],["ja275:4"],["ja275:4"],["ja275:4"],["ja275:4"],["ja275:4"],["ja275:4"]]}],"wordLinks":[["ja275:4.1","rucirā",0,0]],"before":[{"para":2391,"vripara":null,"refs":[],"lines":["Evañca pana vatvā bodhisatto “ito dāni paṭṭhāya mayā ettha vasituṃ na sakkā”ti uppatitvā aññattha agamāsi.","Kākopi nitthunanto tattheva kālamakāsi."],"lineRefs":[[],[]]},{"para":2392,"vripara":null,"refs":[],"lines":["Satthā imaṃ dhammadesanaṃ āharitvā saccāni pakāsetvā jātakaṃ samodhānesi, saccapariyosāne lolabhikkhu anāgāmiphale patiṭṭhahi.","“Tadā lolakāko lolabhikkhu ahosi, pārāvato pana ahameva ahosin”ti."],"lineRefs":[[],[]]},{"para":2393,"vripara":null,"refs":[],"lines":["Lolajātakavaṇṇanā catutthā."],"lineRefs":[[]]},{"para":2395,"vripara":null,"refs":[],"lines":["[275]5. Rucirajātakavaṇṇanā"],"lineRefs":[[]]},{"para":2396,"vripara":null,"refs":[],"lines":["<b>Kāyaṃ balākā rucirā</b>ti idaṃ satthā jetavane viharanto ekaṃ lolabhikkhuṃ ārabbha kathesi.","Dvepi vatthūni purimasadisāneva gāthāpi."],"lineRefs":[[],[]]},{"para":2398,"vripara":"73","refs":[],"lines":["“Kāyaṃ balākā rucirā, kākanīḷasmimacchati;"],"lineRefs":[[]]},{"para":2399,"vripara":null,"refs":[],"lines":["Caṇḍo kāko sakhā mayhaṃ, yassa cetaṃ kulāvakaṃ."],"lineRefs":[[]]},{"para":2401,"vripara":"74","refs":[],"lines":["“Nanu maṃ samma jānāsi, dija sāmākabhojana;"],"lineRefs":[[]]},{"para":2402,"vripara":null,"refs":[],"lines":["Akatvā vacanaṃ tuyhaṃ, passa lūnosmi āgato."],"lineRefs":[[]]},{"para":2404,"vripara":"75","refs":[],"lines":["“Punapāpajjasī samma, sīlañhi tava tādisaṃ;"],"lineRefs":[[]]},{"para":2405,"vripara":null,"refs":[],"lines":["Na hi mānusakā bhogā, subhuñjā honti pakkhinā”ti.","–"],"lineRefs":[[],[]]},{"para":2406,"vripara":null,"refs":[],"lines":["Gāthā hi ekantarikāyeva."],"lineRefs":[[]]}]},"tika":null,"tika2":null}
