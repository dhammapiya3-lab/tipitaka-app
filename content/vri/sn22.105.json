{"suttaId":"sn22.105","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[724,724],"vripara":"105"},"segments":{"sn22.105:0.3":"Sakkāyasuttaṃ","sn22.105:1.1":"Sāvatthinidānaṃ.","sn22.105:1.2":"“Sakkāyañca vo, bhikkhave, desessāmi sakkāyasamudayañca sakkāyanirodhañca sakkāyanirodhagāminiñca paṭipadaṃ.","sn22.105:1.3":"Taṃ suṇātha.","sn22.105:1.4":"Katamo ca, bhikkhave, sakkāyo?","sn22.105:1.5":"Pañcupādānakkhandhātissa vacanīyaṃ.","sn22.105:1.6":"Katame pañca?","sn22.105:1.7":"Seyyathidaṃ – rūpupādānakkhandho, vedanupādānakkhandho, saññupādānakkhandho, saṅkhārupādānakkhandho, viññāṇupādānakkhandho.","sn22.105:1.8":"Ayaṃ vuccati, bhikkhave, sakkāyo.","sn22.105:1.9":"Katamo ca, bhikkhave, sakkāyasamudayo?","sn22.105:1.10":"Yāyaṃ taṇhā ponobhavikā … pe … kāmataṇhā, bhavataṇhā, vibhavataṇhā – ayaṃ vuccati, bhikkhave, sakkāyasamudayo.","sn22.105:1.12":"Katamo ca, bhikkhave, sakkāyanirodho?","sn22.105:1.13":"Yo tassāyeva taṇhāya … pe … ayaṃ vuccati, bhikkhave, sakkāyanirodho.","sn22.105:1.15":"Katamā ca, bhikkhave, sakkāyanirodhagāminī paṭipadā?","sn22.105:1.16":"Ayameva ariyo aṭṭhaṅgiko maggo.","sn22.105:1.17":"Seyyathidaṃ – sammādiṭṭhi … pe … sammāsamādhi.","sn22.105:1.18":"Ayaṃ vuccati, bhikkhave, sakkāyanirodhagāminī paṭipadā”ti.","sn22.105:1.19":"Tatiyaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":363,"to":364,"paras":[{"para":363,"vripara":"104-105","refs":["sn22.105:1"],"lines":["104-105. Dutiyampi pañcakkhandhe catusaccavasena yojetvā <b>dukkhan</b>ti bujjhanakānaṃ ajjhāsayena kathitaṃ.","Tatiyampi tatheva <b>sakkāyo</b>ti bujjhanakānaṃ ajjhāsayena kathitaṃ.","Dutiyatatiyāni."],"lineRefs":[["sn22.105:1"],["sn22.105:1"],["sn22.105:1"]]},{"para":364,"vripara":null,"refs":["sn22.105:1"],"lines":["Pariññeyyasuttavaṇṇanā"],"lineRefs":[["sn22.105:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":352,"to":355,"paras":[{"para":352,"vripara":"104-105","refs":["sn22.105:1"],"lines":["104-105. <b>Dutiyampī</b>ti <b>api</b> -saddo sampiṇḍanattho.","Tena na kevalaṃ paṭhamasuttameva, atha kho dutiyampīti."],"lineRefs":[["sn22.105:1"],["sn22.105:1"]]},{"para":353,"vripara":null,"refs":["sn22.105:1"],"lines":["<b>Tatiyampi tathevā</b>ti iminā “pañcakkhandhe catusaccavasena yojetvā”ti idaṃ upasaṃharati."],"lineRefs":[["sn22.105:1"]]},{"para":354,"vripara":null,"refs":["sn22.105:1"],"lines":["Dukkhasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["sn22.105:1"]]},{"para":355,"vripara":null,"refs":["sn22.105:1"],"lines":["Pariññeyyasuttavaṇṇanā"],"lineRefs":[["sn22.105:1"]]}],"wordLinks":[]},"tika2":null}
