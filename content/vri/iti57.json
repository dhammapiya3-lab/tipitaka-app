{"suttaId":"iti57","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"It","vriCode":"s0504m.mul","paras":[523,528],"vripara":"57"},"segments":{"iti57:0.4":"Dutiyaāsavasuttaṃ","iti57:1.1":"Vuttañhetaṃ bhagavatā, vuttamarahatāti me sutaṃ –","iti57:2.1":"“Tayome, bhikkhave, āsavā.","iti57:2.2":"Katame tayo?","iti57:2.3":"Kāmāsavo, bhavāsavo, avijjāsavo –","iti57:2.4":"ime kho, bhikkhave, tayo āsavā”ti.","iti57:2.5":"Etamatthaṃ bhagavā avoca.","iti57:2.6":"Tatthetaṃ iti vuccati –","iti57:3.1":"“Yassa kāmāsavo khīṇo,","iti57:3.2":"avijjā ca virājitā;","iti57:3.3":"Bhavāsavo parikkhīṇo,","iti57:3.4":"vippamutto nirūpadhi;","iti57:3.5":"Dhāreti antimaṃ dehaṃ,","iti57:3.6":"jetvā māraṃ savāhinin”ti [savāhananti (bahūsu)].","iti57:4.1":"Ayampi attho vutto bhagavatā, iti me sutanti.","iti57:4.2":"Aṭṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"It-a","bookName":"Itivuttaka-aṭṭhakathā","vriCode":"s0504a.att","from":954,"to":960,"paras":[{"para":954,"vripara":"56-57","refs":["iti57:1"],"lines":["56-57. Sattame <b>kāmāsavo</b>ti kāmesu āsavo, kāmasaṅkhāto vā āsavo kāmāsavo, atthato pana kāmarāgo rūpādiabhirati ca kāmāsavo.","Rūpārūpabhavesu chandarāgo jhānanikanti sassatadiṭṭhisahagato rāgo bhavapatthanā ca <b>bhavāsavo</b>.","Avijjāva <b>avijjāsavo</b>."],"lineRefs":[["iti57:1"],["iti57:1"],["iti57:1"]]},{"para":955,"vripara":null,"refs":["iti57:1"],"lines":["<b>Āsavānañca sambhavan</b>ti ettha ayonisomanasikāro avijjādayo ca kilesā āsavānaṃ sambhavo.","Vuttañhetaṃ –"],"lineRefs":[["iti57:1"],["iti57:1"]]},{"para":956,"vripara":null,"refs":["iti57:1"],"lines":["“Ayoniso, bhikkhave, manasikaroto anuppannā ceva āsavā uppajjanti, uppannā ca āsavā pavaḍḍhantī”ti (ma. ni.1.15)."],"lineRefs":[["iti57:1"]]},{"para":957,"vripara":null,"refs":["iti57:1"],"lines":["“Avijjā, bhikkhave, pubbaṅgamā akusalānaṃ dhammānaṃ samāpattiyā anvadeva ahirikaṃ anottappan”ti (itivu.40) ca."],"lineRefs":[["iti57:1"]]},{"para":958,"vripara":null,"refs":["iti57:1"],"lines":["<b>Maggañca khayagāminan</b>ti āsavānaṃ khayagāminaṃ ariyamaggañca.","Tattha kāmāsavo anāgāmimaggena pahīyati, bhavāsavo avijjāsavo ca arahattamaggena.","Kāmupādānaṃ viya kāmāsavopi aggamaggavajjhoti ca vadanti.","Sesaṃ vuttanayameva.","Aṭṭhame apubbaṃ natthi."],"lineRefs":[["iti57:1"],["iti57:1"],["iti57:1"],["iti57:1"],["iti57:1"]]},{"para":959,"vripara":null,"refs":["iti57:1"],"lines":["Sattamaaṭṭhamasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["iti57:1"]]},{"para":960,"vripara":null,"refs":["iti57:1"],"lines":["Taṇhāsuttavaṇṇanā"],"lineRefs":[["iti57:1"]]}],"wordLinks":[]},"tika":null,"tika2":null}
