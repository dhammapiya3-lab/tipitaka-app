{"suttaId":"sn51.24","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[1690,1690],"vripara":"836"},"segments":{"sn51.24:0.3":"Suddhikasuttaṃ","sn51.24:1.1":"“Cattārome, bhikkhave, iddhipādā.","sn51.24:1.2":"Katame cattāro?","sn51.24:1.3":"Idha, bhikkhave, bhikkhu chandasamādhippadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti, vīriyasamādhi … pe … cittasamādhi … pe … vīmaṃsāsamādhippadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti – ime kho, bhikkhave, cattāro iddhipādā”ti.","sn51.24:1.8":"Catutthaṃ."},"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":692,"to":693,"paras":[{"para":692,"vripara":"835-842","refs":["sn51.24:1"],"lines":["835-842. Tatiye vivaṭṭapādakiddhi kathitā, tathā catutthe.","Apica dve phalāni ādiṃ katvā heṭṭhā missakiddhipādā kathitā, sattasu phalesu pubbabhāgā.","Sattamādīni cattāri heṭṭhā kathitanayāneva."],"lineRefs":[["sn51.24:1"],["sn51.24:1"],["sn51.24:1"]]},{"para":693,"vripara":null,"refs":["sn51.24:1"],"lines":["11-12. Moggallānasuttādivaṇṇanā"],"lineRefs":[["sn51.24:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":600,"to":605,"paras":[{"para":600,"vripara":"835-842","refs":["sn51.24:1"],"lines":["835-842. “Dvinnaṃ phalānan”ti āgatasuttaṃ sandhāya <b>“dve phalāni ādiṃ katvā”</b>ti vuttaṃ.","Sesaṃ suviññeyyameva."],"lineRefs":[["sn51.24:1"],["sn51.24:1"]]},{"para":601,"vripara":null,"refs":[],"lines":["Ayoguḷavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":602,"vripara":null,"refs":[],"lines":["Iddhipādasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":603,"vripara":null,"refs":[],"lines":["Anuruddhasaṃyuttaṃ"],"lineRefs":[[]]},{"para":604,"vripara":null,"refs":[],"lines":["Rahogatavaggo"],"lineRefs":[[]]},{"para":605,"vripara":null,"refs":["sn51.24:1"],"lines":["1-2. Paṭhamarahogatasuttādivaṇṇanā"],"lineRefs":[["sn51.24:1"]]}],"wordLinks":[]}}
