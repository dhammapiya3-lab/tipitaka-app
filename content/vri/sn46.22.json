{"suttaId":"sn46.22","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[529,529],"vripara":"203"},"segments":{"sn46.22:0.3":"Bojjhaṅgadesanāsuttaṃ","sn46.22:1.1":"“Satta vo, bhikkhave, bojjhaṅge desessāmi;","sn46.22:1.2":"taṃ suṇātha.","sn46.22:1.3":"Katame ca, bhikkhave, satta bojjhaṅgā?","sn46.22:1.4":"Satisambojjhaṅgo … pe … upekkhāsambojjhaṅgo – ime kho, bhikkhave, satta bojjhaṅgā”ti.","sn46.22:1.6":"Dutiyaṃ."},"attha":null,"tika":null}
