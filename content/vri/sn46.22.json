{"suttaId":"sn46.22","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[529,529],"vripara":"203"},"segments":{"sn46.22:0.3":"Bojjhaṅgadesanāsuttaṃ","sn46.22:1.1":"“Satta vo, bhikkhave, bojjhaṅge desessāmi;","sn46.22:1.2":"taṃ suṇātha.","sn46.22:1.3":"Katame ca, bhikkhave, satta bojjhaṅgā?","sn46.22:1.4":"Satisambojjhaṅgo…pe… upekkhāsambojjhaṅgo –","sn46.22:1.5":"ime kho, bhikkhave, satta bojjhaṅgā”ti.","sn46.22:1.6":"Dutiyaṃ. 3."},"unsure":[],"preface":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":183,"to":184,"paras":[{"para":183,"vripara":"202-203","refs":["sn46.22:1"],"lines":["Tatiyavaggassa paṭhame <b>kittāvatā nu kho, bhante, bojjhaṅgāti vuccantī</b>ti bhante, kittakena nu kho bujjhanakaaṅgā nāma vuccantīti pucchati.","<b>Bodhāya saṃvattantī</b>ti bujjhanatthāya saṃvattanti.","Imasmiṃ sutte missakabojjhaṅgā kathitā.","Dutiye dhammaparicchedo kathito. 3-5."],"lineRefs":[["sn46.22:1"],["sn46.22:1"],["sn46.22:1"],["sn46.22:1"]]},{"para":184,"vripara":null,"refs":["sn46.22:1"],"lines":["Ṭhāniyasuttādivaṇṇanā 204-206."],"lineRefs":[["sn46.22:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":188,"to":189,"paras":[{"para":188,"vripara":"202-203","refs":["sn46.22:1"],"lines":["<b>Kittakena nu kho</b> kāraṇena <b>bujjhanakaaṅgā nāma vuccanti</b> bujjhanakassa puggalassa aṅgāti vattabbataṃ labhanti.","<b>Missakabojjhaṅgā kathitā</b> sahavipassanā maggabojjhaṅgā kathitāti katvā.","<b>Dhammaparicchedo kathito</b> gaṇanāmattena paricchinditvā vuttattā na bhūmantaraparicchedo, vipassanādiparicchedo vā. 3-5."],"lineRefs":[["sn46.22:1"],["sn46.22:1"],["sn46.22:1"]]},{"para":189,"vripara":null,"refs":["sn46.22:1"],"lines":["Ṭhāniyasuttādivaṇṇanā 204-206."],"lineRefs":[["sn46.22:1"]]}],"wordLinks":[]},"tika2":null}
