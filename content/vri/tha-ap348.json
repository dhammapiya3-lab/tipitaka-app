{"suttaId":"tha-ap348","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[10354,10368],"vripara":"39"},"segments":{"tha-ap348:0.3":"Campakapupphiyattheraapadānaṃ","tha-ap348:1.1":"“Himavantassāvidūre,","tha-ap348:1.2":"jāpalo [cāpalo (sī.), chāpalo (syā.)] nāma pabbato;","tha-ap348:1.3":"Buddho sudassano nāma,","tha-ap348:1.4":"vihāsi pabbatantare. 40.","tha-ap348:2.1":"“Pupphaṃ hemavantaṃ [hemavataṃ (sī.), hemavaṇṇaṃ (syā.)] gayha,","tha-ap348:2.2":"gacchaṃ vehāyasenahaṃ;","tha-ap348:2.3":"Addasaṃ virajaṃ buddhaṃ,","tha-ap348:2.4":"oghatiṇṇamanāsavaṃ. 41.","tha-ap348:3.1":"“Satta campakapupphāni,","tha-ap348:3.2":"sīse katvānahaṃ tadā;","tha-ap348:3.3":"Buddhassa abhiropesiṃ,","tha-ap348:3.4":"sayambhussa mahesino. 42.","tha-ap348:4.1":"“Ekattiṃse ito kappe,","tha-ap348:4.2":"yaṃ pupphamabhiropayiṃ;","tha-ap348:4.3":"Duggatiṃ nābhijānāmi,","tha-ap348:4.4":"buddhapūjāyidaṃ phalaṃ. 43.","tha-ap348:5.1":"“Paṭisambhidā catasso…pe…","tha-ap348:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap348:6.1":"Itthaṃ sudaṃ āyasmā campakapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap348:7.1":"Campakapupphiyattherassāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
