{"suttaId":"an5.160","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[1084,1088],"vripara":"160"},"segments":{"an5.160:0.3":"Duppaṭivinodayasuttaṃ","an5.160:1.1":"“Pañcime, bhikkhave, uppannā duppaṭivinodayā.","an5.160:1.2":"Katame pañca?","an5.160:1.3":"Uppanno rāgo duppaṭivinodayo, uppanno doso duppaṭivinodayo, uppanno moho duppaṭivinodayo, uppannaṃ paṭibhānaṃ duppaṭivinodayaṃ, uppannaṃ gamikacittaṃ duppaṭivinodayaṃ.","an5.160:1.4":"Ime kho, bhikkhave, pañca uppannā duppaṭivinodayā”ti.","an5.160:1.5":"Dasamaṃ.","an5.160:1.6":"Saddhammavaggo paṭhamo.","an5.160:2.0":"Tassuddānaṃ –","an5.160:2.1":"Tayo sammattaniyāmā,","an5.160:2.2":"tayo saddhammasammosā;","an5.160:2.3":"Dukkathā ceva sārajjaṃ,","an5.160:2.4":"udāyidubbinodayāti. (17) 2."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":327,"to":327,"paras":[{"para":327,"vripara":"160","refs":["an5.160:1"],"lines":["Dasame <b>duppaṭivinodayā</b>ti yāni hassādīni kiccāni nipphādetuṃ ṭhānāni uppannāni honti, tesu matthakaṃ asampattesu antarāyeva dunnīhārā duvikkhambhayā honti.","<b>Paṭibhāna</b>nti kathetukāmatā vuccati.","Imāni pañca duppaṭivinodayāni, na suppaṭivinodayāni.","Upāyena pana kāraṇena anurūpāhi paccavekkhaṇaanusāsanādīhi sakkā paṭivinodetunti."],"lineRefs":[["an5.160:1"],["an5.160:1"],["an5.160:1"],["an5.160:1"]]}],"wordLinks":[["an5.160:1.1","duppaṭivinodayā",0,0],["an5.160:1.3","duppaṭivinodayā",0,0],["an5.160:1.4","duppaṭivinodayā",0,0],["an5.160:1.3","paṭibhānaṃ",0,1]],"before":[{"para":326,"vripara":null,"title":"Duppaṭivinodayasuttavaṇṇanā","lines":["Duppaṭivinodayasuttavaṇṇanā 160."]}],"after":[{"para":328,"vripara":null,"title":"Duppaṭivinodayasuttavaṇṇanā","lines":["Saddhammavaggo paṭhamo. (17) 2."]}]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":290,"to":292,"paras":[{"para":290,"vripara":"151-160","refs":["an5.160:1"],"lines":["Paṭhamo vaggo uttānatthoyeva. (17) 2."],"lineRefs":[["an5.160:1"]]},{"para":291,"vripara":null,"refs":["an5.160:1"],"lines":["Āghātavaggo 1-5."],"lineRefs":[["an5.160:1"]]},{"para":292,"vripara":null,"refs":["an5.160:1"],"lines":["Paṭhamaāghātapaṭivinayasuttādivaṇṇanā 161-165."],"lineRefs":[["an5.160:1"]]}],"wordLinks":[]},"tika2":null}
