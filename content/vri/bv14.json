{"suttaId":"bv14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[1887,1993],"vripara":"1"},"segments":{"bv14:0.2":"Sujātabuddhavaṃso","bv14:1.1":"Tattheva maṇḍakappamhi,","bv14:1.2":"sujāto nāma nāyako;","bv14:1.3":"Sīhahanusabhakkhandho,","bv14:1.4":"appameyyo durāsado. 2.","bv14:2.1":"Candova vimalo suddho,","bv14:2.2":"sataraṃsīva patāpavā;","bv14:2.3":"Evaṃ sobhati sambuddho,","bv14:2.4":"jalanto siriyā sadā. 3.","bv14:3.1":"Pāpuṇitvāna sambuddho,","bv14:3.2":"kevalaṃ bodhimuttamaṃ;","bv14:3.3":"Sumaṅgalamhi nagare,","bv14:3.4":"dhammacakkaṃ pavattayi. 4.","bv14:4.1":"Desente [desento (syā. kaṃ.)] pavaraṃ dhammaṃ,","bv14:4.2":"sujāte lokanāyake [sujāto lokanāyako (syā. kaṃ.)];","bv14:4.3":"Asītikoṭī abhisamiṃsu,","bv14:4.4":"paṭhame dhammadesane. 5.","bv14:5.1":"Yadā sujāto amitayaso,","bv14:5.2":"deve vassaṃ upāgami;","bv14:5.3":"Sattatiṃsasatasahassānaṃ,","bv14:5.4":"dutiyābhisamayo ahu. 6.","bv14:6.1":"Yadā sujāto asamasamo,","bv14:6.2":"upagacchi pitusantikaṃ;","bv14:6.3":"Saṭṭhisatasahassānaṃ [sattatiṃsasahassānaṃ (sī.)],","bv14:6.4":"tatiyābhisamayo ahu. 7.","bv14:7.1":"Sannipātā tayo āsuṃ,","bv14:7.2":"sujātassa mahesino;","bv14:7.3":"Khīṇāsavānaṃ vimalānaṃ,","bv14:7.4":"santacittāna tādinaṃ. 8.","bv14:8.1":"Abhiññābalappattānaṃ,","bv14:8.2":"appattānaṃ bhavābhave;","bv14:8.3":"Saṭṭhisatasahassāni,","bv14:8.4":"paṭhamaṃ sannipatiṃsu te. 9.","bv14:9.1":"Punāparaṃ sannipāte,","bv14:9.2":"tidivorohaṇe jine;","bv14:9.3":"Paññāsasatasahassānaṃ,","bv14:9.4":"dutiyo āsi samāgamo. 10.","bv14:10.1":"Upasaṅkamanto narāsabhaṃ,","bv14:10.2":"tassa yo aggasāvako;","bv14:10.3":"Catūhi satasahassehi,","bv14:10.4":"sambuddhaṃ upasaṅkami. 11.","bv14:11.1":"Ahaṃ tena samayena,","bv14:11.2":"catudīpamhi issaro;","bv14:11.3":"Antalikkhacaro āsiṃ,","bv14:11.4":"cakkavattī mahabbalo. 12.","bv14:12.1":"Loke acchariyaṃ disvā,","bv14:12.2":"abbhutaṃ lomahaṃsanaṃ;","bv14:12.3":"Upagantvāna vandiṃ so,","bv14:12.4":"sujātaṃ lokanāyakaṃ. 13.","bv14:13.1":"Catudīpe mahārajjaṃ,","bv14:13.2":"ratane satta uttame;","bv14:13.3":"Buddhe niyyādayitvāna,","bv14:13.4":"pabbajiṃ tassa santike. 14.","bv14:14.1":"Ārāmikā janapade,","bv14:14.2":"uṭṭhānaṃ paṭipiṇḍiya;","bv14:14.3":"Upanenti bhikkhusaṅghassa,","bv14:14.4":"paccayaṃ sayanāsanaṃ. 15.","bv14:15.1":"Sopi maṃ buddho [tadā (syā. kaṃ.)] byākāsi,","bv14:15.2":"dasasahassimhi issaro;","bv14:15.3":"“Tiṃsakappasahassamhi,","bv14:15.4":"ayaṃ buddho bhavissati. 16.","bv14:16.1":"“Padhānaṃ padahitvāna…pe…","bv14:16.3":"hessāma sammukhā imaṃ”. 17.","bv14:17.1":"Tassāpi vacanaṃ sutvā,","bv14:17.2":"bhiyyo hāsaṃ janesahaṃ;","bv14:17.3":"Adhiṭṭhahiṃ vataṃ uggaṃ,","bv14:17.4":"dasapāramipūriyā. 18.","bv14:18.1":"Suttantaṃ vinayañcāpi,","bv14:18.2":"navaṅgaṃ satthusāsanaṃ;","bv14:18.3":"Sabbaṃ pariyāpuṇitvāna,","bv14:18.4":"sobhayiṃ jinasāsanaṃ. 19.","bv14:19.1":"Tatthappamatto viharanto,","bv14:19.2":"brahmaṃ bhāvetva bhāvanaṃ;","bv14:19.3":"Abhiññāpāramiṃ gantvā,","bv14:19.4":"brahmalokamagañchahaṃ. 20.","bv14:20.1":"Sumaṅgalaṃ nāma nagaraṃ,","bv14:20.2":"uggato nāma khattiyo;","bv14:20.3":"Mātā pabhāvatī nāma,","bv14:20.4":"sujātassa mahesino. 21.","bv14:21.1":"Navavassasahassāni,","bv14:21.2":"agāraṃ ajjha so vasi;","bv14:21.3":"Sirī upasirī nando,","bv14:21.4":"tayo pāsādamuttamā. 22.","bv14:22.1":"Tevīsatisahassāni,","bv14:22.2":"nāriyo samalaṅkatā;","bv14:22.3":"Sirinandā nāma nārī,","bv14:22.4":"upaseno nāma atrajo. 23.","bv14:23.1":"Nimitte caturo disvā,","bv14:23.2":"assayānena nikkhami;","bv14:23.3":"Anūnanavamāsāni,","bv14:23.4":"padhānaṃ padahī jino. 24.","bv14:24.1":"Brahmunā yācito santo,","bv14:24.2":"sujāto lokanāyako;","bv14:24.3":"Vatti cakkaṃ mahāvīro,","bv14:24.4":"sumaṅgaluyyānamuttame. 25.","bv14:25.1":"Sudassano sudevo ca,","bv14:25.2":"ahesuṃ aggasāvakā;","bv14:25.3":"Nārado nāmupaṭṭhāko,","bv14:25.4":"sujātassa mahesino. 26.","bv14:26.1":"Nāgā ca nāgasamālā ca,","bv14:26.2":"ahesuṃ aggasāvikā;","bv14:26.3":"Bodhi tassa bhagavato,","bv14:26.4":"mahāveḷūti vuccati. 27.","bv14:27.1":"So ca rukkho ghanakkhandho [ghanaruciro (sī. ka.)],","bv14:27.2":"acchiddo hoti pattiko;","bv14:27.3":"Uju vaṃso brahā hoti,","bv14:27.4":"dassanīyo manoramo. 28.","bv14:28.1":"Ekakkhandho pavaḍḍhitvā,","bv14:28.2":"tato sākhā pabhijjati;","bv14:28.3":"Yathā subaddho morahattho,","bv14:28.4":"evaṃ sobhati so dumo. 29.","bv14:29.1":"Na tassa kaṇṭakā honti,","bv14:29.2":"nāpi chiddaṃ mahā ahu;","bv14:29.3":"Vitthiṇṇasākho aviralo,","bv14:29.4":"sandacchāyo manoramo. 30.","bv14:30.1":"Sudatto ceva citto ca,","bv14:30.2":"ahesuṃ aggupaṭṭhakā;","bv14:30.3":"Subhaddā ca padumā ca,","bv14:30.4":"ahesuṃ aggupaṭṭhikā. 31.","bv14:31.1":"Paññāsaratano āsi,","bv14:31.2":"uccattanena so jino;","bv14:31.3":"Sabbākāravarūpeto,","bv14:31.4":"sabbaguṇamupāgato. 32.","bv14:32.1":"Tassa pabhā asamasamā,","bv14:32.2":"niddhāvati samantato;","bv14:32.3":"Appamāṇo atuliyo,","bv14:32.4":"opammehi anūpamo. 33.","bv14:33.1":"Navutivassasahassāni,","bv14:33.2":"āyu vijjati tāvade;","bv14:33.3":"Tāvatā tiṭṭhamāno so,","bv14:33.4":"tāresi janataṃ bahuṃ. 34.","bv14:34.1":"Yathāpi sāgare ūmī,","bv14:34.2":"gagane tārakā yathā;","bv14:34.3":"Evaṃ tadā pāvacanaṃ,","bv14:34.4":"arahantehi cittitaṃ [cittakaṃ (syā. kaṃ.)]. 35.","bv14:35.1":"So ca buddho asamasamo,","bv14:35.2":"guṇāni ca tāni atuliyāni;","bv14:35.3":"Sabbaṃ tamantarahitaṃ,","bv14:35.4":"nanu rittā sabbasaṅkhārā. 36.","bv14:36.1":"Sujāto jinavaro buddho,","bv14:36.2":"silārāmamhi nibbuto;","bv14:36.3":"Tattheva tassa cetiyo [tattheva cetiyo satthu (syā. kaṃ.)],","bv14:36.4":"tīṇigāvutamuggatoti.","bv14:37.1":"Sujātassa bhagavato vaṃso dvādasamo. 15."},"unsure":[],"preface":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":2835,"to":2835,"paras":[{"para":2835,"vripara":null,"refs":["bv14:35"],"lines":["<b>Appamāṇo</b>ti pamāṇarahito, pamāṇaṃ gahetuṃ asakkuṇeyyattā vā appamāṇo.","<b>Atuliyo</b>ti atulo, kenaci asadisoti attho.","<b>Opammehī</b>ti upamitabbehi.","<b>Anūpamo</b>ti upamārahito, “iminā ca iminā ca sadiso”ti vattuṃ asakkuṇeyyabhāvato anūpamoti attho.","<b>Guṇāni</b> <b>ca tānī</b>ti guṇā ca te, sabbaññutaññāṇādayo guṇāti attho.","Liṅgavipallāsena vuttaṃ.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["bv14:35"],["bv14:35"],["bv14:35"],["bv14:35"],["bv14:35"],["bv14:35"],["bv14:35"]]}],"wordLinks":[["bv14:35.1","atuliyo",0,1],["bv14:35.1","guṇāni ca tānī",0,4]],"before":[{"para":2737,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Sujātabuddhavaṃsavaṇṇanā"]},{"para":2738,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Tato tassāparabhāge tasmiṃyeva maṇḍakappe anupubbena aparimitāyukesu sattesu anukkamena parihāyitvā navutivassasahassāyukesu jātesu sujātarūpakāyo parisuddhajāto <b>sujāto</b> nāma satthā loke udapādi.","Sopi pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā sumaṅgalanagare uggatassa nāma rañño kule pabhāvatiyā nāma aggamahesiyā kucchismiṃ paṭisandhiṃ gahetvā dasannaṃ māsānaṃ accayena mātukucchito nikkhami.","Nāmaggahaṇadivase cassa nāmaṃ karonto sakalajambudīpe sabbasattānaṃ sukhaṃ janayanto jātoti “sujāto” tvevassa nāmamakaṃsu.","So navavassasahassāni agāraṃ ajjhāvasi.","Sirī upasirī sirinando cāti tassa tayo pāsādā ahesuṃ.","Sirīnandādevippamukhāni tevīsati itthisahassāni paccupaṭṭhitāni ahesuṃ."]},{"para":2739,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["So cattāri nimittāni disvā sirīnandādeviyā upasene nāma putte uppanne haṃsavahaṃ nāma varaturaṅgamāruyha mahābhinikkhamanaṃ nikkhamitvā pabbaji.","Taṃ pana pabbajantaṃ manussānaṃ koṭi anupabbaji.","Atha so tehi parivuto nava māse padhānacariyaṃ caritvā visākhapuṇṇamāya sirīnandananagare sirīnandanaseṭṭhissa dhītāya dinnaṃ paramamadhuraṃ madhupāyāsaṃ paribhuñjitvā sālavane divāvihāraṃ vītināmetvā sāyanhasamaye sunandājīvakena dinnā aṭṭha tiṇamuṭṭhiyo gahetvā veḷubodhiṃ upasaṅkamitvā tettiṃsahatthavitthataṃ tiṇasantharaṃ santharitvā sūriye dharamāneyeva samāraṃ mārabalaṃ vidhamitvā sammāsambodhiṃ paṭivijjhitvā sabbabuddhānuciṇṇaṃ udānaṃ udānetvā sattasattāhaṃ bodhisamīpeyeva vītināmetvā brahmunā āyācito attano kaniṭṭhabhātikaṃ sudassanakumāraṃ purohitaputtaṃ devakumārañca catusaccadhammapaṭivedhasamatthe disvā ākāsena gantvā sumaṅgalanagarasamīpe sumaṅgaluyyāne otaritvā uyyānapālena attano bhātikaṃ sudassanakumāraṃ purohitaputtaṃ devakumārañca pakkosāpetvā tesaṃ saparivārānaṃ majjhe nisinno dhammacakkaṃ pavattesi.","Tattha asītiyā koṭīnaṃ dhammābhisamayo ahosi.","Ayaṃ paṭhamābhisamayo ahosi."]},{"para":2740,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Yadā pana bhagavā sudassanuyyānadvāre mahāsālamūle yamakapāṭihāriyaṃ katvā devesu tāvatiṃsesu vassāvāsaṃ upāgami, tadā sattattiṃsasatasahassānaṃ dhammābhisamayo ahosi.","Ayaṃ dutiyo abhisamayo ahosi.","Yadā pana sujāto dasabalo pitusantikaṃ agamāsi, tadā saṭṭhisatasahassānaṃ dhammābhisamayo ahosi.","Ayaṃ tatiyo abhisamayo ahosi.","Tena vuttaṃ – 1."]},{"para":2742,"vripara":"1","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Tattheva maṇḍakappamhi, sujāto nāma nāyako;"]},{"para":2743,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Sīhahanusabhakkhandho, appameyyo durāsado. 2."]},{"para":2745,"vripara":"2","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Candova vimalo buddho, sataraṃsīva patāpavā;"]},{"para":2746,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Evaṃ sobhati sambuddho, jalanto siriyā sadā. 3."]},{"para":2748,"vripara":"3","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Pāpuṇitvāna sambuddho, kevalaṃ bodhimuttamaṃ;"]},{"para":2749,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Sumaṅgalamhi nagare, dhammacakkaṃ pavattayi. 4."]},{"para":2751,"vripara":"4","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Desente pavaraṃ dhammaṃ, sujāte lokanāyake;"]},{"para":2752,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Asītikoṭī abhisamiṃsu, paṭhame dhammadesane. 5."]},{"para":2754,"vripara":"5","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Yadā sujāto amitayaso, deve vassaṃ upāgami;"]},{"para":2755,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Sattattiṃsasatasahassānaṃ, dutiyābhisamayo ahu. 6."]},{"para":2757,"vripara":"6","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Yadā sujāto asamasamo, upagacchi pitusantikaṃ;"]},{"para":2758,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Saṭṭhisatasahassānaṃ, tatiyābhisamayo ahū”ti."]},{"para":2759,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Tattha <b>tattheva maṇḍakappamhī</b>ti yasmiṃ maṇḍakappe sumedho bhagavā uppanno, tattheva kappe sujātopi bhagavā uppannoti attho.","<b>Sīhahanū</b>ti sīhassa viya hanu assāti sīhahanu.","Sīhassa pana heṭṭhimahanumeva puṇṇaṃ hoti, na uparimaṃ.","Assa pana mahāpurisassa sīhassa heṭṭhimahanu viya dvepi paripuṇṇāni dvādasiyaṃ pakkhassa candasadisāni honti.","Tena vuttaṃ “sīhahanū”ti.","<b>Usabhakkhandho</b>ti usabhasseva samappavaṭṭakkhandho, suvaṭṭitasuvaṇṇāliṅgasadisakkhandhoti attho.","<b>Sataraṃsīvā</b>ti divasakaro viya.","<b>Siriyā</b>ti buddhasiriyā.","<b>Bodhimuttama</b>nti uttamaṃ sambodhiṃ."]},{"para":2760,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Sudhammavatīnagare sudhammuyyāne āgatānaṃ manussānaṃ dhammaṃ desetvā saṭṭhisatasahassāni ehibhikkhubhāvena pabbājetvā tesaṃ majjhe pātimokkhaṃ uddisi, so paṭhamo sannipāto ahosi.","Tato paraṃ tidivorohaṇe bhagavato paññāsasatasahassānaṃ dutiyo sannipāto ahosi.","Puna “sudassanakumāro bhagavato santike pabbajitvā arahattaṃ patto”ti sutvā “mayampi pabbajissāmā”ti āgatāni cattāri purisasatasahassāni gahetvā sudassanatthero sujātaṃ narāsabhaṃ upasaṅkami.","Tesaṃ bhagavā dhammaṃ desetvā ehibhikkhupabbajjāya pabbājetvā caturaṅgasamannāgate sannipāte pātimokkhaṃ uddisi, so tatiyo sannipāto ahosi.","Tena vuttaṃ – 7."]},{"para":2762,"vripara":"7","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Sannipātā tayo āsuṃ, sujātassa mahesino;"]},{"para":2763,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ. 8."]},{"para":2765,"vripara":"8","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Abhiññābalappattānaṃ, appattānaṃ bhavābhave;"]},{"para":2766,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Saṭṭhisatasahassāni, paṭhamaṃ sannipatiṃsu te. 9."]},{"para":2768,"vripara":"9","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Punāparaṃ sannipāte, tidivorohaṇe jine;"]},{"para":2769,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Paññāsasatasahassānaṃ, dutiyo āsi samāgamo. 10."]},{"para":2771,"vripara":"10","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Upasaṅkamanto narāsabhaṃ, sudassano aggasāvako;"]},{"para":2772,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Catūhi satasahassehi, sambuddhaṃ upasaṅkamī”ti."]},{"para":2773,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Tattha <b>appattāna</b>nti bhavābhave asampattānanti attho.","“Appavattā bhavābhave”tipi pāṭho, soyevattho.","<b>Tidivorohaṇe</b>ti saggalokato otarante kattukārake daṭṭhabbo.","Kārakavipallāsena vuttaṃ.","Atha vā <b>tidivorohaṇe</b>ti tidivato otaraṇe.","<b>Jine</b>ti jinassa, sāmiatthe bhummaṃ daṭṭhabbaṃ."]},{"para":2774,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Tadā kira amhākaṃ bodhisatto cakkavattirājā hutvā “buddho loke uppanno”ti sutvā bhagavantaṃ upasaṅkamitvā dhammakathaṃ sutvā buddhappamukhassa bhikkhusaṅghassa sattahi ratanehi saddhiṃ catumahādīparajjaṃ datvā satthu santike pabbaji.","Sakaladīpavāsino janā raṭṭhuppādaṃ gahetvā ārāmikakiccaṃ sādhetvā buddhappamukhassa saṅghassa niccaṃ mahādānamadaṃsu.","Sopi naṃ satthā –","“anāgate gotamo nāma buddho bhavissatī”ti byākāsi.","Tena vuttaṃ – 11."]},{"para":2776,"vripara":"11","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Ahaṃ tena samayena, catudīpamhi issaro;"]},{"para":2777,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Antalikkhacaro āsiṃ, cakkavattī mahabbalo. 13."]},{"para":2779,"vripara":"13","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Catudīpe mahārajjaṃ ratane satta uttame;"]},{"para":2780,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Buddhe niyyātayitvāna, pabbajiṃ tassa santike. 14."]},{"para":2782,"vripara":"14","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Ārāmikā janapade, uṭṭhānaṃ paṭipiṇḍiya;"]},{"para":2783,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Upanenti bhikkhusaṅghassa, paccayaṃ sayanāsanaṃ. 15."]},{"para":2785,"vripara":"15","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Sopi maṃ buddho byākāsi, dasasahassimhi issaro;"]},{"para":2786,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Tiṃsakappasahassamhi, ayaṃ buddho bhavissati. 16."]},{"para":2788,"vripara":"16","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Padhānaṃ padahitvāna…pe… hessāma sammukhā imaṃ. 17."]},{"para":2790,"vripara":"17","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Tassāpi cavanaṃ sutvā, bhiyyo hāsaṃ janesahaṃ;"]},{"para":2791,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Adhiṭṭhahiṃ vataṃ uggaṃ, dasapāramipūriyā. 18."]},{"para":2793,"vripara":"18","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Suttantaṃ vinayañcāpi, navaṅgaṃ satthusāsanaṃ;"]},{"para":2794,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Sabbaṃ pariyāpuṇitvāna, sobhayiṃ jinasāsanaṃ. 19."]},{"para":2796,"vripara":"19","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Tatthappamatto viharanto, brahmaṃ bhāvetva bhāvanaṃ;"]},{"para":2797,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Abhiññāpāramiṃ gantvā, brahmalokamagañchaha”nti."]},{"para":2798,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Tattha <b>catudīpamhī</b>ti saparivāradīpānaṃ catunnaṃ mahādīpānanti attho.","<b>Antalikkhacaro</b>ti cakkaratanaṃ purakkhatvā ākāsacaro.","<b>Ratane sattā</b>ti hatthiratanādīni satta ratanāni.","<b>Uttame</b>ti uttamāni.","Atha vā uttame buddheti attho daṭṭhabbo.","<b>Niyyātayitvānā</b>ti datvāna.","<b>Uṭṭhāna</b>nti raṭṭhuppādaṃ, āyanti attho.","<b>Paṭipiṇḍiyā</b>ti rāsiṃ katvā saṃkaḍḍhitvā.","<b>Paccaya</b>nti cīvarādivividhaṃ paccayaṃ.","<b>Dasasahassimhi issaro</b>ti dasasahassilokadhātuyaṃ issaro, tadetaṃ jātikkhettaṃ sandhāya vuttanti veditabbaṃ.","Anantānaṃ lokadhātūnaṃ issaro bhagavā.","<b>Tiṃsakappasahassamhī</b>ti ito paṭṭhāya tiṃsakappasahassānaṃ matthaketi attho."]},{"para":2799,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Tassa pana sujātassa bhagavato sumaṅgalaṃ nāma nagaraṃ ahosi, uggato nāma rājā pitā, pabhāvatī nāma mātā, sudassano ca sudevo ca dve aggasāvakā, nārado nāmupaṭṭhāko, nāgā ca nāgasamālā ca dve aggasāvikā, mahāveḷurukkho bodhi, so kira mandacchiddo ghanakkhandho paramaramaṇīyo veḷuriyamaṇivaṇṇehi vimalehi pattehi sañchannavipulasākho mayūrapiñchakalāpo viya virocittha.","Tassa pana bhagavato sarīraṃ paṇṇāsahatthubbedhaṃ ahosi, āyu navutivassasahassāni, sirīnandā nāmassa aggamahesī, upaseno nāma putto.","Turaṅgavarayānena nikkhami.","So pana candavatīnagare silārāme parinibbāyi.","Tena vuttaṃ – 20."]},{"para":2801,"vripara":"20","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Sumaṅgalaṃ nāma nagaraṃ, uggato nāma khattiyo;"]},{"para":2802,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Mātā pabhāvatī nāma, sujātassa mahesino. 25."]},{"para":2804,"vripara":"25","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Sudassano sudevo ca, ahesuṃ aggasāvakā;"]},{"para":2805,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Nārado nāmupaṭṭhāko, sujātassa mahesino. 26."]},{"para":2807,"vripara":"26","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Nāgo ca nāgasamālā ca, ahesuṃ aggasāvikā;"]},{"para":2808,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Bodhi tassa bhagavato, mahāveḷūti vuccati. 27."]},{"para":2810,"vripara":"27","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“So ca rukkho ghanakkhandho, acchiddo hoti pattiko;"]},{"para":2811,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Uju vaṃso brahā hoti, dassanīyo manoramo. 28."]},{"para":2813,"vripara":"28","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Ekakkhandho pavaḍḍhitvā, tato sākhā pabhijjati;"]},{"para":2814,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Yathā subaddho morahattho, evaṃ sobhati so dumo. 29."]},{"para":2816,"vripara":"29","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Na tassa kaṇṭakā honti, nāpi chiddaṃ mahā ahu;"]},{"para":2817,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Vitthiṇṇasākho aviralo, sandacchāyo manoramo. 31."]},{"para":2819,"vripara":"31","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Paññāsaratano āsi, uccattanena so jino;"]},{"para":2820,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Sabbākāravarūpeto, sabbaguṇamupāgato. 32."]},{"para":2822,"vripara":"32","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Tassa pabhā asamasamā, niddhāvati samantato;"]},{"para":2823,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Appamāṇo atuliyo, opammehi anūpamo. 33."]},{"para":2825,"vripara":"33","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Navutivassasahassāni, āyu vijjati tāvade;"]},{"para":2826,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ. 34."]},{"para":2828,"vripara":"34","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“Yathāpi sāgare ūmī, gagane tārakā yathā;"]},{"para":2829,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Evaṃ tadā pāvacanaṃ, arahantehi cittitaṃ. 35."]},{"para":2831,"vripara":"35","title":"Sujātabuddhavaṃsavaṇṇanā","lines":["“So ca buddho asamasamo, guṇāni ca tāni atuliyāni;"]},{"para":2832,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā”ti."]},{"para":2833,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Tattha <b>acchiddo</b>ti appacchiddo.","“Anudarā kaññā”tiādīsu viya daṭṭhabbaṃ.","Keci “chiddaṃ hoti parittaka”nti paṭhanti.","<b>Pattiko</b>ti bahupatto, kācamaṇivaṇṇehi pattehi sañchannoti attho.","<b>Ujū</b>ti avaṅko akuṭilo.","<b>Vaṃso</b>ti veḷu.","<b>Brahā</b>ti samantato mahā.","<b>Ekakkhandho</b>ti avaniruho eko adutiyo cāti attho.","<b>Pavaḍḍhitvā</b>ti vaḍḍhitvā.","<b>Tato sākhā pabhijjatī</b>ti tato vaṃsaggato pañcavidhā sākhā nikkhamitvā pabhijjittha.","“Tato sākhā pabhijjathā”tipi pāṭho.","<b>Subaddho</b>ti suṭṭhu pañcabandhanākārena baddho.","<b>Morahattho</b>ti ātapasannivāraṇatthaṃ kato baddho morapiñchakalāpo vuccati."]},{"para":2834,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["<b>Na tassa kaṇṭakā hontī</b>ti tassa vaṃsassa kaṇṭakinopi rukkhassa kaṇṭakā nāhesuṃ.","<b>Aviralo</b>ti aviralasākhāsañchanno.","<b>Sandacchāyo</b>ti ghanacchāyo, aviralattāva sandacchāyoti vutto.","<b>Paññāsaratano āsī</b>ti paññāsahattho ahosi.","<b>Sabbākāravarūpeto</b>ti sabbena ākārena varehiyeva upeto sabbākāravarūpeto nāma.","<b>Sabbaguṇamupāgato</b>ti anantarapadasseva vevacanamattaṃ."]}],"after":[{"para":2836,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Sujātabuddhavaṃsavaṇṇanā niṭṭhitā."]},{"para":2837,"vripara":null,"title":"Sujātabuddhavaṃsavaṇṇanā","lines":["Niṭṭhito dvādasamo buddhavaṃso. 15."]}]},"tika":null,"tika2":null}
