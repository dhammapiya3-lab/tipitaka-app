{"suttaId":"bv14","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Bv","vriCode":"s0511m.mul","paras":[1887,1993],"vripara":"1"},"segments":{"bv14:0.2":"Sujātabuddhavaṃso","bv14:1.1":"Tattheva maṇḍakappamhi,","bv14:1.2":"sujāto nāma nāyako;","bv14:1.3":"Sīhahanusabhakkhandho,","bv14:1.4":"appameyyo durāsado.","bv14:2.1":"Candova vimalo suddho,","bv14:2.2":"sataraṃsīva patāpavā;","bv14:2.3":"Evaṃ sobhati sambuddho,","bv14:2.4":"jalanto siriyā sadā.","bv14:3.1":"Pāpuṇitvāna sambuddho,","bv14:3.2":"kevalaṃ bodhimuttamaṃ;","bv14:3.3":"Sumaṅgalamhi nagare,","bv14:3.4":"dhammacakkaṃ pavattayi.","bv14:4.1":"Desente [desento (syā. kaṃ.)] pavaraṃ dhammaṃ,","bv14:4.2":"sujāte lokanāyake [sujāto lokanāyako (syā. kaṃ.)];","bv14:4.3":"Asītikoṭī abhisamiṃsu,","bv14:4.4":"paṭhame dhammadesane.","bv14:5.1":"Yadā sujāto amitayaso,","bv14:5.2":"deve vassaṃ upāgami;","bv14:5.3":"Sattatiṃsasatasahassānaṃ,","bv14:5.4":"dutiyābhisamayo ahu.","bv14:6.1":"Yadā sujāto asamasamo,","bv14:6.2":"upagacchi pitusantikaṃ;","bv14:6.3":"Saṭṭhisatasahassānaṃ [sattatiṃsasahassānaṃ (sī.)],","bv14:6.4":"tatiyābhisamayo ahu.","bv14:7.1":"Sannipātā tayo āsuṃ,","bv14:7.2":"sujātassa mahesino;","bv14:7.3":"Khīṇāsavānaṃ vimalānaṃ,","bv14:7.4":"santacittāna tādinaṃ.","bv14:8.1":"Abhiññābalappattānaṃ,","bv14:8.2":"appattānaṃ bhavābhave;","bv14:8.3":"Saṭṭhisatasahassāni,","bv14:8.4":"paṭhamaṃ sannipatiṃsu te.","bv14:9.1":"Punāparaṃ sannipāte,","bv14:9.2":"tidivorohaṇe jine;","bv14:9.3":"Paññāsasatasahassānaṃ,","bv14:9.4":"dutiyo āsi samāgamo.","bv14:10.1":"Upasaṅkamanto narāsabhaṃ,","bv14:10.2":"tassa yo aggasāvako;","bv14:10.3":"Catūhi satasahassehi,","bv14:10.4":"sambuddhaṃ upasaṅkami.","bv14:11.1":"Ahaṃ tena samayena,","bv14:11.2":"catudīpamhi issaro;","bv14:11.3":"Antalikkhacaro āsiṃ,","bv14:11.4":"cakkavattī mahabbalo.","bv14:12.1":"Loke acchariyaṃ disvā,","bv14:12.2":"abbhutaṃ lomahaṃsanaṃ;","bv14:12.3":"Upagantvāna vandiṃ so,","bv14:12.4":"sujātaṃ lokanāyakaṃ.","bv14:13.1":"Catudīpe mahārajjaṃ,","bv14:13.2":"ratane satta uttame;","bv14:13.3":"Buddhe niyyādayitvāna,","bv14:13.4":"pabbajiṃ tassa santike.","bv14:14.1":"Ārāmikā janapade,","bv14:14.2":"uṭṭhānaṃ paṭipiṇḍiya;","bv14:14.3":"Upanenti bhikkhusaṅghassa,","bv14:14.4":"paccayaṃ sayanāsanaṃ.","bv14:15.1":"Sopi maṃ buddho [tadā (syā. kaṃ.)] byākāsi,","bv14:15.2":"dasasahassimhi issaro;","bv14:15.3":"“Tiṃsakappasahassamhi,","bv14:15.4":"ayaṃ buddho bhavissati.","bv14:16.1":"“Padhānaṃ padahitvāna … pe …","bv14:16.3":"hessāma sammukhā imaṃ”.","bv14:17.1":"Tassāpi vacanaṃ sutvā,","bv14:17.2":"bhiyyo hāsaṃ janesahaṃ;","bv14:17.3":"Adhiṭṭhahiṃ vataṃ uggaṃ,","bv14:17.4":"dasapāramipūriyā.","bv14:18.1":"Suttantaṃ vinayañcāpi,","bv14:18.2":"navaṅgaṃ satthusāsanaṃ;","bv14:18.3":"Sabbaṃ pariyāpuṇitvāna,","bv14:18.4":"sobhayiṃ jinasāsanaṃ.","bv14:19.1":"Tatthappamatto viharanto,","bv14:19.2":"brahmaṃ bhāvetva bhāvanaṃ;","bv14:19.3":"Abhiññāpāramiṃ gantvā,","bv14:19.4":"brahmalokamagañchahaṃ.","bv14:20.1":"Sumaṅgalaṃ nāma nagaraṃ,","bv14:20.2":"uggato nāma khattiyo;","bv14:20.3":"Mātā pabhāvatī nāma,","bv14:20.4":"sujātassa mahesino.","bv14:21.1":"Navavassasahassāni,","bv14:21.2":"agāraṃ ajjha so vasi;","bv14:21.3":"Sirī upasirī nando,","bv14:21.4":"tayo pāsādamuttamā.","bv14:22.1":"Tevīsatisahassāni,","bv14:22.2":"nāriyo samalaṅkatā;","bv14:22.3":"Sirinandā nāma nārī,","bv14:22.4":"upaseno nāma atrajo.","bv14:23.1":"Nimitte caturo disvā,","bv14:23.2":"assayānena nikkhami;","bv14:23.3":"Anūnanavamāsāni,","bv14:23.4":"padhānaṃ padahī jino.","bv14:24.1":"Brahmunā yācito santo,","bv14:24.2":"sujāto lokanāyako;","bv14:24.3":"Vatti cakkaṃ mahāvīro,","bv14:24.4":"sumaṅgaluyyānamuttame.","bv14:25.1":"Sudassano sudevo ca,","bv14:25.2":"ahesuṃ aggasāvakā;","bv14:25.3":"Nārado nāmupaṭṭhāko,","bv14:25.4":"sujātassa mahesino.","bv14:26.1":"Nāgā ca nāgasamālā ca,","bv14:26.2":"ahesuṃ aggasāvikā;","bv14:26.3":"Bodhi tassa bhagavato,","bv14:26.4":"mahāveḷūti vuccati.","bv14:27.1":"So ca rukkho ghanakkhandho [ghanaruciro (sī. ka.)],","bv14:27.2":"acchiddo hoti pattiko;","bv14:27.3":"Uju vaṃso brahā hoti,","bv14:27.4":"dassanīyo manoramo.","bv14:28.1":"Ekakkhandho pavaḍḍhitvā,","bv14:28.2":"tato sākhā pabhijjati;","bv14:28.3":"Yathā subaddho morahattho,","bv14:28.4":"evaṃ sobhati so dumo.","bv14:29.1":"Na tassa kaṇṭakā honti,","bv14:29.2":"nāpi chiddaṃ mahā ahu;","bv14:29.3":"Vitthiṇṇasākho aviralo,","bv14:29.4":"sandacchāyo manoramo.","bv14:30.1":"Sudatto ceva citto ca,","bv14:30.2":"ahesuṃ aggupaṭṭhakā;","bv14:30.3":"Subhaddā ca padumā ca,","bv14:30.4":"ahesuṃ aggupaṭṭhikā.","bv14:31.1":"Paññāsaratano āsi,","bv14:31.2":"uccattanena so jino;","bv14:31.3":"Sabbākāravarūpeto,","bv14:31.4":"sabbaguṇamupāgato.","bv14:32.1":"Tassa pabhā asamasamā,","bv14:32.2":"niddhāvati samantato;","bv14:32.3":"Appamāṇo atuliyo,","bv14:32.4":"opammehi anūpamo.","bv14:33.1":"Navutivassasahassāni,","bv14:33.2":"āyu vijjati tāvade;","bv14:33.3":"Tāvatā tiṭṭhamāno so,","bv14:33.4":"tāresi janataṃ bahuṃ.","bv14:34.1":"Yathāpi sāgare ūmī,","bv14:34.2":"gagane tārakā yathā;","bv14:34.3":"Evaṃ tadā pāvacanaṃ,","bv14:34.4":"arahantehi cittitaṃ [cittakaṃ (syā. kaṃ.)].","bv14:35.1":"So ca buddho asamasamo,","bv14:35.2":"guṇāni ca tāni atuliyāni;","bv14:35.3":"Sabbaṃ tamantarahitaṃ,","bv14:35.4":"nanu rittā sabbasaṅkhārā.","bv14:36.1":"Sujāto jinavaro buddho,","bv14:36.2":"silārāmamhi nibbuto;","bv14:36.3":"Tattheva tassa cetiyo [tattheva cetiyo satthu (syā. kaṃ.)],","bv14:36.4":"tīṇigāvutamuggatoti.","bv14:37.1":"Sujātassa bhagavato vaṃso dvādasamo."},"unsure":[],"attha":{"book":"Bv-a","bookName":"Buddhavaṃsa-aṭṭhakathā","vriCode":"s0511a.att","from":2835,"to":2835,"paras":[{"para":2835,"vripara":null,"refs":["bv14:35"],"lines":["<b>Appamāṇo</b>ti pamāṇarahito, pamāṇaṃ gahetuṃ asakkuṇeyyattā vā appamāṇo.","<b>Atuliyo</b>ti atulo, kenaci asadisoti attho.","<b>Opammehī</b>ti upamitabbehi.","<b>Anūpamo</b>ti upamārahito,“iminā ca iminā ca sadiso”ti vattuṃ asakkuṇeyyabhāvato anūpamoti attho.","<b>Guṇāni ca tānī</b>ti guṇā ca te, sabbaññutaññāṇādayo guṇāti attho.","Liṅgavipallāsena vuttaṃ.","Sesaṃ sabbattha uttānatthamevāti."],"lineRefs":[["bv14:35"],["bv14:35"],["bv14:35"],["bv14:35"],["bv14:35"],["bv14:35"],["bv14:35"]]}],"wordLinks":[["bv14:35.1","atuliyo",0,1],["bv14:35.1","guṇāni ca tānī",0,4]],"before":[{"para":2735,"vripara":null,"refs":[],"lines":["Sumedhabuddhavaṃsavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":2736,"vripara":null,"refs":[],"lines":["Niṭṭhito ekādasamo buddhavaṃso."],"lineRefs":[[]]},{"para":2737,"vripara":null,"refs":[],"lines":["Sujātabuddhavaṃsavaṇṇanā"],"lineRefs":[[]]},{"para":2738,"vripara":null,"refs":[],"lines":["Tato tassāparabhāge tasmiṃyeva maṇḍakappe anupubbena aparimitāyukesu sattesu anukkamena parihāyitvā navutivassasahassāyukesu jātesu sujātarūpakāyo parisuddhajāto <b>sujāto</b> nāma satthā loke udapādi.","Sopi pāramiyo pūretvā tusitapure nibbattitvā tato cavitvā sumaṅgalanagare uggatassa nāma rañño kule pabhāvatiyā nāma aggamahesiyā kucchismiṃ paṭisandhiṃ gahetvā dasannaṃ māsānaṃ accayena mātukucchito nikkhami.","Nāmaggahaṇadivase cassa nāmaṃ karonto sakalajambudīpe sabbasattānaṃ sukhaṃ janayanto jātoti “sujāto” tvevassa nāmamakaṃsu.","So navavassasahassāni agāraṃ ajjhāvasi.","Sirī upasirī sirinando cāti tassa tayo pāsādā ahesuṃ.","Sirīnandādevippamukhāni tevīsati itthisahassāni paccupaṭṭhitāni ahesuṃ."],"lineRefs":[[],[],[],[],[],[]]},{"para":2739,"vripara":null,"refs":[],"lines":["So cattāri nimittāni disvā sirīnandādeviyā upasene nāma putte uppanne haṃsavahaṃ nāma varaturaṅgamāruyha mahābhinikkhamanaṃ nikkhamitvā pabbaji.","Taṃ pana pabbajantaṃ manussānaṃ koṭi anupabbaji.","Atha so tehi parivuto nava māse padhānacariyaṃ caritvā visākhapuṇṇamāya sirīnandananagare sirīnandanaseṭṭhissa dhītāya dinnaṃ paramamadhuraṃ madhupāyāsaṃ paribhuñjitvā sālavane divāvihāraṃ vītināmetvā sāyanhasamaye sunandājīvakena dinnā aṭṭha tiṇamuṭṭhiyo gahetvā veḷubodhiṃ upasaṅkamitvā tettiṃsahatthavitthataṃ tiṇasantharaṃ santharitvā sūriye dharamāneyeva samāraṃ mārabalaṃ vidhamitvā sammāsambodhiṃ paṭivijjhitvā sabbabuddhānuciṇṇaṃ udānaṃ udānetvā sattasattāhaṃ bodhisamīpeyeva vītināmetvā brahmunā āyācito attano kaniṭṭhabhātikaṃ sudassanakumāraṃ purohitaputtaṃ devakumārañca catusaccadhammapaṭivedhasamatthe disvā ākāsena gantvā sumaṅgalanagarasamīpe sumaṅgaluyyāne otaritvā uyyānapālena attano bhātikaṃ sudassanakumāraṃ purohitaputtaṃ devakumārañca pakkosāpetvā tesaṃ saparivārānaṃ majjhe nisinno dhammacakkaṃ pavattesi.","Tattha asītiyā koṭīnaṃ dhammābhisamayo ahosi.","Ayaṃ paṭhamābhisamayo ahosi."],"lineRefs":[[],[],[],[],[]]},{"para":2740,"vripara":null,"refs":[],"lines":["Yadā pana bhagavā sudassanuyyānadvāre mahāsālamūle yamakapāṭihāriyaṃ katvā devesu tāvatiṃsesu vassāvāsaṃ upāgami, tadā sattattiṃsasatasahassānaṃ dhammābhisamayo ahosi.","Ayaṃ dutiyo abhisamayo ahosi.","Yadā pana sujāto dasabalo pitusantikaṃ agamāsi, tadā saṭṭhisatasahassānaṃ dhammābhisamayo ahosi.","Ayaṃ tatiyo abhisamayo ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[]]},{"para":2742,"vripara":"1","refs":[],"lines":["“Tattheva maṇḍakappamhi, sujāto nāma nāyako;"],"lineRefs":[[]]},{"para":2743,"vripara":null,"refs":[],"lines":["Sīhahanusabhakkhandho, appameyyo durāsado."],"lineRefs":[[]]},{"para":2745,"vripara":"2","refs":[],"lines":["“Candova vimalo buddho, sataraṃsīva patāpavā;"],"lineRefs":[[]]},{"para":2746,"vripara":null,"refs":[],"lines":["Evaṃ sobhati sambuddho, jalanto siriyā sadā."],"lineRefs":[[]]},{"para":2748,"vripara":"3","refs":[],"lines":["“Pāpuṇitvāna sambuddho, kevalaṃ bodhimuttamaṃ;"],"lineRefs":[[]]},{"para":2749,"vripara":null,"refs":[],"lines":["Sumaṅgalamhi nagare, dhammacakkaṃ pavattayi."],"lineRefs":[[]]},{"para":2751,"vripara":"4","refs":[],"lines":["“Desente pavaraṃ dhammaṃ, sujāte lokanāyake;"],"lineRefs":[[]]},{"para":2752,"vripara":null,"refs":[],"lines":["Asītikoṭī abhisamiṃsu, paṭhame dhammadesane."],"lineRefs":[[]]},{"para":2754,"vripara":"5","refs":[],"lines":["“Yadā sujāto amitayaso, deve vassaṃ upāgami;"],"lineRefs":[[]]},{"para":2755,"vripara":null,"refs":[],"lines":["Sattattiṃsasatasahassānaṃ, dutiyābhisamayo ahu."],"lineRefs":[[]]},{"para":2757,"vripara":"6","refs":[],"lines":["“Yadā sujāto asamasamo, upagacchi pitusantikaṃ;"],"lineRefs":[[]]},{"para":2758,"vripara":null,"refs":[],"lines":["Saṭṭhisatasahassānaṃ, tatiyābhisamayo ahū”ti."],"lineRefs":[[]]},{"para":2759,"vripara":null,"refs":[],"lines":["Tattha <b>tattheva maṇḍakappamhī</b>ti yasmiṃ maṇḍakappe sumedho bhagavā uppanno, tattheva kappe sujātopi bhagavā uppannoti attho.","<b>Sīhahanū</b>ti sīhassa viya hanu assāti sīhahanu.","Sīhassa pana heṭṭhimahanumeva puṇṇaṃ hoti, na uparimaṃ.","Assa pana mahāpurisassa sīhassa heṭṭhimahanu viya dvepi paripuṇṇāni dvādasiyaṃ pakkhassa candasadisāni honti.","Tena vuttaṃ “sīhahanū”ti.","<b>Usabhakkhandho</b>ti usabhasseva samappavaṭṭakkhandho, suvaṭṭitasuvaṇṇāliṅgasadisakkhandhoti attho.","<b>Sataraṃsīvā</b>ti divasakaro viya.","<b>Siriyā</b>ti buddhasiriyā.","<b>Bodhimuttaman</b>ti uttamaṃ sambodhiṃ."],"lineRefs":[[],[],[],[],[],[],[],[],[]]},{"para":2760,"vripara":null,"refs":[],"lines":["Sudhammavatīnagare sudhammuyyāne āgatānaṃ manussānaṃ dhammaṃ desetvā saṭṭhisatasahassāni ehibhikkhubhāvena pabbājetvā tesaṃ majjhe pātimokkhaṃ uddisi, so paṭhamo sannipāto ahosi.","Tato paraṃ tidivorohaṇe bhagavato paññāsasatasahassānaṃ dutiyo sannipāto ahosi.","Puna “sudassanakumāro bhagavato santike pabbajitvā arahattaṃ patto”ti sutvā “mayampi pabbajissāmā”ti āgatāni cattāri purisasatasahassāni gahetvā sudassanatthero sujātaṃ narāsabhaṃ upasaṅkami.","Tesaṃ bhagavā dhammaṃ desetvā ehibhikkhupabbajjāya pabbājetvā caturaṅgasamannāgate sannipāte pātimokkhaṃ uddisi, so tatiyo sannipāto ahosi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[]]},{"para":2762,"vripara":"7","refs":[],"lines":["“Sannipātā tayo āsuṃ, sujātassa mahesino;"],"lineRefs":[[]]},{"para":2763,"vripara":null,"refs":[],"lines":["Khīṇāsavānaṃ vimalānaṃ, santacittāna tādinaṃ."],"lineRefs":[[]]},{"para":2765,"vripara":"8","refs":[],"lines":["“Abhiññābalappattānaṃ, appattānaṃ bhavābhave;"],"lineRefs":[[]]},{"para":2766,"vripara":null,"refs":[],"lines":["Saṭṭhisatasahassāni, paṭhamaṃ sannipatiṃsu te."],"lineRefs":[[]]},{"para":2768,"vripara":"9","refs":[],"lines":["“Punāparaṃ sannipāte, tidivorohaṇe jine;"],"lineRefs":[[]]},{"para":2769,"vripara":null,"refs":[],"lines":["Paññāsasatasahassānaṃ, dutiyo āsi samāgamo."],"lineRefs":[[]]},{"para":2771,"vripara":"10","refs":[],"lines":["“Upasaṅkamanto narāsabhaṃ, sudassano aggasāvako;"],"lineRefs":[[]]},{"para":2772,"vripara":null,"refs":[],"lines":["Catūhi satasahassehi, sambuddhaṃ upasaṅkamī”ti."],"lineRefs":[[]]},{"para":2773,"vripara":null,"refs":[],"lines":["Tattha <b>appattānan</b>ti bhavābhave asampattānanti attho.","“Appavattā bhavābhave” tipi pāṭho, soyevattho.","<b>Tidivorohaṇe</b>ti saggalokato otarante kattukārake daṭṭhabbo.","Kārakavipallāsena vuttaṃ.","Atha vā <b>tidivorohaṇe</b>ti tidivato otaraṇe.","<b>Jine</b>ti jinassa, sāmiatthe bhummaṃ daṭṭhabbaṃ."],"lineRefs":[[],[],[],[],[],[]]},{"para":2774,"vripara":null,"refs":[],"lines":["Tadā kira amhākaṃ bodhisatto cakkavattirājā hutvā “buddho loke uppanno”ti sutvā bhagavantaṃ upasaṅkamitvā dhammakathaṃ sutvā buddhappamukhassa bhikkhusaṅghassa sattahi ratanehi saddhiṃ catumahādīparajjaṃ datvā satthu santike pabbaji.","Sakaladīpavāsino janā raṭṭhuppādaṃ gahetvā ārāmikakiccaṃ sādhetvā buddhappamukhassa saṅghassa niccaṃ mahādānamadaṃsu.","Sopi naṃ satthā –","“anāgate gotamo nāma buddho bhavissatī”ti byākāsi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[]]},{"para":2776,"vripara":"11","refs":[],"lines":["“Ahaṃ tena samayena, catudīpamhi issaro;"],"lineRefs":[[]]},{"para":2777,"vripara":null,"refs":[],"lines":["Antalikkhacaro āsiṃ, cakkavattī mahabbalo."],"lineRefs":[[]]},{"para":2779,"vripara":"13","refs":[],"lines":["“Catudīpe mahārajjaṃ ratane satta uttame;"],"lineRefs":[[]]},{"para":2780,"vripara":null,"refs":[],"lines":["Buddhe niyyātayitvāna, pabbajiṃ tassa santike."],"lineRefs":[[]]},{"para":2782,"vripara":"14","refs":[],"lines":["“Ārāmikā janapade, uṭṭhānaṃ paṭipiṇḍiya;"],"lineRefs":[[]]},{"para":2783,"vripara":null,"refs":[],"lines":["Upanenti bhikkhusaṅghassa, paccayaṃ sayanāsanaṃ."],"lineRefs":[[]]},{"para":2785,"vripara":"15","refs":[],"lines":["“Sopi maṃ buddho byākāsi, dasasahassimhi issaro;"],"lineRefs":[[]]},{"para":2786,"vripara":null,"refs":[],"lines":["Tiṃsakappasahassamhi, ayaṃ buddho bhavissati."],"lineRefs":[[]]},{"para":2788,"vripara":"16","refs":[],"lines":["“Padhānaṃ padahitvāna … pe … hessāma sammukhā imaṃ."],"lineRefs":[[]]},{"para":2790,"vripara":"17","refs":[],"lines":["“Tassāpi cavanaṃ sutvā, bhiyyo hāsaṃ janesahaṃ;"],"lineRefs":[[]]},{"para":2791,"vripara":null,"refs":[],"lines":["Adhiṭṭhahiṃ vataṃ uggaṃ, dasapāramipūriyā."],"lineRefs":[[]]},{"para":2793,"vripara":"18","refs":[],"lines":["“Suttantaṃ vinayañcāpi, navaṅgaṃ satthusāsanaṃ;"],"lineRefs":[[]]},{"para":2794,"vripara":null,"refs":[],"lines":["Sabbaṃ pariyāpuṇitvāna, sobhayiṃ jinasāsanaṃ."],"lineRefs":[[]]},{"para":2796,"vripara":"19","refs":[],"lines":["“Tatthappamatto viharanto, brahmaṃ bhāvetva bhāvanaṃ;"],"lineRefs":[[]]},{"para":2797,"vripara":null,"refs":[],"lines":["Abhiññāpāramiṃ gantvā, brahmalokamagañchahan”ti."],"lineRefs":[[]]},{"para":2798,"vripara":null,"refs":[],"lines":["Tattha <b>catudīpamhī</b>ti saparivāradīpānaṃ catunnaṃ mahādīpānanti attho.","<b>Antalikkhacaro</b>ti cakkaratanaṃ purakkhatvā ākāsacaro.","<b>Ratane sattā</b>ti hatthiratanādīni satta ratanāni.","<b>Uttame</b>ti uttamāni.","Atha vā uttame buddheti attho daṭṭhabbo.","<b>Niyyātayitvānā</b>ti datvāna.","<b>Uṭṭhānan</b>ti raṭṭhuppādaṃ, āyanti attho.","<b>Paṭipiṇḍiyā</b>ti rāsiṃ katvā saṃkaḍḍhitvā.","<b>Paccayan</b>ti cīvarādivividhaṃ paccayaṃ.","<b>Dasasahassimhi issaro</b>ti dasasahassilokadhātuyaṃ issaro, tadetaṃ jātikkhettaṃ sandhāya vuttanti veditabbaṃ.","Anantānaṃ lokadhātūnaṃ issaro bhagavā.","<b>Tiṃsakappasahassamhī</b>ti ito paṭṭhāya tiṃsakappasahassānaṃ matthaketi attho."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":2799,"vripara":null,"refs":[],"lines":["Tassa pana sujātassa bhagavato sumaṅgalaṃ nāma nagaraṃ ahosi, uggato nāma rājā pitā, pabhāvatī nāma mātā, sudassano ca sudevo ca dve aggasāvakā, nārado nāmupaṭṭhāko, nāgā ca nāgasamālā ca dve aggasāvikā, mahāveḷurukkho bodhi, so kira mandacchiddo ghanakkhandho paramaramaṇīyo veḷuriyamaṇivaṇṇehi vimalehi pattehi sañchannavipulasākho mayūrapiñchakalāpo viya virocittha.","Tassa pana bhagavato sarīraṃ paṇṇāsahatthubbedhaṃ ahosi, āyu navutivassasahassāni, sirīnandā nāmassa aggamahesī, upaseno nāma putto.","Turaṅgavarayānena nikkhami.","So pana candavatīnagare silārāme parinibbāyi.","Tena vuttaṃ –"],"lineRefs":[[],[],[],[],[]]},{"para":2801,"vripara":"20","refs":[],"lines":["“Sumaṅgalaṃ nāma nagaraṃ, uggato nāma khattiyo;"],"lineRefs":[[]]},{"para":2802,"vripara":null,"refs":[],"lines":["Mātā pabhāvatī nāma, sujātassa mahesino."],"lineRefs":[[]]},{"para":2804,"vripara":"25","refs":[],"lines":["“Sudassano sudevo ca, ahesuṃ aggasāvakā;"],"lineRefs":[[]]},{"para":2805,"vripara":null,"refs":[],"lines":["Nārado nāmupaṭṭhāko, sujātassa mahesino."],"lineRefs":[[]]},{"para":2807,"vripara":"26","refs":[],"lines":["“Nāgo ca nāgasamālā ca, ahesuṃ aggasāvikā;"],"lineRefs":[[]]},{"para":2808,"vripara":null,"refs":[],"lines":["Bodhi tassa bhagavato, mahāveḷūti vuccati."],"lineRefs":[[]]},{"para":2810,"vripara":"27","refs":[],"lines":["“So ca rukkho ghanakkhandho, acchiddo hoti pattiko;"],"lineRefs":[[]]},{"para":2811,"vripara":null,"refs":[],"lines":["Uju vaṃso brahā hoti, dassanīyo manoramo."],"lineRefs":[[]]},{"para":2813,"vripara":"28","refs":[],"lines":["“Ekakkhandho pavaḍḍhitvā, tato sākhā pabhijjati;"],"lineRefs":[[]]},{"para":2814,"vripara":null,"refs":[],"lines":["Yathā subaddho morahattho, evaṃ sobhati so dumo."],"lineRefs":[[]]},{"para":2816,"vripara":"29","refs":[],"lines":["“Na tassa kaṇṭakā honti, nāpi chiddaṃ mahā ahu;"],"lineRefs":[[]]},{"para":2817,"vripara":null,"refs":[],"lines":["Vitthiṇṇasākho aviralo, sandacchāyo manoramo."],"lineRefs":[[]]},{"para":2819,"vripara":"31","refs":[],"lines":["“Paññāsaratano āsi, uccattanena so jino;"],"lineRefs":[[]]},{"para":2820,"vripara":null,"refs":[],"lines":["Sabbākāravarūpeto, sabbaguṇamupāgato."],"lineRefs":[[]]},{"para":2822,"vripara":"32","refs":[],"lines":["“Tassa pabhā asamasamā, niddhāvati samantato;"],"lineRefs":[[]]},{"para":2823,"vripara":null,"refs":[],"lines":["Appamāṇo atuliyo, opammehi anūpamo."],"lineRefs":[[]]},{"para":2825,"vripara":"33","refs":[],"lines":["“Navutivassasahassāni, āyu vijjati tāvade;"],"lineRefs":[[]]},{"para":2826,"vripara":null,"refs":[],"lines":["Tāvatā tiṭṭhamāno so, tāresi janataṃ bahuṃ."],"lineRefs":[[]]},{"para":2828,"vripara":"34","refs":[],"lines":["“Yathāpi sāgare ūmī, gagane tārakā yathā;"],"lineRefs":[[]]},{"para":2829,"vripara":null,"refs":[],"lines":["Evaṃ tadā pāvacanaṃ, arahantehi cittitaṃ."],"lineRefs":[[]]},{"para":2831,"vripara":"35","refs":[],"lines":["“So ca buddho asamasamo, guṇāni ca tāni atuliyāni;"],"lineRefs":[[]]},{"para":2832,"vripara":null,"refs":[],"lines":["Sabbaṃ tamantarahitaṃ, nanu rittā sabbasaṅkhārā”ti."],"lineRefs":[[]]},{"para":2833,"vripara":null,"refs":[],"lines":["Tattha <b>acchiddo</b>ti appacchiddo.","“Anudarā kaññā”tiādīsu viya daṭṭhabbaṃ.","Keci “chiddaṃ hoti parittakan”ti paṭhanti.","<b>Pattiko</b>ti bahupatto, kācamaṇivaṇṇehi pattehi sañchannoti attho.","<b>Ujū</b>ti avaṅko akuṭilo.","<b>Vaṃso</b>ti veḷu.","<b>Brahā</b>ti samantato mahā.","<b>Ekakkhandho</b>ti avaniruho eko adutiyo cāti attho.","<b>Pavaḍḍhitvā</b>ti vaḍḍhitvā.","<b>Tato sākhā pabhijjatī</b>ti tato vaṃsaggato pañcavidhā sākhā nikkhamitvā pabhijjittha.","“Tato sākhā pabhijjathā” tipi pāṭho.","<b>Subaddho</b>ti suṭṭhu pañcabandhanākārena baddho.","<b>Morahattho</b>ti ātapasannivāraṇatthaṃ kato baddho morapiñchakalāpo vuccati."],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":2834,"vripara":null,"refs":[],"lines":["<b>Na tassa kaṇṭakā hontī</b>ti tassa vaṃsassa kaṇṭakinopi rukkhassa kaṇṭakā nāhesuṃ.","<b>Aviralo</b>ti aviralasākhāsañchanno.","<b>Sandacchāyo</b>ti ghanacchāyo, aviralattāva sandacchāyoti vutto.","<b>Paññāsaratano āsī</b>ti paññāsahattho ahosi.","<b>Sabbākāravarūpeto</b>ti sabbena ākārena varehiyeva upeto sabbākāravarūpeto nāma.","<b>Sabbaguṇamupāgato</b>ti anantarapadasseva vevacanamattaṃ."],"lineRefs":[[],[],[],[],[],[]]}]},"tika":null,"tika2":null}
