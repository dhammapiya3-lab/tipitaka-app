{"suttaId":"sn17.27","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[1132,1132],"vripara":"176"},"segments":{"sn17.27:0.3":"Tatiyasamaṇabrāhmaṇasuttaṃ","sn17.27:1.1":"Sāvatthiyaṃ viharati…pe…","sn17.27:1.2":"“ye hi keci, bhikkhave, samaṇā vā brāhmaṇā vā lābhasakkārasilokaṃ yathābhūtaṃ nappajānanti, lābhasakkārasilokasamudayaṃ nappajānanti, lābhasakkārasilokanirodhaṃ nappajānanti, lābhasakkārasilokanirodhagāminiṃ paṭipadaṃ nappajānanti …pe…","sn17.27:1.3":"pajānanti…pe…","sn17.27:1.4":"sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti.","sn17.27:1.5":"Sattamaṃ. 8."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":813,"to":813,"paras":[{"para":813,"vripara":"176","refs":["sn17.27:1"],"lines":["Sattame <b>samudaya</b>ntiādīsu saha pubbakammena attabhāvo kolaputtiyaṃ vaṇṇapokkharatā kalyāṇavākkaraṇatā dhutaguṇāvīkaraṇaṃ cīvaradhāraṇaṃ parivārasampattīti evamādi lābhasakkārassa samudayo nāma, taṃ samudayasaccavasena nappajānāti, nirodho ca paṭipadā ca nirodhasaccamaggasaccavaseneva veditabbā.","Sattamaṃ. 8."],"lineRefs":[["sn17.27:1"],["sn17.27:1"]]}],"wordLinks":[["sn17.27:1.1","samudayaṃ",0,0]]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":824,"to":826,"paras":[{"para":824,"vripara":"176","refs":["sn17.27:1"],"lines":["<b>Evamādī</b>ti <b>ādi</b>-saddena bāhusaccasaṃvarasīlādīnaṃ saṅgaho daṭṭhabbo.","<b>Lābhasakkārassa samudayaṃ</b> uppattikāraṇaṃ samudayasaccavasena dukkhasaccassa uppattihetutāvasena."],"lineRefs":[["sn17.27:1"],["sn17.27:1"]]},{"para":825,"vripara":null,"refs":["sn17.27:1"],"lines":["Tatiyasamaṇabrāhmaṇasuttavaṇṇanā niṭṭhitā. 8."],"lineRefs":[["sn17.27:1"]]},{"para":826,"vripara":null,"refs":["sn17.27:1"],"lines":["Chavisuttavaṇṇanā 177."],"lineRefs":[["sn17.27:1"]]}],"wordLinks":[]},"tika2":null}
