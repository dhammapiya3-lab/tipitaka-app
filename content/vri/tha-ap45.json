{"suttaId":"tha-ap45","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[3648,3698],"vripara":"54"},"segments":{"tha-ap45:0.3":"Kāḷigodhāputtabhaddiyattheraapadānaṃ","tha-ap45:1.1":"“Padumuttarasambuddhaṃ,","tha-ap45:1.2":"mettacittaṃ mahāmuniṃ;","tha-ap45:1.3":"Upeti janatā sabbā,","tha-ap45:1.4":"sabbalokagganāyakaṃ.","tha-ap45:2.1":"“Sattukañca baddhakañca [vatthaṃ senāsanañceva (sī.), sattukañca padakañca (sī. aṭṭha.), sattukañca pavākañca (syā.)],","tha-ap45:2.2":"āmisaṃ pānabhojanaṃ;","tha-ap45:2.3":"Dadanti satthuno sabbe,","tha-ap45:2.4":"puññakkhette anuttare.","tha-ap45:3.1":"“Ahampi dānaṃ dassāmi,","tha-ap45:3.2":"devadevassa tādino;","tha-ap45:3.3":"Buddhaseṭṭhaṃ nimantetvā,","tha-ap45:3.4":"saṅghampi ca anuttaraṃ.","tha-ap45:4.1":"“Uyyojitā mayā cete,","tha-ap45:4.2":"nimantesuṃ tathāgataṃ;","tha-ap45:4.3":"Kevalaṃ bhikkhusaṅghañca,","tha-ap45:4.4":"puññakkhettaṃ anuttaraṃ.","tha-ap45:5.1":"“Satasahassapallaṅkaṃ,","tha-ap45:5.2":"sovaṇṇaṃ gonakatthataṃ;","tha-ap45:5.3":"Tūlikāpaṭalikāya,","tha-ap45:5.4":"khomakappāsikehi ca;","tha-ap45:5.5":"Mahārahaṃ paññāpayiṃ,","tha-ap45:5.6":"āsanaṃ buddhayuttakaṃ.","tha-ap45:6.1":"“Padumuttaro lokavidū,","tha-ap45:6.2":"devadevo narāsabho;","tha-ap45:6.3":"Bhikkhusaṅghaparibyūḷho,","tha-ap45:6.4":"mama dvāramupāgami.","tha-ap45:7.1":"“Paccuggantvāna sambuddhaṃ,","tha-ap45:7.2":"lokanāthaṃ yasassinaṃ;","tha-ap45:7.3":"Pasannacitto sumano,","tha-ap45:7.4":"abhināmayiṃ saṅgharaṃ [sakaṃ gharaṃ (sī.)].","tha-ap45:8.1":"“Bhikkhūnaṃ satasahassaṃ,","tha-ap45:8.2":"buddhañca lokanāyakaṃ;","tha-ap45:8.3":"Pasannacitto sumano,","tha-ap45:8.4":"paramannena tappayiṃ.","tha-ap45:9.1":"“Padumuttaro lokavidū,","tha-ap45:9.2":"āhutīnaṃ paṭiggaho;","tha-ap45:9.3":"Bhikkhusaṅghe nisīditvā,","tha-ap45:9.4":"imā gāthā abhāsatha.","tha-ap45:10.1":"“‘Yenidaṃ āsanaṃ dinnaṃ,","tha-ap45:10.2":"sovaṇṇaṃ gonakatthataṃ;","tha-ap45:10.3":"Tamahaṃ kittayissāmi,","tha-ap45:10.4":"suṇātha mama bhāsato.","tha-ap45:11.1":"“‘Catusattatikkhattuṃ so,","tha-ap45:11.2":"devarajjaṃ karissati;","tha-ap45:11.3":"Anubhossati sampattiṃ,","tha-ap45:11.4":"accharāhi purakkhato.","tha-ap45:12.1":"“‘Padesarajjaṃ sahassaṃ,","tha-ap45:12.2":"vasudhaṃ āvasissati;","tha-ap45:12.3":"Ekapaññāsakkhattuñca,","tha-ap45:12.4":"cakkavattī bhavissati.","tha-ap45:13.1":"“‘Sabbāsu bhavayonīsu,","tha-ap45:13.2":"uccākulī [uccākule (ka.)] bhavissati;","tha-ap45:13.3":"So ca pacchā pabbajitvā,","tha-ap45:13.4":"sukkamūlena codito;","tha-ap45:13.5":"Bhaddiyo nāma nāmena,","tha-ap45:13.6":"hessati satthu sāvako.","tha-ap45:14.1":"“‘Vivekamanuyuttomhi,","tha-ap45:14.2":"pantasenanivāsahaṃ;","tha-ap45:14.3":"Phalañcādhigataṃ sabbaṃ,","tha-ap45:14.4":"cattaklesomhi ajjahaṃ.","tha-ap45:15.1":"“‘Mama sabbaṃ [kammaṃ (?)] abhiññāya,","tha-ap45:15.2":"sabbaññū lokanāyako;","tha-ap45:15.3":"Bhikkhusaṅghe nisīditvā,","tha-ap45:15.4":"etadagge ṭhapesi maṃ’.","tha-ap45:16.1":"“Paṭisambhidā catasso … pe …","tha-ap45:16.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap45:17.1":"Itthaṃ sudaṃ āyasmā bhaddiyo kāḷigodhāya putto thero imā gāthāyo abhāsitthāti.","tha-ap45:18.1":"Bhaddiyassa kāḷigodhāya puttattherassāpadānaṃ tatiyaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":2502,"to":2504,"paras":[{"para":2502,"vripara":"54","refs":["tha-ap45:1"],"lines":["So arahā hutvā attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>padumuttarasambuddhan</b>tiādimāha.","Taṃ heṭṭhā vuttatthameva.","<b>Mettacittan</b>ti mijjati sinehati nandati sabbasatteti mettā, mettāya sahagataṃ cittaṃ mettacittaṃ, taṃ yassa bhagavato atthīti mettacitto, taṃ mettacittaṃ.","<b>Mahāmunin</b>ti sakalabhikkhūnaṃ mahantattā mahāmuni, taṃ padumuttaraṃ sambuddhanti sambandho.","<b>Janatā sabbā</b>ti sabbo janakāyo, sabbanagaravāsinoti attho.","<b>Sabbalokagganāyakan</b>ti sakalalokassa aggaṃ seṭṭhaṃ nibbānassa nayanato pāpanato nāyakaṃ padumuttarasambuddhaṃ janatā <b>upeti</b> samīpaṃ gacchatīti sambandho."],"lineRefs":[["tha-ap45:1"],["tha-ap45:1"],["tha-ap45:1"],["tha-ap45:1"],["tha-ap45:1"],["tha-ap45:1"]]},{"para":2503,"vripara":"55","refs":["tha-ap45:2"],"lines":["<b>Sattukañca baddhakañcā</b>ti baddhasattuabaddhasattusaṅkhātaṃ <b>āmisaṃ</b>.","Atha vā bhattapūpakhajjabhojjayāguādayo yāvakālikattā <b>āmisaṃ</b> pānabhojanañca gahetvā puññakkhette anuttare satthuno dadantīti sambandho."],"lineRefs":[["tha-ap45:2"],["tha-ap45:2"]]},{"para":2504,"vripara":"58","refs":["tha-ap45:5"],"lines":["<b>Āsanaṃ buddhayuttakan</b>ti buddhayoggaṃ buddhārahaṃ buddhānucchavikaṃ sattaratanamayaṃ āsananti attho.","Sesaṃ nayānuyogena suviññeyyamevāti."],"lineRefs":[["tha-ap45:5"],["tha-ap45:5"]]}],"wordLinks":[["tha-ap45:1.1","padumuttarasambuddhaṃ",0,0],["tha-ap45:1.1","mettacittaṃ",0,2],["tha-ap45:1.1","mahāmuniṃ",0,3],["tha-ap45:1.3","janatā sabbā",0,4],["tha-ap45:1.3","sabbalokagganāyakaṃ",0,5],["tha-ap45:1.3","upeti",0,5],["tha-ap45:2.1","sattukañca baddhakañcā",1,0],["tha-ap45:2.1","āmisaṃ",1,0],["tha-ap45:2.1","āmisaṃ",1,1],["tha-ap45:5.5","āsanaṃ buddhayuttakaṃ",2,0]],"before":[{"para":2499,"vripara":null,"refs":[],"lines":["Koḷivisattheraapadānavaṇṇanā samattā."],"lineRefs":[[]]},{"para":2500,"vripara":null,"refs":[],"lines":["Kāḷigodhāputtabhaddiyattheraapadānavaṇṇanā"],"lineRefs":[[]]},{"para":2501,"vripara":null,"refs":[],"lines":["<b>Padumuttarasambuddhan</b>tiādikaṃ āyasmato bhaddiyassa kāḷigodhāputtattherassa apadānaṃ.","Ayampi purimabuddhesu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto padumuttarassa bhagavato kāle vibhavasampanne ekasmiṃ kule nibbatto vuddhippatto puttadārehi vaḍḍhito nagaravāsino puññāni karonte disvā sayampi puññāni kātukāmo buddhappamukhaṃ bhikkhusaṅghaṃ nimantetvā thūlapaṭalikādianekāni mahārahāni sayanāni paññāpetvā tattha nisinne bhagavati sasaṅghe paṇītenāhārena bhojetvā mahādānaṃ adāsi.","So evaṃ yāvatāyukaṃ puññāni katvā devamanussesu ubhayasampattiyo anubhavitvā aparabhāge imasmiṃ buddhuppāde kāḷigodhāya nāma deviyā putto hutvā nibbatti.","So viññutaṃ patto ārohapariṇāhahatthapādarūpasampattiyā bhaddattā ca kāḷigodhāya deviyā puttattā ca <b>bhaddiyo kāḷigodhāputto</b>ti pākaṭo.","Satthari pasīditvā mātāpitaro ārādhetvā pabbajitvā nacirasseva arahā ahosi."],"lineRefs":[[],[],[],[],[]]}]},"tika":null,"tika2":null}
