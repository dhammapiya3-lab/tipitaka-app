{"suttaId":"ja473","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[6649,6691],"vripara":"121"},"segments":{"ja473:0.4":"Mittāmittajātakaṃ (10)","ja473:1.1":"Kāni kammāni kubbānaṃ,","ja473:1.2":"kathaṃ viññū parakkame;","ja473:1.3":"Amittaṃ jāneyya medhāvī,","ja473:1.4":"disvā sutvā ca paṇḍito.","ja473:2.1":"Na naṃ umhayate disvā,","ja473:2.2":"na ca naṃ paṭinandati;","ja473:2.3":"Cakkhūni cassa [cakkhūnissa (syā. ka.)] na dadāti,","ja473:2.4":"paṭilomañca vattati.","ja473:3.1":"Amitte tassa bhajati,","ja473:3.2":"mitte tassa na sevati;","ja473:3.3":"Vaṇṇakāme nivāreti,","ja473:3.4":"akkosante pasaṃsati.","ja473:4.1":"Guyhañca tassa nakkhāti,","ja473:4.2":"tassa guyhaṃ na gūhati;","ja473:4.3":"Kammaṃ tassa na vaṇṇeti,","ja473:4.4":"paññassa nappasaṃsati.","ja473:5.1":"Abhave nandati tassa,","ja473:5.2":"bhave tassa na nandati;","ja473:5.3":"Accheraṃ [acchariyaṃ (sī. syā. pī.)] bhojanaṃ laddhā,","ja473:5.4":"tassa nuppajjate sati;","ja473:5.5":"Tato naṃ nānukampati,","ja473:5.6":"aho sopi [ahāsopi (ka. sī. syā. ka.)] labheyyito.","ja473:6.1":"Iccete soḷasākārā,","ja473:6.2":"amittasmiṃ patiṭṭhitā;","ja473:6.3":"Yehi amittaṃ jāneyya,","ja473:6.4":"disvā sutvā ca paṇḍito.","ja473:7.1":"Kāni kammāni kubbānaṃ,","ja473:7.2":"kathaṃ viññū parakkame;","ja473:7.3":"Mittaṃ jāneyya medhāvī,","ja473:7.4":"disvā sutvā ca paṇḍito.","ja473:8.1":"Pavutthaṃ tassa sarati,","ja473:8.2":"āgataṃ abhinandati;","ja473:8.3":"Tato kelāyito hoti,","ja473:8.4":"vācāya paṭinandati.","ja473:9.1":"Mitte tasseva bhajati,","ja473:9.2":"amitte tassa na sevati;","ja473:9.3":"Akkosante nivāreti,","ja473:9.4":"vaṇṇakāme pasaṃsati.","ja473:10.1":"Guyhañca tassa akkhāti,","ja473:10.2":"tassa guyhañca gūhati;","ja473:10.3":"Kammañca tassa vaṇṇeti,","ja473:10.4":"paññaṃ tassa [paññamassa (syā. ka.)] pasaṃsati.","ja473:11.1":"Bhave ca nandati tassa [bhave nandati tassa ca (ka.)],","ja473:11.2":"abhave tassa na nandati;","ja473:11.3":"Accheraṃ [acchariyaṃ (sī. syā. pī.)] bhojanaṃ laddhā,","ja473:11.4":"tassa uppajjate sati;","ja473:11.5":"Tato naṃ anukampati,","ja473:11.6":"aho sopi [pahāsopi (ka. sī. syā. ka.)] labheyyito.","ja473:12.1":"Iccete soḷasākārā,","ja473:12.2":"mittasmiṃ suppatiṭṭhitā;","ja473:12.3":"Yehi mittañca jāneyya [mittaṃ sujāneyya (pī. ka.)],","ja473:12.4":"disvā sutvā ca paṇḍitoti.","ja473:13.1":"Mittāmittajātakaṃ dasamaṃ.","ja473:14.1":"Dvādasakanipātaṃ niṭṭhitaṃ.","ja473:15.1":"Tassuddānaṃ –","ja473:16.1":"Lahucitta sasāla kasanti puna,","ja473:16.2":"atha kāma dasakhaluṭṭhānavaro;","ja473:16.3":"Atha kaṇha sukosiya meṇḍavaro,","ja473:16.4":"padumo puna mittavarena dasāti."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-iv","bookName":"Jātaka-aṭṭhakathā-4","vriCode":"s0513a4.att","from":1828,"to":1828,"paras":[{"para":1828,"vripara":null,"refs":["ja473:12"],"lines":["Tattha <b>na naṃ umhayate disvā</b>ti taṃ mittaṃ mittapatirūpako disvā sitaṃ na karoti, pahaṭṭhākāraṃ na dasseti.","<b>Na ca naṃ paṭinandatī</b>ti tassa kathaṃ paggaṇhanto na paṭinandati na tussati.","<b>Cakkhūni cassa na dadātī</b>ti olokentaṃ na oloketi.","<b>Paṭilomañcā</b>ti tassa kathaṃ paṭippharati paṭisattu hoti.","<b>Vaṇṇakāme</b>ti tassa vaṇṇaṃ bhaṇante.","<b>Nakkhātī</b>ti attano guyhaṃ tassa na ācikkhati.","<b>Kammaṃ tassā</b>ti tena katakammaṃ na vaṇṇayati.","<b>Paññassā</b>ti assa paññaṃ nappasaṃsati, ñāṇasampadaṃ na pasaṃsati.","<b>Abhave</b>ti avaḍḍhiyaṃ.","<b>Tassa nuppajjate satī</b>ti tassa mittapatirūpakassa “mama mittassapi ito dassāmī”ti sati na uppajjati.","<b>Nānukampatī</b>ti muducittena na cinteti.","<b>Labheyyito</b>ti labheyya ito.","<b>Ākārā</b>ti kāraṇāni.","<b>Pavutthan</b>ti videsagataṃ.","<b>Kelāyito</b>ti kelāyati mamāyati pattheti piheti icchatīti attho.","<b>Vācāyā</b>ti madhuravacanena taṃ samudācaranto paṭinandati tussati.","Sesaṃ vuttapaṭipakkhanayena veditabbaṃ.","Rājā mahāsattassa kathāya attamano hutvā tassa mahantaṃ yasaṃ adāsi."],"lineRefs":[["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"],["ja473:12"]]}],"wordLinks":[["ja473:12.1","ākārā",0,12]],"after":[{"para":1829,"vripara":null,"title":"[473] 10. Mittāmittajātakavaṇṇanā","lines":["Satthā imaṃ dhammadesanaṃ āharitvā “evaṃ, mahārāja, pubbepesa pañho samuṭṭhahi, paṇḍitāva naṃ kathayiṃsu, imehi dvattiṃsāya ākārehi mittāmitto jānitabbo”ti vatvā jātakaṃ samodhānesi –","“tadā rājā ānando ahosi, paṇḍitāmacco pana ahameva ahosin”ti."]},{"para":1830,"vripara":null,"title":"[473] 10. Mittāmittajātakavaṇṇanā","lines":["Mittāmittajātakavaṇṇanā dasamā."]},{"para":1831,"vripara":null,"title":"[473] 10. Mittāmittajātakavaṇṇanā","lines":["Jātakuddānaṃ –"]},{"para":1832,"vripara":null,"title":"[473] 10. Mittāmittajātakavaṇṇanā","lines":["Kuṇālaṃ bhaddasālañca, samuddavāṇija paṇḍitaṃ;"]},{"para":1833,"vripara":null,"title":"[473] 10. Mittāmittajātakavaṇṇanā","lines":["Janasandhaṃ mahākaṇhaṃ, kosiyaṃ sirimantakaṃ."]},{"para":1834,"vripara":null,"title":"[473] 10. Mittāmittajātakavaṇṇanā","lines":["Padumaṃ mittāmittañca, iccete dasa jātake;"]},{"para":1835,"vripara":null,"title":"[473] 10. Mittāmittajātakavaṇṇanā","lines":["Saṅgāyiṃsu mahātherā, dvādasamhi nipātake."]},{"para":1836,"vripara":null,"title":"[473] 10. Mittāmittajātakavaṇṇanā","lines":["Dvādasakanipātavaṇṇanā niṭṭhitā."]}]},"tika":null,"tika2":null}
