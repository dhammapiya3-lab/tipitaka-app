{"suttaId":"an4.155","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[1230,1230],"vripara":"155"},"segments":{"an4.155:0.3":"Paṭisaṅkhānabalasuttaṃ","an4.155:1.1":"“Cattārimāni, bhikkhave, balāni.","an4.155:1.2":"Katamāni cattāri?","an4.155:1.3":"Paṭisaṅkhānabalaṃ, bhāvanābalaṃ, anavajjabalaṃ, saṅgahabalaṃ – imāni kho, bhikkhave, cattāri balānī”ti.","an4.155:1.5":"Pañcamaṃ."},"attha":null,"tika":null}
