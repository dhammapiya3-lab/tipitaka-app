{"suttaId":"tha-ap193","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7223,7239],"vripara":"1"},"segments":{"tha-ap193:0.3":"Tamālapupphiyattheraapadānaṃ","tha-ap193:1.1":"“Cullāsītisahassāni, thambhā sovaṇṇayā ahū;","tha-ap193:1.3":"Devalaṭṭhipaṭibhāgaṃ, vimānaṃ me sunimmitaṃ.","tha-ap193:2.1":"“Tamālapupphaṃ paggayha, vippasannena cetasā;","tha-ap193:2.3":"Buddhassa abhiropayiṃ, sikhino lokabandhuno.","tha-ap193:3.1":"“Ekattiṃse ito kappe, yaṃ kammamakariṃ tadā;","tha-ap193:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap193:4.1":"“Ito vīsatime kappe, candatittoti ekako;","tha-ap193:4.3":"Sattaratanasampanno, cakkavattī mahabbalo.","tha-ap193:5.1":"“Paṭisambhidā catasso, vimokkhāpi ca aṭṭhime;","tha-ap193:5.3":"Chaḷabhiññā sacchikatā, kataṃ buddhassa sāsanaṃ”.","tha-ap193:6.1":"Itthaṃ sudaṃ āyasmā tamālapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap193:7.1":"Tamālapupphiyattherassāpadānaṃ paṭhamaṃ."},"attha":null,"tika":null}
