{"suttaId":"tha-ap193","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7223,7239],"vripara":"1"},"segments":{"tha-ap193:0.3":"Tamālapupphiyattheraapadānaṃ","tha-ap193:1.1":"“Cullāsītisahassāni,","tha-ap193:1.2":"thambhā sovaṇṇayā ahū;","tha-ap193:1.3":"Devalaṭṭhipaṭibhāgaṃ,","tha-ap193:1.4":"vimānaṃ me sunimmitaṃ. 2.","tha-ap193:2.1":"“Tamālapupphaṃ paggayha,","tha-ap193:2.2":"vippasannena cetasā;","tha-ap193:2.3":"Buddhassa abhiropayiṃ,","tha-ap193:2.4":"sikhino lokabandhuno. 3.","tha-ap193:3.1":"“Ekattiṃse ito kappe,","tha-ap193:3.2":"yaṃ kammamakariṃ tadā;","tha-ap193:3.3":"Duggatiṃ nābhijānāmi,","tha-ap193:3.4":"buddhapūjāyidaṃ phalaṃ. 4.","tha-ap193:4.1":"“Ito vīsatime kappe,","tha-ap193:4.2":"candatittoti ekako;","tha-ap193:4.3":"Sattaratanasampanno,","tha-ap193:4.4":"cakkavattī mahabbalo. 5.","tha-ap193:5.1":"“Paṭisambhidā catasso,","tha-ap193:5.2":"vimokkhāpi ca aṭṭhime;","tha-ap193:5.3":"Chaḷabhiññā sacchikatā,","tha-ap193:5.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap193:6.1":"Itthaṃ sudaṃ āyasmā tamālapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap193:7.1":"Tamālapupphiyattherassāpadānaṃ paṭhamaṃ. 2."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
