{"suttaId":"pv7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[127,160],"vripara":"35"},"segments":{"pv7:0.3":"Sattaputtakhādapetivatthu","pv7:1.1":"“Naggā dubbaṇṇarūpāsi, duggandhā pūti vāyasi;","pv7:1.3":"Makkhikāhi parikiṇṇā, kā nu tvaṃ idha tiṭṭhasī”ti.","pv7:2.1":"“Ahaṃ bhadante petīmhi, duggatā yamalokikā;","pv7:2.3":"Pāpakammaṃ karitvāna, petalokaṃ ito gatā.","pv7:3.1":"“Kālena satta puttāni, sāyaṃ satta punāpare;","pv7:3.3":"Vijāyitvāna khādāmi, tepi nā honti me alaṃ.","pv7:4.1":"“Pariḍayhati dhūmāyati, khudāya hadayaṃ mama;","pv7:4.3":"Nibbutiṃ nādhigacchāmi, aggidaḍḍhāva ātape”ti.","pv7:5.1":"“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;","pv7:5.3":"Kissa kammavipākena, puttamaṃsāni khādasī”ti.","pv7:6.1":"“Ahū mayhaṃ duve puttā, ubho sampattayobbanā;","pv7:6.3":"Sāhaṃ puttabalūpetā, sāmikaṃ atimaññisaṃ.","pv7:7.1":"“Tato me sāmiko kuddho, sapattiṃ mayhamānayi;","pv7:7.3":"Sā ca gabbhaṃ alabhittha, tassā pāpaṃ acetayiṃ.","pv7:8.1":"“Sāhaṃ paduṭṭhamanasā, akariṃ gabbhapātanaṃ;","pv7:8.3":"Tassā temāsiko gabbho, pubbalohitako [pubbalohitako (ka.)] pati.","pv7:9.1":"“Tadassā mātā kupitā, mayhaṃ ñātī samānayi;","pv7:9.3":"Sapathañca maṃ kāresi, paribhāsāpayī ca maṃ.","pv7:10.1":"“Sāhaṃ ghorañca sapathaṃ, musāvādaṃ abhāsisaṃ;","pv7:10.3":"‘Puttamaṃsāni khādāmi, sace taṃ pakataṃ mayā’.","pv7:11.1":"“Tassa kammassa vipākena, musāvādassa cūbhayaṃ;","pv7:11.3":"Puttamaṃsāni khādāmi, pubbalohitamakkhitā”ti.","pv7:12.1":"Sattaputtakhādapetivatthu sattamaṃ."},"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":263,"to":287,"paras":[{"para":263,"vripara":"38","refs":["pv7:4"],"words":["nibbutiṃ","nādhigacchāmī","aggidaḍḍhāva ātape"],"lines":["Tattha <b>nibbutin</b>ti khuppipāsādukkhassa vūpasamaṃ.","<b>Nādhigacchāmī</b>ti na labhāmi.","<b>Aggidaḍḍhāva ātape</b>ti atiuṇhaātape agginā ḍayhamānā viya nibbutiṃ nādhigacchāmīti yojanā."],"lineRefs":[["pv7:4"],["pv7:4"],["pv7:4"]]},{"para":264,"vripara":null,"refs":[],"words":[],"lines":["Taṃ sutvā mahāthero tāya katakammaṃ pucchanto –"],"lineRefs":[[]]},{"para":266,"vripara":"39","refs":[],"words":[],"lines":["“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;"],"lineRefs":[[]]},{"para":267,"vripara":null,"refs":[],"words":[],"lines":["Kissakammavipākena, puttamaṃsāni khādasī”ti.","– gāthamāha;"],"lineRefs":[[],[]]},{"para":268,"vripara":null,"refs":[],"words":[],"lines":["Atha sā petī attano petalokūpapattiñca puttamaṃsakhādanakāraṇañca kathentī –"],"lineRefs":[[]]},{"para":270,"vripara":"40","refs":[],"words":[],"lines":["“Ahū mayhaṃ duve puttā, ubho sampattayobbanā;"],"lineRefs":[[]]},{"para":271,"vripara":null,"refs":[],"words":[],"lines":["Sāhaṃ puttabalūpetā, sāmikaṃ atimaññisaṃ."],"lineRefs":[[]]},{"para":273,"vripara":"41","refs":[],"words":[],"lines":["“Tato me sāmiko kuddho, sapatiṃ mayhamānayi;"],"lineRefs":[[]]},{"para":274,"vripara":null,"refs":[],"words":[],"lines":["Sā ca gabbhaṃ alabhittha, tassā pāpaṃ acetayiṃ."],"lineRefs":[[]]},{"para":276,"vripara":"42","refs":[],"words":[],"lines":["“Sāhaṃ paduṭṭhamanasā, akariṃ gabbhapātanaṃ;"],"lineRefs":[[]]},{"para":277,"vripara":null,"refs":[],"words":[],"lines":["Tassa temāsiko gabbho, pūtilohitako pati."],"lineRefs":[[]]},{"para":279,"vripara":"43","refs":[],"words":[],"lines":["“Tadassā mātā kupitā, mayhaṃ ñātī samānayi;"],"lineRefs":[[]]},{"para":280,"vripara":null,"refs":[],"words":[],"lines":["Sapathañca maṃ kāresi, paribhāsāpayī ca maṃ."],"lineRefs":[[]]},{"para":282,"vripara":"44","refs":[],"words":[],"lines":["“Sāhaṃ ghorañca sapathaṃ, musāvādaṃ abhāsisaṃ;"],"lineRefs":[[]]},{"para":283,"vripara":null,"refs":[],"words":[],"lines":["‘Puttamaṃsāni khādāmi, sace taṃ pakataṃ mayā’."],"lineRefs":[[]]},{"para":285,"vripara":"45","refs":[],"words":[],"lines":["“Tassa kammassa vipākena, musāvādassa cūbhayaṃ;"],"lineRefs":[[]]},{"para":286,"vripara":null,"refs":[],"words":[],"lines":["Puttamaṃsāni khādāmi, pubbalohitamakkhitā”ti.","– imā gāthā abhāsi;"],"lineRefs":[[],[]]},{"para":287,"vripara":"40-45","refs":["pv7:6"],"words":["puttabalūpetā","atimaññisaṃ"],"lines":["40-45. Tattha <b>puttabalūpetā</b>ti puttabalena upetā, puttānaṃ vasena laddhabalā.","<b>Atimaññisan</b>ti atikkamitvā maññiṃ avamaññiṃ.","<b>Pūtilohitako patī</b>ti kuṇapalohitaṃ hutvā gabbho paripati.","Sesaṃ sabbaṃ anantarasadisameva.","Tattha aṭṭha therā, idha sambahulā.","Tattha pañca puttā, idha sattāti ayameva visesoti."],"lineRefs":[["pv7:6"],["pv7:6"],["pv7:6"],["pv7:6"],["pv7:6"],["pv7:6"]]}]},"tika":null}
