{"suttaId":"pv7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Pv","vriCode":"s0507m.mul","paras":[127,160],"vripara":"35"},"segments":{"pv7:0.3":"Sattaputtakhādapetivatthu","pv7:1.1":"“Naggā dubbaṇṇarūpāsi,","pv7:1.2":"duggandhā pūti vāyasi;","pv7:1.3":"Makkhikāhi parikiṇṇā,","pv7:1.4":"kā nu tvaṃ idha tiṭṭhasī”ti.","pv7:2.1":"“Ahaṃ bhadante petīmhi,","pv7:2.2":"duggatā yamalokikā;","pv7:2.3":"Pāpakammaṃ karitvāna,","pv7:2.4":"petalokaṃ ito gatā.","pv7:3.1":"“Kālena satta puttāni,","pv7:3.2":"sāyaṃ satta punāpare;","pv7:3.3":"Vijāyitvāna khādāmi,","pv7:3.4":"tepi nā honti me alaṃ.","pv7:4.1":"“Pariḍayhati dhūmāyati,","pv7:4.2":"khudāya hadayaṃ mama;","pv7:4.3":"Nibbutiṃ nādhigacchāmi,","pv7:4.4":"aggidaḍḍhāva ātape”ti.","pv7:5.1":"“Kiṃ nu kāyena vācāya,","pv7:5.2":"manasā dukkaṭaṃ kataṃ;","pv7:5.3":"Kissa kammavipākena,","pv7:5.4":"puttamaṃsāni khādasī”ti.","pv7:6.1":"“Ahū mayhaṃ duve puttā,","pv7:6.2":"ubho sampattayobbanā;","pv7:6.3":"Sāhaṃ puttabalūpetā,","pv7:6.4":"sāmikaṃ atimaññisaṃ.","pv7:7.1":"“Tato me sāmiko kuddho,","pv7:7.2":"sapattiṃ mayhamānayi;","pv7:7.3":"Sā ca gabbhaṃ alabhittha,","pv7:7.4":"tassā pāpaṃ acetayiṃ.","pv7:8.1":"“Sāhaṃ paduṭṭhamanasā,","pv7:8.2":"akariṃ gabbhapātanaṃ;","pv7:8.3":"Tassā temāsiko gabbho, pubbalohitako [pubbalohitako (ka.)] pati.","pv7:9.1":"“Tadassā mātā kupitā,","pv7:9.2":"mayhaṃ ñātī samānayi;","pv7:9.3":"Sapathañca maṃ kāresi,","pv7:9.4":"paribhāsāpayī ca maṃ.","pv7:10.1":"“Sāhaṃ ghorañca sapathaṃ,","pv7:10.2":"musāvādaṃ abhāsisaṃ;","pv7:10.3":"‘Puttamaṃsāni khādāmi,","pv7:10.4":"sace taṃ pakataṃ mayā’.","pv7:11.1":"“Tassa kammassa vipākena,","pv7:11.2":"musāvādassa cūbhayaṃ;","pv7:11.3":"Puttamaṃsāni khādāmi,","pv7:11.4":"pubbalohitamakkhitā”ti.","pv7:12.1":"Sattaputtakhādapetivatthu sattamaṃ."},"unsure":["pv7:8.3"],"preface":[],"attha":{"book":"Pv-a","bookName":"Petavatthu-aṭṭhakathā","vriCode":"s0507a.att","from":263,"to":287,"paras":[{"para":263,"vripara":"38","refs":["pv7:4"],"lines":["Tattha <b>nibbutin</b>ti khuppipāsādukkhassa vūpasamaṃ.","<b>Nādhigacchāmī</b>ti na labhāmi.","<b>Aggidaḍḍhāva ātape</b>ti atiuṇhaātape agginā ḍayhamānā viya nibbutiṃ nādhigacchāmīti yojanā."],"lineRefs":[["pv7:4"],["pv7:4"],["pv7:4"]]},{"para":264,"vripara":null,"refs":["pv7:4"],"lines":["Taṃ sutvā mahāthero tāya katakammaṃ pucchanto –"],"lineRefs":[["pv7:4"]]},{"para":266,"vripara":"39","refs":["pv7:4"],"lines":["“Kiṃ nu kāyena vācāya, manasā dukkaṭaṃ kataṃ;"],"lineRefs":[["pv7:4"]]},{"para":267,"vripara":null,"refs":["pv7:4"],"lines":["Kissakammavipākena, puttamaṃsāni khādasī”ti.","– gāthamāha;"],"lineRefs":[["pv7:4"],["pv7:4"]]},{"para":268,"vripara":null,"refs":["pv7:4"],"lines":["Atha sā petī attano petalokūpapattiñca puttamaṃsakhādanakāraṇañca kathentī –"],"lineRefs":[["pv7:4"]]},{"para":270,"vripara":"40","refs":["pv7:4"],"lines":["“Ahū mayhaṃ duve puttā, ubho sampattayobbanā;"],"lineRefs":[["pv7:4"]]},{"para":271,"vripara":null,"refs":["pv7:4"],"lines":["Sāhaṃ puttabalūpetā, sāmikaṃ atimaññisaṃ."],"lineRefs":[["pv7:4"]]},{"para":273,"vripara":"41","refs":["pv7:4"],"lines":["“Tato me sāmiko kuddho, sapatiṃ mayhamānayi;"],"lineRefs":[["pv7:4"]]},{"para":274,"vripara":null,"refs":["pv7:4"],"lines":["Sā ca gabbhaṃ alabhittha, tassā pāpaṃ acetayiṃ."],"lineRefs":[["pv7:4"]]},{"para":276,"vripara":"42","refs":["pv7:4"],"lines":["“Sāhaṃ paduṭṭhamanasā, akariṃ gabbhapātanaṃ;"],"lineRefs":[["pv7:4"]]},{"para":277,"vripara":null,"refs":["pv7:4"],"lines":["Tassa temāsiko gabbho, pūtilohitako pati."],"lineRefs":[["pv7:4"]]},{"para":279,"vripara":"43","refs":["pv7:4"],"lines":["“Tadassā mātā kupitā, mayhaṃ ñātī samānayi;"],"lineRefs":[["pv7:4"]]},{"para":280,"vripara":null,"refs":["pv7:4"],"lines":["Sapathañca maṃ kāresi, paribhāsāpayī ca maṃ."],"lineRefs":[["pv7:4"]]},{"para":282,"vripara":"44","refs":["pv7:4"],"lines":["“Sāhaṃ ghorañca sapathaṃ, musāvādaṃ abhāsisaṃ;"],"lineRefs":[["pv7:4"]]},{"para":283,"vripara":null,"refs":["pv7:4"],"lines":["‘Puttamaṃsāni khādāmi, sace taṃ pakataṃ mayā’."],"lineRefs":[["pv7:4"]]},{"para":285,"vripara":"45","refs":["pv7:4"],"lines":["“Tassa kammassa vipākena, musāvādassa cūbhayaṃ;"],"lineRefs":[["pv7:4"]]},{"para":286,"vripara":null,"refs":["pv7:4"],"lines":["Puttamaṃsāni khādāmi, pubbalohitamakkhitā”ti.","– imā gāthā abhāsi;"],"lineRefs":[["pv7:4"],["pv7:4"]]},{"para":287,"vripara":"40-45","refs":["pv7:6"],"lines":["40-45. Tattha <b>puttabalūpetā</b>ti puttabalena upetā, puttānaṃ vasena laddhabalā.","<b>Atimaññisan</b>ti atikkamitvā maññiṃ avamaññiṃ.","<b>Pūtilohitako patī</b>ti kuṇapalohitaṃ hutvā gabbho paripati.","Sesaṃ sabbaṃ anantarasadisameva.","Tattha aṭṭha therā, idha sambahulā.","Tattha pañca puttā, idha sattāti ayameva visesoti."],"lineRefs":[["pv7:6"],["pv7:6"],["pv7:6"],["pv7:6"],["pv7:6"],["pv7:6"]]}],"wordLinks":[["pv7:4.3","nibbutiṃ",0,0],["pv7:4.3","nādhigacchāmī",0,1],["pv7:4.3","aggidaḍḍhāva ātape",0,2],["pv7:6.3","puttabalūpetā",17,0],["pv7:6.3","atimaññisaṃ",17,1]],"before":[{"para":247,"vripara":null,"title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["Sattaputtakhādakapetivatthuvaṇṇanā"]},{"para":248,"vripara":null,"title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["<b>Naggā dubbaṇṇarūpāsī</b>ti idaṃ satthari sāvatthiyaṃ viharante sattaputtakhādakapetiṃ ārabbha vuttaṃ.","Sāvatthiyā kira avidūre aññatarasmiṃ gāmake aññatarassa upāsakassa dve puttā ahesuṃ – paṭhamavaye ṭhitā rūpasampannā sīlācārena samannāgatā.","Tesaṃ mātā “puttavatī ahan”ti puttabalena bhattāraṃ atimaññati.","So bhariyāya avamānito nibbinnamānaso aññaṃ kaññaṃ ānesi.","Sā nacirasseva gabbhinī ahosi.","Athassa jeṭṭhabhariyā issāpakatā aññataraṃ vejjaṃ āmisena upalāpetvā tena tassā temāsikaṃ gabbhaṃ pātesi.","Atha sā ñātīhi ca bhattārā ca “tayā imissā gabbho pātito”ti puṭṭhā “nāhaṃ pātemī”ti musā vatvā tehi asaddahantehi “sapathaṃ karohī”ti vuttā “sāyaṃ pātaṃ satta satta putte vijāyitvā puttamaṃsāni khādāmi, niccaṃ duggandhā ca makkhikāparikiṇṇā ca bhaveyyan”ti sapathaṃ akāsi."]},{"para":249,"vripara":null,"title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["Sā aparena samayena kālaṃ katvā tassa gabbhapātanassa musāvādassa ca phaleneva petayoniyaṃ nibbattitvā puttanayena puttamaṃsāni khādantī tasseva gāmassa avidūre vicarati.","Tena ca samayena sambahulā therā gāmakāvāse vutthavassā bhagavantaṃ dassanāya sāvatthiṃ āgacchantā tassa gāmassa avidūre ekasmiṃ padese rattiyaṃ vāsaṃ kappesuṃ.","Atha sā petī tesaṃ therānaṃ attānaṃ dassesi.","Taṃ mahāthero gāthāya pucchi –"]},{"para":251,"vripara":"35","title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["“Naggā dubbaṇṇarūpāsi, duggandhā pūti vāyasi;"]},{"para":252,"vripara":null,"title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["Makkhikāhi parikiṇṇā, kā nu tvaṃ idha tiṭṭhasī”ti."]},{"para":253,"vripara":null,"title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["Sā therena puṭṭhā tīhi gāthāhi paṭivacanaṃ adāsi –"]},{"para":255,"vripara":"36","title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["“Ahaṃ bhadante petīmhi, duggatā yamalokikā;"]},{"para":256,"vripara":null,"title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["Pāpakammaṃ karitvāna, petalokaṃ ito gatā."]},{"para":258,"vripara":"37","title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["“Kālena satta puttāni, sāyaṃ satta punāpare;"]},{"para":259,"vripara":null,"title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["Vijāyitvāna khādāmi, tepi nā honti me alaṃ."]},{"para":261,"vripara":"38","title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["“Pariḍayhati dhūmāyati, khudāya hadayaṃ mama;"]},{"para":262,"vripara":null,"title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["Nibbutiṃ nādhigacchāmi, aggidaḍḍhāva ātape”ti."]}],"after":[{"para":288,"vripara":null,"title":"Sattaputtakhādakapetivatthuvaṇṇanā","lines":["Sattaputtakhādakapetivatthuvaṇṇānā niṭṭhitā."]}]},"tika":null,"tika2":null}
