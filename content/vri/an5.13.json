{"suttaId":"an5.13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[56,56],"vripara":"13"},"segments":{"an5.13:0.3":"Saṃkhittasuttaṃ","an5.13:1.1":"“Pañcimāni, bhikkhave, balāni.","an5.13:1.2":"Katamāni pañca?","an5.13:1.3":"Saddhābalaṃ, vīriyabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ – imāni kho, bhikkhave, pañca balānī”ti.","an5.13:1.5":"Tatiyaṃ."},"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":29,"to":29,"paras":[{"para":29,"vripara":"13","refs":["an5.13:1"],"words":["satibalaṃ","samādhibalaṃ"],"lines":["Tatiye tattha muṭṭhassacce na kampatīti <b>satibalaṃ</b>.","Uddhacce na kampatīti <b>samādhibalaṃ</b>."],"lineRefs":[["an5.13:1"],["an5.13:1"]]}]},"tika":null}
