{"suttaId":"ja249","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[1719,1725],"vripara":"198"},"segments":{"ja249:0.4":"Sālakajātakaṃ (2-10-9)","ja249:1.1":"Ekaputtako bhavissasi,","ja249:1.2":"tvañca no hessasi issaro kule;","ja249:1.3":"Oroha dumasmā sālaka,","ja249:1.4":"ehi dāni gharakaṃ vajemase. 199.","ja249:2.1":"Nanu maṃ suhadayoti [nanu maṃ hadayeti (sī. pī.)] maññasi,","ja249:2.2":"yañca maṃ hanasi veḷuyaṭṭhiyā;","ja249:2.3":"Pakkambavane ramāmase,","ja249:2.4":"gaccha tvaṃ gharakaṃ yathāsukhanti.","ja249:3.1":"Sālakajātakaṃ navamaṃ. 250."},"unsure":[],"preface":[],"attha":{"book":"Ja-a-ii","bookName":"Jātaka-aṭṭhakathā-2","vriCode":"s0513a2.att","from":1744,"to":1749,"paras":[{"para":1744,"vripara":null,"refs":["ja249:1"],"lines":["Tassattho – tvaṃ mayhaṃ ekaputtako bhavissasi, kule ca me bhogānaṃ issaro, etamhā rukkhā otara, ehi amhākaṃ gharaṃ gamissāma.","<b>Sālakā</b>ti nāmena ālapanto āha."],"lineRefs":[["ja249:1"],["ja249:1"]]},{"para":1745,"vripara":null,"refs":["ja249:1"],"lines":["Taṃ sutvā makkaṭo dutiyaṃ gāthamāha – 199."],"lineRefs":[["ja249:1"]]},{"para":1747,"vripara":"199","refs":["ja249:1"],"lines":["“Nanu maṃ suhadayoti maññasi, yañca maṃ hanasi veḷuyaṭṭhiyā;"],"lineRefs":[["ja249:1"]]},{"para":1748,"vripara":null,"refs":["ja249:1"],"lines":["Pakkambavane ramāmase, gaccha tvaṃ gharakaṃ yathāsukha”nti."],"lineRefs":[["ja249:1"]]},{"para":1749,"vripara":null,"refs":["ja249:2"],"lines":["Tattha <b>nanu maṃ suhadayoti maññasī</b>ti nanu tvaṃ maṃ “suhadayo”ti maññasi, “suhadayo aya”nti maññasīti attho.","<b>Yañca maṃ hanasi veḷuyaṭṭhiyā</b>ti yaṃ maṃ evaṃ atimaññasi, yañca veḷupesikāya hanasi, tenāhaṃ nāgacchāmīti dīpeti.","Atha naṃ “mayaṃ imasmiṃ <b>pakkambavane ramāmase, gaccha tvaṃ gharakaṃ yathāsukha”</b>nti vatvā uppatitvā vanaṃ pāvisi.","Ahituṇḍikopi anattamano attano gehaṃ agamāsi."],"lineRefs":[["ja249:2"],["ja249:2"],["ja249:2"],["ja249:2"]]}],"wordLinks":[["ja249:1.3","sālakā",0,1],["ja249:2.1","nanu maṃ suhadayoti maññasī",4,0],["ja249:2.1","yañca maṃ hanasi veḷuyaṭṭhiyā",4,1],["ja249:2.3","pakkambavane ramāmase gaccha tvaṃ gharakaṃ yathāsukhaṃ",4,2]]},"tika":{"book":"Ja-ṭ-ii","bookName":"Jātaka-abhinavaṭīkā-2","vriCode":"","from":966,"to":968,"paras":[{"para":966,"vripara":null,"refs":["ja249:1"],"lines":["9-sālakajātakavaṇṇanā (249)"],"lineRefs":[["ja249:1"]]},{"para":967,"vripara":null,"refs":["ja249:1"],"lines":["<b>upalāpetī</b>ti catūhi paccayehi upalāpeti.","attano vasaṃ anuvattāpeti.","<b>suhadayo</b>ti anupanāhādivasena sundaramano.","<b>ahituṇḍiko</b>ti ahituṇḍena kīḷanako.","<b>dhaññāpaṇato</b>ti dhaññassa vikkiṇanaṭṭhānato.","<b>veḷupesikāyā</b>ti veḷukhaṇḍenāti."],"lineRefs":[["ja249:1"],["ja249:1"],["ja249:1"],["ja249:1"],["ja249:1"],["ja249:1"]]},{"para":968,"vripara":null,"refs":["ja249:1"],"lines":["ending sālakajātakavaṇṇanā niṭṭhitā."],"lineRefs":[["ja249:1"]]}],"wordLinks":[]},"tika2":null}
