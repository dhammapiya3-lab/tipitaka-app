{"suttaId":"tha-ap220","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[7725,7746],"vripara":"37"},"segments":{"tha-ap220:0.3":"Akkantasaññakattheraapadānaṃ","tha-ap220:1.1":"“Kusāṭakaṃ gahetvāna,","tha-ap220:1.2":"upajjhāyassahaṃ pure;","tha-ap220:1.3":"Mantañca anusikkhāmi,","tha-ap220:1.4":"ganthādosassa [kaṇḍabhedassa (sī.), gaṇḍabhedassa (syā.)] pattiyā. 38.","tha-ap220:2.1":"“Addasaṃ virajaṃ buddhaṃ,","tha-ap220:2.2":"āhutīnaṃ paṭiggahaṃ;","tha-ap220:2.3":"Usabhaṃ pavaraṃ aggaṃ,","tha-ap220:2.4":"tissaṃ buddhaṃ gaṇuttamaṃ [gajuttamaṃ (syā.)]. 39.","tha-ap220:3.1":"“Kusāṭakaṃ pattharitaṃ,","tha-ap220:3.2":"akkamantaṃ naruttamaṃ;","tha-ap220:3.3":"Samuggataṃ mahāvīraṃ,","tha-ap220:3.4":"lokajeṭṭhaṃ narāsabhaṃ. 40.","tha-ap220:4.1":"“Disvā taṃ lokapajjotaṃ,","tha-ap220:4.2":"vimalaṃ candasannibhaṃ;","tha-ap220:4.3":"Avandiṃ satthuno pāde,","tha-ap220:4.4":"vippasannena cetasā. 41.","tha-ap220:5.1":"“Catunnavutito kappe,","tha-ap220:5.2":"yaṃ adāsiṃ kusāṭakaṃ;","tha-ap220:5.3":"Duggatiṃ nābhijānāmi,","tha-ap220:5.4":"kusāṭakassidaṃ phalaṃ. 42.","tha-ap220:6.1":"“Sattatiṃse ito kappe,","tha-ap220:6.2":"eko āsiṃ janādhipo;","tha-ap220:6.3":"Sunando nāma nāmena,","tha-ap220:6.4":"cakkavattī mahabbalo. 43.","tha-ap220:7.1":"“Paṭisambhidā catasso…pe…","tha-ap220:7.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap220:8.1":"Itthaṃ sudaṃ āyasmā akkantasaññako thero imā gāthāyo abhāsitthāti;","tha-ap220:9.1":"Akkantasaññakattherassāpadānaṃ aṭṭhamaṃ. 9."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
