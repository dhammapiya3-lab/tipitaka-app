{"suttaId":"sn28.7","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1234,1234],"vripara":"338"},"segments":{"sn28.7:0.3":"Ākiñcaññāyatanasuttaṃ","sn28.7:1.1":"Sāvatthinidānaṃ.","sn28.7:1.2":"Atha kho āyasmā sāriputto … pe …“idhāhaṃ, āvuso, sabbaso viññāṇañcāyatanaṃ samatikkamma, natthi kiñcīti ākiñcaññāyatanaṃ upasampajja viharāmi … pe … vuṭṭhitoti vā”ti.","sn28.7:1.5":"Sattamaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":459,"to":460,"paras":[{"para":459,"vripara":"332-340","refs":["sn28.7:1"],"lines":["332-340. Sāriputtasaṃyuttassa paṭhame <b>na evaṃ hotī</b>ti ahaṅkāramamaṅkārānaṃ pahīnattā evaṃ na hoti.","Dutiyādīsupi eseva nayo.","Paṭhamādīni."],"lineRefs":[["sn28.7:1"],["sn28.7:1"],["sn28.7:1"]]},{"para":460,"vripara":null,"refs":["sn28.7:1"],"lines":["Sucimukhīsuttavaṇṇanā"],"lineRefs":[["sn28.7:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":483,"to":485,"paras":[{"para":483,"vripara":"332-340","refs":["sn28.7:1"],"lines":["332-340. <b>Na evaṃ hotī</b>ti ettha “ahaṃ samāpajjāmī”ti vā,“ahaṃ samāpanno”ti vā mā hotu tadā tādisābhogābhāvato.","“Ahaṃ vuṭṭhito”ti pana kasmā na hotīti?","Sabbathāpi na hotveva ahaṅkārassa sabbaso pahīnattā."],"lineRefs":[["sn28.7:1"],["sn28.7:1"],["sn28.7:1"]]},{"para":484,"vripara":null,"refs":[],"lines":["Vivekajasuttādivaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":485,"vripara":null,"refs":["sn28.7:1"],"lines":["Sūcimukhīsuttavaṇṇanā"],"lineRefs":[["sn28.7:1"]]}],"wordLinks":[]},"tika2":null}
