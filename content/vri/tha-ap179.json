{"suttaId":"tha-ap179","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[6938,6951],"vripara":"30"},"segments":{"tha-ap179:0.3":"Ekadīpiyattheraapadānaṃ","tha-ap179:1.1":"“Padumuttarassa munino, saḷale bodhimuttame;","tha-ap179:1.3":"Pasannacitto sumano, ekadīpaṃ adāsahaṃ.","tha-ap179:2.1":"“Bhave nibbattamānamhi, nibbatte puññasañcaye;","tha-ap179:2.3":"Duggatiṃ nābhijānāmi, dīpadānassidaṃ phalaṃ.","tha-ap179:3.1":"“Soḷase kappasahasse, ito te caturo janā;","tha-ap179:3.3":"Candābhā nāma nāmena, cakkavattī mahabbalā.","tha-ap179:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap179:5.1":"Itthaṃ sudaṃ āyasmā ekadīpiyo thero imā gāthāyo abhāsitthāti.","tha-ap179:6.1":"Ekadīpiyattherassāpadānaṃ sattamaṃ.","tha-ap179:6.2":"Navamaṃ bhāṇavāraṃ."},"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3148,"to":3148,"paras":[{"para":3148,"vripara":"30","refs":["tha-ap179:1"],"lines":["So aparabhāge attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>padumuttarassa munino</b>tiādimāha.","Taṃ sabbaṃ uttānatthamevāti."],"lineRefs":[["tha-ap179:1"],["tha-ap179:1"]]}],"wordLinks":[["tha-ap179:1.1","padumuttarassa munino",0,0]]},"tika":null}
