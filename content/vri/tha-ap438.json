{"suttaId":"tha-ap438","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[693,707],"vripara":"50"},"segments":{"tha-ap438:0.3":"Kaḷambadāyakattheraapadānaṃ","tha-ap438:1.1":"“Romaso nāma sambuddho,","tha-ap438:1.2":"vasate pabbatantare;","tha-ap438:1.3":"Kaḷambaṃ tassa pādāsiṃ,","tha-ap438:1.4":"pasanno sehi pāṇibhi.","tha-ap438:2.1":"“Catunnavutito kappe,","tha-ap438:2.2":"yaṃ dānamadadiṃ tadā;","tha-ap438:2.3":"Duggatiṃ nābhijānāmi,","tha-ap438:2.4":"kaḷambassa idaṃ phalaṃ.","tha-ap438:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap438:3.3":"viharāmi anāsavo.","tha-ap438:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap438:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap438:5.1":"“Paṭisambhidā catasso … pe …","tha-ap438:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap438:6.1":"Itthaṃ sudaṃ āyasmā kaḷambadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap438:7.1":"Kaḷambadāyakattherassāpadānaṃ chaṭṭhaṃ."},"unsure":[],"attha":null,"tika":null,"tika2":null}
