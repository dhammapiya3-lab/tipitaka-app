{"suttaId":"tha-ap438","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[693,707],"vripara":"50"},"segments":{"tha-ap438:0.3":"Kaḷambadāyakattheraapadānaṃ","tha-ap438:1.1":"“Romaso nāma sambuddho, vasate pabbatantare;","tha-ap438:1.3":"Kaḷambaṃ tassa pādāsiṃ, pasanno sehi pāṇibhi.","tha-ap438:2.1":"“Catunnavutito kappe, yaṃ dānamadadiṃ tadā;","tha-ap438:2.3":"Duggatiṃ nābhijānāmi, kaḷambassa idaṃ phalaṃ.","tha-ap438:3.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap438:4.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap438:5.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap438:6.1":"Itthaṃ sudaṃ āyasmā kaḷambadāyako thero imā gāthāyo Abhāsitthāti.","tha-ap438:7.1":"Kaḷambadāyakattherassāpadānaṃ chaṭṭhaṃ."},"attha":null,"tika":null,"tika2":null}
