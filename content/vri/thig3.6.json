{"suttaId":"thig3.6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Thī","vriCode":"s0509m.mul","paras":[245,254],"vripara":"54"},"segments":{"thig3.6:0.3":"Sukkātherīgāthā","thig3.6:1.1":"“Kiṃme katā rājagahe manussā, madhuṃ pītāva [madhupītāva (sī.)] acchare;","thig3.6:1.3":"Ye sukkaṃ na upāsanti, desentiṃ buddhasāsanaṃ.","thig3.6:2.1":"“Tañca appaṭivānīyaṃ, asecanakamojavaṃ;","thig3.6:2.3":"Pivanti maññe sappaññā, valāhakamivaddhagū.","thig3.6:3.1":"“Sukkā sukkehi dhammehi, vītarāgā samāhitā;","thig3.6:3.3":"Dhāreti antimaṃ dehaṃ, jetvā māraṃ savāhanan”ti.","thig3.6:4.1":"… Sukkā therī …."},"attha":{"book":"Thī-a","bookName":"Therīgāthā-aṭṭhakathā","vriCode":"s0509a.att","from":856,"to":861,"paras":[{"para":856,"vripara":null,"refs":["thig3.6:2"],"lines":["<b>Tañca appaṭivānīyan</b>ti tañca pana dhammaṃ anivattitabhāvāvahaṃ niyyānikaṃ, abhikkantatāya vā yathā sotujanasavanamanoharabhāvena anapanīyaṃ, <b>asecanakaṃ</b> anāsittakaṃ pakatiyāva mahārasaṃ tato eva ojavantaṃ.","“Osadhan” tipi pāḷi.","Vaṭṭadukkhabyādhitikicchāya osadhabhūtaṃ.","<b>Pivanti maññe sappaññā, valāhakamivaddhagū</b>ti valāhakantarato nikkhantaṃ udakaṃ nirudakakantāre pathagā viya taṃ dhammaṃ sappaññā paṇḍitapurisā pivanti maññe pivantā viya suṇanti."],"lineRefs":[["thig3.6:2"],["thig3.6:2"],["thig3.6:2"],["thig3.6:2"]]},{"para":857,"vripara":null,"refs":["thig3.6:2"],"lines":["Manussā taṃ sutvā pasannamānasā theriyā santikaṃ upasaṅkamitvā sakkaccaṃ dhammaṃ suṇiṃsu.","Aparabhāge theriyā āyupariyosāne parinibbānakāle sāsanassa niyyānikabhāvavibhāvanatthaṃ aññaṃ byākarontī –"],"lineRefs":[["thig3.6:2"],["thig3.6:2"]]},{"para":859,"vripara":"56","refs":["thig3.6:2"],"lines":["“Sukkā sukkehi dhammehi, vītarāgā samāhitā;"],"lineRefs":[["thig3.6:2"]]},{"para":860,"vripara":null,"refs":["thig3.6:2"],"lines":["Dhāreti antimaṃ dehaṃ, jetvā māraṃ savāhanan”ti.","– imaṃ gāthaṃ abhāsi;"],"lineRefs":[["thig3.6:2"],["thig3.6:2"]]},{"para":861,"vripara":null,"refs":["thig3.6:3"],"lines":["Tattha <b>sukkā</b>ti sukkātherī attānameva paraṃ viya dasseti.","<b>Sukkehi dhammehī</b>ti suparisuddhehi lokuttaradhammehi.","<b>Vītarāgā samāhitā</b>ti aggamaggena sabbaso vītarāgā arahattaphalasamādhinā samāhitā.","Sesaṃ vuttanayameva."],"lineRefs":[["thig3.6:3"],["thig3.6:3"],["thig3.6:3"],["thig3.6:3"]]}],"wordLinks":[["thig3.6:2.1","asecanakaṃ",0,0],["thig3.6:2.1","tañca appaṭivānīyaṃ",0,0],["thig3.6:2.3","pivanti maññe sappaññā valāhakamivaddhagū",0,3],["thig3.6:3.1","sukkā",4,0],["thig3.6:3.1","sukkehi dhammehī",4,1],["thig3.6:3.1","vītarāgā samāhitā",4,2]],"before":[{"para":784,"vripara":null,"refs":[],"lines":["Ubbiritherīgāthāvaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":785,"vripara":null,"refs":[],"lines":["Sukkātherīgāthāvaṇṇanā"],"lineRefs":[[]]},{"para":786,"vripara":null,"refs":[],"lines":["<b>Kiṃme katā rājagahe</b>tiādikā sukkāya theriyā gāthā.","Ayampi purimabuddhesu katādhikārā tattha tattha bhave vivaṭṭūpanissayaṃ kusalaṃ upacinantī vipassissa bhagavato kāle bandhumatīnagare kulagehe nibbattitvā viññutaṃ pattā upāsikāhi saddhiṃ vihāraṃ gantvā satthu santike dhammaṃ sutvā paṭiladdhasaddhā pabbajitvā bahussutā dhammadharā paṭibhānavatī ahosi.","Sā tattha bahūni vassasahassāni brahmacariyaṃ caritvā puthujjanakālakiriyameva katvā tusite nibbatti.","Tathā sikhissa bhagavato, vessabhussa bhagavato kāleti evaṃ tiṇṇaṃ sammāsambuddhānaṃ sāsane sīlaṃ rakkhitvā bahussutā dhammadharā ahosi, tathā kakusandhassa, koṇāgamanassa, kassapassa ca bhagavato sāsane pabbajitvā visuddhasīlā bahussutā dhammakathikā ahosi."],"lineRefs":[[],[],[],[]]},{"para":787,"vripara":null,"refs":[],"lines":["Evaṃ sā tattha tattha bahuṃ puññaṃ upacinitvā sugatīsuyeva saṃsarantī imasmiṃ buddhuppāde rājagahanagare gahapatimahāsālakule nibbatti, <b>sukkā</b>tissā nāmaṃ ahosi.","Sā viññutaṃ pattā satthu rājagahapavesane laddhappasādā upāsikā hutvā aparabhāge dhammadinnāya theriyā santike dhammaṃ sutvā sañjātasaṃvegā tassā eva santike pabbajitvā vipassanāya kammaṃ karontī nacirasseva saha paṭisambhidāhi arahattaṃ pāpuṇi.","Tena vuttaṃ <b>apadāne</b> (apa. therī 2.4.111-142)–"],"lineRefs":[[],[],[]]},{"para":788,"vripara":null,"refs":[],"lines":["“Ekanavutito kappe, vipassī nāma nāyako;"],"lineRefs":[[]]},{"para":789,"vripara":null,"refs":[],"lines":["Uppajji cārudassano, sabbadhammavipassako."],"lineRefs":[[]]},{"para":790,"vripara":null,"refs":[],"lines":["“Tadāhaṃ bandhumatiyaṃ, jātā aññatare kule;"],"lineRefs":[[]]},{"para":791,"vripara":null,"refs":[],"lines":["Dhammaṃ sutvāna munino, pabbajiṃ anagāriyaṃ."],"lineRefs":[[]]},{"para":792,"vripara":null,"refs":[],"lines":["“Bahussutā dhammadharā, paṭibhānavatī tathā;"],"lineRefs":[[]]},{"para":793,"vripara":null,"refs":[],"lines":["Vicittakathikā cāpi, jinasāsanakārikā."],"lineRefs":[[]]},{"para":794,"vripara":null,"refs":[],"lines":["“Tadā dhammakathaṃ katvā, hitāya janataṃ bahuṃ;"],"lineRefs":[[]]},{"para":795,"vripara":null,"refs":[],"lines":["Tato cutāhaṃ tusitaṃ, upapannā yasassinī."],"lineRefs":[[]]},{"para":796,"vripara":null,"refs":[],"lines":["“Ekattiṃse ito kappe, sikhī viya sikhī jino;"],"lineRefs":[[]]},{"para":797,"vripara":null,"refs":[],"lines":["Tapanto yasasā loke, uppajji vadataṃ varo."],"lineRefs":[[]]},{"para":798,"vripara":null,"refs":[],"lines":["“Tadāpi pabbajitvāna, buddhasāsanakovidā;"],"lineRefs":[[]]},{"para":799,"vripara":null,"refs":[],"lines":["Jotetvā jinavākyāni, tatopi tidivaṃ gatā."],"lineRefs":[[]]},{"para":800,"vripara":null,"refs":[],"lines":["“Ekattiṃseva kappamhi, vessabhū nāma nāyako;"],"lineRefs":[[]]},{"para":801,"vripara":null,"refs":[],"lines":["Uppajjittha mahāñāṇī, tadāpi ca tathevahaṃ."],"lineRefs":[[]]},{"para":802,"vripara":null,"refs":[],"lines":["“Pabbajitvā dhammadharā, jotayiṃ jinasāsanaṃ;"],"lineRefs":[[]]},{"para":803,"vripara":null,"refs":[],"lines":["Gantvā marupuraṃ rammaṃ, anubhosiṃ mahāsukhaṃ."],"lineRefs":[[]]},{"para":804,"vripara":null,"refs":[],"lines":["“Imamhi bhaddake kappe, kakusandho jinuttamo;"],"lineRefs":[[]]},{"para":805,"vripara":null,"refs":[],"lines":["Uppajji narasaraṇo, tadāpi ca tathevahaṃ."],"lineRefs":[[]]},{"para":806,"vripara":null,"refs":[],"lines":["“Pabbajitvā munimataṃ, jotayitvā yathāyukaṃ;"],"lineRefs":[[]]},{"para":807,"vripara":null,"refs":[],"lines":["Tato cutāhaṃ tidivaṃ, agaṃ sabhavanaṃ yathā."],"lineRefs":[[]]},{"para":808,"vripara":null,"refs":[],"lines":["“Imasmiṃyeva kappamhi, koṇāgamananāyako;"],"lineRefs":[[]]},{"para":809,"vripara":null,"refs":[],"lines":["Uppajji lokasaraṇo, araṇo amataṅgato."],"lineRefs":[[]]},{"para":810,"vripara":null,"refs":[],"lines":["“Tadāpi pabbajitvāna, sāsane tassa tādino;"],"lineRefs":[[]]},{"para":811,"vripara":null,"refs":[],"lines":["Bahussutā dhammadharā, jotayiṃ jinasāsanaṃ."],"lineRefs":[[]]},{"para":812,"vripara":null,"refs":[],"lines":["“Imasmiṃyeva kappamhi, kassapo munimuttamo;"],"lineRefs":[[]]},{"para":813,"vripara":null,"refs":[],"lines":["Uppajji lokasaraṇo, araṇo maraṇantagū."],"lineRefs":[[]]},{"para":814,"vripara":null,"refs":[],"lines":["“Tassāpi naravīrassa, pabbajitvāna sāsane;"],"lineRefs":[[]]},{"para":815,"vripara":null,"refs":[],"lines":["Pariyāpuṭasaddhammā, paripucchā visāradā."],"lineRefs":[[]]},{"para":816,"vripara":null,"refs":[],"lines":["“Susīlā lajjinī ceva, tīsu sikkhāsu kovidā;"],"lineRefs":[[]]},{"para":817,"vripara":null,"refs":[],"lines":["Bahuṃ dhammakathaṃ katvā, yāvajīvaṃ mahāmune."],"lineRefs":[[]]},{"para":818,"vripara":null,"refs":[],"lines":["“Tena kammavipākena, cetanāpaṇidhīhi ca;"],"lineRefs":[[]]},{"para":819,"vripara":null,"refs":[],"lines":["Jahitvā mānusaṃ dehaṃ, tāvatiṃsamagacchahaṃ."],"lineRefs":[[]]},{"para":820,"vripara":null,"refs":[],"lines":["“Pacchime ca bhave dāni, giribbajapuruttame;"],"lineRefs":[[]]},{"para":821,"vripara":null,"refs":[],"lines":["Jātā seṭṭhikule phīte, mahāratanasañcaye."],"lineRefs":[[]]},{"para":822,"vripara":null,"refs":[],"lines":["“Yadā bhikkhusahassena, parivuto lokanāyako;"],"lineRefs":[[]]},{"para":823,"vripara":null,"refs":[],"lines":["Upāgami rājagahaṃ, sahassakkhena vaṇṇito."],"lineRefs":[[]]},{"para":824,"vripara":null,"refs":[],"lines":["“Danto dantehi saha purāṇajaṭilehi, vippamutto vippamuttehi;"],"lineRefs":[[]]},{"para":825,"vripara":null,"refs":[],"lines":["Siṅgīnikkhasavaṇṇo, rājagahaṃ pāvisi bhagavā."],"lineRefs":[[]]},{"para":826,"vripara":null,"refs":[],"lines":["“Disvā buddhānubhāvaṃ taṃ, sutvāva guṇasañcayaṃ;"],"lineRefs":[[]]},{"para":827,"vripara":null,"refs":[],"lines":["Buddhe cittaṃ pasādetvā, pūjayiṃ taṃ yathābalaṃ."],"lineRefs":[[]]},{"para":828,"vripara":null,"refs":[],"lines":["“Aparena ca kālena, dhammadinnāya santike;"],"lineRefs":[[]]},{"para":829,"vripara":null,"refs":[],"lines":["Agārā nikkhamitvāna, pabbajiṃ anagāriyaṃ."],"lineRefs":[[]]},{"para":830,"vripara":null,"refs":[],"lines":["“Kesesu chijjamānesu, kilese jhāpayiṃ ahaṃ;"],"lineRefs":[[]]},{"para":831,"vripara":null,"refs":[],"lines":["Uggahiṃ sāsanaṃ sabbaṃ, pabbajitvā cirenahaṃ."],"lineRefs":[[]]},{"para":832,"vripara":null,"refs":[],"lines":["“Tato dhammamadesesiṃ, mahājanasamāgame;"],"lineRefs":[[]]},{"para":833,"vripara":null,"refs":[],"lines":["Dhamme desiyamānamhi, dhammābhisamayo ahu."],"lineRefs":[[]]},{"para":834,"vripara":null,"refs":[],"lines":["“Nekapāṇasahassānaṃ, taṃ viditvātivimhito;"],"lineRefs":[[]]},{"para":835,"vripara":null,"refs":[],"lines":["Abhippasanno me yakkho, bhamitvāna giribbajaṃ."],"lineRefs":[[]]},{"para":836,"vripara":null,"refs":[],"lines":["“Kiṃme katā rājagahe manussā, madhuṃ pītāva acchare;"],"lineRefs":[[]]},{"para":837,"vripara":null,"refs":[],"lines":["Ye sukkaṃ na upāsanti, desentiṃ amataṃ padaṃ."],"lineRefs":[[]]},{"para":838,"vripara":null,"refs":[],"lines":["“Tañca appaṭivānīyaṃ, asecanakamojavaṃ;"],"lineRefs":[[]]},{"para":839,"vripara":null,"refs":[],"lines":["Pivanti maññe sappaññā, valāhakamivaddhagū."],"lineRefs":[[]]},{"para":840,"vripara":null,"refs":[],"lines":["“Iddhīsu ca vasī homi, dibbāya sotadhātuyā;"],"lineRefs":[[]]},{"para":841,"vripara":null,"refs":[],"lines":["Cetopariyañāṇassa, vasī homi mahāmune."],"lineRefs":[[]]},{"para":842,"vripara":null,"refs":[],"lines":["“Pubbenivāsaṃ jānāmi, dibbacakkhu visodhitaṃ;"],"lineRefs":[[]]},{"para":843,"vripara":null,"refs":[],"lines":["Sabbāsavaparikkhīṇā, natthi dāni punabbhavo."],"lineRefs":[[]]},{"para":844,"vripara":null,"refs":[],"lines":["“Atthadhammaniruttīsu, paṭibhāne tatheva ca;"],"lineRefs":[[]]},{"para":845,"vripara":null,"refs":[],"lines":["Ñāṇaṃ mama mahāvīra, uppannaṃ tava santike."],"lineRefs":[[]]},{"para":846,"vripara":null,"refs":[],"lines":["“Kilesā jhāpitā mayhaṃ … pe … kataṃ buddhassa sāsanan”ti."],"lineRefs":[[]]},{"para":847,"vripara":null,"refs":[],"lines":["Arahattaṃ pana patvā pañcasatabhikkhuniparivārā mahādhammakathikā ahosi.","Sā ekadivasaṃ rājagahe piṇḍāya caritvā katabhattakiccā bhikkhunupassayaṃ pavisitvā sannisinnāya mahatiyā parisāya madhubhaṇḍaṃ pīḷetvā sumadhuraṃ pāyentī viya amatena abhisiñcantī viya dhammaṃ deseti.","Parisā cassā dhammakathaṃ ohitasotā avikkhittacittā sakkaccaṃ suṇāti.","Tasmiṃ khaṇe theriyā caṅkamanakoṭiyaṃ rukkhe adhivatthā devatā dhammadesanāya pasannā rājagahaṃ pavisitvā rathiyāya rathiyaṃ siṅghāṭakena siṅghāṭakaṃ vicaritvā tassā guṇaṃ vibhāventī –"],"lineRefs":[[],[],[],[]]},{"para":849,"vripara":"54","refs":[],"lines":["“Kiṃme katā rājagahe manussā, madhuṃ pītāva acchare;"],"lineRefs":[[]]},{"para":850,"vripara":null,"refs":[],"lines":["Ye sukkaṃ na upāsanti, desentiṃ buddhasāsanaṃ."],"lineRefs":[[]]},{"para":852,"vripara":"55","refs":[],"lines":["“Tañca appaṭivānīyaṃ, asecanakamojavaṃ;"],"lineRefs":[[]]},{"para":853,"vripara":null,"refs":[],"lines":["Pivanti maññe sappaññā, valāhakamivaddhagū”ti.","–"],"lineRefs":[[],[]]},{"para":854,"vripara":null,"refs":[],"lines":["Imā dve gāthā abhāsi."],"lineRefs":[[]]},{"para":855,"vripara":null,"refs":[],"lines":["Tattha <b>kiṃme katā rājagahe manussā</b>ti ime rājagahe manussā kiṃ katā, kismiṃ nāma kicce byāvaṭā.","<b>Madhuṃ pītāva acchare</b>ti yathā bhaṇḍamadhuṃ gahetvā madhuṃ pītavanto visaññino hutvā sīsaṃ ukkhipituṃ na sakkonti, evaṃ imepi dhammasaññāya visaññino hutvā maññe sīsaṃ ukkhipituṃ na sakkonti, kevalaṃ acchantiyevāti attho.","<b>Ye sukkaṃ na upāsanti, desentiṃ buddhasāsanan</b>ti buddhassa bhagavato sāsanaṃ yāthāvato desentiṃ pakāsentiṃ sukkaṃ theriṃ ye na upāsanti na payirupāsanti.","Te ime rājagahe manussā kiṃ katāti yojanā."],"lineRefs":[[],[],[],[]]}]},"tika":null,"tika2":null}
