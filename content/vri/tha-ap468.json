{"suttaId":"tha-ap468","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1383,1400],"vripara":"26"},"segments":{"tha-ap468:0.3":"Avaṭaphaliyattheraapadānaṃ","tha-ap468:1.1":"“Sataraṃsī nāma bhagavā, sayambhū aparājito;","tha-ap468:1.3":"Vivekakāmo sambuddho, gocarāyābhinikkhami.","tha-ap468:2.1":"“Phalahattho ahaṃ disvā, upagacchiṃ narāsabhaṃ;","tha-ap468:2.3":"Pasannacitto sumano, adāsiṃ avaṭaṃ phalaṃ.","tha-ap468:3.1":"“Catunnavutito kappe, yaṃ phalaṃ adadiṃ tadā;","tha-ap468:3.3":"Duggatiṃ nābhijānāmi, phaladānassidaṃ phalaṃ.","tha-ap468:4.1":"“Kilesā jhāpitā mayhaṃ … pe … viharāmi anāsavo.","tha-ap468:5.1":"“Svāgataṃ vata me āsi … pe … kataṃ buddhassa sāsanaṃ.","tha-ap468:6.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap468:7.1":"Itthaṃ sudaṃ āyasmā avaṭaphaliyo thero imā gāthāyo Abhāsitthāti.","tha-ap468:8.1":"Avaṭaphaliyattherassāpadānaṃ chaṭṭhaṃ."},"attha":null,"tika":null,"tika2":null}
