{"suttaId":"tha-ap468","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1383,1400],"vripara":"26"},"segments":{"tha-ap468:0.3":"Avaṭaphaliyattheraapadānaṃ","tha-ap468:1.1":"“Sataraṃsī nāma bhagavā,","tha-ap468:1.2":"sayambhū aparājito;","tha-ap468:1.3":"Vivekakāmo sambuddho,","tha-ap468:1.4":"gocarāyābhinikkhami. 27.","tha-ap468:2.1":"“Phalahattho ahaṃ disvā,","tha-ap468:2.2":"upagacchiṃ narāsabhaṃ;","tha-ap468:2.3":"Pasannacitto sumano,","tha-ap468:2.4":"adāsiṃ avaṭaṃ phalaṃ. 28.","tha-ap468:3.1":"“Catunnavutito kappe,","tha-ap468:3.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap468:3.3":"Duggatiṃ nābhijānāmi,","tha-ap468:3.4":"phaladānassidaṃ phalaṃ. 29.","tha-ap468:4.1":"“Kilesā jhāpitā mayhaṃ…pe…","tha-ap468:4.3":"viharāmi anāsavo. 30.","tha-ap468:5.1":"“Svāgataṃ vata me āsi…pe…","tha-ap468:5.3":"kataṃ buddhassa sāsanaṃ. 31.","tha-ap468:6.1":"“Paṭisambhidā catasso…pe…","tha-ap468:6.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap468:7.1":"Itthaṃ sudaṃ āyasmā avaṭaphaliyo thero imā gāthāyo Abhāsitthāti.","tha-ap468:8.1":"Avaṭaphaliyattherassāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
