{"suttaId":"tha-ap534","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[3950,4063],"vripara":"28"},"segments":{"tha-ap534:0.3":"Vakkalittheraapadānaṃ","tha-ap534:1.1":"“Ito satasahassamhi,","tha-ap534:1.2":"kappe uppajji nāyako;","tha-ap534:1.3":"Anomanāmo amito,","tha-ap534:1.4":"nāmena padumuttaro.","tha-ap534:2.1":"“Padumākāravadano,","tha-ap534:2.2":"padumāmalasucchavī;","tha-ap534:2.3":"Lokenānupalittova","tha-ap534:2.4":"toyena padumaṃ yathā.","tha-ap534:3.1":"“Vīro padumapattakkho,","tha-ap534:3.2":"kanto ca padumaṃ yathā;","tha-ap534:3.3":"Padumuttaragandhova,","tha-ap534:3.4":"tasmā so padumuttaro.","tha-ap534:4.1":"“Lokajeṭṭho ca nimmāno,","tha-ap534:4.2":"andhānaṃ nayanūpamo;","tha-ap534:4.3":"Santaveso guṇanidhi,","tha-ap534:4.4":"karuṇāmatisāgaro.","tha-ap534:5.1":"“Sa kadāci mahāvīro,","tha-ap534:5.2":"brahmāsurasuraccito;","tha-ap534:5.3":"Sadevamanujākiṇṇe,","tha-ap534:5.4":"janamajjhe jinuttamo [januttamo (syā. pī.), anuttamo (ka.) vaṅgīsattherāpadānepi].","tha-ap534:6.1":"“Vadanena sugandhena,","tha-ap534:6.2":"madhurena rutena ca;","tha-ap534:6.3":"Rañjayaṃ parisaṃ sabbaṃ,","tha-ap534:6.4":"santhavī sāvakaṃ sakaṃ.","tha-ap534:7.1":"“Saddhādhimutto sumati,","tha-ap534:7.2":"mama dassanalālaso [dassanasālayo (syā.)];","tha-ap534:7.3":"Natthi etādiso añño,","tha-ap534:7.4":"yathāyaṃ bhikkhu vakkali.","tha-ap534:8.1":"“Tadāhaṃ haṃsavatiyaṃ,","tha-ap534:8.2":"nagare brāhmaṇatrajo;","tha-ap534:8.3":"Hutvā sutvā ca taṃ vākyaṃ,","tha-ap534:8.4":"taṃ ṭhānamabhirocayiṃ.","tha-ap534:9.1":"“Sasāvakaṃ taṃ vimalaṃ,","tha-ap534:9.2":"nimantetvā tathāgataṃ;","tha-ap534:9.3":"Sattāhaṃ bhojayitvāna,","tha-ap534:9.4":"dussehacchādayiṃ tadā.","tha-ap534:10.1":"“Nipacca sirasā tassa,","tha-ap534:10.2":"anantaguṇasāgare;","tha-ap534:10.3":"Nimuggo pītisampuṇṇo,","tha-ap534:10.4":"idaṃ vacanamabraviṃ.","tha-ap534:11.1":"“‘Yo so tayā santhavito,","tha-ap534:11.2":"ito sattamake muni [idha saddhādhimutto isi (syā.), ito sattamakehani (sī. pī.)];","tha-ap534:11.3":"Bhikkhu saddhāvataṃ aggo,","tha-ap534:11.4":"tādiso homahaṃ mune’.","tha-ap534:12.1":"“Evaṃ vutte mahāvīro,","tha-ap534:12.2":"anāvaraṇadassano;","tha-ap534:12.3":"Imaṃ vākyaṃ udīresi,","tha-ap534:12.4":"parisāya mahāmuni.","tha-ap534:13.1":"“‘Passathetaṃ māṇavakaṃ,","tha-ap534:13.2":"pītamaṭṭhanivāsanaṃ;","tha-ap534:13.3":"Hemayaññopacitaṅgaṃ [hemayaññopavītaṅgaṃ (sī.)],","tha-ap534:13.4":"jananettamanoharaṃ.","tha-ap534:14.1":"“‘Eso anāgataddhāne,","tha-ap534:14.2":"gotamassa mahesino;","tha-ap534:14.3":"Aggo saddhādhimuttānaṃ,","tha-ap534:14.4":"sāvakoyaṃ bhavissati.","tha-ap534:15.1":"“‘Devabhūto manusso vā,","tha-ap534:15.2":"sabbasantāpavajjito;","tha-ap534:15.3":"Sabbabhogaparibyūḷho,","tha-ap534:15.4":"sukhito saṃsarissati.","tha-ap534:16.1":"“‘Satasahassito kappe,","tha-ap534:16.2":"okkākakulasambhavo;","tha-ap534:16.3":"Gotamo nāma gottena,","tha-ap534:16.4":"satthā loke bhavissati.","tha-ap534:17.1":"“‘Tassa dhammesu dāyādo,","tha-ap534:17.2":"oraso dhammanimmito;","tha-ap534:17.3":"Vakkali nāma nāmena,","tha-ap534:17.4":"hessati satthu sāvako’.","tha-ap534:18.1":"“Tena kammavisesena,","tha-ap534:18.2":"cetanāpaṇidhīhi ca;","tha-ap534:18.3":"Jahitvā mānusaṃ dehaṃ,","tha-ap534:18.4":"tāvatiṃsamagacchahaṃ.","tha-ap534:19.1":"“Sabbattha sukhito hutvā,","tha-ap534:19.2":"saṃsaranto bhavābhave;","tha-ap534:19.3":"Sāvatthiyaṃ pure jāto,","tha-ap534:19.4":"kule aññatare ahaṃ.","tha-ap534:20.1":"“Nonītasukhumālaṃ maṃ,","tha-ap534:20.2":"jātapallavakomalaṃ;","tha-ap534:20.3":"Mandaṃ uttānasayanaṃ,","tha-ap534:20.4":"pisācabhayatajjitā.","tha-ap534:21.1":"“Pādamūle mahesissa,","tha-ap534:21.2":"sāyesuṃ dīnamānasā;","tha-ap534:21.3":"Imaṃ dadāma te nātha,","tha-ap534:21.4":"saraṇaṃ hohi nāyaka.","tha-ap534:22.1":"“Tadā paṭiggahi so maṃ,","tha-ap534:22.2":"bhītānaṃ saraṇo muni;","tha-ap534:22.3":"Jālinā cakkaṅkitena [saṅkalaṅkena (sī.)],","tha-ap534:22.4":"mudukomalapāṇinā.","tha-ap534:23.1":"“Tadā pabhuti tenāhaṃ,","tha-ap534:23.2":"arakkheyyena rakkhito;","tha-ap534:23.3":"Sabbaveravinimutto [sabbabyādhivinimutto (syā.), sabbūpadhivinimutto (pī.)],","tha-ap534:23.4":"sukhena parivuddhito.","tha-ap534:24.1":"“Sugatena vinā bhūto,","tha-ap534:24.2":"ukkaṇṭhāmi muhuttakaṃ;","tha-ap534:24.3":"Jātiyā sattavassohaṃ,","tha-ap534:24.4":"pabbajiṃ anagāriyaṃ.","tha-ap534:25.1":"“Sabbapāramisambhūtaṃ,","tha-ap534:25.2":"nīlakkhinayanaṃ [laṅkinīlayanaṃ (sī.)] varaṃ;","tha-ap534:25.3":"Rūpaṃ sabbasubhākiṇṇaṃ,","tha-ap534:25.4":"atitto viharāmahaṃ [vihayāmahaṃ (sī. pī.)].","tha-ap534:26.1":"“Buddharūparatiṃ [buddho rūparatiṃ (sī.)] ñatvā,","tha-ap534:26.2":"tadā ovadi maṃ jino;","tha-ap534:26.3":"‘Alaṃ vakkali kiṃ rūpe,","tha-ap534:26.4":"ramase bālanandite.","tha-ap534:27.1":"“‘Yo hi passati saddhammaṃ,","tha-ap534:27.2":"so maṃ passati paṇḍito;","tha-ap534:27.3":"Apassamāno saddhammaṃ,","tha-ap534:27.4":"maṃ passampi na passati.","tha-ap534:28.1":"“‘Anantādīnavo kāyo,","tha-ap534:28.2":"visarukkhasamūpamo;","tha-ap534:28.3":"Āvāso sabbarogānaṃ,","tha-ap534:28.4":"puñjo dukkhassa kevalo.","tha-ap534:29.1":"“‘Nibbindiya tato rūpe,","tha-ap534:29.2":"khandhānaṃ udayabbayaṃ;","tha-ap534:29.3":"Passa upakkilesānaṃ,","tha-ap534:29.4":"sukhenantaṃ gamissati’.","tha-ap534:30.1":"“Evaṃ tenānusiṭṭhohaṃ,","tha-ap534:30.2":"nāyakena hitesinā;","tha-ap534:30.3":"Gijjhakūṭaṃ samāruyha,","tha-ap534:30.4":"jhāyāmi girikandare.","tha-ap534:31.1":"“Ṭhito pabbatapādamhi,","tha-ap534:31.2":"assāsayi [mamāhaso (sī.)] mahāmuni;","tha-ap534:31.3":"Vakkalīti jino vācaṃ,","tha-ap534:31.4":"taṃ sutvā mudito ahaṃ.","tha-ap534:32.1":"“Pakkhandiṃ selapabbhāre,","tha-ap534:32.2":"anekasataporise;","tha-ap534:32.3":"Tadā buddhānubhāvena,","tha-ap534:32.4":"sukheneva mahiṃ gato.","tha-ap534:33.1":"“Punopi [punāpi (syā.), muni maṃ (ka.)] dhammaṃ deseti,","tha-ap534:33.2":"khandhānaṃ udayabbayaṃ;","tha-ap534:33.3":"Tamahaṃ dhammamaññāya,","tha-ap534:33.4":"arahattamapāpuṇiṃ.","tha-ap534:34.1":"“Sumahāparisamajjhe,","tha-ap534:34.2":"tadā maṃ caraṇantago;","tha-ap534:34.3":"Aggaṃ saddhādhimuttānaṃ,","tha-ap534:34.4":"paññapesi mahāmati.","tha-ap534:35.1":"“Satasahassito kappe,","tha-ap534:35.2":"yaṃ kammamakariṃ tadā;","tha-ap534:35.3":"Duggatiṃ nābhijānāmi,","tha-ap534:35.4":"buddhapūjāyidaṃ phalaṃ.","tha-ap534:36.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap534:36.3":"viharāmi anāsavo.","tha-ap534:37.1":"“Svāgataṃ vata me āsi … pe …","tha-ap534:37.3":"kataṃ buddhassa sāsanaṃ.","tha-ap534:38.1":"“Paṭisambhidā catasso … pe …","tha-ap534:38.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap534:39.1":"Itthaṃ sudaṃ āyasmā vakkalitthero imā gāthāyo Abhāsitthāti.","tha-ap534:40.1":"Vakkalittherassāpadānaṃ dutiyaṃ."},"unsure":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":3395,"to":3407,"paras":[{"para":3395,"vripara":"28","refs":["tha-ap534:1"],"lines":["So arahattaṃ patvā attano pubbakammaṃ saritvā somanassajāto pubbacaritāpadānaṃ pakāsento <b>ito satasahassamhī</b>tiādimāha.","Tattha <b>ito</b>ti kakusandhādīnaṃ uppannabhaddakappato heṭṭhā kappasatasahassamatthaketi attho."],"lineRefs":[["tha-ap534:1"],["tha-ap534:1"]]},{"para":3396,"vripara":"29","refs":["tha-ap534:2"],"lines":["<b>Padumākāravadano</b>ti supupphitapadumasassirīkamukho.","<b>Padumapattakkho</b>ti setapadumapupphapaṇṇasadisaakkhīti attho."],"lineRefs":[["tha-ap534:2"],["tha-ap534:2"]]},{"para":3397,"vripara":"30","refs":["tha-ap534:3"],"lines":["<b>Padumuttaragandhovā</b>ti padumagandhamukhoti attho."],"lineRefs":[["tha-ap534:3"]]},{"para":3398,"vripara":"31","refs":["tha-ap534:4"],"lines":["<b>Andhānaṃ nayanūpamo</b>ti cakkhuvirahitānaṃ sattānaṃ nayanasadiso, dhammadesanāya sabbasattānaṃ paññācakkhādicakkhudāyakoti attho.","<b>Santaveso</b>ti santasabhāvo santairiyāpatho.","<b>Guṇanidhī</b>ti guṇānaṃ nidhi, sabbaguṇagaṇānaṃ nidhānaṭṭhānabhūtoti attho.","<b>Karuṇāmatiākaro</b>ti sādhūnaṃ cittakampanasaṅkhātāya karuṇāya ca atthānatthaminanaparicchinnamatiyā ca ākaro ādhārabhūto."],"lineRefs":[["tha-ap534:4"],["tha-ap534:4"],["tha-ap534:4"],["tha-ap534:4"]]},{"para":3399,"vripara":"32","refs":["tha-ap534:5"],"lines":["<b>Brahmāsurasuraccito</b>ti brahmehi ca asurehi ca devehi ca accito pūjitoti attho."],"lineRefs":[["tha-ap534:5"]]},{"para":3400,"vripara":"33","refs":["tha-ap534:6"],"lines":["<b>Madhurena rutena cā</b>ti karavīkarutamadhurena saddena sakalaṃ janaṃ rañjayantīti sambandho.","<b>Santhavī sāvakaṃ sakan</b>ti attano sāvakaṃ madhuradhammadesanāya santhavī, thutiṃ akāsīti attho."],"lineRefs":[["tha-ap534:6"],["tha-ap534:6"]]},{"para":3401,"vripara":"34","refs":["tha-ap534:7"],"lines":["<b>Saddhādhimutto</b>ti saddahanasaddhāya sāsane adhimutto patiṭṭhitoti attho.","<b>Mama dassanalālaso</b>ti mayhaṃ dassane byāvaṭo tapparo."],"lineRefs":[["tha-ap534:7"],["tha-ap534:7"]]},{"para":3402,"vripara":"35","refs":["tha-ap534:8"],"lines":["<b>Taṃ ṭhānamabhirocayin</b>ti taṃ saddhādhimuttaṭṭhānantaraṃ abhirocayiṃ, icchiṃ patthesinti attho."],"lineRefs":[["tha-ap534:8"]]},{"para":3403,"vripara":"40","refs":["tha-ap534:13"],"lines":["<b>Pītamaṭṭhanivāsanan</b>ti siliṭṭhasuvaṇṇavaṇṇavatthe nivatthanti attho.","<b>Hemayaññopacitaṅgan</b>ti suvaṇṇapāmaṅgalaggitagattanti attho."],"lineRefs":[["tha-ap534:13"],["tha-ap534:13"]]},{"para":3404,"vripara":"47-48","refs":["tha-ap534:20"],"lines":["47-48. <b>Nonītasukhumālaṃ man</b>ti navanītamiva mudutaluṇahatthapādaṃ.","<b>Jātapallavakomalan</b>ti asokapallavapattakomalamiva mudukanti attho.","<b>Pisācībhayatajjitā</b>ti tadā evaṃbhūtaṃ kumāraṃ maṃ aññā pisācī ekā rakkhasī bhayena tajjesi bhiṃsāpesīti attho.","Tadā <b>mahesissa</b> sammāsambuddhassa pādamūle maṃ <b>sāyesuṃ</b> nipajjāpesuṃ.","<b>Dīnamānasā</b> bhītacittā mama mātāpitaro <b>imaṃ</b> dārakaṃ te dadāma, imassa <b>saraṇaṃ</b> patiṭṭhā hotu nātha nāyakāti sambandho."],"lineRefs":[["tha-ap534:20"],["tha-ap534:20"],["tha-ap534:20"],["tha-ap534:20"],["tha-ap534:20"]]},{"para":3405,"vripara":"49","refs":["tha-ap534:22"],"lines":["<b>Tadā paṭiggahi so man</b>ti so bhagavā tadā tasmiṃ mama mātuyā dinnakāle <b>jālinā</b> jālayuttena saṅkhālakena cakkalakkhaṇādīhi lakkhitena <b>mudukomalapāṇinā</b> mudukena visuddhena hatthatalena maṃ aggahesīti attho."],"lineRefs":[["tha-ap534:22"]]},{"para":3406,"vripara":"52","refs":["tha-ap534:25"],"lines":["<b>Sabbapāramisambhūtan</b>ti sabbehi dānapāramitādīhi sambhūtaṃ jātaṃ.","<b>Nīlakkhinayanaṃ varaṃ</b> puññasambhārajaṃ uttamanīlaakkhivantaṃ.","<b>Sabbasubhākiṇṇaṃ</b> sabbena subhena vaṇṇena saṇṭhānena ākiṇṇaṃ gahanībhūtaṃ <b>rūpaṃ</b> bhagavato hatthapādasīsādirūpaṃ disvāti attho, tittiṃ apatto viharāmi ahanti sambandho."],"lineRefs":[["tha-ap534:25"],["tha-ap534:25"],["tha-ap534:25"]]},{"para":3407,"vripara":"61","refs":["tha-ap534:34"],"lines":["<b>Tadā maṃ caraṇantago</b>ti tasmiṃ mayhaṃ arahattaṃ pattakāle sīlādipannarasannaṃ caraṇadhammānaṃ antago, pariyosānappatto paripūrakārīti attho.","“Maraṇantago” tipi pāṭho.","Tassa maraṇassa antaṃ nibbānaṃ pattoti attho.","Saddhādhimuttānaṃ aggaṃ paññapesīti sambandho.","Atha satthā bhikkhusaṅghamajjhe nisinno “etadaggaṃ, bhikkhave, mama sāvakānaṃ saddhādhimuttānaṃ yadidaṃ, vakkalī”ti (a. ni.1.198,208) maṃ etadaggaṭṭhāne ṭhapesīti vuttaṃ hoti.","Sesaṃ suviññeyyamevāti."],"lineRefs":[["tha-ap534:34"],["tha-ap534:34"],["tha-ap534:34"],["tha-ap534:34"],["tha-ap534:34"],["tha-ap534:34"]]}],"wordLinks":[["tha-ap534:1.1","ito satasahassamhī",0,0],["tha-ap534:1.1","ito",0,1],["tha-ap534:1.3","ito",0,1],["tha-ap534:2.1","padumākāravadano",1,0],["tha-ap534:3.3","padumuttaragandhovā",2,0],["tha-ap534:4.1","andhānaṃ nayanūpamo",3,0],["tha-ap534:4.3","santaveso",3,1],["tha-ap534:4.3","guṇanidhī",3,2],["tha-ap534:5.1","brahmāsurasuraccito",4,0],["tha-ap534:6.1","madhurena rutena cā",5,0],["tha-ap534:6.3","santhavī sāvakaṃ sakaṃ",5,1],["tha-ap534:7.1","saddhādhimutto",6,0],["tha-ap534:7.1","mama dassanalālaso",6,1],["tha-ap534:8.3","taṃ ṭhānamabhirocayiṃ",7,0],["tha-ap534:13.1","pītamaṭṭhanivāsanaṃ",8,0],["tha-ap534:13.3","hemayaññopacitaṅgaṃ",8,1],["tha-ap534:20.1","nonītasukhumālaṃ maṃ",9,0],["tha-ap534:20.1","jātapallavakomalaṃ",9,1],["tha-ap534:22.1","tadā paṭiggahi so maṃ",10,0],["tha-ap534:22.3","jālinā",10,0],["tha-ap534:22.3","mudukomalapāṇinā",10,0],["tha-ap534:25.1","sabbapāramisambhūtaṃ",11,0],["tha-ap534:25.1","nīlakkhinayanaṃ varaṃ",11,1],["tha-ap534:25.3","rūpaṃ",11,2],["tha-ap534:25.3","sabbasubhākiṇṇaṃ",11,2],["tha-ap534:34.1","tadā maṃ caraṇantago",12,0]],"before":[{"para":3375,"vripara":null,"refs":[],"lines":["Mahākaccāyanattheraapadānavaṇṇanā samattā."],"lineRefs":[[]]},{"para":3376,"vripara":null,"refs":[],"lines":["Vakkalittheraapadānavaṇṇanā"],"lineRefs":[[]]},{"para":3377,"vripara":null,"refs":[],"lines":["Dutiyāpadāne <b>ito satasahassamhī</b>tiādikaṃ āyasmato vakkalittherassa apadānaṃ.","Ayampi thero purimajinavaresu katādhikāro tattha tattha bhave vivaṭṭūpanissayāni puññāni upacinanto padumuttarassa bhagavato kāle haṃsavatīnagare kulagehe nibbatto viññutaṃ patto satthu santikaṃ gacchantehi upāsakehi saddhiṃ vihāraṃ gantvā parisapariyante ṭhito dhammaṃ suṇanto satthārā ekaṃ bhikkhuṃ saddhādhimuttānaṃ aggaṭṭhāne ṭhapitaṃ disvā sayampi taṃ ṭhānantaraṃ patthento sattāhaṃ buddhappamukhassa bhikkhusaṅghassa mahādānaṃ datvā paṇidhānaṃ akāsi.","Satthā tassa anantarāyaṃ disvā byākari."],"lineRefs":[[],[],[]]},{"para":3378,"vripara":null,"refs":[],"lines":["So yāvajīvaṃ kusalaṃ katvā devamanussesu saṃsaranto amhākaṃ bhagavato kāle sāvatthiyaṃ brāhmaṇakule nibbatti, tassa <b>vakkalī</b>ti nāmaṃ kariṃsu.","Tattha <b>kalī</b>ti aparādhatilakāḷakādidosassa adhivacanaṃ.","Niddhantasuvaṇṇapiṇḍasadisatāya apagato byapagato kali doso assāti va-kārāgamaṃ katvā vakkalīti vuccati.","So vuddhippatto tayo vede uggaṇhitvā brāhmaṇasippesu nipphattiṃ gato, satthāraṃ disvā rūpakāyasampattidassanena atitto satthārā saddhiṃyeva vicarati.","“Agāramajjhe vasanto niccakālaṃ satthu dassanaṃ na labhissāmī”ti satthu santike pabbajitvā ṭhapetvā bhojanakālaṃ sarīrakiccakālañca sesakāle yattha ṭhitena sakkā dasabalaṃ passituṃ, tattha ṭhito aññaṃ kiccaṃ pahāya bhagavantaṃ olokentoyeva viharati.","Satthā tassa ñāṇaparipākaṃ āgamento bahukālaṃ tasmiṃ rūpadassaneneva vicarante kiñci avatvā punekadivasaṃ –","“kiṃ te, vakkali, iminā pūtikāyena diṭṭhena?","Yo kho, vakkali, dhammaṃ passati, so maṃ passati;","yo maṃ passati, so dhammaṃ passati.","Dhammañhi, vakkali, passanto maṃ passatī”ti (saṃ. ni.3.87) āha.","Satthari evaṃ vadantepi thero satthu dassanaṃ pahāya aññattha gantuṃ na sakkoti.","Tato satthā,“nāyaṃ bhikkhu saṃvegaṃ alabhitvā bujjhissatī”ti vassūpanāyikadivase –","“apehi, vakkalī”ti theraṃ paṇāmesi.","So satthārā paṇāmito satthu sammukhe ṭhātuṃ asakkonto –","“kiṃ mayhaṃ jīvitena, yohaṃ satthāraṃ daṭṭhuṃ na labhāmī”ti gijjhakūṭe pabbate papātaṭṭhānaṃ abhiruhi?","Satthā tassa taṃ pavattiṃ ñatvā –","“ayaṃ bhikkhu mama santikā assāsaṃ alabhanto maggaphalānaṃ upanissayaṃ nāseyyā”ti attānaṃ dassetvā obhāsaṃ vissajjento –"],"lineRefs":[[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[]]},{"para":3379,"vripara":null,"refs":[],"lines":["“Pāmojjabahulo bhikkhu, pasanno buddhasāsane;"],"lineRefs":[[]]},{"para":3380,"vripara":null,"refs":[],"lines":["Adhigacche padaṃ santaṃ, saṅkhārūpasamaṃ sukhan”ti.(dha. pa.381)–"],"lineRefs":[[]]},{"para":3381,"vripara":null,"refs":[],"lines":["Gāthaṃ vatvā “ehi, vakkalī”ti (dha. pa. aṭṭha.2.381) hatthaṃ pasāresi.","Thero “dasabalo me diṭṭho,‘ehī’ti avhāyanampi laddhan”ti balavapītisomanassaṃ uppādetvā “kuto gacchāmī”ti attano gamanabhāvaṃ ajānitvāva satthu sammukhe ākāse pakkhanditvā paṭhamena pādena pabbate ṭhitoyeva satthārā vuttagāthāyo āvajjento ākāseyeva pītiṃ vikkhambhetvā saha paṭisambhidāhi arahattaṃ pāpuṇīti aṅguttaraṭṭhakathāyaṃ (a. ni. aṭṭha.1.1.208) dhammapadavaṇṇanāyañca (dha. pa. aṭṭha.2.381 vakkalittheravatthu) āgataṃ."],"lineRefs":[[],[]]},{"para":3382,"vripara":null,"refs":[],"lines":["Idha pana evaṃ veditabbaṃ –","“kiṃ te, vakkalī”tiādinā satthārā ovadito gijjhakūṭe viharanto vipassanaṃ paṭṭhapesi, tassa saddhāya balavabhāvato eva vipassanā vīthiṃ na otarati?","Bhagavā taṃ ñatvā kammaṭṭhānaṃ sodhetvā adāsi.","So puna vipassanaṃ matthakaṃ pāpetuṃ nāsakkhiyeva.","Athassa āhāravekallena vātābādho uppajji, taṃ vātābādhena pīḷiyamānaṃ ñatvā bhagavā tattha gantvā pucchanto –"],"lineRefs":[[],[],[],[],[]]},{"para":3383,"vripara":null,"refs":[],"lines":["“Vātarogābhinīto tvaṃ, viharaṃ kānane vane;"],"lineRefs":[[]]},{"para":3384,"vripara":null,"refs":[],"lines":["Paviddhagocare lūkhe, kathaṃ bhikkhu karissasī”ti.(theragā.350)–"],"lineRefs":[[]]},{"para":3385,"vripara":null,"refs":[],"lines":["Āha.","Taṃ sutvā thero –"],"lineRefs":[[],[]]},{"para":3386,"vripara":null,"refs":[],"lines":["“Pītisukhena vipulena, pharamāno samussayaṃ;"],"lineRefs":[[]]},{"para":3387,"vripara":null,"refs":[],"lines":["Lūkhampi abhisambhonto, viharissāmi kānane."],"lineRefs":[[]]},{"para":3388,"vripara":null,"refs":[],"lines":["“Bhāvento satipaṭṭhāne, indriyāni balāni ca;"],"lineRefs":[[]]},{"para":3389,"vripara":null,"refs":[],"lines":["Bojjhaṅgāni ca bhāvento, viharissāmi kānane."],"lineRefs":[[]]},{"para":3390,"vripara":null,"refs":[],"lines":["“Āraddhavīriye pahitatte, niccaṃ daḷhaparakkame;"],"lineRefs":[[]]},{"para":3391,"vripara":null,"refs":[],"lines":["Samagge sahite disvā, viharissāmi kānane."],"lineRefs":[[]]},{"para":3392,"vripara":null,"refs":[],"lines":["“Anussaranto sambuddhaṃ, aggaṃ dantaṃ samāhitaṃ;"],"lineRefs":[[]]},{"para":3393,"vripara":null,"refs":[],"lines":["Atandito rattindivaṃ, viharissāmi kānane”ti.(theragā.351-354)–"],"lineRefs":[[]]},{"para":3394,"vripara":null,"refs":[],"lines":["Catasso gāthāyo abhāsi.","Tāsaṃ attho theragāthāvaṇṇanāyaṃ (theragā. aṭṭha.2.351-354) vuttoyeva.","Evaṃ thero vipassanaṃ ussukkāpetvā arahattaṃ pāpuṇi."],"lineRefs":[[],[],[]]}]},"tika":null,"tika2":null}
