{"suttaId":"thag2.8","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Th","vriCode":"s0508m.mul","paras":[762,768],"vripara":"135"},"segments":{"thag2.8:0.4":"Surādhattheragāthā","thag2.8:1.1":"“Khīṇā hi mayhaṃ jāti, vusitaṃ jinasāsanaṃ;","thag2.8:1.3":"Pahīno jālasaṅkhāto, bhavanetti samūhatā.","thag2.8:2.1":"“Yassatthāya pabbajito, agārasmānagāriyaṃ;","thag2.8:2.3":"So me attho anuppatto, sabbasaṃyojanakkhayo”ti.","thag2.8:2.5":"… Surādho thero …."},"attha":null,"tika":null}
