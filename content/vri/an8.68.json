{"suttaId":"an8.68","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-viii","vriCode":"s0404m1.mul","paras":[846,846],"vripara":"68"},"segments":{"an8.68:0.3":"Ariyavohārasuttaṃ","an8.68:1.1":"“Aṭṭhime, bhikkhave, ariyavohārā.","an8.68:1.2":"Katame aṭṭha?","an8.68:1.3":"Adiṭṭhe adiṭṭhavāditā, asute asutavāditā, amute amutavāditā, aviññāte aviññātavāditā, diṭṭhe diṭṭhavāditā, sute sutavāditā, mute mutavāditā, viññāte viññātavāditā.","an8.68:1.4":"Ime kho, bhikkhave, aṭṭha ariyavohārā”ti.","an8.68:1.5":"Aṭṭhamaṃ."},"unsure":[],"preface":[],"attha":{"book":"Mp-viii","bookName":"Aṭṭhakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":224,"to":225,"paras":[{"para":224,"vripara":"67-68","refs":["an8.68:1"],"lines":["67-68. Sattame <b>anariyavohārā</b>ti na ariyakathā sadosakathā.","Yāhi cetanāhi te vohāre voharanti, tāsaṃ etaṃ nāmaṃ.","Aṭṭhame vuttapaṭipakkhanayena attho veditabbo."],"lineRefs":[["an8.68:1"],["an8.68:1"],["an8.68:1"]]},{"para":225,"vripara":null,"refs":["an8.68:1"],"lines":["Parisāsuttavaṇṇanā"],"lineRefs":[["an8.68:1"]]}],"wordLinks":[]},"tika":null,"tika2":null}
