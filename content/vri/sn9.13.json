{"suttaId":"sn9.13","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[2975,2985],"vripara":"233"},"segments":{"sn9.13:0.3":"Pākatindriyasuttaṃ","sn9.13:1.1":"Ekaṃ samayaṃ sambahulā bhikkhū kosalesu viharanti aññatarasmiṃ vanasaṇḍe uddhatā unnaḷā capalā mukharā vikiṇṇavācā muṭṭhassatino asampajānā asamāhitā vibbhantacittā pākatindriyā.","sn9.13:1.2":"Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tesaṃ bhikkhūnaṃ anukampikā atthakāmā te bhikkhū saṃvejetukāmā yena te bhikkhū tenupasaṅkami; upasaṅkamitvā te bhikkhū gāthāhi ajjhabhāsi –","sn9.13:2.1":"“Sukhajīvino pure āsuṃ,","sn9.13:2.2":"bhikkhū gotamasāvakā;","sn9.13:2.3":"Anicchā piṇḍamesanā,","sn9.13:2.4":"anicchā sayanāsanaṃ;","sn9.13:2.5":"Loke aniccataṃ ñatvā,","sn9.13:2.6":"dukkhassantaṃ akaṃsu te.","sn9.13:3.1":"“Dupposaṃ katvā attānaṃ,","sn9.13:3.2":"gāme gāmaṇikā viya;","sn9.13:3.3":"Bhutvā bhutvā nipajjanti,","sn9.13:3.4":"parāgāresu mucchitā.","sn9.13:4.1":"“Saṅghassa añjaliṃ katvā,","sn9.13:4.2":"idhekacce vadāmahaṃ;","sn9.13:4.3":"Apaviddhā [apaviṭṭhā (syā. kaṃ.)] anāthā te,","sn9.13:4.4":"yathā petā tatheva te.","sn9.13:5.1":"“Ye kho pamattā viharanti,","sn9.13:5.2":"te me sandhāya bhāsitaṃ;","sn9.13:5.3":"Ye appamattā viharanti,","sn9.13:5.4":"namo tesaṃ karomahan”ti.","sn9.13:6.1":"Atha kho te bhikkhū tāya devatāya saṃvejitā saṃvegamāpādunti."},"unsure":[],"preface":[],"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":1258,"to":1259,"paras":[{"para":1258,"vripara":"233","refs":["sn9.13:1"],"lines":["Terasamaṃ devaputtasaṃyutte jantudevaputtasutte vitthāritameva.","Terasamaṃ."],"lineRefs":[["sn9.13:1"],["sn9.13:1"]]},{"para":1259,"vripara":null,"refs":["sn9.13:1"],"lines":["Gandhatthenasuttavaṇṇanā"],"lineRefs":[["sn9.13:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":1473,"to":1475,"paras":[{"para":1473,"vripara":"233","refs":["sn9.13:1"],"lines":["Terasame yaṃ vattabbaṃ, taṃ vitthāritamevāti yojanā.","<b>Jantudevaputtasutte</b>ti jantudevaputtasuttasaṃvaṇṇanāya.","“Tattha saṅgītaṃ idhāpī”tiādi anantarasuttavaṇṇanāyaṃ vuttanayameva."],"lineRefs":[["sn9.13:1"],["sn9.13:1"],["sn9.13:1"]]},{"para":1474,"vripara":null,"refs":["sn9.13:1"],"lines":["Pākatindriyasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn9.13:1"]]},{"para":1475,"vripara":null,"refs":["sn9.13:1"],"lines":["Gandhatthenasuttavaṇṇanā"],"lineRefs":[["sn9.13:1"]]}],"wordLinks":[],"after":[{"para":1476,"vripara":"234","title":"Gandhatthenasuttavaṇṇanā","lines":["<b>Gandhārammaṇaṃ upanijjhāyatī</b>ti gandhasaṅkhātaṃ ārammaṇaṃ upecca nijjhāyati, rūpārammaṇena viya viññāṇena rūpaṃ, gandhārammaṇena taṃ upecca nijjhāyati paccakkhato, yāthāvato sabhāvato paṭivijjhatīti attho.","<b>Upasiṅghissatī</b>ti taṇhāvasena upagantvā siṅghissati."]}]},"tika2":null}
