{"suttaId":"an5.126","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-v","vriCode":"s0403m1.mul","paras":[866,867],"vripara":"126"},"segments":{"an5.126:0.3":"Dutiyaanāyussāsuttaṃ","an5.126:1.1":"“Pañcime, bhikkhave, dhammā anāyussā.","an5.126:1.2":"Katame pañca?","an5.126:1.3":"Asappāyakārī hoti, sappāye mattaṃ na jānāti, apariṇatabhojī ca hoti, dussīlo ca, pāpamitto ca.","an5.126:1.4":"Ime kho, bhikkhave, pañca dhammā anāyussā.","an5.126:2.1":"“Pañcime, bhikkhave, dhammā āyussā.","an5.126:2.2":"Katame pañca?","an5.126:2.3":"Sappāyakārī hoti, sappāye mattaṃ jānāti, pariṇatabhojī ca hoti, sīlavā ca, kalyāṇamitto ca.","an5.126:2.4":"Ime kho, bhikkhave, pañca dhammā āyussā”ti.","an5.126:2.5":"Chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":{"book":"Mp-v","bookName":"Pañcakanipāta-aṭṭhakathā","vriCode":"s0403a.att","from":260,"to":261,"paras":[{"para":260,"vripara":"125-126","refs":["an5.126:1"],"lines":["Pañcame <b>anāyussā</b>ti āyupacchedanā, na āyuvaḍḍhanā.","Chaṭṭhepi eseva nayo. 7."],"lineRefs":[["an5.126:1"],["an5.126:1"]]},{"para":261,"vripara":null,"refs":["an5.126:1"],"lines":["Vapakāsasuttavaṇṇanā 127."],"lineRefs":[["an5.126:1"]]}],"wordLinks":[]},"tika":{"book":"Mp-t-v","bookName":"Pañcakanipāta-ṭīkā","vriCode":"s0403t.tik","from":248,"to":250,"paras":[{"para":248,"vripara":"124-130","refs":["an5.126:1"],"lines":["Tatiyo vaggo uttānatthoyeva. (14) 4."],"lineRefs":[["an5.126:1"]]},{"para":249,"vripara":null,"refs":["an5.126:1"],"lines":["Rājavaggo 1."],"lineRefs":[["an5.126:1"]]},{"para":250,"vripara":null,"refs":["an5.126:1"],"lines":["Paṭhamacakkānuvattanasuttavaṇṇanā 131."],"lineRefs":[["an5.126:1"]]}],"wordLinks":[]},"tika2":null}
