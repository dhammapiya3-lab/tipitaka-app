{"suttaId":"an10.181","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[1404,1405],"vripara":"181"},"segments":{"an10.181:0.3":"Atthasuttaṃ","an10.181:1.1":"“Atthañca vo, bhikkhave, desessāmi anatthañca.","an10.181:1.2":"Taṃ suṇātha … pe … katamo ca, bhikkhave, anattho?","an10.181:1.4":"Pāṇātipāto … pe … micchādiṭṭhi – ayaṃ vuccati, bhikkhave, anattho.","an10.181:2.1":"“Katamo ca, bhikkhave, attho?","an10.181:2.2":"Pāṇātipātā veramaṇī … pe … sammādiṭṭhi – ayaṃ vuccati, bhikkhave, attho”ti.","an10.181:2.5":"Catutthaṃ."},"attha":null,"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":765,"to":769,"paras":[{"para":765,"vripara":"167-210","refs":["an10.181:1"],"lines":["167-210. Dutiye ca paṭhamādīni uttānatthāni.","Dasame <b>pacchābhūmivāsino</b>ti paccantadesavāsino.","<b>Sevālamālikā</b>ti pātova udakaṃ orohitvā sevālañceva uppalādīni ca gahetvā attano udakasuddhikabhāvajānanatthañceva “lokassa ca udakena suddhi hotī”ti imassa atthassa jānanatthañca mālaṃ katvā pilandhanakā.","<b>Udakorohakā</b>ti pāto majjhanhe sāyanhe ca udakaorohaṇakā.","Tenāha <b>“sāyatatiyakaṃ udakorohaṇānuyogamanuyuttā”</b>ti.","Ekādasamādīni uttānatthāni.","Catutthe paṇṇāsake natthi vattabbaṃ."],"lineRefs":[["an10.181:1"],["an10.181:1"],["an10.181:1"],["an10.181:1"],["an10.181:1"],["an10.181:1"],["an10.181:1"]]},{"para":766,"vripara":null,"refs":["an10.181:1"],"lines":["Brāhmaṇapaccorohaṇīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an10.181:1"]]},{"para":767,"vripara":null,"refs":["an10.181:1"],"lines":["Catutthapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an10.181:1"]]},{"para":768,"vripara":null,"refs":["an10.181:1"],"lines":["(21)1. Karajakāyavaggo"],"lineRefs":[["an10.181:1"]]},{"para":769,"vripara":null,"refs":["an10.181:1"],"lines":["1-536. Paṭhamanirayasaggasuttādivaṇṇanā"],"lineRefs":[["an10.181:1"]]}],"wordLinks":[]},"tika2":null}
