{"suttaId":"an8.85","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-viii","vriCode":"s0404m1.mul","paras":[993,999],"vripara":"85"},"segments":{"an8.85:0.3":"Samaṇasuttaṃ","an8.85:1.1":"“‘Samaṇo’ti, bhikkhave, tathāgatassetaṃ adhivacanaṃ arahato sammāsambuddhassa.","an8.85:1.2":"‘Brāhmaṇo’ti, bhikkhave, tathāgatassetaṃ adhivacanaṃ arahato sammāsambuddhassa.","an8.85:1.3":"‘Vedagū’ti, bhikkhave, tathāgatassetaṃ adhivacanaṃ arahato sammāsambuddhassa.","an8.85:1.4":"‘Bhisakko’ti, bhikkhave, tathāgatassetaṃ adhivacanaṃ arahato sammāsambuddhassa.","an8.85:1.5":"‘Nimmalo’ti, bhikkhave, tathāgatassetaṃ adhivacanaṃ arahato sammāsambuddhassa.","an8.85:1.6":"‘Vimalo’ti, bhikkhave, tathāgatassetaṃ adhivacanaṃ arahato sammāsambuddhassa.","an8.85:1.7":"‘Ñāṇī’ti, bhikkhave, tathāgatassetaṃ adhivacanaṃ arahato sammāsambuddhassa.","an8.85:1.8":"‘Vimutto’ti, bhikkhave, tathāgatassetaṃ adhivacanaṃ arahato sammāsambuddhassā”ti.","an8.85:2.1":"“Yaṃ samaṇena pattabbaṃ,","an8.85:2.2":"brāhmaṇena vusīmatā;","an8.85:2.3":"Yaṃ vedagunā pattabbaṃ,","an8.85:2.4":"bhisakkena anuttaraṃ.","an8.85:3.1":"“Yaṃ nimmalena pattabbaṃ,","an8.85:3.2":"vimalena sucīmatā;","an8.85:3.3":"Yaṃ ñāṇinā ca pattabbaṃ,","an8.85:3.4":"vimuttena anuttaraṃ.","an8.85:4.1":"“Sohaṃ vijitasaṅgāmo,","an8.85:4.2":"mutto mocemi bandhanā;","an8.85:4.3":"Nāgomhi paramadanto,","an8.85:4.4":"asekho parinibbuto”ti.","an8.85:4.5":"pañcamaṃ;"},"unsure":[],"preface":[],"attha":{"book":"Mp-viii","bookName":"Aṭṭhakanipāta-aṭṭhakathā","vriCode":"s0404a.att","from":257,"to":257,"paras":[{"para":257,"vripara":"85","refs":["an8.85:2","an8.85:4"],"lines":["Pañcame <b>yaṃ samaṇenā</b>ti yaṃ guṇajātaṃ samaṇena pattabbaṃ.","<b>Vusīmatā</b>ti brahmacariyavāsaṃvutena.","<b>Mutto mocemi bandhanā</b>ti ahaṃ sabbabandhanehi mutto hutvā mahājanampi rāgādibandhanato mocemi.","<b>Paramadanto</b>ti aññena kenaci asikkhāpito acodito sayambhuñāṇena paṭivijjhitvā paramadamathena dantattā paramadanto nāma.","<b>Parinibbuto</b>ti kilesaparinibbānena parinibbuto."],"lineRefs":[["an8.85:2"],["an8.85:2"],["an8.85:4"],["an8.85:4"],["an8.85:4"]]}],"wordLinks":[["an8.85:2.1","yaṃ samaṇenā",0,0],["an8.85:2.1","vusīmatā",0,1],["an8.85:4.1","mutto mocemi bandhanā",0,2],["an8.85:4.3","paramadanto",0,3],["an8.85:4.3","parinibbuto",0,4]],"before":[{"para":256,"vripara":null,"title":"Samaṇasuttavaṇṇanā","lines":["Samaṇasuttavaṇṇanā"]}]},"tika":null,"tika2":null}
