{"suttaId":"tha-ap305","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9079,9091],"vripara":"9"},"segments":{"tha-ap305:0.3":"Paramannadāyakattheraapadānaṃ","tha-ap305:1.1":"“Kaṇikāraṃva jotantaṃ, udayantaṃva bhāṇumaṃ;","tha-ap305:1.3":"Vipassiṃ addasaṃ buddhaṃ, lokajeṭṭhaṃ narāsabhaṃ.","tha-ap305:2.1":"“Añjaliṃ paggahetvāna, abhinesiṃ sakaṃ gharaṃ;","tha-ap305:2.3":"Abhinetvāna sambuddhaṃ, paramannamadāsahaṃ.","tha-ap305:3.1":"“Ekanavutito kappe, paramannamadiṃ [paramannaṃ dadiṃ (sī.), paramannamadaṃ (syā.)] tadā;","tha-ap305:3.3":"Duggatiṃ nābhijānāmi, paramannassidaṃ phalaṃ.","tha-ap305:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap305:5.1":"Itthaṃ sudaṃ āyasmā paramannadāyako thero imā gāthāyo abhāsitthāti.","tha-ap305:6.1":"Paramannadāyakattherassāpadānaṃ tatiyaṃ."},"attha":null,"tika":null}
