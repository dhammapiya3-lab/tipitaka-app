{"suttaId":"tha-ap6","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[1288,1328],"vripara":"421"},"segments":{"tha-ap6:0.3":"3-4. Anuruddhattheraapadānaṃ","tha-ap6:1.1":"“Sumedhaṃ bhagavantāhaṃ,","tha-ap6:1.2":"lokajeṭṭhaṃ narāsabhaṃ;","tha-ap6:1.3":"Vūpakaṭṭhaṃ viharantaṃ,","tha-ap6:1.4":"addasaṃ lokanāyakaṃ.","tha-ap6:2.1":"“Upagantvāna sambuddhaṃ,","tha-ap6:2.2":"sumedhaṃ lokanāyakaṃ;","tha-ap6:2.3":"Añjaliṃ paggahetvāna,","tha-ap6:2.4":"buddhaseṭṭhamayācahaṃ.","tha-ap6:3.1":"“Anukampa mahāvīra,","tha-ap6:3.2":"lokajeṭṭha narāsabha;","tha-ap6:3.3":"Padīpaṃ te padassāmi,","tha-ap6:3.4":"rukkhamūlamhi jhāyato.","tha-ap6:4.1":"“Adhivāsesi so dhīro,","tha-ap6:4.2":"sayambhū vadataṃ varo;","tha-ap6:4.3":"Dumesu vinivijjhitvā,","tha-ap6:4.4":"yantaṃ yojiyahaṃ tadā.","tha-ap6:5.1":"“Sahassavaṭṭiṃ pādāsiṃ,","tha-ap6:5.2":"buddhassa lokabandhuno;","tha-ap6:5.3":"Sattāhaṃ pajjalitvāna,","tha-ap6:5.4":"dīpā vūpasamiṃsu me.","tha-ap6:6.1":"“Tena cittappasādena,","tha-ap6:6.2":"cetanāpaṇidhīhi ca;","tha-ap6:6.3":"Jahitvā mānusaṃ dehaṃ,","tha-ap6:6.4":"vimānamupapajjahaṃ.","tha-ap6:7.1":"“Upapannassa devattaṃ,","tha-ap6:7.2":"byamhaṃ āsi sunimmitaṃ;","tha-ap6:7.3":"Samantato pajjalati,","tha-ap6:7.4":"dīpadānassidaṃ phalaṃ.","tha-ap6:8.1":"“Samantā yojanasataṃ,","tha-ap6:8.2":"virocesimahaṃ tadā;","tha-ap6:8.3":"Sabbe deve abhibhomi,","tha-ap6:8.4":"dīpadānassidaṃ phalaṃ.","tha-ap6:9.1":"“Tiṃsakappāni devindo,","tha-ap6:9.2":"devarajjamakārayiṃ;","tha-ap6:9.3":"Na maṃ kecītimaññanti,","tha-ap6:9.4":"dīpadānassidaṃ phalaṃ.","tha-ap6:10.1":"“Aṭṭhavīsatikkhattuñca,","tha-ap6:10.2":"cakkavattī ahosahaṃ;","tha-ap6:10.3":"Divā rattiñca passāmi,","tha-ap6:10.4":"samantā yojanaṃ tadā.","tha-ap6:11.1":"“Sahassalokaṃ ñāṇena,","tha-ap6:11.2":"passāmi satthu sāsane;","tha-ap6:11.3":"Dibbacakkhumanuppatto,","tha-ap6:11.4":"dīpadānassidaṃ phalaṃ.","tha-ap6:12.1":"“Sumedho nāma sambuddho,","tha-ap6:12.2":"tiṃsakappasahassito;","tha-ap6:12.3":"Tassa dīpo mayā dinno,","tha-ap6:12.4":"vippasannena cetasā.","tha-ap6:13.1":"“Paṭisambhidā catasso,","tha-ap6:13.2":"vimokkhāpi ca aṭṭhime;","tha-ap6:13.3":"Chaḷabhiññā sacchikatā,","tha-ap6:13.4":"kataṃ buddhassa sāsanaṃ”.","tha-ap6:14.1":"Itthaṃ sudaṃ āyasmā anuruddho thero imā gāthāyo abhāsitthāti.","tha-ap6:15.1":"Anuruddhattherassāpadānaṃ catutthaṃ."},"unsure":[],"preface":[],"attha":{"book":"Ap-a","bookName":"Apadāna-aṭṭhakathā","vriCode":"s0510a.att","from":1904,"to":1907,"paras":[{"para":1904,"vripara":"421","refs":["tha-ap6:1"],"lines":["Evaṃ so bhagavato santikā dibbacakkhukānaṃ aggaṭṭhānaṃ labhitvā attano pubbakammaṃ saritvā somanassavasena pubbacaritāpadānaṃ pakāsento <b>sumedhaṃ bhagavantāhan</b>tiādimāha.","Tattha sundarā upaṭṭhāpanapaññā maggaphalapaññā vipassanāpaññā catupaṭisambhidādisaṅkhātā medhā yassa bhagavato so sumedho, taṃ <b>sumedhaṃ</b> bhāgyasampannattā <b>bhagavantaṃ</b> lokassa <b>jeṭṭhaṃ</b> seṭṭhaṃ padhānabhūtaṃ saṃsārato paṭhamaṃ niggataṃ narānaṃ āsabhaṃ purecārikaṃ <b>vūpakaṭṭhaṃ</b> vivekabhūtaṃ gaṇasaṅgaṇikārāmato apagataṃ viharantaṃ ahaṃ addasanti sambandho."],"lineRefs":[["tha-ap6:1"],["tha-ap6:1"]]},{"para":1905,"vripara":"422","refs":["tha-ap6:1","tha-ap6:2"],"lines":["Sabbadhammānaṃ sayameva buddhattā <b>sambuddhaṃ, upagantvāna</b> samīpaṃ gantvāti attho.","<b>Añjaliṃ paggahetvānā</b>ti dasaṅgulipuṭaṃ muddhani katvāti attho.","Sesaṃ uttānatthameva."],"lineRefs":[["tha-ap6:1"],["tha-ap6:2"],["tha-ap6:2"]]},{"para":1906,"vripara":"430","refs":["tha-ap6:10"],"lines":["<b>Divā rattiñca passāmī</b>ti tadā devaloke ca manussaloke ca uppannakāle maṃsacakkhunā samantato yojanaṃ passāmīti attho."],"lineRefs":[["tha-ap6:10"]]},{"para":1907,"vripara":"431","refs":["tha-ap6:11"],"lines":["<b>Sahassalokaṃ ñāṇenā</b>ti paññācakkhunā sahassacakkavāḷaṃ passāmīti attho.","<b>Satthu sāsane</b>ti idāni gotamassa bhagavato sāsane.","<b>Dīpadānassa</b> dīpapūjāya idaṃ phalaṃ, iminā phalena dibbacakkhuṃ anuppatto paṭiladdho uppādesinti attho."],"lineRefs":[["tha-ap6:11"],["tha-ap6:11"],["tha-ap6:11"]]}],"wordLinks":[["tha-ap6:1.1","sumedhaṃ bhagavantāhaṃ",0,0],["tha-ap6:1.1","jeṭṭhaṃ",0,1],["tha-ap6:1.1","sumedhaṃ",0,1],["tha-ap6:1.3","vūpakaṭṭhaṃ",0,1],["tha-ap6:2.3","añjaliṃ paggahetvānā",1,1],["tha-ap6:10.3","divā rattiñca passāmī",2,0],["tha-ap6:11.1","sahassalokaṃ ñāṇenā",3,0],["tha-ap6:11.1","satthu sāsane",3,1],["tha-ap6:11.3","dīpadānassa",3,2]]},"tika":null,"tika2":null}
