{"suttaId":"tha-ap311","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9193,9205],"vripara":"43"},"segments":{"tha-ap311:0.3":"Buddhasaññakattheraapadānaṃ","tha-ap311:1.1":"“Udentaṃ sataraṃsiṃva, pītaraṃsiṃva bhāṇumaṃ;","tha-ap311:1.3":"Vanantaragataṃ santaṃ, lokajeṭṭhaṃ narāsabhaṃ.","tha-ap311:2.1":"“Addasaṃ supinantena, siddhatthaṃ lokanāyakaṃ;","tha-ap311:2.3":"Tattha cittaṃ pasādetvā, sugatiṃ upapajjahaṃ.","tha-ap311:3.1":"“Catunnavutito kappe, yaṃ saññamalabhiṃ tadā;","tha-ap311:3.3":"Duggatiṃ nābhijānāmi, buddhasaññāyidaṃ phalaṃ.","tha-ap311:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap311:5.1":"Itthaṃ sudaṃ āyasmā buddhasaññako thero imā gāthāyo abhāsitthāti.","tha-ap311:6.1":"Buddhasaññakattherassāpadānaṃ navamaṃ."},"attha":null,"tika":null}
