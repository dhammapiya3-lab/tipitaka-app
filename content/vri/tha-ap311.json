{"suttaId":"tha-ap311","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9193,9205],"vripara":"43"},"segments":{"tha-ap311:0.3":"Buddhasaññakattheraapadānaṃ","tha-ap311:1.1":"“Udentaṃ sataraṃsiṃva,","tha-ap311:1.2":"pītaraṃsiṃva bhāṇumaṃ;","tha-ap311:1.3":"Vanantaragataṃ santaṃ,","tha-ap311:1.4":"lokajeṭṭhaṃ narāsabhaṃ. 44.","tha-ap311:2.1":"“Addasaṃ supinantena,","tha-ap311:2.2":"siddhatthaṃ lokanāyakaṃ;","tha-ap311:2.3":"Tattha cittaṃ pasādetvā,","tha-ap311:2.4":"sugatiṃ upapajjahaṃ. 45.","tha-ap311:3.1":"“Catunnavutito kappe,","tha-ap311:3.2":"yaṃ saññamalabhiṃ tadā;","tha-ap311:3.3":"Duggatiṃ nābhijānāmi,","tha-ap311:3.4":"buddhasaññāyidaṃ phalaṃ. 46.","tha-ap311:4.1":"“Paṭisambhidā catasso…pe…","tha-ap311:4.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap311:5.1":"Itthaṃ sudaṃ āyasmā buddhasaññako thero imā gāthāyo abhāsitthāti.","tha-ap311:6.1":"Buddhasaññakattherassāpadānaṃ navamaṃ. 10."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
