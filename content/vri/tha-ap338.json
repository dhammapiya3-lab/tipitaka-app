{"suttaId":"tha-ap338","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[9942,10004],"vripara":"53"},"segments":{"tha-ap338:0.3":"Pabhaṅkarattheraapadānaṃ","tha-ap338:1.1":"“Padumuttarabhagavato,","tha-ap338:1.2":"lokajeṭṭhassa tādino;","tha-ap338:1.3":"Vipine cetiyaṃ āsi,","tha-ap338:1.4":"vāḷamigasamākule. 54.","tha-ap338:2.1":"“Na koci visahi gantuṃ,","tha-ap338:2.2":"cetiyaṃ abhivandituṃ;","tha-ap338:2.3":"Tiṇakaṭṭhalatonaddhaṃ,","tha-ap338:2.4":"paluggaṃ āsi cetiyaṃ. 55.","tha-ap338:3.1":"“Vanakammiko tadā āsiṃ,","tha-ap338:3.2":"pitumātumatenahaṃ [pitupetāmahenahaṃ (sī.), pitāpetāmahenahaṃ (syā.)];","tha-ap338:3.3":"Addasaṃ vipine thūpaṃ,","tha-ap338:3.4":"luggaṃ tiṇalatākulaṃ. 56.","tha-ap338:4.1":"“Disvānāhaṃ buddhathūpaṃ,","tha-ap338:4.2":"garucittaṃ upaṭṭhahiṃ;","tha-ap338:4.3":"Buddhaseṭṭhassa thūpoyaṃ,","tha-ap338:4.4":"paluggo acchatī vane. 57.","tha-ap338:5.1":"“Nacchannaṃ nappatirūpaṃ,","tha-ap338:5.2":"jānantassa guṇāguṇaṃ;","tha-ap338:5.3":"Buddhathūpaṃ asodhetvā,","tha-ap338:5.4":"aññaṃ kammaṃ payojaye. 58.","tha-ap338:6.1":"“Tiṇakaṭṭhañca valliñca,","tha-ap338:6.2":"sodhayitvāna cetiye;","tha-ap338:6.3":"Vanditvā aṭṭha vārāni [aṭṭha ṭhānāni (ka.)],","tha-ap338:6.4":"paṭikuṭiko agacchahaṃ. 59.","tha-ap338:7.1":"“Tena kammena sukatena,","tha-ap338:7.2":"cetanāpaṇidhīhi ca;","tha-ap338:7.3":"Jahitvā mānusaṃ dehaṃ,","tha-ap338:7.4":"tāvatiṃsamagacchahaṃ. 60.","tha-ap338:8.1":"“Tattha me sukataṃ byamhaṃ,","tha-ap338:8.2":"sovaṇṇaṃ sapabhassaraṃ;","tha-ap338:8.3":"Saṭṭhiyojanamubbiddhaṃ,","tha-ap338:8.4":"tiṃsayojanavitthataṃ. 61.","tha-ap338:9.1":"“Tisatāni ca vārāni,","tha-ap338:9.2":"devarajjamakārayiṃ;","tha-ap338:9.3":"Pañcavīsatikkhattuñca,","tha-ap338:9.4":"cakkavattī ahosahaṃ. 62.","tha-ap338:10.1":"“Bhavābhave saṃsaranto,","tha-ap338:10.2":"mahābhogaṃ labhāmahaṃ;","tha-ap338:10.3":"Bhoge me ūnatā natthi,","tha-ap338:10.4":"sodhanāya idaṃ phalaṃ. 63.","tha-ap338:11.1":"“Sivikā hatthikhandhena,","tha-ap338:11.2":"vipine gacchato mama;","tha-ap338:11.3":"Yaṃ yaṃ disāhaṃ gacchāmi,","tha-ap338:11.4":"saraṇaṃ sampate [sijjhate (ka.)] vanaṃ. 64.","tha-ap338:12.1":"“Khāṇuṃ vā kaṇṭakaṃ vāpi,","tha-ap338:12.2":"nāhaṃ passāmi cakkhunā;","tha-ap338:12.3":"Puññakammena saṃyutto,","tha-ap338:12.4":"sayamevāpanīyare. 65.","tha-ap338:13.1":"“Kuṭṭhaṃ gaṇḍo kilāso ca,","tha-ap338:13.2":"apamāro vitacchikā;","tha-ap338:13.3":"Daddu kacchu [kaṇḍu (syā.)] ca me natthi,","tha-ap338:13.4":"sodhanāya idaṃ phalaṃ. 66.","tha-ap338:14.1":"“Aññampi me acchariyaṃ,","tha-ap338:14.2":"buddhathūpassa sodhane [buddhathūpamhi sodhite (syā.)];","tha-ap338:14.3":"Nābhijānāmi me kāye,","tha-ap338:14.4":"jātaṃ piḷakabindukaṃ. 67.","tha-ap338:15.1":"“Aññampi me acchariyaṃ,","tha-ap338:15.2":"buddhathūpamhi sodhite [sabbatthapi evameva dissati, tathā uparipi];","tha-ap338:15.3":"Duve bhave saṃsarāmi,","tha-ap338:15.4":"devatte atha mānuse. 68.","tha-ap338:16.1":"“Aññampi me acchariyaṃ,","tha-ap338:16.2":"buddhathūpamhi sodhite;","tha-ap338:16.3":"Suvaṇṇavaṇṇo sabbattha,","tha-ap338:16.4":"sappabhāso bhavāmahaṃ. 69.","tha-ap338:17.1":"“Aññampi me acchariyaṃ,","tha-ap338:17.2":"buddhathūpamhi sodhite;","tha-ap338:17.3":"Amanāpaṃ vivajjati,","tha-ap338:17.4":"manāpaṃ upatiṭṭhati. 70.","tha-ap338:18.1":"“Aññampi me acchariyaṃ,","tha-ap338:18.2":"buddhathūpamhi sodhite;","tha-ap338:18.3":"Visuddhaṃ hoti me cittaṃ,","tha-ap338:18.4":"ekaggaṃ susamāhitaṃ. 71.","tha-ap338:19.1":"“Aññampi me acchariyaṃ,","tha-ap338:19.2":"buddhathūpamhi sodhite;","tha-ap338:19.3":"Ekāsane nisīditvā,","tha-ap338:19.4":"arahattamapāpuṇiṃ. 72.","tha-ap338:20.1":"“Satasahassito kappe,","tha-ap338:20.2":"yaṃ kammamakariṃ tadā;","tha-ap338:20.3":"Duggatiṃ nābhijānāmi,","tha-ap338:20.4":"sodhanāya idaṃ phalaṃ. 73.","tha-ap338:21.1":"“Paṭisambhidā catasso…pe…","tha-ap338:21.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap338:22.1":"Itthaṃ sudaṃ āyasmā pabhaṅkaro thero imā gāthāyo abhāsitthāti.","tha-ap338:23.1":"Pabhaṅkarattherassāpadānaṃ chaṭṭhaṃ. 7."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
