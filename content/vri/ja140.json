{"suttaId":"ja140","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[781,788],"vripara":"140"},"segments":{"ja140:0.4":"Kākajātakaṃ","ja140:1.1":"Niccaṃ ubbiggahadayā, sabbalokavihesakā;","ja140:1.3":"Tasmā nesaṃ vasā natthi, kākānamhāka [kākānasmāka (sī. syā. pī.)] ñātinanti.","ja140:2.1":"Kākajātakaṃ dasamaṃ.","ja140:2.2":"Asampadānavaggo cuddasamo.","ja140:3.1":"Tassuddānaṃ –","ja140:4.1":"Itarītara rakkhasi khemiyo ca, parosatapañhena ābhassaro puna;","ja140:4.3":"Atha haṃsavaruttamababbujaṭaṃ, paṭanaṭṭhaka kākavarena dasāti."},"attha":null,"tika":null}
