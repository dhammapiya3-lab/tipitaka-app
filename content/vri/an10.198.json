{"suttaId":"an10.198","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-x","vriCode":"s0404m3.mul","paras":[1457,1460],"vripara":"198"},"segments":{"an10.198:0.3":"Sacchikātabbasuttaṃ","an10.198:1.1":"“Sacchikātabbañca vo, bhikkhave, dhammaṃ desessāmi na sacchikātabbañca.","an10.198:1.2":"Taṃ suṇātha … pe …","an10.198:1.3":"katamo ca, bhikkhave, na sacchikātabbo dhammo?","an10.198:1.4":"Pāṇātipāto … pe …","an10.198:1.5":"micchādiṭṭhi –","an10.198:1.6":"ayaṃ vuccati, bhikkhave, na sacchikātabbo dhammo.","an10.198:2.1":"“Katamo ca, bhikkhave, sacchikātabbo dhammo?","an10.198:2.2":"Pāṇātipātā veramaṇī … pe …","an10.198:2.3":"sammādiṭṭhi –","an10.198:2.4":"ayaṃ vuccati, bhikkhave, sacchikātabbo dhammo”ti.","an10.198:2.5":"Dasamaṃ.","an10.198:2.6":"Ariyamaggavaggo catuttho."},"unsure":[],"attha":null,"tika":{"book":"Mp-t-x","bookName":"Dasakanipāta-ṭīkā","vriCode":"s0404t.tik","from":765,"to":769,"paras":[{"para":765,"vripara":"167-210","refs":["an10.198:1"],"lines":["167-210. Dutiye ca paṭhamādīni uttānatthāni.","Dasame <b>pacchābhūmivāsino</b>ti paccantadesavāsino.","<b>Sevālamālikā</b>ti pātova udakaṃ orohitvā sevālañceva uppalādīni ca gahetvā attano udakasuddhikabhāvajānanatthañceva “lokassa ca udakena suddhi hotī”ti imassa atthassa jānanatthañca mālaṃ katvā pilandhanakā.","<b>Udakorohakā</b>ti pāto majjhanhe sāyanhe ca udakaorohaṇakā.","Tenāha <b>“sāyatatiyakaṃ udakorohaṇānuyogamanuyuttā”</b>ti.","Ekādasamādīni uttānatthāni.","Catutthe paṇṇāsake natthi vattabbaṃ."],"lineRefs":[["an10.198:1"],["an10.198:1"],["an10.198:1"],["an10.198:1"],["an10.198:1"],["an10.198:1"],["an10.198:1"]]},{"para":766,"vripara":null,"refs":["an10.198:1"],"lines":["Brāhmaṇapaccorohaṇīsuttādivaṇṇanā niṭṭhitā."],"lineRefs":[["an10.198:1"]]},{"para":767,"vripara":null,"refs":["an10.198:1"],"lines":["Catutthapaṇṇāsakaṃ niṭṭhitaṃ."],"lineRefs":[["an10.198:1"]]},{"para":768,"vripara":null,"refs":["an10.198:1"],"lines":["(21)1. Karajakāyavaggo"],"lineRefs":[["an10.198:1"]]},{"para":769,"