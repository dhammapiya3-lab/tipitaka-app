{"suttaId":"sn45.173","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-v","vriCode":"s0305m.mul","paras":[386,386],"vripara":"174"},"segments":{"sn45.173:0.3":"Upādānasuttaṃ","sn45.173:1.1":"“Cattārimāni, bhikkhave, upādānāni.","sn45.173:1.2":"Katamāni cattāri?","sn45.173:1.3":"Kāmupādānaṃ, diṭṭhupādānaṃ, sīlabbatupādānaṃ, attavādupādānaṃ –","sn45.173:1.4":"imāni kho, bhikkhave, cattāri upādānāni.","sn45.173:1.5":"Imesaṃ kho, bhikkhave, catunnaṃ upādānānaṃ abhiññāya pariññāya parikkhayāya pahānāya … pe … ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti.","sn45.173:1.6":"Tatiyaṃ."},"unsure":[],"attha":{"book":"Spk-v","bookName":"Mahāvagga-aṭṭhakathā","vriCode":"s0305a.att","from":120,"to":120,"paras":[{"para":120,"vripara":"174-175","refs":["sn45.173:1"],"lines":["174-175. <b>Kāmupādānan</b>ti kāmaggahaṇaṃ.","<b>Diṭṭhupādānā</b> dīsupi eseva nayo.","<b>Ganthā</b>ti ganthanā ghaṭanā.","<b>Kāyagantho</b>ti nāmakāyassa gantho ganthanaghaṭanakileso.","<b>Idaṃsaccābhiniveso</b>ti antaggāhikadiṭṭhivasena uppanno “idameva saccan”ti evaṃ abhiniveso."],"lineRefs":[["sn45.173:1"],["sn45.173:1"],["sn45.173:1"],["sn45.173:1"],["sn45.173:1"]]}],"wordLinks":[["sn45.173:1.3","kāmupādānaṃ",0,0],["sn45.173:1.3","diṭṭhupādānā",0,1]]},"tika":{"book":"Spk-t-v","bookName":"Mahāvagga-ṭīkā","vriCode":"s0305t.tik","from":120,"to":120,"paras":[{"para":120,"vripara":"174-175","refs":["sn45.173:1"],"lines":["174-175. Kāmanavasena upādiyanato <b>kāmupādānaṃ</b>.","Tenāha <b>“kāmaggahaṇan”</b>ti.","<b>Nāmakāyassā</b>ti vedanādīnaṃ catunnaṃ arūpakkhandhānaṃ.","<b>Ghaṭanapabandhanakileso</b>ti hetunā phalassa kammavaṭṭassa vipākavaṭṭena dukkhappabandhasaññitassa ghaṭanassa sambajjhanassa nibbattakakileso.","<b>Antaggāhikadiṭṭhi</b> sassatucchedagāho."],"lineRefs":[["sn45.173:1"],["sn45.173:1"],["sn45.173:1"],["sn45.173:1"],["sn45.173:1"]]}],"wordLinks":[["sn45.173:1.3","kāmupādānaṃ",0,0]]},"tika2":null}
