{"suttaId":"sn29.1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[1253,1253],"vripara":"342"},"segments":{"sn29.1:0.3":"Suddhikasuttaṃ","sn29.1:1.1":"Sāvatthinidānaṃ.","sn29.1:1.2":"“Catasso imā, bhikkhave, nāgayoniyo.","sn29.1:1.3":"Katamā catasso?","sn29.1:1.4":"Aṇḍajā nāgā, jalābujā nāgā, saṃsedajā nāgā, opapātikā nāgā –","sn29.1:1.5":"imā kho, bhikkhave, catasso nāgayoniyo”ti.","sn29.1:1.6":"Paṭhamaṃ."},"unsure":[],"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":466,"to":466,"paras":[{"para":466,"vripara":"342","refs":["sn29.1:1"],"lines":["Nāgasaṃyutte <b>aṇḍajā</b>ti aṇḍe jātā.","<b>Jalābujā</b>ti vatthikose jātā.","<b>Saṃsedajā</b>ti saṃsede jātā.","<b>Opapātikā</b>ti upapatitvā viya jātā.","Idañca pana suttaṃ aṭṭhuppattiyā vuttaṃ.","Bhikkhūnañhi “kati nu kho nāgayoniyo”ti kathā udapādi.","Atha bhagavā puggalānaṃ nāgayonīhi uddharaṇatthaṃ nāgayoniyo āvikaronto imaṃ suttamāha."],"lineRefs":[["sn29.1:1"],["sn29.1:1"],["sn29.1:1"],["sn29.1:1"],["sn29.1:1"],["sn29.1:1"],["sn29.1:1"]]}],"wordLinks":[["sn29.1:1.4","aṇḍajā",0,0],["sn29.1:1.4","jalābujā",0,1],["sn29.1:1.4","saṃsedajā",0,2],["sn29.1:1.4","opapātikā",0,3]],"before":[{"para":463,"vripara":null,"refs":[],"lines":["Sāriputtasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":464,"vripara":null,"refs":[],"lines":["Nāgasaṃyuttaṃ"],"lineRefs":[[]]},{"para":465,"vripara":null,"refs":[],"lines":["Suddhikasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":492,"to":492,"paras":[{"para":492,"vripara":"342","refs":["sn29.1:1"],"lines":["<b>Aṇḍajā</b>ti aṇḍe jātā.","<b>Vatthikose</b>ti vatthikosasaññite jarāyupuṭe <b>jātā.</b>","<b>Saṃsede</b>ti saṃsinne kilinnaṭṭhāne uppannā.","<b>Upapatitvā viyā</b>ti kutocipi avapatitvā viya nibbattā.","<b>Puggalānan</b>ti tathā vinetabbapuggalānaṃ."],"lineRefs":[["sn29.1:1"],["sn29.1:1"],["sn29.1:1"],["sn29.1:1"],["sn29.1:1"]]}],"wordLinks":[["sn29.1:1.4","aṇḍajā",0,0],["sn29.1:1.4","saṃsede",0,2]],"before":[{"para":488,"vripara":null,"refs":[],"lines":["Sūcimukhīsuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":489,"vripara":null,"refs":[],"lines":["Sāriputtasaṃyuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":490,"vripara":null,"refs":[],"lines":["Nāgasaṃyuttaṃ"],"lineRefs":[[]]},{"para":491,"vripara":null,"refs":[],"lines":["Suddhikasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
