{"suttaId":"sn1.25","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-i","vriCode":"s0301m.mul","paras":[235,257],"vripara":"25"},"segments":{"sn1.25:0.3":"Arahantasuttaṃ","sn1.25:1.1":"“Yo hoti bhikkhu arahaṃ katāvī,","sn1.25:1.2":"Khīṇāsavo antimadehadhārī;","sn1.25:1.3":"Ahaṃ vadāmītipi so vadeyya,","sn1.25:1.4":"Mamaṃ vadantītipi so vadeyyā”ti.","sn1.25:2.1":"“Yo hoti bhikkhu arahaṃ katāvī,","sn1.25:2.2":"Khīṇāsavo antimadehadhārī;","sn1.25:2.3":"Ahaṃ vadāmītipi so vadeyya,","sn1.25:2.4":"Mamaṃ vadantītipi so vadeyya;","sn1.25:2.5":"Loke samaññaṃ kusalo viditvā,","sn1.25:2.6":"Vohāramattena so [sa (?)] vohareyyā”ti.","sn1.25:3.1":"“Yo hoti bhikkhu arahaṃ katāvī,","sn1.25:3.2":"Khīṇāsavo antimadehadhārī;","sn1.25:3.3":"Mānaṃ nu kho so upagamma bhikkhu,","sn1.25:3.4":"Ahaṃ vadāmītipi so vadeyya;","sn1.25:3.5":"Mamaṃ vadantītipi so vadeyyā”ti.","sn1.25:4.1":"“Pahīnamānassa na santi ganthā,","sn1.25:4.2":"Vidhūpitā mānaganthassa sabbe;","sn1.25:4.3":"Sa vītivatto maññataṃ [mānanaṃ (sī.), maññītaṃ (?)] sumedho,","sn1.25:4.4":"Ahaṃ vadāmītipi so vadeyya.","sn1.25:5.1":"“Mamaṃ vadantītipi so vadeyya;","sn1.25:5.2":"Loke samaññaṃ kusalo viditvā;","sn1.25:5.3":"Vohāramattena so vohareyyā”ti."},"attha":{"book":"Spk-i","bookName":"Sagāthāvagga-aṭṭhakathā","vriCode":"s0301a.att","from":256,"to":258,"paras":[{"para":256,"vripara":"25","refs":["sn1.25:1"],"lines":["Pañcame <b>katāvī</b>ti catūhi maggehi katakicco.","<b>Ahaṃ vadāmī</b>ti ayaṃ devatā vanasaṇḍavāsinī, sā āraññakānaṃ bhikkhūnaṃ “ahaṃ bhuñjāmi, ahaṃ nisīdāmi, mama patto, mama cīvaran”tiādikathāvohāraṃ sutvā cintesi –","“ahaṃ ime bhikkhū ‘khīṇāsavā’ti maññāmi, khīṇāsavānañca nāma evarūpā attupaladdhinissitakathā hoti, na hoti nu kho”ti jānanatthaṃ evaṃ pucchati."],"lineRefs":[["sn1.25:1"],["sn1.25:1"],["sn1.25:1"]]},{"para":257,"vripara":null,"refs":["sn1.25:1","sn1.25:2"],"lines":["<b>Sāmaññan</b>ti lokaniruttiṃ lokavohāraṃ.","<b>Kusalo</b>ti khandhādīsu kusalo.","<b>Vohāramattenā</b>ti upaladdhinissitakathaṃ hitvā vohārabhedaṃ akaronto “ahaṃ, mamā”ti vadeyya.","“Khandhā bhuñjanti, khandhā nisīdanti, khandhānaṃ patto, khandhānaṃ cīvaran”ti hi vutte vohārabhedo hoti, na koci jānāti.","Tasmā evaṃ avatvā lokavohārena voharatīti."],"lineRefs":[["sn1.25:1"],["sn1.25:2"],["sn1.25:2"],["sn1.25:2"],["sn1.25:2"]]},{"para":258,"vripara":null,"refs":["sn1.25:2","sn1.25:3","sn1.25:4"],"lines":["Atha devatā –","“yadi diṭṭhiyā vasena na vadati, mānavasena nu kho vadatī”ti cintetvā puna <b>yo hotī</b>ti pucchi.","Tattha <b>mānaṃ nu kho</b>ti so bhikkhu mānaṃ upagantvā mānavasena vadeyya nu khoti.","Atha bhagavā –","“ayaṃ devatā khīṇāsavaṃ samānaṃ viya karotī”ti cintetvā,“khīṇāsavassa navavidhopi māno pahīno”ti dassento paṭigāthaṃ āha.","Tattha <b>vidhūpitā</b>ti vidhamitā.","<b>Mānaganthassā</b>ti mānā ca ganthā ca assa.","<b>Maññatan</b>ti maññanaṃ.","Tividhampi taṇhā-diṭṭhi-māna-maññanaṃ so vītivatto, atikkantoti attho.","Sesaṃ uttānatthamevāti.","Pañcamaṃ."],"lineRefs":[["sn1.25:2"],["sn1.25:2"],["sn1.25:3"],["sn1.25:3"],["sn1.25:3"],["sn1.25:4"],["sn1.25:4"],["sn1.25:4"],["sn1.25:4"],["sn1.25:4"],["sn1.25:4"]]}],"wordLinks":[["sn1.25:1.1","katāvī",0,0],["sn1.25:1.3","ahaṃ vadāmī",0,1],["sn1.25:2.5","kusalo",1,1],["sn1.25:2.6","vohāramattenā",1,2],["sn1.25:2.1","yo hotī",2,1],["sn1.25:3.3","mānaṃ nu kho",2,2],["sn1.25:4.2","vidhūpitā",2,5],["sn1.25:4.2","mānaganthassā",2,6],["sn1.25:4.3","maññataṃ",2,7]],"before":[{"para":255,"vripara":null,"refs":[],"lines":["Arahantasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika":{"book":"Spk-t-i","bookName":"Sagāthāvagga-ṭīkā","vriCode":"s0301t.tik","from":368,"to":370,"paras":[{"para":368,"vripara":"25","refs":["sn1.25:1"],"lines":["<b>Katāvī</b>ti katavā, pariññādikiccaṃ katvā niṭṭhapetvā ṭhitoti attho.","Tenāha <b>“catūhi maggehi katakicco”</b>ti.","Svāyamattho arahantiādisaddasannidhānato viññāyati.","<b>Evaṃ</b> “ahaṃ vadāmī”tiādiākārena <b>pucchati</b>."],"lineRefs":[["sn1.25:1"],["sn1.25:1"],["sn1.25:1"],["sn1.25:1"]]},{"para":369,"vripara":null,"refs":["sn1.25:1"],"lines":["<b>Khandhādīsu kusalo</b>ti khandhāyatanādīsu salakkhaṇādīsu ca samūhādivasena pavattiyañca cheko yathābhūtavedī.","<b>Upaladdhinissitakathan</b>ti attupaladdhinissitakathaṃ hitvā.","<b>Vohārabhedaṃ akaronto</b>ti “ahaṃ paramatthaṃ jānāmī”ti lokavohāraṃ bhindanto avināsento loke lokasamaññameva nissāya <b>“ahaṃ, mamā”ti vadeyya.</b>","<b>Khandhā bhuñjantī</b>tiādinā vohārabhedaṃ, tattha ca ādīnavaṃ dasseti."],"lineRefs":[["sn1.25:1"],["sn1.25:1"],["sn1.25:1"],["sn1.25:1"]]},{"para":370,"vripara":null,"refs":["sn1.25:1","sn1.25:4"],"lines":["Māno nāma diṭṭhiyā samadhuro.","Tathā hi dutiyamaggādīsu sammādiṭṭhiyā pahānābhisamayassa paṭivipaccanīke paṭipattisiddhi.","Tenāha <b>“yadi diṭṭhiyā vasena na vadati, mānavasena nu kho vadatīti cintetvā”</b>ti.","<b>Vidhūpitā</b>ti santāpitā ñāṇagginā daḍḍhā.","Te pana viddhaṃsitā nāma hontīti āha <b>“vidhamitā”</b>ti.","Mamaṅkārādayo mayanti sattasantāne sati pavattanti etenāti mayo, maññanā.","Mayo eva <b>mayatā</b>ti āha <b>“mayatanti maññanan”</b>ti."],"lineRefs":[["sn1.25:1"],["sn1.25:1"],["sn1.25:1"],["sn1.25:4"],["sn1.25:4"],["sn1.25:4"],["sn1.25:4"]]}],"wordLinks":[["sn1.25:1.1","katāvī",0,0],["sn1.25:4.2","vidhūpitā",2,3]],"before":[{"para":366,"vripara":null,"refs":[],"lines":["Manonivāraṇasuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":367,"vripara":null,"refs":[],"lines":["Arahantasuttavaṇṇanā"],"lineRefs":[[]]}]},"tika2":null}
