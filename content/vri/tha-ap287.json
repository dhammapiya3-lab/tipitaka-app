{"suttaId":"tha-ap287","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-i","vriCode":"s0510m1.mul","paras":[8771,8783],"vripara":"20"},"segments":{"tha-ap287:0.3":"Maghavapupphiyattheraapadānaṃ","tha-ap287:1.1":"“Nammadānadiyā tīre, sayambhū aparājito;","tha-ap287:1.3":"Samādhiṃ so samāpanno, vippasanno anāvilo.","tha-ap287:2.1":"“Disvā pasannasumano, sambuddhaṃ aparājitaṃ;","tha-ap287:2.3":"Tāhaṃ maghavapupphena, sayambhuṃ pūjayiṃ tadā.","tha-ap287:3.1":"“Ekanavutito kappe, yaṃ pupphamabhipūjayiṃ;","tha-ap287:3.3":"Duggatiṃ nābhijānāmi, buddhapūjāyidaṃ phalaṃ.","tha-ap287:4.1":"“Paṭisambhidā catasso … pe … kataṃ buddhassa sāsanaṃ”.","tha-ap287:5.1":"Itthaṃ sudaṃ āyasmā maghavapupphiyo thero imā gāthāyo abhāsitthāti.","tha-ap287:6.1":"Maghavapupphiyattherassāpadānaṃ pañcamaṃ."},"attha":null,"tika":null,"tika2":null}
