{"suttaId":"sn22.19","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-iii","vriCode":"s0303m.mul","paras":[126,126],"vripara":"19"},"segments":{"sn22.19:0.3":"Sahetudukkhasuttaṃ","sn22.19:1.1":"Sāvatthinidānaṃ.","sn22.19:1.2":"“Rūpaṃ, bhikkhave, dukkhaṃ.","sn22.19:1.3":"Yopi hetu yopi paccayo rūpassa uppādāya, sopi dukkho.","sn22.19:1.4":"Dukkhasambhūtaṃ, bhikkhave, rūpaṃ kuto sukhaṃ bhavissati!","sn22.19:1.5":"Vedanā dukkhā … saññā dukkhā … saṅkhārā dukkhā … viññāṇaṃ dukkhaṃ.","sn22.19:1.9":"Yopi hetu yopi paccayo viññāṇassa uppādāya, sopi dukkho.","sn22.19:1.10":"Dukkhasambhūtaṃ, bhikkhave, viññāṇaṃ kuto sukhaṃ bhavissati!","sn22.19:1.11":"Evaṃ passaṃ … pe … nāparaṃ itthattāyāti pajānātī”ti.","sn22.19:1.13":"Aṭṭhamaṃ."},"attha":{"book":"Spk-iii","bookName":"Khandhavagga-aṭṭhakathā","vriCode":"s0303a.att","from":70,"to":73,"paras":[{"para":70,"vripara":"12-21","refs":["sn22.19:1"],"lines":["12-21. Aniccavagge pariyosānasuttaṃ pucchāvasikaṃ, sesāni tathā tathā bujjhanakānañca vasena desitānīti.","Paṭhamādīni."],"lineRefs":[["sn22.19:1"],["sn22.19:1"]]},{"para":71,"vripara":null,"refs":[],"lines":["Aniccavaggo dutiyo."],"lineRefs":[[]]},{"para":72,"vripara":null,"refs":[],"lines":["Bhāravaggo"],"lineRefs":[[]]},{"para":73,"vripara":null,"refs":["sn22.19:1"],"lines":["Bhārasuttavaṇṇanā"],"lineRefs":[["sn22.19:1"]]}],"wordLinks":[]},"tika":{"book":"Spk-t-iii","bookName":"Khandhavagga-ṭīkā","vriCode":"s0303t.tik","from":66,"to":70,"paras":[{"para":66,"vripara":"12-21","refs":["sn22.19:1"],"lines":["12-21. <b>Pucchāvasikaṃ</b> ānandattherassa pucchāvasena desitattā."],"lineRefs":[["sn22.19:1"]]},{"para":67,"vripara":null,"refs":[],"lines":["Aniccādisuttavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":68,"vripara":null,"refs":[],"lines":["Aniccavaggavaṇṇanā niṭṭhitā."],"lineRefs":[[]]},{"para":69,"vripara":null,"refs":[],"lines":["Bhāravaggo"],"lineRefs":[[]]},{"para":70,"vripara":null,"refs":["sn22.19:1"],"lines":["Bhārasuttavaṇṇanā"],"lineRefs":[["sn22.19:1"]]}