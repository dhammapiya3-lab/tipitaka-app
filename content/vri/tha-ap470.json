{"suttaId":"tha-ap470","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ap-ii","vriCode":"s0510m2.mul","paras":[1427,1441],"vripara":"40"},"segments":{"tha-ap470:0.3":"Pilakkhaphaladāyakattheraapadānaṃ","tha-ap470:1.1":"“Vanantare buddhaṃ disvā [vanante buddhaṃ disvāna (sī. pī.)],","tha-ap470:1.2":"atthadassiṃ mahāyasaṃ;","tha-ap470:1.3":"Pasannacitto sumano,","tha-ap470:1.4":"pilakkhassa [pilakkhussa (pī.)] phalaṃ adā.","tha-ap470:2.1":"“Aṭṭhārase kappasate,","tha-ap470:2.2":"yaṃ phalaṃ adadiṃ tadā;","tha-ap470:2.3":"Duggatiṃ nābhijānāmi,","tha-ap470:2.4":"phaladānassidaṃ phalaṃ.","tha-ap470:3.1":"“Kilesā jhāpitā mayhaṃ … pe …","tha-ap470:3.3":"viharāmi anāsavo.","tha-ap470:4.1":"“Svāgataṃ vata me āsi … pe …","tha-ap470:4.3":"kataṃ buddhassa sāsanaṃ.","tha-ap470:5.1":"“Paṭisambhidā catasso … pe …","tha-ap470:5.3":"kataṃ buddhassa sāsanaṃ”.","tha-ap470:6.1":"Itthaṃ sudaṃ āyasmā pilakkhaphaladāyako thero imā Gāthāyo abhāsitthāti.","tha-ap470:7.1":"Pilakkhaphaladāyakattherassāpadānaṃ aṭṭhamaṃ."},"unsure":[],"preface":[],"attha":null,"tika":null,"tika2":null}
