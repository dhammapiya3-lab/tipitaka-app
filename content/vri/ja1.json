{"suttaId":"ja1","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[8,11],"vripara":"1"},"segments":{"ja1:0.4":"Apaṇṇakajātakaṃ","ja1:2.1":"Apaṇṇakaṃ ṭhānameke, dutiyaṃ āhu takkikā;","ja1:2.3":"Etadaññāya medhāvī, taṃ gaṇhe yadapaṇṇakanti [taṃ gaṇheyya apaṇṇakaṃ (ka.)].","ja1:3.1":"Apaṇṇakajātakaṃ paṭhamaṃ."},"attha":null,"tika":null}
