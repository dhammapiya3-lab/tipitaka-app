{"suttaId":"an4.5","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"A-iv","vriCode":"s0402m3.mul","paras":[49,68],"vripara":"5"},"segments":{"an4.5:0.3":"Anusotasuttaṃ","an4.5:1.1":"“Cattārome, bhikkhave, puggalā santo saṃvijjamānā lokasmiṃ.","an4.5:1.2":"Katame cattāro?","an4.5:1.3":"Anusotagāmī puggalo, paṭisotagāmī puggalo, ṭhitatto puggalo, tiṇṇo pāraṅgato [pāragato (sī. syā. kaṃ.)] thale tiṭṭhati brāhmaṇo.","an4.5:1.4":"Katamo ca, bhikkhave, anusotagāmī puggalo?","an4.5:1.5":"Idha, bhikkhave, ekacco puggalo kāme ca paṭisevati, pāpañca kammaṃ karoti.","an4.5:1.6":"Ayaṃ vuccati, bhikkhave, anusotagāmī puggalo.","an4.5:2.1":"“Katamo ca, bhikkhave, paṭisotagāmī puggalo?","an4.5:2.2":"Idha, bhikkhave, ekacco puggalo kāme ca nappaṭisevati, pāpañca kammaṃ na karoti, sahāpi dukkhena sahāpi domanassena assumukhopi rudamāno paripuṇṇaṃ parisuddhaṃ brahmacariyaṃ carati.","an4.5:2.3":"Ayaṃ vuccati, bhikkhave, paṭisotagāmī puggalo.","an4.5:3.1":"“Katamo ca, bhikkhave, ṭhitatto puggalo?","an4.5:3.2":"Idha, bhikkhave, ekacco puggalo pañcannaṃ orambhāgiyānaṃ saṃyojanānaṃ parikkhayā opapātiko hoti, tattha parinibbāyī, anāvattidhammo tasmā lokā.","an4.5:3.3":"Ayaṃ vuccati, bhikkhave, ṭhitatto puggalo.","an4.5:4.1":"“Katamo ca, bhikkhave, puggalo tiṇṇo pāraṅgato thale tiṭṭhati brāhmaṇo?","an4.5:4.2":"Idha, bhikkhave, ekacco puggalo āsavānaṃ khayā anāsavaṃ cetovimuttiṃ paññāvimuttiṃ diṭṭheva dhamme sayaṃ abhiññā sacchikatvā upasampajja viharati.","an4.5:4.3":"Ayaṃ vuccati, bhikkhave, puggalo tiṇṇo pāraṅgato thale tiṭṭhati brāhmaṇo.","an4.5:4.4":"Ime kho, bhikkhave, cattāro puggalā santo saṃvijjamānā lokasmin”ti.","an4.5:5.1":"“Ye keci kāmesu asaññatā janā,","an4.5:5.2":"Avītarāgā idha kāmabhogino;","an4.5:5.3":"Punappunaṃ jātijarūpagāmi te [jātijarūpagāhino (sī.), jātijarūpagā hi te (syā. kaṃ.)],","an4.5:5.4":"Taṇhādhipannā anusotagāmino.","an4.5:6.1":"“Tasmā hi dhīro idhupaṭṭhitassatī,","an4.5:6.2":"Kāme ca pāpe ca asevamāno;","an4.5:6.3":"Sahāpi dukkhena jaheyya kāme,","an4.5:6.4":"Paṭisotagāmīti tamāhu puggalaṃ.","an4.5:7.1":"“Yo ve kilesāni pahāya pañca,","an4.5:7.2":"Paripuṇṇasekho aparihānadhammo;","an4.5:7.3":"Cetovasippatto samāhitindriyo,","an4.5:7.4":"Sa ve ṭhitattoti naro pavuccati.","an4.5:8.1":"“Paroparā yassa samecca dhammā,","an4.5:8.2":"Vidhūpitā atthagatā na santi;","an4.5:8.3":"Sa ve muni [sa vedagū (sī. syā. kaṃ. pī.)] vusitabrahmacariyo,","an4.5:8.4":"Lokantagū pāragatoti vuccatī”ti.","an4.5:8.5":"pañcamaṃ;"},"unsure":[],"preface":[],"attha":{"book":"Mp-iv","bookName":"Catukkanipāta-aṭṭhakathā","vriCode":"s0402a.att","from":1011,"to":1012,"paras":[{"para":1011,"vripara":"5","refs":["an4.5:1","an4.5:2","an4.5:3"],"lines":["Pañcame anusotaṃ gacchatīti <b>anusotagāmī</b>.","Kilesasotassa paccanīkapaṭipattiyā paṭisotaṃ gacchatīti <b>paṭisotagāmī</b>.","<b>Ṭhitatto</b>ti ṭhitasabhāvo.","<b>Tiṇṇo</b>ti oghaṃ taritvā ṭhito.","<b>Pāraṅgato</b>ti paratīraṃ gato.","<b>Thale tiṭṭhatī</b>ti nibbānathale tiṭṭhati.","<b>Brāhmaṇo</b>ti seṭṭho niddoso.","<b>Idhā</b>ti imasmiṃ loke.","<b>Kāme ca paṭisevatī</b>ti kilesakāmehi vatthukāme paṭisevati.","<b>Pāpañca kammaṃ karotī</b>ti pāpañca pāṇātipātādikammaṃ karoti.","<b>Pāpañca kammaṃ na karotī</b>ti pañcaverakammaṃ na karoti.","<b>Ayaṃ vuccati, bhikkhave, ṭhitatto</b>ti ayaṃ anāgāmī puggalo tasmā lokā puna paṭisandhivasena anāgamanato ṭhitatto nāma."],"lineRefs":[["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:2"],["an4.5:3"]]},{"para":1012,"vripara":null,"refs":["an4.5:5","an4.5:7","an4.5:8"],"lines":["<b>Taṇhādhipannā</b>ti taṇhāya adhipannā ajjhotthaṭā, taṇhaṃ vā adhipannā ajjhogāḷhā.","<b>Paripuṇṇasekho</b>ti sikkhāpāripūriyā ṭhito.","<b>Aparihānadhammo</b>ti aparihīnasabhāvo.","<b>Cetovasippatto</b>ti cittavasībhāvaṃ patto.","Evarūpo khīṇāsavo hoti, idha pana anāgāmī kathito.","<b>Samāhitindriyo</b>ti samāhitachaḷindriyo.","<b>Paroparā</b>ti parovarā uttamalāmakā, kusalākusalāti attho.","<b>Sameccā</b>ti ñāṇena samāgantvā.","<b>Vidhūpitā</b>ti viddhaṃsitā jhāpitā vā.","<b>Vusitabrahmacariyo</b>ti maggabrahmacariyaṃ vasitvā ṭhito.","<b>Lokantagū</b>ti tividhassāpi lokassa antaṃ gato.","<b>Pāragato</b>ti chahākārehi pāragato.","Idha khīṇāsavova kathito.","Iti suttepi gāthāsupi vaṭṭavivaṭṭameva kathitaṃ."],"lineRefs":[["an4.5:5"],["an4.5:7"],["an4.5:7"],["an4.5:7"],["an4.5:7"],["an4.5:7"],["an4.5:8"],["an4.5:8"],["an4.5:8"],["an4.5:8"],["an4.5:8"],["an4.5:8"],["an4.5:8"],["an4.5:8"]]}],"wordLinks":[["an4.5:1.3","anusotagāmī",0,0],["an4.5:1.4","anusotagāmī",0,0],["an4.5:1.6","anusotagāmī",0,0],["an4.5:1.3","paṭisotagāmī",0,1],["an4.5:1.3","ṭhitatto",0,2],["an4.5:1.3","tiṇṇo",0,3],["an4.5:1.3","pāraṅgato",0,4],["an4.5:1.3","thale tiṭṭhatī",0,5],["an4.5:1.3","brāhmaṇo",0,6],["an4.5:1.5","idhā",0,7],["an4.5:1.5","kāme ca paṭisevatī",0,8],["an4.5:1.5","pāpañca kammaṃ karotī",0,9],["an4.5:2.2","pāpañca kammaṃ na karotī",0,10],["an4.5:3.3","ayaṃ vuccati bhikkhave ṭhitatto",0,11],["an4.5:5.4","taṇhādhipannā",1,0],["an4.5:7.2","paripuṇṇasekho",1,1],["an4.5:7.2","aparihānadhammo",1,2],["an4.5:7.3","cetovasippatto",1,3],["an4.5:7.3","samāhitindriyo",1,5],["an4.5:8.1","paroparā",1,6],["an4.5:8.1","sameccā",1,7],["an4.5:8.2","vidhūpitā",1,8],["an4.5:8.3","vusitabrahmacariyo",1,9],["an4.5:8.4","lokantagū",1,10],["an4.5:8.4","pāragato",1,11]],"before":[{"para":1010,"vripara":null,"title":"Anusotasuttavaṇṇanā","lines":["Anusotasuttavaṇṇanā"]}]},"tika":{"book":"Mp-t-iv","bookName":"Catukkanipāta-ṭīkā","vriCode":"s0402t.tik","from":1035,"to":1036,"paras":[{"para":1035,"vripara":"5","refs":["an4.5:1","an4.5:2"],"lines":["Pañcame <b>anusotaṃ gacchatī</b>ti saṃsārasotassa anukūlabhāvena gacchati.","<b>Paccanīkapaṭipattiyā</b>ti saṃsārasotassa paṭikūlavasena pavattanibbidānupassanādipaṭipattiyā.","<b>Ṭhitasabhāvo</b>ti acalappasādādisamannāgamena ṭhitasabhāvo.","Anāgāmī hi assaddhiyehi kāmarāgabyāpādehi akampaniyacittatāya tamhā lokā anāvattidhammatāya ca ṭhitasabhāvo nāma.","<b>Oghaṃ taritvā</b>ti kāmoghādicatubbidhaṃ oghaṃ atikkamitvā.","<b>Paratīraṃ gato</b>ti nibbānapāraṃ gato.","<b>Brāhmaṇo</b>ti bāhitapāpatāya brāhmaṇoti saṅkhaṃ gato khīṇāsavo.","Tenāha <b>“seṭṭho niddoso”</b>ti.","<b>Pañcaverakamman</b>ti pāṇātipātādipañcaduccaritaṃ.","<b>Sahāpi dukkhena sahāpi domanassenā</b>ti kilesapariyuṭṭhāne sati uppannena dukkhadomanassena saddhimpi.","<b>Paripuṇṇan</b>ti tissannaṃ sikkhānaṃ ekāyapi anūnaṃ.","<b>Parisuddhan</b>ti nirupakkilesaṃ.","<b>Brahmacariyan</b>ti seṭṭhacariyaṃ.","Iminā vārena sotāpannasakadāgāmino kathitā.","Kiṃ pana te rudantā brahmacariyaṃ carantīti?","Āma, kilesarodanena rodantā caranti nāma, sīlasampanno puthujjanabhikkhu ettheva saṅgahito."],"lineRefs":[["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:1"],["an4.5:2"],["an4.5:2"],["an4.5:2"],["an4.5:2"],["an4.5:2"],["an4.5:2"],["an4.5:2"]]},{"para":1036,"vripara":null,"refs":["an4.5:4"],"lines":["<b>Cetovimuttin</b>ti phalasamādhiṃ.","<b>Paññāvimuttin</b>ti phalañāṇaṃ.","<b>Chahākārehi pāragato</b>ti abhiññāpāragū, pariññāpāragū, bhāvanāpāragū, pahānapāragū, sacchikiriyāpāragū, samāpattipāragūti evaṃ chahi ākārehi sabbadhammānaṃ pāraṃ pariyosānaṃ gato.","Sesamettha suviññeyyameva."],"lineRefs":[["an4.5:4"],["an4.5:4"],["an4.5:4"],["an4.5:4"]]}],"wordLinks":[["an4.5:1.3","brāhmaṇo",0,6],["an4.5:2.2","sahāpi dukkhena sahāpi domanassenā",0,9],["an4.5:2.2","paripuṇṇaṃ",0,10],["an4.5:2.2","parisuddhaṃ",0,11],["an4.5:2.2","brahmacariyaṃ",0,12],["an4.5:4.2","cetovimuttiṃ",1,0],["an4.5:4.2","paññāvimuttiṃ",1,1]],"before":[{"para":1034,"vripara":null,"title":"Anusotasuttavaṇṇanā","lines":["Anusotasuttavaṇṇanā"]}],"after":[{"para":1037,"vripara":null,"title":"Anusotasuttavaṇṇanā","lines":["Anusotasuttavaṇṇanā niṭṭhitā."]}]},"tika2":null}
