{"suttaId":"sn15.10","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"S-ii","vriCode":"s0302m.mul","paras":[894,909],"vripara":"133"},"segments":{"sn15.10:0.3":"Puggalasuttaṃ","sn15.10:1.1":"Ekaṃ samayaṃ bhagavā rājagahe viharati gijjhakūṭe pabbate.","sn15.10:1.2":"Tatra kho bhagavā bhikkhū āmantesi –","sn15.10:1.3":"“bhikkhavo”ti.","sn15.10:1.4":"“Bhadante”ti te bhikkhū bhagavato paccassosuṃ.","sn15.10:1.5":"Bhagavā etadavoca –","sn15.10:2.1":"“Anamataggoyaṃ, bhikkhave, saṃsāro…pe…","sn15.10:2.2":"ekapuggalassa, bhikkhave, kappaṃ sandhāvato saṃsarato siyā evaṃ mahā aṭṭhikaṅkalo aṭṭhipuñjo aṭṭhirāsi yathāyaṃ vepullo pabbato, sace saṃhārako assa, sambhatañca na vinasseyya.","sn15.10:2.3":"Taṃ kissa hetu?","sn15.10:2.4":"Anamataggoyaṃ, bhikkhave, saṃsāro…pe…","sn15.10:2.5":"alaṃ vimuccitu”nti.","sn15.10:3.1":"Idamavoca bhagavā.","sn15.10:3.2":"Idaṃ vatvāna sugato athāparaṃ etadavoca satthā –","sn15.10:4.1":"“Ekassekena kappena,","sn15.10:4.2":"puggalassaṭṭhisañcayo;","sn15.10:4.3":"Siyā pabbatasamo rāsi,","sn15.10:4.4":"iti vuttaṃ mahesinā.","sn15.10:5.1":"“So kho panāyaṃ akkhāto,","sn15.10:5.2":"vepullo pabbato mahā;","sn15.10:5.3":"Uttaro gijjhakūṭassa,","sn15.10:5.4":"magadhānaṃ giribbaje.","sn15.10:6.1":"“Yato ca ariyasaccāni,","sn15.10:6.2":"sammappaññāya passati;","sn15.10:6.3":"Dukkhaṃ dukkhasamuppādaṃ,","sn15.10:6.4":"dukkhassa ca atikkamaṃ;","sn15.10:6.5":"Ariyaṃ caṭṭhaṅgikaṃ maggaṃ,","sn15.10:6.6":"dukkhūpasamagāminaṃ.","sn15.10:7.1":"“Sa sattakkhattuṃparamaṃ,","sn15.10:7.2":"sandhāvitvāna puggalo;","sn15.10:7.3":"Dukkhassantakaro hoti,","sn15.10:7.4":"sabbasaṃyojanakkhayā”ti.","sn15.10:7.5":"dasamaṃ;","sn15.10:7.6":"Paṭhamo vaggo.","sn15.10:8.0":"Tassuddānaṃ –","sn15.10:8.1":"Tiṇakaṭṭhañca pathavī,","sn15.10:8.2":"assu khīrañca pabbataṃ;","sn15.10:8.3":"Sāsapā sāvakā gaṅgā,","sn15.10:8.4":"daṇḍo ca puggalena cāti. 2."},"unsure":[],"preface":[],"attha":{"book":"Spk-ii","bookName":"Nidānavagga-aṭṭhakathā","vriCode":"s0302a.att","from":635,"to":635,"paras":[{"para":635,"vripara":"133","refs":["sn15.10:2","sn15.10:5"],"lines":["Dasame <b>aṭṭhikaṅkalo</b>tiādīni tīṇipi rāsivevacanāneva.","Imesaṃ pana sattānaṃ saaṭṭhikālato anaṭṭhikālova bahutaro.","Gaṇḍuppādakādipāṇabhūtānañhi etesaṃ aṭṭhimeva natthi, macchakacchapādibhūtānaṃ pana aṭṭhimeva bahutaraṃ, tasmā anaṭṭhikālañca bahuaṭṭhikālañca aggahetvā samaṭṭhikālova gahetabbo.","<b>Uttaro</b> <b>gijjhakūṭassā</b>ti gijjhakūṭassa uttarapasse ṭhito.","<b>Magadhānaṃ giribbaje</b>ti magadharaṭṭhassa giribbaje, giriparikkhepe ṭhitoti attho.","Sesaṃ sabbattha uttānamevāti.","Dasamaṃ."],"lineRefs":[["sn15.10:2"],["sn15.10:2"],["sn15.10:2"],["sn15.10:5"],["sn15.10:5"],["sn15.10:5"],["sn15.10:5"]]}],"wordLinks":[["sn15.10:2.1","aṭṭhikaṅkalo",0,0],["sn15.10:5.3","uttaro gijjhakūṭassā",0,3],["sn15.10:5.3","magadhānaṃ giribbaje",0,4]],"after":[{"para":636,"vripara":null,"title":"Puggalasuttavaṇṇanā","lines":["Paṭhamo vaggo. 2."]}]},"tika":{"book":"Spk-t-ii","bookName":"Nidānavagga-ṭīkā","vriCode":"s0302t.tik","from":646,"to":650,"paras":[{"para":646,"vripara":"133","refs":["sn15.10:1"],"lines":["<b>Samaṭṭhikālo</b>ti samena ākārena laddhabbaaṭṭhikālo.","<b>Giriparikkhepe</b>ti pañcahi girīhi parikkhittattā “giriparikkhepo”ti laddhanāme rājagahe."],"lineRefs":[["sn15.10:1"],["sn15.10:1"]]},{"para":647,"vripara":null,"refs":["sn15.10:1"],"lines":["Puggalasuttavaṇṇanā niṭṭhitā."],"lineRefs":[["sn15.10:1"]]},{"para":648,"vripara":null,"refs":["sn15.10:1"],"lines":["Paṭhamavaggavaṇṇanā niṭṭhitā. 2."],"lineRefs":[["sn15.10:1"]]},{"para":649,"vripara":null,"refs":["sn15.10:1"],"lines":["Dutiyavaggo 1."],"lineRefs":[["sn15.10:1"]]},{"para":650,"vripara":null,"refs":["sn15.10:1"],"lines":["Duggatasuttavaṇṇanā 134."],"lineRefs":[["sn15.10:1"]]}],"wordLinks":[],"before":[{"para":645,"vripara":null,"title":"Puggalasuttavaṇṇanā","lines":["Puggalasuttavaṇṇanā 133."]}]},"tika2":null}
