{"suttaId":"ja156","source":{"db":"E-Piṭaka (dhammanana/epitaka_app)","book":"Ja-i","vriCode":"s0513m.mul","paras":[895,902],"vripara":"11"},"segments":{"ja156:0.4":"Alīnacittajātakaṃ (2-1-6)","ja156:1.1":"Alīnacittaṃ nissāya, pahaṭṭhā mahatī camū;","ja156:1.3":"Kosalaṃ senāsantuṭṭhaṃ, jīvaggāhaṃ agāhayi.","ja156:2.1":"Evaṃ nissayasampanno, bhikkhu āraddhavīriyo;","ja156:2.3":"Bhāvayaṃ kusalaṃ dhammaṃ, yogakkhemassa pattiyā;","ja156:2.5":"Pāpuṇe anupubbena, sabbasaṃyojanakkhayanti.","ja156:3.1":"Alīnacittajātakaṃ chaṭṭhaṃ."},"attha":null,"tika":null}
