{
  "an1.198:1.1": "Etad aggaṃ bhikkhave mama sāvakānaṃ bhikkhūnaṃ manomayaṃ kāyaṃ abhinimminantānaṃ yadidaṃ Culla-panthako. ",
  "an1.199:1.1": "ceto-vivaṭṭa-kusalānam yadidaṃ Cullapanthako. ",
  "an1.200:1.1": "saññā-vivaṭṭa-kusalānaṃ yadidaṃ Mahāpanthako. ",
  "an1.201:1.1": "araṇavihārīnaṃ yadidaṃ Subhūti. ",
  "an1.202:1.1": "dakkhiṇeyyānaṃ yadidaṃ Subhūti. ",
  "an1.203:1.1": "āraññikānaṃ yadidaṃ Revato Khadiravaniyo. ",
  "an1.204:1.1": "jhāyīnaṃ yadidaṃ Kaṅkhā-revato. ",
  "an1.205:1.1": "āraddha-viriyānaṃ yadidaṃ Soṇo Kolivīso. ",
  "an1.206:1.1": "kalyāṇavākkaraṇānaṃ yadidaṃ Soṇo Kuṭikaṇṇo. ",
  "an1.207:1.1": "lābhīnaṃ yadidaṃ Sīvali. ",
  "an1.208:1.1": "saddhādhimuttānaṃ yadidaṃ Vakkalī ti. "
}
