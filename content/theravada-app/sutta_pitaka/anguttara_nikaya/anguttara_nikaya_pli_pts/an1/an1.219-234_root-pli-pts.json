{
  "an1.219:1.1": "Etad aggaṃ bhikkhave mama sāvakānaṃ bhikkhūnaṃ bahussutānaṃ yadidaṃ Ānando. ",
  "an1.220:1.1": "satimantānaṃ yadidaṃ Ānando. ",
  "an1.221:1.1": "gatimantānaṃ yadidaṃ Ānando. ",
  "an1.222:1.1": "dhitimantānaṃ yadidaṃ Ānando. ",
  "an1.223:1.1": "upaṭṭhākānaṃ yadidaṃ Ānando. ",
  "an1.224:1.1": "mahāparisānaṃ yadidaṃ Uruvela-kassapo. ",
  "an1.225:1.1": "kulappasādakānaṃ yadidaṃ Kāḷudāyī. ",
  "an1.226:1.1": "appābādhānaṃ yadidaṃ Bakkulo. ",
  "an1.227:1.1": "pubbenivāsaṃ anussarantānaṃ yadidaṃ Sobhito. ",
  "an1.228:1.1": "vinayadharānaṃ yadidaṃ Upāli. ",
  "an1.229:1.1": "bhikkhun' ovādakānaṃ yadidaṃ Nandako. ",
  "an1.230:1.1": "indriyesu-gutta-dvārānaṃ yadidaṃ Nando. ",
  "an1.231:1.1": "bhikkhu-ovādakānaṃ yadidaṃ Mahā-kappino. ",
  "an1.232:1.1": "tejo-dhātukusalānaṃ yadidaṃ Sāgato. ",
  "an1.233:1.1": "paṭibhāneyyakānaṃ yadidaṃ Rādho. ",
  "an1.234:1.1": "lūkhacīvara-dharānaṃ yadidaṃ Mogharājā ti. "
}
