{
  "dhp116:0.1": "Khuddakanikāya ",
  "dhp116:0.2": "Dhammapada ",
  "dhp116:0.3": "9. Pāpavagga ",
  "dhp116:0.4": " ",
  "dhp116:1": "abhittharetha kalyāṇe ",
  "dhp116:2": "pāpā cittaṃ nivāraye, ",
  "dhp116:3": "dandhaṃ hi karoto puññaṃ ",
  "dhp116:4": "pāpasmiṃ ramatī mano. ",
  "dhp117:0": " ",
  "dhp117:1": "pāpañ ce puriso kayirā ",
  "dhp117:2": "na taṃ kayirā punappunaṃ, ",
  "dhp117:3": "na tamhi chandaṃ kayirātha, ",
  "dhp117:4": "dukkho pāpassa uccayo. ",
  "dhp118:0": " ",
  "dhp118:1": "puññañ ce puriso kayirā ",
  "dhp118:2": "kayirāth'; enaṃ punappunaṃ, ",
  "dhp118:3": "tamhi chandaṃ kayirātha, ",
  "dhp118:4": "sukho puññassa uccayo. ",
  "dhp119:0": " ",
  "dhp119:1": "pāpo pi passatī bhadraṃ ",
  "dhp119:2": "yāva pāpaṃ na paccati, ",
  "dhp119:3": "yadā ca paccatī pāpaṃ ",
  "dhp119:4": "atha pāpo pāpāni passati. ",
  "dhp120:1": "bhadro pi passatī pāpaṃ ",
  "dhp120:2": "yāva bhadraṃ na paccati, ",
  "dhp120:3": "yadā ca paccatī bhadraṃ ",
  "dhp120:4": "atha bhadro bhadrāni passati. ",
  "dhp121:0": " ",
  "dhp121:1": "māppamaññetha pāpassa ",
  "dhp121:2": "na man taṃ āgamissati, ",
  "dhp121:3": "udabindunipātena ",
  "dhp121:4": "udakumbho pi pūrati, ",
  "dhp121:5": "bālo pūrati pāpassa ",
  "dhp121:6": "thokathokam pi ācinaṃ. ",
  "dhp122:0": " ",
  "dhp122:1": "māppamaññetha puññassa ",
  "dhp122:2": "na man taṃ āgamissati, ",
  "dhp122:3": "udabindunipātena ",
  "dhp122:4": "udakumbho pi pūrati, ",
  "dhp122:5": "dhīro pūrati puññassa ",
  "dhp122:6": "thokathokam pi ācinaṃ. ",
  "dhp123:0": " ",
  "dhp123:1": "vāṇijo va bhayaṃ maggaṃ ",
  "dhp123:2": "appasattho mahaddhano ",
  "dhp123:3": "visaṃ jīvitukāmo va ",
  "dhp123:4": "pāpāni parivajjaye. ",
  "dhp124:0": " ",
  "dhp124:1": "pāṇimhi ce vaṇo nāssa ",
  "dhp124:2": "hareyya pāṇinā visaṃ, ",
  "dhp124:3": "nābbaṇaṃ visam anveti, ",
  "dhp124:4": "n'; atthi pāpaṃ akubbato. ",
  "dhp125:0": " ",
  "dhp125:1": "yo appaduṭṭhassa narassa dussati ",
  "dhp125:2": "suddhassa posassa anaṅgaṇassa ",
  "dhp125:3": "tam eva bālaṃ pacceti pāpaṃ ",
  "dhp125:4": "sukhumo rajo paṭivātaṃ va khitto. ",
  "dhp126:0": " ",
  "dhp126:1": "gabbham eke upapajjanti ",
  "dhp126:2": "nirayaṃ pāpakammino, ",
  "dhp126:3": "saggaṃ sugatino yanti ",
  "dhp126:4": "parinibbanti anāsavā. ",
  "dhp127:0": " ",
  "dhp127:1": "na antalikkhe na samuddamajjhe ",
  "dhp127:2": "na pabbatānaṃ vivaraṃ pavissa ",
  "dhp127:3": "na vijjatī so jagatippadeso ",
  "dhp127:4": "yatthaṭṭhito muñceyya pāpakammā. ",
  "dhp128:0": " ",
  "dhp128:1": "na antalikkhe na samuddamajjhe ",
  "dhp128:2": "na pabbatānaṃ vivaraṃ pavissa ",
  "dhp128:3": "na vijjatī so jagatippadeso ",
  "dhp128:4": "yatthaṭṭhitaṃ na-ppasahetha maccu. ",
  "dhp128:5": "Pāpavaggo navamo "
}