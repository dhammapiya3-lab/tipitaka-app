{
  "dhp146:0.1": "쿳다까니까야 ",
  "dhp146:0.2": "법구경 ",
  "dhp146:0.3": "제11장. 늙음 ",
  "dhp146:0.4": "술에 취한 위사카의 동료들 ",
  "dhp146:1": "세상이 불타고 있는데 ",
  "dhp146:2": "그대, 어찌하여 웃고 기뻐하는가? ",
  "dhp146:3": "세상이 어둠에 묻혀 있는데 ",
  "dhp146:4": "그대, 어찌하여 등불을 구하지 않는가? ",
  "dhp147:0": "기생 시리마를 짝사랑한 비구 ",
  "dhp147:1": "보라, 이 분칠한 모습을, ",
  "dhp147:2": "뼈마디로 엮어 이루어지고\n오물로 가득 찬 가죽주머니를. ",
  "dhp147:3": "자주 병들고\n번뇌망상으로 가득한 몸을. ",
  "dhp147:4": "그 어디에 항상함이 있고 견고함이 있는가? ",
  "dhp148:0": "나이든 웃따라 비구니 ",
  "dhp148:1": "이 몸이 늙어 시들어 가면 ",
  "dhp148:2": "병들이 득세하여 저항력을 잃어간다. ",
  "dhp148:3": "세포가 파괴되어 썩어 문드러지면 ",
  "dhp148:4": "생명은 죽음으로 끝을 맺으리. ",
  "dhp149:0": "구경의 깨달음을 얻었다고 착각한 비구들 ",
  "dhp149:1": "바람에 떨어져 뒹구는 ",
  "dhp149:2": "가을날 조롱박처럼 ",
  "dhp149:3": "하얗게 탈색된 뼈들을 보라. ",
  "dhp149:4": "그걸 바라보는데 무슨 즐거움이 있으랴? ",
  "dhp150:0": "자신의 미모에 자부심이 대단한 루빠난다 ",
  "dhp150:1": "뼈로 엮여 있고 ",
  "dhp150:2": "살과 피로 덮여 있는 ",
  "dhp150:3": "이 몸속에\n늙음과 죽음 ",
  "dhp150:4": "자만과 비방이 머물고 있네. ",
  "dhp151:0": "지옥에 갔다가 도솔천에 태어난 말리까 왕비 ",
  "dhp151:1": "화려하게 꾸민\n왕들의 수레가 낡아가듯이 ",
  "dhp151:2": "아름다운 몸도\n그렇게 늙어간다. ",
  "dhp151:3": "오직 성인이 드러낸 법法**168)**만이 ",
  "dhp151:4": "변하지 않는 영원불멸의 진리이다. ",
  "dhp152:0": "때와 장소에 맞지 않는 말만 하는 랄루다이 비구 ",
  "dhp152:1": "배움이 적고\n마음도 닦지 않는 이는 ",
  "dhp152:2": "게으른 황소처럼 ",
  "dhp152:3": "살만 쪘을 뿐 ",
  "dhp152:4": "지혜는 전혀 자라지 않네. ",
  "dhp153:0": "부처님의 오도송悟道頌 ",
  "dhp153:1": "수많은 삶, 윤회 속을 헤매이며 ",
  "dhp153:2": " ",
  "dhp153:3": "집 짓는 자를 찾았지만 찾지 못하여 ",
  "dhp153:4": "계속해서 태어남은 괴로움이었네.**178)** ",
  "dhp154:1": "오, 집 짓는 자여!\n이제 그대를 보았으니 ",
  "dhp154:2": "그대는 더 이상 집을 짓지 못하리라. ",
  "dhp154:3": "서까래는 부서졌고 대들보는 뿔뿔이 흩어졌으며 ",
  "dhp154:4": " ",
  "dhp154:5": "마음은 열반에 이르러 ",
  "dhp154:6": "갈애의 소멸을 성취했노라.**179)** ",
  "dhp155:0": "거지가 된 부자의 아들 마하다나 ",
  "dhp155:1": "젊어서 마음공부도 하지 않았고 ",
  "dhp155:2": "재산을 모으지도 않았네. ",
  "dhp155:3": "그들은 고기 없는 마른 연못의 ",
  "dhp155:4": "늙은 왜가리처럼\n앙상하게 뼈만 남았네. ",
  "dhp156:1": "젊어서 마음공부도 하지 않았고 ",
  "dhp156:2": "재산을 모으지도 않았네. ",
  "dhp156:3": "그들은 내팽개쳐진 낡은 화살처럼 ",
  "dhp156:4": "지난날을 떠올리며 눈물짓네. ",
  "dhp156:5": " "
}