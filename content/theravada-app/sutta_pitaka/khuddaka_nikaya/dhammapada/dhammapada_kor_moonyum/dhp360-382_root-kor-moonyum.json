{
  "dhp360:0.1": "쿳다까니까야 ",
  "dhp360:0.2": "법구경 ",
  "dhp360:0.3": "제25장. 비구 ",
  "dhp360:0.4": "감각의 문을 보호하지 못한 다섯 명의 비구 ",
  "dhp360:1": "눈을 잘 지키는 것이 좋고 ",
  "dhp360:2": "귀를 잘 지키는 것이 좋다. ",
  "dhp360:3": "코를 잘 지키는 것이 좋고 ",
  "dhp360:4": "혀를 잘 지키는 것이 좋다. ",
  "dhp361:1": "몸을 잘 지키는 것이 좋고 ",
  "dhp361:2": "입을 잘 지키는 것이 좋다. ",
  "dhp361:3": "마음을 잘 지키는 것이 좋고 ",
  "dhp361:4": "모든 감각의 문을 잘 지키는 것이 좋다. ",
  "dhp361:5": "감각의 문을 잘 지키는 비구는 ",
  "dhp361:6": "모든 괴로움에서 벗어난다. ",
  "dhp362:0": "기러기를 죽인 비구 ",
  "dhp362:1": "밖으로 손발과 입을 다스리고 ",
  "dhp362:2": " ",
  "dhp362:3": "안으로 수행하는 데서 기쁨을 찾고 ",
  "dhp362:4": "고요하고 홀로 있으며\n만족할 줄 아는 사람,\n그런 사람을 비구라 한다. ",
  "dhp363:0": "두 상수제자를 비난한 꼬깔리까 비구 ",
  "dhp363:1": "비구가 입을 조심하여 ",
  "dhp363:2": "차분하고 슬기롭게 말하며 ",
  "dhp363:3": "경전과 그 의미를 바르게 설명하면 ",
  "dhp363:4": "그의 설법은 감로수처럼 달콤하리라. ",
  "dhp364:0": "부처님을 진정으로 존경하는 담마라마 비구 ",
  "dhp364:1": "진리(法)에 머물고 진리를 기뻐하며 ",
  "dhp364:2": "진리를 명상하고 늘 마음에 새기는 비구는 ",
  "dhp364:3": " ",
  "dhp364:4": "참된 진리(正法)에서 결코 멀어지지 않는다. ",
  "dhp365:0": "이단자에게 가서 공양을 한 비구 ",
  "dhp365:1": "자기가 받은 것을 가벼이 하지 말고 ",
  "dhp365:2": "남이 얻은 것을 부러워하지 마라. ",
  "dhp365:3": "남이 얻은 것을 부러워하는 비구는 ",
  "dhp365:4": "고요한 마음을 얻을 수 없다. ",
  "dhp366:1": "비구가 조금밖에 얻지 못했더라도 ",
  "dhp366:2": "받은 것을 가벼이 하지 않으며 ",
  "dhp366:3": "생계가 청정하고 게으르지 않으면 ",
  "dhp366:4": "천신들도 그를 찬탄한다. ",
  "dhp367:0": "다섯 번 첫 수확물로 공양을 올리는 빤짝가다야까 바라문 ",
  "dhp367:1": "자신의 몸과 마음 작용에 대해 ",
  "dhp367:2": "‘나’라거나 ‘나의 것’이라고 생각하지 않고 ",
  "dhp367:3": "그것이 사라지더라도 슬퍼하지 않는 사람, ",
  "dhp367:4": "그를 진정 비구라 하네. ",
  "dhp368:0": "소나 꾸띠깐나 비구와 강도였다가 출가한 비구들 ",
  "dhp368:1": "자비관을 닦으며 ",
  "dhp368:2": "부처님의 가르침을 믿고 따르는 비구는 ",
  "dhp368:3": "평화로움, 상카라(行)의 소멸인 행복을 성취한다. ",
  "dhp368:4": " ",
  "dhp369:1": "오, 비구여!\n배 안에 고인 물을 퍼내면**159)** ",
  "dhp369:2": "빠르게 건너편에 닿으리니 ",
  "dhp369:3": "탐욕과 성냄을 잘라버리고 열반을 성취하라. ",
  "dhp369:4": " ",
  "dhp370:1": "다섯 가지를 잘라버리고\n다섯 가지를 없애고 ",
  "dhp370:2": "다섯 가지를 키워나가라. ",
  "dhp370:3": "다섯 가지 얽매임을 벗어난 비구를 ",
  "dhp370:4": "거센 물결을 건넌 자라고 한다.**160)** ",
  "dhp371:1": "오, 비구여!\n방일하지 말고 힘써 수행하며 ",
  "dhp371:2": "마음을 욕망에 빠지지 않게 하라. ",
  "dhp371:3": "방일하여 벌겋게 달구어진 쇠구슬을 삼키고서 ",
  "dhp371:4": "불타는 뜨거움을 맛본 뒤에야\n“아, 괴로워!”하며 울부짖지 마라. ",
  "dhp372:1": "지혜가 없는 이에게 삼매도 없고 ",
  "dhp372:2": "삼매가 없는 이에게 지혜도 없다. ",
  "dhp372:3": "삼매와 지혜를 함께 갖추어야만 ",
  "dhp372:4": "열반에 가까워지리라. ",
  "dhp373:1": "한적하고 조용한 곳에 들어가 ",
  "dhp373:2": "마음을 고요히 하고 ",
  "dhp373:3": "바르게 법을 관찰하는 이에게 ",
  "dhp373:4": "범부를 뛰어넘는 기쁨이 솟아나리라. ",
  "dhp374:1": "오취온이 일어나고 사라짐을 볼 때마다 ",
  "dhp374:2": " ",
  "dhp374:3": "기쁨과 즐거움을 얻으리니 ",
  "dhp374:4": "깨달은 이에게 이것이 불사不死의 열반이다. ",
  "dhp375:1": "감각기관을 잘 다스리고 ",
  "dhp375:2": "얻은 것에 만족하고 ",
  "dhp375:3": "빠띠목카(계목)를 잘 지키는 것, ",
  "dhp375:4": "지혜로운 비구에게 여기가 수행의 시작이다. ",
  "dhp376:1": "생계가 청정하고 ",
  "dhp376:2": "게으르지 않은 도반을 가까이하라. ",
  "dhp376:3": "조화롭게 살며 ",
  "dhp376:4": "해야 할 바를 힘써 하면 ",
  "dhp376:5": "기쁨이 넘치고 괴로움의 끝에 이르리라. ",
  "dhp376:6": " ",
  "dhp377:0": "재스민 꽃이 떨어지기 전에 깨달은 500비구 ",
  "dhp377:1": "재스민나무가 ",
  "dhp377:2": "시든 꽃을 떨어뜨리듯이 ",
  "dhp377:3": "오, 비구여! ",
  "dhp377:4": "탐욕과 성냄을 떨어뜨려라. ",
  "dhp378:0": "항상 침착하고 점잖은 산따까야 비구 ",
  "dhp378:1": "몸과 입과 마음을 ",
  "dhp378:2": "잘 다스려 고요히 하고 ",
  "dhp378:3": "온갖 욕망을 뱉어버리는 비구를 ",
  "dhp378:4": "평화로운 사람이라고 한다. ",
  "dhp379:0": "누더기 옷을 경책으로 삼은 낭갈라꿀라 ",
  "dhp379:1": "스스로 자신을 꾸짖고 ",
  "dhp379:2": "스스로 자신을 잘 살펴라. ",
  "dhp379:3": "자신을 잘 지키고 늘 알아차리면 ",
  "dhp379:4": "오, 비구여!\n그대는 행복하게 살리라. ",
  "dhp380:1": "자신이야말로 자신의 보호처이고 ",
  "dhp380:2": " ",
  "dhp380:3": "자신이야말로 자신의 의지처이니 ",
  "dhp380:4": "말장수가 좋은 말을 잘 보호하듯이 ",
  "dhp380:5": "그렇게 자신을 잘 보호하라. ",
  "dhp381:0": "신심 제일 왁깔리 장로 ",
  "dhp381:1": "붓다의 가르침에 기뻐하며 ",
  "dhp381:2": "믿고 따르는 비구는 ",
  "dhp381:3": "상카라의 소멸, 행복, 평화, 열반을 얻으리라. ",
  "dhp381:4": " ",
  "dhp382:0": "아누룻다 장로와 수마나 사미 ",
  "dhp382:1": "나이가 어리더라도 ",
  "dhp382:2": "붓다의 가르침을 힘껏 닦는 비구, ",
  "dhp382:3": "그가 세상을 비추네. ",
  "dhp382:4": "구름을 벗어난 달처럼. ",
  "dhp382:5": " "
}