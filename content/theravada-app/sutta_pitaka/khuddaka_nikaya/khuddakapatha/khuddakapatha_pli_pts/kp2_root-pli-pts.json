{
  "kp2:1.1": "II. Pāṇātipātā veramaṇī-sikkhāpadaṃ samādiyāmi, ",
  "kp2:2.1": "adinnādānā veramaṇī-sikkhāpadaṃ samādiyāmi, ",
  "kp2:3.1": "abrahmacariyā veramaṇī-sikkhāpadaṃ samādiyāmi, ",
  "kp2:4.1": "musāvādā veramaṇī-sikkhāpadaṃ samādiyāmi, ",
  "kp2:5.1": "surāmerayamajjapamādaṭṭhānā veramaṇī-sikkhāpadaṃ samādiyāmi, ",
  "kp2:6.1": "vikālabhojanā veramaṇī-sikkhāpadaṃ samādiyāmi, ",
  "kp2:7.1": "naccagītavāditavisūkadassanā veramaṇī-sikkhāpadaṃ samādiyāmi, ",
  "kp2:8.1": "mālāgandhavilepanadhāraṇa-maṇḍanavibhūsanaṭṭhānā veramaṇī-sikkhāpadaṃ samādiyāmi, ",
  "kp2:9.1": "uccāsayanamahāsayanā veramaṇī-sikkhāpadaṃ samādiyāmi, ",
  "kp2:10.1": "jātarūparajatapaṭiggahaṇā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:11.1": "DASASIKKHĀPADAṂ. "
}
